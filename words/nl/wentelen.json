{
    "word_family": [
        "wenteling",
        "omwenteling",
        "wenteltrap"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8fc10245-698f-3781-a12c-d9297db218f9",
                    "sense_definition": "draaien, in de rondte laten bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "draaien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kok bleef het deeg <w>wentelen</w> op het met bloem bestrooide aanrecht.",
                            "target_lang_translations": {
                                "en": "The chef kept <w>rolling</w> the dough on the flour-dusted countertop."
                            }
                        },
                        {
                            "text": "Je moet het vlees regelmatig <w>wentelen</w> in de pan om het gelijkmatig te garen.",
                            "target_lang_translations": {
                                "en": "You need to <w>turn</w> the meat regularly in the pan to cook it evenly."
                            }
                        }
                    ],
                    "synonyms": [
                        "draaien",
                        "omdraaien",
                        "roteren"
                    ],
                    "common_phrases": [
                        "in het meel wentelen",
                        "het vlees wentelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To turn, roll, or rotate something over and over, or to move it in a circular motion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "roll",
                                "target_lang_sense_clarification": "to turn over and over, e.g., in cooking or baking"
                            },
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "to change the orientation of something by rotating it"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "970d03fa-1463-3a7f-bed8-e2869b505ce7",
                    "sense_definition": "om een as of steunpunt draaien",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "draaien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De aarde blijft onophoudelijk om haar eigen as <w>wentelen</w>.",
                            "target_lang_translations": {
                                "en": "The Earth continues to <w>rotate</w> incessantly on its own axis."
                            }
                        },
                        {
                            "text": "Het zware rad begon langzaam te <w>wentelen</w> door de kracht van het water.",
                            "target_lang_translations": {
                                "en": "The heavy wheel slowly began to <w>turn</w> due to the power of the water."
                            }
                        }
                    ],
                    "synonyms": [
                        "roteren",
                        "draaien",
                        "spinnen"
                    ],
                    "common_phrases": [
                        "om zijn as wentelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To rotate or spin around an axis or a central point."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rotate",
                                "target_lang_sense_clarification": "to turn around an axis"
                            },
                            {
                                "target_lang_word": "revolve",
                                "target_lang_sense_clarification": "to turn around a central point or axis"
                            },
                            {
                                "target_lang_word": "spin",
                                "target_lang_sense_clarification": "to turn rapidly around an axis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "807109bf-2ca0-3728-a38d-6de66f228f1e",
                    "sense_definition": "zich omrollen, zich heen en weer bewegen in een vloeistof of modder",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "omrollen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De varkens <w>wentelen</w> zich graag in de koele modder tijdens warme zomerdagen.",
                            "target_lang_translations": {
                                "en": "The pigs like to <w>wallow</w> in the cool mud during hot summer days."
                            }
                        },
                        {
                            "text": "Hij bleef zich in zijn verdriet <w>wentelen</w> in plaats van hulp te zoeken.",
                            "target_lang_translations": {
                                "en": "He kept <w>wallowing</w> in his grief instead of seeking help."
                            }
                        }
                    ],
                    "synonyms": [
                        "omrollen",
                        "rollen",
                        "baden"
                    ],
                    "common_phrases": [
                        "zich in modder wentelen",
                        "zich in zelfmedelijden wentelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To roll oneself over, or to wallow and move back and forth in a liquid, mud, or figuratively in an emotion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wallow",
                                "target_lang_sense_clarification": "to roll about in mud, water, or self-pity"
                            },
                            {
                                "target_lang_word": "roll",
                                "target_lang_sense_clarification": "to roll oneself around on the ground or in something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3f48593-4062-3ad3-83c0-00737ed17f76",
                    "sense_definition": "een cirkel beschrijven in een vlak loodrecht op een lijn",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "draaien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De planeten <w>wentelen</w> in elliptische banen rond de zon.",
                            "target_lang_translations": {
                                "en": "The planets <w>revolve</w> in elliptical orbits around the sun."
                            }
                        },
                        {
                            "text": "De satelliet bleef in een vaste baan om de aarde <w>wentelen</w>.",
                            "target_lang_translations": {
                                "en": "The satellite continued to <w>orbit</w> the Earth in a fixed path."
                            }
                        }
                    ],
                    "synonyms": [
                        "cirkelen",
                        "draaien",
                        "revolveren"
                    ],
                    "common_phrases": [
                        "in een baan wentelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "wetenschappelijk of formeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To describe a circle or orbit in a plane perpendicular to a line; to orbit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "orbit",
                                "target_lang_sense_clarification": "to travel in a curved path around a celestial body"
                            },
                            {
                                "target_lang_word": "revolve",
                                "target_lang_sense_clarification": "to move in a circular path around another object"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}