    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9dae249a-8599-320c-9d9a-1c931a22e5b4",
                    "sense_definition": "D'une propreté parfaite, sans la moindre tache ni souillure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propreté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La neige fraîche recouvrait la montagne d'un manteau blanc <w>immaculé</w>."
                        },
                        {
                            "text": "Le médecin portait une blouse <w>immaculée</w> avant d'entrer dans la salle d'opération."
                        }
                    ],
                    "synonyms": [
                        "impeccable",
                        "net",
                        "propre"
                    ],
                    "antonyms": [
                        "sale",
                        "taché",
                        "souillé"
                    ],
                    "common_phrases": [
                        "blanc immaculé",
                        "blancheur immaculée"
                    ]
                },
                {
                    "sense_id": "cda1d42e-13a2-3b89-806d-8199a60d1aae",
                    "sense_definition": "Qui est pur de tout péché, exempt de la souillure originelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La doctrine catholique célèbre l'<w>Immaculée</w> Conception de la Vierge Marie."
                        },
                        {
                            "text": "Le prédicateur évoquait une âme <w>immaculée</w> préservée de toute corruption morale."
                        }
                    ],
                    "synonyms": [
                        "pur",
                        "sans péché"
                    ],
                    "antonyms": [
                        "pécheur"
                    ],
                    "common_phrases": [
                        "Immaculée Conception"
                    ]
                },
                {
                    "sense_id": "31665b80-6945-3b54-9eec-785d944b5ecc",
                    "sense_definition": "Totalement exempt ou dépourvu d'un défaut, d'un doute ou d'un tourment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le thérapeute ne cherche pas à rendre son patient <w>immaculé</w> d'angoisse mais à soulager sa souffrance."
                        },
                        {
                            "text": "Son parcours politique n'était pas tout à fait <w>immaculé</w> de compromis douteux."
                        }
                    ]
                }
            ]
        },
        {
