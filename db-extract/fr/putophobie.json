                        "source_entry_id": "e06d94dc-1c6b-35c1-8573-5e1c8536d2e8",
                        "source_sense_id": "6df63d24-0462-3eca-88f1-67edce253e1b",
                        "target_lang_word": "whorephobia",
                        "target_lang_code": "en",
