                        ],
                        "examples": [
                            {
                                "example_id": "ca300963-82f1-4737-a0f7-10e7386b34fd",
                                "sense_id": "fb5965f2-c831-302c-bbed-903346cb551d",
                                "text": "The rioters firebombed the parked car."
                            },
                            {
                                "example_id": "01ac98be-79f0-4b8c-b352-8f3fcf8f154a",
                                "sense_id": "fb5965f2-c831-302c-bbed-903346cb551d",
                                "text": "A GOP office in Hillsborough, North Carolina, was firebombed over the weekend, with a swastika and the words “Nazi Republicans leave town or else” spray painted on an adjacent building, according to local officials."
                            },
                            {
                                "example_id": "8ad04018-5a38-4bb1-ab86-ae91e052e24b",
                                "sense_id": "fb5965f2-c831-302c-bbed-903346cb551d",
                                "text": "The next week when they firebombed the Satin Room, one of Chink Montagueʼs after-hours joints, Carney assumed the mobsters were embroiled in another war."
                            },
                            {
                                "example_id": "46f4f5f9-36df-41eb-bd59-39dad696b402",
                                "sense_id": "fb5965f2-c831-302c-bbed-903346cb551d",
                                "text": "On Tuesday, a masked man used molotov cocktails to firebomb a Tesla dealership in Las Vegas before firing rounds into the burning vehicles."
                            }
                        ]
                    }
