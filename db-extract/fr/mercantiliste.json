        "fr-extract.jsonl": [
            {
                "entry_id": "69cb4733-bd02-3250-8dc9-37e33aac35ae",
                "word": "mercantiliste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "387e6183-84c1-4995-bd0e-1c037ae20fa5",
                        "entry_id": "69cb4733-bd02-3250-8dc9-37e33aac35ae",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "mercantilistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9fbf6ea-c856-31ef-8d98-7cc89cd708b8",
                        "entry_id": "69cb4733-bd02-3250-8dc9-37e33aac35ae",
                        "glosses": [
                            "Qui se rapporte au mercantilisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc8168e-9ce4-4ca3-a388-b0edab88ace8",
                                "sense_id": "d9fbf6ea-c856-31ef-8d98-7cc89cd708b8",
                                "text": "La doctrine mercantiliste, sur les relations entre économie et politique des nations, a pour point de départ, pour principe la formule célèbre : « L'argent est le nerf de la guerre. »"
                            },
                            {
                                "example_id": "decc014b-5cb1-42bb-aab5-9b5648049615",
                                "sense_id": "d9fbf6ea-c856-31ef-8d98-7cc89cd708b8",
                                "text": "L’exemple le plus célèbre de cette rationalisation, caractéristique de l’économie mercantiliste, est le commerce transatlantique, dit \"commerce triangulaire\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f76ab9d4-b951-4512-99c3-ccbf3596dc67",
                        "source_entry_id": "69cb4733-bd02-3250-8dc9-37e33aac35ae",
                        "source_sense_id": "d9fbf6ea-c856-31ef-8d98-7cc89cd708b8",
                        "target_lang_word": "mercantilist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mercantilist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ea74796-45d4-3144-87b4-78b6853d786c",
                                        "entry_id": "2fbcaef8-4330-3ca0-b2fb-37bc3220159b",
                                        "glosses": [
                                            "Of, pertaining to, or believing in mercantilism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d47e86-668b-4d63-bbd3-9fc337283b30",
                                                "sense_id": "8ea74796-45d4-3144-87b4-78b6853d786c",
                                                "text": "According to the mercantilist thinking that dominated European thought between the 16th and 18th centuries, poverty was socially useful. True, it was miserable for the poor. But it also kept the economic engine humming by ensuring the availability of plentiful cheap labour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mercantilist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5abfe2ce-a4d5-3417-b990-72df47c4a821",
                                        "entry_id": "6fe601b1-360d-390d-822d-7f3ec876043b",
                                        "glosses": [
                                            "One who believes in mercantilism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c618a2-08dd-4309-a090-cda133843e62",
                                                "sense_id": "5abfe2ce-a4d5-3417-b990-72df47c4a821",
                                                "text": "On this point there was no difference between mercantilists and feudalists, between crowned planners and vested interests, between centralizing bureaucrats and conservative particularists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
