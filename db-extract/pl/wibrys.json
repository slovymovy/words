                        "glosses": [
                            "prosty, sztywny i gruby włos pełniący rolę narządu dotyku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fe55f9b-a524-4c3b-9a66-8c5863320c5e",
                                "sense_id": "97920374-d6f6-304a-909a-588e40ae4de8",
                                "text": "Czasami kotu wypadnie wibrys; to normalne"
