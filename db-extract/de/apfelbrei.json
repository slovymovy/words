                "senses": [
                    {
                        "sense_id": "2d61bee0-29ca-302e-a62d-ab7df7d76f1a",
                        "entry_id": "9c137bfe-9442-3ae2-a9aa-8023ca336f25",
                        "glosses": [
                            "Mus aus gekochten Äpfeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673d2cf2-f283-40fc-9d91-d82ea0d408f2",
                                "sense_id": "2d61bee0-29ca-302e-a62d-ab7df7d76f1a",
                                "text": "„Sie trägt ein buntes Blumenkleid und bereitet in der Kochnische Toast mit heißem Apfelbrei und Hagebuttentee vor.“"
                            },
                            {
                                "example_id": "04a63c07-666f-4f29-b82c-50ded75e0665",
                                "sense_id": "2d61bee0-29ca-302e-a62d-ab7df7d76f1a",
                                "text": "„So gelingt es den Lebensmitteltechnologen mühelos, mit Hilfe von Farbstoff, Apfelbrei, Algengelee und Aroma die fruchtige Säure von Johannisbeeren zu simulieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
