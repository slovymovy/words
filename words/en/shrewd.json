                    "sense_definition": "Sharp, piercing, and bitterly cold, especially of wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>shrewd</w> wind blew across the desolate moor, chilling them to the bone.",
                            "target_lang_translations": {
                                "pl": "<w>Przenikliwy</w> wiatr wiał nad opuszczonym wrzosowiskiem, mrożąc ich do szpiku kości.",
                                "tr": "Issız bozkırda <w>keskin</w> bir rüzgar esti ve onları iliklerine kadar dondurdu."
                            }
                        },
                        {
                            "text": "They wrapped their cloaks tightly against the <w>shrewd</w> winter air.",
                            "target_lang_translations": {
                                "pl": "Owinęli się szczelnie płaszczami przed <w>ostrym</w> zimowym powietrzem.",
                                "tr": "Pelerinlerini <w>delici</w> kış havasına karşı sıkıca sardılar."
                            }
