                },
                {
                    "sense_id": "7b680ab6-1330-3d1a-b310-a6b357e7119c",
                    "sense_definition": "zich van de ene naar de andere plaats begeven",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft geen eigen auto en <w>verplaatst</w> zich meestal op de fiets.",
                            "target_lang_translations": {
                                "en": "She doesn't have her own car and usually <w>gets around</w> by bike.",
                                "ru": "У неё нет своей машины, и она обычно <w>передвигается</w> на велосипеде."
                            }
                        },
                        {
                            "text": "In een drukke stad is het vaak sneller om je met de metro te <w>verplaatsen</w>.",
                            "target_lang_translations": {
                                "en": "In a busy city, it is often faster to <w>travel</w> by metro.",
                                "ru": "В оживленном городе часто быстрее <w>ездить</w> на метро."
                            }
