                "senses": [
                    {
                        "sense_id": "ffa94356-56be-322a-8264-89899e99b40f",
                        "entry_id": "13d39ee6-8107-3bcf-8ab5-ce1b3079f57c",
                        "glosses": [
                            "книжн., устар. своими глазами, путём личного опыта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6bb4be9-ab4c-450b-8fdf-44a03f2488e2",
                                "sense_id": "ffa94356-56be-322a-8264-89899e99b40f",
                                "text": "Теперь вы все воочию можете убедиться в том, что это возможно."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b5b5f16-d16f-3463-bc38-b5d6a4df5ade",
                        "entry_id": "13d39ee6-8107-3bcf-8ab5-ce1b3079f57c",
                        "glosses": [
                            "весьма наглядно, со всей ясностью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1b77155-da8c-4600-bf48-2dd75c3e242f",
                                "sense_id": "5b5b5f16-d16f-3463-bc38-b5d6a4df5ade",
                                "text": "Он вдруг понял, увидел воочию, что бросил её на произвол судьбы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c148787-679b-4058-a146-797e4482d074",
                        "source_entry_id": "13d39ee6-8107-3bcf-8ab5-ce1b3079f57c",
                        "source_sense_description": "своими глазами",
                        "target_lang_word": "with one's own eyes",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "with one's own eyes",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b24a7aa-7bc5-3ff0-983a-fa7e0725f481",
                                        "entry_id": "2246480a-fba8-315c-b43a-aa4d0f7121f7",
                                        "glosses": [
                                            "In real life as seen by oneself, as opposed to in a picture or according to someone else's description."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa11322b-5a3b-4417-ad9f-46a2f772517f",
                                                "sense_id": "0b24a7aa-7bc5-3ff0-983a-fa7e0725f481",
                                                "text": "I had seen pictures of the Grand Canyon on the Internet, but I wanted to see it with my own eyes."
                                            },
                                            {
                                                "example_id": "e7c92ccd-d81e-4560-9b32-5e82f1b758b2",
                                                "sense_id": "0b24a7aa-7bc5-3ff0-983a-fa7e0725f481",
                                                "text": "I watched his demise with my own eyes."
                                            },
                                            {
                                                "example_id": "f1dac0b6-aa70-4b26-8669-da3b7819960a",
                                                "sense_id": "0b24a7aa-7bc5-3ff0-983a-fa7e0725f481",
                                                "text": "\"I'm a great believer in data. But there is no substitute for leaders being out there, talking to colleagues, seeing conditions for themselves. All the audits in the world don't replace looking with your own eyes.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
