                    }
                ],
                "senses": [
                    {
                        "sense_id": "cfd93a4f-e976-3668-af5e-cd0405c0acd6",
                        "entry_id": "d25222b5-099e-34f6-a53a-44ddfa25734b",
                        "glosses": [
                            "gewoon, normaal, niet bijzonder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee38de5f-0e68-4b17-8723-1c5f1c64698c",
                                "sense_id": "cfd93a4f-e976-3668-af5e-cd0405c0acd6",
                                "text": "De beroemde artiest bleef een alledaags meisje dat normaal bleef doen zonder sterallures en dat wat eigenlijk ook heel bijzonder."
                            },
                            {
                                "example_id": "beafac0a-f3aa-4375-9793-e7e07fa23d33",
                                "sense_id": "cfd93a4f-e976-3668-af5e-cd0405c0acd6",
                                "text": "Het was te ver verwijderd van de alledaagse werkelijkheid en de realiteit van menselijke emoties, behoeftes en imperfecties."
                            },
                            {
                                "example_id": "2898116a-4190-4125-bccf-4203b95fd8e4",
                                "sense_id": "cfd93a4f-e976-3668-af5e-cd0405c0acd6",
                                "text": "Uit elk rimpeltje op haar alledaagse gelaat sprak opeens medelijden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fa065f8-5daf-4130-b3ff-77ea2424adf4",
                        "source_entry_id": "d25222b5-099e-34f6-a53a-44ddfa25734b",
                        "source_sense_id": "cfd93a4f-e976-3668-af5e-cd0405c0acd6",
                        "target_lang_word": "alltäglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alltäglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc83de35-802b-3e5b-9e42-04ea6a41edb7",
                                        "entry_id": "c1dd2df9-a107-3fd5-9955-2fe2e92d877c",
                                        "glosses": [
                                            "ohne Besonderheit; so normal, dass es zum Alltag gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2edcd35-00a0-4cea-9ec3-e4a12b43bb71",
                                                "sense_id": "dc83de35-802b-3e5b-9e42-04ea6a41edb7",
                                                "text": "Auch ich wähle ja vor allem alltägliche Motive, die eigentlich erst durch das Festhalten auf einem Foto oder einem gemalten Bild, ja auch durch eine Beschreibung in einem Roman, zu etwas Besonderem werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbf4bed9-1c48-3199-85b9-8022b38ba466",
                                        "entry_id": "c1dd2df9-a107-3fd5-9955-2fe2e92d877c",
                                        "glosses": [
                                            "auf den Alltag bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e71927e-5d8b-42a2-93ee-730a7f492f9f",
                                                "sense_id": "bbf4bed9-1c48-3199-85b9-8022b38ba466",
                                                "text": "Rasenmähen ist für uns eine alltägliche Beschäftigung."
                                            },
                                            {
                                                "example_id": "eeaf2640-1b28-4eed-a015-82af02bada38",
                                                "sense_id": "bbf4bed9-1c48-3199-85b9-8022b38ba466",
                                                "text": "„Alltägliche Nahrungsmittel, die Impfstoffe oder andere medizinisch wirksame Zusatzstoffe enthalten, gibt es zwar noch nicht zu kaufen, sie sind aber schon Gegenstand der Forschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd0bb7e4-ee0e-4ca4-a503-b8c6ddf1bf40",
                        "source_entry_id": "d25222b5-099e-34f6-a53a-44ddfa25734b",
                        "source_sense_id": "cfd93a4f-e976-3668-af5e-cd0405c0acd6",
                        "target_lang_word": "everyday",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "everyday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8fb8130-1288-3edd-aed2-f71af7c5a161",
                                        "entry_id": "49e47f57-cc53-304b-a1e3-5caa8b01d38b",
                                        "glosses": [
                                            "Appropriate for ordinary use, rather than for special occasions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c86f9b98-4a23-4c06-9021-7880a20482da",
                                                "sense_id": "e8fb8130-1288-3edd-aed2-f71af7c5a161",
                                                "text": "1906, Edith Nesbit, The Railway Children, Chapter 4: The engine-burglar,\nWhen they had gone, Bobbie put on her everyday frock, and went down to the railway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92cdb22c-161f-35ee-8758-311aed96aa38",
                                        "entry_id": "49e47f57-cc53-304b-a1e3-5caa8b01d38b",
                                        "glosses": [
                                            "Commonplace, ordinary."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d6be65f-d520-4925-8734-5bedea3322f8",
                                                "sense_id": "92cdb22c-161f-35ee-8758-311aed96aa38",
                                                "text": "Then you came in. I heard your rumbling voice\nOut in the kitchen, and I don't know why,\n But I went near to see with my own eyes.\nYou could sit there with the stains on your shoes\n Of the fresh earth from your own baby's grave\nAnd talk about your everyday concerns.[…]"
                                            },
                                            {
                                                "example_id": "a2d9398f-0936-4e9d-a767-128028577b94",
                                                "sense_id": "92cdb22c-161f-35ee-8758-311aed96aa38",
                                                "text": "Although it is an everyday virus, there is something about influenza that inspires awe."
                                            },
                                            {
                                                "example_id": "a5ae6d65-3e17-4337-a2a9-839d85bf6c99",
                                                "sense_id": "92cdb22c-161f-35ee-8758-311aed96aa38",
                                                "text": "By 2025, of course, Trump and Miller were back in the White House, pursuing a campaign promise to “remigrate” millions of everyday people out of America."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c979647b-669b-3a45-8a0a-fa8c83ddb2fa",
                                        "entry_id": "49e47f57-cc53-304b-a1e3-5caa8b01d38b",
                                        "glosses": [
                                            "Present or recurring every day."
                                        ],
                                        "tags": [
                                            "literally",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cd8b9bb-9040-4d25-b689-6e52d73d9a21",
                                                "sense_id": "c979647b-669b-3a45-8a0a-fa8c83ddb2fa",
                                                "text": "For Everyday Recording / For example: Programme time for timer recording every day from 20:00–22:45 on timer programme number 7. Programming for everyday recording can be made on any of the timer programme numbers 1–7. […] For Everyweek Recording / For Example: Programming a timer recording for a TV programme that is broadcast every week on Sunday, from 20:00 to 22:45."
                                            },
                                            {
                                                "example_id": "7cca1a55-9560-4f93-aa6a-5d4d85d7a3e2",
                                                "sense_id": "c979647b-669b-3a45-8a0a-fa8c83ddb2fa",
                                                "text": "“What kind of place do you live in! Every time we turn around, somebody else is getting killed!” / “Believe me, it’s not an everyday occurrence.” An everyweek occurrence lately, however."
                                            },
                                            {
                                                "example_id": "60da92c2-2ec2-4f15-848e-2970ad98f4e0",
                                                "sense_id": "c979647b-669b-3a45-8a0a-fa8c83ddb2fa",
                                                "text": "It’s not an everyday, or even an everyweek, event, but nowadays you can sometimes see young couples kissing goodbye at street corners and train stations."
                                            },
                                            {
                                                "example_id": "4e281f31-3bfd-4a30-8bc0-ee364874de88",
                                                "sense_id": "c979647b-669b-3a45-8a0a-fa8c83ddb2fa",
                                                "text": "We hope this becomes an ‘everyday’ book in your kitchen – or at least an ‘everyweek’ book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "085737d1-c0f6-3509-94ef-2a3b4e0232b6",
                                        "entry_id": "49e47f57-cc53-304b-a1e3-5caa8b01d38b",
                                        "glosses": [
                                            "Commonplace or ordinary during daytime."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b0b9864-ac82-43ac-a602-19f411b2fe27",
                                                "sense_id": "085737d1-c0f6-3509-94ef-2a3b4e0232b6",
                                                "text": "This was an everyday and everynight scene a couple of decades ago."
                                            },
                                            {
                                                "example_id": "383ed38e-a8f1-4ec7-b114-4473311d9c95",
                                                "sense_id": "085737d1-c0f6-3509-94ef-2a3b4e0232b6",
                                                "text": "It calls for methods of thinking, of writing texts, and of investigation that expand and extend our knowledge of how our everyday/everynight worlds are put together, determined and shaped as they are by forces and powers beyond our practical and direct knowledge."
                                            },
                                            {
                                                "example_id": "23392669-7eda-4c97-bf26-39e6ed9aa6b0",
                                                "sense_id": "085737d1-c0f6-3509-94ef-2a3b4e0232b6",
                                                "text": "The locus of emancipatory hopes shifts from everyday to everynight life."
                                            }
                                        ]
                                    }
                                ]
                            },
