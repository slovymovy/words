                "forms": [
                    {
                        "form_id": "6ea76560-3b32-4bbf-944f-1192fddb01ff",
                        "entry_id": "e96637b3-a13b-3ef5-ab9e-3d66fc83b641",
                        "tags": [
                            "plural",
                            "masculine",
