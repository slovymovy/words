                "senses": [
                    {
                        "sense_id": "6292daef-e606-3cf6-bd2a-b55e6d56f18e",
                        "entry_id": "5a04f19b-598c-3850-acff-fa46b4f75301",
                        "glosses": [
                            "Auseinandersetzung/Kampf zwischen Göttern und/oder Göttinnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d66fd61-b0c9-4d7d-8290-d4df2d7c5f8a",
                                "sense_id": "6292daef-e606-3cf6-bd2a-b55e6d56f18e",
                                "text": "„Athene, bekanntlich, war die Namensgeberin und Schutzgöttin von Athen. Einmal trug sie einen kleinen Götterstreit aus mit Poseidon, dem Herrscher der Meere, den dieser natürlich verlor.“"
                            },
                            {
                                "example_id": "8eb6db1c-d271-41da-93bc-2a7745f9e570",
                                "sense_id": "6292daef-e606-3cf6-bd2a-b55e6d56f18e",
                                "text": "„Dieser Tanzfilm ergänzt jetzt, zur Nachhilfe der Konsumentenphantasie, was es nur an Archetypen zum Thema gibt: die Geburt der Welt aus dem Wasser (Plingediling), Götterstreit und Krieg der Sterne, Liebe und Eifersucht, Tod und Schicksal.“"
                            },
                            {
                                "example_id": "a27364a6-c2f5-4bc0-9b10-b82cb74aba07",
                                "sense_id": "6292daef-e606-3cf6-bd2a-b55e6d56f18e",
                                "text": "„Dazu waren die drei Handlungsebenen – Allegorie, Götterstreit, Menschenschicksal – in die Instrumentation eingeflossen.“"
                            },
                            {
                                "example_id": "66e3d489-12a5-4076-9509-0e22d5530e55",
                                "sense_id": "6292daef-e606-3cf6-bd2a-b55e6d56f18e",
                                "text": "„Die Götter zankten sich. […] Hendrik wartete ab – und wußte kaum, welchen Ausgang er dem Götterstreit wünschen sollte.“"
                            },
                            {
                                "example_id": "2c34151d-a762-4e5e-bb66-676dc7ea480b",
                                "sense_id": "6292daef-e606-3cf6-bd2a-b55e6d56f18e",
                                "text": "„Ich aber will, bin ich auch nur ein einzelner Mann, in dem Götterstreit bei den guten Geistern meiner Ahnen stehen, ob sie siegen oder unterliegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
