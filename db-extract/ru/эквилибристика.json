                        ]
                    },
                    {
                        "translation_id": "e9a1c316-f2de-43f4-ba81-977c3a16e2f7",
                        "source_entry_id": "be04e6c9-2ad4-3af0-93ec-66049f20c8c7",
                        "target_lang_word": "Balanceakt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Balanceakt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "879b2f08-d0b8-3169-884c-7ef96e598837",
                                        "entry_id": "8af67b4b-295f-3533-a798-000a1679efdb",
                                        "glosses": [
                                            "eine Vorführung, bei der balanciert wird"
                                        ],
                                        "tags": [
                                            "Zirkus",
                                            "Varieté"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f9aeeaf-26b1-4668-ac9a-1398434c27df",
                                                "sense_id": "879b2f08-d0b8-3169-884c-7ef96e598837",
                                                "text": "„Schaudernd betrachten wir den Balanceakt auf dem Hochseil im Zirkus; dann fahren wir mit dem Auto nach Hause, und es kommt uns nicht in den Sinn, daß wir damit ein viel größeres Risiko eingehen als der Turner unter dem Zeltdach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6b69f09-e205-3233-88ab-099ffd359d5a",
                                        "entry_id": "8af67b4b-295f-3533-a798-000a1679efdb",
                                        "glosses": [
                                            "abwägendes Verhalten, Berücksichtigung mehrerer Seiten einer schwierigen Angelegenheit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2fe71c7-a1e4-45f1-ba98-863142a3e972",
                                                "sense_id": "b6b69f09-e205-3233-88ab-099ffd359d5a",
                                                "text": "„Gleichwohl ist und bleibt es in der Praxis ein schwieriger Balanceakt, die Interessen der Alten mit denen der Jungen zum Ausgleich zu bringen.“"
                                            },
                                            {
                                                "example_id": "3b62d7a1-69d4-4dfd-a3bb-0db086804651",
                                                "sense_id": "b6b69f09-e205-3233-88ab-099ffd359d5a",
                                                "text": "„Für den traditionsbewussten Weltverband ist der Onlineboom Neuland und Balanceakt zugleich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cc1871c-58dd-47e9-8832-c56cf8c31e36",
                        "source_entry_id": "be04e6c9-2ad4-3af0-93ec-66049f20c8c7",
                        "target_lang_word": "exercice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exercice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c24b13-3508-3bfc-8da1-b48c06830fe0",
                                        "entry_id": "0b09cd99-086d-30db-bdca-acc1d4fb83d8",
                                        "glosses": [
                                            "Action d’exercer ou de s’exercer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f03e6509-db68-499a-b4b1-90109eefc8b9",
                                                "sense_id": "a2c24b13-3508-3bfc-8da1-b48c06830fe0",
                                                "text": "Cela ne s’apprend que par un long exercice."
                                            },
                                            {
                                                "example_id": "7dcf3307-29e2-4d6c-b639-ae89a5128bd6",
                                                "sense_id": "a2c24b13-3508-3bfc-8da1-b48c06830fe0",
                                                "text": "Long, pénible, fréquent, continuel exercice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac7bc65-be40-35f9-9e3e-ae351327cf9d",
                                        "entry_id": "0b09cd99-086d-30db-bdca-acc1d4fb83d8",
                                        "glosses": [
                                            "Apprentissage du maniement des armes et des évolutions militaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5d075a6-57f6-4fbb-b0c4-d3d9dd19358f",
                                                "sense_id": "aac7bc65-be40-35f9-9e3e-ae351327cf9d",
                                                "text": "Tous les matins, le brave général Bravida les menait sur l’Esplanade faire l’exercice à feu, l’école de tirailleurs. « Couchez-vous ! levez-vous » et ce qui s’ensuit."
                                            },
                                            {
                                                "example_id": "5267d111-2f3e-44a3-bc83-9976ba199606",
                                                "sense_id": "aac7bc65-be40-35f9-9e3e-ae351327cf9d",
                                                "text": "Et le dernier des Scaër, qui s'est engagé au mois de juillet, n'a pas encore vu le feu. On l'a d'abord envoyé dans un dépôt, pour y apprendre à faire l’exercice."
                                            },
                                            {
                                                "example_id": "4ed307f8-7cae-4842-bcf3-cfe2509c61b6",
                                                "sense_id": "aac7bc65-be40-35f9-9e3e-ae351327cf9d",
                                                "text": "Je l’ai mené jusqu’au pont d’Argenteuil, où il voulait absolument acheter au gardien du Bois, pour me la donner, une pie savante qui fait l’exercice avec un petit fusil."
                                            },
                                            {
                                                "example_id": "c13f116e-60ce-4332-968f-d42f6e0efbc3",
                                                "sense_id": "aac7bc65-be40-35f9-9e3e-ae351327cf9d",
                                                "text": "Aller à l’exercice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c10e78a-7ac0-34f3-b462-34e7a57ebe54",
                                        "entry_id": "0b09cd99-086d-30db-bdca-acc1d4fb83d8",
                                        "glosses": [
                                            "Entrainement du corps, soumis à certaines règles et que l’on apprend à bien exécuter, comme monter à cheval, faire des armes, danser, nager, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad4b9257-9ed7-45b0-8984-f699f913b356",
                                                "sense_id": "0c10e78a-7ac0-34f3-b462-34e7a57ebe54",
                                                "text": "Il réussit mieux dans cet exercice que dans tel autre."
                                            },
                                            {
                                                "example_id": "6d459468-a7e1-4599-a4f0-bbd2b1725f63",
                                                "sense_id": "0c10e78a-7ac0-34f3-b462-34e7a57ebe54",
                                                "text": "Il réussit dans tous ses exercices."
                                            },
                                            {
                                                "example_id": "8e7c8bbe-6559-4010-a01c-827744691fca",
                                                "sense_id": "0c10e78a-7ac0-34f3-b462-34e7a57ebe54",
                                                "text": "Les différents exercices qui font partie de l’éducation."
                                            },
                                            {
                                                "example_id": "ec24f2a5-e598-4f47-bab2-4e814d8b6754",
                                                "sense_id": "0c10e78a-7ac0-34f3-b462-34e7a57ebe54",
                                                "text": "L’exercice des armes."
                                            },
                                            {
                                                "example_id": "50d02ed1-19de-45b5-b2e6-f5a6336f8696",
                                                "sense_id": "0c10e78a-7ac0-34f3-b462-34e7a57ebe54",
                                                "text": "Faire ses exercices."
                                            },
                                            {
                                                "example_id": "c2d1be9c-0831-406f-8455-c138e65a58db",
                                                "sense_id": "0c10e78a-7ac0-34f3-b462-34e7a57ebe54",
                                                "text": "Exercices de gymnastique."
                                            },
                                            {
                                                "example_id": "aca06d5e-da5d-451f-a124-21a71a041f31",
                                                "sense_id": "0c10e78a-7ac0-34f3-b462-34e7a57ebe54",
                                                "text": "Exercice d’acrobatie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5b38480-87cc-3171-ab84-b3803e68896b",
                                        "entry_id": "0b09cd99-086d-30db-bdca-acc1d4fb83d8",
                                        "glosses": [
                                            "Mouvements par lesquels on exerce le corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c94c6f4e-73c9-42a5-86f5-cd853087545d",
                                                "sense_id": "c5b38480-87cc-3171-ab84-b3803e68896b",
                                                "text": "Ce petit potager remonte aux années 1920. Il garantissait aux habitants l’autosuffisance alimentaire et leur offrait l’occasion d’un sain exercice physique – un souci très allemand."
                                            },
                                            {
                                                "example_id": "17e9dd97-a60b-4c0f-a5ac-b3f38a98c4f1",
                                                "sense_id": "c5b38480-87cc-3171-ab84-b3803e68896b",
                                                "text": "Il se promène, il joue à la paume, pour faire de l’exercice."
                                            },
                                            {
                                                "example_id": "571a150f-3e54-48e9-b627-7b61194003d6",
                                                "sense_id": "c5b38480-87cc-3171-ab84-b3803e68896b",
                                                "text": "L’exercice est bon pour la santé."
                                            },
                                            {
                                                "example_id": "c3ba1c16-4f1e-4a2d-b628-fe7324d8d1ec",
                                                "sense_id": "c5b38480-87cc-3171-ab84-b3803e68896b",
                                                "text": "Il aime mieux les exercices du corps que ceux de l’esprit."
                                            },
                                            {
                                                "example_id": "b5d4ce3b-c5cb-4e62-8a65-ff158734e02c",
                                                "sense_id": "c5b38480-87cc-3171-ab84-b3803e68896b",
                                                "text": "Prendre chaque jour de l’exercice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a56b8f98-45f0-3e1f-810e-3b60b9b896a1",
                                        "entry_id": "0b09cd99-086d-30db-bdca-acc1d4fb83d8",
                                        "glosses": [
                                            "Pratique régulière d’une discipline."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bddc818-d4bf-4082-9cf0-83c0a292d98a",
                                                "sense_id": "a56b8f98-45f0-3e1f-810e-3b60b9b896a1",
                                                "text": "[…] ; les propagateurs de réformes sociales, les utopistes et les démocrates avaient fait un tel abus de la Justice qu’on était en droit de regarder toute dissertation sur un tel sujet comme un exercice de rhétorique ou comme une sophistique destinée à égarer les personnes qui s’occupaient du mouvement ouvrier."
                                            },
                                            {
                                                "example_id": "d405ec30-0f25-4f64-8af9-b6ca3ea60ff8",
                                                "sense_id": "a56b8f98-45f0-3e1f-810e-3b60b9b896a1",
                                                "text": "Tandis que sous l’empire des anciennes lois, l’état de perruquier et celui de baigneur étuviste étaient assujettis à une réglementation sévère, l’exercice de la profession de sage-femme était abandonné aux premières venues."
                                            },
                                            {
                                                "example_id": "ac66ed71-444f-4fa8-b96e-2aa2fb8fd6ed",
                                                "sense_id": "a56b8f98-45f0-3e1f-810e-3b60b9b896a1",
                                                "text": "Exercices spirituels, certaines pratiques de dévotion qui se font soit collectivement dans les communautés religieuses, soit individuellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d10ff7e-a3f2-3f08-8306-91d4e5ac3231",
                                        "entry_id": "0b09cd99-086d-30db-bdca-acc1d4fb83d8",
                                        "glosses": [
                                            "Action de remplir les fonctions d’une charge, d’un emploi."
                                        ],
                                        "tags": [],
                                        "note": "Il se disait autrefois en parlant d’une charge, d’un emploi dont les fonctions étaient remplies par deux personnes qui se succédaient en vertu d’un roulement. Il se dit aujourd’hui en parlant des personnes qui remplissent une fonction temporaire, par opposition à celles qui l’ont remplie avant elles et en ont gardé le titre",
                                        "examples": [
                                            {
                                                "example_id": "b7d211d2-3fc9-4baf-8270-7da40b3950bd",
                                                "sense_id": "8d10ff7e-a3f2-3f08-8306-91d4e5ac3231",
                                                "text": "Sous les Carolingiens, les Capitulaires recommandent au Comte de veiller à la protection des orphelins ; il ne s’agit en somme que de l’exercice pratique de la mainbournie royale."
                                            },
                                            {
                                                "example_id": "1da73da6-5930-4153-9e4d-cacfba5ff659",
                                                "sense_id": "8d10ff7e-a3f2-3f08-8306-91d4e5ac3231",
                                                "text": "La justice française vient de trancher : des commerciaux de la société Ricard ont le droit de se plaindre de l’alcoolisme consubstantiel à l’exercice de leur métier."
                                            },
                                            {
                                                "example_id": "5240d684-7b6f-46f7-9608-6cc7eac2c641",
                                                "sense_id": "8d10ff7e-a3f2-3f08-8306-91d4e5ac3231",
                                                "text": "L’exercice d’une charge, d’un emploi."
                                            },
                                            {
                                                "example_id": "dccf5fe2-c18b-439a-aaff-76314564d24e",
                                                "sense_id": "8d10ff7e-a3f2-3f08-8306-91d4e5ac3231",
                                                "text": "Être dans l’exercice de ses fonctions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f1a6cf8-dc89-3c9c-b189-a61e42afa34a",
                                        "entry_id": "0b09cd99-086d-30db-bdca-acc1d4fb83d8",
                                        "glosses": [
                                            "Action d’user de quelque chose, de la faire valoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e4ec853-3341-4d10-ae68-1e4eea51f344",
                                                "sense_id": "7f1a6cf8-dc89-3c9c-b189-a61e42afa34a",
                                                "text": "L’exercice d’un droit, d’un privilège."
                                            },
                                            {
                                                "example_id": "27fe709d-d7fb-4c34-ba97-0100ad3d4708",
                                                "sense_id": "7f1a6cf8-dc89-3c9c-b189-a61e42afa34a",
                                                "text": "Les obstacles qui s’opposaient à l’exercice de son pouvoir, de son autorité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b5e6b3f-58a2-3b47-a397-ac593a7a5a2a",
                                        "entry_id": "0b09cd99-086d-30db-bdca-acc1d4fb83d8",
                                        "glosses": [
                                            "Année ; période entre deux dates déterminées."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eaa11cc-16d7-4291-8a3e-e0815a94b9a9",
                                                "sense_id": "5b5e6b3f-58a2-3b47-a397-ac593a7a5a2a",
                                                "text": "Le bilan traditionnel mesurait la solvabilité; il appliquait strictement les principes de prudence et d’indépendance des exercices et, orienté vers le passé, il considérait le présent comme la conséquence de ce passé."
                                            },
                                            {
                                                "example_id": "9252b42f-b572-473e-bd00-9dfeff94d148",
                                                "sense_id": "5b5e6b3f-58a2-3b47-a397-ac593a7a5a2a",
                                                "text": "Le 21 juin dernier, les délégués à l’assemblée générale de France Mutuelle se sont réunis à Paris, sous la présidence de Michel Dumoux, pour approuver les résultats de l’exercice 2021 et statuer sur diverses orientations proposées par le conseil d’administration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad506259-3709-3bff-b9e1-a1cf91c0d128",
                                        "entry_id": "0b09cd99-086d-30db-bdca-acc1d4fb83d8",
                                        "glosses": [
                                            "Visite qui se fait chez les contribuables, et principalement chez les marchands de vin et les aubergistes, pour assurer le paiement de l’impôt."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acfcc724-5bba-4acd-8f46-2c22b7ca4d30",
                                                "sense_id": "ad506259-3709-3bff-b9e1-a1cf91c0d128",
                                                "text": "Plusieurs villes demandèrent la suppression de l’exercice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
