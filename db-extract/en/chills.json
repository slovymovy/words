                                "target_senses": [
                                    {
                                        "sense_id": "0db69f8e-f0ab-355d-8f92-a60c23b72477",
                                        "entry_id": "81fa3848-0d24-3f05-8be2-79d9829b47db",
                                        "glosses": [
                                            "дрожь от ощущения холода при лихорадочном состоянии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a34d151-7bb1-4316-9330-dc2b0a70d3cd",
                                                "sense_id": "0db69f8e-f0ab-355d-8f92-a60c23b72477",
                                                "text": "После обеда я почувствовал озноб и жар."
                                            },
                                            {
                                                "example_id": "ed964b50-b535-46ff-9e1c-3f3afa465c6c",
                                                "sense_id": "0db69f8e-f0ab-355d-8f92-a60c23b72477",
                                                "text": "Во время рассвета холодок резким ознобом прошёлся по телу."
                                            },
                                            {
                                                "example_id": "4d2f4015-47af-4c7a-979d-e9aa7dadb196",
                                                "sense_id": "0db69f8e-f0ab-355d-8f92-a60c23b72477",
                                                "text": "Его бросает то в жар, то в озноб."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
