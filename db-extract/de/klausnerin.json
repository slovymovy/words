                "senses": [
                    {
                        "sense_id": "9a2932a5-b8f7-3ae4-b715-206711d2bd9c",
                        "entry_id": "3889e4ca-3469-3696-a443-489d04b87d83",
                        "glosses": [
                            "Frau, die in einer Klause lebt"
