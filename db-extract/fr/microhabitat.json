                ],
                "senses": [
                    {
                        "sense_id": "faec68eb-1015-37ea-9b31-926fcceccc0d",
                        "entry_id": "e4e3e34a-e236-30be-a5d4-33c40e3be7c4",
                        "glosses": [
                            "Petit espace environnemental, au sein d'un habitat plus vaste, réunissant des conditions particulières (eau ou humidité, température, salinité, couverture pour abri ou reproduction, etc.) propres à certaines espèces vivantes qui dépendent étroitement de ces conditions."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "9d9e8e24-dc68-4c62-94ef-3b1bbe44aff4",
                                "sense_id": "faec68eb-1015-37ea-9b31-926fcceccc0d",
                                "text": "Un balai de sorcière fournit un microhabitat propice à la nidification de corvidés ou de polatouches ainsi qu'à toute la communauté biologique qui accompagne ces espèces."
                            },
                            {
                                "example_id": "b18486cd-c385-4871-b07b-c7e0c87da886",
                                "sense_id": "faec68eb-1015-37ea-9b31-926fcceccc0d",
                                "text": "En offrant une température plus favorable, une humidité plus élevée et un sol plus riche, une vallée profonde encaissée au sein d'une chaîne de montagnes peut constituer un microhabitat pour une communauté d'espèces animales, végétales et microbiennes particulières que l'on ne peut rencontrer que dans un lieu similaire."
                            },
                            {
                                "example_id": "bab2e728-065b-429c-b895-ab2f80e5250d",
                                "sense_id": "faec68eb-1015-37ea-9b31-926fcceccc0d",
                                "text": "L'échelle la plus fine, celle du microhabitat, correspond au positionnement instantané d'un individu en phase de repos ou d'alimentation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
