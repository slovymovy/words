                                        "entry_id": "12c8fd83-af26-3c69-b5b0-ab88c3687f2a",
                                        "glosses": [
                                            "Of petty or trivial importance; footling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b450a04-799e-4de0-b28a-f1c30f5d43e2",
                                                "sense_id": "5bb87929-5a3a-36b2-a64c-6b2b502a1174",
                                                "text": "It was a fiddling little fault, but ultimately proved disastrous."
                                            }
                                        ]
                                    }
                                ]
