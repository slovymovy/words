{
    "word_family": [
        "syndication",
        "syndicated",
        "syndic",
        "syndicalism",
        "syndicalist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8577b5a-7104-3a20-839c-1bb764e99918",
                    "sense_definition": "A group of individuals or companies formed to transact some specific business or to promote a common interest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organized_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>syndicate</w> of investors decided to fund the new tech startup.",
                            "target_lang_translations": {
                                "ru": "Местный <w>синдикат</w> инвесторов решил профинансировать новый технологический стартап."
                            }
                        },
                        {
                            "text": "A powerful business <w>syndicate</w> controlled most of the city's real estate market.",
                            "target_lang_translations": {
                                "ru": "Мощный деловой <w>синдикат</w> контролировал большую часть рынка недвижимости города."
                            }
                        }
                    ],
                    "synonyms": [
                        "consortium",
                        "association",
                        "alliance",
                        "coalition"
                    ],
                    "common_phrases": [
                        "business syndicate",
                        "investment syndicate",
                        "banking syndicate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа лиц или компаний, сформированная для ведения определенного бизнеса или продвижения общих интересов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синдикат",
                                "target_lang_sense_clarification": "бизнес-объединение"
                            },
                            {
                                "target_lang_word": "консорциум",
                                "target_lang_sense_clarification": "временное объединение для проекта"
                            },
                            {
                                "target_lang_word": "объединение",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cf6eb5a-e3a7-34f9-83dc-5c75459187e2",
                    "sense_definition": "An agency or group of media companies formed to acquire content and publish it in multiple outlets.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "organized_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper <w>syndicate</w> distributes comic strips to hundreds of daily papers.",
                            "target_lang_translations": {
                                "ru": "Газетный <w>синдикат</w> распространяет комиксы в сотни ежедневных газет."
                            }
                        },
                        {
                            "text": "He sold his column to a national <w>syndicate</w> to reach a wider audience.",
                            "target_lang_translations": {
                                "ru": "Он продал свою колонку национальному <w>синдикату</w>, чтобы охватить более широкую аудиторию."
                            }
                        }
                    ],
                    "synonyms": [
                        "agency",
                        "network"
                    ],
                    "common_phrases": [
                        "newspaper syndicate",
                        "media syndicate",
                        "press syndicate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Агентство или группа медиакомпаний, созданная для приобретения контента и его публикации в различных изданиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синдикат",
                                "target_lang_sense_clarification": "информационное или газетное агентство"
                            },
                            {
                                "target_lang_word": "медиа-агентство",
                                "target_lang_sense_clarification": "распространитель контента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efbfc425-ffc9-34ed-a5b5-b6d2d232dec0",
                    "sense_definition": "A group of gangsters or criminals engaged in organized crime.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "organized_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police spent years trying to dismantle the international crime <w>syndicate</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция потратила годы, пытаясь ликвидировать международный преступный <w>синдикат</w>."
                            }
                        },
                        {
                            "text": "Authorities believe the <w>syndicate</w> is responsible for the recent wave of smuggling.",
                            "target_lang_translations": {
                                "ru": "Власти полагают, что этот <w>синдикат</w> несет ответственность за недавнюю волну контрабанды."
                            }
                        }
                    ],
                    "synonyms": [
                        "mob",
                        "gang",
                        "cartel",
                        "mafia"
                    ],
                    "common_phrases": [
                        "crime syndicate",
                        "gambling syndicate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа гангстеров или преступников, занимающихся организованной преступностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синдикат",
                                "target_lang_sense_clarification": "преступная организация"
                            },
                            {
                                "target_lang_word": "группировка",
                                "target_lang_sense_clarification": "организованная преступная группа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bdc093f-4d06-3ce3-b160-e179aae942dd",
                    "sense_definition": "A body or council of syndics, or the office and jurisdiction they hold.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "organized_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university <w>syndicate</w> met to discuss the new academic regulations.",
                            "target_lang_translations": {
                                "ru": "Университетский <w>совет</w> собрался для обсуждения новых академических правил."
                            }
                        },
                        {
                            "text": "Decisions regarding the estate were left to the administrative <w>syndicate</w>.",
                            "target_lang_translations": {
                                "ru": "Решения относительно имущества были оставлены на усмотрение административного <w>совета</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "council",
                        "board",
                        "committee"
                    ],
                    "common_phrases": [
                        "university syndicate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in administrative or university contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совет или орган синдиков, а также их канцелярия или юрисдикция."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синдикат",
                                "target_lang_sense_clarification": "административный совет, например, в университете"
                            },
                            {
                                "target_lang_word": "совет",
                                "target_lang_sense_clarification": "управляющий орган"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "021d7597-7d2c-3a97-824b-e97f65e60dda",
                    "sense_definition": "To release media content through a syndicate to be broadcast or published through multiple outlets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The production company plans to <w>syndicate</w> content to various international television networks.",
                            "target_lang_translations": {
                                "ru": "Производственная компания планирует <w>синдицировать</w> контент для различных международных телевизионных сетей."
                            }
                        },
                        {
                            "text": "Successful sitcoms are often <w>syndicated</w> after they finish their original run.",
                            "target_lang_translations": {
                                "ru": "Успешные ситкомы часто <w>передаются для повторного показа</w> после завершения их оригинального проката."
                            }
                        }
                    ],
                    "synonyms": [
                        "distribute",
                        "broadcast",
                        "circulate"
                    ],
                    "common_phrases": [
                        "syndicate content",
                        "syndicate a show",
                        "syndicate a column"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпускать медиаконтент через синдикат для трансляции или публикации во многих изданиях одновременно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синдицировать",
                                "target_lang_sense_clarification": "распространять через сеть изданий"
                            },
                            {
                                "target_lang_word": "продавать право на публикацию",
                                "target_lang_sense_clarification": "передавать контент многим СМИ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40eb6e14-f88d-3adf-a8a4-91c27a5c8db5",
                    "sense_definition": "To put under the control of a group acting as a unit, especially for financial purposes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank will <w>syndicate</w> a loan among several other financial institutions.",
                            "target_lang_translations": {
                                "ru": "Банк <w>синдицирует</w> кредит между несколькими другими финансовыми институтами."
                            }
                        },
                        {
                            "text": "They decided to <w>syndicate</w> the investment to reduce individual risk.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>объединить</w> инвестиции, чтобы снизить индивидуальный риск."
                            }
                        }
                    ],
                    "synonyms": [
                        "pool",
                        "organize"
                    ],
                    "common_phrases": [
                        "syndicate a loan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать под контроль группы, действующей как единое целое, особенно в финансовых целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синдицировать",
                                "target_lang_sense_clarification": "объединять ресурсы, например, для кредита"
                            },
                            {
                                "target_lang_word": "объединять",
                                "target_lang_sense_clarification": "формировать пул инвесторов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48077c83-2e6d-31af-a5e8-6ef87944e59b",
                    "sense_definition": "To form or become a syndicate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "organize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small businesses chose to <w>syndicate</w> in order to compete with larger corporations.",
                            "target_lang_translations": {
                                "ru": "Малые предприятия решили <w>объединиться в синдикат</w>, чтобы конкурировать с более крупными корпорациями."
                            }
                        },
                        {
                            "text": "After months of negotiation, the independent developers finally <w>syndicated</w>.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев переговоров независимые разработчики наконец <w>объединились</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unite",
                        "combine",
                        "associate"
                    ],
                    "antonyms": [
                        "separate",
                        "dissolve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формировать синдикат или объединяться в него."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединяться в синдикат",
                                "target_lang_sense_clarification": "создавать союз предприятий"
                            },
                            {
                                "target_lang_word": "сформировать синдикат",
                                "target_lang_sense_clarification": "организовать объединение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}