        "fr-extract.jsonl": [
            {
                "entry_id": "eabbd724-1e27-334e-98e7-ea88891668ca",
                "word": "mercanti",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "85eeee9a-657f-4a27-b71b-0f11655e544e",
                        "entry_id": "eabbd724-1e27-334e-98e7-ea88891668ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "mercantis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "686a7e18-b7a1-340d-9628-b371387c9e45",
                        "entry_id": "eabbd724-1e27-334e-98e7-ea88891668ca",
                        "glosses": [
                            "Marchand, dans les pays d’Orient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ef2f069-e063-4ee3-a2d9-b998b9092a97",
                                "sense_id": "686a7e18-b7a1-340d-9628-b371387c9e45",
                                "text": "Pour concrétiser sa mise hors course, elle tira sur le bas de sa mini-jupe, comme un mercanti baissant le rideau de fer."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d4f063f-a869-3a87-86c5-97a9b8792f9c",
                        "entry_id": "eabbd724-1e27-334e-98e7-ea88891668ca",
                        "glosses": [
                            "Homme qui fait argent de tout."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "be180fc9-8054-41b8-98e2-f8be1f60df97",
                                "sense_id": "6d4f063f-a869-3a87-86c5-97a9b8792f9c",
                                "text": "On croit mourir pour la patrie, et on crève pour des combines de mercantis, prompts à engraisser, à travers tous les charniers, leurs dividendes."
                            },
                            {
                                "example_id": "09c25194-3921-4ebd-b2ef-0579248e16d3",
                                "sense_id": "6d4f063f-a869-3a87-86c5-97a9b8792f9c",
                                "text": "C'est alors qu'il fit la connaissance de Lambton, un hideux mercanti qui, non content de s'attribuer la plus large part des revenus de ses découvertes, voulut diriger celles-ci pour les besoins d'une affreuse guerre."
                            },
                            {
                                "example_id": "5141b2b4-68c2-4d1f-a7fb-cd477e608105",
                                "sense_id": "6d4f063f-a869-3a87-86c5-97a9b8792f9c",
                                "text": "Mesdames, approvisionnez-vous au marché blanc, et zut pour les mercantis !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90ffe428-50f7-4ffc-b3de-8de3826942b5",
                        "source_entry_id": "eabbd724-1e27-334e-98e7-ea88891668ca",
                        "source_sense_description": "Marchant en Orient",
                        "target_lang_word": "Schieber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schieber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00be2c0a-880b-36b6-bf70-6a3fe96dca0a",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "eine Schiebetür oder ein Schiebeverschluss an Türen und Fenstern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c7707a-72b1-4f97-965a-0543a3ffe1c1",
                                                "sense_id": "00be2c0a-880b-36b6-bf70-6a3fe96dca0a",
                                                "text": "„Gehegeeinfriedungen im Sinne dieser Regel sind Einrichtungen, die Gehege unmittelbar begrenzen, einschließlich der zugehörigen Türen, Tore und Schieber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d928cde2-35ac-3143-aaf5-40ea299ee709",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "eine Absperrvorrichtung in Rohrleitungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b22aaa9b-7fc9-48f2-a3c8-ac183db369c9",
                                                "sense_id": "d928cde2-35ac-3143-aaf5-40ea299ee709",
                                                "text": "Die Leitung kann bei Bedarf mit einem Schieber geschlossen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "ein gewissenloser Gelegenheitshändler, der Waren mit horrenden Gewinnen verschiebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e506dd3-7a38-433e-b14e-a094a285d1d8",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„Doch noch immer ist das Lokal ein Platz für Schieber und Geschäfte.“"
                                            },
                                            {
                                                "example_id": "0e93189a-f968-4e48-8f7c-0b8b0dc2b824",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„Hinter Schieber-Schmidts Texttilhaus entdeckte Kurt ein Auto, einen grauen Vorkriegs-Opel; denn wer ein richtiger Schieber sein will, muß vor allem schnell sein.“"
                                            },
                                            {
                                                "example_id": "4c492603-8ae9-4c7c-8761-1891428dd61b",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„Gräger ist das Lokal der Schieber, da geht es fast jeden Tag bis morgens durch.“"
                                            },
                                            {
                                                "example_id": "8aeec590-339c-4a8b-8310-b9e31921f3f8",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„In Nepplokalen war es ein Ruhmestitel, ein Schieber zu sein.“"
                                            },
                                            {
                                                "example_id": "581ff7c9-54d1-4045-80ea-15edcd141794",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„Schlump war kein geborener Schieber.“"
                                            },
                                            {
                                                "example_id": "77b6a51b-43c6-4fee-af7c-1c3d980d2d9d",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„Weinhändler, Fälscher, Schmuggler, Emigranten und Schieber saßen im »Brûleur de Loup«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "931d6ade-9d42-3df5-910a-c4e580283e31",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "ein Tanz, ähnlich dem Onestepp"
                                        ],
                                        "tags": [
                                            "Tanz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4358ad-4861-4854-8476-73aac455609e",
                                                "sense_id": "931d6ade-9d42-3df5-910a-c4e580283e31",
                                                "text": "„Der galante Carl Brutal tanzt den Schieber jetzt nochmal und er schiebt die Lady nett übers glänzende Parkett“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "142f2052-36cc-315b-ab62-c114486bb233",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "Bettpfanne für Patienten, die den Weg zur Toilette nicht bewältigen können oder dürfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f380f5-2fa9-4b96-9267-ee7fb292d9d8",
                                                "sense_id": "142f2052-36cc-315b-ab62-c114486bb233",
                                                "text": "Da er bettlägerig ist, braucht er einen Schieber."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f9e81387-46b6-3327-8e3a-bc5d92b0d885",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "Gerät, mit dem man etwas verschieben kann"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "7398d59b-1cf6-3682-8d05-d14b80275ca2",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "Person, die illegale, unsaubere Handlungen betreibt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
