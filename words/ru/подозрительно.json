                    "sense_id": "c1d8a4ec-553a-39e3-84f1-477a7c9325b8",
                    "sense_definition": "Странно, необычно, вызывая сомнения, недоверие или опасения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В пустом доме было <подозрительно> тихо для середины дня.",
                            "target_lang_translations": {
                                "en": "It was <suspiciously> quiet in the empty house for the middle of the day.",
                                "es": "En la casa vacía estaba <sospechosamente> tranquilo para ser mitad del día.",
                                "fr": "La maison vide était <suspectement> calme pour le milieu de la journée."
                            }
                        },
                        {
                            "text": "Этот дешёвый товар выглядит слишком <подозрительно>, чтобы быть качественным.",
                            "target_lang_translations": {
                                "en": "This cheap product looks too <suspicious> to be of high quality.",
                                "es": "Este producto barato parece demasiado <sospechoso> como para ser de buena calidad.",
                                "fr": "Ce produit bon marché a l'air trop <suspect> pour être de qualité."
                            }
                        }
                    ],
                    "synonyms": [
                        "сомнительно",
                        "странно",
                        "нечисто"
                    ],
                    "antonyms": [
                        "естественно",
                        "обычно",
                        "убедительно"
                    ],
                    "common_phrases": [
                        "подозрительно тихо",
                        "подозрительно знакомый",
                        "выглядеть подозрительно",
                        "вести себя подозрительно"
                    ],
                    "target_lang_definitions": {
