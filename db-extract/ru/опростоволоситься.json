                    },
                    {
                        "translation_id": "d7312814-692e-44f2-bbcf-52230f76f7f7",
                        "source_entry_id": "445711d2-79e6-36e9-a99f-e3eb2f70ad3c",
                        "source_sense_description": "совершить промах, ошибку",
                        "target_lang_word": "gaffer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaffer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c04679d-868c-3907-aa89-dc7ab3184be3",
                                        "entry_id": "24ad17d6-ed0d-33ee-b112-bdd32348353b",
                                        "glosses": [
                                            "Ruban adhésif large et particulièrement résistant, généralement renforcé par un tissage, d’usage courant dans le monde du spectacle ou l’installation évènementielle en général."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a7f192-c03b-471c-8cdd-11fddf254893",
                                                "sense_id": "2c04679d-868c-3907-aa89-dc7ab3184be3",
                                                "text": "Tu peux redonner un coup de gaffer au projecteur, j’ai peur qu’il ne tombe pendant la soirée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gaffer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff03069-7c07-34dd-be51-956efb020e85",
                                        "entry_id": "540afd48-3ff8-3d34-9ac0-206aa7d2857d",
                                        "glosses": [
                                            "Accrocher quelque chose avec une gaffe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "438c4e5b-ef81-33df-aaee-bc2c3d5b1190",
                                        "entry_id": "540afd48-3ff8-3d34-9ac0-206aa7d2857d",
                                        "glosses": [
                                            "Mettre du gaffer sur quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "056a547d-a76e-4848-9c68-1198c820cecd",
                                                "sense_id": "438c4e5b-ef81-33df-aaee-bc2c3d5b1190",
                                                "text": "Tu peux gaffer le projecteur, j’ai peur qu’il ne tombe pendant la soirée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cd64594-3d5e-3882-9076-647c934c971c",
                                        "entry_id": "540afd48-3ff8-3d34-9ac0-206aa7d2857d",
                                        "glosses": [
                                            "Commettre une gaffe, dire ou faire ce qu’il n’eût fallu ni dire ni faire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cedce48-e2fb-4cb3-935c-7a2568a8994b",
                                                "sense_id": "1cd64594-3d5e-3882-9076-647c934c971c",
                                                "text": "Je ne veux pas du tout me mêler à la cérémonie ; d’abord, je n’y connais rien et je gafferais, ensuite je ne veux pas me couvrir de ridicule."
                                            },
                                            {
                                                "example_id": "d8308fd2-b037-4687-8cfe-946f728a6f35",
                                                "sense_id": "1cd64594-3d5e-3882-9076-647c934c971c",
                                                "text": "Hubert pensait que sa lourde sœur « gaffait », et que j’étais atteint dans mon orgueil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19961610-534d-352f-9356-9610b2127cd9",
                                        "entry_id": "540afd48-3ff8-3d34-9ac0-206aa7d2857d",
                                        "glosses": [
                                            "Remarquer, faire attention, prendre garde, faire gaffe."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aac171bd-0ff4-4aec-ab4a-8ed853fb63f3",
                                                "sense_id": "19961610-534d-352f-9356-9610b2127cd9",
                                                "text": "– Ils ont l’air si sérieux que ça, les Instituteurs ?\n– C’est pas ça. J’en ai connu qui étaient des rigolos, mais ils ont un air, comme ça… Je vais te dire, c’est d’enseigner les mômes qui leur donne cet air-là… Ils ont l’air, je vais te dire, comme quoi ils seraient toujours en train de gaffer que tu ne dises pas de conneries."
                                            },
                                            {
                                                "example_id": "03515af1-8f45-4115-bf95-71a21695e350",
                                                "sense_id": "19961610-534d-352f-9356-9610b2127cd9",
                                                "text": "Elle croise ses jambes sans gaffer que sa jupe a remonté de vingt centimètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da404dc6-ccb6-373e-9d2b-5b39f29e674a",
                                        "entry_id": "540afd48-3ff8-3d34-9ac0-206aa7d2857d",
                                        "glosses": [
                                            "Regarder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb890907-be51-4100-988d-fdb777374db2",
                                                "sense_id": "da404dc6-ccb6-373e-9d2b-5b39f29e674a",
                                                "text": "Attendant comme toujours qu’on lui demande la suite, le Dabe nous gaffait."
                                            },
                                            {
                                                "example_id": "6b017092-afab-4d25-90d0-ed58a7e935ac",
                                                "sense_id": "da404dc6-ccb6-373e-9d2b-5b39f29e674a",
                                                "text": "Oui, mais, j’ai idée que d’abord je vais faire un tour jusqu’à ma carrée et gaffer si Washington a envoyé les renseignements que j’ai demandés …."
                                            },
                                            {
                                                "example_id": "9e59cd33-1218-4807-9ffd-e8a028cccd07",
                                                "sense_id": "da404dc6-ccb6-373e-9d2b-5b39f29e674a",
                                                "text": "— I dérouillent ! I dérouillent, les Fridolins !… Tiens… Gaffe çui-là… Un coup dans le cigare… Éclaté, qu’il a ! Éclaté !"
                                            },
                                            {
                                                "example_id": "cba8af7d-3db1-42ac-90d1-5ad07c29af25",
                                                "sense_id": "da404dc6-ccb6-373e-9d2b-5b39f29e674a",
                                                "text": "Là alors, j’ai mieux gaffé. C'était juste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
