                "senses": [
                    {
                        "sense_id": "043caa9a-5c3b-3282-b568-2392c8a5c83e",
                        "entry_id": "d1de5118-aa1a-3b26-b7a5-bd893f168dc4",
                        "glosses": [
                            "(vor allem männliche) Person athletischen Körperbaus, die diesen in prahlerischer Weise zur Schau stellt"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "035e2828-1632-4d30-ab05-55c86dbc4193",
                                "sense_id": "043caa9a-5c3b-3282-b568-2392c8a5c83e",
                                "text": "„[…] Auch wenn die Leute im Zeitalter des Körperkults Trendsportarten wie etwa Nordic-Walking nachgehen und so mancher Muskelprotz seinen Adonis-Körper wie besessen in der »Mucki-Bude« aufpumpt, so nimmt das Maß an gesunder Bewegung doch insgesamt immer mehr ab […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
