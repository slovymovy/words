                ],
                "senses": [
                    {
                        "sense_id": "93969e78-f26b-3f95-8d8c-51e2665d92f2",
                        "entry_id": "1536fbff-b8dd-3571-90af-914b55e691a6",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße mit Risiken verbunden ist und von wenig Verantwortungsübernahme zeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed95b653-8079-4a18-9bf8-23179f084895",
                                "sense_id": "93969e78-f26b-3f95-8d8c-51e2665d92f2",
                                "text": "Oft geht Unerfahrenheit mit Leichtsinnigkeit einher, wer die Gefahren nicht kennt, scheut das Risiko weniger als andere."
                            },
                            {
                                "example_id": "1dbefa7d-e9bb-432c-a6de-83b7594f42c9",
                                "sense_id": "93969e78-f26b-3f95-8d8c-51e2665d92f2",
                                "text": "Ihren kleinen Bruder musste sie häufig vor Leichtsinnigkeiten bewahren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb84739c-e93d-4338-930f-f36bcd6c3360",
                        "source_entry_id": "1536fbff-b8dd-3571-90af-914b55e691a6",
                        "source_sense_id": "93969e78-f26b-3f95-8d8c-51e2665d92f2",
                        "target_lang_word": "frivolity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frivolity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "853531fc-6987-300c-9b07-84820c0c19d0",
                                        "entry_id": "3424423d-a924-3b0c-81e0-caf49615a5ae",
                                        "glosses": [
                                            "frivolous act"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31533a49-e5ea-3020-997b-70f032aaad10",
                                        "entry_id": "3424423d-a924-3b0c-81e0-caf49615a5ae",
                                        "glosses": [
                                            "state of being frivolous"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b373a99-f65b-4067-832c-da8a4ef9d013",
                                                "sense_id": "31533a49-e5ea-3020-997b-70f032aaad10",
                                                "text": "The sight of their own blood in the white snow may even have been what provided the jolt to transform them from playful children recklessly delighting in the surprise of an unseasonable snowfall into a whooping army of mutineers urged on by a tiny cadre of seditious underclassmen to turn their rambunctious frivolity into stunning mischief and, with an outburst of everything untamed in them (despite regular attendance at chapel), to tumble and roll and skid down the Hill through the deep snow and commence a stupendous night out."
                                            },
                                            {
                                                "example_id": "fe67d5ab-77f3-418d-996a-8f7e9eeaf3ed",
                                                "sense_id": "31533a49-e5ea-3020-997b-70f032aaad10",
                                                "text": "“Look at this festive assembly. All of us, gathered here together, chuckling at jokes and silliness.” [laughter] “And jackanapery.” [rim shots] “I guess there's only one thing left to say. What is this shit?” [rim shot] [laughter] “[laughs] Very good.” “You call yourselves vampires? Bah. This entire evening has been nothing but a pageant of insipid nonsense.” “[laughing] Yes.” “Worshipping at the altar of your own mediocre frivolity. A jester's hollow dance. And who is laughing?” “Yeah! [whoops] [grunts]” “Vampires are supposed to have blood orgies and slaughter circles. Gah! You have all gone soft. You even invited humans to this asinine affair.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bfa8d2e-fe49-4db6-abc6-6ac97def8811",
                        "source_entry_id": "1536fbff-b8dd-3571-90af-914b55e691a6",
                        "source_sense_id": "93969e78-f26b-3f95-8d8c-51e2665d92f2",
                        "target_lang_word": "imprudence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprudence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "319fad84-5a6a-3653-a166-9869afb49a27",
                                        "entry_id": "823a65f2-2575-3df7-8e49-0d3a49265500",
                                        "glosses": [
                                            "The quality or state of being imprudent; lack of prudence, caution, discretion or circumspection."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e07e4510-85a9-4a6b-ac38-d8da7a56ef78",
                                                "sense_id": "319fad84-5a6a-3653-a166-9869afb49a27",
                                                "text": "[Hamilton were to have said:] nothing but a permanent body can check the imprudence of democracy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                        "entry_id": "823a65f2-2575-3df7-8e49-0d3a49265500",
                                        "glosses": [
                                            "An imprudent act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec62516-4bd2-4e86-8f74-f7a2da31b43d",
                                                "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                                "text": "Ah: my dear—Madam there is the great mistake—'tis this very conscious Innocence that is of the greatest Prejudice to you—what is it makes you negligent of Forms and careless of the world's opinion—why the consciousness of your Innocence—what makes you thoughtless in your Conduct and apt to run into a thousand little imprudences—"
                                            },
                                            {
                                                "example_id": "737aff09-ec76-4142-b0f0-763d969caebe",
                                                "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                                "text": "At about the age of twenty-three, to crown his other imprudences, he married, without improving his reduced circumstances thereby."
                                            },
                                            {
                                                "example_id": "5f86fecc-c27a-47d1-a860-0e39e226aeef",
                                                "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                                "text": "Yes, for six months he threw all his medicines in the fire, and designedly committed all sorts of imprudences."
                                            },
                                            {
                                                "example_id": "31956025-e103-4ef4-9686-45211afa3155",
                                                "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                                "text": "This man finally fell a victim to his diplomacies, perhaps also to his imprudences."
                                            },
                                            {
                                                "example_id": "9369938f-25a2-4396-abcb-e9119e76a255",
                                                "sense_id": "c2bb9803-fb7e-310b-ae7c-ba048bd1feb6",
                                                "text": "He [Timothy Forsyte] had never committed the imprudence of marrying or encumbering himself in any way with children."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
