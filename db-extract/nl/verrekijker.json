                "senses": [
                    {
                        "sense_id": "be42dc32-f295-3d29-a715-263a61f031b2",
                        "entry_id": "a809a7fe-afe6-3fa1-9833-db992d7d3295",
                        "glosses": [
                            "een optisch instrument om voorwerpen op grote afstand te kunnen waarnemen door het vergrotend effect van het instrument"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8d3e273-7290-4fce-a9c2-ab55af8b08ad",
                                "sense_id": "be42dc32-f295-3d29-a715-263a61f031b2",
                                "text": "Met een verrekijker kon men de krijtrotsen van de Engelse kust reeds van verre zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f11698df-9307-455c-b521-9453d3351c46",
                        "source_entry_id": "a809a7fe-afe6-3fa1-9833-db992d7d3295",
                        "source_sense_id": "be42dc32-f295-3d29-a715-263a61f031b2",
                        "source_sense_description": "een optisch instrument om voorwerpen op grote afstand te kunnen waarnemen door het vergrotend effect van het instrument",
                        "target_lang_word": "Fernglas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernglas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45c90b60-bff5-3872-84ef-4f10e8ce6b8f",
                                        "entry_id": "b56907c9-b05a-3bff-8c17-2bf1e70422db",
                                        "glosses": [
                                            "optisches Gerät, um über größere Entfernungen blicken zu können als mit bloßem Auge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79a727bb-bde2-4596-a328-968059116782",
                                                "sense_id": "45c90b60-bff5-3872-84ef-4f10e8ce6b8f",
                                                "text": "Mein Nachbar steht immer mit dem Fernglas am Fenster und beobachtet die anderen Anwohner."
                                            },
                                            {
                                                "example_id": "c26de719-72ea-4a4a-b5e8-8c68d8c4842c",
                                                "sense_id": "45c90b60-bff5-3872-84ef-4f10e8ce6b8f",
                                                "text": "„Croft setzte sein Fernglas an und blickte hinüber.“"
                                            },
                                            {
                                                "example_id": "f861e253-415a-477b-8c62-f30f5f65cf97",
                                                "sense_id": "45c90b60-bff5-3872-84ef-4f10e8ce6b8f",
                                                "text": "„Bobby holte das Fernglas aus dem Handschuhfach in der Fahrerkabine und legte sich in das lange Gras auf den Rücken, während Rosa sich quer auf seinen Bauch fallen ließ.“"
                                            },
                                            {
                                                "example_id": "15eadc84-c5c2-44cc-a8bd-7b65b524dd9c",
                                                "sense_id": "45c90b60-bff5-3872-84ef-4f10e8ce6b8f",
                                                "text": "„Auf einer Höhe stand ein General mit ein paar Offizieren und sah durchs Fernglas nach vorn.“"
                                            },
                                            {
                                                "example_id": "3f3664b9-d2df-4988-84c8-cd14f239f1dd",
                                                "sense_id": "45c90b60-bff5-3872-84ef-4f10e8ce6b8f",
                                                "text": "„Durch das Fernglas erkannte ich die Narben, die einige der Tiere bei Kämpfen davongetragen hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b226c30-28c9-41ec-9b64-5effb5b78030",
                        "source_entry_id": "a809a7fe-afe6-3fa1-9833-db992d7d3295",
                        "source_sense_id": "be42dc32-f295-3d29-a715-263a61f031b2",
                        "source_sense_description": "een optisch instrument om voorwerpen op grote afstand te kunnen waarnemen door het vergrotend effect van het instrument",
                        "target_lang_word": "Fernrohr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernrohr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb90d484-d935-370d-b172-6e48b860c519",
                                        "entry_id": "12c3c54e-0091-3eb0-893c-fa4a4030a572",
                                        "glosses": [
                                            "optisches Gerät mit nur einem Okular zur Verbesserung der Fernsicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c020807e-25e6-4646-a742-3c0613a1fef2",
                                                "sense_id": "cb90d484-d935-370d-b172-6e48b860c519",
                                                "text": "Alle richteten ihre Fernrohre auf den sich verfinsternden Mond."
                                            },
                                            {
                                                "example_id": "e7b356b5-d961-438b-b2a1-1753f2a7948a",
                                                "sense_id": "cb90d484-d935-370d-b172-6e48b860c519",
                                                "text": "„Vorsichtig legte Tóvó das Fernrohr auf den Tisch und schob es dem Doktor zu, mit dem Zeigefinger auf der dunkelroten Seide.“"
                                            },
                                            {
                                                "example_id": "47f1f02b-eaf5-40b2-ac99-13c9c844a2a0",
                                                "sense_id": "cb90d484-d935-370d-b172-6e48b860c519",
                                                "text": "„Die beiden Generäle und ihre Adjutanten griffen nach dem Fernrohr und rissen es einander geradezu aus den Händen.“"
                                            },
                                            {
                                                "example_id": "6805aea4-ff38-4c3d-b4dd-fe6a6ca9556d",
                                                "sense_id": "cb90d484-d935-370d-b172-6e48b860c519",
                                                "text": "„Es genügte für Galilei zu erfahren, nach welchem Prinzip die Holländer vorgingen, um sofort ein solches Fernrohr anfertigen zu lassen.“"
                                            },
                                            {
                                                "example_id": "c34499a4-e6ed-4884-9c74-870a45ff39c1",
                                                "sense_id": "cb90d484-d935-370d-b172-6e48b860c519",
                                                "text": "„Er erlaubte Melchior, durch sein Fernrohr zu sehen, doch war es nicht schärfer als Melchiors eignes Glas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f72e3aa-63ff-4719-afdc-0726e9f6a494",
                        "source_entry_id": "a809a7fe-afe6-3fa1-9833-db992d7d3295",
