                        "entry_id": "b2c2f6c8-486a-3bb0-b1a3-3b7bf3796ff7",
                        "glosses": [
                            "a constituency, a district for the purpose of electoral representation"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "560a71ee-2d86-4d2e-b3b2-a31df4f65845",
                                "sense_id": "e5212040-3d8e-39ba-b99f-5d114b765716",
                                "text": "Elk land is verdeeld in verschillende kiesdistricten voor verkiezingsdoeleinden.",
                                "translation": "Each country is divided into different constituencies for electoral representation.",
                                "english": "Each country is divided into different constituencies for electoral representation."
                            },
                            {
                                "example_id": "84c4cc73-d57f-4768-b507-9d4af0e05fb9",
                                "sense_id": "e5212040-3d8e-39ba-b99f-5d114b765716",
                                "text": "In welk kiesdistrict woon je en wie zijn de kandidaten daar?",
                                "translation": "In which constituency do you live, and who are the candidates there?",
                                "english": "In which constituency do you live, and who are the candidates there?"
                            },
                            {
                                "example_id": "83070f38-5feb-4d92-83b0-814eb061db02",
                                "sense_id": "e5212040-3d8e-39ba-b99f-5d114b765716",
                                "text": "De grenzen van de kiesdistricten worden soms herzien om een eerlijke vertegenwoordiging te waarborgen.",
                                "translation": "The boundaries of the constituencies are sometimes revised to ensure fair representation.",
                                "english": "The boundaries of the constituencies are sometimes revised to ensure fair representation."
                            },
                            {
                                "example_id": "445a65e5-f7bb-4b4e-8db3-09607ba84266",
                                "sense_id": "e5212040-3d8e-39ba-b99f-5d114b765716",
                                "text": "Kiezers in elk kiesdistrict hebben de kans om hun stem uit te brengen tijdens de verkiezingen.",
                                "translation": "Voters in each constituency have the opportunity to cast their vote during the elections.",
                                "english": "Voters in each constituency have the opportunity to cast their vote during the elections."
                            }
                        ]
                    }
