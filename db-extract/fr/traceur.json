                "senses": [
                    {
                        "sense_id": "bab07cec-5b3a-37aa-8a98-75683aa84f05",
                        "entry_id": "d4e24d79-25e1-3ce6-9906-bae5967ac51b",
                        "glosses": [
                            "Variante de traçant."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d9a649e4-ca79-47d3-a96a-8f5b3ab8e8a0",
                                "sense_id": "bab07cec-5b3a-37aa-8a98-75683aa84f05",
                                "text": "Il voit partir vers lui les projectiles traceurs : « La plaine crépite tout entière de courtes mèches lumineuses »"
                            },
                            {
                                "example_id": "d000fa57-c9d7-4ea0-995d-550b0175eec6",
                                "sense_id": "bab07cec-5b3a-37aa-8a98-75683aa84f05",
                                "text": "Un vrai feu d’artifice avec les balles traceuses des mitrailleuses qui filent dans la nuit et semblent danser quand elles ricochent sur un obstacle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "37525036-cbac-3519-a226-f1a7ce7b77f9",
