                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af412ba6-77f7-4698-b3d6-459efff3cd32",
                                                "sense_id": "a806138c-44d0-330c-b3dd-00fedfdc5e55",
                                                "text": "calcareous infiltrations filling the cavities"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d7f770a-2f89-3725-bbca-27a2d4b55679",
                                        "entry_id": "40c2568b-7b6a-38b5-9f00-f108ce960025",
                                        "glosses": [
                                            "The act of secretly entering a physical location and/or organization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42fae490-442d-4b0f-9222-8cb7e11f05de",
                                                "sense_id": "1d7f770a-2f89-3725-bbca-27a2d4b55679",
                                                "text": "No one should be under any illusions about the objective of the Communist Party leadership: it’s long-term, systematic infiltration of social organisations, media and government. By the time China’s infiltration of Australia is readily apparent, it will be too late."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
