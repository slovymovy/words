                    {
                        "sense_id": "7c6c0e9a-3f48-3274-8559-f7c4bcf9439c",
                        "entry_id": "a2dce670-e2c7-328a-b98a-522052afb392",
                        "glosses": [
                            "unbewohntes Eiland im Pazifik, das von den USA beansprucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f067cef-5120-46f6-86cb-f520e52e7288",
                                "sense_id": "7c6c0e9a-3f48-3274-8559-f7c4bcf9439c",
                                "text": "„Insgesamt dauert es 26 Stunden, bis die ganze Welt in ost-westlicher Richtung ins neue Jahr kommt. Ganz am Schluss stehen die unbewohnten Eilande Bakerinsel und Howlandinsel im Pazifik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7966bf4f-ce39-4838-ad49-f833326b2b45",
                        "source_entry_id": "a2dce670-e2c7-328a-b98a-522052afb392",
                        "source_sense_id": "7c6c0e9a-3f48-3274-8559-f7c4bcf9439c",
                        "source_sense_description": "Eiland im Pazifik",
                        "target_lang_word": "貝克島",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "貝克島",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "55d7dcbe-29fb-3cdc-8a29-dc3fb2f0ec1f",
                                        "entry_id": "d5314edd-0c93-3c2f-b79e-5405f8c875b1",
                                        "glosses": [
                                            "位於太平洋中部赤道以北的環礁，面積2.1平方公里，無人居住，地理上與菲尼克斯群岛／鳳凰群島的豪蘭島接近，行政上屬美國的非建制地區"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "267c48df-ae42-49c7-a587-84bd938f794b",
                        "source_entry_id": "a2dce670-e2c7-328a-b98a-522052afb392",
                        "source_sense_id": "7c6c0e9a-3f48-3274-8559-f7c4bcf9439c",
                        "source_sense_description": "Eiland im Pazifik",
                        "target_lang_word": "Baker Island",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baker Island",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eaefdd31-82a0-3d11-934f-7e6979637d8b",
                                        "entry_id": "4421a732-e23a-34d5-87b2-ae51f84fce8c",
                                        "glosses": [
                                            "a US 2.1 km² uninhabited atoll just north of the equator in the central Pacific Ocean, geographically together with Howland Island part of the Rawaki Islands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ba651c-4604-4662-b995-62dc4e5e7d87",
                                                "sense_id": "eaefdd31-82a0-3d11-934f-7e6979637d8b",
                                                "text": "It has been demonstrated that these islands have been often visited by our whale ships, and we confidently predict a vast trade in American guano will be established. The Baker Island guano has been analyzed, and found to be surpassingly rich in phosphates."
                                            },
                                            {
                                                "example_id": "aa3f8e25-caf6-4947-9aab-21f506246b6e",
                                                "sense_id": "eaefdd31-82a0-3d11-934f-7e6979637d8b",
                                                "text": "By virtue of and pursuant to the authority vested in me by the Act of June 25, 1910, Ch. 421, 36 Stat. 847, as amended by the Act of August 24, 1912, ch. 369, 37 Stat. 497, and as President of the United States, it is ordered that Jarvis Island located in the Pacific Ocean approximately in latitude 0°22'30\" S. and longitude 160°01' W. from Greenwich; Baker Island located in the Pacific Ocean approximately in latitude 0°13'30\" N. and longitude 176°33' W. from Greenwich; and Howland Island located in the Pacific Ocean approximately in latitude 0°49' N. and longitude 176°43' W. from Greenwich, as indicated upon the diagram hereto attached and made a part of this order, be, and they are hereby, reserved, set aside, and placed under the control and jurisdiction of the Secretary of the Interior for administrative purposes."
                                            },
                                            {
                                                "example_id": "f5bb9e96-5623-42ed-ab8b-bed064aef081",
                                                "sense_id": "eaefdd31-82a0-3d11-934f-7e6979637d8b",
                                                "text": "Baker Island (□ 1), central Pacific, 40 mi. S of Howland Isl., U.S. naval base, near equator, on air route to Australia; 0°13'N 176°31'W; coral, arid. Claimed 1857 by U.S.; later worked for guano by both U.S. and Great Britain; colonized by Americans from Hawaii 1935; placed under Dept. of Interior 1936. In Second World War, captured by Japanese 1942, regained by U.S. 1944. Formerly worked for guano along with Jarvis and Howland isls."
                                            },
                                            {
                                                "example_id": "2a16c36d-c164-43df-b0fd-0f2ae5bb1b09",
                                                "sense_id": "eaefdd31-82a0-3d11-934f-7e6979637d8b",
                                                "text": "San Francisco's skyline was lit up by the city's annual firework show on the US West Coast.\nBut in the westernmost state of the US, it is still 2024, just.\nHawaii's clocks will tick over to midnight at the top of the coming hour.\nThat's still not (quite) the end of the festivities.\nThe islands of American Samoa and Niue in the South Pacific follow another hour later. Strictly speaking, two more US territories, Baker Island and Howland Island follow an hour after that — but both are uninhabited."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
