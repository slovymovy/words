                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88c867d5-fc5d-4bff-925d-e3e3f14c2502",
                                "sense_id": "e3847b22-b13a-3bca-b968-9767c1a547be",
                                "text": "Die Ursachen der Neurodermitis sind bislang nicht vollständig geklärt."
                            },
                            {
                                "example_id": "560fdd1f-d3d6-4c25-82f1-a51846538472",
                                "sense_id": "e3847b22-b13a-3bca-b968-9767c1a547be",
                                "text": "In der akuten Entstehungsphase der Neurodermitis stehen entzündliche Veränderungen wie Rötung, Schwellung der Haut, Nässen und Krustenbildung durch Eintrocknen des Sekrets im Vordergrund."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
