{
    "word_family": [
        "flourishing",
        "flourisher",
        "florid",
        "floral",
        "flower"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fed49d74-4e13-3341-b74a-252d5338a27f",
                    "sense_definition": "To thrive or grow well, especially in a physical or biological sense.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "thrive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The barley <w>flourished</w> in the warm weather after the heavy spring rains.",
                            "target_lang_translations": {
                                "ru": "Ячмень <w>буйно рос</w> в теплую погоду после сильных весенних дождей."
                            }
                        },
                        {
                            "text": "Many rare plants <w>flourish</w> in the humid environment of the tropical greenhouse.",
                            "target_lang_translations": {
                                "ru": "Многие редкие растения <w>процветают</w> во влажной среде тропической оранжереи."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrive",
                        "bloom",
                        "blossom"
                    ],
                    "antonyms": [
                        "wither",
                        "die",
                        "fade"
                    ],
                    "common_phrases": [
                        "flourish in the sun",
                        "continue to flourish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно расти или развиваться, особенно в физическом или биологическом смысле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процветать",
                                "target_lang_sense_clarification": "о растениях или организмах"
                            },
                            {
                                "target_lang_word": "буйно расти",
                                "target_lang_sense_clarification": "обильно развиваться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ac65f76-7222-33b9-837e-bd15b1ac4f8f",
                    "sense_definition": "To prosper, be successful, or fare well in life or business.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "thrive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small town <w>flourished</w> with the coming of the new railway line.",
                            "target_lang_translations": {
                                "ru": "Маленький городок <w>расцвел</w> с появлением новой железнодорожной линии."
                            }
                        },
                        {
                            "text": "Her online business began to <w>flourish</w> after she improved her marketing strategy.",
                            "target_lang_translations": {
                                "ru": "Ее онлайн-бизнес начал <w>процветать</w> после того, как она улучшила маркетинговую стратегию."
                            }
                        }
                    ],
                    "synonyms": [
                        "prosper",
                        "succeed",
                        "boom",
                        "thrive"
                    ],
                    "antonyms": [
                        "fail",
                        "decline",
                        "struggle"
                    ],
                    "common_phrases": [
                        "flourish under pressure",
                        "begin to flourish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преуспевать, быть успешным или благополучным в жизни или бизнесе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процветать",
                                "target_lang_sense_clarification": "об экономике, бизнесе или городе"
                            },
                            {
                                "target_lang_word": "преуспевать",
                                "target_lang_sense_clarification": "добиваться успеха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e0bc8e1-aff8-305b-b415-56998ea1c5dc",
                    "sense_definition": "To make bold, sweeping, or dramatic movements with something held in the hand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>flourished</w> the banner as they stormed the palace gates.",
                            "target_lang_translations": {
                                "ru": "Они <w>размахивали</w> знаменем, штурмуя ворота дворца."
                            }
                        },
                        {
                            "text": "The conductor <w>flourished</w> his baton to signal the start of the symphony.",
                            "target_lang_translations": {
                                "ru": "Дирижер <w>взмахнул</w> палочкой, давая сигнал к началу симфонии."
                            }
                        }
                    ],
                    "synonyms": [
                        "wave",
                        "brandish",
                        "swing"
                    ],
                    "common_phrases": [
                        "flourish a sword",
                        "flourish a pen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать смелые, размашистые или драматичные движения предметом, зажатым в руке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размахивать",
                                "target_lang_sense_clarification": "делать широкие движения"
                            },
                            {
                                "target_lang_word": "взмахивать",
                                "target_lang_sense_clarification": "сделать резкое движение вверх или в сторону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33e92e14-cfc6-3f0e-b9c9-bbfbae8af451",
                    "sense_definition": "To be in a period of greatest influence, activity, or productivity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "thrive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His creative writing <w>flourished</w> before the war changed his perspective on life.",
                            "target_lang_translations": {
                                "ru": "Его литературное творчество <w>переживало расцвет</w> до того, как война изменила его взгляды на жизнь."
                            }
                        },
                        {
                            "text": "This particular style of architecture <w>flourished</w> during the sixteenth century.",
                            "target_lang_translations": {
                                "ru": "Этот конкретный архитектурный стиль <w>процветал</w> в шестнадцатом веке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться в периоде наибольшего влияния, активности или продуктивности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расцветать",
                                "target_lang_sense_clarification": "о творчестве или стиле"
                            },
                            {
                                "target_lang_word": "переживать расцвет",
                                "target_lang_sense_clarification": "находиться на пике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86d63443-e4fd-3996-b18e-a9e205812b94",
                    "sense_definition": "To use florid language or indulge in rhetorical figures and lofty expressions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rhetoric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orator began to <w>flourish</w> long upon little incidents to impress the crowd.",
                            "target_lang_translations": {
                                "ru": "Оратор начал <w>краснобайствовать</w>, долго рассуждая о незначительных происшествиях, чтобы впечатлить толпу."
                            }
                        },
                        {
                            "text": "He tended to <w>flourish</w> his prose with unnecessary adjectives and complex metaphors.",
                            "target_lang_translations": {
                                "ru": "Он был склонен <w>приукрашивать</w> свою прозу ненужными прилагательными и сложными метафорами."
                            }
                        }
                    ],
                    "synonyms": [
                        "embellish",
                        "elaborate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать цветистый язык или прибегать к риторическим фигурам и высокопарным выражениям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выражаться цветисто",
                                "target_lang_sense_clarification": "использовать излишние украшения в речи"
                            },
                            {
                                "target_lang_word": "приукрашивать",
                                "target_lang_sense_clarification": "делать слог более вычурным"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa691e67-131b-3d1d-bffc-1054ce0a8d65",
                    "sense_definition": "An ornamentation or decorative detail, especially in writing or design.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His signature ended with a <w>flourish</w> that made it difficult to forge.",
                            "target_lang_translations": {
                                "ru": "Его подпись заканчивалась <w>росчерком</w>, который было трудно подделать."
                            }
                        },
                        {
                            "text": "The calligrapher added a decorative <w>flourish</w> to the capital letter of the manuscript.",
                            "target_lang_translations": {
                                "ru": "Каллиграф добавил декоративную <w>завитушку</w> к заглавной букве рукописи."
                            }
                        }
                    ],
                    "synonyms": [
                        "ornament",
                        "embellishment",
                        "decoration"
                    ],
                    "common_phrases": [
                        "with a flourish",
                        "final flourish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Орнамент или декоративная деталь, особенно в письме или дизайне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "росчерк",
                                "target_lang_sense_clarification": "украшение в подписи или письме"
                            },
                            {
                                "target_lang_word": "завитушка",
                                "target_lang_sense_clarification": "декоративный элемент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8a0ee87-0fb1-3c2f-8995-023e6179b424",
                    "sense_definition": "A dramatic or bold gesture intended to attract attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With many <w>flourishes</w> of the captured banner, they marched down the avenue.",
                            "target_lang_translations": {
                                "ru": "С торжественными <w>взмахами</w> захваченного знамени они маршировали по авеню."
                            }
                        },
                        {
                            "text": "He opened the door with a grand <w>flourish</w> and invited the guests inside.",
                            "target_lang_translations": {
                                "ru": "Он распахнул дверь широким <w>жестом</w> и пригласил гостей войти."
                            }
                        }
                    ],
                    "synonyms": [
                        "gesture",
                        "display",
                        "show"
                    ],
                    "common_phrases": [
                        "dramatic flourish",
                        "theatrical flourish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Драматичный или смелый жест, призванный привлечь внимание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жест",
                                "target_lang_sense_clarification": "выразительное движение"
                            },
                            {
                                "target_lang_word": "взмах",
                                "target_lang_sense_clarification": "широкое движение рукой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab696095-f776-3aca-aa8c-b2fd5619a63d",
                    "sense_definition": "A ceremonious passage of music, such as a fanfare of trumpets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trumpets blew a <w>flourish</w> as the royal family entered the church.",
                            "target_lang_translations": {
                                "ru": "Трубы протрубили <w>фанфары</w>, когда королевская семья вошла в церковь."
                            }
                        },
                        {
                            "text": "The announcement was preceded by a brief musical <w>flourish</w> from the orchestra.",
                            "target_lang_translations": {
                                "ru": "Объявлению предшествовал короткий музыкальный <w>туш</w> в исполнении оркестра."
                            }
                        }
                    ],
                    "synonyms": [
                        "fanfare",
                        "prelude"
                    ],
                    "common_phrases": [
                        "flourish of trumpets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Торжественный музыкальный пассаж, например, фанфары труб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фанфара",
                                "target_lang_sense_clarification": "торжественный трубный сигнал"
                            },
                            {
                                "target_lang_word": "туш",
                                "target_lang_sense_clarification": "короткое приветственное музыкальное произведение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}