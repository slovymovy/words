                                ]
                            },
                            {
                                "target_word": "Remy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfb2ad23-a90c-3ccb-ae30-b91024880774",
                                        "entry_id": "2a13da22-6633-3603-935f-6ff132cddefc",
                                        "glosses": [
                                            "Prénom masculin (variante orthographique de Rémi)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bf224d5-c4bc-4af0-8a47-6b326867ca96",
                                                "sense_id": "cfb2ad23-a90c-3ccb-ae30-b91024880774",
                                                "text": "« C’est une réponse que j’ai faite il y a fort longtemps et qu’on n’aurait peut-être pas remarquée si Remy (il prononce Reumy) de Gourmont ne l’avait citée, disant qu’elle résumait tout. »"
                                            },
                                            {
                                                "example_id": "e3f00d6d-fb99-4295-9d5a-2a025e04a220",
                                                "sense_id": "cfb2ad23-a90c-3ccb-ae30-b91024880774",
                                                "text": "Artiste de sable. C’est ainsi que se définit Remy Hoggard, jamais aussi à l’aise qu’en sculptant des animaux sur la plage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Remy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e53ebc4-3f46-3589-9495-a78b89f3d198",
                                        "entry_id": "82d3b69f-77a4-306a-8ac7-6f4a18407a52",
                                        "glosses": [
                                            "Commune française, située dans le département de l’Oise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "268f7feb-65d2-41ae-99ed-710e3fd9533f",
                        "source_entry_id": "326ba8e7-da46-39bc-a983-4bf29c727cbf",
                        "source_sense_id": "c9528cda-db6b-301a-b920-2352813a6cfa",
                        "target_lang_word": "Rémy",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rémy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "044f10a8-965c-3ee9-8e0a-5d6bd17cbaa6",
                                        "entry_id": "998b1035-c9bb-3570-926f-c7c7bfdaa97a",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "622ebac4-4ff8-4662-b39d-126dcc725c0e",
                                                "sense_id": "044f10a8-965c-3ee9-8e0a-5d6bd17cbaa6",
                                                "text": "Les élèves de 4ᵉ et de 3ᵉ du collège Gounod ont assisté à une séance de planétarium à l’intérieur d’une structure gonflable amenée par Gilles Rémy, enseignant à l’Université de Cergy."
                                            },
                                            {
                                                "example_id": "1ce8dee1-6ef4-4678-95b4-3b8270e6efbc",
                                                "sense_id": "044f10a8-965c-3ee9-8e0a-5d6bd17cbaa6",
                                                "text": "Cette initiative vient d’un vœu déposé par les écologistes, et notamment la conseillère Raphaëlle Rémy-Leleu."
                                            },
                                            {
                                                "example_id": "2a8e2b20-6146-4b31-8137-3914b938a17e",
                                                "sense_id": "044f10a8-965c-3ee9-8e0a-5d6bd17cbaa6",
                                                "text": "Ronan Barbier, vainqueur senior hommes, et Evana Rémy-Buzaré, victorieuse simple dames, lors de la remise des récompenses par Jean-Yves Le Querrec, président du Tennis-club, dimanche 24 juillet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Rémy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad83ebbd-aa06-38f8-a4ae-794a93d33d1a",
                                        "entry_id": "a4cd283c-4dcf-38dc-ab53-2b917f0d396a",
                                        "glosses": [
                                            "Variante orthographique de Rémi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed89557b-9b21-4dad-9d35-287b784d99aa",
                                                "sense_id": "ad83ebbd-aa06-38f8-a4ae-794a93d33d1a",
                                                "text": "Après la très réussie Miskina, la pauvre, voici Darknet-sur-Mer, écrite et réalisée par Rémy Four et Julien War, disponible depuis quelques jours sur la plate-forme de Jeff Bezos."
                                            },
                                            {
                                                "example_id": "9347a1a0-a13f-4c1b-b915-0973d43b121b",
                                                "sense_id": "ad83ebbd-aa06-38f8-a4ae-794a93d33d1a",
                                                "text": "Face à une équipe brestoise très tonique, et au jeu limpide, les Lannionnais de Rémy Le Bourdoulous ont été tenus en échec (1-1), samedi en match de préparation."
                                            },
                                            {
                                                "example_id": "7dca239e-d620-43f0-8b4c-6db55d874b58",
                                                "sense_id": "ad83ebbd-aa06-38f8-a4ae-794a93d33d1a",
                                                "text": "Ces vaches appartiennent au Gaec Les Landes celtes fondé en 2019 par les éleveurs Rémy Thépaut et Jérémy Stéphan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Rémy",
                                "target_lang_code": "fr",
                                "target_senses": [
