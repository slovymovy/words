{
    "word_family": [
        "impetuous",
        "impetuously",
        "impetuousness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f0b237e-212b-365e-a4d4-f14f4f4a7f32",
                    "sense_definition": "The quality of acting or deciding rashly, impulsively, and without thinking of consequences.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impulsive_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His youthful <w>impetuosity</w> often led him into trouble with authority.",
                            "target_lang_translations": {
                                "nl": "Zijn jeugdige <w>onbezonnenheid</w> bracht hem vaak in de problemen met het gezag."
                            }
                        },
                        {
                            "text": "She tried to restrain his <w>impetuosity</w> before he signed the risky contract.",
                            "target_lang_translations": {
                                "nl": "Ze probeerde zijn <w>impulsiviteit</w> te beteugelen voordat hij het riskante contract ondertekende."
                            }
                        }
                    ],
                    "synonyms": [
                        "impetuousness"
                    ],
                    "common_phrases": [
                        "youthful impetuosity",
                        "curb one's impetuosity",
                        "restrain his impetuosity"
                    ],
                    "target_lang_definitions": {
                        "nl": "De eigenschap van het overhaast, impulsief en zonder nadenken over de gevolgen handelen of beslissen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onbezonnenheid",
                                "target_lang_sense_clarification": "het handelen zonder na te denken"
                            },
                            {
                                "target_lang_word": "onstuimigheid",
                                "target_lang_sense_clarification": "wilde, ongebreidelde impulsiviteit"
                            },
                            {
                                "target_lang_word": "impulsiviteit",
                                "target_lang_sense_clarification": "het handelen uit een opwelling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74afd29a-c336-3c08-9c78-65111c7b084c",
                    "sense_definition": "Fierce, violent force or rapid motion; overwhelming impatience or fury.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "furious_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river rushed with sudden <w>impetuosity</w> after the storm broke.",
                            "target_lang_translations": {
                                "nl": "De rivier stroomde met plotselinge <w>onstuimigheid</w> nadat de storm losbarstte."
                            }
                        },
                        {
                            "text": "She spoke with an <w>impetuosity</w> that startled everyone in the room.",
                            "target_lang_translations": {
                                "nl": "Ze sprak met een <w>heftigheid</w> die iedereen in de kamer deed schrikken."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sudden impetuosity"
                    ],
                    "target_lang_definitions": {
                        "nl": "Heftige, gewelddadige kracht of snelle beweging; overweldigend ongeduld of felheid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onstuimigheid",
                                "target_lang_sense_clarification": "wilde kracht of felheid"
                            },
                            {
                                "target_lang_word": "heftigheid",
                                "target_lang_sense_clarification": "krachtige intensiteit of felheid"
                            },
                            {
                                "target_lang_word": "gewelddadigheid",
                                "target_lang_sense_clarification": "plotselinge, verwoestende kracht"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}