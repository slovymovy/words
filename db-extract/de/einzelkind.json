                        "cross_references": []
                    },
                    {
                        "translation_id": "f00d5488-cf90-4b75-a424-fb14969955c5",
                        "source_entry_id": "b78d52a3-f8d7-3672-a4f3-1faf7d813e7c",
                        "source_sense_id": "3e1e41ba-94dc-3dc8-869e-15ff1990d3f9",
                        "source_sense_description": "Kind oder Jugendlicher ohne Geschwister",
                        "target_lang_word": "only child",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "only child",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b5cde28-8088-3526-b6a3-cd6ab2498ac2",
                                        "entry_id": "80fe4865-3c28-3e43-8c65-0e9bed717d31",
                                        "glosses": [
                                            "A person who has no siblings; a person raised as the sole child in a household."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "174e96b9-364f-4190-a25c-87182196b670",
                                                "sense_id": "2b5cde28-8088-3526-b6a3-cd6ab2498ac2",
                                                "text": "An only child is often stereotyped as spoiled."
                                            },
                                            {
                                                "example_id": "c633b188-fa68-40c3-bd77-0bd3e7f797b4",
                                                "sense_id": "2b5cde28-8088-3526-b6a3-cd6ab2498ac2",
                                                "text": "Tali: It's my father. He's the senior member of the Admiralty Board. He's one of only five people who can overrule the decisions of the Conclave for the good of the Migrant Fleet.\nTali: My father is responsible for the lives of seventeen million people -- our entire race is in his hands. And I'm his only child."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43202e70-b2e8-4f7a-a6ca-458679c57429",
                        "source_entry_id": "b78d52a3-f8d7-3672-a4f3-1faf7d813e7c",
                        "source_sense_id": "3e1e41ba-94dc-3dc8-869e-15ff1990d3f9",
                        "source_sense_description": "Kind oder Jugendlicher ohne Geschwister",
                        "target_lang_word": "enfant unique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfant unique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7e1dd98-dbfd-390f-b2a7-b734226b074f",
                                        "entry_id": "b1f14830-dde9-331a-8c37-bf680e557df6",
                                        "glosses": [
                                            "Personne qui n’a ni frères ni sœurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4fa5c84-cfa0-42bf-9efc-50e23b74a83d",
                                                "sense_id": "a7e1dd98-dbfd-390f-b2a7-b734226b074f",
                                                "text": "L’enfant unique est souvent plus exposé aux conflits de ses parents, à leurs pressions et à celles de son milieu."
                                            },
                                            {
                                                "example_id": "9ee3011f-17ae-4bc0-b3fc-cbd08b365afc",
                                                "sense_id": "a7e1dd98-dbfd-390f-b2a7-b734226b074f",
                                                "text": "Je plaignais les enfants uniques ; les amusements solitaires me semblaient fades : tout juste une manière de tuer le temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ee86020-4c1c-40b3-aece-de5c3c8ac9ff",
