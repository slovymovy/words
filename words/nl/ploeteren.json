                {
                    "sense_id": "e54282ef-3ed5-3bce-a700-5fa46444203b",
                    "sense_definition": "hard werken met veel inspanning en moeite zonder veel resultaat te zien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hard werken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De studenten moesten de hele nacht <w>ploeteren</w> om hun scriptie op tijd af te krijgen.",
                            "target_lang_translations": {
                                "en": "The students had to <w>toil</w> all night to finish their thesis on time."
                            }
                        },
                        {
                            "text": "Na urenlang <w>ploeteren</w> op die moeilijke som vond hij eindelijk het juiste antwoord.",
                            "target_lang_translations": {
                                "en": "After <w>slogging</w> away at that difficult math problem for hours, he finally found the right answer."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwoegen",
                        "knoeften"
                    ],
                    "common_phrases": [
                        "urenlang ploeteren",
                        "blijven ploeteren"
                    ],
                    "target_lang_definitions": {
