                                        "entry_id": "cda344e5-3f61-34a2-9d2a-c5bf6afa08d5",
                                        "glosses": [
                                            "prostor pod roštem kam propadávají zbytky ze spalovacího prostoru"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f80e52e0-0c9d-48b0-bf56-3c291d2d774f",
                                                "sense_id": "39233c99-2d5b-31fe-a087-eecbdf83dca7",
                                                "text": "Jen hodiny cvakaly, oheň praskal, pes odfukoval, a dole u kamen skřípala malá dvířka popelníku, na kterých si nožkou hrála paní rechtorka."
