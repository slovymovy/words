                "senses": [
                    {
                        "sense_id": "7f8813b6-69df-3996-8070-d4ca6b9d9dc8",
                        "entry_id": "2515fa5c-8650-35f6-b3d2-a81b5ae0b85d",
                        "glosses": [
                            "abbreviation of Panzerabwehrkanone"
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "d2cc31d3-14ac-4e87-9884-c2faa22d0c8d",
                                "sense_id": "7f8813b6-69df-3996-8070-d4ca6b9d9dc8",
                                "text": "Hier in Stalingrad war das anders. Wir haben kaum gegen Panzer gekämpft, die russischen Kampfverbände hatten so kleine PAKs [Panzerabwehrkanonen], die sehr leicht und wendig waren. So etwas wurde uns fast zum Verhängnis. Ich sah, wie eine Panzerabwehrkanone durch den Panzerspiegel abgefeuert wurde und direkt auf meinen Fahrer fiel."
                            }
                        ]
                    }
