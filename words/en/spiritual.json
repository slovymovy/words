{
    "word_family": [
        "spirit",
        "spirituality",
        "spiritualism",
        "spiritualist",
        "spiritualize",
        "spiritually"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7174048c-bb1c-3102-8c21-efd918624341",
                    "sense_definition": "Relating to the human spirit or soul as opposed to material or physical things.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spirit-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people find that meditation helps them achieve a deeper <w>spiritual</w> connection with themselves.",
                            "target_lang_translations": {
                                "ru": "Многие люди находят, что медитация помогает им достичь более глубокой <w>духовной</w> связи с самими собой."
                            }
                        },
                        {
                            "text": "Respect towards ancestors is an essential part of Thai <w>spiritual</w> practice.",
                            "target_lang_translations": {
                                "ru": "Уважение к предкам является важной частью тайской <w>духовной</w> практики."
                            }
                        }
                    ],
                    "antonyms": [
                        "material",
                        "physical",
                        "secular"
                    ],
                    "common_phrases": [
                        "spiritual practice",
                        "spiritual growth",
                        "spiritual journey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к человеческому духу или душе, в противовес материальным или физическим вещам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "духовный",
                                "target_lang_sense_clarification": "связанный с внутренним миром и душой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbb24f03-d17d-3a5f-8f11-a0181e4fa7c1",
                    "sense_definition": "Relating to religion, sacred matters, or God.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bishop is considered the <w>spiritual</w> leader of the local community.",
                            "target_lang_translations": {
                                "ru": "Епископ считается <w>духовным</w> лидером местной общины."
                            }
                        },
                        {
                            "text": "They sought <w>spiritual</w> guidance from the priest during their time of grief.",
                            "target_lang_translations": {
                                "ru": "В период скорби они искали <w>духовного</w> наставления у священника."
                            }
                        }
                    ],
                    "synonyms": [
                        "folk song"
                    ],
                    "antonyms": [
                        "temporal",
                        "worldly"
                    ],
                    "common_phrases": [
                        "spiritual leader",
                        "spiritual guidance",
                        "spiritual life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к религии, священным вопросам или Богу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "духовный",
                                "target_lang_sense_clarification": "религиозный, церковный"
                            },
                            {
                                "target_lang_word": "религиозный",
                                "target_lang_sense_clarification": "связанный с верой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47e8eacc-78fd-3b5d-8e73-76fc4116dd41",
                    "sense_definition": "Consisting of spirit rather than matter; having no physical body.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "spirit-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that the mind is a <w>spiritual</w> substance that exists independently of the brain.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что разум — это <w>духовная</w> субстанция, существующая независимо от мозга."
                            }
                        },
                        {
                            "text": "In many mythologies, ghosts are described as <w>spiritual</w> beings that can pass through walls.",
                            "target_lang_translations": {
                                "ru": "Во многих мифологиях призраки описываются как <w>духовные</w> существа, способные проходить сквозь стены."
                            }
                        }
                    ],
                    "synonyms": [
                        "folk song"
                    ],
                    "antonyms": [
                        "corporeal",
                        "material"
                    ],
                    "common_phrases": [
                        "spiritual being",
                        "spiritual substance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из духа, а не из материи; не имеющий физического тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бестелесный",
                                "target_lang_sense_clarification": "не имеющий плоти"
                            },
                            {
                                "target_lang_word": "духовный",
                                "target_lang_sense_clarification": "нематериальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9f27f75-aed1-38fe-a778-a8fd1c9dbc38",
                    "sense_definition": "Relating to the church or clergy rather than to worldly or state affairs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lords <w>spiritual</w> and temporal gathered to discuss the new laws of the kingdom.",
                            "target_lang_translations": {
                                "ru": "Лорды <w>духовные</w> и светские собрались, чтобы обсудить новые законы королевства."
                            }
                        },
                        {
                            "text": "The <w>spiritual</w> functions of the clergy are distinct from their administrative duties.",
                            "target_lang_translations": {
                                "ru": "<w>Духовные</w> функции духовенства отличаются от их административных обязанностей."
                            }
                        }
                    ],
                    "synonyms": [
                        "folk song"
                    ],
                    "antonyms": [
                        "temporal",
                        "lay"
                    ],
                    "common_phrases": [
                        "lords spiritual",
                        "spiritual authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к церкви или духовенству, а не к мирским или государственным делам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "церковный",
                                "target_lang_sense_clarification": "относящийся к институту церкви"
                            },
                            {
                                "target_lang_word": "духовный",
                                "target_lang_sense_clarification": "относящийся к сану или клиру"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "488fd54d-af1a-385c-9c17-cac15b91da46",
                    "sense_definition": "A religious song of a kind associated with African Americans in the southern US.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir performed a moving African-American <w>spiritual</w> during the Sunday service.",
                            "target_lang_translations": {
                                "ru": "Во время воскресной службы хор исполнил трогательный афроамериканский <w>спиричуэл</w>."
                            }
                        },
                        {
                            "text": "Many famous jazz melodies have their roots in the traditional <w>spiritual</w>.",
                            "target_lang_translations": {
                                "ru": "Многие знаменитые джазовые мелодии уходят корнями в традиционный <w>спиричуэл</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "folk song"
                    ],
                    "common_phrases": [
                        "negro spiritual",
                        "traditional spiritual"
                    ],
                    "target_lang_definitions": {
                        "ru": "Религиозная песня, характерная для афроамериканцев юга США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спиричуэл",
                                "target_lang_sense_clarification": "музыкальный жанр"
                            },
                            {
                                "target_lang_word": "спиричуэлс",
                                "target_lang_sense_clarification": "духовное песнопение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56956826-59a0-3a1c-85f9-2d1340cba810",
                    "sense_definition": "A matter or affair that is religious or ecclesiastical rather than worldly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The emperor held power over temporals, while the pope maintained authority in <w>spirituals</w>.",
                            "target_lang_translations": {
                                "ru": "Император обладал властью над мирскими делами, в то время как папа сохранял авторитет в <w>духовных</w>."
                            }
                        },
                        {
                            "text": "The council was convened to settle disputes regarding various <w>spirituals</w> within the diocese.",
                            "target_lang_translations": {
                                "ru": "Совет был созван для разрешения споров по поводу различных <w>духовных дел</w> внутри епархии."
                            }
                        }
                    ],
                    "antonyms": [
                        "temporals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопрос или дело религиозного или церковного характера, в отличие от мирского."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "духовные дела",
                                "target_lang_sense_clarification": "вопросы веры и церкви"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "20915faf-6691-3565-bff5-ce899a1acdfc",
                    "sense_definition": "A member of a 13th- and 14th-century branch of the Franciscan order that advocated strict poverty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Spirituals</w> were often at odds with the church hierarchy over their radical views on poverty.",
                            "target_lang_translations": {
                                "ru": "<w>Спиритуалы</w> часто конфликтовали с церковной иерархией из-за своих радикальных взглядов на бедность."
                            }
                        },
                        {
                            "text": "Historical records show that the cause of the <w>Spirituals</w> was championed by several influential figures.",
                            "target_lang_translations": {
                                "ru": "Исторические записи показывают, что дело <w>спиритуалов</w> поддерживали несколько влиятельных фигур."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член ветви францисканского ордена XIII–XIV веков, выступавший за строгую бедность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спиритуал",
                                "target_lang_sense_clarification": "исторический термин, монах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}