                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ddc9bf4-b4d1-3419-9199-151efb4035d2",
                        "entry_id": "e6f9fcc9-97e9-318a-a61c-5018bdf3eecc",
                        "glosses": [
                            "Pathologie qui consiste en une érection anormalement prolongée du pénis en l’absence de toute stimulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a0f4b5d-f181-49f2-ae55-ba79b561ff74",
                                "sense_id": "6ddc9bf4-b4d1-3419-9199-151efb4035d2",
                                "text": "Des fomentations ou des cataplasmes seuls contre le priapisme sont peu utiles."
                            },
                            {
                                "example_id": "f3390920-c9f3-4167-a2c8-a23eb1b20d4c",
                                "sense_id": "6ddc9bf4-b4d1-3419-9199-151efb4035d2",
                                "text": "Loin d’être voluptueux, le vrai priapisme est souvent la source de douleurs plus ou moins vives."
                            },
                            {
                                "example_id": "1a56ffa9-cf9e-4fa0-8a15-987fe78fda9e",
                                "sense_id": "6ddc9bf4-b4d1-3419-9199-151efb4035d2",
                                "text": "Francis Ponge était atteint de priapisme, il était en érection quasi perpétuelle et il devait la rougeur remarquable de son teint à une constante dilatation des vaisseaux sanguins, comme s’il était sous perfusion continue de Viagra ou de Cialis, drogues parfaitement inexistantes à l’époque."
                            },
                            {
                                "example_id": "72f39515-a2ba-4ed1-9bd7-49c481ebc45d",
                                "sense_id": "6ddc9bf4-b4d1-3419-9199-151efb4035d2",
                                "text": "La Dre Marie-Ève Morin de la clinique La Licorne à Montréal rappelle qu’une surdose peut mener à des priapismes (longues et douloureuses érections) et à des malaises cardiaques."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b3870a3-8da5-31cc-9470-6fd0129dce92",
                        "entry_id": "e6f9fcc9-97e9-318a-a61c-5018bdf3eecc",
                        "glosses": [
                            "Vif appétit sexuel, et par extension, grande excitation."
                        ],
                        "tags": [
                            "dated",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5c88bd9d-f002-4a38-8b32-c7549004de5d",
                                "sense_id": "8b3870a3-8da5-31cc-9470-6fd0129dce92",
                                "text": "Il assuma également son priapisme, en attachant son sexe démesuré à l’aide d’un drapeau rouge sur sa cuisse gauche, celle du cœur."
                            },
                            {
                                "example_id": "8d6c52af-86ef-4cb8-9eaf-3b894035390b",
                                "sense_id": "8b3870a3-8da5-31cc-9470-6fd0129dce92",
                                "text": "Il suffit de se rappeler qu’il eut une sorte de priapisme jusqu’à quatre-vingts ans, et que les filles de Paris qui venoient souvent le visiter, l’appeloient Pierrot."
                            },
                            {
                                "example_id": "1fa353bc-120e-47c2-aefe-da9747ad9932",
                                "sense_id": "8b3870a3-8da5-31cc-9470-6fd0129dce92",
                                "text": "Son visage gravé semble impur, il est vrai, mais impur de pensée, de fantaisie lubrique, d’un priapisme cérébral."
                            }
                        ]
                    }
                ],
