                {
                    "sense_id": "2b6c1627-3975-3f92-872c-310a786a975f",
                    "sense_definition": "Sert à confirmer un propos, à marquer une adhésion totale ou un accord complet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est <w>exactement</w> ce que je voulais dire pendant la réunion.",
                            "target_lang_translations": {
                                "en": "That's <w>exactly</w> what I meant to say during the meeting.",
                                "ru": "Это <w>именно</w> то, что я хотел сказать на совещании.",
                                "nl": "Dat is <w>precies</w> wat ik tijdens de vergadering wilde zeggen.",
                                "de": "Das ist <w>genau</w> das, was ich während der Besprechung sagen wollte.",
                                "pl": "To <w>dokładnie</w> to, co chciałem powiedzieć na spotkaniu.",
                                "it": "È <w>esattamente</w> quello che volevo dire durante la riunione.",
                                "cs": "To je <w>přesně</w> to, co jsem chtěl říct na poradě.",
                                "tr": "Toplantıda söylemek istediğim şey <w>tam</w> olarak budur.",
                                "es": "Eso es <w>exactamente</w> lo que quería decir durante la reunión.",
                                "zh": "这<w>正是</w>我在会议上想说的。"
                            }
                        },
                        {
                            "text": "— Donc la réunion est reportée à jeudi ? — <w>Exactement</w>, à la même heure.",
                            "target_lang_translations": {
                                "en": "So the meeting has been moved to Thursday? — <w>Exactly</w>, same time.",
                                "ru": "— Значит, совещание перенесли на четверг? — <w>Точно</w>, в то же время.",
                                "nl": "— Dus de vergadering is uitgesteld tot donderdag? — <w>Precies</w>, om dezelfde tijd.",
                                "de": "— Also ist die Besprechung auf Donnerstag verschoben? — <w>Genau</w>, zur selben Uhrzeit.",
                                "pl": "— Czyli spotkanie przełożono na czwartek? — <w>Dokładnie</w>, o tej samej godzinie.",
                                "it": "— Quindi la riunione è rinviata a giovedì? — <w>Esattamente</w>, alla stessa ora.",
                                "cs": "— Takže se porada přesouvá na čtvrtek? — <w>Přesně</w>, ve stejnou dobu.",
                                "tr": "— Yani toplantı perşembeye mi ertelendi? — <w>Tam</w>, aynı saatte.",
                                "es": "— ¿Entonces la reunión se ha aplazado al jueves? — <w>Exactamente</w>, a la misma hora.",
                                "zh": "——所以会议推迟到周四了？——<w>正是</w>，同一时间。"
                            }
                        }
                    ],
