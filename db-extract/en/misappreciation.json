    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5feb1b12-20dc-361f-979d-24bded9d3f17",
                "word": "misappreciation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fb4f050a-362f-40e3-95c2-0e9521da55ef",
                        "entry_id": "5feb1b12-20dc-361f-979d-24bded9d3f17",
                        "tags": [
                            "plural"
                        ],
                        "form": "misappreciations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c79e850a-32b0-3d88-a4c9-2ae442a44ebe",
                        "entry_id": "5feb1b12-20dc-361f-979d-24bded9d3f17",
                        "glosses": [
                            "A failure to correctly and completely understand; an incorrect notion or belief that is a result of such a failure."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4ea278a7-b2b3-4242-9bd7-d3a2ddf4d69a",
                                "sense_id": "c79e850a-32b0-3d88-a4c9-2ae442a44ebe",
                                "text": "It is the duty of the individual juror to strive to avoid any misappreciation of the evidence, no matter how it is represented by the barristers."
                            },
                            {
                                "example_id": "e3c3797c-a180-40cb-9b89-1d8784f7d3f3",
                                "sense_id": "c79e850a-32b0-3d88-a4c9-2ae442a44ebe",
                                "text": "Although he claims to be a postmodernist, his misappreciation of the philosophy is such that he still clings to the idea of absolute truth."
                            },
                            {
                                "example_id": "f235fde6-dfde-4ab3-886d-e417cffd9230",
                                "sense_id": "c79e850a-32b0-3d88-a4c9-2ae442a44ebe",
                                "text": "I accuse you rather of misappreciation than of misstatement."
                            },
                            {
                                "example_id": "c24fbdbc-1a5c-42d7-9dbf-406180474abe",
                                "sense_id": "c79e850a-32b0-3d88-a4c9-2ae442a44ebe",
                                "text": "The notion that keeping half a million men in South Vietnam indefinitely was a credible posture must be one of the most laughable misappreciations of the war."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a771b18-3da8-3183-b38d-aaec221bdcdc",
                        "entry_id": "5feb1b12-20dc-361f-979d-24bded9d3f17",
                        "glosses": [
                            "An observed failure to appreciate the proper worth of a person, an act or a thing."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a73adca8-2c4a-45ed-abc1-deb6fcd74ffe",
                                "sense_id": "4a771b18-3da8-3183-b38d-aaec221bdcdc",
                                "text": "\"He might not have meant to ignore her,\" answered Isabel thoughtfully; \"he might have chosen not to introduce her because he felt too proud of her to subject her to any possible misappreciation from them.\""
                            },
                            {
                                "example_id": "4a810a66-8783-4a9a-9fd6-14bffc951fd2",
                                "sense_id": "4a771b18-3da8-3183-b38d-aaec221bdcdc",
                                "text": "But it is the lot of goodness and truth ever to meet with misappreciation and disdain."
                            }
                        ]
                    }
                ],
