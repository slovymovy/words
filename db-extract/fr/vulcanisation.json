                "entry_id": "9e8ab9af-581a-33d9-bf9e-97ec2c1f17bc",
                "word": "vulcanisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "887c2a77-a0a5-4a4a-88b8-61874faec404",
                        "entry_id": "9e8ab9af-581a-33d9-bf9e-97ec2c1f17bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "vulcanisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad766bcb-ca40-344e-8c80-53e56c5972e6",
                        "entry_id": "9e8ab9af-581a-33d9-bf9e-97ec2c1f17bc",
                        "glosses": [
                            "Opération qui consiste à chauffer du souffre avec du caoutchouc pour permettre la polymérisation de ce dernier, le rendre insoluble, plus élastique, moins sensible à la chaleur et à la lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1660db84-b60a-4cf0-be0d-03df723af2e8",
                                "sense_id": "ad766bcb-ca40-344e-8c80-53e56c5972e6",
                                "text": "La vulcanisation doit être conduite selon un programme de température bien précis."
                            },
                            {
                                "example_id": "dcae40cc-fdc8-49fb-b2b9-4e9143ae4910",
                                "sense_id": "ad766bcb-ca40-344e-8c80-53e56c5972e6",
                                "text": "C’est au XIXe siècle, aux États-Unis, que Charles Goodyear découvre par erreur le procédé de vulcanisation du caoutchouc.\n Il arrive à stabiliser la substance pour qu’elle soit malléable et il invente les préservatifs en latex."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf55b375-7df8-4792-bdd5-1ae50cbdb2b1",
                        "source_entry_id": "9e8ab9af-581a-33d9-bf9e-97ec2c1f17bc",
                        "source_sense_id": "ad766bcb-ca40-344e-8c80-53e56c5972e6",
                        "target_lang_word": "Vulkanisation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vulkanisation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efb0bc17-ac77-3c34-9ae6-2908e9402d23",
                                        "entry_id": "0e4b7066-cc47-3e19-946a-f3b4e422a468",
                                        "glosses": [
                                            "chemischer Prozess, bei dem Kautschuk zu Gummi verarbeitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcfa57f3-9002-411c-974f-c0eca9be2284",
                                                "sense_id": "efb0bc17-ac77-3c34-9ae6-2908e9402d23",
                                                "text": "„Der mit Schwefel vermischte Kautschuk verwandelte sich bei Erhitzung in einen neuen Stoff, in Gummi. Damit hatte Goodyear die Vulkanisation entdeckt.“"
                                            },
                                            {
                                                "example_id": "d79cf768-6777-4b11-847f-2cee4830d6ed",
                                                "sense_id": "efb0bc17-ac77-3c34-9ae6-2908e9402d23",
                                                "text": "„Der Bedarf ist enorm, besonders seit der US-Chemiker Charles Goodyear 1839 die Vulkanisation entdeckt hat, die beständigen Gummi ermöglicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
