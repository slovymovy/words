                        "glosses": [
                            "Peindre à la manière du Caravage."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4274ea9c-7b6e-4008-adb3-d3214e4c1d4b",
                                "sense_id": "4b4305a6-acce-3e91-8f9e-66d5dbebdb47",
                                "text": "Il a un peu caravagé pour les scènes de genre, beaucoup raphaélisé quand les commandes portaient sur une vierge à l’enfant."
                            }
                        ]
                    },
                    {
                        "sense_id": "21f3ca5a-9415-32a2-aef0-544710191b90",
                        "entry_id": "88d6e03a-afa1-3e1a-9322-7df2e2b6e309",
                        "glosses": [
                            "Donner des caractéristiques rappelant Le Caravage à."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
