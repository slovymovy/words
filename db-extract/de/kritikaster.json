                "senses": [
                    {
                        "sense_id": "6f5bfbbb-cad6-3bd3-b307-35ccf3f11f39",
                        "entry_id": "4ab26b96-cb92-3158-812e-b1ce8d68bf41",
                        "glosses": [
                            "abwertend: jemand, der notorisch an allem und jedem etwas auszusetzen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b2c66e4-b38d-4722-8703-fcb11262589f",
                                "sense_id": "6f5bfbbb-cad6-3bd3-b307-35ccf3f11f39",
                                "text": "„Ich brauchte jemanden außerhalb des Circulus vitiosus falscher Bewunderer und mißgünstiger Kritikaster.“"
                            },
                            {
                                "example_id": "b18ca4f2-5fc4-446d-a101-603433704a11",
                                "sense_id": "6f5bfbbb-cad6-3bd3-b307-35ccf3f11f39",
                                "text": "„Wenn ein Kritiker, gleich welcher speziellen Richtung, sein Geschäft besserwisserisch und kleinlich »krittelnd« betreibt, so wird aus ihm in feiner, selbst wiederum kritischer Nuancierung, wie sie das Deutsche seit dem 18. Jahrhundert kennt, ein Kritikaster - ein »Scheinkritiker« gewissermaßen, der sich den bloßen Anschein kritischer Kompetenz gibt.“"
                            },
                            {
                                "example_id": "f6192b7e-10a0-4de3-9ce1-c8711790aaae",
                                "sense_id": "6f5bfbbb-cad6-3bd3-b307-35ccf3f11f39",
                                "text": "„Er ist bis heute der »Basta«-Typ geblieben, dem allzu moralische Meinungen von Kritikastern oder am Wegesrand liegen gebliebenen Ex-Freunden völlig egal sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
