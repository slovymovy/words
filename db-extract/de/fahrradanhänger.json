                    {
                        "sense_id": "ff0c4c94-fb31-388a-a1a7-45eb869f6c13",
                        "entry_id": "8f8542f5-310e-30cf-9276-4483cea6797e",
                        "glosses": [
                            "kleiner Hänger, der hinter einem Fahrrad befestigt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d4e2ab-5b31-45ed-a426-a9022cb8d7b9",
                                "sense_id": "ff0c4c94-fb31-388a-a1a7-45eb869f6c13",
                                "text": "„Immer beliebter bei Eltern werden die Fahrradanhänger.“"
                            },
                            {
                                "example_id": "bbdb600b-adb4-431c-8a42-ca4cccfb6f60",
                                "sense_id": "ff0c4c94-fb31-388a-a1a7-45eb869f6c13",
                                "text": "„Zum Unfallhergang teilte die Polizei mit, dass die 39-Jährige aus dem Bezirk Tulln gegen 20.50 Uhr mit dem Elektrofahrrad samt dem mehrspurigen Fahrradanhänger auf der B19 im Freilandgebiet von Hausleiten in Richtung Tulln unterwegs gewesen sei.“"
                            },
                            {
                                "example_id": "17b7a564-7d2b-4780-bb8f-87532f346c83",
                                "sense_id": "ff0c4c94-fb31-388a-a1a7-45eb869f6c13",
                                "text": "„Er lud die Staffelei, die Mappe mit den Bildern und die Schatulle mit den Malutensilien auf den Fahrradanhänger, den er aus Brettern und Rädern von einem Kinderfahrrad zusammengebaut hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
