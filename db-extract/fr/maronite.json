                "senses": [
                    {
                        "sense_id": "02838495-bd5b-3442-8d43-849c4c443d86",
                        "entry_id": "4e5d2f39-64a0-3e9c-b9c9-5d4679723a97",
                        "glosses": [
                            "Relatif à un rite catholique syrien dont le siège principal est au Liban."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea13b135-40a0-40af-925f-5acbf901e8aa",
                                "sense_id": "02838495-bd5b-3442-8d43-849c4c443d86",
                                "text": "Un prêtre maronite."
                            },
                            {
                                "example_id": "dcf5ddf8-8192-4c7c-8102-14e045845ac5",
                                "sense_id": "02838495-bd5b-3442-8d43-849c4c443d86",
                                "text": "Si bien qu’interrogé sur sa nationalité, ce petit Syrien des montagnes vous répondra : « Je suis chrétien maronite ! » ou bien : « Je suis musulman fatimite », comme si chaque nuance religieuse de tant de cultes opposés constituait une patrie, la seule véritable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5263417b-867d-40f5-a0b5-a9293460e45e",
                        "source_entry_id": "4e5d2f39-64a0-3e9c-b9c9-5d4679723a97",
                        "source_sense_id": "02838495-bd5b-3442-8d43-849c4c443d86",
                        "target_lang_word": "maronitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maronitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90213caf-a7da-3f2c-9889-a8074a8d8951",
                                        "entry_id": "cc408d0c-42ea-3504-a2b7-46405dd684b4",
                                        "glosses": [
                                            "die Maroniten betreffend, zu ihnen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76e61c22-c84f-44ef-ae60-dd20cb424e05",
                                                "sense_id": "90213caf-a7da-3f2c-9889-a8074a8d8951",
                                                "text": "„Das maronitische Netzwerk der CIA bildete einen Machtfaktor im Libanon.“"
                                            },
                                            {
                                                "example_id": "086ba92f-42e7-41f3-801f-4b3120804243",
                                                "sense_id": "90213caf-a7da-3f2c-9889-a8074a8d8951",
                                                "text": "„Es war die Straße, die den Osten Beiruts vom Westsektor trennte, und damit zu einem gewissen Grad auch Muslime von Christen - genauer genommen: schiitische Muslime von maronitischen Christen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
