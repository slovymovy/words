                "translations": [
                    {
                        "translation_id": "3c73e1c1-5244-4978-b01f-9ef344f36cad",
                        "source_entry_id": "340386fc-93dd-334d-b3fb-00a7c9a95209",
                        "source_sense_id": "630d289b-7b13-3982-9e5d-6c73f8041b8d",
                        "source_sense_description": "veraltet: Abgabe von Schüssen in unterschiedliche Richtungen; Knallerei, Schießerei",
                        "target_lang_word": "Knallerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a6a4d1ca-07de-4745-b3d7-dcc13805f7b3",
                        "source_entry_id": "340386fc-93dd-334d-b3fb-00a7c9a95209",
                        "source_sense_id": "630d289b-7b13-3982-9e5d-6c73f8041b8d",
                        "source_sense_description": "veraltet: Abgabe von Schüssen in unterschiedliche Richtungen; Knallerei, Schießerei",
                        "target_lang_word": "Schießerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schießerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                        "entry_id": "fa579482-6284-38c2-9a29-a678cc7e0340",
                                        "glosses": [
                                            "Abfolge mehrerer Schusswechsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367bc444-f070-49aa-af56-35d1ee0e41ee",
                                                "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                                "text": "Gestern gab es vor dem Lokal in der Beethovenstraße mal wieder eine Schießerei."
                                            },
                                            {
                                                "example_id": "45770a2a-23b2-4c28-bd02-c6466be06d26",
                                                "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                                "text": "„Ich lachte den Regisseur und Mutter Mewes aus, weil sie den prachtvollen Nachmittag in der Lesehalle verbracht hatten und durch die Berichte über Schießereien und Unruhen in ganz Deutschland verstimmt waren.“"
                                            },
                                            {
                                                "example_id": "6e529256-31ae-43e4-8517-c711f9ab8bb4",
                                                "sense_id": "4ff5f8f2-d4b3-35f8-8335-7bffbaafa806",
                                                "text": "„Übrigens hatte er, wie ihm später ein Arbeitskollege schrieb, bei seiner Schießerei wie durch ein Wunder niemand verletzt, abgesehen von einem Unbeteiligten, der sich bei dem Sprung aus dem Fenster die Beine gebrochen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f5d21b5-baf8-33da-bf6c-632882db1bb2",
                                        "entry_id": "fa579482-6284-38c2-9a29-a678cc7e0340",
                                        "glosses": [
                                            "ununterbrochenes, andauerndes Schießen"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "no-plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7237ab9-eb79-494a-81ea-d0d641ce2bc2",
                                                "sense_id": "8f5d21b5-baf8-33da-bf6c-632882db1bb2",
                                                "text": "Mein Mann ist völlig versessen auf seine Schießerei. Dauernd hängt er auf dem Schießplatz herum."
                                            },
                                            {
                                                "example_id": "0944bd6a-24ae-4d31-bcbe-12edfdfd6ed7",
                                                "sense_id": "8f5d21b5-baf8-33da-bf6c-632882db1bb2",
                                                "text": "„Die Schießerei hatte unterdessen gewaltig zugenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eb81b02-0477-4404-99bb-9e97238b5c8a",
                        "source_entry_id": "340386fc-93dd-334d-b3fb-00a7c9a95209",
                        "source_sense_id": "6885e9c5-529c-3cf8-9cdc-79f68aec0294",
                        "target_lang_word": "Konflikt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konflikt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                        "entry_id": "1d843196-1d9b-3be8-b2fe-bd01b2e1d5fb",
                                        "glosses": [
                                            "Gegensatz von Meinungen oder Interessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4e54e68-8d5c-476d-af16-b20535d43ad4",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "Es kam zu einem Konflikt zwischen Mutter und Tochter."
                                            },
                                            {
                                                "example_id": "c1833723-8780-48fd-950f-be3be2b8d855",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "„Vor dem geplanten Krisentreffen haben die USA von Russland konkrete Schritte zur Entschärfung des Konflikts angemahnt.“"
                                            },
                                            {
                                                "example_id": "f5d4f4d9-f7a2-45df-92be-4b54e3650231",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "„In der Zeit des Konflikts mit den griechischen Obristen war George Student in Oxford, und sein angeborener Patriotismus kam zum Vorschein.“"
                                            },
                                            {
                                                "example_id": "2ccd0dcf-684c-4dcc-94c3-7347483d40bb",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "„In dem Konflikt geht es um mehr als eine Reihe größtenteils unbewohnter Inseln und Riffe.“"
                                            },
                                            {
                                                "example_id": "dc66f3f3-a35a-4247-af4f-9cc47d0e784d",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "„Um diese potentiell gefährlichen Konflikte zu entschärfen, lädt Bismarck für den November 1884 Vertreter von zwölf europäischen Staaten, des Osmanischen Reiches sowie der USA nach Berlin ein.“"
                                            },
                                            {
                                                "example_id": "9b091c06-042f-4b35-ac91-4e8a4eb87280",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "[Kaiser Wilhelm II. und Zar Nikolaj II.:] „Eines ist jedoch klar: Wilhelm hat keinen von Nikolajs Vorschlägen zur Lösung des österreichisch-serbischen Konflikts angenommen oder umgesetzt.“"
                                            },
                                            {
                                                "example_id": "3e45bf4b-8ed8-4212-bc97-0c0a1923427b",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "„Wohin sollen Patienten gehen, wenn sie Fragen zu einer Inhalationstherapie haben, zu einer langen Medikamenten-Liste oder zu ihrem Blutdruck? Sind sie mit ihren Fragen in einer Arztpraxis oder in einer Apotheke besser aufgehoben? Dieses Thema sorgt also für Konflikte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
