                        "sense_id": "7a81cdf5-c390-3837-80a9-f946e5b0fc60",
                        "entry_id": "30cd1ab3-52f7-3cfe-a56f-c91bc6b5fcdc",
                        "glosses": [
                            "een bedrijf dat eigendom is van familieleden waarin vooral familieleden werken, of dat wordt overgeërfd in de familie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b024423-da88-4360-9f30-55bb030d6d04",
                                "sense_id": "7a81cdf5-c390-3837-80a9-f946e5b0fc60",
                                "text": "Dat gold in gelijke mate voor allebei hun zonen. In werkelijkheid was het natuurlijk niet helemaal in gelijke mate, dat besefte hij heel goed. Het was een aanzienlijk verschil om zoals zijn zoon Karl uit de oorlog te komen als kapitein van de marinereservisten met een diploma van de Handelshogeschool en verzekerd te zijn van werk in het familiebedrijf of zoals haar zoon Hjalmar een afgedankte sergeant te zijn zonder verdere opleiding. Maar in principe was het hetzelfde, aan klassenverschillen kon je niet veel doen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c111317c-b68e-4414-87af-efd28c0fd1de",
                        "source_entry_id": "30cd1ab3-52f7-3cfe-a56f-c91bc6b5fcdc",
                        "source_sense_id": "7a81cdf5-c390-3837-80a9-f946e5b0fc60",
                        "target_lang_word": "Familienunternehmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Familienunternehmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaf7ac97-fce4-316a-806e-b46d6d913c4e",
                                        "entry_id": "c8e4d5ce-d2e5-3d49-9896-5310d371a164",
                                        "glosses": [
                                            "Unternehmen, welches von einer Familie geführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cebc0c2-ae00-4dbd-b57a-25de2292e715",
                                                "sense_id": "aaf7ac97-fce4-316a-806e-b46d6d913c4e",
                                                "text": "Die Schuhfabrik nebenan ist ein Familienunternehmen."
                                            },
                                            {
                                                "example_id": "7504b1f2-a21d-429c-aa9f-472736b9d429",
                                                "sense_id": "aaf7ac97-fce4-316a-806e-b46d6d913c4e",
                                                "text": "„Das Familienunternehmen erzielte im Jahr 2023 einen Umsatz von 25,6 Milliarden Euro.“"
                                            },
                                            {
                                                "example_id": "df2e8abe-4d8c-4bee-8695-091424df580a",
                                                "sense_id": "aaf7ac97-fce4-316a-806e-b46d6d913c4e",
                                                "text": "„Die Größe seines Familienunternehmens erwähnt Iwan fast beiläufig, die bloßen Zahlen sind beeindruckend genug.“"
                                            },
                                            {
                                                "example_id": "a46eb5ce-390f-4072-98ca-a224db802279",
                                                "sense_id": "aaf7ac97-fce4-316a-806e-b46d6d913c4e",
                                                "text": "„Fast vier Jahrzehnte lange hat Angola wie ein korruptes Familienunternehmen funktioniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
