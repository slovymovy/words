                                        "glosses": [
                                            "so, dass es mit einem Sinn wahrgenommen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae300a2c-8d4b-4f9c-b530-e818f5798a33",
                                                "sense_id": "79906324-9ae3-3a0d-b214-686e20e08794",
                                                "text": "Die sinnliche Wahrnehmung ist im Alter oft eingeschränkt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1ba76be-f3a7-306b-ab89-b95d03cb5124",
                                        "entry_id": "b1434e68-aff3-3ba1-95f0-86829859e88c",
                                        "glosses": [
                                            "körperliche, insbesondere sexuelle Genüsse betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221dcdf0-9d37-4a36-a19e-68f7b3d4c93d",
                                                "sense_id": "e1ba76be-f3a7-306b-ab89-b95d03cb5124",
                                                "text": "Sie schaute ihn mit einem sinnlichen Lächeln an."
                                            },
                                            {
                                                "example_id": "ad0b69d6-d426-4074-9eec-5f6782d8f1c9",
                                                "sense_id": "e1ba76be-f3a7-306b-ab89-b95d03cb5124",
                                                "text": "„Die Sirenen erschienen Morgner wagemutiger als Odysseus, eine weibliche Trobadora sinnlicher als ihre männlichen Kollegen und Pandora menschlicher als der von ihr angebetete Prometheus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
