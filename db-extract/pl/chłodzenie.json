                    }
                ],
                "translations": [
                    {
                        "translation_id": "666bb20f-1752-41d1-a83a-f7880e41bb10",
                        "source_entry_id": "2d234195-2581-3105-b5a4-ad6fd9df8a95",
                        "source_sense_id": "c1b48cd1-9fd2-3878-a6c3-b5fa4dedbead",
                        "target_lang_word": "rafraîchissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rafraîchissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a7f73a8-e7ff-3385-9674-bbaf315fb6c0",
                                        "entry_id": "ab189c09-ba88-3970-944f-3f0695492730",
                                        "glosses": [
                                            "Action de rendre plus frais ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36a43eb5-b9ca-4bef-ab87-764ca7e6d78d",
                                                "sense_id": "4a7f73a8-e7ff-3385-9674-bbaf315fb6c0",
                                                "text": "Le rafraîchissement de la température. Le rafraîchissement d’une bouteille dans la glace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9cc5f7-8184-3463-bade-3cecf6fce859",
                                        "entry_id": "ab189c09-ba88-3970-944f-3f0695492730",
                                        "glosses": [
                                            "Action de remettre un objet dans son état de fraîcheur primitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ba66e0f-1544-4e47-9434-f9cace77c572",
                                                "sense_id": "bf9cc5f7-8184-3463-bade-3cecf6fce859",
                                                "text": "Le rafraîchissement d’un tableau, d’un mobilier, d’une toilette."
                                            },
                                            {
                                                "example_id": "302cfaf1-cf8c-4c7a-9c9e-abb3d15ba9f6",
                                                "sense_id": "bf9cc5f7-8184-3463-bade-3cecf6fce859",
                                                "text": "Il se souvenait très bien du jour où il avait décidé d’acheter cet appartement, neuf ans auparavant ; il revoyait l’agent immobilier, trapu et satisfait, vantant la lumière exceptionnelle, sans dissimuler la nécessité de certains «rafraîchissements »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2e06b10-f65f-3e96-af40-0fa8df9517ad",
                                        "entry_id": "ab189c09-ba88-3970-944f-3f0695492730",
                                        "glosses": [
                                            "Boissons fraîches, fruits, mets, que l’on sert dans un bal, au cours d’une réception, ou que l’on offre en dehors des repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05151980-1168-4d1d-a443-698257517b7c",
                                                "sense_id": "d2e06b10-f65f-3e96-af40-0fa8df9517ad",
                                                "text": "[…], tandis que six prêtres accomplissaient constamment les rites funéraires près du corps d’Athelsthane, les autres ne manquaient pas de prendre leur part des rafraîchissements et des amusements que l’on distribuait au château."
                                            },
                                            {
                                                "example_id": "962605b0-ba3f-4a28-975b-4093e1b70ff1",
                                                "sense_id": "d2e06b10-f65f-3e96-af40-0fa8df9517ad",
                                                "text": "Les écoliers pensent qu’il serait bon de faire circuler de temps en temps des rafraîchissements, tels que sirops, limonades, etc."
                                            },
                                            {
                                                "example_id": "85212c72-301a-4537-9ac0-a34ae3de97a8",
                                                "sense_id": "d2e06b10-f65f-3e96-af40-0fa8df9517ad",
                                                "text": "Elle et lui causaient auprès du poêle, pendant que les invités allaient et venaient de la table des victuailles à la table des rafraîchissements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16e9d47e-8c0d-3d56-b4b4-4a0968c5ad14",
                                        "entry_id": "ab189c09-ba88-3970-944f-3f0695492730",
                                        "glosses": [
                                            "Taux de rafraîchissement. Fréquence de balayage vertical définie par le nombre d’images s’affichant sur l’écran par seconde."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26905ed6-b804-4b64-a166-e3ee9fb46896",
                                                "sense_id": "16e9d47e-8c0d-3d56-b4b4-4a0968c5ad14",
                                                "text": "Le seul problème est que le rafraichissement est en 25Hz quand je regarde la TNT."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
