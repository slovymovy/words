                        "examples": [
                            {
                                "example_id": "15d8672e-dad7-46be-a396-7642a3373742",
                                "sense_id": "d160d5d5-4000-3aef-a179-5f0badf582a0",
                                "text": "Председатель принял Чичикова в объятия, и комната присутствия огласилась поцелуями; спросили друг друга о здоровье; оказалось, что у обоих побаливает поясница, что тут же было отнесено к сидячей жизни."
                            },
                            {
                                "example_id": "3cb5b116-ca04-41e6-932f-ee42e765ae94",
                                "sense_id": "d160d5d5-4000-3aef-a179-5f0badf582a0",
                                "text": "В сырые дни у Алексея побаливала грудь и нога; он шёл прихрамывая, опираясь на палку."
                            }
                        ]
                    }
