                },
                {
                    "sense_id": "f6022e10-5053-3f07-bc65-554e54235a91",
                    "sense_definition": "Exprimer clairement ou manifester visiblement un état, une qualité ou un sentiment positif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression_etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec son teint lumineux et son énergie débordante, cet enfant <w>respire</w> la santé."
                        },
                        {
                            "text": "Le vieux salon rénové était chaleureux et <w>respirait</w> la sérénité."
