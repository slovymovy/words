                        "examples": [
                            {
                                "example_id": "9247579b-73e1-4a54-8f65-0acc9fe791f7",
                                "sense_id": "e1becfaa-cfc2-31d3-b371-218179501bb0",
                                "text": "Toen ik de beslissing eenmaal genomen had, kon het niet snel genoeg gaan. In La Gare du Nord stapte ik op de eerstvolgende TGV , die bij aankomst te Brussel een HST was geworden."
                            }
