                "senses": [
                    {
                        "sense_id": "35105fe3-349a-3b10-9d64-8616d50bdde5",
                        "entry_id": "0787f1ec-4d54-3358-98af-fe0000959166",
                        "glosses": [
                            "Qui obsède."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d06ea452-24be-455e-b814-e28ddd98eeb3",
                                "sense_id": "35105fe3-349a-3b10-9d64-8616d50bdde5",
                                "text": "Elle était si préoccupée par l’image obsédante du jeune bijoutier qu’elle ne remarquait ni les âniers, ni les chameliers qui la poursuivaient de leurs cris : « Gare ! Gare ! » […]."
                            },
                            {
                                "example_id": "09d4c6c6-984c-492f-b0ae-75cbeb287ed7",
                                "sense_id": "35105fe3-349a-3b10-9d64-8616d50bdde5",
                                "text": "La littérature érotique embrasse plus de réalités psychologiques que la morale bourgeoise ne voulait en connaître, et que le puritanisme n'en tolère. Or ces réalités, quoiqu'on en juge, sont au moins aussi quotidiennes et obsédantes que les réalités économiques, […]."
                            }
                        ]
                    }
