{
    "word_family": [
        "kruimel",
        "kruimelig",
        "verkruimelen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "519b7506-bbc7-30c2-8313-53761b84bf3f",
                    "sense_definition": "tijdens het eten of snijden kruimels achterlaten of verspreiden",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eet je beschuit boven een bord zodat je niet overal <w>kruimelt</w>.",
                            "target_lang_translations": {
                                "de": "Iss deinen Zwieback über einem Teller, damit du nicht überall <w>krümelst</w>."
                            }
                        },
                        {
                            "text": "De kinderen zaten lekker op de bank te <w>kruimelen</w> met koekjes.",
                            "target_lang_translations": {
                                "de": "Die Kinder saßen gemütlich auf dem Sofa und <w>krümelten</w> mit Keksen."
                            }
                        }
                    ],
                    "synonyms": [
                        "kruimen"
                    ],
                    "target_lang_definitions": {
                        "de": "beim Essen oder Schneiden Krümel hinterlassen oder verstreuen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "krümeln",
                                "target_lang_sense_clarification": "Krümel verstreuen"
                            },
                            {
                                "target_lang_word": "bröseln",
                                "target_lang_sense_clarification": "regional, Krümel fallen lassen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b40ddd79-89f0-38f4-b4b6-294247353a86",
                    "sense_definition": "in kleine brokjes of kruimels uiteenvallen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiteenvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze oude cake is erg droog geworden en <w>kruimelt</w> ontzettend snel.",
                            "target_lang_translations": {
                                "de": "Dieser alte Kuchen ist sehr trocken geworden und <w>krümelt</w> wahnsinnig schnell."
                            }
                        },
                        {
                            "text": "De aarde in de plantenbak <w>kruimelde</w> gemakkelijk tussen zijn vingers.",
                            "target_lang_translations": {
                                "de": "Die Erde im Pflanzkübel <w>zerbröckelte</w> leicht zwischen seinen Fingern."
                            }
                        }
                    ],
                    "synonyms": [
                        "verkruimelen"
                    ],
                    "target_lang_definitions": {
                        "de": "in kleine Stücke oder Krümel zerfallen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "krümeln",
                                "target_lang_sense_clarification": "zerfallen, leicht zerbröckeln"
                            },
                            {
                                "target_lang_word": "zerbröckeln",
                                "target_lang_sense_clarification": "in kleine Teile zerfallen"
                            },
                            {
                                "target_lang_word": "zerbröseln",
                                "target_lang_sense_clarification": "in Brösel zerfallen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fe12ffa-3387-38c5-96d8-082caf35c1bd",
                    "sense_definition": "iets met de handen fijnmaken tot kleine stukjes",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uiteenvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor het dessert moet je wat koekjes fijn <w>kruimelen</w> over het ijs.",
                            "target_lang_translations": {
                                "de": "Für das Dessert musst du ein paar Kekse fein über das Eis <w>zerbröseln</w>."
                            }
                        },
                        {
                            "text": "De kok <w>kruimelde</w> de verse kaas zorgvuldig over de lauwwarme salade.",
                            "target_lang_translations": {
                                "de": "Der Koch <w>zerkrümelte</w> den frischen Käse sorgfältig über den lauwarmen Salat."
                            }
                        }
                    ],
                    "synonyms": [
                        "verkruimelen"
                    ],
                    "target_lang_definitions": {
                        "de": "etwas mit den Fingern in kleine Stücke zerkleinern"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zerbröseln",
                                "target_lang_sense_clarification": "mit den Händen zerkleinern"
                            },
                            {
                                "target_lang_word": "zerkrümeln",
                                "target_lang_sense_clarification": "in Krümel zerdrücken"
                            },
                            {
                                "target_lang_word": "zerbröckeln",
                                "target_lang_sense_clarification": "in Stücke brechen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}