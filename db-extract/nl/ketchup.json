                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                        "entry_id": "cbdda6af-bdb7-35fc-883a-ce2ae7fba31c",
                                        "glosses": [
                                            "Würzsoße mit den Grundbestandteilen Essig, Zucker und Tomaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fe80211-07d3-4e60-aa88-260ec63773b1",
                                                "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                                "text": "Mit Ketchup kann man sich leicht bekleckern."
                                            },
                                            {
                                                "example_id": "53e94359-8ad5-4f34-b8f1-13e2b1598d13",
                                                "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                                "text": "„Eine halbe Stunde später biss ich beherzt in einen Doppelwhopper, und Ketchup und Mayonnaise sammelten sich in meinem zotteligen Vagabundenbart“"
                                            },
                                            {
                                                "example_id": "19a56bb2-6f72-4867-973b-07a9d6e6fe1f",
                                                "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                                "text": "„Als die Shrimps gar waren, schöpften sie sie mit der Kelle aus dem Kochkessel und legten sie auf Zeitungspapier, schälten sie dann mit der Hand und stippten sie in die mit Worcestershire und Ketchup angemachte Soße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e71f0f1-a369-4f5f-b22b-2f1c024cc733",
                        "source_entry_id": "c4c8ff14-81e1-329a-9e5f-d69318ba2a97",
