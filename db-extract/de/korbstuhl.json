                "senses": [
                    {
                        "sense_id": "950003c2-a4be-367a-a19f-39c66334b41d",
                        "entry_id": "76fa2411-ab34-349e-8a19-7cad1b01998d",
                        "glosses": [
                            "Stuhl aus oder mit Rohrgeflecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c062f36-55aa-4c71-b3ce-2690c44765d7",
                                "sense_id": "950003c2-a4be-367a-a19f-39c66334b41d",
                                "text": "„Ein dicker Mann saß, halb aufgerichtet mit geöffnetem Mund, seltsam verkrümmt in der Ecke des Balkons auf einem Korbstuhl.“"
                            },
                            {
                                "example_id": "1ca9448b-9584-4463-9af5-d8fd9860cdef",
                                "sense_id": "950003c2-a4be-367a-a19f-39c66334b41d",
                                "text": "„Er setzte sich in einen der Korbstühle, die zwischen den bepflanzten Amphoren standen, döste eine Weile vor sich hin, blätterte dann wieder in »Jazz-Time«, las aber jetzt, vom blauen Rauch der Gauloises umwölkt, nur die Kritiken, die ihn betrafen.“"
                            },
                            {
                                "example_id": "c9a80a15-23de-4bee-a0a2-8d49751f7081",
                                "sense_id": "950003c2-a4be-367a-a19f-39c66334b41d",
                                "text": "„Ich setze sie in einen Korbstuhl in der Halle.“"
                            },
                            {
                                "example_id": "dee5081c-d97e-4bec-9893-29a942213826",
                                "sense_id": "950003c2-a4be-367a-a19f-39c66334b41d",
                                "text": "„Wie sie so zurückgelehnt in dem Korbstuhl saß, fiel das sanfte Licht eines Lampenschirmes auf sie, spielte über ihr liebes, ernstes Gesicht und verlieh den Ringellocken ihres üppigen Haares einen matten, metallischen Schimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
