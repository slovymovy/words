                    "sense_definition": "Present participle and gerund of <w>hope</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>hoping</w> that the weather will be sunny tomorrow.",
                            "target_lang_translations": {
                                "ru": "Я <w>надеюсь</w>, что завтра будет солнечная погода.",
                                "de": "Ich <w>hoffe</w>, dass das Wetter morgen sonnig sein wird.",
                                "fr": "J'<w>espère</w> qu'il fera beau demain."
                            }
                        },
                        {
                            "text": "She is <w>hoping</w> to visit her family next month.",
                            "target_lang_translations": {
                                "ru": "Она <w>надеется</w> навестить свою семью в следующем месяце.",
                                "de": "Sie <w>hofft</w>, ihre Familie nächsten Monat zu besuchen.",
                                "fr": "Elle <w>espère</w> rendre visite à sa famille le mois prochain."
                            }
                        }
                    ],
                    "common_phrases": [
