                "senses": [
                    {
                        "sense_id": "a2a080b9-93c2-33bc-9319-4c7c2df2e83d",
                        "entry_id": "1e56cd8e-e2f1-386a-afa7-5c4a246e9292",
                        "glosses": [
                            "asketischer Mönch, der sein Leben in Abgewandtheit von der Umwelt allein auf einer säulenartigen Plattform, die nur über eine Leiter erreichbar war, verbrachte (vor allem im 4. bis 6. Jahrhundert nach Christus in Syrien und Palästina)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe79873c-4492-4dde-8d4b-ef16905092a3",
                                "sense_id": "a2a080b9-93c2-33bc-9319-4c7c2df2e83d",
                                "text": "Säulenheilige kamen drei asketischen Idealen nach: dem Verweilen an einem Ort, dem Unbehaustsein und dem Stehen vor Gott."
                            },
                            {
                                "example_id": "f7ef1709-a07a-4732-bdf6-da3445ed3133",
                                "sense_id": "a2a080b9-93c2-33bc-9319-4c7c2df2e83d",
                                "text": "In frühchristlichen Zeiten gab es viele Säulenheilige."
                            },
                            {
                                "example_id": "f05b4a04-eeb1-45aa-bc56-fd78567ecafc",
                                "sense_id": "a2a080b9-93c2-33bc-9319-4c7c2df2e83d",
                                "text": "Die Säulenheiligen waren oft Ziel von Wallfahrern. Sie hatten mit ihren Predigten weitreichenden Einfluss."
                            },
                            {
                                "example_id": "f1ad18be-6b3f-4fcc-b911-7dc8b4ac7aba",
                                "sense_id": "a2a080b9-93c2-33bc-9319-4c7c2df2e83d",
                                "text": "Symeon Stylites der Ältere (* 389 in Sisan im Grenzgebiet zwischen Syrien und Kilikien; † 2. September 459 in Qal'at Sim'an) ging als erster christlicher Säulenheiliger in die Kirchengeschichte ein."
                            },
                            {
                                "example_id": "f35c56f9-a800-4678-aabf-d6094af72a9d",
                                "sense_id": "a2a080b9-93c2-33bc-9319-4c7c2df2e83d",
                                "text": "„Dies steht nicht im Widerspruch zu der wohl belegten These, die in den Porträts der Säulenheiligen aus dem 5. Jh. die ersten Ikonen sieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ab680b26-197a-3d91-b88c-605343b2b1dd",
                        "entry_id": "1e56cd8e-e2f1-386a-afa7-5c4a246e9292",
                        "glosses": [
                            "Person, die auf ihre Art langfristig und bedeutend, stabil und beständig da war"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "23d55887-f2f0-42d1-b047-a44558fdfd99",
                                "sense_id": "ab680b26-197a-3d91-b88c-605343b2b1dd",
                                "text": "„Max Weber ist in Bielefeld immer ein Säulenheiliger gewesen. Warum gerade er?“"
                            },
                            {
                                "example_id": "f050a7bf-d5c9-4792-bdaa-580b423094c5",
                                "sense_id": "ab680b26-197a-3d91-b88c-605343b2b1dd",
                                "text": "„‚Ihr seid doch verrückt‘, schimpfte er, ‚hier mit zwei Karren Beton abzukippen! Ich bin doch nicht Hennecke und auch kein Säulenheiliger‘."
                            },
                            {
                                "example_id": "f1c8047e-7462-4de6-98bd-4bc944ba26f7",
                                "sense_id": "ab680b26-197a-3d91-b88c-605343b2b1dd",
                                "text": "„In Großbritannien ist er doch so etwas wie ein Säulenheiliger.“"
                            },
                            {
                                "example_id": "f8435d54-0cfc-45fb-b4da-2abc6329a1c0",
                                "sense_id": "ab680b26-197a-3d91-b88c-605343b2b1dd",
                                "text": "„Damals aber war Bond ein Säulenheiliger für alle, die einen guten schlechten Geschmack besaßen, und glücklicherweise gab es am Münchener Stachus ein Kino, das über Jahre jede Woche einen anderen Bond zeigte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d696cde1-889b-4843-b46a-2983bd14c932",
                        "source_entry_id": "1e56cd8e-e2f1-386a-afa7-5c4a246e9292",
                        "source_sense_id": "a2a080b9-93c2-33bc-9319-4c7c2df2e83d",
                        "source_sense_description": "asketischer Mönch",
                        "target_lang_word": "stylite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stylite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60e86d5b-7c13-3920-83c9-3610f8bb1a49",
                                        "entry_id": "2d97ad2f-8a5c-3a9d-bf44-a960c0217a1e",
                                        "glosses": [
                                            "A Christian ascetic in ancient times who lived alone on top of a tall pillar."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1967958-c4d8-4aed-80ff-deb049a1cb5e",
                                                "sense_id": "60e86d5b-7c13-3920-83c9-3610f8bb1a49",
                                                "text": "Daniel, the famous stylite of the city, actually descended from his pillar for the first time in fifteen years, terrifying Basiliscus into the withdrawal of his edict."
                                            },
                                            {
                                                "example_id": "4b9640b7-d341-46d2-a3e6-60b42e92baa6",
                                                "sense_id": "60e86d5b-7c13-3920-83c9-3610f8bb1a49",
                                                "text": "Stylites often became major players in Church politics, shouting down their theological pronouncements from their little elevated balconies to the expectant crowds below, or giving personalized advice to those favoured enough to climb the ladder and join them on their platform."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
