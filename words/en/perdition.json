{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ccd5bc1-d2a5-3287-b181-d0f0a52d767b",
                    "sense_definition": "Complete and utter ruin or destruction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their reckless investments during the financial crisis led directly to their financial <w>perdition</w>.",
                            "target_lang_translations": {
                                "ru": "Их безрассудные инвестиции во время финансового кризиса привели непосредственно к их финансовому <w>краху</w>."
                            }
                        },
                        {
                            "text": "The corrupt regime marched blindly toward political <w>perdition</w> despite warnings from advisors.",
                            "target_lang_translations": {
                                "ru": "Коррумпированный режим слепо шел к политической <w>гибели</w>, несмотря на предостережения советников."
                            }
                        }
                    ],
                    "antonyms": [
                        "salvation"
                    ],
                    "common_phrases": [
                        "road to perdition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полное и окончательное крушение или разорение; неминуемая гибель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гибель",
                                "target_lang_sense_clarification": "полный крах, разорение или крушение"
                            },
                            {
                                "target_lang_word": "крах",
                                "target_lang_sense_clarification": "полное разрушение надежд или положения"
                            },
                            {
                                "target_lang_word": "погибель",
                                "target_lang_sense_clarification": "трагический конец, гибельное состояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d445289-82dc-32b5-be0b-df3fc0a92332",
                    "sense_definition": "A state of eternal damnation into which a sinful and unrepentant person passes after death.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "afterlife",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher warned the congregation that a life of deceit would lead their souls to <w>perdition</w>.",
                            "target_lang_translations": {
                                "ru": "Проповедник предупреждал прихожан, что жизнь во лжи обречет их души на <w>вечную погибель</w>."
                            }
                        },
                        {
                            "text": "He feared that his unrepented crimes had condemned him to everlasting <w>perdition</w>.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что его нераскаянные грехи обрекли его на вечное <w>проклятие</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "salvation"
                    ],
                    "common_phrases": [
                        "son of perdition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вечное проклятие и муки души нераскаявшегося грешника в загробной жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проклятие",
                                "target_lang_sense_clarification": "вечное осуждение души на муки"
                            },
                            {
                                "target_lang_word": "погибель",
                                "target_lang_sense_clarification": "вечная смерть души, погибель грешника"
                            },
                            {
                                "target_lang_word": "осуждение",
                                "target_lang_sense_clarification": "вечное религиозное наказание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97246f8c-91c3-3c2a-a564-2cb90fbe8b87",
                    "sense_definition": "The abode of Satan and the damned; hell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "afterlife",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the epic poem, the fallen angel was cast out of heaven into the dark depths of <w>perdition</w>.",
                            "target_lang_translations": {
                                "ru": "В эпической поэме падший ангел был изгнан с небес в темные глубины <w>преисподней</w>."
                            }
                        },
                        {
                            "text": "Medieval paintings often depict sinners being dragged down into fiery <w>perdition</w>.",
                            "target_lang_translations": {
                                "ru": "Средневековые картины часто изображают грешников, увлекаемых в огненную <w>геенну</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "abyss",
                        "Hades",
                        "inferno",
                        "netherworld",
                        "underworld",
                        "hell"
                    ],
                    "common_phrases": [
                        "fires of perdition"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or religious contexts to designate hell"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преисподняя, обитель Сатаны и осуждённых на вечные муки; ад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "геенна",
                                "target_lang_sense_clarification": "преисподняя, место вечных мук"
                            },
                            {
                                "target_lang_word": "ад",
                                "target_lang_sense_clarification": "обитель дьявола и грешников"
                            },
                            {
                                "target_lang_word": "преисподняя",
                                "target_lang_sense_clarification": "подземное царство грешников"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}