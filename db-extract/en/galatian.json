                "translations": [
                    {
                        "translation_id": "6cd66d4d-9d5f-4e12-afbc-c78c27cd6746",
                        "source_entry_id": "c5d152fd-caa7-3e7b-8b41-e15e9496d790",
                        "source_sense_description": "person from Galatia",
                        "target_lang_word": "Galate",
