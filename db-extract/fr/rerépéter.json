                        "glosses": [
                            "Répéter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d049a8f-6f61-4028-88b0-fe250e8263ef",
                                "sense_id": "2c042f56-1c4f-376c-b870-33a6321b95bb",
                                "text": "D’où la nécessité de répéter, et de rerépéter la vérité, pour l’enfoncer dans les esprits rebelles comme un clou dans un bois trop dur."
                            },
                            {
                                "example_id": "d6b54802-1bdd-4b48-9398-362dceec17d8",
                                "sense_id": "2c042f56-1c4f-376c-b870-33a6321b95bb",
                                "text": "Au risque de me rerépéter je vais à nouveau évoquer cela dans la deuxième partie du livre pour lever toute ambiguïté."
                            }
                        ]
