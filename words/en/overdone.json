{
    "word_family": [
        "overdo",
        "overdoing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02bb11f4-ab23-39e2-ba30-2cb2070d99d1",
                    "sense_definition": "Cooked for too long, resulting in a dry or burnt state.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steak was <w>overdone</w> and very difficult to chew.",
                            "target_lang_translations": {
                                "ru": "Стейк был <w>пережарен</w>, и его было очень трудно жевать."
                            }
                        },
                        {
                            "text": "I prefer my vegetables slightly crunchy rather than <w>overdone</w> and mushy.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю, чтобы овощи слегка хрустели, а не были <w>переваренными</w> и мягкими."
                            }
                        }
                    ],
                    "synonyms": [
                        "overcooked"
                    ],
                    "antonyms": [
                        "underdone",
                        "rare"
                    ],
                    "common_phrases": [
                        "slightly overdone",
                        "badly overdone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приготовленный слишком долго, в результате чего блюдо стало сухим или подгоревшим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пережаренный",
                                "target_lang_sense_clarification": "о мясе или овощах"
                            },
                            {
                                "target_lang_word": "переваренный",
                                "target_lang_sense_clarification": "об овощах или пасте"
                            },
                            {
                                "target_lang_word": "передержанный",
                                "target_lang_sense_clarification": "в духовке или на огне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3999a885-096a-3cf9-8170-edc1e293772f",
                    "sense_definition": "Carried to excess or performed with too much emphasis; exaggerated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor's performance was a bit <w>overdone</w> and lacked any real subtlety.",
                            "target_lang_translations": {
                                "ru": "Игра актера была немного <w>наигранной</w>, ей не хватало подлинной тонкости."
                            }
                        },
                        {
                            "text": "There are lots of pauses and some rather <w>overdone</w> limping in the play.",
                            "target_lang_translations": {
                                "ru": "В пьесе много пауз и довольно <w>утрированная</w> хромота."
                            }
                        }
                    ],
                    "synonyms": [
                        "exaggerated",
                        "excessive",
                        "overwrought"
                    ],
                    "antonyms": [
                        "subtle",
                        "understated"
                    ],
                    "common_phrases": [
                        "rather overdone",
                        "bit overdone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доведенный до крайности или выполненный с излишним акцентом; преувеличенный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чрезмерный",
                                "target_lang_sense_clarification": "слишком интенсивный"
                            },
                            {
                                "target_lang_word": "утрированный",
                                "target_lang_sense_clarification": "нарочито подчеркнутый"
                            },
                            {
                                "target_lang_word": "наигранный",
                                "target_lang_sense_clarification": "об актерской игре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "690059db-0d0a-327a-bb39-4f97ce0c94c0",
                    "sense_definition": "Used or repeated so frequently that it has become uninteresting or cliché.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trope of the secret twin is completely <w>overdone</w> in modern soap operas.",
                            "target_lang_translations": {
                                "ru": "Троп с тайным близнецом совершенно <w>избит</w> в современных мыльных операх."
                            }
                        },
                        {
                            "text": "Critics felt that the joke was <w>overdone</w> and no longer funny by the end.",
                            "target_lang_translations": {
                                "ru": "Критики посчитали, что шутка была слишком <w>заезженной</w> и к концу перестала быть смешной."
                            }
                        }
                    ],
                    "synonyms": [
                        "hackneyed",
                        "clichéd",
                        "trite"
                    ],
                    "antonyms": [
                        "original",
                        "fresh"
                    ],
                    "common_phrases": [
                        "completely overdone",
                        "overdone trope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используемый или повторяемый настолько часто, что стал неинтересным или клише."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избитый",
                                "target_lang_sense_clarification": "о теме или шутке"
                            },
                            {
                                "target_lang_word": "заезженный",
                                "target_lang_sense_clarification": "о приеме или фразе"
                            },
                            {
                                "target_lang_word": "приевшийся",
                                "target_lang_sense_clarification": "надоевший из-за частоты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33bd902e-6743-3a49-b756-0d053c03831d",
                    "sense_definition": "past participle of <w>overdo</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I think you have <w>overdone</w> the exercise and should rest your muscles.",
                            "target_lang_translations": {
                                "ru": "Я думаю, ты <w>переусердствовал</w> с упражнениями, и твоим мышцам нужно отдохнуть."
                            }
                        },
                        {
                            "text": "She realized she had <w>overdone</w> the decorations when the room felt crowded.",
                            "target_lang_translations": {
                                "ru": "Она поняла, что <w>переборщила</w> с украшениями, когда в комнате стало тесно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have overdone",
                        "had overdone"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола overdo (переусердствовать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переусердствовал",
                                "target_lang_sense_clarification": "сделал слишком много"
                            },
                            {
                                "target_lang_word": "переборщил",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}