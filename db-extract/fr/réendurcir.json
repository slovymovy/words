                "senses": [
                    {
                        "sense_id": "bb4bb0af-0fc7-3727-9083-8fa0f41e7a1a",
                        "entry_id": "b9a5985b-d896-34cb-9b0c-f0bcab5f166b",
                        "glosses": [
                            "Endurcir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03dd80bf-9817-4ef5-adf9-9d6fcecc677f",
                                "sense_id": "bb4bb0af-0fc7-3727-9083-8fa0f41e7a1a",
                                "text": "Son cœur, remué, ouvert, déchiré jusqu'au fond par la récente blessure, n'avait pas encore eu le temps de se refermer, de se réendurcir et laissait voir (...)"
                            },
                            {
                                "example_id": "3c0879ea-4791-4fb6-9335-3a55276fb0de",
                                "sense_id": "bb4bb0af-0fc7-3727-9083-8fa0f41e7a1a",
                                "text": "(...) tu m'as rendu mon cœur que j'avais changé en roc, il ya longtemps, longtemps de cela, quand pour préserver mon intégrité, j'avais dû me durcir contre ma mère, et puis il avait fallu me réendurcir pour résister à Roberte, mais maintenant, tant que je saurai que tu m'aimes (...)"
                            }
                        ]
                    }
