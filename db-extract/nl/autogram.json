                                    {
                                        "sense_id": "23054cb2-41d1-39b1-8b9f-6935ecf8a0f8",
                                        "entry_id": "8902e017-cd87-3a45-bc4d-95751880a639",
                                        "glosses": [
                                            "To sign, or write one’s name or signature on a book, etc."
