                        "sense_id": "2b1ffa9b-00b7-3bfa-885d-55d24bdfe5e6",
                        "entry_id": "6bc64d7c-5f7c-3b89-b200-ca8aa0bb5599",
                        "glosses": [
                            "A party."
                        ],
                        "tags": [
                            "South-Africa",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "82da9040-40f4-41f7-8012-8672d63d959e",
                                "sense_id": "2b1ffa9b-00b7-3bfa-885d-55d24bdfe5e6",
                                "text": "—Oh sure, high spirits, a jol that went a bit over the top."
                            },
                            {
                                "example_id": "e3f26f1b-4cf4-41f0-bd7e-1da16708c0e5",
                                "sense_id": "2b1ffa9b-00b7-3bfa-885d-55d24bdfe5e6",
                                "text": "I had a jol observing the Friday mix at the Radisson RED’s Roof Bar and the engagement between the patrons, especially between the older men and younger women."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4b7304ec-b365-3ed6-87c4-cc48b0d375da",
