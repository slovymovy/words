                "senses": [
                    {
                        "sense_id": "75d1c89c-f862-3434-92b2-3b08eb58858e",
                        "entry_id": "843b9225-760c-3b36-83d8-c11d41a038c1",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a768908-4d29-42cf-b6eb-92e76feb61f3",
                                "sense_id": "75d1c89c-f862-3434-92b2-3b08eb58858e",
                                "text": "Frau Hügele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8885b621-aa69-48e7-9e0a-b2e588221e0f",
                                "sense_id": "75d1c89c-f862-3434-92b2-3b08eb58858e",
                                "text": "Herr Hügele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "11e61bac-0211-4cb3-8789-54ec0a4f031c",
                                "sense_id": "75d1c89c-f862-3434-92b2-3b08eb58858e",
                                "text": "Die Hügeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a2f2f039-fc48-4f1e-93db-ceb3ced2cfe7",
                                "sense_id": "75d1c89c-f862-3434-92b2-3b08eb58858e",
                                "text": "Der Hügele trägt nie die Pullover, die die Hügele ihm strickt."
                            },
                            {
                                "example_id": "175b6dd5-8947-4f90-a1cf-46d5d3953f9f",
                                "sense_id": "75d1c89c-f862-3434-92b2-3b08eb58858e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hügele kommt, geht der Herr Hügele.“"
                            },
                            {
                                "example_id": "e6f554ea-33eb-459a-b9d5-bb574b29e34c",
                                "sense_id": "75d1c89c-f862-3434-92b2-3b08eb58858e",
                                "text": "Hügele kommt und geht."
                            },
                            {
                                "example_id": "6992a452-5822-4439-899b-f03955a83e9b",
                                "sense_id": "75d1c89c-f862-3434-92b2-3b08eb58858e",
                                "text": "Hügeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
