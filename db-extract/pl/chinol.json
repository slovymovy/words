                "translations": [
                    {
                        "translation_id": "ec13c055-d0b3-4f6f-877c-26994bc0d7f0",
                        "source_entry_id": "c62aa08e-187c-3d8d-ab63-a68208782e74",
                        "source_sense_id": "b970fffa-5d40-3228-a4a3-02645f7341d0",
                        "target_lang_word": "chink",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a6eb494-bda6-3a89-be25-1348f4df8f2f",
                                        "entry_id": "6c608a2c-e688-3c0f-ac04-7794734619a7",
                                        "glosses": [
                                            "A narrow opening such as a fissure or crack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5e894fc-a8ac-4be1-8117-1fed41b5ccdc",
                                                "sense_id": "5a6eb494-bda6-3a89-be25-1348f4df8f2f",
                                                "text": "What a pity they didn’t stop up the chinks and the crannies though, and thrust in a little lint here and there."
                                            },
                                            {
                                                "example_id": "8d487fe6-b324-4710-b420-f4c1cb383708",
                                                "sense_id": "5a6eb494-bda6-3a89-be25-1348f4df8f2f",
                                                "text": "Yet I did not give way, but settled to wait for the dawn, which must, I knew, be now at hand; for then I thought enough light would come through the chinks of the tomb above to show me how to set to work."
                                            },
                                            {
                                                "example_id": "a30c3263-c4c8-4534-a2ce-113fbbc9dbec",
                                                "sense_id": "5a6eb494-bda6-3a89-be25-1348f4df8f2f",
                                                "text": "Through one cloudless chink, in a black, stormy sky, / Shines out the dewy morning star."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9640966-d360-3798-a7f0-d4efa9bc64de",
                                        "entry_id": "6c608a2c-e688-3c0f-ac04-7794734619a7",
                                        "glosses": [
                                            "A narrow opening such as a fissure or crack.",
                                            "A narrow beam or patch of light admitted by such an opening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39cd64c7-4a09-4a0e-a6ed-a8782d8b0a05",
                                                "sense_id": "a9640966-d360-3798-a7f0-d4efa9bc64de",
                                                "text": "I noticed a chink of light under the door."
                                            },
                                            {
                                                "example_id": "9fec1ea2-e557-4bc8-a6e3-05694ff04046",
                                                "sense_id": "a9640966-d360-3798-a7f0-d4efa9bc64de",
                                                "text": "A chink of light offering a possible settlement to one part of the rail dispute comes as the RMT is to ballot its members at Network Rail on whether to accept an improved offer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c5f1843-da6b-30dc-a462-c74eaba2daba",
                                        "entry_id": "6c608a2c-e688-3c0f-ac04-7794734619a7",
                                        "glosses": [
                                            "A chip or dent in something metallic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a71d3ac-4792-4b58-a57c-7b83d14a7272",
                                                "sense_id": "3c5f1843-da6b-30dc-a462-c74eaba2daba",
                                                "text": "The warrior saw a chink in her enemy's armor, and aimed her spear accordingly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ecf735f-ac47-384a-b340-e2e188668e33",
                                        "entry_id": "6c608a2c-e688-3c0f-ac04-7794734619a7",
                                        "glosses": [
                                            "A vulnerability or flaw in a protection system or in any otherwise formidable system."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af39096-72a8-4872-9a9f-d9bb36c47db0",
                                                "sense_id": "5ecf735f-ac47-384a-b340-e2e188668e33",
                                                "text": "The chink in the theory is that the invaders have superior muskets."
                                            },
                                            {
                                                "example_id": "5d5071ac-b0d4-463e-9d12-b430f95d84b3",
                                                "sense_id": "5ecf735f-ac47-384a-b340-e2e188668e33",
                                                "text": "The first chink in Arsenal's relaxed afternoon occurred when key midfielder Samir Nasri pulled up with a hamstring injury and was replaced."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4e74568-0d06-3119-b6ca-4dad16d099a0",
                                        "entry_id": "bafc6842-0b22-3ed5-83a1-79f3d9fdda8e",
                                        "glosses": [
                                            "To fill an opening such as the space between logs in a log house with chinking; to caulk."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39eb36e2-56b7-4f58-910f-fb01c4fafe9e",
                                                "sense_id": "d4e74568-0d06-3119-b6ca-4dad16d099a0",
                                                "text": "to chink a wall"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "904de89e-8de2-3b73-a293-d8097d614bf3",
                                        "entry_id": "bafc6842-0b22-3ed5-83a1-79f3d9fdda8e",
                                        "glosses": [
                                            "To crack; to open."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae47dae6-0060-3ed0-b1c3-a2a3581fadde",
                                        "entry_id": "bafc6842-0b22-3ed5-83a1-79f3d9fdda8e",
                                        "glosses": [
                                            "To cause to open in cracks or fissures."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47ec78ea-01e4-35e0-8533-cc0debed3f6a",
                                        "entry_id": "c9fa422c-0b1c-369e-a5b0-616e472ae95f",
                                        "glosses": [
                                            "A slight sound as of metal objects touching each other; a clink."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a89363b-2cc6-4645-ac48-70da49a7b554",
                                                "sense_id": "47ec78ea-01e4-35e0-8533-cc0debed3f6a",
                                                "text": "She swallow, set the cup down like she want to break it, and the ice-blocks jump, make a chink sound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4408a305-cd86-35d0-adcd-35920fa3ef20",
                                        "entry_id": "c9fa422c-0b1c-369e-a5b0-616e472ae95f",
                                        "glosses": [
                                            "Ready money, especially in the form of coins."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "colloquial",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f3544fa-52e6-46b4-925f-d3f350a475a2",
                                                "sense_id": "4408a305-cd86-35d0-adcd-35920fa3ef20",
                                                "text": "to leave his chink to better hands"
                                            },
                                            {
                                                "example_id": "a69de396-9814-43ab-b23d-37925d471117",
                                                "sense_id": "4408a305-cd86-35d0-adcd-35920fa3ef20",
                                                "text": "I thought that if all the hills about there were pure chink, and all belonged to me, I would give them if I could just talk to her when I wanted to […]"
                                            },
                                            {
                                                "example_id": "9bc5f48e-0c6a-45ee-b02c-47a016fcab1f",
                                                "sense_id": "4408a305-cd86-35d0-adcd-35920fa3ef20",
                                                "text": "At the same time, mind, I must have a bit of a frolic occasionally, for that's all the pleasure I has, when I gets a little chink in my becket; and ye know, too, that I don t care much for that stuff, for a dollar goes with me as fur as a gold ounce does with you, when ye put on your grand airs, and shower it about like a nabob."
                                            },
                                            {
                                                "example_id": "6704ad34-eea9-47d2-bd8b-6f8103c39c69",
                                                "sense_id": "4408a305-cd86-35d0-adcd-35920fa3ef20",
                                                "text": "Now by [the] third part you will hear\nThis young man, as it does appear,\nWith care he then secur'd his chink,\nAnd to this vintner went to drink."
                                            },
                                            {
                                                "example_id": "eadd7352-1bc1-4083-9533-1f69e57e35ce",
                                                "sense_id": "4408a305-cd86-35d0-adcd-35920fa3ef20",
                                                "text": "\"I believe I could make a pudding that wasn't plain, if I tried,\" Alice said. \"Why shouldn't we?\"\n\"No chink,\" said Oswald, with brief sadness.\n\"How much would it cost?\" Noël asked, and added that Dora had twopence and H.O. had a French halfpenny."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e435a1d-2db4-36ff-a0ac-153ce6a92d4d",
                                        "entry_id": "ecde7592-d56b-3e46-a7c4-86fbba9242c1",
                                        "glosses": [
                                            "To make a slight sound like that of metal objects touching."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
