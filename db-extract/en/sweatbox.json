                        "examples": [
                            {
                                "example_id": "3dc16c46-886e-4db3-b3fb-7179ef07ea66",
                                "sense_id": "c58caef2-8246-3303-b491-c968bcb7fe96",
                                "text": "Australia Post has been accused of endangering staff with \"sweatbox\" uniforms and restricting earlier starts to save money."
                            }
                        ]
                    },
                    {
                        "sense_id": "34283560-976b-36d4-bbaa-e0623feca949",
