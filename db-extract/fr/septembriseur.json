                    {
                        "sense_id": "de741180-8f35-3236-b822-f04178e83889",
                        "entry_id": "cdae8a1f-320a-3209-8480-14d43769ae55",
                        "glosses": [
                            "Auteur des massacres de Septembre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a692b40-632a-4ce2-8193-0ecdc8dc9f90",
                                "sense_id": "de741180-8f35-3236-b822-f04178e83889",
                                "text": "Nous retrouverons tous ces caractères chez une des foules qui laissèrent un des plus sinistres souvenirs de notre histoire : les septembriseurs."
                            },
                            {
                                "example_id": "157aa45f-2d1a-4732-ac55-f1c8de1173aa",
                                "sense_id": "de741180-8f35-3236-b822-f04178e83889",
                                "text": "Louvet demanda la mise en accusation de Robespierre et des septembriseurs."
                            },
                            {
                                "example_id": "146d9b0d-74fd-40f5-8032-9adc89b2a92f",
                                "sense_id": "de741180-8f35-3236-b822-f04178e83889",
                                "text": "Loin de requérir la moindre peine contre nos septembriseurs littéraires, il leur déclare avec humilité qu'il n'a point l'orgueil d'être un grand maître."
                            },
                            {
                                "example_id": "8e654a70-87d6-422b-83f8-d3c2106dcc02",
                                "sense_id": "de741180-8f35-3236-b822-f04178e83889",
                                "text": "la pestilence athée a affolé la plèbe et l'a faite septembriseuse, communarde, nihiliste."
                            }
                        ]
                    }
