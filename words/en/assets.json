{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51b44ad7-2ca0-390d-be83-d51f64ee8800",
                    "sense_definition": "Property or items of value owned by a person or company, regarded as having value and available to meet debts, commitments, or legacies.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "financial_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has significant <w>assets</w> in the form of real estate and equipment.",
                            "target_lang_translations": {
                                "ru": "У компании есть значительные <w>активы</w> в виде недвижимости и оборудования.",
                                "zh": "该公司拥有大量以房地产和设备形式存在的<w>资产</w>。"
                            }
                        },
                        {
                            "text": "We need to liquidate some <w>assets</w> to pay off the immediate debt.",
                            "target_lang_translations": {
                                "ru": "Нам нужно ликвидировать некоторые <w>активы</w>, чтобы погасить срочный долг.",
                                "zh": "我们需要变现一些<w>资产</w>来偿还迫在眉睫的债务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resources",
                        "property",
                        "holdings",
                        "capital",
                        "wealth",
                        "possessions",
                        "funds"
                    ],
                    "antonyms": [
                        "liabilities",
                        "debts"
                    ],
                    "common_phrases": [
                        "liquid assets",
                        "fixed assets",
                        "current assets",
                        "total assets",
                        "freeze assets",
                        "net assets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имущество или ценности, принадлежащие лицу или компании, которые имеют денежную стоимость и могут быть использованы для погашения долгов.",
                        "zh": "个人或公司拥有的具有价值的财产或项目，可用于偿还债务、履行承诺或作为遗产。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "активы",
                                "target_lang_sense_clarification": "финансовые ресурсы"
                            },
                            {
                                "target_lang_word": "имущество",
                                "target_lang_sense_clarification": "собственность"
                            },
                            {
                                "target_lang_word": "средства",
                                "target_lang_sense_clarification": "капитал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "资产",
                                "target_lang_sense_clarification": "金融资源或财产"
                            },
                            {
                                "target_lang_word": "财产",
                                "target_lang_sense_clarification": "拥有的物品或财富"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f34f132a-9a26-3cd4-abfd-44fcc10339e1",
                    "sense_definition": "Plural of <w>asset</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_plural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her intelligence and patience are her greatest <w>assets</w>.",
                            "target_lang_translations": {
                                "ru": "Её интеллект и терпение — её главные <w>достоинства</w>.",
                                "zh": "她的智慧和耐心是她最大的<w>优点</w>。"
                            }
                        },
                        {
                            "text": "The new employees quickly proved to be valuable <w>assets</w> to the team.",
                            "target_lang_translations": {
                                "ru": "Новые сотрудники быстро доказали, что они — ценное <w>приобретение</w> для команды.",
                                "zh": "新员工很快证明了他们是团队中<w>宝贵的财富</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "advantages",
                        "benefits",
                        "strengths",
                        "qualities",
                        "talents"
                    ],
                    "antonyms": [
                        "liabilities",
                        "weaknesses",
                        "disadvantages",
                        "handicaps"
                    ],
                    "common_phrases": [
                        "valuable assets",
                        "key assets",
                        "greatest assets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полезные качества, навыки или люди, приносящие пользу и являющиеся преимуществом.",
                        "zh": "指具有价值的品质、技能或能够带来益处的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достоинства",
                                "target_lang_sense_clarification": "положительные качества"
