                "senses": [
                    {
                        "sense_id": "294d39b2-5ab7-3d60-8c3d-4aaea16842e8",
                        "entry_id": "b49b3d20-1302-3ed9-a16e-db3b9c804288",
                        "glosses": [
                            "das waagerechte, balkenförmige, tragende Konstruktionselement über einer Türöffnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ab0d215-6516-43d6-a5ce-67d450d34293",
                                "sense_id": "294d39b2-5ab7-3d60-8c3d-4aaea16842e8",
                                "text": "Wenn er seine Großeltern besuchte, stieß sich Max oft den Kopf an dem niedrigen Türsturz, sobald er ihr altes Häuschen betrat."
                            },
                            {
                                "example_id": "e62a3245-e292-4571-b489-821d5324978c",
                                "sense_id": "294d39b2-5ab7-3d60-8c3d-4aaea16842e8",
                                "text": "Türstürze sind in verschiedenen Standardmaßen erhältlich."
                            },
                            {
                                "example_id": "c1866d8e-e57d-4137-b9c9-c8d97c870241",
                                "sense_id": "294d39b2-5ab7-3d60-8c3d-4aaea16842e8",
                                "text": "Die Oberfläche des Türsturzes war stark beschädigt."
                            },
                            {
                                "example_id": "29bc70e0-070d-41c9-b1e2-206073c053ac",
                                "sense_id": "294d39b2-5ab7-3d60-8c3d-4aaea16842e8",
                                "text": "„Da fast das gesamte Holz in Deckenbalken und Türstürzen verbaut wurde, blieb kaum ein Scheit für andere Zwecke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
