                    },
                    {
                        "sense_id": "89b53586-f1d9-3b70-a49c-b702a1641341",
                        "entry_id": "a76f9a59-7aaa-37df-8312-e9baf587bbdc",
                        "glosses": [
                            "Appareil avec lequel on fait faire aux muscles des exercices d’extension."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9df8c9-4d6a-4e4c-bcf1-422a4ff3a008",
                                "sense_id": "89b53586-f1d9-3b70-a49c-b702a1641341",
                                "text": "Gymnastique à l’extenseur."
                            },
                            {
                                "example_id": "bd8836f8-9a55-492f-ad98-f72496c6abe0",
                                "sense_id": "89b53586-f1d9-3b70-a49c-b702a1641341",
                                "text": "Il s'empara de l'extenseur à son tour, écarta les bras l'un de l'autre lentement, jusqu'à s'appliquer les élastiques sur la poitrine, et revint à la position première. Il était un peu pâle et la veine verticale de son front battait."
                            }
                        ]
                    },
