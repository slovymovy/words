                        "examples": [
                            {
                                "example_id": "e523add6-a609-4f50-94db-8cc81a593443",
                                "sense_id": "e677e3d7-9dc5-33d5-801c-f776c770a539",
                                "text": "Met deze overname krijgt Microsoft toegang tot al die ontwikkelaars, in totaal zo'n 28 miljoen. Volgens The Verge is de overname een logische stap, nu de softwaremaker zijn eigen alternatief in december de nek om heeft gedraaid. Duizend Microsoft-medewerkers zijn inmiddels actief op het platform."
                            },
                            {
                                "example_id": "c39cb37f-c80f-4da8-b7cc-abfae4828130",
                                "sense_id": "e677e3d7-9dc5-33d5-801c-f776c770a539",
                                "text": "Na Apple heeft ook Microsoft gezegd dat het de omzetverwachting naar beneden bij moet stellen als gevolg van het coronavirus. De softwaremaker sprak vorige maand de verwachting uit dat de divisie die onder meer Windows-licenties verkoopt omgerekend tussen de 9,9 miljard en 10,2 miljard euro omzet zou opleveren. Het denkt nu dat dit lager uitvalt."
                            },
                            {
                                "example_id": "e4c7ac05-06f1-4c12-89d2-3c9e16908cde",
                                "sense_id": "e677e3d7-9dc5-33d5-801c-f776c770a539",
                                "text": "Eerder deze week besloten de kledingmerken Patagonia en The North Face, het freelance-platform Upwork en softwaremaker Mozilla om in de maand juli geen advertenties op Facebook te plaatsen."
                            }
                        ]
                    }
