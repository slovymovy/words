        "fr-extract.jsonl": [
            {
                "entry_id": "51c543a0-a47b-3f2a-854c-3bbf66008152",
                "word": "recrutement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7eccaabe-2153-458a-8add-05f2e39711c9",
                        "entry_id": "51c543a0-a47b-3f2a-854c-3bbf66008152",
                        "tags": [
                            "plural"
                        ],
                        "form": "recrutements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                        "entry_id": "51c543a0-a47b-3f2a-854c-3bbf66008152",
                        "glosses": [
                            "Action de recruter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245dfc4e-c057-4f9d-96bf-287ce8186887",
                                "sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                                "text": "Tout ce monde achète, vend, brocante. Des prélats spéculent sur les terrains et les constructions, des lazaristes sur les agences de recrutement militaire, etc., etc."
                            },
                            {
                                "example_id": "c41ad57a-855b-4ef0-b85e-7bdbce0a6b38",
                                "sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                                "text": "Le recrutement se fait à proximité : 70 % des munitionnettes de chez Panhard résident à Paris, 49 % dans le seul XIII^(ème) arrondissement où est localisée l'usine, et 28,7 % dans la banlieue sud […]."
                            },
                            {
                                "example_id": "d6649b5d-6b5f-4467-ab23-2693332c4b06",
                                "sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                                "text": "- Quoique le recrutement se fasse en entier par engagemens volontaires, et sous la direction du commandant en chef de l’armée, ce sont les Magistrats qui reçoivent et constatent l’engagement des recrues; […]."
                            },
                            {
                                "example_id": "3913ff72-abee-4299-a725-7319e218188e",
                                "sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                                "text": "Les situations où les semenciers sont trop rares pour opter pour une régénération naturelle sont plus fréquentes, notamment dans des secteurs d’anciens taillis-sous-futaie où le recrutement des baliveaux était contraint par la dynamique du charme, ce qui a conduit à un appauvrissement en chêne des peuplements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b3189fd-8a61-4d0a-b992-199caa4cd2a8",
                        "source_entry_id": "51c543a0-a47b-3f2a-854c-3bbf66008152",
                        "source_sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                        "target_lang_word": "Rekrutierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rekrutierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f3514fd-7c74-3af8-9edc-18f8d9946488",
                                        "entry_id": "f649dcf9-9430-3bfb-be9a-66e130e10ace",
                                        "glosses": [
                                            "Aktion, um Personen zwangsweise zum Dienst heranzuziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daa7b613-a77c-47ea-845b-7e0d9216e821",
                                                "sense_id": "2f3514fd-7c74-3af8-9edc-18f8d9946488",
                                                "text": "„Wer sich der Rekrutierung widersetzte, wurde verprügelt.“"
                                            },
                                            {
                                                "example_id": "3eb62c4e-729f-48c5-ba6e-3c51ef8bd6bf",
                                                "sense_id": "2f3514fd-7c74-3af8-9edc-18f8d9946488",
                                                "text": "„Die Rekrutierung dieser Truppen verlief organisiert und wurde von den Fuggern finanziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea4e0e14-a3b0-3a25-9494-06441736b9b1",
                                        "entry_id": "f649dcf9-9430-3bfb-be9a-66e130e10ace",
                                        "glosses": [
                                            "Werbung/Zusammenstellung von Personen für eine bestimmte Aufgabe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e5d60f-4121-47cd-87ab-6ac74d9a5384",
                                                "sense_id": "ea4e0e14-a3b0-3a25-9494-06441736b9b1",
                                                "text": "Für die Rekrutierung einer schlagkräftigen Mannschaft allein aus dem Vereinsnachwuchs ist es noch zu früh."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
