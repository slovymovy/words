                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ee81dfa-3ec5-4b09-b069-2bf0b9a110ee",
                                                "sense_id": "b62b8fc9-b1a2-38a0-bcc1-43a542ee0945",
                                                "text": "We're working on some new designs for our range of summer shirts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17acc717-b733-3132-b472-1db13a2c01e4",
                                        "entry_id": "22425063-91fd-3878-9c42-9a26620970fb",
                                        "glosses": [
                                            "The composition of a work of art."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d6e7fa3-f113-31c1-a38f-afb51517bbaf",
                                        "entry_id": "22425063-91fd-3878-9c42-9a26620970fb",
                                        "glosses": [
                                            "Intention or plot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de1aa443-2eee-451d-94f2-ee493722ca2e",
                                                "sense_id": "4d6e7fa3-f113-31c1-a38f-afb51517bbaf",
                                                "text": "We have designs on winning the league next season."
                                            },
                                            {
                                                "example_id": "79f1dd6b-0a9b-4b66-9964-e2caf9ee74c1",
                                                "sense_id": "4d6e7fa3-f113-31c1-a38f-afb51517bbaf",
                                                "text": "To be hateful of the truth by design."
                                            },
                                            {
                                                "example_id": "6deac591-eb74-4a82-b3d5-508c538508b5",
                                                "sense_id": "4d6e7fa3-f113-31c1-a38f-afb51517bbaf",
                                                "text": "I give it you without any other design than to shew you that I reckon nothing dear to me, when I want to do you a pleasure."
                                            },
                                            {
                                                "example_id": "4e9b3cef-1436-450b-8f2a-06a283102f6d",
                                                "sense_id": "4d6e7fa3-f113-31c1-a38f-afb51517bbaf",
                                                "text": "At length, one night, when the company by ſome accident broke up much ſooner than ordinary, ſo that the candles were not half burnt out, ſhe was not able to reſiſt the temptation, but reſolved to have them ſome way or other. Accordingly, as ſoon as the hurry was over, and the ſervants, as ſhe thought, all gone to ſleep, ſhe ſtole out of her bed, and went down ſtairs, naked to her ſhift as ſhe was, with a deſign to ſteal them […]"
                                            },
                                            {
                                                "example_id": "8495703e-0bcb-44ac-bab1-3b1beefddebc",
                                                "sense_id": "4d6e7fa3-f113-31c1-a38f-afb51517bbaf",
                                                "text": "Lisicki will rise from her current ranking of 62 to at least 35 in the world on the back of her efforts at the All England Club, but she will have serious designs on a first Grand Slam title after overcoming the 2007 runner-up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a181203c-f484-3da6-9463-57ad359cc491",
                                        "entry_id": "22425063-91fd-3878-9c42-9a26620970fb",
                                        "glosses": [
                                            "Intention or plot.",
                                            "Malicious or malevolent intention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b74525d6-d959-4a87-9b3a-9eeba7dc37fb",
                                                "sense_id": "a181203c-f484-3da6-9463-57ad359cc491",
                                                "text": "To have evil designs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c112f886-7de7-38ee-822a-83929eee890e",
                                        "entry_id": "22425063-91fd-3878-9c42-9a26620970fb",
                                        "glosses": [
                                            "The shape or appearance given to an object, especially one that is intended to make it more attractive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8f18766-68b6-446f-a817-ef249826611a",
                                                "sense_id": "c112f886-7de7-38ee-822a-83929eee890e",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b73f22dc-37b1-343c-b6a7-d9ef9719b025",
                                        "entry_id": "22425063-91fd-3878-9c42-9a26620970fb",
                                        "glosses": [
                                            "The art of designing"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28ec9d1b-d46d-43e3-9d1d-e61dde0e6871",
                                                "sense_id": "b73f22dc-37b1-343c-b6a7-d9ef9719b025",
                                                "text": "Danish furniture design is world-famous."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "design",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffc2944a-3760-3507-b509-661afd8c6dde",
                                        "entry_id": "f894df8e-1f78-3ede-9c76-5f761a742796",
                                        "glosses": [
                                            "To plan and carry out (a picture, work of art, construction etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d36c8c40-4fd1-4e48-ac46-92d157014f8c",
                                                "sense_id": "ffc2944a-3760-3507-b509-661afd8c6dde",
                                                "text": "He always designs gaming laptops from 4:00 pm to 1:00 am."
                                            },
                                            {
                                                "example_id": "d2911fac-29fb-4542-9ad8-0a212ad33591",
                                                "sense_id": "ffc2944a-3760-3507-b509-661afd8c6dde",
                                                "text": "She designed his retirement from the Royal Irish Artillery, and had negociated an immediate berth for him on the Staff of the Commander of the Forces, and a prospective one in the household of Lord Townshend […]"
                                            },
                                            {
                                                "example_id": "26025a74-4b90-481e-ad7e-2d6f778f3e61",
                                                "sense_id": "ffc2944a-3760-3507-b509-661afd8c6dde",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century, when modish taste was just due to go clean out of fashion for the best part of the next hundred years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082c62a9-f16b-3723-b659-997267e00bd1",
                                        "entry_id": "f894df8e-1f78-3ede-9c76-5f761a742796",
                                        "glosses": [
                                            "To plan (to do something)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a52c40e6-1690-4206-8b48-096bf383e850",
                                                "sense_id": "082c62a9-f16b-3723-b659-997267e00bd1",
                                                "text": "The king designed to mount an expedition to the New World."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54542e21-7a03-3b1f-8a22-f185c66db1b7",
                                        "entry_id": "f894df8e-1f78-3ede-9c76-5f761a742796",
                                        "glosses": [
                                            "To assign, appoint (something to someone); to designate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2554c046-4f58-4ad6-aa4f-bf9f8c672589",
                                                "sense_id": "54542e21-7a03-3b1f-8a22-f185c66db1b7",
                                                "text": "he looks not below the Moon, but hath designed the regiment of sublunary affairs unto inferiour deputations."
                                            },
                                            {
                                                "example_id": "080cc915-b1e2-4824-8599-34e1204e5a45",
                                                "sense_id": "54542e21-7a03-3b1f-8a22-f185c66db1b7",
                                                "text": "He was designed to the study of the law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95124207-5a37-3727-b038-8146875747b1",
                                        "entry_id": "f894df8e-1f78-3ede-9c76-5f761a742796",
                                        "glosses": [
                                            "To mark out and exhibit; to designate; to indicate; to show; to point out; to appoint."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8174fef-3fb1-343f-adb0-905cc60b0b32",
                                        "entry_id": "f894df8e-1f78-3ede-9c76-5f761a742796",
                                        "glosses": [
                                            "To manifest requirements to be satisfied by an object or process for them to solve a problem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc4964e4-739e-404c-bf9e-55702723fa51",
                                                "sense_id": "e8174fef-3fb1-343f-adb0-905cc60b0b32",
                                                "text": "We shall see / Justice design the victor's chivalry."
                                            },
                                            {
                                                "example_id": "8db43685-da27-4811-bb16-152dd84cf676",
                                                "sense_id": "e8174fef-3fb1-343f-adb0-905cc60b0b32",
                                                "text": "Meet me to-morrow where the master / And this fraternity shall design."
                                            }
                                        ]
                                    }
                                ]
                            }
