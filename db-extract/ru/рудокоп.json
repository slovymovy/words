                "senses": [
                    {
                        "sense_id": "b257803d-8f63-3762-9c1d-ecd2fb22706c",
                        "entry_id": "40d6a318-30af-3b4a-a172-52588dfdc449",
                        "glosses": [
                            "горнорабочий на руднике, добывающий ценные ресурсы из скальных пород"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727db469-3ba7-4db4-80e0-68720a956e2d",
                                "sense_id": "b257803d-8f63-3762-9c1d-ecd2fb22706c",
                                "text": "Только в лежачем боку, т. е. в породе под кварцем жилы, были выбиты выемки или площадки; ставя на них ноги, рудокопы спускались в глубь шахты и так же поднимались наверх с грузом выломанного кварца в мешке или корзине на спине."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f969ea9-3c28-4ba1-80fb-0a88eff4c5bb",
                        "source_entry_id": "40d6a318-30af-3b4a-a172-52588dfdc449",
                        "source_sense_id": "b257803d-8f63-3762-9c1d-ecd2fb22706c",
                        "target_lang_word": "miner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                                        "entry_id": "23a491a7-cfae-3df4-acc6-18effaa95270",
                                        "glosses": [
                                            "A person who works in a mine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de40c8a0-a5cf-4a3a-98bd-48d7661d6fba",
                                                "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                                                "text": "Near-synonyms: mineworker; mineowner"
                                            },
                                            {
                                                "example_id": "e6d9fb13-33dc-4175-a94e-6900688b567a",
                                                "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                                                "text": "The group of miners were stuck underground after a shaft caved in."
                                            },
                                            {
                                                "example_id": "6b306c86-c84d-4f7b-bb53-649776da98e7",
                                                "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                                                "text": "Hui from Lin’an—especially those from the village of Huilong—were famously skilled miners and traveled long distances to work mines throughout the province."
                                            },
                                            {
                                                "example_id": "bc0fa7f8-75af-472c-965d-d65da5379c1e",
                                                "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese, a silvery metal, began to totter, slur their speech and behave like someone inebriated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45172ccf-dbc4-33f0-9a7e-ad00bf18fc5e",
                                        "entry_id": "23a491a7-cfae-3df4-acc6-18effaa95270",
                                        "glosses": [
                                            "An operator of ordnance mines and similar explosives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9368c5e1-d587-34a2-abd4-217b652a1f50",
                                        "entry_id": "23a491a7-cfae-3df4-acc6-18effaa95270",
                                        "glosses": [
                                            "Any bird of one of several species of South American ovenbirds in the genus Geositta."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b07d023-5b0c-3514-92fd-af7b8010ba1e",
                                        "entry_id": "23a491a7-cfae-3df4-acc6-18effaa95270",
                                        "glosses": [
                                            "Any bird of one of several species of Australian honeyeaters in the genus Manorina."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fe1bfc0-e09c-3eff-96d1-05b6bc55a15b",
                                        "entry_id": "23a491a7-cfae-3df4-acc6-18effaa95270",
                                        "glosses": [
                                            "Software or hardware that mines, or creates new units of cryptocurrency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b473f12-0bb3-4bdf-8ef3-f0346cc63a1a",
                                                "sense_id": "1fe1bfc0-e09c-3eff-96d1-05b6bc55a15b",
                                                "text": "The move would have probably prevented Kazakhstan-based miners from accessing the bitcoin network."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "563fb9eb-0788-3d26-9faa-1db6faa56387",
                                        "entry_id": "23a491a7-cfae-3df4-acc6-18effaa95270",
                                        "glosses": [
                                            "A person who mines cryptocurrency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e5ffb5-6ae6-43d6-b19e-abe8e85cd425",
                                                "sense_id": "563fb9eb-0788-3d26-9faa-1db6faa56387",
                                                "text": "The first miner to solve each puzzle would be awarded 50 new bitcoins, and the associated block of transactions would be added to the chain. The difficulty of each puzzle would increase as the number of miners increased, which would keep production to one block of transactions roughly every 10 minutes."
                                            }
                                        ]
                                    }
                                ]
                            },
