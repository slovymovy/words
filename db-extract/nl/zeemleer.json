                    {
                        "translation_id": "24f7f8cd-f9e5-43e9-80f9-5b47c02508cc",
                        "source_entry_id": "4858ffe3-c5ce-36cf-95a2-58cb45d229ad",
                        "source_sense_id": "4c02d9eb-9d7c-3af1-a888-d90333b0fa03",
                        "target_lang_word": "peau de chamois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peau de chamois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f9f2bc7-3274-37da-98f4-91b61f36971f",
                                        "entry_id": "a5f262d3-1e14-391c-9e95-f48c7184357d",
                                        "glosses": [
                                            "Étoffe très absorbante en peau de chamois, ou plus souvent en peau de chèvre ou de mouton, ou en matériaux synthétiques, utilisée pour nettoyer ou lustrer les surfaces lisses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1e4a447-493a-4d56-b097-9e82738be99e",
                                                "sense_id": "2f9f2bc7-3274-37da-98f4-91b61f36971f",
                                                "text": "Il s’enfermait à clé pour frotter clandestinement les meubles et les menus objets avec une peau de chamois qu’il sortait de sa poche."
                                            },
                                            {
                                                "example_id": "10219e61-dea1-4bdf-bb5f-6dcbb59e3f98",
                                                "sense_id": "2f9f2bc7-3274-37da-98f4-91b61f36971f",
                                                "text": "La famille Kaufman était très fière, car elle venait d'acheter une Simca Aronde […]. Il fallait, rite quasi religieux, la laver régulièrement tous les dimanche matin : lessivage, rinçage, peau de chamois, puis la lustrer à la “nénette”. C'était l'époque de la toute puissance radiophonique ; […]."
                                            },
                                            {
                                                "example_id": "d4f148c6-4a1f-49c6-8936-987ad8714f87",
                                                "sense_id": "2f9f2bc7-3274-37da-98f4-91b61f36971f",
                                                "text": "L’huile de foie de morue est utilisé pour le tannage de peau de mouton destinée aux articles appelés « peaux de chamois »."
                                            },
                                            {
                                                "example_id": "9981e72c-4696-4e6e-9323-e0c9aa979e53",
                                                "sense_id": "2f9f2bc7-3274-37da-98f4-91b61f36971f",
                                                "text": "Avant d’installer le décor, il faut laver l’intérieur de l’aquarium et nettoyer les vitres, sans produit d’entretien, avec une peau de chamois."
                                            },
                                            {
                                                "example_id": "4e576e7e-5a32-4ef7-948e-210beee0a143",
                                                "sense_id": "2f9f2bc7-3274-37da-98f4-91b61f36971f",
                                                "text": "Apprends aussi qu’on a fait des folies, du shopping, on a acheté de nouveaux étuis, des cordons fluorescents, du liquide nettoyant, des peaux de chamois dernier cri, la santé et la beauté s’entretiennent, mon vieux !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
