                            {
                                "example_id": "869d3ea5-3d12-43b0-a739-4d9f3bc7015b",
                                "sense_id": "91879160-bfa3-3513-8811-5e46ac11fa8c",
                                "text": "Les enfants s’étaient assis sur l’herbe, je les avais suivis. En approchant d’eux, je vis une petite grenouille verte, de l’espèce qu’on appelle gresset."
                            },
                            {
                                "example_id": "bb0d7917-9140-45f9-99e9-171e42cc9def",
                                "sense_id": "91879160-bfa3-3513-8811-5e46ac11fa8c",
                                "text": "Le gresset ( Hyla arborea )existe aussi en beige, il y en avait un hier dans les boutures de rosier et dans l’auge qui me sert à bassiner les fraisiers en pot."
                            }
                        ]
                    }
