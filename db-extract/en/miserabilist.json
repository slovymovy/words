            },
            {
                "entry_id": "bf336ff2-5a71-38e3-b30b-d54ad753f897",
                "word": "miserabilist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7a7cf348-4d54-4bbf-9244-e8fbef716613",
                        "entry_id": "bf336ff2-5a71-38e3-b30b-d54ad753f897",
                        "tags": [
                            "plural"
                        ],
                        "form": "miserabilists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48b833bc-e758-3efe-8b28-c789fe289c5c",
                        "entry_id": "bf336ff2-5a71-38e3-b30b-d54ad753f897",
                        "glosses": [
                            "One who is unhappy, or extols being miserable as a virtue; a philosopher of pessimism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec626e7a-2072-468b-afa8-9f8e79934a03",
                                "sense_id": "48b833bc-e758-3efe-8b28-c789fe289c5c",
                                "text": "Gissing is never more of a miserabilist than when trying to be light-hearted."
                            },
                            {
                                "example_id": "8a3cd698-36f6-442e-83f4-0d6da939d449",
                                "sense_id": "48b833bc-e758-3efe-8b28-c789fe289c5c",
                                "text": "An old, failed actor who lived on his own, he never had friends dropping by, because he was a bedridden inconsiderate miserabilist."
                            },
                            {
                                "example_id": "0e32f725-b29f-4b03-8aea-43276bbf7b46",
                                "sense_id": "48b833bc-e758-3efe-8b28-c789fe289c5c",
                                "text": "The former Smiths singer, professional miserabilist, vegetarian and gladioli-distributor has posed nude for the inner sleeve artwork for his new single, Heaven Knows I'm Naked Now."
                            },
                            {
                                "example_id": "9cf6522f-3743-4849-9bcb-ac4d006b3946",
                                "sense_id": "48b833bc-e758-3efe-8b28-c789fe289c5c",
                                "text": "She said center-right French politicians have started disparaging climate activists as “miserabilists”, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c7af483-15a8-47bc-9301-c9bcafd34c2d",
                        "source_entry_id": "bf336ff2-5a71-38e3-b30b-d54ad753f897",
                        "source_sense_id": "48b833bc-e758-3efe-8b28-c789fe289c5c",
                        "source_sense_description": "one who extols being miserable",
                        "target_lang_word": "misérabiliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misérabiliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aea62caa-63ea-3f61-a301-0c9af85c883a",
                                        "entry_id": "f37d3585-427a-329c-b9ab-f7b1ecc1517a",
                                        "glosses": [
                                            "Qui esthétise la misère dans une veine naturaliste poussée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cdd194c-5382-424a-a54a-a42ddc82883a",
                                                "sense_id": "aea62caa-63ea-3f61-a301-0c9af85c883a",
                                                "text": "Belles photos, mais parfois trop misérabilistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39afac49-eaca-32d1-b5a0-0939de8c3d32",
                                        "entry_id": "f37d3585-427a-329c-b9ab-f7b1ecc1517a",
                                        "glosses": [
                                            "Qui dépeint la misère de façon crue, pesante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1532ec6c-5f6d-4219-ac73-210a71d08535",
                                                "sense_id": "39afac49-eaca-32d1-b5a0-0939de8c3d32",
                                                "text": "Trop souvent, l’immigration fait l’objet de discours misérabilistes ou mystificateurs : les immigré-e-s sont des éternelles victimes ou des héros mythiques."
                                            },
                                            {
                                                "example_id": "05b41fb4-afaa-40a1-b546-f4620e212489",
                                                "sense_id": "39afac49-eaca-32d1-b5a0-0939de8c3d32",
                                                "text": "Pourtant, Kate Tempest n’est pas misérabiliste, elle aime ses personnages, leur vulnérabilité, leur sincérité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
