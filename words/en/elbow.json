{
    "word_family": [
        "elbowroom"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a8e3720-a2b9-3bb4-894a-8aa2ef235401",
                    "sense_definition": "The joint between the upper arm and the forearm.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She rested her <w>elbows</w> on the table while listening.",
                            "target_lang_translations": {
                                "ru": "Она положила <w>локти</w> на стол, пока слушала.",
                                "zh": "她听的时候把<w>手肘</w>撑在桌子上。"
                            }
                        },
                        {
                            "text": "He hurt his <w>elbow</w> playing tennis yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера он ушиб <w>локоть</w>, играя в теннис.",
                                "zh": "他昨天打网球时伤到了<w>手肘</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "elbow joint"
                    ],
                    "common_phrases": [
                        "tennis elbow",
                        "rest one's elbows"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сустав, соединяющий плечо и предплечье.",
                        "zh": "连接上臂和前臂的关节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "локоть",
                                "target_lang_sense_clarification": "часть тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手肘",
                                "target_lang_sense_clarification": "身体部位"
                            },
                            {
                                "target_lang_word": "肘部",
                                "target_lang_sense_clarification": "身体部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4e74840-9bfd-3dc7-80eb-1c4eb8d76f6d",
                    "sense_definition": "A hit, strike, or blow made with the elbow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee called a foul for the sharp <w>elbow</w> to the face.",
                            "target_lang_translations": {
                                "ru": "Судья назначил фол за резкий <w>удар локтем</w> в лицо.",
                                "zh": "裁判判罚了这次面部<w>肘击</w>犯规。"
                            }
                        },
                        {
                            "text": "He gave me a quick <w>elbow</w> in the ribs to wake me up.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>ткнул</w> меня <w>локтем</w> в бок, чтобы разбудить.",
                                "zh": "他用<w>手肘</w>轻轻捅了捅我的肋部把我叫醒。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "throw an elbow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удар, нанесенный локтем.",
                        "zh": "用手肘进行的击打或碰撞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар локтем",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "тычок локтем",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肘击",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1431d69c-9d7d-30c3-9684-67b04578f840",
                    "sense_definition": "A pipe fitting or part of a structure bent at an angle like an elbow.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber needed a copper <w>elbow</w> to fix the leak.",
                            "target_lang_translations": {
                                "ru": "Сантехнику нужно было медное <w>колено</w>, чтобы устранить течь.",
                                "zh": "水管工需要一个铜制<w>弯头</w>来修理漏水。"
                            }
                        },
                        {
                            "text": "The river forms a sharp <w>elbow</w> near the old bridge.",
                            "target_lang_translations": {
                                "ru": "Река делает резкий <w>изгиб</w> возле старого моста.",
                                "zh": "河流在老桥附近形成了一个急<w>拐弯</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деталь трубы или часть конструкции, изогнутая под углом.",
                        "zh": "管道配件或结构中呈角度弯曲的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колено",
                                "target_lang_sense_clarification": "трубы"
                            },
                            {
                                "target_lang_word": "изгиб",
                                "target_lang_sense_clarification": "реки, дороги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弯头",
                                "target_lang_sense_clarification": "管道配件"
                            },
                            {
                                "target_lang_word": "拐弯处",
                                "target_lang_sense_clarification": "结构或地形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3062081b-b2b8-3380-937b-dfe18fb62194",
                    "sense_definition": "Part of a basketball court located at the intersection of the free-throw line and the free-throw lane.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a perfect jump shot from the <w>elbow</w>.",
                            "target_lang_translations": {
                                "ru": "Он совершил идеальный бросок в прыжке с <w>угла штрафной</w>.",
                                "zh": "他在<w>罚球线延长线</w>附近完成了一次完美的跳投。"
                            }
                        },
                        {
                            "text": "The defender trapped the ball handler near the <w>elbow</w>.",
                            "target_lang_translations": {
                                "ru": "Защитник зажал игрока с мячом возле <w>угла штрафной</w>.",
                                "zh": "防守队员在<w>罚球线延长线</w>附近包夹了持球人。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть баскетбольной площадки на пересечении линии штрафного броска и боковой линии трехсекундной зоны.",
                        "zh": "篮球场上罚球线与限制区侧线交汇的区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угол штрафной",
                                "target_lang_sense_clarification": "баскетбол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罚球线延长线区域",
                                "target_lang_sense_clarification": "篮球术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f442652-82c1-3a70-ab4f-bba5bad689c9",
                    "sense_definition": "A detective.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>elbow</w> asked the suspect a few tough questions.",
                            "target_lang_translations": {
                                "ru": "<w>Сыщик</w> задал подозреваемому несколько трудных вопросов.",
                                "zh": "那名<w>侦探</w>问了嫌疑人几个棘手的问题。"
                            }
                        },
                        {
                            "text": "He didn't want to talk while the <w>elbows</w> were watching.",
                            "target_lang_translations": {
                                "ru": "Он не хотел говорить, пока <w>легавые</w> смотрели.",
                                "zh": "在<w>侦探</w>盯着看的时候，他不想说话。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used to refer to a detective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Детектив (сленг).",
                        "zh": "侦探（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыщик",
                                "target_lang_sense_clarification": "профессия"
                            },
                            {
                                "target_lang_word": "детектив",
                                "target_lang_sense_clarification": "профессия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侦探",
                                "target_lang_sense_clarification": "职业"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "353836c2-ceed-36fe-966b-da67ab0afbf0",
                    "sense_definition": "To push one's way through a crowd or tight space using the elbows.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>elbowed</w> her way to the front of the stage.",
                            "target_lang_translations": {
                                "ru": "Она <w>протолкалась</w> к сцене.",
                                "zh": "她<w>挤</w>到了舞台最前面。"
                            }
                        },
                        {
                            "text": "The passengers <w>elbowed</w> through the busy train station.",
                            "target_lang_translations": {
                                "ru": "Пассажиры <w>проталкивались</w> через переполненный вокзал.",
                                "zh": "乘客们在繁忙的火车站里<w>推挤</w>着前行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "elbow one's way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прокладывать путь через толпу или тесное пространство, расталкивая окружающих локтями.",
                        "zh": "用手肘推开人群或在狭窄空间中挤过去。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проталкиваться",
                                "target_lang_sense_clarification": "сквозь толпу"
                            },
                            {
                                "target_lang_word": "расталкивать локтями",
                                "target_lang_sense_clarification": "прокладывать путь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挤",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "推挤",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34e1c901-93c4-3bf9-87ac-d34bd9d7dc52",
                    "sense_definition": "To strike or hit someone with the elbow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He accidentally <w>elbowed</w> me in the eye while turning around.",
                            "target_lang_translations": {
                                "ru": "Оборачиваясь, он случайно <w>задел</w> меня <w>локтем</w> в глаз.",
                                "zh": "他转身时无意中用<w>手肘</w>撞到了我的眼睛。"
                            }
                        },
                        {
                            "text": "The player was penalized for <w>elbowing</w> the defender.",
                            "target_lang_translations": {
                                "ru": "Игрока оштрафовали за <w>удар локтем</w> защитника.",
                                "zh": "那名球员因<w>肘击</w>防守队员而被罚。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-либо локтем.",
                        "zh": "用手肘撞击某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударить локтем",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "двинуть локтем",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肘击",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73b362ce-61d5-338e-a1e0-7b0d4faa6401",
                    "sense_definition": "To force someone to quit or lose their job so that someone else can take it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambitious manager <w>elbowed</w> his rival out of the company.",
                            "target_lang_translations": {
                                "ru": "Амбициозный менеджер <w>выжил</w> своего соперника из компании.",
                                "zh": "那位野心勃勃的经理把他的竞争对手<w>排挤</w>出了公司。"
                            }
                        },
                        {
                            "text": "She was gradually <w>elbowed</w> out of the project she started.",
                            "target_lang_translations": {
                                "ru": "Ее постепенно <w>вытеснили</w> из проекта, который она начала.",
                                "zh": "她逐渐被<w>挤出</w>了她自己发起的项目。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "elbow out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вынудить кого-то уйти или потерять работу, чтобы занять его место.",
                        "zh": "迫使某人离职或离开，以便他人取代其位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытеснять",
                                "target_lang_sense_clarification": "с работы, должности"
                            },
                            {
                                "target_lang_word": "выживать",
                                "target_lang_sense_clarification": "избавляться от кого-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排挤",
                                "target_lang_sense_clarification": "职场行为"
                            },
                            {
                                "target_lang_word": "挤走",
                                "target_lang_sense_clarification": "职场行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}