                "senses": [
                    {
                        "sense_id": "0a87d49d-1882-3a42-b53b-723f7465d6f7",
                        "entry_id": "3427de03-c92c-3d50-9d56-8e7d07aeefd6",
                        "glosses": [
                            "Politiker, der in der Kommunalpolitik tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08324989-199c-4145-85df-0282efd57b8a",
                                "sense_id": "0a87d49d-1882-3a42-b53b-723f7465d6f7",
                                "text": "„Man hatte den Schulamtsleiter eingeladen, und weil demnächst eine Wahl anstand, trudelten auch ein paar Lokalpolitiker ein, die ein engagiertes Gesicht in die Menge halten wollten.“"
                            },
                            {
                                "example_id": "7c762f90-dcea-4936-958a-c5a2a0b6318f",
                                "sense_id": "0a87d49d-1882-3a42-b53b-723f7465d6f7",
                                "text": "„Während bis dahin Gewerkschafter und Lokalpolitiker als Anwälte bestimmter gesellschaftlicher Gruppen aufgetreten waren, verwiesen die jüngeren nationalistischen Politiker vage und generell auf die Bevölkerung als Ganze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
