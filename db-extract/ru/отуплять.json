                "senses": [
                    {
                        "sense_id": "8b104441-71ee-34e4-8679-7197a810bd8b",
                        "entry_id": "73602329-3b91-33b2-a93b-64c20efbc56a",
                        "glosses": [
                            "делать кого-либо плохо восприимчивым, тупым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1730ad-aedf-4e52-a722-f2186ef85ace",
                                "sense_id": "8b104441-71ee-34e4-8679-7197a810bd8b",
                                "text": "Изводить подростка по пустякам — значит отуплять его: он уже не сможет отличать мелочь от серьёзного проступка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65b61ed0-13bd-462e-8237-3f96b3fd244b",
                        "source_entry_id": "73602329-3b91-33b2-a93b-64c20efbc56a",
                        "source_sense_id": "8b104441-71ee-34e4-8679-7197a810bd8b",
                        "target_lang_word": "abêtir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abêtir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70ae69e9-5a73-3639-af38-83398410dac2",
                                        "entry_id": "2ae59fc2-95e6-31d4-9763-4a6924cf19f6",
                                        "glosses": [
                                            "Rendre bête, stupide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af30ebcb-6c1e-46d6-936b-53eebc171794",
                                                "sense_id": "70ae69e9-5a73-3639-af38-83398410dac2",
                                                "text": "Vous abêtirez cet enfant."
                                            },
                                            {
                                                "example_id": "45800658-8d83-4f08-8372-94b28982f39b",
                                                "sense_id": "70ae69e9-5a73-3639-af38-83398410dac2",
                                                "text": "Il est tout abêti."
                                            },
                                            {
                                                "example_id": "3b28f7d5-47fc-40bf-b176-77f4d12a9af7",
                                                "sense_id": "70ae69e9-5a73-3639-af38-83398410dac2",
                                                "text": "Lui aussi est intelligent, mais par malheur la boisson l’a si bien abêti qu’il n’est plus bon qu’à faire un cocher, et encore à condition d’être indulgent."
                                            },
                                            {
                                                "example_id": "8611137a-d2fb-40d9-a3b0-5bc26012ff00",
                                                "sense_id": "70ae69e9-5a73-3639-af38-83398410dac2",
                                                "text": "Qu’adviendrait-il de son frère ? Il avait revu Violette ; Madeleine le savait et elle se figurait raisonnablement cette fille coquette jouant à abêtir les hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3758ae14-9e7f-3297-9e1e-d3ff8b897608",
                                        "entry_id": "2ae59fc2-95e6-31d4-9763-4a6924cf19f6",
                                        "glosses": [
                                            "Devenir bête."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c30b2d9-0d00-4a85-87d9-b9fcc30ddac2",
                                                "sense_id": "3758ae14-9e7f-3297-9e1e-d3ff8b897608",
                                                "text": "Il abêtit tous les jours."
                                            },
                                            {
                                                "example_id": "fa86bc8e-475d-487e-9125-6d821c46c5f4",
                                                "sense_id": "3758ae14-9e7f-3297-9e1e-d3ff8b897608",
                                                "text": "Il s’abêtit."
                                            },
                                            {
                                                "example_id": "f2be2d01-745b-4001-b8b8-6490619f9dc6",
                                                "sense_id": "3758ae14-9e7f-3297-9e1e-d3ff8b897608",
                                                "text": "Mes camarades n’avaient pas tant changé, moi non plus ; mais ce qui nous liait hier, c’était notre entreprise commune : nos études ; aujourd’hui, nos vies divergeaient ; je continuais à aller de l’avant, je me développais tandis que, pour s’adapter à leur existence de filles à marier, elles commençaient de s’abêtir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
