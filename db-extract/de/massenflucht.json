                "senses": [
                    {
                        "sense_id": "c06099a8-3c13-3b3e-989e-55f27188d688",
                        "entry_id": "59f31808-42d7-3ad0-95e7-cf64114a0348",
                        "glosses": [
                            "Flucht einer großen Zahl von Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40c919b5-eb43-4fdc-93db-25b2dd35735c",
                                "sense_id": "c06099a8-3c13-3b3e-989e-55f27188d688",
                                "text": "„Die permanente Bombardierung der Stadt löste eine neue Massenflucht aus, nachdem in den ersten Monaten nach dem Sturz Najibullahs bereits 1,5 Millionen Afghanen ins Land zurückgekehrt waren.“"
                            },
                            {
                                "example_id": "0c4b98e4-9427-4659-a7d3-3fe114b45f37",
                                "sense_id": "c06099a8-3c13-3b3e-989e-55f27188d688",
                                "text": "„Ihre Artillerie- und Luftangriffe gegen eine Reihe schiitischer Dörfer im Südlibanon, bei denen auch zwei Brücken über den Zaharani-Fluss zerbombt wurden, waren so massiv, dass eine Massenflucht der Ortsbewohner in den Norden einsetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
