                "senses": [
                    {
                        "sense_id": "76299907-ffe7-31d0-be00-2f3dc36fee6a",
                        "entry_id": "3cb597c5-4202-3a6e-8cfe-ffcf1213926c",
                        "glosses": [
                            "Genre musical algérien, qui s'est développé en opposition à la musique noble et savante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99262701-3cc2-4a8a-8918-3a6ca0960b45",
                                "sense_id": "76299907-ffe7-31d0-be00-2f3dc36fee6a",
                                "text": "Le chaâbi mêle les instruments orientaux du classique arabo-andalou à d’autres venus de la musique classique occidentale, les textes sont souvent en arabe dialectal."
                            },
                            {
                                "example_id": "9aefccf4-6910-4a60-b4af-4ba434a841b2",
                                "sense_id": "76299907-ffe7-31d0-be00-2f3dc36fee6a",
                                "text": "Le chaâbi marocain, très différent du chaâbi algérien est un genre musical populaire qui dérive de la haïta ou Aïta, est une musique d'origine bédouine que l'on retrouve fréquemment dans les mariages."
                            },
                            {
                                "example_id": "34a0376c-314f-4e60-9084-63f86d393e4d",
                                "sense_id": "76299907-ffe7-31d0-be00-2f3dc36fee6a",
                                "text": "Né le 21 mai 1933 à Bab El-Oued, il est le fils de Lili Labassi, l’un des maîtres du chaâbi, musique aux sonorités arabo-andalouses et aux rythmes berbères, typique de ce quartier populaire d’Alger."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd343861-47bc-38ad-80bf-ed27472e72d0",
                        "entry_id": "3cb597c5-4202-3a6e-8cfe-ffcf1213926c",
                        "glosses": [
                            "Genre musical marocain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e87de1-8b36-4380-868d-ff331b745f59",
                                "sense_id": "dd343861-47bc-38ad-80bf-ed27472e72d0",
                                "text": "Une des invitées appelle tout le monde à danser. C’est une chanson du répertoire chaâbi, très rythmée, sensuelle."
                            }
                        ]
                    }
                ],
