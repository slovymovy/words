            "senses": [
                {
                    "sense_id": "dd573cf0-a911-343d-badf-fffd43417f30",
                    "sense_definition": "Heel erg boos en niet meer voor rede vatbaar.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd <w>woest</w> toen hij hoorde dat zijn fiets gestolen was.",
                            "target_lang_translations": {
                                "en": "He became <w>furious</w> when he heard that his bike had been stolen.",
                                "ru": "Он пришёл в <w>ярость</w>, когда услышал, что его велосипед украли.",
                                "fr": "Il est devenu <w>furieux</w> en apprenant que son vélo avait été volé."
                            }
                        },
                        {
                            "text": "Mijn vader was <w>woest</w> omdat ik veel te laat thuis kwam.",
                            "target_lang_translations": {
                                "en": "My father was <w>furious</w> because I came home much too late.",
                                "ru": "Мой отец был <w>в бешенстве</w>, потому что я пришёл домой слишком поздно.",
                                "fr": "Mon père était <w>fou de rage</w> parce que je suis rentré beaucoup trop tard."
                            }
                        }
                    ],
                    "synonyms": [
                        "woedend",
                        "razend"
                    ],
                    "antonyms": [
                        "kalm",
                        "rustig"
                    ],
                    "common_phrases": [
                        "woest worden",
                        "iemand woest maken"
                    ],
                    "target_lang_definitions": {
                        "en": "Very angry and no longer amenable to reason.",
                        "ru": "Очень злой и не поддающийся разуму.",
                        "fr": "Extrêmement en colère, au point de ne plus être accessible à la raison."
                    },
                    "translations": {
