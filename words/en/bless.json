{
    "word_family": [
        "blessing",
        "blessed",
        "blessedness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccefe550-b914-3f29-9513-ad8a0b2b0b19",
                    "sense_definition": "To ask God or a divine power to protect, help, or show favor to someone or something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religious_favor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest raised his hands to <w>bless</w> the congregation at the end of the service.",
                            "target_lang_translations": {
                                "ru": "Священник поднял руки, чтобы <w>благословить</w> прихожан в конце службы.",
                                "tr": "Rahip, ayinin sonunda cemaati <w>kutsamak</w> için ellerini kaldırdı.",
                                "zh": "仪式结束时，牧师举起双手为会众<w>祝福</w>。"
                            }
                        },
                        {
                            "text": "My grandmother always says, \"God <w>bless</w> you,\" whenever someone sneezes.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка всегда говорит: «Да <w>благословит</w> тебя Бог», когда кто-то чихает.",
                                "tr": "Büyükannem biri hapşırdığında her zaman \"Çok yaşa\" veya \"Allah <w>kutsasın</w>\" der.",
                                "zh": "每当有人打喷嚏时，我祖母总会说：“愿上帝<w>保佑</w>你。”"
                            }
                        }
                    ],
                    "antonyms": [
                        "curse"
                    ],
                    "common_phrases": [
                        "God bless",
                        "bless you",
                        "bless this house"
                    ],
                    "target_lang_definitions": {
                        "ru": "Просить Бога или высшую силу защитить, помочь или проявить благосклонность к кому-либо или чему-либо.",
                        "tr": "Birine veya bir şeye koruma, yardım veya lütuf sağlaması için Tanrı'ya veya ilahi bir güce dua etmek.",
                        "zh": "祈求上帝或神灵保佑、帮助或恩待某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благословлять",
                                "target_lang_sense_clarification": "совершать религиозный обряд или молитву"
                            },
                            {
                                "target_lang_word": "благословить",
                                "target_lang_sense_clarification": "совершенный вид глагола"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kutsamak",
                                "target_lang_sense_clarification": "birine ilahi koruma veya lütuf dilemek"
                            },
                            {
                                "target_lang_word": "takdis etmek",
                                "target_lang_sense_clarification": "dini bir ritüel ile kutsallık atfetmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祝福",
                                "target_lang_sense_clarification": "祈求神灵赐予福分"
                            },
                            {
                                "target_lang_word": "保佑",
                                "target_lang_sense_clarification": "祈求神灵保护"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2ca9599-39d9-302e-867e-b5812fe26997",
                    "sense_definition": "To make something holy or sacred by performing a religious rite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_favor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They asked the bishop to <w>bless</w> the water before the baptism ceremony.",
                            "target_lang_translations": {
                                "ru": "Они попросили епископа <w>освятить</w> воду перед церемонией крещения.",
                                "tr": "Vaftiz töreninden önce piskopostan suyu <w>kutsamasını</w> istediler.",
                                "zh": "他们在洗礼仪式前请主教为水<w>祝圣</w>。"
                            }
                        },
                        {
                            "text": "It is traditional to <w>bless</w> the food before we begin eating dinner.",
                            "target_lang_translations": {
                                "ru": "По традиции принято <w>благословлять</w> пищу перед началом ужина.",
                                "tr": "Akşam yemeğine başlamadan önce yemeği <w>kutsamak</w> bir gelenektir.",
                                "zh": "晚餐前先为食物<w>祈福</w>是我们的传统。"
                            }
                        }
                    ],
                    "antonyms": [
                        "curse"
                    ],
                    "common_phrases": [
                        "bless the food",
                        "bless the water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо святым или священным посредством совершения религиозного обряда.",
                        "tr": "Dini bir ritüel gerçekleştirerek bir şeyi kutsal veya mukaddes kılmak.",
                        "zh": "通过宗教仪式使某物变得神圣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освящать",
                                "target_lang_sense_clarification": "делать священным (воду, предметы)"
                            },
                            {
                                "target_lang_word": "благословлять",
                                "target_lang_sense_clarification": "призывать благодать (на пищу, дары)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kutsamak",
                                "target_lang_sense_clarification": "nesneleri veya yiyecekleri dini törenle kutsal kılmak"
                            },
                            {
                                "target_lang_word": "takdis etmek",
                                "target_lang_sense_clarification": "dini bir ayinle kutsallaştırmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祝圣",
                                "target_lang_sense_clarification": "通过宗教仪式使物品神圣化"
                            },
                            {
                                "target_lang_word": "开光",
                                "target_lang_sense_clarification": "宗教仪式中赋予物品灵性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79fc657-9276-3c0b-aeae-65951fbc6975",
                    "sense_definition": "To give official permission, approval, or agreement to a plan or action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board of directors finally decided to <w>bless</w> the new reorganization strategy.",
                            "target_lang_translations": {
                                "ru": "Совет директоров наконец решил <w>благословить</w> новую стратегию реорганизации.",
                                "tr": "Yönetim kurulu sonunda yeni yeniden yapılanma stratejisini <w>onaylamaya</w> karar verdi.",
                                "zh": "董事会最终决定<w>批准</w>这项新的重组战略。"
                            }
                        },
                        {
                            "text": "Her parents refused to <w>bless</w> the marriage because they thought she was too young.",
                            "target_lang_translations": {
                                "ru": "Ее родители отказались <w>благословить</w> этот брак, так как считали ее слишком молодой.",
                                "tr": "Ebeveynleri, çok genç olduğunu düşündükleri için evliliğe <w>rıza göstermeyi</w> reddettiler.",
                                "zh": "她的父母拒绝<w>认可</w>这段婚姻，因为他们觉得她太年轻了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "condemn"
                    ],
                    "common_phrases": [
                        "bless the plan",
                        "bless the deal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать официальное разрешение, одобрение или согласие на план или действие.",
                        "tr": "Bir plan veya eylem için resmi izin, onay veya rıza vermek.",
                        "zh": "对某项计划或行动给予正式的许可、批准或同意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благословлять",
                                "target_lang_sense_clarification": "перен. давать согласие или одобрение"
                            },
                            {
                                "target_lang_word": "одобрять",
                                "target_lang_sense_clarification": "выражать согласие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "onaylamak",
                                "target_lang_sense_clarification": "resmi olarak kabul etmek"
                            },
                            {
                                "target_lang_word": "rıza göstermek",
                                "target_lang_sense_clarification": "bir eyleme izin vermek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批准",
                                "target_lang_sense_clarification": "正式同意某项计划"
                            },
                            {
                                "target_lang_word": "首肯",
                                "target_lang_sense_clarification": "表示同意或赞许"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd686dc2-9415-315f-bc96-697f249a5bf2",
                    "sense_definition": "To praise, worship, and express gratitude to God.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "worship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gathered in the chapel to <w>bless</w> the Lord for his enduring mercy.",
                            "target_lang_translations": {
                                "ru": "Мы собрались в часовне, чтобы <w>благословить</w> Господа за его бесконечное милосердие.",
                                "tr": "Sonsuz merhameti için Tanrı'yı <w>yüceltmek</w> amacıyla şapelde toplandık.",
                                "zh": "我们聚集在礼拜堂，为上帝永恒的仁慈而<w>赞美</w>他。"
                            }
                        },
                        {
                            "text": "The choir sang a hymn to <w>bless</w> the name of God.",
                            "target_lang_translations": {
                                "ru": "Хор пел гимн, чтобы <w>прославить</w> имя Божье.",
                                "tr": "Koro, Tanrı'nın adını <w>yüceltmek</w> için bir ilahi söyledi.",
                                "zh": "唱诗班唱了一首赞美诗来<w>颂扬</w>上帝之名。"
                            }
                        }
                    ],
                    "antonyms": [
                        "curse"
                    ],
                    "common_phrases": [
                        "bless the Lord"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "common in religious texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восхвалять, почитать и выражать благодарность Богу.",
                        "tr": "Tanrı'yı övmek, ona ibadet etmek ve şükranlarını sunmak.",
                        "zh": "赞美、崇拜并向神表达感激之情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прославлять",
                                "target_lang_sense_clarification": "воздавать хвалу"
                            },
                            {
                                "target_lang_word": "благословлять",
                                "target_lang_sense_clarification": "устар./религ. славить Бога"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yüceltmek",
                                "target_lang_sense_clarification": "Tanrı'yı övmek ve yüceltmek"
                            },
                            {
                                "target_lang_word": "şükretmek",
                                "target_lang_sense_clarification": "Tanrı'ya minnettarlık sunmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赞美",
                                "target_lang_sense_clarification": "对神表达崇敬"
                            },
                            {
                                "target_lang_word": "颂扬",
                                "target_lang_sense_clarification": "歌颂神的名号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4fab6e8-33cb-379a-ae7c-6f7d1d6116aa",
                    "sense_definition": "To give something to someone, often implying a favor or generosity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_give",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you <w>bless</w> me with a few dollars until I get paid next week?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>выручить</w> меня парой долларов, пока я не получу зарплату на следующей неделе?",
                                "tr": "Haftaya maaşımı alana kadar bana birkaç dolar <w>bahşedebilir</w> misin?",
                                "zh": "你能先<w>给</w>我几块钱撑到下周发工资吗？"
                            }
                        },
                        {
                            "text": "He promised to <w>bless</w> us with a discount if we bought two items.",
                            "target_lang_translations": {
                                "ru": "Он обещал <w>порадовать</w> нас скидкой, если мы купим два товара.",
                                "tr": "İki ürün alırsak bize indirim <w>yapmayı</w> vaat etti.",
                                "zh": "他答应如果我们买两件商品，就<w>给予</w>我们折扣。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bless me with"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать что-то кому-то, часто подразумевая одолжение или щедрость.",
                        "tr": "Birine bir şey vermek, genellikle bir lütuf veya cömertlik ima eder.",
                        "zh": "给予某人某物，通常带有恩惠或慷慨的意味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одаривать",
                                "target_lang_sense_clarification": "давать что-то ценное"
                            },
                            {
                                "target_lang_word": "выручать",
                                "target_lang_sense_clarification": "разг. помогать деньгами или вещами"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bahşetmek",
                                "target_lang_sense_clarification": "cömertçe bir şey vermek"
                            },
                            {
                                "target_lang_word": "lütfetmek",
                                "target_lang_sense_clarification": "birine bir iyilikte bulunmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赏赐",
                                "target_lang_sense_clarification": "上位者给予下位者恩惠"
                            },
                            {
                                "target_lang_word": "惠赠",
                                "target_lang_sense_clarification": "慷慨地给予某物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a721885f-256b-33be-a337-d6af15f5ccbf",
                    "sense_definition": "Used to express affection, sympathy, gratitude, or sometimes mild irony.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh, <w>bless</w>! That is the sweetest gift anyone has ever given me.",
                            "target_lang_translations": {
                                "ru": "О, какая <w>прелесть</w>! Это самый милый подарок, который мне когда-либо дарили.",
                                "tr": "Ah, ne <w>kıyamam</w>! Bu, birinin bana verdiği en tatlı hediye.",
                                "zh": "噢，<w>真可爱</w>！这是我收到过最贴心的礼物。"
                            }
                        },
                        {
                            "text": "She tried so hard to fix the car herself, <w>bless</w> her heart, but she had no tools.",
                            "target_lang_translations": {
                                "ru": "Она так старалась починить машину сама, <w>дай ей бог здоровья</w>, но у нее не было инструментов.",
                                "tr": "Arabayı kendi başına tamir etmek için çok uğraştı, <w>kıyamam</w> ona, ama hiç aleti yoktu.",
                                "zh": "她那么努力地想自己修车，<w>真是难为她了</w>，但她手头根本没有工具。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bless you",
                        "bless her heart",
                        "aw bless"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения привязанности, сочувствия, благодарности или иногда легкой иронии.",
                        "tr": "Şefkat, sempati, minnettarlık veya bazen hafif bir ironi ifade etmek için kullanılır.",
                        "zh": "用于表达喜爱、同情、感激，有时也带有轻微的讽刺意味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дай бог здоровья",
                                "target_lang_sense_clarification": "пожелание благополучия"
                            },
                            {
                                "target_lang_word": "прелесть",
                                "target_lang_sense_clarification": "выражение умиления"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kıyamam",
                                "target_lang_sense_clarification": "şefkat veya acıma duygusu ifade ederken"
                            },
                            {
                                "target_lang_word": "Allah razı olsun",
                                "target_lang_sense_clarification": "minnettarlık veya iyi dilek ifadesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真可爱",
                                "target_lang_sense_clarification": "表达喜爱或怜爱"
                            },
                            {
                                "target_lang_word": "真难得",
                                "target_lang_sense_clarification": "表达某种程度的同情或感叹"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "047a765e-121c-3880-ab6d-b812c0f2853d",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We have an appointment with Mr. <w>Bless</w> at three o'clock.",
                            "target_lang_translations": {
                                "ru": "У нас назначена встреча с господином <w>Блессом</w> на три часа.",
                                "tr": "Saat üçte Bay <w>Bless</w> ile randevumuz var.",
                                "zh": "我们和<w>布莱斯</w>先生约在三点见面。"
                            }
                        },
                        {
                            "text": "The <w>Bless</w> family has lived in this town for over a century.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Блесс</w> живет в этом городе уже более века.",
                                "tr": "<w>Bless</w> ailesi bir asırdan fazladır bu kasabada yaşıyor.",
                                "zh": "<w>布莱斯</w>一家在这个镇上已经住了一个多世纪了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия немецкого происхождения.",
                        "tr": "Alman kökenli bir soyadı.",
                        "zh": "源自德语的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Блесс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Bless",
                                "target_lang_sense_clarification": "özel isim (soyadı)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布莱斯",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}