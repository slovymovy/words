                    {
                        "sense_id": "a330fdd3-b416-3a60-945b-f0663864efaf",
                        "entry_id": "e2ed2888-dc34-35f3-9985-84ffa198626a",
                        "glosses": [
                            "Ski, mit dem bei einem Wettbewerb der erste Platz erreicht wurde"
                        ],
                        "tags": [
                            "Wintersport"
                        ],
                        "examples": [
                            {
                                "example_id": "ac1a05fc-50cd-4da6-a5d3-c8c9255b9265",
                                "sense_id": "a330fdd3-b416-3a60-945b-f0663864efaf",
                                "text": "„Und zwei Tage zuvor waren nach seinem Erfolg im Riesenslalom in Alta Badia plötzlich seine Siegerski verschwunden – jene Ski, mit denen Hirscher davor schon den Riesenslalom in Val d’Isère gewonnen hatte.“"
                            },
                            {
                                "example_id": "f4cdfea8-56c4-4b98-856b-0ded3e35bf0e",
                                "sense_id": "a330fdd3-b416-3a60-945b-f0663864efaf",
                                "text": "„Im März finden wie durch glückliche Fügung in Amerika die letzten Weltcup-Abfahrten dieses Winters statt. Johnson darf wohl wieder die Siegerski besteigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
