                "senses": [
                    {
                        "sense_id": "922a56cf-e82a-3ba7-9c87-114f0c9aad45",
                        "entry_id": "eabaebde-25ba-326d-838e-2559c7e5f4b8",
                        "glosses": [
                            "Qui concerne l’orbite d’un corps céleste ou d’un satellite artificiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ae970f-25d7-45b2-8c84-26f8ebecab91",
                                "sense_id": "922a56cf-e82a-3ba7-9c87-114f0c9aad45",
                                "text": "Le mystère des perturbations de l’orbite de Mercure n'a finalement été élucidé qu'avec la théorie de la relativité générale proposée par Albert Einstein au début du XX^(ème) siècle. Cette théorie prédisait justement des écarts orbitaux qui ont été confirmés par Arthur Eddington en 1919."
                            }
                        ]
                    },
                    {
                        "sense_id": "79f8db85-b815-3391-8a48-0307ee4d3435",
                        "entry_id": "eabaebde-25ba-326d-838e-2559c7e5f4b8",
                        "glosses": [
                            "Orbitaire ; qui concerne l’orbite de l’œil."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a1c13fa-e90a-4e0b-902b-099c3ff38ac7",
                        "source_entry_id": "eabaebde-25ba-326d-838e-2559c7e5f4b8",
                        "target_lang_word": "orbital",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orbital",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7579b277-4ad0-364a-98c9-0d743b330fdf",
                                        "entry_id": "6fe734fa-0679-3e4e-b212-bf39c530ebe9",
                                        "glosses": [
                                            "den Orbit betreffend, im Orbit befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "264268d5-e90d-477f-8008-eb88821afb32",
                                                "sense_id": "7579b277-4ad0-364a-98c9-0d743b330fdf",
                                                "text": "Mittels kabelloser Übertragungstechnik soll Strom von orbitalen Solarkollektoren auf die Erde gebeamt werden, um die Energieversorgung zu sichern."
                                            },
                                            {
                                                "example_id": "bbda536d-4fca-4579-b02e-e65f4e2a3b4f",
                                                "sense_id": "7579b277-4ad0-364a-98c9-0d743b330fdf",
                                                "text": "Zwei Tage vor dem Absturz können die Amerikaner aus orbitalen Ortungsdaten eine Gefahrenzone berechnen: Ein langer Streifen, der etwa 50 Kilometer in Ost-West-Richtung durchmisst und sich etwa 1000 Kilometer in Nord-Süd-Richtung ausdehnt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "447c32df-5e7a-3853-9447-6b1a763427da",
                                        "entry_id": "6fe734fa-0679-3e4e-b212-bf39c530ebe9",
                                        "glosses": [
                                            "die Augenhöhle (Orbita) betreffend, zur Augenhöhle gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695c76d2-72a8-4a71-9e23-84f2b977c6f8",
                                                "sense_id": "447c32df-5e7a-3853-9447-6b1a763427da",
                                                "text": "Die endokrine Orbitopathie (EO) ist eine komplexe orbitale Erkrankung, der als Pathogenese wahrscheinlich ein autoimmuner Prozeß zu Grunde liegt."
                                            },
                                            {
                                                "example_id": "8836d1cf-bd01-4729-aa4d-e7e9b761a184",
                                                "sense_id": "447c32df-5e7a-3853-9447-6b1a763427da",
                                                "text": "Bei der Optikusneuropathie kommt es zur Kompression des Sehnervs oder seiner Blutversorgung durch geschwollenes orbitales Gewebe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bcd47c5-fe9b-4f83-830a-5c810a9aa746",
                        "source_entry_id": "eabaebde-25ba-326d-838e-2559c7e5f4b8",
                        "target_lang_word": "orbital",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
