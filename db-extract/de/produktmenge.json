                "senses": [
                    {
                        "sense_id": "e9cabc74-82e4-37e0-848a-a09d1e99af89",
                        "entry_id": "e46cdfa5-2159-3e7e-9a66-f69d70bea210",
                        "glosses": [
                            "Menge aller geordneten Paare (x,y), die sich aus zwei Mengen M₁ und M₂ bilden lassen, wobei x Element der Menge M₁ und y Element der M₂ ist"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "42494d1d-698c-3137-b644-f1b9146c57fd",
                        "entry_id": "e46cdfa5-2159-3e7e-9a66-f69d70bea210",
                        "glosses": [
                            "Anzahl an Produkten"
                        ],
                        "tags": [
                            "Handel"
                        ],
                        "examples": [
                            {
                                "example_id": "f7fecd21-3b73-4d0a-98df-5481f73b7588",
                                "sense_id": "42494d1d-698c-3137-b644-f1b9146c57fd",
                                "text": "„Infolge des Fixkostenblocks werden bei größeren Produktmengen je Zeiteinheit Gewinne erzielt, bei kleineren Produktmengen erleidet der Betrieb Verluste.“"
                            },
                            {
                                "example_id": "0e54939e-da3c-4737-b3b7-be0ff65f02a0",
                                "sense_id": "42494d1d-698c-3137-b644-f1b9146c57fd",
                                "text": "„In vielen Fällen werden entsprechende Produktlizenzen an Spezialisten vergeben und der Verein kauft für seinen zu erwartenden Nachfragebedarf die entsprechenden Produktmengen vom jeweiligen Lizenznehmer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
