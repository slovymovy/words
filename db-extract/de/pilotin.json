                        ],
                        "form": "die Pilotinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82e38034-4a8c-3636-8b0c-3e4c7e128f08",
                        "entry_id": "3dc19d48-dd18-3324-a2a7-aaf5808e0920",
                        "glosses": [
                            "weibliche Person, die ein Flugzeug oder ein ähnliches Flugobjekt steuert"
                        ],
                        "tags": [
                            "Berufsbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "d2e56740-aa7f-4e28-afa9-3c2befca6e5c",
                                "sense_id": "82e38034-4a8c-3636-8b0c-3e4c7e128f08",
                                "text": "Pilotinnen üben einen sehr verantwortungsvollen Beruf aus."
                            },
                            {
                                "example_id": "170acaef-f6ae-4d35-8de1-9bbb5313dfc8",
                                "sense_id": "82e38034-4a8c-3636-8b0c-3e4c7e128f08",
                                "text": "„Für den kurzen Flug schien er unnötig, und ich konnte die Pilotin ohnehin nicht damit navigieren, falls sie sich verflog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8d77d579-3f63-38e8-9057-8d42765d2078",
                        "entry_id": "3dc19d48-dd18-3324-a2a7-aaf5808e0920",
                        "glosses": [
                            "weibliche Person, die über eine entsprechende Lizenz verfügt"
                        ],
                        "tags": [
                            "Berufsbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "d8057bcb-283e-40d6-b291-4c8abbde8024",
                                "sense_id": "8d77d579-3f63-38e8-9057-8d42765d2078",
                                "text": "„Über drei Jahre lang hatte sie versucht, in die röhrende Männer-Welt der Formel 1 einzudringen. Vergeblich. Nun schmeißt Pilotin Susie Wolff hin. Ein Abgang mit Bitterkeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2c967b57-0011-37fb-9210-20208d32a3f6",
                        "entry_id": "3dc19d48-dd18-3324-a2a7-aaf5808e0920",
                        "glosses": [
                            "weibliche Person, die ein Rennfahrzeug steuert"
                        ],
                        "tags": [
                            "Berufsbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "10ae6eee-e130-490e-87b7-889339b2f9eb",
                                "sense_id": "2c967b57-0011-37fb-9210-20208d32a3f6",
                                "text": "Die Pilotin beendete 1976 ihre Formel-1-Karriere."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55820d9a-10f7-4847-a6a4-58a273b260b4",
                        "source_entry_id": "3dc19d48-dd18-3324-a2a7-aaf5808e0920",
                        "source_sense_id": "82e38034-4a8c-3636-8b0c-3e4c7e128f08",
                        "source_sense_description": "steuert Flugzeug",
                        "target_lang_word": "pilot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0ed3bc1-1e90-34a2-b5cb-7764c5f239d5",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A person who steers a ship, a helmsman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e6bdc70-cd58-4007-bf44-078248bc1144",
                                                "sense_id": "e0ed3bc1-1e90-34a2-b5cb-7764c5f239d5",
                                                "text": "They scud before the wind, and sail in open sea.\n Ahead of all the master pilot steers;\n And, as he leads, the following navy veers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b7dc5e7-851d-3e6b-bf5a-28ed36a2c530",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A person who knows well the depths and currents of a harbor or coastal area, who is hired by a vessel to help navigate the harbor or coast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11dde485-5a38-3201-8b7f-b52bf61dbd65",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A guide book for maritime navigation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3bd6036-8301-3a59-9855-d46de73096ba",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "An instrument for detecting the compass error."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d09c13f-ec3f-3ca8-af2b-aef57ea95a2e",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A pilot vehicle."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1bb21d6-f991-3358-8da4-c1fc3a681095",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A person authorised to drive such a vehicle during an escort."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d56ad85c-d15d-3925-9c48-1530556eda9e",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A guide or escort through an unknown or dangerous area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b1a7d61-563b-4413-8262-e0ede72d6123",
                                                "sense_id": "d56ad85c-d15d-3925-9c48-1530556eda9e",
                                                "text": "So we mounted our horses, and put out for that town, under the direction of two friendly Creeks we had taken for pilots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cd4e8dc-c4df-3732-bd3f-6b21fc52cd71",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "Something serving as a test or trial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d14b75-27e1-41f5-aa88-0f67115bc102",
                                                "sense_id": "7cd4e8dc-c4df-3732-bd3f-6b21fc52cd71",
                                                "text": "We would like to run a pilot in your facility before rolling out the program citywide."
                                            },
                                            {
                                                "example_id": "656deb8e-f2d6-42c2-9898-b08712d6a346",
                                                "sense_id": "7cd4e8dc-c4df-3732-bd3f-6b21fc52cd71",
                                                "text": "“I agreed with my husband when he said that to do the business properly we must do a pilot first.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d2c14a-a41d-35d2-b4f2-747dd6497703",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "Something serving as a test or trial.",
                                            "The heading or excavation of relatively small dimensions, first made in the driving of a larger tunnel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa4b18fb-8cd5-31f9-b51e-410ffc46b3ae",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A tone or signal, usually a single frequency, transmitted over a communications system for control or synchronization purposes."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dea3445-b2a8-3cf1-a504-20115acefe9b",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A person who is in charge of the controls of an aircraft."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47a0fd08-75de-3b4d-8a21-562eb2c69d52",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A sample episode of a proposed TV series produced to decide if it should be made or not. If approved, typically the first episode of an actual TV series."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b362e0e-5c2b-4dc9-97d4-638fcb666915",
                                                "sense_id": "47a0fd08-75de-3b4d-8a21-562eb2c69d52",
                                                "text": "I think her biggest deal was she starred in a pilot.[…]Well, the way they pick TV shows is they make one show. That show's called a pilot. Then they show that one show to the people who pick shows, and on the strength of that one show, they decide if they wanna make more shows."
                                            }
                                        ]
                                    },
