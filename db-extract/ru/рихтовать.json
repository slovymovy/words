                                                "example_id": "0e887c2d-582d-4543-8958-496a7aff7aa1",
                                                "sense_id": "985bf13c-7e85-375a-8658-e8337b4f67c0",
                                                "text": "„Ihr Protest richtet sich gegen ein neues Schulfach, das den Schülern pro-chinesischen Patriotismus eintrichtern soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
