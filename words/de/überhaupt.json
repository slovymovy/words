                    "frequency": "High",
                    "semantic_group_id": "verneinung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe heute <w>überhaupt</w> keine Zeit für ein langes Telefonat."
                        },
                        {
                            "text": "Er hat die Erklärung des Lehrers leider <w>überhaupt</w> nicht verstanden."
                        }
                    ],
                    "synonyms": [
                        "gar"
                    ],
                    "common_phrases": [
                        "überhaupt nicht",
                        "überhaupt kein"
                    ]
                },
                {
                    "sense_id": "8e43bd5b-5663-3397-8fc5-9078295b2b4b",
                    "sense_definition": "drückt in Fragen oder Bedingungssätzen einen grundsätzlichen Zweifel an einem Sachverhalt aus",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zweifel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weißt du denn <w>überhaupt</w>, wie spät es im Moment ist?"
                        },
                        {
                            "text": "Können wir den nächsten Zug <w>überhaupt</w> noch pünktlich erreichen?"
                        }
                    ],
                    "synonyms": [
