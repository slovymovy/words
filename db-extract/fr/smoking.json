                    {
                        "sense_id": "cdad1657-24ad-3c0c-b5ab-c535690584b5",
                        "entry_id": "eed4c1df-5d74-3582-a8c4-c67b9798a93b",
                        "glosses": [
                            "Tenue de soirée ou de cérémonie pour homme, qui comprend un costume à revers de soie et en guise de cravate un nœud papillon."
                        ],
                        "tags": [
                            "Faux anglicisme"
                        ],
                        "examples": [
                            {
                                "example_id": "92b93c5e-5b5e-4433-8b9c-1d911842b37c",
                                "sense_id": "cdad1657-24ad-3c0c-b5ab-c535690584b5",
                                "text": "Varichkine avait endossé un smoking que nul dandy londonien n’eût renié, un smoking à revers de moire, avec un gilet de faille noire, orné d’une chaîne de montre à breloque symbolique : la faucille et le marteau d’or semés de rubis."
                            },
                            {
                                "example_id": "f098ea14-f453-4a08-9028-76740721aeef",
                                "sense_id": "cdad1657-24ad-3c0c-b5ab-c535690584b5",
                                "text": "Mais un grand escogriffe en smoking et coiffé d’une casquette à carreaux sortait de la limousine et accourait vers les trois femmes qui l’accueillirent fraîchement."
                            },
                            {
                                "example_id": "b75beda5-6c20-4646-aea8-e67d9e798969",
                                "sense_id": "cdad1657-24ad-3c0c-b5ab-c535690584b5",
                                "text": "Elle bouda toute la soirée quand elle vit les hommes en smoking et leurs compagnes en robes du soir."
                            },
                            {
                                "example_id": "2159316d-1177-43ea-ac30-5c751e8f2565",
                                "sense_id": "cdad1657-24ad-3c0c-b5ab-c535690584b5",
                                "text": "À l’entrée de sa loge, le Marseillais s’exhibait dans un smoking lavande fleuri d’un œillet pourpre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bc40157-e287-4515-9cf0-522799ad98b8",
                        "source_entry_id": "eed4c1df-5d74-3582-a8c4-c67b9798a93b",
                        "source_sense_id": "cdad1657-24ad-3c0c-b5ab-c535690584b5",
                        "target_lang_word": "Smoking",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Smoking",
