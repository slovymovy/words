                "senses": [
                    {
                        "sense_id": "c6fad222-3351-3bc0-bad0-0752985f51a1",
                        "entry_id": "59744a2a-b7c0-3dff-ae4f-f59679d3675a",
                        "glosses": [
                            "Händler, der Waren ins Ausland ausführt"
                        ],
                        "tags": [
                            "Beruf"
                        ],
                        "examples": [
                            {
                                "example_id": "75491de5-f426-4603-974a-ccd533df2fe6",
                                "sense_id": "c6fad222-3351-3bc0-bad0-0752985f51a1",
                                "text": "Der Exporteur erzielte hohe Gewinne."
                            },
                            {
                                "example_id": "9e5b0baf-c0bc-4aca-932c-88628e2ea11a",
                                "sense_id": "c6fad222-3351-3bc0-bad0-0752985f51a1",
                                "text": "„Sein Modell muß in der Gründerzeit fertiggeworden sein, nach 1870, als Bismarck und die Preußen, als die zackigen Unternehmer und Exporteure ihren Nachbarn mit ihrer forschen Aktivität Schrecken einjagten.“"
                            },
                            {
                                "example_id": "fbe54daf-23d1-43b4-96b7-a0485dc2dca2",
                                "sense_id": "c6fad222-3351-3bc0-bad0-0752985f51a1",
                                "text": "„Russland und die Ukraine sind zwei der größten globalen Agrarproduzenten und bedeutende Exporteure von Weizen, Gerste, Mais, Raps, Rapsöl, Sonnenblumenkernen und Sonnenblumenöl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ec9ed5f-1754-430e-8e55-14e5d5e3d8f9",
                        "source_entry_id": "59744a2a-b7c0-3dff-ae4f-f59679d3675a",
                        "source_sense_id": "c6fad222-3351-3bc0-bad0-0752985f51a1",
                        "source_sense_description": "Händler, der Waren ins Ausland ausführt",
                        "target_lang_word": "exporter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exporter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "127093a1-20bb-3fd8-a38b-22e93374c8c8",
                                        "entry_id": "906c9c80-918d-3439-9a47-1249cdf670b7",
                                        "glosses": [
                                            "One who, or that which, exports: especially a person who or organization that exports or sells goods made in one country for delivery in another country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce09d614-d00d-45fc-be85-4607c0aedd9b",
                                                "sense_id": "127093a1-20bb-3fd8-a38b-22e93374c8c8",
                                                "text": "India is the leading exporter of guar gum, making up nearly 85 per cent of the global production."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61e95555-c0b6-4d7b-b270-c4c0fc2c6dc1",
                        "source_entry_id": "59744a2a-b7c0-3dff-ae4f-f59679d3675a",
                        "source_sense_id": "c6fad222-3351-3bc0-bad0-0752985f51a1",
                        "source_sense_description": "Händler, der Waren ins Ausland ausführt",
                        "target_lang_word": "exportateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exportateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8094e6-5727-3171-b41b-2b018261be84",
                                        "entry_id": "6ca7e963-2e3b-3648-93cc-883ceb1ee675",
                                        "glosses": [
                                            "Celui qui exporte des marchandises en pays étranger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e70c26-0919-4d69-9ff9-e40fcf1fbb42",
                                                "sense_id": "8c8094e6-5727-3171-b41b-2b018261be84",
                                                "text": "Elle escompterait les lettres de change tirées sur nos places par les exportateurs de produits exotiques sans que ceux ci passassent sous les fourches caudines des banquiers londoniens."
                                            },
                                            {
                                                "example_id": "c200a891-8150-46ac-93f2-67d2305af2c7",
                                                "sense_id": "8c8094e6-5727-3171-b41b-2b018261be84",
                                                "text": "Très souvent, les mesures d’incitation à l’exportation s’appliquent au niveau de l’exportateur et sont considérablement diluées quand elles arrivent jusqu’aux agriculteurs, si elles y arrivent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exportateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20ff9f83-3642-33ea-bd3c-926848c66cf7",
                                        "entry_id": "5a6dc1c8-388f-3e84-a62e-e3866ab9f610",
                                        "glosses": [
                                            "Relatif aux exportations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0557d956-cfca-4526-bf58-a1320e3745da",
                                                "sense_id": "20ff9f83-3642-33ea-bd3c-926848c66cf7",
                                                "text": "Les entreprises exportatrices utilisent de plus en plus souvent ce système de protection à l’égard de leurs clients."
                                            },
                                            {
                                                "example_id": "7e672ae1-334c-4de7-99ef-3dbd71369e56",
                                                "sense_id": "20ff9f83-3642-33ea-bd3c-926848c66cf7",
                                                "text": "Un pays exportateur de pétrole."
                                            }
                                        ]
                                    }
