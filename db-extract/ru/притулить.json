                "senses": [
                    {
                        "sense_id": "babae42d-2af6-38af-a623-a4870c55868f",
                        "entry_id": "25d2b0ff-a530-3c7d-bf54-2427a2f96032",
                        "glosses": [
                            "прислонить, приставить, поместить, пристроить, примостить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47643239-700e-4efa-950a-a930f6d52c6d",
                                "sense_id": "babae42d-2af6-38af-a623-a4870c55868f",
                                "text": "Вот так цельный день топчешься по избе невесть зачем, — безнадежно говорит старуха. — Не знаешь, куда себя притулить."
                            }
                        ]
                    },
                    {
                        "sense_id": "d51c9f40-2d33-3473-9c3a-ef6be6af3801",
                        "entry_id": "25d2b0ff-a530-3c7d-bf54-2427a2f96032",
                        "glosses": [
                            "укрыть, спрятать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6772342e-e003-4fcf-969a-0adacb77337b",
                                "sense_id": "d51c9f40-2d33-3473-9c3a-ef6be6af3801",
                                "text": "Притули пух от ветру, а то разнесет его."
                            }
                        ]
                    },
                    {
                        "sense_id": "20afc8b4-653a-3dc5-98bf-30d0ff40e8ea",
                        "entry_id": "25d2b0ff-a530-3c7d-bf54-2427a2f96032",
                        "glosses": [
                            "перен. приютить, дать пристанище, убежище, кров"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9abe8c8a-b222-34aa-896e-2c303f7d6bf3",
                        "entry_id": "25d2b0ff-a530-3c7d-bf54-2427a2f96032",
                        "glosses": [
                            "прижать, приобнять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e19bfa35-3c2d-4061-bd2d-cffab079e86f",
                                "sense_id": "9abe8c8a-b222-34aa-896e-2c303f7d6bf3",
                                "text": "Некуда сиротинушке притулиться!"
                            }
                        ]
                    }
