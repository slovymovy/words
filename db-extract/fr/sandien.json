                        "entry_id": "27370ac9-0591-36df-94e0-29f37964a77b",
                        "glosses": [
                            "Propre ou relatif à George Sand ou à son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d97262e-7f4d-4e56-b193-80f3d697e200",
                                "sense_id": "d0b550f0-5574-3b71-b0bc-0b676d1277a2",
                                "text": "Pauvre âme malade et que les romans ont empoisonnée, elle aspire à un amour convulsif, illégitime, impossible, sandien, si l'on peut parler ainsi."
                            },
                            {
                                "example_id": "0e892e37-91cd-41c5-9f65-5f814e4c44bb",
                                "sense_id": "d0b550f0-5574-3b71-b0bc-0b676d1277a2",
                                "text": "Il n’en demeure pas moins que le travail de l’imaginaire sandien agrandit ces portraits, que nourrissent les archétypes de la fée, de la sainte et de la déesse, aux dimensions de figures mythiques."
                            }
                        ]
                    }
