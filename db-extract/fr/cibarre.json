                "senses": [
                    {
                        "sense_id": "06ffaf61-e2bf-3df2-a778-e3bffa898277",
                        "entry_id": "53e4251d-602e-346c-bdd3-82e0f9520714",
                        "glosses": [
                            "Marqueur de cible, homme ordinairement placé dans un fossé et vêtu de rouge."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "b946075f-6d50-4d65-ba8b-712c2efd7321",
                                "sense_id": "06ffaf61-e2bf-3df2-a778-e3bffa898277",
                                "text": "Puis, à trois heures [à la suite du tir], le drapeau fédéral est solennellement conduit par le cortège des cibarres et des tireurs à la demeure du président central."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6769e4d-edb4-37e3-a025-51457e86e281",
                        "entry_id": "53e4251d-602e-346c-bdd3-82e0f9520714",
                        "glosses": [
                            "Instrument qui marque le tir dans la cible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a5ea0a1-5c5c-4695-89a5-77cd2270ce0b",
                                "sense_id": "d6769e4d-edb4-37e3-a025-51457e86e281",
                                "text": "Les cibarres indiquent la valeur des touches avec des \"pelles\" (dont la pointe ronde est de couleurs différentes) comme les aiguilles sur le cadran d'une montre. Ce système ancien a été largement remplacé par des installations électroniques qui déterminent l'endroit de l'impact moyennant trois microphones."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a7514b6-d03f-4a77-bbe3-4bf988135ba5",
                        "source_entry_id": "53e4251d-602e-346c-bdd3-82e0f9520714",
                        "target_lang_word": "Zeiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9ada870-8498-36e0-ba38-ca924ff761dd",
                                        "entry_id": "f294c5dc-6c26-3e9f-b266-969032287ab3",
                                        "glosses": [
                                            "Teil eines Messgeräts oder einer Uhr, der den gemessenen Wert oder eine Richtung anzeigt (siehe auch Kompass, Navi oder Sextant)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "951f4da4-16f6-4f79-be1c-80ac9800fb46",
                                                "sense_id": "b9ada870-8498-36e0-ba38-ca924ff761dd",
                                                "text": "Der Zeiger steht auf 5 vor 12."
                                            },
                                            {
                                                "example_id": "5faa1d6b-988d-417f-8c7c-9f2d36e8a7c5",
                                                "sense_id": "b9ada870-8498-36e0-ba38-ca924ff761dd",
                                                "text": "„Der Zeiger oder das Zifferblatt [von Parkscheiben] ist verstellbar anzubringen.“"
                                            },
                                            {
                                                "example_id": "9055f50e-5b51-437d-b151-7368e7b68433",
                                                "sense_id": "b9ada870-8498-36e0-ba38-ca924ff761dd",
                                                "text": "„Auf den milchweißen Ziffernblättern der Uhren rucken die Zeiger, alle uf einmal, in neue Stellungen.“"
                                            },
                                            {
                                                "example_id": "0cd35702-4da1-4e7a-a6f9-775e414810bb",
                                                "sense_id": "b9ada870-8498-36e0-ba38-ca924ff761dd",
                                                "text": "„Die Zeiger des Weckers im Schlafzimmer ticken lauter als sonst.“"
                                            },
                                            {
                                                "example_id": "ef066e89-18f4-4f69-8ef9-9eb9eca86c47",
                                                "sense_id": "b9ada870-8498-36e0-ba38-ca924ff761dd",
                                                "text": "„Meine Augen folgten den Zeigern am Leuchtzifferblatt der runden Uhr, die auf dem Nachttisch stand.“"
                                            },
                                            {
                                                "example_id": "2a42e69c-6716-40d2-bc39-746ce69b08e4",
                                                "sense_id": "b9ada870-8498-36e0-ba38-ca924ff761dd",
                                                "text": "„Der Zeiger des Tiefenmanometers vibriert.“"
                                            }
                                        ],
