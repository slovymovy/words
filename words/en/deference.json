{
    "word_family": [
        "defer",
        "deferential"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "942caec4-cbe9-3cdf-bbea-70776b6382dc",
                    "sense_definition": "Great respect shown to someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students treated their professor with <w>deference</w>.",
                            "target_lang_translations": {
                                "zh": "学生们对教授表现出了极大的<w>尊重</w>。"
                            }
                        },
                        {
                            "text": "He bowed his head in <w>deference</w> to the king.",
                            "target_lang_translations": {
                                "zh": "他向国王低头以示<w>敬意</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "honor",
                        "respect"
                    ],
                    "common_phrases": [
                        "show deference"
                    ],
                    "target_lang_definitions": {
                        "zh": "对他人的高度尊重或敬意。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尊重",
                                "target_lang_sense_clarification": "指对人或事物的敬重。"
                            },
                            {
                                "target_lang_word": "敬意",
                                "target_lang_sense_clarification": "指对人表示尊敬的态度。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a89f4a2-fa28-3e33-9579-5d3dae721467",
                    "sense_definition": "The willingness to yield to or follow the wishes or opinions of others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She changed her plans in <w>deference</w> to her partner's needs.",
                            "target_lang_translations": {
                                "zh": "为了<w>迁就</w>伴侣的需求，她改变了自己的计划。"
                            }
                        },
                        {
                            "text": "The committee made the decision in <w>deference</w> to the chairman's advice.",
                            "target_lang_translations": {
                                "zh": "委员会出于对主席建议的<w>顺从</w>，做出了这项决定。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in deference to"
                    ],
                    "target_lang_definitions": {
                        "zh": "愿意顺从或采纳他人的意愿或意见。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "顺从",
                                "target_lang_sense_clarification": "指听从他人的意愿。"
                            },
                            {
                                "target_lang_word": "迁就",
                                "target_lang_sense_clarification": "指为了照顾他人的意愿而改变自己的计划。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}