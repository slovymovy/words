                "senses": [
                    {
                        "sense_id": "9238fb16-2d48-3f62-b430-dac94408aba9",
                        "entry_id": "b59e7bf6-d067-3662-92d2-4a38322ee52d",
                        "glosses": [
                            "männliche Person, die für die Pflege von Hotelzimmern beschäftigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d9e21d-caca-4b9c-8e6c-02e9fe993cb2",
                                "sense_id": "9238fb16-2d48-3f62-b430-dac94408aba9",
                                "text": "„Einstweilen vertreiben sich die Hotelangestellten die Zeit mit Routine. Der Zimmerjunge saugt alle zwei Tage die Zimmer, ob sie benutzt wurden oder nicht.“"
                            },
                            {
                                "example_id": "8e21343b-e1ee-463f-a4ed-1bbad06cc035",
                                "sense_id": "9238fb16-2d48-3f62-b430-dac94408aba9",
                                "text": "„Es kam eben ein javanischer Zimmerjunge der Gasthofdienerschaft mit einem Brett in der Hand, auf dem ein Glas voll Limonade stand, die Treppe herauf.“"
                            },
                            {
                                "example_id": "a3622b76-5150-47cd-8f0e-ac1316f98dc8",
                                "sense_id": "9238fb16-2d48-3f62-b430-dac94408aba9",
                                "text": "„Dies schien um so erstaunlicher, als sich im Hause fast gar keine Mannspersonen befanden, mit Ausnahme höchstens des Zimmerjungen, der im grauen Halbfrack und mit bloßen Füßen ging und, wenn er nicht mit Essen beschäftigt war, sicherlich schlief.“"
                            },
                            {
                                "example_id": "95dc2bc3-0263-4c01-b1dc-3e5feaca3421",
                                "sense_id": "9238fb16-2d48-3f62-b430-dac94408aba9",
                                "text": "„Der junge Robert, Zimmerjunge im Hotel Ocean Beach, dessen besondere Methode es ist, die alleinreisenden Damen abends vor ihrer Zimmertür abzufangen und ihnen eine Massage und andere Einschlafhilfen anzubieten, hat für seinen Lebenstraum eine geographische Bezeichnung: Europa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
