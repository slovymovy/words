                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086a3e3f-03aa-45b4-99a2-b4052132c6cc",
                                "sense_id": "63f4d0ad-e192-3052-b778-eebc89724a83",
                                "text": "Кто-то шильцем кольнул коня, ― тот забил, храпя, ― взвился."
                            },
                            {
                                "example_id": "a4a2ff1b-d762-4ae5-ad97-18e491cfafe8",
                                "sense_id": "63f4d0ad-e192-3052-b778-eebc89724a83",
                                "text": "Подсела тут старушка одна знакомая, ― черный шлык, глазки шильцем, язык мыльцем, голова толкачиком."
                            }
                        ]
                    }
