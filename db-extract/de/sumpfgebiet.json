                        "entry_id": "4f84b757-244e-311a-8bde-bf1bc851e88a",
                        "glosses": [
                            "Örtlichkeit mit stark aufgeweichtem, schlammigem, morastigem Boden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfdbec10-9200-4ae0-9cfc-4215a2223c2e",
                                "sense_id": "61b7d294-1bed-3ad7-b1b8-8ff0259b8d1b",
                                "text": "„1884, einige Jahrzehnte nach Gründung der Kronkolonie, begannen die Briten damit, in einem trockengelegten Sumpfgebiet Pferderennen zu veranstalten.“"
                            },
                            {
                                "example_id": "ed916393-30f8-4db2-821a-93b5b0f8cbf9",
                                "sense_id": "61b7d294-1bed-3ad7-b1b8-8ff0259b8d1b",
                                "text": "„Die Siedler standen auf und drangen bis zum Rand eines ausgedehnten Sumpfgebietes vor, dessen Boden aus einem Gemisch von Lehm, Ton und verfaulten Pflanzen bestand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
