                                        "glosses": [
                                            "A water-soluble vitamin, a component of vitamin B complex, found in meat, yeast, and dairy products; it is essential to metabolism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e0917d-b018-4ef0-b18c-329f888884fa",
                                                "sense_id": "f032588c-d4b1-3821-b833-dfa2fbed732a",
                                                "text": "Mixing the alkali into the recipe in the right way chemically releases the otherwise unavailable niacin in the corn, which stops pellagra in its tracks, and allowed corn-based agricultural populations to grow and spread."
                                            }
                                        ]
                                    }
                                ]
