                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "521636d2-d57e-4247-95e0-81c4f86e5c66",
                                                "sense_id": "ed528eb8-8b70-36ce-8809-881fd44f4f4f",
                                                "text": "Un vent tempétueux."
                                            },
                                            {
                                                "example_id": "2ed3aa86-fe15-4211-a7e2-48cb4d527ad1",
                                                "sense_id": "ed528eb8-8b70-36ce-8809-881fd44f4f4f",
                                                "text": "Ces deux tempêtes, rapidement qualifiées par les médias de tempêtes du siècle, s’inscrivent en fait dans une longue série d’événements tempétueux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89cf8c4e-9549-3611-af55-35b82ee4479a",
                                        "entry_id": "03d57052-ac59-3f7c-86da-019844e84937",
                                        "glosses": [
                                            "Qui est agité par la tempête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ee5bb3a-ff6f-4d3c-bc66-f3e32bd2be07",
                                                "sense_id": "89cf8c4e-9549-3611-af55-35b82ee4479a",
                                                "text": "Ça aurait été un magnifique hiver pour se côtoyer à l’extérieur.\n Même la journée un peu tempétueuse d’hier! Par un temps comme ça, jadis au lac Saint-Jean, j’aurais mis mes raquettes pour aller rejoindre mon parrain et ses chums qui surveillaient leurs trous à pêche sur la banquise."
                                            },
                                            {
                                                "example_id": "d111adbb-371e-44fa-9b26-64e6dd02e36f",
                                                "sense_id": "89cf8c4e-9549-3611-af55-35b82ee4479a",
                                                "text": "Une mer tempétueuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a9dc33f-2d51-3c18-a481-4399381027b6",
                                        "entry_id": "03d57052-ac59-3f7c-86da-019844e84937",
                                        "glosses": [
                                            "Agité, impulsif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93ce02da-908e-4479-bfdb-5aeb04d9ed35",
                                                "sense_id": "5a9dc33f-2d51-3c18-a481-4399381027b6",
                                                "text": "C’est avec Gustave que Rémo a fait le voyage de Bucarest à Constantinople, d’où le tempétueux jeune Français est parti pour se mettre au service de l’insurrection crétoise."
                                            },
                                            {
                                                "example_id": "e38db1dd-72a2-4e6e-9544-a5240a609813",
                                                "sense_id": "5a9dc33f-2d51-3c18-a481-4399381027b6",
                                                "text": "Symbole d’une position de plus en plus intenable pour le tempétueux président, la Géorgie, où Joe Biden l’a emporté d’une courte tête, a officiellement certifié vendredi après-midi les résultats de l’élection."
                                            }
                                        ]
                                    }
                                ]
