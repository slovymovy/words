                        ],
                        "form": "шатуно́м"
                    },
                    {
                        "form_id": "c7b161cb-ffb9-4e3b-aa95-e703d4a437b3",
                        "entry_id": "314c2c94-5734-391a-9c6f-2d5bf04245b7",
