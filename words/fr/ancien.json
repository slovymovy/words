{
    "word_family": [
        "ancienneté",
        "anciennement",
        "bisancien"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f1e4c971-0341-3339-a64e-443f6a3d3331",
                    "sense_definition": "Qui a changé de situation, de fonction ou de destination et n'est plus actuel ; qui a été quelque chose auparavant (se place généralement avant le nom).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ancien : qui n'est plus actuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon <w>ancien</w> professeur habite maintenant à Lyon."
                        },
                        {
                            "text": "C'est l'<w>ancien</w> président du club de football."
                        },
                        {
                            "text": "Il habite dans une <w>ancienne</w> boucherie transformée en appartement."
                        }
                    ],
                    "antonyms": [
                        "actuel"
                    ],
                    "common_phrases": [
                        "ancien président",
                        "ancien élève",
                        "ancienne école",
                        "ancien petit ami"
                    ]
                },
                {
                    "sense_id": "bbc30785-7d38-3242-b9d6-eacd1d22f434",
                    "sense_definition": "Qui existe depuis très longtemps ; qui date d'une époque lointaine (se place généralement après le nom).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ancien : qui date de longtemps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté une maison <w>ancienne</w> à la campagne."
                        },
                        {
                            "text": "Cette coutume <w>ancienne</w> se transmet de génération en génération."
                        },
                        {
                            "text": "Le château de Roquetaillade est un château très <w>ancien</w>."
                        }
                    ],
                    "synonyms": [
                        "vieux",
                        "séculaire"
                    ],
                    "antonyms": [
                        "nouveau",
                        "neuf",
                        "moderne",
                        "récent"
                    ],
                    "common_phrases": [
                        "maison ancienne",
                        "bâtiment très ancien",
                        "coutume ancienne"
                    ]
                },
                {
                    "sense_id": "9b77e1f9-5eb6-3525-be42-3e9d3817bd9c",
                    "sense_definition": "Qui concerne l'Antiquité ou une époque historique très éloignée, précédant le Moyen Âge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ancien : qui date de longtemps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans l'Égypte <w>ancienne</w>, on construisait des pyramides."
                        },
                        {
                            "text": "La Grèce <w>ancienne</w> a inventé la démocratie."
                        },
                        {
                            "text": "Il étudie le grec <w>ancien</w> à l'université."
                        }
                    ],
                    "synonyms": [
                        "antique"
                    ],
                    "antonyms": [
                        "moderne",
                        "contemporain"
                    ],
                    "common_phrases": [
                        "Égypte ancienne",
                        "Grèce ancienne",
                        "histoire ancienne",
                        "grec ancien"
                    ]
                },
                {
                    "sense_id": "5e8ea7ce-efd5-3aa6-8daa-44e45cbce02e",
                    "sense_definition": "Se dit, après un nom propre, pour distinguer un personnage historique d'un autre qui porte le même nom et qui est plus jeune.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pline l'<w>ancien</w> est mort pendant l'éruption du Vésuve."
                        },
                        {
                            "text": "Caton l'<w>ancien</w> est connu pour son opposition à Carthage."
                        }
                    ],
                    "antonyms": [
                        "jeune"
                    ]
                },
                {
                    "sense_id": "521702e5-d5d8-3e7f-859a-82d948d7b6bf",
                    "sense_definition": "En sylviculture, se dit des arbres réservés qui ont plus de trois fois l'âge du taillis, par opposition à « moderne ».",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le forestier marque les arbres <w>anciens</w> à conserver dans la réserve."
                        },
                        {
                            "text": "Dans un taillis, les arbres <w>anciens</w> ont plus de trois fois l'âge du taillis."
                        }
                    ],
                    "antonyms": [
                        "moderne"
                    ],
                    "common_phrases": [
                        "arbres anciens"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "347b43a0-ba57-3ff4-aff7-1d7508b128fb",
                    "sense_definition": "Personne âgée, en particulier considérée comme sage ou expérimentée.",
                    "learner_level": "B2",
