                {
                    "sense_id": "c3ba8a27-758e-3a10-a074-a87e7948927f",
                    "sense_definition": "Avec correction et conformisme, mais sans audace ni originalité, en parlant d'un travail artistique ou littéraire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conformisme_artistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce premier roman est <w>sagement</w> composé mais il manque singulièrement de souffle créatif.",
                            "target_lang_translations": {
                                "en": "This debut novel is <w>correctly</w> constructed, but it strikingly lacks creative spark.",
                                "ru": "Этот дебютный роман выстроен <w>правильно</w>, но ему заметно не хватает творческого порыва.",
                                "de": "Dieser Erstlingsroman ist <w>korrekt</w> aufgebaut, doch es fehlt ihm auffallend an kreativem Schwung.",
                                "es": "Esta primera novela está <w>correctamente</w> construida, pero le falta notablemente chispa creativa.",
                                "zh": "这部处女作<w>中规中矩地</w>写成，但尤其缺乏创作上的灵气。"
                            }
                        },
                        {
                            "text": "Le jeune peintre applique très <w>sagement</w> les règles sans jamais prendre de risque.",
                            "target_lang_translations": {
                                "en": "The young painter applies the rules very <w>correctly</w>, never taking any risks.",
                                "ru": "Молодой художник очень <w>правильно</w> следует всем правилам и никогда не идёт на риск.",
                                "de": "Der junge Maler wendet die Regeln sehr <w>korrekt</w> an, ohne jemals ein Risiko einzugehen.",
                                "es": "El joven pintor aplica muy <w>correctamente</w> las reglas, sin correr nunca riesgos.",
                                "zh": "这位年轻画家<w>循规蹈矩地</w>运用绘画规则，从不冒任何风险。"
                            }
                        }
