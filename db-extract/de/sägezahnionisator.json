                "senses": [
                    {
                        "sense_id": "60f72577-ed60-3007-955a-da753c0913bf",
                        "entry_id": "aae9c1d1-d1c9-3bad-9d83-9a074f097562",
                        "glosses": [
                            "metallischer Ionisationsdraht in Sägezahnform, mit symmetrisch oder asymmetrisch angeordneten Zähnen zur Ionisation der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5eeb479-706c-408a-82d3-35e2e6198f1e",
                                "sense_id": "60f72577-ed60-3007-955a-da753c0913bf",
                                "text": "„Leider werden Elektrofilter, im übertragenen Sinne, derzeit mit einer vergleichbaren Argumentation vertrieben (und dabei wird meist noch verschwiegen, dass Sägezahnionisatoren, wie oben beschrieben, konstruktionsbedingt von Anfang an einen ohnehin schlechteren Abscheidegrad haben).“"
                            },
                            {
                                "example_id": "c73236b5-a23d-4309-8c1e-9065396822df",
                                "sense_id": "60f72577-ed60-3007-955a-da753c0913bf",
                                "text": "„Bis zu +13% mehr Abscheideleistung als mit üblichen Verfahren und bis zu +25% höherer Abscheidegrad als mit Sägezahnionisatoren.“"
                            },
                            {
                                "example_id": "a5341e8a-84bb-40f2-8958-16bca969cc55",
                                "sense_id": "60f72577-ed60-3007-955a-da753c0913bf",
                                "text": "„Derzeit werden einfach Drähte aus Speziallegierungen oder so genannte Sägezahn-Ionisatoren als Ionisationselemente eingesetzt.“"
                            },
                            {
                                "example_id": "42120444-ea99-4f0b-bed8-d15355b482eb",
                                "sense_id": "60f72577-ed60-3007-955a-da753c0913bf",
                                "text": "„Elektrofilter unterscheiden sich in Form und Größe der Filtergasse (Rohre, Platten), der Form der Sprühelektroden (Helix, Draht, Dornelektrode, Sägezahnionisator, Wellenionisator usw.), der Betriebsspannung (Gleichspannung, Wechselspannung, gepulste Gleichspannung, pulsüberlagerte Gleichspannung) und der Art der Reinigung (Klopfen, Spülen, Kassettenwechsel).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
