                ],
                "senses": [
                    {
                        "sense_id": "4e91242f-a5f1-3e71-862b-01f36b23850e",
                        "entry_id": "80063fe8-d565-3817-965f-a04a7cb8a6f2",
                        "glosses": [
                            "längliche Kunststoffröhre zum Hindurchleiten von Flüssigkeiten oder Gasen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de1f9d18-d9af-48e7-8f70-36d3ff322184",
                                "sense_id": "4e91242f-a5f1-3e71-862b-01f36b23850e",
                                "text": "„Durch den Einsatz von Kunststoffrohrleitungen sind diese Schäden im industriellen Rohrleitungsbau vermeidbar.“"
                            },
                            {
                                "example_id": "dca36968-1d4f-4f66-b329-e21af841aaa6",
                                "sense_id": "4e91242f-a5f1-3e71-862b-01f36b23850e",
                                "text": "„Für Kunststoffrohrleitungen aus Polybuten (PB) -Polypropylen (PP-R), vernetztes Polyethylen (PE-X), hoher Dichte und vernetztes Polyethylen (PE-X-MD), mittlerer Dichte legt DIN 4726 Anforderungen fest.“"
                            },
                            {
                                "example_id": "b062700d-440b-4187-95a0-4ebf97a5ca98",
                                "sense_id": "4e91242f-a5f1-3e71-862b-01f36b23850e",
                                "text": "„Im Rahmen des Projektes „Naturalhy“ und für einen namhaften Hersteller von Kunststoffrohrleitungen wurden Untersuchungen an Rohren aus PE 100 und PEX durchgeführt.“"
                            },
                            {
                                "example_id": "9defff94-903a-4a21-ae69-813c4721b877",
                                "sense_id": "4e91242f-a5f1-3e71-862b-01f36b23850e",
                                "text": "„Wir haben uns auf den Einsatz qualitativ hochwertiger Kunststoffrohrleitungen in der chemischen und petrochemischen Industrie spezialisiert.“"
                            },
                            {
                                "example_id": "14f3e284-4e8e-4b83-b3e1-fe12befe78dd",
                                "sense_id": "4e91242f-a5f1-3e71-862b-01f36b23850e",
                                "text": "„Neben Kunststoffrohrleitungen bieten wir ein umfangreiches Sortiment an Fittings, Hand- und Automatikarmaturen sowie Rohrzubehör und Sonderformteile für den Bereich Lüftungs- und Klimatechnik.“"
                            },
                            {
                                "example_id": "fefbd052-9932-4d86-8b61-a68d6aad9fdc",
                                "sense_id": "4e91242f-a5f1-3e71-862b-01f36b23850e",
                                "text": "„Parker ist führender Hersteller von Kunststoffrohrleitungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
