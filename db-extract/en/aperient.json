                        "glosses": [
                            "Having a gentle laxative effect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7caefdd5-539d-47fb-8043-197bdb0f8978",
                                "sense_id": "d6fa0404-eb2b-3c7c-aa90-a520ca15a335",
                                "text": "[T]ouching the much vexed question of stimulants he relished a glass of choice old wine in season as both nourishing and bloodmaking and possessing aperient virtues (notably a good burgundy which he was a staunch believer in) […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "61682fcf-b38f-3d5d-b1ac-4e45df7bc79e",
                        "entry_id": "a4d7824d-5dbd-37f3-8074-8b0eb43bf11c",
                        "glosses": [
                            "Serving to open or reveal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d958fa88-0e9c-41dc-a8db-2be9565b8973",
                                "sense_id": "61682fcf-b38f-3d5d-b1ac-4e45df7bc79e",
                                "text": "Is it really more knowledge we want, or more understanding? Are we in fact clavigerous and fail to realize the aperient properties of that which is in our hand?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
