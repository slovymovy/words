                        "target_lang_word": "Kaisersemmel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaisersemmel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "622ffb6e-ba15-3e2f-9a71-578e5d596aac",
                                        "entry_id": "019efb10-13fa-38b0-aa46-282d00caea3b",
                                        "glosses": [
                                            "krustenreiches, knuspriges, sternförmig eingeschnittenes Weißgebäck ursprünglich aus Österreich"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d170edd3-55ad-4300-9df8-1e41a679ab21",
                                                "sense_id": "622ffb6e-ba15-3e2f-9a71-578e5d596aac",
                                                "text": "„Nun da es um sie stiller geworden ist und ihr Mann auch noch \"kracht wie eine Kaisersemmel\", müssen die beiden vom nicht unbeträchtlichen Ersparten leben.“"
                                            },
                                            {
                                                "example_id": "970c2526-9c37-4a34-a154-6ab2a8467682",
                                                "sense_id": "622ffb6e-ba15-3e2f-9a71-578e5d596aac",
                                                "text": "„Schon Kaiser Franz Josef erfreute sich an der handgewirkten Kaisersemmel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
