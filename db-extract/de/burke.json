                ],
                "senses": [
                    {
                        "sense_id": "2b5f970a-e7e3-3711-a400-93c9c9555af5",
                        "entry_id": "67dd99c6-abf7-30f0-8f53-adb5664d1e6d",
                        "glosses": [
                            "Burka (kaukasischer Mantel oder Schleier)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f05175-42c0-4347-9aec-0488baee306f",
                                "sense_id": "2b5f970a-e7e3-3711-a400-93c9c9555af5",
                                "text": "Von anderen Gebräuchen sei noch angeführt, daß die Osseten oftmals dem Verstorbenen ein Pferd, eine Burke (Filzrotunde) und andere Reiterutensilien weihen und das Pferd dreimal um das Grab herumführen."
                            },
                            {
                                "example_id": "752ff1ce-8643-46eb-a3ad-b71cc865bc68",
                                "sense_id": "2b5f970a-e7e3-3711-a400-93c9c9555af5",
                                "text": "Man bringt sie im geschlossenen Sarg, in eine Burke oder einen Teppich gewickelt, zur Begräbnisstätte; dort werden sie herausgenommen und in die Erde versenkt ; nur sehr wohlhabende Leute werden mit dem Sarge begraben."
                            },
                            {
                                "example_id": "169ff9d1-33e6-45f9-be7c-db9265ef4a0a",
                                "sense_id": "2b5f970a-e7e3-3711-a400-93c9c9555af5",
                                "text": "An einem der Tage brachten auch zwei Kachier einen Menschen in grauen Beinkleidern und nur mit einer Burke versehen , und wir alle entsetzten uns über das Wilde in seinem ganzen Thun."
                            },
                            {
                                "example_id": "a8e9ef30-e9e7-4785-89da-d36bf6dcc596",
                                "sense_id": "2b5f970a-e7e3-3711-a400-93c9c9555af5",
                                "text": "Wir schliefen unter freiem Himmel auf einer Burke (Filzmantel), mit der zweiten uns zudeckend."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
