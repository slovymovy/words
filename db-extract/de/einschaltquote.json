                "senses": [
                    {
                        "sense_id": "614c9a42-2abf-3b71-9592-5b9198b8fee0",
                        "entry_id": "b605de62-ae72-3132-9f0e-c829587a9d59",
                        "glosses": [
                            "Anteil der Fernsehzuschauer oder Radiohörer, die eine bestimmte Sendung verfolgen"
                        ],
                        "tags": [
                            "Fernsehen",
                            "Radio"
                        ],
                        "examples": [
                            {
                                "example_id": "2e73feb5-4162-4513-9db6-9d4c99413948",
                                "sense_id": "614c9a42-2abf-3b71-9592-5b9198b8fee0",
                                "text": "Die neue Sendung hatte eine sehr schlechte Einschaltquote und wird vermutlich abgesetzt."
                            },
                            {
                                "example_id": "0d4b3f21-6816-4912-b28c-767460db738f",
                                "sense_id": "614c9a42-2abf-3b71-9592-5b9198b8fee0",
                                "text": "„Dass der Zweiteiler, der die Flucht einer fiktiven ostpreußischen Gräfin in den Mittelpunkt stellte, dem Sender die höchsten Einschaltquoten seit vielen Jahren bescherte, dürfte auch daran gelegen haben, dass laut Lexikon des Internationalen Films ein »deutsches Tabuthema« aufgegriffen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
