                    {
                        "sense_id": "0d78ff11-99f8-310b-9da8-8fa56b90f5f6",
                        "entry_id": "4a0ab4b3-5d86-32f1-b24c-c91c5d8b3f16",
                        "glosses": [
                            "A guidance officer."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1c8ce653-ce40-4cb9-b4ae-c51c7cc52772",
                                "sense_id": "0d78ff11-99f8-310b-9da8-8fa56b90f5f6",
                                "text": "While the Black Team continued to monitor current conditions, off-console retrofire officers (RETROs), flight dynamics officers (FIDOs), and guidance officers (GUIDOs) were at work calculating the exact short-burn maneuver […]"
                            },
                            {
                                "example_id": "aec1233b-768e-4d36-bc34-c034c6d2ede0",
                                "sense_id": "0d78ff11-99f8-310b-9da8-8fa56b90f5f6",
                                "text": "There were to be four Guidance Officers for Apollo 1. Two “Guidos” were to be on the console for launch phase and two for orbit phase."
                            }
                        ]
                    }
                ],
