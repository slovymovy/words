                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9e6e88b-25a1-41e1-be98-edf52d4ee209",
                        "source_entry_id": "63145426-7e34-33e5-8202-eb8fc98ecb89",
                        "source_sense_id": "9a9e300d-dc60-3588-bfce-f01d58f795d5",
                        "target_lang_word": "sartorial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sartorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da66d013-b6c0-345f-9418-9c01510fbdc9",
                                        "entry_id": "32639c8f-a662-3648-8c15-baf152dd53a5",
                                        "glosses": [
                                            "Of or relating to the tailoring of clothing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e2bf000-f3e2-4348-9677-fbb716f95ccb",
                                                "sense_id": "da66d013-b6c0-345f-9418-9c01510fbdc9",
                                                "text": "His sartorial rebellions were slight: he wore jeans, for example, when giving tutorials."
                                            },
                                            {
                                                "example_id": "86cbfd67-0144-470a-9c37-4fe6e7f58afb",
                                                "sense_id": "da66d013-b6c0-345f-9418-9c01510fbdc9",
                                                "text": "Suits are full of joy. They are the sartorial equivalent of a baby’s smile."
                                            },
                                            {
                                                "example_id": "a1f885c4-7465-4fea-a8d7-711411bebdab",
                                                "sense_id": "da66d013-b6c0-345f-9418-9c01510fbdc9",
                                                "text": "The occasion, back then, was his decision to wear a hoodie with a suit jacket while on the air, which proved such an unexpected sartorial choice for an anchorman that it went viral, creating its own mini-news cycle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf06d4b6-0fc6-365e-a54e-98779e24b482",
                                        "entry_id": "32639c8f-a662-3648-8c15-baf152dd53a5",
                                        "glosses": [
                                            "Of or relating to the quality of dress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30069af2-334a-451d-b963-eafc6de03218",
                                                "sense_id": "bf06d4b6-0fc6-365e-a54e-98779e24b482",
                                                "text": "In his smart suit Jacob was by far the most sartorial of our party."
                                            },
                                            {
                                                "example_id": "6fdf6fe9-2a15-4fc0-a9c8-3336944994cf",
                                                "sense_id": "bf06d4b6-0fc6-365e-a54e-98779e24b482",
                                                "text": "The UPI report noted that demonstrators sported \"neon hairdos and tight leather clothes\" as they blocked streets and disrupted traffic in a \"Stop the City\" demonstration. Sartorial descriptions were the order of the day in the UPI dispatch, as it went on to describe a protesting teenager with \"pink hair and 11 earrings\" and \"youths with rainbow hairdos.\""
                                            },
                                            {
                                                "example_id": "6487e271-119b-4344-85b9-ee3cdea4ed42",
                                                "sense_id": "bf06d4b6-0fc6-365e-a54e-98779e24b482",
                                                "text": "He was just a college instructor at the time, long before he had written his book and long before his sartorial conversion. The pockets of his sports coat bulged from having had fists thrust into them too long."
                                            },
                                            {
                                                "example_id": "f277babd-aaca-420d-accc-bdcb2d194322",
                                                "sense_id": "bf06d4b6-0fc6-365e-a54e-98779e24b482",
                                                "text": "As a fashion editor, I pay obsessive attention to my appearance. Even when I pretend to look insouciant, each look has been painfully considered. The right earrings, coordinating shoes, the careful symmetry of a well-balanced look — these are things that please me. The gym has crushed my sartorial ambitions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d50ba50d-11c0-389b-b3fe-49a73f33ccf2",
                                        "entry_id": "32639c8f-a662-3648-8c15-baf152dd53a5",
                                        "glosses": [
                                            "Of or relating to the sartorius muscle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
