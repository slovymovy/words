                                        "sense_id": "416dd7ef-ac7b-35be-a953-fc98ad55bb13",
                                        "entry_id": "9e19abb2-1b81-382d-b34f-b2dc70985b11",
                                        "glosses": [
                                            "Barbare."
                                        ],
