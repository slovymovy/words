                        "entry_id": "a7e43c6f-5f53-3b64-8bf4-282e8f665960",
                        "glosses": [
                            "Illibéralisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8fd5a44-7349-49a9-bf8f-73fc852ad0c1",
                                "sense_id": "2b492fbb-ac69-3881-9f26-5b4481b0d496",
                                "text": "There may be a tyranny of custom, a tyranny of opinion, even a tyranny of circumstance, as real as any tyranny of government and more pervasive. Nor does liberty rest on the self-assertion of the individual. There is scope abundant for Liberalism and illiberalism in personal conduct."
                            }
                        ]
                    }
