                "senses": [
                    {
                        "sense_id": "55bea892-4496-31fc-8f87-9435ebce3156",
                        "entry_id": "e2979768-021b-3599-9480-0297998e5fc8",
                        "glosses": [
                            "verharde weg waarvan het wegdek bestaat uit asfalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f70138be-af43-4e19-bba0-4f3bba4c8a13",
                                "sense_id": "55bea892-4496-31fc-8f87-9435ebce3156",
                                "text": "Op amper een uurtje van de Nederlandse grens kom je in een compleet andere wereld. Waar kasseien soepel overgaan in slingerende asfaltwegen en schonkige boerenpaarden vol verwondering blikken naar de langstrekkende, felgekleurde fietsers. Rondom de traag stromende Leie en de kolkende Schelde wedijveren bossen, heuvels en verstilde dorpen om de prijs voor het mooiste stilleven."
                            },
                            {
                                "example_id": "12c6131f-6777-4696-b655-891bc4aca7eb",
                                "sense_id": "55bea892-4496-31fc-8f87-9435ebce3156",
                                "text": "Je kunt de aangelegde asfaltweg volgen, maar ook paden pakken de bossen in, die aan weerszijden van de kloof voor een mooi groen spektakel zorgen."
                            }
                        ]
                    }
                ],
