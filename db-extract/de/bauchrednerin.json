                "senses": [
                    {
                        "sense_id": "b7798516-e667-3711-a1ab-07cfa42a1bb4",
                        "entry_id": "0a0e5968-d8f6-3d44-810c-f0ca9cfd56b7",
                        "glosses": [
                            "weibliche Person, die ohne sichtliche Mundbewegungen spricht, meist so, dass es aussieht, als spreche eine von ihr bewegte Puppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92e20c18-710a-41f4-9690-2ca716c3eaa9",
                                "sense_id": "b7798516-e667-3711-a1ab-07cfa42a1bb4",
                                "text": "Eine Bauchrednerin trat auf und begeisterte die Menge mit ihrer sprechenden Handpuppe."
                            },
                            {
                                "example_id": "29db6a00-620f-49d2-9b3c-fa795bead396",
                                "sense_id": "b7798516-e667-3711-a1ab-07cfa42a1bb4",
                                "text": "„Und damit diesmal nicht genug: Als Bauchrednerin diskutiert sie auch mit ihrer meist ungehaltenen Berliner Katze Ingeborg (\"Eens sack ich dir, lang schau ick ma dit nich mer an\") – Cleopatra als herrische, manchmal konfuse, schon ein wenig alt gewordene Berlinerin, und dennoch voller Liebessehnsucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
