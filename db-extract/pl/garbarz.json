                        "source_sense_id": "59b881eb-dc8f-3981-b041-6f041c02a679",
                        "target_lang_word": "tanner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tanner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4a96522-cc01-38c9-a55e-a1bf2037c1fd",
                                        "entry_id": "065511ad-f23d-3c3d-85a9-891bd837c91a",
                                        "glosses": [
                                            "A person whose occupation is to tan hides, or convert them into leather by the use of tan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9186d881-c9c4-307d-9a33-03c77ecd672b",
                                        "entry_id": "065511ad-f23d-3c3d-85a9-891bd837c91a",
                                        "glosses": [
                                            "A person who applies a tan (especially a spray tan) on someone's skin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698b518d-e2f3-4075-8402-9d8f67538ed0",
                                                "sense_id": "9186d881-c9c4-307d-9a33-03c77ecd672b",
                                                "text": "Eighty-one-year-old [Martha] Stewart says that a spray tan before her debut Sports Illustrated swimsuit cover boosted her confidence. Ryan Gosling, who plays Ken in Barbie, had a personal tanner on set."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec8824e3-5b87-3067-9dc8-8cad2f4d58fc",
                                        "entry_id": "065511ad-f23d-3c3d-85a9-891bd837c91a",
                                        "glosses": [
                                            "A long-horned beetle of species Prionus coriarius."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tanner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0dfc0a6-5c4f-35a1-adfd-63308a5e69a4",
                                        "entry_id": "85834880-8ec2-3ec8-b754-538639a8843f",
                                        "glosses": [
                                            "A former British coin worth six old pence."
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdda60fa-c5ac-4373-b7da-cabe93e9ac97",
                                                "sense_id": "f0dfc0a6-5c4f-35a1-adfd-63308a5e69a4",
                                                "text": "[A]s you are so flash of your money, though you say you are poor, you may give me a tanner to buy a little baccy with; […]"
                                            },
                                            {
                                                "example_id": "bfcc5659-21c6-4906-ad2a-54d1dc50cfd5",
                                                "sense_id": "f0dfc0a6-5c4f-35a1-adfd-63308a5e69a4",
                                                "text": "They'd say hello, maybe slip you a tanner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tanner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c481b7f9-e0f6-33b5-b362-58fbf7e178ef",
                                        "entry_id": "e3df5d1f-1513-3b5f-9cb6-f1882039be8d",
                                        "glosses": [
                                            "Any of several spider crabs of the genus Chionoecetes, especially Chionoecetes bairdi and Chionoecetes opilio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1a35271-2b45-4cb5-bc6f-61ae4c690045",
                                                "sense_id": "c481b7f9-e0f6-33b5-b362-58fbf7e178ef",
                                                "text": "Near-synonym: snow crab"
                                            },
                                            {
                                                "example_id": "4bf19cc0-c15b-4e2c-bd0b-32b5338b9dfa",
                                                "sense_id": "c481b7f9-e0f6-33b5-b362-58fbf7e178ef",
                                                "text": "The new plant is assumed to result in additions to the resident fleet during the tanner and dungeness crab seasons and function as a port of call for an increased number of trollers, resulting in more local seafood processing."
                                            },
                                            {
                                                "example_id": "2cb0d030-1f05-433a-aab1-60aa248c7e47",
                                                "sense_id": "c481b7f9-e0f6-33b5-b362-58fbf7e178ef",
                                                "text": "There were a few Dungeness, a couple of blue kings and one small and indignant squid, but mostly the pot was filled with tanners, Chionoecetes bairdi & Chionoecetes opilio."
                                            },
                                            {
                                                "example_id": "451d3109-f44a-4167-9fb8-7d219942c93b",
                                                "sense_id": "c481b7f9-e0f6-33b5-b362-58fbf7e178ef",
                                                "text": "We had come here to catch tanner crab, which the Japanese were buying up as fast as we could catch them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tanner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b474df8-81f9-330f-ae7c-1ab7ccf60c37",
                                        "entry_id": "ae970820-9e67-31ab-a1ce-100ce64282e6",
                                        "glosses": [
                                            "comparative form of tan: more tan"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20335de9-a4b4-4bc6-91b7-eff4a972d895",
                                                "sense_id": "8b474df8-81f9-330f-ae7c-1ab7ccf60c37",
                                                "text": "He was a lot tanner than I remembered, or maybe he just looked darker because of the change of light."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "676533ba-6f25-4594-b013-5c3894a0963b",
                        "source_entry_id": "8e1969d4-625f-3904-83f3-11f650b8418a",
                        "source_sense_id": "59b881eb-dc8f-3981-b041-6f041c02a679",
                        "target_lang_word": "Gerber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d30790ce-0732-3693-8ad3-6ce2cbf321ba",
                                        "entry_id": "fbe89584-c9d0-32c6-9032-e7f4de2d2175",
                                        "glosses": [
                                            "Person, die beruflich gerbt, Tierhäute zu Leder verarbeitet"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "035cccba-8772-4fd3-9ec2-e8647b60a87f",
                                                "sense_id": "d30790ce-0732-3693-8ad3-6ce2cbf321ba",
                                                "text": "Obwohl der Gerber tagtäglich Felle gerbt, wurde ihm abends nach dem Kneipenbesuch auch das seinige gegerbt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gerber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "504080a1-cb02-3734-9b6a-b01f4a769e98",
                                        "entry_id": "3370b3a9-d3a8-3586-bad9-07cef2ea757b",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28afdae0-4b0a-440e-8a5a-10d6ef90ba37",
                                                "sense_id": "504080a1-cb02-3734-9b6a-b01f4a769e98",
                                                "text": "Frau Gerber ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "68279b38-64cd-4b6b-8dc1-6a257b8a3c55",
                                                "sense_id": "504080a1-cb02-3734-9b6a-b01f4a769e98",
                                                "text": "Herr Gerber wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "47927fd2-f699-4115-b375-58a097483d72",
                                                "sense_id": "504080a1-cb02-3734-9b6a-b01f4a769e98",
                                                "text": "Die Gerbers fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "cab06cb5-2f70-453e-9671-e95f5cdfbf55",
                                                "sense_id": "504080a1-cb02-3734-9b6a-b01f4a769e98",
                                                "text": "Der Gerber trägt nie die Pullover, die die Gerber ihm strickt."
                                            },
                                            {
                                                "example_id": "290cfa67-a408-4092-8ece-2e5f9db79d42",
                                                "sense_id": "504080a1-cb02-3734-9b6a-b01f4a769e98",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gerber kommt, geht der Herr Gerber.“"
                                            },
                                            {
                                                "example_id": "23d6fe37-757f-4f34-89d5-f6487c8c5b3d",
                                                "sense_id": "504080a1-cb02-3734-9b6a-b01f4a769e98",
                                                "text": "Gerber kommt und geht."
                                            },
                                            {
                                                "example_id": "c052a856-979c-49b8-9b83-d9c94d110874",
                                                "sense_id": "504080a1-cb02-3734-9b6a-b01f4a769e98",
                                                "text": "Gerbers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
