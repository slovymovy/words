                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e45865f4-86d0-312f-a726-f9f44105b070",
                                        "entry_id": "fbe2684c-8b60-364a-afc9-d3e2805218e0",
                                        "glosses": [
                                            "Sorte de vêtement de moine, ample et sans manches. Cuculle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f51fb6d7-f6ad-4455-8420-c2d67d344758",
                                                "sense_id": "e45865f4-86d0-312f-a726-f9f44105b070",
                                                "text": "Au premier rang et les plus inclinées sur le lit, on en remarquait quatre qu’à leur cagoule grise, sorte de soutane, on devinait attachées à quelque confrérie dévote."
                                            },
                                            {
                                                "example_id": "c99935e5-0fda-4e0b-abf3-b5a1b56f6fe0",
                                                "sense_id": "e45865f4-86d0-312f-a726-f9f44105b070",
                                                "text": "On enterra les morts avec magnificence, dans l’église d’un monastère à trois journées du château. Un moine en cagoule rabattue suivit le cortège, loin de tous les autres, sans que personne osât lui parler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93eb69f7-8105-3cf4-9be0-93838cc41fb2",
                                        "entry_id": "fbe2684c-8b60-364a-afc9-d3e2805218e0",
                                        "glosses": [
                                            "Capuchon percé d’ouvertures à la place des yeux et à celle de la bouche, ou au niveau du visage. Elle est destinée à protéger le visage (froid, flamme, projections, etc.) ou à préserver l’anonymat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a00dcfdb-0305-492a-9125-90e748a280c1",
                                                "sense_id": "93eb69f7-8105-3cf4-9be0-93838cc41fb2",
                                                "text": "Lumette, Léon et Lucie sont emmitouflés dans des manteaux sombres, mais sans gants ni cagoule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd1573be-0e10-367a-a9ac-a8527d92fb5f",
                                        "entry_id": "fbe2684c-8b60-364a-afc9-d3e2805218e0",
                                        "glosses": [
                                            "Sorte de capuchon pour couvrir entièrement la tête et en aveugler le porteur."
                                        ],
                                        "tags": [
                                            "Parfois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a1a40a3-4a9d-4ed7-a54d-7e6b469361a5",
                                                "sense_id": "bd1573be-0e10-367a-a9ac-a8527d92fb5f",
                                                "text": "Il avait enfin trouvé un semblant de sommeil lorsqu'il fut réveillé et embarqué de force par un groupe d'hommes qui le cagoulèrent et lui lièrent les mains. Lorsqu'il lui retirèrent sa cagoule, après un voyage dans un véhicule, il reconnut le conseiller, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20d5f60e-9dea-3da1-8521-facd98f7fe03",
                                        "entry_id": "fbe2684c-8b60-364a-afc9-d3e2805218e0",
                                        "glosses": [
                                            "Protection faciale utilisée pour la soudure."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": []
                                    }
                                ]
