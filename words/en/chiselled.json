    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "23741d21-05c6-3ab4-93cc-de6067634f02",
                    "sense_definition": "Having clean, sharp, and well-defined outlines, as if cut by a chisel; typically used to describe handsome facial features or a toned physique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defined_features",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor was famous for his <w>chiselled</w> jawline and athletic build.",
                            "target_lang_translations": {
                                "ru": "Актер был знаменит своей <w>точеной</w> линией челюсти и атлетическим телосложением."
                            }
                        },
                        {
                            "text": "He maintained a <w>chiselled</w> physique through years of dedicated weight training.",
                            "target_lang_translations": {
                                "ru": "Он поддерживал <w>рельефное</w> телосложение благодаря годам упорных тренировок с отягощениями."
                            }
                        }
                    ],
                    "synonyms": [
                        "sculpted",
                        "defined",
                        "sharp"
                    ],
                    "antonyms": [
                        "soft",
                        "flabby"
                    ],
                    "common_phrases": [
                        "chiselled jawline",
                        "chiselled features",
                        "chiselled physique"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий четкие, резкие и хорошо очерченные контуры, словно высеченный резцом; обычно используется для описания красивых черт лица или подтянутого телосложения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точеный",
                                "target_lang_sense_clarification": "о чертах лица или фигуре"
                            },
                            {
                                "target_lang_word": "рельефный",
                                "target_lang_sense_clarification": "о мускулатуре или телосложении"
                            },
                            {
                                "target_lang_word": "очерченный",
                                "target_lang_sense_clarification": "о контурах лица"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "62ba74d3-30bc-3dac-bd85-77c51e31f02d",
                    "sense_definition": "Simple past tense and past participle of <w>chisel</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sculptor carefully <w>chiselled</w> the marble until a beautiful figure emerged.",
                            "target_lang_translations": {
                                "ru": "Скульптор аккуратно <w>высекал</w> мрамор, пока не появилась прекрасная фигура."
                            }
                        },
                        {
                            "text": "He <w>chiselled</w> his name into the wooden bench as a lasting memory.",
                            "target_lang_translations": {
                                "ru": "Он <w>вырезал</w> свое имя на деревянной скамейке на долгую память."
                            }
                        }
                    ],
                    "synonyms": [
                        "carved",
                        "sculpted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола chisel (высекать, вырезать долотом)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высекал",
                                "target_lang_sense_clarification": "прошедшее время от высекать"
                            },
                            {
                                "target_lang_word": "вырезал",
                                "target_lang_sense_clarification": "прошедшее время от вырезать инструментом"
                            },
                            {
                                "target_lang_word": "высеченный",
                                "target_lang_sense_clarification": "причастие от высекать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
