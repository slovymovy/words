            {
                "entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                "word": "GIF",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ec3ddb50-0a19-4ccb-84be-6473174e2e7e",
                        "entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "GIFs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ae8810f-b1b6-38a0-9d77-53bf91b82695",
                        "entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                        "glosses": [
                            "A bitmap image in a particular format with support for multiple images per file or animations, and up to 256 distinct colors per frame, including a fully transparent color."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3a874da-6037-4e90-b5b6-a2f4b2a79f11",
                                "sense_id": "7ae8810f-b1b6-38a0-9d77-53bf91b82695",
                                "text": "I'll send you a GIF of the proposed logo."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a382862-2aab-3b56-9e64-59b8fbc55060",
                        "entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                        "glosses": [
                            "Any short video without audio, usually one which loops."
                        ],
                        "tags": [
                            "Internet",
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b0e54d92-c5c9-40d1-85e0-459aa5c85891",
                                "sense_id": "0a382862-2aab-3b56-9e64-59b8fbc55060",
                                "text": "Crying Dawson ruled the internet comment sections of the late ’00s and early ’10s. It’s “on the Mount Rushmore of GIFs,” says TV critic Sarah D. Bunting."
                            }
                        ]
                    },
                    {
                        "sense_id": "4292c973-4cac-3a88-8e4b-b7934735c6fb",
                        "entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                        "glosses": [
                            "Any short video, in a format directly supported by HTML5 (ie. GIF, MP4, WebM)"
                        ],
                        "tags": [
                            "Internet",
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0e9b45b-d11c-4c3d-bdee-4b5adba0b5ac",
                        "source_entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                        "source_sense_description": "short video without audio",
                        "target_lang_word": "Gif",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gif",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1924faa-d495-3302-8832-91293dbedb36",
                                        "entry_id": "ef3ea37d-1170-3f6f-9820-1054c42b7407",
                                        "glosses": [
                                            "Bild, Foto, Animation mit dem Dateiformat GIF"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cde1533-47e7-4323-a851-7ebb1a7e9082",
                                                "sense_id": "f1924faa-d495-3302-8832-91293dbedb36",
                                                "text": "„Der Erfolg des Gifs ist umso erstaunlicher, weil das Format eigentlich gar nicht so gut ins moderne Netz passt. Die Qualität ist oft lausig, die kurzen Clips sind pixelig und matt.“"
                                            },
                                            {
                                                "example_id": "2f2f9260-0158-4f1b-8b8d-6c8631253e6d",
                                                "sense_id": "f1924faa-d495-3302-8832-91293dbedb36",
                                                "text": "„Schließlich lassen sich solche Emotionen kaum besser beschreiben als mit einem Gif.“"
                                            },
                                            {
                                                "example_id": "fb9fe9ad-9a1f-4a17-b1ee-a783bbe0c054",
                                                "sense_id": "f1924faa-d495-3302-8832-91293dbedb36",
                                                "text": "„Wir verwenden Interpunktionszeichen, um ein Gefühl auszudrücken (niemand würde !!!!!!!!! als Gleichmut missverstehen), oder Bilder wie Gifs oder Emojis, um Stimmungen, Absichten, kleine Zusammenfassungen oder Kommentare zu unseren Worten zu transportieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
