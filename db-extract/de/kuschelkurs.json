                ],
                "senses": [
                    {
                        "sense_id": "60703f06-bcf9-3aa2-b7fb-9f11eb8effce",
                        "entry_id": "6c15d1d8-c75d-339d-bcad-15205340897c",
                        "glosses": [
                            "Annäherung an einen fremden Standpunkt, kritikloser Umgang mit dem Gegenüber"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ebe79be5-cb75-4cd5-96c8-38d0113db883",
                                "sense_id": "60703f06-bcf9-3aa2-b7fb-9f11eb8effce",
                                "text": "„Aus Angst, ein paar Saisonkarten weniger zu verkaufen, wird ein Kuschelkurs gefahren.“"
                            },
                            {
                                "example_id": "90a31c95-c961-43b6-aa3f-6bb8a34399ea",
                                "sense_id": "60703f06-bcf9-3aa2-b7fb-9f11eb8effce",
                                "text": "„Nach dem Erfolg der Partei Vox in Andalusien gehen die etablierten Parteien mit den Rechtsextremen auf Kuschelkurs.“"
                            },
                            {
                                "example_id": "e308433f-0c1c-42b7-bcc4-1c7aec25434c",
                                "sense_id": "60703f06-bcf9-3aa2-b7fb-9f11eb8effce",
                                "text": "„Der ehemalige Chef der US-Army in Europa, General \"Ben\" Hodges, kritisiert Donald Trumps Kuschelkurs gegenüber Wladimir Putin.“"
                            },
                            {
                                "example_id": "8bb7e13a-a279-40a3-978b-86e30c301a3c",
                                "sense_id": "60703f06-bcf9-3aa2-b7fb-9f11eb8effce",
                                "text": "„Diese Pläne kritisiert die Verbraucherorganisation Foodwatch und hält Klöckner [Anm.: Bundesministerin für Ernährung und Landwirtschaft] einen \"Kuschelkurs\" gegenüber der [Anm.: Nahrungsmittel-]Branche vor.“"
                            },
                            {
                                "example_id": "29876c27-88c0-4d55-93a6-768e394b61ca",
                                "sense_id": "60703f06-bcf9-3aa2-b7fb-9f11eb8effce",
                                "text": "[Schlagzeile:] „China und Japan auf vorsichtigem Kuschelkurs – Die beiden asiatischen Länder haben nach acht Jahren ihren Wirtschaftsdialog wieder aufgenommen.“"
                            },
                            {
                                "example_id": "34c10292-6f3f-41dc-bffb-1de72c6f7982",
                                "sense_id": "60703f06-bcf9-3aa2-b7fb-9f11eb8effce",
                                "text": "„Uber verspricht Tausende Jobs in Europa – Bislang war Travis Kalanick bekannt für seine Verbalattacken und sein konfrontatives Auftreten. Doch nun geht der Uber-Chef ganz überraschend auf Kuschelkurs und macht der Politik ein Angebot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
