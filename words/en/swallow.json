{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bfe776b2-859c-3770-887b-ad4611735e8b",
                    "sense_definition": "To cause food, drink, or other substances to pass from the mouth into the stomach through the throat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ingest_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a sip of water to help him <w>swallow</w> the pill.",
                            "target_lang_translations": {
                                "ru": "Он сделал глоток воды, чтобы помочь себе <w>проглотить</w> таблетку.",
                                "zh": "他喝了一口水，好让自己把药<w>吞</w>下去。"
                            }
                        },
                        {
                            "text": "The baby is learning how to chew and <w>swallow</w> solid food.",
                            "target_lang_translations": {
                                "ru": "Ребенок учится жевать и <w>глотать</w> твердую пищу.",
                                "zh": "婴儿正在学习如何咀嚼和<w>咽下</w>固体食物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gulp"
                    ],
                    "common_phrases": [
                        "swallow food",
                        "swallow a pill",
                        "chew and swallow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять пищу, питье или другие вещества проходить изо рта в желудок через горло.",
                        "zh": "指食物、饮料或其他物质通过喉咙从口腔进入胃部的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глотать",
                                "target_lang_sense_clarification": "принимать пищу или жидкость"
                            },
                            {
                                "target_lang_word": "проглотить",
                                "target_lang_sense_clarification": "совершить глоток (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吞",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "咽",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcf14b74-0f7a-30b4-849f-af8341e314ec",
                    "sense_definition": "To perform the muscular action of passing something down the throat, often done without food as a reaction to nervousness or emotion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ingest_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>swallowed</w> hard before delivering the bad news to the team.",
                            "target_lang_translations": {
                                "ru": "Она с трудом <w>сглотнула</w>, прежде чем сообщить команде плохие новости.",
                                "zh": "在向团队宣布坏消息之前，她艰难地<w>咽了口水</w>。"
                            }
                        },
                        {
                            "text": "His throat was so dry that it was painful to <w>swallow</w>.",
                            "target_lang_translations": {
                                "ru": "У него так пересохло в горле, что было больно <w>глотать</w>.",
                                "zh": "他的喉咙太干了，以至于<w>吞咽</w>时感到疼痛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gulp"
                    ],
                    "common_phrases": [
                        "swallow hard",
                        "swallow nervously"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать глотательное движение мышцами горла, часто без пищи, как реакция на нервозность или эмоции.",
                        "zh": "指喉部肌肉的吞咽动作，常因紧张或情绪波动而发生，不一定伴随进食。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сглотнуть",
                                "target_lang_sense_clarification": "сделать глотательное движение"
                            },
                            {
                                "target_lang_word": "глотать",
                                "target_lang_sense_clarification": "физическое действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咽口水",
                                "target_lang_sense_clarification": "因紧张等原因做的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9fa84d8-0e62-3e56-8862-54379881f88b",
                    "sense_definition": "To take something in so that it disappears completely; to envelop or destroy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "envelop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat was quickly <w>swallowed</w> by the stormy waves.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка была быстро <w>поглощена</w> штормовыми волнами.",
                                "zh": "小船很快就被风暴中的巨浪<w>吞没</w>了。"
                            }
                        },
                        {
                            "text": "Darkness seemed to <w>swallow</w> the forest as the sun went down.",
                            "target_lang_translations": {
                                "ru": "Казалось, тьма <w>поглотила</w> лес, когда солнце село.",
                                "zh": "太阳落山时，黑暗似乎<w>吞噬</w>了整片森林。"
                            }
                        }
                    ],
                    "synonyms": [
                        "engulf",
                        "absorb",
                        "swallow up",
                        "consume"
                    ],
                    "common_phrases": [
                        "swallowed by the sea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Захватывать что-либо так, что оно полностью исчезает; окутывать или уничтожать.",
                        "zh": "指某物被完全吞没、覆盖或摧毁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поглощать",
                                "target_lang_sense_clarification": "уничтожать или скрывать"
                            },
                            {
                                "target_lang_word": "поглотить",
                                "target_lang_sense_clarification": "полностью захватить (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吞没",
                                "target_lang_sense_clarification": "完全覆盖或淹没"
                            },
                            {
                                "target_lang_word": "吞噬",
                                "target_lang_sense_clarification": "毁灭性地占据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f2204d8-e45d-3c2a-9358-04752ba79aca",
                    "sense_definition": "To accept or believe something easily or without questioning, often referring to lies or excuses.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "accept_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot believe he actually <w>swallowed</w> that ridiculous story.",
                            "target_lang_translations": {
                                "ru": "Я не могу поверить, что он действительно <w>проглотил</w> эту нелепую историю.",
                                "zh": "我真不敢相信他竟然<w>轻信</w>了那个荒谬的故事。"
                            }
                        },
                        {
                            "text": "The public is not ready to <w>swallow</w> such a vague explanation.",
                            "target_lang_translations": {
                                "ru": "Публика не готова <w>проглотить</w> такое расплывчатое объяснение.",
                                "zh": "公众还没准备好<w>接受</w>这种含糊其辞的解释。"
                            }
                        }
                    ],
                    "synonyms": [
                        "buy",
                        "accept",
                        "believe"
                    ],
                    "common_phrases": [
                        "swallow a lie",
                        "hard to swallow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко принимать или верить чему-либо без вопросов, часто относящееся ко лжи или оправданиям.",
                        "zh": "指轻易地相信或接受某事，通常指谎言或借口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проглотить",
                                "target_lang_sense_clarification": "поверить лжи (разг.)"
                            },
                            {
                                "target_lang_word": "поверить",
                                "target_lang_sense_clarification": "принять на веру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻信",
                                "target_lang_sense_clarification": "轻易相信"
                            },
                            {
                                "target_lang_word": "照单全收",
                                "target_lang_sense_clarification": "毫无疑问地接受"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "138f2dc0-8574-317b-8756-709c5172cfe9",
                    "sense_definition": "To tolerate or endure something unpleasant, such as an insult or pride, without complaining or retaliating.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "accept_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>swallow</w> her pride and ask her rival for assistance.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>усмирить</w> свою гордость и попросить соперницу о помощи.",
                                "zh": "她不得不<w>忍受</w>自尊心的受挫，向竞争对手寻求帮助。"
                            }
                        },
                        {
                            "text": "It was difficult to <w>swallow</w> the insults, but he remained calm.",
                            "target_lang_translations": {
                                "ru": "Было трудно <w>проглотить</w> оскорбления, но он оставался спокоен.",
                                "zh": "要<w>咽下</w>这些侮辱很难，但他保持了冷静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stomach",
                        "endure",
                        "tolerate",
                        "bear"
                    ],
                    "common_phrases": [
                        "swallow one's pride",
                        "swallow an insult"
                    ],
                    "target_lang_definitions": {
                        "ru": "Терпеть или выносить что-то неприятное, например оскорбление или ущемление гордости, без жалоб.",
                        "zh": "指忍受或克制不愉快的事物，如侮辱或自尊心，而不抱怨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проглотить",
                                "target_lang_sense_clarification": "стерпеть обиду (разг.)"
                            },
                            {
                                "target_lang_word": "стерпеть",
                                "target_lang_sense_clarification": "вынести"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忍受",
                                "target_lang_sense_clarification": "克制情绪"
                            },
                            {
                                "target_lang_word": "咽下",
                                "target_lang_sense_clarification": "比喻忍气吞声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5d61334-23f9-392b-bbff-ed7b6643dc36",
                    "sense_definition": "To take back or recant something one has said.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "retract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was forced to <w>swallow</w> his words when the truth finally came out.",
                            "target_lang_translations": {
                                "ru": "Он был вынужден <w>взять назад</w> свои слова, когда правда наконец открылась.",
                                "zh": "当真相最终大白时，他被迫<w>收回</w>了自己说过的话。"
                            }
                        },
                        {
                            "text": "After the prediction failed, the expert had to <w>swallow</w> his earlier claims.",
                            "target_lang_translations": {
                                "ru": "После того как прогноз не сбылся, эксперту пришлось <w>отказаться</w> от своих прежних заявлений.",
                                "zh": "预测失败后，专家不得不<w>收回</w>他早先的断言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retract",
                        "take back",
                        "eat one's words"
                    ],
                    "common_phrases": [
                        "swallow one's words"
                    ],
                    "target_lang_definitions": {
                        "ru": "Брать свои слова обратно; отказываться от сказанного.",
                        "zh": "指收回或撤销自己说过的话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взять назад",
                                "target_lang_sense_clarification": "отказаться от слов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收回",
                                "target_lang_sense_clarification": "撤销言论"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6fc232f-a9b4-3124-9b3d-184816d29d72",
                    "sense_definition": "A small, migratory bird with long, pointed wings and a forked tail, known for its swift flight.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>swallow</w> swooped down to catch an insect in mid-air.",
                            "target_lang_translations": {
                                "ru": "<w>Ласточка</w> спикировала вниз, чтобы поймать насекомое в воздухе.",
                                "zh": "一只<w>燕子</w>俯冲下来，在半空中捕捉昆虫。"
                            }
                        },
                        {
                            "text": "We knew spring had arrived when we saw the first <w>swallow</w>.",
                            "target_lang_translations": {
                                "ru": "Мы поняли, что пришла весна, когда увидели первую <w>ласточку</w>.",
                                "zh": "当我们看到第一只<w>燕子</w>时，就知道春天来了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "martin"
                    ],
                    "common_phrases": [
                        "one swallow does not make a summer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая перелетная птица с длинными острыми крыльями и раздвоенным хвостом, известная своим быстрым полетом.",
                        "zh": "一种小型候鸟，翅膀长而尖，尾巴分叉，飞行迅速。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ласточка",
                                "target_lang_sense_clarification": "птица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "燕子",
                                "target_lang_sense_clarification": "鸟类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60af25a7-77a5-3b26-94db-955a60b798aa",
                    "sense_definition": "The act of swallowing, or the amount of liquid or food swallowed at one time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ingest_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He finished the glass of water in a single <w>swallow</w>.",
                            "target_lang_translations": {
                                "ru": "Он осушил стакан воды одним <w>глотком</w>.",
                                "zh": "他<w>一口</w>气喝干了那杯水。"
                            }
                        },
                        {
                            "text": "She took a small <w>swallow</w> of the hot tea to check the temperature.",
                            "target_lang_translations": {
                                "ru": "Она сделала маленький <w>глоток</w> горячего чая, чтобы проверить температуру.",
                                "zh": "她喝了<w>一小口</w>热茶来试温度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gulp",
                        "mouthful"
                    ],
                    "common_phrases": [
                        "take a swallow",
                        "in one swallow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие глотания или количество жидкости или пищи, проглатываемое за один раз.",
                        "zh": "吞咽的动作，或一次吞下的液体或食物量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глоток",
                                "target_lang_sense_clarification": "количество жидкости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一口",
                                "target_lang_sense_clarification": "量词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74261743-a215-3968-a843-36d20a9c084e",
                    "sense_definition": "A type of carbohydrate-based dish, common in African cuisine, that is soft and swallowed without much chewing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They served a traditional soup accompanied by a ball of <w>swallow</w>.",
                            "target_lang_translations": {
                                "ru": "Они подали традиционный суп с шариком <w>своллоу</w>.",
                                "zh": "他们端上了传统的汤，配着一个<w>非洲面团</w>球。"
                            }
                        },
                        {
                            "text": "You should dip the <w>swallow</w> into the sauce before eating it.",
                            "target_lang_translations": {
                                "ru": "Вам следует окунуть <w>своллоу</w> в соус перед тем, как съесть.",
                                "zh": "吃之前你应该把<w>非洲面团</w>蘸点酱汁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "African contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид блюда на углеводной основе, распространенный в африканской кухне; мягкая масса, которую глотают, почти не пережевывая.",
                        "zh": "非洲饮食中一种以碳水化合物为基础的食物，质地柔软，无需咀嚼即可吞下。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "своллоу",
                                "target_lang_sense_clarification": "африканское блюдо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非洲面团",
                                "target_lang_sense_clarification": "非洲主食"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ace0e6ea-4023-37d5-8349-adaf54823c07",
                    "sense_definition": "The throat or gullet; the passage used for swallowing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry bread seemed to stick in his <w>swallow</w>.",
                            "target_lang_translations": {
                                "ru": "Сухой хлеб, казалось, застрял у него в <w>глотке</w>.",
                                "zh": "干面包似乎卡在了他的<w>喉咙</w>里。"
                            }
                        },
                        {
                            "text": "He felt a burning sensation deep in his <w>swallow</w>.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал жжение глубоко в <w>глотке</w>.",
                                "zh": "他感到<w>喉咙</w>深处有一种灼烧感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "throat",
                        "gullet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Горло или пищевод; проход, используемый для глотания.",
                        "zh": "喉咙或食道，即吞咽的通道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глотка",
                                "target_lang_sense_clarification": "анатомия (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喉咙",
                                "target_lang_sense_clarification": "解剖部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be612d89-19ce-3deb-9b41-be085ae0abba",
                    "sense_definition": "A deep opening, hole, or abyss in the earth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stream vanished underground into a dark <w>swallow</w>.",
                            "target_lang_translations": {
                                "ru": "Ручей исчез под землей в темном <w>поноре</w>.",
                                "zh": "溪流消失在地下一个黑暗的<w>深坑</w>里。"
                            }
                        },
                        {
                            "text": "Explorers were careful not to fall into the hidden <w>swallow</w>.",
                            "target_lang_translations": {
                                "ru": "Исследователи были осторожны, чтобы не упасть в скрытый <w>провал</w>.",
                                "zh": "探险家们小心翼翼，以免掉进隐藏的<w>天坑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chasm",
                        "abyss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокое отверстие, яма или бездна в земле.",
                        "zh": "地表深处的洞穴、裂缝或深渊。"
                    },
                    "translations": {
                        "ru": [
                            {
