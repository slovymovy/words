                    "frequency": "High",
                    "semantic_group_id": "pulling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>yank</w> the cord too hard, it might break.",
                            "target_lang_translations": {
                                "ru": "Если ты слишком сильно <w>дернешь</w> за шнур, он может порваться.",
                                "zh": "如果你太用力<w>猛拉</w>绳子，它可能会断。",
                                "cs": "Pokud za šňůru příliš silně <w>trhneš</w>, může prasknout."
                            }
                        },
                        {
                            "text": "He had to <w>yank</w> the door open because the handle was stuck.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>рвануть</w> дверь на себя, потому что ручку заклинило.",
                                "zh": "因为把手卡住了，他不得不<w>猛拉</w>开门。",
                                "cs": "Musel za dveře <w>pořádně vzít</w>, protože klika byla zaseknutá."
                            }
