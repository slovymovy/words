    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "acf508bf-8989-340d-ae9d-cb0bd59d52de",
                "word": "impressionism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ead34cdf-f1d8-42cc-9073-08fc8e8aab76",
                        "entry_id": "acf508bf-8989-340d-ae9d-cb0bd59d52de",
                        "tags": [
                            "plural"
                        ],
                        "form": "impressionisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ce06f7b-c379-360c-94c9-0e02b87f440b",
                        "entry_id": "acf508bf-8989-340d-ae9d-cb0bd59d52de",
                        "glosses": [
                            "An art movement characterized by visible brushstrokes, ordinary subject matter, and an emphasis on light and its changing qualities."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e69b0981-764d-35ef-8078-fd33055a4e1a",
                        "entry_id": "acf508bf-8989-340d-ae9d-cb0bd59d52de",
                        "glosses": [
                            "A style that avoided traditional harmony, and sought to invoke the impressions of the composer."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "39dd1536-b1d7-355d-8d4b-ed928b87f2a2",
                        "entry_id": "acf508bf-8989-340d-ae9d-cb0bd59d52de",
                        "glosses": [
                            "A style that used imagery and symbolism to portray the poet's impressions."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56055622-a34d-4151-b82a-17b10a2171f7",
