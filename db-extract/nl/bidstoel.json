                    {
                        "sense_id": "a06e80a3-5206-3655-b530-772adf6240bd",
                        "entry_id": "65b6d499-9c16-37e7-816a-b1d8d1cbeb23",
                        "glosses": [
                            "een stoel waarop men kan zitten en als men de zitting opklapt op kan knielen om te bidden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db1c0eef-8984-47f8-b35c-d0a3ca582930",
                                "sense_id": "a06e80a3-5206-3655-b530-772adf6240bd",
                                "text": "Vlak bij de biechtstoel stonden enkele bidstoelen zodat men na de biecht direkt zijn penitentie kon doen."
                            },
                            {
                                "example_id": "f84b2002-80d7-4158-b7e0-a0f5f31b8b5a",
                                "sense_id": "a06e80a3-5206-3655-b530-772adf6240bd",
                                "text": "Een hangtapeet, geverwd in 't geel,\nVan zij, doorweven met fluweel,\nEn zil'vren bloemen aan de randen,\nBedekte met zijn pracht de wanden:\nEen bidstoel, cierlijk uitgewerkt,\nWerd naast den spiegel opgemerkt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be7f74cb-4ee3-436e-97a8-db72e3101693",
                        "source_entry_id": "65b6d499-9c16-37e7-816a-b1d8d1cbeb23",
                        "source_sense_id": "a06e80a3-5206-3655-b530-772adf6240bd",
                        "target_lang_word": "Betpult",
                        "target_lang_code": "de",
