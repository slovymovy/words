                            {
                                "target_word": "Prepper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "924a92a0-659d-39c6-959a-ad07db468dfd",
                                        "entry_id": "538e95fe-e141-31e2-91b1-e66ce69a6c2d",
                                        "glosses": [
                                            "Person, die sich mit Lebensmittelvorräten, Schutzbauen und dergleichen auf eine Krise oder Katastrophe so vorbereitet, dass sie überleben kann"
                                        ],
                                        "tags": [
                                            "Jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a5a3340-ead3-4a13-b316-1d3c60d9f82f",
                                                "sense_id": "924a92a0-659d-39c6-959a-ad07db468dfd",
                                                "text": "Wo sind die Prepper? Wo sind die Eier?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
