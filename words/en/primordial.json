{
    "word_family": [
        "primordially",
        "primordium",
        "primordiality"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ce37e3a3-836e-3e24-957f-477fb213a379",
                    "sense_definition": "Existing at or from the very beginning of time; primeval.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists believe the universe began with a hot, dense <w>primordial</w> soup of particles.",
                            "target_lang_translations": {
                                "ru": "Ученые полагают, что Вселенная началась с горячего, плотного <w>первичного</w> бульона из частиц."
                            }
                        },
                        {
                            "text": "The deep forest had a <w>primordial</w> atmosphere that made us feel like we had stepped back in time.",
                            "target_lang_translations": {
                                "ru": "В глухом лесу царила <w>первозданная</w> атмосфера, заставлявшая нас чувствовать себя так, словно мы перенеслись в прошлое."
                            }
                        }
                    ],
                    "synonyms": [
                        "primeval",
                        "ancient",
                        "prehistoric"
                    ],
                    "antonyms": [
                        "modern"
                    ],
                    "common_phrases": [
                        "primordial soup",
                        "primordial forest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в самом начале времен или с самого начала; первобытный, первозданный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первозданный",
                                "target_lang_sense_clarification": "о природе, состоянии"
                            },
                            {
                                "target_lang_word": "первобытный",
                                "target_lang_sense_clarification": "о временах, эпохах"
                            },
                            {
                                "target_lang_word": "изначальный",
                                "target_lang_sense_clarification": "существующий с самого начала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0efca4a-33c7-3962-bd7b-4e2b17381a47",
                    "sense_definition": "First, earliest, or original; fundamental.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The need for food and shelter is a <w>primordial</w> instinct shared by all living creatures.",
                            "target_lang_translations": {
                                "ru": "Потребность в пище и крове — это <w>изначальный</w> инстинкт, присущий всем живым существам."
                            }
                        },
                        {
                            "text": "Fear of the dark is a <w>primordial</w> fear that has helped humans survive for millennia.",
                            "target_lang_translations": {
                                "ru": "Страх темноты — это <w>первобытный</w> страх, который помогал людям выживать на протяжении тысячелетий."
                            }
                        }
                    ],
                    "synonyms": [
                        "original",
                        "earliest",
                        "fundamental",
                        "basic"
                    ],
                    "antonyms": [
                        "secondary"
                    ],
                    "common_phrases": [
                        "primordial instinct",
                        "primordial fear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первый, самый ранний или оригинальный; фундаментальный, основной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изначальный",
                                "target_lang_sense_clarification": "о чувствах, инстинктах"
                            },
                            {
                                "target_lang_word": "первобытный",
                                "target_lang_sense_clarification": "о страхе, инстинктах"
                            },
                            {
                                "target_lang_word": "основной",
                                "target_lang_sense_clarification": "фундаментальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aaaf689c-7db6-35b7-9642-ed7df210b534",
                    "sense_definition": "Characteristic of the earliest stage of the development of an organism or organ.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher identified a <w>primordial</w> cell that would eventually develop into a leaf.",
                            "target_lang_translations": {
                                "ru": "Исследователь идентифицировал <w>первичную</w> клетку, из которой со временем разовьется лист."
                            }
                        },
                        {
                            "text": "During the early stages of embryonic development, <w>primordial</w> germ cells begin to migrate.",
                            "target_lang_translations": {
                                "ru": "На ранних стадиях эмбрионального развития начинают мигрировать <w>первичные</w> половые клетки."
                            }
                        }
                    ],
                    "synonyms": [
                        "embryonic",
                        "primitive"
                    ],
                    "antonyms": [
                        "mature",
                        "developed"
                    ],
                    "common_phrases": [
                        "primordial cell",
                        "primordial germ cells"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный для самой ранней стадии развития организма или органа; первичный, зародышевый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первичный",
                                "target_lang_sense_clarification": "в биологии, о клетках и органах"
                            },
                            {
                                "target_lang_word": "зародышевый",
                                "target_lang_sense_clarification": "в эмбриологии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70bb2296-5573-3d04-b2fc-da8feea88f5f",
                    "sense_definition": "Of an element or isotope: existing on Earth in its current state since before the Earth was formed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics_chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uranium-238 is a <w>primordial</w> nuclide because its half-life is long enough to have survived since the formation of the solar system.",
                            "target_lang_translations": {
                                "ru": "Уран-238 является <w>первичным</w> нуклидом, поскольку период его полураспада достаточно велик, чтобы сохраниться со времен образования Солнечной системы."
                            }
                        },
                        {
                            "text": "The laboratory analyzed the sample to detect the presence of <w>primordial</w> radionuclides.",
                            "target_lang_translations": {
                                "ru": "Лаборатория проанализировала образец на наличие <w>первичных</w> радионуклидов."
                            }
                        }
                    ],
                    "antonyms": [
                        "synthetic",
                        "radiogenic"
                    ],
                    "common_phrases": [
                        "primordial radionuclides",
                        "primordial nuclide"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific term used in physics and chemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Об элементе или изотопе: существующий на Земле в своем нынешнем состоянии еще до образования Земли; первичный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первичный",
                                "target_lang_sense_clarification": "в физике и химии, о нуклидах"
                            },
                            {
                                "target_lang_word": "примордиальный",
                                "target_lang_sense_clarification": "научный термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6fae1d68-649a-32a3-8465-6f7ffc58ff95",
                    "sense_definition": "A primordial condition, state, or environment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his anger, he felt a sudden transition back to the <w>primordial</w>.",
                            "target_lang_translations": {
                                "ru": "В гневе он почувствовал внезапный переход обратно к <w>первобытному состоянию</w>."
                            }
                        },
                        {
                            "text": "The artist's paintings attempt to capture the raw beauty of the <w>primordial</w>.",
                            "target_lang_translations": {
                                "ru": "Картины художника пытаются запечатлеть первозданную красоту <w>первобытности</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "back to the primordial"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with 'the'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Первозданное состояние, первобытная среда или первооснова."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первозданное состояние",
                                "target_lang_sense_clarification": "первобытная среда"
                            },
                            {
                                "target_lang_word": "первобытность",
                                "target_lang_sense_clarification": "первобытное состояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "079ad2f6-d492-3a54-a1fc-77c342a2e454",
                    "sense_definition": "A first principle, element, or basic building block.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that water was the ultimate <w>primordial</w> from which all things arose.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что вода была тем самым конечным <w>первоначалом</w>, из которого возникло все сущее."
                            }
                        },
                        {
                            "text": "These ancient myths describe the <w>primordials</w> of the cosmos before the gods existed.",
                            "target_lang_translations": {
                                "ru": "Эти древние мифы описывают <w>первоэлементы</w> космоса, существовавшие еще до богов."
                            }
                        }
                    ],
                    "synonyms": [
                        "element",
                        "first principle",
                        "fundamental"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "philosophical or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Первоначало, первоэлемент или базовый строительный блок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первоначало",
                                "target_lang_sense_clarification": "в философии"
                            },
                            {
                                "target_lang_word": "первоэлемент",
                                "target_lang_sense_clarification": "основа космоса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}