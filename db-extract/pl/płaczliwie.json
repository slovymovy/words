                        "entry_id": "df17f236-5d5a-39a2-aaf7-64020dc49aa8",
                        "glosses": [
                            "w sposób zanadto emocjonalny, uczuciowy i zwłaszcza taki, który wywołuje wzruszenie"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "848ac3f2-3104-468a-9fbe-354ab473411e",
                                "sense_id": "ec2583c9-1ef0-3dfb-9e64-c48e393c07ec",
                                "text": "- Aresztują mnie - jęczał płaczliwie - zamkną mnie do więzienia. Ale wszystkiemu winien jest ten przeklęty Klaus. On mnie namówił do złego. Co teraz zrobić, panie Tomaszu?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a494ccee-4660-45a6-b387-63969b8d9c74",
                        "source_entry_id": "df17f236-5d5a-39a2-aaf7-64020dc49aa8",
                        "source_sense_id": "4fc3b8ee-abaa-3b01-b5d3-c8836766a927",
                        "target_lang_word": "querulously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "querulously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86cdf716-b147-350b-9798-3aaf1ebe67b4",
                                        "entry_id": "77e95037-5052-3208-802a-8f2e5654991a",
                                        "glosses": [
                                            "With grumbling, complaining, or whining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "884314e0-7939-44db-bbc0-30b843851870",
                                                "sense_id": "86cdf716-b147-350b-9798-3aaf1ebe67b4",
                                                "text": "It was his last demonstration for that time; as, after shedding some more tears and querulously complaining that he couldn't breathe, he slowly fell into a slumber."
                                            },
                                            {
                                                "example_id": "8e605732-d4b0-41de-b450-830d5fc3a359",
                                                "sense_id": "86cdf716-b147-350b-9798-3aaf1ebe67b4",
                                                "text": "\"There are no crimes and no criminals in these days,\" he said, querulously. \"What is the use of having brains in our profession. I know well that I have it in me to make my name famous.[…]\""
                                            },
                                            {
                                                "example_id": "8c471a1e-4801-43d1-9b2b-92ed1816cf39",
                                                "sense_id": "86cdf716-b147-350b-9798-3aaf1ebe67b4",
                                                "text": "\"I wish to 'eaven I 'adn't these silly sandals on,\" he cried querulously to the universe. \"They give the whole blessed show away.\""
                                            },
                                            {
                                                "example_id": "8aa6a57b-8342-4b20-9209-082301a0fed3",
                                                "sense_id": "86cdf716-b147-350b-9798-3aaf1ebe67b4",
                                                "text": "\"If we're heroes,\" Dane asked a little querulously, \"what are we doing locked up here?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
