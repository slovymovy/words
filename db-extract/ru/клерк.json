                                                "example_id": "990496b6-7490-42a6-b2d4-bd0d0714fdb1",
                                                "sense_id": "a147c564-c8eb-3e9c-bd74-e45f9e893d22",
                                                "text": "In this way, the salaryman was both a progressive social stratum and an intellectual class."
                                            },
