                                                "example_id": "f005c482-e65b-4932-b067-8d681627b4c2",
                                                "sense_id": "245ac55b-b68b-322a-bf7b-a01ba579ff06",
                                                "text": "There is still time to oppose this plan."
                                            },
                                            {
                                                "example_id": "47658208-acc4-4768-99ec-bd224e3b42cc",
                                                "sense_id": "245ac55b-b68b-322a-bf7b-a01ba579ff06",
                                                "text": "I am […] too weak / To oppose your cunning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "478b6674-0842-3386-8b88-df76040b8de9",
                                        "entry_id": "39b1c92d-d4e7-3fb2-8117-dfe72914857b",
                                        "glosses": [
