                        "examples": [
                            {
                                "example_id": "3feac46a-7a6a-433c-b84b-e877265d8a5f",
                                "sense_id": "f55c8f8e-d432-36ce-b8d5-a2e5c4237f01",
                                "text": "„Die Festungstore fliegen auf, unser Jeep gleitet durch alle Sicherheitsabsperrungen, es wird salutiert und zurücksalutiert.“"
                            },
                            {
                                "example_id": "3c14472d-7692-4cf2-9860-94cbde94d06f",
                                "sense_id": "f55c8f8e-d432-36ce-b8d5-a2e5c4237f01",
                                "text": "„Die Afghanen, die dort postiert waren, wunderten sich nicht schlecht und fragten sich, was zum Teufel haben diese Burschen vor? - aber wir duckten uns ganz einfach und nahmen Kurs auf das Festungstor.“"
                            }
                        ],
