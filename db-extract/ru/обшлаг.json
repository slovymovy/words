                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f6b5635-568a-31e4-836b-871a3d07b7e9",
                                        "entry_id": "33e3bb60-42fd-3aa2-b135-8cfc3db63854",
                                        "glosses": [
                                            "das Aufschlagen, hart im Fall auftreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a31f267f-f275-4082-be24-cafab93554ba",
                                                "sense_id": "6f6b5635-568a-31e4-836b-871a3d07b7e9",
                                                "text": "Ich bin gestürzt und habe mir beim Aufschlag die Hand verletzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38a6c57e-db4e-3962-b630-2b1c20269df4",
                                        "entry_id": "33e3bb60-42fd-3aa2-b135-8cfc3db63854",
                                        "glosses": [
                                            "eröffnender Schlag bei Ballspielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac48e0c0-6de9-4da2-852c-cbee1ea8f572",
                                                "sense_id": "38a6c57e-db4e-3962-b630-2b1c20269df4",
                                                "text": "Die Mannschaft mit dem besserem Aufschlag hat meist leichte Vorteile."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d774822f-0540-3ffe-80e0-f07ac37dd022",
                                        "entry_id": "33e3bb60-42fd-3aa2-b135-8cfc3db63854",
                                        "glosses": [
                                            "Verteuerung eines Preises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f11be65-347d-4d57-893f-61bdd9a8b7c3",
                                                "sense_id": "d774822f-0540-3ffe-80e0-f07ac37dd022",
                                                "text": "Der Aufschlag durch den Transport verteuert die Waren gewaltig."
                                            },
                                            {
                                                "example_id": "c997f861-2ee6-4d26-91a7-b80f9f539228",
                                                "sense_id": "d774822f-0540-3ffe-80e0-f07ac37dd022",
                                                "text": "„Peking hatte als Reaktion auf US-Strafzölle hohe Aufschläge auf Sojabohnen aus den Vereinigten Staaten verhängt.“"
                                            },
                                            {
                                                "example_id": "f763b6f0-4f55-48da-9f0b-b65b4b9463e9",
                                                "sense_id": "d774822f-0540-3ffe-80e0-f07ac37dd022",
                                                "text": "„Marie fragte vorher immer, wie weit sie denn fahre, und wer denn gestorben sei – damit sie den Aufschlag auch richtig lösen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c6fe2420-ad49-31fa-9fef-4a31c75e5864",
                                        "entry_id": "33e3bb60-42fd-3aa2-b135-8cfc3db63854",
                                        "glosses": [
                                            "bei Kleidungsstücken, oft bei Uniformen, umgeschlagener Stoffteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887bc7b0-c9a5-4ad6-83b5-ef0f003da16c",
                                                "sense_id": "c6fe2420-ad49-31fa-9fef-4a31c75e5864",
                                                "text": "„Seit siebzehn Jahren war Peter bei der Pferdebahn angestellt, seither war immer derselbe Kutscher im grauen Rock mit grünen Aufschlägen gekommen, hatte ihn angeschirrt und vor den großen, gelben Wagen gespannt, wie heute.“"
                                            },
                                            {
                                                "example_id": "f9cbbfa4-bddf-4b0f-bd98-2e83a9d3eb17",
                                                "sense_id": "c6fe2420-ad49-31fa-9fef-4a31c75e5864",
                                                "text": "Der Aufschlag der Hosen war bunt bestickt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "03b71f30-d82e-3da2-bfb2-5f9c5934d095",
                                        "entry_id": "33e3bb60-42fd-3aa2-b135-8cfc3db63854",
                                        "glosses": [
                                            "durch herabfallende Samen gewachsener Baumbestand"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b91ed3b-0017-4ac1-bf8c-76f0ad737017",
                                                "sense_id": "03b71f30-d82e-3da2-bfb2-5f9c5934d095",
                                                "text": "Wenn nicht genügend Aufschlag ist, muss aufgeforstet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "14710588-0925-35b1-be62-bc433ed68400",
                                        "entry_id": "33e3bb60-42fd-3aa2-b135-8cfc3db63854",
                                        "glosses": [
                                            "unvollständiger Takt zu Beginn eines Satzes"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ca7cac0-465b-4a57-9cb3-8693c98f00c2",
                                                "sense_id": "14710588-0925-35b1-be62-bc433ed68400",
                                                "text": "Als Auftakt auch Aufschlag bezeichnet in der Musik den Beginn einer musikalischen Phrase."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1fd3f6a-ad17-4c64-948c-65e99f550470",
                        "source_entry_id": "62ccdbc7-5348-3135-a502-f487fa3bf4be",
                        "target_lang_word": "parement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72acebcc-89e5-3873-a795-b6b3d2005f6e",
                                        "entry_id": "45e3c9e3-d7fc-3f2b-9a4d-18bc7b816a69",
                                        "glosses": [
                                            "Morceau d’étoffe riche ou voyant ornant un vêtement ou le devant d’un autel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c14868c-3983-498d-a95b-a3b1d849cb99",
                                                "sense_id": "72acebcc-89e5-3873-a795-b6b3d2005f6e",
                                                "text": "C’est en fait une robe bien sage, et la couleur de ses parements n’est nullement aguichante mais charmante et discrète."
                                            },
                                            {
                                                "example_id": "7876f133-5751-47ab-9674-ed2ee0d40b8d",
                                                "sense_id": "72acebcc-89e5-3873-a795-b6b3d2005f6e",
                                                "text": "Un parement de velours, en broderie."
                                            },
                                            {
                                                "example_id": "de356dc7-8171-4e25-b56a-b1abbf0cc931",
                                                "sense_id": "72acebcc-89e5-3873-a795-b6b3d2005f6e",
                                                "text": "L’uniforme de ce régiment a des revers et des parements bleus, rouges, violets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b44cee8-f24a-3a4f-97bd-c7251af39725",
                                        "entry_id": "45e3c9e3-d7fc-3f2b-9a4d-18bc7b816a69",
                                        "glosses": [
                                            "Revers qui se trouvent sur les vêtements, notamment aux extrémités des manches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2505711d-d5a4-4d9c-b705-30ff76248694",
                                                "sense_id": "1b44cee8-f24a-3a4f-97bd-c7251af39725",
                                                "text": "Le corsage est montant, à basque plate rouleautée au contour, et la manche a son parement orné d'un nœud en faille."
                                            },
                                            {
                                                "example_id": "1e810911-d645-47f3-a7a1-83f692f5d326",
                                                "sense_id": "1b44cee8-f24a-3a4f-97bd-c7251af39725",
                                                "text": "Je portais un maillot vert cru à parements blancs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac7a52c6-9f91-3c7e-b600-5171cb3b2a1e",
                                        "entry_id": "45e3c9e3-d7fc-3f2b-9a4d-18bc7b816a69",
                                        "glosses": [
                                            "Surface apparente d’un ouvrage de maçonnerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8329ef5c-8a8d-4521-98ef-6e0cb079605e",
                                                "sense_id": "ac7a52c6-9f91-3c7e-b600-5171cb3b2a1e",
                                                "text": "Ces vantaux étaient fortement unis par une barre qui se logeait dans une entaille réservée dans le parement du mur de droite lorsque la porte était ouverte."
                                            },
                                            {
                                                "example_id": "e4ce8d88-9ed6-4ae1-8dfd-7d32a5ac3214",
                                                "sense_id": "ac7a52c6-9f91-3c7e-b600-5171cb3b2a1e",
                                                "text": "Un ouvrage est à deux parements quand il est fait pour être vu des deux côtés."
                                            },
                                            {
                                                "example_id": "08190d5d-4d67-43d3-a084-94b10fe065f8",
                                                "sense_id": "ac7a52c6-9f91-3c7e-b600-5171cb3b2a1e",
                                                "text": "Porte à deux parements."
                                            },
                                            {
                                                "example_id": "aa519f48-6bc7-4f97-bec6-619953dcdacf",
                                                "sense_id": "ac7a52c6-9f91-3c7e-b600-5171cb3b2a1e",
                                                "text": "Le parement d’une pierre, le côté d’une pierre qui doit paraître en dehors du mur."
                                            },
                                            {
                                                "example_id": "0e3ef981-eaae-4619-aa84-27bf29d9455a",
                                                "sense_id": "ac7a52c6-9f91-3c7e-b600-5171cb3b2a1e",
                                                "text": "Parement brut, taillé, poli."
                                            },
                                            {
                                                "example_id": "bc7f58cb-4f78-437f-905f-586eb0f8b502",
                                                "sense_id": "ac7a52c6-9f91-3c7e-b600-5171cb3b2a1e",
                                                "text": "Pierre à deux parements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede0ea9c-6c4b-3aa9-9380-2999fdae4f79",
                                        "entry_id": "45e3c9e3-d7fc-3f2b-9a4d-18bc7b816a69",
                                        "glosses": [
                                            "Gros quartiers de pierre ou de grès qui bordent un chemin pavé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aac2f612-9100-4cba-9ab2-ebf6fdd223f6",
                                                "sense_id": "ede0ea9c-6c4b-3aa9-9380-2999fdae4f79",
                                                "text": "Ils franchirent d’un même pas le parement du trottoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
