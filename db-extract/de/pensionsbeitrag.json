                        "entry_id": "fe6f9f2a-75e3-3d7e-bab4-873e8d6aeeb0",
                        "glosses": [
                            "für die Pension (Altersversorgung) zu zahlender Beitrag (etwa in Österreich)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8587813-9195-4882-879d-caa88b2e93bf",
                                "sense_id": "a0172985-9912-379a-9f8f-089e2117366a",
                                "text": "„Dennoch leisten die Beamten einen Pensionsbeitrag, der in den 1990er Jahren im Sinne der Angleichung von Beamten und Angestellten auf 12,55 % angehoben wurde.“"
                            },
                            {
                                "example_id": "9e4fd7fd-b522-4638-9f14-f6b1ba8c29ed",
                                "sense_id": "a0172985-9912-379a-9f8f-089e2117366a",
                                "text": "„Ist der Karenzurlaub (oder ein Teil davon) demnach für zeitabhängige Rechte zu berücksichtigen, ist der Pensionsbeitrag verpflichtend zu entrichten.“"
                            }
                        ],
