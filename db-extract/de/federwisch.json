                "senses": [
                    {
                        "sense_id": "7ed37de4-25e6-3b99-a6ca-e0e5a5a74323",
                        "entry_id": "da6775b1-5d51-3061-a108-597b619f7dc3",
                        "glosses": [
                            "gebündelte (Gänse-)Federn, die zum Abwischen leichten Schmutzes verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "893a8d2e-93a2-42bb-ab77-fc804dfb1e45",
                                "sense_id": "7ed37de4-25e6-3b99-a6ca-e0e5a5a74323",
                                "text": "„Nach dem Frühstück pflegte er das Glas über diesen Bildern selbst mit einem Tuch abzuwischen und das Ölbild seiner Frau mit einem Federwisch abzustauben, der an einem kleinen Messinghaken neben dem schweren Goldrahmen hing.“"
                            },
                            {
                                "example_id": "00b96ef2-9c18-4d54-8802-9812a69b641a",
                                "sense_id": "7ed37de4-25e6-3b99-a6ca-e0e5a5a74323",
                                "text": "„Ein Mädchen staubte in der Halle mit einem Federwisch die Goldrahmen der Rembrandtkopien ab; am Abend würde hier die Tanzfläche sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
