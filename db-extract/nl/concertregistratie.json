                        "examples": [
                            {
                                "example_id": "3c820e51-622a-4885-bb2e-0a2609acb478",
                                "sense_id": "0f325a99-0a35-30a8-b4a9-f50affb83d42",
                                "text": "Een ander opvallende kamer komt helemaal op het laatst: 'the performance room'. Een vierkante zaal, waarin ineens de muziek aangaat en op schermen rondom een concertregistratie te zien is. \"Dit is het nummer Comfortably numb\", vertelt de curator verheugd. \"Voor deze tentoonstelling speciaal opnieuw afgemixt. Dit het laatste optreden van de band met zijn vieren, in 2005 in een concert in Hyde Park in Londen.\""
                            },
                            {
                                "example_id": "adce968e-5b8c-49e4-ab67-2e088ae4df9e",
                                "sense_id": "0f325a99-0a35-30a8-b4a9-f50affb83d42",
                                "text": "Demme was ook de regisseur van de muziekfilm Stop Making Sense, een registratie van een optreden van de Talking Heads. Die film wordt door velen beschouwd als de beste concertregistratie van een popgroep ooit."
                            }
                        ]
                    }
