                    "sense_id": "0a43946f-df96-3279-add7-eeff6fad3cbf",
                    "sense_definition": "iemand verrassen of verwonderen door iets onverwachts",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>verbaast</w> me dat hij op tijd is gekomen.",
                            "target_lang_translations": {
                                "en": "It <w>surprises</w> me that he arrived on time.",
                                "ru": "Меня <w>удивляет</w>, что он пришел вовремя.",
                                "pl": "<w>Dziwi</w> mnie, że przyszedł na czas.",
                                "de": "Es <w>erstaunt</w> mich, dass er pünktlich gekommen ist.",
                                "fr": "Cela me <w>surprend</w> qu'il soit arrivé à l'heure.",
                                "it": "Mi <w>sorprende</w> che sia arrivato in orario.",
                                "cs": "<w>Překvapuje</w> mě, že přišel včas.",
                                "tr": "Zamanında gelmesi beni <w>şaşırtıyor</w>.",
                                "es": "Me <w>sorprende</w> que haya llegado a tiempo.",
                                "zh": "他准时到达这件事<w>使</w>我感到惊讶。"
                            }
                        },
                        {
                            "text": "Haar reactie <w>verbaasde</w> iedereen in de vergaderzaal.",
                            "target_lang_translations": {
                                "en": "Her reaction <w>surprised</w> everyone in the conference room.",
                                "ru": "Её реакция <w>удивила</w> всех в конференц-зале.",
                                "pl": "Jej reakcja <w>zaskoczyła</w> wszystkich w sali konferencyjnej.",
                                "de": "Ihre Reaktion <w>erstaunte</w> jeden im Konferenzraum.",
                                "fr": "Sa réaction a <w>surpris</w> tout le monde dans la salle de réunion.",
                                "it": "La sua reazione ha <w>stupito</w> tutti nella sala riunioni.",
                                "cs": "Její reakce <w>překvapila</w> všechny v zasedací místnosti.",
                                "tr": "Onun tepkisi toplantı salonundaki herkesi <w>şaşırttı</w>.",
                                "es": "Su reacción <w>sorprendió</w> a todos en la sala de reuniones.",
                                "zh": "她的反应<w>使</w>会议室里的每个人都感到惊讶。"
                            }
                        }
