                ],
                "senses": [
                    {
                        "sense_id": "c564d7ab-4271-39df-8a1a-73eda6e756eb",
                        "entry_id": "23a2d94b-0ba9-3c2f-a21c-6707491765a2",
                        "glosses": [
                            "längere Zeit nach seinen Geschwistern zur Welt gekommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0efecaf7-0b6e-410d-9a25-a6fe20cb77c7",
                                "sense_id": "c564d7ab-4271-39df-8a1a-73eda6e756eb",
                                "text": "„Es bleibt unklar, ob Abel, der sich vom nachgeborenen Bruder Theo durch Wesen und Auftreten unterscheidet, ein Sohn des Priesters ist.“"
                            },
                            {
                                "example_id": "3b9122e0-2363-417f-b3f6-a17714064575",
                                "sense_id": "c564d7ab-4271-39df-8a1a-73eda6e756eb",
                                "text": "„In diesen Sparten hatten die nachgeborenen, nicht erbberechtigten Söhne ihr Auskommen gefunden.“"
                            },
                            {
                                "example_id": "f9439e17-e20c-47a7-8094-c027ef561d69",
                                "sense_id": "c564d7ab-4271-39df-8a1a-73eda6e756eb",
                                "text": "„In Europa, wo es mit Ausnahme Rußlands seit jeher das Privateigentum am Boden und in der Regel das Erbrecht des ältesten Sohnes gegeben hat, waren die nachgeborenen Kinder genötigt wegzuziehen.“"
                            },
                            {
                                "example_id": "a5a1f53e-6bc1-4989-af34-566ac55566ec",
                                "sense_id": "c564d7ab-4271-39df-8a1a-73eda6e756eb",
                                "text": "„Schon ob man der älteste Sohn seines Vaters war oder ein nachgeborener, machte Entscheidendes aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6c73ef5-8e18-3ef9-85f3-ef194e374015",
                        "entry_id": "23a2d94b-0ba9-3c2f-a21c-6707491765a2",
                        "glosses": [
                            "nach dem Tod des Vaters zur Welt gekommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cb25b10-ea92-44e9-9c37-bc01078d0bc6",
                                "sense_id": "c6c73ef5-8e18-3ef9-85f3-ef194e374015",
                                "text": "„Solange die Witwe Marie Christine (von Osterreich) für den nachgeborenen (1886) Sohn Alfons XIII. die Vormundschaft führte, verlor Spanien durch den amerikanischen Krieg (1898) den Rest seiner Kolonialmacht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "aa99d4d7-5d49-3353-ac5e-a824ea2d40e4",
                        "entry_id": "23a2d94b-0ba9-3c2f-a21c-6707491765a2",
                        "glosses": [
                            "nach einem historischen Ereignis geboren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "784fe187-b1fd-40f6-b7bd-f30376512fd8",
                                "sense_id": "aa99d4d7-5d49-3353-ac5e-a824ea2d40e4",
                                "text": "„Ich kenne viele nachgeborene Juden, bei denen solche Fragen zum Alltag gehören, sie haben die Traumata der Überlebenden als Ängste und Albträume geerbt wie andere volle Bankkonten.“"
                            },
                            {
                                "example_id": "31453e52-a7f1-4da0-b066-8d9d29a8b404",
                                "sense_id": "aa99d4d7-5d49-3353-ac5e-a824ea2d40e4",
                                "text": "„Die neuen Populisten sind keine nachgeborenen Faschisten, die sich so einfach isolieren ließen wie die NPD-Mitläufer.“"
                            },
                            {
                                "example_id": "e59d601f-72d4-42ae-a824-f6361427af6d",
                                "sense_id": "aa99d4d7-5d49-3353-ac5e-a824ea2d40e4",
                                "text": "„Dagegen einzuschreiten, sei tagtägliche Aufgabe der nachgeborenen Generationen, sagte der SPD-Politiker.“"
                            },
                            {
                                "example_id": "1d16270d-22a6-402d-ac8b-c5505da1a27c",
                                "sense_id": "aa99d4d7-5d49-3353-ac5e-a824ea2d40e4",
                                "text": "„Er kämpft mit den nachgeborenen Generationen immer noch auf hohem Niveau.“"
                            },
                            {
                                "example_id": "a2a67cf1-59bb-4de2-9f51-5cd49755eec7",
                                "sense_id": "aa99d4d7-5d49-3353-ac5e-a824ea2d40e4",
                                "text": "„Es ist das Bild einer freudigen Versöhnung der nachgeborenen Deutschen, die beschlossen haben, dass sie sich fürderhin nichts mehr aus ihrer Nazivergangenheit vorzuwerfen haben.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
