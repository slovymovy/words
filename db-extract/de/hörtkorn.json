                "senses": [
                    {
                        "sense_id": "a7637cb5-0a9d-38b4-82b9-1b61c0ed147e",
                        "entry_id": "7be4a817-0885-3596-9b08-3faabebfca6a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90f3107b-a791-427f-8292-b0a52d8e98f6",
                                "sense_id": "a7637cb5-0a9d-38b4-82b9-1b61c0ed147e",
                                "text": "Frau Hörtkorn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3f6904fb-1c9e-4bc7-9fbf-220d71d76cd4",
                                "sense_id": "a7637cb5-0a9d-38b4-82b9-1b61c0ed147e",
                                "text": "Herr Hörtkorn wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0d01cd66-fc15-42f9-824d-f78813bfcd61",
                                "sense_id": "a7637cb5-0a9d-38b4-82b9-1b61c0ed147e",
                                "text": "Die Hörtkorns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5a462786-988a-4a55-bfb5-1b453605a295",
                                "sense_id": "a7637cb5-0a9d-38b4-82b9-1b61c0ed147e",
                                "text": "Der Hörtkorn trägt nie die Schals, die die Hörtkorn ihm strickt."
                            },
                            {
                                "example_id": "620fb6a2-ee8a-4e0c-b83b-f47f2ca3c54c",
                                "sense_id": "a7637cb5-0a9d-38b4-82b9-1b61c0ed147e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hörtkorn kommt, geht der Herr Hörtkorn.“"
                            },
                            {
                                "example_id": "5de899ef-9818-4fda-9260-d6a0f5e64733",
                                "sense_id": "a7637cb5-0a9d-38b4-82b9-1b61c0ed147e",
                                "text": "Hörtkorn kommt und geht."
                            },
                            {
                                "example_id": "4d40de37-f3a4-43ec-a0e1-dc07b951b49f",
                                "sense_id": "a7637cb5-0a9d-38b4-82b9-1b61c0ed147e",
                                "text": "Hörtkorns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
