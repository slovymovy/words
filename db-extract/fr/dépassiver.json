                        "glosses": [
                            "Faire perdre son caractère passif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "038830d3-11c2-4ef0-95af-aac9bdc6c090",
                                "sense_id": "613ba698-5f57-3591-acc4-8e47f154f284",
                                "text": "On peut l'activer (c'est-à-dire le dépassiver) on portant sur un de ses points de l'électricité positive, et l'attaque se propage à tout le morceau."
                            },
                            {
                                "example_id": "5ef77b6c-0f58-40e1-a49e-f5fbdf417b2d",
                                "sense_id": "613ba698-5f57-3591-acc4-8e47f154f284",
                                "text": "Au-delà d'une concentration critique en acide, l'exposition au vide a pour résultat de dépassiver l'alliage."
                            }
                        ]
                    }
