                        "form": "die Lederjacke"
                    },
                    {
                        "form_id": "d866c41b-42a9-413b-badc-54c2d75e86ee",
                        "entry_id": "ce89ff97-dff3-3ff7-9c12-88abcc93e27d",
                        "tags": [
                            "accusative",
