                    {
                        "translation_id": "98d58533-98f7-4038-a6ee-02a9aec358ee",
                        "source_entry_id": "90dd3610-2d98-3938-b3cf-7a222dcbf8c2",
                        "source_sense_id": "487eed13-2894-3415-bc11-bafd5a531740",
                        "source_sense_description": "hair growing on the edge of an eyelid",
                        "target_lang_word": "cil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf946b1-99ed-3a98-8008-a29a02cd7ddf",
                                        "entry_id": "a3aaef05-8ebf-3418-a458-c0890895764a",
                                        "glosses": [
                                            "Poil des paupières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee51b2e1-c2d5-4a03-9f7b-70aa6a337503",
                                                "sense_id": "4cf946b1-99ed-3a98-8008-a29a02cd7ddf",
                                                "text": "C’étaient des yeux extraordinaires, bleus, mais foncés et brillants à la fois, humides, las, en pleurs et en feu, presque fermés sous le poids des cils et des paupières."
                                            },
                                            {
                                                "example_id": "d55f8a86-dd14-4085-b55c-94469e07b2b8",
                                                "sense_id": "4cf946b1-99ed-3a98-8008-a29a02cd7ddf",
                                                "text": "Un soldat trapu, avec des cils blancs dans sa figure rubiconde coupée d’une balafre, apparut sur le seuil […]."
                                            },
                                            {
                                                "example_id": "4a508939-ba6c-4da0-9ada-6da19ed29aaa",
                                                "sense_id": "4cf946b1-99ed-3a98-8008-a29a02cd7ddf",
                                                "text": "Puis, mes cils battant, devant l’armoire à glace, je les coupai. Estelle d’ailleurs ne s’en est pas aperçue, car les siens lui sont inutiles. Qu’il pleuve ou qu’elle pleure, elle essuie ses yeux avec sa main."
                                            },
                                            {
                                                "example_id": "8173c41a-5d30-40a1-8a84-b1f853e7f9b9",
                                                "sense_id": "4cf946b1-99ed-3a98-8008-a29a02cd7ddf",
                                                "text": "Elle dérobait du kohl à sa mère pour s’en noircir les cils et donner à ses yeux agrandis la langueur du regard des gazelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eee48b4d-0947-37ac-9d11-ed41e3ba00af",
                                        "entry_id": "a3aaef05-8ebf-3418-a458-c0890895764a",
                                        "glosses": [
                                            "Poil disposé en rang sur le bord d’une partie quelconque d’une plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a03f92e6-deea-4787-82d2-bd940824049e",
                                                "sense_id": "eee48b4d-0947-37ac-9d11-ed41e3ba00af",
                                                "text": "Tels sont, en particulier, les Rossolis (Drosera rotundifolia et intermedia), dont les feuilles, ornées de longs cils rouges, enlacent l’insecte trop confiant qui a cherché sur elles sa pâture."
                                            },
                                            {
                                                "example_id": "b3d2be3d-b220-47f8-826c-5c8c9ea2fc12",
                                                "sense_id": "eee48b4d-0947-37ac-9d11-ed41e3ba00af",
                                                "text": "Ripartites helomorphus se distingue de ses congénères par le chapeau gibbeux et charnu, beaucoup plus épais que la largeur des lamelles, par l'absence de cils marginaux et par ses spores très petites à verrues basses et arrondies."
                                            }
                                        ]
                                    }
                                ]
                            },
