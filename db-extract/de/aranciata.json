                "senses": [
                    {
                        "sense_id": "f682d54d-53fc-3958-8c4b-cb41d1de06be",
                        "entry_id": "3a0e7455-f8cd-3c56-8b91-7df90a8425b7",
                        "glosses": [
                            "alkoholfreies, kohlensäurehaltiges Erfrischungsgetränk aus Orangensaft (Zucker und Wasser)"
                        ],
                        "tags": [
                            "Italien (Südtirol)"
                        ],
                        "examples": [
                            {
                                "example_id": "3f6b54d0-12dd-4056-8abd-1c7cb6da0256",
                                "sense_id": "f682d54d-53fc-3958-8c4b-cb41d1de06be",
                                "text": "„Olga ließ Wein und Aranciata neben die Teller stellen.“"
                            },
                            {
                                "example_id": "fe7670cd-f88e-48cd-9b25-c5f59ab572f4",
                                "sense_id": "f682d54d-53fc-3958-8c4b-cb41d1de06be",
                                "text": "„Wenn miar nit grod hobn Aranciata gmocht, so hob mar die Getränke za di Kundn gebrocht.“"
                            },
                            {
                                "example_id": "ed97be31-bfc1-4729-ad10-2829e98f410c",
                                "sense_id": "f682d54d-53fc-3958-8c4b-cb41d1de06be",
                                "text": "„Die Auswahl an alkoholfreien Getränken beschränkt sich in den allermeisten Fällen auf Aranciata, Mineralwasser oder Cola.“"
                            },
                            {
                                "example_id": "262c1283-2cda-4e5c-862b-75d01a7f0f47",
                                "sense_id": "f682d54d-53fc-3958-8c4b-cb41d1de06be",
                                "text": "„Meine Buben haben immer miteinander eine Aranciata trinken müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
