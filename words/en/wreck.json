{
    "word_family": [
        "wreckage",
        "wrecker",
        "shipwreck"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20686fdf-3e6d-369f-88a5-2c7da9f59f59",
                    "sense_definition": "An accident in which a vehicle, such as a car, train, or ship, is severely damaged or destroyed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrived quickly at the scene of the <w>wreck</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция быстро прибыла на место <w>аварии</w>.",
                                "zh": "警察很快到达了<w>车祸</w>现场。"
                            }
                        },
                        {
                            "text": "Fortunately, no one was seriously hurt in the car <w>wreck</w>.",
                            "target_lang_translations": {
                                "ru": "К счастью, никто серьезно не пострадал в этой автомобильной <w>аварии</w>.",
                                "zh": "幸运的是，在那场<w>车祸</w>中没有人受重伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crash",
                        "collision"
                    ],
                    "common_phrases": [
                        "car wreck",
                        "train wreck",
                        "ship wreck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезная авария или катастрофа, в которой транспортное средство (автомобиль, поезд или корабль) получает сильные повреждения.",
                        "zh": "指车辆、船只等交通工具发生的严重事故或灾难。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "авария",
                                "target_lang_sense_clarification": "ДТП, происшествие с техникой"
                            },
                            {
                                "target_lang_word": "крушение",
                                "target_lang_sense_clarification": "поезда или корабля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "车祸",
                                "target_lang_sense_clarification": "指汽车发生的严重事故"
                            },
                            {
                                "target_lang_word": "事故",
                                "target_lang_sense_clarification": "泛指交通工具发生的意外"
                            },
                            {
                                "target_lang_word": "失事",
                                "target_lang_sense_clarification": "指飞机或船只发生的严重事故"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b10d04a1-6054-32d0-807d-31e72939ddbc",
                    "sense_definition": "The broken remains of a ship, building, or vehicle after it has been destroyed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Divers swam down to explore the <w>wreck</w> of the ancient ship.",
                            "target_lang_translations": {
                                "ru": "Дайверы поплыли вниз, чтобы исследовать <w>обломки</w> древнего корабля.",
                                "zh": "潜水员游下去探索那艘古船的<w>残骸</w>。"
                            }
                        },
                        {
                            "text": "The burnt-out <w>wreck</w> of the house stood on the hill.",
                            "target_lang_translations": {
                                "ru": "Сгоревшие <w>развалины</w> дома стояли на холме.",
                                "zh": "那座房子的烧焦<w>废墟</w>矗立在山坡上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ruins"
                    ],
                    "common_phrases": [
                        "wreck of a ship",
                        "salvage the wreck",
                        "old wreck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остатки или обломки корабля, здания или транспортного средства после разрушения.",
                        "zh": "指船只、建筑物或车辆在损毁后留下的残骸或废墟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обломки",
                                "target_lang_sense_clarification": "остатки чего-либо разбитого"
                            },
                            {
                                "target_lang_word": "развалины",
                                "target_lang_sense_clarification": "здания или сооружения"
                            },
                            {
                                "target_lang_word": "остов",
                                "target_lang_sense_clarification": "каркас сгоревшего или разрушенного объекта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "残骸",
                                "target_lang_sense_clarification": "指船只或车辆损毁后的遗留物"
                            },
                            {
                                "target_lang_word": "废墟",
                                "target_lang_sense_clarification": "指建筑物倒塌后的遗迹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f70740e6-0fbd-3af6-bac7-777e7225fe03",
                    "sense_definition": "A person who is in a very bad state physically or mentally, often due to stress or illness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_ruin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was a nervous <w>wreck</w> while waiting for the exam results.",
                            "target_lang_translations": {
                                "ru": "Ожидая результатов экзамена, она была настоящей нервной <w>развалиной</w>.",
                                "zh": "等待考试结果时，她简直处于<w>精神崩溃</w>的边缘。"
                            }
                        },
                        {
                            "text": "He looked like a total <w>wreck</w> after working for three days without sleep.",
                            "target_lang_translations": {
                                "ru": "Он выглядел как полная <w>развалина</w> после трех дней работы без сна.",
                                "zh": "连续三天没睡觉后，他看起来整个人都<w>垮掉</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "basket case, mess"
                    ],
                    "common_phrases": [
                        "nervous wreck",
                        "emotional wreck"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, находящийся в очень плохом физическом или психическом состоянии (разг.).",
                        "zh": "指因压力、疾病或过度劳累而导致身心状态极差的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развалина",
                                "target_lang_sense_clarification": "о человеке (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垮掉的人",
                                "target_lang_sense_clarification": "形容身心俱疲的状态"
                            },
                            {
                                "target_lang_word": "精神崩溃",
                                "target_lang_sense_clarification": "形容极度焦虑或压力下的状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3db451e3-69c1-3842-bf27-551ff531d5e3",
                    "sense_definition": "To damage something so severely that it fails, breaks, or can no longer be used.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>wreck</w> his father's car within a week.",
                            "target_lang_translations": {
                                "ru": "Он умудрился <w>разбить</w> машину отца за неделю.",
                                "zh": "他不到一周就把他父亲的车给<w>撞毁</w>了。"
                            }
                        },
                        {
                            "text": "The violent storm threatened to <w>wreck</w> the small boat.",
                            "target_lang_translations": {
                                "ru": "Сильный шторм грозил <w>погубить</w> маленькую лодку.",
                                "zh": "猛烈的风暴威胁着要将那艘小船<w>毁坏</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "build",
                        "construct"
                    ],
                    "common_phrases": [
                        "wreck a car",
                        "wreck the house"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно повредить что-либо, сломать или привести в негодность.",
                        "zh": "指严重损坏某物，使其无法使用或报废。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбить",
                                "target_lang_sense_clarification": "машину, транспорт"
                            },
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "уничтожить целостность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撞毁",
                                "target_lang_sense_clarification": "指车辆因碰撞而损毁"
                            },
                            {
                                "target_lang_word": "毁坏",
                                "target_lang_sense_clarification": "指造成严重破坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edb6e1ca-f33e-3a3c-b915-8b96a3e82c39",
                    "sense_definition": "To completely spoil or ruin a plan, relationship, or opportunity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_ruin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden injury could <w>wreck</w> his chances of winning the race.",
                            "target_lang_translations": {
                                "ru": "Внезапная травма могла <w>разрушить</w> его шансы на победу в гонке.",
                                "zh": "突如其来的伤病可能会<w>毁掉</w>他赢得比赛的机会。"
                            }
                        },
                        {
                            "text": "Please do not let this argument <w>wreck</w> our friendship.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не позволяй этому спору <w>разрушить</w> нашу дружбу.",
                                "zh": "请不要让这次争吵<w>破坏</w>我们的友谊。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wreck a marriage",
                        "wreck my life",
                        "wreck the plans"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью испортить или разрушить план, отношения или возможность.",
                        "zh": "指彻底破坏或毁掉计划、关系或机会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "планы, жизнь, отношения"
                            },
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "сделать плохим"
                            },
                            {
                                "target_lang_word": "погубить",
                                "target_lang_sense_clarification": "уничтожить шансы или жизнь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破坏",
                                "target_lang_sense_clarification": "指毁掉关系或计划"
                            },
                            {
                                "target_lang_word": "毁掉",
                                "target_lang_sense_clarification": "指使某事彻底失败"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dfc0765-ade0-3442-a2be-ba093f4a3b2f",
                    "sense_definition": "To take a damaged vehicle apart in order to save useful parts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic decided to <w>wreck</w> the old truck for spare parts.",
                            "target_lang_translations": {
                                "ru": "Механик решил <w>разобрать</w> старый грузовик на запчасти.",
                                "zh": "修理工决定把那辆旧卡车<w>拆解</w>以获取备用零件。"
                            }
                        },
                        {
                            "text": "They <w>wreck</w> cars at the yard to recycle the metal.",
                            "target_lang_translations": {
                                "ru": "На свалке они <w>разбирают</w> машины, чтобы переработать металл.",
                                "zh": "他们在回收场将汽车<w>拆解</w>以回收金属。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разбирать поврежденное транспортное средство на запчасти.",
                        "zh": "指将损坏的车辆拆解以回收可用零件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбирать",
                                "target_lang_sense_clarification": "на запчасти"
                            },
                            {
                                "target_lang_word": "утилизировать",
                                "target_lang_sense_clarification": "сдавать в утиль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拆解",
                                "target_lang_sense_clarification": "指将车辆拆开以获取零件"
                            },
                            {
                                "target_lang_word": "报废",
                                "target_lang_sense_clarification": "指将车辆送去拆解处理"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}