                                "target_senses": [
                                    {
                                        "sense_id": "7c40bba7-d786-3102-9c1f-ba1eb8c27a56",
                                        "entry_id": "3ac7391b-9d64-3f85-b1c0-4701e70c943a",
                                        "glosses": [
                                            "Scientifique qui étudie les gènes, spécialiste de la génétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b2dbe4-ac85-4aee-a129-60ea77d94e61",
                                                "sense_id": "7c40bba7-d786-3102-9c1f-ba1eb8c27a56",
                                                "text": "Et, les consultants viennent parfois rencontrer le généticien comme celui qui va tout expliquer, tout résoudre de façon magique, un peu comme un Dieu, une position bien difficile pour ce médecin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0614bed-e55b-4992-9660-dc7ea8bf9f04",
                        "source_entry_id": "c34ea3e4-f5bf-37f4-b574-c19b8bcbab80",
                        "source_sense_description": "scientist who studies genes",
                        "target_lang_word": "généticienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "généticienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7323f58-48f0-3c8e-8998-e4d0b039ae2f",
                                        "entry_id": "030606fb-21c9-3103-93b7-b781a5cb2a54",
                                        "glosses": [
                                            "Scientifique qui étudie les gènes, spécialiste de la génétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a8834c-dac2-4884-8ffa-0d243fc4e37e",
                                                "sense_id": "b7323f58-48f0-3c8e-8998-e4d0b039ae2f",
                                                "text": "Ces pratiques sont celles prônées par la généticienne des populations et se trouvent adoptées par un nombre croissant d’agriculteurs du réseau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8278ff88-d7be-4df5-8e28-65aff99240ad",
                        "source_entry_id": "c34ea3e4-f5bf-37f4-b574-c19b8bcbab80",
                        "source_sense_description": "scientist who studies genes",
                        "target_lang_word": "Genetiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genetiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                        "entry_id": "f8ef3de7-be2b-3dc6-b4aa-20dbb0543221",
                                        "glosses": [
                                            "jemand, der sich wissenschaftlich mit der Genetik beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edb042b4-4629-437b-8d83-e1935aef7094",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Ein linker Genetiker explodierte daraufhin: Es sei unerhört und obszön, dass im Jahre 2000 so viele Menschen auf unserem Planeten hungers sterben müssen.“"
                                            },
                                            {
                                                "example_id": "c188df13-3d14-4e7b-9cd7-daa0eca8fabe",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Als Vortragende haben sich unter anderem Wikipedia-Mitgründer Larry Sanger, die NASA-Weltraumforscherin Kerry McGuire und der österreichische Genetiker Markus Hengstschläger sowie die ehemalige nigerianische Bildungsministerin und Gründerin von Transparency International, Obiageli Ezekwesili, angekündigt.“"
                                            },
                                            {
                                                "example_id": "684fd466-54b6-45e1-8eaa-65bccd291f92",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Davis, ein Genetiker, der früher biochemische Forschungen betrieb, wirft die Bettdecke beiseite und eilt über eine gewundene Holztreppe hinunter ins Erdgeschoss.“"
                                            },
                                            {
                                                "example_id": "058a1099-f85b-4480-a654-7210242f906e",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Außerdem befassen sich noch die Althistoriker mit den Kelten, die die Berichte antiker Autoren auswerten, sowie Genetiker und Anthropologen, die versuchen, aus Knochen und anderen biologischen Materialien Befunde abzuleiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "961a02e5-9841-4154-a9c7-3043629c07ee",
                        "source_entry_id": "c34ea3e4-f5bf-37f4-b574-c19b8bcbab80",
