                "senses": [
                    {
                        "sense_id": "24be42bf-656f-3a1b-ac1d-3ae0cfabc333",
                        "entry_id": "b98cd919-43ea-3771-b373-602b00ed807a",
                        "glosses": [
                            "The Holy Grail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7174d0-752c-41f6-97eb-3db9eebfea57",
                                "sense_id": "24be42bf-656f-3a1b-ac1d-3ae0cfabc333",
                                "text": "The quest for the Grail is not archeology. It's a race against evil. If it is captured by the Nazis, the armies of darkness will march all over the face of the earth. Do you understand me?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b274a0f0-b85f-31af-bc71-2bb8aa60895f",
                        "entry_id": "b98cd919-43ea-3771-b373-602b00ed807a",
                        "glosses": [
                            "Something eagerly sought or quested for."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "959f4c51-e8eb-49e4-ad87-8ce47c3f3008",
                                "sense_id": "b274a0f0-b85f-31af-bc71-2bb8aa60895f",
                                "text": "Becoming an astronaut was his grail."
                            },
                            {
                                "example_id": "5dd58693-3867-4a15-bea6-777aa7e26c9e",
                                "sense_id": "b274a0f0-b85f-31af-bc71-2bb8aa60895f",
                                "text": "How many of them had found the item they dreamt of, their personal grails?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
