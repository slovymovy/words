                "senses": [
                    {
                        "sense_id": "267b0d6b-9e74-368d-abf9-063803111421",
                        "entry_id": "711ac9d4-65e5-31dc-9bb3-d75e9fb85eca",
                        "glosses": [
                            "erwachsene, langbeinige, weibliche Puppe aus Hartplastik im Maßstab 1:6"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ac2c502-196e-4e10-8a65-5ec52284ab1f",
                                "sense_id": "267b0d6b-9e74-368d-abf9-063803111421",
                                "text": "Seine Tochter spielte mit einer Barbie."
                            },
                            {
                                "example_id": "95fba755-2117-42c0-8a2b-a0fd351d9d7c",
                                "sense_id": "267b0d6b-9e74-368d-abf9-063803111421",
                                "text": "Anläßlich der ersten Frauenfußball-WM kam eine „Soccer-Barbie\" heraus, anläßlich des ersten Jahrestages von Hongkong als chinesischer Sonderverwaltungszone wurde Barbie als Chinesin präsentiert: die Golden Qi-Pao Barbie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "660c893e-4acf-4461-8c98-df49efe177c1",
                        "source_entry_id": "711ac9d4-65e5-31dc-9bb3-d75e9fb85eca",
                        "source_sense_id": "267b0d6b-9e74-368d-abf9-063803111421",
                        "source_sense_description": "weibliche Puppe aus Hartplastik",
