                                "target_senses": [
                                    {
                                        "sense_id": "974beca2-16bc-35c0-9c24-aa3827f542a1",
                                        "entry_id": "9394b551-1167-32ba-979f-e87bb30cb151",
                                        "glosses": [
                                            "A suitcase or schoolbag."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4edd82c-e45c-4a63-bb07-c45423a23497",
                                                "sense_id": "974beca2-16bc-35c0-9c24-aa3827f542a1",
                                                "text": "No, she just paid up proper-like t' the end of the week, an' orf she went with 'er port, down t' the station, I suppose."
                                            },
                                            {
                                                "example_id": "60861ea0-9760-4d91-9d5b-3fce2273bba8",
                                                "sense_id": "974beca2-16bc-35c0-9c24-aa3827f542a1",
                                                "text": "As they left the classroom, Jennifer pointed at the shelves lining the veranda. “Put your port in there.”\n“What?” asked Penny.\n“Your port - your school bag, silly. It goes in there.”"
                                            },
                                            {
                                                "example_id": "a15fd6b6-96c3-493b-a546-72a183187e94",
                                                "sense_id": "974beca2-16bc-35c0-9c24-aa3827f542a1",
                                                "text": "How do you think the cane toads got into this pristine environment? Joseph Midnight brought them in his port from Townsville, smuggled them in, not that anyone was there to stop him."
                                            }
                                        ]
                                    }
                                ]
                            },
