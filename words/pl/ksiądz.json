    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "183c54f0-d56c-3c0e-acc0-023ae3d8ed86",
                    "sense_definition": "Duchowny chrześcijański, osoba posiadająca święcenia kapłańskie, uprawniona do sprawowania kultu religijnego.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religious_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W każdą niedzielę <w>ksiądz</w> wygłasza kazanie do wiernych.",
                            "target_lang_translations": {
                                "ru": "Каждое воскресенье <w>священник</w> читает проповедь верующим.",
                                "en": "Every Sunday, the <w>priest</w> delivers a sermon to the faithful."
                            }
                        },
                        {
                            "text": "Młody <w>ksiądz</w> uczy religii w naszej szkole podstawowej.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>священник</w> преподает религию в нашей начальной школе.",
                                "en": "A young <w>priest</w> teaches religion at our primary school."
                            }
                        }
                    ],
                    "synonyms": [
                        "duszpasterz",
                        "ojciec",
                        "kapłan",
                        "duchowny"
                    ],
                    "common_phrases": [
                        "ksiądz proboszcz",
                        "iść na księdza",
                        "wizyta księdza",
                        "powołanie na księdza"
                    ],
                    "target_lang_definitions": {
                        "ru": "Христианский священнослужитель, лицо, имеющее сан и право совершать богослужения.",
                        "en": "A Christian ordained minister, especially a Roman Catholic priest, authorized to perform religious rites and administer sacraments."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "священник",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "ксёндз",
                                "target_lang_sense_clarification": "польский католический священник"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "priest",
                                "target_lang_sense_clarification": "ordained Christian minister"
                            },
                            {
                                "target_lang_word": "clergyman",
                                "target_lang_sense_clarification": "member of the clergy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18ee4380-d7a0-34a5-b63d-60bc69b1ad3a",
                    "sense_definition": "Dawny tytuł władcy, księcia lub naczelnika plemienia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_ruler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych kronikach zapisano, że <w>ksiądz</w> ten rządził sprawiedliwie.",
                            "target_lang_translations": {
                                "ru": "В древних летописях записано, что этот <w>князь</w> правил справедливо.",
                                "en": "Ancient chronicles record that this <w>prince</w> ruled justly."
                            }
                        },
                        {
                            "text": "Potężny <w>ksiądz</w> zwołał wszystkich wojowników na naradę.",
                            "target_lang_translations": {
                                "ru": "Могущественный <w>князь</w> созвал всех воинов на совет.",
                                "en": "The powerful <w>chieftain</w> summoned all the warriors for a council."
                            }
                        }
                    ],
                    "synonyms": [
                        "książę",
                        "kniądz"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "słowo używane dawniej w znaczeniu władcy"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "obecnie zastąpione słowem książę"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинный титул правителя, князя или вождя племени.",
                        "en": "An archaic title for a Slavic ruler, prince, or tribal chieftain."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "князь",
                                "target_lang_sense_clarification": "исторический титул"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "prince",
                                "target_lang_sense_clarification": "archaic, historical ruler"
                            },
                            {
                                "target_lang_word": "chieftain",
                                "target_lang_sense_clarification": "historical tribal ruler"
                            }
                        ]
                    }
                }
            ]
        },
        {
