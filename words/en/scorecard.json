{
    "word_family": [
        "score",
        "card"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68cc868b-75e1-3bdd-a8bf-7a3a73bb9ab2",
                    "sense_definition": "A printed card allowing spectators of a game to identify players and record progress.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_tracking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a <w>scorecard</w> at the entrance of the stadium to keep track of the baseball game.",
                            "target_lang_translations": {
                                "ru": "Он купил <w>счётную карточку</w> у входа на стадион, чтобы следить за ходом бейсбольного матча."
                            }
                        },
                        {
                            "text": "The spectator filled out the official <w>scorecard</w> as each player made a run.",
                            "target_lang_translations": {
                                "ru": "Зритель заполнял официальный <w>протокол</w>, когда каждый игрок совершал пробежку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "official scorecard",
                        "fill out a scorecard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Печатная карточка, позволяющая зрителям игры идентифицировать игроков и записывать ход матча."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счётная карточка",
                                "target_lang_sense_clarification": "для записи очков и хода игры"
                            },
                            {
                                "target_lang_word": "программа матча",
                                "target_lang_sense_clarification": "с таблицей для ведения счёта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1817162b-80be-3054-a569-5bd808f72bda",
                    "sense_definition": "A tabular representation of the most important statistics of an innings or match.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_tracking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning newspaper published the complete cricket <w>scorecard</w> from yesterday's match.",
                            "target_lang_translations": {
                                "ru": "В утренней газете была опубликована полная <w>таблица результатов</w> вчерашнего матча по крикету."
                            }
                        },
                        {
                            "text": "You can view the match <w>scorecard</w> online to see how many runs each batsman scored.",
                            "target_lang_translations": {
                                "ru": "Вы можете посмотреть <w>протокол матча</w> онлайн, чтобы узнать, сколько ранов набрал каждый бэтсмен."
                            }
                        }
                    ],
                    "common_phrases": [
                        "match scorecard",
                        "cricket scorecard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Табличное представление наиболее важной статистики иннинга или матча."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таблица результатов",
                                "target_lang_sense_clarification": "статистика матча"
                            },
                            {
                                "target_lang_word": "протокол матча",
                                "target_lang_sense_clarification": "официальная таблица с результатами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "141511ff-c02f-38bf-b2bb-a66d784fc5a0",
                    "sense_definition": "A system of ratings or evaluation metrics.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company uses a balanced <w>scorecard</w> to measure the performance of its various departments.",
                            "target_lang_translations": {
                                "ru": "Компания использует сбалансированную <w>систему показателей</w> для оценки эффективности работы своих различных отделов."
                            }
                        },
                        {
                            "text": "Merseyrail and LNER have emerged at the top of a <w>scorecard</w> ranking train operators for their provision of services.",
                            "target_lang_translations": {
                                "ru": "Merseyrail и LNER оказались на вершине <w>рейтинга</w> железнодорожных операторов по качеству предоставляемых услуг."
                            }
                        }
                    ],
                    "synonyms": [
                        "report card",
                        "rating system"
                    ],
                    "common_phrases": [
                        "balanced scorecard",
                        "performance scorecard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система оценок или показателей эффективности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "система показателей",
                                "target_lang_sense_clarification": "для оценки эффективности"
                            },
                            {
                                "target_lang_word": "оценочная карта",
                                "target_lang_sense_clarification": "рейтинг или метрики оценки"
                            },
                            {
                                "target_lang_word": "сбалансированная система показателей",
                                "target_lang_sense_clarification": "в бизнесе (balanced scorecard)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}