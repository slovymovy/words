                        ],
                        "examples": [
                            {
                                "example_id": "f1c044c0-8846-473e-9bc8-73321ab1ae59",
                                "sense_id": "afec90e7-bca9-30ab-a65d-9da75c88212c",
                                "text": "... for let our finger ake, / And it endues our other heathfull members — Othello (Quarto 1), Shakespeare, 1622"
                            },
                            {
                                "example_id": "12ce20dd-4d56-4248-81a1-a3bd6da8a922",
                                "sense_id": "afec90e7-bca9-30ab-a65d-9da75c88212c",
                                "text": "And that thing made of ſound and ſhovv / VVhich mortals have miſnamed A Beau, / (But in the language of the ſky / Is call'd a tvvolegg'd butterfly) / VVill make your very heartſtrings ake / VVith loud and everlaſting clack, […]"
                            },
                            {
                                "example_id": "b5121452-acee-4191-8fec-09d8d005e2f7",
                                "sense_id": "afec90e7-bca9-30ab-a65d-9da75c88212c",
                                "text": "instead he went with the rogues to supper in an arbour, though it made his heart \"ake\" to listen to their mad talk."
                            }
                        ]
                    }
