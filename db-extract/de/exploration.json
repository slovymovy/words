                        "examples": [
                            {
                                "example_id": "4b9d8f84-2df1-4aaa-b8eb-df006e7b4acb",
                                "sense_id": "fb1f307c-cdfa-39b8-88dd-96a97b7401f5",
                                "text": "„Die persönliche Entwicklung oder überhaupt eine Exploration der eigenen Möglichkeiten und Interessen kam dabei häufig zu kurz.“"
                            },
                            {
                                "example_id": "ac6a3c7c-fc31-4b0c-ae64-5bcc90c94ba7",
                                "sense_id": "fb1f307c-cdfa-39b8-88dd-96a97b7401f5",
                                "text": "„Nur zwei Prozent aller Explorationen führen dazu, dass tatsächlich eine Mine errichtet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
