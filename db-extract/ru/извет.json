                "senses": [
                    {
                        "sense_id": "d8e15483-579a-3e10-98c2-d9306ec1574b",
                        "entry_id": "2407a568-90fa-3171-96ef-42fa8f5e2dc1",
                        "glosses": [
                            "устар. донос, часто клеветнический"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "879dfa86-0a56-4aa3-b51c-fe5e41f2d23b",
                                "sense_id": "d8e15483-579a-3e10-98c2-d9306ec1574b",
                                "text": "Что день, то брат на брата // В орду несёт извет; // Земля, кажись, богата — // Порядка ж вовсе нет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2244b262-fc2e-4783-b2d2-f79bf001ee64",
                        "source_entry_id": "2407a568-90fa-3171-96ef-42fa8f5e2dc1",
                        "source_sense_id": "d8e15483-579a-3e10-98c2-d9306ec1574b",
                        "target_lang_word": "denunciation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denunciation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5cc5e2d-6c4c-3922-ad9e-04ac44071ef5",
                                        "entry_id": "28f1cb9b-db0d-3a9a-acc8-4c7396dad72e",
                                        "glosses": [
                                            "Proclamation; announcement; a publishing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf52ec6b-7728-37e7-987c-54139b80630c",
                                        "entry_id": "28f1cb9b-db0d-3a9a-acc8-4c7396dad72e",
                                        "glosses": [
                                            "The act of denouncing; an accusation made in public"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab1586e7-cc23-47c4-a3b2-c1c42a183e1a",
                                                "sense_id": "cf52ec6b-7728-37e7-987c-54139b80630c",
                                                "text": "[Stephen] Miller’s uncle, a neuroscientist, has been welcomed onto the public stage for his denunciations of his nephew’s immigration policies, which the elder Miller has characterized as hypocritical: the Millers’ not-so-distant Jewish ancestors were, of course, immigrants themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d11258b-910b-31cb-9a51-ba8c25082aee",
                                        "entry_id": "28f1cb9b-db0d-3a9a-acc8-4c7396dad72e",
                                        "glosses": [
                                            "An open declaration of personal fault."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39f2615d-d84b-49e7-b65a-fc79f4a872ce",
                                                "sense_id": "6d11258b-910b-31cb-9a51-ba8c25082aee",
                                                "text": "\"Well,\" said the Duc, with that outward calmness of manner which anger often affects; \"so you do not like me? I am sorry for your bad taste! and I bid you good night, quite convinced that you will repent your refusal; and I dare say you will never get married at all.\" So saying, he left the terrace; while Francesca remained for a few minutes, bewildered by the suddenness of the scene, and half inclined to laugh at the Duc's parting denunciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62aa1d9f-548a-313c-8b76-3de7002d89d8",
                                        "entry_id": "28f1cb9b-db0d-3a9a-acc8-4c7396dad72e",
                                        "glosses": [
                                            "That by which anything is denounced; threat of evil; public menace or accusation; arraignment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65a499fa-bf4b-3872-8e0f-277b707cca90",
                                        "entry_id": "28f1cb9b-db0d-3a9a-acc8-4c7396dad72e",
                                        "glosses": [
                                            "The announcement of termination (of a treaty)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b831d244-44ad-443b-986e-9c2a897b8a55",
                        "source_entry_id": "2407a568-90fa-3171-96ef-42fa8f5e2dc1",
                        "source_sense_id": "d8e15483-579a-3e10-98c2-d9306ec1574b",
                        "target_lang_word": "delation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "042a9f66-2010-3622-a8f6-67e18c104e57",
                                        "entry_id": "b85c0f5d-28ce-3082-8c60-e6b59ff6c773",
                                        "glosses": [
                                            "Conveyance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb9081ff-260d-3104-896d-393c085cfa64",
                                        "entry_id": "b85c0f5d-28ce-3082-8c60-e6b59ff6c773",
                                        "glosses": [
                                            "An accusation or charge brought against someone, especially by an informer; the act of accusing someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6878d150-d06e-4cf8-8992-b7d8b9bece72",
                                                "sense_id": "bb9081ff-260d-3104-896d-393c085cfa64",
                                                "text": "Some curious circumstances respecting delation, prison life, and autos da fe are here minutely recorded."
                                            },
                                            {
                                                "example_id": "bb7748c0-e422-4a69-9336-f527876988b7",
                                                "sense_id": "bb9081ff-260d-3104-896d-393c085cfa64",
                                                "text": "Such public defiance might become Valentinian; but it could leave no room for the unworthy delation of the philosopher Maximus, which supposes some more private offence, (Zosimus, l. iv. p. 200, 201.)"
                                            },
                                            {
                                                "example_id": "f16ce433-a418-4b6a-910e-db7c17e0e0c1",
                                                "sense_id": "bb9081ff-260d-3104-896d-393c085cfa64",
                                                "text": "A wise woman who was popular with her neighbours might escape delation; whereas one who had fallen out with them might find herself accused not just of charming, but even of black witchcraft."
                                            },
                                            {
                                                "example_id": "9b33576a-b322-4b82-9f49-e81109b88e04",
                                                "sense_id": "bb9081ff-260d-3104-896d-393c085cfa64",
                                                "text": "2012, Bradford E. Hinze, Chapter 1: A Decade of Disciplining Theologians, Richard R. Gaillardetz (editor), When the Magisterium Intervenes, Liturgical Press (Michael Glazier), page 9,\nDelations frequently come from a local bishop, but there have been cases where vigilante groups (e.g., Catholics United for the Faith) and individuals have complained about a theologian's writings or lectures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
