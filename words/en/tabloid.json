{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26337208-417f-3f47-acc9-9ad371aecfa5",
                    "sense_definition": "A smaller format newspaper, typically featuring sensational stories, celebrity gossip, and many photographs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "newspaper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a <w>tabloid</w> at the train station to read during his morning commute.",
                            "target_lang_translations": {
                                "zh": "他在火车站买了一份<w>小报</w>，打算在早晨通勤时阅读。"
                            }
                        },
                        {
                            "text": "The scandal was plastered across the front page of every popular <w>tabloid</w>.",
                            "target_lang_translations": {
                                "zh": "这起丑闻登上了每家畅销<w>小报</w>的头版。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rag",
                        "red top",
                        "scandal sheet",
                        "tab"
                    ],
                    "common_phrases": [
                        "tabloid press",
                        "tabloid newspaper"
                    ],
                    "target_lang_definitions": {
                        "zh": "小报（版面较小、通常刊登轰动性新闻、名人八卦和大量图片的报纸）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小报",
                                "target_lang_sense_clarification": "版面较小、内容通俗八卦的报纸"
                            },
                            {
                                "target_lang_word": "八卦报纸",
                                "target_lang_sense_clarification": "以刊登花边新闻为主的小报"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9f5cbdf-ba77-3aab-b651-7dc94b02ca2c",
                    "sense_definition": "A standard paper size measuring 11 by 17 inches, often used for printing larger documents.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please print the architectural drawings on <w>tabloid</w> paper so all details are visible.",
                            "target_lang_translations": {
                                "zh": "请用<w>小报尺寸</w>的纸张打印建筑图纸，以便看清所有细节。"
                            }
                        },
                        {
                            "text": "The office printer ran out of <w>tabloid</w> sheets before the poster was finished.",
                            "target_lang_translations": {
                                "zh": "海报还没印完，办公室打印机的<w>小报纸张</w>就用光了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tabloid paper",
                        "tabloid size"
                    ],
                    "target_lang_definitions": {
                        "zh": "小报尺寸的纸张（通常为11×17英寸，相当于美规B尺寸或近似A3）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小报纸张",
                                "target_lang_sense_clarification": "11×17英寸的打印或绘图用纸"
                            },
                            {
                                "target_lang_word": "小报尺寸",
                                "target_lang_sense_clarification": "纸张规格（11×17英寸）"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e2c5a1a-ac5a-3d46-baf6-8c60a356194d",
                    "sense_definition": "A small, compressed pill or tablet containing medicine, chemicals, or food substances.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old doctor carried a small vial of aspirin <w>tabloids</w> in his medical kit.",
                            "target_lang_translations": {
                                "zh": "老医生在急救箱里放了一小瓶阿司匹林<w>药片</w>。"
                            }
                        },
                        {
                            "text": "Dissolving one chemical <w>tabloid</w> into the water produced enough solution for the experiment.",
                            "target_lang_translations": {
                                "zh": "将一片化学<w>片剂</w>溶解在水里，就配制出了做实验所需的足量溶液。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "小药片；小丸剂（压缩成型的药物、化学品或食品小片）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "药片",
                                "target_lang_sense_clarification": "压制成型的小片状药物"
                            },
                            {
                                "target_lang_word": "片剂",
                                "target_lang_sense_clarification": "压制的小药片或化学试片"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce7521e4-5d09-362e-b31d-7f1dac5a1347",
                    "sense_definition": "A compact or condensed version of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stage adaptation felt like a rushed <w>tabloid</w> of the monumental classic novel.",
                            "target_lang_translations": {
                                "zh": "这部舞台改编剧让人感觉像是对那部宏大经典小说仓促拼凑的<w>浓缩版</w>。"
                            }
                        },
                        {
                            "text": "They presented a <w>tabloid</w> summary of the full financial report to the board.",
                            "target_lang_translations": {
                                "zh": "他们向董事会提交了一份完整财务报告的<w>简编</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "浓缩版；简编；概要"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "浓缩版",
                                "target_lang_sense_clarification": "精简压缩后的版本"
                            },
                            {
                                "target_lang_word": "简编",
                                "target_lang_sense_clarification": "节选概括的内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "920accf6-4441-317f-89d6-ce3663c612c6",
                    "sense_definition": "A small yacht designed for cruising.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the summer sailing along the coast in a vintage <w>tabloid</w> cruiser.",
                            "target_lang_translations": {
                                "zh": "整个夏天，他们都驾着一艘复古的<w>小型游艇</w>沿着海岸航行。"
                            }
                        },
                        {
                            "text": "The tiny harbour was filled with several wooden <w>tabloids</w> moored for the winter.",
                            "target_lang_translations": {
                                "zh": "狭小的港湾里停满了在此过冬的数艘木质<w>小型游艇</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tabloid cruiser"
                    ],
                    "target_lang_definitions": {
                        "zh": "小型巡航游艇"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小型游艇",
                                "target_lang_sense_clarification": "用于巡航的小艇"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e93a55eb-59e8-3c07-987d-e4f9d4644970",
                    "sense_definition": "Characteristic of tabloid journalism; sensational, simplified, and focused on celebrity gossip or scandal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "newspaper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She refused to speak to reporters, tired of seeing her private life in <w>tabloid</w> headlines.",
                            "target_lang_translations": {
                                "zh": "她拒绝接受记者采访，因为她已经厌倦了自己的私生活出现在<w>八卦小报</w>的头条上。"
                            }
                        },
                        {
                            "text": "Critics dismissed the television program as cheap <w>tabloid</w> entertainment that lacked serious investigative value.",
                            "target_lang_translations": {
                                "zh": "批评人士对该电视节目不屑一顾，认为它只是廉价的<w>小报式</w>娱乐，缺乏严肃的调查价值。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tabloid headlines",
                        "tabloid journalism"
                    ],
                    "target_lang_definitions": {
                        "zh": "小报风格的；耸人听闻的；通俗八卦的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小报式的",
                                "target_lang_sense_clarification": "具有小报八卦和猎奇风格的"
                            },
                            {
                                "target_lang_word": "耸人听闻的",
                                "target_lang_sense_clarification": "迎合大众猎奇心理的"
                            },
                            {
                                "target_lang_word": "八卦的",
                                "target_lang_sense_clarification": "聚焦名人绯闻琐事的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5dfd6b1-2984-345f-a85a-24e97fb0f145",
                    "sense_definition": "Compressed, compact, or condensed in size or format.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book provided a <w>tabloid</w> overview of European history for busy tourists.",
                            "target_lang_translations": {
                                "zh": "这本书为匆忙的游客提供了欧洲历史的<w>简明</w>概述。"
                            }
                        },
                        {
                            "text": "Modern audiences often prefer their news delivered in quick, <w>tabloid</w> snippets.",
                            "target_lang_translations": {
                                "zh": "现代受众往往更喜欢阅读短小、<w>浓缩的</w>新闻片段。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tabloid form"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "紧凑的；浓缩的；精简的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "浓缩的",
                                "target_lang_sense_clarification": "压缩形式的"
                            },
                            {
                                "target_lang_word": "简明的",
                                "target_lang_sense_clarification": "短小精炼的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce23fac7-e101-3cbf-884e-4b569143f5bb",
                    "sense_definition": "To summarize or present something in a sensational, condensed manner typical of tabloid media.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The media completely <w>tabloided</w> the tragic divorce to boost online viewership.",
                            "target_lang_translations": {
                                "zh": "媒体为了提升网络点击率，以极其<w>耸人听闻的方式报道</w>了这场令人唏嘘的离婚。"
                            }
                        },
                        {
                            "text": "She accused the writer of deliberately <w>tabloiding</w> her words to make them sound scandalous.",
                            "target_lang_translations": {
                                "zh": "她指责该作者故意<w>断章取义夸大</w>她的话，好让其听起来充满丑闻色彩。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以小报风格（夸张、耸人听闻地）报道或浓缩"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "耸人听闻地报道",
                                "target_lang_sense_clarification": "以小报风格大肆渲染"
                            },
                            {
                                "target_lang_word": "以八卦方式呈现",
                                "target_lang_sense_clarification": "用夸张八卦的手法表现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40493ee1-38a3-33ab-9781-2339a62572ea",
                    "sense_definition": "To redesign or convert a publication into a tabloid format.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "newspaper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The publisher chose to <w>tabloid</w> the broadsheet to attract younger and busier readers.",
                            "target_lang_translations": {
                                "zh": "出版商选择将这份大报<w>改成小报形式</w>，以吸引更年轻、更忙碌的读者。"
                            }
                        },
                        {
                            "text": "Several local daily papers have been <w>tabloided</w> in an effort to reduce printing costs.",
                            "target_lang_translations": {
                                "zh": "为了削减印刷成本，几家地方日报已经<w>改成了小报版式</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将（报刊）改版为小报版式"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "改为小报版面",
                                "target_lang_sense_clarification": "将出版物重新设计为较小版式"
                            },
                            {
                                "target_lang_word": "改成小报形式",
                                "target_lang_sense_clarification": "改换为小报规格"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}