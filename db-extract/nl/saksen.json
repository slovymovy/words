                                            {
                                                "example_id": "cc22089d-10b9-45b8-81f0-7b22b3268783",
                                                "sense_id": "f0237c64-5cc2-304c-bc90-c0b844b0e737",
                                                "text": "Ich habe in Sachsen meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "7bcf2a9f-1a65-4da1-9e0e-85b25b85639b",
                                                "sense_id": "f0237c64-5cc2-304c-bc90-c0b844b0e737",
                                                "text": "Nach Sachsen führen viele Wege."
                                            },
                                            {
                                                "example_id": "c54f9c0d-62b7-4ddb-870a-155a6ee13b5f",
                                                "sense_id": "f0237c64-5cc2-304c-bc90-c0b844b0e737",
                                                "text": "„Durch die Folge des Schmalkaldischen Krieges verloren die Ernestiner im Jahr 1547 die Kurwürde, wodurch ihre Besitzungen im Herzogtum Sachsen vereinigt wurden.“"
                                            },
                                            {
                                                "example_id": "1b68fe85-c902-4048-9169-88d395cd26b4",
                                                "sense_id": "f0237c64-5cc2-304c-bc90-c0b844b0e737",
                                                "text": "„Der Welfe wurde vor den Reichstag zitiert, unter Reichsacht gestellt und verlor die Herzogtümer Sachsen und Bayern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
