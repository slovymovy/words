    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "daa60bbe-a5ff-30dc-af28-c9c81494ba0d",
                    "sense_definition": "Тот, кто утратил прежнее положение, звание или статус; переставший занимать какую-либо должность.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На встречу пришёл <w>бывший</w> директор нашей школы.",
                            "target_lang_translations": {
                                "en": "The <w>former</w> director of our school came to the meeting.",
                                "zh": "我们学校的<w>前</w>任校长来参加了会议。"
                            }
                        },
                        {
                            "text": "Мой <w>бывший</w> коллега помог мне найти новую работу.",
                            "target_lang_translations": {
                                "en": "My <w>former</w> colleague helped me find a new job.",
                                "zh": "我的一位<w>前</w>同事帮我找到了新工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "прежний",
                        "экс",
                        "прошлый"
                    ],
                    "antonyms": [
                        "нынешний",
                        "существующий",
                        "будущий"
                    ],
                    "common_phrases": [
                        "бывший муж",
                        "бывший президент",
                        "бывший начальник",
                        "бывший друг"
                    ],
                    "target_lang_definitions": {
                        "en": "One who has lost a former position, title, or status; who has ceased to occupy a certain post.",
                        "zh": "指失去以前的职位、头衔或地位的人；不再担任某项职务的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "former",
                                "target_lang_sense_clarification": "previous status or position"
                            },
                            {
                                "target_lang_word": "ex-",
                                "target_lang_sense_clarification": "prefix indicating past role"
                            },
                            {
                                "target_lang_word": "one-time",
                                "target_lang_sense_clarification": "having been something in the past"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前",
                                "target_lang_sense_clarification": "用于职位或身份之前，表示以前的"
                            },
                            {
                                "target_lang_word": "原",
                                "target_lang_sense_clarification": "表示原来的，常用于职位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84412eba-0928-375d-b679-26872ab4fc8f",
                    "sense_definition": "Мужчина, с которым женщина ранее состояла в романтических отношениях или браке (бывший парень, муж).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ex_partner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она случайно встретила своего <w>бывшего</w> в магазине.",
                            "target_lang_translations": {
                                "en": "She accidentally met her <w>ex</w> at the store.",
                                "zh": "她在商店里偶然遇到了她的<w>前任</w>。"
                            }
                        },
                        {
                            "text": "Мой <w>бывший</w> всё ещё пишет мне сообщения по праздникам.",
                            "target_lang_translations": {
                                "en": "My <w>ex</w> still texts me on holidays.",
                                "zh": "我的<w>前任</w>在节日时还是会给我发信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "экс"
                    ],
                    "common_phrases": [
                        "вернуться к бывшему",
                        "забыть бывшего",
                        "звонок от бывшего"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A man with whom a woman was previously in a romantic relationship or marriage (ex-boyfriend, husband).",
                        "zh": "指女性以前的恋爱对象或前夫。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ex",
                                "target_lang_sense_clarification": "colloquial noun for former partner"
                            },
                            {
                                "target_lang_word": "ex-boyfriend",
                                "target_lang_sense_clarification": "specific relationship"
                            },
                            {
                                "target_lang_word": "former partner",
                                "target_lang_sense_clarification": "more formal term"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前任",
                                "target_lang_sense_clarification": "指前男友或前夫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78904f83-3034-30c2-9c97-9a81dbcd6d27",
                    "sense_definition": "Человек, потерявший свой привилегированный социальный статус после Октябрьской революции 1917 года.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В коммунальных квартирах часто жили «<w>бывшие</w>», стараясь не привлекать к себе внимания.",
                            "target_lang_translations": {
                                "en": "«<w>Former people</w>» often lived in communal apartments, trying not to attract attention.",
                                "zh": "在公共公寓里经常住着一些<w>旧贵族</w>，他们尽量不引起别人的注意。"
                            }
                        },
                        {
                            "text": "Судьба многих <w>бывших</w> в новом государстве сложилась трагически.",
                            "target_lang_translations": {
                                "en": "The fate of many <w>former people</w> in the new state turned out tragically.",
                                "zh": "许多<w>旧贵族</w>在新国家的命运都很悲惨。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "люди из бывших"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who lost their privileged social status after the October Revolution of 1917.",
                        "zh": "指1917年十月革命后失去特权社会地位的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "former person",
                                "target_lang_sense_clarification": "historical term for disenfranchised elite"
                            },
                            {
                                "target_lang_word": "has-been",
                                "target_lang_sense_clarification": "someone who has lost their status"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旧贵族",
                                "target_lang_sense_clarification": "历史语境下失去地位的特权阶层"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "976cd60b-69ab-3fa9-b432-1553299a8d35",
                    "sense_definition": "Действительное причастие прошедшего времени от глагола <w>быть</w>; существовавший или происходивший ранее.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Овраг, когда-то <w>бывший</w> глубокой рекой, теперь полностью пересох.",
                            "target_lang_translations": {
                                "en": "The ravine, once <w>having been</w> a deep river, has now completely dried up.",
                                "zh": "这条沟壑<w>曾经是</w>一条深河，现在已经完全干涸了。"
                            }
                        },
                        {
                            "text": "Этот случай, <w>бывший</w> предметом долгих споров, наконец забыт.",
                            "target_lang_translations": {
                                "en": "This incident, <w>which was</w> the subject of long disputes, is finally forgotten.",
                                "zh": "这件事<w>曾经是</w>长期争论的话题，现在终于被遗忘了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Active past participle of the verb 'to be'; existing or occurring previously.",
                        "zh": "动词“是”的过去主动分词；指以前存在或发生过的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "which was",
                                "target_lang_sense_clarification": "relative clause construction"
                            },
                            {
                                "target_lang_word": "having been",
                                "target_lang_sense_clarification": "participle construction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "曾经是",
                                "target_lang_sense_clarification": "表示过去的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}