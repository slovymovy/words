                        "form_id": "343e9593-f5d7-4593-a972-232f4d24c20a",
                        "entry_id": "f3efbd21-c334-3fe1-83b3-16b5ba5e4c43",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "onpasselijkers"
