                "senses": [
                    {
                        "sense_id": "ab8570ce-b09b-36e7-bda3-f7c09518dcfa",
                        "entry_id": "86b8a579-941c-3ba6-92bc-e7fc8bd51e81",
                        "glosses": [
                            "Zeitraum, in der etwas geerntet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f6ce19c-6f33-434e-92a1-cfbca42de392",
                                "sense_id": "ab8570ce-b09b-36e7-bda3-f7c09518dcfa",
                                "text": "Die Erntezeit für Erdbeeren ist im Mai und Juni."
                            },
                            {
                                "example_id": "af9900cb-668b-4734-827c-ea34ffbde4d0",
                                "sense_id": "ab8570ce-b09b-36e7-bda3-f7c09518dcfa",
                                "text": "In der Erntezeit haben die Bauern viel zu tun."
                            },
                            {
                                "example_id": "ecefac94-423e-453a-8434-50f37c756239",
                                "sense_id": "ab8570ce-b09b-36e7-bda3-f7c09518dcfa",
                                "text": "„In Borodino hatte die Erntezeit schon ein blutiges Ende gefunden, alle Hügel, die liebliche Kolotscha und die Quelle der Moskwa waren besudelt vom Blut einer Schlacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
