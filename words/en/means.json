                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма множественного числа существительного mean (среднее значение).",
                        "fr": "Forme plurielle du nom « mean » (valeur moyenne)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средние значения",
                                "target_lang_sense_clarification": "математический термин"
