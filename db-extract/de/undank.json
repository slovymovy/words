                        "target_lang_word": "ingratitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingratitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8d342ca-ba34-3a84-b2f6-719d2f695a36",
                                        "entry_id": "785b2593-16de-32a0-be9a-a3dfaaffc566",
                                        "glosses": [
                                            "A lack or absence of gratitude; thanklessness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673eff2a-695f-410c-bc0a-f1fca8c9f852",
                                                "sense_id": "f8d342ca-ba34-3a84-b2f6-719d2f695a36",
                                                "text": "“Mrs. Yule's chagrin and horror at what she called her son's base ingratitude knew no bounds ; at first it was even thought that she would never get over it.[…]”"
                                            },
                                            {
                                                "example_id": "b7a62e0f-3e22-48a7-9177-46d44416d985",
                                                "sense_id": "f8d342ca-ba34-3a84-b2f6-719d2f695a36",
                                                "text": "Blondie: Tut, tut. Such ingratitude after all the times I saved your life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
