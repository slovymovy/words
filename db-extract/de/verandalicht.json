                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c835f0f9-0269-4170-b764-7b1f658e1e64",
                                "sense_id": "28d2ef95-3fa0-31cf-b666-6bd91a1726be",
                                "text": "„Sie zeigt dem Grenzposten ihren Ausweis, geht eine Viertelmeile über blitzsaubere neue Bürgersteige zu dem Haus, dessen Verandalicht noch brennt.“"
                            },
                            {
                                "example_id": "5b87e789-2b80-4d34-b325-f88f14eec105",
                                "sense_id": "28d2ef95-3fa0-31cf-b666-6bd91a1726be",
                                "text": "„Walter wird den Kopf herausstrecken, bis das Verandalicht eine weiße Maske auf sein Gesicht legt, und ihr winken, ins Haus zu kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
