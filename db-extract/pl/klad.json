                        "translation_id": "6dee1974-8262-4902-ba15-d08c2e0395ff",
                        "source_entry_id": "43ae8803-5268-3352-be0b-9711e2771e66",
                        "source_sense_id": "81c141a3-cf66-3d1d-99ba-7422db081277",
                        "target_lang_word": "clade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d54c24bc-69f2-38d1-a33c-1db84f7f770e",
                                        "entry_id": "42e27294-add2-372d-9476-4810a8ddb1cf",
                                        "glosses": [
                                            "A group of animals or other organisms derived from a common ancestor species."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a79e19a-d7e0-450a-ade8-25e98d74678c",
                                                "sense_id": "d54c24bc-69f2-38d1-a33c-1db84f7f770e",
                                                "text": "All three clades containing Prunum and “Volvarina” species contain morphological features that do not collectively appear in any other living or fossil marginellid species (see above)."
                                            },
                                            {
                                                "example_id": "2b5684e5-24f8-4c04-8c75-caa72456b476",
                                                "sense_id": "d54c24bc-69f2-38d1-a33c-1db84f7f770e",
                                                "text": "No one has ever tabulated the number or percentage of non-trending clades within larger monophyletic groups. The concept of a non-trending clade — the higher level analog of a species in stasis — has never been explicitly formulated at all. If only one percent of clades exhibited sustained trends, we would still focus our attention upon this tiny minority in telling our favored version of the story of life's history."
                                            },
                                            {
                                                "example_id": "b1201852-22f5-43e0-9b8c-d063fc0ae955",
                                                "sense_id": "d54c24bc-69f2-38d1-a33c-1db84f7f770e",
                                                "text": "A clade is made up of an ancestral species and all its descendants; think of it as that part of an evolutionary tree that would fall off with a single saw cut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87f40c2b-dbd0-3c48-98b4-19d3f5308a38",
                                        "entry_id": "42e27294-add2-372d-9476-4810a8ddb1cf",
                                        "glosses": [
                                            "A higher level grouping of a genetic haplogroup."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de9264c7-9fc9-3ddb-aefe-8a7e2a7fd89a",
                                        "entry_id": "65c580b0-9e1a-397e-8b39-59abb070b661",
                                        "glosses": [
                                            "To be part of a clade; to form a clade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed5aee46-bda6-4818-b6ca-638492bac9fa",
                                                "sense_id": "de9264c7-9fc9-3ddb-aefe-8a7e2a7fd89a",
                                                "text": "The phylogenetic tree for CiCBR shows it clades with the human cannabinoid receptors rather than with those other human GPCRs which most closely resemble the cannabinoid receptors."
                                            }
                                        ]
                                    }
                                ]
