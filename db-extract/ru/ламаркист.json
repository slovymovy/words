                "senses": [
                    {
                        "sense_id": "bc4e28f7-8656-3899-ac65-5bebdaa66e61",
                        "entry_id": "0e2f5016-b102-3b2e-8ee3-93ca974577ab",
                        "glosses": [
                            "приверженец или представитель ламаркизма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebcd541c-16ba-47a0-a50e-26820d8fc857",
                                "sense_id": "bc4e28f7-8656-3899-ac65-5bebdaa66e61",
                                "text": "Понятно теперь, почему новейшие ламаркисты с особенным ожесточением нападают на теорию Вейсмана."
                            },
                            {
                                "example_id": "c1c828d6-ba38-4847-8508-b94c1073e67e",
                                "sense_id": "bc4e28f7-8656-3899-ac65-5bebdaa66e61",
                                "text": "Победа генетики, конечно, правильна и справедлива, но отца раздражало, что Мичурин, Лысенко, прочие наши ламаркисты везде рисуются примитивно, по-детски."
                            }
                        ]
                    }
                ],
