                ],
                "senses": [
                    {
                        "sense_id": "b83e885b-9225-3098-81c4-f4c47589b482",
                        "entry_id": "6a49e783-44ce-3dba-91dc-3511e7c27215",
                        "glosses": [
                            "Personne qui appartenait au peuple des Petchénègues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33a06bdb-4aef-445d-9360-11502769f938",
                                "sense_id": "b83e885b-9225-3098-81c4-f4c47589b482",
                                "text": "Ce pourrait être le Petchénègue Kégénès, promu patrice, que Constantin IX soupçonna à tort de vouloir attaquer Constantinople et enferma dans la prison Éléphantine."
                            },
                            {
                                "example_id": "5acbe916-c884-4770-8242-e14155c579f1",
                                "sense_id": "b83e885b-9225-3098-81c4-f4c47589b482",
                                "text": "Revenu dans son camp, Vladimir envoya dans le camp ses hérauts qui proclamaient : « N’y a-t-il pas ici un homme qui veuille affronter un Petchénègue ? »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c474056-b006-4092-a2e7-e8cb87480162",
                        "source_entry_id": "6a49e783-44ce-3dba-91dc-3511e7c27215",
                        "source_sense_id": "b83e885b-9225-3098-81c4-f4c47589b482",
                        "target_lang_word": "печенег",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "печенег",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0a470f8d-9007-3f57-a27f-609c1c638883",
                                        "entry_id": "46b36b1e-5c99-3b1a-8196-090105a0cf92",
                                        "glosses": [
                                            "истор. мн. ч. союз племён, образовавшийся в заволжских степях в результате смешения кочевников-тюрков с сарматскими и угро-финскими племенами, которые этнически представляли европеоидов с небольшой примесью монголоидности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cbb2d90-ca6f-4e4a-a541-a53c132f6487",
                                                "sense_id": "0a470f8d-9007-3f57-a27f-609c1c638883",
                                                "text": "Печенеги — имя сарматское, значит скорый, или быстрый и скачущий конем."
                                            },
                                            {
                                                "example_id": "ad9db7f6-4d3d-480f-ac25-575bb098b78d",
                                                "sense_id": "0a470f8d-9007-3f57-a27f-609c1c638883",
                                                "text": "Не зная земледелия, обитая в шатрах, кибитках, или вежах, печенеги искали единственно тучных лугов для стад; искали также богатых соседей для грабительства; славились быстротою коней своих; вооруженные копьями, луком, стрелами, мгновенно окружали неприятеля и мгновенно скрывались от глаз его; бросались на лошадях в самые глубокие реки или вместо лодок употребляли большие кожи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851cb3fa-3dff-326d-b265-2100d497c95c",
                                        "entry_id": "46b36b1e-5c99-3b1a-8196-090105a0cf92",
                                        "glosses": [
                                            "перен. захватчик, лютый враг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fef6d798-cbcf-4ea1-9356-011345211bbb",
                                                "sense_id": "851cb3fa-3dff-326d-b265-2100d497c95c",
                                                "text": "Много лет назад какой-то проезжий землемер, ночевавший на хуторе, проговорил всю ночь с Иваном Абрамычем, остался недоволен и утром, уезжая, сказал ему сурово: «Вы, сударь мой, печенег!»"
                                            },
                                            {
                                                "example_id": "6ec5cfec-b3d8-4d39-af46-c658f8bdb16a",
                                                "sense_id": "851cb3fa-3dff-326d-b265-2100d497c95c",
                                                "text": "Егоров, стоявший ближе всех, хлестнул Тимошкина по уху: — Печенег!.. Ты — пятое колесо в нашей коммунистической телеге…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
