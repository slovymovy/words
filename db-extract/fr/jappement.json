        "fr-extract.jsonl": [
            {
                "entry_id": "a4574853-1482-3527-9b6f-fbd80ec389d0",
                "word": "jappement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "15e4daed-d22c-4360-8871-7104052655b9",
                        "entry_id": "a4574853-1482-3527-9b6f-fbd80ec389d0",
                        "tags": [
                            "plural"
                        ],
                        "form": "jappements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "482ed094-0d0e-38f1-957e-a6c5e89cf3c0",
                        "entry_id": "a4574853-1482-3527-9b6f-fbd80ec389d0",
                        "glosses": [
                            "Petit aboiement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2d21d1e-e9d9-40de-8b8f-3b2c0cc270cb",
                                "sense_id": "482ed094-0d0e-38f1-957e-a6c5e89cf3c0",
                                "text": "Aussitôt libre, le chien s’était mis à fuir avec une vélocité incroyable en poussant ces jappements sourds et saccadés des limiers sur la voie."
                            },
                            {
                                "example_id": "6e8307e3-2047-4385-ab99-e98709b42f1e",
                                "sense_id": "482ed094-0d0e-38f1-957e-a6c5e89cf3c0",
                                "text": "Le bruit de cette chute souleva une tempête de jappements féroces parmi tous les dogues, mâtins et molosses qui faisaient ripaille à la ronde."
                            },
                            {
                                "example_id": "3e736cc1-4ce4-4e4a-89d5-ad784f34fb47",
                                "sense_id": "482ed094-0d0e-38f1-957e-a6c5e89cf3c0",
                                "text": "Loin de s'occuper des jappements indicatifs du chien, notre personnage se plaisait à suivre loisireusement le sentier tortueux dans lequel il marchait."
                            }
                        ]
                    },
                    {
                        "sense_id": "c92d56b9-b6d4-38c4-b753-d1db8c2f2e94",
                        "entry_id": "a4574853-1482-3527-9b6f-fbd80ec389d0",
                        "glosses": [
                            "Bavardages féminins, ponctués d’éclats de voix."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a82b7c0d-3404-4c56-9e75-fcb1ac8fe618",
                                "sense_id": "c92d56b9-b6d4-38c4-b753-d1db8c2f2e94",
                                "text": "Que sa vie me paraissait donc futile à distance ! Tous ces embarras infimes, tout ce va-et-vient sur des talons pointus, tous ces jappements de bouches peintes, tous ces effets de jupes signés, de boucles d’oreilles et de parfums !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c830c67-337c-4052-a03e-b1ea47f85590",
                        "source_entry_id": "a4574853-1482-3527-9b6f-fbd80ec389d0",
                        "target_lang_word": "yelp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yelp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a627efc1-b4f2-308e-9687-d9f1e5296004",
                                        "entry_id": "76b4d77c-2413-33e4-9d67-65e1ace393de",
                                        "glosses": [
                                            "An abrupt, high-pitched noise or utterance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c56610-9ce6-4230-9321-7abea8463740",
                                                "sense_id": "a627efc1-b4f2-308e-9687-d9f1e5296004",
                                                "text": "The puppy let out a yelp when I stepped on her tail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d2e4e59-679b-3416-bef3-bf470534c333",
