{
    "word_family": [
        "evocation",
        "evocative",
        "evocatively"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e54c09ad-1df2-3979-b2e4-22a74120dd1f",
                    "sense_definition": "To bring a feeling, memory, or image into the mind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_recall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old photograph <w>evokes</w> memories of my childhood summers by the sea.",
                            "target_lang_translations": {
                                "ru": "Старая фотография <w>вызывает</w> воспоминания о моем детском лете у моря."
                            }
                        },
                        {
                            "text": "The author's vivid descriptions <w>evoke</w> a sense of nostalgia for a simpler time.",
                            "target_lang_translations": {
                                "ru": "Живые описания автора <w>навевают</w> чувство ностальгии по более простым временам."
                            }
                        }
                    ],
                    "synonyms": [
                        "conjure up",
                        "recall",
                        "suggest"
                    ],
                    "common_phrases": [
                        "evoke memories",
                        "evoke a sense of",
                        "evoke nostalgia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать в воображении или памяти чувства, воспоминания или образы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "воспоминания или чувства"
                            },
                            {
                                "target_lang_word": "пробуждать",
                                "target_lang_sense_clarification": "чувства или интерес"
                            },
                            {
                                "target_lang_word": "навевать",
                                "target_lang_sense_clarification": "мысли или грусть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "776b626b-d406-3f2f-b4fe-384ca48cb2da",
                    "sense_definition": "To cause a particular reaction or response from someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The controversial speech <w>evoked</w> a strong reaction from the audience.",
                            "target_lang_translations": {
                                "ru": "Спорная речь <w>вызвала</w> бурную реакцию аудитории."
                            }
                        },
                        {
                            "text": "His rude behavior <w>evoked</w> anger among his colleagues.",
                            "target_lang_translations": {
                                "ru": "Его грубое поведение <w>спровоцировало</w> гнев среди коллег."
                            }
                        }
                    ],
                    "synonyms": [
                        "elicit",
                        "provoke",
                        "arouse",
                        "induce"
                    ],
                    "common_phrases": [
                        "evoke a reaction",
                        "evoke a response",
                        "evoke criticism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать определенную реакцию или ответ со стороны кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "реакцию или отклик"
                            },
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "ответное действие"
                            },
                            {
                                "target_lang_word": "порождать",
                                "target_lang_sense_clarification": "критику или споры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2b7ee0b-7f52-3422-938e-4a51853c7f81",
                    "sense_definition": "To call forth or summon something, such as a spirit or a hidden quality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "summoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ritual was intended to <w>evoke</w> the spirits of the ancestors.",
                            "target_lang_translations": {
                                "ru": "Ритуал был предназначен для того, чтобы <w>вызвать</w> духов предков."
                            }
                        },
                        {
                            "text": "The coach tried to <w>evoke</w> the hidden potential in his young players.",
                            "target_lang_translations": {
                                "ru": "Тренер пытался <w>пробудить</w> скрытый потенциал в своих молодых игроках."
                            }
                        }
                    ],
                    "synonyms": [
                        "summon",
                        "invoke",
                        "call forth"
                    ],
                    "common_phrases": [
                        "evoke spirits"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Призывать или вызывать что-либо, например, духа или скрытое качество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "духов или скрытые силы"
                            },
                            {
                                "target_lang_word": "призывать",
                                "target_lang_sense_clarification": "к проявлению качеств"
                            },
                            {
                                "target_lang_word": "пробуждать",
                                "target_lang_sense_clarification": "скрытый потенциал"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}