                                "sense_id": "d485e850-37bf-3819-a8ed-361c3af98159",
                                "text": "Kan ik alleen de eidooier gebruiken voor dit recept?",
                                "translation": "Can I use just the egg yolk for this recipe?",
                                "english": "Can I use just the egg yolk for this recipe?"
                            },
                            {
