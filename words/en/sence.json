                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "57911c82-db5e-3bef-a6ad-a869e036674f",
                    "sense_definition": "An alternative spelling of <w>since</w> used as an adverb.",
                    "learner_level": "B1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alternative_spelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He left an hour ago and has not been seen <w>since</w>.",
                            "target_lang_translations": {
                                "ru": "Он ушел час назад, и <w>с тех пор</w> его никто не видел."
