                "translations": [
                    {
                        "translation_id": "5f59a65d-7fd1-4495-b218-52d419b40f9b",
                        "source_entry_id": "06b40cef-3a19-3831-8254-612726bf7188",
                        "source_sense_id": "ba79dce8-35d1-3dd7-a2ad-da8dba9a26d4",
                        "target_lang_word": "hopeful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hopeful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c564f294-2f93-3456-9459-adf4d5cfde3f",
                                        "entry_id": "3de30b05-a87c-3e76-9a8a-25797306cfba",
                                        "glosses": [
                                            "feeling hope"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3f3449b-9305-409f-bc80-a278188e9c8a",
                                                "sense_id": "c564f294-2f93-3456-9459-adf4d5cfde3f",
                                                "text": "I have been very hopeful."
                                            },
                                            {
                                                "example_id": "91abd2ac-54bd-4d3a-82ac-78edfd827c36",
                                                "sense_id": "c564f294-2f93-3456-9459-adf4d5cfde3f",
                                                "text": "I am hopeful that I will recover from the disease."
                                            },
                                            {
                                                "example_id": "bf105973-ef6d-444f-aef7-555c51db2cfa",
                                                "sense_id": "c564f294-2f93-3456-9459-adf4d5cfde3f",
                                                "text": "Speaking with reporters during a stop in New York, Mr. Biden offered the most hopeful assessment of the hostage talks by any major figure in many days, suggesting that the war might be close to a major turning point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a959e41a-cc49-3abc-9f0b-9963c74fde5b",
                                        "entry_id": "3de30b05-a87c-3e76-9a8a-25797306cfba",
                                        "glosses": [
                                            "inspiring hope"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e378c208-8eba-40a7-a146-858aebfc0b3d",
                                                "sense_id": "a959e41a-cc49-3abc-9f0b-9963c74fde5b",
                                                "text": "It looks hopeful that my father will be able to walk again."
                                            },
                                            {
                                                "example_id": "76d1f13d-c4f5-44e3-811d-28929a609e85",
                                                "sense_id": "a959e41a-cc49-3abc-9f0b-9963c74fde5b",
                                                "text": "The night was further proof that the Democratic Party’s cruel summer had given way to a more hopeful election season."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hopeful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
