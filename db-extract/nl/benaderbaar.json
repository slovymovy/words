                                            {
                                                "example_id": "133f304e-2452-428f-b27e-5a73900a71cc",
                                                "sense_id": "f9206355-6001-385e-ba55-43b545954a2b",
                                                "text": "Her boss was very approachable."
                                            },
                                            {
                                                "example_id": "7ee1c616-65bc-4c62-b3a6-20ce4595cc93",
                                                "sense_id": "f9206355-6001-385e-ba55-43b545954a2b",
                                                "text": "Whistle's creation stems from an internal colleague competition run by Northern to design a recognisable and approachable character to act as a mascot."
