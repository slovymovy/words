                ],
                "senses": [
                    {
                        "sense_id": "6a93a3ef-a9f4-3418-9eb5-2bc7451fddc8",
                        "entry_id": "3911d5d3-17aa-3bc4-9b89-f3f673664f01",
                        "glosses": [
                            "Qui fraîchit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daf60ba2-b51d-4aff-b95d-47d4df82bb47",
                                "sense_id": "6a93a3ef-a9f4-3418-9eb5-2bc7451fddc8",
                                "text": "L’eau est calme, unie, aussi la gondole s’avance les voiles doucement gonflées par les brises fraîchissantes."
                            },
                            {
                                "example_id": "3cf6943d-b291-49b1-b32b-4e21e5308ed0",
                                "sense_id": "6a93a3ef-a9f4-3418-9eb5-2bc7451fddc8",
                                "text": "Son panache qui ondulait maintenant dans la brise fraîchissante en s’y diluant semblait assombrir plus que la nuit le ciel d’orage, maléficier cette mer inconnue."
                            },
                            {
                                "example_id": "ac40bb95-5fe2-49f9-8c1d-984e9b111183",
                                "sense_id": "6a93a3ef-a9f4-3418-9eb5-2bc7451fddc8",
                                "text": "La brise fraîchissante du soir avait séché et soulevé ses cheveux, donnait à son visage un désordre à travers lequel apparaissait de la brutalité."
                            }
                        ]
                    }
                ],
