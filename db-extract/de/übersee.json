        "de-extract.jsonl": [
            {
                "entry_id": "43869ae0-6217-3974-af77-7d07a9cda6b6",
                "word": "Übersee",
                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
                        "entry_id": "43869ae0-6217-3974-af77-7d07a9cda6b6",
                        "glosses": [
                            "Länder oder Gebiete jenseits eines Ozeans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "166caf84-e1ee-4e78-adc4-237a47720d39",
                                "sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
                                "text": "Viele Auswanderer gingen nach Übersee."
                            },
                            {
                                "example_id": "cf38ae8f-52af-4193-a38a-701c345a79ad",
                                "sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
                                "text": "„Zu ihnen gehörte die zwanzigjährige Mary Anderson, die seit ihrer Verurteilung zu sieben Jahren Deportation nach Übersee im Mai 1788 in Newgate einsaß.“"
                            },
                            {
                                "example_id": "68e9d649-159b-44dc-933a-a1f6cd5e8b0b",
                                "sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
                                "text": "„Zugleich werden die Besitzungen in Übersee in steigendem Maß zur Belastung; zu groß sind die sozialen Probleme dort.“"
                            },
                            {
                                "example_id": "5bc5e016-b26e-491c-b573-8bde77632fbc",
                                "sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
                                "text": "„Die Art, wie die Menschen ihr Land bewirtschafteten, war den Siedlern aus Übersee unbekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e60a6c21-bb7f-4e5f-8ce2-66057932f1c9",
                        "source_entry_id": "43869ae0-6217-3974-af77-7d07a9cda6b6",
                        "source_sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
