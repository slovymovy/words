                "senses": [
                    {
                        "sense_id": "8f5c65d3-732b-39bc-9190-bcf11e897431",
                        "entry_id": "041d2f68-1fc4-3484-a821-d8a97b924b26",
                        "glosses": [
                            "to flash, to fly by, to flit by"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6463696-4384-44e9-ba35-f7234bc1c3d1",
                                "sense_id": "8f5c65d3-732b-39bc-9190-bcf11e897431",
                                "text": "промелькну́ли две неде́ли",
                                "translation": "two weeks flew by",
                                "english": "two weeks flew by"
                            },
                            {
                                "example_id": "22a0ecac-bc5a-40a3-87c7-4e29595af607",
                                "sense_id": "8f5c65d3-732b-39bc-9190-bcf11e897431",
                                "text": "промелькну́ть в голове́ (о мы́сли)",
                                "translation": "flash/flit through one's mind",
                                "english": "flash/flit through one's mind"
                            }
                        ]
                    },
                    {
                        "sense_id": "d6111a06-e5d2-3c85-a5bf-6b564daf5bc0",
                        "entry_id": "041d2f68-1fc4-3484-a821-d8a97b924b26",
                        "glosses": [
                            "to be perceptible"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf6410c6-540f-471a-a7f3-0272d56e65e0",
                                "sense_id": "d6111a06-e5d2-3c85-a5bf-6b564daf5bc0",
                                "text": "в его́ слова́х промелькну́ла иро́ния",
                                "translation": "there was a touch of irony in his words",
                                "english": "there was a touch of irony in his words"
                            },
                            {
                                "example_id": "370be381-b4a5-46c9-9354-052dfeb07c3d",
                                "sense_id": "d6111a06-e5d2-3c85-a5bf-6b564daf5bc0",
                                "text": "в выраже́нии его́ лица́ промелькну́ла улы́бка",
                                "translation": "a smile flitted across his face",
                                "english": "a smile flitted across his face"
                            }
                        ]
                    }
