                                "target_senses": [
                                    {
                                        "sense_id": "cb277764-f51c-3635-93ea-460c2e92129a",
                                        "entry_id": "f799cc27-124a-35cd-9e80-8d92f1d2eb27",
                                        "glosses": [
                                            "Tending to talk a lot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00034a50-714d-4b15-9c63-ab9a055a4287",
                                                "sense_id": "cb277764-f51c-3635-93ea-460c2e92129a",
                                                "text": "a talkative girl"
                                            },
                                            {
                                                "example_id": "53f60aa0-7998-4dd5-aafb-814f09e31b30",
                                                "sense_id": "cb277764-f51c-3635-93ea-460c2e92129a",
                                                "text": "a talkative TV show"
                                            },
                                            {
                                                "example_id": "7d90a6f7-8aae-4938-80c8-fffeb9feaa22",
                                                "sense_id": "cb277764-f51c-3635-93ea-460c2e92129a",
                                                "text": "Tarzan nodded his head. He was a man of few words, and possibly it was for this reason as much as any that Kadour ben Saden had taken to him, for if there be one thing that an Arab despises it is a talkative man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cd3f098-b99b-3165-b269-a71fa26331de",
                                        "entry_id": "f799cc27-124a-35cd-9e80-8d92f1d2eb27",
                                        "glosses": [
                                            "Speaking openly and honestly, neglecting privacy and consequences."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e0658fa-c3c2-44b9-9ab7-567d77873301",
                        "source_entry_id": "ac3668f3-180c-38b7-ab33-3b44a7d3e28c",
                        "source_sense_id": "8f827d55-cafc-39fc-8a8d-c3da3f609319",
                        "source_sense_description": "snel geneigd tot spreken",
                        "target_lang_word": "loquace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loquace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94839868-f737-3163-b1fe-add51a50529f",
                                        "entry_id": "d753c15f-3c72-3176-901e-c4c03271ec73",
                                        "glosses": [
                                            "Qui parle beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f712c2-28e4-4875-b95c-7a01289cdd32",
                                                "sense_id": "94839868-f737-3163-b1fe-add51a50529f",
                                                "text": "Et pendant cette opération, le loquace caporal interpellait toujours le voyageur, qui ne pouvait l’entendre."
                                            },
                                            {
                                                "example_id": "a17bc396-08a9-49e5-b297-05e75cb4308d",
                                                "sense_id": "94839868-f737-3163-b1fe-add51a50529f",
                                                "text": "Je me propose de converser à discrétion avec ce brave homme pour peu qu’il soit loquace."
                                            },
                                            {
                                                "example_id": "7967713e-dbbd-4237-ac2a-05b65ebc9268",
                                                "sense_id": "94839868-f737-3163-b1fe-add51a50529f",
                                                "text": "Maintenant qu’est passée la période loquace où la facilité de langage et les attitudes impressionnantes étaient une condition nécessaire pour atteindre à la prééminence politique, le contrôle tombe de plus en plus entièrement dans les mains d’une classe d’avocassiers et d’intrigants, à l’esprit souple et tenace."
                                            },
                                            {
                                                "example_id": "20d0b68a-de85-4ea0-b97a-d52b260b9c9d",
                                                "sense_id": "94839868-f737-3163-b1fe-add51a50529f",
                                                "text": "Alors le vieux devint subitement loquace, comme si la contrainte s’était levée, qui pesait sur ses paroles, les faisait rares et précautionneuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f7ce524-bf8d-48a9-9a45-ae1549b8411c",
                        "source_entry_id": "ac3668f3-180c-38b7-ab33-3b44a7d3e28c",
                        "source_sense_id": "8f827d55-cafc-39fc-8a8d-c3da3f609319",
                        "source_sense_description": "snel geneigd tot spreken",
                        "target_lang_word": "causant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "causant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f18a66a6-b1df-3e81-9b47-9315b1e3e916",
                                        "entry_id": "0d14f1a4-a3f0-3866-81ff-6703312a83bc",
                                        "glosses": [
                                            "Qui aime à causer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab15a03-b282-4365-abfe-6a0f43f93157",
                                                "sense_id": "f18a66a6-b1df-3e81-9b47-9315b1e3e916",
                                                "text": "C’est elle qui faisait les courses. Pas causante, et même un brin fiérote."
                                            },
                                            {
                                                "example_id": "03841f02-ce42-4db8-bef8-33c4214b0e13",
                                                "sense_id": "f18a66a6-b1df-3e81-9b47-9315b1e3e916",
                                                "text": "Il y avait bien du monde à cet enterrement, dit Honoré, mais je n’ai pas vu grand-chose, pour dire que j’aie vu. Et les gens n’étaient guère causants."
                                            },
                                            {
                                                "example_id": "0f68b230-79a0-484d-b103-c7c7724dea7f",
                                                "sense_id": "f18a66a6-b1df-3e81-9b47-9315b1e3e916",
                                                "text": "Ils ne sont pas précisément “causants”, ces casquettiers, mais je me débrouillerai."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "causant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5dfeeb4f-f561-3be8-93a6-de83bdad9ea4",
                                        "entry_id": "9a919215-7242-3ccc-8227-928baf478da7",
                                        "glosses": [
                                            "Participe présent du verbe causer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41ebc490-5ae4-4ad7-b8c5-dc37a3bda9ae",
                                                "sense_id": "5dfeeb4f-f561-3be8-93a6-de83bdad9ea4",
                                                "text": "Un jour, causant avec lui dans le palais, ils abordèrent un ministre qui pria Zadig à souper, et ne pria point Arimaze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
