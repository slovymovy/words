                    },
                    {
                        "form_id": "e09d9eab-6f80-445b-bb27-12da743f6f57",
                        "entry_id": "a40ed58d-6f6c-3d27-a6c2-f45612abc7ae",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ausgeglichenheiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                        "entry_id": "a40ed58d-6f6c-3d27-a6c2-f45612abc7ae",
                        "glosses": [
                            "Zustand, sich im Gleichgewicht zu befinden, keinen starken (Gefühls-)Schwankungen ausgesetzt zu sein, eine gleichmäßige Verteilung aufzuweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a3772ac-a243-4a3f-a84f-c685208f53e7",
                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                "text": "Er zeichnet sich im Gegensatz zu den anderen durch seine auffallende Ausgeglichenheit aus."
                            },
                            {
                                "example_id": "32cc01c8-efc7-403b-b566-8c6122b4dc77",
                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                "text": "„Außerdem soll tägliches Meditieren für mehr Entspannung und Ausgeglichenheit sorgen.“"
                            },
                            {
                                "example_id": "0fc266f0-3e82-487d-91ff-3cad4154ef58",
                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                "text": "„Die Wut seiner jungen Jahre hatte er in eine beneidenswerte Ausgeglichenheit umgewandelt, leicht nihilistisch vielleicht, aber immer warmherzig.“"
                            },
                            {
                                "example_id": "74c659c1-e806-492b-934b-0b41a43ef50e",
                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                "text": "„Daran ändert selbst der Umverteilungsmechanismus wenig, den die Bundesliga und andere Ligen installiert haben, um die Ausgeglichenheit der Teams zu ermöglichen.“"
                            },
                            {
                                "example_id": "8f3f511f-728a-4da6-a005-3d341f7e5ba9",
                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                "text": "„Dennoch ist man sich einig, dass schon eine Viertelstunde Vorlesen am Tag zu mehr Ausgeglichenheit bei Kindern führt; denn schon in dieser kurzen Vorlesezeit können die Kleinen zur Ruhe kommen.“"
                            },
                            {
                                "example_id": "ec39720d-eedf-4847-ac01-4ba02cc9dfd4",
                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                "text": "„Der uns heute besonders interessierende Kulturgrund dieses Stiles war eine verhältnismäßig große Ausgeglichenheit zwischen städtischem und ländlichem Wesen.“"
                            },
                            {
                                "example_id": "d149d266-d5e2-4f8b-b84c-b1d7c7386d34",
                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                "text": "„Diese Methode übten sie jahrelang sehr strikt aus und schufen dadurch bereits früh eine gewisse Ausgeglichenheit zwischen den beiden Sprachen.“"
                            },
                            {
                                "example_id": "990f67df-ca1d-4a5c-9843-a37289233f5f",
                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                "text": "„Die Massenfertigung von Speisen mit Geschmacksverstärkern und künstlichen Zusatzstoffen führt vor allem bei Kindern dazu, dass sie hyperaktiv, unaufmerksam und unkonzentriert werden. […] An einer britischen Schule haben Schüler eine Woche lang nur stressfreies Essen gegessen. Und siehe da, erste Ausgeglichenheiten in der Stimmung waren die Folge.“"
                            },
                            {
                                "example_id": "54d3dbae-d2c9-49b3-ba2c-4321ba80a977",
                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                "text": "„Die württembergische Wirtschaft zeichnet sich durch die Ausgeglichenheiten zwischen den und innerhalb der verschiedenen Wirtschaftszweige aus.“"
                            },
                            {
                                "example_id": "94d0223d-c915-46b8-86a6-23f3b57f1ff2",
                                "sense_id": "36392c09-9e55-34ea-8e58-2bd2ac143994",
                                "text": "„Seit dieser Zeit sind aber in den Schafbeständen der bäuerlichen Züchter viel, zum Teil fast alle Ausgeglichenheiten verloren gegangen, besonders was Form und Leistung anbelangt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
