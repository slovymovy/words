{
    "word_family": [
        "chunky",
        "chunking",
        "unchunked"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06175f9a-7ea5-3659-a382-8d8ba38f8d38",
                    "sense_definition": "A thick, solid, and often irregular piece of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_piece",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old stone statue fell and broke into several large <w>chunks</w>.",
                            "target_lang_translations": {
                                "ru": "Старая каменная статуя упала и разбилась на несколько крупных <w>кусков</w>.",
                                "zh": "那座古老的石像倒下后摔成了几大<w>块</w>。"
                            }
                        },
                        {
                            "text": "She added a <w>chunk</w> of ice to her drink to keep it cold.",
                            "target_lang_translations": {
                                "ru": "Она добавила <w>кусок</w> льда в свой напиток, чтобы он оставался холодным.",
                                "zh": "她在饮料里加了一<w>块</w>冰，好让它保持冰凉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hunk",
                        "lump",
                        "piece",
                        "block"
                    ],
                    "antonyms": [
                        "sliver",
                        "shaving"
                    ],
                    "common_phrases": [
                        "chunk of ice",
                        "chunk of wood",
                        "large chunk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толстый, твердый и часто бесформенный кусок чего-либо.",
                        "zh": "指某物厚实、坚硬且通常形状不规则的一块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "часть твердого вещества"
                            },
                            {
                                "target_lang_word": "глыба",
                                "target_lang_sense_clarification": "очень большой кусок камня или льда"
                            },
                            {
                                "target_lang_word": "ломоть",
                                "target_lang_sense_clarification": "крупный отрезанный кусок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "块",
                                "target_lang_sense_clarification": "指固体物质的碎片或部分"
                            },
                            {
                                "target_lang_word": "大块",
                                "target_lang_sense_clarification": "指体积较大的部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef73c37e-4397-3a81-9763-ef32b7c13b90",
                    "sense_definition": "A large or significant portion of something abstract, such as time or money.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "portion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A significant <w>chunk</w> of time was spent researching the project.",
                            "target_lang_translations": {
                                "ru": "Значительная <w>часть</w> времени была потрачена на исследование проекта.",
                                "zh": "研究这个项目花掉了<w>大部分</w>时间。"
                            }
                        },
                        {
                            "text": "He spent a large <w>chunk</w> of change on that new car.",
                            "target_lang_translations": {
                                "ru": "Он потратил приличный <w>кусок</w> денег на ту новую машину.",
                                "zh": "他花了一<w>大笔</w>钱买了那辆新车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "portion",
                        "part",
                        "segment",
                        "share"
                    ],
                    "common_phrases": [
                        "chunk of time",
                        "chunk of change",
                        "large chunk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая или значительная часть чего-то абстрактного, например, времени или денег.",
                        "zh": "指抽象事物（如时间或金钱）中很大或相当重要的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "часть",
                                "target_lang_sense_clarification": "доля целого"
                            },
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "значительная порция ресурса"
                            },
                            {
                                "target_lang_word": "пласт",
                                "target_lang_sense_clarification": "большой объем информации или времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大部分",
                                "target_lang_sense_clarification": "指整体中较大的份额"
                            },
                            {
                                "target_lang_word": "一大笔",
                                "target_lang_sense_clarification": "指数量巨大的金钱或资源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9c301d3-4b66-3dfb-9b9d-a1a508947787",
                    "sense_definition": "A group of words that are often used together as a single unit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Language learners often memorize a lexical <w>chunk</w> to sound more natural.",
                            "target_lang_translations": {
                                "ru": "Изучающие язык часто заучивают лексические <w>блоки</w>, чтобы звучать более естественно.",
                                "zh": "语言学习者经常背诵<w>词块</w>，这样听起来更地道。"
                            }
                        },
                        {
                            "text": "The phrase in accordance with is a common <w>chunk</w> in formal writing.",
                            "target_lang_translations": {
                                "ru": "Фраза «в соответствии с» — это распространенный <w>чанк</w> в официальном письме.",
                                "zh": "“in accordance with”这个短语是正式写作中常见的<w>语块</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster",
                        "bundle"
                    ],
                    "common_phrases": [
                        "lexical chunk",
                        "language chunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа слов, которые часто используются вместе как единое целое.",
                        "zh": "指经常作为一个整体使用的词组或语言单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лексический блок",
                                "target_lang_sense_clarification": "устойчивое словосочетание"
                            },
                            {
                                "target_lang_word": "чанк",
                                "target_lang_sense_clarification": "термин в лингвистике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "词块",
                                "target_lang_sense_clarification": "语言学中指固定搭配或短语"
                            },
                            {
                                "target_lang_word": "语块",
                                "target_lang_sense_clarification": "指作为单一单位记忆的语言片段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f6ca186-919c-3199-8021-cd1af1603aa7",
                    "sense_definition": "A specific segment or routine within a comedian's performance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian decided to cut a five-minute <w>chunk</w> from his set.",
                            "target_lang_translations": {
                                "ru": "Комик решил вырезать пятиминутный <w>блок</w> из своего выступления.",
                                "zh": "那位喜剧演员决定从他的表演中删掉五分钟的<w>段子</w>。"
                            }
                        },
                        {
                            "text": "He practiced his opening <w>chunk</w> until the timing was perfect.",
                            "target_lang_translations": {
                                "ru": "Он репетировал свой вступительный <w>номер</w>, пока тайминг не стал идеальным.",
                                "zh": "他反复练习开场的<w>段子</w>，直到节奏完美为止。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "routine",
                        "segment"
                    ],
                    "common_phrases": [
                        "comedy chunk",
                        "opening chunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "industry jargon for stand-up comedy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный сегмент или номер в выступлении комика.",
                        "zh": "指喜剧演员表演中的特定片段或段子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блок",
                                "target_lang_sense_clarification": "часть выступления"
                            },
                            {
                                "target_lang_word": "номер",
                                "target_lang_sense_clarification": "отдельная шутка или сцена"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "段子",
                                "target_lang_sense_clarification": "指表演中的独立喜剧片段"
                            },
                            {
                                "target_lang_word": "节目片段",
                                "target_lang_sense_clarification": "指表演中的一部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d0e2f05-6d4f-35bd-88ec-92ddeedc1a34",
                    "sense_definition": "A discrete block of data within a digital file or stream.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software processes each data <w>chunk</w> individually to save memory.",
                            "target_lang_translations": {
                                "ru": "Программа обрабатывает каждый <w>блок</w> данных индивидуально для экономии памяти.",
                                "zh": "该软件逐个处理每个<w>数据块</w>以节省内存。"
                            }
                        },
                        {
                            "text": "The file format stores metadata in a separate <w>chunk</w> at the beginning.",
                            "target_lang_translations": {
                                "ru": "Формат файла хранит метаданные в отдельном <w>чанке</w> в самом начале.",
                                "zh": "该文件格式将元数据存储在开头的独立<w>分段</w>中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "block",
                        "segment"
                    ],
                    "common_phrases": [
                        "data chunk",
                        "memory chunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный блок данных в цифровом файле или потоке.",
                        "zh": "指数字文件或数据流中离散的数据块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чанк",
                                "target_lang_sense_clarification": "единица данных в ИТ"
                            },
                            {
                                "target_lang_word": "фрагмент",
                                "target_lang_sense_clarification": "часть пакета данных"
                            },
                            {
                                "target_lang_word": "блок",
                                "target_lang_sense_clarification": "сегмент памяти или файла"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数据块",
                                "target_lang_sense_clarification": "计算机中处理数据的基本单位"
                            },
                            {
                                "target_lang_word": "分段",
                                "target_lang_sense_clarification": "指被分割的数据部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0bbf8b2d-1ac3-3a9c-bf6c-fb68ac6345b3",
                    "sense_definition": "To divide or break something into large, thick pieces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>chunk</w> the meat before putting it into the stew.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>нарезать</w> мясо крупными кусками, прежде чем класть его в рагу.",
                                "zh": "炖肉之前，你应该把肉<w>切成块</w>。"
                            }
                        },
                        {
                            "text": "The machine will <w>chunk</w> the wood into smaller pieces for the fire.",
                            "target_lang_translations": {
                                "ru": "Машина <w>раздробит</w> древесину на более мелкие части для костра.",
                                "zh": "机器会把木头<w>剁碎</w>成小块用来生火。"
                            }
                        }
                    ],
                    "synonyms": [
                        "segment",
                        "divide",
                        "cut"
                    ],
                    "common_phrases": [
                        "chunk up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять или разламывать что-либо на крупные, толстые куски.",
                        "zh": "将某物分割或切成大而厚的块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резать крупными кусками",
                                "target_lang_sense_clarification": "о еде или материале"
                            },
                            {
                                "target_lang_word": "дробить",
                                "target_lang_sense_clarification": "разбивать на части"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "切成块",
                                "target_lang_sense_clarification": "指将食物或材料切分"
                            },
                            {
                                "target_lang_word": "剁碎",
                                "target_lang_sense_clarification": "指用力将物体分成小块"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b70782f-26fa-3aff-93c1-4a54e2ea51fd",
                    "sense_definition": "To organize information into manageable groups or units to make it easier to remember.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "organize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easier to remember phone numbers if you <w>chunk</w> the digits.",
                            "target_lang_translations": {
                                "ru": "Номера телефонов легче запомнить, если <w>группировать</w> цифры.",
                                "zh": "如果你把数字<w>分块</w>，电话号码就更容易记住。"
                            }
                        },
                        {
                            "text": "The teacher helped the students <w>chunk</w> the text into smaller sections.",
                            "target_lang_translations": {
                                "ru": "Учитель помог ученикам <w>разбить</w> текст на более мелкие разделы.",
                                "zh": "老师帮助学生把课文<w>归类</w>成较小的部分。"
                            }
                        }
                    ],
                    "synonyms": [
                        "group",
                        "classify",
                        "categorize"
                    ],
                    "common_phrases": [
                        "chunk information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать информацию в управляемые группы или блоки для облегчения запоминания.",
                        "zh": "将信息组织成易于管理的组或单元，以便于记忆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "группировать",
                                "target_lang_sense_clarification": "объединять данные"
                            },
                            {
                                "target_lang_word": "разбивать на блоки",
                                "target_lang_sense_clarification": "структурировать информацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分块",
                                "target_lang_sense_clarification": "指将信息结构化处理"
                            },
                            {
                                "target_lang_word": "归类",
                                "target_lang_sense_clarification": "指将信息整理成组"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffccd12e-c3e5-33c3-bdc3-6720b71fb26f",
                    "sense_definition": "To deal a large amount of damage to an opponent in a game.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boss's health was <w>chunked</w> by the player's powerful ultimate ability.",
                            "target_lang_translations": {
                                "ru": "Здоровье босса было сильно <w>подорвано</w> мощной ультимативной способностью игрока.",
                                "zh": "玩家强大的终极技能让BOSS的血量被<w>重创</w>。"
                            }
                        },
                        {
                            "text": "He got <w>chunked</w> by the enemy sniper and had to retreat.",
                            "target_lang_translations": {
                                "ru": "Вражеский снайпер <w>снес</w> ему много здоровья, и ему пришлось отступить.",
                                "zh": "他被敌方狙击手<w>打掉</w>了大量血量，不得不撤退。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in gaming contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить большой урон противнику в игре за один раз.",
                        "zh": "在游戏中一次性对对手造成大量伤害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сносить",
                                "target_lang_sense_clarification": "отнимать много здоровья"
                            },
                            {
                                "target_lang_word": "отрывать",
                                "target_lang_sense_clarification": "резко уменьшать полоску ХП"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重创",
                                "target_lang_sense_clarification": "指造成大量生命值损失"
                            },
                            {
                                "target_lang_word": "打掉",
                                "target_lang_sense_clarification": "指瞬间削减大量血量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb87d185-b497-38e7-aa24-ed64417c1012",
                    "sense_definition": "To throw something with force.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "throw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry boy <w>chunked</w> a rock at the old fence.",
                            "target_lang_translations": {
                                "ru": "Рассерженный мальчик <w>швырнул</w> камень в старый забор.",
                                "zh": "那个生气的男孩向旧栅栏<w>猛扔</w>了一块石头。"
                            }
                        },
                        {
                            "text": "They spent the afternoon <w>chunking</w> stones into the river.",
                            "target_lang_translations": {
                                "ru": "Они провели весь день, <w>кидая</w> камни в реку.",
                                "zh": "他们整个下午都在往河里<w>投掷</w>石头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "hurl",
                        "toss",
                        "fling"
                    ],
                    "common_phrases": [
                        "chunk at"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Southern US dialect"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросать что-либо с силой.",
                        "zh": "用力投掷某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швырять",
                                "target_lang_sense_clarification": "бросать с силой"
                            },
                            {
                                "target_lang_word": "запулить",
                                "target_lang_sense_clarification": "сильно кинуть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛扔",
                                "target_lang_sense_clarification": "指用力投掷"
                            },
                            {
                                "target_lang_word": "投掷",
                                "target_lang_sense_clarification": "指抛掷动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}