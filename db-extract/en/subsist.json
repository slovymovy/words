                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6d12942a-0a0b-3d94-a078-f72035c2e828",
                                        "entry_id": "f00f0fa3-9d4c-38f3-b81f-8eb0cf498de9",
