                                "target_senses": [
                                    {
                                        "sense_id": "52e53348-5d16-3dd5-96ba-0543e7d4980a",
                                        "entry_id": "3c3e1800-f80f-3e67-8184-40a663e61323",
                                        "glosses": [
                                            "wódz, książę tatarski; perski i turecki tytuł honorowy, np. uczonych (umieszczany przed nazwiskiem) lub książęcy (wtedy po nazwisku)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a90fa67-f128-4eb2-b726-a0c9170ceca6",
                                                "sense_id": "52e53348-5d16-3dd5-96ba-0543e7d4980a",
                                                "text": "Mimo że na ziemie koronne ruszyły stosunkowo niewielkie siły Tatarów, Kantymir mirza i kałga sułtan Dewlet Gerej powrócili bowiem z większością wojowników do swych ułusów, zniszczenia wywołane przez rabusiów były ogromne"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "mirza",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "55eae08e-a1b5-3f9b-9c6e-4c361e7191cf",
                                        "entry_id": "68430834-7a9e-37a6-b7be-ba8fbd304967",
                                        "glosses": [
                                            "rodzaj małpiatek z rodziny lemurkowatych"
                                        ],
                                        "tags": [],
