                                        "glosses": [
                                            "jemanden zum Spaß hereinlegen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c80da154-880e-4494-8a9a-f333ff96e671",
                                                "sense_id": "83ebd98e-12d1-3354-afb0-fa47454199c1",
                                                "text": "Verkohl mich nicht! Das ist doch nie und nimmer wahr!"
                                            },
                                            {
                                                "example_id": "4bc5d88a-67a4-42e0-9433-2df2f51c6e0f",
                                                "sense_id": "83ebd98e-12d1-3354-afb0-fa47454199c1",
                                                "text": "Da sind Sie wohl von Ihrer Tochter verkohlt worden."
                                            }
                                        ],
