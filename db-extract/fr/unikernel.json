                                            {
                                                "example_id": "8242f222-fd26-4e22-82fa-bf3734d52115",
                                                "sense_id": "fc9242a5-b208-3c17-954d-202282e71ef9",
                                                "text": "The general idea behind unikernel systems is not entirely new, as it builds up on top of the concept of library operating systems such as exokernel or Nemesis."
                                            },
                                            {
                                                "example_id": "52c5bc06-baeb-4cee-ab5e-cf1e30ac36d9",
                                                "sense_id": "fc9242a5-b208-3c17-954d-202282e71ef9",
                                                "text": "In the unikernel approach, a developer selects a minimal set of libraries from a modular stack which correspond to the OS constructs required for their application to run."
                                            }
