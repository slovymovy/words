                "senses": [
                    {
                        "sense_id": "5d7cae7c-bc9a-3e74-85a2-307a9e075510",
                        "entry_id": "62d23bbe-2569-3399-a0a3-b6d7d6db376f",
                        "glosses": [
                            "menschliche Fähigkeit, sich ein Bild von etwas zu machen, etwas anschaulich im Sinn zu haben, sich über etwas Gedanken zu machen und vorzustellen"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "947eb66b-e9dd-4e1f-8a60-0b0014a06bfd",
                                "sense_id": "5d7cae7c-bc9a-3e74-85a2-307a9e075510",
                                "text": "„Eine ausgeprägte Vorstellungsgabe war für den Beruf des Regisseurs wohl Grundbedingung.“"
                            },
                            {
                                "example_id": "62a18548-8056-4717-89c2-d2e3686218fa",
                                "sense_id": "5d7cae7c-bc9a-3e74-85a2-307a9e075510",
                                "text": "„Du wahrscheinlich etwas von deinen Kindern lernen, denn sie haben eine blühende Fantasie und Vorstellungsgabe.“"
                            },
                            {
                                "example_id": "ae52f3e2-d36a-4f0e-9c54-2f614d9524c8",
                                "sense_id": "5d7cae7c-bc9a-3e74-85a2-307a9e075510",
                                "text": "„Sie benötigen aber auch die Vorstellungsgabe, dass Ihr Denken nur einen unter vielen innerkörperlichen Prozessen beschreibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
