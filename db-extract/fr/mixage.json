                                                "example_id": "7e344281-d7f8-4fb8-b12c-9f438d0a1cea",
                                                "sense_id": "339fbb06-c68a-3457-80cd-714c8044b186",
                                                "text": "Het was een mengeling van heimwee en schuldgevoel en veroorzaakte een onaangename knoop in mijn buik."
                                            },
