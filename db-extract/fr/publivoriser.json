                "senses": [
                    {
                        "sense_id": "057cc989-792f-3320-8c9a-ceca14921eb6",
                        "entry_id": "5b8f0604-c5ca-3ed1-a54f-120005fdbb5b",
                        "glosses": [
                            "Donner un caractère publivore à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5792b91-cdaa-4084-bce2-bd32f1e089c2",
                                "sense_id": "057cc989-792f-3320-8c9a-ceca14921eb6",
                                "text": "La planète entière vient à toi et, bien affalé sur ton sofa, de bonnes charentaises aux pieds [ça me regarde, je fais ce que je veux ! Non mais…], ton zappeur en main, tu savoures délicieusement le progrès avec tes quatre mille huit cent douze chaînes qui viennent te solliciter, te draguer, flirter avec toi, te publivoriser la matière grise…"
                            },
                            {
                                "example_id": "293bb4e3-e7bf-469e-934b-0a0917420157",
                                "sense_id": "057cc989-792f-3320-8c9a-ceca14921eb6",
                                "text": "Le condom est banalisé, intégré, partagé, visualisé, échangé, marketé, tête-de-gondolé, publivorisé, voire ballonné ou bombaoïsé dans les collèges et lycées."
                            },
                            {
                                "example_id": "e4e1d3fb-abb8-4e89-8d08-4c301509855f",
                                "sense_id": "057cc989-792f-3320-8c9a-ceca14921eb6",
                                "text": "J'ai trouvé ça très solide, mais mon avis se \"publivorise\" très légèrement."
                            }
                        ]
                    }
                ],
