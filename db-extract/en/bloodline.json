                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ee3ab831-5727-3b1d-86fb-9ca64d47696e",
                        "entry_id": "d6025944-b917-3835-9d5c-99c20c09aa3f",
                        "glosses": [
                            "By extension, the predecessors of a particular item or product."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "274c6ece-8bdc-4d02-a373-015de33cc282",
                                "sense_id": "ee3ab831-5727-3b1d-86fb-9ca64d47696e",
                                "text": "No other Sport Utility Vehicle has a bloodline like the Cayenne."
