                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel mensen vinden het een <w>nutteloze</w> discussie omdat er toch niets zal veranderen.",
                            "target_lang_translations": {
                                "en": "Many people find it a <w>pointless</w> discussion because nothing will change anyway.",
                                "ru": "Многие люди считают это <w>бессмысленной</w> дискуссией, потому что всё равно ничего не изменится.",
                                "pl": "Wiele osób uważa to za <w>bezsensowną</w> dyskusję, ponieważ i tak nic się nie zmieni.",
                                "de": "Viele Menschen halten es für eine <w>sinnlose</w> Diskussion, da sich ohnehin nichts ändern wird.",
                                "fr": "Beaucoup de gens trouvent que c'est une discussion <w>inutile</w> car rien ne changera de toute façon.",
                                "it": "Molte persone la considerano una discussione <w>inutile</w> perché tanto non cambierà nulla.",
                                "cs": "Mnoho lidí považuje tuto diskuzi za <w>nesmyslnou</w>, protože se stejně nic nezmění.",
                                "tr": "Pek çok insan bunun <w>anlamsız</w> bir tartışma olduğunu düşünüyor çünkü zaten hiçbir şey değişmeyecek.",
                                "es": "Muchas personas consideran que es una discusión <w>inútil</w> porque nada cambiará de todos modos.",
                                "zh": "许多人认为这是一场<w>无意义</w>的讨论，因为反正什么也不会改变。"
                            }
                        },
                        {
                            "text": "Hij voelde zich <w>nutteloos</w> toen hij zijn baan verloor en de hele dag thuis zat.",
                            "target_lang_translations": {
                                "en": "He felt <w>useless</w> when he lost his job and sat at home all day.",
                                "ru": "Он чувствовал себя <w>бесполезным</w>, когда потерял работу и целый день сидел дома.",
                                "pl": "Czuł się <w>niepotrzebny</w>, gdy stracił pracę i siedział cały dzień w domu.",
                                "de": "Er fühlte sich <w>nutzlos</w>, als er seinen Job verlor und den ganzen Tag zu Hause saß.",
                                "fr": "Il s'est senti <w>inutile</w> lorsqu'il a perdu son emploi et qu'il est resté à la maison toute la journée.",
                                "it": "Si sentiva <w>inutile</w> quando ha perso il lavoro ed è rimasto a casa tutto il giorno.",
                                "cs": "Cítil se <w>zbytečný</w>, když přišel o práci a celý den seděl doma.",
                                "tr": "İşini kaybettiğinde ve bütün gün evde oturduğunda kendini <w>işe yaramaz</w> hissetti.",
                                "es": "Se sintió <w>inútil</w> cuando perdió su trabajo y se quedó en casa todo el día.",
                                "zh": "当他失去工作整天待在家里时，他感到自己很<w>没用</w>。"
                            }
                        }
