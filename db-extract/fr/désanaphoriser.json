                "senses": [
                    {
                        "sense_id": "315fa88f-8a45-389c-9b59-ffe65276e738",
                        "entry_id": "bcb9f1e5-50c8-3064-838d-70f8a6b01112",
                        "glosses": [
                            "Supprimer les anaphores de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45013763-2f41-4a41-93fc-4e768a0f8d04",
                                "sense_id": "315fa88f-8a45-389c-9b59-ffe65276e738",
                                "text": "Nous ferons la distinction entre les modulations conservant un anaphorique nominal et celles désanaphorisant la version de départ par le recours à des expressions temporelles."
                            },
                            {
                                "example_id": "1abcebc5-6dd5-42b6-a07c-958600b8e3b4",
                                "sense_id": "315fa88f-8a45-389c-9b59-ffe65276e738",
                                "text": "Alfred Gérardin va, en effet, jusqu’à « désanaphoriser » l’original."
                            },
                            {
                                "example_id": "3f323956-f267-4582-b378-82de78d9e3c4",
                                "sense_id": "315fa88f-8a45-389c-9b59-ffe65276e738",
                                "text": "Le who par contre à entendre désanaphoriser ou rématiser le contenu. On va l’utiliser pour introduire un élément nouveau et inconnu de l’énonciateur."
                            }
                        ]
                    }
