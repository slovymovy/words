                        "sense_id": "dd3d623f-297f-3834-91aa-a6726a2d5081",
                        "entry_id": "9d7eb1de-0d51-3017-b819-0478d9184cef",
                        "glosses": [
                            "een groep mensen die actie voeren om een bepaald (idealistisch) doel te bereiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c9e50a-c231-4214-b80f-062dd922d8c6",
                                "sense_id": "dd3d623f-297f-3834-91aa-a6726a2d5081",
                                "text": "De actiegroep had als doel Amelisweerd te behouden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3fa6f01-3f49-4f15-8860-73708bb594ad",
                        "source_entry_id": "9d7eb1de-0d51-3017-b819-0478d9184cef",
                        "source_sense_id": "dd3d623f-297f-3834-91aa-a6726a2d5081",
                        "target_lang_word": "Bürgerinitiative",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürgerinitiative",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "505de78d-63e6-3f07-9879-be885b2325e5",
                                        "entry_id": "3ff96c40-0a2a-34c5-b402-92b59eb0fc9e",
                                        "glosses": [
                                            "Zusammenschluss von Bürgern zur Vertretung ihrer Interessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ffad563-fe8e-492f-9fb3-80cdf8305bf3",
                                                "sense_id": "505de78d-63e6-3f07-9879-be885b2325e5",
                                                "text": "„Die Unterschriftenaktion gehört traditionellerweise zum Aktionsrepertoire der Neuen sozialen Bewegungen und von Bürgerinitiativen, findet jedoch auch außerhalb dieser ihre Anwendung.“"
                                            },
                                            {
                                                "example_id": "d9406cc2-41b9-449f-8358-c0e3f3b19d45",
                                                "sense_id": "505de78d-63e6-3f07-9879-be885b2325e5",
                                                "text": "„Um das Trauerimage ihrer Stadt aufzupolieren, erinnerte eine Bürgerinitiative 2011 an einen Sohn der Stadt, der zu weltweitem Ruhm kam.“"
                                            },
                                            {
                                                "example_id": "29ab2071-fc7c-4886-9f08-b5aebec2288d",
                                                "sense_id": "505de78d-63e6-3f07-9879-be885b2325e5",
                                                "text": "„Die Sachsenhäuser Bürgerinitiative vollzieht eine Kehrtwende: Sie will sich jetzt für ganzheitliche Lösungen der Verkehrsprobleme am Mainufer von Frankfurt einsetzen.“"
                                            },
                                            {
                                                "example_id": "cafb80d5-4937-44b3-8455-a7133608fe4d",
                                                "sense_id": "505de78d-63e6-3f07-9879-be885b2325e5",
                                                "text": "„Wenn Bürgerinitiativen fordern, die wenigen noch verbliebenen Agnes-Miegel-Sraßen umzubenennen, ist das verständlich – man muss Straßen nicht nach ihr benennen, wenn Menschen sich damit unwohl fühlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
