                                        "examples": [
                                            {
                                                "example_id": "700586ec-a000-4d10-abd4-270bc185089d",
                                                "sense_id": "cb4cac5b-e6b5-3596-b9fd-c101a455b122",
                                                "text": "„Zu diesem Zeitpunkt wog der kleine Hase gerade einmal hundert Gramm und hatte kaum die Größe einer Kinderhand.“"
                                            },
                                            {
                                                "example_id": "bbe75e75-723f-44e7-8c50-b6af37c4b8d5",
                                                "sense_id": "cb4cac5b-e6b5-3596-b9fd-c101a455b122",
                                                "text": "„Der naive, wie von Kinderhand gezeichnete Valek nahm den Stil seiner zukünftigen Kinderbücher vorweg.“"
                                            },
                                            {
                                                "example_id": "fcce49d9-9da2-4182-b75f-5cecb340a0f7",
                                                "sense_id": "cb4cac5b-e6b5-3596-b9fd-c101a455b122",
                                                "text": "„Sylvia bewahrte sie normalerweise in einer Vitrine auf, um sie vor neugierigen, ungeschickten Kinderhänden zu schützen, aber Amélie war vorsichtig und behutsam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
