                        "sense_id": "c71395dc-2cc9-38ad-9f8d-cdb34b19e359",
                        "entry_id": "4d431034-1b7c-30df-a829-58d86fcd1fc9",
                        "glosses": [
                            "In euchre: an undefeatable hand containing the five highest cards."
                        ],
