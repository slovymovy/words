                        "glosses": [
                            "(nicht auf Hochschulebene) ausgebildete, (aber nicht ordinierte) Theologin in einer Gemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a40646-63d6-4447-a630-5b0f7363bc72",
                                "sense_id": "ef094b56-fa86-3889-89d9-58e5f36c3f8a",
                                "text": "„Dass in der Einzelbegleitung v.a. auch Menschen von außerhalb der Ortsgemeinde diese Angebote aufsuchen, ist auch für die Praxis der Trauergruppen belegt, wie die Gemeindereferentin in Mönchengladbach in Bezug auf die dort tagenden Trauergruppen ausführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
