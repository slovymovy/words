                        ],
                        "examples": [
                            {
                                "example_id": "279bf880-4a46-4b5e-9cb7-30169a8f649d",
                                "sense_id": "5378cc6f-8f2f-391b-b9e5-31a39f7afb79",
                                "text": "Maar hij was niet uitgenodigd om melancholisch te worden over het feit dat hij zich liet corrumperen met ossenhaas en Franse wijn, goede wijn overigens, een uitstekende versterking van het nieuwe grote rijk."
                            },
                            {
                                "example_id": "b196f2d6-df11-4ad7-871c-3a9df134f94d",
                                "sense_id": "5378cc6f-8f2f-391b-b9e5-31a39f7afb79",
                                "text": "Iets vergeten? JaDe amandel voor de rijstebrij, ze zouden tenslotte kerst vieren in het huis van oudoom Sverre, hij die altijd de amandel in de rijstebrij kreeg, vermoedelijk door de bedienden te corrumperen."
                            }
                        ]
                    }
