                ],
                "senses": [
                    {
                        "sense_id": "d8b9d52a-d274-3e3a-b9d2-0fafe108d29e",
                        "entry_id": "64fe1388-91fe-3168-8d7d-705cfc5b43a5",
                        "glosses": [
                            "прост. сумасбродный, взбалмошный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3cdee62-e5ba-43da-91ea-418636485d10",
                                "sense_id": "d8b9d52a-d274-3e3a-b9d2-0fafe108d29e",
                                "text": "Блажная была покойница, заметил при этом Наркиз, ― мне, говорит, своя воля дороже всего."
                            },
                            {
                                "example_id": "d84b20bf-e873-4a97-873e-8c4e813eac70",
                                "sense_id": "d8b9d52a-d274-3e3a-b9d2-0fafe108d29e",
                                "text": "Брось эту блажную мысль. Не женись."
                            },
                            {
                                "example_id": "358afa27-8690-45f0-9cd7-635f86570943",
                                "sense_id": "d8b9d52a-d274-3e3a-b9d2-0fafe108d29e",
                                "text": "Ну, что блажные слова по пустякам тараторить!"
                            },
                            {
                                "example_id": "5a94abc2-bc11-4966-baf2-6176a59a5a81",
                                "sense_id": "d8b9d52a-d274-3e3a-b9d2-0fafe108d29e",
                                "text": "Нам же будет хуже, если наши блажные просьбы исполнят."
                            }
                        ]
                    },
                    {
                        "sense_id": "770ece3b-a5ab-3aa7-9f0d-acf4b9c73a7c",
                        "entry_id": "64fe1388-91fe-3168-8d7d-705cfc5b43a5",
                        "glosses": [
                            "субстантивир. своенравный, сумасбродный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231938be-d977-4e04-b67d-2104f9eca4fa",
                                "sense_id": "770ece3b-a5ab-3aa7-9f0d-acf4b9c73a7c",
                                "text": "Все блажные и блаженные окинули Висленева внимательным взглядом, и в дальних рядах, где расслышана была только часть этой рекомендации, прокатило имя monsieur Borne, нового медиума, нового адепта великого нового учения."
                            }
                        ]
                    }
                ],
