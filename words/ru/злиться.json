                {
                    "sense_id": "b0121c9a-257b-3404-b5bc-369dbdcd2d3a",
                    "sense_definition": "Бушевать, проявлять сильную активность или разрушительную силу (о явлениях природы: ветре, вьюге, холоде).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За окном всю ночь <злилась> зимняя вьюга.",
                            "target_lang_translations": {
                                "en": "A winter blizzard <raged> outside the window all night.",
                                "nl": "Buiten het raam <raasde> de hele nacht een winterse sneeuwstorm.",
                                "pl": "Za oknem przez całą noc <w>szalała</w> zimowa zamieć.",
                                "fr": "Dehors, la tempête de neige hivernale a <fait rage> toute la nuit.",
                                "de": "Vor dem Fenster <wütete> die ganze Nacht ein winterlicher Schneesturm.",
                                "es": "Fuera de la ventana, la ventisca invernal <rugió> toda la noche.",
                                "it": "Fuori dalla finestra la bufera invernale ha <imperversato> per tutta la notte.",
                                "tr": "Pencerenin dışında bütün gece kış fırtınası <kuduruyordu>.",
                                "cs": "Za oknem celou noc <zuřila> zimní vánice."
                            }
                        },
                        {
                            "text": "Холодный ветер <злился> и срывал последние листья с деревьев.",
                            "target_lang_translations": {
                                "en": "The cold wind <raged> and tore the last leaves from the trees.",
                                "nl": "De koude wind <ging tekeer> en rukte de laatste bladeren van de bomen.",
                                "pl": "Zimny wiatr <w>szalał</w> i zrywał ostatnie liście z drzew.",
                                "fr": "Le vent froid <se déchaînait> et arrachait les dernières feuilles des arbres.",
                                "de": "Der kalte Wind <tobte> und riss die letzten Blätter von den Bäumen.",
                                "es": "El viento frío <se enfurecía> y arrancaba las últimas hojas de los árboles.",
                                "it": "Il vento freddo <infuriava> e strappava le ultime foglie dagli alberi.",
                                "tr": "Soğuk rüzgar <öfkeyle esiyor> ve ağaçlardan son yaprakları koparıyordu.",
                                "cs": "Studený vítr <řádil> a rval z listnatých stromů poslední listy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ветер злится",
                        "вьюга злится",
                        "мороз злится"
                    ],
                    "target_lang_definitions": {
                        "en": "To rage or show violent force (referring to natural phenomena like wind, blizzards, or cold).",
                        "nl": "Tekeergaan, hevige activiteit of vernietigende kracht vertonen (gezegd van natuurverschijnselen zoals wind, sneeuwstorm of kou).",
                        "pl": "Szaleć, przejawiać silną aktywność lub niszczycielską siłę (o zjawiskach przyrodniczych: wietrze, zamieci, mrozie).",
                        "fr": "Faire rage, se déchaîner, manifester une force destructrice (en parlant des éléments naturels comme le vent, la tempête, le froid).",
                        "de": "Wüten, starke Aktivität oder zerstörerische Kraft zeigen (von Naturerscheinungen wie Wind, Schneesturm, Kälte).",
                        "es": "Rugir, mostrar una fuerza violenta o destructiva (referido a fenómenos naturales como el viento, la ventisca o el frío).",
                        "it": "Infuriare, manifestare una forte attività o forza distruttiva (riferito a fenomeni naturali come vento, tempesta, freddo).",
                        "tr": "Doğa olayları (rüzgar, fırtına, soğuk vb.) için şiddetle esmek, kudurmak veya yıkıcı bir güç göstermek.",
                        "cs": "Zuřit, projevovat silnou aktivitu nebo ničivou sílu (o přírodních jevech: větru, vánici, mrazu)."
                    },
