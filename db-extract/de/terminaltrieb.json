                        "tags": [],
                        "examples": [
                            {
                                "example_id": "074970c9-da5f-4a1f-ac33-85297de2b59d",
                                "sense_id": "81f7a8a6-f77e-3ac0-9b24-d51cf1898233",
                                "text": "Alle Zweige und der Terminaltrieb verlängern sich jährlich um einen Langtrieb. Durch das Zählen der Astquirle ist somit eine Altersabschätzung leicht möglich."
                            },
                            {
                                "example_id": "8aadfbf7-84ce-48e7-9f20-964ff469d037",
                                "sense_id": "81f7a8a6-f77e-3ac0-9b24-d51cf1898233",
                                "text": "Die rötlichen und harzfreien Winterknospen stehen an den Enden von Terminaltrieben."
                            }
                        ],
