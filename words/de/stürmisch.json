                {
                    "sense_id": "b4a0a546-11a8-39bb-86b8-d98f3dc8ae01",
                    "sense_definition": "von vielen Veränderungen, Unruhe oder Krisen geprägt; ereignisreich",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uebertragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Krieg erlebte das Land viele <w>stürmische</w> Zeiten voller Ungewissheit.",
                            "target_lang_translations": {
                                "en": "After the war, the country experienced many <w>turbulent</w> times full of uncertainty.",
                                "ru": "После войны страна пережила немало <w>бурных</w> времён, полных неопределённости.",
                                "nl": "Na de oorlog beleefde het land vele <w>turbulente</w> tijden vol onzekerheid.",
                                "pl": "Po wojnie kraj przeżywał wiele <w>burzliwych</w> czasów pełnych niepewności.",
                                "fr": "Après la guerre, le pays a traversé de nombreuses périodes <w>tumultueuses</w> pleines d'incertitudes.",
                                "it": "Dopo la guerra il paese ha vissuto molti tempi <w>turbolenti</w> pieni di incertezza.",
                                "cs": "Po válce zažívala země mnoho <w>bouřlivých</w> časů plných nejistoty.",
                                "tr": "Savaştan sonra ülke belirsizliklerle dolu birçok <w>çalkantılı</w> dönem yaşadı.",
                                "es": "Tras la guerra, el país vivió muchos tiempos <w>turbulentos</w> llenos de incertidumbre.",
                                "zh": "战后，这个国家经历了许多充满不确定性的<w>动荡的</w>岁月。"
