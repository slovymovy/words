                        "entry_id": "acdffb06-5580-3bd7-be33-883c3c7c83e7",
                        "glosses": [
                            "A French liqueur made at Poissy in north central France from brandy and flavoured with almonds and the pits of apricots."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f075f3b9-cef9-4cf4-bceb-b37a1d26f2bb",
                                "sense_id": "3c839214-0b94-37e0-88ea-fb632cbee75c",
                                "text": "His coffee was excellent, and then came a case of liqueurs, noyau both white and red, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "19078042-38e8-3ec9-9443-216336e456b1",
                        "entry_id": "acdffb06-5580-3bd7-be33-883c3c7c83e7",
                        "glosses": [
                            "A small nucleus or core group of people or animals."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "e6f524b8-6546-4ee5-8c8e-0fb72519cb69",
                                "sense_id": "19078042-38e8-3ec9-9443-216336e456b1",
                                "text": "This \"noyau\" pattern is found among various nocturnal strepsirrhines."
                            },
                            {
                                "example_id": "2be9a8ae-0926-482c-bdcd-dee91524b751",
                                "sense_id": "19078042-38e8-3ec9-9443-216336e456b1",
                                "text": "Borders are violated by hungering males and famished females, and the ordered animosities of the noyau give way to a saturnalia of sexual adventure."
                            },
                            {
                                "example_id": "bac354aa-ae54-4c46-a711-b419910e47b2",
                                "sense_id": "19078042-38e8-3ec9-9443-216336e456b1",
                                "text": "The orangutan (Pongo pygmaeus) also exhibits the noyau system and appears to be the only diurnal primate with a largely solitary lifestyle."
                            }
                        ]
                    }
