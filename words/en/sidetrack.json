{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aad7b004-b2df-344d-aa6c-c03b4da9cb0a",
                    "sense_definition": "To distract someone from a main topic or task by introducing something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I meant to clean my room, but I got <w>sidetracked</w> by an old photo album.",
                            "target_lang_translations": {
                                "ru": "Я собирался убраться в комнате, но меня <w>отвлёк</w> старый фотоальбом."
                            }
                        },
                        {
                            "text": "The speaker tried not to let irrelevant questions <w>sidetrack</w> the discussion.",
                            "target_lang_translations": {
                                "ru": "Докладчик старался не позволять посторонним вопросам <w>увести</w> обсуждение <w>в сторону</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get sidetracked",
                        "easily sidetracked"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отвлекать кого-либо от главной темы или задачи, переключая внимание на что-то другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвлекать",
                                "target_lang_sense_clarification": "уводить чьё-либо внимание от дела"
                            },
                            {
                                "target_lang_word": "уводить в сторону",
                                "target_lang_sense_clarification": "сбивать с основной темы"
                            },
                            {
                                "target_lang_word": "сбивать с мысли",
                                "target_lang_sense_clarification": "мешать сосредоточиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "140e5edc-4e75-3d53-85a0-3ba54abca103",
                    "sense_definition": "To delay, sideline, or interrupt the progress of a project or issue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Budget cuts completely <w>sidetracked</w> the development of the new software.",
                            "target_lang_translations": {
                                "ru": "Сокращение бюджета полностью <w>застопорило</w> разработку нового программного обеспечения."
                            }
                        },
                        {
                            "text": "We cannot allow political disagreements to <w>sidetrack</w> our primary goals.",
                            "target_lang_translations": {
                                "ru": "Мы не можем позволить политическим разногласиям <w>отодвинуть на второй план</w> наши главные цели."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Задерживать, отодвигать на второй план или прерывать реализацию проекта или решение вопроса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тормозить",
                                "target_lang_sense_clarification": "замедлять прогресс"
                            },
                            {
                                "target_lang_word": "отодвигать на второй план",
                                "target_lang_sense_clarification": "замедлять или прерывать развитие"
                            },
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "нарушать обычный ход проекта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fc41ccf-8b1d-318e-994d-e93ac81eeba2",
                    "sense_definition": "To deviate or wander away briefly from the main topic being discussed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To <w>sidetrack</w> for a moment, let me thank everyone who helped organize this event.",
                            "target_lang_translations": {
                                "ru": "Если <w>отвлечься</w> на мгновение, я бы хотел поблагодарить всех, кто помог организовать это мероприятие."
                            }
                        },
                        {
                            "text": "I tend to <w>sidetrack</w> whenever I talk about my favorite childhood memories.",
                            "target_lang_translations": {
                                "ru": "Я часто <w>отклоняюсь от темы</w>, когда говорю о любимых детских воспоминаниях."
                            }
                        }
                    ],
                    "synonyms": [
                        "digress"
                    ],
                    "common_phrases": [
                        "sidetrack for a moment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратковременно отклоняться от темы разговора или обсуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклоняться от темы",
                                "target_lang_sense_clarification": "отвлекаться в разговоре"
                            },
                            {
                                "target_lang_word": "отвлекаться",
                                "target_lang_sense_clarification": "уходить в сторону от сути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e62f470-a2d8-394d-84c4-006628572b92",
                    "sense_definition": "To divert a train onto a secondary track to let other trains pass.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "railway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The controller decided to <w>sidetrack</w> the slower freight train to make way for the express.",
                            "target_lang_translations": {
                                "ru": "Диспетчер решил <w>перевести</w> медленный грузовой поезд <w>на запасный путь</w>, чтобы пропустить экспресс."
                            }
                        },
                        {
                            "text": "They had to <w>sidetrack</w> their train until the faster service cleared the line.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>загнать</w> свой состав <w>на запасный путь</w>, пока более скоростной поезд не освободил линию."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переводить поезд на запасный или тупиковый путь, чтобы пропустить другие поезда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загонять на запасный путь",
                                "target_lang_sense_clarification": "о поездах"
                            },
                            {
                                "target_lang_word": "переводить на тупиковый путь",
                                "target_lang_sense_clarification": "ж.-д."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5169383-0a6d-366b-954a-4f3394f88d59",
                    "sense_definition": "A minor issue, diversion, or line of thought that leads away from the main subject.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stay focused on the presentation instead of pursuing minor <w>sidetracks</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, сосредоточьтесь на презентации вместо того, чтобы вдаваться в мелкие <w>отступления от темы</w>."
                            }
                        },
                        {
                            "text": "His explanation was confusing because it was full of unnecessary <w>sidetracks</w>.",
                            "target_lang_translations": {
                                "ru": "Его объяснение сбивало с толку, поскольку изобиловало лишними <w>отвлечениями</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Второстепенная тема, отвлечение или побочный вопрос, уводящий от главного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отступление от темы",
                                "target_lang_sense_clarification": "побочный разговор"
                            },
                            {
                                "target_lang_word": "отвлечение",
                                "target_lang_sense_clarification": "второстепенная деталь"
                            },
                            {
                                "target_lang_word": "увод в сторону",
                                "target_lang_sense_clarification": "ложный след или боковая тема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27cd28d9-9200-3f7e-8d1f-06ee9770a88c",
                    "sense_definition": "A short section of railroad track branching off the main line, used for loading, unloading, or allowing trains to pass.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "railway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The empty cargo train was parked on a <w>sidetrack</w> near the industrial station.",
                            "target_lang_translations": {
                                "ru": "Пустой грузовой состав стоял на <w>запасном пути</w> рядом с промышленной станцией."
                            }
                        },
                        {
                            "text": "Workers used the <w>sidetrack</w> to load lumber while passenger traffic continued on the main line.",
                            "target_lang_translations": {
                                "ru": "Рабочие использовали <w>подъездной путь</w> для погрузки древесины, пока по главной линии продолжалось пассажирское движение."
                            }
                        }
                    ],
                    "synonyms": [
                        "railroad siding",
                        "siding",
                        "lay-by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий участок железнодорожного пути, ответвляющийся от главной линии для погрузки, разгрузки или разъезда поездов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запасный путь",
                                "target_lang_sense_clarification": "для разъезда или стоянки"
                            },
                            {
                                "target_lang_word": "разъезд",
                                "target_lang_sense_clarification": "ж.-д."
                            },
                            {
                                "target_lang_word": "тупик",
                                "target_lang_sense_clarification": "ж.-д. тупиковый путь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "399e6687-bfc5-3cda-84b2-e5946c2acd30",
                    "sense_definition": "Any secondary railway track running adjacent to the main track.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "railway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Maintenance vehicles were kept on an auxiliary <w>sidetrack</w> behind the depot.",
                            "target_lang_translations": {
                                "ru": "Ремонтная техника стояла на вспомогательном <w>боковом пути</w> позади депо."
                            }
                        },
                        {
                            "text": "The station layout includes several <w>sidetracks</w> for temporary storage.",
                            "target_lang_translations": {
                                "ru": "Схема станции предусматривает несколько <w>запасных путей</w> для временного отстоя поездов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой второстепенный железнодорожный путь, идущий параллельно главному."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боковой путь",
                                "target_lang_sense_clarification": "ж.-д."
                            },
                            {
                                "target_lang_word": "подъездной путь",
                                "target_lang_sense_clarification": "вспомогательный путь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "328d840f-ab79-31ee-8498-367105b38c72",
                    "sense_definition": "A secondary or auxiliary well or tunnel drilled away from an existing borehole or main passage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drilling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers drilled a <w>sidetrack</w> to bypass the blocked section of the oil well.",
                            "target_lang_translations": {
                                "ru": "Инженеры пробурили <w>боковой ствол</w>, чтобы обойти заблокированный участок нефтяной скважины."
                            }
                        },
                        {
                            "text": "The geological team inspected the new <w>sidetrack</w> to evaluate the reservoir.",
                            "target_lang_translations": {
                                "ru": "Геологическая группа обследовала новый <w>боковой ствол</w> для оценки пласта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вторичный или дополнительный наклонный ствол, пробуренный в сторону от основной скважины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боковой ствол",
                                "target_lang_sense_clarification": "бурение скважин"
                            },
                            {
                                "target_lang_word": "ответвление",
                                "target_lang_sense_clarification": "геология и бурение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}