                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a430734-3399-4081-8efb-cfaa85472c2e",
                                "sense_id": "45e1f524-1fc6-3949-a13b-7a3f23c6ec94",
                                "text": "„Auf einem Satellitenfoto der syrischen Stadt Hula ist ein größeres Areal zu sehen, das wohl kürzlich umgegraben worden ist.“"
                            },
                            {
                                "example_id": "bb5c2618-c06c-4582-a82b-e234e3f8f329",
                                "sense_id": "45e1f524-1fc6-3949-a13b-7a3f23c6ec94",
                                "text": "„Vier hatte die Pläne studiert und sich den Straßenverlauf auf Satellitenfotos angesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
