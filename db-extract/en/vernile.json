                        ],
                        "examples": [
                            {
                                "example_id": "d3fc715c-ac95-4e03-82e1-709f9dcb9b9f",
                                "sense_id": "138960b7-3540-3165-a4ae-cf49a40239a4",
                                "text": "But it is a point very little to the praise of either [the Greeks or the Romans], that no vindictive notice was taken of any possible personalities[.] This has been promoted by the example hourly ringing in their ears of vernile scurrility."
                            },
                            {
                                "example_id": "8a6ecb66-b930-45ea-b31e-4eae26d700dc",
                                "sense_id": "138960b7-3540-3165-a4ae-cf49a40239a4",
                                "text": "This scandal of Roman society was not, undoubtedly, a pure product, from the vernile scurrility of which we hear so much in Roman writers—other causes conspired; but certainly the fluency which men of rank exhibited in this popular accomplishment of Billingsgate had been at all times sustained by the models of this kind resounding for ever in the streets of Rome, and in the purlieus of great mansions."
                            },
                            {
                                "example_id": "fd33ce0a-10a5-44f0-9c92-28ed686b316c",
                                "sense_id": "138960b7-3540-3165-a4ae-cf49a40239a4",
                                "text": "'Tis that 'twould wean it from the vile and vernile, / Translate it far beyond the precipice[.]"
                            }
                        ]
                    }
