        "nl-extract.jsonl": [
            {
                "entry_id": "def87c08-e3d4-3c4e-b70c-7227fecb3bde",
                "word": "technologie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ec7f53a4-9493-4743-9186-9060543e4235",
                        "entry_id": "def87c08-e3d4-3c4e-b70c-7227fecb3bde",
                        "tags": [
                            "plural"
                        ],
                        "form": "technologieën"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8155336e-17d0-3b70-a15f-8e491fc321ca",
                        "entry_id": "def87c08-e3d4-3c4e-b70c-7227fecb3bde",
                        "glosses": [
                            "de systematische en praktische toepassing van kennis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9a9384-8ad4-4847-a324-c6db2edd46f4",
                                "sense_id": "8155336e-17d0-3b70-a15f-8e491fc321ca",
                                "text": "De ontwikkeling van de technologie kwam met de Industriële Revolutie in een stroomversnelling."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d7d4556-9cdb-36b8-9928-55880ce125a4",
                        "entry_id": "def87c08-e3d4-3c4e-b70c-7227fecb3bde",
                        "glosses": [
                            "een bepaalde systematische en praktische toepassing van wetenschappelijke kennis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a8f3b9-2f99-460d-b4ea-c6702237606d",
                                "sense_id": "9d7d4556-9cdb-36b8-9928-55880ce125a4",
                                "text": "De ontwikkeling van de computer heeft een grote uitwerking gehad op een heel stel andere technologieën."
                            },
                            {
                                "example_id": "04ef9790-83d3-4bbb-98b8-4456517e3c4d",
                                "sense_id": "9d7d4556-9cdb-36b8-9928-55880ce125a4",
                                "text": "Volgens De Groot hebben andere typen versnellers meer potentie. Een investering in de FCC zou ervoor kunnen zorgen dat die technologieën minder snel ontwikkeld worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d35d1868-27a6-489b-82d2-5ff3a0c894d5",
                        "source_entry_id": "def87c08-e3d4-3c4e-b70c-7227fecb3bde",
                        "target_lang_word": "technology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38970747-5fb0-3d9f-8788-62579b37a17b",
                                        "entry_id": "64349106-8fe9-3449-801b-0b0d013e5c70",
                                        "glosses": [
                                            "The combined application of science and art in practical ways in industry, as for example in designing new machines."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e5f3478-cc14-4039-bd28-51cfc6027256",
                                                "sense_id": "38970747-5fb0-3d9f-8788-62579b37a17b",
                                                "text": "Humankind relies on technology to keep average standard of living higher than it would otherwise be."
                                            },
                                            {
                                                "example_id": "8eab642f-4597-447b-9e11-57d6d72feab2",
                                                "sense_id": "38970747-5fb0-3d9f-8788-62579b37a17b",
                                                "text": "Across Japan, technology companies and private investors are racing to install devices that until recently they had little interest in: solar panels. Massive solar parks are popping up as part of a rapid build-up that one developer likened to an \"explosion.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa142a2-1ac2-316a-8096-9f2de88ab704",
                                        "entry_id": "64349106-8fe9-3449-801b-0b0d013e5c70",
                                        "glosses": [
                                            "Machines or equipment thus designed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c161461-0602-4473-a1a7-c955c7ae5455",
                                                "sense_id": "3fa142a2-1ac2-316a-8096-9f2de88ab704",
                                                "text": "We went to the trade show to see the latest technology on display."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "516b9cfb-0b51-3699-89ac-f99bbc34a8e3",
                                        "entry_id": "64349106-8fe9-3449-801b-0b0d013e5c70",
                                        "glosses": [
                                            "Any useful skill or mechanism that humans have developed or invented (including in prescientific eras)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9deb8a78-e1b8-439f-898a-0f159419a6d8",
                                                "sense_id": "516b9cfb-0b51-3699-89ac-f99bbc34a8e3",
                                                "text": "the incipient metalworking technology of the Bronze Age"
                                            },
                                            {
                                                "example_id": "a80c26c5-9638-4e2c-9dda-71ea32762300",
                                                "sense_id": "516b9cfb-0b51-3699-89ac-f99bbc34a8e3",
                                                "text": "Although it can read data quickly, it is very slow at storing it. That has led the industry on a frantic hunt for alternative storage technologies that might unseat flash.\nMr. Parkin’s new approach, referred to as “racetrack memory,” could outpace both solid-state flash memory chips as well as computer hard disks, making it a technology that could transform not only the storage business but the entire computing industry. […] Since the tiny magnetic domains have to travel only submolecular distances, it is possible to read and write magnetic regions with different polarization as quickly as a single nanosecond — far faster than existing storage technologies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6710005-d111-3692-bf8e-0545fb833412",
                                        "entry_id": "64349106-8fe9-3449-801b-0b0d013e5c70",
                                        "glosses": [
                                            "Any useful trait that has evolved in any organism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18c50077-b30b-42fb-82a2-d52962cc84a3",
                                                "sense_id": "c6710005-d111-3692-bf8e-0545fb833412",
                                                "text": "Comb jellies lack the most impressive 'technology' of jellyfish - the nematocyst stinging apparatus which is one of the most deadly weapons and fastest cellular processes in nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4bbcfd-cc26-3315-8cf1-3b8434e37e2e",
                                        "entry_id": "64349106-8fe9-3449-801b-0b0d013e5c70",
                                        "glosses": [
                                            "The study of or a collection of techniques."
                                        ],
                                        "tags": [
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d49468ff-374e-36c9-a029-c742a6432783",
                                        "entry_id": "64349106-8fe9-3449-801b-0b0d013e5c70",
                                        "glosses": [
                                            "A discourse or treatise on the arts."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bcadc6a-2e73-43a8-8132-66229541e111",
                        "source_entry_id": "def87c08-e3d4-3c4e-b70c-7227fecb3bde",
                        "target_lang_word": "technologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7bd41e-fb48-3455-93d3-81cd70e28ce7",
                                        "entry_id": "bdb9cda8-ac0b-3cd1-a766-dc7836a5c804",
                                        "glosses": [
                                            "Science des techniques, étude systématique des procédés, des méthodes, des techniques, des instruments ou des outils propres ou pas à un ou plusieurs domaines techniques, arts ou métiers."
                                        ],
                                        "tags": [
                                            "Sciences appliquées"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68aa65d3-c6e5-4ba0-b4c8-9108773bdef8",
                                                "sense_id": "fc7bd41e-fb48-3455-93d3-81cd70e28ce7",
                                                "text": "En consacrant la notion de risque technologique majeur, les accidents spectaculaires qui se sont produits au cours de ces dernières années ont définitivement anéanti le mythe d’une technologie sans faille et d’une technocratie ultra-compétente."
                                            },
                                            {
                                                "example_id": "959ee2ec-8af5-4058-a48b-dacf3f936d79",
                                                "sense_id": "fc7bd41e-fb48-3455-93d3-81cd70e28ce7",
                                                "text": "La technique procure ce qu’il faut. La technologie procure ce dont on ignore avoir besoin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fac7f7e-7f05-37a3-b8ab-7120586837dc",
                                        "entry_id": "bdb9cda8-ac0b-3cd1-a766-dc7836a5c804",
                                        "glosses": [
                                            "Ensemble des termes propres à un art, à une science, à un métier."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffd3499b-be74-346a-a56b-cb5c83701442",
                                        "entry_id": "bdb9cda8-ac0b-3cd1-a766-dc7836a5c804",
                                        "glosses": [
                                            "Concept technologique particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5de104f5-aa0e-4572-b9fa-59c5d4c96fbb",
                                                "sense_id": "ffd3499b-be74-346a-a56b-cb5c83701442",
                                                "text": "On serait livré par drone et soigné avec le dernier cri de la technologie médicale : robots chirurgiens, thérapies cellulaires et thérapies géniques."
                                            },
                                            {
                                                "example_id": "554b294b-b6cf-438f-a088-393b27d5c24f",
                                                "sense_id": "ffd3499b-be74-346a-a56b-cb5c83701442",
                                                "text": "Façon d’être, mode de vie, philosophie du geek ou de la geekette, qui implique une dévotion quasi fanatique aux nouvelles technologies, et optionnellement une addiction aux meuporgs et une connaissance encyclopédique de tous les personnages secondaires de Star Wars ou du Seigneur des anneaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddb448bb-4f7a-3c06-ae16-086912c1d33b",
                                        "entry_id": "bdb9cda8-ac0b-3cd1-a766-dc7836a5c804",
                                        "glosses": [
                                            "Par extension, ensemble d'évolutions dans les connaissances ou les recours aux technologiques"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3815dd1-98fd-4f46-8c66-60aea56f19aa",
                                                "sense_id": "ddb448bb-4f7a-3c06-ae16-086912c1d33b",
                                                "text": "« L’architecture de sécurité s’effondre, les modèles économiques établis de longue date se fissurent, la récession s’installe dans les principales économies européennes et la technologie continue de se développer de plus en plus rapidement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
