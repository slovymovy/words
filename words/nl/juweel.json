                    "frequency": "Middle",
                    "semantic_group_id": "edelstenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief stal een ongeslepen <w>juweel</w> uit de kluis van de handelaar.",
                            "target_lang_translations": {
                                "en": "The thief stole an uncut <w>gem</w> from the dealer's safe."
                            }
                        },
                        {
                            "text": "Dit zeldzame <w>juweel</w> schittert prachtig in het felle zonlicht.",
                            "target_lang_translations": {
