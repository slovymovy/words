                    {
                        "translation_id": "3f43bc19-4231-479a-9381-75c173f1b6f0",
                        "source_entry_id": "c511031e-524c-3b19-9180-40479648006c",
                        "source_sense_description": "lather, foam",
                        "target_lang_word": "Seifenlauge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seifenlauge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e97c05a-811e-37a3-8805-51475c4781ab",
                                        "entry_id": "354418d4-2b21-3e6a-8868-6800faaa889d",
                                        "glosses": [
                                            "Lauge aus Seife"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867511c1-9fc7-4ec4-a76b-f7ac97e8b71f",
                                                "sense_id": "4e97c05a-811e-37a3-8805-51475c4781ab",
                                                "text": "„Papa sagte, Seifenlauge könne man auch selber machen, aus Wasser und Palmolive.“"
                                            },
                                            {
                                                "example_id": "9655cb2c-476b-4a94-8025-3751c7952c83",
                                                "sense_id": "4e97c05a-811e-37a3-8805-51475c4781ab",
                                                "text": "„Die einzige Ausnahme war der Waschtag, wenn der Geruch nach Seifenlauge durch die Straße zog und der Dampf in den Himmel.“"
                                            },
                                            {
                                                "example_id": "4bf5aedb-13bd-4e81-9369-b24bb12248b7",
                                                "sense_id": "4e97c05a-811e-37a3-8805-51475c4781ab",
                                                "text": "„Meine Hände wurden durch Seifenlauge und Frost rot und blau; jahrelang sah ich nicht einmal die Reklame eines Kosmetiksalons.“"
                                            },
                                            {
                                                "example_id": "64a80dc0-ef32-45ee-a85e-b56871ee61c6",
                                                "sense_id": "4e97c05a-811e-37a3-8805-51475c4781ab",
                                                "text": "„Der scharfe Geruch ihrer Exkremente konkurrierte mit dem Duft der Seifenlauge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1249223e-7dba-496e-98cb-f32ac7797e97",
                        "source_entry_id": "c511031e-524c-3b19-9180-40479648006c",
                        "source_sense_description": "lather, foam",
                        "target_lang_word": "Schaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17856439-2ed7-3a20-aaf2-3fae365ecc27",
                                        "entry_id": "b00f944a-0611-3e84-967f-ec497bff96e1",
                                        "glosses": [
                                            "Gasbläschen, die von flüssigen Wänden eingeschlossen sind"
                                        ],
                                        "tags": [
                                            "singular",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42e173ac-ca60-4d95-a3ed-27010c96b587",
                                                "sense_id": "17856439-2ed7-3a20-aaf2-3fae365ecc27",
                                                "text": "Wenn man im Seifenwasser planscht, entsteht Schaum."
                                            },
                                            {
                                                "example_id": "dd4088c8-08a6-49f1-9df7-6b74bc218af9",
                                                "sense_id": "17856439-2ed7-3a20-aaf2-3fae365ecc27",
                                                "text": "„Ruhig ließ er ihm die Zügel auf dem Sattelknopf liegen und trat rasch durch die Tür, während sein Pony zuerst den schöngeformten Hals schüttelte, so daß der weiße Schaum ringsum flog, und dann mit dem rechten Vorderhuf den Boden zerscharrte und stampfte, als ob es ungeduldig auf den Herrn warte und die Hetze so schnell wie möglich fortzusetzen wünsche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "adb12a0f-c614-38a0-91eb-1f348259ff36",
                                        "entry_id": "b00f944a-0611-3e84-967f-ec497bff96e1",
                                        "glosses": [
                                            "Gasbläschen, die von festen Wänden eingeschlossen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d607d99-f19b-4ebf-bb81-f84bb87c91cd",
                                                "sense_id": "adb12a0f-c614-38a0-91eb-1f348259ff36",
                                                "text": "Bei der Montage des Fensters wurde zu wenig Schaum verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "70022a52-0130-3b63-8779-71dd2ed6f668",
                                        "entry_id": "b00f944a-0611-3e84-967f-ec497bff96e1",
                                        "glosses": [
                                            "steif geschlagene Masse"
                                        ],
                                        "tags": [
                                            "singular",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73d42be2-ad1b-460e-b06a-d52f35ba113a",
                                                "sense_id": "70022a52-0130-3b63-8779-71dd2ed6f668",
                                                "text": "Vorsichtig das Fruchtpüree unterheben, und den Schaum in die vorbereiteten Portionsgläser füllen."
                                            },
                                            {
                                                "example_id": "96816452-a20c-4056-8325-b9cf5d757e73",
                                                "sense_id": "70022a52-0130-3b63-8779-71dd2ed6f668",
                                                "text": "„Der freundliche Kellner serviert den Eiskaffee mit geschütteltem Schaum direkt an der Liege in vier Variationen, als wir zurück an Land sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9a59e19e-e9c6-365d-bb7f-7fcb9c13522c",
                                        "entry_id": "b00f944a-0611-3e84-967f-ec497bff96e1",
                                        "glosses": [
                                            "unrealistische Vorstellungen, die sich auch schnell verflüchtigen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55782f19-a473-42eb-8e8f-972cdc75209c",
                                                "sense_id": "9a59e19e-e9c6-365d-bb7f-7fcb9c13522c",
                                                "text": "Alles nur Schäume? Alles nur Potemkinsche Dörfer?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
