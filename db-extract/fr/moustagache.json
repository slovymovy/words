                        "examples": [
                            {
                                "example_id": "b1b80922-2e56-4a37-b430-4de8eb5a7d45",
                                "sense_id": "efebace9-9bda-3804-b118-835840fd3343",
                                "text": "Il ponctue cette phrase en lissant avantageusement sa moustagache « Solidarnoch » d’un geste large et suffisant."
                            },
                            {
                                "example_id": "d6398024-f786-4a70-be11-406a66e138d5",
                                "sense_id": "efebace9-9bda-3804-b118-835840fd3343",
                                "text": "Je le nettoye ! Je lui enlève la paille partout... Il se requinque vite les moustagaches... Le voilà paré ! Il remonte au jour…"
                            },
                            {
                                "example_id": "8e2a8ef3-5c10-4357-959f-3ff8ce5ce0e8",
                                "sense_id": "efebace9-9bda-3804-b118-835840fd3343",
                                "text": "Autour de nous, sur la piste, je subodore qu’il y en a ici… de ces gominés à moustagaches fines, les dents blanches et l’œil caressant, qui ont trouvé la bonne gâche, la solution à leurs problèmes financiers les plus pressants."
                            }
                        ]
                    }
