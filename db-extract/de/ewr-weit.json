                ],
                "senses": [
                    {
                        "sense_id": "8bbb1685-a5d2-31c9-9b78-4c6f8d164182",
                        "entry_id": "090cbca1-d55e-3e9b-97d7-3f1991771de6",
                        "glosses": [
                            "das ganze Gebiet des Europäischen Wirtschaftsraums (EWR) umfassend, im gesamten Gebiet des EWR, überall im EWR"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e999205c-0958-46aa-9bf6-dea0f559d200",
                                "sense_id": "8bbb1685-a5d2-31c9-9b78-4c6f8d164182",
                                "text": "„Andererseits gilt die EWR-weite Erschöpfung nicht für Waren, deren Preise staatlich kontrolliert sind (Abs. 5).“"
                            },
                            {
                                "example_id": "431170e0-b19c-4647-89ae-8a32360c0971",
                                "sense_id": "8bbb1685-a5d2-31c9-9b78-4c6f8d164182",
                                "text": "„Diese ist allein auf grobe Marktdaten gestützt, vor allem die Marktanteile der Parteien und die Wettbewerbspreise auf Basis der Annahme fiktiver nationaler, internationaler und EWR-weiter Märkte.“"
                            },
                            {
                                "example_id": "67cf86a5-aaca-4f22-9473-39f40c5c7f29",
                                "sense_id": "8bbb1685-a5d2-31c9-9b78-4c6f8d164182",
                                "text": "„Somit ist von einer EWR-weiten Erschöpfung auszugehen.“"
                            },
                            {
                                "example_id": "5a400264-d38f-4c35-83ed-ed834a6e1608",
                                "sense_id": "8bbb1685-a5d2-31c9-9b78-4c6f8d164182",
