                "senses": [
                    {
                        "sense_id": "ad562303-9abb-3eb1-9dd9-aaf58ba77691",
                        "entry_id": "5db1bbbd-4d95-36ab-802c-4f39f1e65520",
                        "glosses": [
                            "Arzneimittel, welches die Wirkung der Botenstoffe Noradrenalin, Adrenalin und Isoprenalin an den Beta-Rezeptoren hemmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a711fbb2-e92b-4d1e-b93c-c53a4442c418",
                                "sense_id": "ad562303-9abb-3eb1-9dd9-aaf58ba77691",
                                "text": "„Britische Pharmaunternehmen stellen drei der meistverkauften Arzneimittel der Welt her: “Zantac“ (von Glaxo Wellcome) zur Behandlung von Krebs, “Tenormin“ (ICI), ein Betablocker gegen Bluthochdruck, und “AZT“ (Glaxo Wellcome), ein Medikament zur Behandlung von AIDS.“"
                            },
                            {
                                "example_id": "411561a3-6b3e-4796-a7c4-e3a1930bb1d7",
                                "sense_id": "ad562303-9abb-3eb1-9dd9-aaf58ba77691",
                                "text": "„Das Leben von Zuckermans Bruder Henry, einem scheinbar ausgeglichenen Zahnarzt und Familienvater, ist ein so trostloser Trott, dass er sich lieber einer lebensgefährlichen Bypass-Operation unterzieht, als die durch Betablocker hervorgerufene Impotenz in Kauf zu nehmen und auf die Blowjobs seiner Assistentin Wendy zu verzichten.“"
                            },
                            {
                                "example_id": "5cea6f64-4d66-442f-b170-24d6300b91bd",
                                "sense_id": "ad562303-9abb-3eb1-9dd9-aaf58ba77691",
                                "text": "„Es ist Propranolol, ein Betablocker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
