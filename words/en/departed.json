                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dead_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest said a prayer for the souls of the <w>departed</w>.",
                            "target_lang_translations": {
                                "ru": "Священник вознес молитву за души <w>усопших</w>.",
                                "pl": "Ksiądz odmówił modlitwę za dusze <w>zmarłych</w>."
                            }
                        },
                        {
                            "text": "We must always speak well of the <w>departed</w>.",
                            "target_lang_translations": {
