                "senses": [
                    {
                        "sense_id": "b817d4f1-eaeb-370c-b6cb-bd9a257ec795",
                        "entry_id": "e5ce0435-b3f1-367d-9256-18180bf5d42b",
                        "glosses": [
                            "weibliche Person, die einen Einbruch begeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b7fcaa9-222b-4dde-9436-4a3ab5c6ec37",
                                "sense_id": "b817d4f1-eaeb-370c-b6cb-bd9a257ec795",
                                "text": "Die Einbrecherin ist von der Polizei erwischt worden."
                            },
                            {
                                "example_id": "197b671c-3794-4788-aa1e-1f12c148124d",
                                "sense_id": "b817d4f1-eaeb-370c-b6cb-bd9a257ec795",
                                "text": "„Eine Einbrecherin aus New Sarum war zum Tode verurteilt und begnadigt worden.“"
                            },
                            {
                                "example_id": "e0887ec6-86a1-4b2d-bb35-7d3bfa1f3a57",
                                "sense_id": "b817d4f1-eaeb-370c-b6cb-bd9a257ec795",
                                "text": "„Nun war es offenbar gerade dieses Zimmer, das die Einbrecherin sich ausgesucht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e972a314-936c-46c4-965d-cf80270aed35",
                        "source_entry_id": "e5ce0435-b3f1-367d-9256-18180bf5d42b",
                        "source_sense_id": "b817d4f1-eaeb-370c-b6cb-bd9a257ec795",
                        "source_sense_description": "weibliche Person, die einen Einbruch begeht",
                        "target_lang_word": "burglar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burglar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                                        "entry_id": "e50bb4d8-0ab7-3513-83ed-fa0f4b74835c",
                                        "glosses": [
                                            "A person who breaks in to premises with the intent of committing theft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c613a06-fffe-4426-b151-a8f1afa99202",
                                                "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                                                "text": "The burglar made off with a large diamond from the museum."
                                            },
                                            {
                                                "example_id": "6de9896d-8722-4425-a1ee-2cd531a41eeb",
                                                "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                                                "text": "In the village itself his lionheartedness had been a legend ever since he had brained a burglar with a number seven iron, and the jury in Guildford had, despite the clear direction of the judge, resolutely declined to convict him for the use of unnecessary force."
                                            },
                                            {
                                                "example_id": "1d04e474-7b8d-445a-bbe7-c3a62618d0d6",
                                                "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                                                "text": "There’s good reason to worry. In an earlier memoir, “Five-Finger Discount,” Stapinski recreated the terrifying world of swindlers, embezzlers, burglars and mobster wannabes who made up her extended Jersey City family."
                                            },
                                            {
                                                "example_id": "b35edd3d-fb7b-4d1d-8558-a49c82e29109",
                                                "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                                                "text": "Corona, who carries a pistol filled not with bullets but with tequila and drives around in his pickup truck that says “Porder Batrol” on the side, says he was playing pickleball at the time, which allowed the burglar free rein to the territory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "burglar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "363a85b6-6ebb-3d7e-8dc9-18be66b053f4",
                                        "entry_id": "05a92250-63b5-3f9d-aab4-87d5edebf0af",
                                        "glosses": [
                                            "To commit burglary."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e2edf9-8491-44b9-b65e-8e81c1fc5eb7",
                                                "sense_id": "363a85b6-6ebb-3d7e-8dc9-18be66b053f4",
                                                "text": "The latter, with another constable, remained to watch the burglared premises both back and front, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63d582e4-cbfe-43e3-9e85-65fc735b28a6",
                        "source_entry_id": "e5ce0435-b3f1-367d-9256-18180bf5d42b",
                        "source_sense_id": "b817d4f1-eaeb-370c-b6cb-bd9a257ec795",
                        "source_sense_description": "weibliche Person, die einen Einbruch begeht",
                        "target_lang_word": "housebreaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "housebreaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09a47c9c-d55f-3325-a7a1-fc16dd8910d3",
                                        "entry_id": "d4db47ba-ea31-32f7-bc83-8bfa701a40d8",
                                        "glosses": [
                                            "A criminal who breaks into and enters another's house or premises with the intent of committing a crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cb16096-789e-4a4b-b5ba-e6e07cc0662d",
                                                "sense_id": "09a47c9c-d55f-3325-a7a1-fc16dd8910d3",
                                                "text": "[…] here were no Gibers, Cenſurers, Backbiters, Pick-pockets, Highwaymen, Houſebreakers, Attorneys, Bawds, Buffoons, Gameſters, Politicians, Wits, ſplenetick tedious Talkers, Controvertiſts, Raviſhers, Murderers, Robbers, Virtuoſo's; […]"
                                            },
                                            {
                                                "example_id": "2501ef74-7ee2-4e44-9529-a0c5d63bb0ba",
                                                "sense_id": "09a47c9c-d55f-3325-a7a1-fc16dd8910d3",
                                                "text": "[H]e is dressed in such a rapscallion manner that the people would think you were talking to a house-breaker."
                                            },
                                            {
                                                "example_id": "b5e4e713-6f18-4346-b19f-3aadbe007555",
                                                "sense_id": "09a47c9c-d55f-3325-a7a1-fc16dd8910d3",
                                                "text": "The vicar seized a sword and routed the housebreaker, but it was the vicar's wife in a nightgown and coat who caught up with the fleeing intruder, slapped his face and held him by the neck."
                                            },
                                            {
                                                "example_id": "de82753b-534a-4867-a3cc-88bb9c8bdb2a",
                                                "sense_id": "09a47c9c-d55f-3325-a7a1-fc16dd8910d3",
                                                "text": "A serial housebreaker who is believed to have stolen from several homes in Ang Mo Kio last month was nabbed on Tuesday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e545151-df25-4c70-a7b2-b7f88f0a5598",
                        "source_entry_id": "e5ce0435-b3f1-367d-9256-18180bf5d42b",
