                        "source_sense_id": "13a71a43-6f71-3fbf-a1a1-269aad420a1b",
                        "target_lang_word": "groan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07417e6e-b67f-3b2e-978a-bf7dde9a72b7",
                                        "entry_id": "f865c0bc-4b19-3417-911e-3da58f9fa20b",
                                        "glosses": [
                                            "A low, mournful sound uttered in pain or grief."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5920fe6-34db-3a65-b678-3ed50fb6e9c5",
                                        "entry_id": "f865c0bc-4b19-3417-911e-3da58f9fa20b",
                                        "glosses": [
                                            "A low, guttural sound uttered in frustration, disapproval, or ecstasy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64f96621-459a-3a42-9652-b74b552df313",
                                        "entry_id": "f865c0bc-4b19-3417-911e-3da58f9fa20b",
                                        "glosses": [
                                            "A low creaking sound from applied pressure or weight."
                                        ],
                                        "tags": [
                                            "of an object"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "groan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                                        "entry_id": "c792ac03-1225-3edc-8182-38c97fca2017",
                                        "glosses": [
                                            "To make a groan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256fb2af-0e79-45b7-a792-dc866bbd8f29",
                                                "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                                                "text": "We groaned at his awful jokes."
                                            },
                                            {
                                                "example_id": "64ddb276-f3c9-429d-916a-ed120a41a24a",
                                                "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                                                "text": "The wooden table groaned under the weight of the banquet."
                                            },
                                            {
                                                "example_id": "45cdf4f0-bd10-4e7d-aa87-0e03609eacf3",
                                                "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                                                "text": "My Lord of Hereford here whom you call King, / Is a foule traitour to proud Herefords King, / And if you crowne him let me propheſie, / The bloud of Engliſh ſhall manure the ground, / And future ages groane for this foule act, [...]"
                                            },
                                            {
                                                "example_id": "51d5eaca-d10a-40cf-a181-00474c5e36bc",
                                                "sense_id": "5b9b2294-d40f-3c6b-9b6d-6a22a8d20c34",
                                                "text": "Designed to accommodate 60,000 people per day in the 1960s, the main concourse, entrances and passageways around the station were by then positively groaning under the weight of more than 140,000 passengers every 24 hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a1586c-2a32-3d7c-a390-14889fc47395",
                                        "entry_id": "c792ac03-1225-3edc-8182-38c97fca2017",
                                        "glosses": [
                                            "To seemingly creak under the strain of being heavily laden."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76781e13-6203-4922-9015-7e0560e12f0a",
                                                "sense_id": "62a1586c-2a32-3d7c-a390-14889fc47395",
                                                "text": "That night the table in the outer dining room was just groaning with good things."
                                            },
                                            {
                                                "example_id": "2ae4e361-00ad-41c3-83d1-769540c2493b",
                                                "sense_id": "62a1586c-2a32-3d7c-a390-14889fc47395",
                                                "text": "Bookshelves groan under the bloated weight of tomes detailing Great Straight Marriages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54adb875-dc77-3306-be80-de529d42dbbf",
                                        "entry_id": "c792ac03-1225-3edc-8182-38c97fca2017",
                                        "glosses": [
                                            "To strive after earnestly, as if with groans."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cc47df6-c686-4ef5-b13c-0b68064bade3",
                                                "sense_id": "54adb875-dc77-3306-be80-de529d42dbbf",
                                                "text": "Nothing but holy, pure, and clear, / Or that which groaneth to be so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28b843c5-4e3b-4926-a404-49a1016768de",
                        "source_entry_id": "9c21c35c-c6af-39e0-a68b-b2cadb3c6bca",
                        "source_sense_id": "13a71a43-6f71-3fbf-a1a1-269aad420a1b",
                        "target_lang_word": "sigh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sigh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6bafcbd-39ba-388b-b429-2e62115fa9f4",
                                        "entry_id": "34ce3a18-ff35-30b2-8ec5-f028fb835cc2",
                                        "glosses": [
                                            "A deep, prolonged audible inhale and exhale of breath; as when fatigued, frustrated, grieved, or relieved; the act of sighing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74be4638-6fb0-4585-bee9-819cd37966fa",
                                                "sense_id": "b6bafcbd-39ba-388b-b429-2e62115fa9f4",
                                                "text": "To Pollyanna the air was all the more stifling after that cool breath of the out of doors; but she did not complain. She only drew a long quivering sigh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9325825b-40ff-3240-898d-79a892c76f8a",
                                        "entry_id": "34ce3a18-ff35-30b2-8ec5-f028fb835cc2",
                                        "glosses": [
                                            "a manifestation of grief; a lament."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "872553a7-4766-311d-b98b-5817a1e12b13",
                                        "entry_id": "34ce3a18-ff35-30b2-8ec5-f028fb835cc2",
                                        "glosses": [
                                            "A person who is bored."
                                        ],
                                        "tags": [
                                            "Cockney",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sigh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e488e808-7992-3a77-a2db-d0a2ba61ae9b",
                                        "entry_id": "9aeb2238-c3c3-3516-b0e2-316cf867f5b8",
                                        "glosses": [
                                            "To inhale a larger quantity of air than usual, and immediately expel it; to make a deep single audible respiration, especially as the result or involuntary expression of fatigue, exhaustion, grief, sorrow, frustration, or the like."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78ab9d34-d362-4307-953a-88b4adb12d81",
                                                "sense_id": "e488e808-7992-3a77-a2db-d0a2ba61ae9b",
                                                "text": "When she saw it wasn't damaged, she sighed with relief."
                                            },
                                            {
                                                "example_id": "348e37b5-3bb9-4797-9dd4-fb4f2429a921",
                                                "sense_id": "e488e808-7992-3a77-a2db-d0a2ba61ae9b",
                                                "text": "He sighed. It was going to be a long night."
                                            },
                                            {
                                                "example_id": "d9f90cbd-ceb8-495e-b2e7-4d57e1294b4b",
                                                "sense_id": "e488e808-7992-3a77-a2db-d0a2ba61ae9b",
                                                "text": "He sighed over the lost opportunity."
                                            },
                                            {
                                                "example_id": "dd5190ec-c0a1-493f-aef0-2131247e3409",
                                                "sense_id": "e488e808-7992-3a77-a2db-d0a2ba61ae9b",
                                                "text": "A waiter brought his aperitif, which was a small scotch and soda, and as he sipped it gratefully he sighed.\n ‘Civilized,’ he said to Mr. Campion. ‘Humanizing.’ […] ‘Cigars and summer days and women in big hats with swansdown face-powder, that's what it reminds me of.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2016f98-1887-3f4a-9c56-926ced727e61",
                                        "entry_id": "9aeb2238-c3c3-3516-b0e2-316cf867f5b8",
                                        "glosses": [
                                            "To lament; to grieve."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0872647-4848-4c82-bba7-076ed683bb8d",
                                                "sense_id": "a2016f98-1887-3f4a-9c56-926ced727e61",
                                                "text": "He sighed deeply in his spirit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6573d505-0779-33c7-81cf-1d67db49debc",
                                        "entry_id": "9aeb2238-c3c3-3516-b0e2-316cf867f5b8",
                                        "glosses": [
                                            "To utter sighs over; to lament or mourn over."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22911ff0-986e-4ea7-9181-1de9207a8089",
                                                "sense_id": "6573d505-0779-33c7-81cf-1d67db49debc",
                                                "text": "Ages to come, and men unborn, / Shall bless her name, and sigh her fate."
                                            },
                                            {
                                                "example_id": "54d4bd9b-f5a5-4a15-9176-17f16d4c0ae9",
                                                "sense_id": "6573d505-0779-33c7-81cf-1d67db49debc",
                                                "text": "The lassie had grace given her to refuse, but with a woeful heart, and Heriotside rode off in black discontent, leaving poor Ailie to sigh her love. He came back the next day and the next, but aye he got the same answer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ac6851e-e620-3da4-ae03-cd8985d6b423",
                                        "entry_id": "9aeb2238-c3c3-3516-b0e2-316cf867f5b8",
                                        "glosses": [
                                            "To make a sound like sighing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff168a3-f3e5-4f56-a234-0e8456713d68",
                                                "sense_id": "0ac6851e-e620-3da4-ae03-cd8985d6b423",
                                                "text": "And the coming wind did roar more loud, / And the sails did sigh like sedge."
                                            },
                                            {
                                                "example_id": "d8d33072-0201-4392-bfbd-7c0d5ad4809c",
                                                "sense_id": "0ac6851e-e620-3da4-ae03-cd8985d6b423",
                                                "text": "The winter winds are wearily sighing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9730cd2c-9ce2-37b9-a032-fdc4f6572925",
                                        "entry_id": "9aeb2238-c3c3-3516-b0e2-316cf867f5b8",
                                        "glosses": [
                                            "To exhale (the breath) in sighs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "015fc149-5c2d-4875-a60d-44294e1f81c5",
                                                "sense_id": "9730cd2c-9ce2-37b9-a032-fdc4f6572925",
                                                "text": "She sighed a sigh that was nearly a groan."
                                            },
                                            {
                                                "example_id": "5ba70d3b-8f87-43a2-bf7e-33270f12687f",
                                                "sense_id": "9730cd2c-9ce2-37b9-a032-fdc4f6572925",
                                                "text": "sigh a note and sing a note"
                                            },
                                            {
                                                "example_id": "cca7b0de-cbc9-4a2d-9002-7bae4b6f82c6",
                                                "sense_id": "9730cd2c-9ce2-37b9-a032-fdc4f6572925",
                                                "text": "Never man sighed truer breath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1fe11d7-642c-3ed0-9dde-f28aeeca3e22",
                                        "entry_id": "9aeb2238-c3c3-3516-b0e2-316cf867f5b8",
                                        "glosses": [
                                            "To express by sighs; to utter in or with sighs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4c1bccc-1ce6-4307-9f41-ae5db2ce4254",
                                                "sense_id": "b1fe11d7-642c-3ed0-9dde-f28aeeca3e22",
                                                "text": "\"I guess I have no choice,\" she sighed."
                                            },
                                            {
                                                "example_id": "b1efc909-8493-4c67-96d1-abe6332873d3",
                                                "sense_id": "b1fe11d7-642c-3ed0-9dde-f28aeeca3e22",
                                                "text": "She sighed her frustrations."
                                            },
                                            {
                                                "example_id": "0851a674-dfe6-49e6-89b3-1af30fd08f48",
                                                "sense_id": "b1fe11d7-642c-3ed0-9dde-f28aeeca3e22",
                                                "text": "They […] sighed forth proverbs."
                                            },
                                            {
                                                "example_id": "777bd283-deef-4060-bd5b-d41fb5eb17a9",
                                                "sense_id": "b1fe11d7-642c-3ed0-9dde-f28aeeca3e22",
                                                "text": "The gentle swain […] sighs back her grief."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sigh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91dc5151-7c13-37b7-8c8f-1de0a4998ce8",
                                        "entry_id": "ec5961de-6632-3f93-a6a2-21ef80b73e77",
                                        "glosses": [
                                            "An expression of fatigue, exhaustion, grief, sorrow, frustration, or the like, often used in casual written contexts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "429420dc-251f-4997-8550-43bc5204ffae",
                                                "sense_id": "91dc5151-7c13-37b7-8c8f-1de0a4998ce8",
                                                "text": "Sigh, I'm so bored at work today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5800b7de-8f15-4e25-b033-de167451c301",
                        "source_entry_id": "9c21c35c-c6af-39e0-a68b-b2cadb3c6bca",
                        "source_sense_id": "13a71a43-6f71-3fbf-a1a1-269aad420a1b",
                        "target_lang_word": "moan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15cb0772-36bf-3d28-914d-a725e32a36a2",
                                        "entry_id": "1cda5c06-7ee7-3aee-9567-93bc1f493a85",
                                        "glosses": [
                                            "A low, mournful cry of pain, sorrow or pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2326a4f7-64c9-4dc7-a71d-7c90d90cdc5f",
                                                "sense_id": "15cb0772-36bf-3d28-914d-a725e32a36a2",
                                                "text": "let out a deep moan"
                                            },
                                            {
                                                "example_id": "13ed8487-cbad-4d47-9217-183c5ce96914",
                                                "sense_id": "15cb0772-36bf-3d28-914d-a725e32a36a2",
                                                "text": "We heard the distant moan of a stag in pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ae47615-a614-3a35-ae85-44581c04c795",
                                        "entry_id": "1cda5c06-7ee7-3aee-9567-93bc1f493a85",
                                        "glosses": [
                                            "A lament or sorrow."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4041a9f8-7aac-491b-a5d8-9073dd9c346f",
                                                "sense_id": "8ae47615-a614-3a35-ae85-44581c04c795",
                                                "text": "to make one's moan",
                                                "translation": "to grieve, complain",
                                                "english": "to grieve, complain"
                                            },
                                            {
                                                "example_id": "09490f9e-6da7-4d09-b9bb-fd982767b75c",
                                                "sense_id": "8ae47615-a614-3a35-ae85-44581c04c795",
                                                "text": "it shall be my daily grief and moan, that I am so dull, & do so little[…]But if when all is done that we can do, you will leave us nothing but our tears and moans for self-destroyers, the sin is yours, and the suffering shall be yours."
                                            },
                                            {
                                                "example_id": "70ce6faf-14a0-47cc-aa34-33d4746595a3",
                                                "sense_id": "8ae47615-a614-3a35-ae85-44581c04c795",
                                                "text": "to thee therefore oh Lord do I make my moan, to thee I render my humble petition, and pour out my soul which hath sinned against thee: Oh Lord, I beseech thee for thy infinite mercy in Jesus Christ, to take pity upon mee[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
