                                                "sense_id": "7bdc934d-0138-32b8-a8ac-98e398258a28",
                                                "text": "„Der »Vorlauf«, der erste Saft, der mit den Füßen ausgestampft wurde, wie auch der Krätzer, der für Salzlake bestimmte saure Wein, wurde möglichst verkauft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "373d45bc-2102-357f-b321-799b163c5c33",
                                        "entry_id": "c27a533a-600e-369e-8fb5-96e0cfe15643",
