                ],
                "senses": [
                    {
                        "sense_id": "d1bc5be6-d700-39b1-8716-ae530096f93f",
                        "entry_id": "a123784d-797b-3533-93d9-7842b5812987",
                        "glosses": [
                            "imię męskie Paweł"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "9f4a34ff-1af9-4ba9-aacd-b843f862643f",
                                "sense_id": "d1bc5be6-d700-39b1-8716-ae530096f93f",
                                "text": "Kingo, daj już Pawełkowi spokój."
                            },
                            {
                                "example_id": "ea3a4e4d-1690-414f-b49c-ecfc7ad4bfc1",
                                "sense_id": "d1bc5be6-d700-39b1-8716-ae530096f93f",
                                "text": "Chłopaki zaciągnęli go do kina, potem Pawełek zdobył bilety na recital Ewy Demarczyk, a potem był mecz hokejowy Polska – NRD, na który poszli całą gromadą i na przemian to wrzeszczeli, to dęli w trąbki, dopingując swojaków."
                            },
                            {
                                "example_id": "322f8d68-203d-42b3-941e-6353f00d4505",
                                "sense_id": "d1bc5be6-d700-39b1-8716-ae530096f93f",
                                "text": "Pawełek Kryński wkraczał zatem w okres, kiedy miłość i śmierć stają się nieodłącznymi przyjaciółkami mężczyzny."
                            },
                            {
                                "example_id": "803694a7-a65c-46fd-96fe-a965326aec00",
                                "sense_id": "d1bc5be6-d700-39b1-8716-ae530096f93f",
                                "text": "(…) Kaźmierz mówił przez ściśnięte gardło, przytulając do piersi Pawełka, przestraszonego widokiem Kargula."
                            },
                            {
                                "example_id": "b9509b1f-082b-4596-90f7-e526c187bf09",
                                "sense_id": "d1bc5be6-d700-39b1-8716-ae530096f93f",
                                "text": "Pawełek zaczął to oczekiwanie od uchylenia żółtych drzwi, dzięki czemu widzieli i słyszeli wszystko, co działo się wewnątrz."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
