                    },
                    {
                        "translation_id": "4761ce2c-26d0-4288-8e28-fe04fab21330",
                        "source_entry_id": "22ad5835-8d6a-31b5-b4dd-f97e1840e346",
                        "source_sense_id": "1b0af0b2-bf52-3129-853c-0d77a12d384a",
                        "source_sense_description": "de sojaplant is een peulvrucht waarvan de boon als grondstof dient voor veel producten",
                        "target_lang_word": "soja",
