    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29443de2-a9c0-3ded-a615-51bc998915cb",
                    "sense_definition": "To make it difficult for someone to do something or for something to happen by acting as an obstacle.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "obstruct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A severe drought <w>hinders</w> the growth of plants and reduces the overall crop yield.",
                            "target_lang_translations": {
                                "ru": "Сильная засуха <w>препятствует</w> росту растений и снижает общий урожай."
                            }
                        },
                        {
                            "text": "The lack of funding will <w>hinder</w> progress on the new community center project.",
                            "target_lang_translations": {
                                "ru": "Нехватка финансирования будет <w>мешать</w> прогрессу проекта нового общественного центра."
                            }
                        }
                    ],
                    "synonyms": [
                        "hamper",
                        "obstruct",
                        "thwart",
                        "frustrate"
                    ],
                    "antonyms": [
                        "assist",
                        "expedite",
                        "facilitate",
                        "help"
                    ],
                    "common_phrases": [
                        "hinder progress",
                        "hinder growth",
                        "hinder development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Затруднять выполнение какого-либо действия или процесса, выступая в качестве препятствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "создавать преграды для развития или действия"
                            },
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "создавать помехи в работе или прогрессе"
                            },
                            {
                                "target_lang_word": "затруднять",
                                "target_lang_sense_clarification": "делать процесс более сложным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5790ab9-6a92-3171-8c6b-2a9d5cc789af",
                    "sense_definition": "To delay or stop someone or something from moving forward or happening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obstruct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy snow began to <w>hinder</w> traffic throughout the city during the morning rush hour.",
