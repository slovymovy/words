                ],
                "senses": [
                    {
                        "sense_id": "e410cbb5-b8e6-3b32-beac-8291c8c438c2",
                        "entry_id": "f92929be-72ea-3339-be01-8bbdffc268f4",
                        "glosses": [
                            "Tintement argentin."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "450889d2-de0b-47be-a7f1-b8d90792d5ec",
                                "sense_id": "e410cbb5-b8e6-3b32-beac-8291c8c438c2",
                                "text": "Le matin, de bonne heure, j’entendais s’élever de la chaussée le tintinnabulement de mille petites sonnettes : c’était les troupeaux des chèvres qui descendaient vers la ville."
                            },
                            {
                                "example_id": "ff4418bf-6cb2-4326-9df8-c54f5b655446",
                                "sense_id": "e410cbb5-b8e6-3b32-beac-8291c8c438c2",
                                "text": "On entend peu à peu le timbre incertain, fissuré, de leurs voix, et en dessous, à peine perceptible, le chuchotement confus des voix mêlées aux tintinnabulements des verres entrechoqués."
                            },
                            {
                                "example_id": "8763eece-e856-4f74-aac5-27e00bdc47bd",
                                "sense_id": "e410cbb5-b8e6-3b32-beac-8291c8c438c2",
                                "text": "Effluves de citron vert, tintinnabulement des glaçons, Jean-Louis Antoine nous accueille un ti-punch à la main…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbcfbb77-f330-4914-b7b2-25344a1a8a2c",
                        "source_entry_id": "f92929be-72ea-3339-be01-8bbdffc268f4",
                        "source_sense_id": "e410cbb5-b8e6-3b32-beac-8291c8c438c2",
                        "target_lang_word": "tintinnabulation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tintinnabulation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f873eceb-e539-3f96-8a35-17eb10ef16df",
                                        "entry_id": "4354c072-f22d-3285-8db8-6b2022fbc125",
                                        "glosses": [
                                            "A tinklingsound, as of a bell or of breaking glass."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a4ee8a4-0356-469e-b829-a317db6b89e9",
                                                "sense_id": "f873eceb-e539-3f96-8a35-17eb10ef16df",
                                                "text": "Across the darkling meadows, from the heights of Hare, the tintinnabulation sounded mournfully, penetrating the curl-wreathed tympanums of Lady Parvula de Panzoust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "250a3dd7-46d7-3b82-8483-9bf71a5f3a40",
                                        "entry_id": "4354c072-f22d-3285-8db8-6b2022fbc125",
                                        "glosses": [
                                            "The ringing of bells."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45693ae3-49cf-49bd-9a73-6f6c1e1e42df",
                                                "sense_id": "250a3dd7-46d7-3b82-8483-9bf71a5f3a40",
                                                "text": "Keeping time, time, time,\nIn a sort of Runic rhyme,\nTo the tintinnabulation that so musically wells\nFrom the bells, bells, bells, bells,\nBells, bells, bells —\nFrom the jingling and the tinkling of the bells."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
