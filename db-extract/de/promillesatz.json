                "senses": [
                    {
                        "sense_id": "d59facf9-dc5a-38d2-993d-b4ed59ab8135",
                        "entry_id": "a3eea503-1a45-37be-8a7f-8a92a0293dbb",
                        "glosses": [
                            "in Tausendstel festgelegter, genannter Anteil eines Betrags, einer Größe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e732f6ab-6d5b-48e3-8fb1-32664b00d487",
                                "sense_id": "d59facf9-dc5a-38d2-993d-b4ed59ab8135",
                                "text": "„Während die privaten Banken unabhängig von der akuten Gefahr jährlich einen festen Promillesatz auf ihre Kundenverbindlichkeiten an den Einlagensicherungsfonds abführen müssen, kam die Protektor-Gründung bislang ausgesprochen günstig. Genau genommen wurde nicht mehr als eine Unternehmenshülle geschaffen.“"
                            },
                            {
                                "example_id": "ad94a232-d961-46a3-9572-26894ce20094",
                                "sense_id": "d59facf9-dc5a-38d2-993d-b4ed59ab8135",
                                "text": "„Die Konzerne versteuern ihre Gewinne – wenn überhaupt – im Ausland zu Promillesätzen.“"
                            },
                            {
                                "example_id": "8e3ec2c9-bd0e-4322-8f87-0801444deaf4",
                                "sense_id": "d59facf9-dc5a-38d2-993d-b4ed59ab8135",
                                "text": "„Und man muss ja sehen, dass wir hier von einem Promillesatz an Personen reden, der für Ärger sorgen könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
