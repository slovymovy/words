                    }
                ],
                "senses": [
                    {
                        "sense_id": "96877c7c-7677-32a6-8d7c-ace016ef2c95",
                        "entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
                        "glosses": [
                            "A battleship, especially of the World War I era, in which most of the firepower is concentrated in large guns that are of the same caliber."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "716e9821-ef9d-40f2-bcae-e0af7227b50d",
                                "sense_id": "96877c7c-7677-32a6-8d7c-ace016ef2c95",
                                "text": "Perturbed at being overtaken, the USS Texas is leading the 6th Battle Squadron at 22-and-a-half knots as the engineers pour everything they have into the effort. Behind the colossal clouds of smoke and cinders they put out come a seemingly-endless stream of dreadnoughts, battle flags flying from every mast and line they can find. It is the Grand Fleet."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3aa7d7d-8149-3069-83d5-27115ca3a6d0",
                        "entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
                        "glosses": [
                            "A battleship, especially of the World War I era, in which most of the firepower is concentrated in large guns that are of the same caliber.",
                            "Any type of warship heavier in armour or armament than a typical battleship."
                        ],
                        "tags": [
                            "historical",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "4cdb5503-43da-4184-b400-63e014efab8d",
                                "sense_id": "e3aa7d7d-8149-3069-83d5-27115ca3a6d0",
                                "text": "Sovereign is the flagship of the rogue Spectre Saren. An enormous dreadnought larger than any other ship in any known fleet, Sovereign is crewed with both geth and krogan. At two kilometers long, its spinal-mounted main gun is likely capable of penetrating another dreadnought's kinetic barriers with a single shot."
                            }
                        ]
                    },
                    {
                        "sense_id": "692c6630-bcde-3eae-9fb3-21b49e62c5b2",
                        "entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
                        "glosses": [
                            "One that is the largest or the most powerful of its kind."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0d6aea89-3898-47ac-b90e-98e4b831fa24",
                                "sense_id": "692c6630-bcde-3eae-9fb3-21b49e62c5b2",
                                "text": "Herbert steering the dreadnought limousine through the night, black cap on his black head."
                            }
                        ]
                    },
                    {
                        "sense_id": "795f672c-1792-3232-a641-523c1f836e14",
                        "entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
                        "glosses": [
                            "One that is the largest or the most powerful of its kind.",
                            "A type of acoustic guitar with a very large body and a waist that is less pronounced than on other guitar shapes, producing a deep, bold sound."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e0663135-1715-35ea-9d4e-e621f6f93e31",
                        "entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
                        "glosses": [
                            "One that is the largest or the most powerful of its kind.",
                            "A garment made of thick woollen cloth that can defend against storm and cold."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b68ab827-74c7-4ba1-92b4-c803bd00d905",
                                "sense_id": "e0663135-1715-35ea-9d4e-e621f6f93e31",
                                "text": "\"Much obliged to you, ma'am!\" says Mr. Guppy, divesting himself of his wet dreadnought in the hall."
                            }
                        ]
                    },
                    {
                        "sense_id": "64247157-f701-3592-9bfa-755103ecf68b",
                        "entry_id": "89744083-ef69-3f9e-9851-12a3b7a829ae",
                        "glosses": [
                            "One that is the largest or the most powerful of its kind.",
                            "The cloth itself; fearnaught."
                        ],
