                "senses": [
                    {
                        "sense_id": "c14fc635-1c73-3025-8dcd-e328a72eaea8",
                        "entry_id": "4a5f5362-f503-3389-bb78-b39d24662214",
                        "glosses": [
                            "systematische zielorientierte Gestaltung eines Spielgeschehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21ca3660-1a07-46cb-90f0-c0f88f277c5e",
                                "sense_id": "c14fc635-1c73-3025-8dcd-e328a72eaea8",
                                "text": "„Im Fußball können sie einzelne Spielsequenzen, wie etwa die Rückeroberung des Balles oder den Spielaufbau, automatisch identifizieren.“"
                            },
                            {
                                "example_id": "838735d3-5687-448d-bd20-370c27f7a568",
                                "sense_id": "c14fc635-1c73-3025-8dcd-e328a72eaea8",
                                "text": "„Der Grieche ist zwar kein Genie im Spielaufbau, hat jedoch Härte, kann Gegner bekämpfen, auch beim Kopfball.“"
                            },
                            {
                                "example_id": "37a8037c-56be-4b1f-90c4-1ef2ca245ef7",
                                "sense_id": "c14fc635-1c73-3025-8dcd-e328a72eaea8",
                                "text": "„In der ersten Phase waren die Deutschen im Spielaufbau und balltechnisch absurd unterlegen.“"
                            },
                            {
                                "example_id": "08aadba7-f2c7-4800-afab-eeef0c8a5822",
                                "sense_id": "c14fc635-1c73-3025-8dcd-e328a72eaea8",
                                "text": "„Die Freiburger brachten hingegen kaum einen kontrollierten Spielaufbau zustande.“"
                            },
                            {
                                "example_id": "fb66cb25-87ea-43e9-ba55-8aae276203a8",
                                "sense_id": "c14fc635-1c73-3025-8dcd-e328a72eaea8",
                                "text": "„Um den FC Bayern von Pep Guardiola auskontern zu können, konzipierte Ancelotti ein ausgeklügeltes Defensivsystem, das den dominanten Spielaufbau der Bayern fast komplett neutralisierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
