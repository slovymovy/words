                            {
                                "example_id": "305220ba-e283-452a-a66e-a2679729e2ba",
                                "sense_id": "7ecda8a4-e3d1-3a14-ab6a-1f08bff45b56",
                                "text": "Wziął wiatr brata za kamrata, / Teraz z nim po polu lata, / Gonią obaj chmury, ptaki, / Mkną, wplątują się w wiatraki,"
                            }
                        ],
