                ],
                "senses": [
                    {
                        "sense_id": "ace4c71f-2744-3817-b54a-b653517b44cc",
                        "entry_id": "8187f87e-e72c-3481-9265-56b5748ee172",
                        "glosses": [
                            "A variety of grape grown in eastern Hungary and in eastern Slovakia."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bc667f50-9a58-3b3a-a2ab-e2d6f121e723",
                        "entry_id": "8187f87e-e72c-3481-9265-56b5748ee172",
                        "glosses": [
                            "Any of a variety of white wines made from this grape."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fb9aa97b-6a90-4387-bf09-aa07e641d9d0",
                                "sense_id": "bc667f50-9a58-3b3a-a2ab-e2d6f121e723",
                                "text": "It was made from the furmint grape, which is better known in Hungary’s lusciously sweet tokays, but this was delicate, floral and just right with a tart chicken curry dish."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53944942-a988-46c8-87bb-77b7fb2b2677",
                        "source_entry_id": "8187f87e-e72c-3481-9265-56b5748ee172",
                        "source_sense_description": "variety of grape",
                        "target_lang_word": "tokay",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tokay",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "471b7641-92db-3b85-88d0-4de4e75dd8cc",
                                        "entry_id": "c5972e70-5ef5-3654-a9c6-3baf7467dd14",
                                        "glosses": [
                                            "Vin liquoreux de Hongrie que l'on produit avec le cépage furmint, entre autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b9fb010-0c97-4756-b979-55d569418b95",
                                                "sense_id": "471b7641-92db-3b85-88d0-4de4e75dd8cc",
                                                "text": "Pour comble de félicité,\nVous possédez, dans votre cave,\nDe ce tokai dont j'ai tâté."
                                            },
                                            {
                                                "example_id": "8040d05f-8a31-4dbc-98d5-758533757eeb",
                                                "sense_id": "471b7641-92db-3b85-88d0-4de4e75dd8cc",
                                                "text": "Je mangeai cependant de bon appétit quelques écrevisses, une aile de poulet arrosée d’un peu de vin de Tokay qu’il avait apporté lui-même, me disait-il, des caves de Kœnisgberg, fréquentées autrefois par Falstaff."
                                            },
                                            {
                                                "example_id": "dbc6492f-c040-49b3-80e4-3e44eea5faf1",
                                                "sense_id": "471b7641-92db-3b85-88d0-4de4e75dd8cc",
                                                "text": "Dans la salle à manger, de quel air il tourne la clef du buffet ! L’enfant sait bien que ce n’est là qu’un jeu, mais l’oncle y semble pris lui-même. Il renifle comme pour flairer où cela sent le meilleur ; s’empare d’une bouteille de tokay ; en verse deux petits verres où tremper des biscuits ; il invite à trinquer, un doigt sur les lèvres ; le cristal sonne imperceptiblement…"
                                            },
                                            {
                                                "example_id": "eab8a717-9484-49f8-89b3-8522b07f1bd6",
                                                "sense_id": "471b7641-92db-3b85-88d0-4de4e75dd8cc",
                                                "text": "– Un verre de tokay à jeun, mon enfant, rien de tel pour vous décaper les papilles de la langue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cab0cc4-2540-39ab-8356-96a9a2d235d7",
                                        "entry_id": "c5972e70-5ef5-3654-a9c6-3baf7467dd14",
                                        "glosses": [
                                            "Synonyme de pinot gris en Alsace où on le nomme aussi tokay d'Alsace. Il est à noter que ce cépage n'est pas utilisé pour produire le vin nommé tokay."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
