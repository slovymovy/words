                        "examples": [
                            {
                                "example_id": "0d4f7cee-4b3f-4717-a8dc-e2aa445e2c7f",
                                "sense_id": "b7216352-6c80-3cb3-bb67-2a5b26be2c57",
                                "text": "„Die gůts haben gethon/ und die gerechten werden gehn ins ewig leben/ Die aber vbels haben gethon/ vnnd nit bůß gethon in den tagen des hails/werden gehn in die ewige peyn. Matth.25.Johan.5.“"
                            },
                            {
                                "example_id": "e17bedda-78d5-4bd3-a9c8-b29b39f29df4",
                                "sense_id": "b7216352-6c80-3cb3-bb67-2a5b26be2c57",
                                "text": "„Haben die Mädchen das 15te Jahr erreicht, ſo müſſen ſie in Dienﬅe gehn.“"
                            },
                            {
                                "example_id": "991e375d-4bd2-41d8-b6d7-01002c19d193",
                                "sense_id": "b7216352-6c80-3cb3-bb67-2a5b26be2c57",
                                "text": "„Das soll mich nicht hindern, nach Hause zu gehn; es ist spät und morgen früh habe ich Amt; man schläft dort schlecht.“"
                            },
                            {
                                "example_id": "d44d6c9d-8698-4b91-b5de-038ce5591be2",
                                "sense_id": "b7216352-6c80-3cb3-bb67-2a5b26be2c57",
                                "text": "„Ich soll spazieren gehn, kurztreten und viel spazieren gehn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
