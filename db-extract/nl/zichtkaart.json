                        "examples": [
                            {
                                "example_id": "ab77c0ac-baa9-403a-b471-62c85457a877",
                                "sense_id": "5ae8a4a7-c8be-3d5e-b2af-f882c7352cba",
                                "text": "Volgens schattingen zijn ongeveer 16.000 inwoners van Enschede zeventig jaar of ouder. Zij krijgen op korte termijn een brief waarin de gemeente de aanmeldingsprocedure uit de doeken doet. Mensen die gebruik gaan maken van het gratis openbaar vervoer moeten een persoonlijke kaart (ov70+) aanvragen bij de gemeente. Gebruikers ontvangen vervolgens thuis een zogenoemde ‘persoonlijke zichtkaart’. Die kunnen ze aan de chauffeur laten zien en dan gratis met de bus."
                            }
                        ]
                    },
