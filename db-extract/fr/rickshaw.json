                "senses": [
                    {
                        "sense_id": "6e657bf3-1262-389b-85e9-4176bd0d540e",
                        "entry_id": "f4993751-af57-3a7a-b6d5-fdfa2f47fcdb",
                        "glosses": [
                            "Véhicule tricycle à propulsion humaine ou mécanique, destiné au transport de personnes et de marchandises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db074719-5173-45c7-9970-0206eccc3f6d",
                                "sense_id": "6e657bf3-1262-389b-85e9-4176bd0d540e",
                                "text": "Mais à leurs pieds passent les touk-touk, des sortes de rickshaws."
                            },
                            {
                                "example_id": "749bca04-15c8-4690-9aa8-36607d3e82ab",
                                "sense_id": "6e657bf3-1262-389b-85e9-4176bd0d540e",
                                "text": "À soixante et un ans, au Bangladesh, Joynal Abedin pédale toute la journée sur un rickshaw, un moyen de transport commun en Asie qui est un gros tricycle muni d'une banquette arrière prévue pour deux personnes mais sur laquelle il n'est pas rare que trois ou quatre passagers prennent place."
                            },
                            {
                                "example_id": "6318e283-2765-48be-9d71-06f7625554d4",
                                "sense_id": "6e657bf3-1262-389b-85e9-4176bd0d540e",
                                "text": "Ça suffit, je ramasse mes affaires, règle l'hôtelier, salue tout le monde et prends le premier rickshaw pour la gare."
                            },
                            {
                                "example_id": "ead6437b-74ad-4fe4-a88b-6097aae5046d",
                                "sense_id": "6e657bf3-1262-389b-85e9-4176bd0d540e",
                                "text": "Il aimait rire, Veerapen. Il lissait ses moustaches quand il riait. Et puis, un jour, il avait craché du sang partout et il était mort comme ça, à l'arrière du rickshaw."
                            }
                        ]
                    }
                ],
