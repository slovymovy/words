    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad68cc1e-d346-36f8-a4f8-625895fb46a6",
                    "sense_definition": "Groupe de personnes désignées pour représenter une collectivité, un État ou une organisation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>délégation</w> officielle est arrivée ce matin pour assister aux négociations de paix."
                        },
                        {
                            "text": "Les membres de la <w>délégation</w> ont rencontré le maire pour discuter du projet."
                        }
                    ],
                    "synonyms": [
                        "députation"
                    ],
                    "common_phrases": [
                        "délégation officielle",
                        "délégation syndicale",
                        "envoyer une délégation"
                    ]
                },
                {
                    "sense_id": "a9e0a0db-cd92-3c4e-a12a-b700b1f5971c",
                    "sense_definition": "Action de transmettre à quelqu'un une tâche, une responsabilité ou une partie de son autorité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transmission_pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur général a signé une <w>délégation</w> de pouvoir en faveur de son adjoint."
                        },
                        {
                            "text": "Le secrétaire général a validé le document officiel par <w>délégation</w> de signature."
                        }
                    ],
                    "synonyms": [
                        "cession",
                        "transfert",
                        "transmission"
                    ],
                    "common_phrases": [
                        "délégation de pouvoir",
                        "délégation de signature",
                        "par délégation"
                    ]
                },
                {
                    "sense_id": "d12fbf2f-fb56-3b66-97cb-b8b5871d6a91",
                    "sense_definition": "Représentation permanente ou mission diplomatique d'une organisation supranationale ou d'un gouvernement dans un pays tiers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diplomatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le diplomate travaille depuis plusieurs années à la <w>délégation</w> de l'Union européenne."
                        },
                        {
                            "text": "La <w>délégation</w> permanente organise une conférence sur le développement durable la semaine prochaine."
                        }
                    ],
                    "synonyms": [
                        "représentation"
                    ],
                    "common_phrases": [
                        "délégation permanente",
                        "chef de délégation"
                    ]
                },
                {
                    "sense_id": "8a0da95d-783b-30c5-b302-6b19b899e87c",
                    "sense_definition": "Comité formé de parlementaires constitué pour suivre des dossiers précis ou assurer des relations interparlementaires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "parlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>délégation</w> parlementaire aux droits des femmes a présenté son rapport annuel hier."
                        },
                        {
                            "text": "Plusieurs députés ont rejoint cette <w>délégation</w> pour étudier les enjeux énergétiques."
                        }
                    ],
                    "synonyms": [
                        "commission"
                    ],
                    "common_phrases": [
                        "délégation parlementaire"
                    ]
                },
                {
                    "sense_id": "b067a77c-a8e2-3169-b64d-461c4a4cc872",
                    "sense_definition": "Opération juridique par laquelle un débiteur invite un tiers à payer un créancier à sa place.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le notaire a rédigé une <w>délégation</w> de créance pour garantir le remboursement du prêt."
                        },
                        {
                            "text": "La convention prévoit une <w>délégation</w> parfaite libérant définitivement l'ancien débiteur."
                        }
                    ],
                    "common_phrases": [
                        "délégation de créance",
                        "délégation imparfaite",
                        "délégation parfaite"
                    ]
                }
            ]
        }
