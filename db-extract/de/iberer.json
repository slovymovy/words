                                    }
                                ]
                            },
                            {
                                "target_word": "Iberian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49fc2534-abdf-387b-b577-3771c4e1c57d",
                                        "entry_id": "4af0657b-e1e9-3393-b9fc-8496b065cb6d",
                                        "glosses": [
                                            "An extinct language isolate that was spoken in the Iberian peninsula."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f5c49c-0440-46cc-8305-b1003803c0c1",
                                                "sense_id": "49fc2534-abdf-387b-b577-3771c4e1c57d",
                                                "text": "Whereas the presence of Etruscan [in southern France] was likely the result of Etruscan traders settling in the area relatively recently, Iberian appears to have been the prevalent language, at least in the southwesternmost parts of what is now the French Mediterranean coast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c8dc623-5160-4e72-bbb8-f91b564fd7ca",
