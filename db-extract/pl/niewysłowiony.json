                ],
                "senses": [
                    {
                        "sense_id": "0fc7b0bf-de80-3c6e-bdf4-a52618e5fd79",
                        "entry_id": "e4d3fcb2-9012-3011-ae90-a0f12fa8340d",
                        "glosses": [
                            "unspeakable (incapable of being spoken or uttered)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "03859908-60b0-47ca-9300-4a0da6f6ef4f",
                                "sense_id": "0fc7b0bf-de80-3c6e-bdf4-a52618e5fd79",
                                "text": "Weź pochodnię w rękę\ni świeć mi... Prędzej! Ci niewysłowieni\ngdy tak panują wrogowie – a widzę,\nże coś podgryza fundament budowy –\nmistrz działać winien, nie w rozkoszy tonąć.",
                                "translation": "Take a torch in your hand\nand give me light... Faster! When these unspeakable\nenemies have power – and I see\nthat something is gnawing at the foundation of the construction –\na master is obligated to work, not drown in pleasure.",
                                "english": "Take a torch in your hand\nand give me light... Faster! When these unspeakable\nenemies have power – and I see\nthat something is gnawing at the foundation of the construction –\na master is obligated to work, not drown in pleasure."
                            },
                            {
                                "example_id": "1aa07781-9fa7-4af5-b973-3ecf43d9da0b",
                                "sense_id": "0fc7b0bf-de80-3c6e-bdf4-a52618e5fd79",
                                "text": "Minęło niewysłowienie dużo czasu.",
                                "translation": "An unspeakably long time passed.",
                                "english": "An unspeakably long time passed."
                            }
                        ]
                    }
                ],
