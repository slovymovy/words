                "senses": [
                    {
                        "sense_id": "a99ea32e-b68c-3c38-8b6c-9f6e1d203caa",
                        "entry_id": "5f319d8d-26fb-38d8-8f84-1736586a3f3c",
                        "glosses": [
                            "Variante orthographique de redisciplinariser (organiser à nouveau par disciplines)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "589ac595-bff2-4101-8d5e-72529bf13a70",
                                "sense_id": "a99ea32e-b68c-3c38-8b6c-9f6e1d203caa",
                                "text": "Peut-il exister des contenus non disciplinaires à l’école ? Et si on est tenté de répondre par l’affirmative en pensant, par exemple, à des contenus pédagogiques ou scolaires (modes d’être, de faire, de penser…) ou encore pluri- ou trans-disciplinaires, n’y a-t-il pas une tendance fondamentale à re-disciplinariser les contenus ?"
                            },
                            {
                                "example_id": "ad11c2c0-0c7b-4cdd-9821-593439612d48",
                                "sense_id": "a99ea32e-b68c-3c38-8b6c-9f6e1d203caa",
                                "text": "Je ne veux pas dire qu’il faut « re-disciplinariser » Sciences Po."
                            },
                            {
                                "example_id": "bbeadeed-1a93-4497-9dd6-90e824956287",
                                "sense_id": "a99ea32e-b68c-3c38-8b6c-9f6e1d203caa",
                                "text": "DÉ-DISCIPLINARISER ET RE-DISCIPLINARISER."
                            }
                        ]
                    }
                ],
