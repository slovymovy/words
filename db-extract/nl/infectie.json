                        "entry_id": "bffeb5e4-9288-3faa-b5af-4391b869b75b",
                        "glosses": [
                            "een besmetting van lichaamsweefsel met ziekteverwekkers als bacteriën, virussen, schimmels of parasieten en de daaropvolgende ontstekingsreactie"
                        ],
                        "tags": [],
                        "examples": [
                            {
