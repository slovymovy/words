                    {
                        "translation_id": "245d9023-8594-4954-a2fc-66de36969d26",
                        "source_entry_id": "d11f4cd8-4a94-345e-a2bd-5df3a1a7d72f",
                        "source_sense_id": "2a740057-613f-354c-a7d3-b94d26c358b7",
