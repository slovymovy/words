                                "target_senses": [
                                    {
                                        "sense_id": "4bab8d18-27ee-33bf-9a40-674b085fafa1",
                                        "entry_id": "985c1217-5e24-3c15-8835-2f310a97c27b",
                                        "glosses": [
                                            "A prefecture-level city of Anhui, China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f596c89c-60dd-47e1-b7d1-ee32aa4e1a77",
                                                "sense_id": "4bab8d18-27ee-33bf-9a40-674b085fafa1",
                                                "text": "Another major producer of sodium cyanide, Anhui Shuguang, appears to have a subsidiary located not only close to a residential area of Anqing in Anhui Province, but also only a few hundred feet from the Yangtze River in central China. The Times found a kindergarten and another school within 1,000 meters of the factory."
                                            },
                                            {
                                                "example_id": "f235d4b7-00d3-4574-b024-7b048e7e1a6b",
                                                "sense_id": "4bab8d18-27ee-33bf-9a40-674b085fafa1",
                                                "text": "In addition to conventional weather monitoring technology, Anqing city in China's Anhui province is using virtual reality goggles linked to river-monitoring cameras that use 5G internet to transmit images to inspectors, according to Xinhua."
                                            },
                                            {
                                                "example_id": "5de08350-4d86-4487-b9fb-a844557a4fcd",
                                                "sense_id": "4bab8d18-27ee-33bf-9a40-674b085fafa1",
                                                "text": "The attack happened on Saturday afternoon, on a shopping street in Anqing city, Anhui province, which is located around 430 kilometers from Shanghai."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
