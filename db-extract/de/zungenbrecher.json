                            {
                                "example_id": "226a7297-7bbc-4174-bcfb-1f8543e5fb59",
                                "sense_id": "75bf9a6e-09b5-3425-8408-431cbb8df694",
                                "text": "„In Ulm, um Ulm, und um Ulm herum“ ist ein Zungenbrecher.",
                                "translation": "« Dans Ulm, autour d'Ulm, dans les environs d'Ulm » est un virelangue"
                            },
                            {
                                "example_id": "e2972670-64be-4b41-a2bd-2a2b305eea60",
                                "sense_id": "75bf9a6e-09b5-3425-8408-431cbb8df694",
                                "text": "„Fischer Fritz fischt frische Fische,frische Fische fischt Fischers Fritz“ ist ein anderer Zungenbrecher'.",
                                "translation": "« Le pêcheur Fritz pêcha des poissons frais, des poissons frais pêchés par Fritz le pêcheur », est un autre virelangue."
                            }
