                "senses": [
                    {
                        "sense_id": "19165b2c-ce73-3ee3-abe1-2fd7c380df22",
                        "entry_id": "1ab8f3b6-de57-3d87-9ad4-0b650bbc8a28",
                        "glosses": [
                            "Postwesen: Reihe thematisch und typographisch gleichartiger Briefmarken, die eine längere Zeit von der Post bereitgestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d30c3e23-9971-4eca-8033-367d9661244d",
                                "sense_id": "19165b2c-ce73-3ee3-abe1-2fd7c380df22",
                                "text": "„Der letzte Dauermarkensatz vor der Invasion wurde 1971 verausgabt.“"
                            },
                            {
                                "example_id": "7c6dceaa-755b-454f-9240-3bec9bcb79d8",
                                "sense_id": "19165b2c-ce73-3ee3-abe1-2fd7c380df22",
                                "text": "„Es gibt leichtere Themen und schwerere. Zu den leichteren gehören zum Beispiel ein Dauermarkensatz, der gültig ist und verkauft wird, oder auch die Auswahl eines willkürlichen Zeitraums, ohne Berücksichtigung von Portoperioden oder anderen postalischen Zusammenhängen des Landes.“"
                            },
                            {
                                "example_id": "d3fd3f0a-a567-4a48-96a5-871afe3da789",
                                "sense_id": "19165b2c-ce73-3ee3-abe1-2fd7c380df22",
                                "text": "„Am ersten Werktag, dem 3. Januar 2011, kam ein Dauermarkensatz mit fünf Werten an die Schalter: 1, 5, 10, 50 und 65 Cent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
