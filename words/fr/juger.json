                    "sense_definition": "Se former ou exprimer une opinion, un avis sur quelqu'un ou quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut jamais <w>juger</w> les gens uniquement sur leur apparence.",
                            "target_lang_translations": {
                                "en": "You should never <w>judge</w> people solely by their appearance.",
                                "ru": "Никогда не следует <w>судить</w> о людях только по внешности.",
                                "nl": "Je moet mensen nooit alleen op basis van hun uiterlijk <w>beoordelen</w>.",
                                "de": "Man sollte Menschen nie allein nach ihrem Aussehen <w>beurteilen</w>.",
                                "pl": "Nigdy nie należy <w>oceniać</w> ludzi wyłącznie po wyglądzie.",
                                "it": "Non bisognerebbe mai <w>giudicare</w> le persone solo dall'aspetto.",
                                "cs": "Lidi bychom nikdy neměli <w>soudit</w> jen podle jejich vzhledu.",
                                "tr": "İnsanları yalnızca dış görünüşlerine bakarak asla <w>yargılamamalıyız</w>.",
                                "es": "Nunca se debe <w>juzgar</w> a las personas solo por su apariencia.",
                                "zh": "不应只凭外表去<w>评判</w>别人。"
                            }
                        },
                        {
                            "text": "Tu me <w>juges</w> très mal si tu penses que j'ai agi par intérêt personnel.",
                            "target_lang_translations": {
                                "en": "You <w>judge</w> me very harshly if you think I acted out of personal self-interest.",
                                "ru": "Ты очень плохо обо мне <w>судишь</w>, если думаешь, что я действовал из личной выгоды.",
                                "nl": "Je <w>oordeelt</w> heel verkeerd over mij als je denkt dat ik uit eigenbelang heb gehandeld.",
                                "de": "Du <w>urteilst</w> sehr falsch über mich, wenn du denkst, ich hätte aus Eigennutz gehandelt.",
                                "pl": "Bardzo źle mnie <w>oceniasz</w>, jeśli myślisz, że chodziło mi o własny interes.",
                                "it": "Mi <w>giudichi</w> davvero male se pensi che abbia agito per interesse personale.",
                                "cs": "Velmi špatně o mně <w>soudíš</w>, když si myslíš, že jsem jednal ze sobeckých důvodů.",
                                "tr": "Kişisel çıkar gözettiğimi düşünüyorsan, benim hakkımda çok yanlış bir <w>yargıya varıyorsun</w>.",
                                "es": "Me <w>juzgas</w> muy mal si crees que actué por interés personal.",
                                "zh": "如果你以为我是出于私利才行事，那你就把我<w>评价</w>得太低了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "estimer",
                        "évaluer",
                        "apprécier"
                    ],
                    "common_phrases": [
                        "juger sur les apparences",
                        "juger sans savoir"
