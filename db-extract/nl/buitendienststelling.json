                        "examples": [
                            {
                                "example_id": "2a9838e9-ffd3-4594-b70f-003c57e32633",
                                "sense_id": "eba132b5-1b76-3ca4-9bab-87546d91a052",
                                "text": "Niet het hele station en alle sporen gaan dicht als er dit jaar grote werkzaamheden plaatsvinden op en rond Utrecht CS. Er is geen sprake van een complete buitendienststelling. Dat zei minister Schultz in de Tweede Kamer in antwoord op vragen van de SP."
                            },
                            {
                                "example_id": "bfb75b57-a4b5-47b6-90fd-1caa1c142290",
                                "sense_id": "eba132b5-1b76-3ca4-9bab-87546d91a052",
                                "text": "\"Het besluit tot een aaneengesloten periode van vier weken geen treinen levert de reiziger de duidelijkste en beste reisinformatie. De periode valt in de vakantie van Noord-Nederland. De ervaring met een dergelijke buitendienststelling in Arnhem leert dat het overlast vermindert\", laten de spoorbedrijven weten."
                            }
                        ]
