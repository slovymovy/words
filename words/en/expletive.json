                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor pruned the manuscript of unnecessary lines and <w>expletive</w> phrases."
                        },
                        {
                            "text": "Poets in that era often avoided <w>expletive</w> syllables to keep the rhythm concise."
