                "senses": [
                    {
                        "sense_id": "0a96c355-ac16-30f2-a785-443a8b159c19",
                        "entry_id": "e62a83b0-451f-32a3-8076-9927f466e316",
                        "glosses": [
                            "Produit démêlant."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "66ec720f-ad14-4436-9995-62ac81712a0c",
                                "sense_id": "0a96c355-ac16-30f2-a785-443a8b159c19",
                                "text": "Eva peine tous les matins pour démêler les cheveux de sa fille. Au lieu d’utiliser des démêlants conventionnels, gavés de silicones et d’huiles minérales, elle a préféré en fabriquer un qui soit sain, tout en choisissant une odeur qui plaise autant à la mère qu’à la fille."
                            },
                            {
                                "example_id": "4bafa147-d3d5-443c-b1f7-751e2f1a622f",
                                "sense_id": "0a96c355-ac16-30f2-a785-443a8b159c19",
                                "text": "Les beaux poils, lisses et biens coiffés s’entretiennent régulièrement. L’application d’un démêlant pour chien permet d’hydrater les tiges jusqu’aux racines et de défaire plus facilement les nœuds."
                            }
                        ]
                    }
