                    {
                        "translation_id": "9e4ea79b-4512-4093-890c-70fef509b39f",
                        "source_entry_id": "899cc8b1-5f0c-3b01-86ac-94904de59d75",
                        "source_sense_id": "741094f1-31c3-3830-82c1-ee62b77e5593",
                        "target_lang_word": "bravo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bravo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "533fefff-4f37-3522-b437-8a8ad28536c8",
                                        "entry_id": "b6ed799a-bafc-3a53-841e-33aee161bcb7",
                                        "glosses": [
                                            "Exclamation qui sert à approuver, applaudir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "965014dd-eafc-4276-acf0-ad7a421a45dd",
                                                "sense_id": "533fefff-4f37-3522-b437-8a8ad28536c8",
                                                "text": "Qu’on me comprenne bien, j’ai l’âme du satyre\nEt son comportement, mais ça ne veut point dire\nQue j’en ai le talent, le génie, loin s’en faut !\nPas une seule encore ne m’a crié « bravo » !"
                                            },
                                            {
                                                "example_id": "3a77dd9b-825a-47c8-9b52-f85be47c6003",
                                                "sense_id": "533fefff-4f37-3522-b437-8a8ad28536c8",
                                                "text": "Jagmeet Singh n’hésite pas non plus à dénoncer « les PDG des grandes chaînes d’épicerie qui gagnent des millions de dollars en primes ». Bravo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bravo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1102e0fc-d261-3e1a-b109-f532d08b5593",
                                        "entry_id": "d6710ce0-54dd-32c8-aaf5-d4e392c77c88",
                                        "glosses": [
                                            "Applaudissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f4d7c5-febd-43ba-a1b9-5d30cc69f34e",
                                                "sense_id": "1102e0fc-d261-3e1a-b109-f532d08b5593",
                                                "text": "Un bruit d’applaudissements et de bravos couvrit la voix de l’orateur, et ne lui permit pas d’achever sa phrase."
                                            },
                                            {
                                                "example_id": "316d9a96-216a-4e28-abb0-0fb46e5c4eb8",
                                                "sense_id": "1102e0fc-d261-3e1a-b109-f532d08b5593",
                                                "text": "Depuis le mois de janvier, en effet, la bonne société de Lausanne se pressait dans les salons du poëte, qu'elle encourageait et récompensait par ses bravos, […]."
                                            },
                                            {
                                                "example_id": "6ef5d2c5-3755-4a2d-9111-8afebe106906",
                                                "sense_id": "1102e0fc-d261-3e1a-b109-f532d08b5593",
                                                "text": "Tous deux durent revenir trois fois dans la clameur des cuivres et s’incliner devant la rampe, face au public dont les bravos, du haut en bas de la salle, crépitaient sans faiblir, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bravo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79c54e8b-7b6c-375e-b6b0-ff0f6e7622e3",
                                        "entry_id": "eb25d57b-2de3-3a92-95ee-e8acad987b78",
                                        "glosses": [
                                            "Tueur à gages italien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a11ceff6-ed66-406f-9aae-90614a92125d",
                                                "sense_id": "79c54e8b-7b6c-375e-b6b0-ff0f6e7622e3",
                                                "text": "Et la noire gondole força de rames, se glissant le long des palais de marbre comme un bravo qui revient de quelque aventure de nuit, un stylet et une lanterne sous sa cape."
                                            },
                                            {
                                                "example_id": "8c813adc-d774-4327-9d4d-868587218a0f",
                                                "sense_id": "79c54e8b-7b6c-375e-b6b0-ff0f6e7622e3",
                                                "text": "Chaque porte qui s’entrebâille a l’air de laisser passer un amant ou un bravo."
                                            },
                                            {
                                                "example_id": "7b6774aa-bdca-4930-9298-a734ed66d4e6",
                                                "sense_id": "79c54e8b-7b6c-375e-b6b0-ff0f6e7622e3",
                                                "text": "Ces bravi viennent trouver un homme qui, pour certaines raisons, ne veut pas qu'on s'occupe de lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ce18f6d-ed61-3446-8d4c-868a6c364fd7",
                                        "entry_id": "eb25d57b-2de3-3a92-95ee-e8acad987b78",
                                        "glosses": [
                                            "Homme de main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "494f1d66-1847-429f-b151-afa34d02050f",
                                                "sense_id": "4ce18f6d-ed61-3446-8d4c-868a6c364fd7",
                                                "text": "Autour de l'homme [le préfet], une clique de gens sans foi, comme lui, sans mœurs, comme lui, mais redoutables : des bravi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
