                {
                    "sense_id": "bddaf1c4-a515-3c5a-8c78-1305f83412fa",
                    "sense_definition": "A nucleotide chain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "string_like",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "DNA is composed of two <w>strands</w> that form a double helix.",
                            "target_lang_translations": {
                                "ru": "ДНК состоит из двух <w>цепей</w>, образующих двойную спираль.",
                                "de": "DNA besteht aus zwei <w>Strängen</w>, die eine Doppelhelix bilden.",
                                "tr": "DNA, çift sarmal oluşturan iki <w>zincirden</w> meydana gelir.",
                                "zh": "DNA由两条<w>链</w>组成，并形成双螺旋结构。"
                            }
                        },
                        {
                            "text": "Scientists are studying how a single <w>strand</w> of RNA replicates itself.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают, как одна <w>цепочка</w> РНК воспроизводит себя.",
                                "de": "Wissenschaftler untersuchen, wie sich ein einzelner <w>Strang</w> RNA selbst repliziert.",
                                "tr": "Bilim insanları, tek bir RNA <w>iplikçiğinin</w> kendini nasıl kopyaladığını inceliyor.",
                                "zh": "科学家们正在研究单<w>链</w>RNA如何自我复制。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нуклеотидная цепь.",
                        "de": "Eine Kette aus Nukleotiden.",
                        "tr": "Bir nükleotit zinciri.",
                        "zh": "核苷酸链。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цепь",
                                "target_lang_sense_clarification": "ДНК или РНК"
                            },
                            {
                                "target_lang_word": "цепочка",
                                "target_lang_sense_clarification": "генетическая"
                            },
                            {
