                                        "entry_id": "9436cc78-29ef-32ce-b4f8-18d571c3c0a5",
                                        "glosses": [
                                            "To give up as beyond hope or expectation; to despair of."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51afdf30-97d6-4137-8380-0b2d2dea4357",
                                                "sense_id": "25f4b7ae-8550-3429-8e42-75fdf2ca2bcd",
                                                "text": "I would not despair the greatest design that could be attempted."
                                            },
                                            {
                                                "example_id": "49939a1b-1fae-4bae-880f-4d7d0af508cb",
                                                "sense_id": "25f4b7ae-8550-3429-8e42-75fdf2ca2bcd",
                                                "text": "I sometimes despair of getting anything quite simple and honest done in this world by the help of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08fb5e4d-ba1c-3801-94ce-28d420660fe6",
                                        "entry_id": "9436cc78-29ef-32ce-b4f8-18d571c3c0a5",
                                        "glosses": [
                                            "To cause to despair."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950245e3-f7d0-48f7-b33c-020fd385aca2",
                                                "sense_id": "08fb5e4d-ba1c-3801-94ce-28d420660fe6",
                                                "text": "Thinking of what I was despairing about despaired me further"
                                            }
                                        ]
                                    },
