                                "target_lang_sense_clarification": "испытывающий сильное недовольство"
                            },
                            {
                                "target_lang_word": "досадующий",
                                "target_lang_sense_clarification": "испытывающий неприятное чувство из-за неудачи или помехи"
                            },
                            {
                                "target_lang_word": "обеспокоенный",
                                "target_lang_sense_clarification": "встревоженный чем-либо"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "irritado",
                                "target_lang_sense_clarification": "que siente enfado o molestia"
                            },
                            {
                                "target_lang_word": "molesto",
                                "target_lang_sense_clarification": "enojado, disgustado o incómodo"
                            },
                            {
                                "target_lang_word": "disgustado",
                                "target_lang_sense_clarification": "que siente descontento o contrariedad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "269410be-98ee-33a1-bc4b-75073ee36e94",
                    "sense_definition": "Subject to much debate, discussion, or dispute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "debate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>vexed</w> question of climate change policy remains a central issue in modern politics.",
