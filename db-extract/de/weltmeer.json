                                        "sense_id": "d66fae33-2006-3246-9756-692039124dec",
                                        "entry_id": "bab8e48e-814a-308d-be4d-36e09eae811b",
                                        "glosses": [
                                            "Water belonging to an ocean."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e13422-bb43-49a1-89c0-524acf5edc81",
                                                "sense_id": "d66fae33-2006-3246-9756-692039124dec",
                                                "text": "The island is surrounded by ocean"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "758b2b2e-5f11-3eea-9526-52d70cc2352f",
                                        "entry_id": "bab8e48e-814a-308d-be4d-36e09eae811b",
                                        "glosses": [
                                            "An immense expanse; any vast space or quantity without apparent limits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1c3cc87-2eb9-4dab-8394-7e86917e0e08",
                                                "sense_id": "758b2b2e-5f11-3eea-9526-52d70cc2352f",
                                                "text": "the boundless ocean of eternity"
                                            },
                                            {
                                                "example_id": "b9622cf1-e00a-4211-a616-ad808f2e22f2",
                                                "sense_id": "758b2b2e-5f11-3eea-9526-52d70cc2352f",
                                                "text": "an ocean of difference"
                                            },
                                            {
                                                "example_id": "4c50e43c-cc97-4874-9c02-63f15f0e4413",
                                                "sense_id": "758b2b2e-5f11-3eea-9526-52d70cc2352f",
                                                "text": "On the present occasion, Traddles was so hemmed in by the pagoda and the guitar-case, and Dora’s flower-painting, and my writing-table, that I had serious doubts of the possibility of his using his knife and fork; but he protested, with his own good-humour, ‘Oceans of room, Copperfield! I assure you, Oceans!’"
                                            },
                                            {
                                                "example_id": "8195d518-a8d9-4411-a531-ccea3bcaa4c7",
                                                "sense_id": "758b2b2e-5f11-3eea-9526-52d70cc2352f",
                                                "text": "Poison Ivy, Lord,'ll make you itch\nYou're gonna need an ocean\nOf calamine lotion\nYou'll be scratchin' like a hound\nThe minute you start to mess around"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edd9c96b-fe43-3bcd-b113-961bfa2bc641",
                                        "entry_id": "bab8e48e-814a-308d-be4d-36e09eae811b",
                                        "glosses": [
                                            "A blue colour, like that of the ocean (also called ocean blue)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c367c32-d2a3-426b-a192-571f21325c46",
                        "source_entry_id": "5608b3fe-3abc-3a77-84bc-1f98ad5b03c3",
