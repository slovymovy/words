                                            {
                                                "example_id": "b00a1bd2-e1cf-4191-b76a-3ad24d1342fc",
                                                "sense_id": "2cc94756-4b1c-3dd1-9ef9-77be41e45743",
                                                "text": "Der Herr befahl ihm, Harakiri zu begehen."
                                            }
                                        ],
