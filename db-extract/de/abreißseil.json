                "senses": [
                    {
                        "sense_id": "32e97c94-77fc-3b17-8acf-8f19eb00682f",
                        "entry_id": "586eb336-ed18-31b5-bfc1-e50a5b3af3a4",
                        "glosses": [
                            "Seil, das die Bremse eines Anhängers betätigt, falls dieser sich während der Fahrt vom Zugfahrzeug lösen sollte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56186a95-1976-4741-ae06-8e764ac0e277",
                                "sense_id": "32e97c94-77fc-3b17-8acf-8f19eb00682f",
                                "text": "„Wohnwagen und größere Nutzanhänger sind in der Regel mit einem sogenannten Abreißseil versehen.“"
                            },
                            {
                                "example_id": "9612f2a5-cbb9-4698-a193-a3a92e56decd",
                                "sense_id": "32e97c94-77fc-3b17-8acf-8f19eb00682f",
                                "text": "„Wird ein Abreißseil verwendet, so muß es so beschaffen sein, daß es sich nach dem Anziehen der Bremse lösen kann.“"
                            },
                            {
                                "example_id": "27a7c205-f808-41d3-b345-634c6541b831",
                                "sense_id": "32e97c94-77fc-3b17-8acf-8f19eb00682f",
                                "text": "„Das Abreißseil mit Karabiner und Abreißring mit definierter Abreißkraft ist einerseits am Handbremshebel und andererseits am Zugfahrzeug befestigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
