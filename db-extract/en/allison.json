                "senses": [
                    {
                        "sense_id": "ca6afddb-c92f-394f-a422-30e814a416f3",
                        "entry_id": "570f29a9-91d7-3fbf-a67d-11836d035055",
                        "glosses": [
                            "A surname originating as a patronymic."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "d30862ca-7862-4b7e-b2d9-19bbb58a0082",
                                "sense_id": "ca6afddb-c92f-394f-a422-30e814a416f3",
                                "text": "While Rapinoe has acknowledged her white privilege, said Allison, the sociology professor, she received outsize attention for her racial activism without experiencing the harsh consequences that Black athletes historically receive for protests."
                            },
                            {
                                "example_id": "05709302-8aa8-48e2-aab5-e457fe702108",
                                "sense_id": "ca6afddb-c92f-394f-a422-30e814a416f3",
                                "text": "To that end, prosecutors allege that Allison and Humber pushed their followers to attack minority communities, government infrastructure, politicians, government officials and the leaders of private companies – some of whom, including a US senator and a federal judge, were included in a detailed list of “high value targets” for assassination."
                            }
                        ]
                    },
                    {
                        "sense_id": "d14c270f-6491-371b-9f1a-60af7a838878",
                        "entry_id": "570f29a9-91d7-3fbf-a67d-11836d035055",
                        "glosses": [
                            "A male given name transferred from the surname, of mostly before 1950 usage."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "64248a2d-cd2b-42a7-9dd7-0b83e7faa2f8",
                                "sense_id": "d14c270f-6491-371b-9f1a-60af7a838878",
                                "text": "\"Allison?\" Surely that was a girl's name.\n\"It's after Davey Allison, the race car driver. He got killed right before the baby was born. Tracy and me wanted to honor his memory.\" It was a precise little speech. She must have explained the name many times."
                            }
                        ]
                    },
                    {
                        "sense_id": "808cde28-38a8-393f-be1b-475f82d5993d",
                        "entry_id": "570f29a9-91d7-3fbf-a67d-11836d035055",
                        "glosses": [
                            "A female given name from the Germanic languages, of 1940s and later usage, variant of Alison."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b91604d-19ae-4e09-8a6f-5f1d6103719b",
                                "sense_id": "808cde28-38a8-393f-be1b-475f82d5993d",
                                "text": "Allison MacKenzie's father, for whom the child had been named, died when she was three years old."
                            },
                            {
                                "example_id": "e8ef1e6f-7268-4ba1-9898-358d5e84a482",
                                "sense_id": "808cde28-38a8-393f-be1b-475f82d5993d",
                                "text": "Judge Allison Burroughs agreed with Harvard’s arguments that the administration imposed the funding freeze in retaliation for the Ivy League university’s refusal to capitulate to demands for reforms that violated First Amendment protections under the Constitution."
                            }
                        ]
                    },
                    {
                        "sense_id": "38ac6d06-ace5-38b9-9ae0-b5a172fd309f",
