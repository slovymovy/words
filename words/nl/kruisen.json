    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9638f5f3-b2d4-39c4-901e-174bf903d2a8",
                    "sense_definition": "elkaar op een bepaald punt ontmoeten of oversnijden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intersectie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee wegen <w>kruisen</w> elkaar bij het grote kruispunt.",
                            "target_lang_translations": {
                                "en": "The two roads <w>intersect</w> at the large junction.",
                                "ru": "Две дороги <w>пересекаются</w> на большом перекрестке."
                            }
                        },
                        {
                            "text": "De lijnen <w>kruisen</w> elkaar precies in het midden van het papier.",
                            "target_lang_translations": {
                                "en": "The lines <w>cross</w> each other exactly in the middle of the paper.",
                                "ru": "Линии <w>пересекаются</w> точно в центре листа бумаги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "elkaar kruisen",
                        "wegen kruisen"
                    ],
                    "target_lang_definitions": {
                        "en": "to meet or pass across each other at a certain point",
                        "ru": "встречаться или пересекаться друг с другом в определенной точке"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intersect",
                                "target_lang_sense_clarification": "lines or roads"
                            },
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "each other"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пересекаться",
                                "target_lang_sense_clarification": "о линиях или дорогах"
                            },
                            {
                                "target_lang_word": "скрещиваться",
                                "target_lang_sense_clarification": "о путях или взглядах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf9339e8-b612-32aa-85b1-bd710d0033e1",
                    "sense_definition": "over een weg of pad gaan om aan de andere kant te komen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "oversteken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gelukkig zou de trail binnenkort een weg <w>kruisen</w> waarlangs ik het café kon bereiken.",
                            "target_lang_translations": {
                                "en": "Fortunately, the trail would soon <w>cross</w> a road along which I could reach the cafe.",
                                "ru": "К счастью, тропа вскоре должна была <w>пересечь</w> дорогу, по которой я мог добраться до кафе."
                            }
                        },
                        {
                            "text": "We moeten de rivier <w>kruisen</w> om bij het bos te komen.",
                            "target_lang_translations": {
                                "en": "We need to <w>cross</w> the river to get to the forest.",
                                "ru": "Нам нужно <w>пересечь</w> реку, чтобы попасть в лес."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een weg kruisen",
                        "het pad kruisen"
                    ],
                    "target_lang_definitions": {
                        "en": "to go across a road, path, or body of water to get to the other side",
                        "ru": "переходить дорогу, тропу или водный объект, чтобы попасть на другую сторону"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "a road or river"
                            },
                            {
                                "target_lang_word": "traverse",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пересекать",
                                "target_lang_sense_clarification": "дорогу или реку"
                            },
                            {
                                "target_lang_word": "переходить",
                                "target_lang_sense_clarification": "на другую сторону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46ede13b-bf02-3829-bf1e-be69f882c629",
                    "sense_definition": "twee voorwerpen over elkaar heen leggen in de vorm van een kruis",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plaatsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat op de grond met zijn benen <w>gekruist</w>.",
                            "target_lang_translations": {
                                "en": "He sat on the ground with his legs <w>crossed</w>.",
                                "ru": "Он сидел на земле, <w>скрестив</w> ноги."
                            }
                        },
                        {
                            "text": "De ridder besloot zijn zwaarden te <w>kruisen</w> voor het gevecht.",
                            "target_lang_translations": {
                                "en": "The knight decided to <w>cross</w> his swords before the fight.",
                                "ru": "Рыцарь решил <w>скрестить</w> мечи перед боем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "armen kruisen",
                        "benen kruisen",
                        "zwaarden kruisen"
                    ],
                    "target_lang_definitions": {
                        "en": "to place two objects over each other in the shape of a cross",
                        "ru": "класть два предмета друг на друга в форме креста"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "arms, legs, or objects"
                            },
                            {
                                "target_lang_word": "fold",
                                "target_lang_sense_clarification": "arms"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скрещивать",
                                "target_lang_sense_clarification": "руки, ноги или предметы"
                            },
                            {
                                "target_lang_word": "перекрещивать",
                                "target_lang_sense_clarification": "предметы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "883d046f-3c39-38b4-99c9-936b761ec7bd",
                    "sense_definition": "verschillende rassen of soorten met elkaar laten paren om nieuwe eigenschappen te krijgen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer <w>kruiste</w> twee verschillende rassen van schapen voor betere wol.",
                            "target_lang_translations": {
                                "en": "The farmer <w>crossbred</w> two different breeds of sheep for better wool.",
                                "ru": "Фермер <w>скрестил</w> две разные породы овец для получения лучшей шерсти."
                            }
                        },
                        {
                            "text": "Ze zijn van plan om de planten te <w>kruisen</w> om een nieuwe variant te krijgen.",
                            "target_lang_translations": {
                                "en": "They plan to <w>cross</w> the plants to get a new variety.",
                                "ru": "Они планируют <w>скрестить</w> растения, чтобы получить новый сорт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rassen kruisen",
                        "soorten kruisen"
                    ],
                    "target_lang_definitions": {
                        "en": "to mate different breeds or species to produce new characteristics",
                        "ru": "спаривать различные породы или виды для получения новых характеристик"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crossbreed",
                                "target_lang_sense_clarification": "animals or plants"
                            },
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "biological species"
                            },
                            {
                                "target_lang_word": "hybridize",
                                "target_lang_sense_clarification": "scientific context"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скрещивать",
                                "target_lang_sense_clarification": "биологические виды"
                            },
                            {
                                "target_lang_word": "гибридизировать",
                                "target_lang_sense_clarification": "научный контекст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de7d0275-b373-3360-bca4-d9c74e1eec67",
                    "sense_definition": "tegen de wind in zeilen door schuin heen en weer te varen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zeilen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zeilers moesten urenlang <w>kruisen</w> om de haven te bereiken.",
                            "target_lang_translations": {
                                "en": "The sailors had to <w>tack</w> for hours to reach the harbor.",
                                "ru": "Морякам пришлось часами <w>лавировать</w>, чтобы добраться до гавани."
                            }
                        },
                        {
                            "text": "Het schip bleef op de oceaan <w>kruisen</w> in afwachting van orders.",
                            "target_lang_translations": {
                                "en": "The ship continued to <w>cruise</w> on the ocean awaiting orders.",
                                "ru": "Корабль продолжал <w>крейсировать</w> в океане в ожидании приказов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tegen de wind kruisen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vaak gebruikt in maritieme context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to sail against the wind by moving back and forth in a zigzag pattern",
                        "ru": "плыть против ветра, двигаясь зигзагообразно"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tack",
                                "target_lang_sense_clarification": "sailing against the wind"
                            },
                            {
                                "target_lang_word": "cruise",
                                "target_lang_sense_clarification": "sailing about"
                            },
                            {
                                "target_lang_word": "beat",
                                "target_lang_sense_clarification": "sailing upwind"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лавировать",
                                "target_lang_sense_clarification": "идти под парусом против ветра"
                            },
                            {
                                "target_lang_word": "крейсировать",
                                "target_lang_sense_clarification": "плавать в определенном районе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "347d6e14-3630-3c5b-b2ec-d4f21e68bff1",
                    "sense_definition": "iemand aan een kruis vastmaken als straf",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "historisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oudheid was het gebruikelijk om misdadigers te <w>kruisen</w>.",
                            "target_lang_translations": {
                                "en": "In ancient times, it was common to <w>crucify</w> criminals.",
                                "ru": "В древности было принято <w>распинать</w> преступников."
                            }
                        },
                        {
                            "text": "De Romeinen besloten de opstandelingen publiekelijk te <w>kruisen</w>.",
                            "target_lang_translations": {
                                "en": "The Romans decided to <w>crucify</w> the rebels publicly.",
                                "ru": "Римляне решили публично <w>распять</w> повстанцев."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "tegenwoordig vaker 'kruisigen' genoemd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to fasten someone to a cross as a form of punishment or execution",
                        "ru": "прикреплять кого-либо к кресту в качестве наказания или казни"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crucify",
                                "target_lang_sense_clarification": "execution on a cross"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "распинать",
                                "target_lang_sense_clarification": "казнить на кресте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
