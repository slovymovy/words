                                                "sense_id": "1bc72cf7-4e3d-3259-8198-f1171cd6e665",
                                                "text": "Sometimes the club has music, sometimes stand-up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b198d0fd-26c4-3411-b96f-882c2acc1d9c",
                                        "entry_id": "53427bca-b4a4-3ff0-aeef-71ecaabd4844",
                                        "glosses": [
                                            "A comedian who performs on stage."
