{
    "word_family": [
        "restful",
        "restless",
        "restfully",
        "restlessness",
        "unrest",
        "rester"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee8664ec-6d9d-343a-b7f2-8a1b9cf76a91",
                    "sense_definition": "Present participle and gerund of <w>rest</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rest_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>resting</w> in her room after the long journey.",
                            "target_lang_translations": {
                                "ru": "Она <w>отдыхает</w> в своей комнате после долгого путешествия.",
                                "fr": "Elle <w>se repose</w> dans sa chambre après le long voyage."
                            }
                        },
                        {
                            "text": "The doctor suggested <w>resting</w> for a few days to ensure a full recovery.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал <w>отдохнуть</w> несколько дней для полного выздоровления.",
                                "fr": "Le médecin a suggéré de <w>se reposer</w> quelques jours pour assurer un rétablissement complet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "currently resting",
                        "start resting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола \"rest\" (отдыхать): причастие настоящего времени или герундий.",
                        "fr": "Participe présent ou gérondif du verbe « se reposer »."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдыхающий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "отдых",
                                "target_lang_sense_clarification": "существительное/герундий"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se reposant",
                                "target_lang_sense_clarification": "participe présent"
                            },
                            {
                                "target_lang_word": "repos",
                                "target_lang_sense_clarification": "gérondif/nom"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f9606e02-7f95-371d-9f80-16e37ef2ad56",
                    "sense_definition": "Not in action, motion, or use; in a state of rest.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rest_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>resting</w> hikers sat on the rocks to catch their breath.",
                            "target_lang_translations": {
                                "ru": "<w>Отдыхающие</w> туристы сидели на камнях, чтобы перевести дух.",
                                "fr": "Les randonneurs <w>au repos</w> se sont assis sur les rochers pour reprendre leur souffle."
                            }
                        },
                        {
                            "text": "We observed the <w>resting</w> animals from a safe distance.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали за <w>отдыхающими</w> животными с безопасного расстояния.",
                                "fr": "Nous avons observé les animaux <w>au repos</w> à une distance de sécurité."
                            }
                        }
                    ],
                    "common_phrases": [
                        "resting place",
                        "resting state"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии отдыха или бездействия; не активный.",
                        "fr": "Qui n'est pas en action, en mouvement ou en cours d'utilisation ; dans un état de repos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдыхающий",
                                "target_lang_sense_clarification": "о людях или животных"
                            },
                            {
                                "target_lang_word": "находящийся в покое",
                                "target_lang_sense_clarification": "о состоянии"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "au repos",
                                "target_lang_sense_clarification": "état de repos"
                            },
                            {
                                "target_lang_word": "en pause",
                                "target_lang_sense_clarification": "inactif"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "699bd7de-8463-3208-a6e5-76e306c39c6b",
                    "sense_definition": "Remaining stationary or at a baseline level, especially regarding physiological functions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rest_technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A normal <w>resting</w> heart rate for adults is between 60 and 100 beats per minute.",
                            "target_lang_translations": {
                                "ru": "Нормальный пульс <w>в состоянии покоя</w> для взрослых составляет от 60 до 100 ударов в минуту.",
                                "fr": "Un rythme cardiaque normal <w>au repos</w> pour les adultes se situe entre 60 et 100 battements par minute."
                            }
                        },
                        {
                            "text": "The membrane potential returns to its <w>resting</w> state after the impulse.",
                            "target_lang_translations": {
                                "ru": "Мембранный потенциал возвращается в состояние <w>покоя</w> после импульса.",
                                "fr": "Le potentiel de membrane revient à son état <w>de repos</w> après l'impulsion."
                            }
                        }
                    ],
                    "common_phrases": [
                        "resting heart rate",
                        "resting potential",
                        "resting metabolism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии покоя или на базовом уровне (о физиологических функциях).",
                        "fr": "Qui reste stationnaire ou à un niveau de base, particulièrement concernant les fonctions physiologiques."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покоя",
                                "target_lang_sense_clarification": "в составе терминов (напр. пульс покоя)"
                            },
                            {
                                "target_lang_word": "в состоянии покоя",
                                "target_lang_sense_clarification": "фраза"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "au repos",
                                "target_lang_sense_clarification": "terme physiologique"
                            },
                            {
                                "target_lang_word": "de base",
                                "target_lang_sense_clarification": "niveau physiologique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f505e002-6956-388c-aa37-924f882af9ed",
                    "sense_definition": "Temporarily out of work or unemployed, typically used to describe actors.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rest_actor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>resting</w> actor worked as a waiter while auditioning for new roles.",
                            "target_lang_translations": {
                                "ru": "<w>Безработный</w> актер работал официантом, пока проходил прослушивания на новые роли.",
                                "fr": "L'acteur <w>sans emploi</w> travaillait comme serveur tout en passant des auditions pour de nouveaux rôles."
                            }
                        },
                        {
                            "text": "She jokingly referred to herself as a <w>resting</w> genius waiting for discovery.",
                            "target_lang_translations": {
                                "ru": "Она в шутку называла себя <w>отдыхающим</w> гением, ожидающим открытия.",
                                "fr": "Elle se qualifiait en plaisantant de génie <w>inactif</w> attendant d'être découvert."
                            }
                        }
                    ],
                    "common_phrases": [
                        "resting actor"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "euphemism used by actors"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Временно безработный (обычно используется по отношению к актерам).",
                        "fr": "Temporairement sans travail ou au chômage, utilisé généralement pour les acteurs."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безработный",
                                "target_lang_sense_clarification": "об актере"
                            },
                            {
                                "target_lang_word": "невостребованный",
                                "target_lang_sense_clarification": "без ролей"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sans emploi",
                                "target_lang_sense_clarification": "pour un acteur"
                            },
                            {
                                "target_lang_word": "inactif",
                                "target_lang_sense_clarification": "sans rôle"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58fad49b-0a79-39b1-a78a-2cffb1105ffd",
                    "sense_definition": "A temporary pause, break, or interruption in activity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rest_pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a brief <w>resting</w> in the storm, allowing us to secure the windows.",
                            "target_lang_translations": {
                                "ru": "В шторме наступило краткое <w>затишье</w>, позволившее нам укрепить окна.",
                                "fr": "Il y a eu une brève <w>accalmie</w> dans la tempête, nous permettant de sécuriser les fenêtres."
                            }
                        },
                        {
                            "text": "The music contained a <w>resting</w> that built anticipation for the final chord.",
                            "target_lang_translations": {
                                "ru": "В музыке была <w>пауза</w>, которая нагнетала ожидание финального аккорда.",
                                "fr": "La musique contenait une <w>pause</w> qui a fait monter l'anticipation pour l'accord final."
                            }
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "break",
                        "hiatus",
                        "respite",
                        "breather",
                        "interruption",
                        "suspension"
                    ],
                    "common_phrases": [
                        "brief resting",
                        "moment of resting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная пауза, перерыв или прерывание активности.",
                        "fr": "Une pause temporaire, un arrêt ou une interruption dans une activité."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затишье",
                                "target_lang_sense_clarification": "в буре или активности"
                            },
                            {
                                "target_lang_word": "пауза",
                                "target_lang_sense_clarification": "в музыке или речи"
                            },
                            {
                                "target_lang_word": "передышка",
                                "target_lang_sense_clarification": "короткий отдых"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "pause",
                                "target_lang_sense_clarification": "interruption"
                            },
                            {
                                "target_lang_word": "accalmie",
                                "target_lang_sense_clarification": "dans une tempête ou activité"
                            },
                            {
                                "target_lang_word": "répit",
                                "target_lang_sense_clarification": "court repos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a61b0b86-ef5a-3e23-b953-531083b1f3ae",
                    "sense_definition": "The action or state of ceasing work or movement to relax or recover.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rest_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>resting</w> of the dough is crucial for the bread's texture.",
                            "target_lang_translations": {
                                "ru": "Постоянная <w>расстойка</w> теста важна для текстуры хлеба.",
                                "fr": "Le <w>repos</w> constant de la pâte est crucial pour la texture du pain."
                            }
                        },
                        {
                            "text": "After several <w>restings</w>, the caravan continued across the desert.",
                            "target_lang_translations": {
                                "ru": "После нескольких <w>привалов</w> караван продолжил путь через пустыню.",
                                "fr": "Après plusieurs <w>haltes</w>, la caravane a continué à travers le désert."
                            }
                        }
                    ],
                    "synonyms": [
                        "repose",
                        "inactivity",
                        "cessation"
                    ],
                    "common_phrases": [
                        "period of resting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или состояние прекращения работы для восстановления сил.",
                        "fr": "L'action ou l'état de cesser le travail ou le mouvement pour se détendre ou récupérer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстойка",
                                "target_lang_sense_clarification": "кулинарный термин (о тесте)"
                            },
                            {
                                "target_lang_word": "привал",
                                "target_lang_sense_clarification": "остановка в пути"
                            },
                            {
                                "target_lang_word": "отдых",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "repos",
                                "target_lang_sense_clarification": "général"
                            },
                            {
                                "target_lang_word": "apprêt",
                                "target_lang_sense_clarification": "culinaire (pâte)"
                            },
                            {
                                "target_lang_word": "halte",
                                "target_lang_sense_clarification": "arrêt en voyage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5386b01d-524e-370d-a18e-91ac0a8e287a",
                    "sense_definition": "A place where one can rest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rest_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary travelers sought a <w>resting</w> for the night.",
                            "target_lang_translations": {
                                "ru": "Усталые путники искали <w>ночлег</w> на ночь.",
                                "fr": "Les voyageurs fatigués cherchaient un <w>gîte</w> pour la nuit."
                            }
                        },
                        {
                            "text": "He found a quiet <w>resting</w> under the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Он нашел тихое <w>пристанище</w> под старым дубом.",
                                "fr": "Il a trouvé un <w>refuge</w> tranquille sous le vieux chêne."
                            }
                        }
                    ],
                    "common_phrases": [
                        "final resting"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где можно отдохнуть.",
                        "fr": "Un endroit où l'on peut se reposer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пристанище",
                                "target_lang_sense_clarification": "литературное/устаревшее"
                            },
                            {
                                "target_lang_word": "ночлег",
                                "target_lang_sense_clarification": "место для сна"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "refuge",
                                "target_lang_sense_clarification": "lieu de repos"
                            },
                            {
                                "target_lang_word": "gîte",
                                "target_lang_sense_clarification": "pour passer la nuit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3435050a-66da-3c4a-acd9-2bea4f362f86",
                    "sense_definition": "To sting someone or something again.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rest_sting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bee flew back, <w>resting</w> the poor dog on the nose.",
                            "target_lang_translations": {
                                "ru": "Пчела прилетела обратно, <w>снова ужалив</w> бедную собаку в нос.",
                                "fr": "L'abeille est revenue, <w>piquant à nouveau</w> le pauvre chien sur le nez."
                            }
                        },
                        {
                            "text": "He was afraid of the jellyfish <w>resting</w> him if he went back in the water.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что медуза <w>повторно ужалит</w> его, если он вернется в воду.",
                                "fr": "Il avait peur que la méduse ne le <w>pique à nouveau</w> s'il retournait dans l'eau."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ужалить кого-то или что-то снова (от re-sting).",
                        "fr": "Piquer quelqu'un ou quelque chose à nouveau."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторно ужалить",
                                "target_lang_sense_clarification": "глагол"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "piquer à nouveau",
                                "target_lang_sense_clarification": "verbe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}