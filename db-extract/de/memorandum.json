                "senses": [
                    {
                        "sense_id": "62bc6adf-2cf4-3f7d-8bc7-876de055a560",
                        "entry_id": "34af26a8-6426-3e92-b320-abba20eea096",
                        "glosses": [
                            "Denkschrift, vor allem zu politischen Themen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "202fcee6-7e02-4102-94cb-ceb35eceb655",
                                "sense_id": "62bc6adf-2cf4-3f7d-8bc7-876de055a560",
                                "text": "„Es kann kaum ein Zweifel daran bestehen, daß Staatssekretär Pacelli an der Ausarbeitung der Enzyklika beteiligt war und die Empörung Pius’ XI. über die Maßnahmen des NS-Regimes teilte. Höchstwahrscheinlich in diesem Kontext übergab Pacelli im April 1938 dem US-Botschafter in London […] bei einer Begegnung in Rom ein vertrauliches Memorandum.“"
                            },
                            {
                                "example_id": "80f4bf58-5aab-4cc5-ae17-6b1a071938cc",
                                "sense_id": "62bc6adf-2cf4-3f7d-8bc7-876de055a560",
                                "text": "„Pikant ist, dass zum Zeitpunkt, als das Memorandum bekannt wurde, Präsident Zardari sich zu medizinischen Behandlungen in Dubai aufhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4673f297-8929-42a1-9597-4d77f4320c71",
