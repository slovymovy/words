                        ],
                        "examples": [
                            {
                                "example_id": "70727073-8cc4-4900-90bf-11b5f3d33cc8",
                                "sense_id": "359187d9-e669-3fed-85b1-9067238d41cf",
                                "text": "The oldsters start squabbling about whose memory is better. “It was cold that day,” one says about some faraway memory. “What are you talking about? It was May, late May,” says another."
                            }
                        ]
                    },
