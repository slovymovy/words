                ],
                "senses": [
                    {
                        "sense_id": "2f7d5343-4ff8-3648-a3fb-064f9de04d50",
                        "entry_id": "cb000c08-f224-3958-9764-8db436772fc6",
                        "glosses": [
                            "вставать на дыбы (о лошади)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b86defa2-f56b-4b47-ba15-a510aaab688c",
                                "sense_id": "2f7d5343-4ff8-3648-a3fb-064f9de04d50",
                                "text": "Видимо, хлыст больно ударил, конь стал неистово вздыбливаться, и, хотя я крепко вцепилась в гриву, он подбросил меня вверх."
                            }
                        ]
                    },
                    {
                        "sense_id": "560cbcf2-07c3-3be0-bfc7-3ac71454ff67",
                        "entry_id": "cb000c08-f224-3958-9764-8db436772fc6",
                        "glosses": [
                            "перен. разг. подниматься кверху, вставать дыбом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a10507b-499a-47e8-bec6-af2bcb9b8541",
                                "sense_id": "560cbcf2-07c3-3be0-bfc7-3ac71454ff67",
                                "text": "Тихое озеро вздыбливалось от взрывов, которые, по мысли исследователей, должны были вспугнуть чудовище и выгнать его на поверхность."
                            }
                        ]
                    },
                    {
                        "sense_id": "2aa1420b-7f10-3d5c-bd16-8b2db9bef4a6",
                        "entry_id": "cb000c08-f224-3958-9764-8db436772fc6",
                        "glosses": [
                            "страд. к вздыбливать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "09315120-bffb-4fb1-99a3-bfc75c776732",
                                "sense_id": "2aa1420b-7f10-3d5c-bd16-8b2db9bef4a6",
                                "text": "Зелёная каша мелкобитого льда ударяет в утёсы и вздыбливается прибоем."
                            }
                        ]
                    }
                ],
