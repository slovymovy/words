                    {
                        "sense_id": "90ca9172-5b4a-3fc4-a72a-127b9b78449b",
                        "entry_id": "3e020307-8ba8-38b0-bdc3-2488ae5f5840",
                        "glosses": [
                            "Entzündung der Ausstülpungen der Schleimhaut (Divertikel) im Dickdarm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2305344-028d-444e-8439-c0863f18b7a6",
                                "sense_id": "90ca9172-5b4a-3fc4-a72a-127b9b78449b",
                                "text": "„Bei einer unkomplizierten Divertikulitis zeigt das CT eine Verdickung des betroffenen Kolons, normalerweise des Sigmoids, und Streifen im mesenterialen Fettgewebe.“"
                            },
                            {
                                "example_id": "02a2fed1-b45b-45c6-ab34-d2748e21d587",
                                "sense_id": "90ca9172-5b4a-3fc4-a72a-127b9b78449b",
                                "text": "„Kommt es zur Entzündung der Divertikel, zeigt sich diese Divertikulitis klinisch mit Fieber und Druckschmerz im linken Unterbauch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
