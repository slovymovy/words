    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c3f4ced-8ec1-30ae-8eef-d4289a560b05",
                    "sense_definition": "Pójść z kimś, wskazując mu drogę lub pomagając dotrzeć do celu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "guide_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodarz uprzejmie <poprowadził> gości do salonu.",
                            "target_lang_translations": {
                                "ru": "Хозяин вежливо <провел> гостей в гостиную.",
                                "en": "The host kindly <guided> the guests to the living room."
                            }
                        },
                        {
                            "text": "Matka <poprowadziła> dziecko za rękę przez ruchliwą ulicę.",
                            "target_lang_translations": {
                                "ru": "Мать <перевела> ребенка за руку через оживленную улицу.",
                                "en": "The mother <led> the child by the hand across the busy street."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaprowadzić",
                        "pokierować"
                    ],
                    "common_phrases": [
                        "poprowadzić do wyjścia",
                        "poprowadzić za rękę",
                        "poprowadzić do celu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пойти с кем-то, указывая дорогу или помогая добраться до цели.",
                        "en": "To accompany someone, showing them the way or helping them reach a destination."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провести",
                                "target_lang_sense_clarification": "сопроводить до места"
                            },
                            {
                                "target_lang_word": "повести",
                                "target_lang_sense_clarification": "начать вести, пойти вместе"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "guide",
                                "target_lang_sense_clarification": "to show someone the way or lead them through a place"
                            },
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "to go in front of someone to show the way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7b8c901-bb8f-39a8-ac59-c2bc40b4dc78",
                    "sense_definition": "Sprawić, że pojazd porusza się w określonym kierunku; kierować pojazdem.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "drive_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój brat obiecał, że <poprowadzi> samochód w drodze powrotnej.",
                            "target_lang_translations": {
                                "ru": "Мой брат пообещал, что <поведет> машину на обратном пути.",
                                "en": "My brother promised that he would <drive> the car on the way back."
                            }
                        },
                        {
                            "text": "Kierowca bezpiecznie <poprowadził> autobus mimo trudnych warunków pogodowych.",
                            "target_lang_translations": {
                                "ru": "Водитель безопасно <провел> автобус, несмотря на сложные погодные условия.",
                                "en": "The driver safely <steered> the bus despite difficult weather conditions."
                            }
                        }
                    ],
                    "synonyms": [
                        "pokierować",
                        "kierować"
                    ],
                    "common_phrases": [
                        "poprowadzić samochód",
                        "poprowadzić auto",
                        "poprowadzić pojazd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить транспортное средство двигаться в определенном направлении; управлять транспортным средством.",
                        "en": "To operate a vehicle and make it move in a specific direction."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повести",
                                "target_lang_sense_clarification": "начать управлять машиной"
                            },
                            {
                                "target_lang_word": "провести",
                                "target_lang_sense_clarification": "успешно проехать маршрут"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "drive",
                                "target_lang_sense_clarification": "to operate a motor vehicle"
                            },
                            {
                                "target_lang_word": "steer",
                                "target_lang_sense_clarification": "to control the direction of a vehicle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2feade0b-95ad-383f-9609-ae7cc7436fd5",
                    "sense_definition": "Przewodniczyć spotkaniu, grupie ludzi lub zarządzać przebiegiem jakiegoś działania.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "manage_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrektor osobiście <poprowadzi> negocjacje z nowym klientem.",
                            "target_lang_translations": {
                                "ru": "Директор лично <проведет> переговоры с новым клиентом.",
                                "en": "The director will personally <lead> the negotiations with the new client."
                            }
                        },
                        {
                            "text": "Nauczycielka w ciekawy sposób <poprowadziła> lekcję o historii Polski.",
                            "target_lang_translations": {
                                "ru": "Учительница интересно <провела> урок истории Польши.",
                                "en": "The teacher <conducted> the history lesson about Poland in an interesting way."
                            }
                        }
                    ],
                    "synonyms": [
                        "przewodniczyć",
                        "pokierować"
                    ],
                    "common_phrases": [
                        "poprowadzić spotkanie",
                        "poprowadzić lekcję",
                        "poprowadzić zespół",
                        "poprowadzić śledztwo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Председательствовать на собрании, руководить группой людей или управлять ходом какого-либо действия.",
                        "en": "To preside over a meeting, manage a group, or direct the course of an activity."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провести",
                                "target_lang_sense_clarification": "осуществить мероприятие"
                            },
                            {
                                "target_lang_word": "возглавить",
                                "target_lang_sense_clarification": "стать руководителем"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "to be in charge of a group or activity"
                            },
                            {
                                "target_lang_word": "chair",
                                "target_lang_sense_clarification": "to preside over a meeting or committee"
                            },
                            {
                                "target_lang_word": "manage",
                                "target_lang_sense_clarification": "to be responsible for controlling an organization or event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f32308b-0b46-3327-928d-da573ea440e9",
                    "sense_definition": "Narysować linię lub kształt na powierzchni za pomocą narzędzia do pisania.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "draw_line",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz <poprowadzić> prostą linię od punktu A do punktu B.",
                            "target_lang_translations": {
                                "ru": "Ты должен <провести> прямую линию от точки А до точки Б.",
                                "en": "You must <draw> a straight line from point A to point B."
                            }
                        },
                        {
                            "text": "Artysta pewną ręką <poprowadził> pędzel po płótnie.",
                            "target_lang_translations": {
                                "ru": "Художник уверенной рукой <провел> кистью по холсту.",
                                "en": "The artist <drew> the brush across the canvas with a steady hand."
                            }
                        }
                    ],
                    "synonyms": [
                        "narysować",
                        "nakreślić",
                        "pociągnąć"
                    ],
                    "common_phrases": [
                        "poprowadzić linię",
                        "poprowadzić kreskę",
                        "poprowadzić kontur"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарисовать линию или фигуру на поверхности с помощью пишущего инструмента.",
                        "en": "To create a line or shape on a surface using a writing or drawing tool."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провести",
                                "target_lang_sense_clarification": "начертить линию"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "draw",
                                "target_lang_sense_clarification": "to produce a picture or line with a pen or pencil"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16b16ac3-b74f-3c8c-95f6-c3ccf31419ff",
                    "sense_definition": "Wyznaczyć i zbudować przebieg drogi, rur lub przewodów w określonym miejscu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "route_infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Inżynierowie zdecydowali, by <poprowadzić> nową autostradę przez dolinę.",
                            "target_lang_translations": {
                                "ru": "Инженеры решили <проложить> новую автостраду через долину.",
                                "en": "The engineers decided to <route> the new highway through the valley."
                            }
                        },
                        {
                            "text": "Elektryk musi <poprowadzić> kable wewnątrz ściany, żeby nie były widoczne.",
                            "target_lang_translations": {
                                "ru": "Электрик должен <проложить> кабели внутри стены, чтобы их не было видно.",
                                "en": "The electrician must <lay> the cables inside the wall so they are not visible."
                            }
                        }
                    ],
                    "synonyms": [
                        "przeprowadzić",
                        "wyznaczyć"
                    ],
                    "common_phrases": [
                        "poprowadzić drogę",
                        "poprowadzić kable",
                        "poprowadzić rurociąg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наметить и проложить маршрут дороги, труб или проводов в определенном месте.",
                        "en": "To plan and construct the route for a road, pipes, or cables in a specific location."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проложить",
                                "target_lang_sense_clarification": "построить маршрут или коммуникации"
                            },
                            {
                                "target_lang_word": "провести",
                                "target_lang_sense_clarification": "протянуть кабели или трубы"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lay",
                                "target_lang_sense_clarification": "to place or install pipes or cables"
                            },
                            {
                                "target_lang_word": "route",
                                "target_lang_sense_clarification": "to plan the path for a road or infrastructure"
                            }
                        ]
                    }
                }
            ]
        }
