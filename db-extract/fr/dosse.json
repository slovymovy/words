                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37e7d909-55fe-3873-9dcb-558acd4c7703",
                                        "entry_id": "d632b7d5-b959-3e80-87bd-231ddd8ea948",
