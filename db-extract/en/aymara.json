                                "target_senses": [
                                    {
                                        "sense_id": "589c135b-2a64-3ccf-902a-4c0673f1f27a",
                                        "entry_id": "2ca3e430-2817-3e51-b8ab-b7d2ab8fc8b5",
                                        "glosses": [
                                            "indigene Sprache Südamerikas, die vor allem in Bolivien gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea000f9a-6149-4e04-b793-70ad5d464dfa",
                                                "sense_id": "589c135b-2a64-3ccf-902a-4c0673f1f27a",
                                                "text": "„Die einzigen erwiesenermaßen mit dem Aymara genetisch verwandten Sprachen sind das Kawki und das Jaqaru, die beide heute nur von einer geringen Zahl von Menschen im Hinterland von Lima in Zentralperu gesprochen werden.“"
                                            },
                                            {
                                                "example_id": "d8fbe680-caef-47c6-9ead-85882fab990b",
                                                "sense_id": "589c135b-2a64-3ccf-902a-4c0673f1f27a",
                                                "text": "„Fortan sollen die spanischsprachigen Kinder […] als obligatorische Zweitsprache Aymara oder Quechua lernen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6347929-e2cb-3abb-a659-d08c44405fc9",
                                        "entry_id": "2ca3e430-2817-3e51-b8ab-b7d2ab8fc8b5",
                                        "glosses": [
                                            "Volk/Ethnie in Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63097361-ea50-4f8c-b6b4-451253471463",
                                                "sense_id": "b6347929-e2cb-3abb-a659-d08c44405fc9",
                                                "text": "„Doch zu einem geringen Maße bauen sie auch Kartoffeln an und halten Kleinvieh wie Hühner und Schweine, landwirtschaftliche Techniken, die sie von ihren Nachbarn, den Aymará übernommen haben“."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
