                "pos": "name",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dae1c999-82f2-3838-aabc-ac036f2b95f8",
                        "entry_id": "30cd2b26-eb85-3911-9ed7-f4aea44fd95a",
                        "glosses": [
                            "miasto w Stanach Zjednoczonych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef95cced-3821-4fcd-b9ae-f65b793d1c05",
                                "sense_id": "dae1c999-82f2-3838-aabc-ac036f2b95f8",
                                "text": "Chicago jest wielkiem centrum zorganizowanej Polonii."
                            },
                            {
                                "example_id": "8c73c677-999e-47c4-aa08-7a1507561931",
                                "sense_id": "dae1c999-82f2-3838-aabc-ac036f2b95f8",
                                "text": "Skład biało-czerwonych zdecydowanie odbiegał od optymalnego, natomiast rywale do Chicago przyjechali w najmocniejszym zestawieniu, z kadrą naszpikowaną medalistami ostatnich mistrzostw świata i igrzysk olimpijskich w Rio de Janeiro"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "750b4c2c-f848-305c-88df-a58d79130ef9",
                        "entry_id": "30cd2b26-eb85-3911-9ed7-f4aea44fd95a",
                        "glosses": [
                            "rzeka w Stanach Zjednoczonych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "02087997-bf60-3f96-a1d6-a68b742b3e6d",
                        "entry_id": "30cd2b26-eb85-3911-9ed7-f4aea44fd95a",
                        "glosses": [
