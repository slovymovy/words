                    "sense_id": "8bbf0c19-82c8-3ad0-9f9c-0de08fc284e8",
                    "sense_definition": "Een mening of houding die iemand heeft over een bepaalde zaak.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>standpunt</w> van de partij staat nog ter discussie.",
                            "target_lang_translations": {
                                "en": "The party's <w>position</w> is still under discussion.",
                                "ru": "<w>Позиция</w> партии всё ещё обсуждается.",
                                "zh": "该党的<w>立场</w>仍在讨论中。"
                            }
                        },
                        {
                            "text": "Hij wil zijn <w>standpunt</w> niet veranderen ondanks de nieuwe informatie.",
                            "target_lang_translations": {
                                "en": "He does not want to change his <w>point of view</w> despite the new information.",
                                "ru": "Он не хочет менять свою <w>точку зрения</w>, несмотря на новую информацию.",
                                "zh": "尽管有了新信息，他仍不想改变自己的<w>观点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gezichtspunt",
                        "optiek",
                        "mening",
                        "visie"
                    ],
                    "common_phrases": [
                        "een standpunt innemen",
                        "bij zijn standpunt blijven",
                        "van standpunt veranderen"
                    ],
                    "target_lang_definitions": {
                        "en": "An opinion or attitude regarding a specific matter.",
                        "ru": "Мнение или отношение к определенному вопросу.",
                        "zh": "对某事所持有的观点或态度。"
                    },
