                ],
                "translations": [
                    {
                        "translation_id": "2bb2ea45-13c9-4f9e-b592-01ac8862c50b",
                        "source_entry_id": "bc41ea7c-1db9-3a22-b0fe-2968e712bbee",
                        "source_sense_id": "07be56e7-5975-33e5-a942-57541434df68",
                        "target_lang_word": "extinction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extinction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48bf5c95-1ea3-36d6-95cf-5bb1c44cbe91",
                                        "entry_id": "d628bd53-9d45-3ca6-8c51-6639a3ea8beb",
                                        "glosses": [
                                            "The action of making or becoming extinct; annihilation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58cf3d60-6ba4-4ce5-aa25-5055d31413f9",
                                                "sense_id": "48bf5c95-1ea3-36d6-95cf-5bb1c44cbe91",
                                                "text": "Thirteen long centuries have elapsed since the extinction of the last Zoroastrian Empire[…]"
                                            },
                                            {
                                                "example_id": "0ffdad48-256e-4ad6-af0d-9f21c769418c",
                                                "sense_id": "48bf5c95-1ea3-36d6-95cf-5bb1c44cbe91",
                                                "text": "Their lives were short; all were condemned by the early 1930s, presumably because, like most classes of G.S.W.R. engines, their small numbers invited extinction under any comprehensive programme of standardisation."
                                            },
                                            {
                                                "example_id": "2267dc23-4c3a-4f7f-9f35-adf29a71c261",
                                                "sense_id": "48bf5c95-1ea3-36d6-95cf-5bb1c44cbe91",
                                                "text": "The extinction of a species once so numerous seemed incredible."
                                            },
                                            {
                                                "example_id": "f593e878-e8a8-4d5a-8f3f-4756201316ba",
                                                "sense_id": "48bf5c95-1ea3-36d6-95cf-5bb1c44cbe91",
                                                "text": "Dr. Manuel: You're wasting your time. The age of humanity is over. Our extinction is inevitable."
                                            },
                                            {
                                                "example_id": "a3e4deae-4dbc-4838-8ac1-9866341c690c",
                                                "sense_id": "48bf5c95-1ea3-36d6-95cf-5bb1c44cbe91",
                                                "text": "Phoenix and Lubbock are both caught in severe drought, and it is going to get much worse. We may see many such [dust] storms in the decades ahead, along with species extinctions, radical disturbance of ecosystems, and intensified social conflict over land and water. Welcome to the Anthropocene, the epoch when humans have become a major geological and climatic force."
                                            },
                                            {
                                                "example_id": "21d87b57-91af-443d-af79-2ec421e0a79d",
                                                "sense_id": "48bf5c95-1ea3-36d6-95cf-5bb1c44cbe91",
                                                "text": "On the East and West Coast Main Lines in the 1950s/60s, for example, we saw the extinction of intermediate stations in order to create the same sort of accelerations that IRP is now promising. Back then, the priority was faster main line services, with wayside/intermediate stations paying the ultimate price."
                                            },
                                            {
                                                "example_id": "13bd366b-fbfa-4515-9991-4dc58a4f4ba0",
                                                "sense_id": "48bf5c95-1ea3-36d6-95cf-5bb1c44cbe91",
                                                "text": "In Perthshire, the Aberdeenshire catchments of Deeside and Donside, in Moray and Nairnshire to the north-east, the populations are in low single figures, putting them on the brink of local extinction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce03888-7e95-3aa2-b301-6520e9c0fe28",
                                        "entry_id": "d628bd53-9d45-3ca6-8c51-6639a3ea8beb",
                                        "glosses": [
                                            "The absorption or scattering of electromagnetic radiation emitted by astronomical objects by intervening dust and gas before it reaches the observer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7426d9e2-fc30-3b44-8a5d-f1baf9b2703b",
                                        "entry_id": "d628bd53-9d45-3ca6-8c51-6639a3ea8beb",
                                        "glosses": [
                                            "The inability to perceive multiple stimuli simultaneously."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f151515-aa8c-3ca2-a9bc-1c50b28a5b2d",
                                        "entry_id": "d628bd53-9d45-3ca6-8c51-6639a3ea8beb",
                                        "glosses": [
                                            "The fading of a conditioned response over time if it is not reinforced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7525b13d-3395-4f4e-8a20-61a9ec8326ac",
                        "source_entry_id": "bc41ea7c-1db9-3a22-b0fe-2968e712bbee",
                        "source_sense_id": "07be56e7-5975-33e5-a942-57541434df68",
                        "target_lang_word": "remission",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remission",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e69ba66-6457-3c35-a141-5ac948f4d21c",
                                        "entry_id": "803d0624-0294-3b24-986a-329dd12d4b77",
                                        "glosses": [
                                            "A pardon of a sin; (chiefly historical, also figuratively) the forgiveness of an offence, or relinquishment of a (legal) claim or a debt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84dc4a5e-2a7c-4de3-b0dd-d19fe6319706",
                                                "sense_id": "2e69ba66-6457-3c35-a141-5ac948f4d21c",
                                                "text": "Moreouer the perfit beleue of this article, worketh in all true chriſten people, aloue to continue in this vnitie, and afeare to be caſte out of the ſame, and it worketh in them that be ſinners and repentant, great comforte, and conſolacion, to obteine remiſſion of ſinne, by vertue of Chriſtes paſſion, and adminiſtracion of his ſacramentes at the miniſters handes, ordained for that purpoſe, […]"
                                            },
                                            {
                                                "example_id": "8c8d15f3-678d-4c45-b553-d54860f26d9b",
                                                "sense_id": "2e69ba66-6457-3c35-a141-5ac948f4d21c",
                                                "text": "Remiſsion of ſins is giuen to all the elect, and them alone, becauſe it is giuen to them all and alone who beleeue; and none beleeue, but the elect onely; for the reprobate neuer haue true faith and beleefe: therefore they neuer obtaine remiſsion of their ſinnes."
                                            },
                                            {
                                                "example_id": "8c4a55e1-3bb9-4a07-a44f-ae579f72bbbe",
                                                "sense_id": "2e69ba66-6457-3c35-a141-5ac948f4d21c",
                                                "text": "So then it is not the Power of preaching and baptizing, which is here given the Apoſtles, but as the Fathers interpret the Place, a peculiar Power of pronouncing, as God's deputed Judges, Pardon and Remiſſion to the Penitent, a Power of abſolving from Sins, in the Name of God, all ſuch as penitently confeſs unto them: […]"
                                            },
                                            {
                                                "example_id": "acddab3e-1375-4e3d-be1b-28669c2a926e",
                                                "sense_id": "2e69ba66-6457-3c35-a141-5ac948f4d21c",
                                                "text": "And as to the remission of the interest of the debt of the Company, the right hon. gentleman knew, that public policy and expediency rendered a remission of the interests of all the debts due to the public equally necessary."
                                            },
                                            {
                                                "example_id": "a6ff9f6d-7285-4c98-a643-deaaabccfaf9",
                                                "sense_id": "2e69ba66-6457-3c35-a141-5ac948f4d21c",
                                                "text": "And it be further enacted, That if it shall appear to the comptroller that any payments of quit rents or certificates given for the remission of quit rent in pursuance of any former law of the state shall have been credited by mistake to the wrong patent or lot, […] it shall be the duty of the comptroller on discovering the same, to rectify all such mistakes […]"
                                            },
                                            {
                                                "example_id": "0fff8585-ebdb-4e8f-b5e1-c44e7c9b07ec",
                                                "sense_id": "2e69ba66-6457-3c35-a141-5ac948f4d21c",
                                                "text": "The remission system ensures that access to justice is maintained for those individuals on lower incomes who would otherwise have difficulty paying a fee to use court or tribunal services. […] A fee remission is a full or partial fee waiver of the fees that become payable when an individual uses these services."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baaf2f63-56bd-3ea3-bbf6-78a5ede01ede",
                                        "entry_id": "803d0624-0294-3b24-986a-329dd12d4b77",
                                        "glosses": [
                                            "A lessening of amount due, as in either money or work, or intensity of a thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d0704f0-767f-4def-886f-0f7c72516da7",
                                                "sense_id": "baaf2f63-56bd-3ea3-bbf6-78a5ede01ede",
                                                "text": "Preceptors have all aſſented to this one principle,—that diſcipline , and amuſement ſhould alternately ſucceed each other. […] You may relax your care, but the youthful mind will be full occupied, and more earneſtly buſied in the career of voluntary play, than on any impoſed taſk. During the remiſſions of ſchool the mind is only tranſferred from one object to another: […]"
                                            },
                                            {
                                                "example_id": "d6213814-a722-421e-b5e2-bc9cd3a6273e",
                                                "sense_id": "baaf2f63-56bd-3ea3-bbf6-78a5ede01ede",
                                                "text": "His objection, at an early period of the session, to the motion of the hon. member for Wareham, besides the general objection at that time to the remission of any taxes, was, that it would throw the trade into confusion by a partial remission. The remission he had now to propose was to a much greater extent."
                                            },
                                            {
                                                "example_id": "3a249e3a-87c2-4100-8e6d-edcd1f984a34",
                                                "sense_id": "baaf2f63-56bd-3ea3-bbf6-78a5ede01ede",
                                                "text": "This gentleman in March, 1833, was applied to by Messrs. Charles and George Palmer, who solicited a remission of the annual jumma or tax upon their farms, to the amount of 24,000 rupees. Mr. [Alexander] Imlach, who, […] was at least acquainted with, and acted up to the spirit of the law, expressed his incompetency to grant the remission."
                                            },
                                            {
                                                "example_id": "eb40b2b6-eb76-4787-a6aa-d0f3d84b966f",
                                                "sense_id": "baaf2f63-56bd-3ea3-bbf6-78a5ede01ede",
                                                "text": "In every polysyllabic word, there is a sharpened percussion of the voice on some one of the syllables, and a comparative remission on the rest. This percussion was called by the Greeks the acute accent, and the remission, the grave accent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a74b759-463e-3f7a-937e-4decc1a11415",
                                        "entry_id": "803d0624-0294-3b24-986a-329dd12d4b77",
                                        "glosses": [
                                            "A lessening of amount due, as in either money or work, or intensity of a thing.",
                                            "A reduction or cancellation of the penalty for a criminal offence; in particular, the reduction of a prison sentence as a recognition of the prisoner's good behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f49b71cb-dfc2-4c0c-88e0-6974ecbbfc88",
                                                "sense_id": "6a74b759-463e-3f7a-937e-4decc1a11415",
                                                "text": "That Mr. Carstairs answer all interrogatories that shall be put to him, betwixt and the first of October next, upon his great oath. That which being done, he shall have his majesty's full pardon and remission, for his life, limb, estate, and fame."
                                            },
                                            {
                                                "example_id": "1cc6797a-1b39-4aff-9eec-2221400bf627",
                                                "sense_id": "6a74b759-463e-3f7a-937e-4decc1a11415",
                                                "text": "At common law, the criminal was bound to assyth the party whom he had injured; no special statute was necessary to establish a point received and understood; but a doubt might be entertained, how far crimes were not entirely abolished by a remission, so as not only to stop the punishment of the law, but to exclude the claim of damages. To obviate this doubt was the intention of these various statutes, which provide that assythment shall be due, notwithstanding a remission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df670be-a95b-3ad4-b9cd-2b71512ff6c8",
                                        "entry_id": "803d0624-0294-3b24-986a-329dd12d4b77",
                                        "glosses": [
                                            "A lessening of amount due, as in either money or work, or intensity of a thing.",
                                            "An abatement or lessening of the manifestations of a disease; a period where the symptoms of a disease are absent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c66903c-dcc1-4061-98ec-bbc21671b7fc",
                                                "sense_id": "9df670be-a95b-3ad4-b9cd-2b71512ff6c8",
                                                "text": "Her cancer was in remission."
                                            },
                                            {
                                                "example_id": "00820bb2-69a1-42ed-a294-8df63b9857f5",
                                                "sense_id": "9df670be-a95b-3ad4-b9cd-2b71512ff6c8",
                                                "text": "It was always dangerous, though perhaps leſs ſo, than other ſymptoms which was leſs alarming, particularly if it ſuffered increaſe and diminution with the paroxyſms and remiſſions of the diſeaſe."
                                            },
                                            {
                                                "example_id": "bef4ba90-eb63-4cdc-9046-d86d24fbfe6d",
                                                "sense_id": "9df670be-a95b-3ad4-b9cd-2b71512ff6c8",
                                                "text": "When Dr. Willis speaks of relapses, does he mean relapses after a cessation of the disorder, or after a remission of the disorder?—Certainly after a remission, his Majesty's disorder has never ceased."
                                            },
                                            {
                                                "example_id": "18240a0b-5de7-41c2-968d-65da0c6df58f",
                                                "sense_id": "9df670be-a95b-3ad4-b9cd-2b71512ff6c8",
                                                "text": "Sometimes also slow fevers infest the body without any remission, so that there is no time afforded either for food or physic."
                                            },
                                            {
                                                "example_id": "b0874361-fea4-455c-a51c-352cfe795f1a",
                                                "sense_id": "9df670be-a95b-3ad4-b9cd-2b71512ff6c8",
                                                "text": "Yet again, in true general paralysis, remissions occur, and in these remissions most of the pupillary symptoms disappear, to return with the onset of fresh activity of the disease."
                                            },
                                            {
                                                "example_id": "33b30fdb-0e51-4bf4-a72d-931d46b657c5",
                                                "sense_id": "9df670be-a95b-3ad4-b9cd-2b71512ff6c8",
                                                "text": "When lymphoma is being treated, the fundamental goals of chemotherapy are to introduce a complete and durable (>6 months) first remission (termed induction), to reinduce a remission when the disease recurs (or the patient experiences relapse) following remission (termed reinduction), and, finally, to induce remission when the cancer fails to respond to induction or reinduction therapy using drugs not included in the initial protocols (termed rescue)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cca0a1b-b609-362f-a9e7-1ea37b672977",
                                        "entry_id": "803d0624-0294-3b24-986a-329dd12d4b77",
                                        "glosses": [
                                            "An act of remitting, returning, or sending back."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6641a75-dbb7-3353-82e5-730d2331a7ed",
                                        "entry_id": "803d0624-0294-3b24-986a-329dd12d4b77",
                                        "glosses": [
                                            "An act of remitting, returning, or sending back.",
                                            "A referral of a case back to another (especially a lower or inferior) court of law; a remand, a remittal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b53caffc-2304-4d40-a721-84135ccb59e0",
                                                "sense_id": "c6641a75-dbb7-3353-82e5-730d2331a7ed",
                                                "text": "It was held by the Court of Errors and Appeals that the remission of the case to the trial court for clarification of the verdict was justified, and that the record, as corrected, clearly indicated that the recommendation of life imprisonment should apply only to Rannelli and not to Merra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7b64ac2-729f-30d9-be8c-d282ab09d51a",
                                        "entry_id": "803d0624-0294-3b24-986a-329dd12d4b77",
                                        "glosses": [
                                            "Reflection or back-scattering of light by a material; (to send back)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "remission",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0c93364-ad4f-3b86-be95-c7405894b3b0",
                                        "entry_id": "f7c31ee4-3718-3746-95e8-b13d83c5d917",
                                        "glosses": [
                                            "To change the mission of; to provide with a new mission."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ea227a-e377-40ba-a47e-b8ddf254bc46",
                                                "sense_id": "b0c93364-ad4f-3b86-be95-c7405894b3b0",
                                                "text": "The Strykers have been remissioned, actually, to a mission of road security that actually takes advantage of the mobility that they provide."
                                            },
                                            {
                                                "example_id": "684eda5a-5464-4484-9687-18c5adda691b",
                                                "sense_id": "b0c93364-ad4f-3b86-be95-c7405894b3b0",
                                                "text": "Their original mission was reestablished. That is what happens to people who will allow God to remission their lives through His blood cleansing them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
