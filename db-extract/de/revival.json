                ],
                "translations": [
                    {
                        "translation_id": "0fed9b62-fff9-4c41-b879-e64235a3807f",
                        "source_entry_id": "0a9d4547-1fc6-33c8-af93-cbae3ee9ba23",
                        "source_sense_id": "8540e8d1-562f-3cb6-a3b2-252baf5e1d68",
