                ],
                "senses": [
                    {
                        "sense_id": "bf6811a7-f596-3bf7-8823-d6604195a76a",
                        "entry_id": "01f34ddd-ae54-39f5-a559-d0bad785403b",
                        "glosses": [
                            "umfangreicher Schaden, bei dem eine Instandsetzung wirtschaftlich nicht mehr vertretbar oder eine Reparatur technisch nicht mehr möglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3afdd1ea-dca1-41ce-b32b-2a055ec1a041",
                                "sense_id": "bf6811a7-f596-3bf7-8823-d6604195a76a",
                                "text": "„In Parlamentskreisen wird bereits von einem drohenden \"Totalschaden\" gesprochen: Womöglich müsse nicht nur die Software der \"Parlakom\"-Rechner neu installiert, sondern auch die komplette Hardware ausgetauscht werden.“"
                            },
                            {
                                "example_id": "9980c867-67fc-46dd-a742-b00f2523737b",
                                "sense_id": "bf6811a7-f596-3bf7-8823-d6604195a76a",
                                "text": "„Sie haben ein Stoppschild überfahren und einen nagelneuen Dodge-Pick-up seitlich gerammt. Totalschaden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c603cef7-b971-4a50-a695-0417b17a86cb",
                        "source_entry_id": "01f34ddd-ae54-39f5-a559-d0bad785403b",
                        "source_sense_id": "bf6811a7-f596-3bf7-8823-d6604195a76a",
                        "target_lang_word": "total loss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "total loss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0822d4c0-64a1-30d0-9bda-260d46b98488",
                                        "entry_id": "7c4ffec6-498a-3c75-bc2b-41ef44b131b9",
                                        "glosses": [
                                            "An insured item of which the entire value is written off."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0f2ee55-06e5-32a2-984c-ab0f0ead8a67",
                                        "entry_id": "7c4ffec6-498a-3c75-bc2b-41ef44b131b9",
                                        "glosses": [
                                            "An insured item that is written off when it is beyond repair, or when the cost of repair exceeds the insured value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51954768-b0ae-454a-a4d2-45d0dd402b4d",
                                                "sense_id": "f0f2ee55-06e5-32a2-984c-ab0f0ead8a67",
                                                "text": "The ship was declared a constructive total loss."
                                            },
                                            {
                                                "example_id": "93f3d251-6c8e-4a36-8609-bd2aba72b927",
                                                "sense_id": "f0f2ee55-06e5-32a2-984c-ab0f0ead8a67",
                                                "text": "Intelligence has been received at Hong Kong of the total loss of the ship Libelle while on a voyage to that port from San Francisco, having on board a valuable cargo and specie to the extent of £76,000 in dollars, and a number of passengers, among whom were Madame Anna Bishop, Miss Phelan, Mr. M. Schrutz, and Mr. Charles Lascelles, of the English Opera Company, who, with other artists, were on a musical tour. The ship was cast away on the night of the 4th of March, on an uninhabited and dangerous reef called Wake Island, in the China Seas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "total loss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8fea1ab5-4095-336a-b839-1b26e686cf15",
                                        "entry_id": "a560709e-461f-38f7-8b98-95d446b1c8b2",
                                        "glosses": [
                                            "A system in which the working fluid is used once and then dumped, burned up, etc. rather than being recirculated. By extension, an electrical system that runs on battery power without the means to recharge during operation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c23ce7cc-4e77-48c4-b8fa-f4a2bd5c8df1",
                                                "sense_id": "8fea1ab5-4095-336a-b839-1b26e686cf15",
                                                "text": "Some rocket engines have a total loss hydraulic system for engine gimbal, using fuel bled from the main turbopumps as the working fluid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a17dccfe-29ec-4b2f-b814-b6646675423f",
                        "source_entry_id": "01f34ddd-ae54-39f5-a559-d0bad785403b",
                        "source_sense_id": "bf6811a7-f596-3bf7-8823-d6604195a76a",
                        "target_lang_word": "write-off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "write-off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82794395-5616-3881-8381-afd06a29c804",
                                        "entry_id": "96dc921b-fca0-3c9f-aa80-d68a51d92159",
                                        "glosses": [
                                            "The cancellation of an item; the amount cancelled or lost."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbc8d75f-960b-351a-b778-b939be94d879",
                                        "entry_id": "96dc921b-fca0-3c9f-aa80-d68a51d92159",
                                        "glosses": [
                                            "Something that is now worthless (such as a car after an accident)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "write-off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bce2ace3-d458-38b2-98fe-fe19421e68e1",
                                        "entry_id": "222ff011-6d41-3128-ad57-5b6068ba837c",
                                        "glosses": [
                                            "Nonstandard form of write off."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10f29a51-1764-4142-94a2-8fbe9964b666",
                                                "sense_id": "bce2ace3-d458-38b2-98fe-fe19421e68e1",
                                                "text": "If you are eager to manufacture the recharging unit, the analyst will be tempted to write-off the equipment over its physical life and provide you with a lower breakeven volume. If you prefer to outsource, the analyst will be tempted to write-off the equipment over its tax life and provide you with a higher breakeven volume."
                                            },
                                            {
                                                "example_id": "2e2b25d7-6689-4d5b-9ec4-95e87a173cc8",
                                                "sense_id": "bce2ace3-d458-38b2-98fe-fe19421e68e1",
                                                "text": "This has spurred major efforts to write-off loans by the two pilot banks and considerable progress at the largest of the SOCBs (the ICBC)."
                                            },
                                            {
                                                "example_id": "fb1c1f08-ad60-4dc7-8d93-2fced1cb1603",
                                                "sense_id": "bce2ace3-d458-38b2-98fe-fe19421e68e1",
                                                "text": "Provided that where the Collector or any of his subordinates is responsible for the collection of any tax, […] the power to write-off such tax, […] on the ground of its being irrecoverable, shall be exercised by the Commissioner of Land Administration […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
