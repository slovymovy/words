                ],
                "senses": [
                    {
                        "sense_id": "c450515e-ec4f-3e50-92f2-96cf0d638980",
                        "entry_id": "36f31f4c-5158-339b-8105-a287c2fc4c46",
                        "glosses": [
                            "een deel van een land dat ver van kust of grens gelegen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cfe48cc-130c-4060-b534-65c1ad82e2a8",
                                "sense_id": "c450515e-ec4f-3e50-92f2-96cf0d638980",
                                "text": "Twente ligt in de diepe binnenlanden van Nederland terwijl Zeeland aan de kust ligt."
                            },
                            {
                                "example_id": "c2818da7-06aa-48a3-ac0f-ccaa9403cfa7",
                                "sense_id": "c450515e-ec4f-3e50-92f2-96cf0d638980",
                                "text": "Nu ziet het er kaal uit. Maar de afgelopen zomers stonden hier zeker tienduizend planten. Ondernemer Mattia Cusani kijkt uit over de beboste heuvels van San Giovanni in Fiore, een dorp in het binnenland van Calabrië. Cusani's geboorteregio loopt al decennialang leeg: gebrek aan economische groei, weinig kansen voor jongeren. En toch is het hem gelukt om hier een succesvol bedrijf op te zetten."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e4bad69-31cc-3835-8090-5400dd7268c9",
                        "entry_id": "36f31f4c-5158-339b-8105-a287c2fc4c46",
                        "glosses": [
                            "binnen de grenzen van een land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c1a003c-2901-4cdc-97aa-bef0e2eac86d",
                                "sense_id": "4e4bad69-31cc-3835-8090-5400dd7268c9",
                                "text": "Door de economische crisis gaat minder mensen naar het buitenland op vakantie maar blijven in het binnenland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba7670a5-d97e-46a6-a8f2-bafaca4ae73f",
                        "source_entry_id": "36f31f4c-5158-339b-8105-a287c2fc4c46",
                        "source_sense_id": "c450515e-ec4f-3e50-92f2-96cf0d638980",
                        "source_sense_description": "een deel van een land dat ver van kust of grens gelegen is",
                        "target_lang_word": "Inland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c39d872c-74e6-33dd-8cef-362b7d83a51b",
                                        "entry_id": "bbd87188-4b50-38fe-9580-52c46940e0bf",
                                        "glosses": [
                                            "das eigene Land (einer Person oder Gruppe); der Staat, in dem man sich befindet, auf den man sich bezieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba5c106-1cbe-4c13-8dea-a1af8149148d",
                                                "sense_id": "c39d872c-74e6-33dd-8cef-362b7d83a51b",
                                                "text": "Mit Besuchen im Ausland versuchte der Kanzler von der Krise im Inland abzulenken."
                                            },
                                            {
                                                "example_id": "393f71b8-ab89-4fad-afb3-79d4bdaf17e7",
                                                "sense_id": "c39d872c-74e6-33dd-8cef-362b7d83a51b",
                                                "text": "Nach einer zweijährigen Übergangsfrist werden europaeinheitliche Überweisungsformulare eingeführt, die dann auch im Inland gelten sollen."
                                            },
                                            {
                                                "example_id": "135a5294-7b9e-4984-846e-354ef0c4c7bc",
                                                "sense_id": "c39d872c-74e6-33dd-8cef-362b7d83a51b",
                                                "text": "„Auch im Inland schwindet Benns Rückhalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d547676-748f-34d7-8636-69272e35c8ef",
                                        "entry_id": "bbd87188-4b50-38fe-9580-52c46940e0bf",
                                        "glosses": [
                                            "der Teil eines Landes oder der Landmasse, der nicht am Rand (an der Küste) liegt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfd2b269-9de9-4a28-8e9e-d7cee32dbe7c",
                                                "sense_id": "2d547676-748f-34d7-8636-69272e35c8ef",
                                                "text": "Nun, das ist wohl ganz anders im Inland, / wo man selten das Salzwasser spürt"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b542fac4-4780-4bc9-a3e2-2852af49d69b",
                        "source_entry_id": "36f31f4c-5158-339b-8105-a287c2fc4c46",
                        "source_sense_id": "c450515e-ec4f-3e50-92f2-96cf0d638980",
                        "source_sense_description": "een deel van een land dat ver van kust of grens gelegen is",
                        "target_lang_word": "inland",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                        "entry_id": "4f3ce394-2532-3b60-9f6a-853a50b4f950",
                                        "glosses": [
                                            "Within the land; relatively remote from the ocean or from open water; interior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b4e7dc-7ada-423d-94d5-c2e6a17731c9",
                                                "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                                "text": "an inland town"
                                            },
                                            {
                                                "example_id": "6f08453d-f266-4cee-b5bd-8f7033454462",
                                                "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                                "text": "In this wide Inland ſea, that hight by name / The Idle lake, my wandring ſhip I row, […]"
                                            },
                                            {
                                                "example_id": "00c74a64-61f7-40f0-b2b4-5be390255925",
                                                "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                                "text": "So doth the greater glory dim the less:\nA substitute shines brightly as a king\n Unto the king be by, and then his state\n Empties itself, as doth an inland brook\n Into the main of waters."
                                            },
                                            {
                                                "example_id": "38100c7f-6364-40c4-a2d5-4b8583008e66",
                                                "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                                "text": "Brutes […] / Ruminate heedleſs of the ſcene outſpread / Beneath, beyond, and ſtretching far away / From inland regions to the diſtant main."
                                            },
                                            {
                                                "example_id": "1a6dfa43-1bf5-47f3-92ce-ca4bf9c09cdb",
                                                "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                                "text": "Happy he who, like Ulysses, has made an adventurous voyage; and there is no such sea for adventurous voyages as the Mediterranean—the inland sea which the ancients looked upon as so vast and so full of wonders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88259c1b-4a0f-31bf-8d7a-9d1140b178ea",
                                        "entry_id": "4f3ce394-2532-3b60-9f6a-853a50b4f950",
                                        "glosses": [
                                            "Limited to the land, or to inland routes; not passing on, or over, the sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d61b0d-9d95-48df-a50a-9b9cd8cd4997",
                                                "sense_id": "88259c1b-4a0f-31bf-8d7a-9d1140b178ea",
                                                "text": "inland commerce"
                                            },
                                            {
                                                "example_id": "0a6deded-dfcc-490e-bec1-3df8d41769b0",
                                                "sense_id": "88259c1b-4a0f-31bf-8d7a-9d1140b178ea",
                                                "text": "inland navigation"
                                            },
                                            {
                                                "example_id": "710f710e-cbd9-44ed-85bc-e12ceebfaeca",
                                                "sense_id": "88259c1b-4a0f-31bf-8d7a-9d1140b178ea",
                                                "text": "inland transportation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e03927-00e3-30e3-998f-d6678d0f2bd3",
                                        "entry_id": "4f3ce394-2532-3b60-9f6a-853a50b4f950",
                                        "glosses": [
                                            "Confined to one country or state; domestic; not foreign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80fa0f2e-6954-4496-886b-f45717b279fb",
                                                "sense_id": "62e03927-00e3-30e3-998f-d6678d0f2bd3",
                                                "text": "an inland bill of exchange"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f704d94f-4ee5-3fdf-b4e8-2b2e505188f9",
                                        "entry_id": "4f3ce394-2532-3b60-9f6a-853a50b4f950",
                                        "glosses": [
                                            "Of a sophisticated background, especially as relates to a royal court or national capital."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a1568cc-06d7-41c6-a579-ddf43d1c68d4",
                                                "sense_id": "f704d94f-4ee5-3fdf-b4e8-2b2e505188f9",
                                                "text": "inland bred"
                                            },
                                            {
                                                "example_id": "94dc29b3-0222-46cb-b044-d36003d65832",
                                                "sense_id": "f704d94f-4ee5-3fdf-b4e8-2b2e505188f9",
                                                "text": "You touch'd my vein at first: the thorny point\nof bare distress hath ta'en from me the show\nof smooth civility; yet am I inland\nbred, and know some nurture."
                                            },
                                            {
                                                "example_id": "2a577207-1b74-4d95-96f0-27c2e13a2bce",
                                                "sense_id": "f704d94f-4ee5-3fdf-b4e8-2b2e505188f9",
                                                "text": "I have been told so of many; but indeed an old religious\nuncle of mine taught me to speak, who was in his youth an inland\nman; one that knew courtship too well, for there he fell in love."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42e023d6-35ec-3d5c-8632-c2ef986ff09f",
                                        "entry_id": "42ab23a1-b69e-3e1a-aa9f-e6381ab5dc6b",
                                        "glosses": [
                                            "The interior part of a country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bae1cf2-1699-4a2e-aee5-0239b77b2bbd",
                                                "sense_id": "42e023d6-35ec-3d5c-8632-c2ef986ff09f",
                                                "text": "a wall sufficient to defend\nOur inland from the pilfering borderers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "282c3e22-0a55-337c-9b3a-d47faaae7f33",
                                        "entry_id": "68867980-1e3f-31af-9ec0-ec9a51a37934",
                                        "glosses": [
                                            "Into, or towards, the interior of the land, away from the coast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4581f5b9-08d3-431a-8ca4-09afdb641f90",
                                                "sense_id": "282c3e22-0a55-337c-9b3a-d47faaae7f33",
                                                "text": "The greatest waves of population have rolled inland from the east."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c478567b-cd07-4508-8e50-ce89a8483eb0",
                        "source_entry_id": "36f31f4c-5158-339b-8105-a287c2fc4c46",
                        "source_sense_id": "c450515e-ec4f-3e50-92f2-96cf0d638980",
                        "source_sense_description": "een deel van een land dat ver van kust of grens gelegen is",
                        "target_lang_word": "arrière-pays",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrière-pays",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25b82550-3906-3bf1-b449-02ac7962b86e",
                                        "entry_id": "c7d1d6e2-bb16-3275-8d16-18b0c0d665cb",
                                        "glosses": [
                                            "Contrée située à l’arrière d’une ville côtière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "563ecbe6-fca2-4d59-9892-9c05e806477e",
                                                "sense_id": "25b82550-3906-3bf1-b449-02ac7962b86e",
                                                "text": "Casablanca était transformé en un presidio complétement isolé de son arrière-pays, qui était l’unique raison d’être et le seul moyen d’existence de cette ville exclusivement commerçante."
                                            },
                                            {
                                                "example_id": "97a8e1f6-53dc-4691-8abc-1ca8bd95db7e",
                                                "sense_id": "25b82550-3906-3bf1-b449-02ac7962b86e",
                                                "text": "Cette notion d’arrière-pays ne garde un sens fort, ne mérite d’être interrogée que si on la rapporte à un homme en situation, que si l’on pense le paysage comme un fragment de terre à baliser, à percevoir d’un certain lieu que nous occupons."
                                            },
                                            {
                                                "example_id": "b05a0615-4fc2-4114-8faa-8399a23a5f9d",
                                                "sense_id": "25b82550-3906-3bf1-b449-02ac7962b86e",
                                                "text": "Dès que l’on entre dans les arrière-pays varois et niçois, le climat est un peu moins tempéré, le thermomètre descendant facilement l’hiver et grimpant vite l’été."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be0868cc-de67-3c75-a509-bb019848b625",
                                        "entry_id": "c7d1d6e2-bb16-3275-8d16-18b0c0d665cb",
                                        "glosses": [
                                            "Contrée circonvoisine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "536820b9-6c5f-434a-8595-891a63acdd38",
                                                "sense_id": "be0868cc-de67-3c75-a509-bb019848b625",
                                                "text": "On utilise sans vergogne l’arrière-pays, du moins sa partie non protégée, non mise en réserve pour accueillir des décharges intempestives, les fûts toxiques, les activités polluantes et les ayatollahs de l’écologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4df511-ef77-3731-8de7-df652fb74f85",
                                        "entry_id": "c7d1d6e2-bb16-3275-8d16-18b0c0d665cb",
                                        "glosses": [
                                            "Région plus éloignée, voire sauvage, rarement visitée."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a734718-edb5-4948-89a2-90c5019565d2",
                                                "sense_id": "6a4df511-ef77-3731-8de7-df652fb74f85",
                                                "text": "Le Québec est un vrai paradis de chasse. Plus de 20,000 orignaux ont été prélevés cette année par les 170,000 nemrods qui se sont aventurés dans l’arrière-pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
