                    }
                ],
                "senses": [
                    {
                        "sense_id": "739d392e-d88b-35a1-946f-6da77871fa8b",
                        "entry_id": "e079d4c0-ef27-343f-8862-ce88cb54ec55",
                        "glosses": [
                            "iemand die autisme heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e66dbb4e-9411-47d6-aa9c-96dafc4519a4",
                                "sense_id": "739d392e-d88b-35a1-946f-6da77871fa8b",
                                "text": "In deze klas zitten twee autisten, die hebben soms wat extra aandacht nodig."
                            }
                        ]
                    },
                    {
                        "sense_id": "24b1ce49-3df9-3c93-80ee-95729020193d",
                        "entry_id": "e079d4c0-ef27-343f-8862-ce88cb54ec55",
                        "glosses": [
                            "beschuldiging dat iemands gedrag of gedachte onaangepast is"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "2bf77176-3286-490f-867f-a29417d124b3",
                                "sense_id": "24b1ce49-3df9-3c93-80ee-95729020193d",
                                "text": "Natuurlijk had je bier moeten halen, ben je een autist of zo?"
                            },
                            {
                                "example_id": "ce94f521-2b63-4216-a1f9-8f8e72793839",
                                "sense_id": "24b1ce49-3df9-3c93-80ee-95729020193d",
                                "text": "Hij begon me op de zenuwen te werken, die stomme autist!"
                            },
                            {
                                "example_id": "38432995-2706-4a28-85d7-773346a9e64e",
                                "sense_id": "24b1ce49-3df9-3c93-80ee-95729020193d",
                                "text": "Ik stak mijn hand uit en pakte de papieren, maar Peña rukte ze uit mijn hand en borg ze op in een la van zijn bureau, die de verdomde autist met een klap dichtschoof."
                            },
                            {
                                "example_id": "b2afbed6-3b27-4397-955b-13fa2bb53fb3",
                                "sense_id": "24b1ce49-3df9-3c93-80ee-95729020193d",
                                "text": "Als een student die bij mij een mondeling tentamen heeft gedaan haar verontwaardiging over mijn ontwijkende gedrag kenbaar maakt met de opmerking “die man is een autist!” dan hoeft ze echt niet uitvoerig uit te leggen wat ze daarmee bedoelt. Het woord 'autist' roept een stereotypisch beeld op van een contactgestoorde persoonlijkheid. Klaarblijkelijk is 'autist' niet zo maar een beschrijvende term, maar is het een beschrijvende term waar een negatieve lading aan vast zit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89bf496b-4f70-4759-ba82-5e152c070b5b",
                        "source_entry_id": "e079d4c0-ef27-343f-8862-ce88cb54ec55",
                        "source_sense_id": "739d392e-d88b-35a1-946f-6da77871fa8b",
                        "source_sense_description": "iemand die autisme heeft",
                        "target_lang_word": "autist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7754e8dc-6cf9-325b-8620-6daff1296305",
                                        "entry_id": "3acf3730-19a5-328b-9587-26bce027e049",
                                        "glosses": [
                                            "An autistic person, a person with autism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf75d12-9b28-4a06-9296-2829a74ccef0",
                                                "sense_id": "7754e8dc-6cf9-325b-8620-6daff1296305",
                                                "text": "Most autists are not artists, as most artists are not autists; but in the chance of their coming together […] there must, I think, be an interaction between the two, so that the art takes on some of the strengths and weaknesses of autism […]"
                                            },
                                            {
                                                "example_id": "afa1ec17-627e-428f-a94c-0ec645efb161",
                                                "sense_id": "7754e8dc-6cf9-325b-8620-6daff1296305",
                                                "text": "Like children and animals, autists have relatively rudimentary conceptual lives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcdf9892-8965-3b62-a9ba-1c7e7a5eb19f",
                                        "entry_id": "3acf3730-19a5-328b-9587-26bce027e049",
                                        "glosses": [
                                            "A person characterized by abnormal and unhealthy focus or persistence, low self-awareness and unhealthy hatred of opposition or criticism."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb2ae60b-5670-4e16-bc85-b74375881b22",
                                                "sense_id": "fcdf9892-8965-3b62-a9ba-1c7e7a5eb19f",
                                                "text": "autists arguing about 'muh graphics'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ed40938-2902-448a-9376-060cc80c5b8a",
                        "source_entry_id": "e079d4c0-ef27-343f-8862-ce88cb54ec55",
                        "source_sense_id": "739d392e-d88b-35a1-946f-6da77871fa8b",
                        "source_sense_description": "iemand die autisme heeft",
                        "target_lang_word": "autiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44452b1d-ca81-3b96-bfcc-2c7d95de9d85",
                                        "entry_id": "73e21df6-adc6-39c3-9957-44de55566112",
                                        "glosses": [
                                            "Qualifie une personne présentant des caractéristiques relevant de l'autisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d05430d-89be-466e-bf28-269c1a367ac9",
                                                "sense_id": "44452b1d-ca81-3b96-bfcc-2c7d95de9d85",
                                                "text": "Si nous savons que les fonctions cognitives de l’enfant autiste sont gravement perturbées et qu’il ne différencie guère l’animé de l’inanimé, il n’en est pas de même pour le faux self."
                                            },
                                            {
                                                "example_id": "950b386a-6fff-471a-9813-ecc5adf84f60",
                                                "sense_id": "44452b1d-ca81-3b96-bfcc-2c7d95de9d85",
                                                "text": "Quand l'activité langagière de l'enfant autiste s'est bien développée vont coexister des capacités combinatoires nuancées et la tendance à utiliser des morceaux de discours écholaliques."
                                            },
                                            {
                                                "example_id": "d6a2485b-7aab-4dd9-bb8b-0b3ef9512305",
                                                "sense_id": "44452b1d-ca81-3b96-bfcc-2c7d95de9d85",
                                                "text": "Chaque personne autiste organise son cerveau d’une façon qui lui est propre. On est capables de dégager des lois générales, mais on n’arrive pas pour le moment à faire une classification qui est assez performante"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "848c0da6-1e44-321c-be07-dd23ef242584",
                                        "entry_id": "73e21df6-adc6-39c3-9957-44de55566112",
                                        "glosses": [
                                            "Qualifie une personne physique ou morale qui ne perçoit pas les sentiments ou les intentions d’autrui."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48e26198-6ac3-4680-b88a-ca087c43c81e",
                                                "sense_id": "848c0da6-1e44-321c-be07-dd23ef242584",
                                                "text": "Née d’un sentiment d'infériorité humiliant, une telle idée doit être surcompensée, transformée en sentiment de supériorité, jusqu’à faire surgir une allophobie autiste que l’individu égaré s'applique à lui-même dans une exaspération schizothyme."
                                            },
                                            {
                                                "example_id": "1174e261-efbb-4650-80df-81dc904e435c",
                                                "sense_id": "848c0da6-1e44-321c-be07-dd23ef242584",
                                                "text": "Je ne suis pas autiste, je vois bien les difficultés …. Je ne suis pas jusqu'au-boutiste, pas enfermé dans une certitude, mais il y a une chose que je constate, c'est qu'il n'y a pas d'alternative"
                                            },
                                            {
                                                "example_id": "3c1a45ed-8b31-43eb-b114-bcbeba4a63e9",
                                                "sense_id": "848c0da6-1e44-321c-be07-dd23ef242584",
                                                "text": "Ces derniers jours, on a souvent qualifié le régime algérien d’autiste. C’est porter préjudice aux gens atteints de cette maladie dont certains développent une intelligence exceptionnelle et une sensibilité hors du commun."
                                            },
                                            {
                                                "example_id": "8f0ed507-4c83-4d4d-8a5d-6adf0b95990d",
                                                "sense_id": "848c0da6-1e44-321c-be07-dd23ef242584",
                                                "text": "Le gouvernement « n’est pas autiste » : la maladresse du ministre du Travail Jean-Pierre Farandou, pour laquelle il a fait son mea culpa, est une illustration du regard déformé que porte encore la société sur le handicap, selon des experts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "autiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a642090-cd8b-3a67-a019-bc3fb738adde",
                                        "entry_id": "8a4f2606-73a4-35c2-b5a6-0ac31531c3ec",
                                        "glosses": [
                                            "Personne ayant de l’autisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dd9a670-71e6-4718-aeed-d667a65fc39b",
                                                "sense_id": "7a642090-cd8b-3a67-a019-bc3fb738adde",
                                                "text": "Il ne faut pas croire que les autistes ont des stéréotypies et que les non-autistes n’en ont pas. Les stéréotypies des personnes non autistes passent simplement pour naturelles, sont mieux acceptées socialement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4e87b62-1084-41fd-8cb3-cf72312eaf95",
                        "source_entry_id": "e079d4c0-ef27-343f-8862-ce88cb54ec55",
                        "source_sense_id": "739d392e-d88b-35a1-946f-6da77871fa8b",
