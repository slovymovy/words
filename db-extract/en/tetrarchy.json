                                        "entry_id": "8e5511e5-04c2-388f-a577-4528e2eab984",
                                        "glosses": [
                                            "Herrschaftsform, bei der die Macht auf vier Personen aufgeteilt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e337e73-fe03-4673-b03f-42db2c122920",
                                                "sense_id": "a400be56-30c1-3870-bb15-23e8e2cddfb9",
                                                "text": "„Durch die Schaffung der Tetrarchie hoffte man, die Soldaten als Kaisermacher auszuschalten.“"
                                            },
                                            {
                                                "example_id": "e05b47f0-4531-46b6-87e4-6a6003a37dbf",
                                                "sense_id": "a400be56-30c1-3870-bb15-23e8e2cddfb9",
                                                "text": "„Typische Herrschaftsform für die Galater war eine Tetrarchie (Viererherrschaft)…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
