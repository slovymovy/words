                    },
                    {
                        "translation_id": "c6062b83-bf72-40f6-a10c-8b57f650108d",
                        "source_entry_id": "5d6ce4f0-8141-3675-b487-977e8c813ad8",
                        "source_sense_id": "72689940-3120-34a6-bcbb-f146c74b803a",
                        "target_lang_word": "paresthésie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paresthésie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "857b78a7-aa25-34d0-b828-71b8a559ee44",
                                        "entry_id": "9c9052d4-cead-3036-83d2-3db958676d20",
                                        "glosses": [
                                            "Trouble de la sensibilité, désagréable et non douloureux, donnant la sensation de palper du coton, et pouvant s’accompagner d’une anesthésie, de picotements, d’une raideur cutanée et parfois d’une sensation de \\\"chaud-froid\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5dd8759-1fd1-49fd-b473-13b4789277c6",
                                                "sense_id": "857b78a7-aa25-34d0-b828-71b8a559ee44",
                                                "text": "Vous vous êtes endormi(e) sur votre bras et vous sentez des picotements dans la main ? Normal ! \"C’est une paresthésie, qui se produit quand un nerf sensitif subit une longue pression, une diminution de son irrigation sanguine ou une variation brutale de température\", avance Didier Bouhassira, neurologue à l’Inserm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb032d6e-7e2c-4093-a085-f272cbe03cf5",
                        "source_entry_id": "5d6ce4f0-8141-3675-b487-977e8c813ad8",
                        "source_sense_id": "72689940-3120-34a6-bcbb-f146c74b803a",
                        "target_lang_word": "parestesia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c2db069c-742d-4cc7-9fea-e0ce881bba5c",
                        "source_entry_id": "5d6ce4f0-8141-3675-b487-977e8c813ad8",
                        "source_sense_id": "72689940-3120-34a6-bcbb-f146c74b803a",
                        "target_lang_word": "Parästhesie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parästhesie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4562ddb3-ebe8-3ea3-9536-857a294f59f2",
                                        "entry_id": "9e4b0bc6-0f69-386e-8872-2507954b6e20",
                                        "glosses": [
                                            "Sensibilitätsstörung der Nerven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "836f70a0-de41-4c2b-a0f9-f682f447ea84",
                                                "sense_id": "4562ddb3-ebe8-3ea3-9536-857a294f59f2",
                                                "text": "„Es handelt sich im Wesentlichen um unbedeutende Komplikationen, wie Nachblutung, Schwellung, Hämatom oder eine temporäre Parästhesie.“"
                                            },
                                            {
                                                "example_id": "d5624128-0e8d-4f19-8df1-9fbe922e8d35",
                                                "sense_id": "4562ddb3-ebe8-3ea3-9536-857a294f59f2",
                                                "text": "„Je eine Person meldete eine Schulterverletzung, Herzrhythmusstörungen sowie Taubheitsgefühl (Parästhesie) im Bein.“"
                                            },
                                            {
                                                "example_id": "e789a0ba-90e2-49e4-aea7-8a0231245172",
                                                "sense_id": "4562ddb3-ebe8-3ea3-9536-857a294f59f2",
                                                "text": "„Häufig tritt eine sekundäre Hypophosphatämie mit Parästhesie und Schwächegefühl auf.“"
                                            },
                                            {
                                                "example_id": "4f4c6a69-0387-457c-bc88-cb35b2579c27",
                                                "sense_id": "4562ddb3-ebe8-3ea3-9536-857a294f59f2",
                                                "text": "„Mitunter visuelle Erscheinungen während des Anfalls und Parästhesien in den Händen, Füßen und der unteren Bauchgegend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
