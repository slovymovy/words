                                        "entry_id": "d7b84393-060d-314b-84dd-d9880d21a698",
                                        "glosses": [
                                            "die erste Ausweichsmöglichkeit; eine vorgesehene Alternative, falls das erste Vorhaben nicht funktioniert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a8542a-996a-488d-8669-0aedf33c712c",
                                                "sense_id": "572cfab0-378b-36d5-8122-2843dcca3687",
                                                "text": "„Ein Motorradunfall setzte vielen seiner Pläne ein abruptes Ende. Seitdem lebt er Plan B – und das sogar ziemlich erfolgreich.“"
                                            },
                                            {
                                                "example_id": "3cb3e004-0b3c-45c1-93ad-65c93e4beb38",
                                                "sense_id": "572cfab0-378b-36d5-8122-2843dcca3687",
                                                "text": "„Hermann Rühle zeigt Ihnen, wie Sie Ihr Alternativenportfolio entwickeln. Mit einem Plan B in der Schublade erwischt Sie eine Krise nicht auf dem falschen Fuß - Sie stehen mit beiden Beinen fest im Berufsleben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
