                "senses": [
                    {
                        "sense_id": "f1b5b8e1-9a78-343a-9538-abc0035faf04",
                        "entry_id": "9a3c813e-9af2-3029-b68f-a37f11140a75",
                        "glosses": [
                            "истор. на Руси IX–XIII вв. — крестьянин-земледелец"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a78e786a-07b2-3825-a4e0-80708963f8ec",
                        "entry_id": "9a3c813e-9af2-3029-b68f-a37f11140a75",
                        "glosses": [
                            "презр. обозначение крепостного крестьянина в устах помещика, представителя власти"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0d36e33f-3a2a-3ead-a143-2a6c569c041a",
                        "entry_id": "9a3c813e-9af2-3029-b68f-a37f11140a75",
                        "glosses": [
                            "устар., перен. простолюдин, человек незнатного происхождения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d4e0aa-75e3-4c08-be1b-67b4e109cdc7",
                                "sense_id": "0d36e33f-3a2a-3ead-a143-2a6c569c041a",
                                "text": "❬…❭ — Это Оська рядский, — отвечает он мне, — ишь раззевался, смерд этакой! ❬…❭"
                            },
                            {
                                "example_id": "60e5dd2a-770a-4503-9c06-90bb011e211d",
                                "sense_id": "0d36e33f-3a2a-3ead-a143-2a6c569c041a",
                                "text": "❬…❭ Простая, необразованная баба, кухарка, смерд — и вдруг позволяет себе такие слова и поступки!"
                            }
                        ]
                    }
