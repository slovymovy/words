                                                "sense_id": "3e4c9ec2-de24-3b68-9997-aab3a1e06af3",
                                                "text": "CHAPTER VI / THE DISEASES OF THE HYPOPHYSIS [PITUITARY GLAND]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17b9bc78-c9b5-3ae1-9828-330673594841",
                                        "entry_id": "abd41a19-b323-38f6-9b94-17274ce59692",
                                        "glosses": [
                                            "The top cell of the suspensor in a dicot embryo, which will differentiate to form part of the root cap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b0708cc-d49d-4c91-abdb-33a63b93ee23",
                                                "sense_id": "17b9bc78-c9b5-3ae1-9828-330673594841",
                                                "text": "All the cells of the suspensor, except one, are eventually crushed and obliterated by the growing embryo; this fortunate cell known as the hypophysis is the one in immediate contact with the embryo and plays an important role in the formation of the root apex."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
