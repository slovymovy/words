        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "39a48359-5bc7-38c0-9143-2a0b66bbd388",
                "word": "marineblauw",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d5795af5-e875-3bb2-a4e8-2bac90adfa4b",
                        "entry_id": "39a48359-5bc7-38c0-9143-2a0b66bbd388",
                        "glosses": [
                            "de kleur marineblauw hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14771a09-dd0b-4b00-a94b-742e3d77b18e",
                                "sense_id": "d5795af5-e875-3bb2-a4e8-2bac90adfa4b",
                                "text": "Hij rijdt in een marineblauwe auto."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77d3b0be-9329-4feb-861e-948c62e2d1cf",
                        "source_entry_id": "39a48359-5bc7-38c0-9143-2a0b66bbd388",
                        "source_sense_id": "d5795af5-e875-3bb2-a4e8-2bac90adfa4b",
                        "source_sense_description": "donkerblauw",
                        "target_lang_word": "marineblau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marineblau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "307eeaf6-77eb-3dd4-b696-a5a1fd2769d1",
                                        "entry_id": "c1977a68-bc68-31f5-9772-efb8b2771836",
                                        "glosses": [
                                            "in einem dunklen Blauton, der häufig bei Marineuniformen anzutreffen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11240819-5d68-4818-a65f-127fa25a37f9",
                                                "sense_id": "307eeaf6-77eb-3dd4-b696-a5a1fd2769d1",
                                                "text": "„Dort mietete er eine Stufenhecklimousine. Das Modell war ihm egal, aber es musste schwarz oder marineblau sein, seine bevorzugten Farben.“"
                                            },
                                            {
                                                "example_id": "dd22d3c6-599e-4abb-a171-b60f7d3b65ee",
                                                "sense_id": "307eeaf6-77eb-3dd4-b696-a5a1fd2769d1",
                                                "text": "„Die Fahrstuhltüren glitten auf und eine Traube von bulligen Männern quoll aus der Kabine, wie ein angreifendes Footballteam in identischen marineblauen Anzügen.“"
                                            },
                                            {
                                                "example_id": "39996018-7127-463c-93c6-8e683d178a10",
                                                "sense_id": "307eeaf6-77eb-3dd4-b696-a5a1fd2769d1",
                                                "text": "„Er trug einen schlichten, marineblauen Anzug von Brooks Brothers und sah trotz des leichten Hinkens und einer kleinen Narbe dicht unter dem linken Auge gut aus.“"
                                            },
                                            {
                                                "example_id": "f7cb483d-700f-4a2f-b0e6-d99146b329e2",
                                                "sense_id": "307eeaf6-77eb-3dd4-b696-a5a1fd2769d1",
                                                "text": "„Ich putzte ihm mit einer Kleiderbürste das Kokain vom Kragen seines makellosen marineblauen Anzugs.“"
                                            },
                                            {
                                                "example_id": "a2ab1b62-75c6-41b3-b9b8-05a32f2dcc33",
                                                "sense_id": "307eeaf6-77eb-3dd4-b696-a5a1fd2769d1",
                                                "text": "„Auf dem marineblauen Schaft des Stifts waren undeutlich zwei blutige Fingerabdrücke erkennbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36769fd4-664c-4db1-b6ad-6bd691c8fa27",
                        "source_entry_id": "39a48359-5bc7-38c0-9143-2a0b66bbd388",
                        "source_sense_id": "d5795af5-e875-3bb2-a4e8-2bac90adfa4b",
                        "source_sense_description": "donkerblauw",
                        "target_lang_word": "navy-blue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d35c0c19-91a2-4708-baf2-6d0dfa7b89cd",
                        "source_entry_id": "39a48359-5bc7-38c0-9143-2a0b66bbd388",
                        "source_sense_id": "d5795af5-e875-3bb2-a4e8-2bac90adfa4b",
                        "source_sense_description": "donkerblauw",
                        "target_lang_word": "bleu marine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleu marine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9344ac1c-34c0-3ee0-bd8c-89be7b5d8f2d",
                                        "entry_id": "50fd3714-5b5e-337e-8fe7-376700b362cb",
                                        "glosses": [
                                            "Couleur, nuance foncée du bleu. #000080"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb20f5fa-8e5d-4021-8eb8-a55432d55b85",
                                                "sense_id": "9344ac1c-34c0-3ee0-bd8c-89be7b5d8f2d",
                                                "text": "On obtient un beau bleu marine par le même procédé que le noir naphtol, en employant la marque 12 B et diminuant de moitié la quantité de colorant indiquée pour noir."
                                            },
                                            {
                                                "example_id": "cc5974fc-8b4f-47e8-b051-75d0bf0aa394",
                                                "sense_id": "9344ac1c-34c0-3ee0-bd8c-89be7b5d8f2d",
                                                "text": "Le bleu marine de l’ensemble valait mieux, certes, que le bleu horizon légendaire du costume des anciens de l’École enfantine Hériot. Cependant, sur les pointes du col rabattu, deux grenades rouges étaient un dangereux symbole."
                                            },
                                            {
                                                "example_id": "8b6e2dea-1fa6-49a2-bcaa-4cd3929296a8",
                                                "sense_id": "9344ac1c-34c0-3ee0-bd8c-89be7b5d8f2d",
                                                "text": "Il est loin d'être le seul à penser que le bleu marine est une couleur « de droite », voire aujourd'hui d’extrême droite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bleu marine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d2b857-f721-3635-bff0-b8249928a00f",
                                        "entry_id": "aad75013-ba62-34db-8cef-085abb7647a6",
                                        "glosses": [
                                            "De la couleur bleu marine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bc2097e-df52-40e3-a4aa-b89f3ff173e8",
                                                "sense_id": "a6d2b857-f721-3635-bff0-b8249928a00f",
                                                "text": "Mais super, super catholique pratiquante : les scouts, les rallyes, les premières communions, les jupes bleu marine, les cols Claudine, les talons plats, les madeleines confectionnées pour les vendre à la kermesse de monsieur le curé."
                                            },
                                            {
                                                "example_id": "5cd21de4-b1c0-476d-b69c-bd073c2152e6",
                                                "sense_id": "a6d2b857-f721-3635-bff0-b8249928a00f",
                                                "text": "Malgré les souffrances physiques que j’endure au moment où je trace ces lignes, je me souviens non sans une mélancolie amusée de l’abominable caban bleu marine dont m’affublait l’autrice de mes jours sans tenir compte de mes supplications : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
