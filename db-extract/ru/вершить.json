                "senses": [
                    {
                        "sense_id": "79b85100-aed2-3e3e-ac1c-a22310f6df11",
                        "entry_id": "c5e39719-db6f-30b7-884f-f9d809b2ee76",
                        "glosses": [
                            "to manage, to control, to direct, to do, to accomplish"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "cf3541e1-1bd0-4846-8553-3580711c890d",
                                "sense_id": "79b85100-aed2-3e3e-ac1c-a22310f6df11",
                                "text": "верши́ть правосу́дие",
                                "translation": "to administer justice, dispense justice, mete out justice, render justice",
                                "english": "to administer justice, dispense justice, mete out justice, render justice"
                            },
                            {
                                "example_id": "473ae1fa-0e37-4696-869b-76f038047b8c",
                                "sense_id": "79b85100-aed2-3e3e-ac1c-a22310f6df11",
                                "text": "верши́ть су́дьбами",
                                "translation": "to rule sway the destinies",
                                "english": "to rule sway the destinies"
                            },
                            {
                                "example_id": "150f7dd6-b818-4807-9f8e-5594f78b869c",
                                "sense_id": "79b85100-aed2-3e3e-ac1c-a22310f6df11",
                                "text": "верши́ть дела́ми",
                                "translation": "to manage control, to direct affairs",
                                "english": "to manage control, to direct affairs"
                            },
                            {
                                "example_id": "a9bc1657-6547-43dc-af0c-5e6353e86a36",
                                "sense_id": "79b85100-aed2-3e3e-ac1c-a22310f6df11",
                                "text": "Но ма́ленький, страда́вший на́сморком, заши́тый в по́лосы мате́рии на пу́говках челове́к, защити́вшись от со́лнца сте́нами, впусти́в лишь ну́жный пучо́к све́та по про́волоке в запа́янный стекля́нный стака́нчик, про́бовал верши́ть свою́ жизнь по-сво́ему.",
                                "translation": "Mikhail Osorgin",
                                "english": "Mikhail Osorgin"
                            }
                        ]
                    }
                ],
