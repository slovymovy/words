                "senses": [
                    {
                        "sense_id": "a437e89a-2f64-362e-985e-3e7a1f1531ce",
                        "entry_id": "edd1630a-d2ac-39e7-8bca-546b7434fda5",
                        "glosses": [
                            "Wissenschaftler, der sich mit Vulkanismus beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc7d66f3-eedb-4097-9cf6-19e96a5cf892",
                                "sense_id": "a437e89a-2f64-362e-985e-3e7a1f1531ce",
                                "text": "„Um neoklassische Bildungen handelt es sich auch bei den Derivaten Biologe \"Wissenschaftler, der sich mit der Lehre vom Leben befaßt\", Soziologe \"Forscher auf dem Gebiet der Soziologie\" und Vulkanologe \"Vulkanforscher\", die seit dem 19. Jhdt. belegt sind.“"
                            },
                            {
                                "example_id": "047dcf44-d2e1-4cb5-8ac6-f98581f57645",
                                "sense_id": "a437e89a-2f64-362e-985e-3e7a1f1531ce",
                                "text": "„Hier nimmt ein Vulkanforscher direkt am Schlot des Vulkans Lava- und Gasproben.“"
                            },
                            {
                                "example_id": "b3a55c9a-0b49-47d6-9700-6ff447a0286d",
                                "sense_id": "a437e89a-2f64-362e-985e-3e7a1f1531ce",
                                "text": "„Nach knapp einer Stunde erreichen wir La Chapelle de Rosemont, eine kleine, etwa 5 m hohe Lavagrotte, benannt nach dem Vulkanforscher Patu de Rosemont, dem die Grotte während seiner Forschungstouren als Wetterschutz diente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
