            {
                "entry_id": "8e2198fb-f045-3246-8c1c-558b81b50a91",
                "word": "orbitale",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8727e849-9445-4b80-ae63-aa173e673a24",
                        "entry_id": "8e2198fb-f045-3246-8c1c-558b81b50a91",
                        "tags": [
