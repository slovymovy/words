                        "examples": [
                            {
                                "example_id": "5870b73f-4c5a-4e6b-bd91-c6c67254c499",
                                "sense_id": "bc413d47-3f3f-33f5-976a-5c833997cb5f",
                                "text": "Onderzoek zou uitwijzen dat de melk van weidekoeien gezonder is. Wakker Dier concludeert: „Los van alle onderzoekscijfers geldt: een vreugdesprong van een koe zegt meer dan duizend woorden\"."
                            },
                            {
                                "example_id": "17a02c01-2404-4e28-96f4-b9f32c16599b",
                                "sense_id": "bc413d47-3f3f-33f5-976a-5c833997cb5f",
                                "text": "Uiteindelijk verliest de bedenker met de kerktoren in zicht door een vreugdesprong zijn evenwicht en wordt ook hij alsnog verslonden."
                            }
                        ]
