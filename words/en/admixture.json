    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45cfcd0a-c430-3c03-9cc3-38d10f4c0734",
                    "sense_definition": "A mixture or combination of different elements or ingredients.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dish featured an unusual <w>admixture</w> of sweet and savory spices."
                        },
                        {
                            "text": "Her speech was delivered with an <w>admixture</w> of humor and quiet seriousness."
                        }
                    ],
                    "synonyms": [
                        "blend",
                        "mixture",
                        "amalgam"
                    ]
                },
                {
                    "sense_id": "79ef0e16-19dd-3406-a229-c8cd4f260075",
                    "sense_definition": "The act or process of mixing an additional ingredient or substance into something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The careful <w>admixture</w> of chemicals resulted in a remarkably stable compound."
                        },
                        {
                            "text": "The subtle <w>admixture</w> of warm tones softened the harsh lighting in the room."
                        }
                    ],
                    "synonyms": [
