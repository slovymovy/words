                ],
                "senses": [
                    {
                        "sense_id": "f9d97417-c97d-3898-9e99-09ab47b51824",
                        "entry_id": "2e9e4637-7f25-33e6-8a33-7b2be7ec9223",
                        "glosses": [
                            "elastisches, ca. 2 bis 3 Meter langes dünnes Band aus Latex, mit dem Therapieübungen nach einer Hand- oder Armverletzung durchgeführt werden"
                        ],
                        "tags": [
                            "Physiotherapie"
                        ],
                        "examples": [
                            {
                                "example_id": "e64763c9-53c1-4121-aa85-81a9917aaa32",
                                "sense_id": "f9d97417-c97d-3898-9e99-09ab47b51824",
                                "text": "„Rudern und Paddeln mit dem Therapieband an der in Zugrichtung geöffneten Tür auf einem gepolsterten Stuhl zur Nachrichtenzeit. Die Übungen sind im Anhang in sinnvoller Reihenfolge noch einmal ausführlich beschrieben.“"
                            },
                            {
                                "example_id": "bfb50d8b-6df1-4bb0-bf15-23cb93580777",
                                "sense_id": "f9d97417-c97d-3898-9e99-09ab47b51824",
                                "text": "„Therapiebänder sind elastische Bänder aus Materialien wie Gummi, Latex, Latexfrei, Naturkautschuk oder Textil bestehen. Die Bänder sind für Übungen zur Kräftigung und zum Muskelaufbau geeignet.“"
                            },
                            {
                                "example_id": "7acfb214-e3e2-4119-8188-c505fc0977f6",
                                "sense_id": "f9d97417-c97d-3898-9e99-09ab47b51824",
                                "text": "„Ein Latexband (oder Gymnastikband) ist ein elastisches Band, das in der Physiotherapie zur allgemeinen körperlichen Ertüchtigung oder zum Krafttraining eingesetzt wird. Im Bereich der Physiotherapie werden die Bänder häufig als Therapieband, Physiotape, Thera-Band oder Powerband bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
