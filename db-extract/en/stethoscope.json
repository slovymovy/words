        "fr-extract.jsonl": [
            {
                "entry_id": "fc7457ad-9e3b-3388-a3c3-69593b7b2b4c",
                "word": "stethoscope",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b5745dfa-d69f-4d1f-afec-27fee0092593",
                        "entry_id": "fc7457ad-9e3b-3388-a3c3-69593b7b2b4c",
                        "tags": [
                            "plural"
                        ],
                        "form": "stethoscopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1cba0262-c24d-3a98-88c4-e63c2205c7e4",
                        "entry_id": "fc7457ad-9e3b-3388-a3c3-69593b7b2b4c",
                        "glosses": [
                            "Stéthoscope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e91e4a14-f78f-4913-9f81-b49e0474d6e7",
                                "sense_id": "1cba0262-c24d-3a98-88c4-e63c2205c7e4",
                                "text": "As Batson applied his stethoscope to the chest of the dead man, I glanced at our hostess not without interest.",
                                "translation": "Tandis que Batson appliquait son stéthoscope sur la poitrine du mort, je jetais un regard non sans intérêt à notre hôtesse."
                            },
                            {
                                "example_id": "7945c369-4f85-41ac-9e22-c3cca1691837",
                                "sense_id": "1cba0262-c24d-3a98-88c4-e63c2205c7e4",
                                "text": "I again place my stethoscope upon the chest, but no sound reaches my ear. I listen for five—for ten—for twenty seconds. There is nothing; all the vital reactions have disappeared.",
                                "translation": "Je place à nouveau mon stéthoscope sur la poitrine, mais aucun son ne parvient à mon oreille. J'écoute pendant cinq, dix, vingt secondes. Il n'y a rien ; toutes les réactions vitales ont disparu."
                            },
                            {
                                "example_id": "4328df46-7063-48d2-afcf-67ed5338fd67",
                                "sense_id": "1cba0262-c24d-3a98-88c4-e63c2205c7e4",
                                "text": "The prize was awarded to Professor Andral, who claimed that listening to the heart-sounds by means of the stethoscope was the surest way of ascertaining whether death had taken place or not, because with this instrument could still be heard the movement of the heart-valves, when by all other tests one could no longer detect any sign of life.",
                                "translation": "Le prix a été décerné au professeur Andral, qui prétendait que l'écoute des bruits du cœur au moyen du stéthoscope était le moyen le plus sûr de déterminer si la mort avait eu lieu ou non, car avec cet instrument, il était possible d'entendre le mouvement des valvules cardiaques, là où, avec tous les autres tests, on ne pouvait plus détecter aucun signe de vie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
