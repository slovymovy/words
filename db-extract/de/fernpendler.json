                "senses": [
                    {
                        "sense_id": "458f659d-72f3-34f3-becb-0740b29b64b5",
                        "entry_id": "90b3d2ac-375a-3b9b-8dd4-07134453ddb9",
                        "glosses": [
                            "Person, die eine große Wegstrecke zurücklegen muss, um von ihrem Wohnort an ihren Arbeitsplatz zu gelangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb5e111-89d4-4935-a80a-b63256d05bb7",
                                "sense_id": "458f659d-72f3-34f3-becb-0740b29b64b5",
                                "text": "„Die Zahl der Fernpendler wächst stetig, und weil Homeoffice kein Synonym mehr ist für Räsenmähen und Wohnungsputz, wird sie eher noch weiter zulegen.“"
                            },
                            {
                                "example_id": "15d536f8-0001-4ab2-993c-a9cc39747cb1",
                                "sense_id": "458f659d-72f3-34f3-becb-0740b29b64b5",
                                "text": "„Auch die Zahl der Fernpendler mit einem einfachen Arbeitsweg von mehr als 150 Kilometern ist seit der Jahrtausendwende gestiegen – von 1 Million auf 1,3 Millionen.“"
                            },
                            {
                                "example_id": "31060147-c062-455a-a94f-78d08d9a3d42",
                                "sense_id": "458f659d-72f3-34f3-becb-0740b29b64b5",
                                "text": "„Unerwähnt bleibt allerdings, dass der Fernpendler bei jeder pünktlichen ICE-Fahrt in nur 36 Minuten am Ziel ist, im Vergleich zur Autofahrt eine Stunde spart und zudem die Zeit im Zug gut nutzen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
