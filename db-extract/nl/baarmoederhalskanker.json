                            {
                                "example_id": "962d9212-004e-4739-ac67-1fbb48fee9c3",
                                "sense_id": "cde99d7a-a368-3374-afe9-ffdf5456bbe5",
                                "text": "Baarmoederhalskanker wordt in vrijwel alle gevallen veroorzaakt door een virus, te weten HPV (humaan papillomavirus) en is in het premaligne stadium eenvoudig te behandelen door aanstippen met azijn"
                            },
                            {
                                "example_id": "2b34a221-d482-479a-993e-ed973f0c116c",
                                "sense_id": "cde99d7a-a368-3374-afe9-ffdf5456bbe5",
                                "text": "Vorig jaar werd bekend dat Heesters baarmoederhalskanker had."
                            }
                        ]
                    }
