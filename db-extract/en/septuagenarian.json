                "senses": [
                    {
                        "sense_id": "10e1706f-6044-34e9-8b4a-996d6f8f2017",
                        "entry_id": "be713c96-0dbf-3a1b-8ba4-6d96a129d4f1",
                        "glosses": [
                            "Synonym of seventysomething: a person between 70 and 79 years old."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb8b4ec1-bde8-453c-a04f-c211a4554dc2",
                                "sense_id": "10e1706f-6044-34e9-8b4a-996d6f8f2017",
                                "text": "Mary Moon, she's a vegetarian.\nMary Moon, Mary Moon, Mary Moon.\nMary Moon, who will outlive all the septuagenarians."
                            },
                            {
                                "example_id": "91306c48-2931-4c47-9b84-e795c6a3ad5b",
                                "sense_id": "10e1706f-6044-34e9-8b4a-996d6f8f2017",
                                "text": "For a ley hunter, local people – particularly the elderly – can be mines of information. Devereux and Thomson recount how they asked a septuagenarian in a remote village the location of an elusive stone, without mentioning the subject of leys: […]"
                            },
                            {
                                "example_id": "9508fe91-cbaa-4cdb-8363-cb5c417c370a",
                                "sense_id": "10e1706f-6044-34e9-8b4a-996d6f8f2017",
                                "text": "“Let Them All Talk” is as breezy as an ocean cruise (pre-Covid), and mostly a welcome excuse to enjoy its three septuagenarian leads – Meryl Streep, Candice Bergen and Dianne Wiest – as they banter their way across the Atlantic."
                            }
                        ]
                    }
                ],
