                    },
                    {
                        "form_id": "303a0d18-91e2-4a20-bc2d-0fcdd6cf05ab",
                        "entry_id": "de97a3cc-0a0a-3716-a75d-7ed73095796f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Wegweiser"
                    },
                    {
                        "form_id": "c894fb0a-ca59-47b7-bfa9-32e0f8e5f52a",
                        "entry_id": "de97a3cc-0a0a-3716-a75d-7ed73095796f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wegweiser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "647ec5c9-1b95-37b0-bacc-85278c1afc0b",
                        "entry_id": "de97a3cc-0a0a-3716-a75d-7ed73095796f",
                        "glosses": [
                            "Gegenstand, der den Weg zu einem oder mehreren Orten anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c72cb9b7-00fa-4de8-9bb4-84e32ce30843",
                                "sense_id": "647ec5c9-1b95-37b0-bacc-85278c1afc0b",
                                "text": "Laut dem Wegweiser müssen wir nach Osten gehen."
                            },
                            {
                                "example_id": "1f7e8ad9-3f45-4cf5-baad-2f20856d61c3",
                                "sense_id": "647ec5c9-1b95-37b0-bacc-85278c1afc0b",
                                "text": "Wir sind allen Wegweisern gefolgt, aber trotzdem nicht an der österreichischen, sondern an der Schweizer Grenze gelandet."
                            },
                            {
                                "example_id": "bf701854-676a-4b70-9028-06da8afd8d76",
                                "sense_id": "647ec5c9-1b95-37b0-bacc-85278c1afc0b",
                                "text": "„Dafür sind körperliche Fitness, Trittsicherheit und ein guter Orientierungssinn notwendig, denn Wanderwegmarkierungen und Wegweiser gibt es hier fast keine.“"
                            },
                            {
                                "example_id": "35dffad2-1c77-4298-996b-57a6aeec035c",
                                "sense_id": "647ec5c9-1b95-37b0-bacc-85278c1afc0b",
                                "text": "„Und im Fluge ging es weiter über das Plateau hin, abwechselnd an Blumen und Felszacken und dann wieder an Kreuzwegen und Wegweisern vorüber.“"
                            },
                            {
                                "example_id": "1a3073ba-1344-4be3-ac4d-cff29de4736c",
                                "sense_id": "647ec5c9-1b95-37b0-bacc-85278c1afc0b",
                                "text": "„Er arbeitete im Gegenteil noch immer in dem Glauben, die Strömung müsse ihm ja auf jeden Fall die Bahn zeigen, wohin der Fluß gehe, wobei das zahlreich treibende Holz einen guten Wegweiser abgeben werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d849b25f-9a56-4663-8786-266853af03aa",
                        "source_entry_id": "de97a3cc-0a0a-3716-a75d-7ed73095796f",
                        "source_sense_id": "647ec5c9-1b95-37b0-bacc-85278c1afc0b",
                        "source_sense_description": "Gegenstand, der den Weg zu einem oder mehreren Orten anzeigt",
                        "target_lang_word": "signpost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signpost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4ec9d08-84be-33d7-943e-ffc776c64583",
                                        "entry_id": "559e3505-ac4c-3732-aa8f-c66d74277761",
                                        "glosses": [
                                            "A post bearing a sign that gives information on directions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f75bfcd-943d-47bb-b823-78aa0d200a09",
                                                "sense_id": "b4ec9d08-84be-33d7-943e-ffc776c64583",
                                                "text": "Dozens of signposts have been stolen, forcing the local authorities to put up the sign at a 2m height and embed it in theft-resistant concrete when putting up replacements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a3ac30e-dd50-37f3-b907-c82ca8c97ccb",
                                        "entry_id": "559e3505-ac4c-3732-aa8f-c66d74277761",
                                        "glosses": [
                                            "A word or phrase within a clue that serves as an indicator, rather than being fodder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2224bde4-5e49-4084-b081-9769285b7cf4",
                                                "sense_id": "1a3ac30e-dd50-37f3-b907-c82ca8c97ccb",
                                                "text": "In the first example — Dance revolutionised Burma — you know the middle word is the signpost as revolutionised is too long to be the fodder (or letters to scramble). […] And bang, out jumps RUMBA."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "signpost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a566ebba-5b75-3559-b056-51929df0132c",
                                        "entry_id": "74826f9b-3708-3b1a-ba78-47a8ff7766d6",
                                        "glosses": [
                                            "To install signposts on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588486aa-454b-43e7-b441-0a530d06ac72",
                                                "sense_id": "a566ebba-5b75-3559-b056-51929df0132c",
                                                "text": "The route wasn't signposted, and we got lost on the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51ff6b91-8739-3b42-9dc5-3c80d4f7f5ca",
                                        "entry_id": "74826f9b-3708-3b1a-ba78-47a8ff7766d6",
                                        "glosses": [
                                            "To direct (somebody) to services, resources, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbaf2239-c714-4387-a68f-4935cfb76aff",
                                                "sense_id": "51ff6b91-8739-3b42-9dc5-3c80d4f7f5ca",
                                                "text": "We believe that some Carers' Centres already offer an effective 'first stop shop' for signposting carers to local organisations, services and benefits, and for providing ongoing support as carers' circumstances change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9bf3c1f-2bf2-31cf-b51f-ef80ca4358fc",
                                        "entry_id": "74826f9b-3708-3b1a-ba78-47a8ff7766d6",
                                        "glosses": [
                                            "To indicate logical progress of a discourse using words or phrases such as now, right, to recap, to sum up, as I was saying, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a31a85ca-a5be-4a93-b3c4-d6b28b62b20a",
                                                "sense_id": "a9bf3c1f-2bf2-31cf-b51f-ef80ca4358fc",
                                                "text": "Bede, never one to shrink from a challenge, focused his energies not only onto calculating Easter but also onto describing why the maths mattered as much as the result. In this, his elevated rhetoric is balanced by a very human enthusiasm — it's hard not to love a writer who signposts his core hypotheses with phrases such as 'now to gut the bowels of this question!'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3f36b2e-948b-3a7e-92ba-00fa2cf52066",
                                        "entry_id": "74826f9b-3708-3b1a-ba78-47a8ff7766d6",
                                        "glosses": [
                                            "To signal, as if with a signpost."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
