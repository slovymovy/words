                    {
                        "sense_id": "692248d8-febc-3273-889c-1ba4dcb1d99f",
                        "entry_id": "4b40f3c2-3053-3410-8884-bfd4ce63fba6",
                        "glosses": [
                            "Monté sur roues et sur chenilles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4edcf9fe-5a18-3d65-a4b3-9be7d304370d",
                        "entry_id": "4b40f3c2-3053-3410-8884-bfd4ce63fba6",
                        "glosses": [
                            "Monté sur un véhicule doté de deux roues directrices, motrices ou non, à l'avant, et de deux trains chenillés, moteurs ou non, sur la partie arrière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f8537d-02c2-4abe-9524-451873574349",
                                "sense_id": "4edcf9fe-5a18-3d65-a4b3-9be7d304370d",
                                "text": "En 1931, l'armée américaine souhaite se doter d'un véhicule semi-chenillé de transport de troupes, comme en possède déjà à cette époque l'Armée française. S'inspirant de divers modèles, et notamment du Kegresse P17 Français, les Américains mettent au point leur propre semi-chenillé, le \"Half Track\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b208c8bf-c7d1-4cb7-a48e-e4f617010c02",
                        "source_entry_id": "4b40f3c2-3053-3410-8884-bfd4ce63fba6",
                        "source_sense_description": "Véhicule à roues et à chenilles",
                        "target_lang_word": "Halbkettenfahrzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbkettenfahrzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a595142-1065-39d0-9ec8-b605536d16f9",
                                        "entry_id": "c1eac15a-ebfb-3954-9b6c-437ba8d7720b",
                                        "glosses": [
                                            "Fahrzeug, dessen Fahrwerk sowohl Räder als auch einen Teil Kettenlaufwerk aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94cb5c51-dae7-4e42-ba8f-c5895c2e18fc",
                                                "sense_id": "4a595142-1065-39d0-9ec8-b605536d16f9",
                                                "text": "„›Wir waren die ersten Soldaten dort, mit unseren Halbkettenfahrzeugen, und dann sehe ich, dass er an der Kotel steht und weint und trinkt, außer sich vor Freude.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
