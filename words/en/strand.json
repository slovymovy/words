                {
                    "sense_id": "44615ef9-a19a-3b7b-8b32-87b84883c340",
                    "sense_definition": "The shore or beach of the sea or ocean.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipwrecked sailors were finally washed up on a lonely <w>strand</w>.",
                            "target_lang_translations": {
                                "ru": "Потерпевших кораблекрушение моряков в конце концов выбросило на пустынный <w>берег</w>.",
                                "de": "Die schiffbrüchigen Matrosen wurden schließlich an einen einsamen <w>Strand</w> gespült.",
                                "tr": "Gemi kazası geçiren denizciler sonunda ıssız bir <w>kıyıya</w> vurdular.",
                                "zh": "遭遇海难的水手们最终被冲上了一片荒凉的<w>海滩</w>。"
                            }
                        },
                        {
                            "text": "They walked along the sandy <w>strand</w> as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Они гуляли по песчаному <w>пляжу</w>, когда солнце начало садиться.",
                                "de": "Sie gingen am sandigen <w>Strand</w> entlang, als die Sonne unterging.",
                                "tr": "Güneş batmaya başlarken kumsalda, <w>sahil</w> boyunca yürüdüler.",
                                "zh": "太阳开始落山时，他们沿着沙<w>滩</w>散步。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beach"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "often used in literary or poetic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Берег или пляж моря или океана (часто в поэтическом контексте).",
                        "de": "Das Ufer oder der Sandbereich am Meer oder Ozean.",
                        "tr": "Deniz veya okyanus kıyısı ya da kumsalı.",
                        "zh": "海或洋的岸边、海滩。"
                    },
                    "translations": {
