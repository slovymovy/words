{
    "word_family": [
        "whizbang",
        "whizzer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70d03fb8-782a-32a6-8f41-e53602f2548e",
                    "sense_definition": "A person who is remarkably skilled or proficient at something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My younger brother is a computer <w>whiz</w> who can repair almost any device.",
                            "target_lang_translations": {
                                "ru": "Мой младший брат — компьютерный <w>гений</w>, который может починить практически любое устройство."
                            }
                        },
                        {
                            "text": "She proved to be a math <w>whiz</w> by solving the complex equation in minutes.",
                            "target_lang_translations": {
                                "ru": "Она проявила себя настоящим математическим <w>виртуозом</w>, решив сложное уравнение за считаные минуты."
                            }
                        }
                    ],
                    "synonyms": [
                        "ace",
                        "expert",
                        "master",
                        "wizard"
                    ],
                    "common_phrases": [
                        "computer whiz",
                        "math whiz"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий исключительными навыками или талантом в каком-либо деле; профи или гений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гений",
                                "target_lang_sense_clarification": "очень талантливый человек"
                            },
                            {
                                "target_lang_word": "мастер",
                                "target_lang_sense_clarification": "умелец, специалист"
                            },
                            {
                                "target_lang_word": "виртуоз",
                                "target_lang_sense_clarification": "человек, в совершенстве владеющий техникой"
                            },
                            {
                                "target_lang_word": "эксперт",
                                "target_lang_sense_clarification": "знаток своего дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a4b8ffc-1ec9-37c1-bc63-6927fb3345c0",
                    "sense_definition": "A hissing or rushing sound like that of an object flying rapidly through the air.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sharp <w>whiz</w> of the arrow made the hunter freeze in place.",
                            "target_lang_translations": {
                                "ru": "Резкий <w>свист</w> стрелы заставил охотника замереть на месте."
                            }
                        },
                        {
                            "text": "We heard the sudden <w>whiz</w> of a stone passing close to our heads.",
                            "target_lang_translations": {
                                "ru": "Мы услышали внезапный <w>свист</w> камня, пролетевшего совсем рядом с нашими головами."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свист или жужжание быстро летящего в воздухе предмета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свист",
                                "target_lang_sense_clarification": "звук летящего предмета"
                            },
                            {
                                "target_lang_word": "жужжание",
                                "target_lang_sense_clarification": "гул рассекающего воздух объекта"
                            },
                            {
                                "target_lang_word": "вжик",
                                "target_lang_sense_clarification": "резкий свистящий звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "312caf53-2439-3602-913e-80531953b998",
                    "sense_definition": "An act of urination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We pulled over at a rest stop because he had to take a <w>whiz</w>.",
                            "target_lang_translations": {
                                "ru": "Мы остановились в зоне отдыха, потому что ему нужно было <w>отлить</w>."
                            }
                        },
                        {
                            "text": "The driver took a quick <w>whiz</w> behind the service station before continuing.",
                            "target_lang_translations": {
                                "ru": "Водитель быстренько <w>пописал</w> за станцией техобслуживания, прежде чем продолжить путь."
                            }
                        }
                    ],
                    "synonyms": [
                        "pee",
                        "urination"
                    ],
                    "common_phrases": [
                        "take a whiz"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal slang for urination"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт мочеиспускания (разговорное/сленговое)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пописать",
                                "target_lang_sense_clarification": "в устойчивых фразах, например take a whiz"
                            },
                            {
                                "target_lang_word": "отлить",
                                "target_lang_sense_clarification": "сленговый акт мочеиспускания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dba24bfd-4f8c-3897-9d3f-1f53ab99734e",
                    "sense_definition": "Amphetamine or speed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police seized several bags of illegal <w>whiz</w> during the overnight raid.",
                            "target_lang_translations": {
                                "ru": "Во время ночного рейда полиция изъяла несколько пакетов нелегального <w>амфетамина</w>."
                            }
                        },
                        {
                            "text": "He fell into addiction after experimenting with cheap street <w>whiz</w> at parties.",
                            "target_lang_translations": {
                                "ru": "Он попал в зависимость после того, как попробовал на вечеринках дешевый уличный <w>спид</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "street slang for amphetamine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Амфетамин или спиды (уличное сленговое название наркотика)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спид",
                                "target_lang_sense_clarification": "амфетамин на сленге"
                            },
                            {
                                "target_lang_word": "амфетамин",
                                "target_lang_sense_clarification": "наркотическое вещество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01c0c204-ab89-3726-8a30-6f1269e05162",
                    "sense_definition": "The trade or practice of pickpocketing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old thief claimed he spent twenty years working the <w>whiz</w> in crowded train stations.",
                            "target_lang_translations": {
                                "ru": "Старый вор утверждал, что двадцать лет промышлял <w>карманными кражами</w> на переполненных вокзалах."
                            }
                        },
                        {
                            "text": "He learned the tricks of the <w>whiz</w> from seasoned pickpockets in the city.",
                            "target_lang_translations": {
                                "ru": "Он перенял тонкости <w>щипачества</w> у опытных городских карманников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the whiz"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "underworld and thieves' slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Карманные кражи как ремесло или деятельность (воровской жаргон)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карманная кража",
                                "target_lang_sense_clarification": "карманничество"
                            },
                            {
                                "target_lang_word": "щипачество",
                                "target_lang_sense_clarification": "воровской жаргон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97622e91-e9bd-3e3c-bc38-244d4221681f",
                    "sense_definition": "To rush or travel very rapidly, often producing a humming or rushing sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cars would constantly <w>whiz</w> by our house at dangerous speeds.",
                            "target_lang_translations": {
                                "ru": "Машины постоянно <w>проносились</w> мимо нашего дома на опасной скорости."
                            }
                        },
                        {
                            "text": "A cyclist <w>whizzed</w> past the pedestrians walking on the narrow sidewalk.",
                            "target_lang_translations": {
                                "ru": "Велосипедист <w>пролетел</w> мимо пешеходов, идущих по узкому тротуару."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whiz by",
                        "whiz past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мчаться, нестись или проноситься с большой скоростью (часто со свистом)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проноситься",
                                "target_lang_sense_clarification": "очень быстро двигаться мимо"
                            },
                            {
                                "target_lang_word": "мчаться",
                                "target_lang_sense_clarification": "нестись на большой скорости"
                            },
                            {
                                "target_lang_word": "пролетать",
                                "target_lang_sense_clarification": "быстро проезжать или проноситься"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15311f73-1a44-3873-8936-33c3291c9f3d",
                    "sense_definition": "To make a humming, buzzing, or hissing sound while traveling through the air.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bullets began to <w>whiz</w> dangerously close over the heads of the soldiers.",
                            "target_lang_translations": {
                                "ru": "Пули стали опасно близко <w>свистеть</w> над головами солдат."
                            }
                        },
                        {
                            "text": "We listened to the spinning blades <w>whiz</w> as the small drone launched.",
                            "target_lang_translations": {
                                "ru": "Мы слушали, как <w>жужжат</w> вращающиеся лопасти при запуске небольшого дрона."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свистеть, жужжать или рассекать воздух с характерным звуком во время полета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свистеть",
                                "target_lang_sense_clarification": "издавать свистящий звук при полете"
                            },
                            {
                                "target_lang_word": "рассекать воздух",
                                "target_lang_sense_clarification": "лететь со свистом"
                            },
                            {
                                "target_lang_word": "жужжать",
                                "target_lang_sense_clarification": "гудеть при быстром вращении или движении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70147ebf-c6d0-3eb2-bb7a-7a23d574eb2a",
                    "sense_definition": "To urinate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The campers stepped away from the tents to <w>whiz</w> in the darkness.",
                            "target_lang_translations": {
                                "ru": "Туристы отошли от палаток, чтобы <w>пописать</w> в темноте."
                            }
                        },
                        {
                            "text": "The puppy suddenly stopped to <w>whiz</w> right next to the fence.",
                            "target_lang_translations": {
                                "ru": "Щенок вдруг остановился, чтобы <w>помочиться</w> прямо у забора."
                            }
                        }
                    ],
                    "synonyms": [
                        "pee",
                        "urinate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мочиться, справлять малую нужду (разговорное/сленговое)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "писать",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "отлить",
                                "target_lang_sense_clarification": "просторечное/сленговое"
                            },
                            {
                                "target_lang_word": "помочиться",
                                "target_lang_sense_clarification": "нейтральное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e6b56fc-5910-31b8-a6e2-6832df9760a6",
                    "sense_definition": "To throw, fling, or spin something with great speed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher managed to <w>whiz</w> the baseball straight across the plate.",
                            "target_lang_translations": {
                                "ru": "Питчеру удалось со свистом <w>метнуть</w> мяч прямо над базой."
                            }
                        },
                        {
                            "text": "He loved to <w>whiz</w> stones across the frozen surface of the lake.",
                            "target_lang_translations": {
                                "ru": "Он любил со свистом <w>запускать</w> камни по замерзшей глади озера."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Швырять, метать или запускать что-либо с огромной скоростью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швырять",
                                "target_lang_sense_clarification": "бросать с силой"
                            },
                            {
                                "target_lang_word": "метать",
                                "target_lang_sense_clarification": "запускать предмет с высокой скоростью"
                            },
                            {
                                "target_lang_word": "запускать со свистом",
                                "target_lang_sense_clarification": "кидать на большой скорости"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "e9b5a370-dbb1-31ae-b552-4ae2cf25454c",
                    "sense_definition": "Pronunciation spelling of <w>with</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you coming <w>whiz</w> us to the store down the road?",
                            "target_lang_translations": {
                                "ru": "Ты идешь <w>с</w> нами в магазин ниже по улице?"
                            }
                        },
                        {
                            "text": "He asked if he could stay <w>whiz</w> me until tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Он спросил, может ли остаться <w>со</w> мной до завтрашнего утра."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "nonstandard pronunciation spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Диалектная или разговорная форма передачи слова «with» (с, вместе с)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с",
                                "target_lang_sense_clarification": "вместе с кем-либо или чем-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}