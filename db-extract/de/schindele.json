                ],
                "senses": [
                    {
                        "sense_id": "c522838a-e6d5-37a5-962b-4698c9c45e05",
                        "entry_id": "13500acc-e0dd-35e2-9764-86d74f833d7f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857fa09d-f498-4cee-931d-aea20be1812b",
                                "sense_id": "c522838a-e6d5-37a5-962b-4698c9c45e05",
                                "text": "Frau Schindele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2fd508ad-311e-47d2-9fca-5f80e9fbf437",
                                "sense_id": "c522838a-e6d5-37a5-962b-4698c9c45e05",
                                "text": "Herr Schindele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8e2d41d4-55de-40b0-ab0f-5a02749b7048",
                                "sense_id": "c522838a-e6d5-37a5-962b-4698c9c45e05",
                                "text": "Die Schindeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3b042dc9-8b3b-419e-b51d-f99741c9a90f",
                                "sense_id": "c522838a-e6d5-37a5-962b-4698c9c45e05",
                                "text": "Der Schindele trägt nie die Schals, die die Schindele ihm strickt."
                            },
                            {
                                "example_id": "3a29bb5c-4d20-4d7d-b34a-f2b1755ccb79",
                                "sense_id": "c522838a-e6d5-37a5-962b-4698c9c45e05",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schindele kommt, geht der Herr Schindele.“"
                            },
                            {
                                "example_id": "32cb6df0-25f3-49ed-b171-c3c2c149d2a1",
                                "sense_id": "c522838a-e6d5-37a5-962b-4698c9c45e05",
                                "text": "Schindele kommt und geht."
                            },
                            {
                                "example_id": "63bd4a92-61c4-4c7b-b2b5-5859a093d1f1",
                                "sense_id": "c522838a-e6d5-37a5-962b-4698c9c45e05",
                                "text": "Schindeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
