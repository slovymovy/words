                    "frequency": "Low",
                    "semantic_group_id": "dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rups van de <w>pijlstaart</w> heeft vaak een opvallende stekel aan de achterkant.",
                            "target_lang_translations": {
                                "en": "The caterpillar of the <w>hawk moth</w> often has a striking spine on its back."
                            }
                        },
                        {
                            "text": "Tijdens de schemering zag ik een grote <w>pijlstaart</w> boven de bloemen zweven.",
                            "target_lang_translations": {
