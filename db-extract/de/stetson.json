                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c17cecd-322c-4f4b-93c2-9a611ed3ac6f",
                                "sense_id": "66829861-d07e-3539-98b9-3937a7ae38ac",
                                "text": "„Ihren Stetson behalten sie auf, behäbig hocken sie hinter Rührei und Kartoffeln.“"
                            },
                            {
                                "example_id": "e31af629-01ae-4f30-bd55-da01d6bab509",
                                "sense_id": "66829861-d07e-3539-98b9-3937a7ae38ac",
                                "text": "„Das Backsteinrot seines Gesichts, bemerkte sie, hörte an einer weißen Linie auf, die der Stetson hinterlassen hatte, der jetzt an einem der Pflöcke der Zeltstange hing.“"
                            },
                            {
                                "example_id": "da41dd34-005f-48f8-9a02-2bd7013cb2eb",
                                "sense_id": "66829861-d07e-3539-98b9-3937a7ae38ac",
                                "text": "„Von einer Orchestertournee nach Las Vegas hat er sich einen schwarzen Stetson mitgebracht, mit dem er extrem bescheuert aussieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
