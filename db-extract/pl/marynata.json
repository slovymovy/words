                "senses": [
                    {
                        "sense_id": "16fe171c-5b53-3137-81bb-e114096783da",
                        "entry_id": "635ee613-e4f4-3b1c-9185-47628e1c166e",
                        "glosses": [
                            "mieszanina przypraw suchych lub płynnych przygotowana do nadania produktom spożywczym pewnych walorów smakowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d90dac06-cf7d-4456-ae06-0438f04d97f0",
                                "sense_id": "16fe171c-5b53-3137-81bb-e114096783da",
                                "text": "Przed włożeniem do piekarnika, dobrze jest włożyć cielęcinę do marynaty na kilka godzin."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e3e52fd4-0b0e-3048-bb49-142a2ca85362",
                        "entry_id": "635ee613-e4f4-3b1c-9185-47628e1c166e",
                        "glosses": [
                            "produkt spożywczy zakonserwowany marynatą (1.3)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab65e643-f67a-47da-bcf3-4c280d6443f1",
                                "sense_id": "e3e52fd4-0b0e-3048-bb49-142a2ca85362",
                                "text": "Do kaszy z gulaszem podaję zwykle jakieś marynaty: ogórki, papryki lub patisony."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "4b7d02d7-b905-3e7f-9430-06a626f59d88",
                        "entry_id": "635ee613-e4f4-3b1c-9185-47628e1c166e",
                        "glosses": [
                            "zalewa octowa przeznaczona do przyrządzenia marynaty (1.2)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f8ecb78-de52-4ece-a662-01f32acfe986",
                        "source_entry_id": "635ee613-e4f4-3b1c-9185-47628e1c166e",
                        "source_sense_id": "16fe171c-5b53-3137-81bb-e114096783da",
                        "target_lang_word": "marinade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marinade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf261707-02e4-365c-b5c8-65521eeeab2e",
                                        "entry_id": "19cf8204-567c-3c57-ba3d-a228544a6a60",
                                        "glosses": [
                                            "A seasoned, often acidic liquid mixture in which food is marinated, or soaked, usually to flavor and prepare it for cooking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e0a6d2-707c-4648-b228-e5d13219a84c",
                                                "sense_id": "cf261707-02e4-365c-b5c8-65521eeeab2e",
                                                "text": "I like to use a lemon marinade with chicken."
                                            },
                                            {
                                                "example_id": "9921e061-4776-460d-9bdb-0cd7abd9d7f1",
                                                "sense_id": "cf261707-02e4-365c-b5c8-65521eeeab2e",
                                                "text": "How much marinade you need depends on the amount of food to be marinated."
                                            },
                                            {
                                                "example_id": "8618a447-f14e-448d-a9c1-f85bee4d99c1",
                                                "sense_id": "cf261707-02e4-365c-b5c8-65521eeeab2e",
                                                "text": "First, marinate the tofu. In a bowl, whisk the kecap manis, chilli sauce, and sesame oil together. Cut the tofu into strips about 1cm thick, mix gently (so it doesn't break) with the marinade and leave in the fridge for half an hour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marinade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b979ba-ee41-3fbc-8c33-ef12b1b5b13c",
                                        "entry_id": "daa20680-59b8-33a0-9719-d936d6506841",
                                        "glosses": [
                                            "To marinate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "985ced18-f885-49ba-ab74-9118d7006073",
                                                "sense_id": "c2b979ba-ee41-3fbc-8c33-ef12b1b5b13c",
                                                "text": "You could just use ordinary shop-bought kecap manis to marinade the meat, but making your own is easy, has a far more elegant fragrance and is, above all, such a great brag! Flavouring kecap manis is an intensely personal thing, so try this version now and next time cook the sauce down with crushed, split lemongrass and a shredded lime leaf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02691f9b-61ea-428a-8bb6-5f9c216729e4",
                        "source_entry_id": "635ee613-e4f4-3b1c-9185-47628e1c166e",
                        "source_sense_id": "16fe171c-5b53-3137-81bb-e114096783da",
                        "target_lang_word": "marináda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f53076f2-aba0-496f-a192-660be301f2e2",
                        "source_entry_id": "635ee613-e4f4-3b1c-9185-47628e1c166e",
                        "source_sense_id": "16fe171c-5b53-3137-81bb-e114096783da",
                        "target_lang_word": "marinade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marinade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8457fc7b-4531-3fdf-b253-92d44b4e6c89",
                                        "entry_id": "4d2da383-ef68-3321-bd22-b914b11983b3",
                                        "glosses": [
                                            "Liquide assaisonné, souvent à base d’huile, dans lequel sont mis à tremper, quelques heures, des morceaux de viande ou de poisson pour les attendrir et en modifier le goût."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9e2eefc-4ad4-41e1-bf85-a57774c89a59",
                                                "sense_id": "8457fc7b-4531-3fdf-b253-92d44b4e6c89",
                                                "text": "Préparer une marinade avec un oignon émincé, de l’huile d’olive et du vin rouge."
                                            },
                                            {
                                                "example_id": "f3c7fe99-e7c9-4ff4-864b-69111f4140b1",
                                                "sense_id": "8457fc7b-4531-3fdf-b253-92d44b4e6c89",
                                                "text": "Au mélange d’épices, incorporer le yaourt, l’ail, le gingembre, les amandes, la poudre de chili, le jus de citron et le sel pour obtenir la marinade. En enduire délicatement la viande à la main, en prenant soin de la faire pénétrer dans les ciselures.\n Laisser mariner le gigot toute une nuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43a2070b-8e26-34ca-b775-6a86002235f4",
                                        "entry_id": "4d2da383-ef68-3321-bd22-b914b11983b3",
                                        "glosses": [
                                            "Viande ou légume mariné & frit à la poêle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69172ed5-2c3a-4943-acca-650588826148",
                                                "sense_id": "43a2070b-8e26-34ca-b775-6a86002235f4",
                                                "text": "Des poulets en marinade."
                                            },
                                            {
                                                "example_id": "053c89b1-3492-4463-a361-2fc9f3a61221",
                                                "sense_id": "43a2070b-8e26-34ca-b775-6a86002235f4",
                                                "text": "Un petit plat d'artichauts frits en marinade."
                                            },
                                            {
                                                "example_id": "5d1e9468-395c-4bad-a8ac-f1b3011d3d18",
                                                "sense_id": "43a2070b-8e26-34ca-b775-6a86002235f4",
                                                "text": "Fritot ou marinade de volaille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
