                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Drzewa w sadzie obrodziły w tym roku wyjątkowo <dobrze>.",
                            "target_lang_translations": {
                                "ru": "Деревья в саду в этом году плодоносили исключительно <хорошо>.",
