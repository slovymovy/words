                                "sense_id": "f82fe363-6834-33e3-adfb-5e757acaee01",
                                "text": "Ce chat est amiteux avec les enfants."
                            },
                            {
                                "example_id": "3a42e388-120e-4ddf-880b-679b8eab836e",
                                "sense_id": "f82fe363-6834-33e3-adfb-5e757acaee01",
                                "text": "Tout ce qu'elle voyait, tout ce qu'elle faisait n'avait plus de goût pour elle, et lui rappelait le temps où elle avait eu ce bon compagnon si tranquille et si amiteux."
                            },
                            {
                                "example_id": "debde984-cd42-4ae0-9b0c-71a29dd319b1",
                                "sense_id": "f82fe363-6834-33e3-adfb-5e757acaee01",
                                "text": "Sylvinet était si amiteux et si fin d’esprit qu’on ne pouvait pas l’aimer moins que son cadet."
                            },
                            {
                                "example_id": "d252c7e9-c0f8-40a9-ac8b-f2c337280fbe",
                                "sense_id": "f82fe363-6834-33e3-adfb-5e757acaee01",
                                "text": "« Qu'y peux-tu faire, camarade\n Si nous sommes cet amiteux ? »"
                            }
                        ]
                    }
