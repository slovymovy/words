                        "entry_id": "e0077f80-05a9-36c4-8e9e-9f82d402e52f",
                        "glosses": [
                            "Ansammlung mehrerer übereinandergeworfener, unsortiert abgelegter Teile aus Eisen an einem Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9273518-4087-41e4-806d-b94560f848f1",
                                "sense_id": "e2aa5aae-05a4-3908-92ce-f91436074ab3",
                                "text": "Auf dem Schrotthaufen landet Altmetall und wird später der Wiederverwertung in einem Eisenwerk zugeführt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
