                "senses": [
                    {
                        "sense_id": "c43274b2-7886-3fe0-a6c2-c0c14eb92ca6",
                        "entry_id": "21c8636a-6011-3255-a5ea-70356d1d23f4",
                        "glosses": [
                            "Professor für Rechtswissenschaften"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "107a7ee6-515c-4873-8153-93d2af612a55",
                                "sense_id": "c43274b2-7886-3fe0-a6c2-c0c14eb92ca6",
                                "text": "„Christoph Bezemek, Jusprofessor an der Universität Graz, forderte ein Gesetz gegen das Fotografieren des eigenen Stimmzettels.“"
                            },
                            {
                                "example_id": "68ae8cec-b467-494d-a110-6f580dd16a08",
                                "sense_id": "c43274b2-7886-3fe0-a6c2-c0c14eb92ca6",
                                "text": "„Der 50-jährige Jusprofessor hatte mit der Aktion Occupy Central die Bewegung ins Leben gerufen.“"
                            },
                            {
                                "example_id": "66e72a8d-927e-45e1-817b-7fd28e069af6",
                                "sense_id": "c43274b2-7886-3fe0-a6c2-c0c14eb92ca6",
                                "text": "„Der Bremer Jusprofessor Andreas Fischer-Lescano hatte dem christlichsozialen Politiker vorgeworfen, in seiner Dissertation einige Passagen wortwörtlich von anderen Autoren übernommen zu haben, ohne dies wie vorgeschrieben zu kennzeichnen.“"
                            },
                            {
                                "example_id": "049bb65b-4300-476b-b12d-97f10c825994",
                                "sense_id": "c43274b2-7886-3fe0-a6c2-c0c14eb92ca6",
                                "text": "„Der auf Digitales spezialisierte Jusprofessor der Uni Wien sagt, die Idee stehe ‚in einem schwierigen Spannungsverhältnis‘ mit Meinungs- und Informationsfreiheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
