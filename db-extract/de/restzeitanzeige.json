                "senses": [
                    {
                        "sense_id": "f39798ee-b5f9-34d1-b6fe-8c04b74786df",
                        "entry_id": "b5194e81-ce9a-376c-b1d8-faaa9c2486fd",
                        "glosses": [
                            "Anzeige der Zeit, die bis zum Eintreten eines bestimmten Ereignisses noch zur Verfügung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38bb0b0e-4951-447b-a51e-caf0ab6f2e47",
                                "sense_id": "f39798ee-b5f9-34d1-b6fe-8c04b74786df",
                                "text": "„In Bauphase 2 wird dann der Verkehr über die bereits sanierte Fahrbahn geführt und mit Ampeln mit einer Restzeitanzeige geregelt.“"
                            },
                            {
                                "example_id": "085bdd36-8cf4-4fb3-9e46-ffad580e5840",
                                "sense_id": "f39798ee-b5f9-34d1-b6fe-8c04b74786df",
                                "text": "„In der Schweiz ist vor allem aufgrund der ÖV-Priorisierung häufig eine verkehrsabhängige Steuerung vorhanden. Dies verunmöglicht eine Restzeitanzeige.“"
                            },
                            {
                                "example_id": "e38845a7-69b8-4998-a80a-f6b8591db194",
                                "sense_id": "f39798ee-b5f9-34d1-b6fe-8c04b74786df",
                                "text": "„Zu den Features des Modells von gorenje gehören unter anderem die Restzeitanzeige, die Startzeitvorwahl und die Mengenautomatik.“"
                            },
                            {
                                "example_id": "1057292e-a53d-40e4-bf9b-30e8217e060f",
                                "sense_id": "f39798ee-b5f9-34d1-b6fe-8c04b74786df",
                                "text": "„Unsere Download-Auswahl stellt Tools zur Termin- und Urlaubsplanung vor. Außerdem gibt es ein Gratis-Tool zur Restzeitanzeige und ein Synchronisiertool für die PC-Uhr.“"
                            }
                        ],
