                "senses": [
                    {
                        "sense_id": "c712a255-f9af-3577-ace3-0d84c6007359",
                        "entry_id": "cc9ec852-a218-32ea-b81f-df1593f12292",
                        "glosses": [
                            "Angehöriger des gleichnamigen, antiken samnitischen Stammes in Mittelitalien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fb10b78-bea3-45ad-a8a7-62763d18ebf4",
                                "sense_id": "c712a255-f9af-3577-ace3-0d84c6007359",
                                "text": "„Dieser Bund umfaßte mehrere Stämme, die Pentrer, Hirpiner und Kaudiner.“"
                            },
                            {
                                "example_id": "e32082ea-4b98-422b-8590-be1091c7a968",
                                "sense_id": "c712a255-f9af-3577-ace3-0d84c6007359",
                                "text": "„Laut dem einen vom römischen Geschichtsschreiber Titus Livius verwendeten Kriegsbericht hätten anschließend beide Konsuln die Hauptstadt der samnitischen Pentrer, Bovianum, erobert, […].“"
                            },
                            {
                                "example_id": "be26ca42-5743-486f-a360-cbb551c475bc",
                                "sense_id": "c712a255-f9af-3577-ace3-0d84c6007359",
                                "text": "„Samniten ist der Oberbegriff für vier altitalische Stämme, nämlich die Caracener, Kaudiner, Hirpiner und Pentrer.“"
                            },
                            {
                                "example_id": "0052dc67-dcbc-4b69-ba83-5a1a08807baf",
                                "sense_id": "c712a255-f9af-3577-ace3-0d84c6007359",
                                "text": "„297 ging Fabius ins Land der Pentrer und stieß am Tifernus auf die Samniter, die er nach hartnäckigem Kampfe durch Hülfe der Nachhut besiegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
