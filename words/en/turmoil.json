{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "170f7d54-2ef4-3c95-9f57-5c42a53ace25",
                    "sense_definition": "A state of great disturbance, confusion, or uncertainty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country was thrown into political <w>turmoil</w> after the unexpected resignation of the president. \t",
                            "target_lang_translations": {
                                "zh": "总统意外辞职后，该国陷入了政治<w>动荡</w>。"
                            }
                        },
                        {
                            "text": "Despite the economic <w>turmoil</w>, the small company managed to increase its profits.",
                            "target_lang_translations": {
                                "zh": "尽管经济<w>动荡</w>，这家小公司还是设法增加了利润。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chaos",
                        "disorder"
                    ],
                    "common_phrases": [
                        "political turmoil",
                        "economic turmoil",
                        "inner turmoil"
                    ],
                    "target_lang_definitions": {
                        "zh": "指极大的混乱、动荡或不安的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "动荡",
                                "target_lang_sense_clarification": "常用于政治或社会局势的剧烈变动。"
                            },
                            {
                                "target_lang_word": "混乱",
                                "target_lang_sense_clarification": "指秩序的缺失或状态的无序。"
                            },
                            {
                                "target_lang_word": "骚乱",
                                "target_lang_sense_clarification": "指社会性的动乱或骚动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a47f63b5-b11e-36f3-bf37-748b204d62ed",
                    "sense_definition": "Harassing work, trouble, or persistent disturbance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of relentless <w>turmoil</w> in the factories, he finally sought a quiet life in the countryside.",
                            "target_lang_translations": {
                                "zh": "在工厂经历了多年的持续<w>烦扰</w>后，他最终在乡间寻求平静的生活。"
                            }
                        },
                        {
                            "text": "She longed for rest after the daily <w>turmoil</w> of her exhausting job.",
                            "target_lang_translations": {
                                "zh": "在经历了一天精疲力竭的工作<w>困扰</w>后，她渴望休息。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指持续不断的烦扰、麻烦或困扰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "烦扰",
                                "target_lang_sense_clarification": "指持续的干扰或令人心烦的事。"
                            },
                            {
                                "target_lang_word": "困扰",
                                "target_lang_sense_clarification": "指长期存在的麻烦或心理负担。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20d5ddc4-8db9-3068-86e9-4d854ae67b7f",
                    "sense_definition": "To be in a state of agitation, confusion, or commotion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mind was <w>turmoiling</w> with conflicting emotions after hearing the news.",
                            "target_lang_translations": {
                                "zh": "听到这个消息后，他的内心因矛盾的情绪而<w>翻腾</w>不已。"
                            }
                        },
                        {
                            "text": "The crowds were <w>turmoiling</w> in the streets as the protest grew.",
                            "target_lang_translations": {
                                "zh": "随着抗议活动的升级，街上的人群开始<w>骚动</w>起来。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an intransitive verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "处于激动、混乱或骚动之中。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "翻腾",
                                "target_lang_sense_clarification": "形容内心思绪或情绪剧烈波动。"
                            },
                            {
                                "target_lang_word": "骚动",
                                "target_lang_sense_clarification": "指人群或局势处于不安的活动状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f121b92-eb45-3791-9793-97d1ac543c58",
                    "sense_definition": "To agitate, harass, or disturb greatly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Constant worries about the future continue to <w>turmoil</w> his thoughts.",
                            "target_lang_translations": {
                                "zh": "对未来的持续担忧不断<w>搅乱</w>着他的思绪。"
                            }
                        },
                        {
                            "text": "The unexpected crisis threatened to <w>turmoil</w> the peaceful town.",
                            "target_lang_translations": {
                                "zh": "突如其来的危机威胁着要<w>扰乱</w>这座宁静的小镇。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a transitive verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使……极度不安、烦扰或混乱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "搅乱",
                                "target_lang_sense_clarification": "指破坏原有的平静或秩序。"
                            },
                            {
                                "target_lang_word": "扰乱",
                                "target_lang_sense_clarification": "指使人或事物陷入混乱。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}