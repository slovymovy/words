                "senses": [
                    {
                        "sense_id": "28fa6a64-e0a0-3fcf-938b-b0ac931df5a7",
                        "entry_id": "c5e5937d-061f-3e25-abb3-52ea8fca9594",
                        "glosses": [
                            "Eigenschaft feudal zu sein: die Aristokratie oder Mitgliedschaft im Adel oder aber (positiv) Herrschaftlichkeit oder das (abwertende) Reaktionärsein"
                        ],
                        "tags": [
                            "in vielerlei Zusammenhang",
                            "also zum Beispiel"
                        ],
                        "examples": [
                            {
                                "example_id": "e558ea78-2da7-4593-b1c4-7ba4d5ed17af",
                                "sense_id": "28fa6a64-e0a0-3fcf-938b-b0ac931df5a7",
                                "text": "„In jenen Zeiten reiner Feudalität, wo der König dem schönen Ausspruche eines Polenkönigs gemäß ein primus inter pares war, führten die Grafen von Champagne, die Grafen von Blois, die von Anjou, die einfachen Barone von der Normandie und die Herzöge von der Bretagne das Leben von Souverainen.“"
                            },
                            {
                                "example_id": "45474045-196c-4b90-b07a-e7c1a3abffbf",
                                "sense_id": "28fa6a64-e0a0-3fcf-938b-b0ac931df5a7",
                                "text": "„Denn es gehört zu den Eigenthümlichkeiten der sarmatischen Nationalität, obwohl sie eine adlige Republik bildete, daß die Feudalität niemals zur vollen Geltung und Entwickelung gelangte.“ (1858)"
                            },
                            {
                                "example_id": "530f7a1f-e5bc-4562-bd2d-1b5f6ac8aaf0",
                                "sense_id": "28fa6a64-e0a0-3fcf-938b-b0ac931df5a7",
                                "text": "„Die Hierarchie und ihre Kämpfe mit der Feudalität (die Kämpfe der Ideologen einer Klasse gegen die Klasse selbst) sind nur der ideologische Ausdruck der Feudalität und der innerhalb der Feudalität selbst sich entwickelnden Kämpfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "afea4c0b-a598-3b03-809d-b4c33247ff96",
                        "entry_id": "c5e5937d-061f-3e25-abb3-52ea8fca9594",
                        "glosses": [
                            "Lehensverhältnis"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "358adbb9-9dbd-4106-835f-4489ca01e051",
                                "sense_id": "afea4c0b-a598-3b03-809d-b4c33247ff96",
                                "text": "„Lumperei oder aber Eigenthumslosigkeit ist der Sinn der Feudalität, des Lehnswesens, das seit dem vorigen Jahrhundert nur den Lehnsherrn vertauscht hat, indem es ‚den Menschen‘ an die Stelle Gottes setzte und vom Menschen zu Lehen annahm, was vorher ein Lehen von Gottes Gnaden gewesen war.“ (1845)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
