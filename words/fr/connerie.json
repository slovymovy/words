                {
                    "sense_id": "c2919191-c4cb-369f-880f-78eaae600378",
                    "sense_definition": "Propos absurde, mensonge grossier ou baliverne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne crois rien de ce qu'il te raconte, ce sont des <w>conneries</w> montées de toutes pièces.",
                            "target_lang_translations": {
                                "en": "Don't believe a word he tells you; it's all <w>nonsense</w>, made up from start to finish.",
                                "ru": "Не верь ни единому его слову: это сплошная <w>чушь</w>, выдуманная от начала до конца.",
                                "nl": "Geloof geen woord van wat hij je vertelt; het is allemaal <w>onzin</w>, van begin tot eind verzonnen.",
                                "de": "Glaub kein Wort von dem, was er dir erzählt; das ist alles <w>Quatsch</w>, von vorne bis hinten erfunden.",
                                "pl": "Nie wierz w nic z tego, co ci opowiada; to same <w>bzdury</w>, wymyślone od początku do końca.",
                                "it": "Non credere a niente di quello che ti racconta: sono tutte <w>panzane</w> inventate di sana pianta.",
                                "cs": "Nevěř ničemu z toho, co ti vypráví, jsou to samé <w>nesmysly</w> vymyšlené od začátku do konce.",
                                "tr": "Sana anlattığı hiçbir şeye inanma; hepsi baştan sona uydurulmuş <w>saçmalıklar</w>.",
                                "es": "No creas nada de lo que te cuenta: son puras <w>tonterías</w> inventadas de principio a fin.",
                                "zh": "他说的话一句都别信，全是凭空编造的<w>瞎话</w>。"
                            }
                        },
                        {
                            "text": "Arrête de raconter des <w>conneries</w> et concentre-toi sur tes véritables devoirs.",
                            "target_lang_translations": {
                                "en": "Stop <w>talking nonsense</w> and focus on your real homework.",
                                "ru": "Перестань <w>нести чушь</w> и сосредоточься на настоящих домашних заданиях.",
                                "nl": "Hou op met <w>onzin</w> vertellen en concentreer je op je echte huiswerk.",
                                "de": "Hör auf, <w>Unsinn</w> zu erzählen, und konzentrier dich auf deine richtigen Hausaufgaben.",
                                "pl": "Przestań <w>pleść bzdury</w> i skup się na prawdziwej pracy domowej.",
                                "it": "Smettila di raccontare <w>sciocchezze</w> e concentrati sui tuoi veri compiti.",
                                "cs": "Přestaň plácat <w>kecy</w> a soustřeď se na své skutečné domácí úkoly.",
                                "tr": "<w>Zırvalamayı</w> bırak ve gerçek ödevlerine odaklan.",
                                "es": "Deja de decir <w>tonterías</w> y concéntrate en tus verdaderos deberes.",
                                "zh": "别再说<w>胡话</w>了，好好专心写你真正的作业吧。"
                            }
                        }
