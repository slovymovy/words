                ],
                "senses": [
                    {
                        "sense_id": "fe75e9a6-1fb1-3b4b-9ce9-b01166ab926e",
                        "entry_id": "7ae2d7b2-d84c-3121-adc6-ec7e4344a0dc",
                        "glosses": [
                            "dreiundzwanzigster Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d18e1f9f-56a4-423b-83df-628bf181c0ce",
                                "sense_id": "fe75e9a6-1fb1-3b4b-9ce9-b01166ab926e",
                                "text": "Lange gehörten die einzelnen Dörfer, aus denen schlussendlich Liesing wurde, zu Niederösterreich."
                            },
                            {
                                "example_id": "0e76d303-55a9-4827-b10e-6a5f272a91a4",
                                "sense_id": "fe75e9a6-1fb1-3b4b-9ce9-b01166ab926e",
                                "text": "Liesing hat großes Wachstumspotenzial."
                            },
                            {
                                "example_id": "626aa6d3-b135-4954-a30c-90f54471582d",
                                "sense_id": "fe75e9a6-1fb1-3b4b-9ce9-b01166ab926e",
                                "text": "Die in Liesing gut aufgestellte Jazzszene hätte schon Neugier am Areal bekundet und erst vor Kurzem hätten sich die Wiener Festwochen das Gelände angesehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "06a89c6a-6e56-3ece-95d5-0d0cb4b2c72f",
                        "entry_id": "7ae2d7b2-d84c-3121-adc6-ec7e4344a0dc",
                        "glosses": [
                            "ehemaliges Dorf, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f260e36-9a35-431e-9fc5-ec53b2c29ac6",
                                "sense_id": "06a89c6a-6e56-3ece-95d5-0d0cb4b2c72f",
                                "text": "Liesing hatte bei Eingemeindung 1938 das Stadtrecht."
                            },
                            {
                                "example_id": "2ef72945-2fd4-4eb5-ba8d-d1bb201596b5",
                                "sense_id": "06a89c6a-6e56-3ece-95d5-0d0cb4b2c72f",
                                "text": "Mit der Industrialisierung kam für Liesing der große wirtschaftliche Aufschwung."
                            },
                            {
                                "example_id": "ea0cd06b-2abd-45ae-b7f1-824888221693",
                                "sense_id": "06a89c6a-6e56-3ece-95d5-0d0cb4b2c72f",
                                "text": "Nachdem Liesing - noch selbständige Gemeinde - 1905 zur Stadt erhoben wurde, erhielt die Stadt das Wappen, das der Bezirk heute führt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
