                "senses": [
                    {
                        "sense_id": "da5fd7a8-a4a6-38a0-aea8-a7f0d05de42e",
                        "entry_id": "4dc6191c-801a-3aea-bdce-c701f82d3cda",
                        "glosses": [
                            "umständliche Verneigung mit bestimmten Arm- und Beinbewegungen (mit kratzendem/scharrendem Geräusch eines Fußes)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef40970-a241-4615-90af-d2deb46a172c",
                                "sense_id": "da5fd7a8-a4a6-38a0-aea8-a7f0d05de42e",
                                "text": "„Er neigte den Kopf und begann, ungeschickt wie ein Kind, das tanzen lernen soll, abwechselnd bald mit dem einen und bald mit dem andern Bein Kratzfüsse zu machen.“"
                            },
                            {
                                "example_id": "e029f967-9354-4231-b6ab-807eb0355903",
                                "sense_id": "da5fd7a8-a4a6-38a0-aea8-a7f0d05de42e",
                                "text": "„Bei den ersten Zusammentreffen machte ich einen Kratzfuß und empfahl mich; später aber bat man mich dazubleiben, denn die Fürsten wissen meistens nicht, was sie allein mit ihren Mätressen anfangen sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c60d127-47bc-46f8-b535-22226661f90c",
                        "source_entry_id": "4dc6191c-801a-3aea-bdce-c701f82d3cda",
                        "source_sense_id": "da5fd7a8-a4a6-38a0-aea8-a7f0d05de42e",
                        "source_sense_description": "Verneigung mit Scharren eines Fußes",
                        "target_lang_word": "inclination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inclination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c00577b-303f-3f22-b150-b7490960e403",
                                        "entry_id": "0e517689-d03d-3c82-8e3d-c07ede28ec42",
                                        "glosses": [
                                            "Action d’incliner, de pencher, par exemple la tête ou le corps en signe d’acquiescement ou de respect."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c212345-74ee-43b3-9138-5410312873f7",
                                                "sense_id": "6c00577b-303f-3f22-b150-b7490960e403",
                                                "text": "Elle le salua sans lui parler, une simple inclination, un signe de sa main l'invitèrent à s'asseoir ; […]."
                                            },
                                            {
                                                "example_id": "11be9782-a2d3-4401-9270-46826b802d15",
                                                "sense_id": "6c00577b-303f-3f22-b150-b7490960e403",
                                                "text": "Tous les deux se saluèrent avec un égal empressement, et Sophie reçut du jeune colonel une inclination respectueuse."
                                            },
                                            {
                                                "example_id": "9ee1dc70-54a1-46d5-90e7-0100e762e1f7",
                                                "sense_id": "6c00577b-303f-3f22-b150-b7490960e403",
                                                "text": "Le Cardinal, toujours assis dans son grand fauteuil, restait immobile pour le commun des courtisans, faisait une inclination de tête aux plus distingués, et pour les princes seulement s’aidait de ses deux bras pour se soulever légèrement."
                                            },
                                            {
                                                "example_id": "d03544fa-68d4-44ea-a47d-db6efb04208e",
                                                "sense_id": "6c00577b-303f-3f22-b150-b7490960e403",
                                                "text": "Et maintenant une dernière question, fait-il, en accentuant davantage la dangereuse inclination de son galurin resté vissé sur son arrière-crâne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f20e79e-6ecb-303b-bf15-3bf010eb7d28",
                                        "entry_id": "0e517689-d03d-3c82-8e3d-c07ede28ec42",
                                        "glosses": [
                                            "Mouvement de l’âme qui vous porte vers quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c80bd4bb-620e-4d66-9b4c-b9e9e996f9f8",
                                                "sense_id": "6f20e79e-6ecb-303b-bf15-3bf010eb7d28",
                                                "text": "Inclination au bien, à la vertu, au jeu, à la débauche."
                                            },
                                            {
                                                "example_id": "8668d793-55cc-48c8-b926-084f93a741ba",
                                                "sense_id": "6f20e79e-6ecb-303b-bf15-3bf010eb7d28",
                                                "text": "Avoir de l’inclination à bien faire, à mal faire, à médire."
                                            },
                                            {
                                                "example_id": "b8134a09-bf8f-4fdf-95ae-7780f3e92679",
                                                "sense_id": "6f20e79e-6ecb-303b-bf15-3bf010eb7d28",
                                                "text": "Il faut quelquefois forcer son inclination."
                                            },
                                            {
                                                "example_id": "c6413961-3e39-4cee-980e-eb204ee5927d",
                                                "sense_id": "6f20e79e-6ecb-303b-bf15-3bf010eb7d28",
                                                "text": "Faire une chose contre son inclination, contre sa propre inclination."
                                            },
                                            {
                                                "example_id": "2119b57b-a5d0-4c2b-a441-bc6923589426",
                                                "sense_id": "6f20e79e-6ecb-303b-bf15-3bf010eb7d28",
                                                "text": "À vrai dire, le fils n’a point hérité des nobles inclinations du père."
                                            },
                                            {
                                                "example_id": "8c8e83d9-65af-4324-be56-18e474c5b555",
                                                "sense_id": "6f20e79e-6ecb-303b-bf15-3bf010eb7d28",
                                                "text": "Comme presque tous leurs collègues, Jérôme et Sylvie étaient devenus psychosociologues par nécessité, non par choix. Nul ne sait d’ailleurs où les aurait menés le libre développement d’inclinations tout à fait indolentes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "094d7313-71aa-3e09-85cc-b27668e7a760",
                                        "entry_id": "0e517689-d03d-3c82-8e3d-c07ede28ec42",
                                        "glosses": [
                                            "Mouvement du cœur qui porte à aimer quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5150728b-a688-473d-b528-7cb261732ad2",
                                                "sense_id": "094d7313-71aa-3e09-85cc-b27668e7a760",
                                                "text": "Dans mon entourage, il arrivait — rarement — qu’on se mariât par inclination : ç’avait été le cas de ma cousine Titite."
                                            },
                                            {
                                                "example_id": "b5420f69-89b7-4d09-ae1c-331181d75575",
                                                "sense_id": "094d7313-71aa-3e09-85cc-b27668e7a760",
                                                "text": "Elle pouvait parfaitement éprouver une inclination pour Brunof sans que ce sentiment ne l’entraînât trop loin."
                                            },
                                            {
                                                "example_id": "c961b483-7265-4120-9115-5e05b3e17cd7",
                                                "sense_id": "094d7313-71aa-3e09-85cc-b27668e7a760",
                                                "text": "Les inclinations naissantes, après tout, ont des charmes inexplicables, et tout le plaisir de l'amour est dans le changement."
                                            },
                                            {
                                                "example_id": "cc1b1ac6-f8d5-4dd8-9e8f-820a1608106e",
                                                "sense_id": "094d7313-71aa-3e09-85cc-b27668e7a760",
                                                "text": "Je suis si flatté qu’elle ait de l’inclination pour moi… Elle est si bien élevée…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "754a2271-8214-38b2-a903-21cf297fd83c",
                                        "entry_id": "0e517689-d03d-3c82-8e3d-c07ede28ec42",
                                        "glosses": [
                                            "Personne qu’on aime."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3388ac8c-9fff-4c24-8f4f-201348277869",
                                                "sense_id": "754a2271-8214-38b2-a903-21cf297fd83c",
                                                "text": "N’aurait-il pas quelque secrète inclination ?"
                                            },
                                            {
                                                "example_id": "b3ec047a-7f51-45a2-8bbb-25ec7b5ae7cd",
                                                "sense_id": "754a2271-8214-38b2-a903-21cf297fd83c",
                                                "text": "Cette jeune fille est l’inclination d’un tel, est son inclination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
