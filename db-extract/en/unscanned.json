                "senses": [
                    {
                        "sense_id": "eee98082-6f75-3f99-ae44-73a9110e5eaf",
                        "entry_id": "a7f71ffe-5ea9-38e3-b552-f7cb40ef2d76",
                        "glosses": [
                            "Not having been scanned."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e0997675-6bf5-4277-9846-ed42d0bd9e12",
                                "sense_id": "eee98082-6f75-3f99-ae44-73a9110e5eaf",
                                "text": "The scanned 1978 patient did better than the unscanned 1974 patient in 31% of pairs, whereas the unscanned 1974 patient did better than the scanned 1978 patient in only 7% of pairs."
                            },
                            {
                                "example_id": "24c16b70-723c-4943-b1a7-a2900ea6dfc7",
                                "sense_id": "eee98082-6f75-3f99-ae44-73a9110e5eaf",
                                "text": "Rescanning and replacement scanning of previously unscanned images, including those missed by the high-speed scanner operator or those considered inappropriate for processing by high-speed scanner[.]"
                            },
                            {
                                "example_id": "e8e6992c-9aea-46e3-9c83-c0f0bd2a91b1",
                                "sense_id": "eee98082-6f75-3f99-ae44-73a9110e5eaf",
                                "text": "We recommend never taking unscanned work because it frequently results in problems for the transcriptionist."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d190ccf-d2f4-3319-bb7b-36627b62bb77",
                        "entry_id": "a7f71ffe-5ea9-38e3-b552-f7cb40ef2d76",
                        "glosses": [
                            "Involving a technique that does not involve scanning, where an alternative technique that does involve scanning exists."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9a5384c9-8f8b-4abb-aa56-175cdb6e476a",
                                "sense_id": "1d190ccf-d2f4-3319-bb7b-36627b62bb77",
                                "text": "This provided an input speed that exceeded the capability of unscanned image filmsetters. Unscanned filmsetter devices use a moving matrix grid or a stationary character grid with electromechanical control of character selection for photographic recording."
                            },
                            {
                                "example_id": "0314cfeb-d88c-4ccb-a7c4-6b72bf19549b",
                                "sense_id": "1d190ccf-d2f4-3319-bb7b-36627b62bb77",
                                "text": "For unscanned modes which do not involve electronic or mechanical steering of the acoustic beam, the potential for significant temperature increase is the greatest"
                            }
                        ]
                    },
                    {
                        "sense_id": "e53e2ed7-d273-3c9b-bd67-e13719621716",
                        "entry_id": "a7f71ffe-5ea9-38e3-b552-f7cb40ef2d76",
                        "glosses": [
                            "Unobserved, unexamined, or unconsidered."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3c6d6f75-4d69-4b5e-910c-b99e6be0b449",
                                "sense_id": "e53e2ed7-d273-3c9b-bd67-e13719621716",
                                "text": "This tiger-footed rage, when it shall find The harm of unscanned swiftness, will too late Tie leaden pounds to 's heels."
                            },
                            {
                                "example_id": "75cbaab4-3aec-456d-9b97-3c7cc4d74131",
                                "sense_id": "e53e2ed7-d273-3c9b-bd67-e13719621716",
                                "text": "The birth of a legend or tradition occurs, how we know not, in fancy's dim and unscanned regions"
                            },
                            {
                                "example_id": "0f2b6569-aa4e-4c4c-85cf-936ccedd9103",
                                "sense_id": "e53e2ed7-d273-3c9b-bd67-e13719621716",
                                "text": "Such sentiments are not those of a contemner of divine power, but of one who believed in the ever-present miracle, unscanned by human reason,—the government of the invisible God."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebee83ec-a21b-3e57-9e06-476b5eeb4880",
                        "entry_id": "a7f71ffe-5ea9-38e3-b552-f7cb40ef2d76",
                        "glosses": [
                            "Having no consistent meter."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4c6c6ef8-b0cb-47e9-a206-9e6721df0a72",
                                "sense_id": "ebee83ec-a21b-3e57-9e06-476b5eeb4880",
                                "text": "The music of the measured, scanned verse of Latin and Greek poetry is one thing ; the music of the rhymed, unscanned verse of Villon and the old French poets, la poe'sie chante'e, is another."
                            }
                        ]
                    }
