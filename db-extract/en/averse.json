        "zh-extract.jsonl": [
            {
                "entry_id": "33792dd3-f894-3a07-bca1-cd110834e214",
                "word": "averse",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e887ffcf-fabf-4a17-8c7c-c07390c4f361",
                        "entry_id": "33792dd3-f894-3a07-bca1-cd110834e214",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more averse"
                    },
                    {
                        "form_id": "12d0dafc-6318-4148-a8e2-6bbe648fdd3e",
                        "entry_id": "33792dd3-f894-3a07-bca1-cd110834e214",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most averse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "121a41a7-eb97-309e-a1df-48dde550d011",
                        "entry_id": "33792dd3-f894-3a07-bca1-cd110834e214",
                        "glosses": [
                            "厌恶的，抵触的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "618c7341-8728-417f-b318-512a3949accc",
                                "sense_id": "121a41a7-eb97-309e-a1df-48dde550d011",
                                "text": "be averse to something / to do something",
                                "translation": "反对某事，反对做某事"
                            },
                            {
                                "example_id": "9d9115cc-7697-41d4-8f75-e2988e0435ff",
                                "sense_id": "121a41a7-eb97-309e-a1df-48dde550d011",
                                "text": "This is why the most eminent intellects have always been strongly averse to any kind of disturbance, interruption and distraction, and above everything to that violent interruption which is caused by noise; other people do not take any particular notice of this sort of thing."
                            },
                            {
                                "example_id": "f9c472be-2af2-46eb-89f9-318a1d983bc2",
                                "sense_id": "121a41a7-eb97-309e-a1df-48dde550d011",
                                "text": "“I assure you, cousin,” replied the old gentleman, “that the Baron, notwithstanding his unpleasant manner, is really one of the most excellent and kind-hearted men in the world. As I have already told you, he did not assume these manners until the time he became lord of the entail; previous to then he was a modest, gentle youth. Besides, he is not, after all, so bad as you make him out to be; and further, I should like to know why you are so averse to him.” As my uncle said these words he smiled mockingly, and the blood rushed hotly and furiously into my face."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4f3e8d6-55cd-3389-9e19-70c94c21c29c",
                        "entry_id": "33792dd3-f894-3a07-bca1-cd110834e214",
                        "glosses": [
                            "背过身的，向后的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf55af2-468f-4dc3-9fbf-1c2f38dd7e44",
                                "sense_id": "f4f3e8d6-55cd-3389-9e19-70c94c21c29c",
                                "text": "The tracks averse a lying notice gave, / And led the searcher backward from the cave."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f3fb46d-e1d0-3f74-a28d-9622851da619",
                        "entry_id": "33792dd3-f894-3a07-bca1-cd110834e214",
                        "glosses": [
                            "展示背面的"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
