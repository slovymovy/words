                ],
                "senses": [
                    {
                        "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                        "entry_id": "5d96c414-897f-3415-95d1-1ca90ca81e7b",
                        "glosses": [
                            "Wärmeenergie, die im Abwasser (beispielsweise von Gebäuden, der Industrie) enthalten ist"
                        ],
                        "tags": [
                            "Energiewirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "159b8c14-28c3-4534-a9ff-6f66ea96a9bc",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Abwasserwärme kann entweder aus der Kanalisation, einem Gebäude oder auf einer Kläranlage gewonnen werden.“"
                            },
                            {
                                "example_id": "7509bfb3-bcae-4ffc-8ed6-90a4a7f131a6",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Die Nutzung von Abwasserwärme kann zukünftig zur Dekarbonisierung und Energiewende im Wärmemarkt beitragen.“"
                            },
                            {
                                "example_id": "b3fb8af0-5414-4539-aba8-03a81faf2f00",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Die Abwasserwärme der Kraftwerksblöcke begünstigte nach Ansicht des Biologen Fabio Rochol die Ausbreitung des Welses im Rhein, so dass besonders große Exemplare dieses Raubfisches in Höhe des Kraftwerks Lausward gehäuft vorkommen.“"
                            },
                            {
                                "example_id": "0e8b7cbc-0ec6-4bc2-86b6-371a2ba7067a",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Künftig soll Abwasserwärme über ein energieeffizientes Wärmeverteilnetz den Bedarf von rund 850 Wohneinheiten und Gewerbeflächen decken.“"
                            },
                            {
                                "example_id": "48e1d6e0-60d6-4f0a-b2d6-569e3c57efc9",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "[…] „die Stadt Oldenburg ist schon aktiv: Sie prüft unter anderem, ob sie Geothermie oder Abwasserwärme nutzen kann.“"
                            },
                            {
                                "example_id": "a21e1c41-f3d9-4881-9196-9567afaf88da",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Für Umweltsenator Jens Kerstan (Grüne) ist die Nutzung der Abwasserwärme ein entscheidender Punkt, um auf das Kohlekraftwerk Wedel zu verzichten.“"
                            },
                            {
                                "example_id": "f79f9575-25e8-453a-8025-bdfde7df03ed",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Unter anderem sollen die Abwärme der Müllverwertungsanlage und anderer Industriebetriebe im Hafen sowie die Abwasserwärme des Klärwerks genutzt werden.“"
                            },
                            {
                                "example_id": "a63e6e5e-0a66-497b-b843-fce6c7c9bf27",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Unter der Straße sind bereits sogenannte Wärmetauschmatten im unterirdischen Abwasserkanal verlegt worden. Über eine Strecke von 250 Metern nehmen sie dort die Abwasserwärme auf und leiten sie ins Nahwärmenetz.“"
                            },
                            {
                                "example_id": "ff63f427-6ad7-4c69-b30b-5ce760b859f0",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Die dafür benötigte Energie soll“ […] „mit Hilfe von Wärmetauschern und Wärmepumpen aus Abwasserwärme gewonnen werden.“"
                            },
                            {
                                "example_id": "2ac951cd-16e7-45d5-828a-032daca98380",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Außerdem sollen die Betreiber der Kanalnetze verpflichtet werden, Karten zu erstellen, wo die Abwasserwärme besonders gut genutzt werden kann.“"
                            },
                            {
                                "example_id": "19538c7e-c502-43fe-bb15-7c674ef51fae",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„In Wiesbaden-Biebrich wird“ […] „ein Neubaugebiet mit rund 100 neuen Wohneinheiten mit Abwasserwärme versorgt.“"
                            },
                            {
                                "example_id": "037a0fd5-f614-4e56-bcd6-0389f7c6fe84",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Konsequent genutzt, könnte die Abwasserwärme drei Prozent der Energie aus fossilen Brennstoffen ersetzen, schätzen Schweizer Experten.“"
                            },
                            {
                                "example_id": "4e3611bf-5728-409a-9d13-f34a55361c65",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Die Anlage ist also nur ein kleiner Beitrag zur Energiewende. Kommt hinzu, dass das Potenzial der Abwasserwärme beschränkt ist: Höchstens fünf weitere Anlagen könnten in der Stadt Luzern gebaut werden.“"
                            },
                            {
                                "example_id": "6eb92a7c-4643-4cdb-a041-c148a14238e1",
                                "sense_id": "81efbee9-47d9-3746-a426-befbf083448d",
                                "text": "„Anders als ursprünglich geplant werde es aber keine Anlage zur Rückgewinnung der Abwasserwärme geben, sagt Nitzsche. Sie rechne sich nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
