        "fr-extract.jsonl": [
            {
                "entry_id": "8046d6f6-7605-3a30-a182-8da4dd80b4e6",
                "word": "gazouillis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                        "entry_id": "8046d6f6-7605-3a30-a182-8da4dd80b4e6",
                        "glosses": [
                            "Petit message de 140 puis 280 caractères maximum diffusé publiquement sur Twitter ou sur un réseau similaire tel que Bluesky ou Truth Social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15844bd7-db2e-4bae-9c34-2ae57b94f27f",
                                "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                "text": "Huitième Journée du livre politique — Lise Bissonnette pourfend gazouillis et placotages."
                            },
                            {
                                "example_id": "aa7ea637-c1d8-4fa9-8f9e-e646467c2ac8",
                                "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                "text": "Les gazouillis de Twitter sont-ils dignes des écrivains ?"
                            },
                            {
                                "example_id": "f46f2c7a-40cc-4774-9531-710ab81a9b26",
                                "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                "text": "Le président du Conseil européen, Charles Michel, a « fermement » condamné dans un gazouillis le coup d'État perpétré."
                            },
                            {
                                "example_id": "e988b190-bb01-4ac6-a4ae-2e69e51049f4",
                                "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                "text": "Non seulement le profil du 45ᵉ président est unique dans l’histoire, mais il ne s’est jamais soucié de parler au nom de tous. Au contraire, ses 26 000 gazouillis ont exploité ou révélé toutes les fissures de la société américaine."
                            },
                            {
                                "example_id": "f9173f4e-e77f-4002-b8f7-1a9ee2b1494e",
                                "sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                                "text": "De simples gazouillis présidentiels ont suffi pour ébranler le vaste Canada, cet « Empire des Bois et des Blés », disait-on jadis, ravalé en simple possession à confisquer, voué à devenir un state, le cinquante et unième de l'Union américaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce11d3f7-91e0-4014-8dd0-c1b024edfb0f",
                        "source_entry_id": "8046d6f6-7605-3a30-a182-8da4dd80b4e6",
                        "source_sense_id": "1057ea9c-fffa-3889-9ec5-fc15e45dab11",
                        "target_lang_word": "tweet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tweet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0dea81b-2097-3ec7-bab4-4cc06c248f82",
                                        "entry_id": "a472fdde-b97b-334f-b262-af1922b9a902",
                                        "glosses": [
                                            "The sound of a bird; any short high-pitched sound or whistle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "955f6412-ed7f-4acc-b195-9034c0d6ad4b",
                                                "sense_id": "e0dea81b-2097-3ec7-bab4-4cc06c248f82",
                                                "text": "[Ignatz, dropping Officer Pupp's police whistle into the lake:] The fishes will have lots of fun tweeting tweets on it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "639024c1-b153-3f0d-bee9-88d6cae3d4f5",
                                        "entry_id": "a472fdde-b97b-334f-b262-af1922b9a902",
                                        "glosses": [
                                            "An entry posted on the microblogging service Twitter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2242e856-0018-47b4-ac61-50ffc8201e14",
                                                "sense_id": "639024c1-b153-3f0d-bee9-88d6cae3d4f5",
                                                "text": "Every few seconds, a tweet appears and vanishes somewhere on the globe."
                                            },
                                            {
                                                "example_id": "3a90373e-2d0e-403e-a242-746c7228be0c",
                                                "sense_id": "639024c1-b153-3f0d-bee9-88d6cae3d4f5",
                                                "text": "For example, as you edit a tweet in Twitter, the number of characters left is updated as you type."
                                            },
                                            {
                                                "example_id": "36d75eaf-8825-40ed-9b4b-e1a0eda362d0",
                                                "sense_id": "639024c1-b153-3f0d-bee9-88d6cae3d4f5",
                                                "text": "A tweet can be received via SMS to your cell phone […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "431f5747-3779-3659-aa39-fe41ff6828cf",
                                        "entry_id": "a472fdde-b97b-334f-b262-af1922b9a902",
                                        "glosses": [
                                            "An entry on any microblogging service."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3357731-89ab-46c8-8510-ca638860f485",
                                                "sense_id": "431f5747-3779-3659-aa39-fe41ff6828cf",
                                                "text": "He was watching the media coverage, talking to his lawyers. And we saw that because of his tweets on Truth Social, or his posts on Truth Social."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tweet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "767e08f8-ed1a-39d3-a873-47ad939d817e",
                                        "entry_id": "e53e4b00-f6f7-3ecd-9c4c-8823a28166ca",
                                        "glosses": [
                                            "To produce a short high-pitched sound, similar to that of certain birds."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "894c0d9a-a6e5-4030-9a15-0380978217d2",
                                                "sense_id": "767e08f8-ed1a-39d3-a873-47ad939d817e",
                                                "text": "[Ignatz, dropping Officer Pupp's police whistle into the lake:] The fishes will have lots of fun tweeting tweets on it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f8f5a21-d11a-3538-ae93-041009ddf397",
                                        "entry_id": "e53e4b00-f6f7-3ecd-9c4c-8823a28166ca",
                                        "glosses": [
                                            "To post an entry to Twitter."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14670a71-ed59-412b-a068-1a2418bfef42",
                                                "sense_id": "6f8f5a21-d11a-3538-ae93-041009ddf397",
                                                "text": "In Saudi Arabia, one of the most conservative societies, one online rebel has rocked the Islamic establishment with tweeted allegations of corruption within the ruling royal family."
                                            },
                                            {
                                                "example_id": "bd3cb0c9-1ec9-42df-b788-7836f2e801ea",
                                                "sense_id": "6f8f5a21-d11a-3538-ae93-041009ddf397",
                                                "text": "=Mr Trump tweeted: \"Big day planned on national security tomorrow. Among many other things, we will build the wall!\""
                                            },
                                            {
                                                "example_id": "d4dd3a23-1e6f-49e6-87a9-c4ef03df3cdc",
                                                "sense_id": "6f8f5a21-d11a-3538-ae93-041009ddf397",
                                                "text": "First, an apology. Tweet in haste and repent at leisure. When I first heard about the idea, before I had properly examined it, I actually tweeted that this was [a] welcome 'innovation' from a state-controlled train operator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b79c602-7c36-3d18-8e67-fb85fb9bef54",
                                        "entry_id": "e53e4b00-f6f7-3ecd-9c4c-8823a28166ca",
                                        "glosses": [
                                            "To post an entry to any microblogging site."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9503bf3e-6a05-443c-9960-1c6384bb748a",
                                                "sense_id": "4b79c602-7c36-3d18-8e67-fb85fb9bef54",
                                                "text": "In response to the motion, Trump tweeted on Truth Social"
                                            },
                                            {
                                                "example_id": "3e45bdb4-a13c-4c77-a01b-e8a4fc499c16",
                                                "sense_id": "4b79c602-7c36-3d18-8e67-fb85fb9bef54",
                                                "text": "As Georgetown public policy prof Dan Moynihan tweeted on Bluesky yesterday, the editors of the Times “are not falling for [Rufo’s] game, they are co-producing it.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tweet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fefcc259-d2f5-34ec-b5b4-15501a01f754",
                                        "entry_id": "7e451506-fda9-30b9-be91-24302dd1513c",
                                        "glosses": [
                                            "used to represent the sound of a bird twittering: twit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53bb7598-6559-4b55-bf22-0fac85e08ff5",
                                                "sense_id": "fefcc259-d2f5-34ec-b5b4-15501a01f754",
                                                "text": "I've got two loves / And they go tweet (×9) like little birds"
                                            }
                                        ]
