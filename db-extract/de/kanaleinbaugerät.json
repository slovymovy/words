                "senses": [
                    {
                        "sense_id": "3171d8b8-7b76-3cad-9325-76bcd8e21c78",
                        "entry_id": "911025c4-9b41-3bd6-b099-9d0cff260683",
                        "glosses": [
                            "kompakte Einbaukomponente zur Behandlung von Luft, die in einen Lüftungskanal eingebaut wird"
                        ],
                        "tags": [
                            "Klimatechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "e8399ca6-11b9-4e58-8f20-be746eb8383f",
                                "sense_id": "3171d8b8-7b76-3cad-9325-76bcd8e21c78",
                                "text": "„Parallel tragen Kanaleinbaugeräte mit horizontaler Luftstromführung dazu bei, die frische Außenluft bedarfsgerecht vorzukonditionieren.“"
                            },
                            {
                                "example_id": "001058ef-af43-4dfd-bff1-c445c54ffbde",
                                "sense_id": "3171d8b8-7b76-3cad-9325-76bcd8e21c78",
                                "text": "„Die Wandgeräte, Truhengeräte, Unterdeckengeräte, Kanaleinbaugeräte und Deckenkassetten sind einfach zu installieren und dank der zugehörigen Infrarot-Fernbedienung mit Fuzzy-Logik-Steuerung einfach zu bedienen.“"
                            },
                            {
                                "example_id": "6d8986c8-9434-4ef6-99f1-244c8d5fe768",
                                "sense_id": "3171d8b8-7b76-3cad-9325-76bcd8e21c78",
                                "text": "„Das Kanaleinbaugerät Typ PEFY-P15VMS1-E sorgt dank des niedrigen Schalldruckpegels von 22 dB (A) für eine leise und komfortable Raumklimatisierung.“"
                            },
                            {
                                "example_id": "fe42551a-4b26-4c86-9347-4b204585c0ee",
                                "sense_id": "3171d8b8-7b76-3cad-9325-76bcd8e21c78",
                                "text": "„Das Kanaleinbaugerät ist für den Einbau in eine Zwischendecke und die Anbindung an ein Luftkanalnetz vorgesehen.“"
                            },
                            {
                                "example_id": "41975dee-d7ee-4580-8a17-25ec0f019e8d",
                                "sense_id": "3171d8b8-7b76-3cad-9325-76bcd8e21c78",
                                "text": "„Das Kanaleinbaugerät gehört zu dem zentralen System, mit einer Inneneinheit, von wo aus die Luft durch mehrere Kanäle zu den Räumen gelangt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
