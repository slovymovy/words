            {
                "entry_id": "2fadf75a-32c9-3969-8024-1c806f2a2f32",
                "word": "rooftop",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "01a54f48-fa83-49f8-8f42-09f12f10ce59",
                        "entry_id": "2fadf75a-32c9-3969-8024-1c806f2a2f32",
                        "tags": [
                            "plural"
                        ],
                        "form": "rooftops"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "acf2dabd-3d2d-38b6-9286-b5a148ded82b",
                        "entry_id": "2fadf75a-32c9-3969-8024-1c806f2a2f32",
                        "glosses": [
                            "The area atop a roof."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "589b566d-bdb7-4c99-9263-6540a8ab7c02",
                                "sense_id": "acf2dabd-3d2d-38b6-9286-b5a148ded82b",
                                "text": "In love, however, women are brave. How many clamber over rooftops of houses and palaces, and are still doing it, when their lovers await them!"
                            },
                            {
                                "example_id": "2c4fef8b-71c2-4321-9022-59e54825ece5",
                                "sense_id": "acf2dabd-3d2d-38b6-9286-b5a148ded82b",
                                "text": "Why do you think the rooftop of their apartment building is called \"tar beach\"? (Answers may vary.)"
                            },
                            {
                                "example_id": "17a083c2-7ed8-4dc8-a737-2c127b444269",
                                "sense_id": "acf2dabd-3d2d-38b6-9286-b5a148ded82b",
                                "text": "Riding the District west of Hammersmith, you immediately know something exciting is coming up, because at Ravenscourt Park you are level with the rooftops."
                            }
                        ]
                    },
                    {
                        "sense_id": "c820d30c-bfe5-3a7e-9b90-caa49d3fc9c8",
                        "entry_id": "2fadf75a-32c9-3969-8024-1c806f2a2f32",
                        "glosses": [
                            "The top layer of a roof; the material covering or composing a roof."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4eb05a4-da6c-4402-b9c8-f69290de358c",
                                "sense_id": "c820d30c-bfe5-3a7e-9b90-caa49d3fc9c8",
                                "text": "The house itself was a mound of red baked bricks and a tin rooftop."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cd86bb2-de7e-4239-942e-d1adaa648f0f",
                        "source_entry_id": "2fadf75a-32c9-3969-8024-1c806f2a2f32",
                        "source_sense_description": "top surface of a roof",
                        "target_lang_word": "Hausdach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausdach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "453d9a26-b3e6-30e4-a108-836f9db30b7f",
                                        "entry_id": "2d1a5c0a-4e80-3739-bc9f-75aa83bc6049",
                                        "glosses": [
                                            "Abdeckung eines Hauses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd4a7441-978e-49ca-b97a-f91af5890304",
                                                "sense_id": "453d9a26-b3e6-30e4-a108-836f9db30b7f",
                                                "text": "Das Hausdach hat bei dem nächtlichen Sturm Schaden genommen."
                                            },
                                            {
                                                "example_id": "9ddfa340-fdbe-47c8-9107-8cbfc18e1fe3",
                                                "sense_id": "453d9a26-b3e6-30e4-a108-836f9db30b7f",
                                                "text": "„Ein blasses Rosa hing über den Hausdächern.“"
                                            },
                                            {
                                                "example_id": "dafd717b-50c9-49e2-b53e-203dad41d8d9",
                                                "sense_id": "453d9a26-b3e6-30e4-a108-836f9db30b7f",
                                                "text": "„Die Decke lief spitz zu und war offenbar die Innenseite des richtigen Hausdaches.“"
                                            },
                                            {
                                                "example_id": "a47555ee-f808-4413-9ce4-3e33d03e010b",
                                                "sense_id": "453d9a26-b3e6-30e4-a108-836f9db30b7f",
                                                "text": "„Vor dem Fenster rauschte der englische Regen aus dem grauen Himmel, trommelte auf die Hausdächer, die Kirche gegenüber, ein Schleier über der Stadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de7f3c47-4535-46c4-aad4-e0c22b350cd5",
