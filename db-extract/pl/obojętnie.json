                                        "sense_id": "27c5c3f9-25d2-3a5a-8cd0-75dbe4086fe7",
                                        "entry_id": "4d01279c-3e35-3c98-a353-979d3873fcc5",
                                        "glosses": [
                                            "наречие к безразличный с безразличием, без интереса"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f22035db-029f-4871-abe4-4a5c97b468cf",
                                                "sense_id": "27c5c3f9-25d2-3a5a-8cd0-75dbe4086fe7",
                                                "text": "Той яблоне, что вырастил ты сам, // Твое существованье безразлично."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d27945e-b2e3-34ac-8eed-11366b1df95c",
                                        "entry_id": "4d01279c-3e35-3c98-a353-979d3873fcc5",
                                        "glosses": [
                                            "не важно, всё равно, не имеет значения"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c2af1e8-736c-4b47-be12-f56f6478fec9",
                        "source_entry_id": "3df9420d-eaaf-329a-b5bd-497d3a115b5a",
                        "source_sense_id": "e6236196-dd95-3596-950a-2cc8a2b2de72",
                        "target_lang_word": "egal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "egal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "830d98e5-c81c-33e0-ada7-b1abf6e3368d",
                                        "entry_id": "e98f75a7-a753-3290-9de3-fe8eea7d2862",
                                        "glosses": [
                                            "gleichgültig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91488e0d-c609-4eed-832b-b1612fad67ad",
                                                "sense_id": "830d98e5-c81c-33e0-ada7-b1abf6e3368d",
                                                "text": "Das ist mir so was von egal!"
                                            },
                                            {
                                                "example_id": "933c3187-b560-4303-a56a-3df81ffc5742",
                                                "sense_id": "830d98e5-c81c-33e0-ada7-b1abf6e3368d",
                                                "text": "„»Ist mir egal« klingt für viele nach Wurschtigkeit und irgendwie beleidigend.“"
                                            },
                                            {
                                                "example_id": "18a37343-4627-4884-a6b5-84c3219b9389",
                                                "sense_id": "830d98e5-c81c-33e0-ada7-b1abf6e3368d",
                                                "text": "„Es ist ja dann irgendwie egal, und wird heute zunehmend egaler, wo du sitzt, wenn der Laden läuft.“"
                                            },
                                            {
                                                "example_id": "5a97a0ce-358f-4a14-867d-fd9bf063e6ed",
                                                "sense_id": "830d98e5-c81c-33e0-ada7-b1abf6e3368d",
                                                "text": "„Am egalsten war mir der abfällige Blick von Frau Nöthisgut, als sie mein Arbeitsblatt sah.“"
                                            },
                                            {
                                                "example_id": "3abf7714-29b9-4c16-8dfa-fbe452930909",
                                                "sense_id": "830d98e5-c81c-33e0-ada7-b1abf6e3368d",
                                                "text": "„Alles scheint egal, immer egaler, je mehr Mahnungen und Vollstreckungsbescheide eintrudeln, je enger sich die stoischen Hände der Gerichte und die prolligen Krallen der Inkassounternehmen um seinen Hals legen.“"
                                            },
                                            {
                                                "example_id": "779b9eaa-789b-4c9f-a673-a2321b54fe6a",
                                                "sense_id": "830d98e5-c81c-33e0-ada7-b1abf6e3368d",
                                                "text": "„Aber ich merke, wie mir das immer egaler wird.“"
                                            },
                                            {
                                                "example_id": "bb1c7d1d-baa0-4d4b-96cd-850677eff1e8",
                                                "sense_id": "830d98e5-c81c-33e0-ada7-b1abf6e3368d",
                                                "text": "„Allerdings vermute sie, dass diese mehrere Verhältnisse gehabt habe und ihr Herr Huber immer egaler geworden sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c24fee13-f1d9-3da3-8344-355295c5daec",
                                        "entry_id": "e98f75a7-a753-3290-9de3-fe8eea7d2862",
                                        "glosses": [
                                            "bündig, eben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b079ea8-374f-490f-a955-a3ac292c96b3",
                                                "sense_id": "c24fee13-f1d9-3da3-8344-355295c5daec",
                                                "text": "Ein Schlag mit dem Hammer, und es ist egal!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bb41a5bf-2ab7-3293-9b4e-5f99ba587750",
                                        "entry_id": "e98f75a7-a753-3290-9de3-fe8eea7d2862",
                                        "glosses": [
                                            "zu dem anderen passend"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3791aa4d-aee7-43ec-8ec8-875ca50618fa",
                                                "sense_id": "bb41a5bf-2ab7-3293-9b4e-5f99ba587750",
                                                "text": "„Farbstoffe, die am wenigsten ausgezogen werden, färben auch am egalsten.“"
                                            },
                                            {
                                                "example_id": "043b4670-4914-4b76-b890-10d4e1afd9a4",
                                                "sense_id": "bb41a5bf-2ab7-3293-9b4e-5f99ba587750",
                                                "text": "„Relativ am egalsten ist die Granulierung der Kopffläche.“"
                                            },
                                            {
                                                "example_id": "8ea53082-eac3-4207-8984-4487b5a71f33",
                                                "sense_id": "bb41a5bf-2ab7-3293-9b4e-5f99ba587750",
                                                "text": "„Den fertigen Guß überstreut man vor der Erstarrung zuletzt mit Sand, was am egalsten durch ein Sieb geschieht.“"
                                            },
                                            {
                                                "example_id": "fd26ce5a-f31c-4ee0-82d4-5b4b27b444e9",
                                                "sense_id": "bb41a5bf-2ab7-3293-9b4e-5f99ba587750",
                                                "text": "„Das Weibchen sieht noch mehr einer Feldlerche ähnlich, als das Männchen; denn es ist am ganzen Oberleibe rostgrau mit dunkelbraunen länglichen Flecken; an den Backen braun; am Unterleib schmutzig weiß mit einzeln länglich eyrunden Längsflecken, die an der Kehle am egalsten stehen und am kleinsten sind, an den Seiten auch sehr einzeln stehen und am größten sind.“"
                                            },
                                            {
                                                "example_id": "b3bc556f-38a8-4e87-b024-5ca46191696b",
                                                "sense_id": "bb41a5bf-2ab7-3293-9b4e-5f99ba587750",
                                                "text": "„Sie haben alle egale Kleider, Gesichter und Redensarten.“"
                                            },
                                            {
                                                "example_id": "9422965a-3f30-4e39-8816-6cafb308c3b8",
                                                "sense_id": "bb41a5bf-2ab7-3293-9b4e-5f99ba587750",
                                                "text": "„Bei diesen Waren stehen dann meist der egale Warenausfall, die Fehlerlosigkeit der Ware und die Reinheit des Warenbildes im Vordergrund, und diese Eigenschaften stellen die qualitätsentscheidenden Merkmale des Artikels dar.“"
                                            },
                                            {
                                                "example_id": "fd25c8a2-4ec1-48b5-be0c-e41b427c02ee",
                                                "sense_id": "bb41a5bf-2ab7-3293-9b4e-5f99ba587750",
                                                "text": "„[…], wenn sonst richtig gearbeitet wurde, kann es sich dabei nur um kleine Fehler handeln, die noch keinen merklich schädlichen Einfluß auf das Resultat haben: in letzter Linie aber bietet dann der egale, gleichmäßig gute Ausfall der Partien im großen den besten Beweis für die Richtigkeit der Theorie und deren Anwendung.“"
                                            },
                                            {
                                                "example_id": "3d1cb555-aef3-46c3-aa50-b81f45ef733b",
                                                "sense_id": "bb41a5bf-2ab7-3293-9b4e-5f99ba587750",
                                                "text": "„Es ist ein Ding, das gar nicht interessiert, ein Gewäsche, das nichts taugt, als die Zeit zu verderben; forcirte Gedanken, weil der Herr Professor die Natur nicht gesehen hat, ewig egale Wendungen; denn Schlacht ist Schlacht, und die Situationen, die es etwa reicht, sind sehr abgenutzt.“"
                                            },
                                            {
                                                "example_id": "d8633499-7171-4739-810f-79a724932f33",
