                "translations": [
                    {
                        "translation_id": "8f2b5d56-d7cb-4155-a700-d99a6e08b730",
                        "source_entry_id": "e09194b4-586e-3605-bf2c-4bde66f47188",
                        "source_sense_id": "2dc06afd-fa33-3c84-98a2-5bb0407d5d0f",
                        "target_lang_word": "mer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6bfc063-8a0f-3fdd-a855-d4d7d9ebd627",
                                        "entry_id": "bd5d702d-5d2c-3bba-bb8d-d8eb5d63fec3",
                                        "glosses": [
                                            "A repeat unit: a structural unit which through repetition forms a polymer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ddce61-757a-4e39-aede-46c8d2f346fb",
                                                "sense_id": "d6bfc063-8a0f-3fdd-a855-d4d7d9ebd627",
                                                "text": "A polymer is a compound formed of repeating structural units called mers, whose atoms share electrons to form very large molecules."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49a0e2d0-29c8-33d5-ad4f-9d35436968ae",
                                        "entry_id": "e833aaf7-db6e-35e5-9ea4-407694cb642f",
                                        "glosses": [
                                            "merpeople"
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aff26109-080d-4830-abca-22f93106a077",
                                                "sense_id": "49a0e2d0-29c8-33d5-ad4f-9d35436968ae",
                                                "text": "There are mermaids and mermen everywhere. They swim above us and linger in nooks and arched doorways. It's impossible not to stare. The mer are as diverse as humans—all ages, size, shape, and color."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cccef8bd-89a6-3920-a307-80e8685ece66",
                                        "entry_id": "4c833f2c-cfd4-3643-b5df-401f023a66c5",
                                        "glosses": [
                                            "Alternative form of mayor and mair."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feacce72-aaa1-4466-82a4-3a8cd0b86d17",
                        "source_entry_id": "e09194b4-586e-3605-bf2c-4bde66f47188",
                        "source_sense_id": "2dc06afd-fa33-3c84-98a2-5bb0407d5d0f",
                        "target_lang_word": "mer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad6d5657-5250-336f-a81f-35e06d31509f",
                                        "entry_id": "694eae6c-1816-303e-9abb-cdfcbe4524e3",
                                        "glosses": [
                                            "Vaste étendue d’eau salée qui baigne les diverses parties de la terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d940911-16af-447f-832e-60153b4c603f",
                                                "sense_id": "ad6d5657-5250-336f-a81f-35e06d31509f",
                                                "text": "Le flux et le reflux de la mer."
                                            },
                                            {
                                                "example_id": "8e80e1a3-90df-4e56-8cc3-8e63f39689ea",
                                                "sense_id": "ad6d5657-5250-336f-a81f-35e06d31509f",
                                                "text": "Poisson, bain de mer."
                                            },
                                            {
                                                "example_id": "80f0f6a8-0e93-4560-aa1c-7e52ca3bf5f0",
                                                "sense_id": "ad6d5657-5250-336f-a81f-35e06d31509f",
                                                "text": "Faire un voyage par mer, en mer."
                                            },
                                            {
                                                "example_id": "30ff9c01-fe8b-4cd9-a3d2-f75b6d24f658",
                                                "sense_id": "ad6d5657-5250-336f-a81f-35e06d31509f",
                                                "text": "La mer, c'est le placenta originel, la profondeur des fosses marines, les créatures baroques, les tempêtes effroyables, les vagues scélérates."
                                            },
                                            {
                                                "example_id": "9ddd3cfe-ad38-41ec-b5d0-57c4cbe5365f",
                                                "sense_id": "ad6d5657-5250-336f-a81f-35e06d31509f",
                                                "text": "Mer : a) Ensemble des eaux salées recouvrant la partie immergée de la planète terre. S’oppose à terre d). On dit aussi océan mondial. Les étendues d’eau fermées, même salées, situées à l’intérieur des terres (mer Caspienne, mer Morte, mer d’Aral) ne sont pas considérées malgré leur nom, comme faisant partie de la mer. Voir aussi HYDROSPHÈRE.\nb) Division géographique non majeure de l’océan mondial, caractérisée par ses limites continentales ou insulaires et éventuellement des particularités hydrologiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c7f4fb2-287f-364d-96bb-d606920338a7",
                                        "entry_id": "694eae6c-1816-303e-9abb-cdfcbe4524e3",
                                        "glosses": [
                                            "Son état pour la navigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2853f08-5cd8-44f9-b6de-ae93e2f44611",
                                                "sense_id": "3c7f4fb2-287f-364d-96bb-d606920338a7",
                                                "text": "Le temps se modère un peu ; la mer toujours affreuse; le navire se comporte toujours très-bien, la mâture ne bouge pas quoique le navire tangue beaucoup."
                                            },
                                            {
                                                "example_id": "f4023724-e1ee-4c7b-9407-c62a3ab4c8be",
                                                "sense_id": "3c7f4fb2-287f-364d-96bb-d606920338a7",
                                                "text": "Dès le 14 au matin, une effroyable tourmente du sud-ouest vint assaillir ces escadres, et, soulevant une mer monstrueuse, leur fit courir les plus grands périls."
                                            },
                                            {
                                                "example_id": "55133595-5663-4f10-aa18-19e246c5e3be",
                                                "sense_id": "3c7f4fb2-287f-364d-96bb-d606920338a7",
                                                "text": "Après avoir laissé derrière nous les Orcades, nous entrâmes en plein Atlantique, et la mer s’enfla prodigieusement."
                                            },
                                            {
                                                "example_id": "9df40d24-97db-4a89-85a9-8f47ba4d75aa",
                                                "sense_id": "3c7f4fb2-287f-364d-96bb-d606920338a7",
                                                "text": "Le Firecrest tanguait fortement contre une mer très dure, plongeant son étrave dans les lames."
                                            },
                                            {
                                                "example_id": "abeb7da6-566a-45c8-b44f-56d01e548dd9",
                                                "sense_id": "3c7f4fb2-287f-364d-96bb-d606920338a7",
                                                "text": "Comment allait se passer notre amerrissage sur une mer aussi démontée ?"
                                            },
                                            {
                                                "example_id": "e6c910a5-1abf-4218-8fed-93f5c654a2e5",
                                                "sense_id": "3c7f4fb2-287f-364d-96bb-d606920338a7",
                                                "text": "Mer : […] c) État d’agitation de la surface de la mer au sens a) sous l’effet des vagues et de la houle. Voir état de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0708dec-c823-3715-a930-ad0cb45399e3",
                                        "entry_id": "694eae6c-1816-303e-9abb-cdfcbe4524e3",
                                        "glosses": [
                                            "Grande étendue de liquide."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef4be44-bead-442e-9918-fb55e05b100e",
                                                "sense_id": "d0708dec-c823-3715-a930-ad0cb45399e3",
                                                "text": "La rivière débordée couvrait la campagne, c’était une vraie mer."
                                            },
                                            {
                                                "example_id": "72e6b0db-22e0-4b05-86c2-826daf946883",
                                                "sense_id": "d0708dec-c823-3715-a930-ad0cb45399e3",
                                                "text": "Une mer de sang : Une grande quantité de sang répandu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0aff434-1d7a-34b5-ad9a-3f5d5920904b",
                                        "entry_id": "694eae6c-1816-303e-9abb-cdfcbe4524e3",
                                        "glosses": [
                                            "Vaste étendue."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3311bd4e-d266-45fe-8f5f-3201a8f19480",
                                                "sense_id": "e0aff434-1d7a-34b5-ad9a-3f5d5920904b",
                                                "text": "Nous trouvons des places au milieu d'une mer de chapeaux dans le brouhaha étouffé des conversations. La mariée arrive avec le retard de circonstance, […]."
                                            },
                                            {
                                                "example_id": "d7576ce3-c654-42b2-9c24-a91948991d01",
                                                "sense_id": "e0aff434-1d7a-34b5-ad9a-3f5d5920904b",
                                                "text": "Ces terrains secs et pierreux, ces sols très légers portaient jadis une mer de vignes de Saint-Michel à Junay sur la rive gauche de l’Armançon, de Maison Rouge à Dannemoine sur la rive droite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "055b41ea-4d88-3f02-9288-925c2d831cdc",
                                        "entry_id": "694eae6c-1816-303e-9abb-cdfcbe4524e3",
                                        "glosses": [
                                            "Meuble représentant une étendue liquide dans les armoiries. Il s’agit d'une zone colorée couvrant le tiers inférieur du champ (donc mouvant de la pointe) avec une ligne de découpe supérieure ondée rappelant les vagues ainsi que d’ombrages ou lignes également ondées sur la zone colorée. On la dit ombrée quand les vagues sont représentées d’un autre émail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e7178ed-e420-4f97-8ea4-fa1cd66290e4",
                                                "sense_id": "055b41ea-4d88-3f02-9288-925c2d831cdc",
                                                "text": "D’azur, aux trois colonnes d’argent à chapiteau corinthien surmontées de trois coquilles du même et mouvant d’une mer de sinople, qui est de la commune de Saint-Aubin-sur-Mer du Calvados → voir illustration « armoiries avec une mer »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5611a82-0038-3483-ba9e-09058e75a483",
                                        "entry_id": "694eae6c-1816-303e-9abb-cdfcbe4524e3",
                                        "glosses": [
                                            "Plaine basaltique grande et sombre de la Lune."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
