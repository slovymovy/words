                ],
                "senses": [
                    {
                        "sense_id": "8309fa2d-4c6f-3642-9763-04f9c0c57415",
                        "entry_id": "6dd739cd-4b0f-3d1e-82b4-6cc986d287c9",
                        "glosses": [
                            "счастье, удача"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf0ae1b-de2d-4540-8214-c5ddf2d4d0ff",
                                "sense_id": "8309fa2d-4c6f-3642-9763-04f9c0c57415",
                                "text": "Говорить уж нечего! Женскому полу всегда во всём фортуна. Женщин и в солдаты не берут, и на танцевальные вечера им бесплатно, и от телесного наказания освобождают…"
                            }
                        ]
                    },
                    {
                        "sense_id": "5e91e390-a4f4-353c-a8c1-b3aaba3cab9e",
                        "entry_id": "6dd739cd-4b0f-3d1e-82b4-6cc986d287c9",
                        "glosses": [
                            "прост. судьба, доля, участь ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19215818-f6ea-43e4-8983-7f6c1d89e648",
                                "sense_id": "5e91e390-a4f4-353c-a8c1-b3aaba3cab9e",
                                "text": "Уж моя фортуна такая: как застряну где-нибудь на станции, так и роман…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2a2fc6e-cfc9-48eb-99f5-a5477b2d00ef",
                        "source_entry_id": "6dd739cd-4b0f-3d1e-82b4-6cc986d287c9",
                        "target_lang_word": "fortune",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "702ca5e7-41dc-3647-a540-a19e9e86c33d",
                                        "entry_id": "5575eab3-eb47-3dd8-b69d-1ce96a1fba13",
                                        "glosses": [
                                            "Destiny, especially favorable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc44c2b6-3bd0-402c-aa3b-250f420ae42c",
                                                "sense_id": "702ca5e7-41dc-3647-a540-a19e9e86c33d",
                                                "text": "She read my fortune. Apparently I will have a good love life this week, but I will have a bad week for money."
                                            },
                                            {
                                                "example_id": "98509c06-1200-4f52-aee0-86f56a2343df",
                                                "sense_id": "702ca5e7-41dc-3647-a540-a19e9e86c33d",
                                                "text": "you, who men's fortunes in their faces read"
                                            },
                                            {
                                                "example_id": "b8d5c445-b8f3-498e-b372-c10847f94fe0",
                                                "sense_id": "702ca5e7-41dc-3647-a540-a19e9e86c33d",
                                                "text": "[…]his lordship was out of humour. That was the way Chollacombe described as knaggy an old gager as ever Charles had had the ill-fortune to serve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f27f2d6f-195b-302b-a90b-53c2a7f4d0ee",
                                        "entry_id": "5575eab3-eb47-3dd8-b69d-1ce96a1fba13",
                                        "glosses": [
                                            "A prediction or set of predictions about a person's future provided by a fortune teller."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c48bccc-1438-3654-b541-6aa2c309b413",
                                        "entry_id": "5575eab3-eb47-3dd8-b69d-1ce96a1fba13",
                                        "glosses": [
                                            "A small slip of paper with wise or vaguely prophetic words printed on it, baked into a fortune cookie."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14c75d75-8b41-3dfc-bbd6-7377a968a23d",
                                        "entry_id": "5575eab3-eb47-3dd8-b69d-1ce96a1fba13",
                                        "glosses": [
                                            "The arrival of something in a sudden or unexpected manner; chance; accident."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20cb1a24-12b3-4e74-93a4-b63eb05d542c",
                                                "sense_id": "14c75d75-8b41-3dfc-bbd6-7377a968a23d",
                                                "text": "'Tis more by fortune, lady, than by merit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea5fb126-84ea-329b-ba36-e2df14c2cbf2",
                                        "entry_id": "5575eab3-eb47-3dd8-b69d-1ce96a1fba13",
                                        "glosses": [
                                            "Good luck."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "597bb70b-25e9-413e-b10b-d1816cb039ed",
                                                "sense_id": "ea5fb126-84ea-329b-ba36-e2df14c2cbf2",
                                                "text": "fame and fortune"
                                            },
                                            {
                                                "example_id": "6c08713f-a5ca-4439-b419-b43bb1fb51a0",
                                                "sense_id": "ea5fb126-84ea-329b-ba36-e2df14c2cbf2",
                                                "text": "Fortune favors the brave."
                                            },
                                            {
                                                "example_id": "1e45ca50-28ac-4dec-8e0a-21a71d3a94bb",
                                                "sense_id": "ea5fb126-84ea-329b-ba36-e2df14c2cbf2",
                                                "text": "There is a tide in the affairs of men / Which, taken at the flood, leads on to fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ad3447-8605-352a-b44c-cd8fe84fa33f",
                                        "entry_id": "5575eab3-eb47-3dd8-b69d-1ce96a1fba13",
                                        "glosses": [
                                            "One's wealth; the amount of money one has, especially if it is vast."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "282054db-888f-4c73-8c5a-ef5ea1fcc603",
                                                "sense_id": "12ad3447-8605-352a-b44c-cd8fe84fa33f",
                                                "text": "He's amassed a small fortune working in the Middle East."
                                            },
                                            {
                                                "example_id": "22734ed2-3b9e-4346-85a2-45508cc0b071",
                                                "sense_id": "12ad3447-8605-352a-b44c-cd8fe84fa33f",
                                                "text": "My vast fortune was a result of inheritance and stock market nous."
                                            },
                                            {
                                                "example_id": "2ac6a9f7-3a03-4d09-b630-f500070ccacc",
                                                "sense_id": "12ad3447-8605-352a-b44c-cd8fe84fa33f",
                                                "text": "Her fortune is estimated at 3 million dollars."
                                            },
                                            {
                                                "example_id": "468a771b-4e2b-4033-8370-707505dd4d0a",
                                                "sense_id": "12ad3447-8605-352a-b44c-cd8fe84fa33f",
                                                "text": "It is a truth universally acknowledged, that a single man in possession of a good fortune, must be in want of a wife."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "605589a0-479b-35fe-8107-f95e9866fe6c",
                                        "entry_id": "5575eab3-eb47-3dd8-b69d-1ce96a1fba13",
                                        "glosses": [
                                            "A large amount of money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74a86bd3-6e7b-45b3-8a81-f48b3cefdcaa",
                                                "sense_id": "605589a0-479b-35fe-8107-f95e9866fe6c",
                                                "text": "That car must be worth a fortune! How could you afford it?"
                                            },
                                            {
                                                "example_id": "ddf36d00-8a05-404d-b753-f325f1ba9ed8",
                                                "sense_id": "605589a0-479b-35fe-8107-f95e9866fe6c",
                                                "text": "Why spend a small fortune on Puma when you could buy Numa, Tuna or Pigg? And why buy Adidas when you can buy Adidos or Avivas? Nike, when there's Nire or Hike? Calvin Klein, when clearly, Calvim Klain or Cavern Kernel are just as good? But remember, after a good workout, be sure to clean up with some Okay shampoo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fortune",
                                "target_lang_code": "en",
