                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4fff0f97-f486-3ba3-958c-571eba7bfd8e",
                        "entry_id": "578718e4-8ee4-386a-ae6a-18c8952ee48c",
                        "glosses": [
                            "aminokwas z łańcuchem bocznym opartym na szkielecie indolu, produkowany przez rośliny i niektóre bakterie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b5caacc-f8c2-4c96-8241-8021c24affec",
                                "sense_id": "4fff0f97-f486-3ba3-958c-571eba7bfd8e",
                                "text": "Człowiek nie potrafi syntetyzować tryptofanu we własnym organizmie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f279954-7ade-4fac-858c-a40500f36bfc",
                        "source_entry_id": "578718e4-8ee4-386a-ae6a-18c8952ee48c",
                        "source_sense_id": "4fff0f97-f486-3ba3-958c-571eba7bfd8e",
                        "target_lang_word": "tryptophan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tryptophan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0b5717-4a70-3dee-9196-2c200a36c351",
                                        "entry_id": "6e6fed71-c10a-3197-954b-426e7e2c3fc5",
                                        "glosses": [
                                            "An essential amino acid with an indole side chain; present in many foods, especially chocolate, oats, banana and milk; it is essential for normal growth and development and is the precursor of serotonin and niacin; any specific form of this compound, or any derivative of it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b6934b-ec5d-45d4-b386-f45f7b24e4d0",
                                                "sense_id": "1c0b5717-4a70-3dee-9196-2c200a36c351",
                                                "text": "The quickest way to raise serotonin levels again is to send more tryptophan into the brain, because serotonin is made from tryptophan."
                                            },
                                            {
                                                "example_id": "1bd9e484-3da1-4979-917d-29b31cde409f",
                                                "sense_id": "1c0b5717-4a70-3dee-9196-2c200a36c351",
                                                "text": "Tryptophan is an amino acid found in many foods, including dairy and turkey, which is one of the reasons commonly given for why so many of us feel so sleepy after our Thanksgiving feasts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78a3edf0-ab43-4415-98ab-68899b431944",
                        "source_entry_id": "578718e4-8ee4-386a-ae6a-18c8952ee48c",
