                        "examples": [
                            {
                                "example_id": "f84f7e31-f302-456c-bcd7-268e459e2782",
                                "sense_id": "7c701a86-7677-3fc3-8d18-59ce28c70fd6",
                                "text": "17 février 1941. Je dois rejoindre Harrar, en territoire éthiopien, et me mettre en contact avec les patriotes favorables à l’empereur. La meilleur façon d’y arriver reste la voie ferrée qui va de Djibouti à Addis-Abeba, en passant par Dire Dawa. Signé : cap. Koïnsky."
                            }
                        ]
                    }
