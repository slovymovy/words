                "senses": [
                    {
                        "sense_id": "5618c448-cd30-3f2b-b861-1dac46bb54f3",
                        "entry_id": "30adca25-05d2-338d-9ccd-22e78a2cf2e8",
                        "glosses": [
                            "gelegenheid waar leden van een gezelligheidsvereniging elkaar in hun vrije tijd kunnen ontmoeten\\n(wordt zowel gebruikt voor de activiteit als de plaats daarvan)"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "f05e34cc-c8e4-4e65-a061-7a9e72ad766c",
                                "sense_id": "5618c448-cd30-3f2b-b861-1dac46bb54f3",
                                "text": "Meneer Deetje stond nog even in gedachten en overwegend of hij nu maar niet meteen naar de soos zou gaan, daar zou nieuws genoeg zijn."
                            },
                            {
                                "example_id": "98a09750-aa3e-40e2-82e6-e9437e7b5dd1",
                                "sense_id": "5618c448-cd30-3f2b-b861-1dac46bb54f3",
                                "text": "Wanneer wordt een soos gehouden?\nMeestal op vrijdag- en zaterdagavond."
                            }
                        ]
                    },
                    {
                        "sense_id": "89e9a48f-306f-3cf9-91bb-fd7e49fb519b",
                        "entry_id": "30adca25-05d2-338d-9ccd-22e78a2cf2e8",
                        "glosses": [
                            "gelegenheid waar leden van een gezelligheidsvereniging elkaar in hun vrije tijd kunnen ontmoeten\\n(wordt zowel gebruikt voor de activiteit als de plaats daarvan)",
                            "ontmoetingsruimte van een studentenvereniging"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "c8c8abcb-30e0-4e18-8e18-fd6d0518ce5c",
                                "sense_id": "89e9a48f-306f-3cf9-91bb-fd7e49fb519b",
                                "text": "Meneer Deetje stond nog even in gedachten en overwegend of hij nu maar niet meteen naar de soos zou gaan, daar zou nieuws genoeg zijn."
                            },
                            {
                                "example_id": "ffba70a4-334f-451a-b732-b37f194b8412",
                                "sense_id": "89e9a48f-306f-3cf9-91bb-fd7e49fb519b",
                                "text": "Wanneer wordt een soos gehouden?\nMeestal op vrijdag- en zaterdagavond."
                            },
                            {
                                "example_id": "fd488ad3-0d5d-484e-acbe-22b05b273264",
                                "sense_id": "89e9a48f-306f-3cf9-91bb-fd7e49fb519b",
                                "text": "Op 16 januari 1996 was er een Open Literair Podium in de sociëteit van de Friese studentenvereniging Bernlef in Groningen. Een haveloze soos met de geur van bier en rook, zonder enige opsmuk."
                            }
                        ]
                    },
                    {
                        "sense_id": "89c0ed38-547a-3e6e-b220-4e6f7db00b38",
                        "entry_id": "30adca25-05d2-338d-9ccd-22e78a2cf2e8",
                        "glosses": [
                            "gelegenheid waar leden van een gezelligheidsvereniging elkaar in hun vrije tijd kunnen ontmoeten\\n(wordt zowel gebruikt voor de activiteit als de plaats daarvan)",
                            "gebouw waar leden van de Europese bovenlaag in een stad elkaar troffen"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "055c0795-5db9-4fd5-83f6-6f962336e941",
                                "sense_id": "89c0ed38-547a-3e6e-b220-4e6f7db00b38",
                                "text": "Meneer Deetje stond nog even in gedachten en overwegend of hij nu maar niet meteen naar de soos zou gaan, daar zou nieuws genoeg zijn."
                            },
                            {
                                "example_id": "6dbaf055-dd0e-4067-9825-c87893c30ca3",
                                "sense_id": "89c0ed38-547a-3e6e-b220-4e6f7db00b38",
                                "text": "Wanneer wordt een soos gehouden?\nMeestal op vrijdag- en zaterdagavond."
                            },
                            {
                                "example_id": "aa7dacc6-4ec3-40ca-afde-58fa83974fca",
                                "sense_id": "89c0ed38-547a-3e6e-b220-4e6f7db00b38",
                                "text": "Om met elkaar om te gaan waren er de sociëteit, het zwembad en de tennisbaan. Ruzies en gekonkel spraken vanzelf; gelukkig werd iedereen overgeplaatst na drie jaar, het was een voortdurend komen en gaan. Toegang tot soos, zwembad en tennisbaan bestond niet voor een grotere groep mensen met eveneens Nederlandse nationaliteit en Europese namen, gemengd-bloedigen van het soort dat de lagere rangen vervulde, commiezen, klerken."
                            }
                        ]
                    },
                    {
                        "sense_id": "df344ba5-8dce-3f4d-8db0-5076e84ce2c3",
                        "entry_id": "30adca25-05d2-338d-9ccd-22e78a2cf2e8",
                        "glosses": [
                            "afdeling van een gemeente belast met de verlening van bijstandsuitkeringen"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "57a03260-2434-491e-a9dc-4055e54c6d12",
                                "sense_id": "df344ba5-8dce-3f4d-8db0-5076e84ce2c3",
                                "text": "Ja, de risicofactor speelt bij mij een hele grote rol. Want ik weet wat mijn rechten zijn, ik weet wat de soos z’n rechten zijn."
                            }
                        ]
                    }
