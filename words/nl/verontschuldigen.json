{
    "word_family": [
        "verontschuldiging",
        "onverontschuldigbaar",
        "verontschuldigend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a9fba2a-68cd-3f7e-a29c-9a13ef9500fb",
                    "sense_definition": "spijt betuigen voor een fout of wangedrag",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "excuses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben zich <w>verontschuldigd</w> voor hun wangedrag tijdens het feest.",
                            "target_lang_translations": {
                                "en": "They <w>apologized</w> for their misconduct during the party."
                            }
                        },
                        {
                            "text": "Je moet je <w>verontschuldigen</w> voor die gemene opmerking tegen je zus.",
                            "target_lang_translations": {
                                "en": "You must <w>apologize</w> for that mean remark to your sister."
                            }
                        }
                    ],
                    "synonyms": [
                        "excuseren",
                        "spijt betuigen",
                        "excuses aanbieden"
                    ],
                    "common_phrases": [
                        "zich verontschuldigen voor"
                    ],
                    "target_lang_definitions": {
                        "en": "to express regret for a mistake or misconduct"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apologize",
                                "target_lang_sense_clarification": "to say sorry for something"
                            },
                            {
                                "target_lang_word": "make excuses",
                                "target_lang_sense_clarification": "to offer reasons for a mistake"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47e65994-7f2e-3848-bd63-0e2883f65f1a",
                    "sense_definition": "toestemming vragen om weg te gaan of om niet aanwezig te zijn",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "afwezigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wilt u mij even <w>verontschuldigen</w>? Ik moet een belangrijk telefoontje plegen.",
                            "target_lang_translations": {
                                "en": "Would you <w>excuse</w> me for a moment? I have to make an important phone call."
                            }
                        },
                        {
                            "text": "Wegens drukke werkzaamheden moest hij zich helaas <w>verontschuldigen</w> voor de vergadering.",
                            "target_lang_translations": {
                                "en": "Due to a heavy workload, he unfortunately had to <w>send his apologies</w> for the meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "afzeggen",
                        "excuseren"
                    ],
                    "common_phrases": [
                        "wilt u mij verontschuldigen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in formele sociale contexten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to ask for permission to leave or to be absent"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excuse",
                                "target_lang_sense_clarification": "to ask for permission to leave"
                            },
                            {
                                "target_lang_word": "send one's apologies",
                                "target_lang_sense_clarification": "to formally state one cannot attend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b315226c-4a90-35f2-87b9-5b8062dc21ef",
                    "sense_definition": "iemand of iets vrijpleiten van schuld of een fout minder erg doen lijken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rechtvaardiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vaagheid van een strafbepaling <w>verontschuldigt</w> de overtreder niet voor zijn daden.",
                            "target_lang_translations": {
                                "en": "The vagueness of a penal provision does not <w>excuse</w> the offender for his actions."
                            }
                        },
                        {
                            "text": "Niets kan zijn agressieve gedrag tegenover de buren <w>verontschuldigen</w>.",
                            "target_lang_translations": {
                                "en": "Nothing can <w>justify</w> his aggressive behavior toward the neighbors."
                            }
                        }
                    ],
                    "synonyms": [
                        "rechtvaardigen",
                        "vrijpleiten",
                        "verschonen"
                    ],
                    "antonyms": [
                        "beschuldigen",
                        "veroordelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to clear someone or something of guilt or make a mistake seem less serious"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excuse",
                                "target_lang_sense_clarification": "to justify or overlook a fault"
                            },
                            {
                                "target_lang_word": "justify",
                                "target_lang_sense_clarification": "to provide a good reason for something"
                            },
                            {
                                "target_lang_word": "exonerate",
                                "target_lang_sense_clarification": "to free from blame"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}