                "senses": [
                    {
                        "sense_id": "5a0fb53e-fa88-304a-92c3-b4491c57437f",
                        "entry_id": "e14764cc-cbf1-3af6-90e2-4fa23218ad9f",
                        "glosses": [
                            "handshake (grasping of hands by two people)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "556cab01-7118-443c-aa13-7800c52e00af",
                                "sense_id": "5a0fb53e-fa88-304a-92c3-b4491c57437f",
                                "text": "Всё о́бщество, продолжа́я меня́ться приве́тами и рукопожа́тиями с прибы́вшим хозя́ином, дви́нулось вверх по ле́стнице, уста́вленной с обе́их сторо́н гла́вными слу́гами и служа́нками.",
                                "translation": "The whole party, still exchanging welcomes and shaking hands with the newly arrived master, moved up the steps, along both sides of which were ranged the principal men- and maid-servants.",
                                "english": "The whole party, still exchanging welcomes and shaking hands with the newly arrived master, moved up the steps, along both sides of which were ranged the principal men- and maid-servants."
                            }
                        ]
                    },
                    {
                        "sense_id": "04e6b6b6-c043-3672-93cd-c25e5a8956aa",
                        "entry_id": "e14764cc-cbf1-3af6-90e2-4fa23218ad9f",
                        "glosses": [
                            "handshake"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa816322-1b35-4e42-b1cf-76350eb8839f",
                                "sense_id": "04e6b6b6-c043-3672-93cd-c25e5a8956aa",
                                "text": "Что́бы установи́ть надёжное соедине́ние, TCP испо́льзует проце́сс, называ́емый те́рмином “трёхсторо́ннее рукопожа́тие”",
                                "translation": "To establish a reliable coonection, TCP uses a process called three-way handshake.",
                                "english": "To establish a reliable coonection, TCP uses a process called three-way handshake."
                            }
                        ]
                    }
                ],
