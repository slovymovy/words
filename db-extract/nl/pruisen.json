                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ad0155-a10b-3913-837c-6b2bad00ab2d",
                                        "entry_id": "5684dc11-b0ac-352d-8c3c-c0c95c9e48b4",
                                        "glosses": [
                                            "ein Königreich in Europa, später Gliedstaat des Deutschen Reiches"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f61e4b9c-caf7-42c9-9be7-8960112970fd",
                                                "sense_id": "f7ad0155-a10b-3913-837c-6b2bad00ab2d",
                                                "text": "„Der Frieden von Hubertusburg beendet den Siebenjährigen Krieg zwischen Preußen und Österreich.“"
                                            },
                                            {
                                                "example_id": "b3a27827-14c1-46e3-82d7-85d8d6f9c939",
                                                "sense_id": "f7ad0155-a10b-3913-837c-6b2bad00ab2d",
                                                "text": "Preußen wurde von der Dynastie der Hohenzollern regiert."
                                            },
                                            {
                                                "example_id": "006a5ee4-f4b7-46c1-b2a3-0ab1c5e9f5a2",
                                                "sense_id": "f7ad0155-a10b-3913-837c-6b2bad00ab2d",
                                                "text": "„Dall'Oglio und seine hübsche Frau brachten mich auf den Gedanken, nach Rußland zu fahren, wenn mir der König von Preußen keine angemessene Anstellung gab.“"
                                            },
                                            {
                                                "example_id": "dd2b59f7-7ab5-425a-abda-9afd4deba42b",
                                                "sense_id": "f7ad0155-a10b-3913-837c-6b2bad00ab2d",
                                                "text": "„In Königsberg, der Hauptstadt des Herzogtums Preußen, wurde Immanuel Kant am 22. April 1724 geboren.“"
                                            },
                                            {
                                                "example_id": "42dc7873-cd09-4049-8286-0f53a0ffb42a",
                                                "sense_id": "f7ad0155-a10b-3913-837c-6b2bad00ab2d",
                                                "text": "„In der Regel wurden Handelsabkommen mit anderen Nationen zentral für alle Mitgliedstaaten von Preußen ausgehandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
