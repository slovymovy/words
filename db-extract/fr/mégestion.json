                        "entry_id": "3885c29a-f225-3dac-a067-09d3316ad7e5",
                        "glosses": [
                            "Mauvaise gestion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "add497d1-2401-4f8e-a770-8456d09fd2d5",
                                "sense_id": "a7b3e5c8-73db-343f-80e8-b2b407ddd9ca",
                                "text": "Il est inquièt de la mégestion de l’hôpital général de Kisangani."
                            },
                            {
                                "example_id": "840ed3c6-9e3e-4aa5-a8fd-b13c173bb466",
                                "sense_id": "a7b3e5c8-73db-343f-80e8-b2b407ddd9ca",
                                "text": "La radicalisation de la crise économique provoquée par la mégestion décrite ci-dessus a paupérisé le peuple et créé ainsi les conditions propices à l’accroissement de dites pratiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ece63e3c-091a-4733-a437-be4d40036a16",
                        "source_entry_id": "3885c29a-f225-3dac-a067-09d3316ad7e5",
                        "source_sense_id": "a7b3e5c8-73db-343f-80e8-b2b407ddd9ca",
                        "target_lang_word": "mismanagement",
