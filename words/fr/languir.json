{
    "word_family": [
        "langueur",
        "languissamment",
        "languissant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e828dc4-012b-38e9-bde4-01f06e06e6ea",
                    "sense_definition": "Attendre avec une vive impatience, ou maintenir quelqu'un dans une attente prolongée et incertaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de me faire <w>languir</w> et annonce enfin la bonne nouvelle."
                        },
                        {
                            "text": "Les spectateurs ont dû <w>languir</w> plus d'une heure avant le début du concert."
                        }
                    ],
                    "synonyms": [
                        "patienter"
                    ],
                    "common_phrases": [
                        "faire languir"
                    ]
                },
                {
                    "sense_id": "a4cfd9b4-ba63-3dec-94e3-8360ddd3d161",
                    "sense_definition": "Perdre sa vivacité, son animation ou son élan, en parlant d'un échange, d'une activité ou d'un récit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ralentissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La conversation commençait à <w>languir</w> avant qu'un invité ne relance le débat."
                        },
                        {
                            "text": "Le rythme de ce long roman finit par <w>languir</w> dans les derniers chapitres."
                        }
                    ],
                    "synonyms": [
                        "faiblir",
                        "traîner"
                    ],
                    "antonyms": [
                        "s'animer"
                    ],
                    "common_phrases": [
                        "laisser languir"
                    ]
                },
                {
                    "sense_id": "99ddddae-a8af-3a90-889a-12640803eda0",
                    "sense_definition": "Éprouver une nostalgie douloureuse ou un grand vide provoqué par l'absence d'une personne ou d'un lieu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son départ pour l'étranger, il se <w>languit</w> de sa famille restée au village."
                        },
                        {
                            "text": "Je me <w>languis</w> de revoir mon pays natal après toutes ces années passées au loin."
                        }
                    ],
                    "synonyms": [
                        "se morfondre"
                    ],
                    "common_phrases": [
                        "se languir de"
                    ]
                },
                {
                    "sense_id": "180f3ac3-fc39-3e9e-9d0e-62b0ad4deaa9",
                    "sense_definition": "Dépérir lentement ou perdre progressivement ses forces sous l'effet d'une maladie, de la douleur ou de la privation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "affaiblissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pauvre captif a <w>langui</w> dans un cachot humide pendant plusieurs mois."
                        },
                        {
                            "text": "Faute de soins et d'une nourriture adaptée, le blessé continuait de <w>languir</w>."
                        }
                    ],
                    "synonyms": [
                        "dépérir",
                        "s'affaiblir",
                        "s'étioler"
                    ],
                    "antonyms": [
                        "prospérer"
                    ],
                    "common_phrases": [
                        "languir de faim"
                    ]
                }
            ]
        }
    ]
}