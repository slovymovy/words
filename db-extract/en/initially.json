                                                "sense_id": "9a1c44a2-3c7a-3005-99a3-8d2fb0cf0e2e",
                                                "text": "Behandeln wir zunächst die Symptome des Problems, später dessen Ursache."
                                            },
                                            {
                                                "example_id": "553cc720-1fda-454b-89a3-12e8259fd5b2",
                                                "sense_id": "9a1c44a2-3c7a-3005-99a3-8d2fb0cf0e2e",
                                                "text": "„Deshalb hatte Rom mit den üblichen Strafexpeditionen zunächst weiterhin Erfolg.“"
                                            },
                                            {
                                                "example_id": "57aec5d0-9d1a-433c-aac6-2eba889f17d5",
                                                "sense_id": "9a1c44a2-3c7a-3005-99a3-8d2fb0cf0e2e",
                                                "text": "„Das etwa 3,6 Meter lange Fluggerät war zunächst von einem B-52-Bomber in einer Flughöhe von knapp 12200 Meter abgesetzt und dann von einer Rakete auf 30000 Meter Höhe gebracht worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18c6d1a6-7dfb-3892-886a-c41942244372",
