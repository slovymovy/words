                        "examples": [
                            {
                                "example_id": "5f8972c0-8412-49a7-b0cc-aabcfddc36ba",
                                "sense_id": "fbe08279-a189-306a-994d-cd29441de518",
                                "text": "Bei der Jagd setzte T-rex offenbar nicht nur auf kleinere Saurier, sondern auch auf Artgenossen."
                            },
                            {
                                "example_id": "6f51e20b-1716-4493-ab8c-5c2527359140",
                                "sense_id": "fbe08279-a189-306a-994d-cd29441de518",
                                "text": "Das Skelett des T-rex-Weibchens wurde 2013 im US-amerikanischen Bundesstaat Montana gefunden."
                            },
                            {
                                "example_id": "b24a8c3f-a438-4177-b237-456f4b0e8345",
                                "sense_id": "fbe08279-a189-306a-994d-cd29441de518",
                                "text": "„Du würdest dir auch einen lebenden T-rex oder einen Giraffatitan entgehen lassen, nur weil sie im Labor gezüchtet wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
