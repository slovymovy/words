        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f5e5dbb-3b70-3aaf-9f64-6ead016b9965",
                    "sense_definition": "To cause to have, or to develop, an accidental shelf or obstruction (especially during mining, canal construction, or dental root canal procedures).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist worked carefully with the file to avoid <w>ledging</w> the delicate canal walls.",
