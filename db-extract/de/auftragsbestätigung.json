                "senses": [
                    {
                        "sense_id": "b427a22c-09dd-3fc7-b779-bd3aa6fa687f",
                        "entry_id": "e604e6b3-841d-3b2b-a4c5-7de924b76a1d",
                        "glosses": [
                            "rechtsverbindliche Mitteilung, über die Annahme eines Auftrages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fbf041d-31f4-450f-b83e-079fa48944ff",
                                "sense_id": "b427a22c-09dd-3fc7-b779-bd3aa6fa687f",
                                "text": "Die Auftragsbestätigung kam mit der Post und gab mir den genauen Liefertermin und viele weitere Datails zu meiner Bestellung an."
                            },
                            {
                                "example_id": "62ff1f44-a163-49df-9fe4-32eb332ad775",
                                "sense_id": "b427a22c-09dd-3fc7-b779-bd3aa6fa687f",
                                "text": "„Die Auftragsbestätigung ist im deutschen Recht keine eigene Rechtsfigur, sondern lediglich eine im allgemeinen Geschäftsverkehr übliche, meist schriftliche, Form der Willenserklärung.“"
                            },
                            {
                                "example_id": "768ead1d-2393-45ed-98e9-81426b6f8519",
                                "sense_id": "b427a22c-09dd-3fc7-b779-bd3aa6fa687f",
                                "text": "„Über die Bestellbestätigung hinaus ist es möglich von einigen Lieferanten eine Auftragsbestätigung in digitaler Form zu erhalten.“"
                            },
                            {
                                "example_id": "594801e2-6e45-4cac-b8e8-156f60526a71",
                                "sense_id": "b427a22c-09dd-3fc7-b779-bd3aa6fa687f",
                                "text": "„Bis zur schriftlichen Auftragsbestätigung sind alle Angebote freibleibend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
