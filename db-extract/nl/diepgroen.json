                "senses": [
                    {
                        "sense_id": "43e1e514-7f08-3c98-a88a-7e795c5a7a20",
                        "entry_id": "5d79c537-1b9d-3b44-a27c-42c0f9b391c5",
                        "glosses": [
                            "met een intense kleur groen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9d86cfb-a49e-43fa-873e-95b4271e44ba",
                                "sense_id": "43e1e514-7f08-3c98-a88a-7e795c5a7a20",
                                "text": "'Het allerlaatste wat ik kocht is een paar fijne sokken van Marni in diepgroen en verbrand oranje. Ik investeer elk seizoen in een aantal paar mooie sokken. Met sokken kan je subtiele én tegelijk eigenzinnige accenten leggen.'"
                            },
                            {
                                "example_id": "b53c7639-d97a-4822-add4-3ff0f4672284",
                                "sense_id": "43e1e514-7f08-3c98-a88a-7e795c5a7a20",
                                "text": "Woensdag keerden de laatste Apaches terug uit. De gevechtsheli’s staan er wat bleekjes bij. Het diepgroen is grauw geworden. „Ze moeten allemaal naar de schilder”, verklaart onderhoudsofficier Stephan van Gewen van het 301 Apachesquadron."
                            },
                            {
                                "example_id": "9ee1993d-6bac-4d5e-b1f6-19d963f8f17c",
                                "sense_id": "43e1e514-7f08-3c98-a88a-7e795c5a7a20",
                                "text": "Vlak naast de vliegstrip staat het voormalige huis van ds. Kuijt en zijn vrouw. Het uitzicht vanuit de woonkamer is fenomenaal. In de verte pronkt een hoge bergrug, ervoor een kilometerslang diepgroen dal."
                            }
                        ]
                    }
