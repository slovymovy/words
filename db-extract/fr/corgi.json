                ],
                "senses": [
                    {
                        "sense_id": "48bbd790-1ec0-3a7a-b22f-5087c604ea15",
                        "entry_id": "0235fa17-43d7-37f2-940c-e1f49ebec89a",
                        "glosses": [
                            "Race de chiens originaire du Pays de Galles."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6810e3c5-615d-499b-b22d-bc7dfcc2cae3",
                                "sense_id": "48bbd790-1ec0-3a7a-b22f-5087c604ea15",
                                "text": "La monarchie britannique souffrirait sans nul doute d’un geste d’emportement royal envers les corgis inséparables de cette famille visiblement amie des animaux."
                            },
                            {
                                "example_id": "e6af30da-0951-47f8-aea6-f6c470ed9360",
                                "sense_id": "48bbd790-1ec0-3a7a-b22f-5087c604ea15",
                                "text": "Passionnée de chiens, notamment les corgis, et de chevaux, elle y montait encore à cheval à 90 ans."
                            },
                            {
                                "example_id": "25a269ff-f093-41a0-9920-14815743d689",
                                "sense_id": "48bbd790-1ec0-3a7a-b22f-5087c604ea15",
                                "text": "Elle en a élevé une trentaine sur des générations, avec une préférence pour la race Pembroke, mais a aussi créé le « dorgi », croisement du corgi et du teckel."
                            },
                            {
                                "example_id": "7b7a9b60-a418-452e-955c-94a35eafef60",
                                "sense_id": "48bbd790-1ec0-3a7a-b22f-5087c604ea15",
                                "text": "Mais c’est l’heure de leur tour matutinal avec les chiens, lesquels frétillent, réclament. Je vous les présente mieux : Oscar, l’œil vif et une sacrée paire d’oreilles, la robe sable à jabot blanc, un corgi, bravo, qui a toujours l’air de sourire, joyeux, attentif, d’excellente composition – Oscar, franchement, le genre qu’on aime tout de suite (Oscar, vous allez l’adorer)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63351f88-aa97-4203-b3d1-9507863f5684",
                        "source_entry_id": "0235fa17-43d7-37f2-940c-e1f49ebec89a",
                        "source_sense_id": "48bbd790-1ec0-3a7a-b22f-5087c604ea15",
                        "target_lang_word": "corgi",
