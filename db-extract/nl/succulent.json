                    },
                    {
                        "translation_id": "7aa49d5e-965e-4729-a470-6a5355f0b3be",
                        "source_entry_id": "a462743d-abdc-38dd-8872-8893174fae30",
                        "target_lang_word": "succulent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "succulent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02c24e4f-f50c-34a9-a2b2-5efc4402459a",
                                        "entry_id": "421ad44c-e782-31f6-8bdb-046033f4ec1a",
                                        "glosses": [
                                            "Qui a beaucoup de suc, qui est savoureux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9649cdd-2e2a-437b-abea-42d861f8232d",
                                                "sense_id": "02c24e4f-f50c-34a9-a2b2-5efc4402459a",
                                                "text": "Les chasseurs abattirent un grand nombre de ces animaux, dont la chair est véritablement succulente."
                                            },
                                            {
                                                "example_id": "1496751a-5e56-475e-90cf-39c386c1c2f1",
                                                "sense_id": "02c24e4f-f50c-34a9-a2b2-5efc4402459a",
                                                "text": "Peu de gens savent qu’on peut cultiver de succulents raisins de table au Québec, et ce, en particulier grâce aux travaux d’Elmer Swenson, hybrideur américain qui a développé des cultivars résistants à notre climat nordique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d665b125-0a36-3fa1-a1f5-d61da041360e",
                                        "entry_id": "421ad44c-e782-31f6-8bdb-046033f4ec1a",
                                        "glosses": [
                                            "Se dit d'une plante charnue ou plante grasse, dont les organes (parenchyme) emmagasinent de l'eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183e86c1-455e-44c8-b92a-4d0796fb8378",
                                                "sense_id": "d665b125-0a36-3fa1-a1f5-d61da041360e",
                                                "text": "Le selago des Celtes est nécessairement une plante succulente tandis notre Lycopodium Selago ne rend aucun suc."
                                            },
                                            {
                                                "example_id": "98c2a48a-a2d2-445d-ba46-721ae509f73d",
                                                "sense_id": "d665b125-0a36-3fa1-a1f5-d61da041360e",
                                                "text": "Or Mullerornis est au nord, tandis qu’Æpyornis peuple toute l’île. Là où les deux genres partagent le même territoire, les signatures isotopiques montrent que leurs niches écologiques étaient différentes, Mullerornis se nourrissant de plantes succulentes, d’insectes et de lézards, tandis qu’Æpyornis était plutôt brouteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de2009f3-b500-3c82-bb31-2f1c1839f9bc",
                                        "entry_id": "421ad44c-e782-31f6-8bdb-046033f4ec1a",
                                        "glosses": [
                                            "Qui ravit l'esprit, savoureux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2167dbf3-07e3-4b13-9e56-44a9c07f498d",
                                                "sense_id": "de2009f3-b500-3c82-bb31-2f1c1839f9bc",
                                                "text": "Ton sonnet à la Sorcière est succulent et le dernier tercet a une consistance de calougat qui m'enchante."
                                            }
                                        ]
                                    }
                                ]
                            },
