    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d54a0ff8-0f46-3436-af78-f2e22e9f9e18",
                    "sense_definition": "iets niet doen dat men in principe had behoren te doen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nalatigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Helaas hebben wij <w>verzuimd</w> dit tijdig aan de directie te melden.",
                            "target_lang_translations": {
                                "en": "Unfortunately, we <w>failed</w> to report this to the management in time."
                            }
                        },
                        {
                            "text": "Je mag niet <w>verzuimen</w> om je elke ochtend bij de receptie te melden.",
                            "target_lang_translations": {
                                "en": "You must not <w>neglect</w> to report to the reception every morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "nalaten",
                        "verzaken"
                    ],
                    "antonyms": [
                        "nakomen",
                        "vervullen"
                    ],
                    "common_phrases": [
                        "niet verzuimen om",
                        "verzuimen te melden"
                    ],
                    "target_lang_definitions": {
                        "en": "To fail to do something that one was supposed or expected to do."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to fail",
                                "target_lang_sense_clarification": "to not perform a duty or action"
                            },
                            {
                                "target_lang_word": "to neglect",
                                "target_lang_sense_clarification": "to fail to take care of a responsibility"
                            },
                            {
                                "target_lang_word": "to omit",
                                "target_lang_sense_clarification": "to leave out or fail to do"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32d24481-5e42-30ff-b0b8-81177f96f146",
                    "sense_definition": "afwezig zijn op een plek waar men verwacht wordt, zoals werk of school",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afwezigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerling bleef zonder geldige reden van school <w>verzuimen</w>.",
                            "target_lang_translations": {
                                "en": "The student continued to <w>be absent</w> from school without a valid reason."
                            }
                        },
                        {
                            "text": "Werknemers die vaak <w>verzuimen</w> wegens ziekte krijgen een gesprek met de bedrijfsarts.",
                            "target_lang_translations": {
                                "en": "Employees who are often <w>absent</w> due to illness will have a meeting with the company doctor."
                            }
                        }
                    ],
                    "antonyms": [
                        "aanwezig zijn"
                    ],
                    "common_phrases": [
                        "wegens ziekte verzuimen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be absent from a place where one is expected to be, such as work or school."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be absent",
                                "target_lang_sense_clarification": "not being present at work or school"
                            },
                            {
                                "target_lang_word": "to miss",
                                "target_lang_sense_clarification": "to not attend an appointment or obligation"
                            }
                        ]
                    }
                }
            ]
        },
        {
