                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f9a48f1-3634-3096-895d-84812cc44a5c",
                        "entry_id": "d32a2ead-0883-3b8d-8c3a-5860919d81ca",
                        "glosses": [
                            "Qui s'est insurgé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5350834-15b7-4238-8131-2b9e2b2e4ca7",
                                "sense_id": "3f9a48f1-3634-3096-895d-84812cc44a5c",
                                "text": "Elle parcourut les Tuileries, le Carrouzel^([sic]), au milieu du peuple armé et insurgé, mais calme."
                            },
                            {
                                "example_id": "51708439-f99c-459e-9e67-83ea1378a041",
                                "sense_id": "3f9a48f1-3634-3096-895d-84812cc44a5c",
                                "text": "Il y a l’ombre d’Auguste Blanqui, socialiste insurgé si souvent utilisé en référence par l’extrême droite radicale française, et pour qui le bourgeois anti-communard constituait «le Prussien de l’intérieur»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ff35cf9-e60c-4bde-ae23-8c512429bc02",
                        "source_entry_id": "d32a2ead-0883-3b8d-8c3a-5860919d81ca",
                        "source_sense_id": "3f9a48f1-3634-3096-895d-84812cc44a5c",
                        "target_lang_word": "insurrecto",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insurrecto",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9f00e185-de28-3426-83e6-b3e87dcc837f",
                                        "entry_id": "0dd6829f-5e77-3663-95c1-ec1f26b95f20",
                                        "glosses": [
                                            "Que no reconoce algún aspecto importante de la autoridad pública o su totalidad y, en consecuencia, se subleva contra ella, ya sea individualmente o promoviendo la sedición."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "d7c9324a-104f-383b-94d3-832226ad3e92",
