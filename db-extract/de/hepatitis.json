                                        "sense_id": "214ccd02-3721-3fdd-8adf-d0c8819f2f99",
                                        "entry_id": "157f501e-234c-3d4e-a077-d49fc6f4787c",
                                        "glosses": [
                                            "Inflammation of the liver, sometimes caused by a viral infection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a36bf427-8f65-4bf8-a4b2-b357f8734ca9",
                                                "sense_id": "214ccd02-3721-3fdd-8adf-d0c8819f2f99",
                                                "text": "Hepatitises B and C are the most important chronic viral infections of humans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cdf01a7-76bf-4216-93b1-101b2928501f",
                        "source_entry_id": "1115de5a-9cd1-3cc6-aa4e-5b84923a845a",
                        "source_sense_id": "30f8c316-ee93-396f-bafa-3b3e92a77631",
                        "source_sense_description": "Medizin: Entzündung der Leber",
                        "target_lang_word": "hépatite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hépatite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fae6dacc-660a-32e6-9063-c05de10f149f",
                                        "entry_id": "0a127bd4-50d3-36a5-9065-783fa30fb69a",
                                        "glosses": [
                                            "Inflammation du foie. Son origine peut être virale, microbienne, auto-immune, parasitaire, ou autre."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e390cc0-98f5-40dc-afcf-3116dfa922d6",
                                                "sense_id": "fae6dacc-660a-32e6-9063-c05de10f149f",
                                                "text": "Les contre-indications permanentes concernent les infections actives connues pour être transmissibles par le sang (hépatites virales, syphilis, infection par le VIH ou par le HTLV, maladie de Chagas, paludisme)."
                                            },
                                            {
                                                "example_id": "8f476218-d27e-496f-85a2-2356d0b93f4b",
                                                "sense_id": "fae6dacc-660a-32e6-9063-c05de10f149f",
                                                "text": "Des choses simples, un ulcère duodénal, une colopathie fonctionnelle, et parfois des choses plus compliquées, une hépatite, une maladie de Crohn, un cancer du côlon…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "334d7440-bff0-3b5a-ba9e-d8f9972bd3a8",
                                        "entry_id": "0a127bd4-50d3-36a5-9065-783fa30fb69a",
                                        "glosses": [
                                            "Pierre précieuse, ainsi nommée parce qu’elle est de la couleur du foie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00ad18b9-7485-3a80-ad7d-49a9f19c4876",
                                        "entry_id": "0a127bd4-50d3-36a5-9065-783fa30fb69a",
                                        "glosses": [
                                            "Sulfate de baryum naturel, incolore, blanc, ou clair. Elle dégage une odeur fétide quand elle est cassée ou écrasée. C’est une variété particulière de baryte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
