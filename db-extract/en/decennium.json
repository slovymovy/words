                            {
                                "example_id": "7421a089-66c2-4dea-95ea-b16239fc1f85",
                                "sense_id": "795e024f-256f-3a98-8e86-50b5ba48b8d8",
                                "text": "G.B. still has to cope with the heritage of approx. 20 years of consecutive Conservative reigns, just as you guys are getting your act together after almost a decennium of Enlightened Ronnie."
                            },
                            {
                                "example_id": "f7df7a6b-7ce8-4d0a-9e64-8ce85e5feaa1",
                                "sense_id": "795e024f-256f-3a98-8e86-50b5ba48b8d8",
                                "text": "Christian leaders refused even to *look* through Galileo's telescope (as a matter of fact, the Vatican cleared Galileo's name only as late as in the previous decennium)."
                            }
                        ]
                    }
