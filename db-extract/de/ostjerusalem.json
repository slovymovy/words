                        "examples": [
                            {
                                "example_id": "ad3f26b7-b2bb-498b-b62d-d64d7db411ff",
                                "sense_id": "ae30ff4c-d6d5-3e0e-a180-1dfb13925e42",
                                "text": "„Am Montag hat die israelische Armee mehrere Häuser in Ostjerusalem zerstört.“"
                            },
                            {
                                "example_id": "8f0a7062-5be6-4120-b50c-34f4600bda5c",
                                "sense_id": "ae30ff4c-d6d5-3e0e-a180-1dfb13925e42",
                                "text": "„Jahr für Jahr sahen sich die Palästinenser aus Anata zunehmend eingeflochten in das städtische Gewebe eines stetig wachsenden Jerusalems, das die Altstadt und den Rest von Ostjerusalem ebenso geschluckt hatte wie mehr als ein Dutzend umliegende Dörfer, alle von Israel annektiert.“"
                            }
                        ],
