                "senses": [
                    {
                        "sense_id": "15aae765-bd5d-3d92-9ca9-5a0c66439972",
                        "entry_id": "60b329f7-0e9a-362a-b9c8-3ec4c48a51e3",
                        "glosses": [
                            "Tier, das aus der Kreuzung zweier oder mehr Arten oder Rassen hervorging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c256e2c5-6655-4c55-afa0-ada04430982a",
                                "sense_id": "15aae765-bd5d-3d92-9ca9-5a0c66439972",
                                "text": "„Der Algorithmus konnte darin Merkmale erkennen, die einem Hund, einem Fisch oder vielleicht einem Hybridtier entsprachen.“"
                            },
                            {
                                "example_id": "2fa3417b-dbf6-4904-a983-9a8e0fc89c07",
                                "sense_id": "15aae765-bd5d-3d92-9ca9-5a0c66439972",
                                "text": "„Die Ausgestaltung des Schutzumfangs richtet sich danach, ob es sich beim Schutzgegenstand um ein Reinzucht- oder Hybridtier handelt.“"
                            },
                            {
                                "example_id": "37adf8bc-2bba-4da0-8327-bb07dd6752c0",
                                "sense_id": "15aae765-bd5d-3d92-9ca9-5a0c66439972",
                                "text": "„Es ist nicht gleichgültig, ob Inzucht-, Auszucht-, Hybridtiere oder Mutanten eingesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
