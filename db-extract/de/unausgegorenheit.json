                "senses": [
                    {
                        "sense_id": "0a7e36d4-d10e-3fc9-b648-f9c4534af95f",
                        "entry_id": "917eb585-9aaa-3b89-8f05-9d9e5de1eca3",
                        "glosses": [
                            "Zustand, nicht in allen Einzelheiten durchdacht zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6805256-e31c-479d-a2b5-4536f78ec0e6",
                                "sense_id": "0a7e36d4-d10e-3fc9-b648-f9c4534af95f",
                                "text": "„Das war ein Experiment, über dessen ökonomische Unausgegorenheiten schon in den Neunziger Jahren heftig gestritten wurde.“"
                            },
                            {
                                "example_id": "54491422-0d7c-4dd8-959f-ea268cc6fec9",
                                "sense_id": "0a7e36d4-d10e-3fc9-b648-f9c4534af95f",
                                "text": "„Wohl genau deshalb leidet die Serie unter einer gewissen Unausgegorenheit.“"
                            },
                            {
                                "example_id": "34d2787e-8b29-4dc5-855f-dce363a79f10",
                                "sense_id": "0a7e36d4-d10e-3fc9-b648-f9c4534af95f",
                                "text": "„Nur die Eltern und andere Bezugspersonen, die das Bewusstsein von sich selbst als Kontinuum nicht verinnerlicht haben, merken es nicht oder interpretieren dies als kindliche Unausgegorenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
