{
    "word_family": [
        "bummer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f028fad6-6e9e-3834-83e9-79aeabcf56e5",
                    "sense_definition": "The part of the body on which a person sits; the buttocks.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler slipped and landed right on his <w>bum</w>.",
                            "target_lang_translations": {
                                "ru": "Малыш поскользнулся и приземлился прямо на <w>попу</w>.",
                                "zh": "那个蹒跚学步的孩子滑倒了，正好坐在了他的<w>屁股</w>上。"
                            }
                        },
                        {
                            "text": "She told the children to sit on their <w>bums</w> and listen to the story.",
                            "target_lang_translations": {
                                "ru": "Она велела детям сесть на <w>попы</w> и слушать сказку.",
                                "zh": "她让孩子们<w>屁股</w>坐在地上，听她讲故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bottom",
                        "backside",
                        "behind",
                        "butt"
                    ],
                    "common_phrases": [
                        "sit on one's bum",
                        "kick up the bum"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть тела, на которой человек сидит; ягодицы.",
                        "zh": "身体坐着的部分；臀部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попа",
                                "target_lang_sense_clarification": "разговорное, мягкое, часто используется детьми"
                            },
                            {
                                "target_lang_word": "задница",
                                "target_lang_sense_clarification": "разговорное, более грубое"
                            },
                            {
                                "target_lang_word": "зад",
                                "target_lang_sense_clarification": "разговорное, нейтральное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屁股",
                                "target_lang_sense_clarification": "口语，指臀部"
                            },
                            {
                                "target_lang_word": "臀部",
                                "target_lang_sense_clarification": "较正式的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b7072df-69ed-3399-91b4-1d46c134b0c2",
                    "sense_definition": "A homeless person who has no permanent residence or job.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bum</w> on the corner asked us for some spare change.",
                            "target_lang_translations": {
                                "ru": "<w>Бомж</w> на углу попросил у нас немного мелочи.",
                                "zh": "街角的那个<w>流浪汉</w>向我们要零钱。"
                            }
                        },
                        {
                            "text": "He lived like a <w>bum</w> on the streets for several years.",
                            "target_lang_translations": {
                                "ru": "Он жил как <w>бомж</w> на улице несколько лет.",
                                "zh": "他在街头像个<w>流浪汉</w>一样生活了好几年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tramp",
                        "hobo",
                        "vagrant",
                        "drifter",
                        "beggar"
                    ],
                    "common_phrases": [
                        "street bum"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бездомный человек, не имеющий постоянного места жительства или работы.",
                        "zh": "没有固定住所或工作的流浪者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бомж",
                                "target_lang_sense_clarification": "разговорное, аббревиатура от 'Без Определенного Места Жительства'"
                            },
                            {
                                "target_lang_word": "бродяга",
                                "target_lang_sense_clarification": "человек, скитающийся без дома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流浪汉",
                                "target_lang_sense_clarification": "指无家可归的人"
                            },
                            {
                                "target_lang_word": "乞丐",
                                "target_lang_sense_clarification": "指以乞讨为生的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91a2e8e9-6aaa-34e8-8ce9-cf0023eb30e8",
                    "sense_definition": "A lazy or incompetent person who avoids work.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get a job and stop being such a <w>bum</w>.",
                            "target_lang_translations": {
                                "ru": "Найди работу и перестань быть таким <w>бездельником</w>.",
                                "zh": "去找份工作，别再当个<w>懒汉</w>了。"
                            }
                        },
                        {
                            "text": "My brother is a bit of a <w>bum</w> who sleeps until noon every day.",
                            "target_lang_translations": {
                                "ru": "Мой брат немного <w>лодырь</w>, он спит до полудня каждый день.",
                                "zh": "我弟弟有点<w>游手好闲</w>，每天都要睡到中午。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loafer",
                        "idler",
                        "slacker",
                        "deadbeat"
                    ],
                    "common_phrases": [
                        "lazy bum"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ленивый или некомпетентный человек, избегающий работы.",
                        "zh": "懒惰、无能或逃避工作的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездельник",
                                "target_lang_sense_clarification": "тот, кто ничего не делает"
                            },
                            {
                                "target_lang_word": "лодырь",
                                "target_lang_sense_clarification": "ленивый человек"
                            },
                            {
                                "target_lang_word": "тунеядец",
                                "target_lang_sense_clarification": "человек, живущий за чужой счет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "懒汉",
                                "target_lang_sense_clarification": "指懒惰的人"
                            },
                            {
                                "target_lang_word": "游手好闲的人",
                                "target_lang_sense_clarification": "指不务正业的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb0d70e8-65e9-38c2-b3b1-32c1cd202833",
                    "sense_definition": "To ask someone to give something for free.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_obtain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always tries to <w>bum</w> a cigarette from strangers outside the bar.",
                            "target_lang_translations": {
                                "ru": "Он всегда пытается <w>стрельнуть</w> сигарету у незнакомцев возле бара.",
                                "zh": "他总是试图在酒吧外向陌生人<w>讨要</w>香烟。"
                            }
                        },
                        {
                            "text": "I need to <w>bum</w> a ride to the station if you are going that way.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>попросить</w> подвезти меня до станции, если вам по пути.",
                                "zh": "如果你顺路的话，我能<w>蹭</w>你的车去车站吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "cadge",
                        "scrounge",
                        "mooch"
                    ],
                    "common_phrases": [
                        "bum a ride",
                        "bum a cigarette"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Просить кого-то дать что-то бесплатно.",
                        "zh": "向别人索要免费的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрелять",
                                "target_lang_sense_clarification": "слэнг, обычно о сигаретах или мелочи"
                            },
                            {
                                "target_lang_word": "клянчить",
                                "target_lang_sense_clarification": "назойливо выпрашивать"
                            },
                            {
                                "target_lang_word": "попрошайничать",
                                "target_lang_sense_clarification": "просить милостыню или подачки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "讨要",
                                "target_lang_sense_clarification": "指索取"
                            },
                            {
                                "target_lang_word": "蹭",
                                "target_lang_sense_clarification": "口语，指占小便宜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dd3ba3c-c164-3284-9269-2842fa9f01a1",
                    "sense_definition": "To make someone feel unhappy, disappointed, or depressed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad news really <w>bummed</w> him out for the rest of the day.",
                            "target_lang_translations": {
                                "ru": "Плохие новости реально <w>расстроили</w> его на весь остаток дня.",
                                "zh": "那个坏消息让他一整天都感到很<w>扫兴</w>。"
                            }
                        },
                        {
                            "text": "It <w>bums</w> me out when it rains on the weekend.",
                            "target_lang_translations": {
                                "ru": "Меня <w>огорчает</w>, когда в выходные идет дождь.",
                                "zh": "周末下雨真让我<w>扫兴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "depress",
                        "sadden",
                        "dishearten"
                    ],
                    "antonyms": [
                        "cheer up"
                    ],
                    "common_phrases": [
                        "bum out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-то чувствовать себя несчастным, разочарованным или подавленным.",
                        "zh": "使人感到不快、失望或沮丧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "вызывать грусть или огорчение"
                            },
                            {
                                "target_lang_word": "огорчать",
                                "target_lang_sense_clarification": "причинять горесть"
                            },
                            {
                                "target_lang_word": "обламывать",
                                "target_lang_sense_clarification": "слэнг, портить настроение или планы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……扫兴",
                                "target_lang_sense_clarification": "指破坏兴致"
                            },
                            {
                                "target_lang_word": "使……沮丧",
                                "target_lang_sense_clarification": "指令人心情低落"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1af7cf9a-d913-3639-b52c-4a2164b5d68d",
                    "sense_definition": "To spend time doing nothing or wandering without a specific purpose.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_idle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to just <w>bum</w> around the city center until the movie started.",
                            "target_lang_translations": {
                                "ru": "Мы решили просто <w>поболтаться</w> по центру города, пока не начнется фильм.",
                                "zh": "我们决定在电影开始前先在市中心<w>闲逛</w>。"
                            }
                        },
                        {
                            "text": "He plans to <w>bum</w> around Europe for the summer before starting college.",
                            "target_lang_translations": {
                                "ru": "Он планирует <w>послоняться</w> по Европе летом перед началом колледжа.",
                                "zh": "他打算在大学开学前去欧洲<w>游荡</w>一个夏天。"
                            }
                        }
