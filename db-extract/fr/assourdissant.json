                                    {
                                        "sense_id": "c93efa78-9150-3f30-92f8-b4f098af8885",
                                        "entry_id": "07095c1d-75b0-347d-a216-be33ae8bf3bd",
                                        "glosses": [
                                            "The process by which something is deafened."
                                        ],
