                        "examples": [
                            {
                                "example_id": "b857b854-a954-4588-a921-ab2f2de282d0",
                                "sense_id": "bf2dc5d8-82e0-354c-bf5b-e5b28fe00625",
                                "text": "Ce ne sera pas une petite moricaude qui l’arrêtera.\n— Mais cette petite moricaude n’est peut-être pas aussi horrible que vous l’imaginez.\n— Une Hindoue."
                            },
                            {
                                "example_id": "a25f7540-749a-4b9e-8440-9f3cfa0b489d",
                                "sense_id": "bf2dc5d8-82e0-354c-bf5b-e5b28fe00625",
                                "text": "Elle déclara à tante El que ça vous retournait les sans de voir une moricaude se prélasser à la vue de tous sur le perron de devant de la maison."
                            }
                        ]
                    }
