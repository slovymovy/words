                        "entry_id": "ed0024b0-515a-3c54-a7c6-58905b9d6708",
                        "glosses": [
                            "A word formed by onomatopoeia."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "adc74814-3589-41d6-81e8-27fc93eb72c5",
                                "sense_id": "73b90ba2-2d40-3744-8bbf-bd73fb9471d9",
                                "text": "To slump; to slip, or fall plum down into any dirty, or wet place. It seems to he a word made per onomatopoeian from the sound."
                            },
                            {
                                "example_id": "f756b06d-5623-4d42-87b7-c520068c3e28",
                                "sense_id": "73b90ba2-2d40-3744-8bbf-bd73fb9471d9",
                                "text": "We have already alluded to the root \"ach,\" as having been in all probability an onomatopœian which gives rise, to a large number of cognate words in the Indo-European languages."
                            }
                        ]
                    }
