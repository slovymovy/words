                                                "sense_id": "63491858-3f24-3421-ba8c-c0d73abddaac",
                                                "text": "In this recipe, the flour and sugar are in fifty-fifty proportions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97660f12-12e6-373e-853d-2674d6f5f51a",
