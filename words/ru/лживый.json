{
    "word_family": [
        "ложь",
        "лгать",
        "лживость",
        "лживо",
        "солгать",
        "облгать"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "41874f3b-4013-31ac-95b4-0a54331b4233",
                    "sense_definition": "Склонный ко лжи, часто говорящий неправду и обманывающий других (о человеке, его характере).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "character_trait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все знали, что он <w>лживый</w> человек, поэтому никто не верил его обещаниям.",
                            "target_lang_translations": {
                                "de": "Jeder wusste, dass er ein <w>verlogener</w> Mensch war, deshalb glaubte niemand seinen Versprechungen.",
                                "en": "Everyone knew he was a <w>lying</w> person, so no one believed his promises."
                            }
                        },
                        {
                            "text": "Этот <w>лживый</w> политик обещал снизить налоги, но сделал всё наоборот.",
                            "target_lang_translations": {
                                "de": "Dieser <w>verlogene</w> Politiker versprach, die Steuern zu senken, tat aber genau das Gegenteil.",
                                "en": "This <w>deceitful</w> politician promised to lower taxes, but did the exact opposite."
                            }
                        }
                    ],
                    "synonyms": [
                        "неи́скренний"
                    ],
                    "antonyms": [
                        "честный",
                        "искренний",
                        "правдивый"
                    ],
                    "common_phrases": [
                        "лживый человек",
                        "лживый характер"
                    ],
                    "target_lang_definitions": {
                        "de": "Dazu neigend zu lügen, oft die Unwahrheit sagend und andere täuschend (über eine Person oder deren Charakter).",
                        "en": "Prone to lying, frequently telling untruths and deceiving others (referring to a person or their character)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verlogen",
                                "target_lang_sense_clarification": "charakterlich unehrlich, oft lügend"
                            },
                            {
                                "target_lang_word": "lügnerisch",
                                "target_lang_sense_clarification": "den Hang zu lügen besitzend"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lying",
                                "target_lang_sense_clarification": "tending to tell lies, untruthful"
                            },
                            {
                                "target_lang_word": "deceitful",
                                "target_lang_sense_clarification": "deliberately misleading or cheating"
                            },
                            {
                                "target_lang_word": "mendacious",
                                "target_lang_sense_clarification": "untruthful or dishonest (formal)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19c72b2e-a1ae-3a62-beb4-d00405760a8e",
                    "sense_definition": "Содержащий ложь, неправду, намеренно вводящий в заблуждение или неискренний.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "falsehood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Суд быстро доказал, что его показания были абсолютно <w>лживыми</w>.",
                            "target_lang_translations": {
                                "de": "Das Gericht bewies schnell, dass seine Aussagen absolut <w>lügenhaft</w> waren.",
                                "en": "The court quickly proved that his testimony was absolutely <w>false</w>."
                            }
                        },
                        {
                            "text": "Она сразу распознала его <w>лживую</w> улыбку и решила прекратить разговор.",
                            "target_lang_translations": {
                                "de": "Sie erkannte sofort sein <w>verlogenes</w> Lächeln und beschloss, das Gespräch zu beenden.",
                                "en": "She immediately recognized his <w>deceitful</w> smile and decided to end the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "фальшивый",
                        "обманчивый"
                    ],
                    "antonyms": [
                        "правдивый",
                        "искренний"
                    ],
                    "common_phrases": [
                        "лживые обещания",
                        "лживые слова"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Lüge oder Unwahrheit enthaltend, absichtlich irreführend oder unaufrichtig.",
                        "en": "Containing lies, untruths, intentionally misleading, or insincere."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verlogen",
                                "target_lang_sense_clarification": "unwahr, unaufrichtig (z. B. Lächeln, Versprechen)"
                            },
                            {
                                "target_lang_word": "lügenhaft",
                                "target_lang_sense_clarification": "auf Lügen beruhend, unwahr (z. B. Aussagen)"
                            },
                            {
                                "target_lang_word": "lügnerisch",
                                "target_lang_sense_clarification": "eine Lüge enthaltend"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "false",
                                "target_lang_sense_clarification": "untrue, not factual"
                            },
                            {
                                "target_lang_word": "deceitful",
                                "target_lang_sense_clarification": "misleading or deceptive"
                            },
                            {
                                "target_lang_word": "mendacious",
                                "target_lang_sense_clarification": "false or untrue (formal)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}