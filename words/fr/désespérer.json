    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5daedb7b-455a-3022-b4da-d906bdb29d64",
                    "sense_definition": "Perdre tout espoir, ne plus croire à la réalisation de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perdre_espoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les nombreuses difficultés, nous refusons de <w>désespérer</w> face à cette situation complexe."
                        },
                        {
                            "text": "Après des semaines de recherches infructueuses, l'équipe commence à <w>désespérer</w> de retrouver le randonneur."
                        }
                    ],
                    "synonyms": [
                        "baisser les bras"
                    ],
                    "antonyms": [
                        "espérer"
                    ],
                    "common_phrases": [
                        "ne pas désespérer",
                        "désespérer de réussir"
                    ]
                },
                {
                    "sense_id": "daf38cd0-4b01-36e3-bac4-5f108e739038",
                    "sense_definition": "Plonger quelqu'un dans le désespoir ou susciter chez lui une vive déception.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "causer_desespoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son manque total d'efforts finit par <w>désespérer</w> ses professeurs qui voulaient pourtant l'aider."
                        },
                        {
                            "text": "Cette nouvelle me <w>désespère</w> profondément et m'empêche d'envisager sereinement notre avenir commun."
                        }
                    ],
                    "synonyms": [
                        "affliger",
                        "décourager",
                        "démoraliser"
                    ],
                    "antonyms": [
                        "encourager",
                        "rassurer",
                        "réconforter"
                    ]
                },
                {
                    "sense_id": "ff974595-91e5-3b47-b97e-8c9790fcd4af",
                    "sense_definition": "S'abandonner au désespoir en manifestant une grande affliction ou une vive agitation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perdre_espoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle se <w>désespère</w> en constatant les dégâts causés par la tempête dans son jardin."
                        },
                        {
                            "text": "Ne vous <w>désespérez</w> pas trop vite, nous finirons bien par trouver une solution satisfaisante."
                        }
                    ],
                    "synonyms": [
                        "se lamenter",
                        "se désoler"
                    ],
                    "antonyms": [
                        "se réjouir"
                    ]
                },
                {
                    "sense_id": "ab5285a7-56e8-3e43-a51d-1b047e858647",
                    "sense_definition": "Juger l'état de santé, le comportement ou l'avenir d'une personne irrémédiablement compromis.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "perdre_espoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré la gravité de ses blessures, les médecins ne <w>désespèrent</w> pas encore du jeune motard."
                        },
                        {
                            "text": "Ses parents ont fini par <w>désespérer</w> de ce fils rebelle qui refusait tout dialogue."
                        }
                    ],
                    "common_phrases": [
                        "désespérer d'un malade"
                    ]
                }
            ]
        }
    ]
