        "fr-extract.jsonl": [
            {
                "entry_id": "0793a280-5828-3bf0-b400-b423019ea400",
                "word": "Belgrade",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8a99058-1d7c-3507-93bb-3c82a39f9c2f",
                        "entry_id": "0793a280-5828-3bf0-b400-b423019ea400",
                        "glosses": [
                            "Ville et capitale de la république de Serbie, et anciennement capitale de la Yougoslavie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b096961-c8a9-4602-8ef0-5378e345d2d0",
                                "sense_id": "d8a99058-1d7c-3507-93bb-3c82a39f9c2f",
                                "text": "J'étais à Belgrade du 2 au 4 octobre 1914. A cette date, les Autrichiens avaient bombardé la ville pendant trente-six jours et autant de nuits."
                            },
                            {
                                "example_id": "99e96539-85e2-41cf-92e8-e6570079adbb",
                                "sense_id": "d8a99058-1d7c-3507-93bb-3c82a39f9c2f",
                                "text": "En 1955, nous étions sous le choc de la “réconciliation” soviéto-yougoslave. Sans crier gare, la troïka moscovite avait débarqué à Belgrade pour se jeter dans les bras de Tito et le couvrir de fleurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae1799ef-7b84-326b-ae05-39314cede465",
                        "entry_id": "0793a280-5828-3bf0-b400-b423019ea400",
                        "glosses": [
                            "Gouvernement serbe."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1702f86a-68fa-4c8d-81af-48c1fe61e2ad",
                        "source_entry_id": "0793a280-5828-3bf0-b400-b423019ea400",
                        "target_lang_word": "Belgrad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belgrad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b46e7567-3e92-358c-b227-fbcc590cba5a",
                                        "entry_id": "b5ef9464-1c01-328e-b549-f0fd159f5159",
                                        "glosses": [
                                            "Hauptstadt von Serbien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f50707ca-093d-4f69-a458-5ad2dfeec4d9",
                                                "sense_id": "b46e7567-3e92-358c-b227-fbcc590cba5a",
                                                "text": "Serbiens Hauptstadt Belgrad, von der Geschichte immer wieder gebeutelt, ist heute die Kultur- und Partyhauptstadt Südosteuropas."
                                            },
                                            {
                                                "example_id": "b8684321-bdf0-4d2d-84c7-d80cd30d9640",
                                                "sense_id": "b46e7567-3e92-358c-b227-fbcc590cba5a",
                                                "text": "Meine letzten Sommerferien verbrachte ich in Belgrad."
                                            },
                                            {
                                                "example_id": "d9bd9ea1-f5c4-42c5-8377-70048699a13d",
                                                "sense_id": "b46e7567-3e92-358c-b227-fbcc590cba5a",
                                                "text": "Die Organisation, die Bewegung der Blockfreien Staaten, konstituierte sich 1961 auf ihrer ersten Sitzung in Belgrad."
                                            },
                                            {
                                                "example_id": "1b77c11e-5cc6-4588-b801-5afb85668635",
                                                "sense_id": "b46e7567-3e92-358c-b227-fbcc590cba5a",
                                                "text": "Belgrad war die Hauptstadt Jugoslawiens."
                                            },
                                            {
                                                "example_id": "2698a9eb-2b34-470c-956d-651d066cf344",
                                                "sense_id": "b46e7567-3e92-358c-b227-fbcc590cba5a",
                                                "text": "„Sie war noch nie in Belgrad gewesen, und sie wollte die Kriegsanstrengungen unterstützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5263c254-4bd9-41b6-8e1f-345f3ad006b4",
