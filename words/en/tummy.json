                    "sense_definition": "A protruding belly or paunch.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stomach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He patted his round <w>tummy</w> contentedly after finishing the large holiday feast.",
                            "target_lang_translations": {
                                "ru": "Он удовлетворенно похлопал себя по круглому <w>животу</w> после окончания обильного праздничного застолья."
