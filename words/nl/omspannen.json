            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88875110-53a3-304a-baa8-58c6176a0725",
                    "sense_definition": "Het geheel omsluiten of omvatten met de handen, een draad of een ander voorwerp",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omvatten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met zijn lange vingers kon hij de stam van de boom gemakkelijk <w>omspannen</w>.",
                            "target_lang_translations": {
                                "fr": "Avec ses longs doigts, il pouvait facilement <w>entourer</w> le tronc de l'arbre."
                            }
                        },
                        {
                            "text": "De kunstenaar wilde een boom <w>omspannen</w> met een gekleurde draad voor zijn project.",
                            "target_lang_translations": {
                                "fr": "L'artiste voulait <w>entourer</w> un arbre avec un fil coloré pour son projet."
                            }
                        }
                    ],
                    "synonyms": [
                        "omvatten",
                        "omsluiten"
                    ],
                    "common_phrases": [
                        "een boom omspannen",
                        "met handen omspannen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Entourer ou englober entièrement avec les mains, un fil ou un autre objet"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "entourer",
                                "target_lang_sense_clarification": "mettre quelque chose autour"
                            },
                            {
                                "target_lang_word": "englober",
                                "target_lang_sense_clarification": "contenir entièrement"
                            },
                            {
                                "target_lang_word": "encercler",
                                "target_lang_sense_clarification": "entourer complètement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8af1ef1-760d-3555-8d65-08f5b743cc77",
                    "sense_definition": "Trekdieren losmaken om andere dieren voor een voertuig te spannen, of op een andere manier inspannen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dieren_inspannen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het koetsstation moesten de koetsiers snel de paarden <w>omspannen</w> voor de lange reis.",
                            "target_lang_translations": {
                                "fr": "À la station de diligences, les cochers devaient rapidement <w>changer d'attelage</w> pour le long voyage."
                            }
                        },
                        {
                            "text": "Nadat de paarden moe waren geworden, besloot de boer het vers te <w>omspannen</w>.",
                            "target_lang_translations": {
                                "fr": "Après que les chevaux furent fatigués, le fermier décida de les <w>réatteler</w> à neuf."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paarden omspannen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Dételer des animaux de trait pour en atteler d'autres à un véhicule"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "changer d'attelage",
                                "target_lang_sense_clarification": "remplacer les animaux attelés"
                            },
                            {
                                "target_lang_word": "réatteler",
                                "target_lang_sense_clarification": "atteler d'autres animaux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac11a5ab-ce89-3507-b422-aa0188bae198",
                    "sense_definition": "Voltooid deelwoord van <w>omspannen</w>",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De paarden zijn door de koetsier bij het station <w>omgespannen</w>.",
                            "target_lang_translations": {
                                "fr": "Les chevaux ont été <w>réattelés</w> par le cocher à la station."
                            }
                        },
                        {
                            "text": "De boomstam werd met een stevig touw <w>omspannen</w> om verdere schade te voorkomen.",
                            "target_lang_translations": {
                                "fr": "Le tronc d'arbre a été <w>entouré</w> d'une corde solide pour éviter d'autres dommages."
                            }
                        }
                    ],
