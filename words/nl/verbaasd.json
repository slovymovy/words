                {
                    "sense_id": "7b287269-4000-3c12-9bbd-9c84a0d2e098",
                    "sense_definition": "het gevoel hebbend dat iets onverwacht of vreemd is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verwondering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De toeristen keken erg <w>verbaasd</w> naar de vreemde kleding van de lokale bevolking.",
                            "target_lang_translations": {
                                "en": "The tourists looked very <w>surprised</w> at the strange clothing of the local population.",
                                "ru": "Туристы с большим <w>удивлением</w> смотрели на странную одежду местных жителей."
                            }
                        },
                        {
                            "text": "Hij was een beetje <w>verbaasd</w> over het plotselinge bezoek van zijn oude vriend.",
                            "target_lang_translations": {
                                "en": "He was a bit <w>surprised</w> by the sudden visit from his old friend.",
                                "ru": "Он был немного <w>удивлён</w> внезапному визиту своего старого друга."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwonderd",
                        "verrast",
                        "versteld"
                    ],
                    "antonyms": [
                        "onverschillig"
                    ],
                    "common_phrases": [
                        "een beetje verbaasd",
                        "verbaasd over"
                    ],
                    "target_lang_definitions": {
                        "en": "having the feeling that something is unexpected or strange",
                        "ru": "чувство, возникающее, когда что-то кажется неожиданным или странным"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surprised",
                                "target_lang_sense_clarification": "feeling or showing surprise"
                            },
                            {
