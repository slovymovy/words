        "fr-extract.jsonl": [
            {
                "entry_id": "6f8ba6c6-1b1e-3870-b160-f2bd0c68d977",
                "word": "xylophone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8b0e93b3-692b-45aa-b5d0-2b000040f0d7",
                        "entry_id": "6f8ba6c6-1b1e-3870-b160-f2bd0c68d977",
                        "tags": [
                            "plural"
                        ],
                        "form": "xylophones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3a5d5e3-f119-3107-9bde-db6cb6cc5227",
                        "entry_id": "6f8ba6c6-1b1e-3870-b160-f2bd0c68d977",
                        "glosses": [
                            "Instrument de musique à percussion composé de lamelles de tailles et d’épaisseurs variables qui forment un clavier sur lequel on frappe avec une mailloche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b98a58b-d84f-45d0-ab57-3a2d785cb3ec",
                                "sense_id": "f3a5d5e3-f119-3107-9bde-db6cb6cc5227",
                                "text": "Bruno tentait d’utiliser ses contacts à l’hôpital où il travaillait pour lui obtenir un rendez-vous avec un psychiatre, mais c’était comme d’essayer de trouver un chien qui jouerait du xylophone."
                            },
                            {
                                "example_id": "7c8ecaed-a632-4271-b3b2-9994d0635cdd",
                                "sense_id": "f3a5d5e3-f119-3107-9bde-db6cb6cc5227",
                                "text": "La dernière fois, on a eu un compositeur de musique électronique qu est venu louer un balafon [une sorte de xylophone] pour enregistrer un sample."
                            },
                            {
                                "example_id": "ef17db08-9bce-48b2-97f3-3c8cd010e7c3",
                                "sense_id": "f3a5d5e3-f119-3107-9bde-db6cb6cc5227",
                                "text": "Puis une seconde porte, celle de ma salle de bains — une porte en bois mince, chantante comme une lame de xylophone — fut fermée plus doucement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "369ef201-c8b1-4f9d-8612-45adfabbc63a",
                        "source_entry_id": "6f8ba6c6-1b1e-3870-b160-f2bd0c68d977",
                        "source_sense_id": "f3a5d5e3-f119-3107-9bde-db6cb6cc5227",
                        "target_lang_word": "Xylophon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xylophon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c83924f-0ba9-3859-bf22-fb00afdfd879",
                                        "entry_id": "a6e0883a-c7e3-3855-8cc8-26400bfaf0fd",
                                        "glosses": [
                                            "Schlaginstrument mit auf einem Klangrahmen befestigten Holzstäben"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c20a085e-8d9d-44f0-9e5b-b621c22bef04",
                                                "sense_id": "2c83924f-0ba9-3859-bf22-fb00afdfd879",
                                                "text": "In Orffs „Carmina Burana“ spielt das Xylophon eine wichtige Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "017c3295-28fa-4d9f-b8bd-bcb5ed34c54c",
                        "source_entry_id": "6f8ba6c6-1b1e-3870-b160-f2bd0c68d977",
                        "source_sense_id": "f3a5d5e3-f119-3107-9bde-db6cb6cc5227",
                        "target_lang_word": "xylophone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xylophone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "586255ca-c9cc-3131-8781-c95d503cf4fd",
                                        "entry_id": "8ad14f29-fb8c-3ebb-b9b1-f19a29153be7",
                                        "glosses": [
                                            "Any musical instrument (percussion idiophone) made of wooden slats graduated so as to make the sounds of the scale when struck with a small drumstick-like mallet; the standard Western concert xylophone or one of its derivatives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b73f0f7-f3cc-4be5-8084-2ba257d7202b",
                                                "sense_id": "586255ca-c9cc-3131-8781-c95d503cf4fd",
                                                "text": "All I know how to play on my xylophone is \"Mary Had a Little Lamb\". Would you like to hear it?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "xylophone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1881f521-ca29-3cf7-b0df-58690ddd796b",
                                        "entry_id": "17e8d764-b9fd-3a94-9bfe-93f5bc80c7e8",
                                        "glosses": [
                                            "To play a xylophone or to play something else as though it was a xylophone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                        "entry_id": "17e8d764-b9fd-3a94-9bfe-93f5bc80c7e8",
                                        "glosses": [
                                            "To move above a ridged surface or series of surfaces so as to hit every ridge, in a manner similar to playing quickly and sequentially on a xylophone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbd61f08-7ac3-4db5-8250-00c0073f2b49",
                                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                                "text": "my eager fingers xylophoning over the memories"
                                            },
                                            {
                                                "example_id": "9cac74ea-71ec-4941-acf6-bd4bc80f3fce",
                                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                                "text": "Like a cat, I arch into the back of the bench, my spine xylophoning along the slats while the tension of the day slowly drains out of me. I'm totally chill and mellow."
                                            },
                                            {
                                                "example_id": "bd58b1e8-42b4-4329-9fe1-4dc4af2ff9ad",
                                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                                "text": "The others waged active war, claws xylophoning across Jack's pinwheeling swords."
                                            },
                                            {
                                                "example_id": "bede3f35-4c7b-4670-9214-68b626c117be",
                                                "sense_id": "401d1ee5-d500-3fcb-9ab4-7932952eb8f2",
                                                "text": "His right hand, the good one, found one of Glass's ankles, pulled. Glass fell, her ulna, clavicle, pevis, and kneecap xylophoning along stair edges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
