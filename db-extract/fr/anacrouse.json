                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6133400c-00f6-4fc2-bd1a-24456b85121b",
                                "sense_id": "e086ad1c-afaf-3d96-9c18-4c8a7184691b",
                                "text": "Les trois premières notes de la Marseillaise forment une anacrouse."
                            },
                            {
                                "example_id": "7f1a1f90-9d0f-47b9-b343-d05fcd92fb63",
                                "sense_id": "e086ad1c-afaf-3d96-9c18-4c8a7184691b",
                                "text": "Il n’est pas dit un seul mot de l’anacrouse; cette expression ne paraît jamais dans les textes des anciens."
                            }
                        ]
                    },
                    {
                        "sense_id": "f05e3800-fdd7-3f9c-8de0-af894231efd1",
