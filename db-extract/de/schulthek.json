                "senses": [
                    {
                        "sense_id": "0e6ce756-9f34-38fd-9e26-d74943c3f168",
                        "entry_id": "2fc1bacb-ddaf-3442-91a4-6c814b5d89f8",
                        "glosses": [
                            "Rucksack, den Schüler verwenden, um ihre Schulmaterialien zu transportieren"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "3067e232-7c5d-409e-8443-9981a2961c99",
                                "sense_id": "0e6ce756-9f34-38fd-9e26-d74943c3f168",
                                "text": "„Katrin, Erstklässlerin und passionisierte Frühaufsteherin, kontrolliert zum xtenmal den Inhalt ihres Schultheks und fragt […] ob sie nun nicht endlich gehen könne.“"
                            },
                            {
                                "example_id": "acee25e1-fcc1-4b15-90c1-92336df59281",
                                "sense_id": "0e6ce756-9f34-38fd-9e26-d74943c3f168",
                                "text": "„Daheim in Wilen TG steht ihr Schulthek parat.“"
                            },
                            {
                                "example_id": "3525eac2-44a1-4783-8b42-37972c9fc8cf",
                                "sense_id": "0e6ce756-9f34-38fd-9e26-d74943c3f168",
                                "text": "„Der Schulthek bleibt zu Hause, das Geplauder und Getuschel geht um ganz andere Dinger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
