                        "sense_id": "61a82775-e076-3f04-9788-2d48a83decbd",
                        "entry_id": "35647f34-fdb8-3fb2-a9ce-a9481d42d78d",
                        "glosses": [
                            "Feces."
                        ],
                        "tags": [
                            "US",
                            "countable",
