{
    "word_family": [
        "participant",
        "participation",
        "participatory",
        "participative",
        "participator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7353f689-9a0b-3b6d-8b1c-f662fbec2de4",
                    "sense_definition": "To take part, join in, or become involved in an activity or event.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All students are encouraged to <w>participate</w> in the school sports day.",
                            "target_lang_translations": {
                                "ru": "Всех студентов призывают <w>участвовать</w> в школьном спортивном дне.",
                                "zh": "鼓励所有学生<w>参加</w>学校运动会。"
                            }
                        },
                        {
                            "text": "She decided to <w>participate</w> actively in the group discussion.",
                            "target_lang_translations": {
                                "ru": "Она решила активно <w>участвовать</w> в групповом обсуждении.",
                                "zh": "她决定积极<w>参与</w>小组讨论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "take part",
                        "join in",
                        "engage",
                        "be involved",
                        "contribute"
                    ],
                    "antonyms": [
                        "abstain",
                        "withdraw",
                        "sit out"
                    ],
                    "common_phrases": [
                        "participate in",
                        "participate actively",
                        "participate fully",
                        "decline to participate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать участие, присоединяться или вовлекаться в деятельность или событие.",
                        "zh": "参加、加入或投身于某项活动或事件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участвовать",
                                "target_lang_sense_clarification": "принимать участие в чём-либо, быть участником"
                            },
                            {
                                "target_lang_word": "принимать участие",
                                "target_lang_sense_clarification": "становиться участником события или деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "参加",
                                "target_lang_sense_clarification": "加入某种活动或组织"
                            },
                            {
                                "target_lang_word": "参与",
                                "target_lang_sense_clarification": "投身于某事并发挥作用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8d3d688-e915-3759-99bb-7b20e3bac32d",
                    "sense_definition": "To share or partake of something directly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The close friends <w>participate</w> each other's joys and sorrows.",
                            "target_lang_translations": {
                                "ru": "Близкие друзья <w>разделяют</w> радости и горести друг друга.",
                                "zh": "挚友们共同<w>分享</w>彼此的喜悦与忧愁。"
                            }
                        },
                        {
                            "text": "He wished to <w>participate</w> the secrets of the council.",
                            "target_lang_translations": {
                                "ru": "Он желал <w>разделить</w> тайны совета.",
                                "zh": "他希望能够<w>分享</w>委员会的秘密。"
                            }
                        }
                    ],
                    "synonyms": [
                        "share",
                        "partake"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Transitive usage is obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять что-либо с кем-то или иметь долю в чём-то.",
                        "zh": "与他人共同分享或拥有某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделять",
                                "target_lang_sense_clarification": "совместно испытывать чувства или владеть чем-то"
                            },
                            {
                                "target_lang_word": "иметь долю",
                                "target_lang_sense_clarification": "владеть частью чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分享",
                                "target_lang_sense_clarification": "共同拥有或体验某种情感或事物"
                            },
                            {
                                "target_lang_word": "分担",
                                "target_lang_sense_clarification": "共同承担某种责任或苦难"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4780f651-7ec4-3714-960e-69303fae4435",
                    "sense_definition": "Acting in common or possessing a shared nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>participate</w> citizens worked together for the common good.",
                            "target_lang_translations": {
                                "ru": "<w>Действующие сообща</w> граждане работали вместе ради общего блага.",
                                "zh": "这些<w>共同</w>行动的公民为了公共利益而齐心协力。"
                            }
                        },
                        {
                            "text": "They formed a <w>participate</w> alliance to defend their lands.",
                            "target_lang_translations": {
                                "ru": "Они сформировали <w>совместный</w> альянс для защиты своих земель.",
                                "zh": "他们组建了一个<w>联合</w>联盟来保卫他们的土地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "joint",
                        "shared"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This adjective form is obsolete."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действующий сообща или имеющий общую природу.",
                        "zh": "共同行动或具有共享的性质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совместный",
                                "target_lang_sense_clarification": "осуществляемый вместе с кем-либо"
                            },
                            {
                                "target_lang_word": "общий",
                                "target_lang_sense_clarification": "касающийся всех, принадлежащий всем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "共同的",
                                "target_lang_sense_clarification": "由多人一起参与或拥有的"
                            },
                            {
                                "target_lang_word": "联合的",
                                "target_lang_sense_clarification": "为了共同目标而结合在一起的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}