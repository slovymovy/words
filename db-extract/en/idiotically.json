                        "source_entry_id": "705b22cf-3937-3201-b92f-1920c9dbe308",
                        "source_sense_id": "b29b576a-4f35-3be9-8a66-4cdd650cd498",
                        "source_sense_description": "in an idiotic manner",
                        "target_lang_word": "idiotement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
