                                "sense_id": "47b49381-d741-3875-83ab-4bc25165169b",
                                "text": "преда́ться гне́ву (страстя́м)",
                                "translation": "滿腔憤怒"
                            },
                            {
                                "example_id": "4ea14627-9d81-4acf-ba31-4b472a8e8891",
                                "sense_id": "47b49381-d741-3875-83ab-4bc25165169b",
                                "text": "преда́ться отча́янию",
                                "translation": "陷入絕望"
