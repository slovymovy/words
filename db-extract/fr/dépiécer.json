                "senses": [
                    {
                        "sense_id": "f703410a-4a30-38d7-9365-78c93fe593a1",
                        "entry_id": "d2fa02f2-766e-3ccc-9fa5-3f0e8c0299ab",
                        "glosses": [
                            "Enlever les pièces"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5cdf2555-678e-364d-af1f-fc4bd03801ca",
                        "entry_id": "d2fa02f2-766e-3ccc-9fa5-3f0e8c0299ab",
                        "glosses": [
                            "Démembrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f5634e6-a413-4d26-a8fa-ea4adbb4a7a4",
                                "sense_id": "5cdf2555-678e-364d-af1f-fc4bd03801ca",
                                "text": "Il y avait une douve gâtée à ce tonneau ; il a fallu le dépiécer."
                            },
                            {
                                "example_id": "9ca4653b-9d9e-48c6-8847-6bf1d93ed5e2",
                                "sense_id": "5cdf2555-678e-364d-af1f-fc4bd03801ca",
                                "text": "… et les intrépides moineaux eux-mêmes, sont continuellement effarouchés par ces oiseaux aux grandes aîles noires, qui passant sur leurs têtes et à côté d'eux avec bruit et rapidité, viennent fondre et s'abattre sur leurs petits nids pour les dépiécer et en emporter les dépouilles dont ils composent eux-mêmes leur habitation nuptiale au sommet des plus hauts arbres."
                            }
                        ]
                    }
