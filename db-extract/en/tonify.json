                                "target_senses": [
                                    {
                                        "sense_id": "20acfe8f-763d-3020-8d8f-71fe7a6f6ca4",
                                        "entry_id": "da622366-bf37-3822-836f-f8262253ff4b",
                                        "glosses": [
                                            "Donner du tonus, de la tonicité, rendre plus vigoureux, plus ferme, plus alerte, plus actif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c974544-5e44-4202-93b3-e0b5f5834f6a",
                                                "sense_id": "20acfe8f-763d-3020-8d8f-71fe7a6f6ca4",
                                                "text": "Cette huile tonifie la peau."
                                            },
                                            {
                                                "example_id": "fa5ad38a-ce82-41f7-93f2-d7aee7096bec",
                                                "sense_id": "20acfe8f-763d-3020-8d8f-71fe7a6f6ca4",
                                                "text": "Et l’estomac lesté, tonifiés par quelques verres de thé bouillant, nous nous sentons prêts pour une nouvelle étape, quelle qu'elle soit."
                                            },
                                            {
                                                "example_id": "40fcfbbb-834c-4648-affc-a802eddaa0fc",
                                                "sense_id": "20acfe8f-763d-3020-8d8f-71fe7a6f6ca4",
                                                "text": "Le vrai c’est que Fleurissoire se sentait ineffablement tonifié par cette lettre […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
