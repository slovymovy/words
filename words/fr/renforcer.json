{
    "word_family": [
        "renfort",
        "renforcement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c195f41-857a-3d32-a5df-4777ba554ab3",
                    "sense_definition": "Rendre un objet, une structure ou un corps plus solide, plus résistant physiquement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "solidification_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers doivent <w>renforcer</w> les fondations de ce bâtiment avant l'arrivée de l'hiver.",
                            "target_lang_translations": {
                                "en": "The workers must <w>strengthen</w> the foundations of this building before winter arrives.",
                                "ru": "Рабочие должны <w>укрепить</w> фундамент этого здания до наступления зимы.",
                                "de": "Die Arbeiter müssen die Fundamente dieses Gebäudes <w>verstärken</w>, bevor der Winter kommt.",
                                "es": "Los obreros deben <w>reforzar</w> los cimientos de este edificio antes de la llegada del invierno.",
                                "zh": "工人们必须在冬天来临之前<w>加固</w>这栋建筑的地基。"
                            }
                        },
                        {
                            "text": "Nous avons décidé de <w>renforcer</w> la porte principale pour décourager les cambrioleurs.",
                            "target_lang_translations": {
                                "en": "We have decided to <w>reinforce</w> the main door to discourage burglars.",
                                "ru": "Мы решили <w>укрепить</w> главную дверь, чтобы отпугнуть взломщиков.",
                                "de": "Wir haben beschlossen, die Haupttür <w>zu verstärken</w>, um Einbrecher abzuschrecken.",
                                "es": "Hemos decidido <w>reforzar</w> la puerta principal para disuadir a los ladrones.",
                                "zh": "我们决定<w>加固</w>正门，以吓退窃贼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "consolider",
                        "fortifier"
                    ],
                    "antonyms": [
                        "affaiblir"
                    ],
                    "common_phrases": [
                        "renforcer les fondations",
                        "renforcer la structure"
                    ],
                    "target_lang_definitions": {
                        "en": "To make an object, structure or body stronger and more physically resistant.",
                        "ru": "Сделать предмет, конструкцию или тело прочнее и физически устойчивее.",
                        "de": "Einen Gegenstand, eine Konstruktion oder einen Körper stabiler und widerstandsfähiger machen.",
                        "es": "Hacer que un objeto, una estructura o un cuerpo sea más sólido y resistente físicamente.",
                        "zh": "使物体、结构或身体更加坚固，更有抵抗力。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strengthen",
                                "target_lang_sense_clarification": "structures, bodies, physical strength"
                            },
                            {
                                "target_lang_word": "reinforce",
                                "target_lang_sense_clarification": "buildings, doors, structures"
                            },
                            {
                                "target_lang_word": "fortify",
                                "target_lang_sense_clarification": "walls, defences, buildings"
                            }
                        ],
                        "ru": [
