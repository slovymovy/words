                                "target_lang_sense_clarification": "To become affected by alcohol or drugs."
                            },
                            {
                                "target_lang_word": "get dazed",
                                "target_lang_sense_clarification": "To become unable to think clearly."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "003b2e9c-8284-320a-be4c-9b5b63880cd3",
