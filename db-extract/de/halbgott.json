                "senses": [
                    {
                        "sense_id": "7c1a293c-19bf-3024-97c8-a10e12453596",
                        "entry_id": "39d801fb-c580-3934-b4af-eee73d3462ab",
                        "glosses": [
                            "demigod"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "ec9fd3d1-8358-46d8-a18b-d2d1b964ba51",
                                "sense_id": "7c1a293c-19bf-3024-97c8-a10e12453596",
                                "text": "Überhaupt aber muß man bei der Vergleichung des leidenden Herkules mit dem leidenden Philoktet nicht vergessen, daß jener ein Halbgott, und dieser nur ein Mensch ist.",
                                "translation": "But generally you must not forget when comparing the suffering Hercules with the suffering Philoctet, that the first one is a demigod and the second one just a man.",
                                "english": "But generally you must not forget when comparing the suffering Hercules with the suffering Philoctet, that the first one is a demigod and the second one just a man."
                            },
                            {
                                "example_id": "f5cd3b24-94e1-465e-8dee-0f7abf6eb8ea",
                                "sense_id": "7c1a293c-19bf-3024-97c8-a10e12453596",
                                "text": "Wem mehr / Als Menschenkraft beschieden ist, der wird / Als Halbgott gleich geboren!",
                                "translation": "He who has been granted more than human strength, is straightaway born as a demigod!",
                                "english": "He who has been granted more than human strength, is straightaway born as a demigod!"
                            }
                        ]
                    },
