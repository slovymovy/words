                        "entry_id": "2cb677cc-9690-34ae-b077-e334841fdcf3",
                        "glosses": [
                            "een stevige band die iemand in een voer- of vliegtuig vasthoudt in zijn zetel ter bescherming tegen onverhoedse bewegingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b4f3533-1b6e-4a11-9641-135f6e4a80cb",
                                "sense_id": "b0c2906c-4b0b-301f-8263-2b2d0005b8c1",
                                "text": "Het dragen van een veiligheidsgordel is verplicht."
                            },
                            {
                                "example_id": "6d314225-a0c9-4787-8998-a887af67741c",
                                "sense_id": "b0c2906c-4b0b-301f-8263-2b2d0005b8c1",
                                "text": "Hoewel de bordjes van de veiligheidsgordel aan waren, besloot een vrouwelijke passagier toch het toilet te gebruiken."
                            }
                        ]
                    }
                ],
