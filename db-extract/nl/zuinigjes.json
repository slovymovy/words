        "nl-extract.jsonl": [
            {
                "entry_id": "491ef3e8-0ab5-33ad-ad85-7f9ebe48a922",
                "word": "zuinigjes",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3b95f0a5-fa5a-349a-818f-b2e86ea07ad8",
                        "entry_id": "491ef3e8-0ab5-33ad-ad85-7f9ebe48a922",
                        "glosses": [
                            "op een spaarzame, duurzame manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f88d4e24-246c-4fbb-a6aa-fa451b263ecd",
                                "sense_id": "3b95f0a5-fa5a-349a-818f-b2e86ea07ad8",
                                "text": "Zijn Hengelose buurten een beetje energiezuinig? In Dalmeden vreten ze stroom, de Nijverheid doet het zuinigjes aan."
                            }
                        ]
                    },
                    {
                        "sense_id": "e05b3956-30a7-3f94-9553-bb1760df7145",
                        "entry_id": "491ef3e8-0ab5-33ad-ad85-7f9ebe48a922",
                        "glosses": [
                            "voorzichtig en niet al te enthousiast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ae28244-1e15-432a-a278-23b8f955236e",
                                "sense_id": "e05b3956-30a7-3f94-9553-bb1760df7145",
                                "text": "VVD-leider Mark Rutte was al meteen zuinigjes over de kansen voor het milieu. Het PBL lijkt een zwaarwegend advies te kunnen geven nu klimaat en duurzaamheid een rol lijken spelen bij de formatie, maar Rutte benadrukte dat er ‘maar een beetje financiële ruimte is’."
                            }
                        ]
                    },
                    {
                        "sense_id": "349bed20-60bc-36d1-a2f1-a144b02ed69c",
                        "entry_id": "491ef3e8-0ab5-33ad-ad85-7f9ebe48a922",
                        "glosses": [
                            "met ingehouden emotie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e63c836b-eae4-4fb0-b80c-797880b55f26",
                                "sense_id": "349bed20-60bc-36d1-a2f1-a144b02ed69c",
                                "text": "Er sneuvelen een spiegel - volgens de overlevering een welgemikte trap van Normaals huisfotograaf Hugo Jaartsveld - en een aantal kleedkamerbordjes. Buiten wordt een portier bijna van de sokken gereden. De dag erop schrijven de kranten dat voor tonnen schade is aangericht. \"130 gulden\", zegt Jolink 40 jaar later zuinigjes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "743c896b-6d13-4c7f-8d3c-f78e9c0f2d42",
                        "source_entry_id": "491ef3e8-0ab5-33ad-ad85-7f9ebe48a922",
                        "source_sense_id": "3b95f0a5-fa5a-349a-818f-b2e86ea07ad8",
                        "target_lang_word": "economical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "economical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9562917-ec47-3819-a573-4257061f46c2",
                                        "entry_id": "2bae23b6-4cb6-3de9-88ae-f6a7ba88ca46",
                                        "glosses": [
                                            "Careful with money so as not to spend too much; prudent; thrifty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849b3b83-868f-4b7f-b214-d3cefc202578",
                                                "sense_id": "d9562917-ec47-3819-a573-4257061f46c2",
                                                "text": "He was an economical person by nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13c655cc-c2ee-3039-bda2-2f9fd4f44799",
                                        "entry_id": "2bae23b6-4cb6-3de9-88ae-f6a7ba88ca46",
                                        "glosses": [
                                            "Saving money or resources."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183ae83a-2ac4-4f23-b75e-1457de4ade91",
                                                "sense_id": "13c655cc-c2ee-3039-bda2-2f9fd4f44799",
                                                "text": "The new, eco-friendly bicycle was an economical purchase."
                                            },
                                            {
                                                "example_id": "150622bf-e5a7-4f9c-890b-4554a0a3b261",
                                                "sense_id": "13c655cc-c2ee-3039-bda2-2f9fd4f44799",
                                                "text": "Regular freight trains between Abergavenny and Merthyr were withdrawn on November 24, 1954, because it was found both practicable and more economical to send this traffic by less severely-graded routes."
                                            },
                                            {
                                                "example_id": "5a9c22ba-98e4-432e-8e4c-bcbd1b41069c",
                                                "sense_id": "13c655cc-c2ee-3039-bda2-2f9fd4f44799",
                                                "text": "The whole [resignalling] scheme has proved more economical than the construction of a new Clyde bridge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d528364f-aace-3776-9b53-728b22b9e31f",
                                        "entry_id": "2bae23b6-4cb6-3de9-88ae-f6a7ba88ca46",
                                        "glosses": [
                                            "Relating to economy in any other sense."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2793e5af-7923-4b35-ab23-687071d3e91c",
                                                "sense_id": "d528364f-aace-3776-9b53-728b22b9e31f",
                                                "text": "In economical science, value and the power of producing value are taken into consideration."
                                            },
                                            {
                                                "example_id": "97b86469-9b2d-4f23-82fd-bfba13d4f173",
                                                "sense_id": "d528364f-aace-3776-9b53-728b22b9e31f",
                                                "text": "By Use, then, in the sense given it by the Say-Hermann school, we have to think of an objective useful element which proceeds from goods, and acquires independent economical existence as well as independent economical value."
                                            },
                                            {
                                                "example_id": "c1edde95-46bd-4128-91c7-675283ae381e",
                                                "sense_id": "d528364f-aace-3776-9b53-728b22b9e31f",
                                                "text": "Doctor in Economical Sciences."
                                            },
                                            {
                                                "example_id": "8d4982b7-c4b6-4c91-b5c0-6f5f82e0ce9d",
                                                "sense_id": "d528364f-aace-3776-9b53-728b22b9e31f",
                                                "text": "Economical function usually has anti-crisis orientation and forms stable economical development of the state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "411508b1-02e3-3682-b329-eda47e68438f",
                                        "entry_id": "2bae23b6-4cb6-3de9-88ae-f6a7ba88ca46",
                                        "glosses": [
                                            "Having a low economy rate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d517de0a-dd3c-4bf2-8885-3666f1c40c2d",
                        "source_entry_id": "491ef3e8-0ab5-33ad-ad85-7f9ebe48a922",
                        "source_sense_id": "3b95f0a5-fa5a-349a-818f-b2e86ea07ad8",
                        "target_lang_word": "thrifty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrifty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83492601-fdf9-3b03-8ae6-19e2f3518b73",
                                        "entry_id": "b0b8ce67-be21-3b43-bdac-d6c832d12b7b",
                                        "glosses": [
                                            "Showing thrift; economical; frugal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed0334b-19bd-4fa0-a43f-44265fed1f5e",
                                                "sense_id": "83492601-fdf9-3b03-8ae6-19e2f3518b73",
                                                "text": "That was a certain trade, while th' age was thrifty, / And men good husbands, look'd into their stocks, / Had their minds bounded; now the public riot / Prostitutes all, scatters away in coaches, / In footmens coats, and waiting womens gowns"
                                            },
                                            {
                                                "example_id": "2dc3e8fd-011d-4657-bab3-c9b96ad3557f",
                                                "sense_id": "83492601-fdf9-3b03-8ae6-19e2f3518b73",
                                                "text": "Nor less disastrous, should his thrifty urn / Neglected leave the once well-water'd land, / To dreary wastes yon paradise would turn, / Polluted ooze, or heaps of barren sand."
                                            },
                                            {
                                                "example_id": "6833e0e6-5a97-4243-b222-12745ef4e573",
                                                "sense_id": "83492601-fdf9-3b03-8ae6-19e2f3518b73",
                                                "text": "Both were thrifty and hardworking. From the beginning of their marriage both worked steadily and saved every penny above their basic living expenses. By their first anniversary they were saving almost all of Richard's earnings as a union carpenter—eighty to ninety dollars a week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e94cce6-e8ae-3dc2-b9a6-fd19137e7f2d",
                                        "entry_id": "b0b8ce67-be21-3b43-bdac-d6c832d12b7b",
                                        "glosses": [
                                            "Thriving, prosperous, successful; (of an animal or plant) growing rapidly or vigorously."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14181562-372b-4f80-896d-9d397785d9bc",
                                                "sense_id": "6e94cce6-e8ae-3dc2-b9a6-fd19137e7f2d",
                                                "text": "The life of religion is this water of life; where that runs, where that is received, and where things are done in this spirit, there all things are well: The church thrifty, the soul thrifty, graces thrifty, and all is well."
                                            },
                                            {
                                                "example_id": "4667de34-6b95-456a-885c-8834c0005011",
                                                "sense_id": "6e94cce6-e8ae-3dc2-b9a6-fd19137e7f2d",
                                                "text": "the lands on this road are of an excellent quality, and in many places light timbered, in others covered with thrifty oak, black walnut, sugar maple, beach and linden."
                                            },
                                            {
                                                "example_id": "1882986b-1af9-437e-94a5-ab8b28a15341",
                                                "sense_id": "6e94cce6-e8ae-3dc2-b9a6-fd19137e7f2d",
                                                "text": "But, Gentlemen, the gallant Admiral has told you he has two loves; and he seems to have made a prudent choice, and been a very thrifty wooer."
                                            },
                                            {
                                                "example_id": "1f48f83b-1a6d-4aa7-adae-0a1c4d3ef407",
                                                "sense_id": "6e94cce6-e8ae-3dc2-b9a6-fd19137e7f2d",
                                                "text": "A thrifty tree of twelve or eighteen inches diameter will increase in its quantity or weight by one year's growth, beyond that of a small sprout or tree in a ratio of more than five to one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08a083ab-5402-3799-86a3-98a0dc66276e",
                                        "entry_id": "b0b8ce67-be21-3b43-bdac-d6c832d12b7b",
                                        "glosses": [
                                            "Preserved by thrift; carefully managed."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f8a937a-0eae-48b8-bb8e-7e07526966f0",
                                                "sense_id": "08a083ab-5402-3799-86a3-98a0dc66276e",
                                                "text": "The amount of patient toil, with its thrifty rewards; of domestic happiness, with its radiant comforts; the amount of intelligent culture, of high-aimed virtue, and of kindly charity, — that have been realized here, if not matter of our boasting, is the glory of our inheritance."
                                            },
                                            {
                                                "example_id": "7a881cec-3524-4fe0-9244-b899931a6c17",
                                                "sense_id": "08a083ab-5402-3799-86a3-98a0dc66276e",
                                                "text": "They han great stores, and thriftye flockes, / great freendes and feeble foes"
                                            },
                                            {
                                                "example_id": "ebe4b163-2a52-4d16-8b55-e362bfa14b30",
                                                "sense_id": "08a083ab-5402-3799-86a3-98a0dc66276e",
                                                "text": "But do not ſo: I haue fiue hundred Crownes,\n The thriftie hire I ſaued vnder your Father,\n Which I did ſtore to be my foſter Nurſe"
                                            },
                                            {
                                                "example_id": "5fa5402f-e15e-4630-8bbe-17d649eac700",
                                                "sense_id": "08a083ab-5402-3799-86a3-98a0dc66276e",
                                                "text": "No more the shadows of the plane-tree and the beech allay the intensity of the solstitial heat; no more the feathered tribes are heard to chirrup amidst the sprays, or the active squirrel seen to disport among the boughs, or collect his thrifty store of acrons ^([sic]) and of nuts, under the cool and impenetrable recesses of the glade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1541c465-7f51-4efa-a7b0-94db08bcfccd",
                        "source_entry_id": "491ef3e8-0ab5-33ad-ad85-7f9ebe48a922",
