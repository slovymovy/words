                    },
                    {
                        "translation_id": "99c1b589-68e2-4214-8232-1cb1dc67c385",
                        "source_entry_id": "0b8af005-e39a-3f81-8869-11e61a3f506e",
                        "source_sense_id": "cf45449b-6b7c-3a9a-8353-11fe35686456",
                        "target_lang_word": "healthy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "healthy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14d95acf-770b-35e0-8de8-1f5cb1fa5b19",
                                        "entry_id": "cdc00040-a8db-3e67-b2b0-b9dc79a0e1b4",
                                        "glosses": [
                                            "Enjoying good health; free from disease or disorder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d54ab7-5f0f-4dfe-ad42-9bfd9f5db5f9",
                                                "sense_id": "14d95acf-770b-35e0-8de8-1f5cb1fa5b19",
                                                "text": "He was father to three healthy kids."
                                            },
                                            {
                                                "example_id": "679cd942-0e31-48fd-b842-6f703aac4873",
                                                "sense_id": "14d95acf-770b-35e0-8de8-1f5cb1fa5b19",
                                                "text": "a healthy mind in a healthy body"
                                            },
                                            {
                                                "example_id": "26173cb7-2d86-47e6-8491-58e832a1d312",
                                                "sense_id": "14d95acf-770b-35e0-8de8-1f5cb1fa5b19",
                                                "text": "Brush regularly to keep your teeth and gums strong and healthy."
                                            },
                                            {
                                                "example_id": "8a4e0e9f-6c7a-4dba-b65e-2b46e34d9832",
                                                "sense_id": "14d95acf-770b-35e0-8de8-1f5cb1fa5b19",
                                                "text": "My fruit trees are looking very healthy."
                                            },
                                            {
                                                "example_id": "f34d0aa5-deea-4ad9-b5d8-0ee8df520162",
                                                "sense_id": "14d95acf-770b-35e0-8de8-1f5cb1fa5b19",
                                                "text": "By one o'clock the place was choc-a-bloc. […] The restaurant was packed, and the promenade between the two main courts and the subsidiary courts was thronged with healthy-looking youngish people, drawn to the Mecca of tennis from all parts of the country."
                                            },
                                            {
                                                "example_id": "21d56bfb-6495-41af-8642-ffb1e96c3f01",
                                                "sense_id": "14d95acf-770b-35e0-8de8-1f5cb1fa5b19",
                                                "text": "At Columbia-Greene, staffers go for the most unadoptable animals to save them from euthanasia. The youngest, healthiest, cutest pets are waiting for you."
                                            },
                                            {
                                                "example_id": "e00ae069-5767-4ac6-9be8-bc7dfc9a3d1d",
                                                "sense_id": "14d95acf-770b-35e0-8de8-1f5cb1fa5b19",
                                                "text": "Galvanised by this knowledge, the figurine family take to exercise and healthy eating in the park, forming themselves into the key words \"Eat\" (better), \"Move\" (more) and \"Live\" (longer) of the government's urgings and soon the municipal landscape is filled with other happy, healthier families who, incidentally, look even more delicious en masse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5d8bd3a-e038-3393-b453-9f577bd5eabd",
                                        "entry_id": "cdc00040-a8db-3e67-b2b0-b9dc79a0e1b4",
                                        "glosses": [
                                            "Conducive to health."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "098f430a-21a5-47e9-9377-d8ae27fbdff6",
                                                "sense_id": "f5d8bd3a-e038-3393-b453-9f577bd5eabd",
                                                "text": "A healthy diet can help to maintain proper weight."
                                            },
                                            {
                                                "example_id": "01ae4a69-4c95-43b7-ba87-b196b90cbde1",
                                                "sense_id": "f5d8bd3a-e038-3393-b453-9f577bd5eabd",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits. ¶ Going to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            },
                                            {
                                                "example_id": "3aefe093-bc89-425d-b936-cc82a0813841",
                                                "sense_id": "f5d8bd3a-e038-3393-b453-9f577bd5eabd",
                                                "text": "It was heretical to say that protein wasn't healthy, let alone say it promoted cancer."
                                            },
                                            {
                                                "example_id": "c5e580a1-8b2e-4084-8623-3229415b4d41",
                                                "sense_id": "f5d8bd3a-e038-3393-b453-9f577bd5eabd",
                                                "text": "Eric Andre: You know, they say if it's gray it's healthy for you.\nJack McBrayer: No one has ever said that.\nHannibal Burress: Only thing gray that you could eat and it'd be healthy for you is, uhh, I think seal meat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "688d56c7-8547-32e7-9c23-9c24205df9d9",
                                        "entry_id": "cdc00040-a8db-3e67-b2b0-b9dc79a0e1b4",
                                        "glosses": [
                                            "Evincing health."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeafedba-7a66-4926-8cff-aa0202e2abd3",
                                                "sense_id": "688d56c7-8547-32e7-9c23-9c24205df9d9",
                                                "text": "Her face had a healthy glow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07acb5c3-ff7c-3090-a3e6-71c41d7dcec4",
                                        "entry_id": "cdc00040-a8db-3e67-b2b0-b9dc79a0e1b4",
                                        "glosses": [
                                            "Significant, hefty; beneficial."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7dbc566-954a-41e9-8c48-9c69528e9dfc",
                                                "sense_id": "07acb5c3-ff7c-3090-a3e6-71c41d7dcec4",
                                                "text": "a healthy respect for authority"
                                            },
                                            {
                                                "example_id": "99858305-56ba-4d7a-9b1b-a205ebcd46db",
                                                "sense_id": "07acb5c3-ff7c-3090-a3e6-71c41d7dcec4",
                                                "text": "Sam unwrapped the sandwich and took a healthy bite out of the middle."
                                            },
                                            {
                                                "example_id": "f7e657d4-4a60-48fd-81db-2118b8dbc235",
                                                "sense_id": "07acb5c3-ff7c-3090-a3e6-71c41d7dcec4",
                                                "text": "a healthy dislike, a healthy contempt"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd47d5dd-b83c-4352-a86f-464e98e68128",
                        "source_entry_id": "0b8af005-e39a-3f81-8869-11e61a3f506e",
                        "source_sense_id": "cf45449b-6b7c-3a9a-8353-11fe35686456",
                        "target_lang_word": "gesund",
