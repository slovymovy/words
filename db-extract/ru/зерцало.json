                                        "glosses": [
                                            "To act as a reflection of, either by being identical to, or by being identical but reversed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a255ca1-5ddc-4ad1-9d02-70aabec35e92",
                                                "sense_id": "2027bd00-9a3b-39d6-b108-93201f4a5e22",
                                                "text": "The placement of the paintings mirrored the positions of the windows on the opposite wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4248ab66-3560-37ce-9b06-97f6b5e6435e",
                                        "entry_id": "6f4b779a-40e8-3beb-88d3-a6958f79f47f",
                                        "glosses": [
                                            "Of an event, activity, behavior, to be identical to; to be a copy of; to imitate closely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a20babeb-0f86-4f44-b804-31c30e338b24",
                                                "sense_id": "4248ab66-3560-37ce-9b06-97f6b5e6435e",
                                                "text": "He tried to mirror Elvis's life by copying his fashion and mannerisms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "192e419b-2f6e-310a-a90f-f5dd13d4060a",
                                        "entry_id": "6f4b779a-40e8-3beb-88d3-a6958f79f47f",
                                        "glosses": [
                                            "To create something identical to (a website, etc.)."
                                        ],
