                    "frequency": "High",
                    "semantic_group_id": "anwesenheit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er ist heute ohne Entschuldigung nicht zur Arbeit <w>erschienen</w>."
                        },
                        {
                            "text": "Alle Zeugen müssen morgen früh pünktlich vor Gericht <w>erscheinen</w>."
                        }
                    ],
                    "synonyms": [
