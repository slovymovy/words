                "senses": [
                    {
                        "sense_id": "f966ca87-0cb0-3414-8e1a-b389b4a67bf9",
                        "entry_id": "9576b473-c699-386c-b083-04c820240791",
                        "glosses": [
                            "Femme simple, peu avisée, qui se laisse dominer et tromper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "030e3566-9539-4549-a0b5-edcc893e1fd9",
                                "sense_id": "f966ca87-0cb0-3414-8e1a-b389b4a67bf9",
                                "text": "Il fallait voir, le jeudi 10 décembre 1896, tous ces pauvres petits bonhommes et toutes ces pauvres petites bonnes femmes, esthètes infortunés des deux sexes qui, l’œil noyé, tendaient le cou et ouvraient à demi la bouche pour communier en l’honneur d’Ubu."
                            }
                        ]
                    },
                    {
                        "sense_id": "c247f4aa-d22b-324d-9b82-0ea7b9c076b4",
                        "entry_id": "9576b473-c699-386c-b083-04c820240791",
                        "glosses": [
                            "Femme quelconque. Peut aussi s’employer pour désigner une femme que l’on n’apprécie pas."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "fed458bc-b33d-422d-9134-e79ce9ad0956",
                                "sense_id": "c247f4aa-d22b-324d-9b82-0ea7b9c076b4",
                                "text": "La bonne-femme n’en peut plus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59094fb4-2db3-4c4f-8cb6-720c6abe32c3",
                        "source_entry_id": "9576b473-c699-386c-b083-04c820240791",
                        "source_sense_id": "f966ca87-0cb0-3414-8e1a-b389b4a67bf9",
                        "source_sense_description": "Femme simple",
                        "target_lang_word": "Frauenzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frauenzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e95bf895-90f9-384a-bcc4-b1a8b22e0ce2",
                                        "entry_id": "57e0e888-a655-34bc-af5c-dea23c1b6085",
                                        "glosses": [
                                            "Frau oder Mädchen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "jocular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9656c013-47a6-407b-a0dd-debdb9e14913",
                                                "sense_id": "e95bf895-90f9-384a-bcc4-b1a8b22e0ce2",
                                                "text": "So ein geschwätziges Frauenzimmer!"
                                            },
                                            {
                                                "example_id": "cb2b43c3-87fa-4272-a66f-1feac8b234d1",
                                                "sense_id": "e95bf895-90f9-384a-bcc4-b1a8b22e0ce2",
                                                "text": "„Das schreckliche Frauenzimmer konnte in gleicher Absicht noch immer hinter der Tür stehen und wieder denselben unglücklichen Moment wählen, sie zu öffnen.“"
                                            },
                                            {
                                                "example_id": "0ff67f0c-feac-4f6c-a40c-848e7e6ab90d",
                                                "sense_id": "e95bf895-90f9-384a-bcc4-b1a8b22e0ce2",
                                                "text": "„In diesem Augenblick kam eines jener Frauenzimmer vorbei, die zu jener Art von Leuten gehörte, die sich, wie es scheint, ein Geschäft daraus machten, kleine Kinder verschwinden zu lassen.“"
                                            },
                                            {
                                                "example_id": "5c79f3f9-a450-41c8-a781-3f630e49b3ed",
                                                "sense_id": "e95bf895-90f9-384a-bcc4-b1a8b22e0ce2",
                                                "text": "„Dann kam ein Frauenzimmer angeritten, an jeder Seite einen Reitknecht.“"
                                            },
                                            {
                                                "example_id": "3b6e9949-3847-41d7-a136-2f122e413fbd",
                                                "sense_id": "e95bf895-90f9-384a-bcc4-b1a8b22e0ce2",
                                                "text": "„Weinend und ohne verabschiedet zu werden, fuhr der vernichtete Druso nach Messina zurück, was den selbstlosen Gatten des liebestollen Frauenzimmers immerhin an die achtzigtausend Goldmark gekostet hatte.“"
                                            },
                                            {
                                                "example_id": "34f9de25-d590-47a4-8cbf-532bb92aa398",
                                                "sense_id": "e95bf895-90f9-384a-bcc4-b1a8b22e0ce2",
                                                "text": "„Man erzählte von ihm, daß ihn ein fremdes Frauenzimmer liebe, das er zufällig kennengelernt habe und das sehr schön und sehr reich sei.“"
                                            },
                                            {
                                                "example_id": "12f48a0c-837e-4ca6-827d-411b067085cb",
                                                "sense_id": "e95bf895-90f9-384a-bcc4-b1a8b22e0ce2",
                                                "text": "„Sabinchen war ein Frauenzimmer, / gar hold und tugendhaft […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6b06327-be51-406d-82f7-7cc2d2d43501",
                        "source_entry_id": "9576b473-c699-386c-b083-04c820240791",
