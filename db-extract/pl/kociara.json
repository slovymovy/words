                "translations": [
                    {
                        "translation_id": "89bbd253-931e-4c5d-a39a-473b465e2909",
                        "source_entry_id": "738b8c89-a1ca-30ff-a946-27d47760b5e3",
                        "source_sense_id": "e2c5f01e-df8e-38dc-9fab-05788f5acb37",
                        "target_lang_word": "cat lady",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cat lady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ccecd27-caf3-31d6-bbe7-f3848bb63ec7",
                                        "entry_id": "7a26bc68-0df7-3e0d-b0dd-bd6456c2d5d4",
                                        "glosses": [
                                            "A woman, often elderly, who devotes her time and attention to one or usually many domestic cats."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0543c3d-2c4e-4db2-bcbe-7568558a4d5b",
                                                "sense_id": "2ccecd27-caf3-31d6-bbe7-f3848bb63ec7",
                                                "text": "Beacon Hill’s notorious cat lady was in the spotlight again yesterday after an angry confrontation with cops who say they found at least two dead felines in her freezer following a brief standoff at her Plymouth home."
                                            },
                                            {
                                                "example_id": "22ea9650-effe-4263-9a3d-6d2457f03275",
                                                "sense_id": "2ccecd27-caf3-31d6-bbe7-f3848bb63ec7",
                                                "text": "The most common is a female character. Single of course, lamenting that she can never own a cat because once you have one you won't be far away from being the cat lady of the neighborhood."
                                            },
                                            {
                                                "example_id": "44818646-75af-4acd-953e-76eb7099d0b8",
                                                "sense_id": "2ccecd27-caf3-31d6-bbe7-f3848bb63ec7",
                                                "text": "We all know the stereotype of the crazy cat lady who lives alone in a home that smells of stale litter. But how unjust is it really?"
                                            },
                                            {
                                                "example_id": "e0967b10-36d1-407e-b17f-6c11f590892e",
                                                "sense_id": "2ccecd27-caf3-31d6-bbe7-f3848bb63ec7",
                                                "text": "Aniston was responding to recently resurfaced 2021 comments by Vance, who told Fox News host Tucker Carlson that the US was being run by “a bunch of childless cat ladies who are miserable at their own lives and the choices that they’ve made and so they want to make the rest of the country miserable, too.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
