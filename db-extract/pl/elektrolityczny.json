                    {
                        "sense_id": "e393f77d-66c4-3a00-a1c9-25fe18044dcb",
                        "entry_id": "7632348e-d424-397c-96cc-3d2bc4e9f421",
                        "glosses": [
                            "dotyczący elektrolizy lub elektrolitu, związany z elektrolizą lub z elektrolitem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e55bbff2-91b0-41bb-8ca1-801ee01315c4",
                                "sense_id": "e393f77d-66c4-3a00-a1c9-25fe18044dcb",
                                "text": "Lista stosowanych środków leczniczych w jonoforezie jest co prawda ograniczona, gdyż nie wszystkie środki ulegają dysocjacji elektrolitycznej, ale w wielu przypadkach jest to metoda bardzo skuteczna."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
