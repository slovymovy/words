                "senses": [
                    {
                        "sense_id": "f44165ac-4e56-3f4e-8792-63eb3404ba35",
                        "entry_id": "e28c4bf3-8dee-3d4a-8a88-4f2448767569",
                        "glosses": [
                            "weithin sichtbare, große Uhr, die auf dem Bahnhofsgelände den Passagieren und dem Bahnpersonal die verbindliche Zeit für den Zugverkehr vorgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2ff1cab-dc56-4239-99b3-35b054615daa",
                                "sense_id": "f44165ac-4e56-3f4e-8792-63eb3404ba35",
                                "text": "Als die Bahnhofsuhr die Abfahrtszeit anzeigte, setzte sich der Zug in Bewegung."
                            },
                            {
                                "example_id": "6d9b29b8-8447-4c05-a424-ac0217641312",
                                "sense_id": "f44165ac-4e56-3f4e-8792-63eb3404ba35",
                                "text": "„Bleibt das Thema Bahnhofsuhr. Das Symbol für Pünktlichkeit zählt in fast jedem Bahnhof dieser Welt zum unverzichtbaren Inventar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
