                                    {
                                        "sense_id": "e74b5aca-dfb4-33e1-8de3-dfb2e01a13b6",
                                        "entry_id": "041f4ae4-e43d-3f76-b957-5ba8d59dcbc9",
                                        "glosses": [
                                            "To cause beads to form on (something)."
