                        "entry_id": "373553eb-dd0d-357d-8b1f-816d35ecd676",
                        "glosses": [
                            "kleiner Splitter oder Faser von Holz oder anderen festen Arbeitsmaterialien, insbesondere, wenn er in die Haut gedrungen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "675683aa-1262-4964-867e-748967b8c928",
                                "sense_id": "41f78196-2ea5-3903-a11b-1d56094fce3f",
                                "text": "Er hatte sich beim Holzlegen einen Speil eingezogen und operierte ihn nun mit einer Nadel aus seiner Haut."
                            }
                        ],
