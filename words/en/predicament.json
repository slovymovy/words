                    "sense_id": "f5051a93-28e3-3f8f-a3f4-70f62f7d4d9a",
                    "sense_definition": "An unfortunate, difficult, or trying situation or condition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficult situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After losing his passport and wallet, he found himself in a difficult <w>predicament</w> while traveling abroad.",
                            "target_lang_translations": {
                                "ru": "Потеряв паспорт и кошелек, он оказался в трудном <w>затруднительном положении</w> во время поездки за границу."
                            }
                        },
                        {
                            "text": "The company is facing a serious <w>predicament</w> due to the sudden loss of its main investor.",
                            "target_lang_translations": {
                                "ru": "Компания столкнулась с серьезной <w>проблемой</w> из-за внезапной потери основного инвестора."
                            }
                        }
                    ],
                    "synonyms": [
                        "tight spot",
                        "plight"
                    ],
                    "common_phrases": [
                        "serious predicament",
                        "difficult predicament",
                        "awkward predicament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятная, трудная или тяжелая ситуация или состояние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затруднительное положение",
                                "target_lang_sense_clarification": "сложная ситуация, из которой трудно найти выход"
                            },
                            {
                                "target_lang_word": "дилемма",
