                    {
                        "translation_id": "3357e241-e97a-4a71-befc-49325a6e5b34",
                        "source_entry_id": "1f377c34-ef12-3913-af57-3c251ddbb48f",
                        "source_sense_id": "7abe2a4a-ec00-313a-b559-12c010af71df",
