                    {
                        "sense_id": "7d12cb98-df46-380a-a369-c33af036a74a",
                        "entry_id": "dc0a443a-6a6d-366f-826d-2bda6f0a32ee",
                        "glosses": [
                            "Celui qui fabrique, qui vend des ouvrages de fer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "149ab268-d050-46e6-b4b5-3a13209784d1",
                                "sense_id": "7d12cb98-df46-380a-a369-c33af036a74a",
                                "text": "M. Hippolyte Brichet était ferronnier à Levrézy avant d'installer une modeste pension pour les ouvriers qui lui laissait le temps de s'adonner à un petit commerce de quincaillerie pour une clientèle strictement locale."
                            },
                            {
                                "example_id": "a0fa543d-4116-49ee-bd5a-ab78c207392d",
                                "sense_id": "7d12cb98-df46-380a-a369-c33af036a74a",
                                "text": "Le fer forgé est le matériau que le ferronnier va travailler; il lui est livré du laminoir en barres ou en verges de différentes grosseurs, rondes, carrées ou plates."
                            }
                        ]
                    }
                ],
