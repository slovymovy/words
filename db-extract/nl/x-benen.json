                                                "sense_id": "0cfa516a-0875-3a6a-8d21-b269741f4d0d",
                                                "text": "„Sie registrert, dass das Mädchen aufrecht geht, wohl proportioniert ist und keine X-Beine hat.“"
                                            },
                                            {
                                                "example_id": "9e99480c-75e6-4bdf-b883-49cc2789a0f5",
                                                "sense_id": "0cfa516a-0875-3a6a-8d21-b269741f4d0d",
                                                "text": "„Wir sehen ihn auf seinen stämmigen X-Beinen über den Hof stampfen, halbmilitärisch mit seinen Radfahrklammern.“"
                                            }
                                        ],
