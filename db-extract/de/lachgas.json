                "senses": [
                    {
                        "sense_id": "add9ba44-13ce-30f9-920d-398477b71bf7",
                        "entry_id": "c32dcfd7-b5db-3987-86a7-8cbb9797cadf",
                        "glosses": [
                            "farbloses Gas aus der Gruppe der Stickoxide, das auch als Betäubungsmittel eingesetzt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10040651-8354-4ee4-975d-8fefb6af6fe7",
                                "sense_id": "add9ba44-13ce-30f9-920d-398477b71bf7",
                                "text": "Lachgas ist als Lebensmittelzusatzstoff unter der Bezeichnung E 942 als Treibgas, beispielsweise für Schlagsahne, zugelassen."
                            },
                            {
                                "example_id": "1ce9d43e-4493-4413-b003-4ec554ce505c",
                                "sense_id": "add9ba44-13ce-30f9-920d-398477b71bf7",
                                "text": "„Der Name Lachgas hat sich vor allem deshalb eingebürgert, weil N2O mitunter für Lachanfälle sorgt.“"
                            },
                            {
                                "example_id": "51b587ec-3572-42aa-ad34-16d064551fc9",
                                "sense_id": "add9ba44-13ce-30f9-920d-398477b71bf7",
                                "text": "„Laut aktueller Treibhausgas-Inventur ist die Landwirtschaft für 7,6 Prozent aller deutschen Emissionen verantwortlich, und rund 40 Prozent davon entfallen auf Lachgas, das beim Abbau von Stickstoffverbindungen aus Gülle und Kunstdünger im Boden entsteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c8c3c69-a5ab-40c5-bf64-ada6e3a547e7",
                        "source_entry_id": "c32dcfd7-b5db-3987-86a7-8cbb9797cadf",
                        "source_sense_id": "add9ba44-13ce-30f9-920d-398477b71bf7",
                        "source_sense_description": "farbloses Gas aus der Gruppe der Stickoxide, das auch als Betäubungsmittel eingesetzt wurde",
                        "target_lang_word": "laughing gas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laughing gas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ed708ff-4a79-3b67-b022-9321bb76ebd4",
                                        "entry_id": "c3a0adbf-fc33-3601-9180-b0a00c0daceb",
                                        "glosses": [
                                            "Nitrous oxide, especially when used as an anaesthetic."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9360a7f-d2c8-4177-9064-bd5b9a6a8ab2",
                                                "sense_id": "6ed708ff-4a79-3b67-b022-9321bb76ebd4",
                                                "text": "\"You know how matters stand, dear,\" said he. \"I have explained it also to our friends here. You're not afraid are you?\" \"It won't be painful, George?\" \"No more than laughing-gas at the dentist's.\""
                                            },
                                            {
                                                "example_id": "c2cbe0a8-4d5c-43c4-8b27-05813d19a6d5",
                                                "sense_id": "6ed708ff-4a79-3b67-b022-9321bb76ebd4",
                                                "text": "ETSC’s Belgian member VIAS institute is calling for the development of a breath test to detect when a driver has consumed nitrous oxide, known as ‘laughing gas’.\nCall for breath tests to detect drivers under the influence of nitrous oxide, ETSC, 20 February 2024"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a077634f-10b4-4b49-80a3-0a5ddf3ac763",
                        "source_entry_id": "c32dcfd7-b5db-3987-86a7-8cbb9797cadf",
                        "source_sense_id": "add9ba44-13ce-30f9-920d-398477b71bf7",
                        "source_sense_description": "farbloses Gas aus der Gruppe der Stickoxide, das auch als Betäubungsmittel eingesetzt wurde",
                        "target_lang_word": "gaz hilarant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaz hilarant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d5cfed-f82c-3a5b-9a10-050106c077a7",
                                        "entry_id": "c8377708-664b-3314-8e5e-63c36ce7e6cc",
                                        "glosses": [
                                            "Protoxyde d’azote utilisé en anesthésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44dda404-faaf-48ea-8ea3-55fb06d7d216",
                                                "sense_id": "d2d5cfed-f82c-3a5b-9a10-050106c077a7",
                                                "text": "Aux États-Unis, M. Mitchell et plusieurs autres personnes respirèrent le gaz hilarant: ils furent frappés, comme Davy, de sa propriété d’exciter le rire et de procurer une sensation générale agréable."
                                            },
                                            {
                                                "example_id": "6d56fb95-544f-4df3-aa35-5000cff98765",
                                                "sense_id": "d2d5cfed-f82c-3a5b-9a10-050106c077a7",
                                                "text": "PROTOXYDE D’AZOTE […]\nDécouvert par Priestley en 1772. Ses propriétés anesthésiques ont été découvertes par Davy en 1800 ; ce savant le désigna sous le nom de gaz hilarant."
                                            },
                                            {
                                                "example_id": "e9faef88-79d6-4e58-b246-68251de77a19",
                                                "sense_id": "d2d5cfed-f82c-3a5b-9a10-050106c077a7",
                                                "text": "À partir du 1er janvier, la vente de protoxyde d'azote, également connu sous l'appellation gaz hilarant, sera totalement interdite aux Pays-Bas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
