                        "examples": [
                            {
                                "example_id": "6f610c33-b731-495e-b267-565e821cd4d8",
                                "sense_id": "c895941c-2090-334d-8f31-88a39acf476b",
                                "text": "Oerlemans en zijn Britse collega John Cantlie werden in juli 2012 ontvoerd toen ze voor een fotoreportage in Syrië waren. Moslimextremisten hielden hen negen dagen vast in hun kamp."
                            },
                            {
                                "example_id": "0effa8a7-57fc-451d-bb2e-66ec1d4ed2e0",
                                "sense_id": "c895941c-2090-334d-8f31-88a39acf476b",
                                "text": "Unbreakable, een simpel, maar daardoor des te doeltreffender project. Het project is een fotoreportage van de New Yorkse kunstenares Grace Brown. Ze zette vrouwen, die in het verleden seksueel misbruikt zijn, letterlijk op de gevoelige plaat. Ze hebben op de foto's namelijk een bord vast met daarop quotes van belagers terwijl ze zich aan hen vergrepen."
                            }
                        ]
                    }
