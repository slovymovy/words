                "senses": [
                    {
                        "sense_id": "278db722-f16a-3f32-b246-c799871119d9",
                        "entry_id": "f08ab740-ccbd-346c-b9f8-5a7e8fa3270b",
                        "glosses": [
                            "zumeist auf Wänden oder Mauern aufgebrachte Darstellung, die überwiegend mit Spray hergestellt ist und ein bestimmtes Motiv, eine Parole oder Ähnliches zeigt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "58324213-4eff-43d9-a63c-97e261c4f820",
                                "sense_id": "278db722-f16a-3f32-b246-c799871119d9",
                                "text": "Hier in der Gegend entstehen ständig neue Graffitis."
                            },
                            {
                                "example_id": "ce602593-8bd7-40ed-a7d0-14a7ac8b0d48",
                                "sense_id": "278db722-f16a-3f32-b246-c799871119d9",
                                "text": "Hast du schon mein neues Graffiti in der Bahnhofstraße gesehen?"
                            },
                            {
                                "example_id": "d59373a5-fd98-4f97-b787-c726d1a486ad",
                                "sense_id": "278db722-f16a-3f32-b246-c799871119d9",
                                "text": "An diese Mauer passt noch ein kleines Graffiti."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb1ab132-ce71-4aad-b21a-5efaccbbc4c8",
                        "source_entry_id": "f08ab740-ccbd-346c-b9f8-5a7e8fa3270b",
                        "source_sense_id": "278db722-f16a-3f32-b246-c799871119d9",
                        "target_lang_word": "graffiti",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graffiti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efcb38b6-88e2-3be6-bcd6-2aa9db83be42",
                                        "entry_id": "8be8f619-18bc-3471-9a95-d495eb0bc94d",
                                        "glosses": [
                                            "Drawings or words drawn on a surface in a public place, usually made without authorization."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52fcaee0-a662-4b3f-a071-e6d922ae49f7",
                                                "sense_id": "efcb38b6-88e2-3be6-bcd6-2aa9db83be42",
                                                "text": "The underpass is a popular place for graffiti artists."
                                            },
                                            {
                                                "example_id": "fca19e70-a1b1-481f-9711-e71ef087e474",
                                                "sense_id": "efcb38b6-88e2-3be6-bcd6-2aa9db83be42",
                                                "text": "The city council spends thousands of pounds removing graffiti from public buildings."
                                            },
                                            {
                                                "example_id": "f4541d23-aaa2-4dc9-b774-92a5eb46757f",
                                                "sense_id": "efcb38b6-88e2-3be6-bcd6-2aa9db83be42",
                                                "text": "The removal of unsightly graffiti on the sides of railway bridges spanning major roads in the North West is to be handed over to National Highways, to speed up the job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5160b678-c277-3c0a-9922-22019c7e4e65",
                                        "entry_id": "8be8f619-18bc-3471-9a95-d495eb0bc94d",
                                        "glosses": [
                                            "Informal inscriptions, figure drawings, etc., as opposed to official inscriptions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "graffiti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a7d94ee-7781-33d1-90fd-64a9db5a3877",
                                        "entry_id": "abd33445-ec1a-3295-af2a-d6d3356ad7a3",
