                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33e8ad73-7e3a-3ae1-a941-a1c1c74399df",
                                        "entry_id": "6f6b00e8-a430-3916-856f-3ba507f9a356",
                                        "glosses": [
                                            "ein Stück Papier, das so gefaltet ist, dass ein knallendes Geräusch entsteht, wenn man es ruckartig bewegt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7f4dcc1-faa7-4458-bd2f-da196066f03e",
                                                "sense_id": "33e8ad73-7e3a-3ae1-a941-a1c1c74399df",
                                                "text": "Er bastelte sich eine Klatsche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9d948b1-83c5-3a15-b906-b7ce47c4b099",
                                        "entry_id": "6f6b00e8-a430-3916-856f-3ba507f9a356",
                                        "glosses": [
                                            "Fliegenklatsche"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e07f462-4a27-4e51-b5e2-f8ad535729e4",
                                                "sense_id": "c9d948b1-83c5-3a15-b906-b7ce47c4b099",
                                                "text": "Er erschlug die Fliege mit der Klatsche."
                                            },
                                            {
                                                "example_id": "79cf20f8-9fbd-477c-833d-cfb7e7635622",
                                                "sense_id": "c9d948b1-83c5-3a15-b906-b7ce47c4b099",
                                                "text": "„Schon in der Morgendämmerung pflegte Alf Bertini hinter sich zu greifen und eine primitive Klatsche hervorzuziehen - einen rohen, runden Lederlappen an einem langen Holzstiel.“"
                                            },
                                            {
                                                "example_id": "60dcbb1e-9034-4db8-b4f6-4e156350bfae",
                                                "sense_id": "c9d948b1-83c5-3a15-b906-b7ce47c4b099",
                                                "text": "„Bei Wilhelm Busch werden Fliegen mit der Klatsche auf dem Babykopf totgeklatscht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "af2c133d-37b8-3b28-9a58-ad9fa1836e57",
                                        "entry_id": "6f6b00e8-a430-3916-856f-3ba507f9a356",
                                        "glosses": [
                                            "jemand, der gerne tratscht"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0f00585-2739-48b6-a1c2-ad85d1534a5b",
                                                "sense_id": "af2c133d-37b8-3b28-9a58-ad9fa1836e57",
                                                "text": "Sie ist eine alte Klatsche."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
