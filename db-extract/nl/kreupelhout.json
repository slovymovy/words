                    {
                        "translation_id": "a18ef023-f743-44f0-bddb-a2d5d5c2141c",
                        "source_entry_id": "d99ccae3-d114-355e-8945-9156c62ad32b",
                        "source_sense_id": "da8be656-61ed-3c5d-86f3-984d0b5fd7d2",
                        "source_sense_description": "laag stuikgewas waarbij de takken van de boompjes door elkaar heen groeien",
                        "target_lang_word": "sous-bois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-bois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bf90871-cccd-3a57-b8c7-6d9d009b5e7f",
                                        "entry_id": "781da515-1bc8-3505-a857-ffe8bc56b421",
                                        "glosses": [
                                            "Strate muscinale, herbacée et arbustive de la forêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfb6d81d-28f9-4dbb-98d3-2ba9e6465191",
                                                "sense_id": "5bf90871-cccd-3a57-b8c7-6d9d009b5e7f",
                                                "text": "Au printemps les sous-bois se tapissent des fleurs de Caltha palustris, Ranunculus Ficaria, Prímula elatíor dont la jaune monotonie s’égaie du bleu des Glechoma hederacea et Viola silvestris."
                                            },
                                            {
                                                "example_id": "3933b2f7-f610-4fb2-b598-9f2e6bb0aaf4",
                                                "sense_id": "5bf90871-cccd-3a57-b8c7-6d9d009b5e7f",
                                                "text": "Ces arbres atteignent 25 à 30 mètres de haut et ils sont associés à un sous-bois abondant, à des lianes et à des plantes épiphytes.."
                                            },
                                            {
                                                "example_id": "944e251f-baf0-49dd-8747-a60c08bb6fa6",
                                                "sense_id": "5bf90871-cccd-3a57-b8c7-6d9d009b5e7f",
                                                "text": "Les plantes de sous-bois de forêts sempervirentes sont donc, par essence même adaptées à cette faible luminosité, de l'ordre de 1 % du plein soleil."
                                            },
                                            {
                                                "example_id": "b5c6b0f1-04f9-4d49-a87c-3694eade73ba",
                                                "sense_id": "5bf90871-cccd-3a57-b8c7-6d9d009b5e7f",
                                                "text": "Dans les canopées, c'est-à-dire au sommet de ces arbres immenses exposés à la lumière, alors que le sous-bois, parce qu'il est moins lumineux, comporte forcément moins de plantes, donc moins d'animaux. Les énergies, la vie sont là-haut."
                                            },
                                            {
                                                "example_id": "12c1551f-371c-4281-873a-f32d9a645e25",
                                                "sense_id": "5bf90871-cccd-3a57-b8c7-6d9d009b5e7f",
                                                "text": "Disposant de peu d’énergie, les plantes du sous-bois ne peuvent produire que de très petites graines et ces dernières, lorsqu’elles germent, mourraient si elles se laissaient enfouir sous la litière; (...)"
                                            },
                                            {
                                                "example_id": "a5c98195-b7c6-4e6b-9326-5b75c867f67d",
                                                "sense_id": "5bf90871-cccd-3a57-b8c7-6d9d009b5e7f",
                                                "text": "Des amas de feuilles mortes, de bois en décomposition et de débris divers parsèmes le sous-bois : ce dernier est un pourrissoir, même s'il n'est pas que cela."
                                            },
                                            {
                                                "example_id": "eeb440d7-7227-460d-8ebe-c520eae0d89b",
                                                "sense_id": "5bf90871-cccd-3a57-b8c7-6d9d009b5e7f",
                                                "text": "La forêt pontique hyperhumide de la région de Rize démarre sur les basses pentes par une aulnaie très dense associée à de nombreuses espèces caducifoliées et à un sous-bois laurifolié (laurier-cerise et rhododendrons); …"
                                            },
                                            {
                                                "example_id": "166f3238-b1ae-4178-b205-d53ffeb88637",
                                                "sense_id": "5bf90871-cccd-3a57-b8c7-6d9d009b5e7f",
                                                "text": "Le Lapic est une des rivières qui se jette au Moulin de la Rive et dont les méandres cheminent dans les sous-bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
