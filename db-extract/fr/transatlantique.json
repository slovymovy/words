        "fr-extract.jsonl": [
            {
                "entry_id": "71e63419-6556-37cb-88ed-f298a942620c",
                "word": "transatlantique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bd84b0a1-e62c-4d1f-b317-e7007ba0981d",
                        "entry_id": "71e63419-6556-37cb-88ed-f298a942620c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "transatlantiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                        "entry_id": "71e63419-6556-37cb-88ed-f298a942620c",
                        "glosses": [
                            "Qui traverse l’Atlantique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3c14f44-1b49-45c6-bcfc-a521d984d8cc",
                                "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                "text": "Pour que le vol transatlantique soit un succès commercial, il faudra développer à la fois la vitesse et la sécurité. Seul l’avenir pourra résoudre ce problème."
                            },
                            {
                                "example_id": "f07690d8-9722-468a-991c-5fd973b35342",
                                "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                "text": "Le Concorde peut effectuer un aller-retour transatlantique en un peu plus de six heures."
                            },
                            {
                                "example_id": "f66cebc4-b734-46c0-91f8-0bf3ba9d0e24",
                                "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                "text": "[…], je m'installais devant mon PC. Il devait être environ 20h. Lorsqu'il se connecta quelques minutes plus tard, je le bipais. Nous eûmes du mal au début. En effet, les liaisons transatlantiques ne sont pas toujours des meilleures avec Skype."
                            },
                            {
                                "example_id": "130d34bb-385f-413f-83bc-2e3aae1cf495",
                                "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                "text": "Un câble transatlantique. — Un paquebot transatlantique. — La Compagnie transatlantique."
                            },
                            {
                                "example_id": "49e49f25-4e99-4aa9-9e3b-5e9386834ffc",
                                "sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                                "text": "« Ils ne peuvent pas avoir le beurre et l'argent du beurre », a martelé celui qui s'est vu remettre à Berlin le prix Eric Warburg, récompensant une personnalité ayant particulièrement oeuvré pour les relations transatlantiques"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70fb9e6e-629f-4687-bbb5-8802c4d97944",
                        "source_entry_id": "71e63419-6556-37cb-88ed-f298a942620c",
                        "source_sense_id": "c1f1700f-8955-3bcd-ae2e-de757f71100b",
                        "target_lang_word": "transatlantic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transatlantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "348372f4-ff2f-374c-8320-584d577013d6",
                                        "entry_id": "c1d5725e-f06d-3fd3-a2ae-98b9dca57e5f",
                                        "glosses": [
                                            "On, spanning or crossing, or from the other side of the Atlantic Ocean."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86815198-d98b-47d7-a7c3-f4f4072f092f",
                                                "sense_id": "348372f4-ff2f-374c-8320-584d577013d6",
                                                "text": "Serving the flat and fertile south-eastern part of Co. Cork is the railway that runs from Glanmire Road Station in Cork City to the popular seaside resort of Youghal (pronounced \"Yawl\") and the town of Cobh (pronounced \"Cove\"), which is Ireland's port of call for transatlantic liners."
                                            },
                                            {
                                                "example_id": "bf6516d2-377e-40f7-9099-df366343f6d1",
                                                "sense_id": "348372f4-ff2f-374c-8320-584d577013d6",
                                                "text": "Many travellers via Fishguard regret the closing by British Transport Hotels & Catering Services of the Fishguard Bay Hotel, built by the G.W.R. early in the century for the expected transatlantic traffic."
                                            },
                                            {
                                                "example_id": "2f220f57-7b7f-401f-9822-05bc446b3458",
                                                "sense_id": "348372f4-ff2f-374c-8320-584d577013d6",
                                                "text": "Ruth Elder was known for her beauty and acting, but her real dream was to become the female version of transatlantic aviator Charles Lindbergh."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96ca1ef2-9fdc-4d4d-8550-1a7e9c4f9225",
                        "source_entry_id": "71e63419-6556-37cb-88ed-f298a942620c",
