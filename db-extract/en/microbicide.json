                                ]
                            },
                            {
                                "target_word": "microbicide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9eb31cf-ded0-3c1d-8d7d-94847630549d",
                                        "entry_id": "88a3b364-484e-3bbf-bb1e-61b8492fe76a",
                                        "glosses": [
                                            "Substance qui tue les microbes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b16188d-35d7-4d5d-8b2e-36d3d541f4ca",
                                                "sense_id": "f9eb31cf-ded0-3c1d-8d7d-94847630549d",
                                                "text": "Les composés chimiques ci-dessus indiqués sont des microbicides de degré variable: il n'y a dès lors rien d'étonnant à leur voir suspendre ou arrêter définitivement le processus germinatif, suivant leur degré de nocuité sur la vie microbienne."
                                            },
                                            {
                                                "example_id": "68b5ee4d-2df2-430c-9018-f2252b231e5e",
                                                "sense_id": "f9eb31cf-ded0-3c1d-8d7d-94847630549d",
                                                "text": "La mise au point d'un virocide, un microbicide inséré dans le vagin qui protégerait contre la transmission du VIH, tout en laissant passer le sperme sans l'endommager, est actuellement à l'étude."
                                            },
                                            {
                                                "example_id": "f2a96079-77b0-452f-b69b-3e5995479ae2",
                                                "sense_id": "f9eb31cf-ded0-3c1d-8d7d-94847630549d",
                                                "text": "Pour la première fois, un microbicide, gel d’application vaginal, a permis de réduire la contamination par le virus du sida."
                                            }
                                        ]
                                    }
                                ]
                            }
