    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "102f3dd0-fcbc-3746-806b-a225fa01d6eb",
                    "sense_definition": "Rendre trouble, altérer la netteté d'une image, de la vue ou perturber la réception d'un signal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie battante sur le pare-brise a commencé à <w>brouiller</w> la vue du conducteur."
                        },
                        {
                            "text": "Les orages violents peuvent <w>brouiller</w> la réception des chaînes de télévision."
                        }
                    ],
                    "synonyms": [
                        "obscurcir",
                        "troubler"
                    ],
                    "antonyms": [
                        "éclaircir"
                    ],
                    "common_phrases": [
                        "brouiller la vue",
                        "brouiller les pistes"
                    ]
                },
                {
                    "sense_id": "5ed60043-6097-3021-b362-9b2bcf3be5bd",
                    "sense_definition": "Mettre en désordre ou confondre des éléments ou des idées de façon obscure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes ces informations contradictoires finissent par lui <w>brouiller</w> l'esprit."
                        },
                        {
                            "text": "Le candidat évite de répondre clairement et tente de <w>brouiller</w> le message."
                        }
                    ],
                    "synonyms": [
                        "confondre",
                        "embrouiller"
                    ],
                    "antonyms": [
                        "clarifier",
                        "ordonner"
                    ],
                    "common_phrases": [
                        "brouiller les cartes",
                        "brouiller le message"
                    ]
                },
                {
                    "sense_id": "3f71e8a6-362c-3540-ab4c-f42338802801",
                    "sense_definition": "Rompre la bonne entente ou provoquer une dispute entre des personnes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une vieille querelle d'héritage a suffi à <w>brouiller</w> ces deux frères."
                        },
                        {
                            "text": "Il refuse de parler de politique pour ne pas se <w>brouiller</w> avec ses voisins."
                        }
                    ],
                    "synonyms": [
                        "désunir",
                        "diviser"
                    ],
                    "antonyms": [
                        "rapprocher",
                        "réconcilier"
                    ],
                    "common_phrases": [
                        "se brouiller avec"
                    ]
                },
                {
                    "sense_id": "a0c53697-f8f2-3c58-9630-822a81360b09",
                    "sense_definition": "Mélanger et battre des œufs pendant la cuisson.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>brouiller</w> les œufs à feu très doux pour préserver leur texture onctueuse."
                        },
                        {
                            "text": "Pour préparer le petit-déjeuner, elle commence par <w>brouiller</w> trois œufs avec du beurre."
                        }
                    ],
                    "common_phrases": [
                        "brouiller des œufs"
                    ]
                }
            ]
        }
    ]
