                        "examples": [
                            {
                                "example_id": "021e8257-56e3-45d8-9be5-f48d69860d66",
                                "sense_id": "4179c2c0-ac67-3e39-86ea-aca302b132f5",
                                "text": "Avec le système, on vous vend également une doublure velours qui s’autoagrippe sur la boîte à rideaux (par un ruban accrocheur spécial)."
                            },
                            {
                                "example_id": "bc9b578d-df7e-4b95-a4cb-28f4772d822e",
                                "sense_id": "4179c2c0-ac67-3e39-86ea-aca302b132f5",
                                "text": "Dès la même première minute, il geint longuement, s’interrompt et s’autoagrippe à ses vêtements avec ses mains, les lâche, et les suce, puis repousse de tout son corps le contact corporel avec sa mère."
                            }
                        ]
                    }
