        "veritable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "59aad0c7-428c-38c6-bbbe-73f1032825c8",
                    "sense_definition": "Being truly or very much so; genuine and authentic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "truth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist is a <w>veritable</w> genius in his field of study.",
                            "target_lang_translations": {
                                "ru": "Этот ученый — <w>настоящий</w> гений в своей области исследований."
                            }
                        },
                        {
                            "text": "This small garden is a <w>veritable</w> paradise for local birds.",
                            "target_lang_translations": {
                                "ru": "Этот маленький сад — <w>настоящий</w> рай для местных птиц."
                            }
                        }
                    ],
                    "synonyms": [
                        "genuine",
                        "authentic",
                        "real"
                    ],
                    "antonyms": [
                        "fake",
                        "false"
                    ],
                    "common_phrases": [
                        "veritable genius",
                        "veritable paradise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подлинный, настоящий, истинный; используется для подчеркивания того, что кто-то или что-то действительно является тем, чем его называют."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлинный",
                                "target_lang_sense_clarification": "указывает на истинность и аутентичность"
                            },
                            {
                                "target_lang_word": "настоящий",
                                "target_lang_sense_clarification": "универсальный вариант для подчеркивания качества"
                            },
                            {
                                "target_lang_word": "истинный",
                                "target_lang_sense_clarification": "подчеркивает соответствие сути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfc0fbb8-ad02-3eb3-8a77-e9b3742ad93e",
                    "sense_definition": "Used as an intensifier to emphasize the magnitude or reality of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "truth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm caused a <w>veritable</w> disaster for the coastal town.",
                            "target_lang_translations": {
                                "ru": "Шторм стал <w>сущим</w> бедствием для прибрежного города."
                            }
                        },
                        {
                            "text": "A <w>veritable</w> mountain of paperwork awaited the manager on Monday.",
                            "target_lang_translations": {
                                "ru": "В понедельник менеджера ждала <w>настоящая</w> гора бумажной работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute",
                        "complete",
                        "utter"
                    ],
                    "common_phrases": [
                        "veritable mountain",
                        "veritable disaster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как усилительное слово для подчеркивания масштаба или значимости события или объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоящий",
                                "target_lang_sense_clarification": "усиливает масштаб события"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "подчеркивает завершенность или крайнюю степень"
                            },
                            {
                                "target_lang_word": "сущий",
                                "target_lang_sense_clarification": "книжный вариант для усиления негативного или значимого явления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}