                                        "sense_id": "41dd4658-8165-332f-8a80-898e6bfb9abf",
                                        "entry_id": "ec8c88fc-03e6-3326-b0e6-858882d36f97",
                                        "glosses": [
                                            "Alternative form of free ride (“to take advantage of a benefit without contributing”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c5ee33e-ca3b-4633-917c-330d3e787d5f",
                                                "sense_id": "41dd4658-8165-332f-8a80-898e6bfb9abf",
                                                "text": "There are thoughtful answers to these questions, but the president speaks to the resentments and anxieties of millions of Americans who feel that others continue to freeride on American generosity."
                                            },
                                            {
                                                "example_id": "083c81c4-28c0-4400-aa2b-35e7a4a91732",
                                                "sense_id": "41dd4658-8165-332f-8a80-898e6bfb9abf",
                                                "text": "A decade ago, policymakers on both sides of the Atlantic were consumed by a debate about who should foot the bill for the infrastructure that powers the internet. On one side, telecoms companies argued that content providers were \"freeriding\" on their infrastructure and should pay more. On the other, a coalition led by civil society and consumer groups was lobbying for an open and interoperable web."
                                            }
                                        ]
                                    }
