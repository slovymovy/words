                                                "sense_id": "df334b43-a01e-33ff-87c0-ad590711c170",
                                                "text": "Bijzondere kentekens werden door de medewerker genoteerd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfba0ee3-fe9a-305b-9022-697cdb5db942",
                                        "entry_id": "6a2ba036-4b04-395a-a5a0-b3631d3de7d2",
                                        "glosses": [
