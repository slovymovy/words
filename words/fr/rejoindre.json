            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03f1c4d3-c1cd-3a72-b317-30ccb8ef5271",
                    "sense_definition": "Aller trouver quelqu'un ou retrouver une personne quelque part.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "retrouver_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux me <w>rejoindre</w> au café après ton travail pour boire un verre."
                        },
                        {
                            "text": "Ils ont décidé de <w>rejoindre</w> leurs amis au cinéma pour la séance du soir."
                        }
                    ],
                    "synonyms": [
                        "retrouver",
                        "rattraper"
                    ],
                    "antonyms": [
                        "quitter"
                    ],
                    "common_phrases": [
                        "rejoindre des amis",
                        "rejoindre sa famille"
                    ]
                },
                {
                    "sense_id": "a31916e8-0246-300f-839f-99525c1e33c9",
                    "sense_definition": "Atteindre un lieu, une route ou parvenir à une destination.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "atteindre_lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons marcher encore deux kilomètres pour <w>rejoindre</w> la gare centrale."
                        },
                        {
                            "text": "Après avoir traversé la forêt, le sentier permet de <w>rejoindre</w> la route principale."
                        }
                    ],
                    "synonyms": [
                        "atteindre",
                        "gagner"
                    ],
                    "common_phrases": [
                        "rejoindre la route",
                        "rejoindre le centre-ville"
                    ]
                },
                {
                    "sense_id": "a5fb45b6-8982-34fe-a92a-64683adb26ab",
                    "sense_definition": "Intégrer un groupe, une entreprise ou adhérer à une organisation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adherer_groupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet ingénieur expérimenté a choisi de <w>rejoindre</w> notre entreprise le mois dernier."
                        },
                        {
                            "text": "Elle souhaite <w>rejoindre</w> une association locale pour aider les personnes âgées."
                        }
                    ],
                    "synonyms": [
                        "intégrer",
                        "adhérer"
                    ],
                    "antonyms": [
                        "quitter"
                    ],
                    "common_phrases": [
                        "rejoindre une équipe",
                        "rejoindre une entreprise",
                        "rejoindre un groupe"
                    ]
                },
                {
                    "sense_id": "79539582-acca-35a0-9ca4-56e2b7b547a8",
                    "sense_definition": "Partager l'avis, l'opinion ou le point de vue de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concordance_idees",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur cette question essentielle, je <w>rejoins</w> tout à fait votre opinion sans aucune hésitation."
                        },
                        {
                            "text": "Le rapport d'experts vient <w>rejoindre</w> les conclusions tirées lors de la première enquête."
                        }
                    ],
                    "synonyms": [
                        "approuver"
                    ],
                    "antonyms": [
                        "contredire"
                    ],
                    "common_phrases": [
                        "rejoindre l'avis",
                        "rejoindre le point de vue"
                    ]
                },
                {
                    "sense_id": "7cc8326c-2791-3bcc-89b6-3429ddb95c1e",
                    "sense_definition": "Se toucher ou se rencontrer en un point en parlant de lignes, de chemins ou de parties.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jonction_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux grands fleuves se <w>rejoignent</w> près de la frontière pour n'en former qu'un seul."
                        },
                        {
                            "text": "Au bout du village, ces deux sentiers finissent par se <w>rejoindre</w> devant une vieille église."
                        }
                    ],
                    "synonyms": [
                        "converger"
                    ],
                    "antonyms": [
                        "diverger"
                    ],
                    "common_phrases": [
                        "se rejoindre à un croisement"
                    ]
                }
            ]
        }
