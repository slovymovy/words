                "translations": [
                    {
                        "translation_id": "6a58e027-3b4e-41e5-84f5-f6f1f12ddf7c",
                        "source_entry_id": "b5b86526-246a-3554-876f-5e31923fbd8c",
                        "source_sense_id": "0081c30b-93ef-390f-8f21-5c5300a3560b",
                        "target_lang_word": "Kabarettist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kabarettist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfab8d79-3f31-3e69-9cfc-8630f79f6225",
                                        "entry_id": "00e14b2e-75bf-34a6-9d80-287070e57575",
                                        "glosses": [
                                            "Künstler des Kabaretts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "189aa734-74a3-4cbb-a390-5deeefd15656",
                                                "sense_id": "cfab8d79-3f31-3e69-9cfc-8630f79f6225",
                                                "text": "„Ich war auf einmal Entertainer, Conférencier, Kabarettist und nicht vorlesender Literat oder diskutierender Teilnehmer einer Talkshow.“"
                                            },
                                            {
                                                "example_id": "17e87b94-16e5-4547-8929-f1672c2de797",
                                                "sense_id": "cfab8d79-3f31-3e69-9cfc-8630f79f6225",
                                                "text": "„Der Kabarettist wandelt sich zum Korrespondenten.“"
                                            },
                                            {
                                                "example_id": "6b665bc8-f245-4322-88eb-cc60709b008b",
                                                "sense_id": "cfab8d79-3f31-3e69-9cfc-8630f79f6225",
                                                "text": "„Als Kabarettist und Medizinjournalist setzen Sie sich schon sehr lange mit der Medizinersprache auseinander. Bei welchen Gelegenheiten flüchten sich die Kollegen Ihrer Meinung nach am liebsten ins Ärzte-Latein?“"
                                            },
                                            {
                                                "example_id": "0c2cb2b1-f79b-49dd-afa0-061b0ab34991",
                                                "sense_id": "cfab8d79-3f31-3e69-9cfc-8630f79f6225",
                                                "text": "„Kaum zu glauben, aber ich bin einer der wenigen Kabarettisten in Deutschland, die bei der Bundeswehr waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
