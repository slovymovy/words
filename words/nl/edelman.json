{
    "word_family": [
        "adel",
        "adellijk",
        "edelvrouw",
        "edeldom",
        "edelmoedig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28e2f66b-bd78-3674-af94-eedcf145584a",
                    "sense_definition": "man die van adel is of tot de aristocratie behoort",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>edelman</w> gaf een groot feest op zijn landgoed ter ere van zijn huwelijk.",
                            "target_lang_translations": {
                                "fr": "Le <w>noble</w> organisa une grande fête sur son domaine en l'honneur de son mariage."
                            }
                        },
                        {
                            "text": "In de middeleeuwen had een <w>edelman</w> vaak veel grond en politieke macht.",
                            "target_lang_translations": {
                                "fr": "Au Moyen Âge, un <w>gentilhomme</w> possédait souvent beaucoup de terres et de pouvoir politique."
                            }
                        }
                    ],
                    "synonyms": [
                        "aristocraat",
                        "edele",
                        "heer"
                    ],
                    "common_phrases": [
                        "rijke edelman"
                    ],
                    "target_lang_definitions": {
                        "fr": "Homme appartenant à la noblesse ou à l'aristocratie"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "noble",
                                "target_lang_sense_clarification": "personne appartenant à la noblesse"
                            },
                            {
                                "target_lang_word": "gentilhomme",
                                "target_lang_sense_clarification": "homme de naissance noble"
                            },
                            {
                                "target_lang_word": "aristocrate",
                                "target_lang_sense_clarification": "membre de l'aristocratie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce2dbf41-4e96-3586-a512-8eda0d1ca01c",
                    "sense_definition": "bepaalde soort kever uit de familie van de bladsprietkevers (Gnorimus nobilis)",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de wandeling door het oude bos zagen we een zeldzame <w>edelman</w> op een boomstam.",
                            "target_lang_translations": {
                                "fr": "Pendant la promenade dans la vieille forêt, nous avons aperçu un rare <w>gnorime noble</w> sur un tronc d'arbre."
                            }
                        },
                        {
                            "text": "De <w>edelman</w> valt op door zijn prachtige, groen metallieke glans.",
                            "target_lang_translations": {
                                "fr": "Le <w>gnorime noble</w> se remarque à son magnifique éclat vert métallique."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Espèce de coléoptère de la famille des scarabéidés (Gnorimus nobilis)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "gnorime noble",
                                "target_lang_sense_clarification": "insecte coléoptère vert métallique"
                            },
                            {
                                "target_lang_word": "barbot noble",
                                "target_lang_sense_clarification": "autre nom commun de ce coléoptère"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}