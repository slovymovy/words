                                ]
                            },
                            {
                                "target_word": "allure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccf3285f-0423-367f-8d6d-e7276c457759",
                                        "entry_id": "f33352cf-baaf-309f-8ec8-15cd8ee4bfa3",
                                        "glosses": [
                                            "To entice; to attract."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aae01a7f-6675-450e-872c-6ec3d8cda6ab",
                                                "sense_id": "ccf3285f-0423-367f-8d6d-e7276c457759",
                                                "text": "[They retained] their ſweet skill in wonted melody; / Which euer after they abuſd to ill, / T’allure weake trueillers, whom gotten they did kill."
                                            },
                                            {
                                                "example_id": "4235a034-da2f-4215-8047-ceb8d603ad4f",
                                                "sense_id": "ccf3285f-0423-367f-8d6d-e7276c457759",
                                                "text": "Injustice doth allure them; as the honour of their vertuous actions enticeth the good."
                                            },
                                            {
                                                "example_id": "dc85b1ce-f7ca-4a02-b62c-8daebb00932a",
                                                "sense_id": "ccf3285f-0423-367f-8d6d-e7276c457759",
                                                "text": "A tender voice his wondring ear allur'd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "allure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de03d3f9-c6aa-3206-b64c-497415355ec3",
                                        "entry_id": "703d1a36-c10d-33a2-90c0-4f0dbd311aa1",
                                        "glosses": [
                                            "Gait; bearing."
                                        ],
                                        "tags": [
