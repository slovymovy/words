        "nl-extract.jsonl": [
            {
                "entry_id": "71c3e713-5ae3-364f-9875-3ee222e07680",
                "word": "kandidatuur",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "cf70474b-9cac-498a-99bb-2284040f4288",
                        "entry_id": "71c3e713-5ae3-364f-9875-3ee222e07680",
                        "tags": [
                            "plural"
                        ],
                        "form": "kandidaturen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd63b034-f746-358f-9bd8-5d774852d54e",
                        "entry_id": "71c3e713-5ae3-364f-9875-3ee222e07680",
                        "glosses": [
                            "het voorgedragen worden voor, of het zelf dingen naar een ambt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "915ffbe9-646a-469e-a969-8a1dd18e5071",
                                "sense_id": "cd63b034-f746-358f-9bd8-5d774852d54e",
                                "text": "Michel Platini maakt zijn kandidatuur voor het voorzitterschap van de FIFA snel bekend."
                            },
                            {
                                "example_id": "bed6b956-451d-40f0-b1e5-b6c26c9cc89d",
                                "sense_id": "cd63b034-f746-358f-9bd8-5d774852d54e",
                                "text": "De kandidatuur van Omtzigt heeft de race ook weer helemaal op z'n kop gezet, stelt Van der Wulp. \"Het CDA is van oudsher een bestuurderspartij. Omtzigt is een kandidaat die juist strijdt tegen te veel macht voor de overheid. Ook hierdoor moeten de CDA-leden scherp kiezen.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "f9c50edf-db1e-3352-964a-6819ba7faa5f",
                        "entry_id": "71c3e713-5ae3-364f-9875-3ee222e07680",
                        "glosses": [
                            "universitaire opleiding in België vergelijkbaar met bachelor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b4392c-36a1-46ee-b40c-2c6ce97a0628",
                                "sense_id": "f9c50edf-db1e-3352-964a-6819ba7faa5f",
                                "text": "De KULAK was van meet af aan erg sterk verbonden met de Katholieke Universiteit Leuven, want in Kortrijk kon men enkel kandidaturen (vergelijkbaar met de huidige bachelorfase) volgen, in de meeste gevallen zelfs alleen maar het eerste of de eerste twee jaren. Hierna werd men verondersteld om het vervolg van de opleiding aan KU Leuven te volgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb2abed2-fe09-4412-a769-55b82e4d6a3c",
                        "source_entry_id": "71c3e713-5ae3-364f-9875-3ee222e07680",
                        "source_sense_id": "cd63b034-f746-358f-9bd8-5d774852d54e",
                        "source_sense_description": "het voorgedragen worden voor, of het zelf dingen naar een ambt",
                        "target_lang_word": "candidature",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "candidature",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94bb1698-a6f5-3ff4-a657-f3c5afde3010",
                                        "entry_id": "799f63b0-99a8-3088-b848-97691eee4ff6",
                                        "glosses": [
                                            "Poursuite que fait un candidat d’un titre, d’un emploi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b3715e5-facb-4985-bd1b-096b6434dc9f",
                                                "sense_id": "94bb1698-a6f5-3ff4-a657-f3c5afde3010",
                                                "text": "Annoncer sa candidature."
                                            },
                                            {
                                                "example_id": "d72f42c7-760a-4c6e-a10f-81daee6255d3",
                                                "sense_id": "94bb1698-a6f5-3ff4-a657-f3c5afde3010",
                                                "text": "Renoncer à la candidature."
                                            },
                                            {
                                                "example_id": "2cf98e45-c218-4bbd-9f41-2f28a4ce04b9",
                                                "sense_id": "94bb1698-a6f5-3ff4-a657-f3c5afde3010",
                                                "text": "Candidature officielle."
                                            },
                                            {
                                                "example_id": "bf88ebb4-b575-425a-9a26-5b90bcddf5ce",
                                                "sense_id": "94bb1698-a6f5-3ff4-a657-f3c5afde3010",
                                                "text": "Il a posé sa candidature pour devenir membre du groupe."
                                            },
                                            {
                                                "example_id": "ad9fcd5e-94c1-46ac-95dd-1bfaa90307e0",
                                                "sense_id": "94bb1698-a6f5-3ff4-a657-f3c5afde3010",
                                                "text": "Mais il se flattait, […], d'arriver toujours bon premier, sans jamais poser sa candidature, sur la liste quadriennale des conseillers municipaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20fdd200-c780-389d-a6fc-527292982aa3",
                                        "entry_id": "799f63b0-99a8-3088-b848-97691eee4ff6",
                                        "glosses": [
                                            "Premier grade universitaire qui s'effectue en deux ou trois ans."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf7702cb-f182-40fb-9212-05b0801314d5",
                                                "sense_id": "20fdd200-c780-389d-a6fc-527292982aa3",
                                                "text": "Je suis en première (année) candidature en langues."
                                            },
                                            {
                                                "example_id": "0807265a-5068-45a2-ae4e-f26bb1484ee8",
                                                "sense_id": "20fdd200-c780-389d-a6fc-527292982aa3",
                                                "text": "Les candidatures ont été en grande partie remplacées par les baccalauréats en vertu du décret européen de Bologne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
