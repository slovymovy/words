                        "examples": [
                            {
                                "example_id": "15c5f0f2-aedd-476d-9add-d95d28f07d26",
                                "sense_id": "4639e8a9-7bd1-39f9-a12b-2e34077f7861",
                                "text": "Afin de déverrouiller ou de défiligraner la séquence image ou audio intégrée, on utilise une clé unique qui est dérivée de manière adaptative des emplacements spatiaux d'enregistrement des seuils des énergies des transformées ac."
                            },
                            {
                                "example_id": "f13f95ca-b078-4d6b-a09d-883264208419",
                                "sense_id": "4639e8a9-7bd1-39f9-a12b-2e34077f7861",
                                "text": "Prend en charge le réarrangement du noircissement, défiligrane, adapté pour tous les amateurs d'apprentissage."
                            },
                            {
                                "example_id": "2d2ce7ab-8934-4d1b-b36d-bc120bda394a",
                                "sense_id": "4639e8a9-7bd1-39f9-a12b-2e34077f7861",
                                "text": "Avec le film \"50 Nuances de Grey\", on réussit ainsi à \"défiligraner\" tout l'absurde des situations romancées par E.L. James et portées à l'écran, nous donnant presque l'impression d'être des Mozart de la perversion perceptive et imaginaire face à la piètre composition qui nous est jouée."
                            }
                        ]
                    }
