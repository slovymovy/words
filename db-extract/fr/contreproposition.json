                        "examples": [
                            {
                                "example_id": "adff2005-4fd5-4305-8dda-6e0a6870c457",
                                "sense_id": "8717c6e5-67fb-3092-8523-1c82bf134b6d",
                                "text": "Les contrepropositions de l’Allemagne au projet du traité de Versailles."
                            },
                            {
                                "example_id": "1d6a6b03-7b6d-4f2a-a0e2-09d5011e0afc",
                                "sense_id": "8717c6e5-67fb-3092-8523-1c82bf134b6d",
                                "text": "Ils ont écrit au bureau du Premier ministre samedi pour faire des contrepropositions concernant la réforme éléctorale."
                            },
                            {
                                "example_id": "a0835c81-855f-488e-9300-722a94d48a97",
                                "sense_id": "8717c6e5-67fb-3092-8523-1c82bf134b6d",
                                "text": "Sollicité par la direction des affaires civiles et du sceau du Ministère de la Justice pour participer à la consultation publique relative à l’avant-projet de loi portant réforme de la responsabilité civile, le CEDCACE a, à nouveau, invité ses membres, enseignants-chercheurs confirmés comme doctorants, à exposerdes analyses et avancer des contrepropositions."
                            }
                        ]
                    }
