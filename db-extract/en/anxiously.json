                                    {
                                        "sense_id": "fcec7355-5a3d-320a-b189-5a25833a3fc7",
                                        "entry_id": "7a587d82-7ff3-3a58-9c87-cfce9f2a58ea",
                                        "glosses": [
                                            "mit Angst und/oder Sorge erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a95ce1c7-8fa2-485b-8802-8ffb4304a31b",
                                                "sense_id": "fcec7355-5a3d-320a-b189-5a25833a3fc7",
                                                "text": "Bange Träume quälten ihn."
                                            },
                                            {
                                                "example_id": "e4505b41-f5b5-42ff-9991-633c99c29be5",
                                                "sense_id": "fcec7355-5a3d-320a-b189-5a25833a3fc7",
                                                "text": "Ihr ist bang(e) zumute."
                                            },
                                            {
                                                "example_id": "cd6be0ae-1f78-47b3-ba33-8b37cae51210",
                                                "sense_id": "fcec7355-5a3d-320a-b189-5a25833a3fc7",
                                                "text": "Die bange Frage nach dem \"Wo bin ich?\" war nach zwei Stunden Flug geklärt."
                                            },
                                            {
                                                "example_id": "f9725824-e15b-444a-9b7c-5155c2b1cf99",
                                                "sense_id": "fcec7355-5a3d-320a-b189-5a25833a3fc7",
                                                "text": "Es wird einem angst und bange, wenn man bedenkt, dass diese \"Massen\" an Studenten einmal die Zukunft des Landes bestimmen sollen"
                                            },
                                            {
                                                "example_id": "2f5d8061-b7e8-4916-9b9f-5e7e26c2ce1e",
                                                "sense_id": "fcec7355-5a3d-320a-b189-5a25833a3fc7",
                                                "text": "Die Eltern waren bang nach ihrem Kinde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
