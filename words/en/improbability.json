                    "sense_id": "e935e6ce-78a0-3f5d-8426-6783e8b6ccd3",
                    "sense_definition": "The quality or state of being unlikely to happen or be true.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "likelihood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the sheer <w>improbability</w> of winning the lottery, millions of people buy tickets every week.",
                            "target_lang_translations": {
                                "ru": "Несмотря на абсолютную <w>маловероятность</w> выигрыша в лотерею, миллионы людей покупают билеты каждую неделю."
                            }
                        },
                        {
                            "text": "The scientist highlighted the extreme <w>improbability</w> that life could develop under such harsh conditions.",
                            "target_lang_translations": {
                                "ru": "Учёный подчеркнул крайнюю <w>невероятность</w> того, что жизнь могла развиться в столь суровых условиях."
                            }
                        }
                    ],
                    "synonyms": [
                        "unlikelihood",
                        "implausibility"
                    ],
                    "antonyms": [
                        "probability",
                        "likelihood"
                    ],
                    "common_phrases": [
                        "sheer improbability",
                        "extreme improbability"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство или состояние чего-либо, что вряд ли произойдёт или окажется правдой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невероятность",
