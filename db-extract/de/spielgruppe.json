                ],
                "senses": [
                    {
                        "sense_id": "ecf5b6f4-3350-3fa1-b1ae-bc6f2aa4a604",
                        "entry_id": "1985ff12-25aa-3e3e-bfa8-f5d7f9b3ec23",
                        "glosses": [
                            "locker gefügte, zusammengehörige, aber nicht, wie etwa in einer Spielmannschaft, speziell strukturierte Einheit von Spielern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ddfea2b-410a-47d0-afb1-3b18098a5289",
                                "sense_id": "ecf5b6f4-3350-3fa1-b1ae-bc6f2aa4a604",
                                "text": "„Neben neuen Spielideen wurde auch eine Reihe von Formen aus dem Bereich der Kleinen Spiele mit einbezogen, die in zahlreichen Spielgruppen schon seit langem einen festen Platz haben.“"
                            },
                            {
                                "example_id": "83ac934b-19b0-49da-83cf-3209eb88c500",
                                "sense_id": "ecf5b6f4-3350-3fa1-b1ae-bc6f2aa4a604",
                                "text": "„Geschwister bilden vorzugsweise auch im Kindergarten eigene Spielgruppen oder gehören gern derselben Spielgruppe an.“"
                            },
                            {
                                "example_id": "26d6e7f7-1e66-490a-842d-62c7c17c38fc",
                                "sense_id": "ecf5b6f4-3350-3fa1-b1ae-bc6f2aa4a604",
                                "text": "„Diese Sicht der Konflikte kann vertieft werden, wenn das konkrete Sozialverhalten der Kinder mit berücksichtigt wird. [..] Dominiert es immer in seiner Spielgruppe oder befindet es sich unter den Mitläufern?“"
                            },
                            {
                                "example_id": "f1984309-6824-4fac-89dd-90f12fb52a8f",
                                "sense_id": "ecf5b6f4-3350-3fa1-b1ae-bc6f2aa4a604",
                                "text": "„Ein Spiel zum Beispiel auf drei oder vier große Spielziele gleichzeitig, bei dem ferner mehrere Bälle mit Fuß und Hand gespielt werden dürfen und mehrere Spielgruppen zu gleicher Zeit das gesamte Spielfeld benutzen können, führt zu der Einsicht, dass nur durch bestimmte Einschränkungen ein wirkliches Gruppenspiel entsteht.“"
                            },
                            {
                                "example_id": "24c40dad-4660-4686-8e85-71f521058006",
                                "sense_id": "ecf5b6f4-3350-3fa1-b1ae-bc6f2aa4a604",
                                "text": "„Der Einzelne muss seine Persönlichkeit und seine Spiellaune in die Spielgruppe einbringen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
