                            {
                                "example_id": "d2db0b8d-8a76-4299-be64-4abe05d74b8e",
                                "sense_id": "711e7f50-ba34-37bc-ada5-c897177193f3",
                                "text": "„In Bairiki befinden sich die meisten Gebäude der Regierung von Kiribati, weshalb der Ort von einigen, vor allem deutschsprachigen, Quellen auch als Hauptstadt des Inselstaates bezeichnet wird. Die Hauptstadt ist jedoch der Distrikt South Tarawa, der Bairiki und die benachbarten Inseln einschließt.“"
                            }
                        ],
