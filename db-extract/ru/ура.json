                        "source_sense_id": "997703aa-1d48-3391-8029-1dbdb89a2284",
                        "target_lang_word": "hurrah",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hurrah",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17a17994-2ff5-33c6-96c6-354266062415",
                                        "entry_id": "4d32c975-2ccc-3078-91be-025412e64542",
                                        "glosses": [
                                            "Variante orthographique de hourra."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33d4c3d0-dd16-4dc8-a36f-abf83bd0d1a3",
                                                "sense_id": "17a17994-2ff5-33c6-96c6-354266062415",
                                                "text": "On passe à Olten, mais on ne s’y arrête guère. C’est le point de jonction de presque toutes les lignes ferrées de la Suisse …. Tout le monde y passe, et personne n’y arrête plus d’un quart d’heure. Hurrah ! Les voyageurs vont vite !"
                                            },
                                            {
                                                "example_id": "22fab635-bbdb-40e7-b4b3-d08203998121",
                                                "sense_id": "17a17994-2ff5-33c6-96c6-354266062415",
                                                "text": "[…], le dernier lutteur s'avance au pas de tir; il prononce le mot sacramental, vise rapidement, jette son coup... le pigeon est tombé ! hurrah ! des cris retentissent , des larmes coulent, mais les flots du champagne bien davantage."
                                            },
                                            {
                                                "example_id": "66b5fb31-c525-4604-b5e0-3df19f9a2471",
                                                "sense_id": "17a17994-2ff5-33c6-96c6-354266062415",
                                                "text": "\" En ce moment Lucien aperçut les visages attristés de Michel Chrestien, de Joseph Brideau et de Fulgence Ridal qui prirent leurs chapeaux et sortirent au milieu d'un hurrah d'imprécations.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hurrah",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96fb184f-7efb-3b8a-9fd7-4f30027d16bc",
                                        "entry_id": "545986a4-e5be-3082-88e4-7dd43d89f17c",
                                        "glosses": [
                                            "Variante orthographique de hourra."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6d1f46f-0dec-4f21-96be-984fcbaa5e19",
                                                "sense_id": "96fb184f-7efb-3b8a-9fd7-4f30027d16bc",
                                                "text": "C’était pour Mrs. Paulina Barnett que le grand salon de la factorerie retentissait de joyeux hurrahs."
                                            },
                                            {
                                                "example_id": "8cd694a1-f3da-4036-a8f4-e0dac3c920e0",
                                                "sense_id": "96fb184f-7efb-3b8a-9fd7-4f30027d16bc",
                                                "text": "Les applaudissements, les hurrahs, les « hip ! hip ! » se succédèrent pendant plus d’un quart d’heure."
                                            },
                                            {
                                                "example_id": "534f245d-7d2f-456c-9c01-92b81cb2cfd2",
                                                "sense_id": "96fb184f-7efb-3b8a-9fd7-4f30027d16bc",
                                                "text": "Enfin les derniers coups de sifflet déchirent l’air, les wagons s’ébranlent, et un formidable hurrah salue à son départ le train du Grand-Transasiatique."
                                            },
                                            {
                                                "example_id": "864953c1-c240-44ad-9f0f-bdade631cfdc",
                                                "sense_id": "96fb184f-7efb-3b8a-9fd7-4f30027d16bc",
                                                "text": "— Hip ! hip ! hurrah ! un ban pour le président…"
                                            },
                                            {
                                                "example_id": "0736925b-b7af-4b34-b26c-65ba5dc44e58",
                                                "sense_id": "96fb184f-7efb-3b8a-9fd7-4f30027d16bc",
                                                "text": "Après un hurrah de mort et de triomphe, la ribouldingue a cessé d’elle-même, brusquement."
                                            },
                                            {
                                                "example_id": "25e19907-2a33-4311-b8c8-c1065210054f",
                                                "sense_id": "96fb184f-7efb-3b8a-9fd7-4f30027d16bc",
                                                "text": "Tout à coup un hurrah frénétique jaillit de la plage. C’étaient les chasseurs canadiens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
