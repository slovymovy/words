                "senses": [
                    {
                        "sense_id": "4a6c3dea-ae38-3e30-a660-631a2d952d03",
                        "entry_id": "b470c29a-a517-34da-aebd-e7036e10111b",
                        "glosses": [
                            "Pluriel de miette."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "127f224b-960d-4303-a57e-ab7a19266009",
                                "sense_id": "4a6c3dea-ae38-3e30-a660-631a2d952d03",
                                "text": "Je me beurre une supertartine, attention aux petites miettes, pour mon supercafé au lit de superman."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fea64b3-72a4-4fed-871f-9a7cda80fb65",
                        "source_entry_id": "b470c29a-a517-34da-aebd-e7036e10111b",
                        "source_sense_id": "4a6c3dea-ae38-3e30-a660-631a2d952d03",
                        "source_sense_description": "[1]",
                        "target_lang_word": "Krümel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krümel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec49fd2e-563d-3787-adab-af71aae87992",
                                        "entry_id": "9fa2af38-2a8b-3b6f-8dff-b2652dc1a4f9",
                                        "glosses": [
                                            "kleines, abgebröseltes Stück; insbesondere von Gebackenem wie Brot, Kuchen, Keksen, Chips, aber auch von festen Stoffen wie Putz, Gips und dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df18ef4c-6148-425a-b8f9-ff0a332ee92d",
                                                "sense_id": "ec49fd2e-563d-3787-adab-af71aae87992",
                                                "text": "Der Nachteil beim Frühstück im Bett ist bekanntlich, dass es danach nicht mehr sehr gemütlich ist, da die vielen Krümel pieksen."
                                            },
                                            {
                                                "example_id": "030bff03-9ce0-4268-b61b-eab804959da7",
                                                "sense_id": "ec49fd2e-563d-3787-adab-af71aae87992",
                                                "text": "„Die Tassen standen noch auf dem Tisch, an dem ich mit Wolf gesessen hatte, und auf meinem Teller lagen noch Krümel von den Brötchen.“"
                                            },
                                            {
                                                "example_id": "2dedf116-3a49-451d-81e0-95d82cdae612",
                                                "sense_id": "ec49fd2e-563d-3787-adab-af71aae87992",
                                                "text": "„Er nahm die Zigarette aus dem Munde, besah sie und spuckte ein paar Krümel Tabak aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9fb7e458-309a-3397-abc3-7666cf888e99",
                                        "entry_id": "9fa2af38-2a8b-3b6f-8dff-b2652dc1a4f9",
                                        "glosses": [
                                            "ein winziges Stück von etwas"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b87762f-8361-4f00-b141-dd809acc1b3d",
                                                "sense_id": "9fb7e458-309a-3397-abc3-7666cf888e99",
                                                "text": "Das Essen muss unseren Gästen wirklich gut geschmeckt haben: Es ist kein Krümel übrig geblieben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aa4d1a69-68cd-3936-884e-f6338c0430f8",
                                        "entry_id": "9fa2af38-2a8b-3b6f-8dff-b2652dc1a4f9",
                                        "glosses": [
                                            "Kosename für ein kleines Kind"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66faec59-d45c-4dc3-959b-04d422aedb0f",
                                                "sense_id": "aa4d1a69-68cd-3936-884e-f6338c0430f8",
                                                "text": "Was, der Krümel spielt schon Golf?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
