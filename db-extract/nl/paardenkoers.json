                        "examples": [
                            {
                                "example_id": "63dc696b-568b-4d3a-b0a6-95092cfef110",
                                "sense_id": "3bbe55b9-cf98-3571-9e76-e056bc12b219",
                                "text": "Winkel Koerse viert de 160ste editie met een eigen Champagne. Het moet een echt verzamelobject worden, met een aangepaste capsule en zes verschillende etiketten. Op die etiketten staan foto's van de voorbije edities. ‘We wilden onze paardenkoers al langer een eigen cachet te geven’, zegt Krist Vandemoortele. Na het Steene Molen Bier dat in 2012 op de markt kwam, lanceert de organisatie daarom nu een eigen champagne."
                            },
                            {
                                "example_id": "e85bdfa2-8c3c-4d22-948d-a46a0063485d",
                                "sense_id": "3bbe55b9-cf98-3571-9e76-e056bc12b219",
                                "text": "Er wordt dit jaar scherp op de veiligheid van de paarden gelet. De hindernissen op de renbaan in Aintree stonden als erg gevaarlijk bekend. 21 paarden stierven hier tussen 2001 en 2014. Daarna werden de hindernissen aangepast. De wereldberoemde paardenkoers Grand National begint zaterdag op het Aintree-terrein."
                            }
                        ]
                    }
