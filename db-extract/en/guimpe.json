                    },
                    {
                        "sense_id": "0e757ef3-dd7f-3e36-812f-3323ac23eec9",
                        "entry_id": "e8d335a9-3858-39be-b526-04d940d8d9ba",
                        "glosses": [
                            "A kind of short, high-necked blouse with sleeves of the late Victorian era, designed to be worn under a low-cut dress, jumper, or pinafore dress."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cbee784b-a267-4855-95de-958a719a8da2",
                                "sense_id": "0e757ef3-dd7f-3e36-812f-3323ac23eec9",
                                "text": "Smocking done in colors on fine white batiste, silk mull, or nainsook makes pretty guimpes and dresses for children and very smart blouses for women."
                            }
                        ]
                    },
                    {
                        "sense_id": "3aadaba0-c3d9-396e-9757-b8c6337f527c",
                        "entry_id": "e8d335a9-3858-39be-b526-04d940d8d9ba",
                        "glosses": [
                            "A kind of short chemisette or yoke insert made of lace, embroidery, or the like, worn with a low-necked dress."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5564c8c2-2a7e-3e34-9d56-9fa6eb2fb17e",
                        "entry_id": "e8d335a9-3858-39be-b526-04d940d8d9ba",
                        "glosses": [
                            "A wimple; a wide, stiffly starched cloth that covers the neck and shoulders, as part of the habit of nuns of certain orders."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "69d23d5d-149d-45b6-80e8-9426497d185b",
                                "sense_id": "5564c8c2-2a7e-3e34-9d56-9fa6eb2fb17e",
                                "text": "All the nuns at the convent wore plain blouses and skirts except for Sister Edgar, who had permission from the motherhouse to fit herself out in the old things with the arcane names, the wimple, cincture and guimpe."
                            }
                        ]
                    }
