            "senses": [
                {
                    "sense_id": "97039082-4e11-37ff-ac16-833358846c36",
                    "sense_definition": "A person who is excessively proper and easily offended by sexual matters.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is such a <w>prude</w> that she refuses to watch any movie with a kissing scene.",
                            "target_lang_translations": {
                                "es": "Es tan <w>mojigata</w> que se niega a ver cualquier película con una escena de besos."
                            }
                        },
                        {
                            "text": "Do not be such a <w>prude</w> and just enjoy the party with everyone else.",
                            "target_lang_translations": {
                                "es": "No seas tan <w>mojigato</w> y simplemente disfruta de la fiesta con los demás."
                            }
                        }
                    ],
                    "synonyms": [
                        "puritan",
                        "moralist"
                    ],
                    "antonyms": [
                        "libertine"
                    ],
                    "target_lang_definitions": {
                        "es": "Persona excesivamente pudorosa, recatada o que se escandaliza fácilmente con asuntos sexuales o morales."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mojigato",
                                "target_lang_sense_clarification": "masculino, persona puritana o remilgada"
                            },
                            {
                                "target_lang_word": "mojigata",
                                "target_lang_sense_clarification": "femenino, persona puritana o remilgada"
                            },
                            {
                                "target_lang_word": "remilgado",
                                "target_lang_sense_clarification": "persona que muestra excesiva delicadeza o pudor"
                            },
                            {
                                "target_lang_word": "puritano",
                                "target_lang_sense_clarification": "persona de moral estricta e intolerante"
                            }
                        ]
                    }
                }
            ]
        },
