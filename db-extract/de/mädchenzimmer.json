                "senses": [
                    {
                        "sense_id": "807afb8a-7063-3a32-bd43-c24620acdd53",
                        "entry_id": "cb4e24c3-c464-33f5-9fd1-dec4e59ec63a",
                        "glosses": [
                            "Zimmer von einem oder mehreren Mädchen in einem Haus oder einer Wohnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80098507-29fd-448d-934a-1f662b824642",
                                "sense_id": "807afb8a-7063-3a32-bd43-c24620acdd53",
                                "text": "„Unterdessen war nicht nur die Kunde von der Ankunft des Ministers und seines Sohnes bis ins Mädchenzimmer gelangt, sondern auch das Aeussere der beiden war schon Gegenstand eingehender Schilderungen gewesen.“"
                            }
                        ],
