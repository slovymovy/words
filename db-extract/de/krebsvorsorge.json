                "senses": [
                    {
                        "sense_id": "b3e5df12-b8e7-392a-a4d4-5e0393cb28e2",
                        "entry_id": "bb93b289-db5e-30dd-ba03-21cdc575089d",
                        "glosses": [
                            "Vorsorge mittels regelmäßiger Untersuchungen zur Früherkennung von Krebs"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "ed6aa527-d226-4c7e-b4df-28a06464a5dd",
                                "sense_id": "b3e5df12-b8e7-392a-a4d4-5e0393cb28e2",
                                "text": "„Bei der gegenwärtig üblichen Krebsvorsorge werden Darmpolypen, gutartige Wucherungen der Darmschleimhaut, gefunden und entfernt, bevor sie zu Darmkrebs werden können.“"
                            },
                            {
                                "example_id": "332cdcc3-a552-4b01-9d18-19e2f209b0e8",
                                "sense_id": "b3e5df12-b8e7-392a-a4d4-5e0393cb28e2",
                                "text": "„Nie verpaßte sie sowieso sämtliche Abstrich-Gelegenheiten, Krebsvorsorgen und was es da alles gab.“"
                            },
                            {
                                "example_id": "22de67d9-2806-45bf-8732-4533681338ba",
                                "sense_id": "b3e5df12-b8e7-392a-a4d4-5e0393cb28e2",
                                "text": "„Die Inhalte der Gesundheitsuntersuchung umfassen: […] Beratung (z.B. Hinweise auf Abbau gesundheitsschädigenden Verhaltens, regelmäßige Krebsvorsorgen und die Augendruckmessung alle zwei Jahre).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
