                "senses": [
                    {
                        "sense_id": "7b3b4b37-1a47-3c9b-827f-f92f0fc8b1c1",
                        "entry_id": "1e502f5b-bfbe-3e3f-85e8-14b85013675c",
                        "glosses": [
                            "oft an einem Gewässer oder einem Schwimmbad gelegene Grünfläche, auf der man sich hinlegen und ausruhen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfe2db5a-6e82-4363-b5d8-4b32b13d03e9",
                                "sense_id": "7b3b4b37-1a47-3c9b-827f-f92f0fc8b1c1",
                                "text": "„Die Wassertemperatur beträgt angenehme 23 Grad, die Bahnen im 50-Meter-Becken sind für Freizeit- und Sportschwimmer unterteilt, auf der Liegewiese spenden Sonnenschirme Schatten.“"
                            },
                            {
                                "example_id": "93326462-4b0d-4e7f-9f04-fd42c6802c2a",
                                "sense_id": "7b3b4b37-1a47-3c9b-827f-f92f0fc8b1c1",
                                "text": "„Ich wurde übermütig, tat so, als gehörte das alles auch mir. Das Schwimmbecken, das Wasser und die Menschen darin, die Liegewiese, das angrenzende Wäldchen, die Straßen, auf denen wir mit unseren Fahrrädern im Slalom hergefahren waren, vorbei an der Kirche, in der ich meinen Freundinnen beim Schulgottesdienst freitags beim Oblatenessen zusah.“"
                            },
                            {
                                "example_id": "afbf9660-3b9e-4555-9d29-f825cb468f3d",
                                "sense_id": "7b3b4b37-1a47-3c9b-827f-f92f0fc8b1c1",
                                "text": "„Neben dem herrschaftlichen Haus gab es sogar eine richtige Liegewiese mit einem kleinen Brunnen und Sonnenschirmen und Liegestühlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "762679a6-3dc6-42dc-9564-16d2eea67658",
                        "source_entry_id": "1e502f5b-bfbe-3e3f-85e8-14b85013675c",
                        "source_sense_id": "7b3b4b37-1a47-3c9b-827f-f92f0fc8b1c1",
                        "source_sense_description": "Wiese zum Relaxen",
                        "target_lang_word": "pelouse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pelouse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65ea2c08-c083-3c14-a91b-06ab812cc3d6",
                                        "entry_id": "74d97e32-f7d9-3df7-84ca-1e1b08e039a7",
                                        "glosses": [
                                            "Végétation de très faible hauteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f1c6eed-44a8-4210-9b01-61a45a4f1e8d",
                                                "sense_id": "65ea2c08-c083-3c14-a91b-06ab812cc3d6",
                                                "text": "Le pourcentage relativement élevé des Chaméphytes suffirait à lui seul à caractériser la végétation de ces pelouses xérothermiques constituées essentiellement par des espèces subligneuses (Teucrium Chamaedrys, Helianthemum, Thymus Serpyllum) dont l’assimilation est continue."
                                            },
                                            {
                                                "example_id": "893baa3b-96bf-4381-9fce-6c1492408600",
                                                "sense_id": "65ea2c08-c083-3c14-a91b-06ab812cc3d6",
                                                "text": "Citons par exemple la pelouse à Cynosurus, qui peut être envahie par la lande à Genêts et donner ensuite le bois de Chêne sessile."
                                            },
                                            {
                                                "example_id": "27cc4c47-e8e2-442b-b3e4-479d9c3446cc",
                                                "sense_id": "65ea2c08-c083-3c14-a91b-06ab812cc3d6",
                                                "text": "Ces pelouses particulièrement riches en espèces méditerranéo-montagnardes constituent une magnifique parure de notre montagne. Elles font partie de l’alliance de l’Ononidion striatae connue surtout dans les Cévennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4e654b3-a270-3eab-8ac6-1fd4e31f8876",
                                        "entry_id": "74d97e32-f7d9-3df7-84ca-1e1b08e039a7",
                                        "glosses": [
                                            "Terrain couvert de gazon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698d3190-2925-41a2-ba8e-866d741aeb24",
                                                "sense_id": "f4e654b3-a270-3eab-8ac6-1fd4e31f8876",
                                                "text": "Quelques chiens, des braques hongrois, gambadent sur les pelouses."
                                            },
                                            {
                                                "example_id": "ec26260b-ceeb-49f4-942e-930d386fe9f1",
                                                "sense_id": "f4e654b3-a270-3eab-8ac6-1fd4e31f8876",
                                                "text": "La barrière de ciment qui entourait les pelouses était facile à franchir."
                                            },
                                            {
                                                "example_id": "171376e4-e5c9-46cb-a84d-915690f7f078",
                                                "sense_id": "f4e654b3-a270-3eab-8ac6-1fd4e31f8876",
                                                "text": "Soigner son gazon équivaut à prendre soin de son corps, le plus souvent masculin, dont il faut surveiller tout ce qui dépasse : il faut tailler son gazon comme les cheveux, la barbe ou la moustache d’un homme – qui doivent être entretenus, coupés, impeccables. Better Homes & Garden compare une pelouse qui n’a pas été tondue à un homme qui ne s’est pas rasé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f03211eb-2927-3702-92b7-89c87dac3b68",
                                        "entry_id": "74d97e32-f7d9-3df7-84ca-1e1b08e039a7",
                                        "glosses": [
                                            "Terrain de sport couvert de gazon."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24148b57-bd27-452e-afd9-2fe30b6ea56c",
                                                "sense_id": "f03211eb-2927-3702-92b7-89c87dac3b68",
                                                "text": "La tendance s'est confirmé ce mercredi puisque l’équipe galicienne du Deportivo a remporté la victoire (3-1) sur sa pelouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c03df7-eced-3299-adfa-d416dcb2148b",
                                        "entry_id": "74d97e32-f7d9-3df7-84ca-1e1b08e039a7",
                                        "glosses": [
                                            "Partie de l’hippodrome, généralement gazonnée, sur laquelle le public est admis."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
