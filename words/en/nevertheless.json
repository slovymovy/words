    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "368f03f1-cfb8-3653-9597-1b04d6763389",
                    "sense_definition": "In spite of what has just been mentioned; however.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather was extremely cold, but we <w>nevertheless</w> enjoyed our trip to the mountains.",
                            "target_lang_translations": {
                                "ru": "Погода была очень холодной, но мы <w>тем не менее</w> получили удовольствие от поездки в горы.",
                                "zh": "天气非常冷，但我们<w>还是</w>很享受这次山中之旅。"
                            }
                        },
                        {
                            "text": "He knew the task would be difficult; <w>nevertheless</w>, he promised to finish it by Friday.",
                            "target_lang_translations": {
                                "ru": "Он знал, что задача будет сложной; <w>тем не менее</w> он пообещал закончить её к пятнице.",
                                "zh": "他知道这项任务很困难，但<w>尽管如此</w>，他还是承诺在周五前完成。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nonetheless",
                        "however",
                        "still",
                        "even so",
                        "yet",
                        "all the same",
                        "notwithstanding"
                    ],
                    "antonyms": [
                        "therefore",
                        "thus"
                    ],
                    "common_phrases": [
                        "but nevertheless",
                        "nevertheless true",
                        "nevertheless important"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несмотря на то, что было упомянуто ранее; однако.",
                        "zh": "尽管前面提到了某事，但仍然如此；然而。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тем не менее",
                                "target_lang_sense_clarification": "основной, стилистически нейтральный перевод"
                            },
                            {
                                "target_lang_word": "однако",
                                "target_lang_sense_clarification": "синоним, выражающий противопоставление"
                            },
                            {
                                "target_lang_word": "всё-таки",
                                "target_lang_sense_clarification": "усилительная частица, ближе к значению «всё же»"
                            },
                            {
                                "target_lang_word": "несмотря на это",
                                "target_lang_sense_clarification": "фраза, поясняющая смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "然而",
                                "target_lang_sense_clarification": "用于转折，表示尽管有前述情况，但结果依然如此"
                            },
                            {
                                "target_lang_word": "尽管如此",
                                "target_lang_sense_clarification": "强调在某种不利条件下依然保持某种状态或结果"
                            },
                            {
                                "target_lang_word": "还是",
                                "target_lang_sense_clarification": "口语中常用的转折词，表示依然"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}