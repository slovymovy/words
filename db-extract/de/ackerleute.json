                "senses": [
                    {
                        "sense_id": "ae4a83ed-615e-32c6-a584-9df54914583c",
                        "entry_id": "cefb2113-9d2e-3c06-8a2f-5984d7dab40e",
                        "glosses": [
                            "Zusatzplural von Ackermann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7721fef1-9a7a-42f1-b2db-ba13d5c791ed",
                                "sense_id": "ae4a83ed-615e-32c6-a584-9df54914583c",
                                "text": "„Von der vollbäuerlichen Gruppe der Ackerleute unterschieden sich die Kötter durch mindere Verpflichtungen gegenüber den Grundherren aber auch durch mindere Nutzungsrechte in der Allmende.“"
                            },
                            {
                                "example_id": "64266f09-7564-4d4d-9502-c9e9206b39ca",
                                "sense_id": "ae4a83ed-615e-32c6-a584-9df54914583c",
                                "text": "„Das mehrfach modifizierte Pachtrecht hieß Meierrecht; nach ihm wurden die Ackerleute seit dem 17. Jahrhundert Meier genannt.“"
                            },
                            {
                                "example_id": "2af19f90-e1b7-4221-bc23-f1ffa5a603ae",
                                "sense_id": "ae4a83ed-615e-32c6-a584-9df54914583c",
                                "text": "„Das wird noch deutlicher, wenn errechnet wird, wie viel Taler je Morgen aufzubringen waren. Dann entfielen bei den Ackerleuten auf einen Morgen 0,17 Taler, bei den Halbspännern 0,38 Taler, bei den Vollkötern 0,82 Taler und bei den Halbkötern 0 ,97 Taler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
