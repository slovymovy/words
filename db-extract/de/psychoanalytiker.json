                        ],
                        "form": "die Psychoanalytiker"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c076dd3b-99c7-34b6-9517-05e3c5249a2c",
                        "entry_id": "67b8349b-bf4e-3046-b8f8-c62b01f26ece",
                        "glosses": [
                            "Facharzt oder Psychologe, der Patienten mit Psychoanalyse behandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cbf7177-0435-459e-a2fc-57839cff6d15",
                                "sense_id": "c076dd3b-99c7-34b6-9517-05e3c5249a2c",
                                "text": "„Sie sagte, dass sich seit damals ja viel in der Wissenschaft getan hätte, und musste sich ziemlich beherrschen, sodass ich nicht umhinkam zu denken, dass die gewöhnlichen Pillenpsychiater diese wenigen Psychoanalytiker wohl in die Isolation getrieben hatten.“"
                            },
                            {
                                "example_id": "13417832-19bf-4c2c-9843-1aec9e458a4d",
                                "sense_id": "c076dd3b-99c7-34b6-9517-05e3c5249a2c",
                                "text": "„Ein praktischer Arzt, der einen seelisch erkrankten Patienten zum Psychoanalytiker geschickt hatte, erkundigte sich nach einem halben Jahr, wie es dem Schmerzenskind ginge."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f26a320c-84cd-4e55-bbea-cef67ab4d575",
                        "source_entry_id": "67b8349b-bf4e-3046-b8f8-c62b01f26ece",
                        "source_sense_id": "c076dd3b-99c7-34b6-9517-05e3c5249a2c",
                        "source_sense_description": "Facharzt oder Psychologe, der Patienten mit Psychoanalyse behandelt",
                        "target_lang_word": "psychoanalyst",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychoanalyst",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3862a356-fb1f-3d43-b6e6-62aedfc7f82d",
                                        "entry_id": "831bc993-c57e-36fe-9dcb-c24d9a0500a5",
                                        "glosses": [
                                            "A practitioner of psychoanalysis."
