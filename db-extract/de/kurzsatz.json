                "senses": [
                    {
                        "sense_id": "4f7929e0-5e12-3469-af20-c0aadf31da2b",
                        "entry_id": "71dd4fea-6f12-38cf-8ec2-fa162307fd8f",
                        "glosses": [
                            "unvollständiger Satz"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "18b928e3-dd66-473a-8276-3933b3a6b13c",
                                "sense_id": "4f7929e0-5e12-3469-af20-c0aadf31da2b",
                                "text": "Kurzsätze sind Sätze, denen ein Satzteil fehlt, der notwendig wäre, um einen vollständigen Satz zu bilden."
                            },
                            {
                                "example_id": "4c3827dc-2938-45de-94da-8ffdb7330b9e",
                                "sense_id": "4f7929e0-5e12-3469-af20-c0aadf31da2b",
                                "text": "Äußerungen wie „Alle Mann drei Schritte zurück!“ sind Kurzsätze."
                            },
                            {
                                "example_id": "32e07535-0f47-437d-b448-d74a30e77ac0",
                                "sense_id": "4f7929e0-5e12-3469-af20-c0aadf31da2b",
                                "text": "Bünting & Bergenholtz definieren: „Kurzsatz (Satzellipse): unvollständiger einfacher Satz, insofern ungrammatisch, aber in Texten häufig zu finden;…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bc0b3ee5-f4dd-337a-940a-19fa94b3fcb1",
                        "entry_id": "71dd4fea-6f12-38cf-8ec2-fa162307fd8f",
                        "glosses": [
                            "kurzer Satz"
                        ],
                        "tags": [
                            "speziell Stilistik"
                        ],
                        "examples": [
                            {
                                "example_id": "e7b6efb3-43f6-4ca2-abba-08212e57e40a",
                                "sense_id": "bc0b3ee5-f4dd-337a-940a-19fa94b3fcb1",
                                "text": "„Im 19. Jahrhundert hat der Amerikaner Ralph Waldo Emerson den Kurzsatz oft wahllos angewandt. Seine Sätze sind durchschnittlich elf Worte lang.“"
                            },
                            {
                                "example_id": "479cf0de-5e1c-4617-a72c-0ca5266ca0bf",
                                "sense_id": "bc0b3ee5-f4dd-337a-940a-19fa94b3fcb1",
                                "text": "„In der Regel umfassen Kurzsätze 3 - 5 Satzglieder, nämlich die grammatisch notwendigen und die informativ wichtigsten (z. B. Zeit- und Ortsangaben).“"
                            },
                            {
                                "example_id": "1cd89fd4-c047-47fe-89a3-96b489e7fb03",
                                "sense_id": "bc0b3ee5-f4dd-337a-940a-19fa94b3fcb1",
                                "text": "„Kurzsätze können höchstens 12 Wörter haben, beschränken sich aber meist auf sehr viel weniger.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
