{
    "word_family": [
        "resurgence",
        "insurgent",
        "insurgency",
        "upsurge"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e184ffde-0815-31c3-b343-f1d0bb8ce498",
                    "sense_definition": "A sudden, strong increase or rush, often of an emotion or a physical quantity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "noun_general_increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sudden <w>surge</w> of excitement when he heard the good news.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал внезапный <w>прилив</w> радости, когда услышал хорошие новости.",
                                "tr": "İyi haberleri duyduğunda ani bir heyecan <w>dalgası</w> hissetti."
                            }
                        },
                        {
                            "text": "The hospital prepared for a <w>surge</w> in patients during the winter season.",
                            "target_lang_translations": {
                                "ru": "Больница готовилась к <w>наплыву</w> пациентов в зимний сезон.",
                                "tr": "Hastane, kış sezonunda hasta sayısındaki <w>artışa</w> karşı hazırlık yaptı."
                            }
                        }
                    ],
                    "synonyms": [
                        "inrush",
                        "torrent"
                    ],
                    "common_phrases": [
                        "surge of excitement",
                        "sudden surge",
                        "surge in demand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное, сильное увеличение или наплыв, часто эмоций или физического количества.",
                        "tr": "Genellikle duygu veya fiziksel miktarda görülen ani, güçlü bir artış veya akın."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всплеск",
                                "target_lang_sense_clarification": "резкое кратковременное увеличение или проявление эмоций"
                            },
                            {
                                "target_lang_word": "наплыв",
                                "target_lang_sense_clarification": "большого количества людей или чего-либо"
                            },
                            {
                                "target_lang_word": "прилив",
                                "target_lang_sense_clarification": "внезапное ощущение сильной эмоции"
                            },
                            {
                                "target_lang_word": "резкий рост",
                                "target_lang_sense_clarification": "быстрое увеличение количества"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "artış",
                                "target_lang_sense_clarification": "ani ve hızlı yükselme"
                            },
                            {
                                "target_lang_word": "akın",
                                "target_lang_sense_clarification": "büyük miktarda hücum veya geliş"
                            },
                            {
                                "target_lang_word": "dalga",
                                "target_lang_sense_clarification": "duygu veya olaylarda ani yükseliş"
                            },
                            {
                                "target_lang_word": "patlama",
                                "target_lang_sense_clarification": "ani ve güçlü yoğunlaşma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92a5facc-4126-349f-85ab-633fed52d652",
                    "sense_definition": "A sudden increase in voltage or current in an electrical circuit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_electrical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A power <w>surge</w> at the generator caused a blackout across the district.",
                            "target_lang_translations": {
                                "ru": "<w>Скачок напряжения</w> на генераторе вызвал отключение электричества во всем районе.",
                                "tr": "Jeneratördeki bir <w>voltaj dalgalanması</w> tüm bölgede elektrik kesintisine yol açtı."
                            }
                        },
                        {
                            "text": "You should use a protector to prevent a voltage <w>surge</w> from damaging your computer.",
                            "target_lang_translations": {
                                "ru": "Вам следует использовать сетевой фильтр, чтобы предотвратить повреждение компьютера из-за <w>скачка напряжения</w>.",
                                "tr": "Bir <w>aşırı gerilimin</w> bilgisayarınıza zarar vermesini önlemek için bir koruyucu kullanmalısınız."
                            }
                        }
                    ],
                    "synonyms": [
                        "inrush"
                    ],
                    "common_phrases": [
                        "power surge",
                        "voltage surge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное повышение напряжения или тока в электрической цепи.",
                        "tr": "Bir elektrik devresinde voltaj veya akımın ani bir şekilde yükselmesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скачок напряжения",
                                "target_lang_sense_clarification": "резкое изменение в электросети"
                            },
                            {
                                "target_lang_word": "перенапряжение",
                                "target_lang_sense_clarification": "чрезмерное напряжение в сети"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "voltaj dalgalanması",
                                "target_lang_sense_clarification": "elektrik devresindeki ani yükselme"
                            },
                            {
                                "target_lang_word": "aşırı gerilim",
                                "target_lang_sense_clarification": "elektrik sistemindeki ani yüksek voltaj"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ebdd689-8411-344b-88a7-dfe9921c4ed5",
                    "sense_definition": "A rapid deployment of military forces or resources in large numbers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general ordered a <w>surge</w> of troops to the border region to maintain stability.",
                            "target_lang_translations": {
                                "ru": "Генерал приказал провести <w>наращивание</w> войск в приграничном районе для поддержания стабильности.",
                                "tr": "General, istikrarı sağlamak için sınır bölgesine asker <w>takviyesi</w> emri verdi."
                            }
                        },
                        {
                            "text": "The government announced a <w>surge</w> in police presence downtown.",
                            "target_lang_translations": {
                                "ru": "Правительство объявило об <w>усилении</w> присутствия полиции в центре города.",
                                "tr": "Hükümet, şehir merkezindeki polis varlığında bir <w>artış</w> olduğunu duyurdu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "surge capacity",
                        "troop surge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое развертывание военных сил или ресурсов в большом количестве.",
                        "tr": "Askeri güçlerin veya kaynakların büyük miktarlarda hızlı bir şekilde konuşlandırılması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наращивание",
                                "target_lang_sense_clarification": "увеличение численности или мощи"
                            },
                            {
                                "target_lang_word": "усиление",
                                "target_lang_sense_clarification": "укрепление позиций или присутствия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "takviye",
                                "target_lang_sense_clarification": "askeri güç veya kaynak artırımı"
                            },
                            {
                                "target_lang_word": "yığınak",
                                "target_lang_sense_clarification": "birliklerin hızlı bir şekilde toplanması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10d97e4d-4457-3ee6-9051-7a7da68cb5c5",
                    "sense_definition": "A large rolling swell or heavy wave of the sea.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_sea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat was tossed about by the heavy <w>surge</w> of the ocean.",
                            "target_lang_translations": {
                                "ru": "Лодку швыряло на сильной <w>волне</w> океана.",
                                "tr": "Tekne, okyanusun güçlü <w>kabarışıyla</w> bir o yana bir bu yana savruldu."
                            }
                        },
                        {
                            "text": "We watched the foaming <w>surge</w> crash against the rocky shore.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как пенящийся <w>вал</w> разбивается о скалистый берег.",
                                "tr": "Köpüren <w>dalgacıkların</w> kayalık sahile çarpışını izledik."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "literary or nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая, мощная волна или зыбь на море.",
                        "tr": "Denizde oluşan büyük, güçlü bir dalga veya kabarma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волна",
                                "target_lang_sense_clarification": "водная масса"
                            },
                            {
                                "target_lang_word": "вал",
                                "target_lang_sense_clarification": "высокая, длинная волна"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dalga",
                                "target_lang_sense_clarification": "büyük deniz dalgası"
                            },
                            {
                                "target_lang_word": "kabarma",
                                "target_lang_sense_clarification": "deniz seviyesindeki yükselme ve şişme"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ee4c678-c75d-384d-8e8f-ac5f10681ad2",
                    "sense_definition": "To increase suddenly and significantly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Online sales <w>surged</w> dramatically during the holiday season.",
                            "target_lang_translations": {
                                "ru": "Онлайн-продажи резко <w>выросли</w> во время праздничного сезона.",
                                "tr": "İnternet satışları tatil sezonunda büyük ölçüde <w>fırladı</w>."
                            }
                        },
                        {
                            "text": "Interest in the new technology has <w>surged</w> in recent years.",
                            "target_lang_translations": {
                                "ru": "Интерес к новой технологии <w>взлетел</w> в последние годы.",
                                "tr": "Yeni teknolojiye olan ilgi son yıllarda hızla <w>arttı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "surge in popularity",
                        "prices surged"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно и значительно увеличиваться.",
                        "tr": "Ani ve önemli ölçüde artmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резко возрасти",
                                "target_lang_sense_clarification": "об увеличении количества или уровня"
                            },
                            {
                                "target_lang_word": "подскочить",
                                "target_lang_sense_clarification": "быстро подняться (о ценах, температуре)"
                            },
                            {
                                "target_lang_word": "взлететь",
                                "target_lang_sense_clarification": "стремительно вырасти (переносное значение)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hızla artmak",
                                "target_lang_sense_clarification": "miktar veya seviyenin aniden yükselmesi"
                            },
                            {
                                "target_lang_word": "fırlamak",
                                "target_lang_sense_clarification": "fiyat veya değerlerin aniden yükselmesi"
                            },
                            {
                                "target_lang_word": "tavan yapmak",
                                "target_lang_sense_clarification": "çok yüksek seviyelere ulaşmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "777340e8-9e04-3bc0-b39d-78f3fb0ab4e9",
                    "sense_definition": "To move suddenly and powerfully forward or upward.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd <w>surged</w> forward when the gates finally opened.",
                            "target_lang_translations": {
                                "ru": "Толпа <w>хлынула</w> вперед, когда ворота наконец открылись.",
                                "tr": "Kapılar nihayet açıldığında kalabalık ileriye doğru <w>atıldı</w>."
                            }
                        },
                        {
                            "text": "The runner <w>surged</w> past his opponents in the final lap of the race.",
                            "target_lang_translations": {
                                "ru": "Бегун <w>рванул</w> мимо своих соперников на последнем круге гонки.",
                                "tr": "Koşucu, yarışın son turunda rakibini <w>geride bıraktı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "surge forward",
                        "surge ahead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться внезапно и мощно вперед или вверх.",
                        "tr": "Ani ve güçlü bir şekilde ileriye veya yukarıya doğru hareket etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлынуть",
                                "target_lang_sense_clarification": "массово устремиться (о толпе)"
                            },
                            {
                                "target_lang_word": "ринуться",
                                "target_lang_sense_clarification": "стремительно броситься"
                            },
                            {
                                "target_lang_word": "рвануться",
                                "target_lang_sense_clarification": "сделать резкое движение вперед"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ileri atılmak",
                                "target_lang_sense_clarification": "güçlü bir şekilde öne doğru hareket etmek"
                            },
                            {
                                "target_lang_word": "akın etmek",
                                "target_lang_sense_clarification": "kalabalığın aniden öne doğru ilerlemesi"
                            },
                            {
                                "target_lang_word": "coşmak",
                                "target_lang_sense_clarification": "güçlü bir ivmeyle yükselmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}