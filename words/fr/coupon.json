            "senses": [
                {
                    "sense_id": "f39b507e-2f89-3fb9-9405-2aeec5354208",
                    "sense_definition": "Billet imprimé ou code numérique qui donne droit à une réduction ou à un avantage lors d'un achat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "commercial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas de présenter votre <w>coupon</w> à la caisse pour obtenir la réduction."
                        },
                        {
                            "text": "J'ai trouvé un <w>coupon</w> de réduction très intéressant dans ma boîte aux lettres."
                        }
                    ],
                    "synonyms": [
                        "bon de réduction"
                    ],
                    "common_phrases": [
                        "coupon de réduction",
                        "coupon rabais"
                    ]
                },
                {
                    "sense_id": "34a08256-f973-3945-a2d1-24f8d31ab754",
                    "sense_definition": "Morceau restant d'une pièce d'étoffe ou de tissu vendu séparément, souvent à prix réduit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté un <w>coupon</w> de soie pour confectionner un joli coussin."
                        },
                        {
                            "text": "Ce magasin propose des <w>coupons</w> de tissu à des prix très avantageux."
                        }
                    ],
                    "synonyms": [
                        "chute",
                        "reste"
                    ],
                    "common_phrases": [
                        "coupon de tissu",
                        "coupon de soie"
                    ]
                },
                {
                    "sense_id": "2e64673a-919f-394d-b1e1-f33d705d52d1",
                    "sense_definition": "Certificat ou intérêt périodique versé au détenteur d'une obligation ou d'un titre financier.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'investisseur attend la fin du semestre pour détacher son <w>coupon</w> d'obligation."
                        },
                        {
                            "text": "Cette obligation d'État rapporte un <w>coupon</w> annuel fixé à trois pour cent."
                        }
                    ],
                    "synonyms": [
                        "dividende",
                        "intérêt"
                    ],
                    "common_phrases": [
