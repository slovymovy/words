                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weingärtner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6779148a-6fdc-3280-823d-74dd4552a870",
                                        "entry_id": "d224c114-b40d-3bd3-8192-83156afdb90c",
                                        "glosses": [
                                            "eine Person, die Wein beruflich an- und ausbaut"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fea76ee4-6833-43a1-8b7f-42d58f58a789",
                                                "sense_id": "6779148a-6fdc-3280-823d-74dd4552a870",
                                                "text": "„Die beste Art, den Weinbau zu heben und den Weingärtner zu richtiger Behandlung seines Weinbergs anzuhalten, ist nach meiner Ansicht ein Musterweinberg und eine Musteranstalt in Behandlung des Weinmostes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
