                                        "entry_id": "0041966c-d0b2-341b-a79c-d013dacef71b",
                                        "glosses": [
                                            "A formal written request made by an individual or a group of people to a sovereign or political authority, often containing many signatures, soliciting some grace, right, mercy, or the redress of some wrong or grievance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497e8dcd-830e-45fc-ba69-912b5eb2487f",
                                                "sense_id": "af107bdb-9e92-39c7-a5fc-f94d2b734b7b",
                                                "text": "We're looking to get 10,000 people to sign the petition to have the bird colony given legal protection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45c06fa5-0915-38a9-a112-c72f99764057",
                                        "entry_id": "0041966c-d0b2-341b-a79c-d013dacef71b",
                                        "glosses": [
                                            "A formal written application made to a magistrate or court for an order or a suit for divorce."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ba851c2-78c1-3bda-8451-303c94d9376b",
                                        "entry_id": "0041966c-d0b2-341b-a79c-d013dacef71b",
                                        "glosses": [
                                            "A prayer or supplication, especially of which is formal or humble and made to a deity, a sovereign, or an authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b398aa96-5c75-4d1f-8ea5-7309e30aeed5",
                                                "sense_id": "6ba851c2-78c1-3bda-8451-303c94d9376b",
                                                "text": "a petition to aid"
                                            },
                                            {
                                                "example_id": "b07fb6c1-f7ec-4c48-8b7d-74933105d942",
                                                "sense_id": "6ba851c2-78c1-3bda-8451-303c94d9376b",
                                                "text": "a petition to God for courage and strength"
                                            },
                                            {
                                                "example_id": "77c55d0f-5b29-4c46-8c7a-0b2f2999c8ae",
                                                "sense_id": "6ba851c2-78c1-3bda-8451-303c94d9376b",
                                                "text": "A house of prayer and petition for thy people."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "petition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75719f57-6ffd-37b5-b210-a4377a4e2295",
                                        "entry_id": "9d955d33-e704-3ac1-9687-f8d9d7d15810",
                                        "glosses": [
                                            "To make a petition to (a sovereign or political authority)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53c6d81b-1454-42ff-b0bb-7c006c699787",
                                                "sense_id": "75719f57-6ffd-37b5-b210-a4377a4e2295",
                                                "text": "The villagers petitioned the council to demolish the dangerous building."
                                            },
                                            {
                                                "example_id": "f4b18f2e-eb53-4980-9b90-fbb8f892dcb7",
                                                "sense_id": "75719f57-6ffd-37b5-b210-a4377a4e2295",
                                                "text": "The company, appreciating the crippling affect ^([sic]) that this scheme will have on its activities unless the railway is diverted, has petitioned against the North Wales Hydro-Electric Power Bill at present before the House of Lords."
                                            }
                                        ]
                                    }
                                ]
