                    },
                    {
                        "form_id": "abf91079-60c2-489d-b04c-a6b9c2b5d075",
                        "entry_id": "1ebe51ea-117e-30b8-b8b2-20b9db69eb6b",
                        "tags": [
                            "masculine"
                        ],
                        "form": "Japonais"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3324a930-4ff9-3592-9800-88c66be55027",
                        "entry_id": "1ebe51ea-117e-30b8-b8b2-20b9db69eb6b",
                        "glosses": [
                            "Habitante du Japon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b9244cb-6f10-4c7d-8cf5-cf77d17c1a7f",
                                "sense_id": "3324a930-4ff9-3592-9800-88c66be55027",
                                "text": "Vainqueur de deux Grands Slams (Tel-Aviv et Bakou), de deux championnats d’Europe et du Masters de Jérusalem, elle a ramené l’argent des Mondiaux de Doha début mai, où seule la Japonaise Natsumi Tsunoda, désormais triple championne du monde, lui a barré la route."
                            },
                            {
                                "example_id": "41bbb92e-0205-488d-8f2a-5d7c29413f34",
                                "sense_id": "3324a930-4ff9-3592-9800-88c66be55027",
                                "text": "Les Japonaises ont réduit le score en fin de match par Honoka Hayashi (87e) et ont poussé, en vain, en fin de match."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaadae9b-c8d9-43a2-86f9-7ea8d433a35c",
                        "source_entry_id": "1ebe51ea-117e-30b8-b8b2-20b9db69eb6b",
                        "source_sense_id": "3324a930-4ff9-3592-9800-88c66be55027",
                        "target_lang_word": "Japanerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Japanerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aed28005-76a3-3c17-b049-9a939da0c366",
                                        "entry_id": "0bc752ac-88da-3aca-988b-f4ad7a95410b",
                                        "glosses": [
                                            "Einwohnerin von Japan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d63de5f7-4914-42a2-b55b-1d4f699272de",
                                                "sense_id": "aed28005-76a3-3c17-b049-9a939da0c366",
                                                "text": "Peters neue Freundin ist Japanerin."
                                            },
                                            {
                                                "example_id": "a019f18a-7239-4854-a0ff-17b957e73fdf",
                                                "sense_id": "aed28005-76a3-3c17-b049-9a939da0c366",
                                                "text": "„Die Japanerinnen geben auf.“"
                                            },
                                            {
                                                "example_id": "7a33e64e-b17c-4481-8b76-c1959d53f83a",
                                                "sense_id": "aed28005-76a3-3c17-b049-9a939da0c366",
                                                "text": "„Leute schlendern vorbei, kurz darauf zwei Japanerinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dddd586-087f-436f-adda-cf0cacc595cc",
                        "source_entry_id": "1ebe51ea-117e-30b8-b8b2-20b9db69eb6b",
                        "source_sense_id": "3324a930-4ff9-3592-9800-88c66be55027",
                        "target_lang_word": "Japanese",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Japanese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c88d75b2-da31-35c6-ae33-61a0ee623ac6",
                                        "entry_id": "a6cc2568-f1a8-371f-b228-37fcfe572d94",
                                        "glosses": [
                                            "Of, relating to, derived from, or characteristic of Japan, its people, language, or culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9402c61f-e5f9-42f1-9d48-06730d9c01f8",
                                                "sense_id": "c88d75b2-da31-35c6-ae33-61a0ee623ac6",
                                                "text": "A Japanese saw is one that cuts on the pull stroke rather than on the push stroke."
                                            },
                                            {
                                                "example_id": "34d69d28-d734-4985-9344-9ed4796936ff",
                                                "sense_id": "c88d75b2-da31-35c6-ae33-61a0ee623ac6",
                                                "text": "In the United States, Japanese animation has had a tremendous surge in popularity over the last few years."
                                            },
                                            {
                                                "example_id": "f5812240-30c6-4431-9c34-9926aaea34e6",
                                                "sense_id": "c88d75b2-da31-35c6-ae33-61a0ee623ac6",
                                                "text": "Then, as I walked back to the Miyako Hybrid, the snow-white hotel, with its perfectly black parking lot and perfectly trimmed palm trees, looked more like a computer rendering of a building than a building itself. And that is very Japanese."
                                            },
                                            {
                                                "example_id": "33098d90-d39a-48db-93c5-e9f80622b104",
                                                "sense_id": "c88d75b2-da31-35c6-ae33-61a0ee623ac6",
                                                "text": "Japanese retail stores have strove to, and have succeeded in, fulfilling these severe demands, and in doing so, have constantly had to innovate both technologically and institutionally in order to keep up with the competition."
                                            },
                                            {
                                                "example_id": "5f782620-16a4-4297-9623-011baafbe551",
                                                "sense_id": "c88d75b2-da31-35c6-ae33-61a0ee623ac6",
                                                "text": "As many as 100,000 Japanese people were killed and another million injured, most of them civilians, when more than 300 American B-29 bombers dropped 1,500 tons of firebombs on the Japanese capital that night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fda92438-8074-3f7a-9a80-94818e0650a8",
                                        "entry_id": "a6cc2568-f1a8-371f-b228-37fcfe572d94",
                                        "glosses": [
                                            "Of, relating to, derived from, or characteristic of Japan, its people, language, or culture.",
                                            "Of or relating to the Yamato people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2279c0f6-680d-4bbd-a053-75594cc24689",
                                                "sense_id": "fda92438-8074-3f7a-9a80-94818e0650a8",
                                                "text": "The Ainu were subject to forced assimilation by the Japanese since at least the 18th century."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Japanese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25f097da-f52d-3dd0-bef4-65350ab56c5a",
                                        "entry_id": "2c3a7c67-c3f8-3385-9b33-0fb4cf91cc38",
                                        "glosses": [
                                            "A person living in or originating from Japan, or of Japanese ancestry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb454f4-c435-401a-a925-76853da23177",
                                                "sense_id": "25f097da-f52d-3dd0-bef4-65350ab56c5a",
                                                "text": "A Japanese will typically have black hair, brown eyes, and pale skin."
                                            },
                                            {
                                                "example_id": "17538722-c1af-4486-a444-d8a486e363c3",
                                                "sense_id": "25f097da-f52d-3dd0-bef4-65350ab56c5a",
                                                "text": "2007 October 16, Madeleine Brand, “Japan Struggles to Meet Its CO2 Emissions Limits”, Day to Day, National Public Radio,\nMotoyuki Shibata isn’t a typical Japanese."
                                            },
                                            {
                                                "example_id": "adb03633-4716-43fd-a77c-bd3e5ef32874",
                                                "sense_id": "25f097da-f52d-3dd0-bef4-65350ab56c5a",
                                                "text": "How courteous is the Japanese;\nHe always says, \"Excuse it, please.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff8701a9-4bb9-331b-bd3c-9dc497398896",
                                        "entry_id": "2c3a7c67-c3f8-3385-9b33-0fb4cf91cc38",
                                        "glosses": [
                                            "Ellipsis of Japanese food."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e6ba67f-07ee-4284-b271-72a74785be73",
                                                "sense_id": "ff8701a9-4bb9-331b-bd3c-9dc497398896",
                                                "text": "Let’s go out to eat. I’m in the mood for Japanese."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Japanese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93dd3dcf-fd3b-37c7-9607-b5c5935e2263",
                                        "entry_id": "b409d3d7-5bb4-3dd3-9805-7b6f914cf0ff",
                                        "glosses": [
                                            "A language that is primarily spoken in East Asia and is the official language of Japan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78a9dc94-23ff-4236-8064-b6ac06747845",
                                                "sense_id": "93dd3dcf-fd3b-37c7-9607-b5c5935e2263",
                                                "text": "I’ve been studying Japanese for three years, and I still can’t order pizza in Tokyo!"
                                            },
                                            {
                                                "example_id": "9871cd9d-59d4-44e9-a6e7-37b86d4099de",
                                                "sense_id": "93dd3dcf-fd3b-37c7-9607-b5c5935e2263",
                                                "text": "What Japanese you speak also depends on your gender. There’s a “rough” language for men and a more “ladylike” language for women, but you must understand both."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
