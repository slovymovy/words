                {
                    "sense_id": "be816952-f9a5-3f0b-82db-6e784f93f403",
                    "sense_definition": "Qui est effacé, sans éclat ni prétention, en parlant des choses.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chose_simple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quelques <w>humbles</w> fleurs sauvages poussaient entre les pierres de la vieille cour."
