                    {
                        "sense_id": "5251d039-e394-38a1-aa7e-6dc182d5fb84",
                        "entry_id": "38baacfe-ec0a-326e-b9db-2ca49c41fae8",
                        "glosses": [
                            "Grandiloquent et vain."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a7a6525e-34ae-46dd-a72b-0c60f4375af0",
                                "sense_id": "5251d039-e394-38a1-aa7e-6dc182d5fb84",
                                "text": "[…]: il leur faut des électeurs ouvriers assez naïfs pour se laisser duper par des phrases ronflantes sur le collectivisme futur; […]."
                            },
                            {
                                "example_id": "380ccfa7-3035-445b-888b-d22ebd718f7d",
                                "sense_id": "5251d039-e394-38a1-aa7e-6dc182d5fb84",
