    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e0fb236a-3cb2-3cd7-b58f-4f181c4640af",
                "word": "biofuel",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bb8f55aa-f61d-45d7-aada-c6d8c75a81e1",
                        "entry_id": "e0fb236a-3cb2-3cd7-b58f-4f181c4640af",
                        "tags": [
                            "plural"
                        ],
                        "form": "biofuels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                        "entry_id": "e0fb236a-3cb2-3cd7-b58f-4f181c4640af",
                        "glosses": [
                            "Any fuel that is obtained from a renewable biological resource, especially from biomass."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7eef6db-0f59-4a0a-83e7-429aff85058c",
                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                "text": "Even second-generation biofuels, made from crop wastes or wood, are an environmental disaster, either extending the cultivated area or removing the straw and stovers which protect the soil from erosion and keep carbon and nutrients in the ground."
                            },
                            {
                                "example_id": "86a12086-d47b-4836-84ed-afdac1311da3",
                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                "text": "The Environmental Protection Agency announced proposed changes to its biofuels program Tuesday to spur more biofuel use and crack down on waivers issued to refineries by the Trump administration, notching a win for the biofuels industry and farmers and a blow to oil refineries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67029585-351e-4ec4-a55f-1d59ca0ba454",
                        "source_entry_id": "e0fb236a-3cb2-3cd7-b58f-4f181c4640af",
                        "source_sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                        "source_sense_description": "biofuel",
                        "target_lang_word": "biopalivo",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biopalivo",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ec9df209-22e7-303c-917e-11de6c035d13",
                                        "entry_id": "3b03094d-c091-3bc6-89b2-a4c9d998c792",
                                        "glosses": [
                                            "palivo vyrobené zpracováním zemědělských produktů nebo biologického odpadu, používané místo fosilních paliv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6bf472a-1b0c-4fdb-a4e8-84a6844f26ad",
                                                "sense_id": "ec9df209-22e7-303c-917e-11de6c035d13",
                                                "text": "Lufthansa byla vůbec první leteckou společností na světě, která v roce 2011 začala biopaliva používat v civilních letech. Šlo tehdy o směs leteckého petroleje a biopaliva získávaného z rostlinných olejů a živočišných tuků."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbfe5b8b-3953-4f4c-9d9d-fbf4472fafaa",
                        "source_entry_id": "e0fb236a-3cb2-3cd7-b58f-4f181c4640af",
                        "source_sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
