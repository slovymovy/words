                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5dc6592-f94b-4f82-b076-7b3ad9260a58",
                                                "sense_id": "4fe28730-b2f8-361a-a39d-c4326f73caf1",
                                                "text": "Son valet de chambre prétend qu’il est resté pendant toute une nuit sur l’appui extérieur d’une fenêtre pour sauver l’honneur de sa maîtresse ; et, il a fait diablement froid ces jours-ci !"
                                            },
                                            {
                                                "example_id": "d2f8d0ca-4a95-40fa-b5b6-8494a38bb25c",
                                                "sense_id": "4fe28730-b2f8-361a-a39d-c4326f73caf1",
                                                "text": "Je vous le dis encor, vous risquez diablement."
                                            },
                                            {
                                                "example_id": "d3cead01-de3d-489a-857e-35b75350985e",
                                                "sense_id": "4fe28730-b2f8-361a-a39d-c4326f73caf1",
                                                "text": "Je suis diablement fort sur l’impromptu."
                                            },
                                            {
                                                "example_id": "efd608f2-2b64-44cd-87f9-4de221e6dc12",
                                                "sense_id": "4fe28730-b2f8-361a-a39d-c4326f73caf1",
                                                "text": "Ainsi parlait la reine Aimée,\nQui fut diablement enflammée."
                                            },
                                            {
                                                "example_id": "ba997533-d02d-4be2-a0f3-502e667f031e",
                                                "sense_id": "4fe28730-b2f8-361a-a39d-c4326f73caf1",
                                                "text": "La flotte est arrivée avec les galions ; Cela va diablement hausser nos actions."
                                            },
                                            {
                                                "example_id": "b3d5273a-b29a-4b10-8422-befccf16206a",
                                                "sense_id": "4fe28730-b2f8-361a-a39d-c4326f73caf1",
                                                "text": "La maison sentait diablement le renfermé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54edd797-bc43-31f2-9fbb-81ce10aeff52",
                                        "entry_id": "7ee231c7-721f-3a19-8a98-d4aa5346234a",
                                        "glosses": [
                                            "Un nombre infini de, une quantité infinie de."
