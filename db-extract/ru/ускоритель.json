                                                "example_id": "a6b62bff-e1d2-4363-abe4-b0bdc239f33a",
                                                "sense_id": "20edda66-6228-39d5-9589-9a383f333b93",
                                                "text": "The Pied Piper treats Lowenstein as a metaphor for American post-war liberalism and subjects a once highly regarded political movement to the same scrutiny Lowenstein himself faces. Not too surprisingly, both come out wanting, though their boosters claim otherwise."
                                            },
                                            {
                                                "example_id": "ec0128e9-36d4-477f-8728-e59e77aed531",
                                                "sense_id": "20edda66-6228-39d5-9589-9a383f333b93",
                                                "text": "Nor is his district quite the Democratic bastion boosters describe: voters there narrowly backed Barack Obama in 2008, but voted for Mr Bush by a hefty margin in 2004."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79376e6e-a762-3b6b-b648-11da6b9024c0",
                                        "entry_id": "1f1b86ec-6dc4-3fa1-99c9-6ba4698d328a",
                                        "glosses": [
                                            "A member of a booster club."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2c6ffe2-b495-33d2-bc4b-cab89ff31c90",
                                        "entry_id": "1f1b86ec-6dc4-3fa1-99c9-6ba4698d328a",
                                        "glosses": [
                                            "A booster dose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "516fe6d6-afe5-4a13-aaf9-d7ffdda86414",
                                                "sense_id": "c2c6ffe2-b495-33d2-bc4b-cab89ff31c90",
                                                "text": "When did you get your last tetanus booster?"
                                            },
                                            {
                                                "example_id": "3b3d6413-5047-4583-93be-a2c0981d762c",
                                                "sense_id": "c2c6ffe2-b495-33d2-bc4b-cab89ff31c90",
                                                "text": "In the September vaccine monitor survey from the Kaiser Family Foundation, 71 percent of unvaccinated respondents said the need for boosters indicated that the vaccines were not working."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2412faa-bae6-3492-a8df-fece995aabac",
                                        "entry_id": "1f1b86ec-6dc4-3fa1-99c9-6ba4698d328a",
                                        "glosses": [
                                            "A small quantity of a sensitive explosive that is triggered by a detonator and provides the energy needed to detonate a larger quantity of a less-sensitive explosive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12a1c786-b58c-3ed5-baf4-bdc5866063f4",
                                        "entry_id": "1f1b86ec-6dc4-3fa1-99c9-6ba4698d328a",
                                        "glosses": [
                                            "A term that serves to amplify or strengthen an utterance, such as \\\"really\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91410151-485e-340c-89c2-8c706202180d",
                                        "entry_id": "1f1b86ec-6dc4-3fa1-99c9-6ba4698d328a",
                                        "glosses": [
                                            "A power-up item."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fac9ae02-7917-31d2-a070-d21d396f656d",
                                        "entry_id": "1f1b86ec-6dc4-3fa1-99c9-6ba4698d328a",
                                        "glosses": [
                                            "A package of cards or figurines designed to add to a player's collection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1dcd1efa-fc08-306b-9270-f09acde77266",
                                        "entry_id": "1f1b86ec-6dc4-3fa1-99c9-6ba4698d328a",
                                        "glosses": [
                                            "A thief."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "002e1cd5-1d5d-4deb-b32a-78f2b7a08099",
                                                "sense_id": "1dcd1efa-fc08-306b-9270-f09acde77266",
                                                "text": "The security guard captured two boosters before they could exit the retail store."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f06ab844-95e2-3bf7-8568-4a6dac4ec40d",
                                        "entry_id": "1f1b86ec-6dc4-3fa1-99c9-6ba4698d328a",
                                        "glosses": [
                                            "A booster engine fitted to a steam locomotive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd08c9d-b656-46d7-824d-49602c645a5a",
                                                "sense_id": "f06ab844-95e2-3bf7-8568-4a6dac4ec40d",
                                                "text": "Another notable new series of locomotives, now in course of delivery to the Canadian National Railways, [...]. Fifteen are being built by the Montreal Locomotive Works Limited, and ten by the Canadian Locomotive Company, of Kingston, Ontario; the former are being provided with boosters and the latter are not."
                                            },
                                            {
                                                "example_id": "481e5507-95b0-4530-aadb-a4d8905fc0ce",
                                                "sense_id": "f06ab844-95e2-3bf7-8568-4a6dac4ec40d",
                                                "text": "Also in 1939, six 4-8-4s, classified \"Kb\" because they have boosters, were built at Hillside for service between Christchurch and Arthurs Pass."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "booster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4bf65aa-c2d4-3eb6-9e8d-1ccfb2a90d9e",
                                        "entry_id": "282566fa-5f35-3e4a-a927-b444f19c6a24",
                                        "glosses": [
                                            "To give a booster shot to; to boost."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75afffd5-4970-442b-a44e-2e2a02277849",
                                                "sense_id": "b4bf65aa-c2d4-3eb6-9e8d-1ccfb2a90d9e",
                                                "text": "\"Hey guys, on the first day of our holiday break I tested positive for Covid. I was vaccinated and boostered which made me lucky enough to only have mild symptoms,\" he wrote beside a photo that showed him sitting alone inside a testing room wearing a mask."
                                            },
                                            {
                                                "example_id": "a9936e08-ddfc-4912-a86f-3a9907df1079",
                                                "sense_id": "b4bf65aa-c2d4-3eb6-9e8d-1ccfb2a90d9e",
                                                "text": "What I would prefer over hazard pay would be for every one of our patients to get vaccinated and boostered, as we request constantly. That would be what would make me happy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
