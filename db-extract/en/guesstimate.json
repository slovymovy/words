                "forms": [
                    {
                        "form_id": "19886c39-795b-42d2-81df-67d7002c90a7",
                        "entry_id": "5a0ad147-d04a-319b-9069-8ae5b1fcd52a",
                        "tags": [
                            "plural"
                        ],
                        "form": "guesstimates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70ba07b0-2d45-3b51-a058-3c9873ed95b4",
                        "entry_id": "5a0ad147-d04a-319b-9069-8ae5b1fcd52a",
                        "glosses": [
                            "An estimate that is hardly any better than a guess, often because it is based on insufficient or unreliable data."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "f23b6632-6221-4374-8d3c-2b4d32c8d9a4",
                                "sense_id": "70ba07b0-2d45-3b51-a058-3c9873ed95b4",
                                "text": "Near-synonym: educated guess"
                            },
                            {
                                "example_id": "fb87b92b-e0f1-4aab-aebc-c17a4cddc871",
                                "sense_id": "70ba07b0-2d45-3b51-a058-3c9873ed95b4",
                                "text": "I'm not sure how many people were at the festival. My best guesstimate is 50,000."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4251049d-4af7-4ec8-8dbf-654e9ee91968",
                        "source_entry_id": "5a0ad147-d04a-319b-9069-8ae5b1fcd52a",
                        "source_sense_id": "70ba07b0-2d45-3b51-a058-3c9873ed95b4",
                        "source_sense_description": "estimate based on insufficient or unreliable data",
                        "target_lang_word": "au doigt mouillé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au doigt mouillé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a09f9ac0-e661-378f-9297-0b9c77fe4797",
                                        "entry_id": "96a5dbfe-75f7-3d2b-852d-bb5f7e7a4d22",
                                        "glosses": [
                                            "Approximativement, au pif (désigne toute évaluation sommaire, imprécise)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "470a389f-f9bd-4ea8-a12e-c6450c994552",
                                                "sense_id": "a09f9ac0-e661-378f-9297-0b9c77fe4797",
                                                "text": "Une lecture même au doigt mouillé convaincra qui ne le saurait pas encore que la Bible est le plus accompli des catalogues en matière de tortures, meurtres individuels ou collectifs, tragédies, injustices, exactions, menaces, vengeances, etc."
                                            },
                                            {
                                                "example_id": "7e601cf4-91fe-4dbf-8ea8-2e27a9fdf8e1",
                                                "sense_id": "a09f9ac0-e661-378f-9297-0b9c77fe4797",
                                                "text": "Sondages à l'appui ou \"estimation au doigt mouillé\", comme ironisait jadis un sondeur désabusé, ces experts élyséens ont fait connaître leur diagnostic, que l'on peut résumer ainsi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
