                "senses": [
                    {
                        "sense_id": "c20e8ed3-4775-3e28-b504-69dfbb7fd247",
                        "entry_id": "ed3b0675-2af7-3592-8d1f-0257d48d0459",
                        "glosses": [
                            "Chocolat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe1f69b-ab73-4396-8f1e-37328148f95d",
                                "sense_id": "c20e8ed3-4775-3e28-b504-69dfbb7fd247",
                                "text": "Au petit déjeuner, maman à préparé une tartine au choco, l'enfant réclame de la confiture. Cris."
                            },
                            {
                                "example_id": "2b0aa8a2-734e-4cff-aa06-b8e967d244d7",
                                "sense_id": "c20e8ed3-4775-3e28-b504-69dfbb7fd247",
                                "text": "En dessert, une tarte choco piment d’Espelette dressée minute, caramel et cacahuètes, un shot un peu trop sucré."
                            },
                            {
                                "example_id": "97a44ca0-4a2f-48b4-9e01-20a5ea150a12",
                                "sense_id": "c20e8ed3-4775-3e28-b504-69dfbb7fd247",
                                "text": "Muffins tout choco : la recette facile"
                            }
                        ]
                    },
                    {
                        "sense_id": "ed8cc280-4609-3ef5-8f1d-041da09035b4",
                        "entry_id": "ed3b0675-2af7-3592-8d1f-0257d48d0459",
                        "glosses": [
                            "Biscuit en sandwich fourré au chocolat."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "ab507846-b152-4456-95e3-3b321f31093a",
                                "sense_id": "ed8cc280-4609-3ef5-8f1d-041da09035b4",
                                "text": "Vous avez également la possibilité de consommer des chocos à la place du pain."
                            },
                            {
                                "example_id": "8849c2a2-e505-4197-8c7f-fea463b34ac0",
                                "sense_id": "ed8cc280-4609-3ef5-8f1d-041da09035b4",
                                "text": "Lorsque j'étais petite, j'étais fan invétérée des chocos BN. Chaque matin, je vidais un paquet neuf avant que mon frère et ma sœur n'arrivent pour récupérer tous ceux qui affichaient des yeux en demi-lune. C'était les plus rares."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d5d7b2c-4f6c-3e7c-ad6b-7dc0d35be33c",
                        "entry_id": "ed3b0675-2af7-3592-8d1f-0257d48d0459",
                        "glosses": [
                            "Pâte à tartiner chocolatée."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "f68025ae-e475-47cf-bbe8-8d6c8c393415",
                                "sense_id": "0d5d7b2c-4f6c-3e7c-ad6b-7dc0d35be33c",
                                "text": "Le choco Kwatta ®"
                            }
                        ]
                    },
                    {
                        "sense_id": "5d4994f0-548f-3a5d-88c8-e474cada448d",
                        "entry_id": "ed3b0675-2af7-3592-8d1f-0257d48d0459",
                        "glosses": [
                            "Haschisch, résine de cannabis, souvent de mauvaise qualité."
                        ],
                        "tags": [
                            "analogy",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "04882250-0353-41f0-8da2-55ea7f2fab4d",
                                "sense_id": "5d4994f0-548f-3a5d-88c8-e474cada448d",
                                "text": "Quand il n'aura plus que dalle,\nQui viendra faire le joli ?\nQui partira en cavale,\nAu beau milieu de la nuit\nPour un choco de cambouis."
                            }
                        ]
                    },
