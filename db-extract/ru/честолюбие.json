                            {
                                "example_id": "66b7943d-7bb4-403e-9b3d-864f7c476b39",
                                "sense_id": "abc8f5e6-19eb-309e-b3c8-ef1fc0de515f",
                                "text": "Но что бы́ло осо́бенно в Трезо́рке до́рого, так э́то соверше́нное отсу́тствие честолю́бия.",
                                "translation": "But if there was one really endearing feature about old Trezor it was his complete lack of ambition.",
                                "english": "But if there was one really endearing feature about old Trezor it was his complete lack of ambition."
                            }
                        ]
                    }
