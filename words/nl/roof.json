            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aaff1d81-d3ff-339f-939b-47881b3a02a2",
                    "sense_definition": "het openlijk en gewelddadig wegnemen van hetgeen een ander toebehoort",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "misdaad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie onderzoekt een gewelddadige <w>roof</w> die gisteravond in het centrum plaatsvond.",
                            "target_lang_translations": {
                                "en": "The police are investigating a violent <w>robbery</w> that took place in the city center last night."
                            }
                        },
                        {
                            "text": "Na de grote <w>roof</w> uit de kluis bleven de daders spoorloos verdwenen.",
                            "target_lang_translations": {
                                "en": "After the major <w>heist</w> from the vault, the perpetrators remained missing without a trace."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gewelddadige roof"
                    ],
                    "target_lang_definitions": {
                        "en": "the act of openly and violently taking what belongs to another"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "robbery",
                                "target_lang_sense_clarification": "theft involving force"
                            },
                            {
                                "target_lang_word": "heist",
                                "target_lang_sense_clarification": "a large-scale robbery"
                            },
                            {
                                "target_lang_word": "loot",
                                "target_lang_sense_clarification": "goods stolen during a robbery"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74541920-ec03-3e8a-b157-065ecd0c0a5f",
                    "sense_definition": "de harde korst die zich op een genezende wond vormt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet niet aan de <w>roof</w> krabben, want dan gaat de wond weer bloeden.",
                            "target_lang_translations": {
                                "en": "You shouldn't scratch the <w>scab</w>, because then the wound will start bleeding again."
                            }
                        },
                        {
                            "text": "Er zit een dikke <w>roof</w> op zijn knie nadat hij gisteren hard gevallen is.",
                            "target_lang_translations": {
                                "en": "There is a thick <w>scab</w> on his knee after he had a hard fall yesterday."
                            }
                        }
                    ],
                    "synonyms": [
                        "korst",
                        "wondkorst"
                    ],
                    "common_phrases": [
                        "een roof op de wond"
                    ],
                    "target_lang_definitions": {
                        "en": "the hard crust that forms over a healing wound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scab",
                                "target_lang_sense_clarification": "crust on a wound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87a3b88b-e514-30d1-a68b-cfc8e214200b",
                    "sense_definition": "een woord overgenomen uit het Engels dat verwijst naar een dak, vaak gebruikt in samenstellingen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij installeerde een nieuwe <w>roof</w>rail op zijn auto om de koffers te vervoeren.",
                            "target_lang_translations": {
                                "en": "He installed a new <w>roof</w> rail on his car to transport the suitcases."
                            }
                        },
                        {
                            "text": "De term <w>roof</w>rack wordt in de Nederlandse autowereld vaak gebruikt voor een imperiaal.",
                            "target_lang_translations": {
                                "en": "The term <w>roof</w> rack is often used in the Dutch automotive world for a luggage rack."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Anglicisme"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a word borrowed from English referring to a roof, often used in compound words"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "roof",
                                "target_lang_sense_clarification": "top covering of a vehicle or building"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7548e9e-5bb5-33c8-8c9a-3fa6896f56cf",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>roven</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>roof</w> nooit iets van anderen omdat ik eerlijk wil leven.",
                            "target_lang_translations": {
                                "en": "I never <w>rob</w> anything from others because I want to live honestly."
                            }
                        },
                        {
                            "text": "Als ik in dit spel goud <w>roof</w>, krijg ik extra punten van de computer.",
                            "target_lang_translations": {
                                "en": "If I <w>plunder</w> gold in this game, I get extra points from the computer."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'to rob' or 'to plunder'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rob",
                                "target_lang_sense_clarification": "to steal from"
                            },
                            {
                                "target_lang_word": "plunder",
                                "target_lang_sense_clarification": "to steal by force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6201c9e8-c71a-3c2e-b9d2-6139b38deaf0",
                    "sense_definition": "gebiedende wijs van <w>roven</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Roof</w> niet van de armen, want dat is moreel onjuist.",
                            "target_lang_translations": {
                                "en": "<w>Rob</w> not from the poor, for that is morally wrong."
                            }
                        },
                        {
                            "text": "De kapitein riep tegen zijn bemanning: <w>Roof</w> alles wat van waarde is!",
                            "target_lang_translations": {
                                "en": "The captain shouted to his crew: <w>Plunder</w> everything of value!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'to rob' or 'to plunder'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rob",
                                "target_lang_sense_clarification": "command to steal"
                            },
                            {
                                "target_lang_word": "plunder",
                                "target_lang_sense_clarification": "command to pillage"
                            }
                        ]
                    }
                }
            ]
        }
    ]
