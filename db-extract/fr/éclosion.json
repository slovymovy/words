                                                "sense_id": "487b93b3-bb72-38fa-9012-2b4a030ebfb5",
                                                "text": "De narcissen staan te bloeien, maar de tulpen moeten nog uitkomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dcda737-dec4-3dc0-8faa-77a26e584c6e",
