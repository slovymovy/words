                        ],
                        "examples": [
                            {
                                "example_id": "abe24bb4-c374-41d0-bcdd-04525552ac23",
                                "sense_id": "7f939fd0-2f23-3aa2-9d5d-41c5c2f6de7f",
                                "text": "Who's afraid of him, except the old governor who daresn't catch him and put him in double-darbies, as he deserves, but lets him go about kidnapping people […]"
                            },
                            {
                                "example_id": "7af871fd-d717-4f97-8064-d6fe0d0c50e6",
                                "sense_id": "7f939fd0-2f23-3aa2-9d5d-41c5c2f6de7f",
                                "text": "And he says, 'I'll go along quiet, Bobby,' he says, 'without the darbies,' he says."
                            },
                            {
                                "example_id": "c317c78d-f994-4ec9-9794-4d0112cb990e",
                                "sense_id": "7f939fd0-2f23-3aa2-9d5d-41c5c2f6de7f",
                                "text": "Second watch: (Produces handcuffs) Here are the darbies."
                            },
                            {
                                "example_id": "af01a80b-5897-47a1-8774-cc27d07c1103",
                                "sense_id": "7f939fd0-2f23-3aa2-9d5d-41c5c2f6de7f",
                                "text": "Sentry, are you there? / Just ease this darbies at the wrist, and roll me over fair, / I am sleepy, and the oozy weeds about me twist."
                            }
                        ]
                    }
                ],
