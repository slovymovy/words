{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "92bf16e5-4f1a-3328-ae0a-c59846b4107b",
                    "sense_definition": "A formal expression used to say goodbye or to wish someone a final farewell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "farewell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a heavy heart, she whispered <w>adieu</w> to her childhood home before moving away.",
                            "target_lang_translations": {
                                "zh": "搬走之前，她怀着沉重的心情向儿时的家低声说了声<w>再见</w>。"
                            }
                        },
                        {
                            "text": "The old soldier stood at the gate and bid his comrades a final <w>adieu</w>.",
                            "target_lang_translations": {
                                "zh": "老兵站在门口，向他的战友们做了最后的<w>告别</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "farewell"
                    ],
                    "common_phrases": [
                        "bid adieu"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in literary or formal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于正式场合的告别语，或表示永别。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "再见",
                                "target_lang_sense_clarification": "正式的告别用语。"
                            },
                            {
                                "target_lang_word": "永别",
                                "target_lang_sense_clarification": "指最后一次告别，通常带有伤感色彩。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5efc6923-38b8-3459-ab49-2fa88dbbe2ea",
                    "sense_definition": "A formal or fond act of saying goodbye, often implying a long or permanent separation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "farewell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They exchanged tearful <w>adieux</w> at the train station before the long journey began.",
                            "target_lang_translations": {
                                "zh": "在漫长的旅程开始前，他们在火车站含泪<w>告别</w>。"
                            }
                        },
                        {
                            "text": "After many years of service, the professor made his final <w>adieu</w> to the university.",
                            "target_lang_translations": {
                                "zh": "在任教多年后，这位教授向大学做了最后的<w>告别</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "farewell"
                    ],
                    "common_phrases": [
                        "bid adieu"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in formal or literary writing."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "正式或深情的告别仪式，通常暗示长期的或永久的分离。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "告别",
                                "target_lang_sense_clarification": "指正式的离别仪式或行为。"
                            },
                            {
                                "target_lang_word": "辞行",
                                "target_lang_sense_clarification": "指远行前的正式告别。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}