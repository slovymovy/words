                                "example_id": "3022ec8c-ba4b-49ed-bceb-55f5edb858cf",
                                "sense_id": "e64666eb-b703-3c6e-b3ab-31ad121bd2f9",
                                "text": "Dat is deels een voordeel en deels ook niet."
                            }
                        ]
