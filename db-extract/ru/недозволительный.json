                                        "sense_id": "909c3e6e-dc95-3544-8919-11c54d1c3d61",
                                        "entry_id": "c192e016-1fbc-311d-9cdd-4877bc2872cf",
                                        "glosses": [
                                            "Qualifie les candidats qui n’ont pas obtenu l’admissibilité."
                                        ],
