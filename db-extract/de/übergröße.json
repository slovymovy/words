                ],
                "senses": [
                    {
                        "sense_id": "35054b8d-b4ca-3597-93c4-9ab1e02a7bbb",
                        "entry_id": "9df0ffd6-7017-3cdb-b142-2b87f443329d",
                        "glosses": [
                            "etwas, das die in der Bevölkerung überwiegend vertretenen oder die endgültig angestrebten beziehungsweise beherrschbaren Maße überschreitet"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "922b7403-1ace-47bc-86c0-f36536f45a64",
                                "sense_id": "35054b8d-b4ca-3597-93c4-9ab1e02a7bbb",
                                "text": "„Führt die Übergröße möglicher Katastrophen zu Unverantwortbarkeit im wahrsten Sinne des Wortes?“"
                            },
                            {
                                "example_id": "a07cd3aa-4836-4eca-920e-47b8b27ba979",
                                "sense_id": "35054b8d-b4ca-3597-93c4-9ab1e02a7bbb",
                                "text": "„Die Übergröße des heutigen Parteivorstands ist dieser Nachkriegsentwicklung geschuldet.“"
                            },
                            {
                                "example_id": "c0a13b01-0719-4354-8895-c48f50491053",
                                "sense_id": "35054b8d-b4ca-3597-93c4-9ab1e02a7bbb",
                                "text": "„Was versteht man unter Übergröße in der Vollkeramik?“"
                            },
                            {
                                "example_id": "2d4b95c9-66e2-4c89-8c65-59eac10d4bd2",
                                "sense_id": "35054b8d-b4ca-3597-93c4-9ab1e02a7bbb",
                                "text": "„Die Folgen der Übergröße des Kopfes für den Hergang der Geburt sind verschieden, nach der Verschiedenheit seiner Größe zu dem Raume des Beckens.“"
                            },
                            {
                                "example_id": "971ad7ca-c679-4feb-9383-cfa18d6c64b5",
                                "sense_id": "35054b8d-b4ca-3597-93c4-9ab1e02a7bbb",
                                "text": "„Die Ursache für die Übergröße der Neugeborenen und für die Veränderungen der Langerhansschen Inseln ist ebenfalls unbekannt, ein Zusammenhang mit der Höhe des Blutzuckerspiegels besteht nicht.“"
                            },
                            {
                                "example_id": "7e4e0f50-3dd8-415c-a886-1cc4c81cd92f",
                                "sense_id": "35054b8d-b4ca-3597-93c4-9ab1e02a7bbb",
                                "text": "„Die Kieferdehnung ist unter Verhältnissen, wie sie unserer Erörterung zugrunde liegen, dann angezeigt, wenn es sich nicht um einen Raummangel handelt, der bei einer normalen Kiefergröße und Form durch eine relative Übergröße der Zähne verursacht ist, sondern dann, wenn eine Untergröße der Kiefer, oft mit Formabweichungen gepaart, Raummangel für ein Gebiß bedingt, dessen Zähne normale Dimensionen aufweisen.“"
                            },
                            {
                                "example_id": "29db0441-e625-4540-bf4e-7da9fe4d35d6",
                                "sense_id": "35054b8d-b4ca-3597-93c4-9ab1e02a7bbb",
                                "text": "„Häufiger aber wird die Übergröße auch zumindest eines Elternteils einen deutlichen Hinweis darauf geben, daß der familiäre Großwuchs nichts mit der entwicklungsneurologisch-neuropädiatrischen Fragestellung zu tun hat.“"
                            },
                            {
                                "example_id": "b4892fd1-1a43-4bc5-9c13-aa627b37fe4e",
                                "sense_id": "35054b8d-b4ca-3597-93c4-9ab1e02a7bbb",
                                "text": "„Die hatte noch gefragt, ob es wohl bei den Särgen Übergrößen gebe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "195b313c-b31e-3d10-a12f-8722b7efb367",
                        "entry_id": "9df0ffd6-7017-3cdb-b142-2b87f443329d",
                        "glosses": [
                            "Kleidung oder Norm für diese, welche die in der Bevölkerung überwiegend vertretenen Maße überschreitet"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "7efdd9f7-9bd7-4ffc-9e7d-54f2bb6aa1a9",
                                "sense_id": "195b313c-b31e-3d10-a12f-8722b7efb367",
                                "text": "„Kapuzenpulli in Übergröße, ebenso die Hose, die man im Übrigen in den Kniekehlen trug.“"
                            },
                            {
                                "example_id": "7cb9d911-cef0-49c7-a105-31cb027e599c",
                                "sense_id": "195b313c-b31e-3d10-a12f-8722b7efb367",
                                "text": "„Das Imageproblem von Übergrößen lässt sich nur lösen, wenn sie so selbstverständlich wie jede andere Mode auch behandelt werden – und zwar von allen: den Kundinnen, Designern und Marketingexperten.“"
                            },
                            {
                                "example_id": "580c4e08-6b10-4d8a-89a6-aa091e48956a",
                                "sense_id": "195b313c-b31e-3d10-a12f-8722b7efb367",
                                "text": "„Im normalen Stadtbild wird der Trend zur Übergröße, quasi zur Maximierung des Kleidungsstücks, jenseits der üblichen Kleidernormen, wohl nie Einzug halten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
