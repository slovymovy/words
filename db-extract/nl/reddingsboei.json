                        "sense_id": "19296d6c-e88b-3590-a091-910fd3e91117",
                        "entry_id": "1afe6638-093d-3afd-a091-a4644f40adcc",
                        "glosses": [
                            "een drijvende ring die naar een drenkeling geworpen wordt om de drenkeling boven water te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1f415bc-8714-4bee-9eb3-1cbec0464070",
                                "sense_id": "19296d6c-e88b-3590-a091-910fd3e91117",
                                "text": "Toen zijn beste vriend in het water lag, bleek de reddingsboei uiterst handig."
                            },
                            {
                                "example_id": "51f674e7-11c5-41cb-9e72-8e0cc1bb8f06",
                                "sense_id": "19296d6c-e88b-3590-a091-910fd3e91117",
                                "text": "Laat je [opblaas]krokodil dan nooit achter, dat is je reddingsboei."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c74dbc23-cf91-4144-bea0-3687cab77865",
                        "source_entry_id": "1afe6638-093d-3afd-a091-a4644f40adcc",
                        "source_sense_id": "19296d6c-e88b-3590-a091-910fd3e91117",
                        "target_lang_word": "Rettungsring",
                        "target_lang_code": "de",
