                "senses": [
                    {
                        "sense_id": "caaaaea3-e2ff-36c0-8e54-07978b1b7cdb",
                        "entry_id": "77e94e6e-6fad-3574-a8eb-f55f98285954",
                        "glosses": [
                            "physikalische Größe, deren Wert sich weder beeinflussen lässt noch räumlich oder zeitlich verändert"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "4a4a936e-bb9a-4399-ab0d-0253be013216",
                                "sense_id": "caaaaea3-e2ff-36c0-8e54-07978b1b7cdb",
                                "text": "„Die Boltzmann-Konstante ist eine Naturkonstante, die in den Grundgleichungen der statistischen Mechanik eine zentrale Rolle spielt.“"
                            },
                            {
                                "example_id": "bd341dc2-84fd-4d16-b66d-af6ae2f8b6f7",
                                "sense_id": "caaaaea3-e2ff-36c0-8e54-07978b1b7cdb",
                                "text": "„Bei Änderungen der Naturkonstanten würden möglicherweise keine Sterne entstehen, die langlebig genug wären, um die Evolution von kohlenstoffbasiertem Leben zuzulassen.“"
                            },
                            {
                                "example_id": "c900c9ac-a546-4ab8-8e89-d86d81c3fceb",
                                "sense_id": "caaaaea3-e2ff-36c0-8e54-07978b1b7cdb",
                                "text": "„Und in beiden Fällen kommen wir nicht zum Ziel, wenn wir nicht auch eine universelle Naturkonstante, die Vakuum-Licht-Geschwindigkeit, mit ins Spiel bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
