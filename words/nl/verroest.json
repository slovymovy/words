                            {
                                "target_lang_word": "rust",
                                "target_lang_sense_clarification": "command to rust"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "rouille",
                                "target_lang_sense_clarification": "impératif du verbe rouiller"
                            }
                        ]
                    }
                }
