                        "examples": [
                            {
                                "example_id": "46d54f08-5b9b-43ce-ba5a-07c0e7061162",
                                "sense_id": "87b3735b-34c6-3b26-bf96-88b44bda118a",
                                "text": "Some others goe further and alledging or rather indeede abusing some peece of the Scripture, where it appeareth that the faithfull haue leaped and daunsed: they thinke verily that they haue founde the beane in the cake, as though this were a proper couerture & cloke to couer the infection and filthines of their daunces."
                            },
                            {
                                "example_id": "652caa65-41cb-448b-8bd3-b9fd0f827efd",
                                "sense_id": "87b3735b-34c6-3b26-bf96-88b44bda118a",
                                "text": "NAVARRE. It is enough if that Navarre may be Esteemed faithfull to the King of France: Whose service he may still commaund to death."
                            },
                            {
                                "example_id": "3be208f8-bca6-4f87-ae46-1f437efeebec",
                                "sense_id": "87b3735b-34c6-3b26-bf96-88b44bda118a",
                                "text": "Thy faithfull and unwearied servant SAMUEL HARTLIB."
                            }
                        ]
                    }
