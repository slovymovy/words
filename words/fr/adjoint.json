    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c4fae31-153d-3955-93d1-02db6d7dd32f",
                    "sense_definition": "Personne associée à une autre pour la seconder dans ses fonctions administratives, professionnelles ou de direction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "profession_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur et son <w>adjoint</w> ont présenté le bilan financier de l'année."
                        },
                        {
                            "text": "Elle a été nommée comme nouvelle collaboratrice auprès du proviseur <w>adjoint</w>."
                        }
                    ],
                    "synonyms": [
                        "assistant",
                        "collaborateur",
                        "second",
                        "suppléant"
                    ],
                    "common_phrases": [
                        "directeur adjoint",
                        "proviseur adjoint"
                    ]
                },
                {
                    "sense_id": "98814e15-5708-3d29-be32-2cbdee03c30c",
                    "sense_definition": "Élu municipal chargé d'assister le maire d'une commune et de le suppléer au besoin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "profession_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>adjoint</w> au maire a célébré le mariage en l'absence de ce dernier."
                        },
                        {
                            "text": "Le premier <w>adjoint</w> a pris la parole devant les habitants réunis à la mairie."
                        }
                    ],
                    "common_phrases": [
                        "adjoint au maire",
                        "premier adjoint"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "968cf322-d573-39df-a077-923444a865c9",
                    "sense_definition": "Qui est associé à un titre ou à un emploi principal pour en seconder le titulaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le secrétaire <w>adjoint</w> rédige le compte rendu de chaque réunion."
                        },
                        {
                            "text": "Ce médecin <w>adjoint</w> assure les gardes de nuit à l'hôpital central."
                        }
                    ],
                    "synonyms": [
                        "auxiliaire"
                    ],
                    "antonyms": [
                        "titulaire"
                    ],
                    "common_phrases": [
                        "secrétaire adjoint",
                        "médecin adjoint"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e866a04-bea6-3142-b2d6-905b7e08d55c",
                    "sense_definition": "Troisième personne du singulier de l'indicatif présent du verbe <w>adjoindre</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef de projet s'<w>adjoint</w> deux techniciens pour finaliser le logiciel à temps."
                        },
                        {
                            "text": "L'entreprise <w>adjoint</w> une garantie de deux ans à chaque appareil vendu."
                        }
                    ],
