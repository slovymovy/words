                                "target_senses": [
                                    {
                                        "sense_id": "93ba8df8-0b5e-36a9-a08e-979c4e504217",
                                        "entry_id": "536d4c0f-a3c4-343d-ae95-5c5af353bbb6",
                                        "glosses": [
                                            "Künstler, der Bilder malt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f94ddc0b-d54f-4280-a72a-c668bf0e7984",
                                                "sense_id": "93ba8df8-0b5e-36a9-a08e-979c4e504217",
                                                "text": "Guernica ist wohl das berühmteste Werk des Malers Picasso."
                                            },
                                            {
                                                "example_id": "cbc4855e-da0d-4047-a8eb-6ace4ad59d85",
                                                "sense_id": "93ba8df8-0b5e-36a9-a08e-979c4e504217",
                                                "text": "\"Hör zu, Maler, mal mir eine Frau / ohne Hemd, wie Gott sie schuf, / blonde Haare, der Zopf gelöst, / mit einem frechen Blümchen auf dem Kopf.\" (Original venez.: \"Senti, pitor, depenzime una donna / senza camisa, come Dio l’ha fata, / cavei biondi, e colla coa desfada, / e co un fioretto in testa alla barona.)"
                                            },
                                            {
                                                "example_id": "0ff91c0c-6695-4cfc-a92f-4d2837805be1",
                                                "sense_id": "93ba8df8-0b5e-36a9-a08e-979c4e504217",
                                                "text": "„Der Maler ließ Robert mit einer sichtlichen Aufmerksamkeit an der rechten Seite gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1f1ad25b-5f7b-3bf5-a6c2-287dc6b09387",
                                        "entry_id": "536d4c0f-a3c4-343d-ae95-5c5af353bbb6",
                                        "glosses": [
                                            "Handwerker, der beispielsweise Wände streicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b3c3715-a942-4472-bdab-9acef088855a",
                                                "sense_id": "1f1ad25b-5f7b-3bf5-a6c2-287dc6b09387",
                                                "text": "Morgen kommen die Maler und renovieren die Wohnung."
                                            },
                                            {
                                                "example_id": "5c68068e-108f-4103-a32a-b33ca6d31387",
                                                "sense_id": "1f1ad25b-5f7b-3bf5-a6c2-287dc6b09387",
                                                "text": "„Ludwig Bertini schien seine Aufgabe als Maurer, Maler, Installateur und Dachdecker sehr ernst zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91b13323-e5a7-40a6-94a5-a62cd99ddf6e",
                        "source_entry_id": "76145e81-a79c-386c-8fb1-84112df699d4",
