                        "source_sense_id": "5644890e-4773-3d14-a74d-d4d38bb4b474",
                        "target_lang_word": "колбасник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "колбасник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "27920cbf-8c73-34d6-bcd7-98798f26213d",
                                        "entry_id": "129a3744-026f-3ac8-9782-2e73e8c38308",
                                        "glosses": [
                                            "производитель колбас или торговец колбасами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b888f9a-3d8b-47da-9158-257bbc80a540",
                                                "sense_id": "27920cbf-8c73-34d6-bcd7-98798f26213d",
                                                "text": "За границей каждый колбасник есть урождённый философ, а каждый пар фюмер — урождённый политико-эконом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "890db4ff-0795-3070-b904-236329e81aa3",
                                        "entry_id": "129a3744-026f-3ac8-9782-2e73e8c38308",
                                        "glosses": [
                                            "устар., разг., пренебр. немец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23b7c1b2-c378-4fce-bf8c-e46cd3c4c85e",
                                                "sense_id": "890db4ff-0795-3070-b904-236329e81aa3",
                                                "text": "— Пошёл ты к чёрту! — перебили его другие. — В Германию, страну колбасников? Да им все морды побить надо!"
                                            },
                                            {
                                                "example_id": "9bab63a2-5b34-4ca6-aa17-1c402e8ae918",
                                                "sense_id": "890db4ff-0795-3070-b904-236329e81aa3",
                                                "text": ".. но теперь, с особенным удовольствием и естественностью относя причину беспорядков к бестолковым немцам, все убедились в том, что происходит вредная путаница, которую наделали колбасники."
                                            }
                                        ]
                                    }
                                ]
                            }
