                    {
                        "translation_id": "883dc5f1-a065-428b-adde-ff02ff434f7d",
                        "source_entry_id": "f58f5c6b-4bfb-3371-afac-07c303433c28",
                        "target_lang_word": "аванпост",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аванпост",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0357320d-6728-39d2-a491-bb9c8b18b206",
                                        "entry_id": "171ecc01-e65a-364c-8bba-2c34cd0db273",
                                        "glosses": [
                                            "устар., воен. передовой сторожевой пост, выставляемый в целях предупреждения внезапного нападения противника; место расположения такого поста"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7481479d-9295-4d1c-8c4d-00405c2da1a2",
                                                "sense_id": "0357320d-6728-39d2-a491-bb9c8b18b206",
                                                "text": "Проводник бежал, Суворов заблудился, проплутал всю ночь и рано утром, при выезде из леса, чуть не наткнулся на неприятельские аванпосты авангарда генерала Платена."
                                            },
                                            {
                                                "example_id": "1b6e3939-7d23-4b96-adc5-7a971853222e",
                                                "sense_id": "0357320d-6728-39d2-a491-bb9c8b18b206",
                                                "text": "Пулемет Родиона Малиновского был установлен на аванпосту №2."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5989ac9-0719-341a-bc53-3c6768ceeead",
                                        "entry_id": "171ecc01-e65a-364c-8bba-2c34cd0db273",
                                        "glosses": [
                                            "перен. передовой пункт, опора чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcfc17e1-3185-4ce3-8688-25d8cb20e083",
                                                "sense_id": "d5989ac9-0719-341a-bc53-3c6768ceeead",
                                                "text": "К пятому веку он [Херсонес] снова самое сильное государство в Крыму, распространитель христианства, огромная узловая и распределительная товарная станция, а для Византии — особо важный стратегический аванпост в борьбе с Диким Полем."
                                            },
                                            {
                                                "example_id": "3768553e-d9a7-470c-a4db-fdb86c65d61b",
                                                "sense_id": "d5989ac9-0719-341a-bc53-3c6768ceeead",
                                                "text": "Только в ГДР, на этом социалистическом аванпосту, мы имели около миллиона наших военнослужащих."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
