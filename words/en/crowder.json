{
    "word_family": [
        "crowd",
        "crowding",
        "crwth"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d61c58eb-d0a0-30f8-8ba5-0a78cab4770b",
                    "sense_definition": "A person who pushes or presses into a space with others",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>crowder</w> pushed his way through the subway doors before anyone could exit.",
                            "target_lang_translations": {
                                "ru": "Этот <w>толкающийся</w> проложил себе путь через двери метро до того, как кто-либо успел выйти."
                            }
                        },
                        {
                            "text": "Security had to remove the aggressive <w>crowder</w> who was making everyone uncomfortable in the line.",
                            "target_lang_translations": {
                                "ru": "Охране пришлось вывести агрессивного <w>наглеца</w>, который мешал всем в очереди."
                            }
                        }
                    ],
                    "synonyms": [
                        "pusher",
                        "shover"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который проталкивается или втискивается в пространство вместе с другими"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толкающийся",
                                "target_lang_sense_clarification": "человек в толпе"
                            },
                            {
                                "target_lang_word": "наглец",
                                "target_lang_sense_clarification": "проталкивающийся без очереди"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e0150c9-0bde-3cbe-a834-e740ddbe78d7",
                    "sense_definition": "A person who plays the crwth, an ancient Welsh string instrument; a fiddler",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musicians",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old song was sung by a blind <w>crowder</w> whose music moved the hearts of all who listened.",
                            "target_lang_translations": {
                                "ru": "Старую песню спел слепой <w>скрипач</w>, чья музыка тронула сердца всех слушателей."
                            }
                        },
                        {
                            "text": "In the medieval court, the <w>crowder</w> was responsible for providing entertainment during the evening feast.",
                            "target_lang_translations": {
                                "ru": "При средневековом дворе <w>кротист</w> отвечал за развлечение гостей во время вечернего пира."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiddler",
                        "minstrel"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to a historical musical role"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкант, играющий на кроте (древнем валлийском струнном инструменте); скрипач"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кротист",
                                "target_lang_sense_clarification": "игрок на кроте"
                            },
                            {
                                "target_lang_word": "скрипач",
                                "target_lang_sense_clarification": "устаревшее или народное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "09d4e117-3f5e-3e0a-a3f9-e16f96a568f6",
                    "sense_definition": "An English surname that originally referred to a player of the crwth",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Crowder</w> published a significant study on the history of folk music.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Краудер</w> опубликовал значительное исследование по истории народной музыки."
                            }
                        },
                        {
                            "text": "The local library was named after the <w>Crowder</w> family who donated the land.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Краудер</w>, которая пожертвовала землю."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "occupational origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от названия игрока на кроте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Краудер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21fb9d87-69a1-3051-93e5-670a586e7b0a",
                    "sense_definition": "A small town located in Panola and Quitman Counties, Mississippi",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through <w>Crowder</w> on their way to the northern part of Mississippi.",
                            "target_lang_translations": {
                                "ru": "Они проезжали через <w>Краудер</w> по пути в северную часть Миссисипи."
                            }
                        },
                        {
                            "text": "The community in <w>Crowder</w> is known for its quiet atmosphere and rural charm.",
                            "target_lang_translations": {
                                "ru": "Община в <w>Краудере</w> известна своей спокойной атмосферой и сельским очарованием."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой город в округах Панола и Квитмен, штат Миссисипи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Краудер",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31190e3a-0b98-384e-a21a-c6b17ad33fcb",
                    "sense_definition": "A town located in Pittsburg County, Oklahoma",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The fishing tournament was held near the town of <w>Crowder</w> by the lake.",
                            "target_lang_translations": {
                                "ru": "Рыболовный турнир проводился у озера рядом с городом <w>Краудер</w>."
                            }
                        },
                        {
                            "text": "Many residents of <w>Crowder</w> enjoy the proximity to Eufaula Lake.",
                            "target_lang_translations": {
                                "ru": "Многие жители <w>Краудера</w> наслаждаются близостью к озеру Юфола."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в округе Питтсбург, штат Оклахома"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Краудер",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65c9b89e-e106-3ddb-b449-02ed4d8bc15b",
                    "sense_definition": "An unincorporated community in Scott County, Missouri",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The historical map shows the small settlement of <w>Crowder</w> in rural Missouri.",
                            "target_lang_translations": {
                                "ru": "На исторической карте показано небольшое поселение <w>Краудер</w> в сельской местности Миссури."
                            }
                        },
                        {
                            "text": "Few people live in the unincorporated area of <w>Crowder</w> today.",
                            "target_lang_translations": {
                                "ru": "Сегодня на межселенной территории <w>Краудер</w> живет мало людей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Межселенная территория в округе Скотт, штат Миссури"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Краудер",
                                "target_lang_sense_clarification": "название поселения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}