                ],
                "senses": [
                    {
                        "sense_id": "7a5ae009-e634-36c3-bc42-25463c3ecccd",
                        "entry_id": "f6968a76-1cf3-3f21-930e-29eae42e435a",
                        "glosses": [
                            "ein Gemisch aus Süßwasser und Salzwasser, hauptsächlich an Flussmündungen ins Meer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca4dbe2-35df-4b0e-a83f-667cf39b5d78",
                                "sense_id": "7a5ae009-e634-36c3-bc42-25463c3ecccd",
                                "text": "Igelfische sind reine Meeresfische, nur ganz selten verirren sie sich ins Brackwasser, also zum Beispiel in den Mündungsbereich von Flüssen, wo sich Süß- und Salzwasser mischen."
                            },
                            {
                                "example_id": "d816b5f2-1727-491e-9742-35f1c8d4ca63",
                                "sense_id": "7a5ae009-e634-36c3-bc42-25463c3ecccd",
                                "text": "„Wo immer ich sein werde, wird mir ein Toter begegnen – im Graben verdorrt, von Trümmern erschlagen, im Brackwasser treibend, von Winterschnee konserviert.“"
                            },
                            {
                                "example_id": "dbb34fbe-3488-4a30-8168-6ce0dbc566b9",
                                "sense_id": "7a5ae009-e634-36c3-bc42-25463c3ecccd",
                                "text": "„Ich folgte ihr mit dem Blick bis Berg, vorbei an dem schleimigen Brackwasser bei Bergsbotn, über die Brücke nach Bjerka, dann hoch zu der Wohnsiedlung, wo das Gartenfest stattfand.“"
                            },
                            {
                                "example_id": "fc913746-71f9-465b-96d2-3537fbad0106",
                                "sense_id": "7a5ae009-e634-36c3-bc42-25463c3ecccd",
                                "text": "„Ohne Wimpel, ohne alles Brimborium treiben sie auf dem Brackwasser heran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
