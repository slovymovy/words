                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2d61d35-aafc-3d86-97ad-d83dab6a9c11",
                                        "entry_id": "989fd590-c4ef-36a9-9c9d-38d122d74d01",
                                        "glosses": [
                                            "The state of being capitalised.",
                                            "The state of having a particular case, such as ALL CAPS or all lowercase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76f08266-e29a-4e58-8986-44621560ccb8",
                                                "sense_id": "b2d61d35-aafc-3d86-97ad-d83dab6a9c11",
                                                "text": "His capitalisation was erratic: sometimes he wrote \"British\", sometimes \"british\", sometimes \"briTish\"..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89c99a86-a85e-35a9-bef4-e69e39a2ee6c",
                                        "entry_id": "989fd590-c4ef-36a9-9c9d-38d122d74d01",
                                        "glosses": [
                                            "The total value of all outstanding shares for a publicly traded company"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c261d5-0f0a-4eba-ba26-6ec17347c8e7",
                                                "sense_id": "89c99a86-a85e-35a9-bef4-e69e39a2ee6c",
                                                "text": "I doubt if one of them was interested in any business the total capitalization of which exceeded a couple of hundred thousand dollars."
                                            }
