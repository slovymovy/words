                "senses": [
                    {
                        "sense_id": "0eb4fad5-60db-35a7-9302-cba4b37f6c7e",
                        "entry_id": "24e8268f-bacd-3b7c-bf8f-2cc13e7a6ab1",
                        "glosses": [
                            "η αυστηρότητα, η σκληρότητα, το γεγονός ότι είναι σκληρό και αυστηρό"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1d48c8-119c-4b21-b6ba-5c549e923ed9",
                                "sense_id": "0eb4fad5-60db-35a7-9302-cba4b37f6c7e",
                                "text": "The harshness of the boss sometimes makes the work environment very uncomfortable.",
                                "translation": "Η αυστηρότητα του αφεντικού μερικές φορές κάνει το περιβάλλον εργασίας πολύ άβολο."
                            },
                            {
                                "example_id": "6acf4e33-4953-4a86-b7dd-40235281f3e8",
                                "sense_id": "0eb4fad5-60db-35a7-9302-cba4b37f6c7e",
                                "text": "The teacher showed harshness in dealing with the students who did not follow the school rules.",
                                "translation": "Ο δάσκαλος έδειξε σκληρότητα στην αντιμετώπιση των μαθητών που δεν τήρησαν τους κανόνες του σχολείου."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2188800-d1de-392a-8b67-8367aac9f4b4",
                        "entry_id": "24e8268f-bacd-3b7c-bf8f-2cc13e7a6ab1",
                        "glosses": [
                            "η δριμύτητα, το γεγονός ότι οι καιρικές συνθήκες ή συνθήκες ζωής είναι πολύ δύσκολες και δυσάρεστες για να ζω"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f8e6ba6-8e67-467a-b407-7ddba31d20ab",
                                "sense_id": "b2188800-d1de-392a-8b67-8367aac9f4b4",
                                "text": "the harshness of the winter in Alaska - η δριμύτητα του χειμώνα στην Αλάσκα"
                            }
                        ]
                    },
                    {
                        "sense_id": "2177e1fc-b8cf-38b1-9d1d-ff5546971416",
                        "entry_id": "24e8268f-bacd-3b7c-bf8f-2cc13e7a6ab1",
                        "glosses": [
                            "η σκληρότητα, το γεγονός ότι είναι πολύ δυνατό και φωτεινό· το γεγονός ότι είναι άσχημο ή δυσάρεστο"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6c9df2d-3003-43aa-9984-a69923397cdc",
                                "sense_id": "2177e1fc-b8cf-38b1-9d1d-ff5546971416",
                                "text": "The harshness of the sun during the summer affects our health.",
                                "translation": "Η σκληρότητα του ήλιου κατά τη διάρκεια του καλοκαιριού επηρεάζει την υγεία μας."
                            }
                        ]
                    },
                    {
                        "sense_id": "663e107a-0929-33ce-ba82-6fcaafb34b81",
                        "entry_id": "24e8268f-bacd-3b7c-bf8f-2cc13e7a6ab1",
                        "glosses": [
                            "η σκληρότητα, το γεγονός ότι είναι δυσάρεστο να ακούω"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50481b8d-0da4-4639-a9a2-e558067da038",
                                "sense_id": "663e107a-0929-33ce-ba82-6fcaafb34b81",
                                "text": "The harshness of the noise was unbearable.",
                                "translation": "Η σκληρότητα του θορύβου ήταν ανυπόφορη."
                            }
                        ]
                    },
                    {
                        "sense_id": "11c02c1e-e161-3066-880c-3973e5b0ec8a",
                        "entry_id": "24e8268f-bacd-3b7c-bf8f-2cc13e7a6ab1",
                        "glosses": [
                            "η σκληρότητα, το γεγονός ότι είναι πολύ δυνατό και σκληρό και είναι πιθανό να βλάψει κάτι"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa43343-9554-48f0-b32d-9a8ccfa1a377",
                                "sense_id": "11c02c1e-e161-3066-880c-3973e5b0ec8a",
                                "text": "The tobacco industry adds flavors to reduce the harshness of the smoke.",
                                "translation": "Η βιομηχανία καπνού προσθέτει γεύσεις για να μειώσει τη σκληρότητα του καπνού."
                            }
                        ]
                    }
                ],
