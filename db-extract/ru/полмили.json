                        "glosses": [
                            "половина мили"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b8f50b6-3424-49e6-8f02-3c0a9bd2adc5",
                                "sense_id": "2dcefd46-9ed3-371e-afb4-c69cd4426960",
                                "text": "На русском корабле «Не тронь меня!» оказалась сильная течь; он замыкал линию слева, почти опираясь на каменную гряду подводных камней, которая на полмили простиралась в море параллельно с берегом."
                            },
                            {
                                "example_id": "40418ddf-6949-4c69-846d-f00c62864f25",
                                "sense_id": "2dcefd46-9ed3-371e-afb4-c69cd4426960",
                                "text": "В полумили от Ревансера дорога разветвляется по трем подъемам, упомянутым выше: Лун, Семеррехш и Наль-шикен."
                            }
                        ]
                    }
                ],
