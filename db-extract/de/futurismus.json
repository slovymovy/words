                                        "examples": [
                                            {
                                                "example_id": "c85be00e-457b-4564-a1ed-8d17cd1378b1",
                                                "sense_id": "04143c35-df9d-3dd5-a9c7-0b96316366b5",
                                                "text": "Suffice it to say that Futurism has a gratifying dislike both of Liberal politics and Christian morals; I say gratifying because, however unfortunately the cross and the cap of liberty have quarrelled, they are always united in the feeble hatred of such silly megalomaniacs as these. […"
                                            }
                                        ]
