                "translations": [
                    {
                        "translation_id": "bdbc570e-53ce-48a1-b2a3-1024fad8a0ec",
                        "source_entry_id": "8db65e6a-e65a-38c3-84fa-28c36e42136f",
                        "source_sense_id": "67e9bc6c-f1e5-3deb-be6a-938b54ce8e6e",
                        "source_sense_description": "schijngestalte van de maan",
                        "target_lang_word": "Halbmond",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbmond",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "118bed6a-0712-34e4-be6f-f43ccfac6112",
                                        "entry_id": "6e58b1c7-de9d-3a41-92e5-4f4bbbd01d5a",
                                        "glosses": [
                                            "der Mond, wenn er zur Hälfte beleuchtet ist (genau im ersten oder letzten Viertel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "081f889c-a051-4198-8444-135dc1436b02",
                                                "sense_id": "118bed6a-0712-34e4-be6f-f43ccfac6112",
                                                "text": "Heute haben wir Halbmond (der Mond steht im 1. Viertel)."
                                            },
                                            {
                                                "example_id": "81fcb3c0-4aa9-49b9-abf8-ef2d7fd912c8",
                                                "sense_id": "118bed6a-0712-34e4-be6f-f43ccfac6112",
                                                "text": "„Der Mond schien, ein Halbmond, und sie konnten die weißen Shorts des Mädchens erkennen, die sich gegen die dunklen Sanddünen abzeichneten.“"
                                            },
                                            {
                                                "example_id": "268ab8a2-3b8e-40fe-9366-3e8520964dc2",
                                                "sense_id": "118bed6a-0712-34e4-be6f-f43ccfac6112",
                                                "text": "„Der Leutnant hatte sich zurückgezogen, und die Nacht war hereingebrochen, der Halbmond schwand eben hinter den westlichen Baumwipfeln hinab, der alte Mann war aufgestanden und trat schweigend mit seinem Gaste vor die Türe.“"
                                            },
                                            {
                                                "example_id": "34190f99-babd-4203-8c4a-031a5cc68a47",
                                                "sense_id": "118bed6a-0712-34e4-be6f-f43ccfac6112",
                                                "text": "„Schwere Wolken zogen langsam über den Himmel, und gelegentlich guckte ein Halbmond durch die Wolkenritzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53313592-3865-309f-b891-3267a4801c06",
                                        "entry_id": "6e58b1c7-de9d-3a41-92e5-4f4bbbd01d5a",
                                        "glosses": [
                                            "ein Symbol in Form einer Mondsichel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3060fb4e-ab49-450f-a7b3-afd3aa04802b",
                                                "sense_id": "53313592-3865-309f-b891-3267a4801c06",
                                                "text": "Die türkische Flagge zeigt einen Halbmond."
                                            },
                                            {
                                                "example_id": "83f82573-22e8-4d8c-b1bf-5e4d3adbc229",
                                                "sense_id": "53313592-3865-309f-b891-3267a4801c06",
                                                "text": "Fruchtbarer Halbmond, Roter Halbmond"
                                            },
                                            {
                                                "example_id": "f58026b8-d0d1-4481-8eeb-73afcb809ec5",
                                                "sense_id": "53313592-3865-309f-b891-3267a4801c06",
                                                "text": "„Am 30. September 1967 markierte es dies mit der Herausgabe eigener Briefmarken, auf denen die rot-grüne Nationalflagge mit Halbmond und Krummdolch prangte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b02f01a6-b383-3fbe-993e-d3778d44168d",
                                        "entry_id": "6e58b1c7-de9d-3a41-92e5-4f4bbbd01d5a",
                                        "glosses": [
                                            "das Möndchen (Lunula), der sichtbare halbmondförmige Teil der Matrix von Finger- oder Zehennagel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25c6af2-1bc2-4ef1-b78e-ee9ed5233b07",
                                                "sense_id": "b02f01a6-b383-3fbe-993e-d3778d44168d",
                                                "text": "Meine Halbmonde sind ganz verschieden groß."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
