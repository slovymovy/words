                        "examples": [
                            {
                                "example_id": "8b87d074-9ffd-4d9d-a355-25b80d49237d",
                                "sense_id": "136f7f21-2de9-3e56-9a5d-f13f7b6c236e",
                                "text": "„Ihre Tugend nötigte sie, alles so darzustellen, als wolle sie ihr beteuern, daß sie sich trotz ihrer Betörtheit niemals von ihr gelöst habe.“"
                            },
                            {
                                "example_id": "bc1e794e-dca6-49d7-a64a-cbaec8bf7e75",
                                "sense_id": "136f7f21-2de9-3e56-9a5d-f13f7b6c236e",
                                "text": "„Nach einer Weile stellte sich der Blick von Betörtheit auf Klarsicht um: Unangestrengter Spaß-Metal, Posing von Herzen, Glamour, der sich nicht parodiert.“"
                            }
                        ],
