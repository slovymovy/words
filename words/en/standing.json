                {
                    "sense_id": "bfc08f78-402f-3499-99d3-133e9f500329",
                    "sense_definition": "Continuing to exist or remain valid without changing; permanent or established.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adj_permanent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have a <w>standing</w> invitation to visit my parents whenever we want.",
                            "target_lang_translations": {
                                "ru": "У нас есть <w>постоянное</w> приглашение навещать моих родителей, когда мы захотим.",
                                "zh": "我们随时都可以去看望我父母，他们的邀请一直是<w>长期有效的</w>。"
                            }
                        },
                        {
                            "text": "The club formed a <w>standing</w> committee to handle finances.",
                            "target_lang_translations": {
                                "ru": "Клуб сформировал <w>постоянный</w> комитет для управления финансами.",
                                "zh": "俱乐部成立了一个<w>常设的</w>委员会来管理财务。"
                            }
