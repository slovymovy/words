                        "cross_references": [
                            {
                                "target_word": "environmental science",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be9d9ccd-b5c7-32ff-bd0a-70bb00844a22",
                                        "entry_id": "a5827b65-5f15-3da7-8508-158acf4bcf17",
                                        "glosses": [
                                            "The integrated study of factors that influence the environment and environmental systems, especially the interaction of the physical, chemical, and biological components of the environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
