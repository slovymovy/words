                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3094d1d-3dff-4862-bc91-8f31a439eda7",
                                "sense_id": "d84d23e6-9bbc-3c8f-9b26-9e2e2f6b3567",
                                "text": "De coalitieonderhandelingen zijn hiermee terug in het stadium van twee weken geleden. Toen trok Geert Wilders de stekker uit de onderhandelingen, voornamelijk door onrust binnen het CDA. Toen vorige week maandag Ab Klink, één van de criticasters binnen het CDA, uit de fractie stapte, was er voor Wilders voldoende reden om opnieuw een poging te wagen. Tjeenk Willink leidde de afgelopen week een informatieronde, om te onderzoeken of opnieuw onderhandelen over een rechts kabinet nog zin zou hebben."
                            },
                            {
                                "example_id": "7c1361cd-09f6-4948-8e7f-4414e0ca8817",
                                "sense_id": "d84d23e6-9bbc-3c8f-9b26-9e2e2f6b3567",
                                "text": "Informateur Tjeenk Willink geeft vanmiddag om 13.00 uur een toelichting op zijn werkzaamheden. Gisteren kreeg hij van koningin Beatrix de opdracht een informatieronde te houden en haar op korte termijn te informeren over de situatie en de vervolgstappen."
                            }
                        ]
                    }
