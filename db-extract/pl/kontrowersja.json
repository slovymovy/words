                                            {
                                                "example_id": "7193b6a6-323f-482c-b1be-bc3f5c2d76da",
                                                "sense_id": "1cf0a6a0-48cb-3eaf-a7cf-0883e847b15f",
                                                "text": "Bij biologen bestaat er geen controverse meer over de theorie van Darwin."
                                            },
                                            {
                                                "example_id": "aff85763-31bf-403c-a4af-de171b5531e5",
                                                "sense_id": "1cf0a6a0-48cb-3eaf-a7cf-0883e847b15f",
                                                "text": "Ze nam zich voor de zoveelste keer voor om rustig aan te doen, geen onderwerpen aan te snijden die eventueel een controverse uitlokten."
