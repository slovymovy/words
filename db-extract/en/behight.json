                "senses": [
                    {
                        "sense_id": "98b69a51-3dc8-3b26-8eba-0e5c5041749c",
                        "entry_id": "7cb71b65-7eb0-326c-8a5d-263c5ab3594a",
                        "glosses": [
                            "To vow, promise (someone)."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "23c47cb4-59c3-46de-8bac-0dee48d91154",
                                "sense_id": "98b69a51-3dc8-3b26-8eba-0e5c5041749c",
                                "text": "Thenne I behote yow sayd Balyn parte of his blood to hele youre sone with alle."
                            }
                        ]
                    },
                    {
                        "sense_id": "d919a5e6-8128-3e16-b136-8b53327363b3",
                        "entry_id": "7cb71b65-7eb0-326c-8a5d-263c5ab3594a",
                        "glosses": [
                            "To be designated."
                        ],
                        "tags": [
                            "Northern-England",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "ada0366c-d8c6-4444-9b56-d07c03aa2db8",
                                "sense_id": "d919a5e6-8128-3e16-b136-8b53327363b3",
                                "text": "Wheea behight thee? = What is your name/to whom do you belong?"
                            }
                        ]
                    },
                    {
                        "sense_id": "d551a84d-969b-32e4-bb3f-5bedafba96d6",
                        "entry_id": "7cb71b65-7eb0-326c-8a5d-263c5ab3594a",
                        "glosses": [
                            "To give in trust; to commit; to entrust."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a692ec2b-7840-43e0-82e9-683795ad195a",
                                "sense_id": "d551a84d-969b-32e4-bb3f-5bedafba96d6",
                                "text": "The keys are to thy hand behight."
                            }
                        ]
                    },
                    {
                        "sense_id": "724c46f0-577e-3bd2-935c-40233e2e2fdd",
                        "entry_id": "7cb71b65-7eb0-326c-8a5d-263c5ab3594a",
                        "glosses": [
                            "To mean, or intend."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c651a26f-94e6-4eed-aec1-f0fa72be5616",
                                "sense_id": "724c46f0-577e-3bd2-935c-40233e2e2fdd",
                                "text": "More than heart behighteth."
                            }
                        ]
                    },
                    {
                        "sense_id": "96c06d40-00bf-3677-9398-d6c71d309e1b",
                        "entry_id": "7cb71b65-7eb0-326c-8a5d-263c5ab3594a",
                        "glosses": [
                            "To consider or esteem to be; to declare to be."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1828c4c2-621b-4933-9127-4e41945a211c",
                                "sense_id": "96c06d40-00bf-3677-9398-d6c71d309e1b",
                                "text": "But nathelesse whilst all the lookers on / Him dead behight, as he to all appeard, / All vnawares he started vp anon,"
                            }
                        ]
                    },
                    {
                        "sense_id": "ad715b0d-3ccf-3efb-b206-482b779c6fb1",
                        "entry_id": "7cb71b65-7eb0-326c-8a5d-263c5ab3594a",
                        "glosses": [
                            "To call; to name; to address."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "07e075f6-5273-4a65-8ed7-3283e2792c68",
                                "sense_id": "ad715b0d-3ccf-3efb-b206-482b779c6fb1",
                                "text": "Whom […] he knew and thus behight."
                            }
                        ]
                    },
                    {
                        "sense_id": "701d6e68-c255-3bc9-ab62-7ad500fc8d53",
                        "entry_id": "7cb71b65-7eb0-326c-8a5d-263c5ab3594a",
                        "glosses": [
                            "To command; to order."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fa704ca8-7a9f-410a-9d82-158dd26b88f6",
                                "sense_id": "701d6e68-c255-3bc9-ab62-7ad500fc8d53",
                                "text": "And his well proued weapons to him hent; / So taking courteous conge he behight, / Those gates to be vnbar'd, and forth he went."
                            }
                        ]
                    }
