                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "b9266073-4a62-4583-92a6-bc7a8ff4dfe6",
                                "sense_id": "02c1363e-1c55-3365-b27b-05ceafb024ba",
                                "text": "Aktivisten aus dem Nachbarland Belarus brachten den Angriff in Zusammenhang mit dem Start mehrerer russischer Kampfflugzeuge von Flugplätzen in Belarus. Der dortige Machthaber Alexander Lukaschenko stellt den russischen Truppen sein Land als Aufmarschgebiet gegen die Ukraine zur Verfügung."
                            }
                        ]
                    }
