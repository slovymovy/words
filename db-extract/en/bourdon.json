                ],
                "senses": [
                    {
                        "sense_id": "103d84cc-2634-3ba0-9e3b-f4dcfd81c1ad",
                        "entry_id": "07b3fe8c-5cb7-319b-96ed-bbbe1d2c2a9f",
                        "glosses": [
                            "The burden or bass of a melody."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "23c2914a-3fb2-452f-9b3b-ec0dd1780a5e",
                                "sense_id": "103d84cc-2634-3ba0-9e3b-f4dcfd81c1ad",
                                "text": "The earth tremors resumed and made a bourdon to the loud psalms that they sang, interspersed with the odd ode of Horace recited by Silas."
                            }
                        ]
                    },
                    {
                        "sense_id": "91bec3ec-1ce9-37de-9585-95c320182358",
                        "entry_id": "07b3fe8c-5cb7-319b-96ed-bbbe1d2c2a9f",
                        "glosses": [
                            "The drone pipe of a bagpipe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b7a3e577-0390-3e9f-b5aa-57e274c183c7",
                        "entry_id": "07b3fe8c-5cb7-319b-96ed-bbbe1d2c2a9f",
                        "glosses": [
                            "The lowest-pitched stop of an organ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c7fd64b-b9f9-4c82-9c41-3190fcc896f0",
                                "sense_id": "b7a3e577-0390-3e9f-b5aa-57e274c183c7",
                                "text": "The dim roar of London was like the bourdon note of a distant organ."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c7c1330-e25b-37ee-be4b-eae5d19ffade",
                        "entry_id": "07b3fe8c-5cb7-319b-96ed-bbbe1d2c2a9f",
                        "glosses": [
                            "The lowest-pitched bell of a carillon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "647451b1-1dd8-355e-a164-f6e74d354166",
                        "entry_id": "07b3fe8c-5cb7-319b-96ed-bbbe1d2c2a9f",
