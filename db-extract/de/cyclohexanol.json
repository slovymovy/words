                "senses": [
                    {
                        "sense_id": "39ca24a2-91c3-3203-9754-919c129f0115",
                        "entry_id": "adaed540-caad-3f94-bc4c-f6d1f2b08088",
                        "glosses": [
                            "brennbare, farblose und kristalline Substanz, die ein einwertiger, zyklischer und sekundärer Alkohol ist – Derivat des Cyclohexans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abd4bb2b-0321-4728-a384-a1c60fc70b76",
                                "sense_id": "39ca24a2-91c3-3203-9754-919c129f0115",
                                "text": "Cyclohexanol bildet mit Luft ein explosionsfähiges Gemisch."
                            },
                            {
                                "example_id": "7df6976d-a760-44b0-8836-000e39aa3590",
                                "sense_id": "39ca24a2-91c3-3203-9754-919c129f0115",
                                "text": "Zur Herstellung von Lacken, Bohnermassen, Schuhcremes und Kunststoffen wird Cyclohexanol verwendet."
                            },
                            {
                                "example_id": "74377bd1-601b-4973-ae66-0bfee1deffd0",
                                "sense_id": "39ca24a2-91c3-3203-9754-919c129f0115",
                                "text": "Cyclohexanol ist eine Standardbezugssubstanz in der Gaschromatografie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
