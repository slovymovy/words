                        "sense_id": "edccc914-8d5a-3ee9-b141-7e3bbfc7ec30",
                        "entry_id": "e5f0df20-a0c3-30aa-ab2d-e46b9348e561",
                        "glosses": [
                            "Having socialist tendencies."
                        ],
                        "tags": [],
