                            {
                                "example_id": "0355cf09-d5ef-4dee-aa2f-a8131742658e",
                                "sense_id": "429f0283-412a-3ea6-bbe2-723fdc202e61",
                                "text": "[…] had alighted upon this magnificent chamber; and, tired with his tedious explorations, was unable to resist the delicious invitement to repose, which he there saw exhibited; […]"
                            },
                            {
                                "example_id": "2f206ced-ce79-4dab-b4e5-5a72121335f7",
                                "sense_id": "429f0283-412a-3ea6-bbe2-723fdc202e61",
                                "text": "These are great invitements unto men to become saints."
                            },
                            {
                                "example_id": "55739d33-a7e3-4f77-aab3-e4a2c9538de7",
                                "sense_id": "429f0283-412a-3ea6-bbe2-723fdc202e61",
                                "text": "I'll seek no other ordinary then, / But be his daily guest without invitement; […]"
                            },
                            {
                                "example_id": "862dfdce-c202-4a17-8dbd-f3d3f7cbfa0b",
                                "sense_id": "429f0283-412a-3ea6-bbe2-723fdc202e61",
                                "text": "Nor would I wish any invitement of states or friends, only your reverent presence and witness shall sufficiently grace and confirm us."
                            }
                        ]
                    }
                ],
