        "ru-extract.jsonl": [
            {
                "entry_id": "29766df2-4fa4-366d-a813-0a346318cde1",
                "word": "Горбачёв",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "258de1a9-be62-3acb-81c9-cb40b21d9ee5",
                        "entry_id": "29766df2-4fa4-366d-a813-0a346318cde1",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3f9760d-c199-430b-a956-3b823d0bc003",
                                "sense_id": "258de1a9-be62-3acb-81c9-cb40b21d9ee5",
                                "text": "В начале 1989 года, когда Горбачёвым было сказано, что Советский Союз не будет силой удерживать соцлагерь в тогдашних границах, я написал в отчёте в Бонн, что воссоединение Германии ― вопрос времени."
                            },
                            {
                                "example_id": "87dbf60b-6923-4ef0-867b-605a84292006",
                                "sense_id": "258de1a9-be62-3acb-81c9-cb40b21d9ee5",
                                "text": "Так, мы пропустили Горбачёва с его перестройкой. Чем это кончилось ― сегодня все знают."
                            },
                            {
                                "example_id": "298df42f-ba59-42d8-94e0-d93d2443c3b7",
                                "sense_id": "258de1a9-be62-3acb-81c9-cb40b21d9ee5",
                                "text": "8 апреля 1986 года в Тольятти генсек Горбачёв произнесёт слово «перестройка». Страна радостно вздрогнет ― она ещё не знает, что вздрагивать ей теперь придётся частенько."
                            }
                        ]
                    },
                    {
                        "sense_id": "4009921c-3247-3485-b8af-585308defe4c",
                        "entry_id": "29766df2-4fa4-366d-a813-0a346318cde1",
                        "glosses": [
                            "перен. о руководителе тоталитарного либо авторитарного государства, проводящем демократические реформы"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
