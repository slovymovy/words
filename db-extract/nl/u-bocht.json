                    },
                    {
                        "translation_id": "57df9ef6-584f-456d-b2ec-233e97f7ae19",
                        "source_entry_id": "e7bd1447-a884-38e5-b114-9a96da04f7be",
                        "source_sense_id": "75b001a8-006c-35b8-9dfa-afd2b803e414",
                        "source_sense_description": "bocht van 180°",
                        "target_lang_word": "U-turn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "U-turn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2206a519-20f3-3b7e-a64b-2d2975a7f6b3",
                                        "entry_id": "90e89974-77e8-373d-8a0a-4edeab15fed0",
                                        "glosses": [
                                            "A turn in a vehicle carried out by driving in a semicircle in order to travel in the opposite direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "963503ac-2ab8-4e2d-9041-676bfa47e423",
                                                "sense_id": "2206a519-20f3-3b7e-a64b-2d2975a7f6b3",
                                                "text": "What's disappointing about all this doom and gloom is that the franchise has made the kind of whiplashing U-turn you might see in its car-chase sequences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ab024b5-4aa6-32c4-84d8-30f16ad74a21",
                                        "entry_id": "90e89974-77e8-373d-8a0a-4edeab15fed0",
                                        "glosses": [
                                            "A reversal of policy or opinion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d45cd7c3-ddcc-440f-a033-c70f0819d373",
                                                "sense_id": "5ab024b5-4aa6-32c4-84d8-30f16ad74a21",
                                                "text": "The government have done a U-turn and are now supporting greater European integration instead of opposing it."
                                            },
                                            {
                                                "example_id": "4085e311-f18e-4537-b992-61ea220679ae",
                                                "sense_id": "5ab024b5-4aa6-32c4-84d8-30f16ad74a21",
                                                "text": "Rishi Sunak, the UK prime minister, announced a major U-turn on the government’s climate commitments last month, pushing back the deadline for selling new petrol and diesel cars and the phasing out of gas boilers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "U-turn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b977e62d-caff-3a10-93f5-f0de9162aeed",
                                        "entry_id": "a4551d5b-c036-3a2d-929a-648d025181da",
                                        "glosses": [
                                            "To turn a vehicle in a semicircle so as to face the opposite direction (∩))."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88b8479a-2a79-3f96-ade0-86a1d2494aa5",
                                        "entry_id": "a4551d5b-c036-3a2d-929a-648d025181da",
                                        "glosses": [
                                            "To shift from one opinion or decision to its opposite."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a96ef82-8aa5-46c6-9597-e08a9d658fc9",
                                                "sense_id": "88b8479a-2a79-3f96-ade0-86a1d2494aa5",
                                                "text": "She made the case for cutting taxes as “the right thing to do morally and economically”, despite having just U-turned over her decision to abolish the 45p top rate of income tax."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5564a676-5836-4d05-a971-75bed019fd80",
                        "source_entry_id": "e7bd1447-a884-38e5-b114-9a96da04f7be",
                        "source_sense_id": "75b001a8-006c-35b8-9dfa-afd2b803e414",
                        "source_sense_description": "bocht van 180°",
                        "target_lang_word": "demi-tour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-tour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f87446b-7a4a-3d34-9a9a-47e14afefc3b",
                                        "entry_id": "2f03362f-f9f0-3e42-ace0-6a5d3afa2b49",
                                        "glosses": [
                                            "Moitié d’un tour sur soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eb929f9-e826-46b9-809f-3d7aacf5088b",
                                                "sense_id": "7f87446b-7a4a-3d34-9a9a-47e14afefc3b",
                                                "text": "Demi-tour à droite… droite !…"
                                            },
                                            {
                                                "example_id": "f2369d3f-042e-4325-9dca-3ae5ebc256e3",
                                                "sense_id": "7f87446b-7a4a-3d34-9a9a-47e14afefc3b",
                                                "text": "Nous sommes pareils, mais nos choix vont en sens inverse, un peu comme dans les anciens manuels militaires où l’on nous apprenait que faire sur place demi-tour à gauche est exactement la même chose que faire demi-tour à droite, seulement c’est le contraire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bdbe0fe-e2be-35ec-a25e-6a6f5b6aea3a",
                                        "entry_id": "2f03362f-f9f0-3e42-ace0-6a5d3afa2b49",
                                        "glosses": [
                                            "Virage ou angle à 180 degrés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae9cac36-bd0a-4cdd-a4b6-f0ee548facc5",
                                                "sense_id": "3bdbe0fe-e2be-35ec-a25e-6a6f5b6aea3a",
                                                "text": "Mais le taxi terminait son demi-tour et Dieuble eut un sursaut d’estomaquement en lisant la marque de l'automobile, plaquée-or sur l'aile arrière : « Ouzbek »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
