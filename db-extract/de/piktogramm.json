                    }
                ],
                "senses": [
                    {
                        "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                        "entry_id": "05623b7f-b9fd-34dd-a0d1-4b3e7987c94c",
                        "glosses": [
                            "bildliches Zeichen, das eine Information beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e394a325-19c7-4506-87e6-536d8e498d38",
                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                "text": "Die chinesische Schrift entwickelte sich aus Piktogrammen."
                            },
                            {
                                "example_id": "b8fa86e1-3030-40a9-8119-d004794c750c",
                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                "text": "Die Steinzeitmenschen benutzten Piktogramme für ihre Höhlenmalerei, um ihre Erlebnisse niederzuschreiben."
                            },
                            {
                                "example_id": "6a2a5548-3bee-46f1-b02b-b31c790c082b",
                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                "text": "„Zur Genüge kennt man ja Piktogramme in Form von Verbotsschildern…“"
                            },
                            {
                                "example_id": "1d088b3f-0518-48af-93af-faea0bf79ebc",
                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                "text": "„Piktogramme haben gegenüber Schriftzeichen mehrere Vorteile: Sie sind international verständlich, sie sind Zeit sparend (sowohl beim Lesen als auch beim Schreiben) und Platz sparend (beim Schreiben).“"
                            },
                            {
                                "example_id": "3b38fa4a-2ce0-43dc-a41f-1d677cd09591",
                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                "text": "„Es sind Piktogramme, die jeweils auf einen Gegenstand oder ein bestimmtes Wesen hinweisen.“"
                            },
                            {
                                "example_id": "3a8769a2-aa7c-4b9a-8ef4-6271a69dd730",
                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                "text": "„Auch diese Höhlenmalereien sind Wörter, eine ganze Wand voller Piktogramme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
