                ],
                "senses": [
                    {
                        "sense_id": "5baffe31-e67b-31fd-8be8-8e4499b62145",
                        "entry_id": "d0e88121-d7c9-37d1-ba4c-68de531c3357",
                        "glosses": [
                            "ou Garçon de café."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9821b902-721c-4dad-b58f-7f9998a83850",
                                "sense_id": "5baffe31-e67b-31fd-8be8-8e4499b62145",
                                "text": "Eh toi, loufiat, cria-t-il au garçon, voilà de la braise, éteins-la, il y a cinq chopines à payer et en avant les paladins !"
                            },
                            {
                                "example_id": "9ba25be7-bc56-47d7-be88-72521dab98f8",
                                "sense_id": "5baffe31-e67b-31fd-8be8-8e4499b62145",
                                "text": "Le loufiat haussa discrètement les épaules. Y a longtemps qu’elle était prête, la bouteille !"
                            },
                            {
                                "example_id": "f17f7827-70ec-410d-925f-a6b57d56ed2b",
                                "sense_id": "5baffe31-e67b-31fd-8be8-8e4499b62145",
                                "text": "Comme un loufiat passait d’aventure, Fédor Balanovitch lui dit : — Pour moi, ce sera un jus de bière."
                            },
                            {
                                "example_id": "7c927962-f381-4d57-8c91-d82ebc90863f",
                                "sense_id": "5baffe31-e67b-31fd-8be8-8e4499b62145",
                                "text": "On passe d’autorité une commande pantagruélique au loufiat."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2e35e50-bf62-3cf3-9dd0-a57c2641db8c",
                        "entry_id": "d0e88121-d7c9-37d1-ba4c-68de531c3357",
                        "glosses": [
                            "Domestique, esclave, larbin, homme sans caractère."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "eff83ae4-f42c-4b70-8bf6-0af0fa05ab2f",
                                "sense_id": "c2e35e50-bf62-3cf3-9dd0-a57c2641db8c",
                                "text": "[…] le comportement minable dans les hôtels de luxe, exigeant d’être servi comme un seigneur sans bourse délier, la dénonciation des loufiats […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a4b0c647-14a7-3f09-859e-0623e58c733c",
                        "entry_id": "d0e88121-d7c9-37d1-ba4c-68de531c3357",
                        "glosses": [
                            "Lieutenant de vaisseau"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f66d81e0-197a-4043-abe8-f030671da855",
                                "sense_id": "a4b0c647-14a7-3f09-859e-0623e58c733c",
                                "text": "Nous nous sommes bien entendus avec notre loufiat, mais nous étions encore loin de mai 68 […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4a360ac-b335-4f19-8c84-bbef8ffedf99",
                        "source_entry_id": "d0e88121-d7c9-37d1-ba4c-68de531c3357",
                        "target_lang_word": "Diener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                        "entry_id": "d2873e8b-0454-3b11-8ce1-2a3ea17e181a",
                                        "glosses": [
                                            "abhängig Arbeitender, der für seinen Herren bestimmte häusliche Pflichten erfüllt, Hausangestellter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a50e2859-faf4-4db0-a8ef-7d9d31f754b2",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "Ein Diener lernt auf einer speziellen Schule, wie er sich gegenüber dem Herren verhalten muss."
                                            },
                                            {
                                                "example_id": "7170e4bf-1d7d-44cd-815e-e67536cf21b6",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Es nützte nichts, weder der Priester noch sonst jemand vermochte ihn davon abzubringen, daß ich nicht sein Diener, sondern sein Sklave sei…“"
                                            },
                                            {
                                                "example_id": "23226876-6de2-4650-a8d3-e81ee59ea5c7",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Die Einzigen von ihnen, die jemals ihren Fuß in die Stadt setzten, waren die schwarzen Diener und Dienerinnen, welche die Plantagenbesitzer von den karibischen Inseln mitbrachten, wenn sie Frankreich einen Besuch abstatteten.“"
                                            },
                                            {
                                                "example_id": "cbf1718a-5aa3-4572-a9e9-0fc6958b3852",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Mit dem »ganz ollen Vietzke« ist unser alter Diener gemeint; sein Sohn ist der Brennermeister.“"
                                            },
                                            {
                                                "example_id": "5b171a48-7db5-44ff-9377-04ffdca2ad20",
                                                "sense_id": "438f5903-27ce-35ad-a6af-f8ccdfa3902b",
                                                "text": "„Ich befürchtete, dass der Diener mich nicht hereinlassen würde, wenn ich im Gewand eines einfachen Seemanns anklopfte, also öffnete ich die Eingangstür ohne Umschweife und ging direkt durch zum Salon, bevor man mich aufhalten konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b64ee6ab-206d-3451-8b91-533bb4b9e646",
                                        "entry_id": "d2873e8b-0454-3b11-8ce1-2a3ea17e181a",
                                        "glosses": [
                                            "Person, die sich sehr für etwas einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc1c9437-4fa5-4a89-bc92-89e530085dbe",
                                                "sense_id": "b64ee6ab-206d-3451-8b91-533bb4b9e646",
                                                "text": "Er war ein mächtiger Diener der Wissenschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b6fc4f0d-6847-34c5-bab3-ee1c978f9f3c",
                                        "entry_id": "d2873e8b-0454-3b11-8ce1-2a3ea17e181a",
                                        "glosses": [
                                            "Verbeugung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affab34a-15eb-4dcc-b24b-053d4374d691",
                                                "sense_id": "b6fc4f0d-6847-34c5-bab3-ee1c978f9f3c",
                                                "text": "Als Kinder mussten wir zur Begrüßung einen Diener machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c50a2c7c-a486-48c0-b928-fc223780ebd7",
                        "source_entry_id": "d0e88121-d7c9-37d1-ba4c-68de531c3357",
                        "target_lang_word": "Kellner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kellner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43463a6d-f962-3efd-839f-cbcc2fe0c4cb",
                                        "entry_id": "dbe728e0-5ba5-3ee9-9fce-bf3e43d8b692",
                                        "glosses": [
                                            "Angestellter in der Gastronomie, dessen Aufgabe die Bedienung der Gäste ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25da3cc0-6c1b-426d-aa2a-82ad8038a2b6",
                                                "sense_id": "43463a6d-f962-3efd-839f-cbcc2fe0c4cb",
                                                "text": "Der Kellner hat heute aber viel zu tun."
                                            },
                                            {
                                                "example_id": "36e79d23-aeb1-4b30-ac57-bad82a388967",
                                                "sense_id": "43463a6d-f962-3efd-839f-cbcc2fe0c4cb",
                                                "text": "Der neue Kellner bedient heute zum ersten Mal die Gäste bei uns."
                                            },
                                            {
                                                "example_id": "37a77bf2-a92f-4be1-b739-c5f1cff44c53",
                                                "sense_id": "43463a6d-f962-3efd-839f-cbcc2fe0c4cb",
                                                "text": "Ruf mal den Kellner an den Tisch."
                                            },
                                            {
                                                "example_id": "41490819-2bbe-4193-84fe-27baca05e1a5",
                                                "sense_id": "43463a6d-f962-3efd-839f-cbcc2fe0c4cb",
                                                "text": "„So entwarf Kamilla Jellinek (Die weibliche Bedienung im Gast- und Schankwirtschaftsgewerbe, Leipzig 1909) eine Petition, die ein Berufsverbot für weibliche Kellner forderte.“"
                                            },
                                            {
                                                "example_id": "5440b6e7-23e8-4f0a-8002-b9dda954b982",
                                                "sense_id": "43463a6d-f962-3efd-839f-cbcc2fe0c4cb",
                                                "text": "„Inzwischen bringt der Kellner für Maja das bestellte Kännchen Kaffee und die drei Stücke Kuchen, die sie sich am Buffet ausgesucht hat, und Paul bekommt eine Tasse Tee.“"
                                            },
                                            {
                                                "example_id": "a67d8222-67db-4556-b66e-ae3981a595ad",
                                                "sense_id": "43463a6d-f962-3efd-839f-cbcc2fe0c4cb",
                                                "text": "„Der Kellner brachte uns die Karte, und wir sahen, dass es in diesem Lokal nur Altberliner Küche zu essen gab.“"
                                            },
                                            {
                                                "example_id": "52f431c7-ce9d-4059-8bf8-a9a3bbd946b0",
                                                "sense_id": "43463a6d-f962-3efd-839f-cbcc2fe0c4cb",
                                                "text": "„Der Raum ist voll; der Kellner macht eine Tür auf, eine enge Hinterstube ist frei.“"
                                            },
                                            {
                                                "example_id": "c58a47e1-113c-4967-9c55-27c0b210899e",
                                                "sense_id": "43463a6d-f962-3efd-839f-cbcc2fe0c4cb",
                                                "text": "„Der Kellner will, daß wir Champagner bestellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f57f9e2-b503-3621-a73d-fa0baacb3632",
                                        "entry_id": "dbe728e0-5ba5-3ee9-9fce-bf3e43d8b692",
                                        "glosses": [
                                            "Kellermeister"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7d4c0bae-2e52-3776-9249-70f45b2949b8",
