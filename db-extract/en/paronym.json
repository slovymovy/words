                        ],
                        "form": "paronyms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e905f883-dafb-356c-9b5b-0473b798c6d3",
                        "entry_id": "d6114ce8-ba00-3ab5-8de4-791ad7f85f71",
                        "glosses": [
                            "A word derived from the same root or stem as another word; classes include cognates and naturalizations of foreign words."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9202f491-2bc0-3145-a01e-c91c29b5a104",
                        "entry_id": "d6114ce8-ba00-3ab5-8de4-791ad7f85f71",
                        "glosses": [
                            "A near-homophone, a word that sounds like another word (some example pairs are cognate)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ef41935-55ab-4457-8272-0b2f221aad21",
                        "source_entry_id": "d6114ce8-ba00-3ab5-8de4-791ad7f85f71",
                        "source_sense_description": "word derived from the same root/stem",
                        "target_lang_word": "Paronym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paronym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae18ce3-5860-3638-b85d-ce3d3930f87e",
                                        "entry_id": "506b3183-def9-3dc7-b30b-3777256f7c54",
                                        "glosses": [
                                            "ein Wort einer Sprache, das einem Wort einer anderen Sprache lautlich (phonetisch) ähnlich ist und die gleiche Bedeutung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcdec0a1-91e3-41c8-a362-1c4189b4da8f",
                                                "sense_id": "2ae18ce3-5860-3638-b85d-ce3d3930f87e",
                                                "text": "In der Literatur wird als Beispiel für Wörter, die Paronyme sind, auf deutsch „Sommer“ und englisch „summer“ verwiesen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2abdbc42-a01d-3e99-b0df-047e4562c7fe",
                                        "entry_id": "506b3183-def9-3dc7-b30b-3777256f7c54",
                                        "glosses": [
                                            "ein Wort, das morphologisch teilweise mit einem anderen übereinstimmt, aber eine andere Bedeutung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef5ef48-25c1-4e26-95af-630929a0d26d",
                                                "sense_id": "2abdbc42-a01d-3e99-b0df-047e4562c7fe",
                                                "text": "Bußmann verweist als Beispiele für Paronyme auf die Wörter der Wortfamilie, die aus dem Stamm „les-“ (zum Verb lesen) abgeleitet werden können."
                                            },
                                            {
                                                "example_id": "931aee66-3ba6-4ec8-80fd-99d5c5e15a7e",
                                                "sense_id": "2abdbc42-a01d-3e99-b0df-047e4562c7fe",
                                                "text": "Duden. Das große Fremdwörterbuch nennt als Beispiele für Paronyme die Wortfamilie mit dem Stamm „red-“: „Rede- reden - Redner - redlich - beredt“."
                                            },
                                            {
                                                "example_id": "52244403-1495-4e8c-b822-28a4ae9a51cc",
                                                "sense_id": "2abdbc42-a01d-3e99-b0df-047e4562c7fe",
                                                "text": "„Paronyme können bedingt sein durch fehlerhaften Gebrauch oder durch spielerischen Umgang mit der Sprache.“"
                                            },
                                            {
                                                "example_id": "94a104ad-ed5e-4aad-8fa6-8332a19bee31",
                                                "sense_id": "2abdbc42-a01d-3e99-b0df-047e4562c7fe",
                                                "text": "„Paronyme werden in der Regel nicht als Synonyme betrachtet, sondern es handelt sich um Ausdrücke mit einem erhöhten Grad an »ausdrucksgebundener Verwechslungsmöglichkeit« (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24fa648e-002b-42ed-b1db-402e6ea4f1ee",
                        "source_entry_id": "d6114ce8-ba00-3ab5-8de4-791ad7f85f71",
                        "source_sense_description": "word derived from the same root/stem",
                        "target_lang_word": "когна́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "когна́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7e4297e6-7e20-306c-80a5-65372fa3fd2e",
                                        "entry_id": "aa9260ef-9531-367b-bcda-b314b99f578b",
                                        "glosses": [
                                            "истор. юр. в древнеримском праве — кровный родственник, не находящийся под юридической властью главы данной семьи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a5e2eb4-1a42-4e09-bc11-20df85dea4bb",
                                                "sense_id": "7e4297e6-7e20-306c-80a5-65372fa3fd2e",
                                                "text": "К третьей очереди законных наследников принадлежали когнаты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2905384e-b471-38cb-9c76-5f4c6a5ad575",
                                        "entry_id": "aa9260ef-9531-367b-bcda-b314b99f578b",
                                        "glosses": [
                                            "лингв. однокоренные слова родственных языков, имеющие общее происхождение из языка-предка и не являющиеся заимствованиями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf78aa2-3bc7-4c9a-9e7a-9ab3b80fe398",
                                                "sense_id": "2905384e-b471-38cb-9c76-5f4c6a5ad575",
                                                "text": "Когнаты — лексемы с двумя значениями, находящимися в отношении семантической производности, в родственных языках восходят к одной лексеме праязыка, в которой предположительно отсутствует соответствующая полисемия."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
