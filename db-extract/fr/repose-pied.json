                    {
                        "form_id": "ed0c6a64-cafe-4576-bb5d-0ff8e5b21a34",
                        "entry_id": "5efc6832-bc59-3e3f-997a-94c6e26596a6",
                        "tags": [],
                        "form": "repose-pieds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0662aafe-e092-311e-8293-194d12eb534a",
                        "entry_id": "5efc6832-bc59-3e3f-997a-94c6e26596a6",
                        "glosses": [
                            "Siège bas pour poser un pied ou les pieds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dab7425-5915-4057-b0ad-8c9730461cf4",
                                "sense_id": "0662aafe-e092-311e-8293-194d12eb534a",
                                "text": "Chaise longue « Pi » et son repose-pied, 1983, métal peint et cuir, vendue 31 000 euros en 2021."
                            },
                            {
                                "example_id": "ce1405f8-99b3-4492-b584-0cdbb7520bd1",
                                "sense_id": "0662aafe-e092-311e-8293-194d12eb534a",
                                "text": "Dans l’intensité cruelle du trafic, il faut deviner les notes de Jeux interdits, mais le guitariste entre deux âges a eu le cran d’installer son petit tabouret et son repose-pied au milieu du trottoir, rue Ordener."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b167c40-88fd-3b98-a0cd-e010abc67254",
                        "entry_id": "5efc6832-bc59-3e3f-997a-94c6e26596a6",
                        "glosses": [
                            "Cale-pied, partie d'un matériel servant à faire reposer ou à caler les pieds."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f96922bc-aabc-4570-acbc-627a8c989d4d",
                        "source_entry_id": "5efc6832-bc59-3e3f-997a-94c6e26596a6",
                        "source_sense_description": "Siège bas pour poser le pied",
                        "target_lang_word": "Fußbank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußbank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94e96966-678b-3862-9c6b-0b3d76e1668f",
                                        "entry_id": "cde32d8b-983e-3530-9e11-c4faf0fcc922",
                                        "glosses": [
                                            "kleine niedrige Bank, die als Fußstütze dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4019b50a-cb5e-4369-9c61-8eea7a836e59",
                                                "sense_id": "94e96966-678b-3862-9c6b-0b3d76e1668f",
                                                "text": "Weil er so klein war, nutzte er eine Fußbank, um an das Buch zu gelangen."
                                            },
                                            {
                                                "example_id": "09ef2e76-5cf7-4cf7-9b58-0ff5fbead85f",
                                                "sense_id": "94e96966-678b-3862-9c6b-0b3d76e1668f",
                                                "text": "„Sie stellte sich auf eine Fußbank und spielte eine Weile mit den Tieren.“"
                                            },
                                            {
                                                "example_id": "44af201d-ffd7-4d60-975f-992be97393da",
                                                "sense_id": "94e96966-678b-3862-9c6b-0b3d76e1668f",
                                                "text": "„Pécuchet hatte eine Fußbank unter den Stiefeln und las mit seiner hohlen Stimme laut vor, ohne müde zu werden, und hielt nur inne, um seine Finger in die Schnupftabaksdose zu stecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e871fe47-9480-46f4-bfa0-8d05fa782b93",
                        "source_entry_id": "5efc6832-bc59-3e3f-997a-94c6e26596a6",
                        "source_sense_description": "Siège bas pour poser le pied",
                        "target_lang_word": "Schemel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schemel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                        "entry_id": "357969a6-51ba-3be3-87cf-d9150c563621",
                                        "glosses": [
                                            "einfacher Stuhl ohne Rückenlehne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af908d2-6ec5-45fb-bb13-2a96d53915b9",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "„Er tritt hinter sie, in die Enge zwischen der Balkontür und dem Schemel und betrachtet sein Porträt.“"
                                            },
                                            {
                                                "example_id": "de5c13da-31da-436a-8e97-f49137ac7e92",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "Der Schemel fiel laut klappernd zu Boden."
                                            },
                                            {
                                                "example_id": "9fc85311-fa98-4445-af63-78bff9396552",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "„Auf niedrigen Schemeln hocken die Mägde neben ihnen, um sie zu melken.“"
                                            },
                                            {
                                                "example_id": "e0e8434d-05a5-484f-a5b1-9d8beb9b9f53",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "„Die setzt sich auf den Schemel, sieht ihn an.“"
                                            },
                                            {
                                                "example_id": "5e9d5700-97e5-4b61-8d47-64a82a83750d",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "„Schließlich unterbrach er diesen Bericht, indem er seinen Schemel herumschwang und beim Sprechen mit beiden Händen spielte.“"
                                            },
                                            {
                                                "example_id": "0d11844d-3cab-4d08-979c-0a08734b6ef1",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "„Andere Bewohner hockten auf dem Steinboden, als wollten sie Stühle und Schemel schonen, um sich ihres Besitzes länger zu erfreuen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51f999e8-7d35-3358-a929-a0dec7dd7fed",
                                        "entry_id": "357969a6-51ba-3be3-87cf-d9150c563621",
                                        "glosses": [
                                            "kleine, niedrige Bank als Fußstütze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44815cc8-a66c-497e-80c8-7d46bc2ff613",
                                                "sense_id": "51f999e8-7d35-3358-a929-a0dec7dd7fed",
                                                "text": "„Schließlich unterbrach er diesen Bericht, indem er seinen Schemel herumschwang und beim Sprechen mit beiden Händen spielte.“"
                                            },
                                            {
                                                "example_id": "9dbde96d-7af1-4bde-aa54-340d589b9bf1",
                                                "sense_id": "51f999e8-7d35-3358-a929-a0dec7dd7fed",
                                                "text": "„Andere Bewohner hockten auf dem Steinboden, als wollten sie Stühle und Schemel schonen, um sich ihres Besitzes länger zu erfreuen.“"
                                            },
                                            {
                                                "example_id": "e6659e4b-1da3-43bc-8fe9-ba468c452def",
                                                "sense_id": "51f999e8-7d35-3358-a929-a0dec7dd7fed",
                                                "text": "Um die Beine hochzulegen, benutze ich einen Schemel."
                                            },
                                            {
                                                "example_id": "083ca89e-fb18-4a46-9aad-9d63114646b7",
                                                "sense_id": "51f999e8-7d35-3358-a929-a0dec7dd7fed",
                                                "text": "„Meine ganze Kindheit hindurch hatte Frank bei sich und Rita im Sessel gesessen und geraucht, den Aschenbecher auf der Armlehne, die Füße auf einen Schemel gelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2c4f773-2556-41c5-821b-82b215c5378c",
                        "source_entry_id": "5efc6832-bc59-3e3f-997a-94c6e26596a6",
