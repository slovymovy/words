                "senses": [
                    {
                        "sense_id": "f5a2eecc-70eb-3d2d-9e48-3b1e039cea4d",
                        "entry_id": "091143df-3b4d-317e-969e-e76b94ffdf2c",
                        "glosses": [
                            "Ennuyer beaucoup, déprimer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b66337-3810-4c97-b783-5010ffaa7ec4",
                                "sense_id": "f5a2eecc-70eb-3d2d-9e48-3b1e039cea4d",
                                "text": "Ça me déponne de friquer ça !"
                            },
                            {
                                "example_id": "04d76a9e-682c-4b5f-88de-a90c41dad533",
                                "sense_id": "f5a2eecc-70eb-3d2d-9e48-3b1e039cea4d",
                                "text": "S’être fait piéger si connement dans cette maison de rencarts, les déponne l’un et l’autre au maximum."
                            }
                        ]
                    },
                    {
                        "sense_id": "e079a717-f439-3078-a486-880031cde49e",
                        "entry_id": "091143df-3b4d-317e-969e-e76b94ffdf2c",
                        "glosses": [
                            "Ouvrir."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "07a95073-41f2-4e73-badf-367764899d23",
                                "sense_id": "e079a717-f439-3078-a486-880031cde49e",
                                "text": "Je déponne la lourde de la révérende mère Secrétaire sans prendre la peine de frapper au prélavable."
                            },
                            {
                                "example_id": "92b28e4c-e361-43a9-9e32-01d2c1ccb38d",
                                "sense_id": "e079a717-f439-3078-a486-880031cde49e",
                                "text": "Ce dont Duranton ne se priva pas, en déponnant vite fait la jolie porte en bois ouvragé de notre sous-directeur des Douanes disparu."
                            }
                        ]
                    }
