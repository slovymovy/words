                        ],
                        "examples": [
                            {
                                "example_id": "91e8cca2-a7a2-4de7-a2cb-e7f3a2ecc4db",
                                "sense_id": "67fb0549-4d66-3bcb-94f9-dc0cb039b42b",
                                "text": "Dziś samolot bombowy ma dzięki technice aerodynamicznej i aeromechanicznej takie udoskonalenia, o jakich przed dziesięciu laty nie można było marzyć.",
                                "translation": "Thanks to aerodynamic and aeromechanical technology, the bomber aircraft today has such improvements that ten years ago could not have been dreamed of.",
                                "english": "Thanks to aerodynamic and aeromechanical technology, the bomber aircraft today has such improvements that ten years ago could not have been dreamed of."
                            },
                            {
                                "example_id": "0d0781fe-8d13-4f67-b3e2-9f595432ad8b",
                                "sense_id": "67fb0549-4d66-3bcb-94f9-dc0cb039b42b",
                                "text": "Modelowanie sprzężeń aeromechanicznych z uwzględnieniem charakterystyk materiałowych",
                                "translation": "Modeling aeromechanical couplings taking into account material characteristics",
                                "english": "Modeling aeromechanical couplings taking into account material characteristics"
                            }
                        ]
