                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8689036-b90e-43cd-8d1c-6b24390c954b",
                        "source_entry_id": "0701892b-3ec9-3e2b-9fe1-21311971d4f2",
                        "source_sense_id": "7da7925d-dc17-384d-907b-bd1cb6a2709d",
                        "target_lang_word": "enchant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enchant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fb26a01-a145-33cf-918a-3877f43ac7a6",
                                        "entry_id": "bf850101-d938-3d9c-89ce-14762d84b97f",
                                        "glosses": [
                                            "To attract and delight, to charm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22178846-d655-430a-8cd1-0a11c0c816a1",
                                                "sense_id": "3fb26a01-a145-33cf-918a-3877f43ac7a6",
                                                "text": "New Jersey was reeling on Wednesday from the impact of Hurricane Sandy, which has caused catastrophic flooding here in Hoboken and in other New York City suburbs, destroyed entire neighborhoods across the state and wiped out iconic boardwalks in shore towns that had enchanted generations of vacationgoers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04b58638-53a0-39bc-b849-8ea88ff97e03",
                                        "entry_id": "bf850101-d938-3d9c-89ce-14762d84b97f",
                                        "glosses": [
                                            "To cast a spell upon (often one that attracts or charms)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d26b2a36-d088-4c6c-8213-29c6cdbefead",
                                                "sense_id": "04b58638-53a0-39bc-b849-8ea88ff97e03",
                                                "text": "With the aid of his eponymous pipes, a satyr is capable of weaving a wide variety of melodic spells designed to enchant others and bring them in line with his capricious desires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fce713f3-a8bc-3f19-af87-8ba8d4cda23e",
                                        "entry_id": "bf850101-d938-3d9c-89ce-14762d84b97f",
                                        "glosses": [
                                            "To magically enhance or degrade an item."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "enchant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36307f56-e96e-31a9-bbfc-ac2b22fe1ed8",
                                        "entry_id": "12930392-10ab-3073-99bb-d9f8a8f342f6",
                                        "glosses": [
                                            "An enchantment"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67bc8a14-c8ff-4a02-88ad-841b786d5de7",
                                                "sense_id": "36307f56-e96e-31a9-bbfc-ac2b22fe1ed8",
                                                "text": "The top button is an enchant you can get with 1 lapis, the middle will need 2 lapis, and the bottom will need 3. In addition to lapis, you will need to have a certain number of experience points to get an enchant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bba1591e-fbf9-4c24-9c97-f25d5a2225ed",
                        "source_entry_id": "0701892b-3ec9-3e2b-9fe1-21311971d4f2",
                        "source_sense_id": "7da7925d-dc17-384d-907b-bd1cb6a2709d",
                        "target_lang_word": "bewitch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bewitch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a386c9f-3ee1-3cdf-87f0-9b8d454a6f01",
                                        "entry_id": "058c4ae5-f04f-37c0-b37e-0cea2296aac5",
                                        "glosses": [
                                            "To cast a spell upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6ae551c-b551-4ab0-bc4f-0bb056f1f052",
                                                "sense_id": "8a386c9f-3ee1-3cdf-87f0-9b8d454a6f01",
                                                "text": "And further, this examinate saith, that she sent both her spirits to Stonesby, to one Willison, a husbandman, and Robert Williman, a husbandman's son, and bade the kitten go to Willison and bewitch him to death, and the moldiwarp to the other and bewitch him to death, which they did, and within ten days they died."
                                            },
                                            {
                                                "example_id": "66e391b7-0f0d-4c00-9128-5d6b4f2dbf75",
                                                "sense_id": "8a386c9f-3ee1-3cdf-87f0-9b8d454a6f01",
                                                "text": "Afterwards Jim said the witches bewitched him and put him in a trance,[…]"
                                            },
                                            {
                                                "example_id": "d93468d7-ced3-486e-b919-cc3ec3adabad",
                                                "sense_id": "8a386c9f-3ee1-3cdf-87f0-9b8d454a6f01",
                                                "text": "But above all beware never to look the Fairy of the Dawn in the face, for she has eyes that will bewitch you, and glances that will befool you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0806d69-c29c-309c-ac2c-4942acaf50bd",
                                        "entry_id": "058c4ae5-f04f-37c0-b37e-0cea2296aac5",
                                        "glosses": [
                                            "To fascinate or charm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "379b8bed-8d2a-4f33-b424-4198153bf967",
                                                "sense_id": "e0806d69-c29c-309c-ac2c-4942acaf50bd",
                                                "text": "I was bewitched by the sight of the girl dancing in the forest."
                                            },
                                            {
                                                "example_id": "1ae3440d-bf43-42f7-a880-32184cbc588f",
                                                "sense_id": "e0806d69-c29c-309c-ac2c-4942acaf50bd",
                                                "text": "A Svveet diſorder in the dreſſe / Kindles in cloathes a vvantonneſſe: / […] / A Cuffe neglectfull, and thereby / Ribbands to flovv confuſedly: / […] / Do more bevvitch me, than vvhen Art / Is too preciſe in every part."
                                            }
                                        ]
                                    },
