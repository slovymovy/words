                "senses": [
                    {
                        "sense_id": "e2f55d09-93fa-39b1-9366-024a46365eb6",
                        "entry_id": "a63d2982-c9c2-3a59-976c-3cc1e4e6063a",
                        "glosses": [
                            "Aufbau des politischen und wirtschaftlichen Lebens über Räte von unten her durch unmittelbare Mitbestimmung meist nur bestimmter Schichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d81027e-a3cc-46b9-b422-a1b218f90210",
                                "sense_id": "e2f55d09-93fa-39b1-9366-024a46365eb6",
                                "text": "„Das Rätesystem baut auf der anarchistischen Freiheit des nur sich selbst gehorchenden Einzelnen auf; […]“"
                            },
                            {
                                "example_id": "b9616010-bf3b-44fa-830f-807993f63737",
                                "sense_id": "e2f55d09-93fa-39b1-9366-024a46365eb6",
                                "text": "„Die Vertreter des linken USPD-Flügels lehnten dagegen die Nationalversammlung ab und sprachen sich für ein Rätesystem aus.“"
                            },
                            {
                                "example_id": "e1ae3592-19a0-4a7c-9104-ff7a7eeef4f5",
                                "sense_id": "e2f55d09-93fa-39b1-9366-024a46365eb6",
                                "text": "„Das Rätesystem vertritt unter dem Slogan »Alle Macht den Räten« das Prinzip der Gewalteneinheit sowie den Grundsatz der umfassenden Verantwortlichkeit der vom Volk gewählten Räte, die daher jederzeit wieder abberufen werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
