                ],
                "senses": [
                    {
                        "sense_id": "09c9376f-9403-3846-a247-f5ef8de6d1bf",
                        "entry_id": "c7c0eff7-e40e-3595-911a-a0081ed8e14c",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным гомеопатия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40e16a36-32d0-404c-b1cb-8f911661e8bd",
                                "sense_id": "09c9376f-9403-3846-a247-f5ef8de6d1bf",
                                "text": "Предлагающий мысли свои не читал ни одного из гомеопатических сочинений."
                            },
                            {
                                "example_id": "730c76bd-d455-4ef8-bc8b-9eafa706104b",
                                "sense_id": "09c9376f-9403-3846-a247-f5ef8de6d1bf",
                                "text": "Николай Петрович, как все домоседы, занимался лечением и даже выписал гомеопатическую аптечку."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbdfbb0c-3de0-39b6-9ed5-6bdecba2bf86",
                        "entry_id": "c7c0eff7-e40e-3595-911a-a0081ed8e14c",
                        "glosses": [
                            "перен., разг. очень маленький; крошечный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf59653a-c3f1-414a-9dc6-170aebd9aefb",
                                "sense_id": "bbdfbb0c-3de0-39b6-9ed5-6bdecba2bf86",
                                "text": "Только что мелькнула её гомеопатическая ножка, обутая в красный сафьянный сапожок, ― и за княжною полезла её подруга, озабоченная своим роброном."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11e36273-0a41-4467-a192-3ff7ba3467ef",
                        "source_entry_id": "c7c0eff7-e40e-3595-911a-a0081ed8e14c",
                        "source_sense_description": "связанный, соотносящийся по значению с существительным гомеопатия",
                        "target_lang_word": "homeopathic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homeopathic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "571e697d-87df-386e-9192-a81a8cb6a3d8",
                                        "entry_id": "be0bfce0-5692-3857-8cf2-266e267d4a40",
                                        "glosses": [
                                            "Of or pertaining to homeopathy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "123769a7-bb56-30c2-beb7-3154a43f03bf",
                                        "entry_id": "be0bfce0-5692-3857-8cf2-266e267d4a40",
                                        "glosses": [
                                            "Extremely dilute, insipid."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f506d53-07ed-4bd6-989a-b074b8ad11c0",
                                                "sense_id": "123769a7-bb56-30c2-beb7-3154a43f03bf",
                                                "text": "Therefore, with a slight misgiving that so delicate a creature as an embryo shad might possibly be affected by the homœopathic amount of alcohol still present, I set up my apparatus on the shaded piazza of the hotel."
                                            },
                                            {
                                                "example_id": "c5189fce-6918-4ed2-99cc-67cdf8383c43",
                                                "sense_id": "123769a7-bb56-30c2-beb7-3154a43f03bf",
                                                "text": "On the other hand, the pop psychology titles are usually very accessible (hence their popularity) but frequently state the obvious or simply retread the same old ground – the psychological content is so diluted it's positively homeopathic!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homeopathic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82d9f0e3-5ab6-3f37-93f9-306f2325458a",
                                        "entry_id": "25c4b32e-0864-334d-9238-cf5448b72d3d",
                                        "glosses": [
                                            "Any of the diluted remedies used in homeopathy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
