                "senses": [
                    {
                        "sense_id": "3475f49b-a453-3bfe-8c15-85972bf4a451",
                        "entry_id": "89d1f9dd-0e6b-32c4-886e-80b7cb438173",
                        "glosses": [
                            "Summe der Angelegenheiten, die die Geldinstitute betreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc6fd3ec-2a0a-4a8d-b566-5f64f519d5ef",
                                "sense_id": "3475f49b-a453-3bfe-8c15-85972bf4a451",
                                "text": "„Die TAN-Nummern müssen nicht mehr abgestrichen werden, da im Banksystem hinterlegt ist, welche iTANs bereits verbraucht wurden.“"
                            },
                            {
                                "example_id": "82358c9d-c24d-49c5-a34a-93e89dd8b8cd",
                                "sense_id": "3475f49b-a453-3bfe-8c15-85972bf4a451",
                                "text": "„Das zweistufige Banksystem bedeutet, dass die Zentralbank (oder Nationalbank) und die Geschäftsbanken miteinander getrennt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
