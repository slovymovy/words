    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "674da1a8-f194-3c89-bbed-225777ca22e8",
                    "sense_definition": "Ordre, règle ou instruction explicite à respecter lors d'une activité ou d'une opération.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves doivent lire attentivement chaque <w>consigne</w> avant de commencer l'exercice."
                        },
                        {
                            "text": "Il est obligatoire de respecter les <w>consignes</w> de sécurité affichées à l'entrée de l'usine."
                        }
                    ],
                    "synonyms": [
                        "directive"
                    ],
                    "common_phrases": [
                        "consignes de sécurité",
                        "respecter la consigne",
                        "suivre les consignes"
                    ]
                },
                {
                    "sense_id": "c0f762e9-095c-3d13-97c1-a041b111c2f9",
                    "sense_definition": "Lieu ou casier sécurisé où l'on dépose temporairement des bagages dans une gare ou un aéroport.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "bagages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons laissé nos valises à la <w>consigne</w> de la gare pour visiter la ville."
                        },
                        {
                            "text": "Le voyageur cherche une <w>consigne</w> automatique libre pour y déposer son sac."
                        }
                    ],
                    "common_phrases": [
                        "consigne automatique",
                        "consigne de la gare",
                        "laisser à la consigne"
                    ]
                },
                {
                    "sense_id": "7f8ab2a1-bdc9-3b5c-8325-0b2bd33807e3",
                    "sense_definition": "Somme versée lors de l'achat d'un récipient ou d'un emballage réutilisable et restituée lors de son retour.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prix de cette boisson comprend une <w>consigne</w> remboursable lors du retour de la bouteille."
                        },
                        {
                            "text": "Les clients rapportent leurs bouteilles au magasin pour récupérer le montant de la <w>consigne</w>."
                        }
                    ],
                    "common_phrases": [
                        "système de consigne",
                        "payer une consigne",
                        "récupérer la consigne"
                    ]
                },
                {
                    "sense_id": "9112ee8e-a76f-3e04-8a4c-f28e2d1ea0c8",
                    "sense_definition": "Valeur fixée qu'un système régulateur automatique cherche à atteindre et à maintenir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le thermostat maintient la température de <w>consigne</w> sélectionnée par les habitants."
                        },
                        {
                            "text": "L'opérateur ajuste la vitesse pour que la machine atteigne la <w>consigne</w> programmée."
                        }
                    ],
                    "common_phrases": [
                        "température de consigne",
                        "valeur de consigne"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "55a8ee45-a9b3-3099-a4b3-8b115faae3d8",
                    "sense_definition": "Première et troisième personnes du singulier de l'indicatif présent du verbe <w>consigner</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque soir, je <w>consigne</w> mes dépenses quotidiennes dans un petit carnet."
                        },
                        {
                            "text": "Le secrétaire <w>consigne</w> soigneusement toutes les décisions prises pendant la réunion."
