                "forms": [
                    {
                        "form_id": "fc39ce09-f576-4aa2-a580-4278f4518750",
                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                        "tags": [
                            "plural"
                        ],
                        "form": "atriums"
                    },
                    {
                        "form_id": "253a8887-755f-485f-82f0-cad5c8d58b65",
                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                        "tags": [
                            "singular"
                        ],
                        "form": "atria"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ca1950e-3f52-3170-a390-4552a6ba45e0",
                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                        "glosses": [
                            "Pièce principale pourvue d’un toit ouvert, généralement entourée d’un portique, et sur laquelle donnaient les autres pièces de la maison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d73745-3fe0-4530-8655-9f23f3e8876f",
                                "sense_id": "8ca1950e-3f52-3170-a390-4552a6ba45e0",
                                "text": "Il est en outre spécialement chargé de veiller à la conservation des images des ancêtres, des statues et des objets de prix exposés dans l’atrium. Il verrait avec peine qu’on le rangeât parmi le vulgum pecus de la classe servile ; car il compte parmi ceux qu’on appelle les ordinarii."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3a75b06-dc9a-349d-bda0-51141e92b103",
                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                        "glosses": [
                            "Cour intérieure couverte ou non, ou pièce à l’éclairage zénithal."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b722a980-3cda-36a8-9134-e95d42214ecc",
                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                        "glosses": [
                            "Oreillette dans la nouvelle nomenclature ; chacune des deux cavités du cœur qui sont placées au-dessus des deux ventricules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf329dc-6c14-42b1-9dd5-5a6149e254ea",
                                "sense_id": "b722a980-3cda-36a8-9134-e95d42214ecc",
                                "text": "L'artère coronaire droite naît du sinus aortique droit de l'aorte ascendante. Elle se dirige en avant, puis descend verticalement dans le sillon coronaire, entre l’atrium droit et le ventricule droit […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9b6fd49-1f67-37b9-b1d5-3a899ac97c42",
                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                        "glosses": [
                            "D’une façon plus générale, pouvait désigner une cavité de remplissage d’un organe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6795ab19-f56e-4b8f-8f3e-d5cd08fd038a",
                                "sense_id": "f9b6fd49-1f67-37b9-b1d5-3a899ac97c42",
                                "text": "L’atrium du ventricule latéral."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0379cb3-6b43-3b42-923b-f46e766d722d",
                        "entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                        "glosses": [
                            "Aire de protection et d’immunité autour d’une église (de 30 ou de 50 pas) au Moyen Âge en Occident."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "ca092289-de88-4f72-b324-53b62ce3ebfa",
                                "sense_id": "e0379cb3-6b43-3b42-923b-f46e766d722d",
                                "text": "Un certain nombre de canons des conciles de la Paix de Dieu rappellent l'importance de l'atrium"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dae33cc-6ba2-4f27-9d7d-25b78bc122bf",
                        "source_entry_id": "bc1c5585-14f3-334a-ac8f-25b95a10ea8d",
                        "target_lang_word": "Atrium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atrium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13b07add-06a6-381c-8edd-a7e554dfb759",
                                        "entry_id": "cdfb62d6-894f-3471-83f1-23925e5c3ffb",
                                        "glosses": [
                                            "quadratischer Innenraum eines römischen Wohnhauses mit einer Deckenöffnung, von dem aus man in die angrenzenden Räume gelangt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cde5bb4-56c7-441c-8446-dc9e140e3e80",
                                                "sense_id": "13b07add-06a6-381c-8edd-a7e554dfb759",
                                                "text": "In den großen Palästen Roms stand die Pinatheca gewöhnlich mit dem Atrium in Verbindung."
                                            },
                                            {
                                                "example_id": "ce187bf7-6ee0-4e06-9694-dfd20384e625",
                                                "sense_id": "13b07add-06a6-381c-8edd-a7e554dfb759",
                                                "text": "Aber vorn im Atrium scholl Hymenäen-Gesang und Flötenspiel."
                                            },
                                            {
                                                "example_id": "74268cf6-b24f-4e64-b3f2-b01ad694327a",
                                                "sense_id": "13b07add-06a6-381c-8edd-a7e554dfb759",
                                                "text": "Die Frau trat an das Fenster des Schlafgemachs, schlug den rotbraunen Vorhang zurück und blickte in das Atrium hinab, dessen Estrich von pyrenäischem, weißem Marmor, von buntem Mosaik umrändert, in hellem Mondlicht leuchtete."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bdbb8326-d9bb-3bc5-8aac-4fb497e497ab",
                                        "entry_id": "cdfb62d6-894f-3471-83f1-23925e5c3ffb",
                                        "glosses": [
                                            "Vorhof in der christlichen Basilika; ein von Gebäudeteilen oder Mauern umgebener, heute meist mit einem Glasdach geschützter Innenhof"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03adb695-c46e-42de-ac45-0f09310cd207",
                                                "sense_id": "bdbb8326-d9bb-3bc5-8aac-4fb497e497ab",
                                                "text": "Wir verlassen nun die untern Räume und steigen vom Atrium aus treppauf, um den obern Zimmern unsern Besuch zu machen."
                                            },
                                            {
                                                "example_id": "b8e3f2af-e08c-4d58-85f1-62dac2d82988",
                                                "sense_id": "bdbb8326-d9bb-3bc5-8aac-4fb497e497ab",
                                                "text": "Das Atrium, nach dem das Haus seinen Namen hat, ist ein künstlicher Freiraum, von dem die Zimmer des Hauses ihr Tageslicht bekommen. Das Atrium ist rundherum bis in zweieinhalb Meter Höhe von Gebautem umgeben und ohne Kontakt mit der Umgebung."
                                            },
                                            {
                                                "example_id": "e448d023-1fcb-4e97-8721-1a418fc64ee1",
                                                "sense_id": "bdbb8326-d9bb-3bc5-8aac-4fb497e497ab",
                                                "text": "Das 24 Meter hohe Atrium zwischen den beiden Flügeln des Fünf-Sterne-Hauses überspannt eine teilweise verglaste Dachkonstruktion."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "23d6a0af-9148-36ce-9048-96bae11f1441",
                                        "entry_id": "cdfb62d6-894f-3471-83f1-23925e5c3ffb",
                                        "glosses": [
                                            "linke oder rechte Vorkammer im Herzen höherer Wirbeltiere sowie des Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50e8505c-13a0-44bc-801f-ef84256e3ddf",
                                                "sense_id": "23d6a0af-9148-36ce-9048-96bae11f1441",
                                                "text": "Jede Herzhälfte ist in einen muskelschwächeren Vorhof (Atrium) und in eine muskelstärkere Herzkammer (Ventrikel) unterteilt."
                                            },
                                            {
                                                "example_id": "aef7c8ac-d712-47f1-b5e2-fa1c568a42da",
                                                "sense_id": "23d6a0af-9148-36ce-9048-96bae11f1441",
                                                "text": "Kurzschlüsse oder auf englisch Shunts von Blut im sich entwickelnden Herzen dienen einem ganz praktischen Bedürfnis. Alles Blut gelangt zuerst ins rechte Atrium."
                                            },
                                            {
                                                "example_id": "9ed54100-1654-4986-9f3b-f349ef8aaed0",
                                                "sense_id": "23d6a0af-9148-36ce-9048-96bae11f1441",
                                                "text": "Das daran anschließende Atrium ist bei den Fröschen durch eine vollständige Trennwand in zwei Hälften geteilt, das rechte und das linke Atrium."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
