                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5f8d4609-04a9-31a0-8615-dab8cef0530a",
                        "entry_id": "ecdd5f4d-f4b6-3867-89c3-cf912038dd44",
                        "glosses": [
                            "Stadt im US-Bundesstaat Massachusetts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b511d0a-46bc-4828-930c-a1a629de5cc9",
                                "sense_id": "5f8d4609-04a9-31a0-8615-dab8cef0530a",
                                "text": "„Er stammte aus Worcester in Massachusetts und war, nachdem er kurze Zeit in der Armee gedient hatte, in den achtziger Jahren als paramilitärischer Offizier zur CIA gekommen, um Contras in Nicaragua auszubilden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ffa8cfd8-b792-3210-abc8-575cfee26bb5",
                        "entry_id": "ecdd5f4d-f4b6-3867-89c3-cf912038dd44",
                        "glosses": [
                            "Stadt in der südafrikanischen Provinz Westkap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c86dffd-1ff5-4036-96ae-d6ea51c4e3a8",
                                "sense_id": "ffa8cfd8-b792-3210-abc8-575cfee26bb5",
                                "text": "„Wenn er niedergeschlagen war, nach einem harten Arbeitstag, stieg er oft in den Zug und fuhr einfach ins Blaue. Nach Lentegeur, Bellville, Simonstad; er war sogar schon zweimal mit Metrorail bis hinaus nach Worcester gefahren.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
