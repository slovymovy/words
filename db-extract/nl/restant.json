                "translations": [
                    {
                        "translation_id": "85cbb508-b387-4e57-9e06-38d05c4ad5ff",
                        "source_entry_id": "88f56f0f-a300-31b5-b8f9-1db9e927c029",
                        "source_sense_description": "het restant — 1. wat is overgebleven",
                        "target_lang_word": "Überbleibsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überbleibsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd00ac49-c31b-3091-b94b-3a03283c4ae1",
                                        "entry_id": "32626f09-fc90-316d-acea-6bd72c468c1c",
                                        "glosses": [
                                            "etwas, das im Unterschied zu verschwundenen Dingen noch vorhanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cc67ef7-30b3-4650-af59-3eeaf975535f",
                                                "sense_id": "bd00ac49-c31b-3091-b94b-3a03283c4ae1",
                                                "text": "„Er hatte seinen einzigen guten Anzug an, ein altmodisches Überbleibsel aus seiner großen Zeit, und die Narbe an seiner Nase war schneeweiß.“"
                                            },
                                            {
                                                "example_id": "6f7f5a40-bba7-43a1-99a7-39c70340ab5a",
                                                "sense_id": "bd00ac49-c31b-3091-b94b-3a03283c4ae1",
                                                "text": "„Der Rolandsbogen, letztes Überbleibsel der ehemals auf einem Bergsporn oberhalb der Insel Nonnenwerth gelegenen, mittelalterlichen Rolandsburg, war eingestürzt.“"
                                            },
                                            {
                                                "example_id": "afb0fb78-ef49-482f-af3d-f0f76e5904de",
                                                "sense_id": "bd00ac49-c31b-3091-b94b-3a03283c4ae1",
                                                "text": "„Dieses Volk hatte überdauert und konnte von sich behaupten, das lebende Überbleibsel der ersten Menschen zu sein, mit einem uralten Stammbaum, der lückenlos bis in die Gegenwart reichte.“"
                                            },
                                            {
                                                "example_id": "98d5edfc-d8d9-4f52-a87b-3244e4f1b6c2",
                                                "sense_id": "bd00ac49-c31b-3091-b94b-3a03283c4ae1",
                                                "text": "„Am Nachmittag gehen sie in einen Laurel und Hardy-Film, ein Überbleibsel von vor dreißig Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c262d52-abfc-4884-857d-b62bea5228ea",
                        "source_entry_id": "88f56f0f-a300-31b5-b8f9-1db9e927c029",
                        "source_sense_description": "het restant — 1. wat is overgebleven",
                        "target_lang_word": "remnant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remnant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4142d712-79fd-388c-bae3-3774c4e1ad5f",
                                        "entry_id": "f85d67e0-3c33-3320-972f-05b059673f4c",
                                        "glosses": [
                                            "The small portion remaining of a larger thing or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b9f59cd-353f-477c-9190-b126dd57f617",
                                                "sense_id": "4142d712-79fd-388c-bae3-3774c4e1ad5f",
                                                "text": "The remnants of Neanderthals were mixed with Homo sapiens."
                                            },
                                            {
                                                "example_id": "fb3db3b5-3b1e-4560-95e3-a9fc88049997",
                                                "sense_id": "4142d712-79fd-388c-bae3-3774c4e1ad5f",
                                                "text": "20 ¶ And it shal come to passe in that day, that the remnant of Israel, and such as are escaped of the house of Iacob, shall no more againe stay vpon him that smote them: but shall stay vpon the Lord, the Holy One of Israel in trueth.\n21 The remnant shall returne, euen the remnant of Iacob, vnto the mightie God.\n22 For though thy people Israel be as the sand of the sea, yet a remnant of them shall returne: the consumption decreed shall ouerflow with righteousnesse."
                                            },
                                            {
                                                "example_id": "88374ea0-e26e-4cfc-bcba-6da83e062295",
                                                "sense_id": "4142d712-79fd-388c-bae3-3774c4e1ad5f",
                                                "text": "Pent up in Utica he vainly forms\nA poor Epitome of Roman Greatneſs,\nAnd, cover’d with Numidian Guards, directs\nA feeble Army, and an empty Senate,\nRemnants of mighty Battels fought in vain."
                                            },
                                            {
                                                "example_id": "1a634c74-1a6c-4b02-8f24-31c8fd0f47d9",
                                                "sense_id": "4142d712-79fd-388c-bae3-3774c4e1ad5f",
                                                "text": "Even while within sight of persons of the prevailing faith, there were individuals bold enough, by folding their arms and bending their head, to give distant and silent intimation that they recognized sister Magdalen, and honoured alike her person and her purpose. […] “You see,” she said, “my son, that the enemies have been unable altogether to suppress the good spirit, or to root out the true seed. Amid heretics and schismatics, spoilers of the church’s lands, and scoffers at saints and sacraments, there remains a remnant.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca198ee9-7c77-3738-a7ed-4838d950ec41",
                                        "entry_id": "f85d67e0-3c33-3320-972f-05b059673f4c",
                                        "glosses": [
                                            "The remaining fabric at the end of the bolt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd554cbe-1501-4509-83b2-f1222ffa6ac6",
                                                "sense_id": "ca198ee9-7c77-3738-a7ed-4838d950ec41",
                                                "text": "Usually not enough to make an entire project by itself, remnants of several fabrics can be used to make quilts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24a7eba5-1ec8-3987-90a3-963d3b6b84d3",
                                        "entry_id": "f85d67e0-3c33-3320-972f-05b059673f4c",
                                        "glosses": [
                                            "An unsold end of piece goods, as cloth, ribbons, carpets, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0a1a8e-0791-4441-93d4-370be9b298f0",
                                                "sense_id": "24a7eba5-1ec8-3987-90a3-963d3b6b84d3",
                                                "text": "All the remnants were sold in the flea market."
                                            },
                                            {
                                                "example_id": "cdaa863c-1310-41bb-8c5c-19d141821566",
                                                "sense_id": "24a7eba5-1ec8-3987-90a3-963d3b6b84d3",
                                                "text": "A large number of remnants were taking up too much space, so we disposed of them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "remnant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "404f51c3-e37b-3acd-bbc2-728599cc9f39",
                                        "entry_id": "d7764711-094a-3726-ab23-93a1e8bea7cf",
                                        "glosses": [
                                            "Still left; remaining."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c538361-d793-44f7-a44a-5b7425cce14e",
                                                "sense_id": "404f51c3-e37b-3acd-bbc2-728599cc9f39",
                                                "text": "[H]is vow was made in his ſickneſſe, whileſt reaſon was ſcarce as yet in the peaceable poſſeſſion of his mind, becauſe of the remnant dregs of his diſeaſe: […]"
                                            },
                                            {
                                                "example_id": "4f308a49-cc59-4059-a231-0f73209ef5f5",
                                                "sense_id": "404f51c3-e37b-3acd-bbc2-728599cc9f39",
                                                "text": "It bid Her feel / No future Pain for Me; but inſtant wed / A Lover more proportion'd to her Bed; / And quiet dedicate her remnant Life / To the juſt duties of an humble Wife."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33daff93-0000-4624-a9ef-877a1e05383f",
                        "source_entry_id": "88f56f0f-a300-31b5-b8f9-1db9e927c029",
                        "source_sense_description": "het restant — 1. wat is overgebleven",
                        "target_lang_word": "remainder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remainder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e06d764a-1750-36c6-b8a7-f62e498cc75e",
                                        "entry_id": "46ceb54e-a1ed-3806-958c-446581fec966",
                                        "glosses": [
                                            "A part or parts remaining after some has/have been removed or already occurred."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9733ecde-d791-47fb-900c-7edea85836fc",
                                                "sense_id": "e06d764a-1750-36c6-b8a7-f62e498cc75e",
                                                "text": "My son ate part of his cake and I ate the remainder."
                                            },
                                            {
                                                "example_id": "de7a2997-7305-47f9-ad08-4d77226d545e",
                                                "sense_id": "e06d764a-1750-36c6-b8a7-f62e498cc75e",
                                                "text": "You can have the remainder of my clothes."
                                            },
                                            {
                                                "example_id": "e5266006-374b-4bab-92ec-1c951cfedc50",
                                                "sense_id": "e06d764a-1750-36c6-b8a7-f62e498cc75e",
                                                "text": "He spent the remainder of the war in a prisoner-of-war camp."
                                            },
                                            {
                                                "example_id": "da17f55b-aa47-49b1-be46-cf7e12b7b339",
                                                "sense_id": "e06d764a-1750-36c6-b8a7-f62e498cc75e",
                                                "text": "When the clocks are put forward at the introduction of summer time, the long-distance night trains automatically become one hour late, and continue to run late for the remainder of their journeys. […] Similarly, when the clocks are put back in the autumn, the night trains become one hour early."
                                            },
                                            {
                                                "example_id": "24d3248f-3ba5-4dd1-8fe0-0080b0a61c34",
                                                "sense_id": "e06d764a-1750-36c6-b8a7-f62e498cc75e",
                                                "text": "Thirdly, I continue to attempt to interdigitate the taxa in our flora with taxa of the remainder of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "841c1a26-614d-3a1c-8166-243dfdc0cde8",
                                        "entry_id": "46ceb54e-a1ed-3806-958c-446581fec966",
                                        "glosses": [
                                            "The amount left over after subtracting the divisor as many times as possible from the dividend without producing a negative result. If n (dividend) and d (divisor) are integers, then n can always be expressed in the form n = dq + r, where q (quotient) and r (remainder) are also integers and 0 ≤ r < d."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03aee34a-8f62-48d6-ac7c-77e2d7f6ad64",
                                                "sense_id": "841c1a26-614d-3a1c-8166-243dfdc0cde8",
                                                "text": "17 leaves a remainder of 2 when divided by 3."
                                            },
                                            {
                                                "example_id": "9d39b154-e1d8-46f3-9674-31648c440b3e",
                                                "sense_id": "841c1a26-614d-3a1c-8166-243dfdc0cde8",
                                                "text": "11 divided by 2 is 5 remainder 1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ea38db8-f7dc-3484-b4f6-2f55f2d3af91",
                                        "entry_id": "46ceb54e-a1ed-3806-958c-446581fec966",
                                        "glosses": [
                                            "The number left over after a simple subtraction"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e7d23e-b4ea-410b-bf16-0d5acb78b044",
                                                "sense_id": "3ea38db8-f7dc-3484-b4f6-2f55f2d3af91",
                                                "text": "10 minus 4 leaves a remainder of 6"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc633d66-029f-34de-93e1-68a4bd09edc0",
                                        "entry_id": "46ceb54e-a1ed-3806-958c-446581fec966",
                                        "glosses": [
                                            "Excess stock items left unsold and subject to reduction in price."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f901040-9d7b-4201-b2d0-6f9de1a8044e",
                                                "sense_id": "cc633d66-029f-34de-93e1-68a4bd09edc0",
                                                "text": "I got a really good price on this shirt because it was a remainder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9e2b58b-f23b-3c82-9eb5-9710f4780e25",
                                        "entry_id": "46ceb54e-a1ed-3806-958c-446581fec966",
                                        "glosses": [
                                            "An estate in expectancy which only comes in its heir's possession after an estate created by the same instrument has been determined"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
