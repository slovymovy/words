                "senses": [
                    {
                        "sense_id": "ce084562-eb14-36fb-b31b-4c7399873d3a",
                        "entry_id": "004f787f-fc32-3187-bef1-998285078de1",
                        "glosses": [
                            "Most usually, a very large shield fitted with a stand, like a small moveable wall, carried in front to protect all or most of the bearer's body that could be positioned independently of the user, such as a crossbowman, often with a projecting ridge running vertically down the center. However, smaller, more standard shield types were also termed as such, with the central verticle ridge as a defining feature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46a81740-75e7-43d8-9a2b-d7bbb13a29d6",
                                "sense_id": "ce084562-eb14-36fb-b31b-4c7399873d3a",
                                "text": "For in this proceſſe, Parrot nothĩg hath ſurmyſed\nNo matter pretendyd, nor nothyng enterpryſed\nBut that metaphora, alegoria with all\nShall be his protectyon, his pauys and his wall"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae337ca7-632d-499f-93fd-8e0ebf3820af",
                        "source_entry_id": "004f787f-fc32-3187-bef1-998285078de1",
                        "source_sense_id": "ce084562-eb14-36fb-b31b-4c7399873d3a",
                        "source_sense_description": "large shield",
                        "target_lang_word": "pavéza",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pavéza",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "603c7f24-4336-3084-8b4d-c42d7f9e9d04",
                                        "entry_id": "c662510c-2fe8-32de-a959-4207e8beadcb",
                                        "glosses": [
                                            "obdélníkový čtyřhranný či pětihranný vydutý štít velkých rozměrů se zašpičatělým dolním koncem užívaný zejména v patnáctém století husity jako kryt pro střelce nebo později pro obsluhu děla"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb2f72df-4c84-4353-95b0-29ce7466832d",
                                                "sense_id": "603c7f24-4336-3084-8b4d-c42d7f9e9d04",
                                                "text": "Obrňte se krunýřem povolnosti a vyzbrojte se pavézou trpělivosti!"
                                            },
                                            {
                                                "example_id": "26bd7c33-60d5-4f60-955c-1d8750f36fd0",
                                                "sense_id": "603c7f24-4336-3084-8b4d-c42d7f9e9d04",
                                                "text": "Vlezli do vozu čtyři pavézníci, každý s velikou podlouhlou dřevěnou pavézou, jež mu až po prsa sahala."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f92bd5c-321d-3057-905d-34fd527f29dc",
                                        "entry_id": "c662510c-2fe8-32de-a959-4207e8beadcb",
                                        "glosses": [
                                            "největší horní (korunní) plátek v květech motýlokvětých rostlin"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fe1a580-1bfb-3917-ac71-78cb154d2c92",
                                        "entry_id": "c662510c-2fe8-32de-a959-4207e8beadcb",
                                        "glosses": [
                                            "silný kmen či silná dřevěná tyč, která se podélně pokládá a upevňuje na vysoko naloženou fůru sena nebo obilí při přepravě"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e6788a5-d6d2-4fa0-ab6f-f94d015c4acb",
                        "source_entry_id": "004f787f-fc32-3187-bef1-998285078de1",
                        "source_sense_id": "ce084562-eb14-36fb-b31b-4c7399873d3a",
                        "source_sense_description": "large shield",
                        "target_lang_word": "pavois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pavois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fce11fe1-9a74-3068-811e-585a762ca2d9",
                                        "entry_id": "a30e342a-02fb-3f03-9b12-e6513c335724",
                                        "glosses": [
                                            "Sorte de grand bouclier en usage à l’époque mérovingienne. À la différence de la targe, il est recourbé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c94ce53e-30a7-4409-8b88-00d69b15e99a",
                                                "sense_id": "fce11fe1-9a74-3068-811e-585a762ca2d9",
                                                "text": "Il était impossible d’empêcher des assaillants nombreux et hardis, protégés par des pavois et même par des chats (sortes de chariots recouverts de madriers et de peaux) de saper le pied des tours."
                                            },
                                            {
                                                "example_id": "d0c5c9f3-a32f-497b-bdbf-07a2fec03694",
                                                "sense_id": "fce11fe1-9a74-3068-811e-585a762ca2d9",
                                                "text": "Lorsqu’on élisait un roi, on le hissait sur le pavois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "913738c5-a663-3096-8437-326411e1c252",
                                        "entry_id": "a30e342a-02fb-3f03-9b12-e6513c335724",
                                        "glosses": [
                                            "Ensemble des pavillons répartis sur de légers cordages hissés aux mâts et vergues d’un navire. Ils servent habituellement aux signaux, et occasionnellement à célébrer un événement heureux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b19adea5-3699-4e4a-a298-bdbb48f7b959",
                                                "sense_id": "913738c5-a663-3096-8437-326411e1c252",
                                                "text": "Et sur tout cela, flottaient des mouchoirs, des camisoles roses, du linge blanc qui séchait dans le vent, pendu à des ficelles, et qui étaient comme les pavois de cette flottille arrêtée là, au tournant de la rivière."
                                            },
                                            {
                                                "example_id": "f3b7d391-72af-404c-b3b2-138c1335fc7f",
                                                "sense_id": "913738c5-a663-3096-8437-326411e1c252",
                                                "text": "Et si ce bateau était uniquement peuplé d’enfants que j’aurais arrachés à la stupidité de leurs parents ! D’un bout à l’autre des cordages, un grand pavois de petits êtres volés, baignant dans un bonheur purement maritime !"
                                            },
                                            {
                                                "example_id": "1269b46c-0952-4662-96ac-bae41f80e49f",
                                                "sense_id": "913738c5-a663-3096-8437-326411e1c252",
                                                "text": "On dirait plutôt un cuirassé sous le grand pavois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60dc43ff-fdaa-388a-823a-dbada3c6a8c9",
                                        "entry_id": "a30e342a-02fb-3f03-9b12-e6513c335724",
                                        "glosses": [
                                            "Tenue exceptionnelle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4830677-553d-4e35-8e09-20e48a26a583",
                                                "sense_id": "60dc43ff-fdaa-388a-823a-dbada3c6a8c9",
                                                "text": "Nous sommes en tenue de noces, et on n’aura pas mis ses grands pavois pour rien !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01da277e-669e-3555-ba7f-006868929455",
                                        "entry_id": "a30e342a-02fb-3f03-9b12-e6513c335724",
                                        "glosses": [
                                            "Partie supérieure de la muraille d’un navire qui dépasse du pont. Originellement, il était formé de boucliers fixés sur la partie supérieure du navire pour se protéger lors du combat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1840a1eb-cf5f-4922-954b-bc6d4f8154df",
                                                "sense_id": "01da277e-669e-3555-ba7f-006868929455",
                                                "text": "La partie de la muraille qui dépasse parfois du pont vers le haut (pour constituer un garde corps) s’appelle un pavois."
                                            },
                                            {
                                                "example_id": "e5937c45-1d73-4eac-b35b-91ee8facafa9",
                                                "sense_id": "01da277e-669e-3555-ba7f-006868929455",
                                                "text": "C’est un ancien thonier à la coque blanche, pavois rouge vif et listons noirs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pavois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ddadd1f-254d-3a9f-9fe2-ce2018ffcbdf",
                                        "entry_id": "be7f26dc-ce7c-317f-a773-42b39fc86cd6",
                                        "glosses": [
                                            "Relatif à Vitry-en-Perthois, commune française située dans le département de la Marne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
