                        "sense_id": "667c568f-1b15-37ab-9d13-5246ea5311b1",
                        "entry_id": "bd89edc9-2565-378b-93f0-d8257cc2b286",
                        "glosses": [
                            "de goddelijke kracht en macht die zich uit op de dag des oordeels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32053bfb-922b-415c-a7c6-66b88e09b92e",
                                "sense_id": "667c568f-1b15-37ab-9d13-5246ea5311b1",
                                "text": "De schepping is geschapen omwille van het einde. Er moet een verbondsvolk zijn dat „zeer gewillig is op de dag Zijner heerkracht” (Ps. 110:3). Dat volk is wedergeboren tot een levende hóóp, door de opstanding van Jezus Christus uit de doden (1 Petr. 1:3)."
                            },
                            {
                                "example_id": "fa2d6152-c4fd-44fe-9cc6-6f657331095e",
                                "sense_id": "667c568f-1b15-37ab-9d13-5246ea5311b1",
                                "text": "Dit volk is een gewillig volk op de dag van Uw heerkracht?”"
                            }
                        ]
