        "fr-extract.jsonl": [
            {
                "entry_id": "49501a35-afe0-357f-a541-b33be92902c9",
                "word": "insectarium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d50184ec-d53c-475b-91af-3f68878df1d1",
                        "entry_id": "49501a35-afe0-357f-a541-b33be92902c9",
                        "tags": [
                            "plural"
                        ],
                        "form": "insectariums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc5879dc-889f-3b3a-bfb6-591ec98eb74b",
                        "entry_id": "49501a35-afe0-357f-a541-b33be92902c9",
                        "glosses": [
                            "Espace confiné qui permet d’étudier le mode de vie des insectes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30282ece-5da6-4bb2-8477-8cc4032dd713",
                                "sense_id": "cc5879dc-889f-3b3a-bfb6-591ec98eb74b",
                                "text": "Les tiges de ces plantes sont disséquées, et chenilles et chrysalides sont conservées dans l’insectarium jusqu’à l’émergence des insectes."
                            },
                            {
                                "example_id": "09f32753-dbb8-4e20-a0f7-bc97088c9d93",
                                "sense_id": "cc5879dc-889f-3b3a-bfb6-591ec98eb74b",
                                "text": "L’insectarium étant un élément clé dans le fonctionnement du laboratoire — sans moustiques, pas de manipulations — mettre en place un système documentaire précis pour la maintenance et le suivi de nos souches de références était indispensable."
                            }
                        ]
                    },
                    {
                        "sense_id": "802a2169-dfa9-332d-94f9-2ba3d1a0f339",
                        "entry_id": "49501a35-afe0-357f-a541-b33be92902c9",
                        "glosses": [
                            "Collection muséale d’insectes morts dont l’étude est fondamentale en systématique."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "09954f49-a769-457d-a866-17b62a40cc0d",
                                "sense_id": "802a2169-dfa9-332d-94f9-2ba3d1a0f339",
                                "text": "Les insectariums sur les murs du bureau de mon grand-père étaient à la fois fascinants et répugnants."
                            }
                        ]
                    },
                    {
                        "sense_id": "88aae373-c4f1-3549-9190-7f680fecbd21",
                        "entry_id": "49501a35-afe0-357f-a541-b33be92902c9",
                        "glosses": [
                            "Établissement de présentation et d'élevage d'insectes vivants, ouvert au public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b938a5c-5d8b-4e7e-9a76-4127de38bc26",
                                "sense_id": "88aae373-c4f1-3549-9190-7f680fecbd21",
                                "text": "Fondé en 1881, le Zoo de Londres fut l’un des premiers insectariums publics au monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac0f655e-37a3-43b7-8fdb-003b81d57751",
                        "source_entry_id": "49501a35-afe0-357f-a541-b33be92902c9",
