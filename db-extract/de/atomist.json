                                "target_senses": [
                                    {
                                        "sense_id": "07e60054-1992-34f7-97dd-a141b48f5e9a",
                                        "entry_id": "65c15aea-53a1-366a-924f-2f5148c861d9",
                                        "glosses": [
                                            "An adherent of atomism; one who believes matter is composed of elementary indivisible particles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9083b797-6805-4609-b1af-65be0ffde040",
                                                "sense_id": "07e60054-1992-34f7-97dd-a141b48f5e9a",
                                                "text": "What distinguished the atomists from their opponents was not the belief in tiny particles that make up matter, but the question of what separated them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9b71a99-3449-3671-9114-9902b508875e",
                                        "entry_id": "65c15aea-53a1-366a-924f-2f5148c861d9",
                                        "glosses": [
                                            "An adherent of the atomic theory."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4408ece-f26a-49ff-ad3b-fe0e3a2b3613",
                        "source_entry_id": "8f82188a-714f-30be-9f17-60b4c65b095a",
                        "source_sense_id": "5fb5df1e-85cb-3e13-89f3-7cb1487d9899",
                        "source_sense_description": "Vertreter der Lehre des Atomismus",
                        "target_lang_word": "atomiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atomiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36427f84-70c4-3b14-95ca-b6f6046386b7",
                                        "entry_id": "9d21236e-3198-3d72-9a61-d411a0e98706",
                                        "glosses": [
                                            "Relatif à l’atomisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeff7dcd-621a-40dc-acee-0afab95eb8fc",
                                                "sense_id": "36427f84-70c4-3b14-95ca-b6f6046386b7",
                                                "text": "Théoriquement l’atomisme lucrècien pouvait se passer du clinamen. Mais le clinamen montrait à livre ouvert que la question du statut de l’esprit et de la pensée se posait dans la théorie atomiste et n’était pas aisée à résoudre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "atomiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50c29368-6385-3176-baff-9e061e4b7ed5",
                                        "entry_id": "a22f9d0b-9d29-3be3-aa0d-9ab47b2ac59e",
                                        "glosses": [
                                            "Partisan des doctrines de l’atomisme."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a4b5f7d-816b-4f6b-94f1-25f5242feaab",
                                                "sense_id": "50c29368-6385-3176-baff-9e061e4b7ed5",
                                                "text": "En questionnant : « Dites-moi si vous avez jamais vu ou lu des philosophes pensant que le monde a été fait par hasard », Spinoza qui, quelques lignes après, fera l’éloge des Atomistes, affirme, par là même implicitement que telle n’est pas, selon lui, la conception épicurienne du clinamen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47c49eb0-36da-35fb-b993-e6d7aafa3580",
                                        "entry_id": "a22f9d0b-9d29-3be3-aa0d-9ab47b2ac59e",
                                        "glosses": [
                                            "Physicien ou physicienne de l’atome."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
