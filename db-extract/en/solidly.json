                ],
                "senses": [
                    {
                        "sense_id": "44f64ce1-7eaa-3db2-aa41-62c783183a19",
                        "entry_id": "3b61c13f-16a6-372c-94d7-aff49b7e9851",
                        "glosses": [
                            "In a solid or firm manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82476830-a4bb-46f8-b3e9-e777b73f5b27",
                                "sense_id": "44f64ce1-7eaa-3db2-aa41-62c783183a19",
                                "text": "Within school, 19 of 21 teachers were firmly committed behind me, were with me solidly."
                            },
                            {
                                "example_id": "5764d581-f9e5-4eb3-85be-08a6c67e8651",
                                "sense_id": "44f64ce1-7eaa-3db2-aa41-62c783183a19",
                                "text": "And Trippier's measured penalty was another indication of his growing maturity at this level, the Spurs full-back having again performed solidly down England's right."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4719a82-76d1-4cdb-ac12-674e5b0e2f94",
                        "source_entry_id": "3b61c13f-16a6-372c-94d7-aff49b7e9851",
                        "source_sense_id": "44f64ce1-7eaa-3db2-aa41-62c783183a19",
                        "source_sense_description": "in a solid manner",
                        "target_lang_word": "solidement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solidement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9324dace-7885-3233-958e-7229df8b9a20",
                                        "entry_id": "4d33732e-4962-3c15-b835-40d01917863d",
                                        "glosses": [
                                            "D’une manière solide ; fermement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32de4fee-dbe8-4cd8-b4d4-0cd67c7a3155",
                                                "sense_id": "9324dace-7885-3233-958e-7229df8b9a20",
                                                "text": "Comme le lieutenant le lui avait ordonné, il se rendit sur la galerie et s’accota solidement contre la balustrade, […]"
                                            },
                                            {
                                                "example_id": "2591054f-6e39-4404-8a2c-f04e37964886",
                                                "sense_id": "9324dace-7885-3233-958e-7229df8b9a20",
                                                "text": "Au moyen de palans je « roidis » les étais et j'amarre le beaupré aussi solidement qu'il est possible sur le pont maintenant rasé à l'avant."
                                            },
                                            {
                                                "example_id": "bae94377-976b-44cb-8529-0411e19d5692",
                                                "sense_id": "9324dace-7885-3233-958e-7229df8b9a20",
                                                "text": "Gillonne tira l’échelle à elle, l’assujettit solidement ; et le prince, […], commença l’escalade, qu’il acheva sans accident."
                                            },
                                            {
                                                "example_id": "2fedfa00-4fe9-443c-a194-8cad15559bdd",
                                                "sense_id": "9324dace-7885-3233-958e-7229df8b9a20",
                                                "text": "Peut-être que, prêt à mourir, on comptera pour quelque chose cette imagination de revivre dans sa famille, que l’on croira laisser solidement établie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaf93b63-4eaf-39c0-8b0d-23ead6b94fc1",
                                        "entry_id": "4d33732e-4962-3c15-b835-40d01917863d",
                                        "glosses": [
                                            "Très."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "971d8be8-9356-4b78-9675-b80069930b99",
                                                "sense_id": "eaf93b63-4eaf-39c0-8b0d-23ead6b94fc1",
                                                "text": "C'est à ses solidement bonnes qualités [de M. de Lavardin] que je me suis attachée,"
                                            },
                                            {
                                                "example_id": "c033ab81-4145-4395-a50c-3e4469bb6b2e",
                                                "sense_id": "eaf93b63-4eaf-39c0-8b0d-23ead6b94fc1",
                                                "text": "Le grand Béthune disait, quand il [Saint-Géran] eut le coup de canon : Le gros Saint-Géran est bon homme, honnête homme, mais il a besoin d’être tué pour être estimé solidement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
