                "senses": [
                    {
                        "sense_id": "89142e3c-3d3b-3212-a725-6d1af93b9f8e",
                        "entry_id": "64b57c0a-7852-3a23-9eb4-3b7a29ea169b",
                        "glosses": [
                            "particle used to give intonational emphasis to a part of speech"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ac9da0e3-88fd-4ae1-9a50-388d31086b94",
                                "sense_id": "89142e3c-3d3b-3212-a725-6d1af93b9f8e",
                                "text": "Ну я-то не ста́ну туда́ ходи́ть.",
                                "translation": "Well, there's no chance I'm going there, anyway.",
                                "english": "Well, there's no chance I'm going there, anyway."
                            },
                            {
                                "example_id": "caf4c08d-4831-4a91-8305-ad8071a6199b",
                                "sense_id": "89142e3c-3d3b-3212-a725-6d1af93b9f8e",
                                "text": "Я и зна́ть-то его́ не хочу́.",
                                "translation": "I don’t even want to know him!",
                                "english": "I don’t even want to know him!"
                            },
                            {
                                "example_id": "f5b04f43-ddda-4b0d-9cc2-2178f77d934f",
                                "sense_id": "89142e3c-3d3b-3212-a725-6d1af93b9f8e",
                                "text": "Об э́том-то я и хоте́л с ва́ми поговори́ть.",
                                "translation": "That is precisely what I wanted to talk to you about.",
                                "english": "That is precisely what I wanted to talk to you about."
                            },
                            {
                                "example_id": "cca1bca3-3e4d-4255-9e84-392894af80e4",
                                "sense_id": "89142e3c-3d3b-3212-a725-6d1af93b9f8e",
                                "text": "А я-то ду́мал...",
                                "translation": "And here I was, thinking / And there was me, thinking... / Just when I thought...",
                                "english": "And here I was, thinking / And there was me, thinking... / Just when I thought..."
                            }
                        ]
                    }
                ],
