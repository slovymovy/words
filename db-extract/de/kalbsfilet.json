                "senses": [
                    {
                        "sense_id": "d210712f-7e2b-3e61-a96b-fbc0cda4a016",
                        "entry_id": "fafa008d-40fa-3200-98f5-82eeda573d63",
                        "glosses": [
                            "von einem Kalb stammendes Filet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2acc1c12-a917-42d8-b8e5-aa389810bd6d",
                                "sense_id": "d210712f-7e2b-3e61-a96b-fbc0cda4a016",
                                "text": "„Und bis heute ist für mich ein Leben als Feinschmecker ohne Fleisch undenkbar, weil mein Himmeltellerreich auf Erden ein kurz gebratener Rehrücken mit Morcheln ist oder ein pochiertes Kalbsfilet im Kräutermantel oder ein Kotelett vom Ibérico-Schwein, das sein ganzes Leben frei wie der Wind in den Eichenhainen Andalusiens verbracht hat.“"
                            },
                            {
                                "example_id": "6dd3607d-5da0-4bec-b318-7f321d1d8a25",
                                "sense_id": "d210712f-7e2b-3e61-a96b-fbc0cda4a016",
                                "text": "„Hier erwarb er ein ansehnliches Stück Kalbsfilet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
