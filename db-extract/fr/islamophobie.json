                                "target_senses": [
                                    {
                                        "sense_id": "f8fa6537-0f0f-3ba0-af39-d5bee89ff287",
                                        "entry_id": "b5bb74ee-ce3b-3060-8eba-0d8bc96f297e",
                                        "glosses": [
                                            "Islamophobia"
                                        ],
                                        "tags": [
                                            "rare",
