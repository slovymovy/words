                "senses": [
                    {
                        "sense_id": "8f287199-f8c6-3b6c-bb2f-2a4c87d69e32",
                        "entry_id": "ec5e4756-e030-35a8-90c3-3e6aaa918833",
                        "glosses": [
                            "Höhe des gesamten Objekts/Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18a2e28c-251d-48c5-826f-bcb0c27348c0",
                                "sense_id": "8f287199-f8c6-3b6c-bb2f-2a4c87d69e32",
                                "text": "„Das erst 2011 fertiggestellte Gebäude im Jachthafen von Dubai hat eine Gesamthöhe von 352 Metern bis zur Antennenspitze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ab4aaec-2ee2-322b-a9c6-69370bfad14b",
                        "entry_id": "ec5e4756-e030-35a8-90c3-3e6aaa918833",
                        "glosses": [
                            "gesamte Summe, gesamter Betrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600c288f-c7cb-4d90-8990-aafc3be4195d",
                                "sense_id": "3ab4aaec-2ee2-322b-a9c6-69370bfad14b",
                                "text": "„Wegen Steuerbetrugs in Gesamthöhe von 4,1 Millionen Euro wurde der Weltfußballer des FC Barcelona zu 21 Monaten Haft verurteilt.“"
                            },
                            {
                                "example_id": "a8847234-93bf-4156-b3db-0c9893b1d2ad",
                                "sense_id": "3ab4aaec-2ee2-322b-a9c6-69370bfad14b",
                                "text": "„Vom Hauptgewinn der \"Lotería del Niño\" in Gesamthöhe von 90 Millionen, der auf die Loszahl 22654 entfiel und sich auf viele Menschen verteilte, gingen allein knapp 40 Millionen nach Pasaia.“"
                            },
                            {
                                "example_id": "28858518-b9ba-461a-8c7a-54aa88a0de29",
                                "sense_id": "3ab4aaec-2ee2-322b-a9c6-69370bfad14b",
                                "text": "„Berichten des NDR zufolge war es im vergangenen Herbst so knapp, dass nur ein Darlehen des Logistik-Unternehmers Klaus-Michael Kühne in Gesamthöhe von 9,25 Millionen Euro die Liquidität des Vereines sichern konnte.“"
                            },
                            {
                                "example_id": "04b7ac12-3828-4c90-b697-1bfd3c9b3c28",
                                "sense_id": "3ab4aaec-2ee2-322b-a9c6-69370bfad14b",
                                "text": "„Das Bundeskartellamt verhängt Bußgelder in Gesamthöhe von fast 100 Millionen Euro für acht Schienenhersteller wegen illegaler Absprachen.“"
                            },
                            {
                                "example_id": "4a8edf1d-b430-44d0-a55e-e1262d6ccba4",
                                "sense_id": "3ab4aaec-2ee2-322b-a9c6-69370bfad14b",
                                "text": "„Diese Fantasiezahl ähnelt verdächtig der Gesamthöhe der griechischen Schulden und stellt schon wieder den falschen Zusammenhang her.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
