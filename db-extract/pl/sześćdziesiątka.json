                                "target_senses": [
                                    {
                                        "sense_id": "6efc02fe-780c-3194-81ae-bb39720a331f",
                                        "entry_id": "9c82ef45-3514-3600-a09b-d66ae3c8e162",
                                        "glosses": [
                                            "The cardinal number occurring after fifty-nine and before sixty-one, represented in Roman numerals as LX and in Arabic numerals as 60."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c6b242-0015-4666-8687-9b62b14968b8",
                                                "sense_id": "6efc02fe-780c-3194-81ae-bb39720a331f",
                                                "text": "[…]the remaining three hundred and sixty words were then vetted with a battery of references. Six potential Mountweazels emerged."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sixty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ff39357-f281-3f7d-b147-2ba34a320a21",
                                        "entry_id": "d3d13663-a120-3841-b4aa-3226314671ec",
                                        "glosses": [
                                            "A commercial lasting 60 seconds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5436177-2748-4b1a-9d68-72819cefc346",
                                                "sense_id": "5ff39357-f281-3f7d-b147-2ba34a320a21",
                                                "text": "[…] instead of thirties [thirty-second commercials], they buy sixties, which cost twice as much. They spend more on filming it than they need to; they buy a lot of ads that are garbage and don't really say anything, just to fill up the space."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a155411-67b9-47be-bc73-b75f7a996506",
                        "source_entry_id": "f25afd2f-226c-3a7e-8d1b-34fdf44bb726",
                        "source_sense_id": "e99d49d8-0463-3921-a4ea-25c2870c8e09",
                        "target_lang_word": "šedesátka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "šedesátka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e2bf8d01-e392-34a1-8042-8997e1f2b971",
                                        "entry_id": "f2d7000f-d88e-3289-93ae-cd56aed3d2a7",
                                        "glosses": [
                                            "název čísla šedesát"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb01eab1-b2b2-4946-9876-1770c4c786e8",
                                                "sense_id": "e2bf8d01-e392-34a1-8042-8997e1f2b971",
                                                "text": "Bývalý prezident kladenského klubu Jaromír Jágr starší dostal dres s jedničkou, trikot s šedesátkou převzali oslavenci Nový, František Kaberle starší a Josef Horešovský."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "997e128f-c904-380a-8b61-fd86e7c8ca99",
                                        "entry_id": "f2d7000f-d88e-3289-93ae-cd56aed3d2a7",
                                        "glosses": [
                                            "to, co má číslo šedesát v názvu, je jím označeno nebo má v obvyklých jednotkách číselnou hodnotu šedesát"
                                        ],
                                        "tags": [
                                            "v obecném jazyce"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24207991-8bb6-4d94-b3c0-97c926be5c56",
                                                "sense_id": "997e128f-c904-380a-8b61-fd86e7c8ca99",
                                                "text": "„Byla bych ráda, kdyby se Eurovia a ŘSD přestaly hádat a dali to do pořádku, protože jet šedesátkou po dálnici je hrůza,“ míní například Petra Ptáčková Pavelková z Ostravy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5907bb-f654-3fd4-94c7-e5522d320481",
                                        "entry_id": "f2d7000f-d88e-3289-93ae-cd56aed3d2a7",
                                        "glosses": [
                                            "přibližný počet šedesát"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a332110c-1e9e-431e-ae1d-2d2d7c281579",
                                                "sense_id": "2b5907bb-f654-3fd4-94c7-e5522d320481",
                                                "text": "Šedesátka případů byla zaznamenána ve městě Salvador."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e7813fc-5af4-469e-9903-8b7a4d23e9fd",
                        "source_entry_id": "f25afd2f-226c-3a7e-8d1b-34fdf44bb726",
