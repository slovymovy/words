                ],
                "senses": [
                    {
                        "sense_id": "81b42c3f-663b-337b-9d5b-12c3875297fe",
                        "entry_id": "ab49a4d9-9248-3df1-b158-29ebf34038c5",
                        "glosses": [
                            "Gesamtheit der Abgeordneten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e69438-159f-4903-a7a2-169c8675fa7b",
                                "sense_id": "81b42c3f-663b-337b-9d5b-12c3875297fe",
                                "text": "„Das Abgeordnetenhaus von Berlin wird alle fünf Jahre in allgemeiner, gleicher, freier, geheimer und direkter Wahl gewählt.“"
                            },
                            {
                                "example_id": "0060c7ad-fba1-4cf5-96b6-e117ae8dfb64",
                                "sense_id": "81b42c3f-663b-337b-9d5b-12c3875297fe",
                                "text": "„Im Superwahljahr 2021 findet neben Landtagswahlen in fünf Bundesländern, Kommunalwahlen in zwei Ländern und der Wahl zum Abgeordnetenhaus in Berlin auch die Bundestagswahl statt.“"
                            },
                            {
                                "example_id": "143ed04c-9abd-440e-9b78-b2b8d5b99f70",
                                "sense_id": "81b42c3f-663b-337b-9d5b-12c3875297fe",
                                "text": "„Die Demokraten hatten mit ihrer Mehrheit im Abgeordnetenhaus unter anderem strengere Überprüfungen für private und kommerzielle Waffenkäufe beschlossen.“"
                            },
                            {
                                "example_id": "b68dc021-04b1-42ea-80d1-6824f8e16af0",
                                "sense_id": "81b42c3f-663b-337b-9d5b-12c3875297fe",
                                "text": "„Prominente Republikaner wie der Fraktionsvorsitzende im Senat, Mitch McConnell, oder der Minderheitsführer im Abgeordnetenhaus, Kevin McCarthy, kritisierten Donald Trump nach der Attacke auf das Kapitol am 6.Januar zwar deutlicher als zuvor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f46273aa-e835-3604-8e95-63fb40f5880b",
                        "entry_id": "ab49a4d9-9248-3df1-b158-29ebf34038c5",
                        "glosses": [
                            "Gebäude, in dem [1] tagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67441d63-291c-4b6e-8d40-8785665dda18",
                                "sense_id": "f46273aa-e835-3604-8e95-63fb40f5880b",
                                "text": "„Berlin kann auf dem Wasserweg Elbsandstein erhalten; darum sind viele Bauten, so die Werke K. F. Schinkels (1781—1841), ferner das Reichstagsgebäude und das Abgeordnetenhaus aus diesem Gestein errichtet worden.“"
                            },
                            {
                                "example_id": "85f875e8-2e0c-4f8e-861e-6640c106fe49",
                                "sense_id": "f46273aa-e835-3604-8e95-63fb40f5880b",
                                "text": "„Kings Hall, das alte Abgeordnetenhaus, und die Senatskammern stehen dem Besucher offen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
