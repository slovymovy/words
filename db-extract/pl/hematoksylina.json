                                        "sense_id": "928ce839-c412-3894-a243-98115b5d56d7",
                                        "entry_id": "2edd7b9e-ac78-3558-b4c1-e32bb9955f88",
                                        "glosses": [
                                            "мед. гистологический краситель, получаемый из эфирного экстракта кампешевого дерева"
                                        ],
