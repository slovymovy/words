                                "sense_id": "8e377bcd-9391-3e7e-817b-b90b945c5b4f",
                                "text": "De teelt van vee vereist veel ruimte en middelen.",
                                "translation": "The breeding of livestock requires a lot of space and resources.",
                                "english": "The breeding of livestock requires a lot of space and resources."
                            },
                            {
                                "example_id": "10641744-348c-420a-a982-a8a776cb6904",
                                "sense_id": "8e377bcd-9391-3e7e-817b-b90b945c5b4f",
                                "text": "Hij is verantwoordelijk voor de teelt van de kippen op de boerderij.",
                                "translation": "He is responsible for the raising of chickens on the farm.",
                                "english": "He is responsible for the raising of chickens on the farm."
                            }
                        ]
