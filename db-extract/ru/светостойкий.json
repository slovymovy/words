                    },
                    {
                        "form_id": "49b47af3-26a1-4da2-8f12-49b19ba1a26c",
                        "entry_id": "cd367bf8-d477-3f9d-8796-fcccfa624dc4",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "свѐтосто́йки"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f4d4496-1448-344e-932d-01a5059b2553",
                        "entry_id": "cd367bf8-d477-3f9d-8796-fcccfa624dc4",
                        "glosses": [
                            "хим. сохраняющий свойства при продолжительном воздействии световых лучей, не поддающийся их разрушению"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e727be2a-dbfb-4a19-8927-5db7a9fe386e",
                                "sense_id": "8f4d4496-1448-344e-932d-01a5059b2553",
                                "text": "Меламиновые пластмассы светостойки, не имеют запаха и хорошо окрашиваются."
                            },
                            {
                                "example_id": "59249b59-36e6-4580-b0f9-1b65a6427acb",
                                "sense_id": "8f4d4496-1448-344e-932d-01a5059b2553",
                                "text": "Некоторые из подобных диметилглиоксимату никеля соединений — основа очень светостойких красок."
                            },
                            {
                                "example_id": "c609b92c-e7e4-4e44-a731-a7b3734cfeda",
                                "sense_id": "8f4d4496-1448-344e-932d-01a5059b2553",
                                "text": "Синтетические ткани не сохраняют форму, могут «плавиться» при глажении, но они очень прочные, светостойкие, лёгкие в уходе и более дешёвые."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efc32641-7ae5-45e1-bda2-473b1fc7dfda",
                        "source_entry_id": "cd367bf8-d477-3f9d-8796-fcccfa624dc4",
                        "source_sense_id": "8f4d4496-1448-344e-932d-01a5059b2553",
                        "source_sense_description": "сохраняющий свойства при продолжительном воздействии световых лучей, не поддающийся их разрушению",
                        "target_lang_word": "lightfast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lightfast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e73d28a4-cbf1-36f8-827e-1680431dd712",
                                        "entry_id": "b2d2cf0c-25fe-3bf6-9c90-77700290a6e6",
                                        "glosses": [
                                            "Resistant to fading."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083493fa-9fd6-462c-953c-2c4e9eb0f1c9",
                                                "sense_id": "e73d28a4-cbf1-36f8-827e-1680431dd712",
                                                "text": "Verdigris is lightfast in oil paint, as numerous examples of fifteenth-century paintings show."
                                            },
                                            {
                                                "example_id": "7a35b2bb-724a-444c-98f8-5760c0a1986f",
                                                "sense_id": "e73d28a4-cbf1-36f8-827e-1680431dd712",
                                                "text": "Some ink-and-paper combinations are more lightfast than others, and the resulting prints are more fade-resistant."
                                            },
                                            {
                                                "example_id": "72cf5a65-c5fc-43b1-bb8f-f2a57203a230",
                                                "sense_id": "e73d28a4-cbf1-36f8-827e-1680431dd712",
                                                "text": "Tara, a gallotannin, is often quoted as being the most lightfast vegetable tannin and makes very pale coloured leather."
                                            },
                                            {
                                                "example_id": "2cc84bda-8de2-421e-9e4c-235469377002",
                                                "sense_id": "e73d28a4-cbf1-36f8-827e-1680431dd712",
                                                "text": "The blue, or cyan, is the most lightfast ink used in the printing process, so it lasts the longest. That blue, incidentally, is the phthalocyanine blue pigment.\nYou can easily test to determine whether any material is lightfast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
