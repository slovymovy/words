                "translations": [
                    {
                        "translation_id": "3b517b48-4a2e-4d8d-a17d-677d27112c86",
                        "source_entry_id": "a90e05a9-2d70-3c72-804b-18f1429957e3",
                        "source_sense_id": "fd074434-e6f7-33c5-8e09-c06c4b2d19a2",
                        "source_sense_description": "een dode taal die in het huidige Turkije werd gesproken",
