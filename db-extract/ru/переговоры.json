                    {
                        "translation_id": "6d5e64ec-2aa2-4e5a-9468-2211f0df9503",
                        "source_entry_id": "e1a6dc63-4ae7-3d5f-b767-f964c74cce3f",
                        "source_sense_id": "f2544444-4d89-3a6f-931a-5c719eaac198",
                        "target_lang_word": "Unterredung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterredung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                        "entry_id": "270d535b-2006-3005-849c-00a0b09c02d0",
                                        "glosses": [
                                            "ein meist förmliches, offizielles Gespräch mit einer Person oder einigen Personen über eine wichtige Angelegenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef0eb804-8c1c-4c7f-a460-a0bf296522b6",
                                                "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                                "text": "Der Abteilungsleiter bittet die Sachbearbeiterin zu einer Unterredung."
                                            },
                                            {
                                                "example_id": "45077950-6fc1-4553-9dfd-6072dbc91e5b",
                                                "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                                "text": "In den ersten Märztagen 1976 hatten wir, Kohl und ich, in meiner Wohnung in Bonn eine Unterredung, in der wir die Lage und den Vertragstext noch einmal analysierten."
                                            },
                                            {
                                                "example_id": "4ddc37e3-1a9b-47d1-a55b-0edf257c6b88",
                                                "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                                "text": "Ich konnte nicht ahnen, dass ich kaum drei Monate später eine recht ungewöhnliche Unterredung mit seinem Nachfolger haben sollte und für kurze Zeit in seinem Arbeitszimmer im Vatikan eingeschlossen war."
                                            },
                                            {
                                                "example_id": "ca4e4e2e-42ae-4453-9c35-8d920d5c8d20",
                                                "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                                "text": "„Aus dem Gefühl heraus, daß hier unsere Unterredung stocke, schlug ich Herrn Jackopp vor, zu Herrn Rösselmann zu gehen, denn ich war gespannt, was dieser Herr zu dieser Neuerung so alles zu sagen hätte.“"
                                            },
                                            {
                                                "example_id": "ebb2980d-f0c3-41ca-91a3-fb6d011097d0",
                                                "sense_id": "fe43d438-43c3-3d0d-b08c-1ca85859b70c",
                                                "text": "„Nach dieser Unterredung mit Pierre fuhr Anna Michailowna wieder zu Rostows und legte sich schlafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ed08afe-6ef0-40b0-879a-c2e87a31f17c",
                        "source_entry_id": "e1a6dc63-4ae7-3d5f-b767-f964c74cce3f",
                        "source_sense_id": "f2544444-4d89-3a6f-931a-5c719eaac198",
                        "target_lang_word": "Verhandlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verhandlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95e2efad-0eda-3783-8c60-d730241bc5bd",
                                        "entry_id": "8289e749-8743-3217-973f-019ab23a3c15",
                                        "glosses": [
                                            "gerichtliche Abhandlung einer Strafsache oder Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a8752e-bac4-4674-aedf-65e1c9943abf",
                                                "sense_id": "95e2efad-0eda-3783-8c60-d730241bc5bd",
                                                "text": "Die Verhandlung muss vertagt werden."
                                            },
                                            {
                                                "example_id": "86806d75-ad0d-4dd3-8e0d-92408c89e1e6",
                                                "sense_id": "95e2efad-0eda-3783-8c60-d730241bc5bd",
                                                "text": "„Vor einigen Jahren hatte ich einmal als Zeuge an einer Verhandlung teilnehmen müssen.“"
                                            },
                                            {
                                                "example_id": "63d2c42c-b253-45de-b7d8-60387ca2ed7a",
                                                "sense_id": "95e2efad-0eda-3783-8c60-d730241bc5bd",
                                                "text": "„Bei Staatsanwaltschaft und Verteidigern ist er beliebt, weil er routinierte, schnelle Verhandlungen macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1cd9ff68-f50c-3b7c-94cb-8ae58097534d",
                                        "entry_id": "8289e749-8743-3217-973f-019ab23a3c15",
                                        "glosses": [
                                            "ein Interessenausgleich, durch den sich widersprechende Bedürfnisse von zwei oder mehreren Parteien mit Hilfe von Kommunikation und Strategie ausgeglichen werden sollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ad6dded-c82a-4bdf-87f6-1221acb919a4",
                                                "sense_id": "1cd9ff68-f50c-3b7c-94cb-8ae58097534d",
                                                "text": "Die Verhandlungen sind noch in vollem Gange."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
