                                "target_senses": [
                                    {
                                        "sense_id": "2bc1f4b4-67bd-35ed-a2b3-ae0e1a653a79",
                                        "entry_id": "fee876e4-1f1f-3571-aaef-9f604dd66ca9",
                                        "glosses": [
                                            "A person belonging to a province; one who is provincial."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9fd33c8-3e9c-368c-8dcc-84f943d58a38",
                                        "entry_id": "fee876e4-1f1f-3571-aaef-9f604dd66ca9",
                                        "glosses": [
                                            "A monastic superior, who, under the general of his order, has the direction of all the religious houses of the same fraternity in a given district, called a province of the order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b461077-1ae1-4864-a770-3cedf1b6ef20",
                                                "sense_id": "d9fd33c8-3e9c-368c-8dcc-84f943d58a38",
                                                "text": "The Franciscan provincial Diego de Landa set up a local Inquisition which unleashed a campaign of interrogation and torture on the Indio population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0388ae03-85cb-392f-ba66-10d55e1deaec",
                                        "entry_id": "fee876e4-1f1f-3571-aaef-9f604dd66ca9",
                                        "glosses": [
                                            "A constitution issued by the head of an ecclesiastical province."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1858aa52-a6b9-4b8d-ac18-829bf8d3ed0c",
                                                "sense_id": "0388ae03-85cb-392f-ba66-10d55e1deaec",
                                                "text": "Or els is thys Goddis law,\nDecrees or decretals,\nOr holy sinodals,\nOr els provincyals,\nThus within the wals\nOf holy church to deale […]?"
                                            }
                                        ]
                                    },
