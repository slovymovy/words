                                            {
                                                "example_id": "a68ac62c-d514-4876-892a-ca708591fd1a",
                                                "sense_id": "6e407f0f-2752-39ec-adb2-3cfc0f9477a0",
                                                "text": "It is, perhaps, too much to assume that an elderly Melville read James, but he was an eager scanner of magazines and did read fiction in his later years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4100fe3e-edaf-3c4e-ac8c-a4de06cb1f45",
                                        "entry_id": "44973185-461e-3fa2-a05c-b72f7c906300",
                                        "glosses": [
                                            "A device which scans documents in order to convert them to a digital medium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e05111-8eff-4eb9-bf54-8c654c49fc1a",
                                                "sense_id": "4100fe3e-edaf-3c4e-ac8c-a4de06cb1f45",
                                                "text": "He put the picture in the scanner, then e-mailed a copy of it to his family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "047d88fb-15ef-34c3-815d-41c78b8cf5f0",
                                        "entry_id": "44973185-461e-3fa2-a05c-b72f7c906300",
                                        "glosses": [
                                            "A device which scans barcodes or QR codes for the purpose of charging a customer, performing a price check or enquiry, printing a price label or sticker, checking an item in or out of the store or warehouse, or finding an item ordered through click and collect and its corresponding location; a pricing gun or HHT."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37e31ce7-d7ed-3452-a454-56e803db1f7e",
                                        "entry_id": "44973185-461e-3fa2-a05c-b72f7c906300",
                                        "glosses": [
                                            "A radio receiver which iterates through a sequence of frequencies to detect signal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdf07613-66e8-3262-899c-e31cbf76c26f",
                                        "entry_id": "44973185-461e-3fa2-a05c-b72f7c906300",
                                        "glosses": [
                                            "A device which uses radiation (ultrasound, X-ray, etc.) to generate images of tissue or surfaces for diagnostic purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ae621d-77c5-4426-88ba-867aa43c15ce",
                                                "sense_id": "fdf07613-66e8-3262-899c-e31cbf76c26f",
                                                "text": "Chorban: I'm using a small scanner to gather readings on the keepers.\nChorban: So far, I've had mixed results. I find it difficult to get near the creatures."
