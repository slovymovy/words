                ],
                "senses": [
                    {
                        "sense_id": "f3d8671a-e978-31a4-bd5e-418fbb0767d9",
                        "entry_id": "a0450545-06f9-3fa4-b0c1-bb672ebd142c",
                        "glosses": [
                            "Donner un caractère épistémologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0daff3-0216-47c7-b9d2-12bba0ad010e",
                                "sense_id": "f3d8671a-e978-31a4-bd5e-418fbb0767d9",
                                "text": "Nous voyons du coup qu'il ne suffit pas d’épistémologiser les sciences biologiques."
                            },
                            {
                                "example_id": "88d64296-f0de-4fb1-a3f3-3d0047567434",
                                "sense_id": "f3d8671a-e978-31a4-bd5e-418fbb0767d9",
                                "text": "La raison en est que, par un gradient qui caractérise sans doute nos cultures, les formations discursives ne cessent de s’épistémologiser."
                            },
                            {
                                "example_id": "c1c9373d-d5be-4f30-b295-2eed05d8c5a7",
                                "sense_id": "f3d8671a-e978-31a4-bd5e-418fbb0767d9",
                                "text": "J'hypothèse. Je théorise. J'épistémologise. Et soudainement, alors que je m'y attends le moins, on se met à me prendre au sérieux."
                            }
                        ]
                    }
                ],
