                        "glosses": [
                            "Occurring in pairs; two at a time."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "24f52594-3682-4694-a72b-db95e57b2551",
                                "sense_id": "3e8c6958-40dc-3c55-933a-40bd2c81af79",
                                "text": "They proceeded to make pairwise comparisons."
                            }
                        ]
                    }
                ],
                "translations": [
