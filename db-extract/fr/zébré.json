                    {
                        "sense_id": "f103be1a-4536-399a-ae65-e61b2b32f1a2",
                        "entry_id": "ff1bbe6e-0d3a-3ce9-88c0-7859f8ec661b",
                        "glosses": [
                            "Qui est marqué de raies semblables à celles du zèbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "080f409a-33cf-4442-9b41-a727b4e2cc63",
                                "sense_id": "f103be1a-4536-399a-ae65-e61b2b32f1a2",
                                "text": "C’est un minibus zébré rouge et noir, tu ne peux pas le rater."
                            },
                            {
                                "example_id": "07ff134a-4a6b-4252-9aff-5237144982b2",
                                "sense_id": "f103be1a-4536-399a-ae65-e61b2b32f1a2",
                                "text": "Le ciel était zébré d’étincelles électriques qui grésillaient sous les larges gouttes de la pluie.."
                            },
                            {
                                "example_id": "9cc96749-d9a2-4537-9128-f91e2a426e68",
                                "sense_id": "f103be1a-4536-399a-ae65-e61b2b32f1a2",
                                "text": "Certains coins, les coins d’ombre humide, grouillaient d’un pullulement de reptiles, noirs, jaunes, violacés, zébrés, tigrés."
                            },
                            {
                                "example_id": "1f7efdde-c185-4a33-9198-5770cb7b8627",
                                "sense_id": "f103be1a-4536-399a-ae65-e61b2b32f1a2",
                                "text": "D’autres ont le visage zébré par des bandes de même couleur, horizontales cette fois."
                            }
                        ]
                    }
                ],
