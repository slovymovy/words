                        "zh": [
                            {
                                "target_lang_word": "总理",
                                "target_lang_sense_clarification": "国家政府首脑"
                            },
                            {
                                "target_lang_word": "省长",
                                "target_lang_sense_clarification": "省政府首脑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38dee73f-9d9e-3d77-9356-931ea37b71ad",
                    "sense_definition": "The champion team of a sports season.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a hard-fought season, the local club was crowned the <w>premiers</w>.",
                            "target_lang_translations": {
                                "ru": "После тяжелого сезона местный клуб был провозглашен <w>чемпионом</w>.",
                                "zh": "经过一个艰难的赛季，当地俱乐部荣膺<w>冠军</w>。"
                            }
                        },
                        {
                            "text": "The <w>premiers</w> celebrated their grand final victory with a parade through the city.",
                            "target_lang_translations": {
                                "ru": "<w>Чемпионы</w> отпраздновали свою победу в гранд-финале парадом по городу.",
                                "zh": "<w>冠军</w>队在城中举行游行，庆祝他们在总决赛中的胜利。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Команда-чемпион спортивного сезона.",
                        "zh": "体育赛季中的冠军队伍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чемпион",
                                "target_lang_sense_clarification": "победитель соревнования"
                            },
                            {
                                "target_lang_word": "победитель",
                                "target_lang_sense_clarification": "выигравший первенство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冠军",
                                "target_lang_sense_clarification": "比赛的获胜者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cfd76f1-4219-3f7d-b1b0-fc6dc15a58d3",
                    "sense_definition": "The first lieutenant or second-in-command officer on a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain left the bridge in the capable hands of his <w>premier</w>.",
                            "target_lang_translations": {
                                "ru": "Капитан оставил мостик в надежных руках своего <w>старшего помощника</w>.",
                                "zh": "船长将驾驶台交给了他得力的<w>大副</w>。"
                            }
                        },
                        {
                            "text": "As the <w>premier</w>, he was responsible for the daily operations of the vessel.",
                            "target_lang_translations": {
                                "ru": "Как <w>старший помощник</w>, он отвечал за повседневную эксплуатацию судна.",
                                "zh": "作为<w>大副</w>，他负责船只的日常运营。"
                            }
                        }
                    ],
                    "synonyms": [
                        "first lieutenant",
                        "first mate"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "nautical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Первый лейтенант или второй по командованию офицер на корабле.",
                        "zh": "船上的大副或二把手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старший помощник",
                                "target_lang_sense_clarification": "морской термин, заместитель капитана"
                            },
                            {
                                "target_lang_word": "старпом",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大副",
                                "target_lang_sense_clarification": "船长的主要助手"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "528a526a-c016-3413-8ef6-3cc59e6195c7",
                    "sense_definition": "To perform, display, or exhibit something publicly for the first time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director decided to <w>premier</w> his new film at the international festival.",
                            "target_lang_translations": {
                                "ru": "Режиссер решил <w>представить</w> свой новый фильм на международном фестивале.",
                                "zh": "导演决定在国际电影节上<w>首映</w>他的新片。"
                            }
                        },
                        {
                            "text": "They will <w>premier</w> the song on the radio before releasing the album.",
                            "target_lang_translations": {
                                "ru": "Они <w>представят</w> песню на радио перед выпуском альбома.",
                                "zh": "他们将在专辑发行前通过电台<w>首播</w>这首歌。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "premier a film",
                        "premier a song"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often spelled 'premiere'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять, показывать или представлять что-либо публике впервые.",
                        "zh": "首次公开表演、展示或放映某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представлять впервые",
                                "target_lang_sense_clarification": "делать премьеру"
