{
    "word_family": [
        "certainement",
        "certitude",
        "incertain",
        "incertitude"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c14f69b3-ef5f-391d-bf07-90c9158be08b",
                    "sense_definition": "Qui est convaincu, assuré de la vérité ou de la réalité de quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conviction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis <w>certain</w> d'avoir fermé la porte avant de partir ce matin."
                        },
                        {
                            "text": "Elle n'est pas tout à fait <w>certaine</w> de l'heure exacte du rendez-vous."
                        }
                    ],
                    "common_phrases": [
                        "être certain de",
                        "sûr et certain"
                    ]
                },
                {
                    "sense_id": "b82ab06d-314b-3370-b3fb-b42ef211c88a",
                    "sense_definition": "Qui est indubitable, incontestable ou garanti.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conviction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est <w>certain</w> que cette décision aura des répercussions durables sur le groupe."
                        },
                        {
                            "text": "Le succès de leur nouvelle initiative paraît désormais tout à fait <w>certain</w>."
                        }
                    ],
                    "common_phrases": [
                        "il est certain que",
                        "succès certain"
                    ]
                },
                {
                    "sense_id": "f05aa2d8-8932-3812-804a-1198891c408e",
                    "sense_definition": "Employé avec un article indéfini pour marquer une nuance, une intensité ou une quantité modérée mais appréciable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "indefini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce travail de traduction demande une <w>certaine</w> patience pour éviter les contresens."
                        },
                        {
                            "text": "Le responsable a manifesté un <w>certain</w> intérêt pour les propositions des employés."
                        }
                    ],
                    "common_phrases": [
                        "une certaine mesure",
                        "un certain temps"
                    ]
                },
                {
                    "sense_id": "7cf5475c-197c-3cde-9b6c-feff297b3ac3",
                    "sense_definition": "Précédé de « un » ou « une » et suivi d'un nom propre, désigne une personne dont l'identité est mal connue ou mentionnée avec distance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indefini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce matin, un <w>certain</w> Paul a téléphoné pour obtenir des informations sur l'annonce."
                        },
                        {
                            "text": "L'enquête s'intéresse à un <w>certain</w> Dupont qui séjournait dans l'hôtel voisin."
                        }
                    ],
                    "common_phrases": [
                        "un certain monsieur"
                    ]
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "b61a0122-08a1-3c30-8d41-23596e2a7cd8",
                    "sense_definition": "Sert à désigner de manière indéterminée une partie des personnes ou des éléments d'un groupe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indefini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Certains</w> étudiants préfèrent réviser tard le soir plutôt que le matin."
                        },
                        {
                            "text": "<w>Certaines</w> règles de grammaire comportent de nombreuses exceptions difficiles à retenir."
                        }
                    ],
                    "common_phrases": [
                        "certains jours",
                        "certaines personnes"
                    ]
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "5b672ec2-e9d4-37da-a7f5-dbe631e6325a",
                    "sense_definition": "Désigne plusieurs personnes ou choses indéterminées au sein d'une collectivité plus vaste.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indefini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les avis étaient partagés et <w>certains</w> ont préféré s'abstenir lors du vote."
                        },
                        {
                            "text": "Parmi tous les invités de la soirée, <w>certains</w> sont partis bien avant minuit."
                        }
                    ],
                    "synonyms": [
                        "d'aucuns"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7a0dae7-2d48-3cc1-abc5-07690ce5394b",
                    "sense_definition": "Ce qui est assuré, indubitable, par opposition à ce qui présente un risque ou une incertitude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conviction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est souvent imprudent de quitter le <w>certain</w> pour l'incertain sans garantie."
                        },
                        {
                            "text": "Le philosophe cherche à bâtir sa réflexion sur le <w>certain</w> plutôt que sur des hypothèses."
                        }
                    ],
                    "common_phrases": [
                        "quitter le certain pour l'incertain"
                    ]
                }
            ]
        }
    ]
}