{
    "word_family": [
        "bouquin",
        "bouquinerie",
        "bouquineur",
        "bouquiniste"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88a15f0b-643f-3048-83f4-8bbc02dbca46",
                    "sense_definition": "Lire des livres ou d'autres écrits, le plus souvent pour son plaisir ou pour se détendre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lecture_et_livres",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'aime me poser dans un fauteuil confortable pour <w>bouquiner</w> tranquillement le soir."
                        },
                        {
                            "text": "Pendant les vacances d'été, elle <w>bouquine</w> souvent au bord de la piscine."
                        }
                    ],
                    "synonyms": [
                        "lire"
                    ],
                    "common_phrases": [
                        "bouquiner au lit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "1708a7cf-f931-32f9-b815-6ca0131828dc",
                    "sense_definition": "Rechercher et feuilleter des livres anciens ou d'occasion, notamment chez des bouquinistes ou dans des brocantes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lecture_et_livres",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il adore passer des heures à <w>bouquiner</w> le long des quais de la Seine."
                        },
                        {
                            "text": "Ce collectionneur passionné <w>bouquine</w> régulièrement dans les brocantes à la recherche de raretés."
                        }
                    ],
                    "synonyms": [
                        "chiner"
                    ],
                    "common_phrases": [
                        "bouquiner sur les quais"
                    ]
                },
                {
                    "sense_id": "03419ee7-7a76-342a-a589-b97941e8607a",
                    "sense_definition": "Examiner ou parcourir des livres dans une librairie avant de décider d'en acheter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lecture_et_livres",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En attendant son train, elle est allée <w>bouquiner</w> quelques nouveautés dans la librairie de la gare."
                        },
                        {
                            "text": "Les clients peuvent <w>bouquiner</w> debout quelques instants avant de faire leur choix."
                        }
                    ],
                    "synonyms": [
                        "feuilleter"
                    ],
                    "common_phrases": [
                        "bouquiner en librairie"
                    ]
                },
                {
                    "sense_id": "4c4434c7-0efd-381b-9e48-b0ec26cf68f9",
                    "sense_definition": "S'accoupler, en parlant du lièvre, du lapin ou du bouc.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reproduction_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au début du printemps, les lièvres mâles <w>bouquinent</w> dans les champs."
                        },
                        {
                            "text": "Le garde forestier a observé un lièvre qui <w>bouquinait</w> à la lisière du bois."
                        }
                    ],
                    "synonyms": [
                        "copuler",
                        "s'accoupler"
                    ]
                }
            ]
        }
    ]
}