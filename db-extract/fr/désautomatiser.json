                ],
                "senses": [
                    {
                        "sense_id": "54862e02-a730-3d74-8084-365d860e8add",
                        "entry_id": "de8d44fa-4d88-36e4-b0cd-a0eb6fc4695b",
                        "glosses": [
                            "Retirer à quelque chose son caractère automatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "236db36f-914b-4b98-ad4b-9d793153a83e",
                                "sense_id": "54862e02-a730-3d74-8084-365d860e8add",
                                "text": "Décodifier l’idiome établi, le désautomatiser, rendre hétérogène et mouvante sa prévisible monotonie sera considéré comme un acte condamnable."
                            },
                            {
                                "example_id": "52638377-669c-4933-8a82-4618909e357f",
                                "sense_id": "54862e02-a730-3d74-8084-365d860e8add",
                                "text": "L’emploi est ce qui interrompt structurellement et radicalement ce rapport entre automatismes et désautomatisation au travail : tel qu’il est porté à son comble dans la conception taylorienne du ‘travail’ à la chaîne, il a ceci de spécifique qu’il soumet les femmes et les hommes à la reproduction invariable d’automatismes sans la moindre possibilité de désautomatiser."
                            },
                            {
                                "example_id": "21f1f170-23ea-4132-b1a9-063459673f90",
                                "sense_id": "54862e02-a730-3d74-8084-365d860e8add",
                                "text": "Il s’agit de « désautomatiser » les mécanismes habituels qui organisent la connaissance et la perception."
                            }
                        ]
                    }
                ],
