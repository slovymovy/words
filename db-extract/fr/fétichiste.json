        "fr-extract.jsonl": [
            {
                "entry_id": "95fcc4b1-a820-3af7-a2ed-a7dd1b4d156f",
                "word": "fétichiste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d4a4ed9-b56a-4563-99ee-ace2857953cc",
                        "entry_id": "95fcc4b1-a820-3af7-a2ed-a7dd1b4d156f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "fétichistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af5a6beb-dab8-36a4-b51e-81d94720e044",
                        "entry_id": "95fcc4b1-a820-3af7-a2ed-a7dd1b4d156f",
                        "glosses": [
                            "Qui pratique le fétichisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7374bab-96ac-4e51-8da2-162e0624ad3e",
                                "sense_id": "af5a6beb-dab8-36a4-b51e-81d94720e044",
                                "text": "Elle se rappelait que Dechartre lui avait dit : « L’amour est fétichiste. J’ai cueilli sur la terrasse les baies noires et desséchées d’un troène, que vous aviez regardé. » Pourquoi n’avait-elle pas songé à emporter une petite pierre du pavillon où elle avait oublié le monde ?"
                            },
                            {
                                "example_id": "68f70d2f-cbf7-456c-ac21-d0ceefd501ae",
                                "sense_id": "af5a6beb-dab8-36a4-b51e-81d94720e044",
                                "text": "Sur le front, juste au milieu, la croix berbère était tracée en bleu, symbole inconnu, inexplicable chez ces peuplades autochtones qui ne furent jamais chrétiennes et que l'islam vint prendre toutes sauvages et fétichistes, pour sa grande floraison de foi et d'espérance."
                            },
                            {
                                "example_id": "97e7895f-adb1-4582-aa1b-82ccefed46c0",
                                "sense_id": "af5a6beb-dab8-36a4-b51e-81d94720e044",
                                "text": "En détachant le cordonnet noir, Poupette s’est mise à pleurer : « C’est idiot, je ne suis pourtant pas fétichiste mais je ne peux pas jeter ce ruban. — Garde-le. » Inutile de prétendre intégrer la mort à la vie et se conduire de manière rationnelle en face d’une chose qui ne l’est pas : que chacun se débrouille à sa guise dans la confusion de ses sentiments."
                            },
                            {
                                "example_id": "6ea36e6f-0e2c-4b0a-a684-b5937fbd7602",
                                "sense_id": "af5a6beb-dab8-36a4-b51e-81d94720e044",
                                "text": "Sous influence d'un gourou arabe, Chakib Khalil qui vivait à Genève, Messali issu d'un milieu fétichiste, tomba totalement sous l'influence de ce sbire du nationalisme arabe alors en gestation, jusqu'à devenir une marionnette entre ses mains […]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ae30fab1-22db-37e6-9faa-31da9ca02850",
                "word": "fétichiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "176570de-7bdd-4904-9332-178f79a4936b",
                        "entry_id": "ae30fab1-22db-37e6-9faa-31da9ca02850",
                        "tags": [
                            "plural"
                        ],
                        "form": "fétichistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40c342d6-3570-3f2a-a192-4b5d082c294d",
                        "entry_id": "ae30fab1-22db-37e6-9faa-31da9ca02850",
                        "glosses": [
                            "Celui, celle qui pratique le fétichisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50e3e3bb-4fc4-4224-b0ab-a4452abd8eef",
                                "sense_id": "40c342d6-3570-3f2a-a192-4b5d082c294d",
                                "text": "Imaginons qu’un fétichiste se jette à nos pieds pendant que nous sommes tranquillement assis à la terrasse d’un café, et qu’il nous arrache d’un air lubrique notre bottine pour s’échapper et en tirer des jouissances indues."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbcd2568-d1a0-3057-b493-9b53d7b44f76",
                        "entry_id": "ae30fab1-22db-37e6-9faa-31da9ca02850",
                        "glosses": [
                            "Féticheur, sorcier des religions animistes."
                        ],
                        "tags": [
                            "Sénégal"
                        ],
                        "examples": [
                            {
                                "example_id": "7956cd28-fea7-495d-879d-f8d181c58c0d",
                                "sense_id": "bbcd2568-d1a0-3057-b493-9b53d7b44f76",
                                "text": "Le fétichiste tient son pouvoir des esprits, il agit au moyen de fétiches."
                            }
                        ]
                    }
                ],
