            "senses": [
                {
                    "sense_id": "39e06118-0f3d-355d-9f1f-4028576ffcc7",
                    "sense_definition": "Informer quelqu'un d'une situation ou le prévenir d'un danger à venir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pensez à m'<w>avertir</w> dès que vous recevez les résultats de cet examen."
                        },
                        {
                            "text": "Le panneau lumineux permet d'<w>avertir</w> les automobilistes d'un accident sur la route."
                        }
                    ],
                    "synonyms": [
                        "aviser",
                        "informer",
                        "prévenir"
                    ],
                    "common_phrases": [
