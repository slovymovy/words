                        "examples": [
                            {
                                "example_id": "2e942528-c1e1-403f-9765-f72c79516843",
                                "sense_id": "9b4a606f-91aa-30fc-a5ff-6069a0bb40af",
                                "text": "Zum Beispiel dem in Dänemark geborenen iranischen Secondo Atila Momeni: Als er beim Klub nachfragte, was denn los sei, wurde ihm mitgeteilt, sein Ticketkauf sei aus Sicherheitsgründen annulliert worden."
                            },
                            {
                                "example_id": "1f204dac-1054-490c-9955-b14f647879f7",
                                "sense_id": "9b4a606f-91aa-30fc-a5ff-6069a0bb40af",
                                "text": "Auch die angezettelte Secondo-Diskussion ist reine Ablenkungsstrategie. So wie die Behauptung eines Altbundesrates, selbst die USA würden Secondos aus dem Land werfen. Das stimmt nicht, weil in den USA geborene Menschen automatisch amerikanische Staatsangehörige werden."
                            }
                        ]
                    }
