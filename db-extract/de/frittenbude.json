                                        "examples": [
                                            {
                                                "example_id": "1ad3516d-8555-416c-99e3-7107f8fbe49a",
                                                "sense_id": "e58d6e36-067f-3e39-982b-0066f8548326",
                                                "text": "De frituur is open, hoor."
                                            },
                                            {
                                                "example_id": "3447adec-afe8-4928-a771-b313d80c26c0",
                                                "sense_id": "e58d6e36-067f-3e39-982b-0066f8548326",
                                                "text": "Vraag het aan Gentenaar Geert Claus, uitbater van frituur Emily’s, hoe zwaar het is. Hij legt de laatste meters te voet af, met de fiets aan de hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb763c98-1303-37ff-828f-66b2d12c8a34",
                                        "entry_id": "17a675e7-7829-36b7-b7a5-5ae060e54d7b",
