                "senses": [
                    {
                        "sense_id": "5aab897e-aee6-3c47-8713-e58dcdde6324",
                        "entry_id": "e40d7074-8599-3db6-861c-6816925b7b0d",
                        "glosses": [
                            "Pertaining to or engaging in incest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "595df588-9e3f-4a63-8598-d8ae590f6ec5",
                                "sense_id": "5aab897e-aee6-3c47-8713-e58dcdde6324",
                                "text": "If you engaged in an incestuous relationship with a family member, that would make you an inbreeder."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6ec954c-dafa-3e34-8650-7191edd10f2b",
                        "entry_id": "e40d7074-8599-3db6-861c-6816925b7b0d",
                        "glosses": [
                            "Characterized by mutual relationships that are intimate and exclusive to the detriment of outsiders."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3029b25-d227-47b5-80d6-4a08b425258c",
                                "sense_id": "e6ec954c-dafa-3e34-8650-7191edd10f2b",
                                "text": "It’s an incestuous thing. Faculty at the liberal, Ivy League schools are involved in hiring other faculty, who later hire the next generation of faculty. There’s very little intellectual or philosophical diversity in our newsrooms as a result. Furthermore, as I pointed out in the book, there’s a large number of so-called journalists who work for Democrat politicians, who go back and forth between politics and journalism."
                            },
                            {
                                "example_id": "aeb02b10-edf0-430e-bbc2-676da836a027",
                                "sense_id": "e6ec954c-dafa-3e34-8650-7191edd10f2b",
                                "text": "Democrats have the luxury of controlling the public narrative, thanks, in large part, to their incestuous relationship with the news media."
                            }
                        ]
                    }
                ],
