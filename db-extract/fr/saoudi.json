                                    {
                                        "sense_id": "d40a49e9-3baa-32b1-a8e4-14257df9a953",
                                        "entry_id": "8c9a5d89-5872-3b10-a530-f23a64e5b273",
                                        "glosses": [
                                            "Saudi-Arabien betreffend, aus Saudi-Arabien kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fafc9d10-3a48-4907-a957-c2b07f10aec5",
                                                "sense_id": "d40a49e9-3baa-32b1-a8e4-14257df9a953",
                                                "text": "Er ist ein saudi-arabischer Junge."
                                            },
                                            {
                                                "example_id": "105d9261-b211-4b03-b3bd-e11c64918fcc",
                                                "sense_id": "d40a49e9-3baa-32b1-a8e4-14257df9a953",
                                                "text": "Die Herrscherfamilie fürchtete, Saddam Husain könne die Gelegenheit nutzen und die ölreiche saudi-arabische Ostprovinz besetzen."
                                            },
                                            {
                                                "example_id": "ac014165-7924-4070-b7bb-99b4a4952751",
                                                "sense_id": "d40a49e9-3baa-32b1-a8e4-14257df9a953",
                                                "text": "„Osama bin Laden diente Gerüchten zufolge als Mittelsmann, um bei saudi-arabischen Prinzen um Geld zu werben, mit dem der Wahlkampf und die erste Regierung von Benazir Bhutto torpediert werden sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4791aaf2-67ec-40f3-bf18-99b90b54b55a",
                        "source_entry_id": "95c3f381-0642-387f-a215-851bfd8b819a",
