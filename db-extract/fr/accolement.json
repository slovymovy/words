                            {
                                "example_id": "1101f693-02f5-4c4c-9900-c9a1c0186db8",
                                "sense_id": "cf276932-d025-3780-af31-99af8d5088d4",
                                "text": "Sur les voyelles ouvertes, l'accolement est toujours plus ferme que sur les voyelles fermées."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1165c5e-faa7-3691-a5ce-da7ac97626d0",
                        "entry_id": "ad6f7dde-8b5a-3333-9b17-5d111e9768fd",
                        "glosses": [
                            "Fait d’être accolé."
                        ],
