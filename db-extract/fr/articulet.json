                "senses": [
                    {
                        "sense_id": "270f4786-7c7f-3b93-a8a0-9d95c38060f0",
                        "entry_id": "02274c8d-7dd6-3155-9716-24be96352b54",
                        "glosses": [
                            "Petit article paru dans la presse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f531bea-6b79-45cd-b151-e148232351c8",
                                "sense_id": "270f4786-7c7f-3b93-a8a0-9d95c38060f0",
                                "text": "Comme des enfants pris en faute, nous nous vîmes reprocher un détail, un articulet sans gravité qui avait échappé à notre vigilance."
                            },
                            {
                                "example_id": "60dc8212-3f9c-4a57-8362-78a0d01c12cb",
                                "sense_id": "270f4786-7c7f-3b93-a8a0-9d95c38060f0",
                                "text": "Quelques articulets paraissent dans la presse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "858f1ce2-bd08-4bf2-878b-723853ada6a9",
                        "source_entry_id": "02274c8d-7dd6-3155-9716-24be96352b54",
                        "source_sense_id": "270f4786-7c7f-3b93-a8a0-9d95c38060f0",
