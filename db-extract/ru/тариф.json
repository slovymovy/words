                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7b92897-3490-3a5b-8f99-774caba5272b",
                        "entry_id": "3234cb45-ebf5-38bc-990c-184fcbf010ce",
                        "glosses": [
                            "экон. официально установленный размер стоимости, оплаты, обложения чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4f3b4b-d886-40b7-8df2-cf72c5266c72",
                                "sense_id": "a7b92897-3490-3a5b-8f99-774caba5272b",
                                "text": "Наш сотовый оператор предлагает своим клиентам несколько тарифов, учитывающих не только специфику бизнеса, но и индивидуальные потребности каждого."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c759ef3-74f8-4d1b-b7ce-7ab0e22fd6b3",
                        "source_entry_id": "3234cb45-ebf5-38bc-990c-184fcbf010ce",
                        "source_sense_id": "a7b92897-3490-3a5b-8f99-774caba5272b",
                        "target_lang_word": "tariff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tariff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9de134df-d0c4-3f8d-8588-5bccef286338",
                                        "entry_id": "465372f9-d862-3be7-a979-92512f37290c",
                                        "glosses": [
                                            "A system of government-imposed duties levied on imported or exported goods; a list of such duties, or the duties themselves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f8e4bb1-bf60-4593-bdf4-d25ee1b6670f",
                                                "sense_id": "9de134df-d0c4-3f8d-8588-5bccef286338",
                                                "text": "For the sake of this support, the party advocated for agricultural tariffs, for antimargarine laws, and for restrictions on meat importation."
                                            },
                                            {
                                                "example_id": "9f1beaed-1178-4f8c-8b5f-74e990a7c3e2",
                                                "sense_id": "9de134df-d0c4-3f8d-8588-5bccef286338",
                                                "text": "Possibly Wallonians bought goods in Flanders that they could have obtained cheaper in Holland if it were not for the tariff."
                                            },
                                            {
                                                "example_id": "2ee7614c-4a7e-4786-898b-49554c641bf4",
                                                "sense_id": "9de134df-d0c4-3f8d-8588-5bccef286338",
                                                "text": "It’s been nearly four years since China put tariffs on American-grown soybeans during a tit-for-tat trade war with then-President Donald Trump – and they remain in place despite the change in administrations."
                                            },
                                            {
                                                "example_id": "c5d3a05e-1b7f-4b79-be5c-30947e25c149",
                                                "sense_id": "9de134df-d0c4-3f8d-8588-5bccef286338",
                                                "text": "Speaking to press in the Oval Office on Friday after signing executive orders, Trump said the tariff would apply to any phone maker selling devices in the US."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad19af7-2014-3c25-af58-bdf794cd0a4d",
                                        "entry_id": "465372f9-d862-3be7-a979-92512f37290c",
                                        "glosses": [
                                            "A schedule of rates, fees or prices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad2a17e-ff47-48cf-b876-bb7570c77e8f",
                                                "sense_id": "cad19af7-2014-3c25-af58-bdf794cd0a4d",
                                                "text": "Under a peak/off-peak electricity tariff, you pay a lower rate for the power when demand is less."
                                            },
                                            {
                                                "example_id": "0fb3e032-1fa0-4e3e-9249-d52563411ca1",
                                                "sense_id": "cad19af7-2014-3c25-af58-bdf794cd0a4d",
                                                "text": "There is a tariff in every carriage, and most of them also have taxometers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "028fbc80-f9d9-3c0e-bca0-3134336f54af",
                                        "entry_id": "465372f9-d862-3be7-a979-92512f37290c",
                                        "glosses": [
                                            "A sentence determined according to a scale of standard penalties for certain categories of crime."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tariff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa23e06-9bb4-3a19-82b5-5101ccd624f7",
                                        "entry_id": "79c86a06-c897-320b-8494-e03f88edb3b7",
                                        "glosses": [
                                            "To levy a duty on (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1aa662-2671-4077-957e-801ec05e8616",
                                                "sense_id": "aaa23e06-9bb4-3a19-82b5-5101ccd624f7",
                                                "text": "From the perspective of foreign producers, it is more difficult to export tariffed goods to the US because US importers have to pay the tariff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
