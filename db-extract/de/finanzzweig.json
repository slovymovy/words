                "senses": [
                    {
                        "sense_id": "789a8332-1287-3fef-a2fe-8e6c89c86be1",
                        "entry_id": "c7f87bf4-6432-3c63-8f9f-ea5ac1a41abd",
                        "glosses": [
                            "Geschäftsbereich, der sich mit dem Geldwesen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d579cec8-573f-43c8-b861-a91d6e9ffc68",
                                "sense_id": "789a8332-1287-3fef-a2fe-8e6c89c86be1",
                                "text": "„Die Geschäfte, die dem Unternehmen am meisten Gewinne einbringen, sind seine europäischen Ableger, sein Finanzzweig (GMAC), Hughes Aircraft, Delco und Electronic Data Systems (ein Dankeschön an Ross Perot).“"
                            },
                            {
                                "example_id": "7b300a98-b558-4f6a-8cb1-ac30427b7712",
                                "sense_id": "789a8332-1287-3fef-a2fe-8e6c89c86be1",
                                "text": "„Im Jahre 1765 ging man jedoch von dein Systeme der getrennten Verwaltung der Finanzzweige wieder ab.“"
                            },
                            {
                                "example_id": "37059b0c-4b4f-49be-98ce-045af3733cb1",
                                "sense_id": "789a8332-1287-3fef-a2fe-8e6c89c86be1",
                                "text": "„Man spricht davon als von einer entschiedenen Sache, daß Herr von Voß alle Finanzzweige wieder vereinigen werde unter seiner persönlichen Leitung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
