                "translations": [
                    {
                        "translation_id": "c9e7988b-f8f5-4a87-9e4a-625d1d82ac84",
                        "source_entry_id": "e5bdf773-0966-371a-969b-c9996c306967",
                        "source_sense_id": "dd320f02-50ff-375b-8aff-b0357c89e781",
