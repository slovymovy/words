                                "target_senses": [
                                    {
                                        "sense_id": "4cc3f53b-c037-368f-88a1-1a7e6d818b77",
                                        "entry_id": "470e7086-68f2-3612-974a-24605b1fcfa8",
                                        "glosses": [
                                            "A game in which individuals or teams seek to find a number of specific items, or perform tasks, as given in a list."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c4e810-8b6b-4107-b2dd-c0851504d375",
                                                "sense_id": "4cc3f53b-c037-368f-88a1-1a7e6d818b77",
                                                "text": "Before he died, James Halliday (Mark Rylance), the hermit-like, socially maladjusted tech genius who created The Oasis, hid an Easter egg somewhere in the circuitry, scattering bread crumbs that lead to its location. Find the egg, and the mogul’s fortune—along with total control of his digital fiefdom—is yours. It’s the ultimate capitalist scavenger hunt!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "708846c9-bbda-4899-8a78-8661894dfc78",
                        "source_entry_id": "ef36cc28-45e6-3850-bcfa-fed2ee6f728d",
                        "source_sense_id": "a8d897fd-3bac-3001-aa8c-5a7320b5663c",
                        "source_sense_description": "Spiel, bei dem die Mitspieler Hinweisen folgen oder Aufgaben lösen müssen, um eine Belohnung am Zielort zu finden",
                        "target_lang_word": "chasse au trésor",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chasse au trésor",
                                "target_lang_code": "fr",
                                "target_senses": [
