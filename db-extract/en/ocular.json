                    },
                    {
                        "translation_id": "faa2ead2-60c1-49fa-87ea-40ceb515dc37",
                        "source_entry_id": "c9705d2c-d470-3024-bd1f-3ddb1ca72eff",
                        "source_sense_description": "of or relating to the eye",
                        "target_lang_word": "oculaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
