                    {
                        "translation_id": "1a60b0a9-e8b5-4cc8-8559-76e14d141803",
                        "source_entry_id": "99ce13bf-f8ab-3765-bac4-5bb7c86c7bbe",
                        "source_sense_id": "2ad4617f-67dc-32c4-b0aa-bc76643419f1",
                        "target_lang_word": "лысуха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лысуха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c64bd35c-be4e-3564-aa33-8fc0c14ce1a4",
                                        "entry_id": "e774e5aa-9678-38ec-84f0-dfc25c4aef5a",
                                        "glosses": [
                                            "зоол., орнитол. небольшая водоплавающая птица семейства пастушковых с чёрным оперением и белым наростом на лбу (Fulica)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80604261-722d-4d20-932e-a2b771d1f6d9",
                                                "sense_id": "c64bd35c-be4e-3564-aa33-8fc0c14ce1a4",
                                                "text": "Лысуха .. по устройству своего тела, особенно шеи и головы, по беловатому, острому, совершенно куриному носу, .. отличается от утиных пород и по справедливости может назваться водяною курицею. Имя лысухи .. дано ей потому, что у ней на лбу лежит как будто припаянная белая, гладкая бляха, .. отчего голова издали кажется лысою."
                                            },
                                            {
                                                "example_id": "d89be9be-20db-4ef3-bc7f-1d5904ba125c",
                                                "sense_id": "c64bd35c-be4e-3564-aa33-8fc0c14ce1a4",
                                                "text": "Дорога шла до Крутца вдоль пруда, по которому уже плавали чёрные лысухи и над которым уже вилась стая белых и пёстрых мартышек или чаек."
                                            },
                                            {
                                                "example_id": "5ab0b962-5140-4614-9ca9-a60b820534a1",
                                                "sense_id": "c64bd35c-be4e-3564-aa33-8fc0c14ce1a4",
                                                "text": ".. одна за другой начинают просыпаться птицы. Громче и усерднее загоготали гуси, запищали в тростнике лысухи, учащённее раздаётся гуканье выпи и звонкий голос водяного коростеля, свистят, крякают и кыркают разные утки .."
                                            },
                                            {
                                                "example_id": "ee0c9e6b-baa7-4c7a-bde3-6ce32f78bf6c",
                                                "sense_id": "c64bd35c-be4e-3564-aa33-8fc0c14ce1a4",
                                                "text": "Лысуха — водоплавающая птица семейства пастушковых .. Плотного телосложения, оперенье чёрное или тёмно-серое матовое. На лбу — заметная кожистая бляха белого цвета. Клюв и хвост короткие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
