                        "entry_id": "ef3eb441-bd0e-37dc-9cca-8497f57352e8",
                        "glosses": [
                            "operating theatre, operating room (room where surgical procedures are performed)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f740aa4a-f913-4cc0-8d30-a27e852edb66",
                                "sense_id": "af4efc8d-c572-3564-90fe-a159c7c8e43e",
                                "text": "De patiënt werd naar de operatiekamer gebracht voor de chirurgische ingreep.",
                                "translation": "The patient was taken to the operating theatre for the surgical procedure.",
                                "english": "The patient was taken to the operating theatre for the surgical procedure."
                            },
                            {
                                "example_id": "b5af54ac-505b-4c73-b59d-a2e33a394806",
                                "sense_id": "af4efc8d-c572-3564-90fe-a159c7c8e43e",
                                "text": "De operatiekamers in het ziekenhuis zijn uitgerust met geavanceerde medische apparatuur.",
                                "translation": "The operating rooms in the hospital are equipped with advanced medical equipment.",
                                "english": "The operating rooms in the hospital are equipped with advanced medical equipment."
                            },
                            {
                                "example_id": "5d31d070-e32f-4e29-baf6-b5367b91f9f9",
                                "sense_id": "af4efc8d-c572-3564-90fe-a159c7c8e43e",
                                "text": "De chirurgen verzamelden zich in de goed verlichte operatiekamer om de complexe operatie uit te voeren.",
                                "translation": "The surgeons gathered in the well-lit operating room to perform the complex surgery.",
                                "english": "The surgeons gathered in the well-lit operating room to perform the complex surgery."
                            }
                        ]
                    }
