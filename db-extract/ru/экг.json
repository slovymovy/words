                                            {
                                                "example_id": "69b52959-d147-43f6-9d33-c030bc587d38",
                                                "sense_id": "bb8b134a-2950-35f2-ac5d-a15fba7fc312",
                                                "text": "Mit dem EKG lassen sich vielfältige Aussagen zu Eigenschaften und Gesundheit des Herzens treffen."
                                            },
                                            {
                                                "example_id": "647f367e-9f7e-49da-9ecd-dbe1c763cf97",
                                                "sense_id": "bb8b134a-2950-35f2-ac5d-a15fba7fc312",
                                                "text": "„Das EKG und ein Ultraschall des Herzens waren normal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0b93c19-5772-3cf9-a1b6-65e9c1fef961",
