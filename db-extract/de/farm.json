                                                "sense_id": "3736b1ff-431d-39b8-a3e0-117ddd582c5c",
                                                "text": "Orada kızına bir çiftlik almış, işten el çekmişti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54ea4f1f-5d89-330a-9cd2-a58fd5286cfa",
