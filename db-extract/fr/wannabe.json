                        "glosses": [
                            "Aspirant qui souhaite être quelqu’un ou faire quelque chose, mais manque de qualités, de talent."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "1db88dbc-e8b1-42a5-9991-e304e4865108",
                                "sense_id": "8118ff68-0e1f-3031-9cb2-b2a23de32ca1",
                                "text": "Ce nouveau Orange Orange est encore plus sucré, lustré, raffiné, destiné aux DJ, aussi wannabe soient-ils."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c967d47b-be07-42d2-8038-938a28da0441",
                        "source_entry_id": "e7cc8808-03c8-3826-b296-322ad7e3ca9b",
                        "source_sense_id": "8118ff68-0e1f-3031-9cb2-b2a23de32ca1",
