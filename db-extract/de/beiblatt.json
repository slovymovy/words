                "senses": [
                    {
                        "sense_id": "8b18336e-21cd-383d-adbc-28ab7bd29507",
                        "entry_id": "56c3bf1f-b68a-3355-91de-610f04420fb5",
                        "glosses": [
                            "diejenigen Karten, die im angestrebten Spiel kein Trumpf sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9659a33-2bab-4dbc-a9f2-a3de56c43d79",
                                "sense_id": "8b18336e-21cd-383d-adbc-28ab7bd29507",
                                "text": "Das Beiblatt mit den Assen ist ja ganz gut, aber es sind einfach zu wenige Trümpfe dabei. Ich passe."
                            },
                            {
                                "example_id": "3b219e10-5ac6-45b1-b592-00ef764e48fc",
                                "sense_id": "8b18336e-21cd-383d-adbc-28ab7bd29507",
                                "text": "„Selbstverständlich ist Ihr Beiblatt viel zu schwach, um mit fünf mittelmäßigen Trümpfen ein Herz-Spiel auch nur in Erwägung zu ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "437bfa15-f29f-3bfe-b233-8b87500bd26a",
                        "entry_id": "56c3bf1f-b68a-3355-91de-610f04420fb5",
                        "glosses": [
                            "beiliegende Seite (Blatt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f7e651-c0a7-4e67-93db-f77ee394c7d8",
                                "sense_id": "437bfa15-f29f-3bfe-b233-8b87500bd26a",
                                "text": "„Dazu muss nachgewiesen werden, dass die Alternativkonstruktion für den gleichwertigen Ersatz eines entsprechenden Bauteils aus dem Beiblatt 2 der DIN 4108 geeignet ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
