{
    "word_family": [
        "coving"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1900225-0572-3f20-a3f2-af1a4b68cdc7",
                    "sense_definition": "A small coastal inlet, especially one having high cliffs protecting vessels from prevailing winds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat dropped anchor in a quiet <w>cove</w> to escape the rough sea.",
                            "target_lang_translations": {
                                "ru": "Лодка бросила якорь в тихой <w>бухте</w>, чтобы спастись от бушующего моря.",
                                "pl": "Łódź rzuciła kotwicę w spokojnej <w>zatoczce</w>, aby schronić się przed wzburzonym morzem."
                            }
                        },
                        {
                            "text": "There are several excellent snorkelling spots in the shallow <w>coves</w> around the island.",
                            "target_lang_translations": {
                                "ru": "В мелководных <w>бухточках</w> вокруг острова есть несколько отличных мест для снорклинга.",
                                "pl": "W płytkich <w>zatoczkach</w> wokół wyspy znajduje się kilka znakomitych miejsc do snorkelingu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shallow cove",
                        "secret cove",
                        "coastal cove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой прибрежный залив, часто защищенный высокими скалами от ветров.",
                        "pl": "Niewielka przybrzeżna zatoczka, często osłonięta stromymi klifami przed wiatrem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бухта",
                                "target_lang_sense_clarification": "небольшой залив"
                            },
                            {
                                "target_lang_word": "бухточка",
                                "target_lang_sense_clarification": "маленькая уютная бухта"
                            },
                            {
                                "target_lang_word": "заводь",
                                "target_lang_sense_clarification": "тихое место у берега"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zatoczka",
                                "target_lang_sense_clarification": "niewielka zatoka morska lub rzeczna"
                            },
                            {
                                "target_lang_word": "zatoka",
                                "target_lang_sense_clarification": "akwen wcięty w ląd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3cfcfb1-8706-3c7f-8161-c773aaf33212",
                    "sense_definition": "A fellow or a man.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At one point, a friendly-looking sort of <w>cove</w> with silver hair beamed at him.",
                            "target_lang_translations": {
                                "ru": "В какой-то момент ему улыбнулся дружелюбного вида <w>малый</w> с седыми волосами.",
                                "pl": "W pewnym momencie uśmiechnął się do niego sympatycznie wyglądający <w>facet</w> ze srebrnymi włosami."
                            }
                        },
                        {
                            "text": "He was known as a bit of a strange <w>cove</w> by the locals in the village.",
                            "target_lang_translations": {
                                "ru": "Местные жители в деревне считали его немного странным <w>типом</w>.",
                                "pl": "Miejscowi we wsi uważali go za dość dziwnego <w>typa</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "man"
                    ],
                    "antonyms": [
                        "woman"
                    ],
                    "common_phrases": [
                        "strange cove",
                        "old cove"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, парень или мужчина (устаревшее британское обращение).",
                        "pl": "Mężczyzna, gość lub facet (przestarzałe brytyjskie określenie potoczne)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малый",
                                "target_lang_sense_clarification": "парень, субъект"
                            },
                            {
                                "target_lang_word": "тип",
                                "target_lang_sense_clarification": "человек с определенными чертами"
                            },
                            {
                                "target_lang_word": "субъект",
                                "target_lang_sense_clarification": "незнакомый человек"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "facet",
                                "target_lang_sense_clarification": "potocznie o mężczyźnie"
                            },
                            {
                                "target_lang_word": "typ",
                                "target_lang_sense_clarification": "osobnik, człowiek o specyficznym wyglądzie lub zachowaniu"
                            },
                            {
                                "target_lang_word": "gość",
                                "target_lang_sense_clarification": "potocznie o człowieku, mężczyźnie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71e7a5ed-6d8b-3c20-a089-f667fa45ca04",
                    "sense_definition": "A friend or a mate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went down to the pub to meet an old <w>cove</w> from his school days.",
                            "target_lang_translations": {
                                "ru": "Он отправился в паб, чтобы встретиться со старым <w>приятелем</w> со школьных времен.",
                                "pl": "Poszedł do pubu, aby spotkać się ze starym <w>kumplem</w> z czasów szkolnych."
                            }
                        },
                        {
                            "text": "The two <w>coves</w> shared a drink and talked about the old times.",
                            "target_lang_translations": {
                                "ru": "Двое <w>друзей</w> выпили по стаканчику и поговорили о былых временах.",
                                "pl": "Dwaj <w>przyjaciele</w> napili się razem i rozmawiali o dawnych czasach."
                            }
                        }
                    ],
                    "synonyms": [
                        "friend"
                    ],
                    "antonyms": [
                        "enemy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Друг, приятель или товарищ (архаичный сленг).",
                        "pl": "Przyjaciel, kumpel lub kompan (archaiczny slang)."
                    },
                    "translations": {
