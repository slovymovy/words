                "senses": [
                    {
                        "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                        "entry_id": "ba37ce46-76fb-3b67-a926-e4b5e7cb4e75",
                        "glosses": [
                            "Maßnahmen für Soldaten, die deren Wohlbefinden, die Moral und Motivation stärken sollen; meist finden Truppenbetreuungen außerhalb von Kampfeinsätzen statt (beispielsweise durch Unterhaltung, Freizeitangebote, psychologische Unterstützung oder Seelsorge)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc9f7869-f09c-45f5-836c-da52399a8c45",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "Die Bundeswehr legt großen Wert auf die Truppenbetreuung im Auslandseinsatz."
                            },
                            {
                                "example_id": "7867444a-b32f-48e7-9cb8-95113d9fc4d3",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "Im Zweiten Weltkrieg gab es eigene Theatergruppen zur Truppenbetreuung an der Front."
                            },
                            {
                                "example_id": "c60a94a0-cacc-4d1f-a12e-9358c91b2eb9",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "[30. September 1940:] „Im Deutschen Reich werden gegenwärtig 14 Wanderbühnen für die \"Truppenbetreuung\" an Wehrmachtsstandorten und an der Front eingesetzt.“"
                            },
                            {
                                "example_id": "130ae2bd-2492-4048-9147-dadb1586f491",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "[2. Weltkrieg:] „[…] es wurde Hertha Borchert […] nahegelegt, in die „Nationalsozialistische Frauenschaft“ einzutreten. Fortan hielt sie Lesungen in Ortsgruppen und reiste, als der Krieg ausgebrochen war, zwecks Truppenbetreuung wochenlang durchs Land.“"
                            },
                            {
                                "example_id": "9faa4f0d-4203-4e05-bcec-d56398663716",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "[2. Weltkrieg:] „Nach ihrer Rückkehr nach Hamburg und einer überstandenen Hepatitis-Infektion meldete sie sich erneut zur Truppenbetreuung und spielte an wechselnden Truppenstandorten in Deutschland.“"
                            },
                            {
                                "example_id": "f14005a7-4b18-426f-993c-1b253713c945",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "[2. Weltkrieg:] „Heinz Erhardt wird zur Marine eingezogen; er muss zur Truppenbetreuung und dort seine Chansons und Gedichte vortragen. Auf diese Weise kommt er relativ gut durch die Kriegsjahre.“"
                            },
                            {
                                "example_id": "b61837b9-e6fa-4079-abd1-dd3fc2a022b5",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "[2. Weltkrieg:] „Wolfgang Neuß […] schießt sich vorsätzlich den linken Zeigefinger ab. Er hat vom Krieg die Nase voll. Im Lazarett tritt er als Parodist und Pantomime auf, von da an ist er in der Truppenbetreuung tätig.“"
                            },
                            {
                                "example_id": "2d6ff1fb-0b7b-4089-826d-66aa9484c36d",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "[2. Weltkrieg:] „Marlene Dietrich […] wurde dort [Anmerkung: in den USA] zum Star und zur Legende und gab sich schließlich mit ihrem Beitrag zur Truppenbetreuung für die Alliierten als engagierte Gegnerin des Faschismus zu erkennen.“"
                            },
                            {
                                "example_id": "b9f2905a-598c-44bc-8553-b0a5d5c11979",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "[2. Weltkrieg: Zarah Leander:] „Die Sängerin geht zur Truppenbetreuung und singt vor verwundeten Soldaten, auch solchen mit SS-Runen: »Davon geht die Welt nicht unter.«“"
                            },
                            {
                                "example_id": "33b82247-851c-4add-83a0-a298fa5536e8",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "[2. Weltkrieg: Glen Miller:] „Nachdem Miller am 7. Oktober 1942 zur Armee einberufen worden war, absolvierte er die Grundausbildung im Eiltempo, um dann das Orchester der Luftwaffe aufzubauen und unermüdlich für die Truppenbetreuung zu arbeiten. Bei einem dieser Einsätze flog er am 15. Dezember 1944 bei schlechtem Wetter von England nach Paris mit einem Transportflugzeug, das jedoch nie am Zielort ankam.“"
                            },
                            {
                                "example_id": "28cb6164-ad6a-40fc-87dd-4eaf17627dc5",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "„Unmittelbar nach dem Zweiten Weltkrieg war Bayreuth unter US-Besatzung, zur Truppenbetreuung wurden dort [Anmerkung: im Bayreuther Festspielhaus] auch Musicals gespielt.“"
                            },
                            {
                                "example_id": "754a1ab2-0232-491a-9876-db1b910ac438",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "[2001:] „Die amerikanischen Pop-Diven Mariah Carey und Jennifer Lopez zeigen sich patriotisch und reisen zur Truppenbetreuung in den Kosovo und nach Afghanistan.“"
                            },
                            {
                                "example_id": "635c8bbf-be10-42c7-856d-fea9c61ff028",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "„Auch Peter Maffay hat sich schon in der Truppenbetreuung engagiert. Er sang im Sommer 2005 im Kabuler Isaf-Camp vor tausend deutschen Soldaten.“"
                            },
                            {
                                "example_id": "e5fef6c8-7974-486f-a977-0e3cf25fbd36",
                                "sense_id": "8562f45f-b531-36ed-b974-7c6b132d139f",
                                "text": "„Geplant sind zwei Neubauten - ein Gebäude für die Truppenbetreuung und eines für das Musikkorps der Luftwaffe, das ebenfalls in Erfurt stationiert ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
