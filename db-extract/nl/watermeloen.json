                                "target_senses": [
                                    {
                                        "sense_id": "dedc12d6-60a9-3d9d-a1ca-4ec9f75402fe",
                                        "entry_id": "82a0b022-7342-3a7f-8017-380ff32ae5de",
                                        "glosses": [
                                            "Melonenart mit sehr wasserhaltigem Fruchtfleisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b37044-4640-4b5b-abdc-44c1c14beb42",
                                                "sense_id": "dedc12d6-60a9-3d9d-a1ca-4ec9f75402fe",
                                                "text": "Das Fruchtfleisch einer Wassermelone ist rot."
                                            },
                                            {
                                                "example_id": "ae026812-6932-48a5-be22-a8979a381978",
                                                "sense_id": "dedc12d6-60a9-3d9d-a1ca-4ec9f75402fe",
                                                "text": "„Die Preise für Wassermelonen bewegen sich unaufhörlich in einer Spirale nach unten, dabei sind es sowieso Kopekenpreise.“"
                                            },
                                            {
                                                "example_id": "652ac2bb-9af3-4e09-822f-e042dd4e2fa6",
                                                "sense_id": "dedc12d6-60a9-3d9d-a1ca-4ec9f75402fe",
                                                "text": "„In der einen Hand hielt sie einen Goldklumpen von der Größe einer Wassermelone.“"
                                            },
                                            {
                                                "example_id": "c0ba70a0-40dd-4815-8536-6f6d65a3b7db",
                                                "sense_id": "dedc12d6-60a9-3d9d-a1ca-4ec9f75402fe",
                                                "text": "„Bosse erzählte weiter, dass er ganz ähnlich mit den Wassermelonen verfuhr, die er ebenfalls importierte, jedoch nicht aus Polen, sondern aus Spanien oder Marokko.“"
                                            },
                                            {
                                                "example_id": "308bf865-c2e0-447e-b433-a45f45483a6e",
                                                "sense_id": "dedc12d6-60a9-3d9d-a1ca-4ec9f75402fe",
                                                "text": "„Wir wurden mit Baklava und Wassermelonen gefüttert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
