                                        "sense_id": "3b27d21c-6870-3d3c-a39f-057866ed1b6b",
                                        "entry_id": "33b4dc06-2ed2-3c9b-b120-75434caf1b76",
                                        "glosses": [
                                            "Primatenart aus der Familie der Lemuren, die im Nordosten Madagaskars vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca7ecd21-b5f4-4fc0-8672-bd5310ec5dc8",
                                                "sense_id": "3b27d21c-6870-3d3c-a39f-057866ed1b6b",
                                                "text": "„Mit einer Körperhöhe von 80 cm ist der Indri (Indri Indri) heute die größte noch existierende Lemurenart.“"
                                            },
                                            {
                                                "example_id": "95855715-0189-44e8-8e0e-bce72e9db9ef",
                                                "sense_id": "3b27d21c-6870-3d3c-a39f-057866ed1b6b",
                                                "text": "„Da sein Lebensraum zunehmend zerstört wird, ist der Indri vom Aussterben bedroht.“"
                                            },
                                            {
                                                "example_id": "caa32b00-2b74-4609-a987-4f9f05df6738",
                                                "sense_id": "3b27d21c-6870-3d3c-a39f-057866ed1b6b",
                                                "text": "„Zur Familie der Indridae gehören der kleine Wollmaki und der Indri, der von den Eingeborenen wegen seiner lauten Stimme Amboanala oder Hund des Waldes genannt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
