                "senses": [
                    {
                        "sense_id": "6abea914-370d-3710-abc2-a42f1f5c70c9",
                        "entry_id": "7bdc96c2-5ce4-3080-86de-e24ebc0cecce",
                        "glosses": [
                            "der nördliche Teil von Skandinavien"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "e930e6a2-a51a-4820-b19b-190132bf0fac",
                                "sense_id": "6abea914-370d-3710-abc2-a42f1f5c70c9",
                                "text": "Heutzutage beträgt die Landhebung, die von der geographischen Breite abhängt, in Nordskandinavien 10–11 mm jährlich."
                            },
                            {
                                "example_id": "a3f3c574-974e-494d-a498-b6b78a661619",
                                "sense_id": "6abea914-370d-3710-abc2-a42f1f5c70c9",
                                "text": "800 Kilometer führt dieser schönste und längste Wanderweg Nordskandinaviens durch die Berge Norwegens, Schwedens und Finnlands, überquert dabei 15 Mal die Grenzen und führt auch über den Padjelantaleden."
                            },
                            {
                                "example_id": "2f580ec5-9313-417b-94d8-97344256c207",
                                "sense_id": "6abea914-370d-3710-abc2-a42f1f5c70c9",
                                "text": "Für Nordskandinavien wird nicht der Begriff Bronzezeit verwendet, sondern Metallzeit."
                            },
                            {
                                "example_id": "74f39556-dedf-443d-9b58-b133b2018595",
                                "sense_id": "6abea914-370d-3710-abc2-a42f1f5c70c9",
                                "text": "Ich liebe diesen langsamen, schleichenden Übergang der Vegetation je näher man den Bergen und den unzugänglichsten Regionen Nordskandinaviens kommt."
                            },
                            {
                                "example_id": "dc0618ea-3883-4593-86ff-df3a4d3ca1a4",
                                "sense_id": "6abea914-370d-3710-abc2-a42f1f5c70c9",
                                "text": "Nachdem mir schon in Träumen Polarlichter erschienen waren, die Erwartung darauf sich also immer schöner und aufregender gestaltete, beschloss ich mit einem Freund endlich eine Reise nach Nordskandinavien zu unternehmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
