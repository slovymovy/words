                "senses": [
                    {
                        "sense_id": "d6dd8e9b-a723-34c9-9bad-ad5b49d0ba61",
                        "entry_id": "38d2b0b9-4865-393e-b5f2-3ce7e03ba626",
                        "glosses": [
                            "manuelle Aufhebung(-smöglichkeit) einer Blockierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aec1539-4025-4d31-a0e6-8e7884677c7d",
                                "sense_id": "d6dd8e9b-a723-34c9-9bad-ad5b49d0ba61",
                                "text": "„Das Zugpersonal betätigt beim Aussteigen aus dem Zug den Vierkantschalter an der Notentriegelung.“"
                            },
                            {
                                "example_id": "69c9f793-2c61-472c-b83a-6510975df9f7",
                                "sense_id": "d6dd8e9b-a723-34c9-9bad-ad5b49d0ba61",
                                "text": "„Ist dies nicht möglich, müssen Zugangssperren über eine Notentriegelung leicht zu öffnen sein, wobei an der Notentriegelung und an der Zugangssperre auf die noch bestehenden Gefahren besonders hingewiesen werden muss.“"
                            },
                            {
                                "example_id": "2d72200c-f899-4176-b2ce-366e32b47050",
                                "sense_id": "d6dd8e9b-a723-34c9-9bad-ad5b49d0ba61",
                                "text": "„Um die Fahrschachttür, zum Beispiel zur Befreiung einer eingeschlossenen Person, zu öffnen, muss an jeder Schachttür eine geeignete Notentriegelung vorhanden sein.“"
                            },
                            {
                                "example_id": "0f4abac1-72aa-4c29-9f17-562f9e2bc720",
                                "sense_id": "d6dd8e9b-a723-34c9-9bad-ad5b49d0ba61",
                                "text": "„Er ging zur Tür und aktivierte die Notentriegelung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
