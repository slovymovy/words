                "senses": [
                    {
                        "sense_id": "e7116d21-0f37-368c-b412-f1f44ef07f84",
                        "entry_id": "0b91bb9d-d800-30a3-b104-c4acde48bfc9",
                        "glosses": [
                            "besonders oft von Geschäftsleuten genutzte Buchungs- und Beförderungskategorie, deren Komfort höher als in der Economyclass, aber niedriger als in der First Class ist"
                        ],
                        "tags": [
                            "Flugwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "35e91957-39bc-4909-b632-51b588c8156d",
                                "sense_id": "e7116d21-0f37-368c-b412-f1f44ef07f84",
                                "text": "„Wenn man Rüdiger Lange ein bisschen länger begleitet, dann sieht man einen Arzt, der auch mal für zwei Tage in der Businessclass zu Kongressen nach Japan fliegt und dann ein paar Schlaftabletten schluckt, um den Jetlag zu überwinden.“"
                            },
                            {
                                "example_id": "ba3169e1-47c2-4fc7-91f4-84310c4357a1",
                                "sense_id": "e7116d21-0f37-368c-b412-f1f44ef07f84",
                                "text": "„Aber er ist sich auch der Probleme der Gemeinschaftswährung bewusst und macht die in kleinen Beobachtungen deutlich, etwa wenn er berichtet, dass die Notenbankchefs aus dem Norden immer Economy nach Frankfurt zur EZB-Sitzung flogen, die aus dem Süden aber in der Businessclass.“"
                            },
                            {
                                "example_id": "94670657-36e8-4fc9-88c2-9f20e3ae03b6",
                                "sense_id": "e7116d21-0f37-368c-b412-f1f44ef07f84",
                                "text": "„Das einzige noch verfügbare Ticket gab es in der Businessclass, teuer wie der Tod, dachte Eiríkur unwillkürlich, und schickte seinem Großvater im Zug zum Flughafen eine SMS, dass er unterwegs sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
