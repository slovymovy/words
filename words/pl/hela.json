                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ящик",
                                "target_lang_sense_clarification": "контейнер для овощей"
                            },
                            {
                                "target_lang_word": "короб",
                                "target_lang_sense_clarification": "большой деревянный ящик"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "374747ca-692f-3c56-9042-f753d69163b4",
                    "sense_definition": "skrzynia na wozie lub wóz ze skrzynią",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pojemniki",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na drodze widzieliśmy dwie <w>hele</w> wypełnione towarami.",
