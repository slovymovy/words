                {
                    "sense_id": "b37b4ea1-bf97-3b52-a62a-48917c0e4d45",
                    "sense_definition": "S'emploie en début de phrase pour introduire une question ou solliciter une réaction.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Alors</w>, tu viens avec nous au cinéma ce soir ?",
                            "target_lang_translations": {
                                "en": "<w>So</w>, are you coming with us to the cinema tonight?",
                                "ru": "<w>Ну</w>, ты пойдёшь с нами в кино сегодня вечером?",
                                "nl": "<w>Nou</w>, kom je vanavond met ons mee naar de bioscoop?",
                                "de": "<w>Na</w>, kommst du heute Abend mit uns ins Kino?",
                                "pl": "<w>No</w>, idziesz dziś wieczorem z nami do kina?",
                                "it": "<w>Allora</w>, vieni con noi al cinema stasera?",
                                "cs": "<w>No</w>, půjdeš dnes večer s námi do kina?",
                                "tr": "<w>Ee</w>, bu akşam bizimle sinemaya geliyor musun?",
                                "es": "<w>Bueno</w>, ¿vienes con nosotros al cine esta noche?",
                                "zh": "<w>那么</w>，你今晚跟我们一起去看电影吗？"
                            }
                        },
                        {
                            "text": "<w>Alors</w>, comment s'est passée ta première journée de travail ?",
                            "target_lang_translations": {
                                "en": "<w>So</w>, how did your first day at work go?",
                                "ru": "<w>Ну</w>, как прошёл твой первый рабочий день?",
                                "nl": "<w>Nou</w>, hoe is je eerste werkdag verlopen?",
                                "de": "<w>Na</w>, wie war dein erster Arbeitstag?",
                                "pl": "<w>No</w>, jak minął twój pierwszy dzień w pracy?",
                                "it": "<w>Allora</w>, com'è andata la tua prima giornata di lavoro?",
                                "cs": "<w>No</w>, jak ti šel první pracovní den?",
                                "tr": "<w>Ee</w>, ilk iş günün nasıl geçti?",
                                "es": "<w>Pues</w>, ¿qué tal te fue tu primer día de trabajo?",
                                "zh": "<w>那么</w>，你第一天上班感觉怎么样？"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Opens a question or invites a reaction at the start of a sentence.",
                        "ru": "Открывает вопрос или побуждает собеседника к реакции в начале фразы.",
                        "nl": "Wordt aan het begin van een zin gebruikt om een vraag in te leiden of om een reactie te vragen.",
                        "de": "Leitet eine Frage ein oder fordert den Gesprächspartner zu einer Reaktion auf.",
                        "pl": "Używane na początku zdania, aby wprowadzić pytanie lub zachęcić rozmówcę do reakcji.",
                        "it": "Si usa all'inizio di una frase per introdurre una domanda o sollecitare una reazione.",
                        "cs": "Používá se na začátku věty k uvedení otázky nebo k vyzvání k reakci.",
                        "tr": "Cümle başında soru başlatmak ya da karşı tarafın bir tepki vermesini istemek için kullanılır.",
                        "es": "Se usa al principio de una frase para introducir una pregunta o pedir una reacción al interlocutor.",
                        "zh": "用在句首，引出一个问题或请对方作出回应。"
                    },
