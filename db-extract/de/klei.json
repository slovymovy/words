                        ],
                        "form": "den Klei"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68cfec93-e0a9-3bf7-b374-7df0bb2026ad",
                        "entry_id": "f629aaab-18bd-3878-b048-845b47777513",
                        "glosses": [
                            "norddeutsch, auch Bodenkunde: der schwere, lehmige, fette, bindige Boden der Marsch"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "480102bc-611e-40da-862c-0d06ecf3a006",
                                "sense_id": "68cfec93-e0a9-3bf7-b374-7df0bb2026ad",
                                "text": "„Klei, der lehmähnliche Schlickboden an der Küste, bildet den Deichmantel, der Sand ist der Deichkern.“"
                            },
                            {
                                "example_id": "9a56ed24-9190-46b8-84cd-4b05fb4e664b",
                                "sense_id": "68cfec93-e0a9-3bf7-b374-7df0bb2026ad",
                                "text": "„Östlich von Soest liegt der Bad Sassendorfer Ortsteil Enkesen, dem man zur Unterscheidung den Zusatz 'im Klei' gab. Und jener fette, aber nicht sehr tief reichende Tonboden, eben der Klei, ist schon seit Jahrhunderten charakteristisch für diese Landschaft.“"
                            },
                            {
                                "example_id": "60b4f115-0041-413d-8c44-a3dd4d728c3f",
                                "sense_id": "68cfec93-e0a9-3bf7-b374-7df0bb2026ad",
                                "text": "„Der Klei, der für die Deicherhöhung benötigt wird, werde aus Heinitzpolder angefahren, sagt Berends […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
