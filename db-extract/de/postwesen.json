                "senses": [
                    {
                        "sense_id": "757d5b39-c5e2-35d6-9333-b73d53247fa8",
                        "entry_id": "6d4032bf-ae64-3616-913a-b87959353a27",
                        "glosses": [
                            "Gesamtheit der Aktivitäten und Einrichtungen, die für die Bewältigung der Dienstleistungen der Post eingesetzt werden oder sich daraus ergeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f27a47-09d3-445a-9e3d-f885582b87e2",
                                "sense_id": "757d5b39-c5e2-35d6-9333-b73d53247fa8",
                                "text": "„Ihre Bedeutung für den Nachrichtenaustausch ist immens - selbst das moderne Postwesen greift noch immer auf sie zurück.“"
                            },
                            {
                                "example_id": "9ac54d0c-7a24-4029-be0f-55e04c9f4998",
                                "sense_id": "757d5b39-c5e2-35d6-9333-b73d53247fa8",
                                "text": "„Eine wichtige Rolle für die Verwaltung eines Staates, der in seiner längsten Ausdehnung fast 1000 Kilometer mißt, spielt das Postwesen.“"
                            },
                            {
                                "example_id": "69ede0cb-a67c-4bab-b494-abed005bb58c",
                                "sense_id": "757d5b39-c5e2-35d6-9333-b73d53247fa8",
                                "text": "„Amerika verfügte bereits ab 1800 über ein hervorragendes, vom Kongress vorangetriebenes Postwesen, so dass selbst in den hintersten Winkeln des Landes Zeitungen und Zeitschriften gelesen wurden.“"
                            },
                            {
                                "example_id": "7bd50d89-9193-4ac2-b1f1-5d94bb15669a",
                                "sense_id": "757d5b39-c5e2-35d6-9333-b73d53247fa8",
                                "text": "„Wir wollen aus diesem Anlass eine Zeitreise durch die Entwicklung des Postwesen bis zur Einigung des Landes unternehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
