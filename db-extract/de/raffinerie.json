                "senses": [
                    {
                        "sense_id": "5813c800-67bb-333d-975f-32b314e41b08",
                        "entry_id": "f0f36536-9c12-33b6-8eca-d7ee77586226",
                        "glosses": [
                            "industrielle Anlage zur Verarbeitung von Rohstoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30460707-d878-4abb-b5c6-100a35a9ff45",
                                "sense_id": "5813c800-67bb-333d-975f-32b314e41b08",
                                "text": "Die Raffinerie bekommt in den nächsten Wochen zwei Anbauten."
                            },
                            {
                                "example_id": "0e20d56f-ab84-4dd7-a019-63ff12305deb",
                                "sense_id": "5813c800-67bb-333d-975f-32b314e41b08",
                                "text": "„Die ersten Raffinerien entstanden schon zum Beginn der Mineralöl-Ära, also Mitte des 19. Jahrhunderts.“"
                            },
                            {
                                "example_id": "b557c681-3ff8-48e2-8276-2acc5dc0c219",
                                "sense_id": "5813c800-67bb-333d-975f-32b314e41b08",
                                "text": "„Kaum war das Hafengebiet mit den vielen Autoabgasen, dem Fabriksmog und den zahlreichen Motorrädern überstanden, kam ich an dem Gelände einer riesigen Raffinerie vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3db0b9eb-cc20-4d87-ae3c-24c2c85961c7",
                        "source_entry_id": "f0f36536-9c12-33b6-8eca-d7ee77586226",
                        "source_sense_id": "5813c800-67bb-333d-975f-32b314e41b08",
                        "source_sense_description": "industrielle Anlage zur Verarbeitung von Rohstoffen",
                        "target_lang_word": "炼油厂",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "09ba8634-1187-45b4-9baf-5d6beee55739",
                        "source_entry_id": "f0f36536-9c12-33b6-8eca-d7ee77586226",
                        "source_sense_id": "5813c800-67bb-333d-975f-32b314e41b08",
                        "source_sense_description": "industrielle Anlage zur Verarbeitung von Rohstoffen",
                        "target_lang_word": "refinery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refinery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d40216f-1825-3ffa-af5a-5fcafeb16e26",
                                        "entry_id": "566be6c2-6dfb-3b32-b462-4d6bf0cbf109",
                                        "glosses": [
                                            "A building, or a mass of machinery, used to produce refined products such as sugar, oil, or metals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b702847-85b4-4e11-838e-b67c54cedecb",
                                                "sense_id": "8d40216f-1825-3ffa-af5a-5fcafeb16e26",
                                                "text": "An oil field was discovered at Karamai in 1955, the first of a number to be found in Dzungaria. This oil find has greatly helped China’s industrial development, and the oil fields are now linked to Lanchow by pipeline and by rail. Large refineries have been built at Lanchow and at Tushantzu in Dzungaria."
                                            },
                                            {
                                                "example_id": "61142e3e-f502-45ed-9f76-62299a56c46e",
                                                "sense_id": "8d40216f-1825-3ffa-af5a-5fcafeb16e26",
                                                "text": "Pipeable products may be moved from refinery centers to demand zones by truck, barge, intercoastal tanker or pipeline."
                                            },
                                            {
                                                "example_id": "282e2d2c-5900-493b-8db1-9e402b1dcdf4",
                                                "sense_id": "8d40216f-1825-3ffa-af5a-5fcafeb16e26",
                                                "text": "On orders from Beijing, state-controlled enterprises have dismantled Baotou refineries and rebuilt them at an enormous mining complex at Bayan Obo in the Gobi Desert, which mines about half the world’s rare earths."
                                            },
                                            {
                                                "example_id": "7d69876e-89c5-4a9a-aeb1-0201fdfb84d0",
                                                "sense_id": "8d40216f-1825-3ffa-af5a-5fcafeb16e26",
                                                "text": "Hsu’s division is responsible for CPC’s two main facilities, the oil refinery in Kaohsiung’s Siaogang District (小港) and the refinery in Taoyuan’s Gueishan District (龜山), which together process 600,000 barrels of crude oil per day, a report released last year by CPC said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89a80cd2-8d6e-49ec-a4ed-7dc84db00587",
                        "source_entry_id": "f0f36536-9c12-33b6-8eca-d7ee77586226",
                        "source_sense_id": "5813c800-67bb-333d-975f-32b314e41b08",
                        "source_sense_description": "industrielle Anlage zur Verarbeitung von Rohstoffen",
                        "target_lang_word": "raffinerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raffinerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f7a533a-8d1d-3eea-a2ec-9e26728a9d13",
                                        "entry_id": "d2c46b25-d9aa-3180-81e4-3bf8b397bf5c",
                                        "glosses": [
                                            "Usine où l’on raffine certaines substances."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e39bf93a-3215-4e86-a3d2-58b2a617eace",
                                                "sense_id": "2f7a533a-8d1d-3eea-a2ec-9e26728a9d13",
                                                "text": "Avant les raffineries, on peut citer les mouvements à Carrefour, Sephora, dans le secteur aérien…"
                                            },
                                            {
                                                "example_id": "6e77e988-9006-4256-949d-427397bbcd4d",
                                                "sense_id": "2f7a533a-8d1d-3eea-a2ec-9e26728a9d13",
                                                "text": "En début d’année, on apportait à la raffinerie la récolte de canne à sucre des mois précédents. Une odeur très forte se dégageait des tiges écrasées puis brûlées. C’était pour le sucre que les Français avaient investi l’île ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03a9e97e-e5a5-331b-be0c-abb9b8abd185",
                                        "entry_id": "d2c46b25-d9aa-3180-81e4-3bf8b397bf5c",
                                        "glosses": [
                                            "Profession ou métier des raffineurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
