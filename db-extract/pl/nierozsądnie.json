                                "target_senses": [
                                    {
                                        "sense_id": "40c856d8-7175-36b9-b068-d87bb1e99756",
                                        "entry_id": "fdac779d-157a-39e8-9f6b-f2b6d4e53ad7",
                                        "glosses": [
                                            "In an unwise manner; foolishly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "335eea1f-ca82-41bd-943d-5b060ef2387f",
                                                "sense_id": "40c856d8-7175-36b9-b068-d87bb1e99756",
                                                "text": "The scope of the new upgrade isn't just restricted to the station and junction. It has involved more than simply putting back what was unwisely taken away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3957d2cd-bcc9-4c62-8a8b-e1dc63c13ff7",
                        "source_entry_id": "a4bd7319-031b-3f5b-8f26-b922a69a5442",
                        "source_sense_id": "d5c2307b-4640-3a21-898d-308f949c9ddc",
