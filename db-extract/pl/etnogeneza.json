                        "translation_id": "853a0bb7-b0e1-4399-bc7b-aa5348fd2405",
                        "source_entry_id": "0e6f24ac-7487-3fc7-9b48-283244c03662",
                        "source_sense_id": "eb2e3c05-7a29-3a10-a8c0-830611b6ce17",
                        "target_lang_word": "этногенез",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "этногенез",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cc74d7a5-19a2-33cf-a450-55cdba86b987",
                                        "entry_id": "a0139260-98f4-3757-b9b8-4acb4d88fb17",
                                        "glosses": [
                                            "этнолог. процесс формирования этнической общности (этноса)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e88d7ee5-bbbc-4bb9-a943-a9e7954ba1f0",
                                                "sense_id": "cc74d7a5-19a2-33cf-a450-55cdba86b987",
                                                "text": "― Вывод, по-моему, тот, что в этногенезе, как и вообще в истории, надо искать то, что действительно было, и не то, что мы хотели бы видеть."
                                            },
                                            {
                                                "example_id": "f092f66b-9f00-4478-b9de-3c926be4bf01",
                                                "sense_id": "cc74d7a5-19a2-33cf-a450-55cdba86b987",
                                                "text": "Большой вклад в изучение славянского этногенеза внесло языкознание."
                                            },
                                            {
                                                "example_id": "d34b1576-d029-4b34-bd4d-dea0397b9b8d",
                                                "sense_id": "cc74d7a5-19a2-33cf-a450-55cdba86b987",
                                                "text": "❬…❭ Не знаю, в курсе ли Вы пассионарной теории этногенеза (происхождения и развития народов) Льва Гумилёва? Главный труд его — «Этногенез и биосфера земли»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
