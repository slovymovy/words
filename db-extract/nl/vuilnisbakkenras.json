                        "examples": [
                            {
                                "example_id": "332da7d4-f97b-4f67-91d5-32363f297bbd",
                                "sense_id": "c29214be-e9d0-353e-89d0-56f84a17f2a6",
                                "text": "Ik vertelde trots over de afkomst van mijn zoon. Oh, zei de verpleegkundige, een vuilnisbakkenras dus."
                            },
                            {
                                "example_id": "89aae1dc-6e59-4ff3-8f74-49cdf97b8bd5",
                                "sense_id": "c29214be-e9d0-353e-89d0-56f84a17f2a6",
                                "text": "Uit onvrede over de hondenfokkerij kruiste dierenarts Steef Somers vijf jaar geleden twee gezonde honden met elkaar: een kruising poedel/golden retriever en een kruising Australische herdershond/border collie. Hier kwam de 'premium bastaard' uit, een vuilnisbakkenras als middel tegen inteelt bij rashonden."
                            }
                        ]
                    }
