                    {
                        "sense_id": "dcf5774c-8679-340f-82ea-cbc1b8ac7aca",
                        "entry_id": "e722cb2c-11a9-3939-951c-6e299b0db2ab",
                        "glosses": [
                            "Sorte de résine poudreuse, jaunâtre, amère et odorante qui est fixée sur les bractées des inflorescences femelles du houblon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c58c80b-3822-4526-b7ad-8b2277b002bd",
                                "sense_id": "dcf5774c-8679-340f-82ea-cbc1b8ac7aca",
                                "text": "M. Personne qui, particulièrement aux points de vue chimique et pharmaceutique, a fait une étude très-approfondie du lupulin, conseille, pour extraire cette matière des cônes du houblon, défroisser les cônes entiers sur un tamis de crin."
                            },
                            {
                                "example_id": "707e6758-13e1-46f8-b326-91b676a1d5eb",
                                "sense_id": "dcf5774c-8679-340f-82ea-cbc1b8ac7aca",
                                "text": "Le lupulin fut prescrit, concurremment avec la digitaline et quelques autres moyens appropriés aux circonstances."
                            }
                        ]
                    },
                    {
                        "sense_id": "a00b965b-609a-33f0-bfc1-284e73798554",
