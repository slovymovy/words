                        "glosses": [
                            "Qui a rapport à la mesure de l’intensité des couleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb09f47-226b-4698-83c6-a2aef233a2dc",
                                "sense_id": "f66ac20f-7d4b-3c50-ba19-3fd44fa7a9e0",
                                "text": "Le précipité étant trop faible pour être pesé, sa teneur en cuivre a été déterminée à l’aide d’une méthode colorimétrique."
                            },
                            {
                                "example_id": "03b0d437-4dd7-4d0c-b183-470409dbed1f",
                                "sense_id": "f66ac20f-7d4b-3c50-ba19-3fd44fa7a9e0",
                                "text": "Les enzymes utilisées dans le conjugué sont principalement la HRP (horse radish peroxidase) pour une révélation chimioluminescente ou la PAL (phosphatase alcaline) pour une révélation colorimétrique."
                            }
                        ]
                    }
