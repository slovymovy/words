    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1d4c802c-1bec-32c7-b691-d7b20e8e516d",
                "word": "faubourg",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6f2b278a-05fa-476f-861b-9e4a4f732b65",
                        "entry_id": "1d4c802c-1bec-32c7-b691-d7b20e8e516d",
                        "tags": [
                            "plural"
                        ],
                        "form": "faubourgs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0d2515b-774f-3428-8f9a-9816e90e1097",
                        "entry_id": "1d4c802c-1bec-32c7-b691-d7b20e8e516d",
                        "glosses": [
                            "An outlying part of a city or town, beyond the walls; a suburb, especially of Paris, New Orleans, Montreal, or Quebec City."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "500e371f-3565-40be-ac51-79cfbef811a3",
                                "sense_id": "c0d2515b-774f-3428-8f9a-9816e90e1097",
                                "text": "At last a great shout went up ... and that was sign sufficient that the faubourgs were ours."
                            },
                            {
                                "example_id": "90f6857f-6345-4101-a1ee-6f7edff4220a",
                                "sense_id": "c0d2515b-774f-3428-8f9a-9816e90e1097",
                                "text": "[…]in the course of his walk (which led him out toward the faubourgs of Flatbush) he passed long vistas of signboards[…]"
                            },
                            {
                                "example_id": "18562813-fc5b-4ce8-9d87-dc5640e9144b",
                                "sense_id": "c0d2515b-774f-3428-8f9a-9816e90e1097",
                                "text": "By the time that I was quite clear of the city's unlovely faubourgs and purlieus I needed petrol: the Silver Ghost is a lovely car but its best friend would have to admit that its m.'s per g. are few."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "feffd023-219f-4c5a-9c63-0e155fb5f72b",
                        "source_entry_id": "1d4c802c-1bec-32c7-b691-d7b20e8e516d",
                        "source_sense_id": "c0d2515b-774f-3428-8f9a-9816e90e1097",
                        "source_sense_description": "an outlying part of a city or town",
                        "target_lang_word": "faubourg",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faubourg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb54d8dd-edbd-365b-be19-70c639cf45cb",
                                        "entry_id": "bc7ff315-72ec-3fee-afb9-cb6b06d514dd",
                                        "glosses": [
                                            "Partie d’une ville qui est au-delà de ses portes et de son enceinte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4399e9e-ab33-4a93-ac8a-aa16f9f3d048",
                                                "sense_id": "eb54d8dd-edbd-365b-be19-70c639cf45cb",
                                                "text": "Les défenseurs, après avoir perdu les faubourgs, manquant d’eau, furent obligés de capituler."
                                            },
                                            {
                                                "example_id": "144c9616-967e-4b51-ad30-dc14c5cc77da",
                                                "sense_id": "eb54d8dd-edbd-365b-be19-70c639cf45cb",
                                                "text": "Mais nous sommes déjà dans les faubourgs. Les maisons s'espacent, se reculent, s'adossent à la rivière ou à la montagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                                        "entry_id": "bc7ff315-72ec-3fee-afb9-cb6b06d514dd",
                                        "glosses": [
                                            "Quartier d’une ville qui était anciennement un faubourg."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0576f974-9f75-4e73-a546-07e1f9c8cc69",
                                                "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                                                "text": "Les gens du faubourg Saint-Antoine n’appellent jamais autrement ce quartier célèbre que le faubourg. C’est pour eux le faubourg par excellence, le souverain faubourg, et les fabricants eux-mêmes entendent par ce mot spécialement le faubourg Saint-Antoine."
                                            },
                                            {
                                                "example_id": "352f2f70-bc1c-4fa9-b3f4-45668d307cfa",
                                                "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                                                "text": "Or nous avions fini, tout en conversant, par arriver faubourg du Temple, où des filles, à l'entrée du passage, racolaient."
                                            },
                                            {
                                                "example_id": "d4fbdc00-cae6-436e-9d95-edf16cc4d59e",
                                                "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                                                "text": "Aux terrasses des brasseries, échelonnées du faubourg Montmartre, à la rue Drouot, de larges gouttes s'écrasaient sur le sol."
                                            },
                                            {
                                                "example_id": "9789645b-f873-424e-90c9-f2b51a8d0ca3",
                                                "sense_id": "b97bec60-608f-3d7f-955a-7b4584b22040",
                                                "text": "D'un côté l'arôme familial d'un arabica feutré, de l'autre le remugle oppressant du graillon des faubourgs de Birmingham.\nD'un côté le bon goût français, de l'autre l’empiffrerie britannique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6eb5c11-e9ed-3735-bfed-b5e109135243",
                                        "entry_id": "bc7ff315-72ec-3fee-afb9-cb6b06d514dd",
                                        "glosses": [
                                            "Ensemble des habitants d'un de ces lieux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82d0a3e-849e-44f3-8b33-fb21d60925c4",
                                                "sense_id": "b6eb5c11-e9ed-3735-bfed-b5e109135243",
                                                "text": "On a entendu le tambour , au son duquel on a vu entrer une partie nombreuse du faubourg Montmartre , portant le buste de Désilles, entouré de drapeaux et de lauriers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a6017b3-fa12-41ff-8fea-d4f7558ad58e",
                        "source_entry_id": "1d4c802c-1bec-32c7-b691-d7b20e8e516d",
