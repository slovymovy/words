                ],
                "senses": [
                    {
                        "sense_id": "b5363371-978a-3f6f-a3b4-197782bcec41",
                        "entry_id": "e8c4a26e-8146-3831-ab0a-ba21ba37d479",
                        "glosses": [
                            "jemand, der aus der Stadt Karl-Marx-Stadt stammt oder in Karl-Marx-Stadt wohnt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "32612b97-cc09-4c6d-a977-c3660d13cf59",
                                "sense_id": "b5363371-978a-3f6f-a3b4-197782bcec41",
                                "text": "„Das sportliche Ziel der Karl-Marx-Städter kann dabei nur lauten: Kontinuität zeigen und weiter nach oben mit Gerd Schädlich.“"
                            },
                            {
                                "example_id": "13070a35-b97b-4779-af39-24b9e7e30a3c",
                                "sense_id": "b5363371-978a-3f6f-a3b4-197782bcec41",
                                "text": "„Außerdem ist vorgesehen, daß die jüngsten Karl-Marx-Städter in den Kinderkrippen und -gärten von sechs bis 18 Uhr betreut werden.“"
                            },
                            {
                                "example_id": "f32cb719-2cb4-400b-94d4-52ca6d6b3a11",
                                "sense_id": "b5363371-978a-3f6f-a3b4-197782bcec41",
                                "text": "„Die Staatsanwaltschaft hält den gebürtigen Karl-Marx-Städter für den Drahtzieher eines gut funktionierenden Drogenrings.“"
                            },
                            {
                                "example_id": "366bfef2-258f-4700-9c60-bc8752de4148",
                                "sense_id": "b5363371-978a-3f6f-a3b4-197782bcec41",
                                "text": "„Die Karl-Marx-Städter wollen wieder Chemnitzer sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f82f6980-4ace-3559-b990-56cb3ab74b6e",
