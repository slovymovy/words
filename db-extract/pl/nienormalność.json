                    {
                        "translation_id": "3435b923-e7bf-4348-9def-bd45843d9e2e",
                        "source_entry_id": "e6ff11ce-a3e2-3d01-bdb9-70d2a300649c",
                        "source_sense_id": "4a990ef5-ba49-3031-b0ae-9dc9805d5397",
                        "target_lang_word": "abnormality",
