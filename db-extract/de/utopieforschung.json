                "senses": [
                    {
                        "sense_id": "c06829cf-9d29-3c1a-aad3-910f7152e205",
                        "entry_id": "f65e4ba0-4350-37f2-8bd5-ac80c33aef13",
                        "glosses": [
                            "Fachrichtung, die sich utopischen Vorstellungen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b1d9d6-514a-45d0-88d7-ea6f19be8624",
                                "sense_id": "c06829cf-9d29-3c1a-aad3-910f7152e205",
                                "text": "„Insbesondere in der historischen Utopieforschung wird Utopia als neue literarische Gattung und ‚epochale[r] Einschnitt‘ gewertet.“"
                            },
                            {
                                "example_id": "78882de8-a873-49ff-8f0b-3a9e7e52ad62",
                                "sense_id": "c06829cf-9d29-3c1a-aad3-910f7152e205",
                                "text": "„Im Zentrum der neueren Utopieforschung steht im Gegensatz zur historischen Lesart der Utopie eine funktionale.“"
                            },
                            {
                                "example_id": "32b840ab-d1c3-4209-8593-59ccb4caab71",
                                "sense_id": "c06829cf-9d29-3c1a-aad3-910f7152e205",
                                "text": "„In der Utopieforschung scheint es mittlerweile zu einem Brauch geworden zu sein, die verwirrende Vielfalt unterschiedlicher Definitionen des Begriffs zu beklagen.“"
                            },
                            {
                                "example_id": "6ed008b8-5e45-43e6-8584-df0d28c8cddf",
                                "sense_id": "c06829cf-9d29-3c1a-aad3-910f7152e205",
                                "text": "„Ich versuche in dieser Arbeit einen Themenkomplex zu behandeln, der in der modernen Utopieforschung bisher leider größtenteils außen vor gelassen wurde.“"
                            },
                            {
                                "example_id": "f19cb364-d483-4300-8b12-9819c30875f5",
                                "sense_id": "c06829cf-9d29-3c1a-aad3-910f7152e205",
                                "text": "„Die Utopieforschung steht sich mit Utopien befassend nicht selten vor dem Problem der Formulierung eines konsistenten Utopiebegriffs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
