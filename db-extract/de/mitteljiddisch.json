                "senses": [
                    {
                        "sense_id": "fbe5f8fb-3a42-35f3-afd7-f17ef5734dca",
                        "entry_id": "46faaf05-ed03-3234-8066-0daca2e7b116",
                        "glosses": [
                            "Jiddisch vom 16. bis Mitte des 18. Jahrhunderts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "019c32ea-7217-4d6f-85ac-fad268e1e542",
                                "sense_id": "fbe5f8fb-3a42-35f3-afd7-f17ef5734dca",
                                "text": "„Es werden drei Perioden der jiddischen Sprach- und Literaturgeschichte unterschieden: Altjiddisch (12.Jh. - 1500), Mitteljiddisch (1500 - 1750), Neujiddisch (seit 1750).“"
                            },
                            {
                                "example_id": "112b0306-f565-4c96-9093-b3a496b94fd9",
                                "sense_id": "fbe5f8fb-3a42-35f3-afd7-f17ef5734dca",
                                "text": "„Ebenso neueren Ursprungs ist die chronologische Unterteilung Urjiddisch (bis 1250), Altjiddisch (bis 1500), Mitteljiddisch (bis 1750) und Neujiddisch (seit 1750).“"
                            },
                            {
                                "example_id": "62080830-7923-4dd4-9885-ba9b8c38d629",
                                "sense_id": "fbe5f8fb-3a42-35f3-afd7-f17ef5734dca",
                                "text": "„Die Sprachstufen Alt- und Mitteljiddisch fassen wir der Kürze halber unter dem Begriff Älteres Jiddisch zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
