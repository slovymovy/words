                "senses": [
                    {
                        "sense_id": "92e9a57c-4fcc-33c0-9c37-b6579b8a4fef",
                        "entry_id": "7c896fdf-1daa-3ca7-8790-b045f8eb205f",
                        "glosses": [
                            "Habitant de la Champagne (région française)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07d0ada1-e796-47da-82f7-3003d77b9de1",
                                "sense_id": "92e9a57c-4fcc-33c0-9c37-b6579b8a4fef",
                                "text": "En bon Champenois, il célébra le vin de Champagne dans une ode en vers iambiques, dont le style vif et pétillant, présente la belle image de cette charmante liqueur."
                            },
                            {
                                "example_id": "b572325d-b9c2-4d74-b8d1-aff035fe0901",
                                "sense_id": "92e9a57c-4fcc-33c0-9c37-b6579b8a4fef",
                                "text": "Il y avait Élise, le père Louia, ce vieux Champenois calme et obstiné qui à lui seul s'occupait davantage des sidéens que toutes les organisations humanitaires du pays, et Valcourt."
                            },
                            {
                                "example_id": "037773b0-e479-4650-88b5-d8174a1777da",
                                "sense_id": "92e9a57c-4fcc-33c0-9c37-b6579b8a4fef",
                                "text": "Les Champenois deviennent non pas pétillants comme leur vin, mais pétulants, le stade supérieur."
                            }
                        ]
                    },
