                                "target_senses": [
                                    {
                                        "sense_id": "e1ed6d31-2bf2-3197-bc57-180a4742bab5",
                                        "entry_id": "6a74ea72-f453-3501-a370-ea59b09ab5f0",
                                        "glosses": [
                                            "A highly radioactive chemical element (symbol At), one of the halogens, with atomic number 85."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b75b130e-9279-4606-8ab0-b9af61142d30",
                                                "sense_id": "e1ed6d31-2bf2-3197-bc57-180a4742bab5",
                                                "text": "Astatine, for instance, is practically unstudied. It has a name and a place on the periodic table (next to Marie Curie's polonium), but almost nothing else."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
