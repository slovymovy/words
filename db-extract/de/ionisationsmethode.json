                "senses": [
                    {
                        "sense_id": "6f7dae8d-9afa-38a0-af9a-066faa00c9a5",
                        "entry_id": "d23b1ed7-8fe6-3d2b-a819-eb336bf5077e",
                        "glosses": [
                            "Art und Weise, wie man etwas ionisiert, um ein bestimmtes Ziel zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "114c5ce9-f9ea-4d48-b565-ba3e24fd3445",
                                "sense_id": "6f7dae8d-9afa-38a0-af9a-066faa00c9a5",
                                "text": "„Für alle diese Anforderungen von Stein und Metall über Gase bis hin zu Biomolekülen hat man in der Massenspektrometrie passende Ionisationsmethoden zur Hand.“"
                            },
                            {
                                "example_id": "c8622bd3-cc4e-4b31-8770-f25597f6fcf3",
                                "sense_id": "6f7dae8d-9afa-38a0-af9a-066faa00c9a5",
                                "text": "„Nicht jede Verbindung ist für jede Ionisationsmethode geeignet.“"
                            },
                            {
                                "example_id": "89a1b93d-e985-4bcc-985f-06858bb2603f",
                                "sense_id": "6f7dae8d-9afa-38a0-af9a-066faa00c9a5",
                                "text": "„Nicht jeder Analyt ist für jede Ionisationsmethode geeignet. Ferner ist nicht jede Ionisationsmethode an allen Geräten verfügbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
