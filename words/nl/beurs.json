                },
                {
                    "sense_id": "23e6e176-a532-33a8-8355-ccbc1429ccf6",
                    "sense_definition": "Een groot evenement waar bedrijven hun producten of diensten presenteren aan publiek of andere bedrijven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exhibition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij bezoeken morgen een grote <w>beurs</w> voor nieuwe auto's.",
                            "target_lang_translations": {
                                "ru": "Завтра мы посетим большую <w>выставку</w> новых автомобилей.",
                                "en": "We are visiting a large car <w>fair</w> tomorrow."
                            }
                        },
                        {
                            "text": "Veel bedrijven willen op de <w>beurs</w> staan om nieuwe klanten te vinden.",
                            "target_lang_translations": {
                                "ru": "Многие компании хотят участвовать в <w>выставке</w>, чтобы найти новых клиентов.",
                                "en": "Many companies want to have a stand at the <w>trade show</w> to find new customers."
                            }
                        }
