    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "acde756e-2a65-30f9-93ae-0086a7728d6d",
                    "sense_definition": "A growth of facial hair between the nose and the upper lip.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "facial_hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to grow a thick <w>moustache</w> over the winter.",
                            "target_lang_translations": {
                                "ru": "За зиму он решил отрастить густые <w>усы</w>."
                            }
                        },
                        {
                            "text": "The detective was easily recognized by his famous curled <w>moustache</w>.",
                            "target_lang_translations": {
                                "ru": "Детектива легко узнавали по его знаменитым подкрученным <w>усам</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mustache"
                    ],
                    "common_phrases": [
                        "grow a moustache",
                        "thick moustache",
                        "curled moustache"
                    ],
                    "target_lang_definitions": {
                        "ru": "Волосы, растущие на лице между носом и верхней губой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усы",
                                "target_lang_sense_clarification": "волосы над верхней губой у человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a466d1d-5095-3106-9a95-f20457ff0b36",
                    "sense_definition": "A curly bracket, { or }.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "punctuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In programming, you must close every open <w>moustache</w> to avoid syntax errors.",
                            "target_lang_translations": {
                                "ru": "В программировании необходимо закрывать каждую открытую <w>фигурную скобку</w>, чтобы избежать синтаксических ошибок."
                            }
                        },
                        {
                            "text": "The template engine uses double <w>moustaches</w> to bind data to the HTML.",
                            "target_lang_translations": {
                                "ru": "Шаблонизатор использует двойные <w>фигурные скобки</w> для привязки данных к HTML."
                            }
                        }
                    ],
                    "synonyms": [
                        "brace",
                        "curly bracket",
                        "curly brace"
                    ],
                    "common_phrases": [
                        "double moustache"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally in programming and typography contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фигурная скобка, { или }."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фигурная скобка",
                                "target_lang_sense_clarification": "знак пунктуации или символ в программировании"
                            },
                            {
                                "target_lang_word": "усы",
                                "target_lang_sense_clarification": "разговорное название фигурных скобок в программировании"
                            }
                        ]
                    }
                }
            ]
        }
    ]
