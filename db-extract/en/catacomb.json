                    {
                        "translation_id": "f9e72af1-3882-4009-9443-0579996d4b8e",
                        "source_entry_id": "99160a54-35b7-3bd4-9ccb-6ac7c11de650",
                        "source_sense_id": "1d26fb79-14d1-36d5-9616-6c0eb828a345",
