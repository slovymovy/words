                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1dc50c7-9532-3c39-8e22-b56ef0fd3459",
                                        "entry_id": "e7ae0d90-7efc-31d8-a621-dc3a1fcde7e4",
                                        "glosses": [
                                            "Entscheidung zwischen zwei oder mehreren Möglichkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "689b10c9-b460-4fe8-83ca-5b4c897d4dea",
                                                "sense_id": "a1dc50c7-9532-3c39-8e22-b56ef0fd3459",
                                                "text": "Heute habe ich die Wahl: Spaghetti oder Pommes?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9be3b59-cb44-3c78-b19c-5ed6924125ad",
                                        "entry_id": "e7ae0d90-7efc-31d8-a621-dc3a1fcde7e4",
                                        "glosses": [
                                            "das Abstimmen darüber, wer bestimmte Ämter oder Gremien besetzen beziehungsweise ausüben darf, auch über einzelne Sachthemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd037207-d69c-4df9-b40e-63bc151fc188",
                                                "sense_id": "c9be3b59-cb44-3c78-b19c-5ed6924125ad",
                                                "text": "Wir hielten heute in der Schule eine Wahl zum Amt des Klassensprechers ab."
                                            },
                                            {
                                                "example_id": "f1f69f1e-5111-4bd7-a01b-fd40b9e6b80f",
                                                "sense_id": "c9be3b59-cb44-3c78-b19c-5ed6924125ad",
                                                "text": "Bei der Wahl 2002 siegte die SPD, gefolgt von der CDU."
                                            },
                                            {
                                                "example_id": "4563300b-da6f-45f3-a1e0-7d972d0e429d",
                                                "sense_id": "c9be3b59-cb44-3c78-b19c-5ed6924125ad",
                                                "text": "[4. Novmber 2024:] „Den Tag vor der Wahl verbringt Vizepräsidentin Harris (60) komplett im Swing State Pennsylvania, der zu den wenigen besonders umkämpften Bundesstaaten gehört, die mal die eine, mal die andere Partei bevorzugen.“"
                                            },
                                            {
                                                "example_id": "fa779703-9eb8-4707-a447-d50cd27eff27",
                                                "sense_id": "c9be3b59-cb44-3c78-b19c-5ed6924125ad",
                                                "text": "„Im Frühling 1921 fanden drei Wahlen zur Mationalversammlung des Freistaats statt.“"
                                            },
                                            {
                                                "example_id": "d55bdf80-80a6-47c9-bbe9-5d255aa1b003",
                                                "sense_id": "c9be3b59-cb44-3c78-b19c-5ed6924125ad",
                                                "text": "„Um zwei Uhr sollte die Wahl beginnen, und die bis jetzt anwesenden Farmer und Jäger, die in dem kleinen Häuschen, in dem der Tisch mit den Schreibmaterialien stand, und um dasselbe versammelt waren, vertrieben sich die Zeit nach besten Kräften.“"
                                            },
                                            {
                                                "example_id": "9fa2ce71-5d63-43ca-a196-46e8ebb73a1a",
                                                "sense_id": "c9be3b59-cb44-3c78-b19c-5ed6924125ad",
                                                "text": "„Die Wahl des evangelischen Bürgermeisters stand an, und Wieland geriet mitten in die Kontroversen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c533321-cf92-34cb-8d07-393a5b064df0",
                                        "entry_id": "e7ae0d90-7efc-31d8-a621-dc3a1fcde7e4",
                                        "glosses": [
                                            "eine Qualitätsstufe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bd2ff28-e28f-4343-a837-87e7110c52e3",
                                                "sense_id": "9c533321-cf92-34cb-8d07-393a5b064df0",
                                                "text": "Die Weintrauben sind erste Wahl."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8921f195-4c0b-3c49-bfae-9e2c0544a661",
                                        "entry_id": "08afdd54-baf2-3452-84f4-7a8e6d920e38",
                                        "glosses": [
