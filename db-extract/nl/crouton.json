                    {
                        "translation_id": "eac8cf84-b296-41dc-a8c3-c0ee5089fe06",
                        "source_entry_id": "91c58bab-391c-3db3-b636-29ee5fb36447",
                        "source_sense_id": "36cbb9bd-23c2-3c13-85e8-b3e75238e17d",
                        "target_lang_word": "croûton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croûton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83fe0227-326f-3957-9d49-7ba355ea998f",
                                        "entry_id": "67e9ebf7-1547-36a1-bc1f-e15a195c5c94",
                                        "glosses": [
                                            "Chacune des extrémités d’un pain long (aussi nommée quignon). Petit bout de pain dur. Morceau de pain sec, dur, rassis."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4735552d-901c-42e6-8d7e-660c545da924",
                                                "sense_id": "83fe0227-326f-3957-9d49-7ba355ea998f",
                                                "text": "Comudet, plongeant les deux mains en même temps dans les vastes poches de son paletot sac, tira de l’une quatre œufs durs et de l’autre le croûton d'un pain."
                                            },
                                            {
                                                "example_id": "23b89056-7c97-489c-99f3-3179de7cdfc4",
                                                "sense_id": "83fe0227-326f-3957-9d49-7ba355ea998f",
                                                "text": "Sur la table il y avait une cruche en terre qui était vide et un vieux croûton de pain tout sec. On ne trouva pas un kopeck ; il n’y avait pas même de linge pour le changer avant de l’enterrer, et quelqu’un donna une chemise."
                                            },
                                            {
                                                "example_id": "69339810-2578-4508-938c-7066a88fded9",
                                                "sense_id": "83fe0227-326f-3957-9d49-7ba355ea998f",
                                                "text": "Si Maurice, une heure auparavant, n’avait pas mangé son croûton de pain sous les obus, jamais il n’aurait trouvé la force de faire ce qu’il fit alors."
                                            },
                                            {
                                                "example_id": "bad6a3c7-29b8-4bec-a317-5df59a3876ea",
                                                "sense_id": "83fe0227-326f-3957-9d49-7ba355ea998f",
                                                "text": "Il me restait un vieux croûton, j’en pris la mie que je pétris avec un peu de gruyère et je lançai ma ligne à l’eau."
                                            },
                                            {
                                                "example_id": "5304b6c4-e121-4172-a1b3-d78e78bc1496",
                                                "sense_id": "83fe0227-326f-3957-9d49-7ba355ea998f",
                                                "text": "Comme ils arrivaient sous les arbres, la vieille sortit de son cabas un petit sac en papier empli de croûtons de pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9b86aa-4253-36a5-a3dc-a8e09a4a117e",
                                        "entry_id": "67e9ebf7-1547-36a1-bc1f-e15a195c5c94",
                                        "glosses": [
                                            "Petits morceaux de pain frits ou grillés qu’on met dans une omelette, dans une purée, ou qui servent à garnir des plats d’entrée ou d’entremets."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "689e8ec9-0a41-4a70-994b-be073e739f3c",
                                                "sense_id": "bf9b86aa-4253-36a5-a3dc-a8e09a4a117e",
                                                "text": "Omelette aux croûtons."
                                            },
                                            {
                                                "example_id": "ec08a290-87f9-4718-8cb2-c77829b3c2eb",
                                                "sense_id": "bf9b86aa-4253-36a5-a3dc-a8e09a4a117e",
                                                "text": "Mettre des croûtons sur des épinards."
                                            },
                                            {
                                                "example_id": "af92b35b-727d-4b42-9f02-e619aefaf029",
                                                "sense_id": "bf9b86aa-4253-36a5-a3dc-a8e09a4a117e",
                                                "text": "Emplissez le puits avec les truffes, saucez légèrement les filets, alternez-les chacun avec un croûton de pain coupé en crête, frit, glacé au pinceau."
                                            },
                                            {
                                                "example_id": "6375cf0c-1ca8-4a90-a338-0cd44a731ebc",
                                                "sense_id": "bf9b86aa-4253-36a5-a3dc-a8e09a4a117e",
                                                "text": "Note printanière à vos restes ? Accommodez vos croûtons au Ronron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379b93c8-6ab8-330f-a63a-c2f3e5c31721",
                                        "entry_id": "67e9ebf7-1547-36a1-bc1f-e15a195c5c94",
                                        "glosses": [
                                            "Petit résidu dur ou trop cuit d'une portion de frites s’accumulant au fond du contenant."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "448fee3c-64ad-4140-839a-f502c2f8c549",
                                                "sense_id": "379b93c8-6ab8-330f-a63a-c2f3e5c31721",
                                                "text": "N.B. : S'emploie généralement au pluriel (« les croûtons », « des croûtons »)."
                                            }
                                        ]
                                    }
                                ]
                            },
