                "senses": [
                    {
                        "sense_id": "6b398f63-7c4b-3f37-9bd9-d142b02609d2",
                        "entry_id": "3a22b655-b0b0-3f44-aa9e-a99e199b5cc2",
                        "glosses": [
                            "Landschaft an der Mosel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fbaf25-8c5b-49bc-b33b-77dff141a7cc",
                                "sense_id": "6b398f63-7c4b-3f37-9bd9-d142b02609d2",
                                "text": "„Eine Dampferfahrt von Trier bis Koblenz zeigt dem Fremden ebenso den anmutigen Liebreiz der Mosellandschaft mit Städten und Dörfern, Bergen und Burgen.“"
                            },
                            {
                                "example_id": "8d6b55ea-4e33-4d24-8c44-2cc9294e975b",
                                "sense_id": "6b398f63-7c4b-3f37-9bd9-d142b02609d2",
                                "text": "„Dafür hätten wir uns aber die Mosellandschaft nicht so genau angeschaut, und wir wären auch nicht in der Mosel schwimmen gegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
