                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a17436d6-2750-45e2-8be0-65db69dd2568",
                                "sense_id": "ba925259-add8-31d4-ab34-03d9e03015b7",
                                "text": "Depuis tout petit, maman m’achetait chaque samedi Le Petit Illustré parce que dedans il y avait les aventures de Bibi Fricotin, qu’elle adorait."
                            },
                            {
                                "example_id": "6fbbcb31-e760-4258-a729-cdf8caf68031",
                                "sense_id": "ba925259-add8-31d4-ab34-03d9e03015b7",
                                "text": "Bibi Fricotin est un jeune garçon débordant de vitalité."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "50a6bd9e-c2c0-3ab5-ab63-55400108467d",
                "word": "bibi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "049c34cb-c2a4-45a1-a636-b19e18a35b03",
                        "entry_id": "50a6bd9e-c2c0-3ab5-ab63-55400108467d",
                        "tags": [
