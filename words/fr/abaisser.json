            "senses": [
                {
                    "sense_id": "95006900-bb5c-375f-a17e-cc2feb76b246",
                    "sense_definition": "Mettre en position plus basse, faire descendre vers le bas.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur doit <w>abaisser</w> le pare-soleil pour éviter d'être ébloui par la lumière."
                        },
                        {
                            "text": "L'employé a oublié d'<w>abaisser</w> la barrière de sécurité avant le passage du train."
                        }
                    ],
                    "synonyms": [
                        "descendre",
                        "rabattre"
                    ],
                    "antonyms": [
                        "élever",
                        "hausser"
                    ],
                    "common_phrases": [
