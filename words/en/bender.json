    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f7e9bf8-3b95-3701-accf-4e4cbaf24f19",
                    "sense_definition": "A period or bout of heavy, continuous drinking or drug use.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire weekend on a <w>bender</w> with his old college friends.",
                            "target_lang_translations": {
                                "it": "Ha passato l'intero fine settimana a fare una <w>sbornia</w> con i suoi vecchi compagni di università."
                            }
                        },
                        {
                            "text": "After losing his job, he went on a week-long <w>bender</w> that worried his family.",
                            "target_lang_translations": {
                                "it": "Dopo aver perso il lavoro, è partito per una <w>sbronza</w> durata una settimana che ha preoccupato la sua famiglia."
                            }
                        }
                    ],
                    "synonyms": [
                        "binge",
                        "spree"
                    ],
                    "common_phrases": [
                        "on a bender",
                        "go on a bender"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in informal spoken contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Un periodo continuo di bevute smodate o uso di droghe; una sbronza prolungata."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sbornia",
                                "target_lang_sense_clarification": "bevuta eccessiva e prolungata"
                            },
                            {
                                "target_lang_word": "sbronza",
                                "target_lang_sense_clarification": "ubriacatura o baldoria alcolica prolungata"
                            },
                            {
                                "target_lang_word": "baldoria",
                                "target_lang_sense_clarification": "festa o periodo di eccessi alcolici"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc679903-a7b8-3932-8f4b-2dc1a3e8c6cd",
                    "sense_definition": "A tool or mechanical device designed to bend materials, such as pipes or conduit, to a desired angle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electrician reached into his toolbox to grab a pipe <w>bender</w>.",
                            "target_lang_translations": {
                                "it": "L'elettricista ha cercato nella cassetta degli attrezzi per prendere una <w>curvatubi</w>."
                            }
                        },
                        {
                            "text": "Using a conduit <w>bender</w> allows you to make precise curves without kinking the metal.",
                            "target_lang_translations": {
                                "it": "L'uso di una <w>curvatubi</w> per canaline consente di eseguire curve precise senza deformare il metallo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pipe bender",
                        "conduit bender"
                    ],
                    "target_lang_definitions": {
                        "it": "Attrezzo o macchina utilizzata per curvare o piegare materiali come tubi o lamiere."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "curvatubi",
                                "target_lang_sense_clarification": "attrezzo per piegare tubi"
                            },
                            {
                                "target_lang_word": "piegatrice",
                                "target_lang_sense_clarification": "macchina o attrezzo per curvare materiali"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f60b924e-a487-3ae0-ac5c-b51fbf830e0d",
                    "sense_definition": "A person or thing that bends.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal <w>bender</w> adjusted the heavy machinery before shaping the steel plates.",
                            "target_lang_translations": {
                                "it": "Il <w>piegatore</w> di metalli ha regolato il macchinario pesante prima di sagomare le lastre d'acciaio."
                            }
                        },
                        {
                            "text": "As a rule <w>bender</w>, he always looked for loopholes in the company policy.",
                            "target_lang_translations": {
                                "it": "Da abile <w>manipolatore</w> delle regole, cercava sempre scappatoie nelle politiche aziendali."
                            }
                        }
                    ],
                    "target_lang_definitions": {
