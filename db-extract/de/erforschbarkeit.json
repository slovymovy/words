                        "glosses": [
                            "Eigenschaft, dass sich etwas untersuchen, wissenschaftlich erforschen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd31ff1-1e01-412c-b5d0-15cdd81f782b",
                                "sense_id": "6dacc072-11f1-324c-baea-b6e6b156468d",
                                "text": "„Die auf einem klinischen Verständnis beruhenden medizinischen Definitionsversuche dienen dagegen primär dem wissenschaftlichen Interesse an der Erforschbarkeit des Phänomens.“"
                            },
                            {
                                "example_id": "599ffdef-7892-44fe-a1b4-edcd53e56c1c",
                                "sense_id": "6dacc072-11f1-324c-baea-b6e6b156468d",
                                "text": "„Gerade wegen all dieser Fortschritte ist uns heute die Begrenztheit der Erforschbarkeit, des Wissens um komplexe Zusammenhänge in dieser Welt klar, wenn auch einigen Wissenschaftlern mehr als den nicht näher damit Vertrauten.“"
                            }
                        ],
