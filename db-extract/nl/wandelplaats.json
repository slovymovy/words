                    {
                        "sense_id": "386de95a-1346-3d76-b026-d8fb123c20e5",
                        "entry_id": "cfc1879c-bfa1-3ddc-9daa-dad91dfbb659",
                        "glosses": [
                            "een park, plantsoen of promenade waar men fijn kan wandelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c71f524-8e3c-40d7-a20a-99c29312cd1b",
                                "sense_id": "386de95a-1346-3d76-b026-d8fb123c20e5",
                                "text": "Het is goed toeven in een fraai aangelegde wandelplaats."
                            },
                            {
                                "example_id": "5223113d-6197-42fe-9bd7-a5df5ace3db2",
                                "sense_id": "386de95a-1346-3d76-b026-d8fb123c20e5",
                                "text": "Een wandelplaats is een groen sieraad voor de stad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6d7ea43-4da2-4755-b2b6-4329f2252439",
