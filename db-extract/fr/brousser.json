                "senses": [
                    {
                        "sense_id": "b2ea0d9f-6db2-38e2-a55b-219cfb1a8686",
                        "entry_id": "b6ee18a2-5230-3fa1-a6a5-eba55852f19e",
                        "glosses": [
                            "Marcher à travers bois sans suivre les chemins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6ca9bef-4eaf-49bd-9b6b-bc3b2ff1d11b",
                                "sense_id": "b2ea0d9f-6db2-38e2-a55b-219cfb1a8686",
                                "text": "Monsieur ne s'ébranla point, et il fallut se réduire au parti de brousser à l'aveugle de jour en jour"
                            },
                            {
                                "example_id": "a9b138f4-b49d-45cf-9afa-603f220ce169",
                                "sense_id": "b2ea0d9f-6db2-38e2-a55b-219cfb1a8686",
                                "text": "Il ne guettait plus les oiseaux du parc, laissait les chats brousser dans les lianes et laper l’eau du bassin ; […]"
                            },
                            {
                                "example_id": "f2cf5c19-86b6-4018-ab74-ef084f561391",
                                "sense_id": "b2ea0d9f-6db2-38e2-a55b-219cfb1a8686",
                                "text": "Je broussai parmi les citations comme au travers d’un bois légendaire. Çà et là, je relevai des notations familières, des rappels historiques, voire de petites scènes prises sur le vif, et qui tenaient en une phrase."
                            }
                        ]
                    }
                ],
