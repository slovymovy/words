                                    {
                                        "sense_id": "9a12898e-46d6-3e7d-ab04-ad05498ecc50",
                                        "entry_id": "e3c2ac6f-afa8-3f02-8207-d4e89114f1d7",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de disputer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f260def-2b4e-40a6-a888-1d640ef095f2",
                                                "sense_id": "9a12898e-46d6-3e7d-ab04-ad05498ecc50",
                                                "text": "Il accompagne Pantagruel dans un périple en mer, au cours duquel il se dispute avec un marchand de moutons, prénommé Dindenault."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "359bcf2a-31c5-3b2f-a5ea-5d9b1e2a4984",
