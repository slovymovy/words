                        "glosses": [
                            "крим. жарг. войти в сговор с мусорами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e8a8683-bf7c-459a-8658-593bfdb615b0",
                                "sense_id": "bcd2dd03-b86a-3b38-a4a0-b817b081bac4",
                                "text": "Большинство преступников конкретно замусорились. Дела обтяпывают рука об руку с ментами."
                            }
                        ]
