                        "entry_id": "5f043aff-881d-3e6e-8222-4070b27ead5b",
                        "glosses": [
                            "jong kind in de leeftijd van één tot vier jaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de6ccd65-ef53-4135-9bea-01ff932039ef",
                                "sense_id": "110fe80f-86d5-3cbc-8e6b-dd784fad0a4d",
                                "text": "De peuter brabbelde de hele dag door."
                            },
                            {
                                "example_id": "b5b1cdb1-113d-4d09-bfce-ec4e7ec139d3",
                                "sense_id": "110fe80f-86d5-3cbc-8e6b-dd784fad0a4d",
                                "text": "- Is de peuter stil geweest? - Ja. Hij is niet wakker geworden. Blijf je nog op?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5d8ea95b-23a4-3c8c-8f45-d9d3d45fb94a",
                        "entry_id": "5f043aff-881d-3e6e-8222-4070b27ead5b",
                        "glosses": [
                            "persoon die peutert, peuteraar"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aee84b6e-75eb-3ef2-a370-d8e9762daab7",
                        "entry_id": "5f043aff-881d-3e6e-8222-4070b27ead5b",
                        "glosses": [
                            "stoot, por"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "86526aed-adf3-487f-b708-e589d3252fa8",
                                "sense_id": "aee84b6e-75eb-3ef2-a370-d8e9762daab7",
                                "text": "‘Halloo, what! old fellow, ouwe Hollander,’ zei de ‘captain.’ - ‘Never mind! - Jij bent bang, old Dutchman.’\n‘Bang?’ zei Jan, en hij keek den Engelschman vlak in zijn gezicht. ‘Bang? Net zoo min als jij, maar het is mijn plicht om je te waarschouwen.’In dat oogenblik had Jan den Engelschen dikzak graag een ‘peuter’ willen geven, want hij werd niet graag ‘geaffronteerd,’ maar als men loods is, mag men tot zulke ‘werktuigelijkheden’ natuurlijk niet overgaan"
                            }
                        ]
                    },
                    {
                        "sense_id": "fc37f8c7-3f6c-35b6-8538-2077bc396686",
                        "entry_id": "5f043aff-881d-3e6e-8222-4070b27ead5b",
                        "glosses": [
                            "lepeltje om het oor te reinigen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd45dd82-f3aa-4b4b-896c-2064fd223699",
                        "source_entry_id": "5f043aff-881d-3e6e-8222-4070b27ead5b",
                        "source_sense_id": "110fe80f-86d5-3cbc-8e6b-dd784fad0a4d",
                        "source_sense_description": "een jong kind in de leeftijd van een tot vier jaar",
                        "target_lang_word": "Kleinkind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinkind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                        "entry_id": "a9f67a56-f4a1-3b43-8759-2af3bad5b461",
                                        "glosses": [
                                            "Kind unter sechs Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9cad32-f673-48f5-b3c5-671001d06d39",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "Es gibt ein extra Planschbecken für Kleinkinder."
                                            },
                                            {
                                                "example_id": "873d0824-9193-4661-9e69-28070f4efddc",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Es fehlte die Wahrnehmung dafür, dass es für die Kleineren weit schwerer war, mit einer Kette von furchtbaren Erlebnissen fertigzuwerden, weil die überforderten Erwachsenen nicht die Sicherheit und Nestwärme geben konnten, die Kleinkinder für den Aufbau ihrer psychischen Stabilität brauchen.“"
                                            },
                                            {
                                                "example_id": "9654fbb2-cdb7-474a-9acd-79eb8a58fac1",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Wolfgang Thierse, geboren 1943, floh als Kleinkind mit seiner Familie vor der russischen Armee aus dem brennenden Breslau bei 16 Grad unter Null und 50 Zentimeter Neuschnee.“"
                                            },
                                            {
                                                "example_id": "2d6c6036-9d09-4320-a7b9-e9546757a6cb",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Er wandte sich mir zu und behandelte mich nicht wie ein Kleinkind.“"
                                            },
                                            {
                                                "example_id": "f56fe350-0cdc-45c9-9859-0ff89810a62a",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Hier wohnte die eine als Kleinkind und sie erinnere sich noch immer an einen fantastischen Blick auf den Rhein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3c22df9-1213-4a54-861c-47c454ba5b6b",
                        "source_entry_id": "5f043aff-881d-3e6e-8222-4070b27ead5b",
                        "source_sense_id": "110fe80f-86d5-3cbc-8e6b-dd784fad0a4d",
                        "source_sense_description": "een jong kind in de leeftijd van een tot vier jaar",
                        "target_lang_word": "toddler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toddler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba5d6c59-17af-3bcd-9ed0-7715e1bc539a",
                                        "entry_id": "40593122-7c0d-3bf1-bf9e-a5bd6ad875ab",
                                        "glosses": [
                                            "A young child who has started walking but not fully mastered it, typically between one and three years old."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8484e5fe-787f-4f1a-9aa6-b34d2f10641c",
                                                "sense_id": "ba5d6c59-17af-3bcd-9ed0-7715e1bc539a",
                                                "text": "I can't believe Vanessa's baby is now a toddler already!"
                                            },
                                            {
                                                "example_id": "eb15d944-ae15-43d1-a85f-0724f06e4045",
                                                "sense_id": "ba5d6c59-17af-3bcd-9ed0-7715e1bc539a",
                                                "text": "One inexpensive possibility is to purchase a toddler seat that can be placed on your current carriage. There are seats especially designed for that purpose, with seat belts and all. Some toddlers enjoy their high perch, but safety is a concern with these seats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b1081a5-8966-3b93-9fea-e90fe1eb3c5c",
                                        "entry_id": "40593122-7c0d-3bf1-bf9e-a5bd6ad875ab",
                                        "glosses": [
                                            "One unsteady on their feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e169fdd4-3fc2-458b-be57-4a92302961aa",
                                                "sense_id": "9b1081a5-8966-3b93-9fea-e90fe1eb3c5c",
                                                "text": "He is sixty-five years old if he is a fortnight, while the girl has only just done with her dolls,and hos no more love for the toothless old toddler than I have for Mammy Wombat, the black gin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5be27363-c720-4bc4-9c46-0883f6704774",
                        "source_entry_id": "5f043aff-881d-3e6e-8222-4070b27ead5b",
                        "source_sense_id": "110fe80f-86d5-3cbc-8e6b-dd784fad0a4d",
