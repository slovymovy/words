                        "source_sense_id": "ed3fc025-0ae0-3ee5-a573-31260e652075",
                        "target_lang_word": "nain de jardin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nain de jardin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "311f116e-f2c1-3b31-bb1d-513d6ed0c1da",
                                        "entry_id": "b3f59027-6f2a-3976-92e6-761c58269d33",
                                        "glosses": [
                                            "Représentation d’un gnome sous la forme d’une statue de petite taille, utilisée pour décorer certains jardins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18ddfe83-8cb9-4c01-96dd-0c8a23bdef7f",
                                                "sense_id": "311f116e-f2c1-3b31-bb1d-513d6ed0c1da",
                                                "text": "Le nain de jardin porte fièrement différents bonnets. Il semble vide de sens tellement il peut en avoir."
                                            },
                                            {
                                                "example_id": "bbd575ef-53f6-42ad-94a5-d261bfcc687a",
                                                "sense_id": "311f116e-f2c1-3b31-bb1d-513d6ed0c1da",
                                                "text": "À travers un film de Ken Loach, Family Life (1972), le sadisme à l’encontre du nain de jardin devient le révélateur d’un mal être social."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c932cf6-e901-4407-94a3-5511cbe97311",
                        "source_entry_id": "364adc6f-2a14-33cb-b7dc-74cd9926ac66",
                        "source_sense_id": "ed3fc025-0ae0-3ee5-a573-31260e652075",
                        "target_lang_word": "nain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe1b5155-c0f3-35eb-a682-99a7345ed768",
                                        "entry_id": "2259ea16-9926-3708-803d-f492c13dae5c",
                                        "glosses": [
                                            "De toute petite taille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59558218-0263-46d0-acfd-50f3000982e4",
                                                "sense_id": "fe1b5155-c0f3-35eb-a682-99a7345ed768",
                                                "text": "Arbre nain, bonsaï, buisson."
                                            },
                                            {
                                                "example_id": "9503a8fb-53cc-498c-ab73-fc7896edc9c1",
                                                "sense_id": "fe1b5155-c0f3-35eb-a682-99a7345ed768",
                                                "text": "Buis nain, buis qui ne devient jamais aussi grand que le buis ordinaire."
                                            },
                                            {
                                                "example_id": "5bda2bdf-e2e1-4ebe-aec0-0f829c99551a",
                                                "sense_id": "fe1b5155-c0f3-35eb-a682-99a7345ed768",
                                                "text": "Caniche nain, variété de petite taille de cette race de chien."
                                            },
                                            {
                                                "example_id": "c8ffd167-e08e-408e-9b44-5cc9fca9ea6d",
                                                "sense_id": "fe1b5155-c0f3-35eb-a682-99a7345ed768",
                                                "text": "Étoile naine, étoile de faible luminosité intrinsèque."
                                            },
                                            {
                                                "example_id": "7c40fb91-4430-4c34-acb4-696214e0f462",
                                                "sense_id": "fe1b5155-c0f3-35eb-a682-99a7345ed768",
                                                "text": "Mur nain, muret."
                                            },
                                            {
                                                "example_id": "ef35fded-566f-432c-b608-074ae6d41ba0",
                                                "sense_id": "fe1b5155-c0f3-35eb-a682-99a7345ed768",
                                                "text": "Rosier nain, Capucine naine, variétés de petite taille de ces plantes."
                                            },
                                            {
                                                "example_id": "8d808fa0-15dd-4159-8a67-916c4e1ea2ba",
                                                "sense_id": "fe1b5155-c0f3-35eb-a682-99a7345ed768",
                                                "text": "Œuf nain, œuf de poule qui ne contient point de jaune."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc078fc3-8345-34f7-a39a-40452becdd4c",
                                        "entry_id": "8883ae58-1dae-391b-9662-e0729c21a4e0",
                                        "glosses": [
                                            "Humain d’une taille beaucoup plus petite que la taille ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e931c7-232a-42bb-bc4d-ed09c2832bff",
                                                "sense_id": "dc078fc3-8345-34f7-a39a-40452becdd4c",
                                                "text": "Le roi a un nain charmant, n’est-ce pas ? on le met dans un pâté. Qu’il est heureux le roi d’Espagne ! je n’en ai jamais pu trouver un comme cela."
                                            },
                                            {
                                                "example_id": "3207abbf-1eb0-4d4a-8ccc-b01909f71aa5",
                                                "sense_id": "dc078fc3-8345-34f7-a39a-40452becdd4c",
                                                "text": "Le nain qui vend les journaux vient s’asseoir, sa tournée finie, près d’eux, mais une fois assis, il les surpasse de la tête, car ses jambes seules sont si petites."
                                            },
                                            {
                                                "example_id": "18791c68-aa29-4823-8c1d-06ec2dda7d00",
                                                "sense_id": "dc078fc3-8345-34f7-a39a-40452becdd4c",
                                                "text": "Je lisais l’autre jour un conte de Paul Morand. C’est l’histoire d’un seigneur dont la fille est naine. Le père fait rassembler tous les nains du royaume autour d’elle pour lui constituer un univers à la dimension, à sa mesure. Il fait venir des poneys, fabriquer des meubles lilliputiens, tout est à l’échelle de la môme. Elle vit dans une sorte d’îlot frappé de nanisme. Et lorsqu’elle finit par découvrir ce qui l’entoure – les gens normaux, en somme – elle les traite de monstres."
                                            },
                                            {
                                                "example_id": "4c4b2e30-ec2c-4f70-9fa8-902cf1d75305",
                                                "sense_id": "dc078fc3-8345-34f7-a39a-40452becdd4c",
                                                "text": "Dans La Petite Vie, l’acteur Michel Côté a incarné Jean-Lou, un homosexuel efféminé au maximum. Benoit Brière a joué un français vêtu d’une camisole, baguette sous le bras. Ti-mé, alias Popa, et Stimé, joué par Stéphane Rousseau, ont multiplié les blagues sur les nains, entre autres choses."
                                            },
                                            {
                                                "example_id": "e312d59f-73da-4732-89c4-765d74b220bf",
                                                "sense_id": "dc078fc3-8345-34f7-a39a-40452becdd4c",
                                                "text": "Une petite dernière en terminant. Dans Blanche-Neige, le film de Disney, quelle est la chanson que les sept nains chantent pour se donner du cœur à l’ouvrage ? « Heigh Ho, Heigh Ho » ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d961eff-89d4-313b-b90f-25903f0f2505",
                                        "entry_id": "8883ae58-1dae-391b-9662-e0729c21a4e0",
                                        "glosses": [
                                            "Créature mythologique de même aspect qu’un homme, mais de très petite taille."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2f4fda4-4a63-4117-8d3e-ab3704f3af8e",
                                                "sense_id": "1d961eff-89d4-313b-b90f-25903f0f2505",
                                                "text": "Les nains enchanteurs ont disparu, le pont-levis s’est envolé et le lézard se traîne où se promenait jadis la belle Geneviève."
                                            },
                                            {
                                                "example_id": "85350c5b-cc41-4b4a-9381-8b42f39c4772",
                                                "sense_id": "1d961eff-89d4-313b-b90f-25903f0f2505",
                                                "text": "Si nous dressons le bilan de cette rapide incursion dans les littératures celtiques, nous pouvons le formuler ainsi : les nains sont beaux ou laids, hostiles ou serviables, quelquefois voleurs ou ravisseurs; ils habitent des royaumes situés sur des îles, dans des lacs ou dans la mer, ou encore souterrains; ils y vivent en communauté, dirigés par un roi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d35598f-3679-3ef4-a66c-abe44b81409f",
                                        "entry_id": "8883ae58-1dae-391b-9662-e0729c21a4e0",
                                        "glosses": [
                                            "Personne ou entité personnifiée de peu d’influence ou de peu d’envergure."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "081dc271-1d80-43cc-80a9-0c363e36b1b8",
                                                "sense_id": "3d35598f-3679-3ef4-a66c-abe44b81409f",
                                                "text": "La première puissance commerciale du monde ressemble parfois, dans ses hésitations comme dans ses détours, à un nain politique, à un nain militaire et à un nain culturel."
                                            },
                                            {
                                                "example_id": "5ebae494-781f-4ccd-9ec3-5fc7a529f94f",
                                                "sense_id": "3d35598f-3679-3ef4-a66c-abe44b81409f",
                                                "text": "C’est pourquoi il a choisi de se faire tout petit. […] Et puis ça a du bon la petitesse. Les nains sont les derniers à recevoir les tuiles sur la tête et les premiers à se rendre compte quand la marée monte. En conséquence, ce qu’ils perdent en hauteur, ils le récupèrent en perspective."
                                            },
                                            {
                                                "example_id": "013d233a-70c3-49f3-8174-de6c3eb4f005",
                                                "sense_id": "3d35598f-3679-3ef4-a66c-abe44b81409f",
                                                "text": "Occupée sur une partie (industrielle) de son territoire, confrontée à une inflation sans précédent, à une agitation ouvrière, à des troubles politiques et institutionnels, l’Allemagne devient un nain économique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98944443-e9d7-4614-acf9-9391a0571d27",
                        "source_entry_id": "364adc6f-2a14-33cb-b7dc-74cd9926ac66",
