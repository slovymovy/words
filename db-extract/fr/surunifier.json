                "senses": [
                    {
                        "sense_id": "dd519260-3b39-374a-af11-2044a3485a2e",
                        "entry_id": "67b6874c-ede2-329e-a57a-f476f845f935",
                        "glosses": [
                            "Rendre trop uniforme (ou complètement uniforme)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c10e5584-2c30-405f-83c0-de2955130d76",
                                "sense_id": "dd519260-3b39-374a-af11-2044a3485a2e",
                                "text": "Roparz Hemon, L'ordre de surunifier la langue est venu du gouvernement allemand."
                            },
                            {
                                "example_id": "0be04826-41f7-428b-911d-462d3b45c0ae",
                                "sense_id": "dd519260-3b39-374a-af11-2044a3485a2e",
                                "text": "Les communistes ont pu intégrer le capitalisme, les brittophones arrivent parfois à intégrer le message jacobin, à force de surunifier on stérilise et on aseptise."
                            },
                            {
                                "example_id": "8ffbf40b-a4d6-4d33-a83a-ae956589e96e",
                                "sense_id": "dd519260-3b39-374a-af11-2044a3485a2e",
                                "text": "Est-il même nécessaire de les fondre tous deux et comment parvenir à les surunifier ?"
                            }
                        ]
                    }
