                    "frequency": "High",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour financer ses études supérieures, il a dû <w>contracter</w> un emprunt bancaire."
                        },
                        {
                            "text": "Les jeunes mariés ont choisi de <w>contracter</w> une assurance pour leur premier appartement."
                        }
                    ],
                    "common_phrases": [
