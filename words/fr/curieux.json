                    "frequency": "High",
                    "semantic_group_id": "desir_apprendre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet élève très <w>curieux</w> pose souvent des questions intéressantes en cours de sciences."
                        },
