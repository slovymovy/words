                        "entry_id": "645c7b3c-c478-3ed6-99e7-0c2b2c243ea1",
                        "glosses": [
                            "Celle qui tient un bistrot."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "2132ad9f-e7c8-46e0-99ce-69336a2af6fa",
                                "sense_id": "6f8de18f-3770-3782-93c3-5c418f4d62b2",
                                "text": "Je l’entends encore, avec sa gouaille de bistrotière,qui me parle de ses cousins « engliches » de Barneville."
                            },
                            {
                                "example_id": "cf3f8b0f-d748-4600-a0a6-8968fdc824b6",
                                "sense_id": "6f8de18f-3770-3782-93c3-5c418f4d62b2",
                                "text": "Les exclamations des joueurs de tarot emplissaient la salle enfumée, ainsi que les remarques spirituelles d’Ida qui avait le verbe haut & savait être à la fois ferme & aimable, comme toute bistrotière digne de ce nom."
                            }
                        ]
                    }
