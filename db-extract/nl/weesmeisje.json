                                        "sense_id": "d42a3b7a-6d9b-3e99-b874-2fa0fd1f9be4",
                                        "entry_id": "7f212e98-1ff1-3c2b-827f-ea4418664bd4",
                                        "glosses": [
                                            "Remaining after the removal of some form of support."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
