                        "examples": [
                            {
                                "example_id": "e56746bf-1599-48fa-9a41-38402a956df1",
                                "sense_id": "8653b40b-7baa-3c4e-9f6f-e8c94613737d",
                                "text": "Elle commence alors sa « grande lessive », le bazardage de tout ce qui semblait la rassurer autrefois... Son musée, véritable mausolée de ce qui ne sera plus jamais, l'étouffe."
                            },
                            {
                                "example_id": "4b958cd2-d60e-4ba1-8392-44e6700dd23c",
                                "sense_id": "8653b40b-7baa-3c4e-9f6f-e8c94613737d",
                                "text": "En fait, il n'a jamais accepté la décision du Cabinet de décembre 1969. Il parlera, en privé, d'un «bazardage» de la politique canadienne aux mains du ministère de la Défense."
                            }
                        ]
                    }
