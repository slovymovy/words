{
    "word_family": [
        "discover",
        "discoverer",
        "discoverable",
        "undiscovered",
        "rediscovery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "033ff9fb-27a4-35af-a6b9-4bacac31ecba",
                    "sense_definition": "The process or act of finding or learning something for the first time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>discovery</w> of fire was a major turning point in human history.",
                            "target_lang_translations": {
                                "ru": "<w>Открытие</w> огня стало важным поворотным моментом в истории человечества."
                            }
                        },
                        {
                            "text": "The primary goal of the scientific voyage was <w>discovery</w> of new species.",
                            "target_lang_translations": {
                                "ru": "Основной целью научной экспедиции было <w>открытие</w> новых видов."
                            }
                        }
                    ],
                    "synonyms": [
                        "finding",
                        "detection",
                        "unearthing"
                    ],
                    "common_phrases": [
                        "voyage of discovery",
                        "scientific discovery",
                        "accidental discovery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или акт нахождения или узнавания чего-либо впервые."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открытие",
                                "target_lang_sense_clarification": "процесс нахождения нового"
                            },
                            {
                                "target_lang_word": "обнаружение",
                                "target_lang_sense_clarification": "факт выявления чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd3d36d6-352b-38f5-adbf-de761add97ff",
                    "sense_definition": "A person, place, or thing that has been found or learned about.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This latest <w>discovery</w> should eventually lead to much better treatments for disease.",
                            "target_lang_translations": {
                                "ru": "Это последнее <w>открытие</w> должно в конечном итоге привести к гораздо более эффективным методам лечения болезней."
                            }
                        },
                        {
                            "text": "The archaeologists shared their amazing <w>discovery</w> with the local museum.",
                            "target_lang_translations": {
                                "ru": "Археологи поделились своей удивительной <w>находкой</w> с местным музеем."
                            }
                        }
                    ],
                    "synonyms": [
                        "find",
                        "breakthrough"
                    ],
                    "common_phrases": [
                        "amazing discovery",
                        "recent discovery",
                        "major discovery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, место или вещь, которые были найдены или о которых стало известно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открытие",
                                "target_lang_sense_clarification": "результат исследования или поиска"
                            },
                            {
                                "target_lang_word": "находка",
                                "target_lang_sense_clarification": "что-то ценное или интересное, что было найдено"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f30a723e-03ca-3175-874e-1d0593eb26ca",
                    "sense_definition": "The act of revealing or uncovering a secret or hidden fact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>discovery</w> of his true identity shocked everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>разоблачение</w> его истинной личности шокировало всех присутствующих."
                            }
                        },
                        {
                            "text": "She feared the <w>discovery</w> of her secret would ruin her reputation.",
                            "target_lang_translations": {
                                "ru": "Она боялась, что <w>обнаружение</w> её секрета разрушит её репутацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "revelation",
                        "disclosure",
                        "exposure"
                    ],
                    "antonyms": [
                        "concealment"
                    ],
                    "common_phrases": [
                        "fear of discovery",
                        "sudden discovery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт раскрытия или выявления секрета или скрытого факта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разоблачение",
                                "target_lang_sense_clarification": "раскрытие тайны или правды"
                            },
                            {
                                "target_lang_word": "обнаружение",
                                "target_lang_sense_clarification": "выявление скрытого факта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9acfc33e-c92f-37f5-a9b3-69c5603ffe47",
                    "sense_definition": "A pre-trial phase in a lawsuit where each party investigates the facts of a case and gathers evidence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecution moved to suppress certain items turned up during <w>discovery</w>.",
                            "target_lang_translations": {
                                "ru": "Обвинение подало ходатайство об исключении некоторых улик, выявленных в ходе <w>раскрытия доказательств</w>."
                            }
                        },
                        {
                            "text": "Lawyers spent months in the <w>discovery</w> phase reviewing thousands of documents.",
                            "target_lang_translations": {
                                "ru": "Адвокаты провели месяцы на стадии <w>сбора доказательств</w>, изучая тысячи документов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "discovery phase",
                        "pretrial discovery",
                        "conduct discovery"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Досудебная стадия судебного процесса, на которой стороны собирают доказательства и факты по делу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрытие доказательств",
                                "target_lang_sense_clarification": "юридическая процедура обмена информацией"
                            },
                            {
                                "target_lang_word": "сбор доказательств",
                                "target_lang_sense_clarification": "процесс подготовки к суду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92479fd7-2d04-36d1-8352-b1d6ea58fca8",
                    "sense_definition": "A situation in chess where moving a piece unmasks an attack by another piece.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could easily lose his queen to a bishop <w>discovery</w> on the b5 square.",
                            "target_lang_translations": {
                                "ru": "Он мог легко потерять ферзя из-за <w>вскрытого нападения</w> слоном на поле b5."
                            }
                        },
                        {
                            "text": "The grandmaster set up a clever <w>discovery</w> that forced his opponent to resign.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстер подготовил хитрое <w>вскрытое нападение</w>, которое заставило противника сдаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "discovered attack"
                    ],
                    "common_phrases": [
                        "bishop discovery",
                        "knight discovery"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "chess"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация в шахматах, когда ход одной фигуры открывает линию атаки для другой фигуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вскрытое нападение",
                                "target_lang_sense_clarification": "шахматный термин"
                            },
                            {
                                "target_lang_word": "вскрытый шах",
                                "target_lang_sense_clarification": "если атакован король"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}