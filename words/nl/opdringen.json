{
    "word_family": [
        "dringen",
        "opdringerig",
        "opdringing",
        "aandringen",
        "doordringen",
        "verdringen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23ee42ee-6d44-38e0-a0d7-4009cfa8a572",
                    "sense_definition": "iemand dwingen om iets te accepteren of aan te nemen, vaak tegen hun zin",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "forceren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet jouw mening niet altijd aan anderen <w>opdringen</w>.",
                            "target_lang_translations": {
                                "en": "You shouldn't always <w>impose</w> your opinion on others."
                            }
                        },
                        {
                            "text": "Hij kreeg een nieuwe functie <w>opgedrongen</w> die hij eigenlijk helemaal niet wilde doen.",
                            "target_lang_translations": {
                                "en": "He had a new position <w>forced</w> upon him that he didn't actually want to do at all."
                            }
                        }
                    ],
                    "synonyms": [
                        "opleggen",
                        "forceren"
                    ],
                    "common_phrases": [
                        "mening opdringen",
                        "wil opdringen"
                    ],
                    "target_lang_definitions": {
                        "en": "To force someone to accept or take something, often against their will."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impose",
                                "target_lang_sense_clarification": "to force something on someone"
                            },
                            {
                                "target_lang_word": "force",
                                "target_lang_sense_clarification": "to make someone accept something"
                            },
                            {
                                "target_lang_word": "foist",
                                "target_lang_sense_clarification": "to force someone to accept something inferior or unwanted"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28316c7c-76e5-3056-93e5-44628d05d0ff",
                    "sense_definition": "zichzelf ongevraagd of met veel moeite in iemands gezelschap of aandacht plaatsen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sociaal gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij probeert zich voortdurend aan de directeur <w>op</w> te <w>dringen</w> tijdens de lunch.",
                            "target_lang_translations": {
                                "en": "She constantly tries to <w>impose herself</w> on the director during lunch."
                            }
                        },
                        {
                            "text": "Ik wil me niet <w>opdringen</w> maar ik kan jullie wel helpen met die zware tassen.",
                            "target_lang_translations": {
                                "en": "I don't want to <w>intrude</w>, but I can help you with those heavy bags."
                            }
                        }
                    ],
                    "synonyms": [
                        "zich aanbieden"
                    ],
                    "antonyms": [
                        "zich terugtrekken"
                    ],
                    "common_phrases": [
                        "zich opdringen"
                    ],
                    "target_lang_definitions": {
                        "en": "To place oneself uninvited or with great effort into someone's company or attention."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intrude",
                                "target_lang_sense_clarification": "to put oneself into a place or situation where one is not invited"
                            },
                            {
                                "target_lang_word": "impose oneself",
                                "target_lang_sense_clarification": "to force one's presence on others"
                            },
                            {
                                "target_lang_word": "push oneself",
                                "target_lang_sense_clarification": "to aggressively seek attention or inclusion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3283763b-447d-37a9-910c-402d54c8b4ba",
                    "sense_definition": "zich ~: wanneer een gedachte, gevoel of herinnering onvermijdelijk en krachtig in de geest naar boven komt",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mentaal proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De herinnering aan die vakantie bleef zich aan hem <w>opdringen</w>.",
                            "target_lang_translations": {
                                "en": "The memory of that holiday kept <w>intruding</w> on his mind."
                            }
                        },
                        {
                            "text": "Een akelig vermoeden <w>drong</w> zich aan mij <w>op</w> na het horen van het nieuws.",
                            "target_lang_translations": {
                                "en": "A nasty suspicion <w>forced itself</w> upon me after hearing the news."
                            }
                        }
                    ],
                    "synonyms": [
                        "zich voordoen",
                        "opkomen"
                    ],
                    "common_phrases": [
                        "gedachte opdringen",
                        "vermoeden opdringen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "reflexive use"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "When a thought, feeling, or memory inevitably and powerfully comes to mind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intrude",
                                "target_lang_sense_clarification": "of thoughts or memories entering the mind unwanted"
                            },
                            {
                                "target_lang_word": "force itself",
                                "target_lang_sense_clarification": "of an idea or feeling becoming impossible to ignore"
                            },
                            {
                                "target_lang_word": "obtrude",
                                "target_lang_sense_clarification": "to become noticeable in an unwelcome way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e48b5e6-4791-3035-aae2-01f455446e0e",
                    "sense_definition": "zich met kracht of in grote getale in een bepaalde richting verplaatsen",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vijand was al een heel stuk <w>opgedrongen</w> richting de grens.",
                            "target_lang_translations": {
                                "en": "The enemy had already <w>advanced</w> a long way toward the border."
                            }
                        },
                        {
                            "text": "De menigte <w>drong</w> steeds verder <w>op</w> naar het podium.",
                            "target_lang_translations": {
                                "en": "The crowd kept <w>pushing forward</w> toward the stage."
                            }
                        }
                    ],
                    "synonyms": [
                        "oprukken",
                        "vooruitdringen"
                    ],
                    "antonyms": [
                        "terugtrekken",
                        "wijken"
                    ],
                    "common_phrases": [
                        "verder opdringen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move in a certain direction with force or in large numbers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "advance",
                                "target_lang_sense_clarification": "to move forward, often in a military or forceful context"
                            },
                            {
                                "target_lang_word": "push forward",
                                "target_lang_sense_clarification": "to move ahead through a crowd or obstacle"
                            },
                            {
                                "target_lang_word": "press on",
                                "target_lang_sense_clarification": "to continue moving forward forcefully"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}