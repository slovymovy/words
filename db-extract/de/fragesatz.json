                "senses": [
                    {
                        "sense_id": "88c19172-1c58-3050-84ec-79a33d21f1dd",
                        "entry_id": "7878cd6c-4131-3671-bf6b-03e6ade44d3b",
                        "glosses": [
                            "verschiedene Satzformen, die hauptsächlich verwendet werden, um eine Frage zu äußern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc60e61a-f09d-44a3-9b4f-c58ba6dae171",
                                "sense_id": "88c19172-1c58-3050-84ec-79a33d21f1dd",
                                "text": "Der Satz „Kommst du heute?“ ist ein Fragesatz."
                            },
                            {
                                "example_id": "d9e16f2e-9d2d-43db-a14c-33b34530d517",
                                "sense_id": "88c19172-1c58-3050-84ec-79a33d21f1dd",
                                "text": "Fragesätze werden mit dem Satzzeichen „?“ gekennzeichnet, wenn es sich um Hauptsätze handelt."
                            },
                            {
                                "example_id": "afc7d357-f80b-4f85-b9c7-9f86f4b250d8",
                                "sense_id": "88c19172-1c58-3050-84ec-79a33d21f1dd",
                                "text": "Manche Fragesätze dienen nicht als Fragen, sondern eher als Aufforderungen, wie z.B. „Willst du nicht endlich kommen?“"
                            },
                            {
                                "example_id": "886dddba-7ebd-4942-b7d0-25c3093cd073",
                                "sense_id": "88c19172-1c58-3050-84ec-79a33d21f1dd",
                                "text": "„Insbesondere Aufforderungen lassen sich in einem Fragesatz oder in einem Aussagesatz ausdrücken.“"
                            },
                            {
                                "example_id": "81256ca7-1d3c-4917-97c6-2a1640a88190",
                                "sense_id": "88c19172-1c58-3050-84ec-79a33d21f1dd",
                                "text": "„Auf das Einwortsatz-Stadium folgen Sätze von zwei und mehreren flexionslosen Wörtern, die sich als Ausrufs-, Frage- und Aussagesätze klassifizieren lassen (...).“"
                            },
                            {
                                "example_id": "6dbfff4c-5bfa-4ede-8aa9-96647c1c4d1e",
                                "sense_id": "88c19172-1c58-3050-84ec-79a33d21f1dd",
                                "text": "„Gelegentlich werden ein Fragezeichen und ein Ausrufezeichen gesetzt, um einen Fragesatz gleichzeitig als Ausrufesatz zu kennzeichnen.“"
                            },
                            {
                                "example_id": "bcf2edf4-60de-4db7-8641-685db589b282",
                                "sense_id": "88c19172-1c58-3050-84ec-79a33d21f1dd",
                                "text": "„Wenn man jemanden zu etwas auffordern möchte, drückt man das bei uns oft eher in der Form eines Fragesatzes als mit einem Wunschsatz aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
