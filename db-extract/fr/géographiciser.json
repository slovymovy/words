                        "glosses": [
                            "Donner un caractère géographique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7266a756-6d64-4f99-beb2-9d8d535d14bf",
                                "sense_id": "aa48c692-9f8b-315e-adc7-9a2c7eaf7e0b",
                                "text": "Ces préoccupations, souvent partagées sans le savoir, permettent d’historiciser et de géographiciser le concept de ville."
                            },
                            {
                                "example_id": "41d01262-2dd9-4f64-872b-52988953e95d",
                                "sense_id": "aa48c692-9f8b-315e-adc7-9a2c7eaf7e0b",
                                "text": "Lorsque Braudel appelle à historiciser la géographie, et à géographiciser l’histoire, la symétrie s’avère finalement illusoire."
                            }
                        ]
