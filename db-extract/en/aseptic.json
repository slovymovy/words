    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f38bd5bc-7aa0-3813-a221-e51d805c1496",
                "word": "aseptic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d46ac90-f10f-33ea-8f59-b3db109b6c0e",
                        "entry_id": "f38bd5bc-7aa0-3813-a221-e51d805c1496",
                        "glosses": [
                            "Free of disease-causing microbes."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "927e711a-9a6e-46eb-8be6-7a2f49d1a8af",
                                "sense_id": "5d46ac90-f10f-33ea-8f59-b3db109b6c0e",
                                "text": "The lack of aseptic tools during surgery has resulted in many deaths."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f2998be-ac51-39d2-a76d-1ce5f18f2127",
                        "entry_id": "f38bd5bc-7aa0-3813-a221-e51d805c1496",
                        "glosses": [
                            "Used to protect against infection by disease-causing microbes."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7b997a6f-a18a-424e-aac6-c8d1b5243dc4",
                                "sense_id": "0f2998be-ac51-39d2-a76d-1ce5f18f2127",
                                "text": "Pharmaceuticals are packaged using aseptic techniques."
                            }
                        ]
                    },
                    {
                        "sense_id": "01711632-0c6b-3a54-b797-a42d44d1a953",
                        "entry_id": "f38bd5bc-7aa0-3813-a221-e51d805c1496",
                        "glosses": [
                            "pasteurised."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08aa0be6-5a6c-4b8c-aa71-75cb87b759c0",
                        "source_entry_id": "f38bd5bc-7aa0-3813-a221-e51d805c1496",
                        "source_sense_description": "free of microbes",
                        "target_lang_word": "aseptisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aseptisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04a90ccd-b10a-3fbb-b81b-5680a081d8f5",
                                        "entry_id": "77b261a7-d37b-30f8-9613-86b06ba8760b",
                                        "glosses": [
                                            "nicht septisch; frei von Keimen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7cf5f61-1ae8-4c2d-8573-e313fb54bf2c",
                                                "sense_id": "04a90ccd-b10a-3fbb-b81b-5680a081d8f5",
                                                "text": "Der Chirurg muß ja bei seinen aseptischsten Operationen an der Luft arbeiten."
                                            },
                                            {
                                                "example_id": "a74bcc8c-ec87-4eb2-9990-bb36d61def09",
                                                "sense_id": "04a90ccd-b10a-3fbb-b81b-5680a081d8f5",
                                                "text": "Die im Verarbeitungsprozess angeschlossene Füll- und Verschließmaschine muss aseptisch arbeiten."
                                            },
                                            {
                                                "example_id": "af25ea16-4c55-41fd-a6ab-3b4e9fba6f9b",
                                                "sense_id": "04a90ccd-b10a-3fbb-b81b-5680a081d8f5",
                                                "text": "Bei aseptischen Wunden wird die Wunde bei Durchführung der Wundreinigung von innen nach außen gewischt."
                                            },
                                            {
                                                "example_id": "91f27422-db51-4cea-b1a9-2c8f6d99c806",
                                                "sense_id": "04a90ccd-b10a-3fbb-b81b-5680a081d8f5",
                                                "text": "„Red öffnete sein Verbandpäckchen und nahm eine flache Pappschachtel heraus, die die Binde enthielt. Mit steifen Fingern wickelte er sie aus, drückte die aseptische Seite auf Wilsons Wunde und band den Streifen leicht um seinen Körper.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ae594f5-4e63-3d91-87b4-3720fb83811e",
                                        "entry_id": "77b261a7-d37b-30f8-9613-86b06ba8760b",
                                        "glosses": [
                                            "nicht auf einer Infektion beruhend"
                                        ],
                                        "tags": [
                                            "bei Entzündungen, Nekrosen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "756274e6-0215-44b6-a5e9-a1bad96af411",
                                                "sense_id": "9ae594f5-4e63-3d91-87b4-3720fb83811e",
                                                "text": "Wie an anderen Skelettabschnitten sind ebenfalls Tumoren sowie septische und aseptische Entzündungen aus dem rheumatischen Formenkreis auszuschließen."
                                            },
                                            {
                                                "example_id": "8a29df6c-2ab9-49dc-af0f-f8858ca50d79",
                                                "sense_id": "9ae594f5-4e63-3d91-87b4-3720fb83811e",
                                                "text": "Die häufigste aseptische Entzündung des Kniegelenkes stellt die Gicht noch vor der chronischen Polyarthritis dar."
                                            },
                                            {
                                                "example_id": "5947e388-1cd5-4232-9043-856e4027c846",
                                                "sense_id": "9ae594f5-4e63-3d91-87b4-3720fb83811e",
                                                "text": "Bei der Osgood-Schlatter-Erkrankung handelt es sich um eine aseptische Nekrose der Tibiaapophyse mit lokalem Druckschmerz und Schwellung mit Schmerzverstärkung bei Streckung des Kniegelenkes gegen Widerstand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
