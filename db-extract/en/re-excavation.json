                                "example_id": "be7248e3-6244-4cd6-84c3-38779cdbb94e",
                                "sense_id": "acb2bea4-2883-3301-96ea-312b68817626",
                                "text": "The loess also, in the suburbs and neighbourhood of Liége, occurring at various heights in patches lying at between 20 and 200 feet above the river, cannot be explained without supposing the filling up and re-excavation of the valleys at a period posterior to the washing in of the animal remains into most of the old caverns."
                            },
                            {
                                "example_id": "8e8cff3f-c5da-40e0-964f-5df6f3f73a3a",
                                "sense_id": "acb2bea4-2883-3301-96ea-312b68817626",
                                "text": "Olsen (1968) describes some of the methods used in the re-excavation of the Viking fortress at Trelleborg, first excavated between 1934 and 1943 (Norland 1948)."
                            },
                            {
                                "example_id": "41d04c96-cb9e-44c8-bd1e-f5278275f84a",
                                "sense_id": "acb2bea4-2883-3301-96ea-312b68817626",
                                "text": "Re-excavation of mass graves is an important area of investigation."
                            }
                        ]
