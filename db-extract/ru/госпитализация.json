                        "cross_references": []
                    },
                    {
                        "translation_id": "6dc4e859-971f-4f87-b509-a958cd4ed1d5",
                        "source_entry_id": "d6b3c0e1-52c3-38e4-9868-6681ecfef127",
                        "source_sense_id": "1c639a5a-5a3f-352b-a79a-d860c8e1b809",
                        "target_lang_word": "Hospitalisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hospitalisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d72f5489-1edd-3037-81ae-a1a6ddc4a4d0",
                                        "entry_id": "16b011ab-45d6-389c-a0e5-39f2b8dc87c6",
                                        "glosses": [
                                            "Aufnahme/Einweisung in ein Krankenhaus (Hospital)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32de20ab-c7da-42cd-b434-28c4fd49fd9b",
                                                "sense_id": "d72f5489-1edd-3037-81ae-a1a6ddc4a4d0",
                                                "text": "„In einer retrospektiven Beobachtungsstudie wurde die deutschlandweite fallpauschalenbezogene Krankenhausstatistik (DRG-Statistik; DRG, „diagnosis related groups“) zwischen 2007 und 2015 ausgewertet. Wir untersuchten Hospitalisierungen, Anzahl der Todesfälle und die Inanspruchnahme einer Intensivtherapie.“"
                                            },
                                            {
                                                "example_id": "a100283b-f953-4b19-9ec2-fe5b1288731d",
                                                "sense_id": "d72f5489-1edd-3037-81ae-a1a6ddc4a4d0",
                                                "text": "„Die Hospitalisierungen nahmen nun aber wieder zu auf durchschnittlich über 60 pro Tag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "012cd016-5bd4-4b43-b6d4-e99f99207a32",
                        "source_entry_id": "d6b3c0e1-52c3-38e4-9868-6681ecfef127",
                        "source_sense_id": "1c639a5a-5a3f-352b-a79a-d860c8e1b809",
                        "target_lang_word": "hospitalisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospitalisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc9da5db-59b4-3c21-928b-e0cabd4c2b5f",
                                        "entry_id": "6054b8e1-2c98-303a-85b7-2d3e6db6cfb7",
                                        "glosses": [
                                            "Action d’hospitaliser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcbb069e-51a0-4758-8768-57d336f5f9c7",
                                                "sense_id": "dc9da5db-59b4-3c21-928b-e0cabd4c2b5f",
                                                "text": "Puisse-t-il ne pas nous porter rigueur d’imaginer une hospitalisation alors qu’il pourrait y recevoir l’attention à même de lui procurer soulagement et apaisement sans proposer la mort."
                                            },
                                            {
                                                "example_id": "86d01101-46ce-4c98-8bee-27841a1d3276",
                                                "sense_id": "dc9da5db-59b4-3c21-928b-e0cabd4c2b5f",
                                                "text": "Le nombre d'hospitalisations a, quant à lui, augmenté de 40 par rapport à la veille, avec un total de 818."
                                            },
                                            {
                                                "example_id": "8edae2b6-33b6-4b88-91b2-7237905a53e9",
                                                "sense_id": "dc9da5db-59b4-3c21-928b-e0cabd4c2b5f",
                                                "text": "Ici, les adolescents souffrant de TCA et d’obésité sont pris en charge de manière pluridisciplinaire (somatique et psychique), en consultation, en hospitalisation complète ou de jour, de manière individuelle, familiale, groupale en fonction des besoins, précise le Pʳ Marie Rose Moro, chef de service."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
