                "senses": [
                    {
                        "sense_id": "2e4b4080-013f-35c1-ab51-5b32036e3d92",
                        "entry_id": "26a51b15-f39a-3c51-a6e5-feaca2e50ab8",
                        "glosses": [
                            "To sow seeds again; to apply seed to (a plot of land) again."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "02714c1b-ee6c-44ba-a5d3-9a66ae7e1347",
                                "sense_id": "2e4b4080-013f-35c1-ab51-5b32036e3d92",
                                "text": "When the birds ate the seeds he had planted, the farmer was forced to reseed the field."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec589ac1-e8fc-3d51-8e4f-3c4b0e8ed8e5",
                        "entry_id": "26a51b15-f39a-3c51-a6e5-feaca2e50ab8",
                        "glosses": [
                            "Of a non-perennial plant, to produce seeds to ensure the following generation without human intervention; to self-sow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7f7d1e9-c593-477c-b8bc-e2a7c9e5949a",
                                "sense_id": "ec589ac1-e8fc-3d51-8e4f-3c4b0e8ed8e5",
                                "text": "The marigolds had reseeded themselves in the flower box, so he didn't have to buy new ones this year."
                            }
                        ]
                    },
                    {
                        "sense_id": "773606af-7fb8-32fd-835e-5af9875908c0",
                        "entry_id": "26a51b15-f39a-3c51-a6e5-feaca2e50ab8",
                        "glosses": [
                            "To reset the input of an algorithm so as to ensure different results."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a26da156-62e7-48cf-87df-1be6d11dae7e",
                                "sense_id": "773606af-7fb8-32fd-835e-5af9875908c0",
                                "text": "The game reseeded its random number algorithm with a time-based value each time the game was restarted."
                            }
                        ]
                    }
