                    {
                        "translation_id": "9d874f94-025c-4f92-9420-e6e554607d31",
                        "source_entry_id": "f50be026-b8af-3f85-995b-e45d2e1e1512",
                        "source_sense_description": "something pleasant",
                        "target_lang_word": "Annehmlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Annehmlichkeit",
