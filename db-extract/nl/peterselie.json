                    {
                        "translation_id": "ae580770-0531-46a5-b271-95d73f58f8bf",
                        "source_entry_id": "8d70e6e5-3e4c-37e5-97e9-d54d5a9eba2f",
                        "source_sense_id": "e47ec67f-c085-3c7b-9905-43d6e9f396e4",
                        "source_sense_description": "kruid",
                        "target_lang_word": "Petersilie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petersilie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18669e02-4fff-3050-9e50-8690d9a43a9e",
                                        "entry_id": "9f1cf17f-0017-37c5-a5f9-ad1d5de969b6",
                                        "glosses": [
                                            "Doldenblütler, wegen seines würzigen, ätherischen Öls ein verbreitetes Küchenkraut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1177c31a-0a67-4ab0-8db9-28ec1875e2c4",
                                                "sense_id": "18669e02-4fff-3050-9e50-8690d9a43a9e",
                                                "text": "Meine Mutter hatte stets Petersilie im Gemüsegarten angebaut."
                                            },
                                            {
                                                "example_id": "2790efb4-e8f9-426b-9c71-5b7144ab54d7",
                                                "sense_id": "18669e02-4fff-3050-9e50-8690d9a43a9e",
                                                "text": "Die Wurzelpetersilie ist ein harntreibendes Volksheilmittel."
                                            },
                                            {
                                                "example_id": "8f7e53a4-ef2a-4b3c-ad39-15d24d8b12ec",
                                                "sense_id": "18669e02-4fff-3050-9e50-8690d9a43a9e",
                                                "text": "„Außerdem legte er um das Haus herum Gemüsebeete an und pflanzte Petersilie, Dill, Schnittlauch, Mohrrüben, Kopfsalat und Fleischtomaten.“"
                                            },
                                            {
                                                "example_id": "6cce22ea-a381-423e-af38-79b50c3dbb08",
                                                "sense_id": "18669e02-4fff-3050-9e50-8690d9a43a9e",
                                                "text": "„Petersilie sollte in Ihrem Kräutergarten nicht fehlen: Das knallgrüne Kraut enthält Vitamin C, Vitamin K und Folsäure sowie wichtige Mineralstoffe.“"
                                            },
                                            {
                                                "example_id": "6be48926-a847-4341-b410-4396924b4903",
                                                "sense_id": "18669e02-4fff-3050-9e50-8690d9a43a9e",
                                                "text": "„Praktischer als Petersilie jedes Mal im Supermarkt zu kaufen, ist es, das Küchenkraut selber anzupflanzen.“"
                                            },
                                            {
                                                "example_id": "826fb3ff-86e3-4d2d-bcb3-0c04c4f31542",
                                                "sense_id": "18669e02-4fff-3050-9e50-8690d9a43a9e",
                                                "text": "[…] „Petersilie ist pflegeleicht und wächst auch auf dem Balkon oder der Fensterbank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8aa65f96-5ba4-4943-b764-d93c70a1f97d",
