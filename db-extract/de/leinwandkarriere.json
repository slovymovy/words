                    {
                        "sense_id": "821d27c7-7e9a-3f08-b78a-16b072510a5a",
                        "entry_id": "fb30bed7-73ba-36a4-859a-dd72636764ab",
                        "glosses": [
                            "(erfolgreicher) Werdegang eines Filmschauspielers"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dd2e5f1e-7bf8-427a-9b32-d325a22d0c44",
                                "sense_id": "821d27c7-7e9a-3f08-b78a-16b072510a5a",
                                "text": "„Der Filmstar begann seine Leinwandkarriere 1965 und hat seither in fast 70 Filmen mitgewirkt.“"
                            },
                            {
                                "example_id": "2c2849c9-1b87-44b5-94c3-30391500cfe3",
                                "sense_id": "821d27c7-7e9a-3f08-b78a-16b072510a5a",
                                "text": "„Nach einer weiteren Oscar-Nominierung 1969 für das Ehedrama ‚The Happy Ending‘ (mit John Forsythe und Lloyd Bridges) ging es mit ihrer Leinwandkarriere ab den siebziger Jahren bergab.“"
                            },
                            {
                                "example_id": "c091a26b-30b8-4b40-a586-93a3f634d796",
                                "sense_id": "821d27c7-7e9a-3f08-b78a-16b072510a5a",
                                "text": "„In den Münchner Bavaria Filmstudios entstanden zahlreiche unkritische Spielfilme und etliche Leinwandkarrieren begannen dort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
