                    {
                        "translation_id": "738dbc7e-cfe1-44c0-abef-dc66d2bae580",
                        "source_entry_id": "d3c72369-8d0b-30fd-a76d-52a6a79dfe2d",
                        "source_sense_id": "07770030-bb04-32ff-939a-a32681f4245f",
                        "target_lang_word": "nearer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nearer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b538ca3-fa98-3b47-89d7-ce42fe1c3b3f",
                                        "entry_id": "2622fbe4-e9f3-3c63-b4d7-1d185c91ca3f",
                                        "glosses": [
                                            "Less distant; comparative form of near: more near."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b6c1bc-c187-4fc9-8e12-1cdb57740191",
                                                "sense_id": "8b538ca3-fa98-3b47-89d7-ce42fe1c3b3f",
                                                "text": "There are two pubs in the town; the nearer one is about a five-minute walk away."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nearer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ecd21b-7160-3386-a743-b955bf4c01b1",
                                        "entry_id": "bf78eecc-b537-370c-9b1a-6940a30cc0a4",
                                        "glosses": [
                                            "Closer to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abc44c72-cb95-495b-b513-1469ec6b5549",
                                                "sense_id": "a6ecd21b-7160-3386-a743-b955bf4c01b1",
                                                "text": "I'd like to live nearer the office."
                                            },
                                            {
                                                "example_id": "e2a5a0b3-50df-4e8c-91cd-9fba768b0720",
                                                "sense_id": "a6ecd21b-7160-3386-a743-b955bf4c01b1",
                                                "text": "I’ll tell you nearer the time what to do."
                                            },
                                            {
                                                "example_id": "ea708dde-4377-42e8-ba00-fe1d95507169",
                                                "sense_id": "a6ecd21b-7160-3386-a743-b955bf4c01b1",
                                                "text": "I still seem to be no nearer a solution."
                                            },
                                            {
                                                "example_id": "b2797c8c-1ffe-4fce-a319-fc1edb248c7d",
                                                "sense_id": "a6ecd21b-7160-3386-a743-b955bf4c01b1",
                                                "text": "The star grew—it grew with a terrible steadiness hour after hour, a little larger each hour, a little nearer the midnight zenith, and brighter and brighter, until it had turned night into a second day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d0846fa-13ef-4a1c-9b80-041aebfee666",
                        "source_entry_id": "d3c72369-8d0b-30fd-a76d-52a6a79dfe2d",
                        "source_sense_id": "07770030-bb04-32ff-939a-a32681f4245f",
                        "target_lang_word": "closer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "closer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b3fd68c-3c59-3dfb-bb5e-d5500992a61c",
                                        "entry_id": "b8df1886-edd0-3f18-b805-a466f048e1a8",
                                        "glosses": [
                                            "comparative form of close: more close"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29393799-9e4e-411d-90c1-8cb597b0335b",
                                                "sense_id": "5b3fd68c-3c59-3dfb-bb5e-d5500992a61c",
                                                "text": "In the spring of 1938 the Japanese imperialists invaded Yü-tz'u and T'ai-ku in Shansi. Everyone was in panic as the flames of war came closer and closer to Hsiang-yüan hsien."
                                            },
                                            {
                                                "example_id": "6bbf30be-99bb-475f-8d83-a1dadb09ef99",
                                                "sense_id": "5b3fd68c-3c59-3dfb-bb5e-d5500992a61c",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across. Such pits are about the size of a bacterial cell. Closer examination showed that some of these pits did, indeed, contain bacteria, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "280b5cb9-74ed-3283-b7cf-0d0d751c59ae",
                                        "entry_id": "b8df1886-edd0-3f18-b805-a466f048e1a8",
                                        "glosses": [
                                            "Within a shorter distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "797af464-ab7b-44db-a780-9da6cc8f6475",
                                                "sense_id": "280b5cb9-74ed-3283-b7cf-0d0d751c59ae",
                                                "text": "Come closer, my dear."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "closer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1aa63738-51f0-3779-bbd2-2df914172b4b",
                                        "entry_id": "aebc2cc6-45f2-38f2-8aa4-f26d71e414cf",
                                        "glosses": [
                                            "Someone or something that closes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5723b246-1793-4a39-b410-60f220b5641a",
                                                "sense_id": "1aa63738-51f0-3779-bbd2-2df914172b4b",
                                                "text": "In our organization, the VP of Sales usually acts as the closer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0536f19-fe90-3438-9341-b6f53ea88937",
                                        "entry_id": "aebc2cc6-45f2-38f2-8aa4-f26d71e414cf",
                                        "glosses": [
                                            "Someone or something that concludes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f3a7108-6603-4db2-aefc-ac58f0a2690d",
                                                "sense_id": "a0536f19-fe90-3438-9341-b6f53ea88937",
                                                "text": "The DJ chose a fantastic track as his closer at the end of the night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2de9ec24-95a9-3422-8a42-fda2bd97b73d",
                                        "entry_id": "aebc2cc6-45f2-38f2-8aa4-f26d71e414cf",
                                        "glosses": [
                                            "Synonym of close (“the point at the end of a sales pitch when the consumer is asked to buy”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7250de0b-9c11-3dcc-a6e2-1d322e793e14",
                                        "entry_id": "aebc2cc6-45f2-38f2-8aa4-f26d71e414cf",
                                        "glosses": [
                                            "The last stone in a horizontal course, if smaller than the others; a piece of brick finishing a course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36142dc5-1ba7-4331-b9bd-df10084f2bea",
                                                "sense_id": "7250de0b-9c11-3dcc-a6e2-1d322e793e14",
                                                "text": "The longitudinal bond of the walls is only 24 inches, or one fourth of the length of a brick of 9 inches, and is obtained by introducing closers 24 inches broad"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0656b93f-54bb-3e09-8bb7-ea844a24a30a",
                                        "entry_id": "aebc2cc6-45f2-38f2-8aa4-f26d71e414cf",
                                        "glosses": [
                                            "A relief pitcher who specializes in getting the last three outs of the game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd0aa0b2-34d8-4290-add4-499597f108db",
                                                "sense_id": "0656b93f-54bb-3e09-8bb7-ea844a24a30a",
                                                "text": "They brought their closer in for the ninth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e26a0180-2785-357a-a6a6-6c08b867d388",
                                        "entry_id": "aebc2cc6-45f2-38f2-8aa4-f26d71e414cf",
                                        "glosses": [
                                            "A horse that performs best toward the end of a race."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
