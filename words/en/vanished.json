            "senses": [
                {
                    "sense_id": "e90671b6-cb8e-3f7e-9e32-e63ad59b9a31",
                    "sense_definition": "No longer existing or visible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disappearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers searched for traces of the <w>vanished</w> civilization in the deep jungle.",
                            "target_lang_translations": {
                                "ru": "Исследователи искали следы <w>исчезнувшей</w> цивилизации в глубине джунглей."
                            }
                        },
                        {
                            "text": "He felt like a ghost from a <w>vanished</w> era of history.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя призраком из <w>исчезнувшей</w> исторической эпохи."
                            }
                        }
                    ],
                    "synonyms": [
                        "extinct",
                        "gone",
                        "lost"
                    ],
                    "antonyms": [
                        "extant",
                        "existing"
                    ],
                    "common_phrases": [
                        "vanished world",
                        "vanished era"
                    ],
                    "target_lang_definitions": {
                        "ru": "Больше не существующий или невидимый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчезнувший",
                                "target_lang_sense_clarification": "тот, который перестал существовать или быть видимым"
                            },
                            {
                                "target_lang_word": "утраченный",
                                "target_lang_sense_clarification": "потерянный или исчезнувший из виду"
