                    }
                ],
                "senses": [
                    {
                        "sense_id": "e40853e6-4d14-3506-b590-c4f734525562",
                        "entry_id": "f6a85cc6-bb3a-3cff-8388-a062796323fc",
                        "glosses": [
                            "фин. не приносящий прибыли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f580031d-9dcd-45d9-a4bd-005a9c72034d",
                                "sense_id": "e40853e6-4d14-3506-b590-c4f734525562",
                                "text": "Отсутствие должной информации о финансовой поддержке бесприбыльных организаций, которые решают социально-правовые проблемы малоимущего населения, является серьёзным препятствием для широкого участия в ней бизнесменов."
                            },
                            {
                                "example_id": "97c48961-0b21-4e6c-b00f-b2348094972c",
                                "sense_id": "e40853e6-4d14-3506-b590-c4f734525562",
                                "text": "Римский клуб был зарегистрирован в Женеве как бесприбыльная гражданская ассоциация."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d953b52-5ea7-4792-99c7-d225b8bf8b0a",
                        "source_entry_id": "f6a85cc6-bb3a-3cff-8388-a062796323fc",
                        "source_sense_id": "e40853e6-4d14-3506-b590-c4f734525562",
                        "target_lang_word": "profitless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profitless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f76f925-e27e-33d3-8b2b-618462c4b939",
                                        "entry_id": "51d093df-ef8f-306f-b790-e004735579db",
                                        "glosses": [
                                            "not yielding profit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f21d8514-b5ad-470f-8004-c6b39f75b94d",
                                                "sense_id": "6f76f925-e27e-33d3-8b2b-618462c4b939",
                                                "text": "I pray thee, cease thy counsel,\nWhich falls into mine ears as profitless\nAs water in a sieve..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ab276af-99b6-4430-915e-2cff5f32adca",
                        "source_entry_id": "f6a85cc6-bb3a-3cff-8388-a062796323fc",
                        "source_sense_id": "e40853e6-4d14-3506-b590-c4f734525562",
                        "target_lang_word": "unprofitable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unprofitable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a513ac5-65ee-30ed-bfba-a3423ef80116",
                                        "entry_id": "89ab3a5c-3380-3955-9a76-ee7e2ec30bbd",
                                        "glosses": [
                                            "Not making a profit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b4f94ab-0741-4499-ad5e-b18ba2bee313",
                                                "sense_id": "5a513ac5-65ee-30ed-bfba-a3423ef80116",
                                                "text": "Being a professional poet is a nice job, albeit unprofitable."
                                            },
                                            {
                                                "example_id": "5c6b3165-6835-4991-95bf-9791a9343be5",
                                                "sense_id": "5a513ac5-65ee-30ed-bfba-a3423ef80116",
                                                "text": "The undermediators are not required, have nothing properly to do, no peculiar duty to perform; but are an unprofitable or inutile set of beings sitting down and looking at each other through want of other occupation."
                                            },
                                            {
                                                "example_id": "6c1ce537-0aaa-467f-bc4d-24a98411de26",
                                                "sense_id": "5a513ac5-65ee-30ed-bfba-a3423ef80116",
                                                "text": "Soon after breakfast Miss Matilda, having galloped and blundered through a few unprofitable lessons, and vengeably thumped the piano for an hour, in a terrible humour with both me and it, because her mama would not give her a holiday, […]"
                                            },
                                            {
                                                "example_id": "336825e0-8587-4679-871e-df787393e7e3",
                                                "sense_id": "5a513ac5-65ee-30ed-bfba-a3423ef80116",
                                                "text": "In some places, however, quartz reefs, payably auriferous while in Silurian rock, have been followed down to subjacent granite, and have there been found to thin out and become unprofitable […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unprofitable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a3d38fd-0624-39e7-aa99-f5d0e826be2e",
                                        "entry_id": "6c8dc21d-0af9-3d1d-8249-80b754b0715c",
                                        "glosses": [
                                            "A person or thing that fails to make a profit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8abc57b7-0602-46ca-bcd3-c409068b9ffc",
                        "source_entry_id": "f6a85cc6-bb3a-3cff-8388-a062796323fc",
                        "source_sense_id": "e40853e6-4d14-3506-b590-c4f734525562",
                        "target_lang_word": "unprofitabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "968524f0-1f4c-49eb-a584-0cdf2377f938",
                        "source_entry_id": "f6a85cc6-bb3a-3cff-8388-a062796323fc",
                        "source_sense_id": "e40853e6-4d14-3506-b590-c4f734525562",
                        "target_lang_word": "unrentabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unrentabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2758d2f1-58eb-35dd-95ad-9a3a104dd797",
                                        "entry_id": "7fc200ba-bd24-3099-afad-71b4904e8a88",
                                        "glosses": [
                                            "nicht rentabel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c07678f-2628-4211-8a7f-7980dd9dde20",
                                                "sense_id": "2758d2f1-58eb-35dd-95ad-9a3a104dd797",
                                                "text": "„Als der Zugverkehr auf dieser unrentablen Strecke im September 1968 eingestellt wurde, fiel das fast auf den Tag genau mit dem Ende unserer Jugendzeit zusammen, denn nur wenige Monate später gingen wir, in alle Winde verstreut, jeder für sich seinen Weg.“"
                                            },
                                            {
                                                "example_id": "18331b36-01f8-427f-8abc-4b8c68f2d981",
                                                "sense_id": "2758d2f1-58eb-35dd-95ad-9a3a104dd797",
                                                "text": "„Der Erdöl- und Gaskonzern OMV denkt im Zuge seiner Strategieüberprüfung auch über einen Verkauf seines unrentablen türkischen Gaskraftwerks nach.“"
                                            },
                                            {
                                                "example_id": "6f7cfa0f-2228-4a2e-a622-e850feab6ef2",
                                                "sense_id": "2758d2f1-58eb-35dd-95ad-9a3a104dd797",
                                                "text": "„Als die Briten nach Nordwestindien vordrangen, verkauften sie 1846 große Teile von Jammu und Kaschmir für ca. eine Million Pfund an den Dografürsten Gulab Singh, da sie die Region für wirtschaftlich unrentabel hielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
