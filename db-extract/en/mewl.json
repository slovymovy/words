                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "eb06d35a-bf8f-4411-b94f-fe114c0e72e4",
                        "entry_id": "216f2b49-1b2b-3bac-89e9-720be7e096ae",
                        "tags": [
                            "plural"
                        ],
                        "form": "mewls"
