                "senses": [
                    {
                        "sense_id": "e89f5df6-af13-30b7-a253-0fada5a25206",
                        "entry_id": "5c5af373-b734-3740-9ff0-4a73eb3ba857",
                        "glosses": [
                            "Untersuchung, bei der ein Thema zu einem Zeitpunkt/-abschnitt an einer Versuchspersonengruppe untersucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1202d287-0eaf-4f45-a7cc-1593706a96f4",
                                "sense_id": "e89f5df6-af13-30b7-a253-0fada5a25206",
                                "text": "„Dass Themen, die nur lose miteinander verknüpft sind, nicht mehr zulässig sein sollen, halten die Rechtsanwälte für ‚nicht zweckmäßig‘, da je nach Sachlage auch eine derartige Querschnittsuntersuchung sinnvoll sein könne.“"
                            },
                            {
                                "example_id": "d3c341cb-172d-4996-815a-69b1c52a2100",
                                "sense_id": "e89f5df6-af13-30b7-a253-0fada5a25206",
                                "text": "„Für jedes der Jahre 2000 bis 2003 wurden Querschnittsuntersuchungen der Stichprobe angestellt.“"
                            },
                            {
                                "example_id": "6322cf44-e8fa-452f-b17c-41d0ecdf8a8f",
                                "sense_id": "e89f5df6-af13-30b7-a253-0fada5a25206",
                                "text": "„Es will vielmehr den traurigen Anlass für eine Querschnittsuntersuchung nutzen, erklärt Erik Lund, Mitarbeiter der Wildtier-Sektion des Amts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
