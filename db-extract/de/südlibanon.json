                ],
                "senses": [
                    {
                        "sense_id": "26fea23a-7a46-3965-9843-7a9b582d050f",
                        "entry_id": "c117bd24-9029-333c-a6f6-f9dba5a3c15a",
                        "glosses": [
                            "südlicher Teil des Libanon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec12b7c9-9017-4181-a38c-5fc122621ea9",
                                "sense_id": "26fea23a-7a46-3965-9843-7a9b582d050f",
                                "text": "„Hiram war der Name des biblischen Königs Hiram von Tyros (Sur), das zu den Zielen dieser ehrgeizigen Expansionspläne gehörte: Israels Eroberung Obergaliläas und des Südlibanon.“"
                            },
                            {
                                "example_id": "efc6d569-f88f-4f5d-a92c-cc4b657b395d",
                                "sense_id": "26fea23a-7a46-3965-9843-7a9b582d050f",
                                "text": "„Politische bewanderte Insassen nannten es Ansar III, nach dem Gefängnis nahe der Stadt Ansar, das Israel bei der Besetzung des Südlibanons errichtet hatte.“"
                            },
                            {
                                "example_id": "40c57684-4115-42aa-a394-6e95151ebece",
                                "sense_id": "26fea23a-7a46-3965-9843-7a9b582d050f",
                                "text": "„Anfang der 1970er erlebte ich im Südlibanon, wie Habasch das Publikum trotz der Komplexität seiner Ideen stundenlang in Atem halten konnte.“"
                            },
                            {
                                "example_id": "513798d9-749a-4515-94de-202b29796200",
                                "sense_id": "26fea23a-7a46-3965-9843-7a9b582d050f",
                                "text": "„Dieses Mal ging es nicht nur darum, eine Pufferzone im Südlibanon einzurichten, sondern das ›Palästinenserproblem‹ ein für alle Mal zu lösen, also Arafat zu beseitigen, die PLO-Strukturen zu zerschlagen und die palästinensischen Kämpfer aus dem Libanon zu vertreiben.“"
                            },
                            {
                                "example_id": "e42d062f-d93e-4e73-8574-1bf8a0f45c00",
                                "sense_id": "26fea23a-7a46-3965-9843-7a9b582d050f",
                                "text": "„Tod, Aushungern und Verfolgung gehören inzwischen zum politischen Dialog, und nicht einmal das Kabinett bildet darin eine Ausnahme. Ihre Stimmen sind laut und deutlich zu hören, oft vom Rednerpult der Knesset, wenn sie über Gaza, Judäa, Samaria und Südlibanon reden.“"
                            },
                            {
                                "example_id": "e9206a6f-fce8-4bd0-8b92-cbc384444c03",
                                "sense_id": "26fea23a-7a46-3965-9843-7a9b582d050f",
                                "text": "„Israel war damals nicht nur Nachbarland, sondern seit Juni 1982 als Besatzungsmacht im Südlibanon präsent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
