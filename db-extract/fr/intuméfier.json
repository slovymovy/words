                ],
                "senses": [
                    {
                        "sense_id": "74bc7e59-3be2-3880-8434-a12e9f39bad5",
                        "entry_id": "54661bc9-5074-33cd-babc-9fb05aba0b08",
                        "glosses": [
                            "Gonfler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b4a10e-2014-491a-9c57-58a4b8a52cc7",
                                "sense_id": "74bc7e59-3be2-3880-8434-a12e9f39bad5",
                                "text": "L’écoulement, dans l'hypothèse même où la compression aidée des réfrigérants l’aurait arrêté, n’en laisse pas moins, après lui, des caillots qui intuméfient les moignons, irritent les parties, sqppurent, tombent en putrilage et deviennent une cause active d’infection purulente."
                            },
                            {
                                "example_id": "d5fc5311-f279-4de5-af49-f42e925e152f",
                                "sense_id": "74bc7e59-3be2-3880-8434-a12e9f39bad5",
                                "text": "Le moi se gonfle, s’intuméfie, s’étale, expose toutes ses hideurs."
                            },
                            {
                                "example_id": "407464ec-45cb-4595-a322-71abe87a1aad",
                                "sense_id": "74bc7e59-3be2-3880-8434-a12e9f39bad5",
                                "text": "Mais à présent Ajax est seul; déjà son cœur s’intuméfie ;"
                            }
                        ]
                    }
                ],
