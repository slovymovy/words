                },
                {
                    "sense_id": "67ec0274-98fa-395f-a67f-883024d26df5",
                    "sense_definition": "To return to the ownership of a former owner or their legal heirs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the lease expires, the property will <w>revert</w> to the original land owner.",
                            "target_lang_translations": {
                                "ru": "Когда срок аренды истечет, имущество <w>вернется</w> к первоначальному владельцу земли."
                            }
                        },
                        {
                            "text": "The rights will <w>revert</w> to the author after five years.",
                            "target_lang_translations": {
                                "ru": "Права <w>перейдут обратно</w> к автору через пять лет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "revert to the owner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращаться в собственность прежнего владельца или его законных наследников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращаться",
                                "target_lang_sense_clarification": "в собственность законного владельца"
                            },
                            {
                                "target_lang_word": "переходить обратно",
                                "target_lang_sense_clarification": "к прежнему владельцу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "148c95a0-456f-31d9-9009-87bb22a5edf8",
