                "senses": [
                    {
                        "sense_id": "225cd4df-91fa-3c4e-9abd-00fca04a0c5d",
                        "entry_id": "77712456-7278-3326-a6a0-bb54247fe1c5",
                        "glosses": [
                            "Décomposer par une réaction de déshydrolyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "348fa2ca-5f3f-4a1b-aba6-b47371f671f6",
                                "sense_id": "225cd4df-91fa-3c4e-9abd-00fca04a0c5d",
                                "text": "Est-il possible de le « déshydrolyser » ?"
                            },
                            {
                                "example_id": "f968725f-f97a-4bb4-ab63-2afb5455a26c",
                                "sense_id": "225cd4df-91fa-3c4e-9abd-00fca04a0c5d",
                                "text": "D’autre part, dans le processus de transformation de gros globules gras en petits globules gras, la membrane phospholipidique intacte originale des globules gras du lait est détruite, de sorte que la lipase initialement bloquée par la membrane peut pénétrer dans les globules gras pour déshydrolyser les triglycérides."
                            },
                            {
                                "example_id": "0c302feb-87bc-4705-adc2-cae6598031c4",
                                "sense_id": "225cd4df-91fa-3c4e-9abd-00fca04a0c5d",
                                "text": "La résine phénolique thermodurcissable est principalement liquide à température ambiante, et elle se déshydrolyse pour dégager de l’eau pendant le chauffage."
                            }
                        ]
                    }
