                    {
                        "translation_id": "f02dc8bf-d9b9-40dd-b6ba-ccbd3103a15f",
                        "source_entry_id": "f0df5625-c962-3371-86f6-68a2818663e6",
                        "source_sense_id": "44ff48f8-910e-3260-a1b4-43e43a3f5311",
                        "target_lang_word": "Konditorei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konditorei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f66d9ba9-c8da-3530-91ad-affd28b086b7",
                                        "entry_id": "bc76e1ae-c6a5-344d-81d2-7a78add590a6",
                                        "glosses": [
                                            "Gewerbefachbetrieb zur Herstellung von Kuchen, Torten und Plätzchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd58f10-153c-4677-afc1-380b6d278fbc",
                                                "sense_id": "f66d9ba9-c8da-3530-91ad-affd28b086b7",
                                                "text": "Ich geh' mal schnell in die Konditorei nebenan und kaufe Törtchen."
                                            },
                                            {
                                                "example_id": "47ff22d3-313d-44ed-b4f9-60d1d945f793",
                                                "sense_id": "f66d9ba9-c8da-3530-91ad-affd28b086b7",
                                                "text": "„Jeden Tag sitze ich in der kleinen Konditorei gegenüber dem Theater und warte auf sie.“"
                                            },
                                            {
                                                "example_id": "6789ee64-ad8e-4642-bfd6-8b7aeb372021",
                                                "sense_id": "f66d9ba9-c8da-3530-91ad-affd28b086b7",
                                                "text": "„Wir gingen dann in die Konditorei, und es gab dort sehr viele Kuchen und Torten in einer langen Vitrine.“"
                                            },
                                            {
                                                "example_id": "87f78003-3ee6-45ce-828c-ed61d8c4cd95",
                                                "sense_id": "f66d9ba9-c8da-3530-91ad-affd28b086b7",
                                                "text": "„Konditoreien, Bierkneipen und Wurstläden säumten den Weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9aad6de6-2330-4071-b2af-da269b0026dc",
                        "source_entry_id": "f0df5625-c962-3371-86f6-68a2818663e6",
                        "source_sense_id": "44ff48f8-910e-3260-a1b4-43e43a3f5311",
                        "target_lang_word": "кондитерская",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кондитерская",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a24d3148-558a-391a-a6ac-26ca1ad215bf",
                                        "entry_id": "2c28bb87-40b6-32bf-b0b2-8c9765ac3586",
                                        "glosses": [
                                            "устар. предприятие и помещение, в котором изготовляются и продаются кондитерские изделия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7597380-0e2a-4b2e-ab60-ff64b946fd8e",
                                                "sense_id": "a24d3148-558a-391a-a6ac-26ca1ad215bf",
                                                "text": "С Кузнецкого моста я заехал в кондитерскую на Тверской и, хотя желал притвориться, что меня в кондитерской преимущественно интересуют газеты, не мог удержаться и начал есть один сладкий пирожок за другим."
                                            },
                                            {
                                                "example_id": "1d4007a7-1072-4cad-ba94-cc117826c650",
                                                "sense_id": "a24d3148-558a-391a-a6ac-26ca1ad215bf",
                                                "text": "Апельсины и пряники поели ещё до моего прихода сенаторские и графские дети, а четыре двугривенных у меня тотчас же отнял Ламберт; на них накупили они в кондитерской пирожков и шоколаду и даже меня не попотчевали."
                                            },
                                            {
                                                "example_id": "7c7253bb-1dd8-44d5-914c-e1e5a4a71236",
                                                "sense_id": "a24d3148-558a-391a-a6ac-26ca1ad215bf",
                                                "text": "Он распахнул стеклянную дверь кондитерской, положил шляпу на столик, налил воды из графина и заказал кельнерше порцию мороженого."
                                            },
                                            {
                                                "example_id": "1b177494-3ae4-4b59-b8cc-940f3af77ba2",
                                                "sense_id": "a24d3148-558a-391a-a6ac-26ca1ad215bf",
                                                "text": "Продавец с облегчением увидел, что в кондитерской только поварята, а трёх главных кондитеров нет."
                                            }
                                        ]
                                    },
