                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The silence in the room was <w>disconcertingly</w> heavy after the argument ended.",
                            "target_lang_translations": {
                                "de": "Die Stille im Raum war nach dem Streit <w>verunsichernd</w> schwer."
                            }
                        },
                        {
                            "text": "He smiled <w>disconcertingly</w> while explaining the serious nature of the problem.",
                            "target_lang_translations": {
                                "de": "Er lächelte <w>beunruhigend</w>, während er den ernsten Charakter des Problems erklärte."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsettlingly",
                        "disturbingly",
                        "worryingly"
                    ],
                    "common_phrases": [
                        "disconcertingly quiet",
                        "disconcertingly calm"
                    ],
                    "target_lang_definitions": {
