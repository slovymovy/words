                                "example_id": "4127b171-6896-48d0-bffa-088970933096",
                                "sense_id": "2392048a-57f2-3dd4-bcd4-f7bf87cd9111",
                                "text": "„Straßenkinder leben heute in den Ländern Südamerikas (u. a. in Brasilien), in osteuropäischen Gesellschaften (u. a. in Rumänien) und teilweise auch in westlichen Industrienationen.“"
                            }
