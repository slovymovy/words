                ],
                "senses": [
                    {
                        "sense_id": "f798b0d3-3a4a-3083-be03-ea8e2771263a",
                        "entry_id": "0b4aef5c-861b-320d-b337-c42787f2cdb1",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecb138ad-7cbf-41bc-aaeb-b06434cac1e9",
                                "sense_id": "f798b0d3-3a4a-3083-be03-ea8e2771263a",
                                "text": "Frau Devanthey ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f5f23098-85da-47f1-964f-b1363ea1bd79",
                                "sense_id": "f798b0d3-3a4a-3083-be03-ea8e2771263a",
                                "text": "Herr Devanthey wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fb9510f9-3ad3-4550-ab0d-e12fa8d48061",
                                "sense_id": "f798b0d3-3a4a-3083-be03-ea8e2771263a",
                                "text": "Die Devantheys kommen heute aus dem Allgäu."
                            },
                            {
                                "example_id": "b375a0a0-e91f-4ae9-83f2-7fe7f840ccce",
                                "sense_id": "f798b0d3-3a4a-3083-be03-ea8e2771263a",
                                "text": "Der Devanthey trägt nie die Schals, die die Devanthey ihm strickt."
                            },
                            {
                                "example_id": "f9505226-09bf-4ac2-b961-49752f91f9b7",
                                "sense_id": "f798b0d3-3a4a-3083-be03-ea8e2771263a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Devanthey kommt, geht der Herr Devanthey.“"
                            },
                            {
                                "example_id": "e2558d59-a427-4436-9480-e8c91bb9dae6",
                                "sense_id": "f798b0d3-3a4a-3083-be03-ea8e2771263a",
                                "text": "Devanthey kommt und geht."
                            },
                            {
                                "example_id": "b644da26-ea7b-442d-8da6-ee59e23533f0",
                                "sense_id": "f798b0d3-3a4a-3083-be03-ea8e2771263a",
                                "text": "Devantheys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
