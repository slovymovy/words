                "senses": [
                    {
                        "sense_id": "a6af609e-063d-3816-8a03-fcf9aac1130c",
                        "entry_id": "207f5a29-cb14-3b5e-8b81-4924209aa861",
                        "glosses": [
                            "historische Untersuchung, wie Menschen vergangener Zeiten im Alltag lebten"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ebff8ed7-1f0e-451a-bb4f-e43541242253",
                                "sense_id": "a6af609e-063d-3816-8a03-fcf9aac1130c",
                                "text": "„An der Grabungsstätte am Donaumarkt in der Domstadt waren verkohlte Reste von Semmeln, einer Brezel und eines Hörnchen aus dem 18. Jahrhundert gefunden worden. Der Fund sei etwas Besonderes, weil er ein Stück Alltagsgeschichte beschreibe, sagte der Regensburger Oberbürgermeister Joachim Wolbergs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4fda6d3-027c-31d5-b732-7bcbcbc1658d",
                        "entry_id": "207f5a29-cb14-3b5e-8b81-4924209aa861",
                        "glosses": [
                            "eine Geschichte aus dem Alltag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3a9d98e-325f-4ec1-b466-cfbc00c2c889",
                                "sense_id": "a4fda6d3-027c-31d5-b732-7bcbcbc1658d",
                                "text": "„Eine sympathische Alltagsgeschichte folgte 1998 mit Sam Millers Melodram \"Among Giants\" und in Nick Willins Lewis Carroll-Verfilmung \"Alice im Wunderland\" gehörte er zum Edel-Cast um Robbie Coltrane, Whoopi Goldberg und Ben Kingsley. „"
                            },
                            {
                                "example_id": "7586c34d-2b7f-4658-ac70-48f295ed424c",
                                "sense_id": "a4fda6d3-027c-31d5-b732-7bcbcbc1658d",
                                "text": "„Wir werden dabei zunächst verschiedene einfache und mehr oder weniger harmlose Alltagsgeschichten erzählen, um uns und Sie mit der Wahrscheinlichkeitslogik vertraut zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
