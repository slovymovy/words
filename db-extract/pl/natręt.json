                                        "sense_id": "3442e2ee-c8a6-3c6b-b3cc-b9315e237e6d",
                                        "entry_id": "613c6937-88eb-3b16-83fd-7eb2f7c35a87",
                                        "glosses": [
                                            "A minor annoyance or inconvenience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca86ab1-b8da-4e57-a66a-e4f554186fb8",
                                                "sense_id": "3442e2ee-c8a6-3c6b-b3cc-b9315e237e6d",
                                                "text": "The neighbor's dog barking throughout the night is a right nuisance - I'm going to complain."
                                            },
                                            {
                                                "example_id": "c5ff36ba-fad4-4744-b1a7-cbe7c32c3a97",
                                                "sense_id": "3442e2ee-c8a6-3c6b-b3cc-b9315e237e6d",
                                                "text": "What a nuisance to have to go now!"
                                            },
                                            {
                                                "example_id": "15ea9178-e425-44e0-9935-592617e8210d",
                                                "sense_id": "3442e2ee-c8a6-3c6b-b3cc-b9315e237e6d",
                                                "text": "By itself, nondifferentiability at zero is a minor nuisance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58e889ce-7cc1-3dcb-8c0e-ccd0a3aa3aaa",
                                        "entry_id": "613c6937-88eb-3b16-83fd-7eb2f7c35a87",
                                        "glosses": [
                                            "A person or thing causing annoyance or inconvenience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace243fe-85f0-45ed-8f18-a4229c6e7d2a",
                                                "sense_id": "58e889ce-7cc1-3dcb-8c0e-ccd0a3aa3aaa",
                                                "text": "You can be such a nuisance when you don't get your way."
                                            },
                                            {
                                                "example_id": "f57b9675-551d-45a0-97ac-5a43126e6fa4",
                                                "sense_id": "58e889ce-7cc1-3dcb-8c0e-ccd0a3aa3aaa",
                                                "text": "With Vardy working tirelessly up front, chasing lost causes and generally making a nuisance of himself, Sevilla were never allowed to settle on a night when the atmosphere was electric inside the King Power Stadium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aa4cf19-c195-3419-832a-d63475b99119",
                                        "entry_id": "613c6937-88eb-3b16-83fd-7eb2f7c35a87",
                                        "glosses": [
