{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00207614-80be-3f77-a7e9-81f0f5e6ea93",
                    "sense_definition": "A large fruit with a hard green rind and sweet, juicy red flesh inside.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ate a slice of sweet <w>watermelon</w> on a hot afternoon. ",
                            "target_lang_translations": {
                                "zh": "在一个炎热的下午，我们吃了一片甜甜的<w>西瓜</w>。"
                            }
                        },
                        {
                            "text": "She bought a whole <w>watermelon</w> at the local farmers market.",
                            "target_lang_translations": {
                                "zh": "她在当地的农贸市场买了一个完整的<w>西瓜</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slice of watermelon",
                        "juicy watermelon"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种个头很大的水果，外皮坚硬呈绿色，里面是香甜多汁的红色果肉。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "西瓜",
                                "target_lang_sense_clarification": "指水果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5c60bf0-74f7-364a-8b69-a74e2ff321a1",
                    "sense_definition": "The trailing plant that produces watermelons.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer planted <w>watermelon</w> seeds in late spring.",
                            "target_lang_translations": {
                                "zh": "农民在晚春种下了<w>西瓜</w>种子。"
                            }
                        },
                        {
                            "text": "Large green leaves spread across the <w>watermelon</w> plant in the garden.",
                            "target_lang_translations": {
                                "zh": "菜园里的<w>西瓜藤</w>上长满了大片绿叶。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "watermelon plant"
                    ],
                    "target_lang_definitions": {
                        "zh": "结出西瓜的蔓生植物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "西瓜",
                                "target_lang_sense_clarification": "指植株或藤蔓"
                            },
                            {
                                "target_lang_word": "西瓜藤",
                                "target_lang_sense_clarification": "强调藤蔓时用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "497f68e7-65f2-3a0f-9335-90b25abe66ec",
                    "sense_definition": "A light pinkish-red color resembling the flesh of a ripe watermelon.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She painted her nails a bright <w>watermelon</w> shade for summer.",
                            "target_lang_translations": {
                                "zh": "为了迎接夏天，她把指甲涂成了鲜艳的<w>西瓜红</w>。"
                            }
                        },
                        {
                            "text": "His shirt was a soft <w>watermelon</w> color.",
                            "target_lang_translations": {
                                "zh": "他的衬衫是柔和的<w>西瓜红</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "watermelon pink"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种浅粉偏红的颜色，类似成熟西瓜果肉的颜色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "西瓜红",
                                "target_lang_sense_clarification": "指像熟西瓜瓜瓤的浅粉红偏红色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04129221-3b7a-379f-bf16-cc8657de3cc2",
                    "sense_definition": "An environmentalist who holds socialist or left-wing political views.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics dismissed the political movement as just a bunch of political <w>watermelons</w>.",
                            "target_lang_translations": {
                                "zh": "批评者把这场政治运动贬称为一群政治上的<w>绿左</w>。"
                            }
                        },
                        {
                            "text": "The column described political activists who balance ecological concerns with left-wing economics as <w>watermelons</w>.",
                            "target_lang_translations": {
                                "zh": "该专栏把那些兼顾生态议题和左翼经济主张的政治活动人士称为<w>绿左</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal political term"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "带贬义，指在政治立场上倾向社会主义或左翼的环保主义者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绿左",
                                "target_lang_sense_clarification": "贬义，指持环保立场但政治上偏左翼或社会主义的人"
                            },
                            {
                                "target_lang_word": "绿皮红心派",
                                "target_lang_sense_clarification": "比喻说法，强调“外绿内红”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c904b41a-9ade-3d52-b559-043ec087a487",
                    "sense_definition": "A project that appears green or healthy on the surface but is red or failing inside.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager realized the project was a <w>watermelon</w> when the critical deadline was missed.",
                            "target_lang_translations": {
                                "zh": "关键截止日期被错过后，经理意识到这个项目其实是个<w>西瓜项目</w>。"
                            }
                        },
                        {
                            "text": "Clear communication prevents <w>watermelon</w> status reporting in complex corporate teams.",
                            "target_lang_translations": {
                                "zh": "清晰的沟通能防止复杂企业团队中出现<w>西瓜式</w>状态汇报。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "watermelon project"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "business/corporate slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种项目管理中的俚语，指表面看起来一切正常或“绿色健康”，但内部其实已经出问题或接近失败的项目。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "西瓜项目",
                                "target_lang_sense_clarification": "商务/项目管理俚语，指表面看似正常健康、实际内部已出问题的项目"
                            },
                            {
                                "target_lang_word": "西瓜式",
                                "target_lang_sense_clarification": "作定语时常用，指表绿里红的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a57c993-c821-3240-832b-2c1ec1f8389a",
                    "sense_definition": "A very large female breast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian made a rude remark about <w>watermelons</w> during his act.",
                            "target_lang_translations": {
                                "zh": "那位喜剧演员在表演时粗俗地拿<w>大奶子</w>开玩笑。"
                            }
                        },
                        {
                            "text": "The character in the adult comedy was given crude nicknames like <w>watermelons</w>.",
                            "target_lang_translations": {
                                "zh": "这部成人喜剧里的那个角色被起了“<w>大波</w>”之类的粗俗绰号。"
                            }
                        }
                    ],
                    "synonyms": [
                        "breasts"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar or humorous slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "粗俗或戏谑说法，指非常大的女性乳房。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大奶子",
                                "target_lang_sense_clarification": "粗俗说法，指非常大的女性乳房"
                            },
                            {
                                "target_lang_word": "大波",
                                "target_lang_sense_clarification": "粗俗、口语说法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}