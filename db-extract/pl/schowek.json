                        "entry_id": "9ad8e1fa-da31-3dc0-9c42-f8c0731ad48e",
                        "glosses": [
                            "pamięć zarządzana przez system operacyjny, która umożliwia kopiowanie i wklejanie danych w programie albo między programami"
                        ],
                        "tags": [],
