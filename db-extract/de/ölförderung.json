                "senses": [
                    {
                        "sense_id": "949bcc32-d63a-3326-828d-6f6a0464943c",
                        "entry_id": "4967c888-6bd3-32da-b4ac-b562af69b550",
                        "glosses": [
                            "Gewinnung des Erdöls aus einer Lagerstätte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb64a832-6588-4ee8-9ac4-57f227e93c2c",
                                "sense_id": "949bcc32-d63a-3326-828d-6f6a0464943c",
                                "text": "„Diese Initiative sollte im Bereich der Ölförderung für mehr Transparenz sorgen und es den Bürgern ermöglichen, »ihre Regierung zur Rechenschaft zu ziehen«.“"
                            },
                            {
                                "example_id": "ddcda65f-2834-4434-9b5d-0b287f385908",
                                "sense_id": "949bcc32-d63a-3326-828d-6f6a0464943c",
                                "text": "„Die Ölförderung hatte in den 1870er Jahren begonnen, und das Öl aus Baku lieferte damals an die 50 % des weltweit benötigten Öls.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
