                    {
                        "sense_id": "d1930abe-a812-3e35-b710-6815c893e5bd",
                        "entry_id": "0116d9aa-f3a0-3240-aff4-3d4b0fa62517",
                        "glosses": [
                            "Situation d'une personne qui exerce sur une même période plusieurs activités professionnelles."
                        ],
                        "tags": [
                            "Droit du travail"
                        ],
                        "examples": [
                            {
                                "example_id": "1e0d8460-4536-4593-a35f-0ef9ecccaaee",
                                "sense_id": "d1930abe-a812-3e35-b710-6815c893e5bd",
                                "text": "Créteil Soleil est le centième Carrefour à adopter la polyactivité. Vingt-quatre caissières y ont fait le choix d'exercer un second métier cinq heures par semaine."
                            },
                            {
                                "example_id": "f093b4b1-fb31-4255-9b29-d71ca657da60",
                                "sense_id": "d1930abe-a812-3e35-b710-6815c893e5bd",
                                "text": "Les parties constatent que l'activité des casinos implique fréquemment la mise en œuvre d'une polyactivité des salariés qui y sont employés."
                            },
                            {
                                "example_id": "55799790-fba2-4b8b-9d0e-6c6da6c84209",
                                "sense_id": "d1930abe-a812-3e35-b710-6815c893e5bd",
                                "text": "Il est tentant d’imaginer que Corneille aurait conduit deux carrières distinctes, l’une comme officier rouennais, l’autre comme dramaturge parisien. Mais … l’hypothèse d’une polyactivité des premiers dramaturges français paraît en effet plus fonctionnelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "855968fd-3d80-3ef9-afbb-56a69b970741",
                        "entry_id": "0116d9aa-f3a0-3240-aff4-3d4b0fa62517",
                        "glosses": [
                            "Destination multiple d'un bâtiment, généralement public, dans le domaine des sports, des loisirs, de la culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80869135-004a-448d-8a33-2549b509bbd9",
                                "sense_id": "855968fd-3d80-3ef9-afbb-56a69b970741",
                                "text": "La salle polyactivité d'Algolsheim."
                            },
                            {
                                "example_id": "362b79b3-3a95-403a-828a-c071de06bedc",
                                "sense_id": "855968fd-3d80-3ef9-afbb-56a69b970741",
                                "text": "Vendredi 10 juin à 14h30 pour les collégiens et séance tout public à 20h00 à la Salle Jacques Villeret du Centre de Polyactivité de Cornimont."
                            },
                            {
                                "example_id": "a418e637-06a1-409d-8b0f-c4812b8ccbca",
                                "sense_id": "855968fd-3d80-3ef9-afbb-56a69b970741",
                                "text": "La commune s'attache à redonner une seconde vie aux friches. Du centre polyactivités à un éco-quartier, les transformations sont impressionnantes."
                            }
                        ]
                    }
