                "senses": [
                    {
                        "sense_id": "139f35cb-afb4-354f-a701-9dfb81119f61",
                        "entry_id": "63844c28-cecd-32c4-b6fe-db57f657e4fe",
                        "glosses": [
                            "mit Schokolade überzogener Eiweißschaum auf einer Waffel"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "26e7ca4a-a887-4f94-b7c3-3ef5add45217",
                                "sense_id": "139f35cb-afb4-354f-a701-9dfb81119f61",
                                "text": "„Am liebsten waren mir die kleinen, flaumigen Schwedenbomben. Es gab sie im Sechserpack zu kaufen, drei schwarze und drei mit Kokosflocken bestreute, die ich auf eine spezielle Art und Weise aß.“"
                            },
                            {
                                "example_id": "9f4d9440-d246-4141-8f86-fa89d8bbc948",
                                "sense_id": "139f35cb-afb4-354f-a701-9dfb81119f61",
                                "text": "„Die Schwedenbomben werden seit Anfang Oktober 2015 im IZ NÖ-Süd hergestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
