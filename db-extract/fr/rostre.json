                    },
                    {
                        "sense_id": "cad6e7cc-d636-3c6c-8411-7a2871f9ebde",
                        "entry_id": "f5ef0587-9e64-30f9-9cff-aa04a56502ae",
                        "glosses": [
                            "Sculpture d’ornement en forme d’éperon de navire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43ed423f-b5fb-4c1d-9ba6-82ecb84e1a18",
                                "sense_id": "cad6e7cc-d636-3c6c-8411-7a2871f9ebde",
                                "text": "À Bordeaux, des rostres sont visibles sur l’entrée principale de l’Hôtel Fenwick, 1, cours Xavier Arnozan."
                            },
                            {
                                "example_id": "a5e62072-9a43-41df-9269-9b120afc8a09",
                                "sense_id": "cad6e7cc-d636-3c6c-8411-7a2871f9ebde",
                                "text": "Les magistrats eurent toutes les peines du monde à calmer la foule, et ils n’auraient pas réussi sans le secours de plusieurs témoins montés sur les rostres pour affirmer que l’empereur était vivant et sur le chemin du retour."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec0e601c-f961-35c3-8dd6-500824da7179",
                        "entry_id": "f5ef0587-9e64-30f9-9cff-aa04a56502ae",
                        "glosses": [
                            "Trompe de certains insectes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a8b122d9-e04e-3a0a-adf7-135b5221ff09",
                        "entry_id": "f5ef0587-9e64-30f9-9cff-aa04a56502ae",
                        "glosses": [
                            "Museau des cétacés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfbcc7f5-4a52-488e-b8e5-2fa08be65eec",
                                "sense_id": "a8b122d9-e04e-3a0a-adf7-135b5221ff09",
                                "text": "Le Léviathan veut passer en force mais les dauphins l’encerclent, frappant ses flancs et utilisant leurs rostres comme des éperons."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f1f1cff-c715-3f02-a560-38894ac5bfd8",
                        "entry_id": "f5ef0587-9e64-30f9-9cff-aa04a56502ae",
                        "glosses": [
                            "Prolongement rigide de la tête de certains poissons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b614f64-d15b-4d74-8800-0d279360e992",
                                "sense_id": "2f1f1cff-c715-3f02-a560-38894ac5bfd8",
                                "text": "« Attention, le revoilà ! » Le cri a jailli au moment où le poisson-scie a pointé le bout du rostre hors du récif artificiel où il avait disparu."
                            }
                        ]
                    }
