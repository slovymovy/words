                "translations": [
                    {
                        "translation_id": "a6d3b61c-faaf-4ec0-a80f-8eb619c752a5",
                        "source_entry_id": "1b42b1f9-433e-38e2-b00e-be1e322992af",
                        "source_sense_id": "36012268-a9e9-392f-940d-36029977dfc4",
                        "target_lang_word": "Caucasus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Caucasus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                        "entry_id": "bce24e08-b003-357a-9fa6-dbd2b8f17df7",
                                        "glosses": [
                                            "A mountain range in Eastern Europe between the Black Sea and the Caspian Sea, on territory of Russia, Georgia, Armenia and Azerbaijan, which includes the ranges of Greater Caucasus and Lesser Caucasus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65c993bf-7a32-4c4a-95a4-4af707b82173",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "Oh who can hold a fire in his hand / By thinking on the froſtie Caucaſus? / Or cloy the hungry edge of appetite, / by bare imagination of a Feaſt?"
                                            },
                                            {
                                                "example_id": "b74f08f7-7969-4c4f-84f3-4479ffb3007b",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "[…] from the long and rugged ravines of the Caucasus, […]"
                                            },
                                            {
                                                "example_id": "f4e5c499-0503-4d56-8812-2afad6ae7c13",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "Driven with that weak blast which Winter leaves, / Closing his palace gates on Caucasus, / […]"
                                            },
                                            {
                                                "example_id": "09c49ae9-6d64-4ce0-b255-f77724707bbe",
                                                "sense_id": "de492931-2638-366f-bb8e-edcafed0b5a7",
                                                "text": "Germany, Italy, Spain and Belgium writhed in the throes of Anarchy, while Russia, watching from the Caucasus, stooped and bound them one by one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd53359d-cbac-3ce2-8292-57062a060a52",
                                        "entry_id": "bce24e08-b003-357a-9fa6-dbd2b8f17df7",
                                        "glosses": [
                                            "A geopolitical region in Eastern Europe and Western Asia, deriving its name from the aforementioned mountains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a24cda7a-cfc3-45b4-b1bf-827141299426",
                        "source_entry_id": "1b42b1f9-433e-38e2-b00e-be1e322992af",
                        "source_sense_id": "36012268-a9e9-392f-940d-36029977dfc4",
