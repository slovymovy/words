                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le coup d'État, les officiers ont imposé une sévère <w>dictature</w> militaire."
                        },
                        {
                            "text": "De nombreux opposants ont fui à l'étranger pour échapper à cette violente <w>dictature</w>."
                        }
                    ],
