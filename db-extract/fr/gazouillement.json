        "fr-extract.jsonl": [
            {
                "entry_id": "b647f05c-5d41-3b94-a24b-36c854f5753d",
                "word": "gazouillement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3676b0c4-9b9f-4420-8ea0-f65d0112106f",
                        "entry_id": "b647f05c-5d41-3b94-a24b-36c854f5753d",
                        "tags": [
                            "plural"
                        ],
                        "form": "gazouillements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1c0876c-1229-3c0b-b319-986c61e3636a",
                        "entry_id": "b647f05c-5d41-3b94-a24b-36c854f5753d",
                        "glosses": [
                            "Action de gazouiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2de78ebd-7432-44d8-b3da-f62027a7bf7b",
                                "sense_id": "b1c0876c-1229-3c0b-b319-986c61e3636a",
                                "text": "La forêt résonne de gazouillements d’oiseaux."
                            },
                            {
                                "example_id": "004ecf59-4f25-4011-9096-d05d1b033309",
                                "sense_id": "b1c0876c-1229-3c0b-b319-986c61e3636a",
                                "text": "— On lit ce livre absolument comme au bord de la cascade on entendrait, rêveur, le gazouillement des eaux."
                            },
                            {
                                "example_id": "c9c78d18-68d0-4da9-9474-1b53ba1d7704",
                                "sense_id": "b1c0876c-1229-3c0b-b319-986c61e3636a",
                                "text": "Rien ne lui échappait : le susurrement sucré de la jeune vedette héroïne, le parler guttural du caïd sans scrupules, les nasillements du faux-frère, les jacassements de la commère, le jargon du bellâtre amoureux, les caracoulements du jeune premier, les gémissements de l’orpheline, les piaulements des villageois, les babillements des ouvrières, les graillements de la douairière, les braillements du nouveau riche en train de se pavaner, les sifflements du beau-parleur, les craillements des hommes avides, les croassements des maîtres-chanteurs, les coqueriquements des hâbleurs, les jabotements de la fille de joie, les cacardements de l’oie blanche, les pépiements des enfants, les gazouillements de l’alerte soubrette, les glatissements du foudre de guerre, les glapissements de la grue de service, les piaillements de la valetaille, les gloussements de la poule émoustillée, les hôlements du maître-chanteur, les frigottements de sa victime, les glougloutements du dindon de la farce, les coucoulements du pique-assiette, les frouements de la vieille femme acariâtre, les pupulements de la coquette, les gringottements du jeune chanteur, les cajolements du faraud, les grisolements de la mauviette, les margottements de la petite caille grassouillette, les criaillements de la grande pintade efflanquée, les trissements de l’hirondelle des faubourgs […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6aa03d6-014a-45ae-97f2-6ba5c40fee1e",
                        "source_entry_id": "b647f05c-5d41-3b94-a24b-36c854f5753d",
                        "source_sense_id": "b1c0876c-1229-3c0b-b319-986c61e3636a",
                        "target_lang_word": "Gepiepe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gepiepe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c1e7382-28a7-3d5c-9a0d-0cd939370e48",
                                        "entry_id": "725d2437-7a28-3aa8-a57a-8cc5cfe5bb9e",
                                        "glosses": [
                                            "anhaltendes, deutlich vernehmbares Piepen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2578b861-e579-4830-97e6-32ff5d4d451e",
                                                "sense_id": "2c1e7382-28a7-3d5c-9a0d-0cd939370e48",
                                                "text": "Das ständige Gepiepe des Faxgerätes geht mir auf die Nerven."
                                            },
                                            {
                                                "example_id": "e69de07c-9f44-4b56-bf60-e09d885ddaff",
                                                "sense_id": "2c1e7382-28a7-3d5c-9a0d-0cd939370e48",
                                                "text": "Das laute Gepiepe der kaputten Heizungsanlage war die ganze Nacht lang zu hören."
                                            },
                                            {
                                                "example_id": "a71506dd-0d6a-4ba9-811b-d65c677a31a9",
                                                "sense_id": "2c1e7382-28a7-3d5c-9a0d-0cd939370e48",
                                                "text": "Vogelgezwitscher ist entspannend, aber wenn man schlafen will, ist das laute Gepiepe vor dem Schlafzimmerfenster störend."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cd04540-7177-471e-8155-746833e3693d",
