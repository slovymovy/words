                "senses": [
                    {
                        "sense_id": "bb1aff73-eb35-34b9-8ae2-de3806fcc73a",
                        "entry_id": "0a6b6566-22a8-3e39-b370-d6544ffbabdb",
                        "glosses": [
                            "eine sehr ursprüngliche Ständerwand aus aufrecht auf Schwellen stehenden Pfosten, die zur Balkenlage führen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ccbe55-9a6f-41f4-bc6e-0d0d94e67793",
                                "sense_id": "bb1aff73-eb35-34b9-8ae2-de3806fcc73a",
                                "text": "„[…] Enggestellte runde und ovale Pfostenlöcher markieren die Wand, an einigen Stellen in dichtem Nebeneinander wie bei einer Pfostenwand, andererseits bezeugen Reste von Weide und Erle die Existenz von Flechtwerk.“"
                            },
                            {
                                "example_id": "0ace61fe-6d5a-4647-b1ca-b7fb4ba30651",
                                "sense_id": "bb1aff73-eb35-34b9-8ae2-de3806fcc73a",
                                "text": "„Eine Pfostenwand hat aufrechtstehende Wandplanken, die auf Schwellen ruhen und zur Balkenlage hochführen. … Eine Pfostenwand hat also einen kräftigen Rahmen, bestehend aus Schwelle, Balkenlage und zwei Eckständern.“"
                            },
                            {
                                "example_id": "d1499415-f924-4d08-88d4-787859314be1",
                                "sense_id": "bb1aff73-eb35-34b9-8ae2-de3806fcc73a",
                                "text": "„Trotz ähnlichen Alters und Grundrisses wie Flögeln geht hier der Ausgräber von massiven Pfostenwänden aus, die ein wenig geneigtes, schweres Sodendach getragen haben könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
