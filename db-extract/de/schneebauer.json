                ],
                "senses": [
                    {
                        "sense_id": "00a5a84e-ce27-374e-8889-db489d180cd0",
                        "entry_id": "81e176f4-0c00-35fa-ac62-739b2b619905",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "287daa2a-7b7d-4f21-8186-7dadb3b25680",
                                "sense_id": "00a5a84e-ce27-374e-8889-db489d180cd0",
                                "text": "Frau Schneebauer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e117cd77-e5a7-498d-a555-7a03d1faf614",
                                "sense_id": "00a5a84e-ce27-374e-8889-db489d180cd0",
                                "text": "Herr Schneebauer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5922d917-7b65-49c7-b420-4057b5743bc9",
                                "sense_id": "00a5a84e-ce27-374e-8889-db489d180cd0",
                                "text": "Die Schneebauers fahren heute ins Burgenland."
                            },
                            {
                                "example_id": "ad310b7a-7932-49c4-b515-279d2f26d011",
                                "sense_id": "00a5a84e-ce27-374e-8889-db489d180cd0",
                                "text": "Der Schneebauer trägt nie die Schals, die die Schneebauer ihm strickt."
                            },
                            {
                                "example_id": "8dddb04c-4d55-4c55-9a79-8f1931b5b524",
                                "sense_id": "00a5a84e-ce27-374e-8889-db489d180cd0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schneebauer kommt, geht der Herr Schneebauer.“"
                            },
                            {
                                "example_id": "a6afd303-19a3-4095-a330-651fa28b6813",
                                "sense_id": "00a5a84e-ce27-374e-8889-db489d180cd0",
                                "text": "Schneebauer kommt und geht."
                            },
                            {
                                "example_id": "30bb70ae-c4e2-483a-b949-dc89cf07f412",
                                "sense_id": "00a5a84e-ce27-374e-8889-db489d180cd0",
                                "text": "Schneebauers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
