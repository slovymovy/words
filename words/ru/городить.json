{
    "word_family": [
        "город",
        "изгородь",
        "загородка",
        "огород",
        "пригород",
        "ограждение",
        "преграда"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b909f8f-b880-3812-9ea1-904c127b80ba",
                    "sense_definition": "Строить забор, ограду или огораживать какое-либо пространство.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fence_building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое лето сосед принимался <w>городить</w> новый забор вокруг своего участка.",
                            "target_lang_translations": {
                                "nl": "Elke zomer begon de buurman een nieuwe schutting rond zijn erf te <w>bouwen</w>."
                            }
                        },
                        {
                            "text": "Зачем <w>городить</w> ограду там, где никто никогда не ходит?",
                            "target_lang_translations": {
                                "nl": "Waarom zou je een hek <w>neerzetten</w> waar toch nooit iemand loopt?"
                            }
                        }
                    ],
                    "synonyms": [
                        "огораживать"
                    ],
                    "common_phrases": [
                        "городить забор",
                        "городить ограду"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een hek of omheining bouwen, of een bepaalde ruimte afzetten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omheinen",
                                "target_lang_sense_clarification": "een hek of omheining plaatsen om een gebied"
                            },
                            {
                                "target_lang_word": "afzetten",
                                "target_lang_sense_clarification": "met een barrière of hekwerk afsluiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b7cd87b-cc27-35c5-a7e9-4d3425b75a9b",
                    "sense_definition": "Беспорядочно или неумело строить, громоздить какие-либо сооружения.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cluttered_construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они начали <w>городить</w> какие-то непонятные пристройки прямо во дворе дома.",
                            "target_lang_translations": {
                                "nl": "Ze begonnen allerlei vage aanbouwen midden op de binnenplaats van het huis te <w>neerpoten</w>."
                            }
                        },
                        {
                            "text": "Не нужно <w>городить</w> лишние перегородки в этой и без того маленькой комнате.",
                            "target_lang_translations": {
                                "nl": "Je hoeft geen overbodige tussenwanden te <w>plaatsen</w> in deze toch al kleine kamer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "городить пристройки"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в разговорной речи при неодобрении хаотичного строительства"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een rommelige, onhandige of chaotische manier bouwwerken neerzetten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "neerpoten",
                                "target_lang_sense_clarification": "slordig of lukraak bouwen"
                            },
                            {
                                "target_lang_word": "opstapelen",
                                "target_lang_sense_clarification": "onhandig op elkaar bouwen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06f5ae1e-62df-31fe-86c0-511fb1d479bc",
                    "sense_definition": "Говорить глупости, нелепости или выдумывать вздор.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "talking_nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Прекрати <w>городить</w> чепуху и расскажи наконец, что произошло на самом деле.",
                            "target_lang_translations": {
                                "nl": "Stop met onzin te <w>verkopen</w> en vertel eindelijk wat er werkelijk is gebeurd."
                            }
                        },
                        {
                            "text": "Ну что ты <w>городишь</w>, ведь все прекрасно знают правду!",
                            "target_lang_translations": {
                                "nl": "Wat sta je nou te <w>kletsen</w>, iedereen kent de waarheid toch allang!"
                            }
                        }
                    ],
                    "synonyms": [
                        "болтать",
                        "нести"
                    ],
                    "common_phrases": [
                        "городить чепуху",
                        "городить вздор",
                        "городить ахинею"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "широко используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Onzin, wartaal of dwaasheden verkondigen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kletsen",
                                "target_lang_sense_clarification": "onzin praten"
                            },
                            {
                                "target_lang_word": "uitkramen",
                                "target_lang_sense_clarification": "onzin of wartaal verkondigen"
                            },
                            {
                                "target_lang_word": "buitelen",
                                "target_lang_sense_clarification": "onzin achter elkaar vertellen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}