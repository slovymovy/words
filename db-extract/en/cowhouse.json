                        "entry_id": "7ddb6a5e-5f5e-3c29-abba-e5a28430e1a9",
                        "glosses": [
                            "A house (barn or shed) for keeping cows."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61ab3882-4834-4f52-a8d9-6b0d71d8c1ea",
                                "sense_id": "09f7b53a-2203-371d-8ff9-f66e2e467280",
                                "text": "A colony of Elves had taken up their abode under the floor of the cowhouse, or, it is more likely, were there before it was made a cowhouse."
                            },
                            {
                                "example_id": "502ff21f-2c32-4d6f-8a50-01408d585ec7",
                                "sense_id": "09f7b53a-2203-371d-8ff9-f66e2e467280",
                                "text": "When he had churned some time he recollected that the cow, which they kept at home, hadn't been let out of the cow-house, and hadn't had a straw of hay or anything to drink, although it was late in the day."
                            }
                        ]
                    }
