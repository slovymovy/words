                    {
                        "sense_id": "17373373-0d12-3b7c-a471-84d2ea182c34",
                        "entry_id": "ea1bd92a-83ff-3728-8de5-e77f27477081",
                        "glosses": [
                            "Prétentieux et snob."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a737eb-5062-42df-8988-07d1b5588fd3",
                                "sense_id": "17373373-0d12-3b7c-a471-84d2ea182c34",
                                "text": "– Je n’ai pas du tout envie de passer aux yeux de mes enfants pour une mère racornie, bêcheuse et butée !"
                            },
                            {
                                "example_id": "3d1fee2f-ceac-486d-a8cb-2274d5f4a56d",
                                "sense_id": "17373373-0d12-3b7c-a471-84d2ea182c34",
                                "text": "Aveugle à cent pour cent. Sa frangine, une belle nana, mais bêcheuse, le conduit par les rues, et lui il tâte le bord du trottoir avec sa canne, poc poc poc."
                            }
                        ]
                    }
                ],
