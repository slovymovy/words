                "senses": [
                    {
                        "sense_id": "3cf0e0ca-c581-3ecf-a3ad-4c0ec2ae01b6",
                        "entry_id": "0dd05370-1141-3ddd-b453-abdf71190080",
                        "glosses": [
                            "Gesamtheit aller Makromolekülkomplexe, welche die Gene einer Zelle enthalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f24cf20e-ba51-43b5-8397-876ac85d56e1",
                                "sense_id": "3cf0e0ca-c581-3ecf-a3ad-4c0ec2ae01b6",
                                "text": "„Der Weizen stammt von drei Wildgräsern ab und besitzt daher drei Genome mit jeweils zwei Chromosomensätzen.“"
                            },
                            {
                                "example_id": "280fea4a-2df8-4578-b307-81321cb02668",
                                "sense_id": "3cf0e0ca-c581-3ecf-a3ad-4c0ec2ae01b6",
                                "text": "Säugetierzellen enthalten üblicherweise zwei Chromosomensätze, jeweils einen von Vater und Mutter - die Wissenschafter sprechen von diploiden Zellen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
