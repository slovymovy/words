                ],
                "senses": [
                    {
                        "sense_id": "f17472bb-96ec-3f29-9d12-37d1b2a5d33b",
                        "entry_id": "8517400b-1ae0-3346-a8eb-8d4d1d9cbf92",
                        "glosses": [
                            "grundsätzliches oppositionelles Verhalten; Widerstand leisten, der nicht vernünftig begründet ist; Ablehnung jeder Zusammenarbeit"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "91099c45-6c60-4a4b-bf6a-9145dfbb9171",
                                "sense_id": "f17472bb-96ec-3f29-9d12-37d1b2a5d33b",
                                "text": "„Die Tschechen fürchten Entschädigungsansprüche der Deutschen. Und die Österreicher müssen - theoretisch - überlegen, ob sie als einzige eine Veto-Drohung aussprechen sollen. Oder ob sie die Sache nicht lieber den EU-Gerichtshöfen nach einem Beitritt Prags überlassen. Klugheit oder Bestemm? An dieser Wahl hängt mehr als eine Medaille beim Freistilringen.“"
                            },
                            {
                                "example_id": "c6c651c1-1cc7-41f3-a1cb-b9ab829a48fa",
                                "sense_id": "f17472bb-96ec-3f29-9d12-37d1b2a5d33b",
                                "text": "„Damals, Mai 1968, gab es in der Wiener Secession eine kunterbunte Abnormitätenschau, bunt und abnorm aus Überzeugung und Bestemm.“"
                            },
                            {
                                "example_id": "957be11c-6e85-44c4-ae10-091117eff0ab",
                                "sense_id": "f17472bb-96ec-3f29-9d12-37d1b2a5d33b",
                                "text": "„Er erwarte, ‚dass sich ÖVP und auch SPÖ bewegen‘, so Schützenhöfer, und, „dass sie sich zusammensetzen, dass die Volkspartei im der Frage der Steuerreform ihre Bestemm-Haltung aufgibt, dass die SPÖ ihren Klassenkampf aufgibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "08fb332a-5c8c-38f8-9b1f-f4ef0b621d2f",
                        "entry_id": "8517400b-1ae0-3346-a8eb-8d4d1d9cbf92",
                        "glosses": [
                            "Bestehen auf etwas; stures Beharren"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "c41075ef-3ec8-42b3-88a1-33084e51f139",
                                "sense_id": "08fb332a-5c8c-38f8-9b1f-f4ef0b621d2f",
                                "text": "„Damals, Mai 1968, gab es in der Wiener Secession eine kunterbunte Abnormitätenschau, bunt und abnorm aus Überzeugung und Bestemm.“"
                            },
                            {
                                "example_id": "9f5e3fd0-b032-4bb2-b243-a87e26648716",
                                "sense_id": "08fb332a-5c8c-38f8-9b1f-f4ef0b621d2f",
                                "text": "„Er erwarte, ‚dass sich ÖVP und auch SPÖ bewegen‘, so Schützenhöfer, und, „dass sie sich zusammensetzen, dass die Volkspartei im der Frage der Steuerreform ihre Bestemm-Haltung aufgibt, dass die SPÖ ihren Klassenkampf aufgibt.“"
                            },
                            {
                                "example_id": "05e3fa38-4b69-4dfa-b7fc-e40936111b4d",
                                "sense_id": "08fb332a-5c8c-38f8-9b1f-f4ef0b621d2f",
                                "text": "„Doch FPÖ-Chef Heinz-Christian Strache machte sein Bestemm auf den vierten Posten mit einer fehlgeleiteten SMS öffentlich.“"
                            },
                            {
                                "example_id": "ff9fd501-ca14-4e99-bd88-584e59a35dfa",
                                "sense_id": "08fb332a-5c8c-38f8-9b1f-f4ef0b621d2f",
                                "text": "„Der Stelvio folgt dem Mainstream und widersetzt sich ihm gleichzeitig mit subtilem Bestemm.“"
                            },
                            {
                                "example_id": "5dc64901-d6ed-47b8-91e3-919ae7a16327",
                                "sense_id": "08fb332a-5c8c-38f8-9b1f-f4ef0b621d2f",
                                "text": "„Stets basieren diese Geschichten auf dem Bestemm, eine Meinung gegen alle Widersprüche abzuschirmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
