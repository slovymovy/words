                                "target_senses": [
                                    {
                                        "sense_id": "ddc586f3-2200-36ca-a7b8-4d266355bb72",
                                        "entry_id": "5d6011af-5799-3e1d-ae18-1d0540abf697",
                                        "glosses": [
                                            "eine flache schirmlose Kopfbedeckung"
                                        ],
                                        "tags": [],
                                        "examples": [
