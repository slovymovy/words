{
    "word_family": [
        "bow",
        "bowing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fb668a4d-0cb6-39df-8a42-ede9a31a8313",
                    "sense_definition": "Bent or curved in shape",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter had to replace the <w>bowed</w> wooden board because it was no longer straight.",
                            "target_lang_translations": {
                                "ru": "Плотнику пришлось заменить <w>изогнутую</w> деревянную доску, потому что она перестала быть прямой."
                            }
                        },
                        {
                            "text": "The horse suffered from a <w>bowed</w> tendon after running too hard on the track.",
                            "target_lang_translations": {
                                "ru": "Лошадь страдала от <w>воспаления</w> сухожилия после слишком интенсивного бега по треку."
                            }
                        }
                    ],
                    "synonyms": [
                        "curved",
                        "arched"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "bowed board",
                        "bowed tendon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий изогнутую или дугообразную форму"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изогнутый",
                                "target_lang_sense_clarification": "общая форма предмета"
                            },
                            {
                                "target_lang_word": "выгнутый",
                                "target_lang_sense_clarification": "о поверхности или материале"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ae7ac49-33ce-37a2-84f8-aa56241655d0",
                    "sense_definition": "Designed to be played using a bow",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The violin is a classic example of a <w>bowed</w> string instrument.",
                            "target_lang_translations": {
                                "ru": "Скрипка — классический пример <w>смычкового</w> струнного инструмента."
                            }
                        },
                        {
                            "text": "Many musicians prefer the sound of a <w>bowed</w> instrument over a plucked one.",
                            "target_lang_translations": {
                                "ru": "Многие музыканты предпочитают звучание <w>смычкового</w> инструмента щипковому."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowed instrument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для игры смычком"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смычковый",
                                "target_lang_sense_clarification": "о музыкальном инструменте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f40f222-f1f7-326c-849f-02f8d55b7c99",
                    "sense_definition": "Having been played by a bow",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bowed</w> string produced a long and mournful note.",
                            "target_lang_translations": {
                                "ru": "Струна, по которой <w>провели смычком</w>, издала долгую и печальную ноту."
                            }
                        },
                        {
                            "text": "Physicists study the vibration of a <w>bowed</w> string to understand musical acoustics.",
                            "target_lang_translations": {
                                "ru": "Физики изучают вибрацию <w>смычковой</w> струны, чтобы понять музыкальную акустику."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowed string"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, на котором играли с помощью смычка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звучащий от смычка",
                                "target_lang_sense_clarification": "о процессе извлечения звука"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "276e14cd-d7b6-305a-bbd8-650cd86d1609",
                    "sense_definition": "Equipped with a bow for shooting arrows",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient army relied on its <w>bowed</w> archers to defend the city walls.",
                            "target_lang_translations": {
                                "ru": "Древняя армия полагалась на своих <w>вооруженных луками</w> лучников для защиты городских стен."
                            }
                        },
                        {
                            "text": "The statue depicted a strong <w>bowed</w> hunter ready for the chase.",
                            "target_lang_translations": {
                                "ru": "Статуя изображала сильного охотника <w>с луком</w>, готового к погоне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowed archer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вооруженный луком для стрельбы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вооруженный луком",
                                "target_lang_sense_clarification": "о человеке или воине"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a77a2db1-1555-3e16-9630-4caec127cb96",
                    "sense_definition": "Simple past and past participle of <w>bow</w> (to bend the body forward)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor <w>bowed</w> to the audience after the final performance.",
                            "target_lang_translations": {
                                "ru": "Актер <w>поклонился</w> публике после финального выступления."
                            }
                        },
                        {
                            "text": "She <w>bowed</w> her head in respect during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Она <w>склонила</w> голову в знак уважения во время церемонии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowed head"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола «кланяться» (наклонять корпус вперед)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поклонился",
                                "target_lang_sense_clarification": "совершил поклон"
                            },
                            {
                                "target_lang_word": "склонил",
                                "target_lang_sense_clarification": "о наклоне головы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}