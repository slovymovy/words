                "senses": [
                    {
                        "sense_id": "7978fd9e-09e9-3046-b28d-acd5871edd38",
                        "entry_id": "14be785c-0e8e-3226-ad94-8987508f415a",
                        "glosses": [
                            "einzelner Bestandteil eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52cca9de-99f6-4bf3-8442-b014a9d6b97c",
                                "sense_id": "7978fd9e-09e9-3046-b28d-acd5871edd38",
                                "text": "„Das Zulassen des Mogelns für alle schafft wiederum spielgerecht für alle gleiche Bedingungen. Es kann also als reizvolles eigenes Spielelement erfahren werden.“"
                            },
                            {
                                "example_id": "f13d31a1-4666-4ed6-94ba-d6bf6da4c2f2",
                                "sense_id": "7978fd9e-09e9-3046-b28d-acd5871edd38",
                                "text": "„In seiner Heimatstadt und im oberösterreichischen Linz konnte man ihn bei Kostümtheater-Führungen mit gruppenpädagogischen Spielelementen beobachten.“"
                            },
                            {
                                "example_id": "b5970841-3aac-40de-aa1d-2506a9b9d880",
                                "sense_id": "7978fd9e-09e9-3046-b28d-acd5871edd38",
                                "text": "„Zum großen Familienspiel mit entsprechendem Erfolg reifte der Mechanismus in ‚Abenteuer Tierwelt’, das im selben Verlag erschien und schon die meisten heutigen Spielelemente besaß.“"
                            },
                            {
                                "example_id": "443f8f2b-e16f-465e-bebd-d1d1cc40636c",
                                "sense_id": "7978fd9e-09e9-3046-b28d-acd5871edd38",
                                "text": "„Probleme erkennen und gezielt lösen, ist das wichtigste Spielelement.“"
                            },
                            {
                                "example_id": "58db0499-1149-4cf6-81ab-86c851076c92",
                                "sense_id": "7978fd9e-09e9-3046-b28d-acd5871edd38",
                                "text": "„Die Literatur, das Lebenselixier der Familie, liefert nur die ferne Begleitmusik für das Filmwerk, in dem die dokumentarischen und die Spielelemente mit raffinierter Technik ineinander verwoben sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
