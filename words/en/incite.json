                    "frequency": "Middle",
                    "semantic_group_id": "provoke_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leader was arrested for using his speech to <w>incite</w> violence among the crowd.",
                            "target_lang_translations": {
                                "nl": "De leider werd gearresteerd omdat hij zijn toespraak gebruikte om de menigte tot geweld <w>aan te zetten</w>."
                            }
                        },
                        {
                            "text": "He claimed that online forums had <w>incited</w> him to commit the vandalism.",
                            "target_lang_translations": {
                                "nl": "Hij beweerde dat online forums hem ertoe hadden <w>aangezet</w> om het vandalisme te plegen."
                            }
                        }
