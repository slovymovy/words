                        "glosses": [
                            "Lautäußerung vor, während oder nach einer körperlichen oder geistigen Anstrengung oder bei dem Gedanken daran."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f066171-4dcb-4227-a38a-5012adcc2c41",
                                "sense_id": "951d7d9b-c36b-3c22-9de1-4ea456f03fd3",
                                "text": "Uff, schon wieder Suff heut?"
