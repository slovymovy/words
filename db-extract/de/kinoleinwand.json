                "senses": [
                    {
                        "sense_id": "03081e16-16d6-3fe2-88ed-efed5509fe6e",
                        "entry_id": "eaf64771-094a-30fd-a954-89725a363e1e",
                        "glosses": [
                            "Projektionsfläche in einem Kinosaal, auf der die Bilder zu sehen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd10cbd-112a-4e2c-aadd-9634ac345c83",
                                "sense_id": "03081e16-16d6-3fe2-88ed-efed5509fe6e",
                                "text": "Die große Kinoleinwand ist hinter einem altertümlich anmutenden, roten Samtvorhang verborgen."
                            },
                            {
                                "example_id": "326c1c6e-ab2c-4061-9ec5-b03ca09680d9",
                                "sense_id": "03081e16-16d6-3fe2-88ed-efed5509fe6e",
                                "text": "„Michalik dichtete dem Klassiker von 1897 eine Entstehungsgeschichte an, die ihrerseits ein Bühnenerfolg wurde und es jetzt auch auf die Kinoleinwand geschafft hat.“"
                            },
                            {
                                "example_id": "b1817288-ecfb-4cbe-ba69-340541767eab",
                                "sense_id": "03081e16-16d6-3fe2-88ed-efed5509fe6e",
                                "text": "Dieser Stoff gehört auf die Kinoleinwände der ganzen Welt!"
                            }
                        ],
                        "sense_index_json": "\"1\""
