                "senses": [
                    {
                        "sense_id": "b8151c29-384e-39cd-b742-d08f86f92405",
                        "entry_id": "707e5842-f34a-3a8d-abc2-91570ae0bc21",
                        "glosses": [
                            "Action de retarder, de causer du retard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea0d9376-e023-40a7-b36a-b3ba2353b387",
                                "sense_id": "b8151c29-384e-39cd-b742-d08f86f92405",
                                "text": "Causer, apporter du retardement à quelque chose."
                            },
                            {
                                "example_id": "8e6a2612-ae6a-4a70-9098-295cd1bedb4a",
                                "sense_id": "b8151c29-384e-39cd-b742-d08f86f92405",
                                "text": "Il n’y aura point de retardement de ma part."
                            },
                            {
                                "example_id": "eab6f710-f261-40c9-b061-3e1315a5d161",
                                "sense_id": "b8151c29-384e-39cd-b742-d08f86f92405",
                                "text": "Le retardement de cette affaire vient de ce que…"
                            },
                            {
                                "example_id": "6bf9b39e-de1b-4281-af7e-475235e0d2c5",
                                "sense_id": "b8151c29-384e-39cd-b742-d08f86f92405",
                                "text": "Le retardement d’un départ, d’un paiement."
                            },
                            {
                                "example_id": "9f087a59-f671-45f9-9c4b-b4947593d49c",
                                "sense_id": "b8151c29-384e-39cd-b742-d08f86f92405",
                                "text": "Ainsi Monléon, en procédant par des effets de retardement et non par effets de suspension, a fait progresser sans cesse chez le spectateur l’horreur qui l’emporte sur la pitié pour les victimes."
                            }
                        ]
                    }
