                        "target_lang_word": "watscheln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "watscheln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ca4e345-5b4c-3ecc-89b9-6f11fccf5371",
                                        "entry_id": "cfd261ea-a34e-3bca-bc58-7c426826afb6",
                                        "glosses": [
                                            "sich behäbig und schaukelnd fortbewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c75873-5d31-46d3-9e46-b46bc06f691d",
                                                "sense_id": "1ca4e345-5b4c-3ecc-89b9-6f11fccf5371",
