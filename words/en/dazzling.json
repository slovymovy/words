{
    "word_family": [
        "dazzle",
        "dazzlement",
        "dazzler",
        "bedazzle",
        "dazzlingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9083c9db-410a-3a52-a544-fd7b7d24e4ec",
                    "sense_definition": "Extremely bright, especially so as to blind the eyes temporarily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "brightness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dazzling</w> white glare of the sun on the snow made it hard to see without sunglasses.",
                            "target_lang_translations": {
                                "ru": "<w>Ослепительный</w> белый блеск солнца на снегу мешал видеть без солнечных очков.",
                                "es": "El <w>deslumbrante</w> resplandor blanco del sol sobre la nieve hacía difícil ver sin gafas de sol."
                            }
                        },
                        {
                            "text": "Drivers were blinded by the <w>dazzling</w> headlights of the oncoming truck.",
                            "target_lang_translations": {
                                "ru": "Водители были ослеплены <w>ослепляющими</w> фарами встречного грузовика.",
                                "es": "Los conductores quedaban cegados por los faros <w>cegadores</w> del camión que venía de frente."
                            }
                        }
                    ],
                    "synonyms": [
                        "blinding",
                        "glaring",
                        "radiant"
                    ],
                    "antonyms": [
                        "dim",
                        "dull"
                    ],
                    "common_phrases": [
                        "dazzling white glare",
                        "dazzling light",
                        "dazzling sunshine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно яркий, способный временно ослепить глаза.",
                        "es": "Extremadamente brillante, en especial de modo que ciega temporalmente los ojos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослепительный",
                                "target_lang_sense_clarification": "очень яркий свет"
                            },
                            {
                                "target_lang_word": "ослепляющий",
                                "target_lang_sense_clarification": "лишающий возможности видеть"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deslumbrante",
                                "target_lang_sense_clarification": "luz tan intensa que ciega o molesta la vista"
                            },
                            {
                                "target_lang_word": "cegador",
                                "target_lang_sense_clarification": "que priva de la visión por su gran brillo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "288f0df6-1d9f-33c7-b22f-9dd64b9a2d0b",
                    "sense_definition": "Extremely impressive, beautiful, or skillful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impressive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gymnast gave a <w>dazzling</w> display of skill that left the judges speechless.",
                            "target_lang_translations": {
                                "ru": "Гимнаст показал <w>блестящее</w> мастерство, которое оставило судей без слов.",
                                "es": "El gimnasta ofreció una exhibición <w>brillante</w> de habilidad que dejó a los jueces sin palabras."
                            }
                        },
                        {
                            "text": "She wore a <w>dazzling</w> smile as she accepted the prestigious award.",
                            "target_lang_translations": {
                                "ru": "На её лице была <w>ослепительная</w> улыбка, когда она принимала престижную награду.",
                                "es": "Llevaba una sonrisa <w>deslumbrante</w> mientras aceptaba el prestigioso premio."
                            }
                        }
                    ],
                    "synonyms": [
                        "brilliant",
                        "splendid",
                        "stunning",
                        "spectacular"
                    ],
                    "antonyms": [
                        "unimpressive",
                        "ordinary"
                    ],
                    "common_phrases": [
                        "dazzling display",
                        "dazzling smile",
                        "dazzling performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно впечатляющий, красивый или искусный.",
                        "es": "Extremadamente impresionante, hermoso o hábil."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослепительный",
                                "target_lang_sense_clarification": "поразительный по красоте"
                            },
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "выдающийся, превосходный"
                            },
                            {
                                "target_lang_word": "великолепный",
                                "target_lang_sense_clarification": "производящий сильное впечатление"
                            },
                            {
                                "target_lang_word": "поразительный",
                                "target_lang_sense_clarification": "изумительный, необыкновенный"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deslumbrante",
                                "target_lang_sense_clarification": "fascinante, que impresiona por su belleza o talento"
                            },
                            {
                                "target_lang_word": "brillante",
                                "target_lang_sense_clarification": "extraordinario, sobresaliente"
                            },
                            {
                                "target_lang_word": "espectacular",
                                "target_lang_sense_clarification": "asombroso o grandioso"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e349a38-2b2a-31a9-9782-28947dde0389",
                    "sense_definition": "present participle and gerund of <w>dazzle</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician is <w>dazzling</w> the audience with his latest card tricks.",
                            "target_lang_translations": {
                                "ru": "Фокусник <w>поражает</w> публику своими новыми карточными трюками.",
                                "es": "El mago está <w>deslumbrando</w> al público con sus últimos trucos de cartas."
                            }
                        },
                        {
                            "text": "By <w>dazzling</w> the voters with empty promises, the politician won the election.",
                            "target_lang_translations": {
                                "ru": "<w>Ослепляя</w> избирателей пустыми обещаниями, политик выиграл выборы.",
                                "es": "<w>Deslumbrando</w> a los votantes con promesas vacías, el político ganó las elecciones."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «ослеплять» или «поражать».",
                        "es": "Participio de presente y gerundio de dazzle; deslumbrando o maravillando."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослепляющий",
                                "target_lang_sense_clarification": "в процессе ослепления светом или мастерством"
                            },
                            {
                                "target_lang_word": "поражающий",
                                "target_lang_sense_clarification": "в процессе произведения сильного впечатления"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deslumbrando",
                                "target_lang_sense_clarification": "forma en gerundio del verbo deslumbrar"
                            },
                            {
                                "target_lang_word": "maravillando",
                                "target_lang_sense_clarification": "causando gran admiración"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "119ba615-6a2f-3bd8-9c15-d9971f809e45",
                    "sense_definition": "The act or process of being dazzled; a state of dazzlement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>dazzling</w> of the stage lights caused the actor to stumble.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>ослепление</w> сценическим светом заставило актера споткнуться.",
                                "es": "El repentino <w>deslumbramiento</w> por las luces del escenario hizo que el actor tropezara."
                            }
                        },
                        {
                            "text": "He preferred the steady glow of gold to the temporary <w>dazzlings</w> of cheaper metals.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал ровное сияние золота временному <w>блеску</w> более дешевых металлов.",
                                "es": "Prefería el brillo constante del oro a los <w>destellos</w> pasajeros de metales más baratos."
                            }
                        }
                    ],
                    "synonyms": [
                        "dazzlement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс ослепления; состояние ослепленности.",
                        "es": "Acción o efecto de quedar deslumbrado; estado de deslumbramiento."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослепление",
                                "target_lang_sense_clarification": "процесс потери зрения от яркости или блеска"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deslumbramiento",
                                "target_lang_sense_clarification": "efecto de perder momentáneamente la vista o quedar fascinado"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}