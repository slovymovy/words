{
    "word_family": [
        "mêmement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f27e7e7e-2373-3307-9cc8-f7db020a64d9",
                    "sense_definition": "Qui n'est pas différent, qui est identique ou semblable à un autre.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "identite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous habitons dans le <w>même</w> immeuble depuis plusieurs années."
                        },
                        {
                            "text": "Ils sont arrivés à la fête en <w>même</w> temps."
                        }
                    ],
                    "synonyms": [
                        "identique",
                        "pareil"
                    ],
                    "antonyms": [
                        "différent",
                        "autre"
                    ],
                    "common_phrases": [
                        "le même jour",
                        "la même chose",
                        "en même temps"
                    ]
                },
                {
                    "sense_id": "52265559-1e64-3c73-acbb-65549a7b3700",
                    "sense_definition": "Placé après un nom ou un pronom, sert à insister sur la personne ou la chose dont il s'agit, ou sur la précision d'un moment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a reçu une réponse favorable le jour <w>même</w> de sa candidature."
                        },
                        {
                            "text": "Au moment <w>même</w> où nous partions, la pluie a commencé à tomber."
                        }
                    ],
                    "synonyms": [
                        "précisément"
                    ],
                    "common_phrases": [
                        "le jour même",
                        "le soir même",
                        "au moment même"
                    ]
                },
                {
                    "sense_id": "b16c4062-5529-37e8-8f0f-65da8e228cb3",
                    "sense_definition": "Placé après un nom abstrait, exprime qu'une qualité est possédée au degré le plus élevé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette femme a toujours aidé ses voisins, elle est la bonté <w>même</w>."
                        },
                        {
                            "text": "Toujours calme et poli, cet employé incarne la courtoisie <w>même</w>."
                        }
                    ],
                    "common_phrases": [
                        "la bonté même",
                        "la courtoisie même"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a070bdbc-546b-35fc-8420-e478cf17f9a3",
                    "sense_definition": "Sert à introduire une idée d'addition extrême, d'insistance ou d'inclusion inattendue ; y compris, jusqu'à.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "enchere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le monde est venu à la réunion, <w>même</w> les étudiants d'ordinaire absents."
                        },
                        {
                            "text": "Il fait très froid ce matin, <w>même</w> avec un gros manteau."
                        }
                    ],
                    "synonyms": [
                        "aussi",
                        "voire"
                    ],
                    "common_phrases": [
                        "même si",
                        "quand même",
                        "pas même"
                    ]
                },
                {
                    "sense_id": "e5d11fc0-d478-3865-87c1-6167922c19cc",
                    "sense_definition": "Placé en tête de proposition pour renchérir ou insister ; bien plus, qui plus est.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "enchere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le malade allait beaucoup mieux, <w>même</w> il avait retrouvé l'appétit dès l'aube."
                        },
                        {
                            "text": "Le projet n'était pas abandonné, <w>même</w> il progressait à grands pas."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "cd03b3f3-f3d2-3239-8a0c-a628cde64539",
                    "sense_definition": "Désigne une personne ou une chose identique à celle dont il vient d'être question.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pronom_identite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as acheté ce roman, j'ai exactement le <w>même</w> chez moi."
                        },
                        {
                            "text": "Parmi tous les modèles proposés, les clients ont choisi les <w>mêmes</w>."
                        }
                    ],
                    "common_phrases": [
                        "le même que",
                        "les mêmes"
                    ]
                },
                {
                    "sense_id": "565aac94-0e2d-3988-9c40-24877eb96035",
                    "sense_definition": "Désigne la permanence du comportement, de l'état ou du caractère d'une personne à travers le temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pronom_identite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré le succès et les années, il est resté le <w>même</w> avec ses amis."
                        },
                        {
                            "text": "Elle garde toujours son calme, elle est toujours la <w>même</w> dans l'adversité."
                        }
                    ],
                    "common_phrases": [
                        "toujours le même",
                        "rester le même"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "648519ea-80d4-3f6f-85cc-70ef571ac877",
                    "sense_definition": "La même chose, une réalité ou un résultat identique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nom_identite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Que tu partes aujourd'hui ou demain, cela revient au <w>même</w> pour nous."
                        },
                        {
                            "text": "Changer d'itinéraire n'a rien apporté de nouveau, c'est du pareil au <w>même</w>."
                        }
                    ],
                    "common_phrases": [
                        "revenir au même",
                        "du pareil au même"
                    ]
                },
                {
                    "sense_id": "9ba9b352-1fbb-35b1-bc0d-9ba03a5baf1a",
                    "sense_definition": "Concept philosophique représentant l'identité fondamentale et l'unité de l'être, traditionnellement opposé à l'Autre.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nom_identite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La dialectique platonicienne interroge les relations complexes entre le <w>Même</w> et l'Autre."
                        },
                        {
                            "text": "L'auteur fonde toute son argumentation sur la tension constante entre le <w>Même</w> et la différence."
                        }
                    ],
                    "antonyms": [
                        "autre"
                    ],
                    "common_phrases": [
                        "le Même et l'Autre"
                    ]
                }
            ]
        }
    ]
}