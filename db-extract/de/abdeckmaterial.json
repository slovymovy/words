                "senses": [
                    {
                        "sense_id": "fc7b775f-c254-3219-ab91-5bf3d5c889df",
                        "entry_id": "d662e05d-ed89-3fbf-9afd-b1aae32428d3",
                        "glosses": [
                            "Material, mit dem andere Dinge zum Schutz abgedeckt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bac3dc8-6498-473b-a14b-a6a6a16c8386",
                                "sense_id": "fc7b775f-c254-3219-ab91-5bf3d5c889df",
                                "text": "„Beim Standaufbau fallen insbesondere Verpackungsmaterialien und Kunststoffolien als Abdeckmaterial zum Schutz der textilen Bodenbeläge an.“"
                            },
                            {
                                "example_id": "be699a50-a759-4ca0-af09-886c05785f4a",
                                "sense_id": "fc7b775f-c254-3219-ab91-5bf3d5c889df",
                                "text": "„Unter dem Abdeckmaterial ist ein fertig verlegter Granitboden erkennbar und auch ein Grossteil der Rohre für die Kühl- und anderen Regale sind verlegt.“"
                            },
                            {
                                "example_id": "19ac8e51-20a8-4514-84ee-08b1689a7f8c",
                                "sense_id": "fc7b775f-c254-3219-ab91-5bf3d5c889df",
                                "text": "„Viele Malergeschäfte sind gern bereit, Abdeckmaterial, Pinsel, Leitern und Farben gegen Bezahlung zur Verfügung zu stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
