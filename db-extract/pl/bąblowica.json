                                        "glosses": [
                                            "Maladie parasitaire due à un ténia échinocoque."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6f4adc4-a7b3-4628-8ba5-6eaaa7547cf0",
                                                "sense_id": "e941694a-1f8f-31ad-9eff-80e393695767",
                                                "text": "La surveillance concerne en priorité les zoonoses suivantes :\n- brucellose,\n- campylobactériose,\n- échinococcose, …"
