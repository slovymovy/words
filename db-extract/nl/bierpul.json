                        "sense_id": "08864bcb-a9bb-3986-b8a1-a8481b288d96",
                        "entry_id": "ee5c3bcf-9d0a-3aa1-b8a8-f1e1f9c71a20",
                        "glosses": [
                            "groot glas of grote beker met handvat en soms ook een deksel voor het drinken van bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a6515e-9798-4d15-8d6d-efe4b5d45756",
                                "sense_id": "08864bcb-a9bb-3986-b8a1-a8481b288d96",
                                "text": "Samen met de ordediensten kwam de politie honderden keren in actie, veelal voor kleinere incidenten. De meeste ongelukken deden zich voor met gebroken bierpullen. In totaal probeerden bezoekers zo'n 120.000 glazen te stelen."
                            },
                            {
                                "example_id": "7fbb6c6f-01ae-4426-ac5d-a33fd79de338",
                                "sense_id": "08864bcb-a9bb-3986-b8a1-a8481b288d96",
                                "text": "De wereldrecordhouder bierpullen dragen heeft zichzelf overtroffen. Oliver Strümpfel wist zijn eigen record van 25 pullen te verbreken."
                            }
                        ]
                    }
                ],
