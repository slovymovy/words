{
    "word_family": [
        "transport",
        "transportable",
        "transporteur",
        "transportation",
        "intransportable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93d28e7d-2c98-3e25-93c0-513001de4756",
                    "sense_definition": "Déplacer ou faire parvenir des personnes ou des biens d'un endroit à un autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deplacement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce camion moderne permet de <w>transporter</w> des marchandises rapidement d'une ville à l'autre."
                        },
                        {
                            "text": "Les pompiers ont <w>transporté</w> les blessés à l'hôpital dès leur arrivée sur les lieux."
                        }
                    ],
                    "synonyms": [
                        "acheminer",
                        "véhiculer"
                    ],
                    "common_phrases": [
                        "transporter des marchandises",
                        "transporter des passagers"
                    ]
                },
                {
                    "sense_id": "08c56b82-21d0-3b4e-810a-bcbd7ff87685",
                    "sense_definition": "Transférer un élément abstrait, un siège d'activité ou le cadre d'une action dans un autre lieu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transfert_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé de <w>transporter</w> le siège de l'entreprise dans une autre région."
                        },
                        {
                            "text": "Les deux amis préfèrent <w>transporter</w> la discussion sur un sujet plus joyeux."
                        }
                    ],
                    "synonyms": [
                        "déplacer",
                        "transférer"
                    ],
                    "common_phrases": [
                        "transporter la conversation"
                    ]
                },
                {
                    "sense_id": "26153958-73d4-3edc-ba66-85392755f998",
                    "sense_definition": "Provoquer une émotion très intense qui met quelqu'un hors de son état habituel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette magnifique victoire a immédiatement <w>transporté</w> toute la foule dans un immense bonheur."
                        },
                        {
                            "text": "Une colère subite semblait le <w>transporter</w> au point qu'il n'écoutait plus personne."
                        }
                    ],
                    "synonyms": [
                        "exalter",
                        "enivrer"
                    ],
                    "common_phrases": [
                        "transporter de joie"
                    ]
                },
                {
                    "sense_id": "c7eeba76-1887-31bd-898b-4ada3a7dd928",
                    "sense_definition": "Imaginer ou concevoir qu'on se trouve dans une autre époque ou un autre endroit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En lisant ce livre d'histoire, on peut se <w>transporter</w> aisément au siècle dernier."
                        },
                        {
                            "text": "Il aimait se <w>transporter</w> par la pensée au bord de la mer Méditerranée."
                        }
                    ],
                    "synonyms": [
                        "se projeter"
                    ],
                    "common_phrases": [
                        "se transporter par la pensée"
                    ]
                },
                {
                    "sense_id": "edfee33c-afcc-3a5e-9620-be9427df41e9",
                    "sense_definition": "Aller en personne sur un site pour un motif officiel, administratif ou judiciaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge d'instruction a dû se <w>transporter</w> sur les lieux pour vérifier les déclarations."
                        },
                        {
                            "text": "Les enquêteurs se sont <w>transportés</w> au domicile du suspect pour effectuer une perquisition."
                        }
                    ],
                    "synonyms": [
                        "se rendre"
                    ],
                    "common_phrases": [
                        "se transporter sur les lieux"
                    ]
                },
                {
                    "sense_id": "aa88dbc2-62c7-3a45-9c75-db5c39e89c5d",
                    "sense_definition": "Envoyer un individu condamné purger sa peine dans une colonie pénitentiaire lointaine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "histoire_peine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au dix-neuvième siècle, les insurgés condamnés étaient souvent <w>transportés</w> dans des colonies pénitentiaires."
                        },
                        {
                            "text": "L'État décida de <w>transporter</w> plusieurs prisonniers politiques hors de la métropole."
                        }
                    ],
                    "synonyms": [
                        "déporter",
                        "exiler"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme utilisé historiquement pour la transportation pénale"
                        }
                    ]
                },
                {
                    "sense_id": "b1efe456-5e66-30ca-b627-08a16c99c8df",
                    "sense_definition": "Transmettre formellement la propriété d'un droit ou d'une créance à un tiers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire a formellement <w>transporté</w> ses droits sur l'immeuble à un nouvel acquéreur."
                        },
                        {
                            "text": "Le créancier a choisi de <w>transporter</w> sa créance à une société financière spécialisée."
                        }
                    ],
                    "synonyms": [
                        "céder",
                        "transférer"
                    ],
                    "common_phrases": [
                        "transporter une créance"
                    ]
                }
            ]
        }
    ]
}