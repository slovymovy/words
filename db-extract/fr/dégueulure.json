                        "glosses": [
                            "Vomi, vomissure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "390b9cfb-b7da-46a9-9b11-7aad8f2f0c4b",
                                "sense_id": "fc31c701-957b-3d36-95af-16d58bab3b9b",
                                "text": "S’il s’y donnait postillonnage, vociférations, horreurs, dégueulures !"
                            },
                            {
                                "example_id": "ba03b624-c79d-4481-abc7-6327d7e875ec",
                                "sense_id": "fc31c701-957b-3d36-95af-16d58bab3b9b",
                                "text": "Une robe en marceline opale s’échenillant autour d’elle en dégueulures écumeuses de cygne d’or, denchée de solanées pourries, fleurant à dix pages à la ronde un de ces parfums éblouissants, carminatifs d’extase : Youth dew d’Estée Lauder."
                            },
                            {
                                "example_id": "b55e961e-7de4-4a39-9a6a-9b32c2959881",
                                "sense_id": "fc31c701-957b-3d36-95af-16d58bab3b9b",
                                "text": "S’en échappait aussi une odeur indéfinissable de vin passé, de sang, de vieille chemise, de dégueulure et de tabac pisseux."
                            }
                        ]
                    }
