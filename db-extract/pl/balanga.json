                "senses": [
                    {
                        "sense_id": "4b162caa-98dc-3f89-9cfe-2bd4261d7288",
                        "entry_id": "ae649fd2-f815-33ab-bb5a-685464ae501f",
                        "glosses": [
                            "huczna impreza towarzyska"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7f57d025-9c8f-47fa-9cff-57abd4ac6a54",
                                "sense_id": "4b162caa-98dc-3f89-9cfe-2bd4261d7288",
                                "text": "Jutro w klubie jest balanga."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad16c16f-1ca3-4f13-a06e-c6e3284a082b",
                        "source_entry_id": "ae649fd2-f815-33ab-bb5a-685464ae501f",
                        "source_sense_id": "4b162caa-98dc-3f89-9cfe-2bd4261d7288",
                        "target_lang_word": "boum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf153210-4f07-3210-bcbc-ac59cd1a1c47",
                                        "entry_id": "abd4a170-0832-3544-9ec8-350c71567809",
                                        "glosses": [
                                            "Exprime le bruit sourd d’une explosion, du tambour ou des battements cardiaques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcfbb5cc-8043-4e8b-8b8e-c6522fac7317",
                                                "sense_id": "bf153210-4f07-3210-bcbc-ac59cd1a1c47",
                                                "text": "Mon cœur fait boum ! quand je te vois."
                                            },
                                            {
                                                "example_id": "f90a9676-3b08-41af-b6b4-50be93548fe7",
                                                "sense_id": "bf153210-4f07-3210-bcbc-ac59cd1a1c47",
                                                "text": "Ça viendra, bibiche, mais tu ne donnes pas encore assez moelleusement le coup des hanches qui doit pimenter le « boum » de la grosse caisse."
                                            },
                                            {
                                                "example_id": "7f1df80c-f0fb-4425-9015-5c3d558036cf",
                                                "sense_id": "bf153210-4f07-3210-bcbc-ac59cd1a1c47",
                                                "text": "Boum ! Midi « tonne » au canon du Palais-Royal !"
                                            },
                                            {
                                                "example_id": "661c2989-f28c-4ea3-94d4-bd44f5e881c7",
                                                "sense_id": "bf153210-4f07-3210-bcbc-ac59cd1a1c47",
                                                "text": "Il baissa les yeux et tapa sur son tambour en criant : « Boum, boum, tararaboum. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4930424-bbd3-3b48-882a-84c77bf98790",
                                        "entry_id": "abd4a170-0832-3544-9ec8-350c71567809",
                                        "glosses": [
                                            "Mot prononcé autrefois par les garçons de café lorsqu’ils servaient une consommation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b396f9e0-b250-48c3-9bd7-2c7337bf725a",
                                                "sense_id": "a4930424-bbd3-3b48-882a-84c77bf98790",
                                                "text": "Comme un consommateur au fond de l’établissement criait : — « Un bock, s’il vous plaît ! », il répondit aussitôt d’une voix terrible : — « Voilà, boum !… on y va, » et s’élança pour servir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8682c5f1-dca9-30de-94a9-f9a5556002f2",
                                        "entry_id": "9955f32c-4dc0-3c4c-89cb-a2fec4a3ad4c",
                                        "glosses": [
                                            "Bruit d’une explosion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b918e963-05df-418c-9e8f-6e25f16d784e",
                                                "sense_id": "8682c5f1-dca9-30de-94a9-f9a5556002f2",
                                                "text": "Enregistrements des v de particule dans le sol produites par des boums soniques à Edwards Air Force, Californie, à l'observatoire sismologique de Tonto Forest, Arizona, et Uinta Basin, Utah. L'analyse des données indique que les effets sismiques sont limités, latéralement, à la zone de l'enveloppe de p du boum, et, verticalement, à quelques mètres de profondeur."
                                            },
                                            {
                                                "example_id": "a57eb4fe-c056-4495-8369-a51647cb0e41",
                                                "sense_id": "8682c5f1-dca9-30de-94a9-f9a5556002f2",
                                                "text": "Un fracas, un boum et une vibration. Un fracas, un boum et une vibration et un fracas, un boum et une vibration. Pas aussi rapidement, mais c'était monotone. Un fracas, un boum et une vibration. C'est exactement la même sensation que lorsque l'on vous manque de peu : […]."
                                            },
                                            {
                                                "example_id": "0847ed06-2966-4c39-b514-046e6476f31d",
                                                "sense_id": "8682c5f1-dca9-30de-94a9-f9a5556002f2",
                                                "text": "Je ne suis plus aussi réactif aux bruits, je n'entends plus le boum de l’explosion dans mes oreilles, encore et encore, je dors beaucoup mieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b098bba4-e363-302d-9286-c53b4d87c876",
                                        "entry_id": "ef1397eb-ae09-35a9-a469-0f92a9863290",
                                        "glosses": [
                                            "Fête accompagnée de musique, organisée par ou pour des adolescents et jeunes adultes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c337245-5721-4081-9d24-d5c299e7be51",
                                                "sense_id": "b098bba4-e363-302d-9286-c53b4d87c876",
                                                "text": "[…] : moins fermée que la première, la boum de MJC en partageait la musique exclusivement jeune, mais restait beaucoup plus accessible pour les moins âgés ou ceux dont les familles étaient suspicieuses. Elle était, en effet, surveillée par un directeur et se déroulait dans un lieu connu, souvent l'après-midi. Les MJC proposaient aussi des bals mais, selon un calendrier fixe, à la différence des boums : bal de rentrée, du nouvel an... ouverts aux adultes, […]."
                                            },
                                            {
                                                "example_id": "9ff94046-47f8-487e-b232-d05062223d22",
                                                "sense_id": "b098bba4-e363-302d-9286-c53b4d87c876",
                                                "text": "L'après-midi avait été consacré à l'anniversaire classique avec les amis du lycée, le gâteau et les glaces, un semblant de boum encadré par ma mère qui assurait le service et veillait à l'absence totale d'alcool et de cigarette."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "903930a7-b9f0-37e2-af6e-03f99b17268e",
                                        "entry_id": "2db968a3-fd74-306a-b28b-611b31206f8a",
                                        "glosses": [
                                            "Développement considérable ; grosse augmentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a0c5401-ab43-4098-b515-0f30296f87d5",
                                                "sense_id": "903930a7-b9f0-37e2-af6e-03f99b17268e",
                                                "text": "Ce dernier estime que ces données témoignent d’un changement stratégique profond en Europe avec un boum des énergies renouvelables"
                                            },
                                            {
                                                "example_id": "bc9c6407-d16e-4265-acde-cf85c425a7a6",
                                                "sense_id": "903930a7-b9f0-37e2-af6e-03f99b17268e",
                                                "text": "En outre, le boum immobilier a contribué à l'inflation."
                                            },
                                            {
                                                "example_id": "537221ac-7b4e-40f1-bce2-b6b504823e14",
                                                "sense_id": "903930a7-b9f0-37e2-af6e-03f99b17268e",
                                                "text": "Au début du siècle à Hawaï, le boum de l’activité sucrière attira une main-d'œuvre étrangère venue de pays aussi différents que la Chine, le Japon, les Philippines, la Corée et le Portugal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
