                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>flikker</w> die oude kranten vanmiddag nog in de papierbak.",
                            "target_lang_translations": {
                                "en": "I will <w>toss</w> those old newspapers into the recycling bin this afternoon."
                            }
                        },
                        {
                            "text": "Soms <w>flikker</w> ik bijna van mijn fiets door de harde wind.",
                            "target_lang_translations": {
                                "en": "Sometimes I almost <w>fall</w> off my bike because of the strong wind."
                            }
                        }
                    ],
                    "traits": [
                        {
