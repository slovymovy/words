                        "examples": [
                            {
                                "example_id": "733aa094-f0ea-4a54-a840-a845179b95d8",
                                "sense_id": "d914054b-0ba5-3d5e-8495-fe07abc50255",
                                "text": "„Arbeitslose jugendliche Rennfahrer versuchen ihre stressige Woche hinter sich zu lassen, indem sie jeden mit ihrem Musikgeschmack beeindrucken. Junge Kerle, die enge schwarze Jeans und schwarze T-Shirts mit Löchern tragen, auf denen die Namen von Heavy-Metal-Bands oder Whiskymarken stehen.“"
                            },
                            {
                                "example_id": "86c531fb-ca9a-48f8-ab32-3d9b5af3af86",
                                "sense_id": "d914054b-0ba5-3d5e-8495-fe07abc50255",
                                "text": "„Kenny Jefferies ist ein Mann mit drei Leben. In einem ist oder war er der Gitarrist einer Heavy-Metal-Band mit dem Namen Tampon of Lamb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
