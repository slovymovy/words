                "senses": [
                    {
                        "sense_id": "93dba437-8e46-39cc-84d3-13ad5bb3a232",
                        "entry_id": "3263b64c-83f4-3572-8344-98b8eb5ccaf6",
                        "glosses": [
                            "истор., комп. портативный магнитный носитель информации, используемый для многократной записи и хранения данных сравнительно небольшого объёма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32fbd684-2c03-4279-a11f-5baa98f497bc",
                                "sense_id": "93dba437-8e46-39cc-84d3-13ad5bb3a232",
                                "text": "Саша .. подошёл к своему рабочему месту, .. сел за свой компьютер и сбросил на дискету всё, что было нужно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5aac6321-3d9d-4e65-b947-5ee0f8d71bdd",
                        "source_entry_id": "3263b64c-83f4-3572-8344-98b8eb5ccaf6",
                        "source_sense_id": "93dba437-8e46-39cc-84d3-13ad5bb3a232",
                        "target_lang_word": "floppy disk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "floppy disk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57a269d5-e237-348f-9816-b039b3079851",
                                        "entry_id": "da11aa49-fd42-3866-8626-12fd3b04db3f",
                                        "glosses": [
                                            "A removable disk used for storing digital data, measuring between 2 and 8 inches diagonally and storing between 80 KB and 240 MB."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533be5f1-8cde-43b2-8b9f-72eaaa5fa221",
                                                "sense_id": "57a269d5-e237-348f-9816-b039b3079851",
                                                "text": "A hacker starts with nothing but a dream and a floppy disk and presently finds himself in a business that's doubled and trebled."
                                            },
                                            {
                                                "example_id": "6170c7a2-4094-4611-b386-32755da8b20a",
                                                "sense_id": "57a269d5-e237-348f-9816-b039b3079851",
                                                "text": "The floppy disk itself is a magnetically coated flexible plastic disk which is mounted in a protective envelope and can be used as a mass data storage medium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
