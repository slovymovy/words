                "senses": [
                    {
                        "sense_id": "4acec5f2-8cc3-3b88-b9cc-fc228ad4d74d",
                        "entry_id": "b4ac84aa-c6b2-3277-bc14-1625e7dff37c",
                        "glosses": [
                            "Programm, das im Rahmen eines anderen Programms betrieben wird"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "caf56db5-8f3b-4727-9013-addbd60143db",
                                "sense_id": "4acec5f2-8cc3-3b88-b9cc-fc228ad4d74d",
                                "text": "„Die Parameter des Applets sind gut dokumentiert, die nichtkommerzielle Verwendung ist kostenlos.“"
                            },
                            {
                                "example_id": "d509422f-718f-4448-a9ce-d555f5695b47",
                                "sense_id": "4acec5f2-8cc3-3b88-b9cc-fc228ad4d74d",
                                "text": "„Kommt das Applet zur Ausführung, kann der Angreifer den Datenstrom nach dem Proxy umleiten und, soweit nicht verschlüsselt, mitlesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b613de26-2e67-4778-8f09-d4866f510ccc",
                        "source_entry_id": "b4ac84aa-c6b2-3277-bc14-1625e7dff37c",
                        "source_sense_id": "4acec5f2-8cc3-3b88-b9cc-fc228ad4d74d",
                        "source_sense_description": "EDV: Programm, das im Rahmen eines anderen Programms betrieben wird",
                        "target_lang_word": "applet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "applet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e98cee6c-3f1b-3b7a-bea9-5921ffccd65a",
                                        "entry_id": "faa9e93d-38ae-3ece-833a-b6c8dba71b2f",
                                        "glosses": [
                                            "A small program module that runs under the control of a larger application, typically a web browser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9a24dca-2006-4b27-a053-6f2d26904a8c",
                                                "sense_id": "e98cee6c-3f1b-3b7a-bea9-5921ffccd65a",
                                                "text": "Holonyms: app, application, program"
                                            },
                                            {
                                                "example_id": "830b1523-49a3-4dd4-a042-1a9cfdde15a7",
                                                "sense_id": "e98cee6c-3f1b-3b7a-bea9-5921ffccd65a",
                                                "text": "If a component must run on different kinds of client systems and if the limitations imposed by sandboxing are acceptable or outright desirable, then building that component as a Java applet makes sense."
                                            },
                                            {
                                                "example_id": "f3abd124-ff5e-40fe-9d65-0b7f0aec54d8",
                                                "sense_id": "e98cee6c-3f1b-3b7a-bea9-5921ffccd65a",
                                                "text": "You can also configure a hot corner to open the Expo screen, or install the Expo applet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
