                    {
                        "sense_id": "b49d0e1e-a3f7-36dd-9faf-c7abc2ceaa45",
                        "entry_id": "9563b2a6-8e1f-3ee2-b1bb-e0660c12e146",
                        "glosses": [
                            "schwarzgebrannte Spirituose"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "543be056-f66f-4d7b-903b-d5da051518be",
                                "sense_id": "b49d0e1e-a3f7-36dd-9faf-c7abc2ceaa45",
                                "text": "„›Nimm dir'n Viertelliter Moonshine, ich schreib's bei dir auf. Und bring mir einen von den verzollten Whiskeys mit, wenn du da reingehst.‹“"
                            },
                            {
                                "example_id": "00de5d4a-bfd6-442b-a2e8-8b11867210ae",
                                "sense_id": "b49d0e1e-a3f7-36dd-9faf-c7abc2ceaa45",
                                "text": "„›Kennst du Moonshine?‹, fragte sie mich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "452b1d7c-1075-4c2a-a491-99119104266f",
                        "source_entry_id": "9563b2a6-8e1f-3ee2-b1bb-e0660c12e146",
                        "source_sense_id": "b49d0e1e-a3f7-36dd-9faf-c7abc2ceaa45",
