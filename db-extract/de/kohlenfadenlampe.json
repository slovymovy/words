                "senses": [
                    {
                        "sense_id": "41801f76-d036-3cef-9627-df05dae5d545",
                        "entry_id": "d48143f1-05fc-318e-a5d1-11c3c7e72bdc",
                        "glosses": [
                            "Lampe mit einem aus Kohle hergestellten Glühfaden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c96eb2d-7daa-4a01-8fe5-2bd7bc552d82",
                                "sense_id": "41801f76-d036-3cef-9627-df05dae5d545",
                                "text": "Kohlefadenlampen werden auch heute noch angeboten."
                            },
                            {
                                "example_id": "ae4f9ffa-826c-43cb-92d7-90f7ae7027d4",
                                "sense_id": "41801f76-d036-3cef-9627-df05dae5d545",
                                "text": "„1854 erfand H. Goebel die Glühlampe, und 1879 entwickelte Edison die Kohlenfadenlampe.“"
                            },
                            {
                                "example_id": "5af43ecf-3062-4677-be02-a867d5b219af",
                                "sense_id": "41801f76-d036-3cef-9627-df05dae5d545",
                                "text": "„Bei der Suche nach dem Kaltlicht experimentierte er mit einer Schusterkugel, um die Lichtausbeute der damals neuen Kohlenfadenlampe zu verstärken.“"
                            }
                        ],
