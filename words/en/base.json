                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politics_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate gave a speech designed to energize his political <w>base</w>.",
                            "target_lang_translations": {
                                "ru": "Кандидат произнес речь, призванную активизировать его политическую <w>базу</w>.",
                                "tr": "Aday, kendi siyasi <w>tabanını</w> harekete geçirmek için tasarlanmış bir konuşma yaptı.",
                                "zh": "候选人发表了一场旨在激励其政治<w>选民基础</w>的演讲。"
                            }
                        },
                        {
                            "text": "The party needs to expand its support beyond its traditional <w>base</w>.",
                            "target_lang_translations": {
                                "ru": "Партии необходимо расширить поддержку за пределы своей традиционной <w>базы</w>.",
                                "tr": "Partinin desteğini geleneksel <w>tabanının</w> ötesine genişletmesi gerekiyor.",
                                "zh": "该党需要将其支持范围扩大到传统<w>选民基础</w>之外。"
                            }
                        }
                    ],
                    "synonyms": [
                        "electoral base",
                        "political base"
                    ],
                    "common_phrases": [
                        "voter base",
                        "support base",
                        "party base"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "politics"
                        }
