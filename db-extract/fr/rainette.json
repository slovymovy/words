        "fr-extract.jsonl": [
            {
                "entry_id": "f52fae7d-9d96-3ad1-b2fd-39a9804e55ee",
                "word": "rainette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b7c16890-c934-437c-845e-ddf0dccf256d",
                        "entry_id": "f52fae7d-9d96-3ad1-b2fd-39a9804e55ee",
                        "tags": [
