                        "form": "die Musseline"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8a71b68-a025-3638-b09e-e8f9c85b8dd1",
                        "entry_id": "20c285a5-5783-38da-b399-253a8b8583df",
                        "glosses": [
                            "„feines, locker gewebtes [Baum]wollgewebe“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d216ebe3-7b26-46d3-9bcc-692d5bc39a8d",
                                "sense_id": "e8a71b68-a025-3638-b09e-e8f9c85b8dd1",
                                "text": "„Wir hatten neben anderen Waren vor allem zweiundvierzig Ballen indische Stoffe der verschiedensten Art, wie Seiden, Musseline und feine Chintze, bei uns, dazu fünfzehn Ballen sehr kostbare chinesische Seiden und siebzig Bündel oder Ballen Gewürze, insbesondere Nelken und Muskatnüsse.“"
                            },
                            {
                                "example_id": "54078be7-cb76-4755-ad53-89f72d4628ed",
                                "sense_id": "e8a71b68-a025-3638-b09e-e8f9c85b8dd1",
                                "text": "„Das übrige erriet ich, denn die zarten Falten des Musselins konnten mir nur die lebende Oberfläche verbergen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa6ff8d8-9838-4107-846a-6dd503756fdc",
                        "source_entry_id": "20c285a5-5783-38da-b399-253a8b8583df",
                        "source_sense_id": "e8a71b68-a025-3638-b09e-e8f9c85b8dd1",
                        "target_lang_word": "muslin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muslin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e4ca9d8-f183-3772-875c-9ac5c8705e45",
                                        "entry_id": "e64d2def-8de4-39bd-9013-fc6cc97c9b2f",
                                        "glosses": [
                                            "Any of several varieties of thin cotton cloth."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2ea719f-3b1f-42c7-b7f5-7259267450ac",
                                                "sense_id": "0e4ca9d8-f183-3772-875c-9ac5c8705e45",
                                                "text": "[…] my pupils leave off their thick shoes and tight old tartan pelisses, and wear silk stockings and muslin frocks, as fashionable baronets' daughters should."
                                            },
                                            {
                                                "example_id": "f65a4632-f13f-4bee-8790-3f4b50884568",
                                                "sense_id": "0e4ca9d8-f183-3772-875c-9ac5c8705e45",
                                                "text": "A bleached or unbleached thin white cotton cloth, unprinted and undyed. [Nineteen varieties are thereafter listed.]"
                                            },
                                            {
                                                "example_id": "c5a94d48-84b9-4be4-be53-d680a610b4c2",
                                                "sense_id": "0e4ca9d8-f183-3772-875c-9ac5c8705e45",
                                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street. He wore shepherd's plaid trousers and the swallow-tail coat of the day, with a figured muslin cravat wound about his wide-spread collar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db23dddf-ebc8-3f13-9b60-302eb7dbf8a1",
                                        "entry_id": "e64d2def-8de4-39bd-9013-fc6cc97c9b2f",
                                        "glosses": [
                                            "Fabric made of cotton, flax (linen), hemp, or silk, finely or coarsely woven."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd7432b0-79e3-44e9-af1d-53740de57980",
                                                "sense_id": "db23dddf-ebc8-3f13-9b60-302eb7dbf8a1",
                                                "text": "Other very different styles of fabric are now indifferently called muslins, and the term is used differently on the respective sides of the Atlantic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70bfc325-fa5a-387b-b09e-09b5072e280e",
                                        "entry_id": "e64d2def-8de4-39bd-9013-fc6cc97c9b2f",
                                        "glosses": [
                                            "Any of a wide variety of tightly-woven thin fabrics, especially those used for bedlinen."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd975ae3-3b9f-3a82-a810-46a068114628",
                                        "entry_id": "e64d2def-8de4-39bd-9013-fc6cc97c9b2f",
                                        "glosses": [
                                            "Woven cotton or linen fabrics, especially when used for items other than garments."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77ab7097-8f30-3307-8711-b540ca33b3b4",
                                        "entry_id": "e64d2def-8de4-39bd-9013-fc6cc97c9b2f",
                                        "glosses": [
                                            "A dressmaker's pattern made from inexpensive cloth for fitting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12e4f98e-aee4-346f-b3ed-c6f665f6f560",
                                        "entry_id": "e64d2def-8de4-39bd-9013-fc6cc97c9b2f",
                                        "glosses": [
                                            "Any of several different moths, especially the muslin moth, Diaphora mendica."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e57053c0-3f30-3de5-a68f-1d1b60eb4ddb",
                                        "entry_id": "e64d2def-8de4-39bd-9013-fc6cc97c9b2f",
                                        "glosses": [
                                            "Woman as sex object; prostitute, as in a bit of muslin."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d67baee-12ac-4a12-9783-77deaacda404",
                                                "sense_id": "e57053c0-3f30-3de5-a68f-1d1b60eb4ddb",
                                                "text": "\"That was a pretty bit of muslin hanging on your arm—who was she?” asked the fascinating student."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e64667f5-5ae2-4a59-91c9-25d16252702c",
                        "source_entry_id": "20c285a5-5783-38da-b399-253a8b8583df",
                        "source_sense_id": "e8a71b68-a025-3638-b09e-e8f9c85b8dd1",
                        "target_lang_word": "mousseline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mousseline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef02f845-3532-3edb-b56d-19a7ab75cb4f",
                                        "entry_id": "f6e1854a-fe1c-361c-8b4c-ab5dc6a43496",
                                        "glosses": [
                                            "Toile de coton très claire et ordinairement très fine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc2f2b7c-c2a3-4150-857c-9db41801f695",
                                                "sense_id": "ef02f845-3532-3edb-b56d-19a7ab75cb4f",
                                                "text": "Elle était vêtue avec une magnificence pleine de charme et d'élégance. La mousseline des Indes faisait tous les frais de sa toilette."
                                            },
                                            {
                                                "example_id": "68b981dd-4573-499a-8890-f3bf711a59b4",
                                                "sense_id": "ef02f845-3532-3edb-b56d-19a7ab75cb4f",
                                                "text": "La Clope avait une voix de petite fille modèle, une voix fait pour être enveloppée de mousseline, un de ces voix dont on dit qu’elle passe sur les dents comme sur des perles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604da249-1caf-33a6-a6ca-980bcae8f27b",
                                        "entry_id": "f6e1854a-fe1c-361c-8b4c-ab5dc6a43496",
                                        "glosses": [
                                            "Étoffe fine et souple."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f145d5cb-f7ef-448a-938d-6150b6990d9f",
                                                "sense_id": "604da249-1caf-33a6-a6ca-980bcae8f27b",
                                                "text": "Mademoiselle Marie avait un petit logement au rez-de-chaussée, tendu en laine bleue, avec des rideaux de mousseline blanche. Cela lui allait au teint, et je la trouvai plus jolie."
                                            },
                                            {
                                                "example_id": "72209076-172d-453a-8ee2-15b76cc74a3e",
                                                "sense_id": "604da249-1caf-33a6-a6ca-980bcae8f27b",
                                                "text": "A chaque fenêtre on aperçoit, sous les rideaux de mousseline, des fuchsias ou des géraniums cultivés dans des pots avec une touchante sollicitude."
                                            },
                                            {
                                                "example_id": "34375ab8-de08-4848-bcc6-21b6cbe0f74e",
                                                "sense_id": "604da249-1caf-33a6-a6ca-980bcae8f27b",
                                                "text": "Par la fenêtre entr’ouverte, l’air entrait, gonflant comme une voile les rideaux de mousseline, et j’apercevais un pan de ciel bleu."
                                            },
                                            {
                                                "example_id": "0af6a5fe-5291-4ee5-b95c-0bf62afb1933",
                                                "sense_id": "604da249-1caf-33a6-a6ca-980bcae8f27b",
                                                "text": "Le regard perdu dans le ciel, elle est debout près de la fenêtre. Machinalement, elle froisse la fine mousseline des rideaux."
                                            },
                                            {
                                                "example_id": "da83cd7a-3bad-4df2-b910-56619d49a551",
                                                "sense_id": "604da249-1caf-33a6-a6ca-980bcae8f27b",
                                                "text": "Il est doux d’être convalescent par les soirs où tombe la pluie ; cela est plus doux encore par les soirs de soleil. Des mouches vous rendent visite à la fenêtre ; on hésite à les écraser entre la vitre et la mousseline, par pitié d’abord, et puis c’est si sale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4bbe0e2-dda4-3f5d-b671-1096529538aa",
                                        "entry_id": "f6e1854a-fe1c-361c-8b4c-ab5dc6a43496",
                                        "glosses": [
                                            "Écran léger, voile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94c21e3b-a601-41e3-8c1e-070d6bbc79e6",
                                                "sense_id": "d4bbe0e2-dda4-3f5d-b671-1096529538aa",
                                                "text": "Les vitres embuées mettaient une doublure de mousseline à la translucidité des rideaux de cretonne blanchissant avec la lumière levante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c500e58e-4d66-3069-ac42-d04d234233f2",
                                        "entry_id": "f6e1854a-fe1c-361c-8b4c-ab5dc6a43496",
                                        "glosses": [
                                            "Verre à vin très fin, dépoli et orné de motifs imitant le tissu du même nom. → voir mousselinage"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5f0c7f2-4370-45c6-b83a-30d1f2cea6d1",
                                                "sense_id": "c500e58e-4d66-3069-ac42-d04d234233f2",
                                                "text": "L'intoxication saturnine est fréquente chez les ouvriers en verre de mousseline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0027c6e9-6375-3ce3-bb31-327658bcec3a",
                                        "entry_id": "f6e1854a-fe1c-361c-8b4c-ab5dc6a43496",
                                        "glosses": [
                                            "Fine purée de pomme de terre, plus généralement préparation légère."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57518bef-2962-41e6-8b48-eb0c4c761af9",
                                                "sense_id": "0027c6e9-6375-3ce3-bb31-327658bcec3a",
                                                "text": "Après avoir raclé le fond de mousseline de saumon, Victor emporta la calotte vide vers les éviers."
                                            },
                                            {
                                                "example_id": "8bf4d5be-d2d4-4457-af6d-1b80f0c4b6b1",
                                                "sense_id": "0027c6e9-6375-3ce3-bb31-327658bcec3a",
                                                "text": "Continuons avec les desserts : la spécialité du chef est le tube de chocolat et sa mousseline aux fraises, mais il y a aussi cet exquis Antillais (mousseline au chocolat, avec en son cœur, des bananes flambées)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "887d73f6-988a-3a88-ac6a-c1bf66dd23b7",
                                        "entry_id": "f6e1854a-fe1c-361c-8b4c-ab5dc6a43496",
                                        "glosses": [
                                            "Plante du genre Asparagus."
                                        ],
                                        "tags": [
                                            "Guadeloupe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "251521e2-f66b-4b56-a01f-3716daf5777c",
                                                "sense_id": "887d73f6-988a-3a88-ac6a-c1bf66dd23b7",
                                                "text": "L’ombre mouvante des mousselines était aussi vaporeuse que leur feuillage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mousseline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86b1b024-9a0e-3f5c-b3d5-6ae336c3c2c1",
                                        "entry_id": "1e50bd77-7b6c-312e-b71b-74417a619242",
                                        "glosses": [
                                            "Qualifie des préparations légères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbe03af0-362b-4080-9305-75e018393f4c",
                                                "sense_id": "86b1b024-9a0e-3f5c-b3d5-6ae336c3c2c1",
                                                "text": "Brioche mousseline, brioche très légère."
                                            },
                                            {
                                                "example_id": "87fde5c2-9318-450e-82b2-ec16324a8405",
                                                "sense_id": "86b1b024-9a0e-3f5c-b3d5-6ae336c3c2c1",
                                                "text": "Pommes mousseline, purée de pommes de terre fouettée avec des œufs et de la crème fraiche."
                                            },
                                            {
                                                "example_id": "f6b326ea-d89b-4396-8ddc-0cebe998df78",
                                                "sense_id": "86b1b024-9a0e-3f5c-b3d5-6ae336c3c2c1",
                                                "text": "Sauce mousseline, sauce hollandaise à laquelle on a ajouté de la crème fraiche fouettée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dfc502d-d941-3170-9656-1fbe2a507581",
                                        "entry_id": "1e50bd77-7b6c-312e-b71b-74417a619242",
                                        "glosses": [
                                            "Très fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f4a1f78-6aa4-4aa4-a1ac-b7db2ff62237",
                                                "sense_id": "4dfc502d-d941-3170-9656-1fbe2a507581",
                                                "text": "Verres, porcelaine mousseline, verres fins, porcelaine fine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
