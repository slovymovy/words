                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de vroege zomer moet de teler de druiventrossen zorgvuldig <w>krenten</w> met een schaartje.",
                            "target_lang_translations": {
                                "en": "In early summer, the grower must carefully <w>thin</w> the grape bunches with small scissors."
                            }
                        },
                        {
                            "text": "Als je de druiven niet op tijd <w>krent</w>, blijven de vruchten te klein en zuur.",
                            "target_lang_translations": {
