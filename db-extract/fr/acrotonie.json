                        "glosses": [
                            "Croissance prédominante au niveau de l'extrémité d'une plante ou d'un rameau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7890231a-72d2-4a20-84fc-32bcf076cd45",
                                "sense_id": "c7efdd26-a770-3bd3-9ed1-3dac96e76b8c",
                                "text": "Hydrangea macrophylla est parfaitement basitone mais il possède une acrotonie qui variera dans d’importantes proportions selon le cultivar."
                            },
                            {
                                "example_id": "671d468b-5772-438f-b64b-91317f54cc6e",
                                "sense_id": "c7efdd26-a770-3bd3-9ed1-3dac96e76b8c",
                                "text": "L’acrotonie ? C’est la tendance à vouloir toujours aller plus haut, en alimentant préférentiellement en sève les branches près de la cime, et ainsi favoriser la croissance du bout de ces branches."
                            }
                        ]
                    }
                ],
