                "senses": [
                    {
                        "sense_id": "e4c31624-c0fc-3000-85f6-34b2e2e8a6a6",
                        "entry_id": "d4309fb2-990e-3da1-8c8f-60548140f1f5",
                        "glosses": [
                            "luminiferous, luminous, light-bringing"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "c0ac03d5-1a13-4a0b-abc9-40645f2a0e0d",
                                "sense_id": "e4c31624-c0fc-3000-85f6-34b2e2e8a6a6",
                                "text": "Из-за верши́н да́льнего тёмно-си́зого ле́са сверкну́л золоти́стый серп. Он растёт, растёт, и вот на безо́блачный, я́сный небоскло́н вы́катилось светоно́сное со́лнце.",
                                "translation": "A golden crescent glittered beyond the tops of the trees of the distant dark-bluish forest. It began growing and growing, until the luminous sun rolled out into the cloudless, clear sky.",
                                "english": "A golden crescent glittered beyond the tops of the trees of the distant dark-bluish forest. It began growing and growing, until the luminous sun rolled out into the cloudless, clear sky."
                            }
                        ]
                    }
