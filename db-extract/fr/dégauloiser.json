                "senses": [
                    {
                        "sense_id": "aa069a5d-33ce-33f9-93df-35d8f8eb7612",
                        "entry_id": "7d3385a3-6e37-34a4-a22c-ccdd0346f54b",
                        "glosses": [
                            "Ôter le caractère gaulois ou grivois d'une chose."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "218f4467-3d3d-4a78-b8f4-4437f84222bd",
                                "sense_id": "aa069a5d-33ce-33f9-93df-35d8f8eb7612",
                                "text": "Si la Quinault avait entrepris de dégauloiser Piron, lui demanderait-elle avec tant d'insistance certaine chanson gauloise qu'il lui a promise et qui tarde à arriver ?"
                            },
                            {
                                "example_id": "a6d5e934-ac20-458b-9e5c-5ebf43490e48",
                                "sense_id": "aa069a5d-33ce-33f9-93df-35d8f8eb7612",
                                "text": "Ils prétendent que l'on veut créer, dans notre joyeux pays, une nouvelle armée du Salut, monachiser (…) la France, dégauloiser la patrie de François Iᵉʳ et d'Henri IV, excommunier les verts-galants."
                            }
                        ]
                    }
