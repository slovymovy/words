                    {
                        "sense_id": "4a62f135-98ff-3319-b243-e2ccbd9829f2",
                        "entry_id": "393a7070-116d-3f76-914e-5e6aad06ae7b",
                        "glosses": [
                            "Peur pathologique et injustifiée de la neige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1220f66d-0083-45bc-bb18-2ddd460c97e9",
                                "sense_id": "4a62f135-98ff-3319-b243-e2ccbd9829f2",
                                "text": "Chionophobie, répondit-il, juste un mot bien savant pour décrire une peur incontrôlée de la neige. Il s'agit en général d'une peur déportée. La substance en elle-même n'en est pas la cause, mais elle engendre chez le patient une peur de glisser ou de prendre la voiture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9989c906-a6ef-4c13-9695-72e2ace96568",
                        "source_entry_id": "393a7070-116d-3f76-914e-5e6aad06ae7b",
                        "source_sense_id": "4a62f135-98ff-3319-b243-e2ccbd9829f2",
                        "target_lang_word": "chionophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chionophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "720d7288-b569-3691-9ef0-292233c63e34",
                                        "entry_id": "979626a1-1a6d-339e-966f-917f4fe4107a",
                                        "glosses": [
                                            "Fear of snow."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f6ed79b-d398-4849-b77f-9a781e9c1134",
                                                "sense_id": "720d7288-b569-3691-9ef0-292233c63e34",
                                                "text": "Do you hesitate to step outside when it snows? Do you insist on keeping off the highways when they are snow-packed? Every time you see a flake falling, do you wish you were in Florida? Does even a snow flurry send you into a frenzy? If you have these symptoms, don’t let anyone call you a fraidy-cat? You’ve got chionophobia!"
                                            },
                                            {
                                                "example_id": "956235d8-63bd-4b35-848f-933e7efeff48",
                                                "sense_id": "720d7288-b569-3691-9ef0-292233c63e34",
                                                "text": "Snowbirds have an often-contagious case of cryophobia, or fear of the cold, along with chionophobia — intense fear of snow."
                                            },
                                            {
                                                "example_id": "0f123408-e471-4875-a5a4-91a6c0433e74",
                                                "sense_id": "720d7288-b569-3691-9ef0-292233c63e34",
                                                "text": "I don’t have chionophobia, a fear of snow. I’ve been an avid snowshoer and a snowball flinger of some repute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
