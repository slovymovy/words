                    },
                    {
                        "translation_id": "9a99a986-6a72-4ac7-98bf-6ddd3951ad0f",
                        "source_entry_id": "b4067a14-7684-3f53-a176-36f1f2491abb",
                        "source_sense_id": "a0b13199-88ce-322e-ad4e-479e8d80b3ac",
                        "target_lang_word": "intubation",
                        "target_lang_code": "en",
