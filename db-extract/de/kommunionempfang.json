                ],
                "senses": [
                    {
                        "sense_id": "ae7e614b-918c-3a7f-9c6c-b4facaa29fa2",
                        "entry_id": "909e45fd-abe4-3946-9f0a-4d45ea9e6b55",
                        "glosses": [
                            "der Empfang der eucharistischen Gaben (Kommunion)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde58281-336e-44c3-ac4c-6c188cbd6634",
                                "sense_id": "ae7e614b-918c-3a7f-9c6c-b4facaa29fa2",
                                "text": "„Erstkommunion […] heißt in der altkatholischen und römisch-katholischen Kirche der meist festlich begangene erste Kommunionempfang der Kinder.“"
                            },
                            {
                                "example_id": "510a612c-aced-4918-b2a6-4c05d52a07c6",
                                "sense_id": "ae7e614b-918c-3a7f-9c6c-b4facaa29fa2",
                                "text": "Chaput hat mehrmals verkündet, dass Katholiken, die im Stand der schweren Sünde leben oder die Lehre der Kirche leugnen, sich freiwillig vom Kommunionempfang zurückhalten sollen."
                            },
                            {
                                "example_id": "7f23d154-3979-4674-ad3b-2b15095d9145",
                                "sense_id": "ae7e614b-918c-3a7f-9c6c-b4facaa29fa2",
                                "text": "„Die gemeinsame Feier und der gemeinsame Kommunionempfang hat einen stark gemeinschaftsbildenden Aspekt; die Symbolik des einen Brotes, das aus vielen Körnern bereitet ist – und auch des Weins, der aus vielen Trauben gekeltert ist – spricht davon.“"
                            },
                            {
                                "example_id": "da73cd67-7fe4-4e17-86f7-0a0189b4352f",
                                "sense_id": "ae7e614b-918c-3a7f-9c6c-b4facaa29fa2",
                                "text": "„Diese äußere und innere Haltung soll ganz deutlich machen, da[ss] ich beim Kommunionempfang ein Beschenkter, ein Empfangender bin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
