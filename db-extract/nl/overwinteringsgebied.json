                        "glosses": [
                            "plaats waar vogels de winter doorbrengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05cf6c9e-4767-44a4-a909-76219d1ced32",
                                "sense_id": "4e1f20fc-5ac0-33ce-bbad-6afd2d363dc3",
                                "text": "Ieder jaar worden in de Groningse Eemshaven duizenden vogels gedood door windmolens. Vooral trekvogels die in de herfst naar hun overwinteringsgebied vliegen, komen in de wieken terecht. Met een zogenoemde trekvogelradar wil de provincie Groningen het aantal vogelslachtoffers laten dalen."
                            },
                            {
                                "example_id": "8697c65d-736b-4161-a146-2920ac1aa0b2",
                                "sense_id": "4e1f20fc-5ac0-33ce-bbad-6afd2d363dc3",
                                "text": "De Waddenzee is 's werelds grootste gebied dat met eb droogvalt en met vloed weer overspoelt. Het is bovendien het enige Nederlandse natuurgebied met UNESCO-werelderfgoedstatus. De kwelders en wadplaten zijn onmisbaar als broedgebied, overwinteringsgebied en pleisterplaats voor miljoenen trekvogels in hun jaarlijkse reizen van de Arctische toendra tot tropisch Afrika."
                            }
                        ]
                    }
