                "senses": [
                    {
                        "sense_id": "bffc8e2f-9f42-3f83-a5ec-c07d1b87dccd",
                        "entry_id": "47f4c1b0-8463-3b9d-83b5-8a062da0c22a",
                        "glosses": [
                            "(männliche^☆) Person, die im Bereich des Abbruchs von Gebäuden oder Bauwerken tätig ist und sich hauptsächlich mit den eigentlichen Abbrucharbeiten befasst, ohne Nebentätigkeiten wie Aufräumen, Laden oder Säubern auszuführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bed76ad0-f788-4fec-8a01-c5564e9947d4",
                                "sense_id": "bffc8e2f-9f42-3f83-a5ec-c07d1b87dccd",
                                "text": "„Der gelernte Elektriker, der 1956 im VEB Sachsenring anfing, muß dafür sorgen, daß durch Hunderte von Leitungen, die oft verdeckt hinter Maschinen und Regalen verlaufen, kein Strom mehr fließt, wenn die Abbrucharbeiter mit ihren Zangen und Sägen kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
