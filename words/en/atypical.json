    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "71b2b66b-1a45-3089-92bf-f0fdf6b1f415",
                    "sense_definition": "Not conforming to the usual type, pattern, or expectation; unusual or irregular.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient showed an <w>atypical</w> response to the prescribed medication.",
                            "target_lang_translations": {
                                "zh": "该患者对所开药物表现出了<w>非典型的</w>反应。"
                            }
                        },
                        {
                            "text": "Such extremely warm weather is completely <w>atypical</w> for this region in winter.",
                            "target_lang_translations": {
                                "zh": "这种极度温暖的天气对该地区冬季来说完全是<w>反常的</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "irregular",
                        "unusual",
                        "abnormal",
                        "untypical"
                    ],
                    "antonyms": [
                        "typical"
                    ],
                    "common_phrases": [
                        "atypical behavior",
                        "atypical symptoms",
                        "atypical presentation",
                        "atypical case"
                    ],
                    "target_lang_definitions": {
                        "zh": "不符合通常的类型、模式或预期的；非典型的、反常的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "非典型的",
                                "target_lang_sense_clarification": "不符合典型特征或常态的"
                            },
                            {
                                "target_lang_word": "反常的",
                                "target_lang_sense_clarification": "与平常情况不同、不合常理的"
                            },
                            {
                                "target_lang_word": "异常的",
                                "target_lang_sense_clarification": "不正常的、特殊的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93593aa9-c4af-3b77-8118-b80dbccaaf84",
                    "sense_definition": "An atypical antipsychotic medication.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor decided to prescribe an <w>atypical</w> to reduce the risk of motor side effects.",
                            "target_lang_translations": {
                                "zh": "医生决定开一种<w>非典型抗精神病药</w>，以降低出现运动副作用的风险。"
                            }
                        },
                        {
                            "text": "Many patients respond better to an <w>atypical</w> than to first-generation neuroleptics.",
                            "target_lang_translations": {
                                "zh": "许多患者对<w>非典型抗精神病药</w>的反应优于第一代抗神经病药。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "非典型抗精神病药物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "非典型抗精神病药",
                                "target_lang_sense_clarification": "第二代抗精神病药物"
                            }
                        ]
                    }
                }
            ]
        }
