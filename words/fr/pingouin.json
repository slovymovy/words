                    "frequency": "High",
                    "semantic_group_id": "oiseau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants adorent regarder les <w>pingouins</w> marcher maladroitement sur la banquise."
                        },
                        {
                            "text": "Dans ce film documentaire, un <w>pingouin</w> glisse joyeusement sur la neige polaire."
                        }
                    ],
                    "synonyms": [
