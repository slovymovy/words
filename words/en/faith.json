                {
                    "sense_id": "b9e1107d-bbeb-37fb-9ce0-0babb3769a48",
                    "sense_definition": "Sincerity of intention or honesty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sincerity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company negotiated in good <w>faith</w> to reach a fair agreement.",
                            "target_lang_translations": {
                                "ru": "Компания вела переговоры <w>добросо́вестно</w>, чтобы достичь справедливого соглашения.",
                                "tr": "Şirket, adil bir anlaşmaya varmak için iyi <w>niyetle</w> müzakere etti.",
                                "zh": "公司本着<w>诚意</w>进行谈判，以达成公平的协议。",
                                "pl": "Firma negocjowała w <w>dobrej wierze</w>, aby osiągnąć sprawiedliwe porozumienie."
                            }
                        },
                        {
                            "text": "We assumed they were acting in good <w>faith</w> when they made the offer.",
                            "target_lang_translations": {
                                "ru": "Мы полагали, что они действуют <w>добросо́вестно</w>, когда они сделали это предложение.",
                                "tr": "Teklifi yaptıklarında iyi <w>niyetle</w> hareket ettiklerini varsaydık.",
                                "zh": "我们以为他们提出报价时是出于<w>诚意</w>的。",
                                "pl": "Zakładaliśmy, że działają w <w>dobrej wierze</w>, składając tę ofertę."
                            }
                        }
                    ],
                    "antonyms": [
                        "dishonesty"
                    ],
                    "common_phrases": [
                        "in good faith",
                        "in bad faith"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искренность намерений или честность.",
                        "tr": "Niyetin samimiyeti veya dürüstlük.",
                        "zh": "意图的真诚或诚实。",
                        "pl": "Szczerość intencji lub uczciwość."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добросо́вестность",
                                "target_lang_sense_clarification": "честность"
                            },
                            {
                                "target_lang_word": "че́стность",
                                "target_lang_sense_clarification": "искренность"
                            }
                        ],
                        "tr": [
