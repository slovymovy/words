                                                "sense_id": "0b887228-847f-3a85-a1f6-177185ff8a75",
                                                "text": "Étriper un veau, un cochon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54da046e-f66c-3c14-a023-0cb1dee433df",
                                        "entry_id": "072e2531-cfce-3cd8-bf9a-7ede6a9710f5",
                                        "glosses": [
                                            "ou (réciproque) Battre, rosser."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a81d7b3-85b5-4606-b098-67f397314405",
                                                "sense_id": "54da046e-f66c-3c14-a023-0cb1dee433df",
                                                "text": "S’il s’imagine étriper sa progéniture à la première anicroche, mieux vaut renoncer."
                                            },
                                            {
                                                "example_id": "0708b66b-c17e-482b-b8af-9614b72997cb",
                                                "sense_id": "54da046e-f66c-3c14-a023-0cb1dee433df",
                                                "text": "Je vais t’étriper !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e76cce6c-1bca-3ccc-b8ef-13d8fe3be884",
                                        "entry_id": "072e2531-cfce-3cd8-bf9a-7ede6a9710f5",
                                        "glosses": [
                                            "ou (réciproque) Lacérer, dilacérer."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pronominal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1ca1642-4c2d-4ac4-a118-d3dab739bba3",
                                                "sense_id": "e76cce6c-1bca-3ccc-b8ef-13d8fe3be884",
                                                "text": "M. de Coulombe écrivit à M. le Comté de Maurepas qu’il étoit content des manœuvres dormantes, mais que les manœuvres courantes avoient été commises trop peu, qu’elles s’étripoient, qu’au reste il avoit fait mettre ces manœuvres dans un Magasin, pour qu’on leur fît souffrir telle épreuve qu’on jugeroit convenable."
                                            }
                                        ]
                                    }
