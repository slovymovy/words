                    {
                        "translation_id": "2147560c-75c7-4690-bd3e-9b0eb3b41746",
                        "source_entry_id": "9be8f932-f8bc-3201-b5e0-e03e592b76c7",
                        "source_sense_description": "Vache (1)",
                        "target_lang_word": "heifer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heifer",
