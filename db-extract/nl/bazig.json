                "senses": [
                    {
                        "sense_id": "875118bf-61f4-3cd2-b457-4aa82a5cbaa6",
                        "entry_id": "1bef460b-6064-3fdc-aab7-4e17f7048a89",
                        "glosses": [
                            "autoritair, zich gedragend alsof een ander gehoorzaam moet zijn, de baas spelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab850bd-6c70-4711-bb37-8542e9087152",
                                "sense_id": "875118bf-61f4-3cd2-b457-4aa82a5cbaa6",
                                "text": "Zijn bazige vrouw eiste dat hij meteen boodschappen ging doen."
                            },
                            {
                                "example_id": "4095a5bd-7331-48fd-94eb-ead6eb006dcc",
                                "sense_id": "875118bf-61f4-3cd2-b457-4aa82a5cbaa6",
                                "text": "Als mensen naar buiten gaan om te roken, rook ik binnen. Al die bazige lui die weten dat ik dat niet moet doen, die mean spirits, die mensen aan een touwtje willen hebben, fuck off."
                            },
                            {
                                "example_id": "d86904ee-f879-4991-b664-e260244d8486",
                                "sense_id": "875118bf-61f4-3cd2-b457-4aa82a5cbaa6",
                                "text": "Je bent vreselijk bazig, Olive. Je walst over de gevoelens van andere mensen heen."
                            }
                        ]
                    }
