                "senses": [
                    {
                        "sense_id": "e9bbf626-3737-343c-b65c-c64f7e0eea24",
                        "entry_id": "e18c8713-d535-36c4-ae9b-454925354ad9",
                        "glosses": [
                            "A sudden stoppage of work."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c011b797-a9b0-460f-8ba2-53b77535fd07",
                                "sense_id": "e9bbf626-3737-343c-b65c-c64f7e0eea24",
                                "text": "Thursday’s walkout occurred three weeks after several dozen employees at warehouses that serve Walmart walked off the job in California and Illinois to protest what they said were onerous conditions, including toiling in warehouses that they said sometimes heat up to 120 degrees."
                            },
                            {
                                "example_id": "60e5dfcf-1338-43c5-b79f-d2c9e6e1cb58",
                                "sense_id": "e9bbf626-3737-343c-b65c-c64f7e0eea24",
                                "text": "Despite DoRA [Defence of the Realm Act] being waved about once again, walk-outs did take place on parts of the Great Western Railway in September 1918 - this time predominantly among NUR members."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffe696e5-6d1a-35fe-b7cf-f19a438e65fc",
                        "entry_id": "e18c8713-d535-36c4-ae9b-454925354ad9",
                        "glosses": [
                            "A similar mass action of people leaving a place as a form of protest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfcc46f1-7134-4b7b-888f-4d59171952de",
                                "sense_id": "ffe696e5-6d1a-35fe-b7cf-f19a438e65fc",
                                "text": "Many people agreed this play did not belong in the festival: this tied with House on Mayhem Street for most walkouts, and was the subject of much angry discussion afterwards."
                            },
                            {
                                "example_id": "f292d56c-b772-4a58-943d-e43cd3fc0099",
                                "sense_id": "ffe696e5-6d1a-35fe-b7cf-f19a438e65fc",
                                "text": "The protest group — conducting a virtual “walkout” of sorts since most Facebook employees are working from home because of the coronavirus pandemic — was one of a number of clusters of employees pressing Facebook executives to take a tougher stand on Mr. Trump’s posts."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd2e52d8-3ecb-37d0-9a14-541e82be14a8",
                        "entry_id": "e18c8713-d535-36c4-ae9b-454925354ad9",
                        "glosses": [
                            "A part of the squat exercise wherein one has to step out from the rack (“walk out” the weight) in order not to hit it during execution."
                        ],
                        "tags": [],
                        "examples": []
                    }
