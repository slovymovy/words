                        "glosses": [
                            "Chapeau traditionnel des Peuls."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6694ce31-d1fa-4b72-9188-46639714c3d5",
                                "sense_id": "53f4dc58-2563-3981-b408-fc87d27477ff",
                                "text": "« Tengade » en peulh, « Gaban » en bambara, le chapeau peulh ne passe pas inaperçu. Généralement de forme ovale, il est fabriqué par des artisans locaux à base de paille et de peau d’animaux domestiques."
                            },
                            {
                                "example_id": "135a4767-5f67-431d-bf15-5ec3df375389",
                                "sense_id": "53f4dc58-2563-3981-b408-fc87d27477ff",
                                "text": "Le Tengade est un chapeau culturellement attribué aux Peuls de l’Afrique de l’Ouest. Du Mali, au Sénégal en passant par la Guinée, il fait partie des parures traditionnelles des populations nomades."
                            }
                        ]
                    }
