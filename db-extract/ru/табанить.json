                    {
                        "translation_id": "e9fd94e6-c771-41b2-ae3f-0db4110e4590",
                        "source_entry_id": "c246baa9-299b-3f60-8bad-0a2dfb8abf20",
                        "source_sense_id": "778e310c-059f-34df-8651-b3276855dd19",
                        "target_lang_word": "scier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aac5f7d1-b3cb-3d2c-b55e-2590f8634f01",
                                        "entry_id": "24f4fc83-8c63-30ef-9022-880a569db2d6",
                                        "glosses": [
                                            "Couper, fendre avec une scie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5395126-ed3d-4525-94cb-6dcbe42f0a20",
                                                "sense_id": "aac5f7d1-b3cb-3d2c-b55e-2590f8634f01",
                                                "text": "Sa spécialité consistait à scier les dés et à les piper. Il m’expliqua l’opération, car achetant lui-même l’ivoire, il le débitait en petits cubes […]."
                                            },
                                            {
                                                "example_id": "75e94357-96b5-4fb0-a7cd-2c3c1bdd8731",
                                                "sense_id": "aac5f7d1-b3cb-3d2c-b55e-2590f8634f01",
                                                "text": "Scier du bois, de la pierre, du marbre, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cbe6d4a-953d-3676-b649-28a1b12b7128",
                                        "entry_id": "24f4fc83-8c63-30ef-9022-880a569db2d6",
                                        "glosses": [
                                            "Couper avec la faucille en parlant des blés."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88e04fea-cf45-43d9-b9e8-accab3508542",
                                                "sense_id": "3cbe6d4a-953d-3676-b649-28a1b12b7128",
                                                "text": "C’est le temps de scier les blés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84f9e442-0970-3c8e-a24d-2cfb0308f65e",
                                        "entry_id": "24f4fc83-8c63-30ef-9022-880a569db2d6",
                                        "glosses": [
                                            "Excéder d’ennui."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a984386-d8c7-442e-9da5-ca373aaa5466",
                                                "sense_id": "84f9e442-0970-3c8e-a24d-2cfb0308f65e",
                                                "text": "Enfin, j’ai travaillé dans les carrières de Montrouge. Mais au bout de deux ans ça m’a scié de faire toujours l’écureuil dans les grandes roues pour tirer la pierre, moyennant vingt sous par jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "337dfe41-dd9b-3f64-b5a0-b45b0cf80109",
                                        "entry_id": "24f4fc83-8c63-30ef-9022-880a569db2d6",
                                        "glosses": [
                                            "Stupéfier, époustoufler, sidérer."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e7486f-73b4-49f7-9e80-10e30e907b3c",
                                                "sense_id": "337dfe41-dd9b-3f64-b5a0-b45b0cf80109",
                                                "text": "- Vous me sciez. J’ai jamais rencontré une nana comme vous…"
                                            },
                                            {
                                                "example_id": "2dad5149-33bc-492e-a1e2-55cdee99db56",
                                                "sense_id": "337dfe41-dd9b-3f64-b5a0-b45b0cf80109",
                                                "text": "Tes mots exacts : Je ne crois pas aux serial killers… Ça, ça m’a scié ! Ça, ça m’a donné envie de me dépasser, de prouver que j’existe, merde !"
                                            },
                                            {
                                                "example_id": "68a16b84-164a-40b7-8e6e-e0ce65cda073",
                                                "sense_id": "337dfe41-dd9b-3f64-b5a0-b45b0cf80109",
                                                "text": "Il m'a dit qu'il avait appris le chinois en trois mois, j'étais scié."
                                            },
                                            {
                                                "example_id": "8d18f3ef-581d-4ed7-8e4d-659238a038f5",
                                                "sense_id": "337dfe41-dd9b-3f64-b5a0-b45b0cf80109",
                                                "text": "Franchement, je suis scié par ton talent en dessin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5c6642-939a-3d55-8cfa-b75f103a771d",
                                        "entry_id": "24f4fc83-8c63-30ef-9022-880a569db2d6",
                                        "glosses": [
                                            "Ramer à rebours pour rétrograder, revenir sur son sillage."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d48ec850-05af-3bc0-b49d-4981df8cb609",
                                        "entry_id": "24f4fc83-8c63-30ef-9022-880a569db2d6",
                                        "glosses": [
                                            "Refréner quelqu’un, saboter ce qu'il fait."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f42fa8a-1010-4d2c-aad0-d38464947d78",
                                                "sense_id": "d48ec850-05af-3bc0-b49d-4981df8cb609",
                                                "text": "Bechet et Zutty semblent être en froid et j’ai bien l’impression que lorsque l’un des deux se sent inspiré, l’autre s’empresse de le « scier » au lieu de le suivre de le stimuler."
                                            }
                                        ]
