                                    {
                                        "sense_id": "530195c0-b7cc-343f-aed4-f4bcfaddec0f",
                                        "entry_id": "c1e44101-a4d7-3f13-bff9-3a8036f4c2a8",
                                        "glosses": [
                                            "Any time in the middle of February."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bb150d8-cccc-4d05-aedf-de95bb6c31fe",
                                                "sense_id": "530195c0-b7cc-343f-aed4-f4bcfaddec0f",
                                                "text": "Temperatures in Bangkok fell as low as 59.3 degrees Fahrenheit (15.2 degrees Celsius) on Monday, the lowest the capital has seen in years, as the country’s weather agency warned cool conditions could persist through mid-February."
                                            },
                                            {
                                                "example_id": "dea8c608-eb26-4fda-a35e-7fe684a06d47",
                                                "sense_id": "530195c0-b7cc-343f-aed4-f4bcfaddec0f",
                                                "text": "Saturday’s tariffs are unlikely to be Trump’s last. The president said himself said in the Oval Office that additional tariffs could come by mid-February on chips, pharmaceuticals, steel, aluminum, copper, oil and gas imports – along with tariffs on the European Union – all threats that few would discount given his willingness to follow through on the North American and China tariffs on Saturday."
                                            }
                                        ]
                                    }
