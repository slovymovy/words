                ],
                "senses": [
                    {
                        "sense_id": "ece022d3-cee7-3ca0-bed6-f8802dd64e10",
                        "entry_id": "06799f64-8177-386b-8778-0fb233e018db",
                        "glosses": [
                            "invoering van een elektriciteitsnet in een bepaald gebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a6b2817-72cc-44dc-8794-7a83d0590d54",
                                "sense_id": "ece022d3-cee7-3ca0-bed6-f8802dd64e10",
                                "text": "Het klonk een klein beetje als zo’n oude communistische strijdkreet uit het begin van de bolsjewistische regering, die op spandoeken was te lezen: ‘Communisme - dat is Sovjetmacht + elektrificatie van het hele land’."
                            }
                        ]
                    },
                    {
                        "sense_id": "a73e3fcd-b81a-3977-b3bf-aa5fae371cc6",
                        "entry_id": "06799f64-8177-386b-8778-0fb233e018db",
                        "glosses": [
                            "gebruik van spanning voor een bepaalde toepassing ter vervanging van een andere vorm van energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2b26638-d5c2-42be-b1be-e85df524a17d",
                                "sense_id": "a73e3fcd-b81a-3977-b3bf-aa5fae371cc6",
                                "text": "Nooit had deze elektrificatie van de grond kunnen komen zonder sturing van de Noorse overheid, die hoge klimaatambities heeft."
                            },
                            {
                                "example_id": "cd6e98a3-8242-4dae-839a-d06ce94466e6",
                                "sense_id": "a73e3fcd-b81a-3977-b3bf-aa5fae371cc6",
                                "text": "De investeringsopgave in elektrische autotechnologie lijkt niet voor iedereen haalbaar. Bij concerns die vrijwel niet geïnvesteerd hebben in elektrificatie – zoals Jaguar Land Rover, onderdeel van het Indiase Tata – rijst de vraag welke toekomst ze op termijn hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b00bc019-2e6a-482c-8cc1-0ac4a46fe9cd",
                        "source_entry_id": "06799f64-8177-386b-8778-0fb233e018db",
                        "source_sense_id": "ece022d3-cee7-3ca0-bed6-f8802dd64e10",
                        "source_sense_description": "invoering van een elektriciteitsnet",
                        "target_lang_word": "electrification",
