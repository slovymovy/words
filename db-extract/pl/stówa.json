                    },
                    {
                        "translation_id": "99b013c4-308d-4d6c-be76-0596444dfe74",
                        "source_entry_id": "eccac87b-667b-3b16-aa4d-953e983b987e",
                        "source_sense_id": "cd08beb2-949f-3abd-ac15-8f9cf74b2620",
                        "target_lang_word": "сотня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сотня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2155add0-9a7b-3817-92fa-06592f20a091",
                                        "entry_id": "6b342878-f790-31de-8e30-04556f93dc54",
                                        "glosses": [
                                            "группа из ста объектов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c5b74c-8940-4c96-9208-461c436cd3cd",
                                                "sense_id": "2155add0-9a7b-3817-92fa-06592f20a091",
                                                "text": "Для него потребна по крайней мере новая сотня документов."
                                            },
                                            {
                                                "example_id": "ad079007-6097-4048-b2a0-7769981fb78f",
                                                "sense_id": "2155add0-9a7b-3817-92fa-06592f20a091",
                                                "text": "С гиком вылетела сотня русских лодок, напала на тумбасы, девятью из них овладела, а остальные удрали в Азов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "127df69a-87c2-3aa5-8201-de7833271f14",
                                        "entry_id": "6b342878-f790-31de-8e30-04556f93dc54",
                                        "glosses": [
                                            "истор., воен. войсковое подразделение казачьих войск, соответствующее эскадрону"
                                        ],
                                        "tags": [
                                            "в Российском государстве до 1917 г."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8596242-0229-4bb3-88f9-116470181c85",
                                                "sense_id": "127df69a-87c2-3aa5-8201-de7833271f14",
                                                "text": "Сотня, где был Пугачев, получила задание конвоировать наших раненых офицеров в город Кёнигсберг."
                                            },
                                            {
                                                "example_id": "ba1dd21d-129e-49c4-b16e-2176f8b27bb3",
                                                "sense_id": "127df69a-87c2-3aa5-8201-de7833271f14",
                                                "text": "Одна сотня, оставленная с хорунжиим Александровым для наблюдения за неприятелем, продолжала перестреливаться я отступать на Ермаки к Знаменскому, дабы заманить неприятеля в другую сторону той, куда партия предприняла своё направление."
                                            },
                                            {
                                                "example_id": "03120302-a882-4f18-8566-fc0769ab8a9e",
                                                "sense_id": "127df69a-87c2-3aa5-8201-de7833271f14",
                                                "text": "Свободными оказались в Темир-Хан-Шуре не более трёх батальонов, всего 1.500 штыков, пять горных орудий, сотня линейцев и туземное конное ополчение, с которыми 1-го ноября мы и двинулись к Гергебилю по дороге через Оглы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df9a6250-c61d-3cff-9dfc-4a51713b7fa3",
                                        "entry_id": "6b342878-f790-31de-8e30-04556f93dc54",
                                        "glosses": [
                                            "разг. монета или купюра достоинством в 100 российских рублей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4436f723-cf17-49a6-acc4-311d59bb1f99",
                                                "sense_id": "df9a6250-c61d-3cff-9dfc-4a51713b7fa3",
                                                "text": "У нас в кармане сотня, а манеру мы держим на тысячи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
