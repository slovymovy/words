                "senses": [
                    {
                        "sense_id": "150e4e50-8df0-358b-83e2-a7f236881f75",
                        "entry_id": "337ddde3-c105-3901-820f-4d5d62a3b124",
                        "glosses": [
                            "ursprünglich vereinsrechtliche, aber staatlich privilegierte Organisation zur Kandidatur für Volksvertretungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8339b70c-ebd8-485b-a4ad-a5533abcf88e",
                                "sense_id": "150e4e50-8df0-358b-83e2-a7f236881f75",
                                "text": "„Der neugegründete Wahlverein verstößt aber außerdem noch gegen Art. 17 des Vereinsgesetzes.“"
                            },
                            {
                                "example_id": "856d3885-1b20-43ef-afe9-3ef0ad6bca80",
                                "sense_id": "150e4e50-8df0-358b-83e2-a7f236881f75",
                                "text": "„Richter gründete 1896 den Sozialdemokratischen Wahlverein Rudolfsheim, war Obmann der Sozialdemokratischen Arbeiterpartei Rudolfsheim und Mitglied der Landesparteivertretung der Sozialdemokratischen Arbeiterpartei Niederösterreich sowie des Parteivorstandes der Sozialdemokratischen Arbeiterpartei.“"
                            },
                            {
                                "example_id": "a6da15b4-98a3-4031-928a-6024dcc5d09d",
                                "sense_id": "150e4e50-8df0-358b-83e2-a7f236881f75",
                                "text": "„Der ad hoc gegründete Wahlverein der Opposition, Plan Progreso para Bolivia (PPB), landete fast 38 Prozentpunkte dahinter abgeschlagen auf Platz 2 und zeigte sogleich wieder Auflösungserscheinungen.“"
                            },
                            {
                                "example_id": "12b6f23b-e182-4292-ace7-51c371c1f8bf",
                                "sense_id": "150e4e50-8df0-358b-83e2-a7f236881f75",
                                "text": "„Vier Tage später entstanden Wahlvereine in Obajillo in der nordöstlich von Lima gelegenen Provinz Canta und in Jauja, einer Stadt im andinen Hochland.“"
                            },
                            {
                                "example_id": "f121e864-ae12-41f0-9ad1-21b947f0e253",
                                "sense_id": "150e4e50-8df0-358b-83e2-a7f236881f75",
                                "text": "„Van der Bellens Wahlverein wird seine Einnahmen am Sonntag ins Internet stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c7d4e926-b680-3830-9f66-a620d1857d5c",
                        "entry_id": "337ddde3-c105-3901-820f-4d5d62a3b124",
                        "glosses": [
                            "Partei, die sich weniger auf ein Programm als auf ihren Spitzenkandidaten stützt"
                        ],
                        "tags": [
                            "heute meist übertragen verwendet"
                        ],
                        "examples": [
                            {
                                "example_id": "2f2d55cc-d34e-490c-a1de-5dcef5ed2700",
                                "sense_id": "c7d4e926-b680-3830-9f66-a620d1857d5c",
                                "text": "„Die Ursache für seinen Bruch mit Helmut Kohl, kritisches Vordenken, wird wohl mitgeteilt; aber daß dieser Grund prototypisch für das Verhältnis des Parteivorsitzenden Kohl zur Kritik vieler seiner Weggefährten ist und die CDU zum Wahlverein für den Kanzler Kohl zurückentwickeln wird, das muß man sich selber durch das empfohlene Nachhaken vermitteln.“"
                            },
                            {
                                "example_id": "72ecd633-f9a0-40f4-a32f-c72933f07c87",
                                "sense_id": "c7d4e926-b680-3830-9f66-a620d1857d5c",
                                "text": "„Merkel, Merkel, Merkel – 78 Tage vor der Bundestagswahl verdichtet die NRW-CDU ihr Programm auf die Rolle als Wahlverein der Kanzlerin.“"
                            },
                            {
                                "example_id": "c13c7de5-72aa-4ee1-bbea-5d83d479925e",
                                "sense_id": "c7d4e926-b680-3830-9f66-a620d1857d5c",
                                "text": "„Es war die scheidende Bundesrätin selber, die in ihrem Rücktritt auch gleich eine Art Kur für die Partei sieht: «Das gibt der BDP die Chance, nicht nur als Wahlverein oder Fanklub von mir wahrgenommen zu werden», sagte sie.“"
                            },
                            {
                                "example_id": "6ee35611-2923-4f36-aaf2-4366cd27c4c5",
                                "sense_id": "c7d4e926-b680-3830-9f66-a620d1857d5c",
                                "text": "„Zu oft seien sie ein Wahlverein für eine Person.“"
                            },
                            {
                                "example_id": "3e8b71ed-a72b-4596-a360-a7fc48313894",
                                "sense_id": "c7d4e926-b680-3830-9f66-a620d1857d5c",
                                "text": "„Der konservative Wahlverein CDU zerlegt sich, wie man das bisher nur von der SPD kannte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
