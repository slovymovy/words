                        ],
                        "examples": [
                            {
                                "example_id": "e571f595-f490-4d75-93d2-3c12f9cd664f",
                                "sense_id": "72a12515-1ca1-36f8-8ea5-214fc0b290a4",
                                "text": "W sprawach zagranicznych Mao jest większym lewakiem niż Czou, w sprawach wewnętrznych jest wprost przeciwnie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
