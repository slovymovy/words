                    "frequency": "High",
                    "semantic_group_id": "registratie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Piet wilde zich graag voor de nieuwe cursus <w>aanmelden</w>.",
                            "target_lang_translations": {
                                "en": "Piet really wanted to <w>register</w> for the new course."
                            }
                        },
                        {
                            "text": "Je kunt je online <w>aanmelden</w> voor de nieuwsbrief van de school.",
                            "target_lang_translations": {
