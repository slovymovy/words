                                "sense_id": "969ed0c6-1759-3dd0-b155-f8150d7a590e",
                                "text": "„Der deutsche Bahnradvierer hat in Mexiko den 13 Jahre alten deutschen Rekord in der Mannschaftsverfolgung über 4000 Meter verbessert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
