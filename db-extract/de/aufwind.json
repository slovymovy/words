                                    {
                                        "sense_id": "c1b1b05c-aabd-399a-abde-b7e7a420c591",
                                        "entry_id": "d2ed3d18-19ab-3762-a42e-f5797a5b0b43",
                                        "glosses": [
                                            "To wind upwards."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc5f2c53-ee18-4c31-a090-741ae41f7896",
                                                "sense_id": "c1b1b05c-aabd-399a-abde-b7e7a420c591",
                                                "text": "The cries of all on board were drowned in wind,\nAnd wind in thunder drowned;\nWith useless sails upwound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24611b3f-fddf-356e-9a6f-85b67d1980e0",
                                        "entry_id": "d2ed3d18-19ab-3762-a42e-f5797a5b0b43",
                                        "glosses": [
                                            "To wind up (a mechanism)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "794db5fe-8910-4e6b-986b-477e9a279485",
                                                "sense_id": "24611b3f-fddf-356e-9a6f-85b67d1980e0",
                                                "text": "Tell me not of a huge machine, / Going like a clock upwound; / All measured out each space between, / Marked out each weary round."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba88e4b8-e12e-4bee-a7ae-3a8f464bce9e",
                        "source_entry_id": "c86cdcc5-f2de-3bb0-9217-725e334f30d9",
