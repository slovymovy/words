                "senses": [
                    {
                        "sense_id": "2a9c5163-cfd8-3f3a-afbf-58f3d5b78829",
                        "entry_id": "417812eb-0bb3-3738-81de-01f636040e3a",
                        "glosses": [
                            "Pouvoir être avalé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "368a5ece-03f5-48ee-8968-8d95a601f3d7",
                                "sense_id": "2a9c5163-cfd8-3f3a-afbf-58f3d5b78829",
                                "text": "Ça s’avale, hein ? — Quand on a faim…"
                            },
                            {
                                "example_id": "4492fcf0-2bc9-45a6-ab2e-e8f6d14b4f64",
                                "sense_id": "2a9c5163-cfd8-3f3a-afbf-58f3d5b78829",
                                "text": "Et le pain, même s’il date de plusieurs jours, et que la lame du couteau plie devant lui, une fois cassé et trempé dans le bol, il s’avale facilement."
                            }
                        ]
                    },
                    {
                        "sense_id": "4630ecf2-bbad-3cc7-b302-45efe86c6c6b",
                        "entry_id": "417812eb-0bb3-3738-81de-01f636040e3a",
                        "glosses": [
                            "Avaler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdad7078-dc5d-4fa7-b010-1f6157a5befd",
                                "sense_id": "4630ecf2-bbad-3cc7-b302-45efe86c6c6b",
                                "text": "Il est sur le lit de son mobile home, il ouvre son minifrigo, s’avale une gorgée de lait et essuie une esquisse de moustache d’un revers de main."
                            }
                        ]
                    }
