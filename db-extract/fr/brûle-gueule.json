                "entry_id": "c3d0f2e5-f069-3dc1-9182-1c4cbc338826",
                "word": "brûle-gueule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b0c59195-aae0-4fa2-926c-2f28d239483b",
                        "entry_id": "c3d0f2e5-f069-3dc1-9182-1c4cbc338826",
                        "tags": [
                            "plural"
                        ],
                        "form": "brûle-gueules"
                    },
                    {
                        "form_id": "e35bfd17-9fd8-4ee8-af31-bd016b0910ea",
                        "entry_id": "c3d0f2e5-f069-3dc1-9182-1c4cbc338826",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "brule-gueule"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2717797-3035-3cd6-b766-a3da733cb0a1",
                        "entry_id": "c3d0f2e5-f069-3dc1-9182-1c4cbc338826",
                        "glosses": [
                            "Pipe à tuyau très court."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab26228-2690-4891-b647-9e5f874f0e92",
                                "sense_id": "c2717797-3035-3cd6-b766-a3da733cb0a1",
                                "text": "Ce voyageur ailé, comme il est gauche et veule !\nLui, naguère si beau, qu’il est comique et laid !\nL’un agace son bec avec un brûle-gueule,\nL’autre mime, en boitant, l’infirme qui volait !"
                            },
                            {
                                "example_id": "7f02a5cc-eafd-48ae-a29a-146c96d3d077",
                                "sense_id": "c2717797-3035-3cd6-b766-a3da733cb0a1",
                                "text": "Accoudé sur le dossier de sa chaise, il lisait un in-folio à tranches rouges, et fumait à grand bruit une petite pipe courte et brune, de celles qu’on appelle « brûle-gueule »."
                            },
                            {
                                "example_id": "a87682a6-7df6-4f90-a83e-0951f24ec813",
                                "sense_id": "c2717797-3035-3cd6-b766-a3da733cb0a1",
                                "text": "Et elle alluma son brûle-gueule, au grand scandale de mistress Mac Pherson."
                            },
                            {
                                "example_id": "4c56960a-96fa-4835-bdc2-7d59b8736aec",
                                "sense_id": "c2717797-3035-3cd6-b766-a3da733cb0a1",
                                "text": "Il cogna ; un homme en bras de chemise, un brûle-gueule à la bouche, entr’ouvrit la porte, et dit d’attendre un instant."
                            }
                        ]
                    },
                    {
                        "sense_id": "924193ca-5ca2-311d-b808-f1963ade3dd4",
                        "entry_id": "c3d0f2e5-f069-3dc1-9182-1c4cbc338826",
                        "glosses": [
                            "Alcool très fort, presque imbuvable."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fa3a022b-65ab-400d-9140-744d97a3858a",
                                "sense_id": "924193ca-5ca2-311d-b808-f1963ade3dd4",
                                "text": "Vêtu d’un chandail humide et porteur d’une casquette spongieuse, déformée, d’un pantalon trop court et de godillots à clous, le gars tétait un authentique brûle-gueule de terre-neuva."
                            }
                        ]
                    }
