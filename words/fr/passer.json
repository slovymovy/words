    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "618de7dc-7e51-3f06-bb9a-cd839bf48ba5",
                    "sense_definition": "Consacrer ou employer une durée, vivre un moment déterminé.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>passons</w> généralement nos vacances d'été au bord de la mer."
                        },
                        {
                            "text": "J'ai <w>passé</w> une excellente soirée avec mes anciens camarades de classe."
                        }
                    ],
                    "common_phrases": [
                        "passer du temps",
                        "passer la nuit",
                        "passer ses vacances",
                        "passer une bonne journée"
                    ]
                },
                {
                    "sense_id": "01c24f2a-2d03-3766-aea4-c5878af4d0af",
                    "sense_definition": "Aller d'un lieu à un autre, traverser un espace ou franchir une limite.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les voitures <w>passent</w> sur le pont pour traverser la rivière."
                        },
                        {
                            "text": "Le train <w>passe</w> à toute vitesse devant la petite gare du village."
                        }
                    ],
                    "common_phrases": [
                        "passer le pont",
                        "passer la frontière",
                        "passer par là"
                    ]
                },
                {
                    "sense_id": "c4508bc2-f06b-308d-887e-dfeecb70dafb",
                    "sense_definition": "Faire une courte visite, s'arrêter brièvement quelque part.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>passerai</w> chez toi en fin d'après-midi pour récupérer mes clés."
                        },
                        {
                            "text": "Mon frère est <w>passé</w> au bureau pour me saluer avant son départ."
                        }
                    ],
                    "common_phrases": [
                        "passer voir quelqu'un",
                        "passer en coup de vent"
                    ]
                },
                {
                    "sense_id": "df9e71cf-1502-3dda-bf99-b673d3d1035a",
                    "sense_definition": "Transmettre un objet de la main à la main ou mettre en communication.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu me <w>passer</w> le sel et le poivre, s'il te plaît ?"
                        },
                        {
                            "text": "La secrétaire va vous <w>passer</w> le directeur dès qu'il sera disponible."
                        }
                    ],
                    "common_phrases": [
                        "passer le sel",
                        "passer quelqu'un au téléphone",
                        "passer un message"
                    ]
                },
                {
                    "sense_id": "bb143f8e-5cdd-3117-924d-58af233f63e3",
                    "sense_definition": "Avoir lieu, arriver, survenir.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evenement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne ne sait exactement ce qui s'est <w>passé</w> pendant cette réunion secrète."
                        },
                        {
                            "text": "Tout se <w>passe</w> comme prévu pour la fête de fin d'année."
                        }
                    ],
                    "synonyms": [
                        "se produire",
                        "arriver"
                    ],
                    "common_phrases": [
                        "se passer bien",
                        "se passer mal"
                    ]
                },
                {
                    "sense_id": "3b1cdff1-62c3-344e-ab64-66d636260bab",
                    "sense_definition": "Se soumettre à une épreuve, à un examen ou à un test.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma sœur va <w>passer</w> son permis de conduire la semaine prochaine."
                        },
                        {
                            "text": "Tous les candidats <w>passent</w> un entretien individuel devant le jury de sélection."
                        }
                    ],
                    "common_phrases": [
                        "passer un examen",
                        "passer le permis",
                        "passer un entretien",
                        "passer une épreuve"
                    ]
                },
                {
                    "sense_id": "7c0ce3e1-23ef-3967-b15a-635fe4dd3315",
                    "sense_definition": "S'écouler de manière continue, en parlant du temps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le temps <w>passe</w> très vite quand on s'amuse avec des amis."
                        },
                        {
                            "text": "Les semaines ont <w>passé</w> sans que nous recevions de ses nouvelles."
                        }
                    ],
                    "common_phrases": [
                        "le temps passe",
                        "voir passer les heures"
                    ]
                },
                {
                    "sense_id": "8ef7313a-6209-39a4-bffc-6de12bcc058c",
                    "sense_definition": "Faire sans quelque chose ou sans quelqu'un, s'en dispenser.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dispense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est incapable de se <w>passer</w> de son café au réveil."
                        },
                        {
                            "text": "Nous devrons nous <w>passer</w> de voiture pour ce séjour en ville."
                        }
                    ],
                    "common_phrases": [
                        "se passer de tout",
                        "pouvoir se passer de"
                    ]
                },
                {
                    "sense_id": "e403d14c-52a5-32bc-b8f6-47ca6d974ea8",
                    "sense_definition": "Enfiler ou mettre un vêtement ou un accessoire sur soi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "habillement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait froid dehors, alors il <w>passe</w> un pull chaud avant de sortir."
                        },
                        {
                            "text": "Elle a vite <w>passé</w> son manteau pour ne pas rater son bus."
                        }
                    ],
                    "common_phrases": [
                        "passer un manteau",
                        "passer une robe",
                        "passer ses chaussures"
                    ]
                },
                {
                    "sense_id": "3280b919-8a06-36aa-9ad7-625b911723d9",
                    "sense_definition": "Être projeté, diffusé ou diffusé publiquement sur un écran ou sur les ondes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux film culte <w>passe</w> à la télévision tard ce soir."
                        },
                        {
                            "text": "Une nouvelle chanson entraînante <w>passe</w> souvent à la radio depuis quelques jours."
                        }
                    ],
                    "common_phrases": [
                        "passer au cinéma",
                        "passer à la radio",
                        "passer à la télé"
                    ]
                },
                {
                    "sense_id": "0a2bfaf5-2b4b-3152-9e2a-f6caf442b122",
                    "sense_definition": "Prendre fin, s'apaiser, disparaître en parlant d'une douleur ou d'une émotion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prends un cachet et ton mal de tête va bientôt <w>passer</w>."
                        },
                        {
                            "text": "Ne t'inquiète pas pour sa colère, cela lui <w>passera</w> vite."
                        }
                    ],
                    "common_phrases": [
                        "faire passer la douleur",
                        "laisser passer la colère"
                    ]
                }
            ]
        }
    ]
