                                    {
                                        "sense_id": "8f8617dd-4d44-3ddd-b78f-c9fb3a8aab18",
                                        "entry_id": "7aabd1be-6370-3b66-a40f-ea8a5e8d830e",
                                        "glosses": [
                                            "Synonym of helicoid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4265013b-4937-4690-bb67-663dcfabd79f",
                                                "sense_id": "8f8617dd-4d44-3ddd-b78f-c9fb3a8aab18",
                                                "text": "The salient characteristics of Isabelline architecture include the use of extravagant formal elements such as helicoidal columns and mixtilinear arches with complete disregard of their tectonic or constructive function in the building, and profuse display of high-relief ornamentation in stone, especially heraldic symbols."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a91a7e4-818c-44dd-a35d-df6623271157",
                        "source_entry_id": "6924ecb9-29cb-3aba-822c-8eddba3497ad",
                        "source_sense_id": "357517a5-3a8c-3c43-bc51-c528faffa54a",
                        "target_lang_word": "spiral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spiral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85e00c9b-e8e3-316b-a9d4-ccfcd1a61cbe",
                                        "entry_id": "5de4aff9-96c7-34e0-8ed9-e9cfc0ac4dc9",
                                        "glosses": [
                                            "A curve that is the locus of a point that rotates about a fixed point while continuously increasing its distance from that point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a41c5d32-97fe-3470-94e1-f4ed0844b2f4",
                                        "entry_id": "5de4aff9-96c7-34e0-8ed9-e9cfc0ac4dc9",
                                        "glosses": [
                                            "A helix."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d25c56d-09f8-3989-8b0d-3d442ba0eabc",
                                        "entry_id": "5de4aff9-96c7-34e0-8ed9-e9cfc0ac4dc9",
                                        "glosses": [
                                            "A self-sustaining process with a lot of momentum involved, so it is difficult to accelerate or stop it at once."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd0d7a2-f07e-4ed8-8565-cf36cfd1aa02",
                                                "sense_id": "2d25c56d-09f8-3989-8b0d-3d442ba0eabc",
                                                "text": "My beloved friends and family who sustained and grounded me as I fell into the rabbit hole of this project or down the spiral of new parenthood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f28ae8-e321-3cf0-84a8-f954e50ee269",
                                        "entry_id": "5de4aff9-96c7-34e0-8ed9-e9cfc0ac4dc9",
                                        "glosses": [
                                            "A section of track that forms a circle and crosses over itself, used for gaining height in mountainous territory."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spiral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "685a4c3b-c804-3393-a9c4-ce00e762d2f3",
                                        "entry_id": "76d2438d-1895-3a04-94c1-dced68083951",
                                        "glosses": [
                                            "Helical, like a spiral."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "532ef3c7-6b0c-4dcb-9248-5d824bbe2e04",
                                                "sense_id": "685a4c3b-c804-3393-a9c4-ce00e762d2f3",
                                                "text": "The formation of tornados and water-spouts is very probably identical with that of dust-storms and \"devils,\" viz., a sudden disturbance of the vertical equilibrium of the atmosphere, where by an upward rush of air is generated, which rapidly becomes spiral."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spiral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d29d377-39d3-35cf-83a4-afa2f2e541d2",
                                        "entry_id": "5d54bc48-1338-3f89-8f07-53a78e55e2ff",
                                        "glosses": [
                                            "To move along the path of a spiral or helix."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7837f11-0fca-4b6c-900a-a6290288ec49",
                                                "sense_id": "2d29d377-39d3-35cf-83a4-afa2f2e541d2",
                                                "text": "The falling leaves spiralled down from the tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eefa05ff-ec7e-372f-8bfd-d089b8ccf8db",
                                        "entry_id": "5d54bc48-1338-3f89-8f07-53a78e55e2ff",
                                        "glosses": [
                                            "To cause something to spiral."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8378777e-bf63-49ee-97c1-ac5927cc47f0",
                                                "sense_id": "eefa05ff-ec7e-372f-8bfd-d089b8ccf8db",
                                                "text": "You need to learn how to spiral a ball."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c39db768-7f97-3bbb-8466-55e15eb25deb",
                                        "entry_id": "5d54bc48-1338-3f89-8f07-53a78e55e2ff",
                                        "glosses": [
                                            "To increase continually."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15344684-e2ef-4a14-8d26-15e5672fbdf3",
                                                "sense_id": "c39db768-7f97-3bbb-8466-55e15eb25deb",
                                                "text": "Her debts were spiralling out of control."
                                            }
