                        "entry_id": "ec2d0d79-d75c-348d-b7fc-accd1a856e8a",
                        "glosses": [
                            "Gardien de troupeau de vaches, ce mot étant associé au western (dans l’ouest des États-Unis d’Amérique au XIXᵉ siècle)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "550328ae-d9ab-4070-9b5c-4944e1ecc564",
                                "sense_id": "f27e8dc9-f818-3f47-8c28-d89977e82e9b",
                                "text": "Les cow-boys avaient pour mission de conduire les bêtes à travers le sud des Grandes Plaines."
                            }
                        ]
                    },
                    {
                        "sense_id": "8384d7e1-6507-3e9d-9591-48a3ef878c99",
                        "entry_id": "ec2d0d79-d75c-348d-b7fc-accd1a856e8a",
                        "glosses": [
                            "Homme courageux, cavalier émérite et tireur d’élite prêt à dégainer face aux Indiens pour défendre la veuve et l’orphelin."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4cdfdb8c-881d-3539-81ae-ccfb717a454a",
                        "entry_id": "ec2d0d79-d75c-348d-b7fc-accd1a856e8a",
                        "glosses": [
                            "Cocktail Orangina menthe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8169084e-f6b9-33bf-ab46-8b5349b07616",
                        "entry_id": "ec2d0d79-d75c-348d-b7fc-accd1a856e8a",
                        "glosses": [
                            "Coupe particulière de pantalon, rétrécie vers le bas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32a8d356-18ab-41e7-9aa1-50f03dbc03a6",
                                "sense_id": "8169084e-f6b9-33bf-ab46-8b5349b07616",
                                "text": "La forme de mon jean dite cow-boy (large en haut et serré en bas) n’était pas encore parvenue dans ces contrées, on s’étonna d’un tel accoutrement et on rit derrière mon dos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e8cd296-8d0d-42a4-a52b-32c6e130c1aa",
                        "source_entry_id": "ec2d0d79-d75c-348d-b7fc-accd1a856e8a",
                        "source_sense_description": "Gardien de troupeau de vaches, ce mot étant associé au western",
