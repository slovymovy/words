                                "target_senses": [
                                    {
                                        "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                        "entry_id": "0e2daf3a-9429-39fc-a1a2-babcdb5f82c1",
                                        "glosses": [
                                            "極其，很"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75f3caf2-5d79-49cb-a1a3-9d37c227f05b",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "非常感謝"
                                            },
                                            {
                                                "example_id": "eca99019-7d67-41f6-b1c5-77118343733c",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "非常感谢"
                                            },
                                            {
                                                "example_id": "78ec7af0-cd27-4d0c-b783-4a75078f60ec",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "非常努力地工作"
                                            },
                                            {
                                                "example_id": "03925368-38f1-4428-9c15-2a7f2d00c6ac",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他在信中的用詞非常犀利。"
                                            },
                                            {
                                                "example_id": "70b7dc2b-da81-44c4-9b70-d9736a4dae56",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他在信中的用词非常犀利。"
                                            },
                                            {
                                                "example_id": "e30fdba4-2a94-44bc-93eb-9bc8fc840c8a",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他是有文化的人，說的話非常好聽。"
                                            },
                                            {
                                                "example_id": "05322b19-b8fe-456e-98bf-7191f59ce398",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他是有文化的人，说的话非常好听。"
                                            },
                                            {
                                                "example_id": "18bdd89b-7fdc-4ab3-9e29-6bd0770f192f",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他是一位胸懷十分豁達，並且意念非常堅強的領袖。"
                                            },
                                            {
                                                "example_id": "d6bd4c06-cd0b-436c-a82e-3fb8983c5502",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他是一位胸怀十分豁达，并且意念非常坚强的领袖。"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "非常",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "c29a4ff4-ad87-39a8-baee-2dc7a0e06867",
                                        "entry_id": "3447a545-deaa-3202-a513-5582033c6b4c",
                                        "glosses": [
                                            "特別，非凡，異乎尋常"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4957893-99ef-46ef-b9bd-c704e4da9cf0",
                                                "sense_id": "c29a4ff4-ad87-39a8-baee-2dc7a0e06867",
                                                "text": "古者富貴而名磨滅，不可勝{shēng記，唯倜儻非常之人稱焉。",
                                                "translation": "古代富貴之人不計其數，但他們的名字卻已默默無聞。只有那些精明強幹的人，那些真正非凡的人，才有可能被人們銘記。"
                                            },
                                            {
                                                "example_id": "243f81fc-13d3-41eb-9d82-ba49b2c51bb8",
                                                "sense_id": "c29a4ff4-ad87-39a8-baee-2dc7a0e06867",
                                                "text": "古者富贵而名磨灭，不可胜{shēng记，唯倜傥非常之人称焉。",
                                                "translation": "古代富貴之人不計其數，但他們的名字卻已默默無聞。只有那些精明強幹的人，那些真正非凡的人，才有可能被人們銘記。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b755156-e78a-32f1-afd5-480dce84701b",
                                        "entry_id": "3447a545-deaa-3202-a513-5582033c6b4c",
                                        "glosses": [
                                            "突如其來的禍患"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0de7250-3627-42eb-9e41-d5b49d23f27b",
                        "source_entry_id": "1311c47f-f88b-31c6-a6eb-ad61fa0279fb",
                        "source_sense_id": "9852f0b3-e79e-3739-872e-980af4b7c36d",
                        "target_lang_word": "particulièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "particulièrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45f20cfb-5e2a-3e06-881b-7198e5d5c469",
                                        "entry_id": "03661ef8-80a4-3064-8706-d5c3725df2c2",
                                        "glosses": [
                                            "D’une manière singulière ou remarquable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d28ab93-435f-450a-b6a9-f01a57e2814b",
                                                "sense_id": "45f20cfb-5e2a-3e06-881b-7198e5d5c469",
                                                "text": "Toilette du bataillon. Le barbier passe pour particulièrement francophile. Tout le monde va se raser chez lui."
                                            },
                                            {
                                                "example_id": "cbbe18b6-78c3-4f08-b3c8-213ff5d80468",
                                                "sense_id": "45f20cfb-5e2a-3e06-881b-7198e5d5c469",
                                                "text": "L’endémisme est particulièrement développé dans trois sortes de flores : les flores isolées, les flores montagnardes, les flores insulaires."
                                            },
                                            {
                                                "example_id": "478d8518-6a25-4d7b-af9a-932ee1894811",
                                                "sense_id": "45f20cfb-5e2a-3e06-881b-7198e5d5c469",
                                                "text": "La période qui s'étend entre le débarquement japonais à l’embouchure du Wang-poo et le bombardement de Nagasaki fut pour la Chine particulièrement fertile en catastrophes."
                                            },
                                            {
                                                "example_id": "836bfa9c-2f74-4d27-aa72-b242316d8acc",
                                                "sense_id": "45f20cfb-5e2a-3e06-881b-7198e5d5c469",
                                                "text": "Chez les possédants, l'agitation sociale réveille une vieille hantise particulièrement vivace chez les bourgeois français : la peur de l'ouvrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73fe5f68-f64e-393d-ac61-e86c5c20a417",
                                        "entry_id": "03661ef8-80a4-3064-8706-d5c3725df2c2",
                                        "glosses": [
                                            "D’une manière spéciale ; spécialement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcbc274d-be71-426b-8e56-2a9a0756c71e",
                                                "sense_id": "73fe5f68-f64e-393d-ac61-e86c5c20a417",
                                                "text": "Et particulièrement je mettais entre les excès toutes les promesses par lesquelles on retranche quelque chose de sa liberté,"
                                            },
                                            {
                                                "example_id": "b0418630-5fd7-450d-a047-b3e37b60319c",
                                                "sense_id": "73fe5f68-f64e-393d-ac61-e86c5c20a417",
                                                "text": "J’ai couru deux ou trois fois — je ne sais plus ! — le Tour du Finistère, appelé aussi le Tourduf, dans le milieu des années deux mille, et j’en garde un souvenir particulièrement ému."
                                            },
                                            {
                                                "example_id": "580f033c-e414-4b12-93dd-95feeee2d1e4",
                                                "sense_id": "73fe5f68-f64e-393d-ac61-e86c5c20a417",
                                                "text": "L’habitude des parents qui « larguent » leurs enfants devant l’école au dernier moment « embêtait » particulièrement la mairie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19332a20-c12d-348d-8fcc-a5c270b2eba1",
                                        "entry_id": "03661ef8-80a4-3064-8706-d5c3725df2c2",
                                        "glosses": [
                                            "Un nombre particulier de, une quantité particulière de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5cb0933-24e7-4359-8e75-e022117e1ce0",
                                                "sense_id": "19332a20-c12d-348d-8fcc-a5c270b2eba1",
                                                "text": "Le supérieur du Grand Séminaire de Nancy s’inscrit dans cet esprit lorsqu’il rend hommage à un séminariste mort en Algérie, pour qui il avait particulièrement d’affection, Jean Thibessard : […]"
                                            },
                                            {
                                                "example_id": "4e113639-c233-4f95-a8f2-e191aace1ff7",
                                                "sense_id": "19332a20-c12d-348d-8fcc-a5c270b2eba1",
                                                "text": "D’autre part, et cela a particulièrement d’importance pour la suite de l’argument, le langage est mis en œuvre comme s’il faisait corps avec le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e5fd9ba-10b6-3fb1-aa44-e8795bef3f60",
                                        "entry_id": "03661ef8-80a4-3064-8706-d5c3725df2c2",
                                        "glosses": [
                                            "Dans l’intimité, d’une manière intime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5512528d-9027-4e49-8a21-dd1e7d84189d",
                                                "sense_id": "0e5fd9ba-10b6-3fb1-aa44-e8795bef3f60",
                                                "text": "L’auteur paraît avoir connu particulièrement Marivaux, et doit avoir su de lui plus exactement les détails de sa jeunesse,"
                                            },
                                            {
                                                "example_id": "437f1e56-708c-48f8-8cf1-e5556cc3a17a",
                                                "sense_id": "0e5fd9ba-10b6-3fb1-aa44-e8795bef3f60",
                                                "text": "— On doit, après le dîner qui nous sera servi particulièrement, rendre visite à M. le marquis de Bruyères pour lui montrer la liste des pièces que nous pouvons jouer, et savoir de lui dans quelle partie du château nous dresserons le théâtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eda9d16c-87dc-3336-8926-40deba8a40fe",
                                        "entry_id": "03661ef8-80a4-3064-8706-d5c3725df2c2",
                                        "glosses": [
                                            "En détail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87e363df-5905-498c-8e49-1b76285396c6",
                                                "sense_id": "eda9d16c-87dc-3336-8926-40deba8a40fe",
                                                "text": "Si quelqu’un nous avait particulièrement laissé par écrit ce qui se passait entre Auguste, Mécénas et les excellents esprits de leur siècle, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
