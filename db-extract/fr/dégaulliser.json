                "senses": [
                    {
                        "sense_id": "aaa7f141-bfd1-3cd6-b4d8-b25d082e98d6",
                        "entry_id": "b5294e3b-33c7-3edf-a930-b7a68613e1eb",
                        "glosses": [
                            "Défaire de l’influence gaulliste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3434d9fa-4ed6-423e-b05e-58616a02e47f",
                                "sense_id": "aaa7f141-bfd1-3cd6-b4d8-b25d082e98d6",
                                "text": "Dégaulliser la France ? entend-on dire. Mais il faudrait d’abord la « dénapoléoniser », comme disait le Prince de Ligne, puis la dépétainiser, que sais-je encore, tant nos vices nationaux ont trouvé à se personnaliser."
                            },
                            {
                                "example_id": "7c7635d2-259b-4fcd-b0ca-750bf716fa97",
                                "sense_id": "aaa7f141-bfd1-3cd6-b4d8-b25d082e98d6",
                                "text": "Le message est clair: Valéry Giscard d’Estaing veut \"dégaulliser\" Paris."
                            }
                        ]
                    }
