                ],
                "senses": [
                    {
                        "sense_id": "b7cdf0ca-1e82-392c-b391-5d4a6d4f4ada",
                        "entry_id": "53ae7a57-6458-3a8f-9ca9-dabdc007839a",
                        "glosses": [
                            "Brücke über den Fluss Elbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39d4d4d5-54d0-44c8-9161-bc1664e7bd0d",
                                "sense_id": "b7cdf0ca-1e82-392c-b391-5d4a6d4f4ada",
                                "text": "„Die Elbbrücke in Niederwartha wird vom nächsten Mittwoch an in ihrer Fahrbahn verbreitert, gepflastert und an den Anschlußrampen neu beschottert.“"
                            },
                            {
                                "example_id": "48096e30-9974-44a0-adf8-a7eb29f75e08",
                                "sense_id": "b7cdf0ca-1e82-392c-b391-5d4a6d4f4ada",
                                "text": "„Genoveva bestaunte den Festschmuck und freute sich daran, doch als sie gerade den Fuß auf die erste Bohle der alten Elbbrücke setzen wollte, wurde das Tor geöffnet.“"
                            },
                            {
                                "example_id": "b15329f6-640d-4d04-8cf2-32f60086bb49",
                                "sense_id": "b7cdf0ca-1e82-392c-b391-5d4a6d4f4ada",
                                "text": "„Und während all der glänzenden Feste zogen über die Elbbrücke Massen von Truppen in vollendeter Rüstung, voll kriegerischen Feners nach den Osten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
