            {
                "entry_id": "d0c6ae11-c9a2-381b-b107-7c34ddca9217",
                "word": "samoyède",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70588ad1-47b7-3948-9b54-7ccf4933521e",
                        "entry_id": "d0c6ae11-c9a2-381b-b107-7c34ddca9217",
                        "glosses": [
                            "Chien polyvalent, voisin du loup, originaire de Sibérie, à poil épais, blanc, crème ou fauve."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "1af5026d-fe1b-4adf-bbef-e250a27d5d59",
                                "sense_id": "70588ad1-47b7-3948-9b54-7ccf4933521e",
                                "text": "Le samoyède était utilisé par la tribu des Samoyèdes (aujourd’hui essentiellement Nénètses) pour tirer les traîneaux notamment."
                            },
                            {
                                "example_id": "8f4c362c-1a02-4b59-8080-c7daa2819c1a",
                                "sense_id": "70588ad1-47b7-3948-9b54-7ccf4933521e",
                                "text": "Le samoyède fait partie du groupe 5 du classement des races de chien par la société centrale canine ou SCC."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d900344-62cb-402c-a87b-c8cec861a8b2",
                        "source_entry_id": "d0c6ae11-c9a2-381b-b107-7c34ddca9217",
                        "source_sense_id": "70588ad1-47b7-3948-9b54-7ccf4933521e",
                        "target_lang_word": "Samojede",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Samojede",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "693eead2-8138-3374-8940-91a6c307d6fa",
                                        "entry_id": "cabd41f2-430c-395f-b327-8aa6cc148c34",
                                        "glosses": [
                                            "Hunderasse FCI-Standard Nr. 212"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a6950f9-cf5e-4bb5-b24b-21fb8534b0dd",
                                                "sense_id": "693eead2-8138-3374-8940-91a6c307d6fa",
                                                "text": "Sein charakteristischer Ausdruck, das sogenannte «Lächeln» des Samojeden, wird erzeugt durch die Kombination der Augenform und -stellung mit den in sanfter Kurve nach oben gerichteten Lefzenwinkeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e201b6d-aa27-3f0f-836b-2cc89a05d44d",
                                        "entry_id": "cabd41f2-430c-395f-b327-8aa6cc148c34",
                                        "glosses": [
                                            "Angehöriger eines der samojedischen Völker, den Nenzen (Jurak-Samojeden, Juraken), Enzen, Nganasanen (Tawgi-Samojeden) und Selkupen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e27bca-5f56-4dc2-ad5e-7f52c08b06e3",
                                                "sense_id": "7e201b6d-aa27-3f0f-836b-2cc89a05d44d",
                                                "text": "Bei den unter dem Oberbegriff Samojeden zusammengefassten Völkern handelt es sich um Ethnien, die ursprünglich als Nomaden lebten und sich von ihren Rentierherden, von Fischfang und von der Jagd ernährten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4e43ce6c-628e-3ccb-b5f8-b526b228c04e",
                                        "entry_id": "cabd41f2-430c-395f-b327-8aa6cc148c34",
                                        "glosses": [
                                            "Angehöriger des Volks der Nenzen im Nordosten des europäischen Teils Russlands und im Nordwesten Sibiriens"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97fd03be-6a10-41f9-bf93-7cbe7e799ef6",
                                                "sense_id": "4e43ce6c-628e-3ccb-b5f8-b526b228c04e",
                                                "text": "Die Morpheme samo und jed des Russischen bedeuten in der Zusammensetzung „Selbst-Esser“, was abschätzig wirkt. Deshalb wurde der Name Samojeden im 20. Jahrhundert immer seltener benutzt, das Volk selbst brachte die Bezeichnung Nenzen hervor."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a0beb4d4-833b-3e9c-a6f4-e258a821a461",
                                        "entry_id": "cabd41f2-430c-395f-b327-8aa6cc148c34",
                                        "glosses": [
                                            "Sprecher einer samojedischen Sprache, wie Nenzisch, Tundra-Nenzisch, Wald-Nenzisch, Jurakisch (Ostnenzisch, Jurazisch), Enzisch (Jenissei-Samojedisch), Nganasanisch (Tawgi-Samojedisch), Selkupisch (Ostjak-Samojedisch), Matorisch, Kamassisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bca64c7-12bf-4f7e-86b2-0145396f5dcd",
                                                "sense_id": "a0beb4d4-833b-3e9c-a6f4-e258a821a461",
                                                "text": "Die samojedischen Sprachen bilden mit den finnisch-ugrischen Sprachen die uralische Sprachfamilie und werden von ca. 30.000 Menschen im nördlichen Osteuropa und im nordwestlichen Sibirien gesprochen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
