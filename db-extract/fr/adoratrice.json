        "fr-extract.jsonl": [
            {
                "entry_id": "a8b5bd03-b6c8-3221-854f-59135418d49f",
                "word": "adoratrice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "27728b4c-820f-45b6-b77b-fa13d4da02cf",
                        "entry_id": "a8b5bd03-b6c8-3221-854f-59135418d49f",
                        "tags": [
