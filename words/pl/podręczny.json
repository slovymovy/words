{
    "word_family": [
        "podręcznik",
        "podręcznikowy",
        "ręka",
        "ręczny"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "31488750-a3cf-316b-9bcf-f014412ce397",
                    "sense_definition": "znajdujący się pod ręką, łatwo dostępny i gotowy do natychmiastowego użycia",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dostepnosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W samochodzie zawsze warto mieć <w>podręczną</w> apteczkę z podstawowymi lekami.",
                            "target_lang_translations": {
                                "ru": "В машине всегда стоит иметь <w>подручную</w> аптечку с основными лекарствами."
                            }
                        },
                        {
                            "text": "Na biurku trzymam tylko najbardziej <w>podręczne</w> przybory do pisania.",
                            "target_lang_translations": {
                                "ru": "На письменном столе я держу только самые <w>необходимые под рукой</w> письменные принадлежности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "podręczna apteczka",
                        "podręczna biblioteczka",
                        "bagaż podręczny"
                    ],
                    "target_lang_definitions": {
                        "ru": "находящийся под рукой, легко доступный и готовый к немедленному использованию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подручный",
                                "target_lang_sense_clarification": "находящийся под рукой, всегда доступный"
                            },
                            {
                                "target_lang_word": "ручной",
                                "target_lang_sense_clarification": "о клади или багаже, который берут с собой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68f910c4-66b7-3480-aaa3-447aba10fa6f",
                    "sense_definition": "niewielki, łatwy do przenoszenia lub trzymania w dłoni",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rozmiar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiłem mały, <w>podręczny</w> odkurzacz, który idealnie nadaje się do sprzątania okruchów.",
                            "target_lang_translations": {
                                "ru": "Я купил маленький <w>портативный</w> пылесос, который идеально подходит для уборки крошек."
                            }
                        },
                        {
                            "text": "Do pracy w terenie najbardziej przydaje się <w>podręczny</w> zestaw narzędzi.",
                            "target_lang_translations": {
                                "ru": "Для работы на выезде больше всего пригодится <w>компактный</w> набор инструментов."
                            }
                        }
                    ],
                    "synonyms": [
                        "przenośny"
                    ],
                    "common_phrases": [
                        "podręczny zestaw",
                        "podręczny sprzęt"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшой, компактный, удобный для переноски или удерживания в руке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "портативный",
                                "target_lang_sense_clarification": "небольшой по размеру, удобный для переноски"
                            },
                            {
                                "target_lang_word": "компактный",
                                "target_lang_sense_clarification": "занимающий мало места, удобный"
                            },
                            {
                                "target_lang_word": "ручной",
                                "target_lang_sense_clarification": "небольшой инструмент или прибор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dffbcc0-31d4-3224-8c24-f83021cbfa5a",
                    "sense_definition": "o wydawnictwie lub źródle informacji: zwięzły, niewielki i zawierający najważniejsze wiadomości",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zabrał w podróż <w>podręczny</w> słownik języka hiszpańskiego, aby ułatwić sobie rozmowę.",
                            "target_lang_translations": {
                                "ru": "Он взял в поездку <w>карманный</w> словарь испанского языка, чтобы облегчить общение."
                            }
                        },
                        {
                            "text": "Warto mieć przy sobie <w>podręczny</w> przewodnik z najważniejszymi atrakcjami miasta.",
                            "target_lang_translations": {
                                "ru": "Стоит иметь при себе <w>краткий</w> путеводитель с главными достопримечательностями города."
                            }
                        }
                    ],
                    "synonyms": [
                        "kieszonkowy"
                    ],
                    "common_phrases": [
                        "podręczny słownik",
                        "podręczny atlas"
                    ],
                    "target_lang_definitions": {
                        "ru": "об издании, книге или источнике информации: краткий, карманный, содержащий основные сведения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карманный",
                                "target_lang_sense_clarification": "о справочнике, словаре небольшого формата"
                            },
                            {
                                "target_lang_word": "настольный",
                                "target_lang_sense_clarification": "о справочнике или пособии повседневного использования"
                            },
                            {
                                "target_lang_word": "краткий",
                                "target_lang_sense_clarification": "содержащий только основную информацию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}