                                    },
                                    {
                                        "sense_id": "377ca5b3-c180-305a-94ed-a455c19c0d97",
                                        "entry_id": "17c666f8-81b6-30df-a762-a108106c919f",
                                        "glosses": [
                                            "A spokesman; one who speaks on behalf of someone else."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5afd4df-4659-4e34-9117-8746c2ba04f7",
                                                "sense_id": "377ca5b3-c180-305a-94ed-a455c19c0d97",
                                                "text": "The novel's protagonist serves as a mouthpiece for the author's political views."
                                            },
                                            {
                                                "example_id": "f586010a-a60a-47fe-bbf1-40b72d506698",
                                                "sense_id": "377ca5b3-c180-305a-94ed-a455c19c0d97",
                                                "text": "Seeming “real” has been the aim since the earliest police procedurals, which began a long tradition of Hollywood productions acting as a mouthpiece for police departments."
                                            },
                                            {
                                                "example_id": "1b372269-d781-4641-bb00-41c723f30274",
                                                "sense_id": "377ca5b3-c180-305a-94ed-a455c19c0d97",
                                                "text": "Xi Jinping has told the People’s Liberation Army to “focus all its energy on fighting” in preparation for war, a Chinese Communist party mouthpiece has reported."
                                            },
                                            {
                                                "example_id": "89ae5cbe-cc0e-41e1-832f-c81a160f17c9",
                                                "sense_id": "377ca5b3-c180-305a-94ed-a455c19c0d97",
                                                "text": "Rightwing media mouthpieces and ICE get both barrels in South Park’s latest zeitgeist-capturing satire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2edb756-a502-3bf7-a352-810756c07cae",
                                        "entry_id": "17c666f8-81b6-30df-a762-a108106c919f",
                                        "glosses": [
                                            "A lawyer for the defense."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32169938-9949-4d35-b3e3-a5c6cba0682d",
                        "source_entry_id": "29cd22a9-37ae-3e10-8bf8-6e30f452727b",
                        "source_sense_id": "97d0e503-96fb-3146-9dcc-a496b1af0946",
                        "source_sense_description": "dat deel van een blaasinstrument dat in de mond genomen wordt of aan de lippen gezet",
                        "target_lang_word": "embouchure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embouchure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "884505ee-fa65-3341-bb09-9db8a59880dd",
                                        "entry_id": "442061b2-3e4c-30dc-9e91-51916a24a226",
                                        "glosses": [
                                            "Lieu où se jette un fleuve dans la mer ou par lequel une rivière se jette dans un fleuve ou dans une autre rivière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bde886b-e8d4-4255-b473-4990e42f745e",
                                                "sense_id": "884505ee-fa65-3341-bb09-9db8a59880dd",
                                                "text": "Ses principales factoreries sont situées sur la baie James, à l'embouchure de la rivière de Severn, dans la partie sud et vers les frontières du Haut-Canada."
                                            },
                                            {
                                                "example_id": "6d6e04fc-4fc1-4760-a555-2b5a2687ef82",
                                                "sense_id": "884505ee-fa65-3341-bb09-9db8a59880dd",
                                                "text": "Pour connaître le cours d'un fleuve, il faut le suivre depuis sa source jusqu'à son embouchure."
                                            },
                                            {
                                                "example_id": "d9348def-a3c3-4793-b1cc-56ee3b9d1599",
                                                "sense_id": "884505ee-fa65-3341-bb09-9db8a59880dd",
                                                "text": "Son embouchure, à 32 ou 33 kilomètres au sud de Safi, est bloquée par une barre guéable à marée basse pendant presque toute l'année."
                                            },
                                            {
                                                "example_id": "e9676ea9-d051-4b98-97bc-9902004ab3cc",
                                                "sense_id": "884505ee-fa65-3341-bb09-9db8a59880dd",
                                                "text": "Le Louvre conserve une tablette votive sumérienne, venant de l’embouchure de l’Euphrate et datant de 2850 avant J.C., faite d’un mélange artificiel de bitume et d’argile."
                                            },
                                            {
                                                "example_id": "f3488c37-edf3-4fe6-812e-a1ad11eab749",
                                                "sense_id": "884505ee-fa65-3341-bb09-9db8a59880dd",
                                                "text": "Il est vrai qu'il y eut des moments de tension extrême, par exemple à l’embouchure de la rivière, lorsque Jean ne winchait pas assez vite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29a94382-055b-3c51-82b3-d102fdd821a1",
                                        "entry_id": "442061b2-3e4c-30dc-9e91-51916a24a226",
                                        "glosses": [
                                            "Pièce métallique en forme d’entonnoir, propre aux cuivres, sur laquelle le musicien pose ses lèvres. , zone du corps d'autres instruments à vent (notamment certaines flûtes) qui est en contact avec la bouche du musicien."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a19870df-3a9a-41bb-8172-b74c8df6234d",
                                                "sense_id": "29a94382-055b-3c51-82b3-d102fdd821a1",
                                                "text": "Le syrinx ou flûte de Pan est une flûte polycalame à embouchures libres (et multiples)."
                                            },
                                            {
                                                "example_id": "87a9edf8-1af9-4041-b929-397ae891a9f7",
                                                "sense_id": "29a94382-055b-3c51-82b3-d102fdd821a1",
                                                "text": "À l’un des côtés de cette ceinture pendait une espèce de panier ; à l’autre, une corne de bélier ayant une embouchure par laquelle on soufflait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a810150-69ff-3acf-a889-98c941bbb5a4",
                                        "entry_id": "442061b2-3e4c-30dc-9e91-51916a24a226",
                                        "glosses": [
                                            "Manière dont on embouche certains instruments."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5fa1975-00d8-428e-92d0-04bd54cb23af",
                                                "sense_id": "3a810150-69ff-3acf-a889-98c941bbb5a4",
                                                "text": "Ce joueur de flûte a l’embouchure excellente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d022d465-84b3-3655-88cf-cd30b2c5d721",
                                        "entry_id": "442061b2-3e4c-30dc-9e91-51916a24a226",
                                        "glosses": [
                                            "Orifice pratiqué dans un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02a6a122-854f-4e66-8a5b-40f62a22977b",
                                                "sense_id": "d022d465-84b3-3655-88cf-cd30b2c5d721",
                                                "text": "Le front incliné, le menton engoncé dans l'échancrure de la robe, les mains croisées dans les embouchures des manches flottantes, le Japonais écoutait, imperturbable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f3b8c7a-95f9-3c14-aca2-680d43053eae",
                                        "entry_id": "442061b2-3e4c-30dc-9e91-51916a24a226",
                                        "glosses": [
                                            "Gueule du canon."
                                        ],
                                        "tags": [],
