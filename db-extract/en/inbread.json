                "senses": [
                    {
                        "sense_id": "792ac049-8f37-3ff9-8d4d-7ecec8ecb25a",
                        "entry_id": "834792c8-7270-32fc-a605-dcfbef10d5e1",
                        "glosses": [
                            "Synonym of impanate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "491ba11d-713a-4538-af59-6fce11780d07",
                                "sense_id": "792ac049-8f37-3ff9-8d4d-7ecec8ecb25a",
                                "text": "But now we muſt belcue that he cometh downe agayn at the wyll of the preſtes, to be inpaned or inbreaded for their bellyes commonwelthe, lyke as be afore came downe, at the wyll of hys heauenlye father, to be incarnated or infleſhed for our vnyuerſall ſowles helth."
                            },
                            {
                                "example_id": "f6aabd38-9233-4aef-937f-77f545ae0332",
                                "sense_id": "792ac049-8f37-3ff9-8d4d-7ecec8ecb25a",
                                "text": "Semblable through the sayd body be presented in ye bred, howbeit it is not become one person therwith which is properly termed ye impaning or enbreding therof."
                            },
                            {
                                "example_id": "8ed3e571-2328-4475-a768-aa38f2931347",
                                "sense_id": "792ac049-8f37-3ff9-8d4d-7ecec8ecb25a",
                                "text": "Or, in-breaded God, impanatus Deus."
                            }
                        ]
                    }
                ],
