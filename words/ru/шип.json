                {
                    "sense_id": "4078646f-3867-3634-b23b-a7685065d9cd",
                    "sense_definition": "Острый вырост на стебле растения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не бывает розы без <w>шипов</w>.",
                            "target_lang_translations": {
                                "en": "There is no rose without <w>thorns</w>."
                            }
                        },
                        {
                            "text": "Осторожно, у этого кактуса очень острые <w>шипы</w>.",
                            "target_lang_translations": {
                                "en": "Be careful, this cactus has very sharp <w>thorns</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "игла",
                        "колючка"
                    ],
                    "common_phrases": [
                        "острые шипы"
                    ],
                    "target_lang_definitions": {
                        "en": "A sharp, pointed outgrowth on the stem of a plant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thorn",
                                "target_lang_sense_clarification": "A sharp, woody outgrowth on a plant stem."
                            },
                            {
                                "target_lang_word": "prickle",
                                "target_lang_sense_clarification": "A small, sharp, pointed outgrowth on a plant."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cb402f5-f970-33e6-86bf-9059aa0a2c5c",
                    "sense_definition": "Металлический выступ на подошве обуви или шине для лучшего сцепления с дорогой.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой лучше ездить на резине с <w>шипами</w>.",
                            "target_lang_translations": {
                                "en": "In winter, it is better to drive on <w>studded</w> tires."
                            }
                        },
                        {
                            "text": "Футболисты надевают бутсы с <w>шипами</w> для игры на траве.",
                            "target_lang_translations": {
                                "en": "Football players wear <w>cleated</w> boots to play on grass."
                            }
