                    },
                    {
                        "sense_id": "b49c6b8b-0014-3e52-91d9-5a32ae57980e",
                        "entry_id": "44a208dc-875f-34f3-b6cb-88201ca36934",
                        "glosses": [
                            "Peindre ou sculpter des personnages à l'allure raide, sans naturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab0bb913-bf81-4e42-89b0-4d2fb30b783a",
                                "sense_id": "b49c6b8b-0014-3e52-91d9-5a32ae57980e",
                                "text": "C’est le nu de la femme, avec une parfaite connaissance de son anatomie, mais un nu, simplifié, résumé dans ses masses, et présenté sans détails, en des longueurs un peu mannequinées, et par un trait qu’on dirait calligraphié."
                            }
                        ]
                    }
