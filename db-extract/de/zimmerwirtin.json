                "senses": [
                    {
                        "sense_id": "8f13ec28-85a7-3aad-9c78-fb499db4b2e9",
                        "entry_id": "f4e9098a-6808-3cbe-b439-8d7cbc8aaafa",
                        "glosses": [
                            "Frau, die ein Zimmer/mehrere Zimmer vermietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06cf1ba-a335-4bae-bc26-a4e3d11eb8e7",
                                "sense_id": "8f13ec28-85a7-3aad-9c78-fb499db4b2e9",
                                "text": "„Verzweifelt fragte sie bei seiner Zimmerwirtin nach.“"
                            },
                            {
                                "example_id": "b57a5d37-bfa8-4fdf-8424-18c4f9c55f5a",
                                "sense_id": "8f13ec28-85a7-3aad-9c78-fb499db4b2e9",
                                "text": "„Zusammen mit der Tochter ihrer Zimmerwirtin fuhr Ditti abends mit der Straßenbahn zur Endstation, sie kletterten auf die Güterwaggons mit den Eierbriketts, stopften die Rucksäcke voll und schleppten sie – verdammt schwer, wie sie waren – wieder zurück nach Hause.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
