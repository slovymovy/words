            "senses": [
                {
                    "sense_id": "6e94a742-a64f-3d44-9f14-eee6167c0c17",
                    "sense_definition": "Leçon ou enseignement moral que l'on tire d'une fable ou d'une histoire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lecon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la fin du conte, l'auteur rappelle la <w>moralité</w> de l'histoire aux jeunes lecteurs."
                        },
                        {
                            "text": "Chaque fable de La Fontaine se termine généralement par une claire <w>moralité</w>."
                        }
                    ],
                    "synonyms": [
                        "morale"
                    ],
                    "common_phrases": [
                        "moralité de l'histoire",
                        "moralité d'une fable"
                    ]
                },
                {
                    "sense_id": "95a15dae-08d4-3e9f-b202-36bddbec8384",
                    "sense_definition": "Conformité d'une personne aux principes du bien et de la vertu ; droiture, honnêteté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vertu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a mené une enquête pour vérifier la <w>moralité</w> du candidat avant son embauche."
                        },
                        {
                            "text": "Personne ne mettait en doute la parfaite <w>moralité</w> de ce vieux médecin de campagne."
                        }
                    ],
                    "synonyms": [
                        "honnêteté",
                        "intégrité",
                        "probité"
                    ],
                    "antonyms": [
                        "immoralité"
                    ],
                    "common_phrases": [
                        "enquête de moralité",
                        "douteuse moralité"
                    ]
                },
                {
                    "sense_id": "9412fefb-1447-306b-997c-fbf6cffd442a",
                    "sense_definition": "Conclusion pratique, souvent sentencieuse ou ironique, tirée d'une situation vécue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lecon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Moralité</w>, il vaut mieux réfléchir à deux fois avant de signer un tel contrat."
                        },
                        {
                            "text": "Nous sommes arrivés en retard sous la pluie ; <w>moralité</w>, nous aurions dû prendre le train."
                        }
                    ],
                    "synonyms": [
                        "conclusion"
                    ]
                },
                {
                    "sense_id": "497f57fc-1bd5-30e5-802b-f84017548110",
                    "sense_definition": "Caractère de ce qui est conforme aux règles et aux exigences de la morale.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "vertu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les philosophes s'interrogent depuis des siècles sur la <w>moralité</w> de certaines décisions politiques."
                        },
                        {
                            "text": "Il est parfois difficile de juger de la <w>moralité</w> d'un choix imposé par une situation d'urgence."
                        }
                    ],
                    "synonyms": [
                        "éthique"
                    ],
                    "antonyms": [
                        "immoralité"
                    ]
                },
                {
                    "sense_id": "91798f37-48ea-366e-943c-d327fbeb3bac",
                    "sense_definition": "Genre théâtral allégorique du Moyen Âge mettant en scène des vertus et des vices dans un but d'instruction morale.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au quinzième siècle, la <w>moralité</w> était un genre théâtral très populaire auprès du public urbain."
                        },
                        {
                            "text": "Les comédiens ont interprété une célèbre <w>moralité</w> médiévale sur le parvis de l'église."
                        }
                    ]
                }
            ]
        }
    ]
