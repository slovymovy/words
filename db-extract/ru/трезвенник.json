                                        "sense_id": "c08574a3-bf74-384a-8720-5104e767b7b7",
                                        "entry_id": "74ea0cbf-e6b9-3377-8537-dd17c6c06890",
                                        "glosses": [
                                            "Person, die prinzipiell keinen Alkohol trinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6394e07f-c8d6-4acf-a8ca-40ec0373be36",
                                                "sense_id": "c08574a3-bf74-384a-8720-5104e767b7b7",
                                                "text": "Für einen überzeugten Abstinenzler sind Erscheinungen wie das Koma-Saufen völlig unverständlich."
                                            },
                                            {
                                                "example_id": "0d5781c0-19b1-479d-bc59-181d6d92a7a6",
                                                "sense_id": "c08574a3-bf74-384a-8720-5104e767b7b7",
                                                "text": "„Der Präsident bestellte noch eine Runde Bier, bemerkte aber leicht gereizt, eine Person, die in betrunkenem Zustand nukleare Geheimnisse ausplauderte, sollte vielleicht erwägen, unter die Abstinenzler zu gehen.“"
                                            },
                                            {
                                                "example_id": "93381a1f-bee3-40ba-a48b-9b328687ce45",
                                                "sense_id": "c08574a3-bf74-384a-8720-5104e767b7b7",
                                                "text": "„Angeblich war der für das Palais zuständige Marschall Abstinenzler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
