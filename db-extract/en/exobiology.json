                "entry_id": "a4eb6482-f47f-36ae-95e9-6c7e7fe45733",
                "word": "exobiology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "273c825f-cc88-46ad-81cd-061a6b06538f",
                        "entry_id": "a4eb6482-f47f-36ae-95e9-6c7e7fe45733",
                        "tags": [
                            "plural"
                        ],
                        "form": "exobiologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27cb86d7-80d0-39f5-a039-0c72522ea4e2",
                        "entry_id": "a4eb6482-f47f-36ae-95e9-6c7e7fe45733",
                        "glosses": [
                            "The branch of biology dealing with lifeforms originating a different planet."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "842431b5-1de3-4846-9823-d1c1dadbabd2",
                                "sense_id": "27cb86d7-80d0-39f5-a039-0c72522ea4e2",
                                "text": "Biology has lately given rise to a new discipline: exobiology, the study of extraterrestrial life. Ever since 1959, when analysis of a piece of meteor substance showed traces of organic compounds, a controversy has raged as to whether these compounds came into the atmosphere with the meteorite or whether they originate on earth."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "796d95c1-fe1e-499a-814b-786fe150f602",
                        "source_entry_id": "a4eb6482-f47f-36ae-95e9-6c7e7fe45733",
                        "source_sense_id": "27cb86d7-80d0-39f5-a039-0c72522ea4e2",
                        "source_sense_description": "biology dealing with extraterrestrial lifeforms",
                        "target_lang_word": "exobiologie",
