                "senses": [
                    {
                        "sense_id": "f36da4fe-71a3-3c59-9725-0d39ec1e9d22",
                        "entry_id": "83f4315e-8052-3fc6-990d-e35339aa8fcd",
                        "glosses": [
                            "спец., охотн. войлочная, картонная, кожаная и т. п. прокладка внутри охотничьих патронов"
                        ],
                        "tags": [],
