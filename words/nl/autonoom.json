{
    "word_family": [
        "autonomie",
        "autonoompje"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "272ff162-492a-34f6-8a62-e887238f8be6",
                    "sense_definition": "niet afhankelijk van anderen, zelfstandig handelend of functionerend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onafhankelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>autonome</w> ontwikkeling van kinderen is misschien wel belangrijker dan het gereguleerde onderwijs.",
                            "target_lang_translations": {
                                "en": "The <w>autonomous</w> development of children is perhaps even more important than regulated education."
                            }
                        },
                        {
                            "text": "Zij is een zeer <w>autonome</w> persoon die haar eigen beslissingen neemt zonder hulp van buitenaf.",
                            "target_lang_translations": {
                                "en": "She is a very <w>independent</w> person who makes her own decisions without outside help."
                            }
                        }
                    ],
                    "synonyms": [
                        "zelfstandig",
                        "onafhankelijk",
                        "soeverein"
                    ],
                    "antonyms": [
                        "afhankelijk",
                        "onvrij"
                    ],
                    "common_phrases": [
                        "autonome persoonlijkheid",
                        "autonoom individu"
                    ],
                    "target_lang_definitions": {
                        "en": "not dependent on others, acting or functioning independently"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "autonomous",
                                "target_lang_sense_clarification": "self-governing or independent"
                            },
                            {
                                "target_lang_word": "independent",
                                "target_lang_sense_clarification": "not influenced or controlled by others"
                            },
                            {
                                "target_lang_word": "self-reliant",
                                "target_lang_sense_clarification": "relying on one's own powers and resources"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac81f6d3-4b7b-3c4e-8cfe-3a933218a698",
                    "sense_definition": "zonder directe menselijke besturing of externe controle werkend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Google gaat zijn zelfrijdende auto’s leren meer als mensen te rijden met deze <w>autonome</w> voertuigen.",
                            "target_lang_translations": {
                                "en": "Google is going to teach its self-driving cars to drive more like humans with these <w>autonomous</w> vehicles."
                            }
                        },
                        {
                            "text": "In de toekomst zullen <w>autonome</w> systemen veel taken in de fabriek overnemen.",
                            "target_lang_translations": {
                                "en": "In the future, <w>autonomous</w> systems will take over many tasks in the factory."
                            }
                        }
                    ],
                    "synonyms": [
                        "zelfsturend"
                    ],
                    "common_phrases": [
                        "autonome voertuigen",
                        "autonome systemen",
                        "autonome wapens"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "operating without direct human control or external steering"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "autonomous",
                                "target_lang_sense_clarification": "of a machine or system, acting independently"
                            },
                            {
                                "target_lang_word": "self-driving",
                                "target_lang_sense_clarification": "specifically for vehicles"
                            },
                            {
                                "target_lang_word": "automated",
                                "target_lang_sense_clarification": "operated by largely automatic equipment"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07ef1a28-1604-3299-9374-7a38da2221a4",
                    "sense_definition": "een lid van een anarchistische jongerenbeweging in Nederland, vooral actief in de jaren tachtig",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "subcultuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>autonomen</w> weigerden nooit een bijstandsuitkering te ontvangen van de verderfelijke overheid.",
                            "target_lang_translations": {
                                "en": "The <w>autonomists</w> never refused to receive welfare benefits from the pernicious government."
                            }
                        },
                        {
                            "text": "Tijdens de krakersrellen waren veel <w>autonomen</w> op straat te vinden.",
                            "target_lang_translations": {
                                "en": "During the squatter riots, many <w>anarchists</w> could be found on the streets."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Nederland"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "jaren tachtig"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a member of an anarchist youth movement in the Netherlands, especially active in the 1980s"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "autonomist",
                                "target_lang_sense_clarification": "member of a radical left-wing political movement"
                            },
                            {
                                "target_lang_word": "anarchist",
                                "target_lang_sense_clarification": "person who advocates for self-governed societies"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}