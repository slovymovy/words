                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588eb6f4-0e8c-4918-9722-66f1fa825afa",
                                                "sense_id": "c679a32b-9214-3e16-8a39-5103d3dcb2cc",
                                                "text": "I inscribed the book with a message for Kate."
                                            },
                                            {
                                                "example_id": "1015dc98-58f7-45d3-ab26-726957e6ce32",
                                                "sense_id": "c679a32b-9214-3e16-8a39-5103d3dcb2cc",
                                                "text": "I inscribed my name into the book."
                                            },
                                            {
                                                "example_id": "db98cadd-2b60-4b54-af05-ccc638b0c5b2",
                                                "sense_id": "c679a32b-9214-3e16-8a39-5103d3dcb2cc",
                                                "text": "This coheres with the pattern of Scripture, which inscribes her story among that of others in the company of Jesus."
