    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b2d0ac86-e46a-388f-b848-c6c758786319",
                "word": "Japanophile",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5a01c27b-afbb-48ca-96cb-5b8fff32e255",
                        "entry_id": "b2d0ac86-e46a-388f-b848-c6c758786319",
                        "tags": [
                            "plural"
                        ],
                        "form": "Japanophiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7881d537-40e0-312c-9279-1afe770d485b",
                        "entry_id": "b2d0ac86-e46a-388f-b848-c6c758786319",
                        "glosses": [
                            "A person who loves the country, culture, or people of Japan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deec23e6-be49-4054-92c4-5ab4e6a24cd4",
                                "sense_id": "7881d537-40e0-312c-9279-1afe770d485b",
                                "text": "I am convinced that this book is not solely of interest to Japanophiles. The quality of Sado Hasegawa's work shines through and the book should prove to be a valued asset to any home library and is beautiful for display."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93b4e698-d4aa-487b-8610-0c97f4b877b1",
                        "source_entry_id": "b2d0ac86-e46a-388f-b848-c6c758786319",
                        "source_sense_id": "7881d537-40e0-312c-9279-1afe770d485b",
                        "source_sense_description": "A person who loves Japan",
                        "target_lang_word": "japonophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "japonophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05f0d260-48c7-37ab-8647-4d51f9d17622",
                                        "entry_id": "936f5b4d-5600-363a-bf9c-89a80358716d",
                                        "glosses": [
                                            "Qui aime le Japon, les Japonais ou la culture japonaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b47b0302-94ac-43fe-a318-711826f7070f",
                                                "sense_id": "05f0d260-48c7-37ab-8647-4d51f9d17622",
                                                "text": "Ce n'est certes point par amitié pour le maître anglais; mais l'Hindou est japonophile. La joie procède d'un vague sentiment panasiatique qui naît. Une multitude d'images représentant les récents faits de guerre se vendent dans les bazars."
                                            },
                                            {
                                                "example_id": "638776cd-7bab-4d07-be25-8cd943318f33",
                                                "sense_id": "05f0d260-48c7-37ab-8647-4d51f9d17622",
                                                "text": "Les partisans de l'éducation, comme les fonctionnaires japonophiles représentent l'élite intellectuelle du pays, et voient dans le Japon l'intermédiaire le plus utile entre la Chine et les idées occidentales."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "japonophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55044ca5-61a2-30ff-90f7-3189c43db5cc",
                                        "entry_id": "c7bc8260-7976-39a5-9d4a-7d733063e278",
                                        "glosses": [
                                            "Personne qui aime le Japon ou la culture japonaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4e7bcad-ecdc-46e7-b8b6-c23fe7be3467",
                                                "sense_id": "55044ca5-61a2-30ff-90f7-3189c43db5cc",
                                                "text": "Si un japonophile comme Zhou dénonçait avec pareille virulence les projets de collaboration culturelle proposés par le Japon, on devine aisément l’hostilité éprouvée par la majorité des Chinois."
                                            },
                                            {
                                                "example_id": "300d23b1-85e3-4b02-b3b1-98e6edd34f68",
                                                "sense_id": "55044ca5-61a2-30ff-90f7-3189c43db5cc",
                                                "text": "Du coup, Ham-heung, capitale de la province, est évacué par les négociants japonais et les japonophiles, laissant carte blanche au préfet, tout acquis aux Russes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f03032aa-76cc-4c58-ab12-54b3f3490a86",
                        "source_entry_id": "b2d0ac86-e46a-388f-b848-c6c758786319",
                        "source_sense_id": "7881d537-40e0-312c-9279-1afe770d485b",
                        "source_sense_description": "A person who loves Japan",
                        "target_lang_word": "nippophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nippophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0503e0ea-48f2-3e4d-bdf8-c6c470342d62",
                                        "entry_id": "c984e4bf-604b-34e8-8e29-25e8b5fedf75",
                                        "glosses": [
                                            "Passionné, amateur du Japon et de la culture japonaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33cd4f21-6589-4f3e-9e74-52517ed3a4ca",
                                                "sense_id": "0503e0ea-48f2-3e4d-bdf8-c6c470342d62",
                                                "text": "Zhu Rongji, le vice-premier ministre en charge de l’économie et des finances, est un nippophile. Il estime que l’Empire du Milieu a beaucoup à apprendre de son voisin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
