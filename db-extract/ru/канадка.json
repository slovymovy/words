                ],
                "senses": [
                    {
                        "sense_id": "01fe5481-cf49-3d7d-b267-4849cf659fcc",
                        "entry_id": "ccb24d1f-f205-31c7-ad80-c2f09e307caa",
                        "glosses": [
                            "жительница или уроженка Канады"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1e2b27f-67d5-4ec0-aacb-293a53666653",
                                "sense_id": "01fe5481-cf49-3d7d-b267-4849cf659fcc",
                                "text": "Самая известная женщина-вратарь ― канадка Манон Реом."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdef5f20-8a61-3951-9601-51ae0ae66afc",
                        "entry_id": "ccb24d1f-f205-31c7-ad80-c2f09e307caa",
                        "glosses": [
                            "разг. тёплая куртка, обычно на меху"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9082db73-3339-4b3e-b96a-d72fa6c26b8e",
                                "sense_id": "cdef5f20-8a61-3951-9601-51ae0ae66afc",
                                "text": "На мне была доходившая мне до колен канадка, а башмаки сорок второго размера."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5fb80f8-0863-3891-998b-5c1183b1e221",
                        "entry_id": "ccb24d1f-f205-31c7-ad80-c2f09e307caa",
                        "glosses": [
                            "разг. короткая мужская стрижка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2969d472-b5e9-4683-99fd-38f74c3335c7",
                                "sense_id": "b5fb80f8-0863-3891-998b-5c1183b1e221",
                                "text": "― Канадка? ― Она самая, ― кивнул Постников. Он так и не выучил ни одного стрижечного названия и всегда, чтобы не выглядеть дураком, соглашался на любые предложения."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f0dccd8-3cdb-31ba-a8e6-107bc3c2f23f",
                        "entry_id": "ccb24d1f-f205-31c7-ad80-c2f09e307caa",
                        "glosses": [
                            "разновидность спортивного каноэ"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0791ffd1-eb0e-367b-95bd-e2a805845483",
                        "entry_id": "ccb24d1f-f205-31c7-ad80-c2f09e307caa",
                        "glosses": [
                            "обычно мн. ч. костыль с опорой под локоть"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
