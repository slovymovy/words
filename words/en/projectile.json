{
    "word_family": [
        "project",
        "projection",
        "projector"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf0bcac8-0b7b-3d25-b4c7-45d976916a8b",
                    "sense_definition": "An object intended to be or having been shot from a weapon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier took cover as the <w>projectile</w> flew over his head.",
                            "target_lang_translations": {
                                "zh": "士兵赶紧寻找掩护，因为<w>弹丸</w>从他头顶飞过。",
                                "ru": "Солдат укрылся, когда над его головой просвистел <w>снаряд</w>."
                            }
                        },
                        {
                            "text": "Police recovered a <w>projectile</w> from the crime scene.",
                            "target_lang_translations": {
                                "zh": "警方从犯罪现场找到了一枚<w>弹丸</w>。",
                                "ru": "Полиция изъяла <w>пулю</w> с места преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "missile",
                        "bullet"
                    ],
                    "common_phrases": [
                        "fired projectile"
                    ],
                    "target_lang_definitions": {
                        "zh": "指从武器中发射出来的物体，如子弹或炮弹。",
                        "ru": "Предмет, предназначенный для выстрела из оружия или уже выпущенный из него."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弹丸",
                                "target_lang_sense_clarification": "指枪炮等发射的物体，常用于军事或技术语境。"
                            },
                            {
                                "target_lang_word": "抛射物",
                                "target_lang_sense_clarification": "指被发射或投掷出的物体，涵盖范围较广。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "снаряд",
                                "target_lang_sense_clarification": "артиллерийский боеприпас или метаемый объект"
                            },
                            {
                                "target_lang_word": "пуля",
                                "target_lang_sense_clarification": "небольшой боеприпас для стрелкового оружия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75ffb43d-d72c-3508-ba88-5fb3f052b183",
                    "sense_definition": "Any object propelled or thrown through space by the application of a force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In physics class, we calculated the path of a <w>projectile</w> thrown into the air.",
                            "target_lang_translations": {
                                "zh": "在物理课上，我们计算了被抛向空中的<w>抛射体</w>的运动轨迹。",
                                "ru": "На уроке физики мы рассчитывали траекторию <w>брошенного в воздух тела</w>."
                            }
                        },
                        {
                            "text": "A loose roof tile became a dangerous <w>projectile</w> in the strong wind.",
                            "target_lang_translations": {
                                "zh": "一片松动的屋瓦在大风中变成了危险的<w>抛射体</w>。",
                                "ru": "Сорванная ветром черепица превратилась в опасный <w>летящий предмет</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "object"
                    ],
                    "common_phrases": [
                        "projectile motion"
                    ],
                    "target_lang_definitions": {
                        "zh": "指任何受力后在空间中运动的物体。",
                        "ru": "Любой объект, брошенный или летящий в пространстве под действием приложенной силы."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抛射体",
                                "target_lang_sense_clarification": "物理学中指在重力作用下做抛体运动的物体。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "метательный предмет",
                                "target_lang_sense_clarification": "брошенный или запущенный объект"
                            },
                            {
                                "target_lang_word": "брошенное тело",
                                "target_lang_sense_clarification": "в физике, объект в состоянии свободного полёта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1070ab93-b0c7-3dd6-b2c3-b295c2f4f98e",
                    "sense_definition": "Having the ability to impel or push something forward.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "propulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine provides a <w>projectile</w> force to move the vehicle.",
                            "target_lang_translations": {
                                "zh": "发动机提供<w>推进</w>力来驱动车辆。",
                                "ru": "Двигатель создаёт <w>движущую</w> силу для перемещения машины."
                            }
                        },
                        {
                            "text": "Engineers designed a <w>projectile</w> mechanism for the new machine.",
                            "target_lang_translations": {
                                "zh": "工程师为这台新机器设计了一种<w>推进</w>装置。",
                                "ru": "Инженеры разработали <w>метательный</w> механизм для новой установки."
                            }
                        }
                    ],
                    "synonyms": [
                        "propulsive"
                    ],
                    "common_phrases": [
                        "projectile force"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有推动或发射能力的。",
                        "ru": "Способный толкать, метать или приводить что-либо в движение вперёд."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "推进的",
                                "target_lang_sense_clarification": "指提供动力以推动物体前进的。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "метательный",
                                "target_lang_sense_clarification": "служащий для бросания или запуска"
                            },
                            {
                                "target_lang_word": "движущий",
                                "target_lang_sense_clarification": "сообщающий движение вперёд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6b4cd14-e486-37c2-b953-0a6e5aa02547",
                    "sense_definition": "Caused or imparted by an external impulse or projection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "propulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>projectile</w> motion of the ball was determined by the initial kick.",
                            "target_lang_translations": {
                                "zh": "球的<w>抛射</w>运动由最初的那一脚决定。",
                                "ru": "<w>Баллистическая</w> траектория мяча была задана начальным ударом ноги."
                            }
                        },
                        {
                            "text": "Scientists studied the <w>projectile</w> effect on the fluid flow.",
                            "target_lang_translations": {
                                "zh": "科学家研究了<w>抛射</w>效应对流体流动的影响。",
                                "ru": "Учёные исследовали влияние <w>выброса</w> на движение жидкости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "projectile motion"
                    ],
                    "target_lang_definitions": {
                        "zh": "由外部冲力或投射引起的。",
                        "ru": "Вызванный или сообщённый внешним импульсом, броском или выстрелом."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抛射的",
                                "target_lang_sense_clarification": "指与抛射运动或效应相关的。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "баллистический",
                                "target_lang_sense_clarification": "относящийся к движению брошенного тела"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}