                },
                {
                    "sense_id": "5561b377-9d0c-3ca6-b759-90b05b3acbf1",
                    "sense_definition": "Taki, który sprawia radość, jest zabawny, przyjemny lub pełen optymizmu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "happiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Życzę wam wszystkim zdrowych i <w>Wesołych</w> Świąt spędzonych z rodziną.",
