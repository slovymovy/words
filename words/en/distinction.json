            "senses": [
                {
                    "sense_id": "44b940ec-0373-32df-80f4-07eaa9184007",
                    "sense_definition": "A clear difference or separation between two similar things or people.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often difficult to draw a clear <w>distinction</w> between these two concepts.",
                            "target_lang_translations": {
                                "ru": "Часто трудно провести четкое <w>различие</w> между этими двумя понятиями.",
                                "tr": "Bu iki kavram arasında net bir <w>ayrım</w> yapmak genellikle zordur."
                            }
                        },
                        {
                            "text": "The law makes a sharp <w>distinction</w> between accidental and intentional damage.",
                            "target_lang_translations": {
                                "ru": "Закон проводит резкое <w>разграничение</w> между случайным и умышленным ущербом.",
                                "tr": "Kanun, kazara verilen zarar ile kasten verilen zarar arasında kesin bir <w>ayrım</w> yapar."
                            }
                        }
                    ],
                    "synonyms": [
                        "difference",
                        "contrast",
                        "separation"
                    ],
                    "antonyms": [
                        "confusion"
                    ],
                    "common_phrases": [
                        "make a distinction",
                        "draw a distinction",
                        "clear distinction",
                        "sharp distinction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ясная разница или разделение между двумя похожими вещами или людьми.",
                        "tr": "Benzer iki şey veya kişi arasında net bir fark veya ayrım."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "различие",
                                "target_lang_sense_clarification": "разница между объектами или понятиями"
                            },
                            {
                                "target_lang_word": "разграничение",
                                "target_lang_sense_clarification": "процесс проведения границы или разделения"
                            },
                            {
                                "target_lang_word": "разница",
                                "target_lang_sense_clarification": "несходство"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ayrım",
                                "target_lang_sense_clarification": "şeyler veya kavramlar arasındaki sınır ve fark"
                            },
                            {
                                "target_lang_word": "fark",
                                "target_lang_sense_clarification": "benzer şeyleri ayıran özellik"
                            },
                            {
                                "target_lang_word": "farklılık",
                                "target_lang_sense_clarification": "farklı olma durumu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f589512-8351-3607-9d96-7c72be5d5945",
                    "sense_definition": "The quality of being excellent or superior; a special achievement, honor, or rank.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He served the organization with <w>distinction</w> for over thirty years.",
                            "target_lang_translations": {
                                "ru": "Он прослужил в организации с <w>отличием</w> более тридцати лет.",
                                "tr": "Kuruma otuz yıldan fazla bir süre <w>üstün hizmetle</w> katkıda bulundu."
                            }
                        },
                        {
                            "text": "She had the <w>distinction</w> of being the first student to pass the exam with a perfect score.",
                            "target_lang_translations": {
                                "ru": "Она удостоилась <w>чести</w> быть первой студенткой, сдавшей экзамен с идеальным результатом.",
                                "tr": "Sınavı tam puanla geçen ilk öğrenci olma <w>ayrıcalığına</w> sahipti."
                            }
                        }
                    ],
                    "synonyms": [
                        "excellence",
                        "merit",
                        "honor",
                        "eminence"
                    ],
                    "common_phrases": [
                        "with distinction",
                        "mark of distinction",
                        "have the distinction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество превосходства или исключительности; особое достижение, почесть или ранг.",
                        "tr": "Üstünlük veya mükemmellik niteliği; özel bir başarı, onur veya rütbe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отличие",
                                "target_lang_sense_clarification": "знак признания заслуг, награда или высокая оценка"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "üstünlük",
                                "target_lang_sense_clarification": "mükemmellik veya yüksek nitelik"
                            },
                            {
                                "target_lang_word": "seçkinlik",
                                "target_lang_sense_clarification": "saygınlık ve özel başarı durumu"
                            },
                            {
                                "target_lang_word": "ayrıcalık",
                                "target_lang_sense_clarification": "özel bir onur veya itibar"
                            }
                        ]
                    }
                }
