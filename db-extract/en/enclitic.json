                                    {
                                        "sense_id": "e2cc1d0e-4636-32dd-bfa6-7ad65f3e4880",
                                        "entry_id": "fc1e651a-75a4-3614-a93e-0b3fdc31595b",
                                        "glosses": [
                                            "riferito a un elemento linguistico atono che si appoggia per la pronuncia alla parola precedente; nella lingua scritta l'elemento enclitico può apparire unito alla parola ospite o separato"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7940ba-7ef5-47f8-b17c-56129991e232",
                                                "sense_id": "e2cc1d0e-4636-32dd-bfa6-7ad65f3e4880",
                                                "text": "in italiano le particelle enclitiche sono principalmente pronomi come \"me\", \"te\", \"lo\", \"ce\"; possono essere avverbi di luogo come \"ci\" e \"ne\" o avere funzione partitiva come \"ne\""
                                            },
                                            {
                                                "example_id": "87f0e5ba-e964-4880-ba9a-c4701a61840c",
                                                "sense_id": "e2cc1d0e-4636-32dd-bfa6-7ad65f3e4880",
                                                "text": "in italiano l'elemento enclitico appare colla parola ospite: \"vattene\""
                                            },
                                            {
                                                "example_id": "2d4fe692-636f-488f-9a26-0e60086c7eb1",
                                                "sense_id": "e2cc1d0e-4636-32dd-bfa6-7ad65f3e4880",
                                                "text": "«-lo» è una particella enclitica in funzione di complemento oggetto"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enclitico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "b269953e-9c33-3439-843a-32449ea7a3d7",
                                        "entry_id": "4423f162-ff6f-3894-99cc-96ff1cc6575f",
                                        "glosses": [
                                            "elemento enclitico, ossia clitico che segue la parola ospite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb5fa63-3b95-43b1-8df5-3911afd95ff4",
                                                "sense_id": "b269953e-9c33-3439-843a-32449ea7a3d7",
                                                "text": "in italiano gli enclitici si possono comporre tra di loro: per esempio \"gli\" e \"ne\" diventano \"gliene\""
                                            },
                                            {
                                                "example_id": "15cc26a1-5326-4118-850e-5c7ca8ba651f",
                                                "sense_id": "b269953e-9c33-3439-843a-32449ea7a3d7",
                                                "text": "«-lo» è un enclitico in funzione di complemento oggetto"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
