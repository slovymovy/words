                                        "entry_id": "3dcebbf5-e11d-3fe1-ad48-b063d830464e",
                                        "glosses": [
                                            "Historical records; chronicles; history."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
