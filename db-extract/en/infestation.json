    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1855cd8e-e4ce-3167-879b-df614cc805f8",
                "word": "infestation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c68e91a4-e131-4869-8ab2-c9b7b5fe9e57",
                        "entry_id": "1855cd8e-e4ce-3167-879b-df614cc805f8",
                        "tags": [
                            "plural"
                        ],
                        "form": "infestations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "56bea373-fe93-3236-8b2c-0c3dee8cd80f",
                        "entry_id": "1855cd8e-e4ce-3167-879b-df614cc805f8",
                        "glosses": [
                            "The presence of a large number of pest organisms in an area or field, on the surface of a host or anything that might contact a host, or in the soil."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4f19d1be-80c1-4396-b78d-82d0c98438ba",
                                "sense_id": "56bea373-fe93-3236-8b2c-0c3dee8cd80f",
                                "text": "Guatemalan snowpea production has continually been harmed by insect and disease infestations."
                            },
                            {
                                "example_id": "97529afa-6f16-4e88-99a7-2de64e227acd",
                                "sense_id": "56bea373-fe93-3236-8b2c-0c3dee8cd80f",
                                "text": "You've probably heard about Beemageddon. Over the past few years, colony collapse disorder – thought to be brought on by a pernicious combination of overwork, bad weather, pesticides and infestations of parasitic varroa mites – has been threatening to wipe out honeybees all over the world, and with them many of our food crops."
                            },
                            {
                                "example_id": "af00bfc2-7254-43af-8d8a-2e24f4c01df2",
                                "sense_id": "56bea373-fe93-3236-8b2c-0c3dee8cd80f",
                                "text": "A. The exterior of the premises and all structures thereon shall be kept free of all nuisances, unsanitary conditions and fire or safety hazards in the public areas and any of the foregoing shall be removed and abated promptly by the owner or manager.\nB. Without limiting the generality of Subsection A, the maintenance includes: . . . (3) Keeping the premises free of conditions conducive to infestation by vermin or insects, such as rodent harborages or stagnant water, and other known sources of infestation."
                            },
                            {
                                "example_id": "cb290e90-0c23-4471-9b6d-43efeb493aeb",
                                "sense_id": "56bea373-fe93-3236-8b2c-0c3dee8cd80f",
                                "text": "\"We have done some targeted pest control, and it has made a huge difference. It's a serious topic. We looked at why there were so many power trips at Ladbroke Grove. And it was an infestation of birds.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c15a06c1-49ec-4ed6-85b8-0501891e0620",
                        "source_entry_id": "1855cd8e-e4ce-3167-879b-df614cc805f8",
                        "source_sense_id": "56bea373-fe93-3236-8b2c-0c3dee8cd80f",
                        "source_sense_description": "presence of a large number of pest organisms in an area",
                        "target_lang_word": "Befall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7199ce7f-3d85-3a60-a70c-c7d719586032",
                                        "entry_id": "1aaaa0ed-7a21-384f-ae08-d8792ad31bf0",
                                        "glosses": [
                                            "das Auftreten von biologisch aktiven Organismen an Orten, an denen sie unerwünscht sind oder Schaden verursachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16e7252f-c784-4ea4-b366-74e0a8034549",
                                                "sense_id": "7199ce7f-3d85-3a60-a70c-c7d719586032",
                                                "text": "Viele Menschen führen einen Befall mit Kopfläusen auf mangelnde Hygiene zurück und schämen sich. Dabei hat das eine mit dem anderen nichts zu tun!"
                                            },
                                            {
                                                "example_id": "72e3cbab-6bf8-4abd-9b7a-21b4b6225060",
                                                "sense_id": "7199ce7f-3d85-3a60-a70c-c7d719586032",
                                                "text": "„Bei Matjes wird im niederländischen Lebensmittelrecht ein Tiefkühlen bei −45 °C vorgeschrieben, um einen Befall mit Nematoden auszuschließen, die bei dieser Temperatur zuverlässig abgetötet werden.“"
                                            },
                                            {
                                                "example_id": "2665d60f-206f-4302-b23a-eee7cacbdbda",
                                                "sense_id": "7199ce7f-3d85-3a60-a70c-c7d719586032",
                                                "text": "„Das Holz ist bei fortgeschrittenem Befall kreuz und quer von Fraßgängen durchzogen und weist an der Oberfläche kreisrunde Ausfluglöcher von ca. zwei bis drei Millimetern Durchmesser auf.“"
                                            },
                                            {
                                                "example_id": "cfb1e69b-17dc-40d1-9e5c-0d2b6aa00f68",
                                                "sense_id": "7199ce7f-3d85-3a60-a70c-c7d719586032",
                                                "text": "„Aufgrund ihres Alters sowie des Befalles mit der Miniermotte wird derzeit über das Fällen und Ersetzen der Bäume diskutiert.“"
                                            },
                                            {
                                                "example_id": "0805eefd-d0c9-4de9-95ed-d79055382354",
                                                "sense_id": "7199ce7f-3d85-3a60-a70c-c7d719586032",
                                                "text": "\"Wir wissen bereits, dass diese Meeresschnecken natürlicherweise gegen mikrobiellen Befall geschützt sind. Wahrscheinlich produzieren bestimmte Bakterien, die auf ihnen siedeln, einen Stoff mit antibiotischer Wirkung\", so [Till] Schäberle [von der Universität Bonn]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "908b0aa8-413e-3875-b149-df2d6d307351",
                                        "entry_id": "1aaaa0ed-7a21-384f-ae08-d8792ad31bf0",
                                        "glosses": [
                                            "das Eindringen von Schadsoftware in Computersysteme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c3b6b66-2f42-49da-8cb3-706ad7ed3ae6",
                                                "sense_id": "908b0aa8-413e-3875-b149-df2d6d307351",
                                                "text": "„Auch Java-Plugins zu deaktivieren, gar nicht erst zu installieren oder wenigstens aktuell zu halten vermindert die Wahrscheinlichkeit eines Befalls beträchtlich.“"
                                            },
                                            {
                                                "example_id": "e66b9f59-3f71-42b3-b12e-1ec8fce94858",
                                                "sense_id": "908b0aa8-413e-3875-b149-df2d6d307351",
                                                "text": "„Typischerweise tritt dies nach einem Befall durch einen Computervirus oder durch einen gezielten Einbruch durch Hacker (bzw. Cracker) auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
