                "senses": [
                    {
                        "sense_id": "681d3ba9-2556-3e23-a0a7-5c27f34f07f7",
                        "entry_id": "91ab2810-5e1a-3ca8-b604-f4648af4c8c1",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b18ff7-e231-4b0a-b2e3-976cf2c45bce",
                                "sense_id": "681d3ba9-2556-3e23-a0a7-5c27f34f07f7",
                                "text": "Bullinger kommt und geht."
                            },
                            {
                                "example_id": "677efab7-b25b-4852-ad89-5b470b85e267",
                                "sense_id": "681d3ba9-2556-3e23-a0a7-5c27f34f07f7",
                                "text": "Bullingers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "e210dc78-d9b6-487d-b321-6344a96ffb14",
                                "sense_id": "681d3ba9-2556-3e23-a0a7-5c27f34f07f7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bullinger kommt, geht der Herr Bullinger.“"
                            },
                            {
                                "example_id": "d437f146-7b30-4c45-865f-b3454acea580",
                                "sense_id": "681d3ba9-2556-3e23-a0a7-5c27f34f07f7",
                                "text": "Herr Bullinger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7045edd6-bda4-4061-86fa-1995520e3841",
                                "sense_id": "681d3ba9-2556-3e23-a0a7-5c27f34f07f7",
                                "text": "Die Bullingers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "55c7d9db-f0e4-4fe7-aa0f-53df13692723",
                                "sense_id": "681d3ba9-2556-3e23-a0a7-5c27f34f07f7",
                                "text": "Der Bullinger trägt nie die Schals, die die Bullinger ihm strickt."
                            },
                            {
                                "example_id": "fc2e69c5-482e-4e4e-b43b-f5b697def38a",
                                "sense_id": "681d3ba9-2556-3e23-a0a7-5c27f34f07f7",
                                "text": "Frau Bullinger ist ein Genie im Verkauf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
