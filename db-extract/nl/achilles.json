                                    {
                                        "sense_id": "0dc69beb-28f8-3ece-b5ac-d025a5f78694",
                                        "entry_id": "23dad4f5-47f4-3dbf-92c4-cc87c5286caa",
                                        "glosses": [
                                            "in der griechischen Mythologie ein beinahe unverwundbarer Held der Griechen (Achaier) vor Troja"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39d29a6-a134-4e10-bd58-4c30b486ab31",
                                                "sense_id": "0dc69beb-28f8-3ece-b5ac-d025a5f78694",
                                                "text": "Der Held Achilleus war der Sage nach nur an der Ferse verwundbar."
                                            },
                                            {
                                                "example_id": "03c65816-c878-45a4-bba0-bce085f466cb",
                                                "sense_id": "0dc69beb-28f8-3ece-b5ac-d025a5f78694",
                                                "text": "„Singe den Zorn, o Göttin, des Peleiaden Achilleus […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
