                    "sense_id": "ad742c25-37e0-3ac5-b7a1-0b245557938a",
                    "sense_definition": "zniszczyć kruchą rzecz, rozbijając ją na kawałki",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rozbicie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jacek <w>stłukł</w> babci wazon piłką.",
                            "target_lang_translations": {
                                "en": "Jacek <w>broke</w> his grandmother's vase with a ball."
                            }
                        },
                        {
                            "text": "Niechcący <w>stłukłem</w> szklankę w kuchni.",
                            "target_lang_translations": {
                                "en": "I accidentally <w>broke</w> a glass in the kitchen."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozbić",
                        "roztrzaskać",
                        "potłuc",
                        "zbić"
                    ],
                    "common_phrases": [
                        "stłuc szklankę",
                        "stłuc wazon"
                    ],
                    "target_lang_definitions": {
