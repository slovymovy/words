                        ],
                        "form": "die Zitadelle"
                    },
                    {
                        "form_id": "0e5b03eb-81b5-4a22-8349-78b5dfdeb887",
                        "entry_id": "22441565-764c-375e-a490-7e9451a5f9e3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zitadellen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                        "entry_id": "22441565-764c-375e-a490-7e9451a5f9e3",
                        "glosses": [
                            "der innere, am stärksten ausgebaute Teil einer Festung oder eine Festung innerhalb einer befestigten Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a5a5ce1-503c-4529-97df-07288800e8f8",
                                "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                "text": "In der Zitadelle von Roses ist ein großes historisches Museum untergebracht."
                            },
                            {
                                "example_id": "1542b168-779d-45c6-a8bf-a942f8928511",
                                "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                "text": "„Und ohne ein Wort weiter zu sprechen, begann er den Berg emporzusteigen, der sich im Kern der Stadt erhebt und der seit Jahrhunderten eine verwitterte Zitadelle auf seinem Rücken trägt.“"
                            },
                            {
                                "example_id": "5fd5eb85-fa7b-4508-a850-207c9f62306a",
                                "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                "text": "„Ohne das notwendige Koffein radelte ich über die Elisabethbrücke und ließ mich am Fuße des Gellértbergs unterhalb der Zitadelle nieder.“"
                            },
                            {
                                "example_id": "9e6deffe-0be2-407b-a5ed-44cbddf07e61",
                                "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                "text": "„Am Fuße der Zitadelle verputzen drei Männer in blauen Anzügen eine Lehmmauer.“"
                            },
                            {
                                "example_id": "c17ba88d-a0c6-42e2-983e-1ecf03c6a6f2",
                                "sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                                "text": "„Wir gingen in einer schönen Allee bei der Zitadelle spazieren; dort sah ich eine Menge hübscher Mädchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5125dd66-a0a9-4080-8acf-c8456adb7b6c",
                        "source_entry_id": "22441565-764c-375e-a490-7e9451a5f9e3",
                        "source_sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                        "source_sense_description": "der am stärksten ausgebaute Teil einer Festung; eine Festung innerhalb einer befestigten Stadt",
                        "target_lang_word": "citadel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citadel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5167fa15-8b55-3174-946e-88270552210b",
                                        "entry_id": "7ca5354f-b46c-397f-ba07-582e277e792e",
                                        "glosses": [
                                            "A strong fortress that sits high above a city."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8756243c-00dc-47dd-a8b1-988153eba1a3",
                                                "sense_id": "5167fa15-8b55-3174-946e-88270552210b",
                                                "text": "In the city’s midst the gleaming marble of a thousand steps climbed to the citadel where arose four pinnacles beckoning to heaven, and midmost between the pinnacles there stood the dome, vast, as the gods had dreamed it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d981e2-6cf3-301b-85bc-7ab97bc45bf2",
                                        "entry_id": "7ca5354f-b46c-397f-ba07-582e277e792e",
                                        "glosses": [
                                            "A stronghold or fortified place."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19249f5d-b11c-4e99-80cd-95395ccd0915",
                                                "sense_id": "54d981e2-6cf3-301b-85bc-7ab97bc45bf2",
                                                "text": "Intrenched within the citadel of our apartment, and cheered by the comfortings of a coal fire, we passed the day in letter-writing, conversation, or gazing from the sheltered security of our windows upon the agitated sea[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2cc60f9-75c8-3845-9f4c-77467712ddf3",
                                        "entry_id": "7ca5354f-b46c-397f-ba07-582e277e792e",
                                        "glosses": [
                                            "An armoured portion of a warship, housing important equipment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9c5406-188c-4394-b75b-bdfdb4fad6eb",
                                                "sense_id": "f2cc60f9-75c8-3845-9f4c-77467712ddf3",
                                                "text": "Twenty-two of these — eleven per broadside — were on the main deck within a central citadel, essentially an armor-protected box in the middle of the ship. Also within the citadel were four 110-pdr. breech-loaders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a420dfa9-0487-3487-b1a7-ff1100bd54d0",
                                        "entry_id": "7ca5354f-b46c-397f-ba07-582e277e792e",
                                        "glosses": [
                                            "A Salvation Army meeting place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "644a2a86-3146-4fcc-ba78-20e97a0ba061",
                        "source_entry_id": "22441565-764c-375e-a490-7e9451a5f9e3",
                        "source_sense_id": "179f20a9-a2e4-3ff6-b25e-4e1295b4d514",
                        "source_sense_description": "der am stärksten ausgebaute Teil einer Festung; eine Festung innerhalb einer befestigten Stadt",
                        "target_lang_word": "citadelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citadelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1709b30-7ba5-3741-b995-33405ea68c81",
                                        "entry_id": "e62db6ea-5dcc-3fc1-b2b6-dead111beced",
                                        "glosses": [
                                            "Forteresse qui commandait une ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556c136c-00b6-4116-ae8c-74854ea0ef7a",
                                                "sense_id": "a1709b30-7ba5-3741-b995-33405ea68c81",
                                                "text": "La citadelle de Dinant, & la tour de Bouvines furent détruites, par représailles du saccagement & de la destruction de Terouane."
                                            },
                                            {
                                                "example_id": "7cb8fbf1-5e5a-4855-8359-d76a2fffff56",
                                                "sense_id": "a1709b30-7ba5-3741-b995-33405ea68c81",
                                                "text": "— […], j’ai découvert par hasard à deux portées de fusil de l’endroit où nous sommes une espèce de citadelle où nos chevaux seront on ne peut mieux, et dans laquelle, le cas échéant, nous pourrions soutenir un siège en règle."
                                            },
                                            {
                                                "example_id": "43a5cf41-1971-4368-9cf9-c7393cf5830a",
                                                "sense_id": "a1709b30-7ba5-3741-b995-33405ea68c81",
                                                "text": "Le colombophile entendait toujours les mêmes questions. […] Le colombophile (flatté au fond) expliquait qu'ils avaient niché au colombier militaire de la citadelle et qu'ils retournaient là d'instinct."
                                            },
                                            {
                                                "example_id": "189c8603-5269-46c6-83bf-f27f9ec6aea7",
                                                "sense_id": "a1709b30-7ba5-3741-b995-33405ea68c81",
                                                "text": "Après l'encerclement de la citadelle de Sarmizégéthuse, j'entrai à la suite de l'empereur dans la salle souterraine où les conseillers du roi Décébale venaient de s'empoisonner au cours d'un dernier banquet ; je fus chargé par lui de mettre le feu à cet étrange tas d'hommes morts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daca4ec4-d0f4-3805-bfd2-09113b45727d",
                                        "entry_id": "e62db6ea-5dcc-3fc1-b2b6-dead111beced",
                                        "glosses": [
                                            "Tout ce qui semble inexpugnable."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52998889-a1cd-45df-ace9-597039b5a5ec",
                                                "sense_id": "daca4ec4-d0f4-3805-bfd2-09113b45727d",
                                                "text": "Il y passa vingt-trois ans (1541-1564) au milieu de luttes et de conflits incessants, mais il réussit à faire de Genève la forteresse, la citadelle du calvinisme, aux portes de la France, citadelle d'où la propagande protestante, par des milliers de petits livres clandestins, par des dizaines d'ardents prédicateurs, allait se répandre sur toute la France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
