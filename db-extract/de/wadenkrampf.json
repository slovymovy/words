                "senses": [
                    {
                        "sense_id": "6e73c897-a479-31b8-aa7d-7e65533d2b3e",
                        "entry_id": "2a3f1205-5c92-3833-b10f-519de00ddb85",
                        "glosses": [
                            "ungewollte starke Anspannung des Wadenmuskels, die mit großen Schmerzen verbunden sein kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c597a4-ed3b-4708-b498-c695a52044bb",
                                "sense_id": "6e73c897-a479-31b8-aa7d-7e65533d2b3e",
                                "text": "Wegen eines Wadenkrampfs musste er das Rennen abbrechen."
                            },
                            {
                                "example_id": "a8a028eb-e0a6-47fc-8175-887945e70154",
                                "sense_id": "6e73c897-a479-31b8-aa7d-7e65533d2b3e",
                                "text": "„Der Wadenkrampf des österreichischen Teamverteidigers von Eintracht Frankfurt hatte sich eine Viertelstunde vor dem Ende des Spiels gegen die TSG Hoffenheim am vergangenen Sonntag gelöst, der Schütze des Siegtreffers zum 1:0 war wieder schmerzfrei.“"
                            },
                            {
                                "example_id": "95386cdf-b155-4188-a8fd-14fe470cfa4a",
                                "sense_id": "6e73c897-a479-31b8-aa7d-7e65533d2b3e",
                                "text": "„In der Nacht hat mich ein Wadenkrampf hochgeschreckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30c7f9b6-bb00-46d7-bdb4-5c36015a5aa5",
                        "source_entry_id": "2a3f1205-5c92-3833-b10f-519de00ddb85",
                        "source_sense_id": "6e73c897-a479-31b8-aa7d-7e65533d2b3e",
                        "source_sense_description": "Krampf in der Wade",
                        "target_lang_word": "charley horse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charley horse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe84928b-823d-331f-ae88-1e150697f8e0",
                                        "entry_id": "7fc45aee-54e3-3575-852d-e98eea097ca9",
                                        "glosses": [
                                            "A muscle cramp, usually a strong one, in the thigh, leg, arm, or core."
                                        ],
                                        "tags": [
                                            "US",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cee9195c-a854-4513-9151-cb1a127ed80b",
                                                "sense_id": "fe84928b-823d-331f-ae88-1e150697f8e0",
                                                "text": "Of course there had been plenty of bruises—one mild case of charley-horse, several dislocated or sprained fingers, a wrenched ankle or two and any number of cuts and scrapes, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ae4c289-126c-3b1f-bee1-198a81dc1cdb",
                                        "entry_id": "7fc45aee-54e3-3575-852d-e98eea097ca9",
                                        "glosses": [
                                            "A punch in the thigh."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "926d6feb-4ab4-4e96-86fd-3b029ea90ab8",
                                                "sense_id": "4ae4c289-126c-3b1f-bee1-198a81dc1cdb",
                                                "text": "I knew to just keep my mouth shut about it — unless I wanted the word \"dummy\" to be followed by a charley horse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
