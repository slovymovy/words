        "unknowledgeable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "357e0a95-66f4-3cbe-a591-c7d29254bd35",
                    "sense_definition": "Possessing a lot of information and being well-informed through education or experience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a very <w>knowledgeable</w> person who can answer almost any question about history.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>эрудированный</w> человек, который может ответить почти на любой вопрос по истории."
                            }
                        },
                        {
                            "text": "The professor is highly <w>knowledgeable</w> about modern art and has written several books.",
                            "target_lang_translations": {
                                "ru": "Профессор очень <w>сведущ</w> в современном искусстве и написал несколько книг."
                            }
                        }
                    ],
                    "synonyms": [
                        "informed",
                        "educated",
                        "erudite",
                        "learned",
                        "well-informed",
                        "expert"
                    ],
                    "antonyms": [
                        "unknowledgeable"
                    ],
                    "common_phrases": [
                        "highly knowledgeable",
                        "knowledgeable about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий обширными знаниями и хорошей информированностью благодаря образованию или опыту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эрудированный",
                                "target_lang_sense_clarification": "обладающий широкими познаниями"
                            },
                            {
                                "target_lang_word": "образованный",
                                "target_lang_sense_clarification": "имеющий хорошее образование и знания"
                            },
                            {
                                "target_lang_word": "знающий",
                                "target_lang_sense_clarification": "обладающий знаниями в какой-либо области"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47d56c6b-268c-3460-8f8d-7bc0b1e71b0d",
                    "sense_definition": "Having specific knowledge or expertise regarding a particular subject or field.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to hire a <w>knowledgeable</w> staff member to manage our new technical department.",
                            "target_lang_translations": {
                                "ru": "Нам нужно нанять <w>компетентного</w> сотрудника для руководства нашим новым техническим отделом."
                            }
                        },
                        {
                            "text": "The tour guide was extremely <w>knowledgeable</w> regarding the local wildlife and plants.",
                            "target_lang_translations": {
                                "ru": "Экскурсовод был чрезвычайно <w>осведомлён</w> о местной дикой природе и растениях."
                            }
                        }
                    ],
                    "synonyms": [
                        "expert",
                        "well-versed",
                        "proficient"
                    ],
                    "antonyms": [
                        "unknowledgeable"
                    ],
                    "common_phrases": [
                        "knowledgeable staff",
                        "knowledgeable regarding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий конкретными знаниями или экспертными навыками в определенной области или предмете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компетентный",
                                "target_lang_sense_clarification": "обладающий знаниями для решения задач"
                            },
                            {
                                "target_lang_word": "осведомлённый",
                                "target_lang_sense_clarification": "хорошо информированный о чем-либо"
                            },
                            {
                                "target_lang_word": "сведущий",
                                "target_lang_sense_clarification": "хорошо разбирающийся в вопросе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54a7368c-ac32-374f-83b6-232dabdbb410",
                    "sense_definition": "An individual who possesses specific information or is considered an informed party in a situation.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigators sought out the <w>knowledgeables</w> within the company to understand the data breach.",
                            "target_lang_translations": {
                                "ru": "Следователи разыскали <w>осведомлённых лиц</w> внутри компании, чтобы разобраться в утечке данных."
                            }
                        },
                        {
                            "text": "As one of the few <w>knowledgeables</w> on the committee, he was asked to lead the discussion.",
                            "target_lang_translations": {
                                "ru": "Как одного из немногих <w>знатоков</w> в комитете, его попросили возглавить дискуссию."
                            }
                        }
                    ],
                    "synonyms": [
                        "expert",
                        "insider",
                        "authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий специальной информацией или считающийся информированной стороной в ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знаток",
                                "target_lang_sense_clarification": "человек, обладающий глубокими знаниями"
                            },
                            {
                                "target_lang_word": "эксперт",
                                "target_lang_sense_clarification": "специалист в определенной области"
                            },
                            {
                                "target_lang_word": "осведомлённое лицо",
                                "target_lang_sense_clarification": "человек, владеющий информацией"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}