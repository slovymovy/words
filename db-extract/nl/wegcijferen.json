                    {
                        "sense_id": "40ffac17-1a09-3040-87dd-e44e8723cc41",
                        "entry_id": "a6d1852e-1f18-3feb-b1aa-9bc483d26494",
                        "glosses": [
                            "zichzelf wegcijferen: zichzelf op de achtergrond zetten"
