                        "source_entry_id": "34dba837-3a0f-3df7-945b-c68cfeef5aa8",
                        "source_sense_id": "dccfbf15-f86e-3730-bdd6-cdb923a36dce",
                        "source_sense_description": "in a confident manner",
                        "target_lang_word": "confidemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
