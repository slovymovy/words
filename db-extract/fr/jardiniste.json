                    {
                        "sense_id": "41c4ed78-59fc-3aeb-97ec-c82a7dfeb09f",
                        "entry_id": "e0fdbbb2-0c42-33c2-b752-fd4780306358",
                        "glosses": [
                            "Architecte de jardins ; personne qui dessine des jardins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbb71a58-46be-4665-84cf-f7046cae46b4",
                                "sense_id": "41c4ed78-59fc-3aeb-97ec-c82a7dfeb09f",
                                "text": "Des personnages de moindre grandeur y figurent aussi, et l’on sait gré à Perrault d’avoir su par exemple mettre l’admirable Callot à sa juste place, estimer un savant comme Peiresc, un jardiniste comme La Quintinie."
                            },
                            {
                                "example_id": "9693ed7e-883f-419c-9088-a7696f8bf7e5",
                                "sense_id": "41c4ed78-59fc-3aeb-97ec-c82a7dfeb09f",
                                "text": "La maison a été bâtie sur un terrain de 5 hectares. Elle est occupée par une jardiniste et sa sœur. La remise des instruments, une serre chaude et une cour intérieure pour cultiver des plantes d'ornement sont situés au côté nord."
                            }
                        ]
                    },
                    {
                        "sense_id": "9673c3fb-d782-31ee-952e-6f4faeaac280",
                        "entry_id": "e0fdbbb2-0c42-33c2-b752-fd4780306358",
                        "glosses": [
                            "Personne chargée de cultiver, d'entretenir des jardins, pour son compte personnel ou pour quelqu'un d'autre."
                        ],
