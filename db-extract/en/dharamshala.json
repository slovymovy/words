                        "glosses": [
                            "A city in Himachal Pradesh, India."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e8c5bb-7ad5-477a-9d81-f275d956f08a",
                                "sense_id": "14501ae7-4258-3763-8f6f-8bbfca22996b",
                                "text": "The nearest airport from Dharamshala is at Gaggal (13 kms). Jagson Airlines flies thrice a week (via Kullu) from Delhi to Dharamshala. Jagson Airlines has a ticket counter at the airport. From the airport you can hire a taxi to Dharamshala,"
                            },
                            {
                                "example_id": "2ab8d054-eef0-44f3-957d-a34973a723dc",
                                "sense_id": "14501ae7-4258-3763-8f6f-8bbfca22996b",
                                "text": "Ensconced in the beautiful Kangra Valley in Himachal Pradesh, Dharamshala is not just another tourist spot, another hill station."
                            },
                            {
                                "example_id": "40d0f35c-2449-488c-bd12-f05d7c6535aa",
                                "sense_id": "14501ae7-4258-3763-8f6f-8bbfca22996b",
                                "text": "I live in Dharamshala (HP). Till now we have been discussing the northern part of the country, now I want to focus on the Himalayan region especially Dharamshala and the Indo-Tibetan border."
                            }
                        ]
