{
    "word_family": [
        "horrible",
        "horrific",
        "horrify",
        "horrendous",
        "horrid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "946a998d-ceaa-393c-9c25-71b4d28b3132",
                    "sense_definition": "An intense feeling of fear, shock, or disgust.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She watched in <w>horror</w> as the car veered off the road.",
                            "target_lang_translations": {
                                "ru": "Она с <w>ужасом</w> наблюдала, как машина съехала с дороги."
                            }
                        },
                        {
                            "text": "The survivors spoke of the sheer <w>horror</w> they felt during the earthquake.",
                            "target_lang_translations": {
                                "ru": "Выжившие рассказывали о неописуемом <w>ужасе</w>, который они испытали во время землетрясения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sheer horror",
                        "recoil in horror",
                        "look of horror"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное чувство страха, шока или отвращения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужас",
                                "target_lang_sense_clarification": "сильное чувство страха"
                            },
                            {
                                "target_lang_word": "отвращение",
                                "target_lang_sense_clarification": "чувство неприязни"
                            },
                            {
                                "target_lang_word": "омерзение",
                                "target_lang_sense_clarification": "крайнее отвращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dd05c32-4859-310a-9193-8fc798ca6b83",
                    "sense_definition": "A genre of fiction, such as movies or books, intended to scare or startle the audience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not a big fan of <w>horror</w> movies because they give me nightmares.",
                            "target_lang_translations": {
                                "ru": "Я не большой поклонник фильмов <w>ужасов</w>, потому что после них мне снятся кошмары."
                            }
                        },
                        {
                            "text": "He enjoys reading classic <w>horror</w> fiction by authors like H.P. Lovecraft.",
                            "target_lang_translations": {
                                "ru": "Ему нравится читать классический <w>хоррор</w> таких авторов, как Г. Ф. Лавкрафт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "horror movie",
                        "horror film",
                        "horror story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жанр художественных произведений (фильмов или книг), предназначенный для того, чтобы напугать аудиторию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасы",
                                "target_lang_sense_clarification": "жанр кино или литературы"
                            },
                            {
                                "target_lang_word": "хоррор",
                                "target_lang_sense_clarification": "современное название жанра"
                            },
                            {
                                "target_lang_word": "ужастик",
                                "target_lang_sense_clarification": "разговорное название фильма ужасов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90d6cfd0-e58b-38ce-8bcd-8f11a95329d4",
                    "sense_definition": "A very painful or unpleasant experience or object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers witnessed many <w>horrors</w> during the long years of the war.",
                            "target_lang_translations": {
                                "ru": "Солдаты стали свидетелями многих <w>ужасов</w> за долгие годы войны."
                            }
                        },
                        {
                            "text": "The <w>horrors</w> of war are often difficult for civilians to imagine.",
                            "target_lang_translations": {
                                "ru": "<w>Ужасы</w> войны часто трудно представить мирным жителям."
                            }
                        }
                    ],
                    "synonyms": [
                        "nightmare"
                    ],
                    "common_phrases": [
                        "horrors of war"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень болезненный или неприятный опыт или объект."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужас",
                                "target_lang_sense_clarification": "бедственная ситуация"
                            },
                            {
                                "target_lang_word": "кошмар",
                                "target_lang_sense_clarification": "крайне неприятное событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f673c6b-aff7-3cb9-bbf9-c3019beb0b8d",
                    "sense_definition": "A person, especially a child, who is very badly behaved or annoying.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbor's children are little <w>horrors</w> who never stop screaming.",
                            "target_lang_translations": {
                                "ru": "Соседские дети — просто маленькие <w>чудовища</w>, они никогда не перестают кричать."
                            }
                        },
                        {
                            "text": "He was a little <w>horror</w> at school, always getting into trouble with the teachers.",
                            "target_lang_translations": {
                                "ru": "В школе он был сущим <w>наказанием</w>, постоянно попадая в неприятности с учителями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "little horror"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe children"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, особенно ребенок, который ведет себя очень плохо или раздражает."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тихий ужас",
                                "target_lang_sense_clarification": "о несносном человеке"
                            },
                            {
                                "target_lang_word": "чудовище",
                                "target_lang_sense_clarification": "о плохо ведущем себя ребенке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10e670ef-bc45-3959-b8f0-7ec23c9f7e8d",
                    "sense_definition": "A state of extreme nervousness, anxiety, or depression.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the accident, he suffered from the <w>horrors</w> for several weeks.",
                            "target_lang_translations": {
                                "ru": "После аварии он несколько недель страдал от <w>панических атак</w>."
                            }
                        },
                        {
                            "text": "She woke up with the <w>horrors</w>, unable to shake the feeling of dread.",
                            "target_lang_translations": {
                                "ru": "Она проснулась в состоянии <w>дикого страха</w>, не в силах избавиться от чувства тревоги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the horrors"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually used with 'the'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние крайней нервозности, тревоги или депрессии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мандраж",
                                "target_lang_sense_clarification": "состояние сильной нервозности"
                            },
                            {
                                "target_lang_word": "тревожное состояние",
                                "target_lang_sense_clarification": "чувство сильного беспокойства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}