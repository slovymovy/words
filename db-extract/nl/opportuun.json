                                        "sense_id": "6b64b2ee-77b3-3365-a556-e8cc0da22ad5",
                                        "entry_id": "ec9fe88d-a6e0-3096-89b0-48766dd4c71b",
                                        "glosses": [
                                            "Suitable for some particular purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb1d82ce-09b4-4c9e-a10d-98a47b1db9ad",
                                                "sense_id": "6b64b2ee-77b3-3365-a556-e8cc0da22ad5",
                                                "text": "This would be an opportune spot for a picnic."
                                            },
                                            {
                                                "example_id": "42955d5a-fd89-4456-ba4a-eacfbfa028e9",
                                                "sense_id": "6b64b2ee-77b3-3365-a556-e8cc0da22ad5",
                                                "text": "I staggered to an opportune wall and continued to wail from the deepest, hurtingest, sweetest little abandoned place I could imagine. Finally, I dragged my weary body to my seat and finished my conversation with God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6ced37d-68a1-36c9-b147-7a1f18041ef1",
                                        "entry_id": "ec9fe88d-a6e0-3096-89b0-48766dd4c71b",
                                        "glosses": [
                                            "At a convenient or advantageous time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae9e83f8-8874-4021-9d79-f190e40b8208",
                                                "sense_id": "c6ced37d-68a1-36c9-b147-7a1f18041ef1",
                                                "text": "The opportune arrival of the bus cut short the boring conversation."
                                            },
                                            {
                                                "example_id": "7db9053c-3e93-46ea-addb-473995f4b4ce",
                                                "sense_id": "c6ced37d-68a1-36c9-b147-7a1f18041ef1",
                                                "text": "Sam Tyler: Well, our first priority is to make sure the thieves don't strike again. It'll be tricky, 'cause these sorts of gangs rarely have just one target on the go. They've usually researched half a dozen possibilities, waiting for the most opportune circumstances on any of them.\nHarry Woolf: He knows his onions, this lad, eh?\nGene Hunt: Oh, he's a right little smart-arse. So, what do you suggest, Buddha?"
                                            }
                                        ]
                                    }
                                ]
