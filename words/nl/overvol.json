                    "frequency": "Middle",
                    "semantic_group_id": "volheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stad is tijdens het festival <w>overvol</w> met toeristen.",
                            "target_lang_translations": {
                                "en": "The city is <w>overcrowded</w> with tourists during the festival."
                            }
                        },
                        {
                            "text": "Door de <w>overvolle</w> wegen kwamen we veel te laat aan.",
                            "target_lang_translations": {
                                "en": "Because of the <w>congested</w> roads, we arrived much too late."
                            }
