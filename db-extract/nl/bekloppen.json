                        "glosses": [
                            "iets of iemand zo hard slaan dat er geluid ontstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8aba0d8f-a243-4ef9-8f5a-6286046310e8",
                                "sense_id": "fec4925f-7dc1-327b-a5c5-77cee09a7d85",
                                "text": "Het zijn de handen waar ik naar blijf kijken. Een oude dame in stofjas hangt met chirurgische precisie een vloerkleed over haar balkonhekje om te luchten. Tikkie naar links, stukje naar rechts, zacht het ruwe materiaal bekloppend."
                            },
                            {
                                "example_id": "d9204c4e-2608-4a1f-b0a5-f471f293d19d",
                                "sense_id": "fec4925f-7dc1-327b-a5c5-77cee09a7d85",
                                "text": "Staand in het Raadscafé van 't Oale Roadhoes bekloppen de aanwezige mantelzorgers hun lichaam. Deze ontspanningsoefening dient als inleiding voor de bijeenkomst die Steunpunt Mantelzorg Tubbergen deze woensdagmiddag organiseert voor mantelzorgers uit de gemeente Tubbergen."
                            }
                        ]
                    }
