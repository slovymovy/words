                    {
                        "translation_id": "f789caec-1472-4bf8-a09f-4d5225e04ce0",
                        "source_entry_id": "5d76182b-5222-3a1f-b006-7047fbf8547c",
                        "source_sense_id": "86b1be69-8d42-36c7-b5b7-949065daa7a7",
                        "source_sense_description": "een taal die in Abchazië gesproken wordt",
                        "target_lang_word": "Abchasisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abchasisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5961f76f-8077-36f9-97ba-a08e344d3a3f",
                                        "entry_id": "25e887ab-9494-323b-a7cb-321e8ac226af",
                                        "glosses": [
                                            "in Georgien und in der Türkei gesprochene Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "950aa571-0416-4159-8627-501dcdd24a2c",
                                                "sense_id": "5961f76f-8077-36f9-97ba-a08e344d3a3f",
                                                "text": "„Abchasisch ist erst seit einem Jahrhundert eine Schriftsprache.“"
                                            },
                                            {
                                                "example_id": "237d9575-2227-449a-acb9-f79d8cb4aee4",
                                                "sense_id": "5961f76f-8077-36f9-97ba-a08e344d3a3f",
                                                "text": "„Abchasisch und Georgisch unterscheiden sich grundsätzlich voneinander, nicht nur was die Sprachfamilie (nord- bzw. südkaukasisch), sondern auch was das Alphabet betrifft.“"
                                            },
                                            {
                                                "example_id": "74000712-6197-4b76-b4e5-f1556a07d629",
                                                "sense_id": "5961f76f-8077-36f9-97ba-a08e344d3a3f",
                                                "text": "„›Trotz der‹ – er stieß ein eigenartig zischendes Pfeifen aus – ›etwas verwirrenden abchasischen Dialekte handelt es sich zusammen mit dem Abchasischen, Adygeischen und Karbadisch-Tscherkessischen sowie dem Ubychischen, das fast ausgestorben ist und das man nur noch bei einigen Sprechern in Anatolien findet, um eine einzige Sprache mit ausgeprägten Dialektvarianten‹.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
