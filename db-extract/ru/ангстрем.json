                                "target_senses": [
                                    {
                                        "sense_id": "b0e6f35d-bd67-327b-8beb-0c4a33c3b4d2",
                                        "entry_id": "ff2c59bb-2615-3dec-ad7d-b06ebc7cc5d9",
                                        "glosses": [
                                            "lengtemaat met een waarde van 10⁻¹⁰ m, dus 0,1 nanometer of 100 picometer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47210725-c938-4519-8c4b-b3f29d44087d",
                                                "sense_id": "b0e6f35d-bd67-327b-8beb-0c4a33c3b4d2",
                                                "text": "Röntgenstralen zijn niet met het oog waarneembaar. Ter vergelijking: zichtbaar licht, eveneens uit elektromagnetische golven bestaand, heeft een golflengte van 350 tot 800 nanometer, ofwel 3500 tot 8000 ångström. In de radiodiagnostiek wordt gebruik gemaakt van röntgenstralen met een golflengte van 0,008 tot 0,05 nm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a863c673-c8ee-48c2-a7f4-12b6c41b66ff",
                        "source_entry_id": "3fe4a236-848b-3e2b-8a73-af5db8f512f1",
