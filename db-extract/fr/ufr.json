                                                "example_id": "9625ed16-2ccd-449f-ba4a-2eb84d5cbf55",
                                                "sense_id": "da811899-54f6-39ea-b164-9a80606e3458",
                                                "text": "Informatik ist mein Fachbereich."
                                            },
                                            {
                                                "example_id": "00692e05-d383-4e34-8d1c-7836c26254fd",
                                                "sense_id": "da811899-54f6-39ea-b164-9a80606e3458",
                                                "text": "„Gerade jetzt, in Zeiten knapper Kassen, sähe mancher Professor das Geld, das aus den Fachbereichen in die Studienreformprojekte fließt, lieber im Budget für seine Arbeit, die sich häufig auf ein disziplinäres Kernthema beschränkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6fe8f17-fcf4-3bd5-ab8f-a53557efe610",
                                        "entry_id": "8946c1cc-2247-3cac-b013-e36f7f94f869",
                                        "glosses": [
                                            "eine Organisationseinheit an (Hoch-)Schulen mit eng zusammengehörenden Wissenschaftsgebieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "060a2526-7cef-41da-a1ce-ff6b54b03e26",
                                                "sense_id": "e6fe8f17-fcf4-3bd5-ab8f-a53557efe610",
                                                "text": "„Er maturierte am Technologischen Gewerbemuseum (TGM) im Fachbereich Schweißtechnik und studierte 1959 bis 1964 an der Hochschule für Musik und darstellende Kunst in Wien bei Alfred Jerger.“"
                                            },
                                            {
                                                "example_id": "1d68ec7b-7a1f-4139-b403-299e27260351",
                                                "sense_id": "e6fe8f17-fcf4-3bd5-ab8f-a53557efe610",
                                                "text": "Im Fachbereich Elektrotechnik studieren 500 Studenten."
                                            },
                                            {
                                                "example_id": "fa041c53-d376-40f4-9561-65df63cf4576",
                                                "sense_id": "e6fe8f17-fcf4-3bd5-ab8f-a53557efe610",
                                                "text": "„Während des Chemiestudiums wandte Tom seine umfangreichen EDV-Kenntnisse auch im Fachbereich der Uni an, indem er die dortige EDV als Administrator auf dem neuesten Stand hielt, soweit das den Vorschriften entsprechend möglich war.“"
                                            }
