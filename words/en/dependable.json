    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f514e226-f0c1-3af0-84e0-481f051775d9",
                    "sense_definition": "Capable of being trusted or relied upon; trustworthy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>dependable</w> friend who is always there when you need help.",
                            "target_lang_translations": {
                                "tr": "O, yardıma ihtiyacın olduğunda her zaman yanında olan <w>güvenilir</w> bir arkadaştır."
                            }
                        },
                        {
                            "text": "He proved to be a <w>dependable</w> worker by always finishing his projects on time.",
                            "target_lang_translations": {
                                "tr": "Projelerini her zaman zamanında bitirerek <w>güvenilir</w> bir çalışan olduğunu kanıtladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "reliable",
                        "trustworthy",
                        "steadfast"
                    ],
                    "antonyms": [
                        "undependable",
                        "unreliable"
                    ],
                    "common_phrases": [
                        "dependable worker",
                        "dependable friend"
                    ],
                    "target_lang_definitions": {
                        "tr": "Güven duyulabilecek veya sırt dayanabilecek nitelikte olan; güvenilir."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "güvenilir",
                                "target_lang_sense_clarification": "her zaman güven duyulabilen"
                            },
                            {
                                "target_lang_word": "itimat edilir",
                                "target_lang_sense_clarification": "resmi veya resmi olmayan durumlarda güvenilen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35f565c0-a35d-37ef-be2b-8a3dc985b656",
                    "sense_definition": "A person or thing that is consistently reliable or trustworthy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach relies on his old <w>dependables</w> to win the final game.",
                            "target_lang_translations": {
                                "tr": "Koç, final maçını kazanmak için eski <w>güvenilir oyuncularına</w> güveniyor."
                            }
                        },
                        {
                            "text": "This car has been one of my true <w>dependables</w> for over ten years.",
                            "target_lang_translations": {
                                "tr": "Bu araba, on yılı aşkın süredir en <w>güvenilir araçlarımdan</w> biri oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "mainstay"
                    ],
                    "common_phrases": [
                        "old dependables"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sürekli olarak güvenilen ve bel bağlanan kişi veya şey."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "güvenilir kişi",
                                "target_lang_sense_clarification": "insanlar için"
                            },
                            {
                                "target_lang_word": "demirbaş",
                                "target_lang_sense_clarification": "her zaman bel bağlanan şey veya kişi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
