                "forms": [],
                "senses": [
                    {
                        "sense_id": "d0e385c6-f821-31cd-b22c-7b845e53b6aa",
                        "entry_id": "85cc6e4c-81e6-331e-b803-a56284ed0098",
                        "glosses": [
                            "de neiging om op een tamelijk goedaardige manier iemand belachelijk te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac7a260-a04d-4b01-b310-b27f62ae6354",
                                "sense_id": "d0e385c6-f821-31cd-b22c-7b845e53b6aa",
                                "text": "Bovendien was iedereen die hem vroeger had gekend van mening dat hij in de laatste vijf jaar zeer in zijn voordeel veranderd was, dat hij zachtaardiger en mannelijker was geworden, dat hij nu die onechtheid, trots en spotzucht van vroeger miste, en dat hij de rust over zich had gekregen die met de jaren komt."
                            },
                            {
                                "example_id": "ae6e3d91-41a2-4873-b226-d57769a4da27",
                                "sense_id": "d0e385c6-f821-31cd-b22c-7b845e53b6aa",
                                "text": "Een goede psycholoog kan helpen, echt, zeggen vrienden. Maar ik zie er niks in, hulpverleners maken in mij de spotzucht los. Stap daar toch eens overheen, snauwde iemand. Die arrogantie ook."
                            }
                        ]
                    }
