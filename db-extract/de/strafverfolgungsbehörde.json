                    {
                        "sense_id": "d09a2a33-e328-33aa-87b6-86e99588fae0",
                        "entry_id": "8b1d56ab-89e6-3b3b-933c-be810196b22a",
                        "glosses": [
                            "Behörde, deren Aufgabe es ist, Straftaten zu verfolgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa2f1dd3-6d27-46c2-9c18-b41fece78172",
                                "sense_id": "d09a2a33-e328-33aa-87b6-86e99588fae0",
                                "text": "„Es gibt Schätzungen, wonach den deutschen Strafverfolgungsbehörden neun von zehn Straftaten im muslimischen Milieu verborgen bleiben.“"
                            },
                            {
                                "example_id": "2a0760b7-4c95-4d99-9a8a-cfa6e11905c7",
                                "sense_id": "d09a2a33-e328-33aa-87b6-86e99588fae0",
                                "text": "„Damals hatten die Strafverfolgungsbehörden mehr als 200 Domains der Schattenbibliothek beschlagnahmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
