                                "target_senses": [
                                    {
                                        "sense_id": "6d4776e6-e71c-3dbf-81bc-2bbb966bfeec",
                                        "entry_id": "7608b216-25d0-313f-8a0d-ebdf2a2cc797",
                                        "glosses": [
                                            "The domain of a baron or baroness, usually as part of a larger kingdom or empire.",
                                            "Synonym of hundred, an English administrative division originally reckoned as comprising 100 hides and in various numbers composing counties."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f70c8f47-8b0f-47b6-9b06-584d045fa5c5",
                                                "sense_id": "6d4776e6-e71c-3dbf-81bc-2bbb966bfeec",
                                                "text": "In Ireland... an head constable for each barony or hundred, being 252."
                                            },
                                            {
                                                "example_id": "691a04bd-3369-42e6-87d6-5c3efd521781",
                                                "sense_id": "6d4776e6-e71c-3dbf-81bc-2bbb966bfeec",
                                                "text": "The Baronies appear to have been formed successively on the submission of the Irish chiefs... the territory of each constituting a barony."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c596c80-ac11-3440-a473-9e2c65a4bfbc",
                                        "entry_id": "7608b216-25d0-313f-8a0d-ebdf2a2cc797",
                                        "glosses": [
                                            "The domain of a baron or baroness, usually as part of a larger kingdom or empire.",
                                            "Any large manor or estate, regardless of its owner's rank."
                                        ],
                                        "tags": [
