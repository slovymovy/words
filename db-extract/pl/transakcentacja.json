                                        "examples": [
                                            {
                                                "example_id": "834eb4d2-561e-4be8-95ae-62da2ed4b563",
                                                "sense_id": "1000eb61-1fd8-3909-ae32-11c16781c162",
                                                "text": "„Akzentverschiebung bewirkt, dass nicht zwei betonte Silben unmittelbar aufeinander folgen; sie vermeidet einen Akzentzusammenstoß. Als englisches Beispiel wird gegeben: ‚fourtéen‘ → ‚fóurteen‘ in ‚fóurteen póund‘.“"
                                            },
                                            {
                                                "example_id": "b18dee20-1497-4408-bd10-f1acf00e2911",
                                                "sense_id": "1000eb61-1fd8-3909-ae32-11c16781c162",
                                                "text": "„Kommt es in Komposita zum Akzentzusammenstoß, d. h., folgen die Akzentsilben zweier Konstituenten unmittelbar aufeinander, so besteht die Tendenz zu einer Akzentverschiebung, weil zwei Akzente nacheinander den Sprechfluss beeinträchtigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
