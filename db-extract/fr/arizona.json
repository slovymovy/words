                                                "sense_id": "d0a62c0c-ee50-3d87-8cea-558e09f878c4",
                                                "text": "Wer Arizona besucht, fährt meist auch in den Grand-Canyon-Nationalpark."
                                            },
                                            {
                                                "example_id": "342ca4b3-faba-4885-8d85-76abe661651d",
                                                "sense_id": "d0a62c0c-ee50-3d87-8cea-558e09f878c4",
                                                "text": "Wenn du das Arizona der Navajos suchst, musst du dich abseits der Touristenströme bewegen."
                                            }
