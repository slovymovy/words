                        "target_lang_word": "zunehmend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zunehmend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e57bfa54-512b-3a1b-8aba-e152b7540143",
                                        "entry_id": "b6989dca-3911-3d78-a7c0-06460d4f5c59",
                                        "glosses": [
                                            "mehr in Zahl, Menge oder Häufigkeit werdend, sich vergrößernd, ansteigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05a6e16d-0377-46bc-a797-f69a9dc3af53",
                                                "sense_id": "e57bfa54-512b-3a1b-8aba-e152b7540143",
                                                "text": "Kapitalanlagen in fossile Energie stellen […] ein zunehmendes Risiko für Investoren dar."
                                            },
                                            {
                                                "example_id": "033a7071-5eca-4df0-b916-47a45bbd8bf1",
                                                "sense_id": "e57bfa54-512b-3a1b-8aba-e152b7540143",
                                                "text": "Auch in der Schweiz gibt es eine zunehmende Nachfrage nach ExpertInnen [sic]."
                                            },
                                            {
                                                "example_id": "dc0e78c5-6038-4b69-b065-396f7b008f19",
                                                "sense_id": "e57bfa54-512b-3a1b-8aba-e152b7540143",
                                                "text": "Riesige Investionen für sportliche Großveranstaltungen, wie Olympische Spiele, stoßen auf zunehmendes Unverständnis in der Bevölkerung- wie man am Hamburger Referendum erkennen konnte.",
                                                "translation": "Adverb:"
                                            },
                                            {
                                                "example_id": "e4356390-5577-4f24-b314-b7010609fb6b",
                                                "sense_id": "e57bfa54-512b-3a1b-8aba-e152b7540143",
                                                "text": "Am Triathlon nehmen zunehmend auch Frauen teil."
                                            },
                                            {
                                                "example_id": "b6f07e2f-f2d0-46cb-a2f3-2d327096e8bf",
                                                "sense_id": "e57bfa54-512b-3a1b-8aba-e152b7540143",
                                                "text": "Obwohl sie ins Krankenhaus kam, verschlechterte sich ihr Zustand zunehmend."
                                            },
                                            {
                                                "example_id": "da315408-3536-40ae-b490-0c411b1143d9",
                                                "sense_id": "e57bfa54-512b-3a1b-8aba-e152b7540143",
                                                "text": "[EZB-Chef] Super Mario [Draghi] hat zugeschlagen und mit einem ganzen Bündel von Maßnahmen den Geldhahn in der Eurozone weiter aufgedreht. Allerdings stößt er zunehmend auf Unverständnis."
                                            },
                                            {
                                                "example_id": "eab0722c-9545-472f-94bf-d50d0d7fb409",
                                                "sense_id": "e57bfa54-512b-3a1b-8aba-e152b7540143",
                                                "text": "Unternehmen entdecken zunehmend den Reiz von Wikipedia - und wollen dort in möglichst positivem Licht erscheinen."
                                            },
                                            {
                                                "example_id": "82e40bf6-3884-4754-8007-10d1729c953f",
                                                "sense_id": "e57bfa54-512b-3a1b-8aba-e152b7540143",
                                                "text": "Atomkraft verliert weltweit an Bedeutung und wird zunehmend unrentabel, sagt Atomexperte Mycle Schneider, Träger des alternativen Nobelpreises."
                                            },
                                            {
                                                "example_id": "f88c0b61-7cd1-46e0-a2bf-7b4bd063b6e2",
                                                "sense_id": "e57bfa54-512b-3a1b-8aba-e152b7540143",
                                                "text": "Zunehmend engagieren sich auch Migranten ehrenamtlich - nicht nur für andere Migranten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
