                "senses": [
                    {
                        "sense_id": "63bfacc2-a18d-3901-83af-98fcab6a0726",
                        "entry_id": "a642c48c-d9e6-39d9-aa85-a3aa38687bf9",
                        "glosses": [
                            "sexuelle Begierde gegenüber der eigenen Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa76b136-1728-4be8-a222-dc44511b71bf",
                                "sense_id": "63bfacc2-a18d-3901-83af-98fcab6a0726",
                                "text": "„Bevor die Libido vom Ich zu den Objekten geschickt wird, ist sie zuerst ganz beim Ich und wird hier Ichlibido genannt.“"
                            },
                            {
                                "example_id": "4d1043fc-d290-4365-8a78-df20d57c808e",
                                "sense_id": "63bfacc2-a18d-3901-83af-98fcab6a0726",
                                "text": "„Mit dieser Umsetzung in Ichlibido ist natürlich ein Aufgeben der Sexualziele, eine Desexualisierung, verbunden.“"
                            },
                            {
                                "example_id": "29d3d554-6fdf-47b9-ab52-a516a8db5b34",
                                "sense_id": "63bfacc2-a18d-3901-83af-98fcab6a0726",
                                "text": "„Die narzisstische Akkumulierung der Ichlibido führt zum Abbau der Objektlibido, das heißt der Libido, die das Objekt besetzt.“"
                            },
                            {
                                "example_id": "be20c136-1a96-4bdf-8039-063b71da75eb",
                                "sense_id": "63bfacc2-a18d-3901-83af-98fcab6a0726",
                                "text": "„Dem analytischen Studium bequem zugänglich wird diese Ichlibido aber nur, wenn sie die psychische Verwendung zur Besetzung von Sexualobjekten gefunden hat, also zur Objektlibido geworden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
