                        ],
                        "examples": [
                            {
                                "example_id": "b4e1ce57-2bdb-406b-99fc-954c2baa5f5e",
                                "sense_id": "5dd5ddc6-0f1a-33df-8455-7c503b61024c",
                                "text": "Grâce au conditionnement des cargaisons, leurs rotations peuvent s’effectuer rapidement sans période de stock tampon en libérant ainsi, des espaces de stockage."
                            }
                        ]
                    }
