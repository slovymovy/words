    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ecf3d77e-40f9-3ae1-aa33-7d5cf8ef8693",
                    "sense_definition": "The hard outer covering that protects certain animals, such as snails, oysters, turtles, and crabs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked along the beach looking for a pretty <w>shell</w> to take home.",
                            "target_lang_translations": {
                                "ru": "Мы гуляли по пляжу в поисках красивой <w>ракушки</w>, чтобы забрать её домой.",
                                "zh": "我们沿着海滩走，寻找漂亮的<w>贝壳</w>带回家。"
                            }
                        },
                        {
                            "text": "The turtle pulled its head back into its <w>shell</w> when it saw the dog.",
                            "target_lang_translations": {
                                "ru": "Черепаха втянула голову в <w>панцирь</w>, когда увидела собаку.",
                                "zh": "乌龟看到狗时，把头缩回了<w>壳</w>里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sea shell",
                        "snail shell",
                        "turtle shell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердое внешнее покрытие, защищающее определенных животных, таких как улитки, устрицы, черепахи и крабы.",
                        "zh": "某些动物（如蜗牛、牡蛎、海龟和螃蟹）身上坚硬的保护性外壳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раковина",
                                "target_lang_sense_clarification": "моллюска"
                            },
                            {
                                "target_lang_word": "панцирь",
                                "target_lang_sense_clarification": "черепахи, краба"
                            },
                            {
                                "target_lang_word": "ракушка",
                                "target_lang_sense_clarification": "найденная на пляже"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贝壳",
                                "target_lang_sense_clarification": "指海滩上常见的软体动物外壳"
                            },
                            {
                                "target_lang_word": "甲壳",
                                "target_lang_sense_clarification": "指螃蟹或甲壳类动物的硬壳"
                            },
                            {
                                "target_lang_word": "壳",
                                "target_lang_sense_clarification": "指乌龟等动物的背甲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ffdf79f-b4fc-3cfc-8f5a-5dc2c22bb790",
                    "sense_definition": "The hard outer layer of an egg, nut, or seed that protects what is inside.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to get any pieces of <w>shell</w> in the cake batter.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, чтобы кусочки <w>скорлупы</w> не попали в тесто для торта.",
                                "zh": "小心别让<w>蛋壳</w>碎片掉进蛋糕糊里。"
                            }
                        },
                        {
                            "text": "He cracked the walnut <w>shell</w> to get to the meat inside.",
                            "target_lang_translations": {
                                "ru": "Он расколол <w>скорлупу</w> грецкого ореха, чтобы добраться до ядра внутри.",
                                "zh": "他敲开了核桃<w>壳</w>，取出里面的果肉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "egg shell",
                        "nut shell",
                        "peanut shell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый внешний слой яйца, ореха или семени, защищающий содержимое.",
                        "zh": "蛋、坚果或种子外层坚硬的保护层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скорлупа",
                                "target_lang_sense_clarification": "яйца, ореха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "壳",
                                "target_lang_sense_clarification": "通用的外壳称呼"
                            },
                            {
                                "target_lang_word": "蛋壳",
                                "target_lang_sense_clarification": "特指蛋的外壳"
                            },
                            {
                                "target_lang_word": "果壳",
                                "target_lang_sense_clarification": "特指坚果的外壳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e656b56e-b8e6-3514-a9be-f02d3a965c68",
                    "sense_definition": "A metal container filled with explosives that is fired from a large gun.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers took cover when an artillery <w>shell</w> exploded nearby.",
                            "target_lang_translations": {
                                "ru": "Солдаты укрылись, когда рядом разорвался артиллерийский <w>снаряд</w>.",
                                "zh": "当一枚<w>炮弹</w>在附近爆炸时，士兵们迅速寻找掩体。"
                            }
                        },
                        {
                            "text": "They found an old unexploded <w>shell</w> buried in the field.",
                            "target_lang_translations": {
                                "ru": "Они нашли старый неразорвавшийся <w>снаряд</w>, зарытый в поле.",
                                "zh": "他们在田里发现了一枚埋藏已久的未爆<w>炮弹</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "artillery shell",
                        "mortar shell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлический контейнер, наполненный взрывчаткой, которым стреляют из большого орудия.",
                        "zh": "一种装有炸药的金属容器，由大型火炮发射。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снаряд",
                                "target_lang_sense_clarification": "артиллерийский"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炮弹",
                                "target_lang_sense_clarification": "火炮发射的弹药"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22f98853-14cf-3e46-9f95-98c6cceac610",
                    "sense_definition": "A state of being shy, withdrawn, or avoiding social interaction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took a long time for him to come out of his <w>shell</w> and make friends.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось много времени, чтобы выбраться из своей <w>скорлупы</w> и завести друзей.",
                                "zh": "他花了很长时间才走出自己的<w>壳</w>，开始结交朋友。"
                            }
                        },
                        {
                            "text": "She retreated into her <w>shell</w> after being criticized by the teacher.",
                            "target_lang_translations": {
                                "ru": "Она замкнулась в своей <w>скорлупе</w> после критики учителя.",
                                "zh": "被老师批评后，她又缩回了自己的<w>壳</w>里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "come out of one's shell",
                        "retreat into one's shell"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in idioms describing personality"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние застенчивости, замкнутости или избегания социального взаимодействия.",
                        "zh": "指人害羞、退缩或回避社交的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скорлупа",
                                "target_lang_sense_clarification": "перен. замкнутость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "壳",
                                "target_lang_sense_clarification": "比喻封闭自我的心理状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb830636-8fe0-361e-a618-88f2b0314398",
                    "sense_definition": "The walls and outer structure of a building, vehicle, or object that is unfinished, empty, or destroyed inside.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fire destroyed the interior, leaving only the hollow <w>shell</w> of the house.",
                            "target_lang_translations": {
                                "ru": "Огонь уничтожил интерьер, оставив только пустой <w>остов</w> дома.",
                                "zh": "大火烧毁了内部，只剩下房子的<w>空壳</w>。"
                            }
                        },
                        {
                            "text": "Investors bought the <w>shell</w> of the old factory to convert it into apartments.",
                            "target_lang_translations": {
                                "ru": "Инвесторы купили <w>каркас</w> старой фабрики, чтобы переделать его в квартиры.",
                                "zh": "投资者买下了旧工厂的<w>骨架</w>，打算将其改建成公寓。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hollow shell",
                        "empty shell",
                        "burnt-out shell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стены и внешняя структура здания, транспортного средства или объекта, который не закончен, пуст или разрушен внутри.",
                        "zh": "建筑物、车辆或物体内部空置、未完工或被毁坏后的外墙及结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остов",
                                "target_lang_sense_clarification": "разрушенного здания, машины"
                            },
                            {
                                "target_lang_word": "каркас",
                                "target_lang_sense_clarification": "несущая конструкция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骨架",
                                "target_lang_sense_clarification": "指建筑或物体的支撑结构"
                            },
                            {
                                "target_lang_word": "空壳",
                                "target_lang_sense_clarification": "指内部被掏空或毁坏后的外形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4a7847e-cd43-333a-b538-e15e1bec0f24",
                    "sense_definition": "A computer program that accepts commands from a user and passes them to the operating system to be executed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can write a script in the <w>shell</w> to automate these tasks.",
                            "target_lang_translations": {
                                "ru": "Вы можете написать скрипт в <w>оболочке</w>, чтобы автоматизировать эти задачи.",
                                "zh": "你可以在<w>壳</w>中编写脚本来自动执行这些任务。"
                            }
                        },
                        {
                            "text": "The system administrator used the command <w>shell</w> to fix the server issue.",
                            "target_lang_translations": {
                                "ru": "Системный администратор использовал командную <w>оболочку</w>, чтобы устранить проблему с сервером.",
                                "zh": "系统管理员使用命令行<w>壳</w>修复了服务器问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "command shell",
                        "shell script"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерная программа, которая принимает команды от пользователя и передает их операционной системе для выполнения.",
                        "zh": "一种接收用户命令并将其传递给操作系统执行的计算机程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оболочка",
                                "target_lang_sense_clarification": "командная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "壳",
                                "target_lang_sense_clarification": "计算机术语，指命令解释器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3eed1a1a-153b-3b05-898b-3c114532d5cb",
                    "sense_definition": "A grouping of electrons surrounding the nucleus of an atom.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elements in the same column of the periodic table often have the same number of electrons in their outer <w>shell</w>.",
                            "target_lang_translations": {
                                "ru": "Элементы в одном столбце периодической таблицы часто имеют одинаковое количество электронов на внешней <w>оболочке</w>.",
                                "zh": "元素周期表中同一列的元素，其外层<w>电子层</w>上的电子数通常相同。"
                            }
                        },
                        {
                            "text": "Chemical bonding is determined by the electrons in the valence <w>shell</w>.",
                            "target_lang_translations": {
                                "ru": "Химическая связь определяется электронами на валентной <w>оболочке</w>.",
                                "zh": "化学键由价<w>电子层</w>上的电子决定。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "electron shell",
                        "valence shell"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группировка электронов, окружающих ядро атома.",
                        "zh": "原子核外电子的分布层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оболочка",
                                "target_lang_sense_clarification": "электронная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电子层",
                                "target_lang_sense_clarification": "科学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc394b6a-bbe4-359f-bb9f-c461a801da56",
                    "sense_definition": "A company that exists legally on paper but has no active operations or significant assets.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The money was transferred through a <w>shell</w> company to hide its origin.",
                            "target_lang_translations": {
                                "ru": "Деньги были переведены через <w>подставную компанию</w>, чтобы скрыть их происхождение.",
                                "zh": "资金通过一家<w>空壳公司</w>转移，以掩盖其来源。"
                            }
                        },
                        {
                            "text": "They set up a <w>shell</w> corporation to acquire the assets anonymously.",
                            "target_lang_translations": {
                                "ru": "Они создали <w>фирму-однодневку</w>, чтобы анонимно приобрести активы.",
                                "zh": "他们成立了一家<w>空壳公司</w>来匿名收购资产。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shell company",
                        "shell corporation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компания, которая существует юридически на бумаге, но не ведет активной деятельности и не имеет значительных активов.",
                        "zh": "在法律上存在但没有实际业务或重大资产的公司。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подставная компания",
                                "target_lang_sense_clarification": "фиктивная фирма"
                            },
                            {
                                "target_lang_word": "фирма-однодневка",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空壳公司",
                                "target_lang_sense_clarification": "商业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b62c80a5-846a-3a26-8c26-4599f34af409",
                    "sense_definition": "A sleeveless shirt or blouse, usually worn by women.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a simple white <w>shell</w> under her business suit.",
                            "target_lang_translations": {
                                "ru": "Она надела простой белый <w>топ</w> под деловой костюм.",
                                "zh": "她在西装里穿了一件简单的白色<w>无袖衫</w>。"
                            }
                        },
                        {
                            "text": "In the summer, a light cotton <w>shell</w> is very comfortable.",
                            "target_lang_translations": {
                                "ru": "Летом легкая хлопковая <w>блузка без рукавов</w> очень удобна.",
                                "zh": "夏天穿一件轻便的棉质<w>无袖衫</w>非常舒服。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рубашка или блузка без рукавов, которую обычно носят женщины.",
                        "zh": "一种无袖衬衫或女式上衣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топ",
                                "target_lang_sense_clarification": "без рукавов"
                            },
                            {
                                "target_lang_word": "блузка без рукавов",
                                "target_lang_sense_clarification": "одежда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无袖衫",
                                "target_lang_sense_clarification": "服装类型"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f23c8096-0386-36ed-8e99-7911a5afa2c8",
                    "sense_definition": "To attack a place by firing explosive projectiles from large guns.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy forces continued to <w>shell</w> the city throughout the night.",
                            "target_lang_translations": {
                                "ru": "Вражеские войска продолжали <w>обстреливать</w> город в течение всей ночи.",
                                "zh": "敌军整夜都在<w>炮轰</w>这座城市。"
                            }
                        },
                        {
                            "text": "The village was heavily <w>shelled</w> during the war.",
                            "target_lang_translations": {
                                "ru": "Деревня была сильно <w>обстреляна</w> во время войны.",
                                "zh": "战争期间，这个村庄遭到了猛烈的<w>炮轰</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атаковать место, стреляя разрывными снарядами из больших орудий.",
                        "zh": "用大型火炮发射爆炸性弹药来攻击某地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обстреливать",
                                "target_lang_sense_clarification": "артиллерией"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炮轰",
                                "target_lang_sense_clarification": "军事行动"
                            },
                            {
                                "target_lang_word": "轰炸",
                                "target_lang_sense_clarification": "泛指猛烈攻击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a13cd1c-32a9-3d34-81f7-423ed15eea22",
                    "sense_definition": "To remove the hard outer covering from something, such as nuts, peas, or shrimp.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat on the porch helping my grandmother <w>shell</w> peas for dinner.",
                            "target_lang_translations": {
                                "ru": "Мы сидели на крыльце, помогая бабушке <w>лущить</w> горох к ужину.",
                                "zh": "我们坐在门廊上，帮奶奶<w>剥</w>豌豆准备晚饭。"
                            }
                        },
                        {
                            "text": "It takes a lot of time to <w>shell</w> enough walnuts for a pie.",
