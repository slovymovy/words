                        "examples": [
                            {
                                "example_id": "49d9d452-f53c-4c4d-90c2-250bb8a900c6",
                                "sense_id": "efc5f7ec-6f65-37dd-bd96-6381ef424263",
                                "text": "Un saducéen est un juif conservateur qui ne croit pas en la résurrection."
                            },
                            {
                                "example_id": "dedab50f-2d84-48d0-b900-83b00e49ec80",
                                "sense_id": "efc5f7ec-6f65-37dd-bd96-6381ef424263",
                                "text": "Les saducéens niaient l’immortalité de l’âme."
                            },
                            {
                                "example_id": "848e38e9-19d0-451a-8fc1-2110814df72b",
                                "sense_id": "efc5f7ec-6f65-37dd-bd96-6381ef424263",
                                "text": "Je n’obtins aucun succès à Jérusalem, pas même de curiosité. Ma seule réussite consista à me faire détester chaque jour davantage des prêtres, docteurs de la Loi, saducéens et pharisiens."
                            }
                        ]
                    }
