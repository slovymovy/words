                        "glosses": [
                            "Any extinct primitive fern of the genus Botryopteris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5c8b281-584b-48fc-af00-91cbb50f4bed",
                                "sense_id": "6febe65b-b4f2-352d-ae91-56d12d3e76c0",
                                "text": "The botryopterids (Botryopteriaceae) include three or four genera, all based on stem anatomy, with fruiting organs known also in one genus."
                            },
                            {
                                "example_id": "aac68e48-adc1-4d90-bf94-c844abb2cc5b",
                                "sense_id": "6febe65b-b4f2-352d-ae91-56d12d3e76c0",
                                "text": "To date it has been assumed that most Middle and Upper Pennsylvanian botryopterids produced sporangial aggregations similar to B. globosa and that all botryopterid species of this age produced Punctatisporites-like spores."
                            }
                        ]
                    }
