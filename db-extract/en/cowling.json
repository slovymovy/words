                                    {
                                        "sense_id": "b653387f-516c-37cb-89f1-e3ae2fb0d1c6",
                                        "entry_id": "1dfb4330-bd35-370f-8ae8-12652d8cef66",
                                        "glosses": [
                                            "Ne faire aucune levée."
                                        ],
                                        "tags": [
                                            "Jeu de cartes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fe6a0f5-a211-406e-9d69-82263f001fbf",
                                                "sense_id": "b653387f-516c-37cb-89f1-e3ae2fb0d1c6",
                                                "text": "Être capot, N’avoir fait aucune levée."
                                            },
                                            {
                                                "example_id": "129200ca-b304-4445-92ef-4869430c5929",
                                                "sense_id": "b653387f-516c-37cb-89f1-e3ae2fb0d1c6",
                                                "text": "Faire quelqu’un capot, Ne lui laisser aucune levée à faire."
                                            },
                                            {
                                                "example_id": "08aa6b96-2133-4d2f-b264-e964e2c89d8e",
                                                "sense_id": "b653387f-516c-37cb-89f1-e3ae2fb0d1c6",
                                                "text": "Mettre quelqu’un capot, Ne lui laisser aucune levée à faire."
                                            },
                                            {
                                                "example_id": "572af1ac-10d3-4bde-ab6c-77fef66e8b3d",
                                                "sense_id": "b653387f-516c-37cb-89f1-e3ae2fb0d1c6",
                                                "text": "– Je n'ai jamais eu une guigne pareille. La petite vient de me faire capot trois fois d'affilée."
                                            },
                                            {
                                                "example_id": "1338f46c-4169-4425-90d3-20f0d3dfa37e",
                                                "sense_id": "b653387f-516c-37cb-89f1-e3ae2fb0d1c6",
                                                "text": "Demeurer capot, Demeurer confus et interdit auprès de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70671ef7-4d3f-3276-a75a-439d1409b728",
                                        "entry_id": "1dfb4330-bd35-370f-8ae8-12652d8cef66",
                                        "glosses": [
                                            "Se voir frustré de son espérance."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67c4813c-2547-425b-b110-67f6a980e0aa",
                                                "sense_id": "70671ef7-4d3f-3276-a75a-439d1409b728",
                                                "text": "Il a été bien capot de se voir reconnu."
                                            },
                                            {
                                                "example_id": "d48d2f57-7d71-41ff-bfd9-95076fef766f",
                                                "sense_id": "70671ef7-4d3f-3276-a75a-439d1409b728",
                                                "text": "Elle est demeurée capot."
                                            },
                                            {
                                                "example_id": "d02ab74b-4b76-480a-8ca3-8107aa828c85",
                                                "sense_id": "70671ef7-4d3f-3276-a75a-439d1409b728",
                                                "text": "J’étais capot et sans atout."
                                            },
                                            {
                                                "example_id": "a474e303-10e7-4415-9e36-4e3ec22b350f",
                                                "sense_id": "70671ef7-4d3f-3276-a75a-439d1409b728",
                                                "text": "Deux hommes de la patrouille emmenèrent les prisonniers qui, maintenant, étaient capots."
                                            },
                                            {
                                                "example_id": "40419616-e3a4-4e4b-bb28-4727dab71c53",
                                                "sense_id": "70671ef7-4d3f-3276-a75a-439d1409b728",
                                                "text": "Pas un ne gagne contre moi. Ils peuvent jouer toutes leurs cartes. C’est toujours capote et capot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "capot",
