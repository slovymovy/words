                "senses": [
                    {
                        "sense_id": "6267dc35-14ef-3cdf-8c03-325ceced66d8",
                        "entry_id": "d4529443-4de0-3aff-9068-1f7bdf6d525e",
                        "glosses": [
                            "ablehnende Entscheidung, negativer Eindruck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57fbf863-9a10-4304-82eb-190cabb48fa3",
                                "sense_id": "6267dc35-14ef-3cdf-8c03-325ceced66d8",
                                "text": "„Eine solche inoffizielle Ebene gab es 1546 aber nicht mehr; das gegenseitige Misstrauen und das feststehende Negativurteil über den anderen verhinderten dies.“"
                            },
                            {
                                "example_id": "40cb8df6-e1ce-4c10-837f-15653bf2b4d9",
                                "sense_id": "6267dc35-14ef-3cdf-8c03-325ceced66d8",
                                "text": "„Ihre Missachtung beruht dabei auf einem Negativurteil hinsichtlich ihres gesellschaftlichen Wertes, so dass ihr Leben vielfach durch Diskriminierungen und Stigmatisierungen gekennzeichnet ist.“"
                            },
                            {
                                "example_id": "4721ffd5-b1bf-4665-a9f5-144f56f76f92",
                                "sense_id": "6267dc35-14ef-3cdf-8c03-325ceced66d8",
                                "text": "„Das Negativurteil der Analysten, ob in Ratingagenturen oder auch durch Finanzanalysten in Banken, wirkt damit selbst krisenverschärfend.“"
                            },
                            {
                                "example_id": "978867f6-8743-4ca7-a794-909ce647ae4b",
                                "sense_id": "6267dc35-14ef-3cdf-8c03-325ceced66d8",
                                "text": "„Dabei intendiert diese Bewertung keineswegs ein Negativurteil, sondern verweist lediglich auf die Andersartigkeit durch den Wegfall der transitiven Ebene.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
