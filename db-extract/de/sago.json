                "translations": [
                    {
                        "translation_id": "86e4c9c6-d228-4fb8-bb5b-4921aaf3378a",
                        "source_entry_id": "c65c2d47-4ad9-301b-ae7d-c6107be4a65a",
                        "source_sense_id": "9718af35-ee64-382e-9a0b-ae3967c6d5e2",
                        "source_sense_description": "Stärkemehl zum Verdicken von Grütze, Suppe und dergleichen",
                        "target_lang_word": "sagou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sagou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1300ee8-bc88-36aa-9cc0-c1e6f45c3b5c",
                                        "entry_id": "5bf938e8-4b55-3f80-8950-a9117a469e67",
                                        "glosses": [
                                            "Fécule amylacée qu’on tire de la moelle de diverses espèces de palmiers, en particulier du sagoutier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b257e322-09b7-4953-bdf1-b5bd7515cf7f",
                                                "sense_id": "a1300ee8-bc88-36aa-9cc0-c1e6f45c3b5c",
                                                "text": "De tous ces sagous, les plus estimés ou les plus estimables, au jugement de M. Planche, sont les sagous des îles Moluques."
                                            },
                                            {
                                                "example_id": "4bc41acc-ebd6-497e-9484-af000be8b692",
                                                "sense_id": "a1300ee8-bc88-36aa-9cc0-c1e6f45c3b5c",
                                                "text": "À une aussi grande distance des lieux, il est difficile de décider, entre ces arbres, quels sont ceux qui produisent véritablement les sagous du commerce; car il y en a, plusieurs espèces."
                                            },
                                            {
                                                "example_id": "2ea28df3-4e56-4fec-951d-c81fa4c2d0af",
                                                "sense_id": "a1300ee8-bc88-36aa-9cc0-c1e6f45c3b5c",
                                                "text": "Je fus un voyou et une petite brute pendant tout le déjeuner, et je ne valais pas plus cher qu’un voyou des Sablonières, et j'aurais dû montrer plus de respect, et je restais silencieusement assis, comme Tunney, à manger mon pudding au sagou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fe190b6-6e36-3834-901d-9624b119eb09",
                                        "entry_id": "5bf938e8-4b55-3f80-8950-a9117a469e67",
                                        "glosses": [
                                            "Sagoutier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d9f80f3-04c0-47ae-a284-85d787e26206",
                                                "sense_id": "5fe190b6-6e36-3834-901d-9624b119eb09",
                                                "text": "Le sagou du Japon."
                                            },
                                            {
                                                "example_id": "901c31ee-4256-4936-9090-1f60dddc1e72",
                                                "sense_id": "5fe190b6-6e36-3834-901d-9624b119eb09",
                                                "text": "Dans les îles de l'Asie, le sagou contient dans son tronc épais une farine abondante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
