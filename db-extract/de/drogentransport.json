                "senses": [
                    {
                        "sense_id": "57bce953-9b24-3387-a1d0-65dc433b64ef",
                        "entry_id": "599e332f-1281-3506-98f5-cdc46da8075f",
                        "glosses": [
                            "Transport von Drogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b0fe768-c4f0-40c4-8c42-f5df924234fd",
                                "sense_id": "57bce953-9b24-3387-a1d0-65dc433b64ef",
                                "text": "„Einer von ihnen gab Beamten des DAS (Departamento Administrativo de Seguridad) einen Tipp, und so verhaftete man ihn, seinen Cousin Gustavo und drei weitere Männer nur zwei Monate nach der Hochzeit, als die Gruppe von einem Drogentransport nach Medellín zurückkehrte.“"
                            },
                            {
                                "example_id": "1ef387e3-ac25-4b73-aa34-3f7898e21824",
                                "sense_id": "57bce953-9b24-3387-a1d0-65dc433b64ef",
                                "text": "„Er sorgte für den Schutz der Drogentransporte, der Produktionsanlagen und der Safe Houses.“"
                            },
                            {
                                "example_id": "8e0efb26-ced9-413f-968c-41d1e6173f87",
                                "sense_id": "57bce953-9b24-3387-a1d0-65dc433b64ef",
                                "text": "„Er setzt sich dafür ein, die Südgrenze der Vereinigten Staaten für Drogentransporte offen zu halten und den Menschenhandel zu erleichtern, der einen stetigen Strom von überschuldeten jungen Frauen für Bordelle und zartester Kinder für Männer sicherstellt, die nach ihnen gieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
