                ],
                "senses": [
                    {
                        "sense_id": "5848e914-cf25-31d6-9152-f1f5deef76ef",
                        "entry_id": "dfb9e5b6-9832-303f-a976-0ba85cef7403",
                        "glosses": [
                            "sachliche Themen in den Vordergrund stellend; unter Zurückstellung persönlicher/emotionaler Faktoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afd028e7-6221-4848-8d5a-74b82fb11013",
                                "sense_id": "5848e914-cf25-31d6-9152-f1f5deef76ef",
                                "text": "„In diesem erhitzten Klima der Vorurteile und Emotionen war kühle, sachbetonte und interessenbewußte Gleichgewichtspolitik zum Scheitern verurteilt.“"
                            },
                            {
                                "example_id": "8132d683-f98e-4083-8625-77f8d334ffac",
                                "sense_id": "5848e914-cf25-31d6-9152-f1f5deef76ef",
                                "text": "„Diese Debatte war - gerade auch mangels Trump-Tiraden - auffallend sachbetont, streckenweise sogar tiefgehend.“"
                            },
                            {
