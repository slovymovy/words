                    }
                ],
                "senses": [
                    {
                        "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                        "entry_id": "05d91af1-2cbb-3bca-bbfd-b2badc2df526",
                        "glosses": [
                            "Blutgefäß um das Herz, durch das Blut zur Versorgung des Herzens fließt"
                        ],
                        "tags": [
                            "oft im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9cd6e2c2-40e4-4176-b1e7-804ab1bbba0e",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "Ein Blutgerinnsel in einem Herzkranzgefäß kann tödlich sein."
                            },
                            {
                                "example_id": "8591afb8-b56b-425d-b01f-db4263bc6bc6",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "„Eine verengte Stelle in einem der Herzkranzgefäße – den Koronararterien - führt zu Sauerstoffmangel.“"
                            },
                            {
                                "example_id": "20bed1b8-8db7-46cb-8d66-9c59c3ea3611",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "„Moderne Computertomografen entdecken Verschlüsse der Herzkranzgefäße schon im Frühstadium.“"
                            },
                            {
                                "example_id": "e429889e-9b07-4682-9fa1-39fb42246c7e",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "„Etwa 75 % der Infarkte entstehen an nur leicht oder mittelgradig veränderten Abschnitten der Herzkranzgefäße.“"
                            },
                            {
                                "example_id": "bce7973c-40a0-4841-a2ed-fdd93356467f",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "„Verkalkte Herzkranzgefäße lassen sich mit Ballons weiten, kleine Röhren (Stents) sorgen für die langfristige Öffnung.“"
                            },
                            {
                                "example_id": "d81a0198-cb20-45de-b000-0f2a166d566e",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "„1977 wagt Grüntzig eine Ballondilatation und dehnt ein verengtes Herzkranzgefäß eines 38-jährigen Mannes mittels Katheter aus.“"
                            },
                            {
                                "example_id": "9e07f3bc-2ebe-489c-9f0d-92b970e18abd",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "„Mithilfe von Scans machten die Forscher winzige Kalziumablagerungen in den Wänden der Herzkranzgefäße sichtbar, die als erster Hinweis auf Gefäßverkalkung gelten.“"
                            },
                            {
                                "example_id": "6a64c324-191c-4ff1-9481-95fe78072824",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "„An sehr kalten Tagen steigt die Zahl der Herzinfarkte. Starke Kälte belastet die Herzkranzgefäße, indem sich die Gefäße verengen und die Blutversorgung des Herzmuskels vermindern, der dadurch weniger Sauerstoff bekommt.“"
                            },
                            {
                                "example_id": "b4e61334-6f22-431b-b7e6-5495e1729bb7",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "[Herzkatheteruntersuchung:] „Je nach Untersuchungsziel werden unterschiedliche Stellen im Herzen bzw. in den Herzkranzgefäßen angesteuert.“"
                            },
                            {
                                "example_id": "209d1563-7866-417f-9c86-c996888719ed",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "Die Rechtsherzkatheteruntersuchung wird eher selten, die Linksherzkatheteruntersuchung häufiger durchgeführt, vor allem um bei der Koronarangiographie die Herzkranzgefäße sichtbar zu machen und möglicherweise im Rahmen einer Ballondilatation aufzudehnen."
                            },
                            {
                                "example_id": "279f3e32-0d53-4ce5-ab0e-f51af16c4468",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "„Ein chronischer Mangel an Stickstoffmonoxid kann zum Beispiel zu chronischen Gefäßverengungen wie Arteriosklerose, zu Veränderungen der Herzkranzgefäße aber auch zu Lungenhochdruck führen.“"
                            },
                            {
                                "example_id": "54d67175-3ba1-4623-a57d-2f4ed3eb4a5b",
                                "sense_id": "11cde2fa-188b-3fc4-aca6-3d73f9137c83",
                                "text": "„Ein weiterer Faktor ist das Alter: Ab etwa 35 Jahren ist eine Verengung der Herzkranzgefäße die Hauptursache für einen plötzlichen Herztod beim Sport.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
