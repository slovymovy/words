                                "target_senses": [
                                    {
                                        "sense_id": "c4992f79-16aa-37cd-9e62-e6ca767e13b5",
                                        "entry_id": "345bcf25-3a4b-3025-bdee-015aa8697992",
                                        "glosses": [
                                            "semireguläres Polyeder mit sechs Quadraten und acht gleichseitigen Dreiecken"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c25af601-fee0-497b-8201-2b74b93d323b",
                                                "sense_id": "c4992f79-16aa-37cd-9e62-e6ca767e13b5",
                                                "text": "Das Kuboktaeder kann aus einem Würfel entstehen."
                                            },
                                            {
                                                "example_id": "2005d0be-5834-4adb-9377-0273e55d2073",
                                                "sense_id": "c4992f79-16aa-37cd-9e62-e6ca767e13b5",
                                                "text": "Bereits Platon soll neben den nach ihm benannten regulären Polyedern das Kuboktaeder gekannt haben."
                                            },
                                            {
                                                "example_id": "d13f175c-68e2-48e6-9cdc-d82a49054ed3",
                                                "sense_id": "c4992f79-16aa-37cd-9e62-e6ca767e13b5",
                                                "text": "Der Kuboktaeder bildet die Grundstrukturen der atomaren Gitter von Zeolithen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
