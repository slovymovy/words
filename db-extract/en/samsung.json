                "senses": [
                    {
                        "sense_id": "d89e58fe-5ab3-3009-8966-060f347da44d",
                        "entry_id": "c9f9fc34-d2f3-31d9-9973-e3332afb0981",
                        "glosses": [
                            "A consumer electronic device manufactured by the South Korean conglomerate company Samsung."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "223513af-931f-42b3-a57e-3859e3bbf88f",
                                "sense_id": "d89e58fe-5ab3-3009-8966-060f347da44d",
                                "text": "He told his friend that the game wasnt available on Samsung phones."
                            },
                            {
                                "example_id": "c7636486-8fb5-43a3-9b06-39720b24d78f",
                                "sense_id": "d89e58fe-5ab3-3009-8966-060f347da44d",
                                "text": "The advantage of the Hercules card over the EGA is that it can be used with a standard IBM Monochrome Monitor or an inexpensive monochrome monitor such as a Samsung, priced at around $100."
                            },
                            {
                                "example_id": "a0a7e393-972d-4af6-8223-f24d3a8facbd",
                                "sense_id": "d89e58fe-5ab3-3009-8966-060f347da44d",
                                "text": "When a grandmother from Pittsburgh bought a Samsung, she bought the most reliable microwave oven made."
                            }
                        ]
                    },
                    {
                        "sense_id": "3327cc01-03d4-3bd4-b6c9-793eb34a3ec1",
                        "entry_id": "c9f9fc34-d2f3-31d9-9973-e3332afb0981",
                        "glosses": [
                            "A consumer electronic device manufactured by the South Korean conglomerate company Samsung.",
                            "A phone manufactured by Samsung."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dfff137-d15e-44d0-9a33-ffb1a55ae5e2",
                                "sense_id": "3327cc01-03d4-3bd4-b6c9-793eb34a3ec1",
                                "text": "They are wearing pajamas and shouldering pillows, with iPhones in their left hands and Samsungs in their right hands."
                            },
                            {
                                "example_id": "596694ba-10da-439a-a563-e918e1e24bfc",
                                "sense_id": "3327cc01-03d4-3bd4-b6c9-793eb34a3ec1",
                                "text": "Everywhere Nokias and Samsungs are stapled to eager ears, clipped onto trousers or slipped into purses."
                            }
                        ]
                    },
