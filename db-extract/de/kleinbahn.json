                "senses": [
                    {
                        "sense_id": "ef205f60-a2c4-3901-941f-79658a54037d",
                        "entry_id": "34851120-2c71-3773-b42e-4ef680b45e6f",
                        "glosses": [
                            "Eisenbahn nur mit lokaler Bedeutung, meist mit kurzer Streckenlänge und häufig mit geringerer Spurweite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7025b49-f7e6-4b8d-b353-7410ede18ea7",
                                "sense_id": "ef205f60-a2c4-3901-941f-79658a54037d",
                                "text": "„Eine unbeleuchtete Kleinbahn beförderte ihn weiter, hielt auf kleinen Dorfbahnhöfen, die zum Verladen von Rüben und Kartoffeln bestimmt waren, aber nicht für den Personenverkehr.“"
                            },
                            {
                                "example_id": "1a82d120-df6d-48af-8f70-3c5e328e9e53",
                                "sense_id": "ef205f60-a2c4-3901-941f-79658a54037d",
                                "text": "„Ich fahre mit der Kleinbahn nach Ingolstadt.“"
                            },
                            {
                                "example_id": "b1a49b47-4a79-4e94-89d4-6df326444cb7",
                                "sense_id": "ef205f60-a2c4-3901-941f-79658a54037d",
                                "text": "„So fuhren wir eines Tages mit dem Zug nach Arnsdorf und mit der Kleinbahn nach Kamenz, um von dort unser Ziel zu Fuß zu erreichen.“"
                            },
                            {
                                "example_id": "e7788461-7c4f-471b-9a55-b1335147aed8",
                                "sense_id": "ef205f60-a2c4-3901-941f-79658a54037d",
                                "text": "„Die Kleinbahn hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfa864d3-c42d-4901-aaf2-ae1853f18811",
                        "source_entry_id": "34851120-2c71-3773-b42e-4ef680b45e6f",
                        "source_sense_id": "ef205f60-a2c4-3901-941f-79658a54037d",
                        "source_sense_description": "Eisenbahn nur mit lokaler Bedeutung, meist mit kurzer Streckenlänge und häufig mit geringerer Spurweite",
                        "target_lang_word": "light railway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "light railway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dae510cd-0579-3968-bf23-53df161a269d",
                                        "entry_id": "ad6fd785-ecc1-33f6-b4ec-d15d63d769f2",
                                        "glosses": [
                                            "A railway built at a lower cost, with a lighter track and to a lower standard than a main-line railway."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c3a23c-4c16-4c92-94bc-d974817c532b",
                                                "sense_id": "dae510cd-0579-3968-bf23-53df161a269d",
                                                "text": "Under a Light Railway Order of 1904, the line was extended to Appledore, and opened thence on May 1, 1908, bringing the route length up to a fraction over 7 miles. The whole system was worked under this Order as a light railway, but this caused some friction with the local authorities when, under the authority of the Board of Trade, the gates were removed at five level crossings in May, 1905."
                                            },
                                            {
                                                "example_id": "b43343a0-a994-4a8a-88c6-f0b8c43fde54",
                                                "sense_id": "dae510cd-0579-3968-bf23-53df161a269d",
                                                "text": "Although the line is officially a light railway, it is of standard gauge, and the traffic, particularly during and since the war years, is anything but light."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
