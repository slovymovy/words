{
    "word_family": [
        "méconnaissance",
        "méconnaissable",
        "connaître",
        "reconnaître"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d07817b-2d48-3935-b04e-02f468841bea",
                    "sense_definition": "Ne pas apprécier quelqu'un ou quelque chose à sa juste valeur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appreciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce poète de talent est longtemps resté <w>méconnu</w> du grand public avant d'obtenir ce prix."
                        },
                        {
                            "text": "Il ne faut pas <w>méconnaître</w> les efforts constants que l'équipe a déployés pour ce projet."
                        }
                    ],
                    "synonyms": [
                        "sous-estimer",
                        "déconsidérer"
                    ],
                    "antonyms": [
                        "reconnaître",
                        "apprécier"
                    ],
                    "common_phrases": [
                        "artiste méconnu",
                        "méconnaître les mérites"
                    ]
                },
                {
                    "sense_id": "b8548778-a4b1-3687-a281-328fce18e9e9",
                    "sense_definition": "Ignorer délibérément ou refuser d'admettre la réalité, la valeur ou l'autorité de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ignorance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision administrative semble <w>méconnaître</w> les droits fondamentaux garantis par la loi."
                        },
                        {
                            "text": "Le rapport officiel tendait à <w>méconnaître</w> la gravité réelle des événements survenus."
                        }
                    ],
                    "synonyms": [
                        "ignorer",
                        "enfreindre"
                    ],
                    "antonyms": [
                        "respecter",
                        "observer"
                    ],
                    "common_phrases": [
                        "méconnaître la réalité",
                        "méconnaître les droits"
                    ]
                },
                {
                    "sense_id": "0f3363b7-1577-3526-8dd3-f3dbfd7ced8e",
                    "sense_definition": "Désavouer quelqu'un ou feindre de ne pas le connaître, généralement par fierté ou ingratitude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "desaveu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il a connu la gloire, il <w>méconnaît</w> ses anciens camarades d'école."
                        },
                        {
                            "text": "Elle craignait que ses proches ne finissent par la <w>méconnaître</w> après son exil."
                        }
                    ],
                    "synonyms": [
                        "désavouer",
                        "renier"
                    ],
                    "antonyms": [
                        "reconnaître"
                    ],
                    "common_phrases": [
                        "méconnaître ses amis",
                        "méconnaître ses parents"
                    ]
                },
                {
                    "sense_id": "e7a963d8-b6d2-3432-a38c-4660e6a460ce",
                    "sense_definition": "Avoir une idée fausse ou inexacte de soi-même, de ses capacités ou de ses limites.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pronominal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En acceptant cette tâche écrasante, il a prouvé qu'il se <w>méconnaissait</w> complètement."
                        },
                        {
                            "text": "À force de vouloir plaire aux autres, elle a fini par se <w>méconnaître</w> au fil du temps."
                        }
                    ],
                    "synonyms": [
                        "s'illusionner"
                    ],
                    "common_phrases": [
                        "se méconnaître soi-même"
                    ]
                }
            ]
        }
    ]
}