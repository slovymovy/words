                                            {
                                                "example_id": "b6463dea-94fa-426a-a47d-59349fd07ca7",
                                                "sense_id": "3e77d350-b068-3a77-bbf2-7420ba44ad40",
                                                "text": "Der alarmierte Wärter bläst kräftig in ein Horn, worauf seine Kollegen von den Gleisen wegtreten."
                                            },
                                            {
                                                "example_id": "08ec1021-0d0a-46fb-be62-8f5a41ad01bf",
                                                "sense_id": "3e77d350-b068-3a77-bbf2-7420ba44ad40",
                                                "text": "Man beachte, dass die Schlittenwege ab der Bussalp auf einigen Abschnitten mit dem Bus die Strasse teilen, so dass man anhalten und von der Strasse wegtreten muss, sobald man das Horn des Busses vernimmt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c21752fb-97a4-362d-9613-b4af8561a1cc",
                                        "entry_id": "ce0d382a-5c3c-3ff5-9575-e589fcf92a39",
                                        "glosses": [
                                            "etwas von sich treten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fd9a33d-8b94-4faf-a424-998f3dc10196",
                                                "sense_id": "c21752fb-97a4-362d-9613-b4af8561a1cc",
                                                "text": "„Ich weiß nicht, ob man dem Mario Götze erst ein Bein wegtreten muss, damit er mal einen Elfmeter kriegt.“"
                                            },
                                            {
                                                "example_id": "e2479982-3bf2-489d-bd32-6f7f69be44c5",
                                                "sense_id": "c21752fb-97a4-362d-9613-b4af8561a1cc",
                                                "text": "Um zu verhindern, dass man ihn verliert, muss man damit weglaufen - oder besser noch: man muss ihn abgeben, also wegtreten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
