{
    "word_family": [
        "abridgement",
        "abridger",
        "unabridged"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e13b883-6f6f-3943-87da-3491930ceb80",
                    "sense_definition": "To shorten a book, speech, or text by condensing it while retaining the essential meaning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "shorten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The publisher decided to <w>abridge</w> the lengthy novel so students could read it more easily."
                        },
                        {
                            "text": "The author worked carefully to <w>abridge</w> a text without omitting any crucial plot points."
                        }
                    ],
                    "synonyms": [
                        "condense",
                        "shorten",
                        "summarize"
                    ],
                    "antonyms": [
                        "expand"
                    ],
                    "common_phrases": [
                        "abridge a text",
                        "abridge a novel"
                    ]
                },
                {
                    "sense_id": "6008aa9c-fa94-31e1-923b-f8537276284f",
                    "sense_definition": "To curtail, limit, or diminish rights, privileges, or authority.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shorten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constitution strictly prohibits any law that would <w>abridge</w> basic human rights."
                        },
                        {
                            "text": "Citizens feared the emergency decree would <w>abridge</w> freedom of speech across the country."
                        }
                    ],
                    "synonyms": [
                        "curtail",
                        "limit",
                        "restrict"
                    ],
                    "common_phrases": [
                        "abridge rights",
                        "abridge freedom"
                    ]
                },
                {
                    "sense_id": "ecd42d45-0324-3f06-8358-892d8ea743cc",
                    "sense_definition": "To reduce or shorten in duration, span, or extent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shorten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Severe winter weather forced the travelers to <w>abridge</w> their planned vacation by several days."
                        },
                        {
                            "text": "He decided to <w>abridge</w> the visit when he noticed his host was visibly exhausted."
                        }
                    ],
                    "synonyms": [
                        "lessen",
                        "truncate"
                    ],
                    "antonyms": [
                        "prolong"
                    ],
                    "common_phrases": [
                        "abridge a visit"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used of time, duration, or general physical extent"
                        }
                    ]
                },
                {
                    "sense_id": "4cb246b4-61dc-336c-b3b9-5f05d0af15d3",
                    "sense_definition": "To deprive someone of something; to debar or cut off.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deprive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unjust decree seemed designed to <w>abridge</w> the citizens of their inherited privileges."
                        },
                        {
                            "text": "War threatened to <w>abridge</w> the region of essential trade routes."
                        }
                    ],
                    "synonyms": [
                        "deprive",
                        "divest"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "In the sense of depriving or cutting off"
                        }
                    ]
                }
            ]
        },
