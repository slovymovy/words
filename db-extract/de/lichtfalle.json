                "senses": [
                    {
                        "sense_id": "bf016823-ffc5-3039-a07c-40dbc54101ac",
                        "entry_id": "bbbab484-50db-38a5-a80b-1102cfc95f45",
                        "glosses": [
                            "Gerät, mit dem nachtaktive Insekten mithilfe künstlichen Lichts eingefangen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053b6ba3-30bf-46c6-a280-f1f1141d40df",
                                "sense_id": "bf016823-ffc5-3039-a07c-40dbc54101ac",
                                "text": "„Was die Sümpfe an Insekten auszubrüten vermochten, kreiste und flatterte um die Lichtfalle über Lorraines Kopf.“"
                            },
                            {
                                "example_id": "0bc55505-8ae5-4fce-8dcb-09569c831696",
                                "sense_id": "bf016823-ffc5-3039-a07c-40dbc54101ac",
                                "text": "„Man kann die Lichtquelle mit einer automatischen Sammeleinrichtung versehen, die die Insekten zurückhält; dann spricht man von einer Lichtfalle.“"
                            },
                            {
                                "example_id": "261b36f2-2f85-4ed4-97dd-a9b3cd82d674",
                                "sense_id": "bf016823-ffc5-3039-a07c-40dbc54101ac",
                                "text": "„Nicht weniger als 62 britische Arten sind ausgestorben, seit ich als Kind meine erste Lichtfalle betrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
