                "senses": [
                    {
                        "sense_id": "991b6ba4-8e2f-3275-bda9-c421879af741",
                        "entry_id": "3b1cb989-3d24-32d8-b6c3-254147c403bc",
                        "glosses": [
                            "het heilige boek der joden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9aff705-c730-4b9d-bb64-843671bce4c1",
                                "sense_id": "991b6ba4-8e2f-3275-bda9-c421879af741",
                                "text": "De Tenach komt niet helemaal overeen met het Oude Testament van de christelijke Bijbel, omdat de boeken in een andere volgorde staan en er -althans in de katholieke traditie- een aantal boeken meer tot het Oude Testament gerekend worden."
                            },
                            {
                                "example_id": "79a3a751-3d57-4906-a16b-e64399667432",
                                "sense_id": "991b6ba4-8e2f-3275-bda9-c421879af741",
                                "text": "⧖ Met genoegen lazen wij, dezer dagen bij bet intreden van de kerk eene annonce van den Heer Sanders, onderwijzer alhier, waarbij eene avond-cursus wordt aangekondigd van onderrigt in Tenach, Misna, en wat verder op de Talmudische kennis betrekking heeft, zelfs de Posgiem."
                            }
                        ]
                    }
                ],
