                                                "sense_id": "857197bc-bf7d-372b-9bfa-a7d0d98fccab",
                                                "text": "Bei dieser Nachricht wich ihm alles Blut aus den Wangen, und er wurde leichenblass."
                                            },
                                            {
                                                "example_id": "b32ef4b3-4113-45ef-a9c2-913adaa43aee",
                                                "sense_id": "857197bc-bf7d-372b-9bfa-a7d0d98fccab",
                                                "text": "„Patienten mit fortgeschrittenem Leberkrebs sind leichenblass, gelblich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8ae2863-87e3-4339-9cea-1b14ec32265f",
                        "source_entry_id": "388bd1b9-7e2a-382b-b288-788544e2e4ac",
                        "source_sense_id": "ceceb573-b0f0-3210-aa58-5f8d0be8e9d2",
                        "target_lang_word": "totenbleich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totenbleich",
                                "target_lang_code": "de",
