                        "glosses": [
                            "Qu’on peut suivre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab01a3ab-f5b8-43b9-aecb-b2ad11fdabce",
                                "sense_id": "a6eee1c5-1824-3b61-a60d-ffb0f42d1618",
                                "text": "De même, comme on le verra, si l’on dit suivre la fenêtre, il faudra que d’une façon ou d’une autre la fenêtre puisse s’interpréter comme étant suivable."
                            },
                            {
                                "example_id": "5afcf1f7-4575-4114-b2fe-6865fa4b4a7a",
                                "sense_id": "a6eee1c5-1824-3b61-a60d-ffb0f42d1618",
                                "text": "Il n’est pas numéro un mondial pour rien. C’est vraiment le puncheur qui n’est pas suivable dans les montées comme ça."
                            },
                            {
                                "example_id": "d4a27145-21e8-4c0d-b4f4-5800d5f1cc04",
                                "sense_id": "a6eee1c5-1824-3b61-a60d-ffb0f42d1618",
                                "text": "Un événement digitalisé depuis l’année dernière et l’apparition de la COVID-19. Cette année encore, la séance était suivable depuis Facebook, Youtube ou encore Twitch."
                            }
                        ]
                    }
