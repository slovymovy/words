{
    "word_family": [
        "buster",
        "busty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fdb8f880-832d-324f-ad70-3314f15d91b9",
                    "sense_definition": "To break or damage something physically.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "break_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I accidentally <w>busted</w> the lock on the front door.",
                            "target_lang_translations": {
                                "ru": "Я случайно <w>сломал</w> замок на входной двери.",
                                "zh": "我不小心<w>弄坏</w>了前门的锁。"
                            }
                        },
                        {
                            "text": "Be careful with that vase, or you might <w>bust</w> it.",
                            "target_lang_translations": {
                                "ru": "Осторожнее с этой вазой, а то можешь её <w>разбить</w>.",
                                "zh": "小心那个花瓶，不然你可能会把它<w>摔碎</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "fix",
                        "repair"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in spoken English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сломать или повредить что-либо физически.",
                        "zh": "物理上弄坏或损坏某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сломать",
                                "target_lang_sense_clarification": "повредить, нарушить целостность"
                            },
                            {
                                "target_lang_word": "разбить",
                                "target_lang_sense_clarification": "расколоть на куски (о хрупких предметах)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄坏",
                                "target_lang_sense_clarification": "使东西损坏"
                            },
                            {
                                "target_lang_word": "摔碎",
                                "target_lang_sense_clarification": "指易碎品因掉落而损坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8097dea-43b5-32f9-8eb3-b15cbf171adf",
                    "sense_definition": "To arrest someone for a crime or to catch someone doing something wrong.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "law_enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police <w>busted</w> the gang for selling stolen goods.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>арестовала</w> банду за продажу краденого.",
                                "zh": "警方因该团伙贩卖赃物而将其<w>逮捕</w>。"
                            }
                        },
                        {
                            "text": "He got <w>busted</w> by his teacher for cheating on the test.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>застукал</w> его, когда он списывал на контрольной.",
                                "zh": "他考试作弊时被老师<w>抓获</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nick"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Арестовать кого-либо за преступление или поймать кого-либо за совершением чего-то неправильного.",
                        "zh": "因犯罪而逮捕某人，或抓获某人做错事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арестовать",
                                "target_lang_sense_clarification": "взять под стражу (о полиции)"
                            },
                            {
                                "target_lang_word": "застукать",
                                "target_lang_sense_clarification": "застать врасплох за чем-то предосудительным (разг.)"
                            },
                            {
                                "target_lang_word": "поймать",
                                "target_lang_sense_clarification": "схватить, уличить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逮捕",
                                "target_lang_sense_clarification": "警方拘留嫌疑人"
                            },
                            {
                                "target_lang_word": "抓获",
                                "target_lang_sense_clarification": "当场抓住"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0647719-472a-308e-80b7-ec5c6548a4b2",
                    "sense_definition": "To prove that a belief, myth, or idea is false.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disprove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists set out to <w>bust</w> the myth that sugar causes hyperactivity.",
                            "target_lang_translations": {
                                "ru": "Учёные решили <w>развенчать</w> миф о том, что сахар вызывает гиперактивность.",
                                "zh": "科学家们着手<w>辟谣</w>关于糖会导致多动症的说法。"
                            }
                        },
                        {
                            "text": "This article <w>busts</w> several common misconceptions about diet.",
                            "target_lang_translations": {
                                "ru": "Эта статья <w>опровергает</w> несколько распространённых заблуждений о диетах.",
                                "zh": "这篇文章<w>驳斥</w>了几个关于饮食的常见误区。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bust-a-myth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доказать, что убеждение, миф или идея являются ложными.",
                        "zh": "证明某种信念、神话或观点是错误的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развенчать",
                                "target_lang_sense_clarification": "доказать несостоятельность (мифа, идеи)"
                            },
                            {
                                "target_lang_word": "опровергнуть",
                                "target_lang_sense_clarification": "доказать ложность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辟谣",
                                "target_lang_sense_clarification": "揭露虚假信息"
                            },
                            {
                                "target_lang_word": "驳斥",
                                "target_lang_sense_clarification": "证明观点错误"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6281e92a-b668-3548-9403-8141163fdd78",
                    "sense_definition": "To lose in a card game like blackjack by exceeding a total score of 21.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I took one more card and <w>busted</w> with twenty-two.",
                            "target_lang_translations": {
                                "ru": "Я взял ещё одну карту и <w>перебрал</w>, набрав двадцать два очка.",
                                "zh": "我又拿了一张牌，结果点数二十二，<w>爆牌</w>了。"
                            }
                        },
                        {
                            "text": "If the dealer <w>busts</w>, everyone still in the game wins.",
                            "target_lang_translations": {
                                "ru": "Если дилер <w>перебирает</w>, все оставшиеся в игре выигрывают.",
                                "zh": "如果庄家<w>爆牌</w>，所有留在游戏中的玩家都赢了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проиграть в карточной игре (например, в блэкджек), набрав в сумме больше 21 очка.",
                        "zh": "在纸牌游戏（如二十一点）中，因点数超过21点而输掉比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перебрать",
                                "target_lang_sense_clarification": "набрать очков больше, чем нужно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爆牌",
                                "target_lang_sense_clarification": "二十一点中点数超过21"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3dff2f51-f902-39ae-acf2-293c9299d872",
                    "sense_definition": "A woman's chest or the measurement around her breasts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dress was a bit too tight around the <w>bust</w>.",
                            "target_lang_translations": {
                                "ru": "Платье было немного тесновато в <w>груди</w>.",
                                "zh": "这件裙子在<w>胸围</w>处有点太紧了。"
                            }
                        },
                        {
                            "text": "She took measurements of her waist, hips, and <w>bust</w>.",
                            "target_lang_translations": {
                                "ru": "Она измерила талию, бёдра и <w>бюст</w>.",
                                "zh": "她测量了自己的腰围、臀围和<w>胸围</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женская грудь или обхват груди.",
                        "zh": "女性的胸部或胸围尺寸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грудь",
                                "target_lang_sense_clarification": "часть тела"
                            },
                            {
                                "target_lang_word": "бюст",
                                "target_lang_sense_clarification": "обхват груди или женская грудь (более формально)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胸部",
                                "target_lang_sense_clarification": "身体部位"
                            },
                            {
                                "target_lang_word": "胸围",
                                "target_lang_sense_clarification": "测量尺寸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2207f493-4e80-3c55-9f64-1e6a4abffdff",
                    "sense_definition": "A sculpture representing a person's head, shoulders, and upper chest.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A marble <w>bust</w> of the emperor stood in the museum hall.",
                            "target_lang_translations": {
                                "ru": "В зале музея стоял мраморный <w>бюст</w> императора.",
                                "zh": "博物馆大厅里立着一座皇帝的大理石<w>半身像</w>。"
                            }
                        },
                        {
                            "text": "The artist was commissioned to create a bronze <w>bust</w> of the founder.",
                            "target_lang_translations": {
                                "ru": "Художнику заказали бронзовый <w>бюст</w> основателя.",
                                "zh": "艺术家受委托创作了一座创始人的青铜<w>半身像</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скульптурное изображение головы, плеч и верхней части груди человека.",
                        "zh": "表现人物头部、肩膀和上胸部的雕塑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюст",
                                "target_lang_sense_clarification": "вид скульптуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "半身像",
                                "target_lang_sense_clarification": "雕塑艺术形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df9f7406-d094-346a-8c10-2308b7b8ea6b",
                    "sense_definition": "An event, performance, or enterprise that is a complete failure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party was a total <w>bust</w> because nobody showed up.",
                            "target_lang_translations": {
                                "ru": "Вечеринка стала полным <w>провалом</w>, потому что никто не пришёл.",
                                "zh": "因为没人来，聚会彻底<w>失败</w>了。"
                            }
                        },
                        {
                            "text": "Our trip to the beach was a <w>bust</w> due to the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Наша поездка на пляж обернулась <w>неудачей</w> из-за сильного дождя.",
                                "zh": "由于大雨，我们的海滩之旅以<w>惨败</w>告终。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие, выступление или предприятие, которое заканчивается полной неудачей.",
                        "zh": "彻底失败的事件、表演或企业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провал",
                                "target_lang_sense_clarification": "полная неудача"
                            },
                            {
                                "target_lang_word": "фиаско",
                                "target_lang_sense_clarification": "сокрушительная неудача"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失败",
                                "target_lang_sense_clarification": "未达到预期结果"
                            },
                            {
                                "target_lang_word": "惨败",
                                "target_lang_sense_clarification": "彻底的失败"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f98d113c-ab5a-3fc2-9da9-7aecb3a9f3b4",
                    "sense_definition": "A police raid or the act of arresting someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "law_enforcement_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police organized a major drug <w>bust</w> downtown.",
                            "target_lang_translations": {
                                "ru": "Полиция организовала крупную <w>облаву</w> на наркоторговцев в центре города.",
                                "zh": "警方在市中心组织了一次大规模的毒品<w>突袭</w>行动。"
                            }
                        },
                        {
                            "text": "He was caught during a <w>bust</w> on an illegal gambling den.",
                            "target_lang_translations": {
                                "ru": "Его поймали во время <w>рейда</w> на подпольный игорный притон.",
                                "zh": "他在一次针对非法赌场的<w>搜捕</w>中被抓住了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полицейский рейд или акт ареста кого-либо.",
                        "zh": "警察突袭或逮捕某人的行动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облава",
                                "target_lang_sense_clarification": "окружение места с целью поимки преступников"
                            },
                            {
                                "target_lang_word": "рейд",
                                "target_lang_sense_clarification": "внезапная проверка полицией"
                            },
                            {
                                "target_lang_word": "налёт",
                                "target_lang_sense_clarification": "внезапное нападение или захват (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突袭",
                                "target_lang_sense_clarification": "警方的突然行动"
                            },
                            {
                                "target_lang_word": "搜捕",
                                "target_lang_sense_clarification": "搜查并抓捕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b37f373-b5b2-3656-91df-cd97ea2f208a",
                    "sense_definition": "A period of economic difficulty or depression.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "economy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economy tends to follow a cycle of boom and <w>bust</w>.",
                            "target_lang_translations": {
                                "ru": "Экономика имеет тенденцию следовать циклу подъёмов и <w>спадов</w>.",
                                "zh": "经济往往遵循繁荣与<w>衰退</w>的周期。"
                            }
                        },
                        {
                            "text": "Many investors lost their savings during the market <w>bust</w>.",
                            "target_lang_translations": {
                                "ru": "Многие инвесторы потеряли свои сбережения во время рыночного <w>кризиса</w>.",
                                "zh": "许多投资者在市场<w>萧条</w>期间损失了积蓄。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "boom-and-bust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период экономических трудностей или депрессии.",
                        "zh": "经济困难或萧条的时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спад",
                                "target_lang_sense_clarification": "ухудшение экономической ситуации"
                            },
                            {
                                "target_lang_word": "кризис",
                                "target_lang_sense_clarification": "резкое ухудшение состояния"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衰退",
                                "target_lang_sense_clarification": "经济下滑"
                            },
                            {
                                "target_lang_word": "萧条",
                                "target_lang_sense_clarification": "经济严重低迷"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1b8dcb65-25ac-3f09-b6c2-8a77cc5eb137",
                    "sense_definition": "Having no money; financially ruined.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "financial_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After months of poor sales, the company finally went <w>bust</w>.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев плохих продаж компания в конце концов <w>разорилась</w>.",
                                "zh": "经过几个月的销售不佳，公司最终<w>破产</w>了。"
                            }
                        },
                        {
                            "text": "If we don't reduce our spending, we will go <w>bust</w> within a year.",
                            "target_lang_translations": {
                                "ru": "Если мы не сократим расходы, то <w>обанкротимся</w> в течение года.",
                                "zh": "如果我们不削减开支，一年内就会<w>破产</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go-bust"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий денег; финансово разоренный.",
                        "zh": "没有钱；经济上破产。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разорившийся",
                                "target_lang_sense_clarification": "потерявший все деньги"
                            },
                            {
                                "target_lang_word": "банкрот",
                                "target_lang_sense_clarification": "неплатежеспособный должник"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破产",
                                "target_lang_sense_clarification": "丧失偿债能力"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}