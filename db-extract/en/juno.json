                "word": "Juno",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dac593f1-2cb7-327c-bed6-cea5143dae6e",
                        "entry_id": "671387be-d86a-39d7-967f-0021bccdf92f",
                        "glosses": [
                            "The queen of the gods, the equivalent of the Greek goddess Hera."
                        ],
                        "tags": [
                            "Roman"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "66342088-0835-36a9-9642-6434da7fbff2",
                        "entry_id": "671387be-d86a-39d7-967f-0021bccdf92f",
                        "glosses": [
                            "3 Juno, the third asteroid discovered."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "389ecb3d-77e1-3f0c-957e-615e9951cd28",
                        "entry_id": "671387be-d86a-39d7-967f-0021bccdf92f",
                        "glosses": [
                            "A female given name."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5a321e6b-aebb-42b5-a103-89f04d139883",
                                "sense_id": "389ecb3d-77e1-3f0c-957e-615e9951cd28",
                                "text": "But after a few visits to share details about ultrasounds and such, Juno and Mark find they have similar interests in music and movies - and Juno does have extraordinary tastes for someone her age, from the songs of Iggy and the Stooges to the horror flicks of Dario Argento."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dc4cfff-2dbd-4985-98a4-cd69d358cc5c",
                        "source_entry_id": "671387be-d86a-39d7-967f-0021bccdf92f",
                        "source_sense_description": "Roman goddess",
                        "target_lang_word": "Junon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Junon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c502435-6282-3f9d-8c83-e96526c89e49",
                                        "entry_id": "fa7fc755-89c8-33b9-8b2c-12d11647c816",
                                        "glosses": [
                                            "Déesse romaine, reine des dieux et reine du ciel, fille de Rhéa et de Saturne, sœur de Cérès, Neptune, Pluton, Vesta, Jupiter et épouse de celui-ci, protectrice des femmes, qui symbolise le mariage et la fécondité."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "663f4a2d-41a1-42e1-a965-072b40f2bcd0",
                                                "sense_id": "8c502435-6282-3f9d-8c83-e96526c89e49",
                                                "text": "Junon persécuta toutes les concubines de Jupiter et tous les enfants issus de ses illégitimes amours ; Hercule, Io, Europe, Sémélé, Platée, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a89fb8fa-300d-31dd-8072-6ab7dfc52eea",
                                        "entry_id": "fa7fc755-89c8-33b9-8b2c-12d11647c816",
                                        "glosses": [
                                            "Un des principaux astéroïdes de la ceinture principale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eba1416-ee24-40a1-89cd-349fc9464c58",
                                                "sense_id": "a89fb8fa-300d-31dd-8072-6ab7dfc52eea",
                                                "text": "Junon fut découverte le 1ᵉʳ septembre 1804 à l’observatoire de Schröter par l’astronome allemand Karl Ludwig Harding."
                                            },
                                            {
                                                "example_id": "3f50b0d0-afe3-4302-bb7a-72d63c876d5c",
                                                "sense_id": "a89fb8fa-300d-31dd-8072-6ab7dfc52eea",
                                                "text": "Les planètes sont au nombre de onze : Mercure, Vénus, la Terre, Mars, Cérès, Pallas, Junon, Vesta, Jupiter, Saturne et Uranus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
