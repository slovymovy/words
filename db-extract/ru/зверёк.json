                    {
                        "translation_id": "d010c738-ad84-4454-9d7b-2c73ed073685",
                        "source_entry_id": "01b66895-d1f1-3aa2-97bb-f0930a08f259",
                        "source_sense_id": "0885d2ad-70d3-3470-9ab5-60be52529820",
                        "target_lang_word": "beestje",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beestje",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5c138a54-f5d3-3642-b3c5-44179a643c96",
                                        "entry_id": "1aed0717-f604-3c22-a653-f457169a10f6",
                                        "glosses": [
                                            "verkleinwoord enkelvoud van het zelfstandig naamwoord beest"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d444ff5-4cf9-434b-9f1c-a54ff2206a0f",
                                                "sense_id": "5c138a54-f5d3-3642-b3c5-44179a643c96",
                                                "text": "Mijn hond is altijd een braaf beestje geweest, maar nu had hij toch iemand gebeten."
                                            },
                                            {
                                                "example_id": "22b1ec87-c62f-4594-bdc2-ceb2382b4521",
                                                "sense_id": "5c138a54-f5d3-3642-b3c5-44179a643c96",
                                                "text": "Dan hoort ze het gemompel dat uit de naastgelegen slaapkamer komt waar Salma, zittend op het bed, een kleine salamander boven het bed bestudeert. Als ze Hafsa opmerkt, wenkt ze haar om dichterbij te komen en wijst naar het beestje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39bf6257-3cb3-3340-9faa-10de913317fc",
                                        "entry_id": "1aed0717-f604-3c22-a653-f457169a10f6",
                                        "glosses": [
                                            "dim. tant. een klein diertje, insect, bacterie, worm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0251d4b-8f8e-4dad-a77f-666bc4e7ae02",
                                                "sense_id": "39bf6257-3cb3-3340-9faa-10de913317fc",
                                                "text": "Er zaten opeens een hele lading kleine beestjes op de voorruit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c2c130e-1d3f-34d7-ba8f-6ee713d83a19",
                                        "entry_id": "1aed0717-f604-3c22-a653-f457169a10f6",
                                        "glosses": [
                                            "dim. tant. , een foutje in het programma"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04ae10e-3598-4c0f-995c-62a7604c804d",
                                                "sense_id": "1c2c130e-1d3f-34d7-ba8f-6ee713d83a19",
                                                "text": "Er zitten wat beestjes in de nieuwste versie van onze software."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
