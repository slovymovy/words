                                "sense_id": "a25e541a-903a-3c76-b280-e5fdb207409d",
                                "text": "A truebred nag, whenever walking or trotting, or if ever spoken to, should carry its tail right out."
                            },
                            {
                                "example_id": "1a308441-808c-4eba-b195-810395dcfbbc",
                                "sense_id": "a25e541a-903a-3c76-b280-e5fdb207409d",
                                "text": "While Mendel was able to start his experiments with truebred tall and truebred dwarf peas, neither of which had any trace of the other in its past breeding history, his results were naturally more uniform and positive than can possibly be attained with Beagles, large and small..."
                            },
                            {
                                "example_id": "d5da8ecf-0f99-4c6c-a751-37370490cb0c",
                                "sense_id": "a25e541a-903a-3c76-b280-e5fdb207409d",
                                "text": "Branigan on his mount, a truebred quarter-horse out of the legendary Rocking Bar Ranch, rode point."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d1bb428-1bc2-33c6-a7fd-fb2b70291dcc",
                        "entry_id": "7751c369-5510-3a5b-b3cc-6ea0b06bebe3",
                        "glosses": [
                            "Alternative form of true-bred.",
