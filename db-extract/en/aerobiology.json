                                    {
                                        "sense_id": "528ac984-ec1e-3dd1-a80b-7cc22d62076b",
                                        "entry_id": "c8ec25f3-9b34-33e2-a7dd-2b9a9938d567",
                                        "glosses": [
                                            "Branche de la biologie ayant pour objet l'étude des particules biologiques en suspension dans l'air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed9f181-6940-4af9-b6a5-f2aa26b2c412",
                                                "sense_id": "528ac984-ec1e-3dd1-a80b-7cc22d62076b",
                                                "text": "Le risque associé à de nombreuses procédures générant des aérosols n’est pas encore bien défini, et la compréhension par l’aérobiologie des procédures générant des aérosols pourrait évoluer."
                                            },
                                            {
                                                "example_id": "4d72a5e0-3b90-47b7-bcfa-667e5025cc73",
                                                "sense_id": "528ac984-ec1e-3dd1-a80b-7cc22d62076b",
                                                "text": "L’aérobiologie demeura pendant longtemps une sous-spécialité majeure de la pathologie végétale mais cette discipline a accusé une nette régression au cours de ces trois dernières décennies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
