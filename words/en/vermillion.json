                    "sense_id": "1027623d-e47d-37e2-b073-8fee54e17cc9",
                    "sense_definition": "Alternative spelling of <w>vermilion</w>; a vivid red to reddish-orange pigment or color.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist mixed a small amount of <w>vermillion</w> to paint the sunset.",
                            "target_lang_translations": {
                                "ru": "Художник смешал небольшое количество <w>киновари</w>, чтобы нарисовать закат."
                            }
                        },
                        {
                            "text": "She chose a bright shade of <w>vermillion</w> for her new dress.",
                            "target_lang_translations": {
                                "ru": "Она выбрала яркий оттенок <w>алого</w> для своего нового платья."
                            }
                        }
