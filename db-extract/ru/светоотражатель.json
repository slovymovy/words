                "senses": [
                    {
                        "sense_id": "5f93cc5c-3abd-3968-a19a-abe112387570",
                        "entry_id": "7ba641e2-7d89-32d5-a851-7f6eaf29c3ce",
                        "glosses": [
                            "отражатель света"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59750324-8142-47dd-acd3-5f515c1b146e",
                                "sense_id": "5f93cc5c-3abd-3968-a19a-abe112387570",
                                "text": "Светоотражатель — это простой и эффективный способ обеспечить свою видимость на дороге. Например, наличие светоотражателя у пешехода позволяет водителю заметить его на расстоянии = 150 м в ближнем свете фары = 400 м при включенном дальнем свете."
                            }
                        ]
                    }
                ],
