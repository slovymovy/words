                            {
                                "target_lang_word": "creton",
                                "target_lang_sense_clarification": "morceau de résidu de graisse de porc fondue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "800a13af-a662-36d0-a11c-8afc3a7363f4",
                    "sense_definition": "Een metalen sluiting om een boek dicht te houden.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude bijbel was voorzien van een zilveren <w>krap</w>.",
                            "target_lang_translations": {
                                "en": "The old bible was fitted with a silver <w>clasp</w>.",
                                "ru": "Старая библия была снабжена серебряной <w>застёжкой</w>.",
                                "fr": "La vieille bible était munie d'un <w>fermoir</w> en argent."
                            }
                        },
                        {
                            "text": "Hij maakte de <w>krap</w> voorzichtig los om het boek te openen.",
                            "target_lang_translations": {
                                "en": "He carefully undid the <w>clasp</w> to open the book.",
                                "ru": "Он осторожно расстегнул <w>застёжку</w>, чтобы открыть книгу.",
                                "fr": "Il défit délicatement le <w>fermoir</w> pour ouvrir le livre."
                            }
                        }
                    ],
                    "synonyms": [
                        "boekslot"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A metal fastening used to keep a book closed.",
                        "ru": "Металлическая застежка, удерживающая книгу закрытой.",
                        "fr": "Fermoir métallique servant à maintenir un livre fermé."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clasp",
                                "target_lang_sense_clarification": "metal fastening for a book"
