                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1323b96-a0a5-43be-9b2d-88929bab5a7e",
                                                "sense_id": "ee3cb77e-537c-3d51-bb65-8f2b1621f6bc",
                                                "text": "„Ihre Aufgabe, auch nur nominelle Unterwerfung von den Stämmen des nördlichen Yukatan zu erlangen, war schwer genug.“"
                                            },
                                            {
                                                "example_id": "b979d52d-bba4-49c5-b0e6-0141e3098fa0",
                                                "sense_id": "ee3cb77e-537c-3d51-bb65-8f2b1621f6bc",
                                                "text": "Dafür ist er nur nominell zuständig."
                                            },
                                            {
                                                "example_id": "f4c292d9-3945-4bf1-8310-ba3a1b04ddeb",
                                                "sense_id": "ee3cb77e-537c-3d51-bb65-8f2b1621f6bc",
                                                "text": "Die Bürgerbewegung hat 20 nominelle Mitglieder. Aber selbst gesehen haben wir noch keinen Vertreter von denen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50624a28-4654-337a-8ddc-cd975c743c7b",
                                        "entry_id": "91b54cbb-d614-3bd1-9c29-27f8c3d6f4ca",
                                        "glosses": [
                                            "auf den Nennwert bezogen, als Nettowert/Ziffernfolge ohne die Berücksichtigung anderer Einflussgrößen"
                                        ],
                                        "tags": [
                                            "Bankwesen",
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ddddc7a-b872-4a71-b58a-912f1b8faa89",
                                                "sense_id": "50624a28-4654-337a-8ddc-cd975c743c7b",
                                                "text": "Die nominelle Lebensdauer ist die mit 90 % Erlebenswahrscheinlichkeit erreichbare rechnerische Lebensdauer und wird in Betriebsstunden ausgedrückt."
                                            },
                                            {
                                                "example_id": "64246a33-40d7-4383-ac71-f9c4749681ff",
                                                "sense_id": "50624a28-4654-337a-8ddc-cd975c743c7b",
                                                "text": "Welcher nominelle Zinssatz ergibt bei kontinuierlicher Verzinsung einen effektiven Jahreszins von 3 %?"
                                            },
                                            {
                                                "example_id": "2772dfee-eea9-4d58-a49f-8a8e0a6770ca",
                                                "sense_id": "50624a28-4654-337a-8ddc-cd975c743c7b",
                                                "text": "Es handelte sich um eine nominelle Gehaltserhöhung von 5 %."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
