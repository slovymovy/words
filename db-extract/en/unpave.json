                        "glosses": [
                            "To remove the paving (especially in the form of paving stones, etc) from (a street); to cause to no longer be paved."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "daf14251-ede1-4ca7-aea5-d80bf3035b1e",
                                "sense_id": "a97f4724-7e58-373c-b1c7-21db70ef280f",
                                "text": "Women were occupied with their children in unpaving the streets, and carrying the great stones into the houses in order to shower down upon and crush the military. Enthusiasm was at its highest pitch. The military were routed and dispersed ..."
                            }
                        ]
                    }
