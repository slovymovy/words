                {
                    "sense_id": "3c5a4de2-d598-34a7-bb68-c6820191494a",
                    "sense_definition": "Personne qui habite près d'une autre ou qui se trouve à proximité.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "habitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon <w>voisin</w> est très gentil et m'aide souvent à porter mes courses.",
                            "target_lang_translations": {
                                "en": "My <w>neighbour</w> is very kind and often helps me carry my shopping.",
                                "ru": "Мой <w>сосед</w> очень добрый и часто помогает мне донести покупки.",
                                "nl": "Mijn <w>buurman</w> is erg aardig en helpt me vaak met het dragen van mijn boodschappen.",
                                "de": "Mein <w>Nachbar</w> ist sehr nett und hilft mir oft, meine Einkäufe zu tragen.",
                                "pl": "Mój <w>sąsiad</w> jest bardzo miły i często pomaga mi nosić zakupy.",
                                "it": "Il mio <w>vicino</w> è molto gentile e spesso mi aiuta a portare la spesa.",
                                "cs": "Můj <w>soused</w> je velmi hodný a často mi pomáhá nosit nákupy.",
                                "es": "Mi <w>vecino</w> es muy amable y a menudo me ayuda a llevar la compra.",
                                "zh": "我的<w>邻居</w>非常热心，经常帮我拎购物的东西。",
                                "tr": "<w>Komşum</w> çok nazik biri ve alışverişimi taşımama sık sık yardım ediyor."
                            }
                        },
                        {
                            "text": "Je dis toujours bonjour à mes <w>voisins</w> quand je les croise dans le hall.",
                            "target_lang_translations": {
                                "en": "I always say hello to my <w>neighbours</w> when I pass them in the hallway.",
                                "ru": "Я всегда здороваюсь с <w>соседями</w>, когда встречаю их в подъезде.",
                                "nl": "Ik zeg altijd gedag tegen mijn <w>buren</w> als ik ze in de hal tegenkom.",
                                "de": "Ich grüße meine <w>Nachbarn</w> immer, wenn ich ihnen im Hausflur begegne.",
                                "pl": "Zawsze witam się z moimi <w>sąsiadami</w>, kiedy mijam ich na klatce schodowej.",
                                "it": "Saluto sempre i miei <w>vicini</w> quando li incontro nell'androne.",
                                "cs": "Vždycky pozdravím své <w>sousedy</w>, když je potkám na chodbě.",
                                "es": "Siempre saludo a mis <w>vecinos</w> cuando me cruzo con ellos en el portal.",
                                "zh": "每次在楼道里碰到<w>邻居</w>，我都会跟他们打声招呼。",
                                "tr": "Apartmanın girişinde karşılaştığımda <w>komşularıma</w> her zaman merhaba derim."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voisin de palier",
                        "fête des voisins"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who lives nearby or is close to someone else.",
                        "ru": "Человек, который живёт рядом с другим человеком или находится поблизости от него.",
                        "nl": "Persoon die dichtbij een ander woont of zich in de nabijheid bevindt.",
                        "de": "Person, die in der Nähe einer anderen Person wohnt oder sich in unmittelbarer Nähe aufhält.",
                        "pl": "Osoba, która mieszka blisko innej osoby lub przebywa w jej pobliżu.",
                        "it": "Persona che abita accanto a un'altra persona o che si trova nelle vicinanze.",
                        "cs": "Člověk, který bydlí blízko jiného člověka nebo se nachází v jeho blízkosti.",
                        "es": "Persona que vive cerca de otra o que se encuentra en sus proximidades.",
                        "zh": "住在另一个人附近或与其相邻而居的人。",
                        "tr": "Yakınında veya hemen yanında oturan ya da bulunan kişi."
                    },
