                    {
                        "translation_id": "e75cb930-1579-4d95-9e49-bfe04f439107",
                        "source_entry_id": "c415f622-c32f-3c9d-b319-8ebd97230a69",
                        "target_lang_word": "Tunnel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tunnel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c43d381b-e98b-3486-a9c5-444005e975e7",
                                        "entry_id": "6ec1717f-94e9-3660-b33f-f94abf1f806c",
                                        "glosses": [
                                            "längere Unterführung, Durchbruch durch Bergmassive oder unter bebauten Flächen oder Gewässern für Verkehrswege"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe2b2386-ce60-4b6f-9467-a99bd8bf4b63",
                                                "sense_id": "c43d381b-e98b-3486-a9c5-444005e975e7",
                                                "text": "Hinter der Kurve fuhr der Zug in den Tunnel."
                                            },
                                            {
                                                "example_id": "17b049be-7d9c-4aa4-95d5-f0b1fafa8a3f",
                                                "sense_id": "c43d381b-e98b-3486-a9c5-444005e975e7",
                                                "text": "„Die Lüftung der Tunnel im Eisenbahnbetrieb vollzieht sich in kürzeren Tunneln, auch in stärkeren Steigungen meist in natürlicher Weise und ist abhängig von der Lage der Tunnelmündungen, den Wärmeunterschieden an diesen, ihrer gegenseitigen Höhenlage und der herrschenden Windrichtung.“"
                                            },
                                            {
                                                "example_id": "e9cc2275-6dd0-4cdc-abd2-6a908b1d8933",
                                                "sense_id": "c43d381b-e98b-3486-a9c5-444005e975e7",
                                                "text": "„Die größeren Inseln sind nun alle - außer die südlichste von ihnen - durch Tunnel miteinander verbunden worden, zu den übrigen gibt es Fährverbindungen.“"
                                            },
                                            {
                                                "example_id": "463b8631-5557-4e2d-8221-bb1e578c727c",
                                                "sense_id": "c43d381b-e98b-3486-a9c5-444005e975e7",
                                                "text": "„Ich lief durch den dunklen Gang in den Tunnel und dort in die erste Tür links.“"
                                            },
                                            {
                                                "example_id": "93a31a48-3a32-47d0-8f85-68acaab454dc",
                                                "sense_id": "c43d381b-e98b-3486-a9c5-444005e975e7",
                                                "text": "„Der Tunnel endet am westlichen Ende des Sees.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tunnel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29822df6-a9fc-3a83-b2e9-ec484f0db455",
                                        "entry_id": "1ffdda73-d8c1-3019-8c53-f766b44bde93",
                                        "glosses": [
                                            "mit einem Ring gefasste Ohrläppchenöffnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5589cb2-e25a-4f71-8aca-fb9770f266aa",
                                                "sense_id": "29822df6-a9fc-3a83-b2e9-ec484f0db455",
                                                "text": "Ich lasse mir jetzt einen Tunnel im Ohrläppchen anbringen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
