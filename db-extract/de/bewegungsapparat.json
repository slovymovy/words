                ],
                "senses": [
                    {
                        "sense_id": "6e9fbb48-37a8-3179-b765-962384b1e5b2",
                        "entry_id": "c70728fd-bd81-3f3a-8acc-a81e4aae0eeb",
                        "glosses": [
                            "sämtliche Organe (Skelett, Muskeln, Sehnen und so weiter), die dem Körper seine Form verleihen und für die Ausführung von Bewegungen notwendig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435051ce-17e9-4cfb-bcee-188ac3a47bab",
                                "sense_id": "6e9fbb48-37a8-3179-b765-962384b1e5b2",
                                "text": "„Der Bewegungsapparat unserer Vorfahren musste laufen, klettern, kämpfen, tragen und vieles mehr.“"
                            },
                            {
                                "example_id": "8bb769f5-6b61-4062-ab95-0386d042bde8",
                                "sense_id": "6e9fbb48-37a8-3179-b765-962384b1e5b2",
                                "text": "„Der Körper ist ein komplexes System, und es ist aus verschiedenen Teilsystemen zusammengesetzt: dem Bewegungsapparat, den Organen (von Osteopathen als viszerales System bezeichnet), Gefäß-, Hormon-, Immunund Nervensystem.“"
                            },
                            {
                                "example_id": "9da3e4ee-bb03-4a01-87da-1d75fdd3ea40",
                                "sense_id": "6e9fbb48-37a8-3179-b765-962384b1e5b2",
                                "text": "„Zum Stütz- und Bewegungsapparat gehören die obere Extremität, der Rumpf, die untere Extremität sowie Teile des Schädels.“"
                            },
                            {
                                "example_id": "25085016-f986-4f12-96f3-5b878c0b9e24",
                                "sense_id": "6e9fbb48-37a8-3179-b765-962384b1e5b2",
                                "text": "„Auch durch Umwelteinflüsse und intestinale Autointoxikation eingelagerte Säuren und Gifte können sich negativ auf den Bewegungsapparat auswirken.“"
                            },
                            {
                                "example_id": "18a3f7fe-738c-48f3-be78-1dd9bd397ff1",
                                "sense_id": "6e9fbb48-37a8-3179-b765-962384b1e5b2",
                                "text": "„Es gibt viele Gründe für Verspannungen und Verletzungen des Bewegungsapparates bei Pferden.“"
                            },
                            {
                                "example_id": "50aeeb66-b385-41dc-8ccc-296bbd97dd9e",
                                "sense_id": "6e9fbb48-37a8-3179-b765-962384b1e5b2",
                                "text": "„Der Bewegungsapparat ist ein komplexes Organsystem, dessen zentrale Funktion vorrangig eine mechanische Leistung ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
