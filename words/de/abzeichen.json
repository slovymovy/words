                    "sense_id": "a6f2fc65-683b-3a0a-a7c2-1c9ab28a19c1",
                    "sense_definition": "An der Kleidung getragenes Zeichen oder Symbol zur Kennzeichnung einer bestimmten Zugehörigkeit, Funktion oder eines Ranges.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emblem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Polizistin trug ein sichtbares <w>Abzeichen</w> an ihrer dunklen Uniform."
                        },
                        {
                            "text": "Alle aktiven Mitglieder des Vereins tragen bei offiziellen Treffen ein kleines <w>Abzeichen</w>."
                        }
                    ],
                    "synonyms": [
                        "Anstecker",
                        "Anstecknadel",
                        "Aufnäher",
                        "Erkennungszeichen"
                    ],
                    "common_phrases": [
