                        "glosses": [
                            "een uitgaansgelegenheid waar men kan dansen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ee0c6e-91ea-42e6-8fa0-211fb3693402",
                                "sense_id": "fd4284aa-3444-3fac-949b-b35bf70e10bf",
                                "text": "Op het festivalterrein staan verder overal emmers met sponzen erin en veel extra watertappunten. Een paraplu met stompe punt is toegestaan om als parasol te gebruiken. De organisatie plaatst extra blowers in de danstent en raadt mensen aan om daar regelmatig even af te gaan koelen."
                            },
                            {
                                "example_id": "0b011989-401b-4b2d-b021-b1bd91cb7d20",
                                "sense_id": "fd4284aa-3444-3fac-949b-b35bf70e10bf",
                                "text": "Airbnb heeft een aantal gebruikers die onlangs gezocht hebben naar een accommodatie in San Francisco een uitnodiging gestuurd om deel te nemen aan een nieuw experiment. Ze kunnen uitstapjes boeken waarbij ze rond worden geleid door bewoners van de stad. Airbnb biedt 3 of 5 daagse excursies aan gebaseerd op de interesse van gebruikers. Zo is het mogelijk de favoriete restaurants van locals te bezoeken of de hipste danstenten."
                            }
                        ]
                    }
