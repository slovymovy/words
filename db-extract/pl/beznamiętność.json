                    {
                        "translation_id": "bf39831f-829f-490a-af20-c1dd22cefad6",
                        "source_entry_id": "898bc274-09ed-3c7a-9ee5-8f47f2c8cafe",
                        "source_sense_id": "b1d9d1c8-92ca-3fa6-a708-91201de899fc",
                        "target_lang_word": "emotionlessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emotionlessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a70251a9-cbe8-3d7d-997a-91eb63d0638a",
                                        "entry_id": "bcab5740-9c6a-3b7a-848a-0f616884f0b7",
                                        "glosses": [
                                            "The property of being emotionless."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "836b46a1-c83d-4b96-9b30-e7c673bfb6f5",
                                                "sense_id": "a70251a9-cbe8-3d7d-997a-91eb63d0638a",
                                                "text": "She tells Dr. Sacks that she identifies with Data, an android on \"Star Trek\" whose emotionlessness belies a great curiosity and wistfulness about the human world."
                                            },
                                            {
                                                "example_id": "17acd320-2bf4-4c36-9166-0d067b6de508",
                                                "sense_id": "a70251a9-cbe8-3d7d-997a-91eb63d0638a",
                                                "text": "Despite their troubles, there is an emotionlessness about Lesser's characters -- you don't feel for them much."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b4a08a4-c714-486f-979a-3331f49653f1",
                        "source_entry_id": "898bc274-09ed-3c7a-9ee5-8f47f2c8cafe",
                        "source_sense_id": "b1d9d1c8-92ca-3fa6-a708-91201de899fc",
                        "target_lang_word": "indifference",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indifference",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8211dc7b-db8d-3724-99de-b6801dc58e8e",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "The state of being indifferent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d345c28b-656b-4d8a-8a21-7e08bc97b6b4",
                                                "sense_id": "8211dc7b-db8d-3724-99de-b6801dc58e8e",
                                                "text": "\"I do not care for them; I would not have them now,\" cried Lady Penrhyn; \"it is only your affection I care for. Do not suppose, for a moment, that I wish for the tables when you do not: oh, no! my only concern was for your indifference. But I am content if you tell me I was mistaken.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a27db88c-7273-307a-8052-46118583ce1b",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unbiased impartiality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unemotional apathy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe74535a-2673-4243-b1ba-a0c645804ac4",
                                                "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                                "text": "His daughter's indifference towards the sexist group made him wonder if she felt no empathy for the bullied."
                                            },
                                            {
                                                "example_id": "59bc99c5-eb46-4f3c-b268-f80e9563c626",
                                                "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                                                "text": "I wish the consequences of this moment for young women punctured the apparent indifference of so many men and boys I saw that day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f444eaa-e3f2-3a51-aa04-1b3a0d65594b",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "A lack of enthusiasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc199469-40a1-3131-9fcc-60afdb8c26b5",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Unconcerned nonchalance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b5fe27-4d36-434c-8cad-fdf51614a63c",
                                                "sense_id": "bc199469-40a1-3131-9fcc-60afdb8c26b5",
                                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9ba4cb-8ccf-3405-b6f5-330befd59489",
                                        "entry_id": "d92e49a0-4684-3b70-9265-2ca54d9c48b3",
                                        "glosses": [
                                            "Self-identity defined through the negation of difference, non-difference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41dda57-14d0-4802-9f64-925669bf2cc3",
                                                "sense_id": "9f9ba4cb-8ccf-3405-b6f5-330befd59489",
                                                "text": "\"I call reason absolute reason, or reason insofar as it is conceived as the total indifference of the subjective and objective.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8026fa8c-2c10-4965-be1f-c9b43fb49cba",
                        "source_entry_id": "898bc274-09ed-3c7a-9ee5-8f47f2c8cafe",
                        "source_sense_id": "b1d9d1c8-92ca-3fa6-a708-91201de899fc",
                        "target_lang_word": "stoicism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoicism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40b2df25-aed5-31a2-a005-d04ea5caa94f",
                                        "entry_id": "13a897c1-006c-3b33-8550-68813af399c7",
                                        "glosses": [
                                            "A school of philosophy popularized during the Roman Empire that emphasized reason as a means of understanding the natural state of things, or logos, and as a means of freeing oneself from emotional distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                        "entry_id": "13a897c1-006c-3b33-8550-68813af399c7",
                                        "glosses": [
                                            "A real or pretended indifference to pleasure or pain; insensibility; impassiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf8f39ac-771a-456d-ba80-0549918a8f8c",
                                                "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                                "text": "Jones’ sad eyes betray a pervasive pain his purposefully spare dialogue only hints at, while the perfectly cast Brolin conveys hints of playfulness and warmth while staying true to the craggy stoicism at the character’s core."
                                            },
                                            {
                                                "example_id": "39925f7d-3d2a-4f9c-b58b-eb62c652b614",
                                                "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                                "text": "Although very distant from the lives of her subjects – she never went to school and had only the most fleeting experiences of being on equal terms with anyone – she grew into a much respected figure, admired for her stoicism and diligence"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bbcd082-8c08-4741-ab89-40bb411f8f99",
                        "source_entry_id": "898bc274-09ed-3c7a-9ee5-8f47f2c8cafe",
                        "source_sense_id": "b1d9d1c8-92ca-3fa6-a708-91201de899fc",
                        "target_lang_word": "insensibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insensibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f604c9c-93c7-349e-b5ec-2dbacfab2c82",
                                        "entry_id": "bf96d953-b871-3d08-a0d1-a4f39d6eab60",
                                        "glosses": [
                                            "The property of being insensible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0da3f69-2aa0-4ef8-9fe5-caacf043aa1d",
                                                "sense_id": "0f604c9c-93c7-349e-b5ec-2dbacfab2c82",
                                                "text": "What a deal of grief, care, and other harmful excitement does a healthy dulness and cheerful insensibility avoid!"
                                            },
                                            {
                                                "example_id": "aa809952-9d34-4bcf-ba05-fff9c7b4c425",
                                                "sense_id": "0f604c9c-93c7-349e-b5ec-2dbacfab2c82",
                                                "text": "When I recovered I found myself lying on a clean, comfortable bed, while there bent over me a physician and an elderly woman. I learned that I had been found early in the morning in the rear of the house in a state of insensibility, and that the owner of the place […] had caused me to be brought in and placed on the bed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "986f6c8e-c28f-431e-b69f-bfb36e245393",
                        "source_entry_id": "898bc274-09ed-3c7a-9ee5-8f47f2c8cafe",
                        "source_sense_id": "b1d9d1c8-92ca-3fa6-a708-91201de899fc",
                        "target_lang_word": "insensibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insensibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                        "entry_id": "32a46d26-dae5-3ce0-8300-27dff9220d89",
                                        "glosses": [
                                            "Absence de sensibilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9336e50-3fa0-4984-ab9e-1d9ae5c96b97",
                                                "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                                "text": "On a dit une grande vérité lorsqu’on a posé en principe que toute la science du jockey consistait à faire supporter tout son poids par la bouche de son cheval ; mais on n’a pas parlé de l’insensibilité des barres que l’on produisait par cette manœuvre, […]."
                                            },
                                            {
                                                "example_id": "4177c0cd-64ec-423d-b623-a292dad2885c",
                                                "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                                "text": "— Deux sortes de personnes contractent nécessairement beaucoup d’insensibilité : les chirurgiens, les prêtres. A voir toujours souffrir et mourir, on meurt peu à peu soi-même dans les facultés sympathiques."
                                            },
                                            {
                                                "example_id": "083e7a96-bb1b-46a1-acb6-54c99847616e",
                                                "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                                "text": "L’examen par ce praticien révéla sans tarder sur le corps de Thomas le signe d’un pacte infernal, ces fameuses plaques d’insensibilité tenues de nos jours pour pathologiques, où les opérateurs pouvaient à leur aise enfoncer des épingles sans obtenir de cri ou de soubresaut du patient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
