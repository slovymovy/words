        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "85c8ed05-2e72-3af9-8a85-8a5d2aa933a4",
                "word": "overwatch",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a7ea31af-1844-3279-8511-51a45beecf8d",
                        "entry_id": "85c8ed05-2e72-3af9-8a85-8a5d2aa933a4",
                        "glosses": [
                            "The supervision of one unit or vehicle by another while the supervised unit is firing or moving."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8fac2d39-7a7b-47d8-9880-dfc86fcda0f6",
                                "sense_id": "a7ea31af-1844-3279-8511-51a45beecf8d",
                                "text": "At a further and undefined point in the future, the American force would shrink to about seven and later five brigades — all involved in overwatch missions."
                            },
                            {
                                "example_id": "41a3da5a-8187-4e4b-9d01-9e74de724b42",
                                "sense_id": "a7ea31af-1844-3279-8511-51a45beecf8d",
                                "text": "“It’s 21st-century warfare,” says another team member, Doshch. And although some of the overwatch can be conducted remotely in bunkers, most of the drone teams (typically four-strong, they say) have to work about 1km behind the front."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
