                "senses": [
                    {
                        "sense_id": "d700975a-abcd-3833-a669-14e0eec7de14",
                        "entry_id": "d68c89c5-1357-37b0-b910-82c903189594",
                        "glosses": [
                            "Steuer, die auf bestimmte Kapitalerträge erhoben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "608b5e93-5d34-4c0e-b298-a9fddd635b3b",
                                "sense_id": "d700975a-abcd-3833-a669-14e0eec7de14",
                                "text": "Die Kapitalertragssteuer ist eine Erhebungsform der Einkommensteuer."
                            },
                            {
                                "example_id": "613a14d4-ebf0-4732-86b2-fa4809468b67",
                                "sense_id": "d700975a-abcd-3833-a669-14e0eec7de14",
                                "text": "Die Kapitalertragssteuer wird nun doch erhöht."
                            },
                            {
                                "example_id": "d47a6821-d951-4d1c-a6ab-21b529ac2b19",
                                "sense_id": "d700975a-abcd-3833-a669-14e0eec7de14",
                                "text": "„Daher spricht sich dessen Präsident, Bank-Austria-Chef Robert Zadrazil, für eine Befreiung von der Kapitalertragssteuer (KESt) für Investments in ökologische und ethische Anlageformen aus – wie es auch im türkis-grünen Regierungsprogramm vorgesehen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
