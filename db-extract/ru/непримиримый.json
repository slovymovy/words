                "senses": [
                    {
                        "sense_id": "160eaf99-e0b3-3a60-a144-c5d69478d1b6",
                        "entry_id": "a4aa7a84-fb43-371b-a7de-27968a3e8071",
                        "glosses": [
                            "irreconcilable, unappeasable, implacable"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7903a0c1-1d34-4762-ad34-27b1e7dcbfd7",
                                "sense_id": "160eaf99-e0b3-3a60-a144-c5d69478d1b6",
                                "text": "непримири́мая борьба́",
                                "translation": "uncompromising struggle; war to the knife",
                                "english": "uncompromising struggle; war to the knife"
                            },
                            {
                                "example_id": "7ece3b58-4550-42fc-87e2-c0121350a600",
                                "sense_id": "160eaf99-e0b3-3a60-a144-c5d69478d1b6",
                                "text": "вести непримири́мую борьбу́ (про́тив)",
                                "translation": "to wage a relentless struggle (against)",
                                "english": "to wage a relentless struggle (against)"
                            },
                            {
                                "example_id": "c3d87836-0529-4423-b3ef-6dc8a490ad72",
                                "sense_id": "160eaf99-e0b3-3a60-a144-c5d69478d1b6",
                                "text": "Тепе́рь он упо́рно выде́рживал при́стальный взгляд Щавинского, и в его́ ры́жих звери́ных глаза́х фельетони́ст уви́дел пла́мя непримири́мой, нечелове́ческой не́нависти.",
                                "translation": "He held out stubbornly against Schavinsky’s steady look, and in his yellow animal eyes the journalist noticed a flame of implacable, inhuman hatred.",
                                "english": "He held out stubbornly against Schavinsky’s steady look, and in his yellow animal eyes the journalist noticed a flame of implacable, inhuman hatred."
                            }
                        ]
                    },
                    {
                        "sense_id": "283de8e3-52ff-3b46-ba63-f926aaec0498",
                        "entry_id": "a4aa7a84-fb43-371b-a7de-27968a3e8071",
                        "glosses": [
                            "incompatible, irreconcilable"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "732fa42e-d4d0-42a3-8e0c-c7d914f30ff3",
                                "sense_id": "283de8e3-52ff-3b46-ba63-f926aaec0498",
                                "text": "непримири́мые противоре́чия",
                                "translation": "irreconcilable contradictions",
                                "english": "irreconcilable contradictions"
                            }
                        ]
                    }
