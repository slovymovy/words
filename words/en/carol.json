                                "target_lang_word": "villancico",
                                "target_lang_sense_clarification": "canción tradicional de celebración navideña"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d7fe6dc-b896-3bf2-8a75-be54a00abb47",
                    "sense_definition": "A ballad or song of joy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "joyful_song",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning <w>carol</w> of the birds woke me up early in the spring.",
                            "target_lang_translations": {
                                "ru": "Утренняя <w>песнь</w> птиц разбудила меня рано весной.",
                                "zh": "春天里，鸟儿清晨的<w>欢歌</w>很早就把我叫醒了。",
                                "es": "El <w>canto</w> matutino de los pájaros me despertó temprano en primavera."
                            }
                        },
                        {
                            "text": "She wrote a sweet <w>carol</w> to celebrate the arrival of the harvest.",
                            "target_lang_translations": {
                                "ru": "Она написала милую <w>радостную песню</w>, чтобы отпраздновать начало сбора урожая.",
                                "zh": "她写了一首甜美的<w>颂歌</w>，庆祝丰收的到来。",
                                "es": "Ella escribió un dulce <w>canto</w> para celebrar la llegada de la cosecha."
                            }
                        }
                    ],
                    "synonyms": [
                        "song",
                        "ballad",
                        "lay"
                    ],
                    "antonyms": [
                        "dirge",
                        "lament"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
