                    {
                        "translation_id": "5df60aed-00fa-4fcc-9266-e3c1c7b54687",
                        "source_entry_id": "5c62ce24-d5be-344e-aa61-ebe8fe7b4154",
                        "source_sense_id": "4418f828-844e-3a8c-a361-c26483788dcf",
                        "source_sense_description": "pathological liar",
                        "target_lang_word": "Pseudologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pseudologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07b7aebe-556e-3ee7-a2cc-6bbd168e1bda",
                                        "entry_id": "77c4c3e6-2f55-35b4-aeb9-d4e0090c3f9b",
                                        "glosses": [
                                            "Person, welche Mangels eigener Erlebnisse oder Kenntnisse, Lebensgeschichten oder Fakten ausdenkt und anderen erzählt, als wären sie real (pathologisches Lügen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c114a83-d9ac-4572-a436-da404ad96fbd",
                                                "sense_id": "07b7aebe-556e-3ee7-a2cc-6bbd168e1bda",
                                                "text": "„‚Pseudologen‘ werden unter Fachleuten Menschen genannt, bei denen das Lügen zwanghaft ist.“"
                                            },
                                            {
                                                "example_id": "f3e90776-5ebf-40a7-b4f2-0ebf58f483c7",
                                                "sense_id": "07b7aebe-556e-3ee7-a2cc-6bbd168e1bda",
                                                "text": "„In der Sucht, eine Rolle zu spielen, die ihm das wirkliche Leben versagt, spielt der Pseudologe anderen und sich selbst Theater vor.“"
                                            },
                                            {
                                                "example_id": "1e432a12-60bd-48e5-9442-f16ba9e2f706",
                                                "sense_id": "07b7aebe-556e-3ee7-a2cc-6bbd168e1bda",
                                                "text": "„Auf die ganz großen Lügen, Lebenslügen und Doppelleben, zielten echte Pseudologen gar nicht ab.“"
                                            },
                                            {
                                                "example_id": "4d42ae68-49b1-4a2f-8dd5-3ae05f6f5ec5",
                                                "sense_id": "07b7aebe-556e-3ee7-a2cc-6bbd168e1bda",
                                                "text": "„Wahr ist wohl, dass Pseudologen aus einer Art Schutzbedürfnis heraus handeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
