                    },
                    {
                        "translation_id": "35f02656-c519-4aa5-8a47-7a94d40e06c1",
                        "source_entry_id": "a81e6b11-4ecc-3404-87e5-2778a5c522ce",
                        "source_sense_description": "kind of fruit",
                        "target_lang_word": "ты́ква",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ты́ква",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "27b46dae-3fb8-3e17-8b71-72de737f5a8b",
                                        "entry_id": "901d2b3c-a80e-36cb-871a-5e3ae921716a",
                                        "glosses": [
                                            "ботан. овощное растение семейства тыквенных (лат. Cucurbita), имеющее стелющийся стебель и крупные плоды круглой, овальной или иной формы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10892f9-a22b-4c12-93f6-d274fb03f15c",
                                                "sense_id": "27b46dae-3fb8-3e17-8b71-72de737f5a8b",
                                                "text": "Основную площадь участка занимал огород ― грядки, на которых росли тыквы и кабачки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bc9ea33-b440-3bc8-be68-bbc33e7ab667",
                                        "entry_id": "901d2b3c-a80e-36cb-871a-5e3ae921716a",
                                        "glosses": [
                                            "плод такого растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "233d039f-5b8e-4a24-abce-2a59f8691e18",
                                                "sense_id": "6bc9ea33-b440-3bc8-be68-bbc33e7ab667",
                                                "text": "Особенно славились его нежные и сладкие тыквы, чрезвычайно больших размеров, доходившие иногда до пуда веса."
                                            },
                                            {
                                                "example_id": "5a159d36-6216-44fb-a915-cca3f62f0e40",
                                                "sense_id": "6bc9ea33-b440-3bc8-be68-bbc33e7ab667",
                                                "text": "Ярко-оранжевая тыква лежала на прилавке среди переросших кабачков, пучков редиски и остро пахнущей зелени."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14fbf425-36d5-3443-89a2-201b7df6f044",
                                        "entry_id": "901d2b3c-a80e-36cb-871a-5e3ae921716a",
                                        "glosses": [
                                            "кулин. какое-либо блюдо, приготовленное из такого плода (плодов)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98eb65cf-2222-4ae5-a85e-c452f45e52e5",
                                                "sense_id": "14fbf425-36d5-3443-89a2-201b7df6f044",
                                                "text": "Наталья кормила детей печёной тыквой .."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ты́ква",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "434d74fa-59bf-3b92-ac33-802cc1470e71",
                                        "entry_id": "f066966e-f1f9-3e38-a800-aa4a49b22012",
                                        "glosses": [
                                            "разг., пренебр. голова"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4196b7-2f1a-4284-90de-d5118a903794",
                                                "sense_id": "434d74fa-59bf-3b92-ac33-802cc1470e71",
                                                "text": "У нас могут просто подойти, дать в тыкву и забрать мобилу."
                                            }
                                        ]
                                    }
                                ]
                            },
