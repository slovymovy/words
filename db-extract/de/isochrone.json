                "senses": [
                    {
                        "sense_id": "a59f58c3-5b59-3e3c-b6f7-9b683a90c0da",
                        "entry_id": "038165d9-b0d4-3c9b-9d7b-c454e8153353",
                        "glosses": [
                            "die Verbindungslinie zwischen Orten, an denen ein Naturereignis, wie ein Erdbeben oder eine Überflutung, zum gleichen Zeitpunkt auftrat"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "fbd768fa-1b27-43d3-8a84-479c843e6784",
                                "sense_id": "a59f58c3-5b59-3e3c-b6f7-9b683a90c0da",
                                "text": "„Isochronen zeigen die Ausbreitung des Tsunami anhand von äquidistanten Zeitintervallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6e2a88a2-3f7e-38e3-897d-40b9b72af252",
                        "entry_id": "038165d9-b0d4-3c9b-9d7b-c454e8153353",
                        "glosses": [
                            "die Verbindungslinie zwischen Orten, die von einem Standpunkt aus in der gleichen Zeit erreichbar sind"
                        ],
                        "tags": [
                            "Verkehrskarte"
                        ],
                        "examples": [
                            {
                                "example_id": "e95ca645-5ed2-45ac-93ef-ee2741cc4a90",
                                "sense_id": "6e2a88a2-3f7e-38e3-897d-40b9b72af252",
                                "text": "„Auf Grundlage der räumlichen RRG GIS Datenbasis transeuropäischer Verkehrsnetze sind im Rahmen eines Eigenforschungsprojektes jeweils 30-, 60-, 90- und 120 Minuten Isochronen für Berlin im Eisenbahn- und Straßennetz berechnet worden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "843ffb56-3202-3433-bbf2-fc52c6f1a1f3",
                        "entry_id": "038165d9-b0d4-3c9b-9d7b-c454e8153353",
                        "glosses": [
                            "die Resultate der Messung der Isotopenverhältnisse werden als Isochronenplot dargestellt."
                        ],
                        "tags": [
                            "radiometrische Datierung von Mineralien"
                        ],
                        "examples": [
                            {
                                "example_id": "87c818b6-ae4c-4b4c-b024-5a73bf05cf14",
                                "sense_id": "843ffb56-3202-3433-bbf2-fc52c6f1a1f3",
                                "text": "„Die Steigung der Isochrone ist dann ein Maß für das Alter der Probe.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
