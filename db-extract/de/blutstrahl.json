                        "examples": [
                            {
                                "example_id": "b4b9ab0c-633a-40df-a177-9e345f4b021b",
                                "sense_id": "21aeff22-9525-33bc-ac24-5d24421c87f9",
                                "text": "„Die rechte Schlagader des Deputys platzte, ein Blutstrahl schoss durch den Raum, klatschte an die Wand und rann daran herunter.“"
                            },
                            {
                                "example_id": "014805bf-a6d8-47a2-9933-f757e07ff576",
                                "sense_id": "21aeff22-9525-33bc-ac24-5d24421c87f9",
                                "text": "„Der Mann, der sein rechtes Handgelenk gehalten hatte, fiel nach hinten, und ein dicker schwarzer Blutstrahl schoss in das unstete Licht.“"
                            }
                        ],
