                        "glosses": [
                            "The bunya pine, Araucaria bidwillii, native to Queensland."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de31d3ba-1437-47ce-8255-d4be98b8bf48",
                                "sense_id": "41b6020f-dbd7-3549-9b9b-d0ca70a9fcea",
                                "text": "The palm takes the place of the eucalyptus to a certain extent, and the woods teem with the bunya-bunya, — a very desirable and ornamental tree, which belongs to the pine family."
                            },
                            {
                                "example_id": "1b792eb2-3455-4dbd-9d7f-19b8ee0bec4e",
                                "sense_id": "41b6020f-dbd7-3549-9b9b-d0ca70a9fcea",
                                "text": "Her three favourite bunyah-bunyah nut trees were destroyed last year to make way for more grazing land for sheep and other animals whose cloven hooves destroyed the delicate topsoil and laid bare the earth."
                            },
                            {
                                "example_id": "d30d6d23-e62c-479c-a8e0-186d3b5f0bd6",
                                "sense_id": "41b6020f-dbd7-3549-9b9b-d0ca70a9fcea",
                                "text": "Bunya nuts, which come from a conifer in the genus Araucaria, are an example of a plant that fruited so heavily that large stores were set aside."
                            }
                        ]
                    }
