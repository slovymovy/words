{
    "word_family": [
        "dessin",
        "dessinateur",
        "dessinatrice",
        "redessiner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd599e81-d200-3ef6-971b-fd954d7927d2",
                    "sense_definition": "Représenter un objet, une personne ou une figure à l'aide de traits ou de contours.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "arts_graphiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon petit frère aime <w>dessiner</w> des animaux fantastiques dans son cahier d'école."
                        },
                        {
                            "text": "L'artiste <w>dessine</w> un portrait au crayon avec une grande précision."
                        }
                    ],
                    "synonyms": [
                        "croquer",
                        "esquisser",
                        "tracer"
                    ],
                    "common_phrases": [
                        "dessiner au crayon",
                        "apprendre à dessiner"
                    ]
                },
                {
                    "sense_id": "ffc00a10-58ae-3596-9a2a-d21c069548a5",
                    "sense_definition": "Concevoir la forme ou les plans d'un objet, d'un vêtement ou d'un édifice.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte passe plusieurs semaines à <w>dessiner</w> les plans du futur bâtiment public."
                        },
                        {
                            "text": "Cette styliste talentueuse <w>dessine</w> une collection originale pour le défilé de mode."
                        }
                    ],
                    "synonyms": [
                        "concevoir",
                        "projeter"
                    ],
                    "common_phrases": [
                        "dessiner les plans",
                        "dessiner une collection"
                    ]
                },
                {
                    "sense_id": "f1bd9d5b-9f88-3a78-a99e-b3bb14dd4aeb",
                    "sense_definition": "Épouser ou faire ressortir visiblement les contours et la silhouette.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "forme_contour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette robe élégante <w>dessine</w> parfaitement la silhouette élancée de la comédienne."
                        },
                        {
                            "text": "Le pantalon ajusté <w>dessinait</w> les jambes du danseur sous les projecteurs."
                        }
                    ],
                    "synonyms": [
                        "mouler",
                        "souligner"
                    ],
                    "common_phrases": [
                        "dessiner la silhouette",
                        "dessiner les formes"
                    ]
                },
                {
                    "sense_id": "45f837ca-d73f-38b3-ae4b-f2179c62e4f2",
                    "sense_definition": "Apparaître ou se détacher nettement sur un fond, en parlant d'une forme ou d'un profil.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chaîne de montagnes commence à se <w>dessiner</w> à l'horizon au lever du jour."
                        },
                        {
                            "text": "À travers la brume, les mâts du navire se <w>dessinaient</w> peu à peu."
                        }
                    ],
                    "synonyms": [
                        "apparaître"
                    ],
                    "antonyms": [
                        "disparaître",
                        "s'effacer"
                    ],
                    "common_phrases": [
                        "se dessiner à l horizon",
                        "se dessiner dans l ombre"
                    ]
                },
                {
                    "sense_id": "0237d83a-315e-31f4-a9c6-dd0ce851efe5",
                    "sense_definition": "Commencer à prendre une forme reconnaissable ou à se préciser, en parlant d'une situation ou d'une tendance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une majorité favorable aux réformes commence à se <w>dessiner</w> lors des débats."
                        },
                        {
                            "text": "Après de longues discussions, les contours d'un accord durable se <w>dessinent</w> enfin."
                        }
                    ],
                    "synonyms": [
                        "émerger"
                    ],
                    "common_phrases": [
                        "tendance qui se dessine",
                        "accord qui se dessine"
                    ]
                }
            ]
        }
    ]
}