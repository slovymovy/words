                    {
                        "form_id": "022bff92-a37a-4ede-aa17-fd577d86e51d",
                        "entry_id": "5fadff18-44a3-3c35-9738-9f521b4b1816",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mietwägen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                        "entry_id": "5fadff18-44a3-3c35-9738-9f521b4b1816",
                        "glosses": [
                            "Fahrzeug, das man gegen eine Gebühr vorübergehend als Selbstfahrer nutzen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c7d5cc-ce5a-4b19-9057-17e0e09d511d",
                                "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                "text": "Wenn das eigene Fahrzeug in die Werkstatt muss, braucht man womöglich einen Mietwagen."
                            },
                            {
                                "example_id": "ffdfc583-3513-45b3-89ae-237f0bedc556",
                                "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                "text": "„Einige kamen im Mietwagen oder mit dem Taxi von der Bahnstation im Tal herauf.“"
                            },
                            {
                                "example_id": "ac64183c-c78c-4a4f-bded-6bbcb89a3e9e",
                                "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                "text": "„Touristen steigen aus ihren kleinen weißen Mietwagen, kaufen sich Süßigkeiten und Hotdogs.“"
                            },
                            {
                                "example_id": "833da346-8d14-4535-af74-8b5f476ce9d7",
                                "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                "text": "„Mit dem Mietwagen brauchen wir sieben Stunden Richtung Trikala, der Weg ist nicht schwer zu finden: immer nach Norden.“"
                            },
                            {
                                "example_id": "5439c30f-04ae-48bc-822b-640b9ffb16b1",
                                "sense_id": "3ff8f220-068e-3aa7-9189-d96f687cdd1f",
                                "text": "„Ich aß also zu Mittag, kleidete mich dann an und fuhr in einem Mietwagen zum Palazzo Matalone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
