    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "57f5e0bc-9996-3728-8f7d-68235e111190",
                    "sense_definition": "Completely baffled, confused, or puzzled by something that is difficult to understand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confused",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists were utterly <w>perplexed</w> by the strange results of the experiment.",
                            "target_lang_translations": {
                                "de": "Die Wissenschaftler waren von den seltsamen Ergebnissen des Experiments völlig <w>ratlos</w>."
                            }
                        },
                        {
                            "text": "He wore a <w>perplexed</w> expression when trying to read the complicated instructions.",
                            "target_lang_translations": {
                                "de": "Er machte einen <w>perplexen</w> Eindruck, als er versuchte, die komplizierte Anleitung zu lesen."
                            }
                        }
                    ],
                    "synonyms": [
                        "baffled",
                        "bewildered",
                        "confused",
                        "puzzled"
                    ],
                    "antonyms": [
                        "clearheaded"
                    ],
                    "common_phrases": [
                        "perplexed expression",
                        "perplexed look"
                    ],
                    "target_lang_definitions": {
                        "de": "Völlig verwirrt, ratlos oder erstaunt über etwas, das schwer zu verstehen ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ratlos",
                                "target_lang_sense_clarification": "keine Erklärung oder Lösung wissend"
                            },
                            {
                                "target_lang_word": "verblüfft",
                                "target_lang_sense_clarification": "durch etwas Unerwartetes oder Unverständliches überrascht"
                            },
                            {
                                "target_lang_word": "perplex",
                                "target_lang_sense_clarification": "überrascht und verwirrt"
                            },
                            {
                                "target_lang_word": "verdutzt",
                                "target_lang_sense_clarification": "leicht irritiert und erstaunt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58655f04-c864-3460-861a-68116cd9f840",
                    "sense_definition": "Intricately entangled, complicated, or labyrinthine in structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We lost our way inside the <w>perplexed</w> network of narrow forest trails.",
                            "target_lang_translations": {
                                "de": "Wir verirrten uns in dem <w>verschlungenen</w> Netz aus schmalen Waldwegen."
                            }
                        },
                        {
                            "text": "The explorer ventured into the <w>perplexed</w> passages of the ancient underground cavern.",
                            "target_lang_translations": {
                                "de": "Der Forscher wagte sich in die <w>labyrinthischen</w> Gänge der uralten unterirdischen Höhle."
                            }
                        }
                    ],
                    "synonyms": [
                        "entangled",
                        "intricate",
                        "labyrinthine"
                    ],
                    "antonyms": [
                        "simple",
                        "straightforward"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to describe physical spaces or structures."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Kompliziert verschlungen, unübersichtlich oder labyrinthisch aufgebaut (gehoben oder veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
