                        "entry_id": "edbd6929-d28b-38ed-bec5-c0bec4a5c93f",
                        "glosses": [
                            "bestimmte Eigenschaften aufweisende Schraube (scharfes Gewinde, spitzer Kopf, …) zur Verwendung bei Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda345da-5f62-47e8-984f-08462d0c3708",
                                "sense_id": "daa2a73f-f6df-316f-b984-417a0a72b60c",
                                "text": "„Das zusammengesetzte Substantiv verlangt vom Leser einen reichen Schatz an Erfahrung. Er weiß, dass eine Messingschraube aus Messing, eine Holzschraube aber nicht aus Holz gemacht, sondern für Holz gedacht ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
