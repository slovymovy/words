                                "target_senses": [
                                    {
                                        "sense_id": "db8bd8bd-2d28-3d89-ae3f-5d3c37899b23",
                                        "entry_id": "1a403997-0922-31bf-8a81-98c4279c37e9",
                                        "glosses": [
                                            "лингв. слово иностранного языка с переводом на родной язык"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b80a7c-32f8-4222-b1eb-27f62dbc2ba4",
                                                "sense_id": "db8bd8bd-2d28-3d89-ae3f-5d3c37899b23",
                                                "text": "А знаете, чем он теперь особенно занимается?.. французские вокабулы наизусть учит."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e550d2ad-6070-38d5-9ca8-a0b8f9c97557",
                                        "entry_id": "1a403997-0922-31bf-8a81-98c4279c37e9",
                                        "glosses": [
                                            "лингв., слово или словосочетание, являющееся предметом словарной статьи и стоящее в её заголовке; заголовок словарной статьи"
                                        ],
                                        "tags": [
                                            "лексикогр."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "068448aa-8e8e-4130-aef5-e589207becfe",
                                                "sense_id": "e550d2ad-6070-38d5-9ca8-a0b8f9c97557",
                                                "text": "Быстро все поняли их пригодность не только для вокабул и толкований словаря, но и для иных уединенных нужд, непосредственно со словарем не связанных."
                                            }
                                        ]
