                "senses": [
                    {
                        "sense_id": "2c3953d2-9d3a-300b-b34a-b6d080b97a55",
                        "entry_id": "50f0e465-0a1c-3f06-aedc-c920c2267540",
                        "glosses": [
                            "ballyhoo, fuss"
                        ],
                        "tags": [
                            "dated",
                            "neuter",
