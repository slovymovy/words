                ],
                "senses": [
                    {
                        "sense_id": "41c22150-1a1e-30cf-bbbf-ff44bf1230cf",
                        "entry_id": "e587ddcf-fd2e-3495-9525-6f235c07b495",
                        "glosses": [
                            "Endteil einer gerauchten Zigarette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7d38911-db91-4d5c-a40f-5012e2d32feb",
                                "sense_id": "41c22150-1a1e-30cf-bbbf-ff44bf1230cf",
                                "text": "Auf der Straße kann man viele Zigarettenstummel finden."
                            },
                            {
                                "example_id": "7c1a9cfa-e9ea-4118-bb32-9ee8de24af20",
                                "sense_id": "41c22150-1a1e-30cf-bbbf-ff44bf1230cf",
                                "text": "„Der Einarmige warf den Zigarettenstummel außenbords.“"
                            },
                            {
                                "example_id": "663e21a0-0b52-417a-9fc1-329082512c8f",
                                "sense_id": "41c22150-1a1e-30cf-bbbf-ff44bf1230cf",
                                "text": "„Ich spuckte den brennenden Zigarettenstummel auf den Teppich, sah, wie die Glut sich verteilte, kleine, schwarze Löcher brannte.“"
                            },
                            {
                                "example_id": "220990c3-1194-4924-89cf-49bc778bdd1e",
                                "sense_id": "41c22150-1a1e-30cf-bbbf-ff44bf1230cf",
                                "text": "„Ihre Zigarettenstummel liegen im Windfang, auf der Kellertreppe und auf den Gartenbeeten.“"
                            },
                            {
                                "example_id": "741daeec-5ff0-46a0-8401-fa930a41d163",
                                "sense_id": "41c22150-1a1e-30cf-bbbf-ff44bf1230cf",
                                "text": "„Der Fahrer versuchte einen Zigarettenstummel, der ihm braun und feucht an der Oberlippe klebte, anzuzünden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
