                        "glosses": [
                            "de geestelijke en religieuze zorg die iemand krijgt van een geestelijke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b77f6d1b-1577-491c-8986-31217ea1ad09",
                                "sense_id": "f75758b0-bf8a-3464-8747-47c231261ffe",
                                "text": "Wil ik een computer die mijn gevoelsleven ontleedt? Nu blijft het nog bij signaleren. Over een paar jaar zullen de computers ons aanzetten - dwingen - tot een gezonder bestaan. Het begint met ons fysiek welzijn en eindigt met zielszorg."
                            },
                            {
                                "example_id": "aad4390a-42f8-4fd9-b4c1-03a508379dfd",
                                "sense_id": "f75758b0-bf8a-3464-8747-47c231261ffe",
                                "text": "Van Buuren: Ín de leemte die is ontstaan na de dood van God, is voor een deel voorzien door de zielszorg, en een deel door de filosofie. Leren leven; daar gaat het uiteindelijk allemaal over.'"
                            }
                        ]
                    }
