                                "target_senses": [
                                    {
                                        "sense_id": "56666974-fcb2-3349-8fe8-7347c23e68e5",
                                        "entry_id": "8912bc26-d061-344d-949a-c438658e8283",
                                        "glosses": [
                                            "die Geopolitik betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "369bba99-01d7-43b5-a725-5156cbd3b39f",
                                                "sense_id": "56666974-fcb2-3349-8fe8-7347c23e68e5",
                                                "text": "Die Türkei würde eine wichtige geopolitische Rolle für die Europäische Union spielen, wenn sie in diese aufgenommen würde."
                                            },
                                            {
                                                "example_id": "e36ff3b9-26d1-4988-998f-01fbf93d9273",
                                                "sense_id": "56666974-fcb2-3349-8fe8-7347c23e68e5",
                                                "text": "„Von damals her stammen die Entfremdung und das Misstrauen, die den Subkontinent bis heute prägen und zu einer geopolitischen Gefahrenzone machen.“"
                                            },
                                            {
                                                "example_id": "94cfa7c3-db3b-4180-8ee5-2379b2439f77",
                                                "sense_id": "56666974-fcb2-3349-8fe8-7347c23e68e5",
                                                "text": "„Kabul erkennt bis heute den Grenzverlauf aus ethno- und geopolitischen Gründen nicht an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
