                ],
                "senses": [
                    {
                        "sense_id": "627cd71c-86ff-3732-aa2d-8c1bc32236cc",
                        "entry_id": "78585190-1a4c-3fb1-b15a-34195d7d1e93",
                        "glosses": [
                            "im Vergleich zur Nebenbetonung stärkere Betonung bei der Aussprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a10543d-5079-492b-aba3-18b771b31ddd",
                                "sense_id": "627cd71c-86ff-3732-aa2d-8c1bc32236cc",
                                "text": "„Es werden nur Wörter aufgenommen, deren Hauptbetonung auf dem Reim liegt.“"
                            },
                            {
                                "example_id": "a9daacd2-b82f-4461-8aaa-a1b6a74c545e",
                                "sense_id": "627cd71c-86ff-3732-aa2d-8c1bc32236cc",
                                "text": "„Der Doppelton (Gravis) ist fallender Ton auf der Silbe mit Hauptbetonung und höher fallender Ton auf der folgenden Silbe, bei zusammengesetzten Wörtern auf der akzentuierten Silbe des zweiten Wortes.“"
                            },
                            {
                                "example_id": "2ca5dd4c-320e-4006-90e8-fb03f19c0ecd",
                                "sense_id": "627cd71c-86ff-3732-aa2d-8c1bc32236cc",
                                "text": "„In manchen Sprachen fällt die Hauptbtonung des Wortes stets auf dieselbe Silbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3219197d-aaa5-356e-9d06-cad4c8a9775b",
                        "entry_id": "78585190-1a4c-3fb1-b15a-34195d7d1e93",
                        "glosses": [
                            "wirkungsvollste Ausführung eines Taktteils"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "2b55073d-67a7-4c27-b5ab-a4f245ca8fa9",
                                "sense_id": "3219197d-aaa5-356e-9d06-cad4c8a9775b",
                                "text": "„Hiernach hat das erste Viertel von den vier Taktzeiten die Hauptbetonung, das dritte die Nebenbetonung, während das zweite und vierte Viertel die unbetonten Taktzeiten sind.“"
                            },
                            {
                                "example_id": "6d3180f2-5ee1-45d5-abe8-0021560e0903",
                                "sense_id": "3219197d-aaa5-356e-9d06-cad4c8a9775b",
                                "text": "„Auf diese Weise erfährt das c im ersten Takte die Hauptbetonung, d die Nebenbetonung u. s. w.“"
                            },
                            {
                                "example_id": "183487a5-37fb-471b-85ff-99d19fbb4217",
                                "sense_id": "3219197d-aaa5-356e-9d06-cad4c8a9775b",
                                "text": "„Die metrische Bezugseinheit versteht sich als Akzentschema, mit einer Hauptbetonung am Anfang und eventuell einer Nebenbetonung in der Mitte, bei schwächerem Gewicht der übrigen Zählzeiten.“"
                            },
                            {
                                "example_id": "b6aebe2f-8e92-4ede-9a85-129fface2962",
                                "sense_id": "3219197d-aaa5-356e-9d06-cad4c8a9775b",
                                "text": "„Grundsätzlich trägt die erste Zählzeit nach dem Taktstrich immer die Hauptbetonung.“"
                            },
                            {
                                "example_id": "000ddbad-34c1-43ce-84c4-d5c35ef62988",
                                "sense_id": "3219197d-aaa5-356e-9d06-cad4c8a9775b",
                                "text": "„In allen geraden und ungeraden Taktarten hat aber der erste Takttheil als sogenannter Haupttheil jedes Taktes auch die Hauptbetonung, den schärfsten Accent zu beanspruchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
