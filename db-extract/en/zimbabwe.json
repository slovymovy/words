                                                "sense_id": "6d3d951d-845f-30f7-8799-94caade0f4fb",
                                                "text": "Harare ist die Hauptstadt Simbabwes."
                                            },
                                            {
                                                "example_id": "b3b92d93-2256-4c7d-b73a-1399bad73075",
                                                "sense_id": "6d3d951d-845f-30f7-8799-94caade0f4fb",
                                                "text": "„Weltweit gehört Simbabwe zu den von HIV und AIDS am stärksten betroffenen Ländern.“"
                                            },
                                            {
                                                "example_id": "d63fe8ea-fc50-493f-8706-b8f257bc29a2",
                                                "sense_id": "6d3d951d-845f-30f7-8799-94caade0f4fb",
                                                "text": "„Nach der Unabhängigkeit wurde aus Rhodesien Simbabwe, Victoria wurde in Masvingo umbenannt, Pierres Eltern bearbeiteten weiter ihre Farm.“"
                                            }
                                        ],
