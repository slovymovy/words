    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0bcc45a2-7392-3ef2-892e-e0f9fd2ad532",
                "word": "Frenchification",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2660d30e-6e56-4111-aab1-522221551dbb",
                        "entry_id": "0bcc45a2-7392-3ef2-892e-e0f9fd2ad532",
                        "tags": [
                            "plural"
                        ],
                        "form": "Frenchifications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33d6b4f0-b126-3494-8304-461fdcab4670",
                        "entry_id": "0bcc45a2-7392-3ef2-892e-e0f9fd2ad532",
                        "glosses": [
                            "The act or process of making French or more French-like, especially in informal contexts."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c14caf29-f53b-495d-a54c-4d4b26956239",
                                "sense_id": "33d6b4f0-b126-3494-8304-461fdcab4670",
                                "text": "The Frenchification of the shopping district is complete: every shop has been redone in a Haussmannian style and baguettes, wine, and accordion music are inescapable."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d6d3650-5b3e-3fbf-ba1e-f87b5bc0087c",
                        "entry_id": "0bcc45a2-7392-3ef2-892e-e0f9fd2ad532",
                        "glosses": [
                            "Something that has been made more French or French-like."
                        ],
                        "tags": [
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "114a2fa6-c084-47b2-af10-8eb1eb09db11",
                                "sense_id": "6d6d3650-5b3e-3fbf-ba1e-f87b5bc0087c",
                                "text": "The ubiquitous café is just a Frenchification of the old English coffeehouse, providing the ambiance of peaceful al fresco dining without actually moving any chairs outdoors."
                            }
                        ]
                    },
                    {
                        "sense_id": "3845cb35-b6c0-308b-a089-4c433b6ec517",
                        "entry_id": "0bcc45a2-7392-3ef2-892e-e0f9fd2ad532",
                        "glosses": [
                            "Synonym of Gallicization, translation into French or a French translation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84bf2bd5-3c2b-4fd2-af6a-6b7fdab18605",
                        "source_entry_id": "0bcc45a2-7392-3ef2-892e-e0f9fd2ad532",
                        "source_sense_description": "act or action of Frenchifying, something Frenchified",
                        "target_lang_word": "verfransing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "758f3325-601f-4a9a-97ae-fcf6e493b4be",
                        "source_entry_id": "0bcc45a2-7392-3ef2-892e-e0f9fd2ad532",
                        "source_sense_description": "act or action of Frenchifying, something Frenchified",
                        "target_lang_word": "francisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "francisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97cd084b-15e5-3d1d-ae73-af98fa18f67f",
                                        "entry_id": "c672e3e9-1f4d-370c-a377-b24f07d64d71",
                                        "glosses": [
                                            "Action de franciser un mot, ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e6164d-1cd6-4813-a0a7-8db3fdebac0d",
                                                "sense_id": "97cd084b-15e5-3d1d-ae73-af98fa18f67f",
                                                "text": "Je propose donc la francisation de tous les mots grecs et la suppression de toutes les lettres doubles […]. Je ne suis pas ici pour les demi-mesures. Pour ce qui est de la francisation des mots grecs, quelques-uns disent : « On pourrait franciser les mots usuels et conserver grécoïdes les mots savants »."
                                            },
                                            {
                                                "example_id": "b3748871-2a48-4bbc-9572-46d2b3f27b07",
                                                "sense_id": "97cd084b-15e5-3d1d-ae73-af98fa18f67f",
                                                "text": "Dans le cas de l’assurance, prime est la francisation de l’anglais premium, qui vient lui-même du latin prae (avant) et emere (verser) et désigne donc ce qu’on verse à l’avance."
                                            },
                                            {
                                                "example_id": "95015af4-a295-42f1-810a-398807f4d137",
                                                "sense_id": "97cd084b-15e5-3d1d-ae73-af98fa18f67f",
                                                "text": "Et si on n'était convaincu de l'utilité de ce travail, il suffirait de dire que ce travail de francisation sert notamment à nous faire échapper à des expressions comme celles-ci : se logger, forwarder, switcher, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c3cb08-0c80-3dbb-8284-2fd138cae910",
                                        "entry_id": "c672e3e9-1f4d-370c-a377-b24f07d64d71",
                                        "glosses": [
                                            "Acte qui constate qu’un navire est français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da72d9ba-6ce1-4dda-bf2c-d283c6bf5ecf",
                                                "sense_id": "06c3cb08-0c80-3dbb-8284-2fd138cae910",
                                                "text": "La francisation confère au navire le droit de porter le pavillon de la République française avec les avantages qui s’y attachent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c80c4d0-cfa5-3e50-8dbb-448c3da1d6f2",
                                        "entry_id": "c672e3e9-1f4d-370c-a377-b24f07d64d71",
                                        "glosses": [
                                            "Processus qui permet à un étranger, immigré en France, de devenir Français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79243f99-d89a-43d0-9e28-9fae7408cbfb",
                                                "sense_id": "6c80c4d0-cfa5-3e50-8dbb-448c3da1d6f2",
                                                "text": "Il est équitable de faire remarquer, en passant, que l’école primaire, tant décriée, et le certificat d’études, si dénigré, ont été en réalité des moyens de francisation d’une efficacité souveraines."
                                            },
                                            {
                                                "example_id": "8b61b89a-0815-4444-976a-9314d06e2033",
                                                "sense_id": "6c80c4d0-cfa5-3e50-8dbb-448c3da1d6f2",
                                                "text": "« Le choix d'un prénom français pour les enfants d'étrangers était un moyen d'assimilation. Ce choix de prénom allait parfois de pair avec la francisation des noms et prénoms des immigrés eux-mêmes. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd0eeb47-a398-32a9-a1bb-9472f18647a0",
                                        "entry_id": "c672e3e9-1f4d-370c-a377-b24f07d64d71",
                                        "glosses": [
                                            "Transformation visant à adopter la langue française ou l’apparence française."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ee490b1-dfbc-481a-a525-5e4def135ef2",
                                                "sense_id": "fd0eeb47-a398-32a9-a1bb-9472f18647a0",
                                                "text": "La francisation de la minorité privilégiée avait déjà fait de si grands progrès au XVIIIᵉ siècle, qu’un certain nombre de ses membres ne considéraient plus le flamand que comme un patois à l’usage des inférieurs."
                                            },
                                            {
                                                "example_id": "a1664266-083f-48dd-87ef-63ed8a22726c",
                                                "sense_id": "fd0eeb47-a398-32a9-a1bb-9472f18647a0",
                                                "text": "Outre l’enseignement, la francisation du milieu de travail est un objectif prioritaire de la Charte [de la langue française]."
                                            },
                                            {
                                                "example_id": "62012a0b-5577-4cc0-9ae9-8b39b15cd8e7",
                                                "sense_id": "fd0eeb47-a398-32a9-a1bb-9472f18647a0",
                                                "text": "Pour les Flamands qui ont choisi la francisation, le mouvement flamand est synonyme de trahison."
                                            },
                                            {
                                                "example_id": "4315adfb-076d-4948-99f2-43e8eb922791",
                                                "sense_id": "fd0eeb47-a398-32a9-a1bb-9472f18647a0",
                                                "text": "Mon amoureux a appris le français dans un centre de francisation de Terrebonne, à temps plein, sans toucher un sou du gouvernement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a271301b-458f-351e-8336-732c79655c8f",
                                        "entry_id": "c672e3e9-1f4d-370c-a377-b24f07d64d71",
                                        "glosses": [
                                            "Localisation en langue française de logiciel informatique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1bd163a9-0af3-3a87-b6bb-b0cfb9fbf60e",
                                        "entry_id": "c672e3e9-1f4d-370c-a377-b24f07d64d71",
                                        "glosses": [
                                            "Adaptation aux normes françaises de matériel conçu et fabriqué dans un autre pays."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b25ad229-2f71-39d6-8bed-e9a98fa57f6a",
                                        "entry_id": "c672e3e9-1f4d-370c-a377-b24f07d64d71",
                                        "glosses": [
                                            "Pratique commerciale frauduleuse consistant pour une entreprise à acheter des produits à l'étranger, souvent à bas prix, et à les revendre en prétendant qu'ils viennent de la production française."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49cc5318-896a-4a6b-af58-f672a6296d3e",
                                                "sense_id": "b25ad229-2f71-39d6-8bed-e9a98fa57f6a",
                                                "text": "En juillet 2021, une vaste enquête avait été ouverte par le parquet de Tarascon (Bouches-du-Rhône) après la « francisation » de fruits et légumes venus d’Espagne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
