                "senses": [
                    {
                        "sense_id": "5a2341df-0b69-3d3c-81be-e57469a64481",
                        "entry_id": "f213663e-5b23-33e9-88dc-05f4e55cb052",
                        "glosses": [
                            "Ort, an dem Abfall endgelagert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d151fd74-2e6d-4ecb-a75c-d18c3bc4cbf5",
                                "sense_id": "5a2341df-0b69-3d3c-81be-e57469a64481",
                                "text": "„Wissenschaftlern des Instituts für Geophysik und Meteorologie der Universität zu Köln ist es zum ersten Mal gelungen, ein dreidimensionales tomographisches Bild einer stillgelegten Abfalldeponie zu erzeugen.“"
                            },
                            {
                                "example_id": "001c9ce9-ca44-4e92-b5a3-e8ff8de63d0c",
                                "sense_id": "5a2341df-0b69-3d3c-81be-e57469a64481",
                                "text": "„Auf den Abfalldeponien entwickelte sich eine regelrechte Müllfauna aus Parasiten und Schädlingen, Ratten und Mäusen, die zugleich Krankheitsüberträger waren.“"
                            },
                            {
                                "example_id": "3bb845e2-16dc-4323-aba9-123df0e244c7",
                                "sense_id": "5a2341df-0b69-3d3c-81be-e57469a64481",
                                "text": "„Auf Abfalldeponien entstehen beim Abbau organischer Kohlenstoffverbindungen jährlich etwa 2 bis 4 Millionen Tonnen Methan […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
