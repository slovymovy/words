                        "entry_id": "1d807989-520b-3cbd-a234-762fab25c337",
                        "glosses": [
                            "A method of separating molecules or particles of different sizes by differential diffusion through a semipermeable membrane."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4415eff6-4586-3ad5-b0c2-5d33ee1b945d",
                        "entry_id": "1d807989-520b-3cbd-a234-762fab25c337",
                        "glosses": [
                            "The use of this method for the removal of waste products from the blood in the case of kidney failure: hemodialysis or peritoneal dialysis."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f51c27f-87c3-40a4-9103-da61f9958b15",
                                "sense_id": "4415eff6-4586-3ad5-b0c2-5d33ee1b945d",
                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                            }
                        ]
                    },
