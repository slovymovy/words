                            }
                        },
                        {
                            "text": "Many people use a <w>gov</w> email address when communicating about official state business.",
                            "target_lang_translations": {
                                "ru": "Многие люди используют <w>правительственный</w> адрес электронной почты при общении по официальным государственным делам."
                            }
                        }
                    ],
                    "synonyms": [
