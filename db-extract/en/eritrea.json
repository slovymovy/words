                                            {
                                                "example_id": "932702c0-e4a7-46eb-a743-d9f0e90b2b0b",
                                                "sense_id": "4a530dd7-80aa-373b-a44a-6e1023a32c90",
                                                "text": "Zwischen Eritrea und Äthiopien gibt es einen Konflikt um den Grenzverlauf."
                                            },
                                            {
                                                "example_id": "1a7321f2-69af-4c9b-99ff-ec97ef6e90ad",
                                                "sense_id": "4a530dd7-80aa-373b-a44a-6e1023a32c90",
                                                "text": "Eritrea war erst italienische, dann britische Kolonie."
                                            },
                                            {
                                                "example_id": "362d3339-f73c-4e7c-b01b-b1165a3db8d6",
                                                "sense_id": "4a530dd7-80aa-373b-a44a-6e1023a32c90",
                                                "text": "Asmara ist die Hauptstadt von Eritrea."
                                            },
                                            {
                                                "example_id": "ae155e7b-da22-4ba6-91b0-d3b761c018d8",
                                                "sense_id": "4a530dd7-80aa-373b-a44a-6e1023a32c90",
                                                "text": "„Mit den Italienern hat der neue Herrscher noch vor seiner Krönung mehrere Abkommen geschlossen, in denen er Rom unter anderem die Region Eritrea abgetreten hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
