                                "target_senses": [
                                    {
                                        "sense_id": "fe31bdba-99fc-390a-bf7e-60c9284256a2",
                                        "entry_id": "251fc9bd-d5fc-3caa-be47-904d4983fdba",
                                        "glosses": [
                                            "Circuit dans lequel peut se produire un courant électrique alternatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "835ff549-156e-4e56-a08d-0cf8d66ce3c9",
                                                "sense_id": "fe31bdba-99fc-390a-bf7e-60c9284256a2",
                                                "text": "L’oscillateur de Hertz a servi à la découverte des ondes électriques."
                                            },
                                            {
                                                "example_id": "d23c21de-e821-4ccb-b346-cbbfe43eb022",
                                                "sense_id": "fe31bdba-99fc-390a-bf7e-60c9284256a2",
                                                "text": "Tout type d’oscillateur, un oscillateur LC fixe par exemple, peut être modifié en oscillateur contrôle en tension."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "755ff645-22a7-4622-adcb-ec66d5cdd8f1",
                        "source_entry_id": "a6370db3-cacb-3845-8c4f-6fe9a2e0e74e",
                        "source_sense_description": "an electronic circuit used to generate a continuous output waveform",
                        "target_lang_word": "Oszillator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oszillator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd9912ef-38e9-34aa-89b3-ac47305400f1",
                                        "entry_id": "356171ec-cc4a-322f-b0cb-ed1a0a4133f9",
                                        "glosses": [
                                            "Objekt, das die Fähigkeit zur (harmonischen) Schwingung aufweist, zu deren Erzeugung oder Messung dient"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ba8ff8-4790-4c4b-b3c1-155a610eaaf5",
                                                "sense_id": "dd9912ef-38e9-34aa-89b3-ac47305400f1",
                                                "text": "In der klassischen Mechanik ist ein harmonischer Oszillator ein Teilchen, das einer anziehenden, zum Abstand von einem festen Punkt proportionalen Kraft unterworfen ist."
                                            },
                                            {
                                                "example_id": "dcc09256-a9a7-4fcf-a663-a34106fae589",
                                                "sense_id": "dd9912ef-38e9-34aa-89b3-ac47305400f1",
                                                "text": "Eine Schwingung ist eine periodische oder sich repetierende Zustandsänderung eines physikalischen Systems. Ein schwingungsfähiges System bezeichnet man als Oszillator."
                                            },
                                            {
                                                "example_id": "e6b1a360-1524-44de-97cf-f824cc39956e",
                                                "sense_id": "dd9912ef-38e9-34aa-89b3-ac47305400f1",
                                                "text": "Wir beginnen mit den Beispielen, für die wir die Funktion der linearen Antwort bereits berechnet haben: dem harmonischen Oszillator und dem Relaxator."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
