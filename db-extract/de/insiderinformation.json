                            {
                                "example_id": "a95795ca-f249-4639-bfec-9c99ce0e5a66",
                                "sense_id": "e494a9b4-3e99-3c5d-9539-cfda040c8756",
                                "text": "„Sind Sie durch Detektivarbeit darauf gekommen? Oder durch Insiderinformationen?“"
                            },
                            {
                                "example_id": "8204ed1e-8c7c-42c2-8103-42787dc0b4c7",
                                "sense_id": "e494a9b4-3e99-3c5d-9539-cfda040c8756",
                                "text": "„Vor vier Jahren hatte sich Charles an Peter gewandt und ihm ein Angebot gemacht, das der zukünftige Präsidentenberater nicht ablehnen konnte - Insiderinformationen über den trostlosen Stand des laufenden Irakkriegs.“"
                            }
                        ],
