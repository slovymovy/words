    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02013943-d1bb-3532-9630-23f3bd6fdb36",
                    "sense_definition": "Of, relating to, or characteristic of priests or their duties.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "priest_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years preparing to take on full <w>priestly</w> duties in the church.",
                            "target_lang_translations": {
                                "ru": "Он провел годы, готовясь взять на себя все <w>священнические</w> обязанности в церкви."
                            }
                        },
                        {
                            "text": "The bishop performed the ritual while wearing traditional <w>priestly</w> robes.",
                            "target_lang_translations": {
                                "ru": "Епископ совершил обряд, облачившись в традиционные <w>священнические</w> одежды."
                            }
                        }
                    ],
                    "synonyms": [
                        "sacerdotal",
                        "hieratic"
                    ],
                    "common_phrases": [
                        "priestly duties",
                        "priestly robes",
                        "priestly office"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к священникам, священнослужителям или их обязанностям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "священнический",
                                "target_lang_sense_clarification": "относящийся к священнику или сану"
                            },
                            {
                                "target_lang_word": "жреческий",
                                "target_lang_sense_clarification": "относящийся к жрецам (в античных или языческих культах)"
                            },
                            {
                                "target_lang_word": "пастырский",
                                "target_lang_sense_clarification": "связанный с пастырским служением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f9075dc-8b4d-3ded-bc3f-bed21d2d8a3b",
                    "sense_definition": "Having the appearance, demeanor, or solemn manner of a priest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "priest_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with a calm and <w>priestly</w> demeanor that put everyone at ease.",
                            "target_lang_translations": {
                                "ru": "Он говорил со спокойной и <w>подобной священнической</w> манерой, которая всех успокаивала."
                            }
                        },
                        {
                            "text": "Her long black coat gave her a remarkably <w>priestly</w> appearance.",
                            "target_lang_translations": {
                                "ru": "Ее длинное черное пальто придавало ей поразительно <w>священнический</w> вид."
                            }
                        }
                    ],
                    "common_phrases": [
                        "priestly demeanor",
                        "priestly appearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий вид, манеру поведения или торжественность, присущие священнику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подобный священнику",
                                "target_lang_sense_clarification": "напоминающий священника по виду или поведению"
                            },
                            {
                                "target_lang_word": "священнический",
                                "target_lang_sense_clarification": "напоминающий манеру священника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e1c52ff-ab6e-32d7-bc96-a8e246940a22",
                    "sense_definition": "Pertaining to the Priestly source (P), one of the proposed original sources of the Torah according to the documentary hypothesis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biblical_scholarship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholars often identify chapters containing ritual laws as belonging to the <w>Priestly</w> source.",
                            "target_lang_translations": {
                                "ru": "Ученые часто относят главы, содержащие ритуальные законы, к <w>Жреческому</w> источнику."
                            }
                        },
                        {
                            "text": "These verses were written in a distinct <w>Priestly</w> style characteristic of the later biblical texts.",
                            "target_lang_translations": {
                                "ru": "Эти стихи были написаны в характерном <w>священническом</w> стиле, свойственном более поздним библейским текстам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Priestly source",
                        "Priestly text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Священническому кодексу (источнику P) в документальной гипотезе происхождения Торы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жреческий",
                                "target_lang_sense_clarification": "в библеистике: Жреческий кодекс или источник"
                            },
                            {
                                "target_lang_word": "священнический",
                                "target_lang_sense_clarification": "в библеистике: Священнический источник"
                            }
                        ]
                    }
                }
            ]
        },
        {
