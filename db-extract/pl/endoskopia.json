                                        "sense_id": "ee33762d-dc26-3500-aa97-3a930c3c024c",
                                        "entry_id": "89665771-8036-33f9-8bf2-0191b6777e6f",
                                        "glosses": [
                                            "Examen réalisé avec un endoscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2f84faa-53aa-4c7d-951b-a57b37c292bb",
                                                "sense_id": "ee33762d-dc26-3500-aa97-3a930c3c024c",
                                                "text": "L’anesthésie. Elle est le plus souvent locale et les indications d’anesthésie générale doivent être rares en fibroscopie souple. L’endoscopie rigide par contre est réalisée sous anesthésie générale."
                                            },
                                            {
                                                "example_id": "0004d696-60b1-48ac-878f-836d9328198e",
                                                "sense_id": "ee33762d-dc26-3500-aa97-3a930c3c024c",
                                                "text": "Une tumeur sous-muqueuse (TSM) est observée lors d’une endoscopie sur 300."
                                            }
                                        ]
