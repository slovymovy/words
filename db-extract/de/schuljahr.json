                    },
                    {
                        "form_id": "8097d234-ab7c-4792-9301-2b47699bae1b",
                        "entry_id": "0e8fb499-e572-3c8a-83b5-6d23ead9be32",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schuljahre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "311e6437-c7e2-32e2-9b37-98d1704916cc",
                        "entry_id": "0e8fb499-e572-3c8a-83b5-6d23ead9be32",
                        "glosses": [
                            "Zeitraum eines Jahres, in dem der Unterricht in der Schule stattfindet (in Österreich inklusive der Sommerferien)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aae2407-ebc0-4077-82bf-493ae138b08f",
                                "sense_id": "311e6437-c7e2-32e2-9b37-98d1704916cc",
                                "text": "Am Ende des Schuljahres erhalten die Schüler ihre Zeugnisse."
                            },
                            {
                                "example_id": "63f53d42-e7a8-4e8a-b9ae-88151e60da7f",
                                "sense_id": "311e6437-c7e2-32e2-9b37-98d1704916cc",
                                "text": "„In dem Schreiben teilte uns die Schule lapidar mit, dass das Schuljahr bald vorbei sei.“"
                            },
                            {
                                "example_id": "6aa466ed-f9ed-4013-aaad-33cd9b8da571",
                                "sense_id": "311e6437-c7e2-32e2-9b37-98d1704916cc",
                                "text": "„Das Unterrichtsjahr ist dem israelischen Schuljahr angepasst.“"
                            },
                            {
                                "example_id": "8934fa55-80ff-420a-b228-3f9db3374e0b",
                                "sense_id": "311e6437-c7e2-32e2-9b37-98d1704916cc",
                                "text": "„Der Rest des Schuljahres verging in einer Art winterlichen Vegetierens.“"
                            },
                            {
                                "example_id": "df0611b2-75a6-4a22-adc2-3368a5882ac4",
                                "sense_id": "311e6437-c7e2-32e2-9b37-98d1704916cc",
                                "text": "„Wotan und ich, wir sind uns – ich muss überlegen – im Herbst 1941, nach den Sommerferien, als das neue Schuljahr begann, zum ersten Mal begegnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f15158b3-ad99-3123-a0cd-e669895ce86b",
                        "entry_id": "0e8fb499-e572-3c8a-83b5-6d23ead9be32",
                        "glosses": [
                            "Klassenstufe, in der Schüler mit ähnlichem Lernniveau und Lernpensum zusammengefasst sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11de4cf9-30d3-4435-a843-522bc2b575df",
                                "sense_id": "f15158b3-ad99-3123-a0cd-e669895ce86b",
                                "text": "„Ich war fünfzehneinhalb Jahre alt und musste vor allem die versäumten Schuljahre nachholen.“"
                            },
                            {
                                "example_id": "71678def-812d-4022-bc61-6ec3cf77e874",
                                "sense_id": "f15158b3-ad99-3123-a0cd-e669895ce86b",
                                "text": "„In meinem Zeugnis stand, daß ich das erste Schuljahr mit gutem Erfolg besucht hätte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
