                            {
                                "example_id": "9cc76651-a4f5-4a2e-98f4-1569fbb4eaa8",
                                "sense_id": "63e92690-b4b9-3366-b9bb-1867eb8cf260",
                                "text": "We spraken niet over ... het pleisterwerk dat hier en daar duimendik op de vloeren lag ..."
                            },
                            {
                                "example_id": "7e311e33-53d7-419f-b76d-6bf6eccaba0a",
                                "sense_id": "63e92690-b4b9-3366-b9bb-1867eb8cf260",
                                "text": "Een vrouw in de Amerikalaan in Gent merkte al aan het einde van de middag dat er schuim uit een riooldeksel op straat kwam. Uren later stond het schuim duimendik op straat en kwam het bij drie huizen uit de riolering omhoog."
                            }
