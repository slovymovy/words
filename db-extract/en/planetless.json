                    {
                        "sense_id": "024e4c35-8aa0-3ad2-92b2-6a74aae2483c",
                        "entry_id": "ad599a26-df9d-33bd-95c8-4a8804dcd015",
                        "glosses": [
                            "Without planets."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bef196c3-938f-43d3-9b5e-2fee31c32327",
                                "sense_id": "024e4c35-8aa0-3ad2-92b2-6a74aae2483c",
                                "text": "A shoreless sea, a sky sunless and planetless."
                            },
                            {
                                "example_id": "7304b686-903a-4113-96a9-a812145613ee",
                                "sense_id": "024e4c35-8aa0-3ad2-92b2-6a74aae2483c",
                                "text": "The circumstance which, on the occasion of the discovery of Ceres, and the other so-called small planets, first forcibly recalled to mind Kepler's Pythagorean arguments, was his almost forgotten conjecture as to the probable existence of a yet unseen planet in the great planetless chasm between Mars and Jupiter."
                            }
                        ]
                    },
                    {
                        "sense_id": "a19c2a8b-f1b1-3017-95a4-789e8f31a5a1",
                        "entry_id": "ad599a26-df9d-33bd-95c8-4a8804dcd015",
                        "glosses": [
                            "Having no home planet."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bf0dbc58-9835-422e-9ea1-00f417ae93e4",
                                "sense_id": "a19c2a8b-f1b1-3017-95a4-789e8f31a5a1",
                                "text": "And I am not going to gamble half our resources on as crazy an effort as this, masterminded by a mouthful of planetless lunatics."
                            },
                            {
                                "example_id": "9115f277-3d02-417a-8a70-59eeb7706ff4",
                                "sense_id": "a19c2a8b-f1b1-3017-95a4-789e8f31a5a1",
                                "text": "He cleared his throat and began the tale of the planetless boy, and Kate listened, drowsy, drifting."
                            },
                            {
                                "example_id": "791e1947-c1c8-4c99-92e9-8cd2e783777d",
                                "sense_id": "a19c2a8b-f1b1-3017-95a4-789e8f31a5a1",
                                "text": "Umlari, others called them. Or spacefolk. Or those planetless freaks. Living in their great stations, orbiting unwanted stars, the People cared nothing for names."
                            }
                        ]
                    }
