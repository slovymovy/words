                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b355219-e42f-4e92-8638-9dc1c164f32d",
                                "sense_id": "e511aa76-0561-3b57-afab-c325f6268602",
                                "text": "À 78 ans, Michel Ocelot tient toujours la forme."
