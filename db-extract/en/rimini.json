                "entry_id": "18370f63-e7cd-371b-9f4b-3d95d2bf78e8",
                "word": "Rimini",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6c976ca2-131a-3d9a-8fad-462cf523adad",
                        "entry_id": "18370f63-e7cd-371b-9f4b-3d95d2bf78e8",
                        "glosses": [
                            "A province of Emilia-Romagna, Italy."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cd0e8f72-31ef-3e4d-817b-a8b279d47980",
                        "entry_id": "18370f63-e7cd-371b-9f4b-3d95d2bf78e8",
                        "glosses": [
                            "A resort city, the capital of the province of Rimini, Emilia-Romagna, Italy."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fadaf862-6439-4387-b1e6-c6bebebd1f7c",
                        "source_entry_id": "18370f63-e7cd-371b-9f4b-3d95d2bf78e8",
                        "source_sense_description": "province of Italy",
                        "target_lang_word": "Rimini",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rimini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca3028a3-7d9a-3bcb-b643-74594fcedab3",
                                        "entry_id": "351ffd19-25b1-3735-b777-1e0eab107351",
                                        "glosses": [
                                            "Commune et ville de la région d’Émilie-Romagne en Italie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4936dd9-c6ae-4edf-94d4-170307781152",
                                                "sense_id": "ca3028a3-7d9a-3bcb-b643-74594fcedab3",
                                                "text": "Rimini, ville splendide, n’a pas seulement sa plage sur l’Adriatique. Elle abonde en monuments extraordinaires : l’arc d’Auguste, qui se dresse toujours à l’entrée de la Via Emilia, le pont de Tibère, les restes de l’amphithéâtre romain , le château Sigismondo, un des fleurons de la Renaissance italienne, le palais Arengo et la fontaine Santo Agostino, le magnifique temple de Malatesta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3808cec9-e6a4-3977-b267-ddc9ad3e3a6b",
                                        "entry_id": "351ffd19-25b1-3735-b777-1e0eab107351",
                                        "glosses": [
                                            "Province autour de cette ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d93c11c-4225-4c42-ad41-e8fa269d1a05",
                                                "sense_id": "3808cec9-e6a4-3977-b267-ddc9ad3e3a6b",
                                                "text": "La Romagne, la Pentapole (Ancône et Rimini), l’Istrie, la Vénétie, la Sicile, surtout la Grande Grèce, redeviennent, grâce à elle, des oasis de richesse dans la péninsule ruinée par les Barbares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5448653a-ac40-46a0-9ba3-0c7b4874a0e6",
                        "source_entry_id": "18370f63-e7cd-371b-9f4b-3d95d2bf78e8",
                        "source_sense_description": "province of Italy",
                        "target_lang_word": "Rimini",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rimini",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "652b1009-66a8-38fe-bc11-c6e5ab0abe21",
                                        "entry_id": "74ce3ded-4f69-3cd0-adf3-d8166de50231",
                                        "glosses": [
                                            "italienische Stadt an der Adria"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1e8ba8-819e-4d0a-a8c2-4079ef94bf7b",
                                                "sense_id": "652b1009-66a8-38fe-bc11-c6e5ab0abe21",
                                                "text": "Wir haben unseren Urlaub in Rimini verbracht."
                                            },
                                            {
                                                "example_id": "231e9b59-d4d8-4597-a975-b7ed0fa8657f",
                                                "sense_id": "652b1009-66a8-38fe-bc11-c6e5ab0abe21",
                                                "text": "„In Rimini gab ich dem ersten Gassenjungen, dem ich begegnete, zwei Baiocchi und ließ mich zum Hause führen, in dem Teresa wohnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e948b419-26ad-425e-b363-d4f491cdddcd",
                        "source_entry_id": "18370f63-e7cd-371b-9f4b-3d95d2bf78e8",
                        "source_sense_description": "province of Italy",
                        "target_lang_word": "Rimini",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rimini",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "3d6efd31-0fbb-316e-b836-0f35c3e96959",
                                        "entry_id": "1ef528f5-c8c3-3122-a699-2e7c3bdfaa9d",
                                        "glosses": [
                                            "capoluogo di provincia della regione Emilia-Romagna in Italia"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daae61a4-e8cd-41fe-ae31-ffcbcffb10b5",
                        "source_entry_id": "18370f63-e7cd-371b-9f4b-3d95d2bf78e8",
                        "source_sense_description": "province of Italy",
                        "target_lang_word": "Rimini",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rimini",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "19125446-7401-3776-8a88-fa8f80b29990",
                                        "entry_id": "b470909a-3154-36dc-8bef-76df05c290f7",
                                        "glosses": [
                                            "miasto i gmina we Włoszech, w regionie Emilia-Romania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a1abb13-2437-4fc6-97fa-5e26e8f65b43",
                                                "sense_id": "19125446-7401-3776-8a88-fa8f80b29990",
                                                "text": "Z Faenzy do Rimini było 66 km, a my od Rimini drugie tyle przelecieliśmy i lotniska nie widać"
                                            },
                                            {
                                                "example_id": "abdbab7d-e4c0-46d9-b174-20e81b796971",
                                                "sense_id": "19125446-7401-3776-8a88-fa8f80b29990",
                                                "text": "Wygnawszy Sforzów z Pesaro, Malatestów z Rimini, a Manfreddich z Faenzy, stworzyli podwaliny władzy, której ideologicznym uzasadnieniem była pozycja papieża – głowy Kościoła, a zarazem przedstawiciela rodu i rzecznika jego interesów. Odniósłszy spektakularne sukcesy Borgiowie zwrócili się następnie przeciwko swoim dotychczasowym sprzymierzeńcom"
                                            },
                                            {
                                                "example_id": "52fb9db5-0558-4787-89f0-8fd3fcea91a8",
                                                "sense_id": "19125446-7401-3776-8a88-fa8f80b29990",
                                                "text": "8 Armia po ciężkich walkach i stratach, głównie Korpusu Kanadyjskiego, zdobyła wprawdzie ruiny Rimini, lecz zaraz za miastem, mniej więcej na linii Cezarowego Rubikonu, u wylotu doliny lombardzkiej front stanął, broniony przez niemieckie siły pancerne"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "14e5163c-d2ad-3e7f-8937-ef901112f755",
                                        "entry_id": "b470909a-3154-36dc-8bef-76df05c290f7",
                                        "glosses": [
                                            "włoska prowincja położona w regionie Emilia-Romania"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
