                            {
                                "example_id": "dbe71388-75b2-4d63-bc86-ce55d33263d6",
                                "sense_id": "4592c8e5-bb0a-3519-b705-faea44f3dff8",
                                "text": "Dans les montagnes plantées de châtaigniers, des valats (tranchées ) sont creusés de distance en distance pour recevoir les eaux du ciel et les diriger vers les ravins."
                            }
                        ]
                    },
                    {
