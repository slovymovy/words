                    },
                    {
                        "translation_id": "0892b422-49c8-4fc4-835b-b038f119ea54",
                        "source_entry_id": "3b8c86c2-0212-3f39-a8e4-7d72923f0c88",
                        "source_sense_id": "a5215fc9-36ee-3e9a-a0ee-fd2d799e9056",
                        "source_sense_description": "een voortijdige en kunstmatige beëindiging van een zwangerschap",
                        "target_lang_word": "interruption de grossese",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0241f734-b751-4542-ab8a-a712e1fa9daa",
                        "source_entry_id": "3b8c86c2-0212-3f39-a8e4-7d72923f0c88",
                        "source_sense_id": "a5215fc9-36ee-3e9a-a0ee-fd2d799e9056",
                        "source_sense_description": "een voortijdige en kunstmatige beëindiging van een zwangerschap",
                        "target_lang_word": "interruption volontaire de grossesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interruption volontaire de grossesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29e39a08-497e-3e07-8c6b-d4dbe2fce0f0",
                                        "entry_id": "b1681939-f13a-3d1a-a929-b986f28e12b8",
                                        "glosses": [
                                            "Avortement déclenché pour des raisons non médicales, à la suite d'une décision personnelle ou familiale, dans un cadre légal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e36bfb8-26e9-4edd-9bc1-12d47681f7b0",
                                                "sense_id": "29e39a08-497e-3e07-8c6b-d4dbe2fce0f0",
                                                "text": "Cette loi met fin à la législation répressive et archaïque qui régnait dans ce domaine : l'article 317 du Code pénal qui sanctionnait sévèrement l’interruption volontaire de grossesse est suspendu pour cinq ans."
                                            },
                                            {
                                                "example_id": "b3a7c674-bce6-48b3-8eb7-1b9a9c9db5f8",
                                                "sense_id": "29e39a08-497e-3e07-8c6b-d4dbe2fce0f0",
                                                "text": "Un établissement d’hospitalisation privé peut refuser que des interruptions volontaires de grossesse soient pratiquées dans ses locaux."
                                            },
                                            {
                                                "example_id": "19ca724b-a879-4c6c-8600-554324dcaddf",
                                                "sense_id": "29e39a08-497e-3e07-8c6b-d4dbe2fce0f0",
                                                "text": "Car en vertu de la Loi canadienne sur la santé, l’interruption volontaire de grossesse est un « service médicalement nécessaire »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
