                                ]
                            },
                            {
                                "target_word": "Martien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7279ab8-6502-3082-80f4-2ac411c288b2",
                                        "entry_id": "8960647a-3bec-381e-bd67-513af74fef30",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f48c848-83ca-41f3-acec-bd2f52194621",
                                                "sense_id": "c7279ab8-6502-3082-80f4-2ac411c288b2",
                                                "text": "Le manuel de Martien Capella, qui prélude à la réduction de toute science dans la célèbre mais étroite unité du Trivium et du Quadrivium, nous donne une fidèle et triste idée de cet abaissement des intelligences (1)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef36c90e-cbac-4e2d-9ef8-1b776403d5f9",
