                        "sense_id": "c5055a1d-06a5-395c-b6a2-0962373fb654",
                        "entry_id": "e2c5ae17-b7d8-308c-ac02-3d2c55fe1bd6",
                        "glosses": [
                            "ruimte waar men tijdens het wachten kan verblijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6de62a-d4b6-46e4-b5a2-4cf9a4a7d3a0",
                                "sense_id": "c5055a1d-06a5-395c-b6a2-0962373fb654",
                                "text": "Met wat getelefoneer lukt het me toestemming van de lokale autoriteiten te krijgen om in een blauw geverfd wachtlokaal van de politie aan de Vliegeniersboulevard de van staatswege bevolen ontnuchtering van nabij te bestuderen."
                            },
                            {
                                "example_id": "881d8c19-f0b0-43db-b9f5-06a1206aced7",
                                "sense_id": "c5055a1d-06a5-395c-b6a2-0962373fb654",
                                "text": "In totaal is er plaats voor 49 ‘groene’ vaartuigen. De gemeente zorgt voor oplaadpunten voor de elektrobootjes en voor haken en ladders om eventuele drenkelingen uit het water te halen. Wachtlokalen of loketten voor kaartverkoop komen er niet, aldus de gemeente."
                            }
                        ]
