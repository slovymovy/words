                    },
                    {
                        "sense_id": "3dae6187-75c0-3814-b32c-ae4a2c37d2be",
                        "entry_id": "8e0debf3-1e27-353f-9c71-600f2e37b383",
                        "glosses": [
                            "то, что израсходовано сверх установленной нормы, плана и т. п."
                        ],
                        "tags": [],
