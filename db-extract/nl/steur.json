                    {
                        "translation_id": "7b4f214f-c63d-4928-a1f1-4c48ecd59681",
                        "source_entry_id": "f94d89ce-647b-37e4-ab6f-e5c30cab0713",
                        "source_sense_id": "77916b5f-41e8-37c3-8f77-fa109f7b7123",
                        "source_sense_description": "bepaald soort anadrome vis, Acipenser sturio",
                        "target_lang_word": "Stör",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stör",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                        "entry_id": "88cce1a2-8481-3759-8106-7704cd968762",
                                        "glosses": [
                                            "ein Knochenfisch mit der Gattungsbezeichnung Acipenser, Lieferant von Kaviar (Rogen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea2e044-a803-4c77-b2f9-49bdf31f8387",
                                                "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                                "text": "Der Stör kam früher in der Elbe vor."
                                            },
                                            {
                                                "example_id": "da411594-a500-426f-9509-39e21b037907",
                                                "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                                "text": "Es gibt mehrere Arten des Störs, die sowohl in reinem Süßwasser als auch in Salzwasser leben."
                                            },
                                            {
                                                "example_id": "6585beb4-6078-44ff-be3a-655ce7d02ebb",
                                                "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                                "text": "„Zwischendurch gehen sie angeln und bringen ein paar Störe auf die Märkte der nordkaukasischen Städte, zum Beispiel nach Pjatigorsk, zu Deutsch Fünfberg.“"
                                            },
                                            {
                                                "example_id": "3913094a-017e-47cf-b468-5706791abc72",
                                                "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                                "text": "„Roosa führte mich zu einem Becken, in dem Störe schwammen, die in Imatra gezüchtet wurden.“"
                                            },
                                            {
                                                "example_id": "62969bbd-85e2-4c07-a19e-e0823a6175ce",
                                                "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                                "text": "„Die Wirtin, die mich als freigebig kennengelernt hatte, gab mir Wildpret und Stör.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Stör",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                        "entry_id": "ad87ac49-81ef-345b-8306-cde42521b3e0",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e088467b-48b9-402d-8ea2-78264395d98a",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Frau Stör ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "c70aa893-4e22-4dc9-9db1-beff691edd93",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Herr Stör wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "6a959f2e-1ae2-451f-93f4-1ba9b4716a76",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Die Störs fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "fa197369-c8dc-45a0-8106-bf0f4a134cf7",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Der Stör trägt nie die Schals, die die Stör ihm strickt."
                                            },
                                            {
                                                "example_id": "464d8a9e-0908-460c-96dd-4610ed6b97a4",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stör kommt, geht der Herr Stör.“"
                                            },
                                            {
                                                "example_id": "3b7ac259-0590-4898-8643-81658319a660",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Stör kommt und geht."
                                            },
                                            {
                                                "example_id": "1d6ee567-c0ee-4524-9c60-db3c3efc8b8e",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Störs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Stör",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c83a3de-f146-3e9a-8f25-d8ca5929e84e",
                                        "entry_id": "4a2e3efb-8a1d-31c4-9fa2-7a8ace8f4ce3",
                                        "glosses": [
                                            "rechter Nebenfluss der Elbe in Schleswig-Holstein, einst kam der Stör hier vor"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ffcf7c-400f-48db-a2d7-96a4bb134286",
                                                "sense_id": "2c83a3de-f146-3e9a-8f25-d8ca5929e84e",
                                                "text": "„Die Temperatur der Stör steige maximal um unbedenkliche 1,5 Grad“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c01e3ea-a9a4-4c96-b22b-3d437074415b",
                        "source_entry_id": "f94d89ce-647b-37e4-ab6f-e5c30cab0713",
                        "source_sense_id": "77916b5f-41e8-37c3-8f77-fa109f7b7123",
                        "source_sense_description": "bepaald soort anadrome vis, Acipenser sturio",
                        "target_lang_word": "sturgeon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sturgeon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94fdeec6-e88d-3372-8cac-e705e2eaea01",
                                        "entry_id": "1b57ac1b-c79e-38da-9bce-1ba84fca0399",
                                        "glosses": [
                                            "Any marine or freshwater fish of the family Acipenseridae that are prized for their roe and are endemic to temperate seas and rivers of the northern hemisphere, especially central Eurasia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00f99050-c0e6-48b1-92c7-a32bd1ee160a",
                                                "sense_id": "94fdeec6-e88d-3372-8cac-e705e2eaea01",
                                                "text": "The sturgeon is considered to be rich in aphrodisiac elements."
                                            },
                                            {
                                                "example_id": "4ed542ed-32de-45f9-8b73-c18a620deaf2",
                                                "sense_id": "94fdeec6-e88d-3372-8cac-e705e2eaea01",
                                                "text": "An investigation has been carried out into the changes in blood chemistry which occur during the migration of young sturgeon and spawned adults from freshwater into saltwater and of the migration of prespawning adults in the reverse direction by Magnin (1962)."
                                            },
                                            {
                                                "example_id": "5ca7d9eb-2e05-4f55-af34-5fc58f374573",
                                                "sense_id": "94fdeec6-e88d-3372-8cac-e705e2eaea01",
                                                "text": "1997, M. L. Khrykhtin, V. G. Svirsky, Sturgeon catch and the current status of sturgeon stocks in the Amur River, Andreas Bauer, Astrid Kaiser-Pohlmann, Sturgeon Stocks and Caviar Trade Workshop: Proceedings, page 29,\nStrict regulation of the catch was introduced in the Soviet Union in 1976 in order to prevent overfishing of the sexually mature sturgeons in the river."
                                            },
                                            {
                                                "example_id": "e06beb33-eeec-429b-9a76-de45ba151ce1",
                                                "sense_id": "94fdeec6-e88d-3372-8cac-e705e2eaea01",
                                                "text": "Long and snout-nosed with rows of platelike bony protrusions, sturgeon have a dinosaur-era look."
                                            },
                                            {
                                                "example_id": "51e72e4a-233b-46d9-9d34-d02c26944b73",
                                                "sense_id": "94fdeec6-e88d-3372-8cac-e705e2eaea01",
                                                "text": "Information on the spawning period, spawning behavior, and other details of the reproductive biology of green sturgeon in the Columbia River is lacking (Oregon Department of Fish and Wildlife and Washington Department of Fish and Wildlife 1995)."
                                            },
                                            {
                                                "example_id": "bcfeabf8-a225-4ab5-8e70-28a7595ac978",
                                                "sense_id": "94fdeec6-e88d-3372-8cac-e705e2eaea01",
                                                "text": "Only about one out of every 80 sturgeons caught in the Sacramento River is a Green Sturgeon, and that lopsided ratio is reversed for sturgeons taken in the Klamath River."
                                            },
                                            {
                                                "example_id": "6a509437-abc0-409c-a03a-3031e241c0aa",
                                                "sense_id": "94fdeec6-e88d-3372-8cac-e705e2eaea01",
                                                "text": "In 2009, 120,000 Chinese sturgeons were released into the Yangtze River in an effort to boost the population of the endangered species in the wild."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34112ced-ab05-488e-a6b8-afccfb18792d",
                        "source_entry_id": "f94d89ce-647b-37e4-ab6f-e5c30cab0713",
                        "source_sense_id": "77916b5f-41e8-37c3-8f77-fa109f7b7123",
                        "source_sense_description": "bepaald soort anadrome vis, Acipenser sturio",
                        "target_lang_word": "esturgeon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esturgeon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e29a6242-b610-39d2-a2fe-09c26ba181ee",
                                        "entry_id": "dc835853-25f3-3ab1-9acb-7677645856df",
                                        "glosses": [
                                            "Espèce de poissons cartilagineux longilignes, au museau terminé par une longue pointe, et au corps ayant cinq rangées longitudinales de grosses plaques osseuses, anadromes (remontant les fleuves depuis la mer comme le saumon)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6277a7a-2094-4e38-ba7d-1da8d0e63224",
                                                "sense_id": "e29a6242-b610-39d2-a2fe-09c26ba181ee",
                                                "text": "Les esturgeons fournissent le caviar."
                                            },
                                            {
                                                "example_id": "b9b3b783-c35c-4b6a-8d05-a8edab51dacd",
                                                "sense_id": "e29a6242-b610-39d2-a2fe-09c26ba181ee",
                                                "text": "On pêche fréquemment dans le Rhône le barbeau et le goujon, quelquefois la truite ordinaire, la truite saumonée et même le saumon, le plus souvent la carpe, le brochet et les deux espèces d'anguilles de nos marais , que distinguent fort bien nos pêcheurs et mieux encore nos gourmets. A certaines époques, on y prend des esturgeons et des aloses en grande quantité."
                                            },
                                            {
                                                "example_id": "3bfffd42-8964-4674-820e-0e6a0f15ee6e",
                                                "sense_id": "e29a6242-b610-39d2-a2fe-09c26ba181ee",
                                                "text": "Sur ce chapitre-là mon Jacques restait muet comme un esturgeon."
                                            },
                                            {
                                                "example_id": "e473bf23-8de4-46e0-a14c-ea8360af6170",
                                                "sense_id": "e29a6242-b610-39d2-a2fe-09c26ba181ee",
                                                "text": "Des soudacs et des esturgeons tout argentés battaient l'eau de leur queue puissante et effrayaient les sterlets et les ombres-chevaliers. De grands brochets, à tête de lézard, ouvraient leurs mâchoires armées de dents en scie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "818203d4-26ac-35ec-becb-f6688787394e",
                                        "entry_id": "dc835853-25f3-3ab1-9acb-7677645856df",
                                        "glosses": [
                                            "Œufs d’esturgeon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
