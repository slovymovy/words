                            },
                            {
                                "target_lang_word": "十",
                                "target_lang_sense_clarification": "牌类语境中的简略说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66d612b8-14d5-3e43-804a-ec41b037ee8f",
                    "sense_definition": "To inform on someone to the authorities; to report illegal activity, especially anonymously.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was afraid his partner would <dime> on him to the police.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что его напарник <w>настучит</w> на него в полицию.",
                                "zh": "他怕同伙会向警方<w>告发</w>他。"
                            }
                        },
                        {
                            "text": "Somebody <dimed> him out, and he got arrested the next day.",
                            "target_lang_translations": {
                                "ru": "Кто-то <w>сдал</w> его, и на следующий день его арестовали.",
                                "zh": "有人把他<w>告发</w>了，结果他第二天就被逮捕了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rat on",
                        "snitch",
                        "inform on",
                        "tell on"
                    ],
                    "common_phrases": [
                        "dime on someone",
                        "dime out"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доносить на кого-либо властям; сообщать о незаконной деятельности, особенно анонимно.",
                        "zh": "向警方或有关当局告发某人，尤其指举报其违法行为，常带匿名或出卖的意味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стучать",
                                "target_lang_sense_clarification": "жаргон"
                            },
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "доносить",
                                "target_lang_sense_clarification": "нейтральное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "告发",
                                "target_lang_sense_clarification": "中性到偏口语，指向警方或当局检举某人"
                            },
                            {
                                "target_lang_word": "告密",
                                "target_lang_sense_clarification": "强调秘密告状、出卖别人"
