                ],
                "senses": [
                    {
                        "sense_id": "b68ac74f-2b16-3280-be79-602b84c489e2",
                        "entry_id": "6587412d-1ef2-3cde-9892-093a5de37c18",
                        "glosses": [
                            "A cry of squee."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "653c9f98-381e-4e3b-9f04-b4c412d5d3e1",
                                "sense_id": "b68ac74f-2b16-3280-be79-602b84c489e2",
                                "text": "It's just that the young female group squees seem to come at the most inopportune time. Sure enough, just about every time I'm on the phone — squee. Talking to someone important? Squee."
                            },
                            {
                                "example_id": "98aaf895-43e7-4c9a-adb5-c174ce32dcc8",
                                "sense_id": "b68ac74f-2b16-3280-be79-602b84c489e2",
                                "text": "\"Oughta be more careful, El. Most people aren't accustomed to fanboyish squees.\" \"Well, they aren't going to get used to it without exposure.\" \"Fair 'nough.\""
                            },
                            {
                                "example_id": "b6b27512-e435-4567-8eb9-d22de83fb55c",
                                "sense_id": "b68ac74f-2b16-3280-be79-602b84c489e2",
                                "text": "\"Forgive me. I am imagining the two of you as a couple and it is making me very happy. This must be the 'squee' emotion I have heard so much about.\" \"That is the most dignified squee I've ever seen.\""
                            }
                        ]
                    }
                ],
