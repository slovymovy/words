                    {
                        "translation_id": "af98f2be-aff4-40c3-8ccc-6271095c203a",
                        "source_entry_id": "17ef7bb4-c786-35e4-82a9-a9662432ea32",
                        "source_sense_id": "a4c3b342-eaa6-3dc7-b64c-bd9381d321e4",
                        "source_sense_description": "Tourismus: Stand-by, Standby",
                        "target_lang_word": "Standby",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Standby",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54813487-ffbb-3c8b-8e8a-e268225307de",
                                        "entry_id": "3e6bdd24-6c12-3a7d-9a18-f7f090562ea7",
                                        "glosses": [
                                            "Zustand, in dem ein Gerät jederzeit in Betrieb genommen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14b4de9-aa36-4d93-88f0-b062a0b3c93c",
                                                "sense_id": "54813487-ffbb-3c8b-8e8a-e268225307de",
                                                "text": "Auch im Standby verbrauchen elektronische Geräte immer noch Strom."
                                            },
                                            {
                                                "example_id": "da09b87f-1b26-4727-96d8-d86c049221f0",
                                                "sense_id": "54813487-ffbb-3c8b-8e8a-e268225307de",
                                                "text": "„In meinem Keller horte ich kistenweise 100-Watt-Glühbirnen, und mein Fernseher läuft an Feiertagen knallhart auf Standby.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a03024a6-fe62-4470-8220-a50a80df9f72",
                        "source_entry_id": "17ef7bb4-c786-35e4-82a9-a9662432ea32",
                        "source_sense_id": "3f4b6801-c699-3868-8893-d3b4b856a796",
                        "source_sense_description": "übertragen: Bereitschaft, Ruhezustand",
                        "target_lang_word": "Bereitschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bereitschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f754d5c-9a08-3373-8dff-a36b9e33e762",
                                        "entry_id": "94091ad9-0840-3e56-a25b-43a6bbba7af0",
                                        "glosses": [
                                            "das Fertigsein, um etwas zu tun"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0eb7f25-d080-4e60-a98c-2b0d73ce0abe",
                                                "sense_id": "7f754d5c-9a08-3373-8dff-a36b9e33e762",
                                                "text": "Ich bin in Bereitschaft umzuziehen, sobald ich die Gelegenheit bekomme."
                                            },
                                            {
                                                "example_id": "685de547-017a-4d90-88e0-3d48416d7c09",
                                                "sense_id": "7f754d5c-9a08-3373-8dff-a36b9e33e762",
                                                "text": "„So auch die Bereitschaft, Sport zu treiben.“"
                                            },
                                            {
                                                "example_id": "68361465-67da-461b-8ae2-e946069e4675",
                                                "sense_id": "7f754d5c-9a08-3373-8dff-a36b9e33e762",
                                                "text": "„Während die Extrembergsteiger sowohl in ihren Veröffentlichungen als auch in ihren Auskünften bei meinen Befragungen eine große Offenheit und ein hohes Reflexionsniveau gegenüber diesen Problemstellungen beweisen, offenbart sich bei vielen anderen Risikogruppen noch ein erheblicher Nachholbedarf an Selbstkritik und Bereitschaft, das Gefahrenpotenzial der eigenen Sportart unvoreingenommen objektivieren zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36c4ddc3-2ba9-3219-b4d5-13bcc2812920",
                                        "entry_id": "94091ad9-0840-3e56-a25b-43a6bbba7af0",
                                        "glosses": [
                                            "der Willen, eine anspruchsvolle Aufgabe zu erledigen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec7b065-25b2-4962-8ce1-5971b9d12df6",
                                                "sense_id": "36c4ddc3-2ba9-3219-b4d5-13bcc2812920",
                                                "text": "„Während die Extrembergsteiger sowohl in ihren Veröffentlichungen als auch in ihren Auskünften bei meinen Befragungen eine große Offenheit und ein hohes Reflexionsniveau gegenüber diesen Problemstellungen beweisen, offenbart sich bei vielen anderen Risikogruppen noch ein erheblicher Nachholbedarf an Selbstkritik und Bereitschaft, das Gefahrenpotenzial der eigenen Sportart unvoreingenommen objektivieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "66c219b5-94d6-41b3-afa9-4f783fcb7241",
                                                "sense_id": "36c4ddc3-2ba9-3219-b4d5-13bcc2812920",
                                                "text": "Ohne die Bereitschaft, auch mal am Wochenende zu arbeiten, brauchst du dich dort nicht zu bewerben."
                                            },
                                            {
                                                "example_id": "8cca777f-e9e0-4eca-8531-b7f658afa3da",
                                                "sense_id": "36c4ddc3-2ba9-3219-b4d5-13bcc2812920",
                                                "text": "„Zumindest in Österreich-Ungarn und Rußland scheint die dortige innenpolitische Dauerkrise die Bereitschaft unter den Eliten erhöht zu haben, der Endzeitstimmung durch den Schritt zum Krieg zu entkommen.“"
                                            },
                                            {
                                                "example_id": "01506d8b-cbad-4277-8e4e-42b38eecf59a",
                                                "sense_id": "36c4ddc3-2ba9-3219-b4d5-13bcc2812920",
                                                "text": "„Indirekt schlug Traugott von Jagow also vor, die Bereitschaft zur Annahme von Arbeit durch Kürzung von Unterstützungsleistungen zu erhöhen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a26c6e52-fa62-3668-a3f7-d289e6905b87",
                                        "entry_id": "94091ad9-0840-3e56-a25b-43a6bbba7af0",
                                        "glosses": [
                                            "Gruppe zum Beispiel von Polizei oder Feuerwehr, die zu einem Einsatz fertig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e5370b-66a9-49d8-9c73-d208d412a914",
                                                "sense_id": "a26c6e52-fa62-3668-a3f7-d289e6905b87",
                                                "text": "Die Bereitschaften von Polizei und Rotem Kreuz waren schnell am Unfallort."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3f16cf27-5aa4-38f6-ada2-d5ed855f9ed8",
                                        "entry_id": "94091ad9-0840-3e56-a25b-43a6bbba7af0",
                                        "glosses": [
                                            "Dienst, bei dem man sich zum Einsatz bereit halten muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556b9b7f-61f6-4414-8b5b-4ab41f417942",
                                                "sense_id": "3f16cf27-5aa4-38f6-ada2-d5ed855f9ed8",
                                                "text": "Ich habe heute Bereitschaft, ich kann nicht in die Kneipe gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62f2286c-ba50-4b77-bd1a-a4df2add9fd2",
                        "source_entry_id": "17ef7bb4-c786-35e4-82a9-a9662432ea32",
                        "source_sense_id": "3f4b6801-c699-3868-8893-d3b4b856a796",
                        "source_sense_description": "übertragen: Bereitschaft, Ruhezustand",
                        "target_lang_word": "Ruhezustand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruhezustand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                        "entry_id": "34285e84-761e-30a6-8628-86c86c767d5d",
                                        "glosses": [
                                            "Zustand von jemandem oder etwas in Untätigkeit oder Entspannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450def0f-f290-46e3-89c8-d46eb736779b",
                                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                                "text": "„Jeder Muskel in unserem Körper ist darauf ausgelegt, von einem Spannungszustand zu einem Ruhezustand wechseln zu können.“"
                                            },
                                            {
                                                "example_id": "7de23815-c868-48d0-9dc3-20b547f68fb5",
                                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                                "text": "„Im Ruhezustand liegt die Sauerstoffkonzentration im Muskel bei ungefähr 40 Torr, bei körperlicher Anstrengung verringert sie sich hingegen auf 20 Torr.“"
                                            },
                                            {
                                                "example_id": "1a47b692-22de-411c-aca4-24108219758d",
                                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                                "text": "„Er stellte die Frage, ob sich die Kugel nun bewegt oder im Ruhezustand befindet.“"
                                            },
                                            {
                                                "example_id": "dd5cc3a1-a57a-49ed-a042-c12513c2ad22",
                                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                                "text": "„Dieser Ruhezustand ist auch der Zustand der geringsten Reibung und des geringsten Widerstandes.“"
                                            },
                                            {
                                                "example_id": "082e2f8d-efaf-4ead-8439-2a8e870fcae4",
                                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                                "text": "„Für eine gestörte Psyche wie die eines Serienmörders ist es typisch, dass sich Ruhezustände mit häufig unmotivierten Wutausbrüchen abwechseln.“"
                                            },
                                            {
                                                "example_id": "4d4af08e-e5b3-4258-8e1b-703b6205bdee",
                                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                                "text": "„Triebbedingte Ruhezustände sind Schlaf und Winterschlaf; viele Tiere haben ein ausgeprägtes Appetenzverhalten, das sie nach einem ihrer Art gemäßen Schlafplatz oder Winterschlaf-Versteck suchen läßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                        "entry_id": "34285e84-761e-30a6-8628-86c86c767d5d",
                                        "glosses": [
                                            "Zustand, in dem ein elektronisches Gerät eingeschaltet ist, aber nichts ausführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4048737-a43d-411f-8d1f-875261552bbd",
                                                "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                                "text": "„Viele Netzwerkkarten sind dazu in der Lage, einen abgeschalteten oder im Ruhezustand befindlichen Computer einzuschalten oder aufzuwecken.“"
                                            },
                                            {
                                                "example_id": "803ea8a6-f023-4190-b71f-2f4ce1cf402d",
                                                "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                                "text": "„Befindet sich die CPU nicht lange genug im Ruhezustand, wird der Job nicht gestartet.“"
                                            },
                                            {
                                                "example_id": "b17526a4-cdf3-4e7e-afa8-c772b54c1359",
                                                "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                                "text": "„Im Ausgangszustand befindet sich die Smartcard im Ruhezustand und es findet keine Kommunikation statt.“"
                                            },
                                            {
                                                "example_id": "c1073780-021a-429b-9b70-7d9e58fe8f34",
                                                "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                                "text": "„Wenn Sie das iPad manuell über die Standby-Taste in den Ruhezustand versetzen, muss das nicht bedeuten, dass es auch gesperrt wird.“"
                                            },
                                            {
                                                "example_id": "2a982b77-6f33-4e93-915d-739021d63e67",
                                                "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                                "text": "„Alarme bleiben unter Android auch dann aktiv, wenn sich das Gerät im Ruhezustand befindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
