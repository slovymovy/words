                "senses": [
                    {
                        "sense_id": "c42bde4a-4619-3510-bbe8-a5f004410524",
                        "entry_id": "31e20396-6e54-3d1b-b9db-9c1e2522712e",
                        "glosses": [
                            "ein in sich abgeschlossener, im Radio ausgestrahlter Programmbeitrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64495c9f-25cd-4cb7-9477-8086f6ce7671",
                                "sense_id": "c42bde4a-4619-3510-bbe8-a5f004410524",
                                "text": "›Club aktuell‹ ist eine Radiosendung, die immer Freitag abends gesendet wird."
                            },
                            {
                                "example_id": "fcc98863-2065-4dd2-9eb1-216f336338e6",
                                "sense_id": "c42bde4a-4619-3510-bbe8-a5f004410524",
                                "text": "„Ich habe auch an einer deutschen Radiosendung teilgenommen, die eine improvisierte Diskussion am runden Tisch über das Thema Vorurteil und Toleranz war.“"
                            },
                            {
                                "example_id": "cb36e5de-7c20-4ae5-bb5a-6cf91209e31c",
                                "sense_id": "c42bde4a-4619-3510-bbe8-a5f004410524",
                                "text": "„In Radiosendungen, Filmen, Büchern, Broschüren und öffentlichen Gerichtsverhandlungen soll dem Volk der Täter bewußt werden, welchen Weg es beschritten hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
