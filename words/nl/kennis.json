                                "ru": "Много читая, можно приобрести новые <w>знания</w>.",
                                "pl": "Czytając dużo, można zdobyć nową <w>wiedzę</w>.",
                                "de": "Durch vieles Lesen kann man sich neues <w>Wissen</w> aneignen.",
                                "fr": "En lisant beaucoup, on peut acquérir de nouvelles <w>connaissances</w>.",
                                "it": "Leggendo molto si possono acquisire nuove <w>conoscenze</w>.",
                                "cs": "Čtením můžete získat nové <w>znalosti</w>.",
                                "tr": "Çok okuyarak yeni <w>bilgiler</w> edinebilirsin.",
                                "es": "Al leer mucho puedes adquirir nuevos <w>conocimientos</w>."
                            }
