                                "target_senses": [
                                    {
                                        "sense_id": "6db13a2c-d133-3633-9e1a-5d3f99f598d1",
                                        "entry_id": "f5e336d8-0086-3578-a863-8063b42b15cc",
                                        "glosses": [
                                            "Satz mehrerer zusammengehöriger Gegenstände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb196557-67a0-4ef6-87cb-f11f52dcbab1",
                                                "sense_id": "6db13a2c-d133-3633-9e1a-5d3f99f598d1",
                                                "text": "Ich habe mir ein Set mit zwölf Schraubenschlüsseln gekauft."
                                            },
                                            {
                                                "example_id": "a5fd135b-aa4d-45cc-af61-e3785c62625f",
                                                "sense_id": "6db13a2c-d133-3633-9e1a-5d3f99f598d1",
                                                "text": "„Neben Gefühlen wie Empörung, Verachtung und Enttäuschung enthält sein Set auch eher kognitive Zustände wie Weisheit, Toleranz und Solidarität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb920081-0d2d-3f66-9568-f866d7edaad6",
                                        "entry_id": "f5e336d8-0086-3578-a863-8063b42b15cc",
                                        "glosses": [
                                            "ein Deckchen, das auf dem Tisch vor jedem Platz liegt, auf das man den Teller stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "479a8416-8cf3-4cd0-9e35-435823619ee3",
                                                "sense_id": "eb920081-0d2d-3f66-9568-f866d7edaad6",
                                                "text": "Sie legte die selbstgehäkelten Sets auf den Tisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "62fd1fe1-2942-397b-a5e5-a53a1d534889",
                                        "entry_id": "f5e336d8-0086-3578-a863-8063b42b15cc",
                                        "glosses": [
                                            "ein Ort, an dem gerade Dreharbeiten laufen"
                                        ],
                                        "tags": [
                                            "Film",
                                            "nur Maskulinum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef3a8af-b710-41ca-9c70-baac66924917",
                                                "sense_id": "62fd1fe1-2942-397b-a5e5-a53a1d534889",
                                                "text": "Der Schauspieler ist heute nicht am Set erschienen."
                                            },
                                            {
                                                "example_id": "723e6155-c386-4940-93ce-ca6dea9af459",
                                                "sense_id": "62fd1fe1-2942-397b-a5e5-a53a1d534889",
                                                "text": "„Eben war sie doch noch als Schauspielerin am Set gewesen und musste alles geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf6e4d41-b15b-41e7-ad58-14579e2c4d96",
                        "source_entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "source_sense_id": "0196ebbd-e045-3cd5-8016-ab07e12635bf",
                        "source_sense_description": "(Sport), Manche, partie de match.",
                        "target_lang_word": "Satz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Satz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b73f8267-a54a-32b4-b5ea-4c31ac36331e",
                                        "entry_id": "d205f4a8-0c76-3a79-a942-da92bbf24502",
                                        "glosses": [
                                            "abgeschlossener, nach grammatischen Regeln aufgebauter, sprachlich geäußerter Gedanke; grammatikalische Einheit, bestehend aus einem finiten Verb und allen von diesem Verb verlangten Satzgliedern"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8053a09e-7675-42b1-a756-63f365591f1e",
                                                "sense_id": "b73f8267-a54a-32b4-b5ea-4c31ac36331e",
                                                "text": "Antworte im ganzen Satz."
                                            },
                                            {
                                                "example_id": "f8214917-82aa-4563-ba0d-d1144555e135",
                                                "sense_id": "b73f8267-a54a-32b4-b5ea-4c31ac36331e",
                                                "text": "„Wer spricht oder schreibt, muß sich darüber klar sein, daß es eine natürliche Grenze für die Länge eines Satzes gibt.“"
                                            },
                                            {
                                                "example_id": "661f6b9d-5041-486d-a8f5-052a6460b79c",
                                                "sense_id": "b73f8267-a54a-32b4-b5ea-4c31ac36331e",
                                                "text": "„Er zerpflückte jeden Satz, holte bei den Kommas Luft und verachtete die Punkte.“"
                                            },
                                            {
                                                "example_id": "d82f8886-ad39-4628-85cc-05e0fbd3590b",
                                                "sense_id": "b73f8267-a54a-32b4-b5ea-4c31ac36331e",
                                                "text": "„Und es war nur ein einziger Satz gewesen, keine lange Rede.“"
                                            },
                                            {
                                                "example_id": "6d435a5e-3313-487f-a031-ed103472eb3b",
                                                "sense_id": "b73f8267-a54a-32b4-b5ea-4c31ac36331e",
                                                "text": "„Im Unterschied zu den anderen Satzgliedern kann es in einem Satz mehrere adverbiale Bestimmungen geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8bc2be25-892d-3336-a091-73b3ee87c607",
                                        "entry_id": "d205f4a8-0c76-3a79-a942-da92bbf24502",
                                        "glosses": [
                                            "aus bestimmten Einzelelementen (nach Anzahl) zusammengesetzte Einheit, etwas Zusammengehöriges, etwas Zusammengesetztes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f5b6e7-7c01-49d2-96f8-4545e00ba507",
                                                "sense_id": "8bc2be25-892d-3336-a091-73b3ee87c607",
                                                "text": "Postfrische Briefmarken in vollständigen Sätzen haben einen höheren Wert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7e38e460-7200-30ea-a302-dd5388e7f28e",
                                        "entry_id": "d205f4a8-0c76-3a79-a942-da92bbf24502",
                                        "glosses": [
                                            "Teil, Abschnitt eines Spiels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a862f4-62ea-4751-a924-a40569c5aa97",
                                                "sense_id": "7e38e460-7200-30ea-a302-dd5388e7f28e",
                                                "text": "N. N. hat diesen ersten Satz gewonnen, aber noch lange nicht das Spiel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0fcddfde-9a34-3c5e-83e7-33c51037eb8a",
                                        "entry_id": "d205f4a8-0c76-3a79-a942-da92bbf24502",
                                        "glosses": [
                                            "etwas, was sich gesetzt hat oder abgesetzt wurde (feste Bestandteile in einer Flüssigkeit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "649db9ee-39d4-40f1-a3fd-c92c4441233a",
                                                "sense_id": "0fcddfde-9a34-3c5e-83e7-33c51037eb8a",
                                                "text": "Den Satz in der Tasse mitzutrinken ist unappetitlich."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7c6f10ee-4d91-3fdd-920c-e45ee5334d44",
                                        "entry_id": "d205f4a8-0c76-3a79-a942-da92bbf24502",
                                        "glosses": [
                                            "Sprung oder großer Schritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8105e277-db99-464a-960f-f3dc677d397a",
                                                "sense_id": "7c6f10ee-4d91-3fdd-920c-e45ee5334d44",
                                                "text": "Sie machte plötzlich in ihrer Entwicklung einen Satz nach vorn."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "c2f1d752-a50b-3d5f-8f95-6ea0b62cf8bf",
                                        "entry_id": "d205f4a8-0c76-3a79-a942-da92bbf24502",
                                        "glosses": [
                                            "gängiges, übliches, festgelegtes, vereinbartes Maß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e4dde6-80c0-4f3d-a0d5-124fdf65d11e",
                                                "sense_id": "c2f1d752-a50b-3d5f-8f95-6ea0b62cf8bf",
                                                "text": "Ich bleibe keinen Cent unter dem vereinbarten Satz."
                                            },
                                            {
                                                "example_id": "6f465a2a-f8d4-4c7f-be19-20f565a8476f",
                                                "sense_id": "c2f1d752-a50b-3d5f-8f95-6ea0b62cf8bf",
                                                "text": "„Bei einer Einkommenssteuer stiegen die Sätze von zehn auf 60 Prozent an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "7db779c7-74f2-3d67-b0ce-6fb9d23495bf",
                                        "entry_id": "d205f4a8-0c76-3a79-a942-da92bbf24502",
                                        "glosses": [
                                            "Teil eines Musikstückes"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9e4c78e-9216-4b13-b39f-d82b94f9c88d",
                                                "sense_id": "7db779c7-74f2-3d67-b0ce-6fb9d23495bf",
                                                "text": "Erster Satz – Fortissimo, zweiter Satz – Andante, dritter Satz – Allegro und vierter Satz – Forte."
                                            },
                                            {
                                                "example_id": "c0e18bb3-a090-4c37-ad43-b1af67dc3509",
                                                "sense_id": "7db779c7-74f2-3d67-b0ce-6fb9d23495bf",
                                                "text": "„Auch klassische Musik behandelt sie jetzt so, dass sie zum Beispiel eine Sonate nicht in voller Länge und nicht Satz für Satz einstudiert, sondern meist nur einen einzigen Satz übt und ihn dann mit anderen Klavierstücken verbindet.“"
                                            },
                                            {
                                                "example_id": "ee8a1288-a1ab-44db-85c0-942b2542be02",
                                                "sense_id": "7db779c7-74f2-3d67-b0ce-6fb9d23495bf",
