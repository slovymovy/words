                "senses": [
                    {
                        "sense_id": "8d8e0bca-4414-3262-b074-e769210342ad",
                        "entry_id": "9e64cf72-fbb6-357c-80b5-4076e1f4076a",
                        "glosses": [
                            "Petite carpe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecb98e23-106c-4862-a717-d5d444d3e0a5",
                                "sense_id": "8d8e0bca-4414-3262-b074-e769210342ad",
                                "text": "Un Carpeau qui n'était encore que fretin\nFut pris par un Pêcheur au bord d'une rivière."
                            },
                            {
                                "example_id": "c7fa539d-8b1e-4aa4-9280-a08749b9e70d",
                                "sense_id": "8d8e0bca-4414-3262-b074-e769210342ad",
                                "text": "Il parait qu'à Strasbourg on engraisse les carpeaux du Rhin, et on les fait grossir dans des réservoirs d’où on les tire pour les demandes du pays, et souvent de Paris."
                            }
                        ]
                    },
                    {
                        "sense_id": "87ef1213-2639-3925-804f-6c3b519cc0b7",
                        "entry_id": "9e64cf72-fbb6-357c-80b5-4076e1f4076a",
                        "glosses": [
                            "Variété de carpe que l’on pêche dans le Rhône et dans la Saône et qui est d’un goût fort délicat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c0b9e58-a0f2-4dbf-88e6-3f777a3cb1b1",
                                "sense_id": "87ef1213-2639-3925-804f-6c3b519cc0b7",
                                "text": "Il y a, dans les rivières, des brochets (que l’on quenellise ici aussi), des carpeaux que l’on déguste farcis à la crème."
                            }
                        ]
                    }
                ],
