    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c7293d3-697d-3152-a450-8671827bdcbb",
                    "sense_definition": "iemand of jezelf fysiek of mentaal moe maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moe maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De lange wandeling door de bergen zal ons zeker <w>vermoeien</w>.",
                            "target_lang_translations": {
                                "en": "The long walk through the mountains will certainly <w>tire</w> us."
                            }
                        },
                        {
                            "text": "Je moet jezelf niet te veel <w>vermoeien</w> met al dat extra werk.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>fatigue</w> yourself too much with all that extra work."
                            }
                        }
                    ],
                    "synonyms": [
                        "afmatten",
                        "uitputten"
                    ],
                    "antonyms": [
                        "verkwikken",
                        "rusten"
                    ],
                    "common_phrases": [
                        "jezelf vermoeien",
                        "de ogen vermoeien"
                    ],
                    "target_lang_definitions": {
                        "en": "to make someone or yourself physically or mentally tired"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tire",
                                "target_lang_sense_clarification": "to make weary"
                            },
                            {
                                "target_lang_word": "fatigue",
                                "target_lang_sense_clarification": "to exhaust physically or mentally"
                            },
                            {
                                "target_lang_word": "weary",
                                "target_lang_sense_clarification": "to make tired or impatient"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cc060b0-fd4c-3b7a-94e4-e96d1df32844",
                    "sense_definition": "iemand lastigvallen of vervelen met iets langdurigs",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lastigvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil je niet <w>vermoeien</w> met alle details van mijn vakantie.",
                            "target_lang_translations": {
                                "en": "I don't want to <w>bore</w> you with all the details of my holiday."
                            }
                        },
                        {
                            "text": "Hij bleef de klas <w>vermoeien</w> met zijn eindeloze verhalen over vroeger.",
                            "target_lang_translations": {
                                "en": "He kept <w>wearying</w> the class with his endless stories about the past."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervelen",
                        "lastigvallen"
                    ],
                    "antonyms": [
                        "boeien",
                        "interesseren"
                    ],
                    "common_phrases": [
                        "iemand vermoeien met details"
                    ],
                    "target_lang_definitions": {
                        "en": "to bother or bore someone with something lengthy or tedious"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bore",
                                "target_lang_sense_clarification": "to inspire boredom in somebody"
                            },
                            {
                                "target_lang_word": "weary",
                                "target_lang_sense_clarification": "to exhaust someone's patience"
                            },
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "to bother someone with something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
