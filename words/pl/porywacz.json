{
    "word_family": [
        "porywać",
        "porwanie",
        "porywczy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e73d0d15-2720-3a7e-9e08-5dabc5422561",
                    "sense_definition": "osoba, która bezprawnie uprowadziła innego człowieka",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przestępca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja szybko schwytała <w>porywacza</w> ukrywającego się w lesie.",
                            "target_lang_translations": {
                                "ru": "Полиция быстро поймала <w>похитителя</w>, скрывавшегося в лесу."
                            }
                        },
                        {
                            "text": "Niebezpieczny <w>porywacz</w> zażądał ogromnego okupu za uwolnienie dziecka.",
                            "target_lang_translations": {
                                "ru": "Опасный <w>похититель</w> потребовал огромный выкуп за освобождение ребенка."
                            }
                        }
                    ],
                    "synonyms": [
                        "uprowadziciel"
                    ],
                    "common_phrases": [
                        "groźny porywacz",
                        "schwytać porywacza"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который незаконно похитил другого человека"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похититель",
                                "target_lang_sense_clarification": "лицо, совершившее похищение человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edbf19df-e912-3bb9-94d8-140bc7f00261",
                    "sense_definition": "osoba, która siłą przejęła kontrolę nad środkiem transportu, np. samolotem",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "przestępca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uzbrojony <w>porywacz</w> zmusił pilota do zmiany kursu samolotu.",
                            "target_lang_translations": {
                                "ru": "Вооруженный <w>угонщик</w> заставил пилота изменить курс самолета."
                            }
                        },
                        {
                            "text": "Po wylądowaniu <w>porywacz</w> został obezwładniony przez oddział antyterrorystyczny.",
                            "target_lang_translations": {
                                "ru": "После приземления <w>угонщик</w> был обезврежен антитеррористическим подразделением."
                            }
                        }
                    ],
                    "common_phrases": [
                        "porywacz samolotu"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который силой захватил контроль над транспортным средством, например, самолетом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угонщик",
                                "target_lang_sense_clarification": "лицо, совершившее угон транспортного средства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}