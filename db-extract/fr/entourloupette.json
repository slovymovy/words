        "fr-extract.jsonl": [
            {
                "entry_id": "944e8e4f-3aaa-3958-9202-3e7c47b935e6",
                "word": "entourloupette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "45fca3a5-93ad-4e98-bf95-89ad05c89590",
                        "entry_id": "944e8e4f-3aaa-3958-9202-3e7c47b935e6",
                        "tags": [
                            "plural"
                        ],
                        "form": "entourloupettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75c4ad9a-7f84-3aef-af1b-423f239b46e0",
                        "entry_id": "944e8e4f-3aaa-3958-9202-3e7c47b935e6",
                        "glosses": [
                            "Synonyme de entourloupe."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "49ea7947-62c3-41e1-b027-76f755b3ffe6",
                                "sense_id": "75c4ad9a-7f84-3aef-af1b-423f239b46e0",
                                "text": "… j’ai l’impression que tout ce que je peux faire de mieux c’est de rester là et d’attendre qu’il se passe du neuf, malgré que s’insinue en moi l’intime conviction que ce qu’il va se passer de neuf c’est que quelqu’un va me faire une vache entourloupette…"
                            },
                            {
                                "example_id": "be66e94d-2a14-43c2-9ef0-72582759ee2f",
                                "sense_id": "75c4ad9a-7f84-3aef-af1b-423f239b46e0",
                                "text": "« Il y a cinq ans votre entourloupette aurait fait long feu, jeune homme ! »"
                            },
                            {
                                "example_id": "d72095fb-5bd5-47ae-83c0-3e17b6fc26fc",
                                "sense_id": "75c4ad9a-7f84-3aef-af1b-423f239b46e0",
                                "text": "Je crois la façon qu’ont les gens de vous regarder plus forte que tous les bouquins, et je la hais, l’injure masculine « tu fais du roman, tu as trop d’imagination ma pauvre fille », prétexte à cacher toutes les entourloupettes, les rendez-vous manqués, « non je t’assure que tu as vraiment trop d’imagination »."
                            },
                            {
                                "example_id": "57702de6-9536-43d4-84b0-1131ad696d96",
                                "sense_id": "75c4ad9a-7f84-3aef-af1b-423f239b46e0",
                                "text": "Ça, c’est ce qu’on appelle une entourloupette: éviter le débat de fond, éviter de se prononcer et continuer de patauger dans l’incohérence et l’illogisme."
                            },
                            {
                                "example_id": "a945f682-378d-4943-8334-be6cc541f0f7",
                                "sense_id": "75c4ad9a-7f84-3aef-af1b-423f239b46e0",
                                "text": "Il n’y a pas d’entourloupette, pas de délit d’initiés, pas de magouille, juste des gens qui placent intelligemment leur argent, pour le faire fructifier en toute légalité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "878d0030-6ea0-4cee-ad91-502705925dfd",
                        "source_entry_id": "944e8e4f-3aaa-3958-9202-3e7c47b935e6",
                        "source_sense_id": "75c4ad9a-7f84-3aef-af1b-423f239b46e0",
                        "target_lang_word": "Schabernack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schabernack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                        "entry_id": "1d9872bd-fe4e-3f6d-9260-aaad5f7fd43d",
                                        "glosses": [
                                            "Handlung, mit der jemandem ein Scherz, ein Streich gespielt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c3b735f-750e-44da-b55f-746b6a7b38b7",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "Lass bitte den Schabernack sein!"
                                            },
                                            {
                                                "example_id": "563594ce-635b-4a48-9a03-eb834c316ba3",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "Ich treibe für mein Leben gerne Schabernack!"
                                            },
                                            {
                                                "example_id": "bd2b0a65-301c-46a8-9a58-064640d85aa3",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "„Weil Konrad ein lustiger Bruder war und deshalb bei einem Teile der Jungmannschaft gut gelitten war, so taten sie seinem Schwager einen Schabernack nach dem anderen an.“"
                                            },
                                            {
                                                "example_id": "f7613cd3-90d8-473c-8359-43cafa769b4d",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "„Es war, als ob etwas in ihm, ein innerer Feind, seinen Schabernack mit ihm trieb und ihn in Verlegenheit bringen wollte.“"
                                            },
                                            {
                                                "example_id": "22db87dc-403f-47ed-bb1a-6563d4ac346a",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "„Helmina trieb mit den dreien sogleich ihren Schabernack.“"
                                            },
                                            {
                                                "example_id": "fd707c33-636d-4f7c-99f8-af8b4c70d15d",
                                                "sense_id": "1d7829a2-98a5-327e-9b49-3fdc16acaab5",
                                                "text": "„Heute ist mir nach Schabernack zumute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41b70659-5b36-3fc6-a061-c4d9e9c671ae",
