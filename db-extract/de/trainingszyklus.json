                ],
                "senses": [
                    {
                        "sense_id": "d1642a6b-0b86-3e12-9602-81880b6e4428",
                        "entry_id": "0ded4014-adbc-3d2a-a3a1-652c4a22bb4d",
                        "glosses": [
                            "strukturiert organisierte Abfolge von Trainingseinheiten, die in bestimmten größeren Zyklen abläuft"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f3b4cb38-99f7-45de-86d2-7dd45a5f7b90",
                                "sense_id": "d1642a6b-0b86-3e12-9602-81880b6e4428",
                                "text": "„Ich trainiere seit ca. 10 Monaten mit meinem Personal Trainer und kann mir ein Trainingszyklus ohne seine Einleitung, seine Motivation und seine Unterstützung nicht mehr vorstellen.“"
                            },
                            {
                                "example_id": "17399b08-28a5-464c-be05-173299eb87b1",
                                "sense_id": "d1642a6b-0b86-3e12-9602-81880b6e4428",
                                "text": "„Die Stosch kam am 17. März nach Kiel für den üblichen Trainingszyklus für das Jahr, der am 31. März startete, zurück.“"
                            },
                            {
                                "example_id": "43f73975-29da-4f2e-a2ea-4b112da5f9ae",
                                "sense_id": "d1642a6b-0b86-3e12-9602-81880b6e4428",
                                "text": "„Der Mikrozyklus ist der kurzfristigste Trainingszyklus, erstreckt sich meist über Zeiträume von einer Woche und wiederholt sich im Trainingsprozess.“"
                            },
                            {
                                "example_id": "d966735a-5623-442b-86d4-1306541ce59a",
                                "sense_id": "d1642a6b-0b86-3e12-9602-81880b6e4428",
                                "text": "„Schließlich wird jeder 400-Meter-Läufer auf der Welt ungefähr mit den gleichen Trainingszyklen arbeiten.“"
                            },
                            {
                                "example_id": "b02ff98c-9562-4d53-8247-b57eaaa4b8f2",
                                "sense_id": "d1642a6b-0b86-3e12-9602-81880b6e4428",
                                "text": "„Um Verletzungen vorzubeugen und optimale Ergebnisse zu erzielen, plant Nick bewusste Ruhepausen in seinen Trainingszyklen ein – hierdurch kann der Körper regenerieren und neue Kraft schöpfen.“"
                            },
                            {
                                "example_id": "aa837930-b9cd-46d6-85f5-8521742cb050",
                                "sense_id": "d1642a6b-0b86-3e12-9602-81880b6e4428",
                                "text": "„Mit dem gewonnenen Fokus kannst du in einem Trainingszyklus beispielsweise deine Maximalkraft verbessern und dich im folgenden Zyklus mehr auf die Kraftausdauer konzentrieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e90ffac2-b672-3c7c-b219-d8777817cdbb",
                        "entry_id": "0ded4014-adbc-3d2a-a3a1-652c4a22bb4d",
                        "glosses": [
                            "der gesamte Prozess des Trainings eines KI-Modells (wie eines großen Sprachmodells, LLM), der sich aus mehreren Phasen / Iterationen zusammensetzt"
                        ],
                        "tags": [
                            "künstliche Intelligenz"
                        ],
                        "examples": [
                            {
                                "example_id": "828f7635-b769-4ed6-8bc9-d50d274113fc",
                                "sense_id": "e90ffac2-b672-3c7c-b219-d8777817cdbb",
                                "text": "„Dadurch wird in GPT ein Trainingsset erstellt, das in zukünftigen Trainingszyklen zur Vermeidung von Halluzinationen genutzt werden kann und somit die Qualität und die Zuverlässigkeit der Aussagen erhöht.“"
                            },
                            {
                                "example_id": "30d66a96-a811-494c-a55f-e9241a104b0f",
                                "sense_id": "e90ffac2-b672-3c7c-b219-d8777817cdbb",
                                "text": "„‚Insbesondere die Anbieter von großen Sprachmodellen, sogenannten LLMs, geben oft nur den direkten Energieverbrauch und die Emissionen für einen Trainingszyklus an‘, erklärt KI-Expertin Friederike Rohde vom IÖW.“"
                            },
                            {
                                "example_id": "799d6574-2c67-4331-aa49-c8eccbc9633b",
                                "sense_id": "e90ffac2-b672-3c7c-b219-d8777817cdbb",
                                "text": "„So können Angreifer im Rahmen eines Supervised-Learning-Prozesses die Ergebnisse des Modells durch wiederholte Trainingszyklen in die von ihnen gewünschten Richtungen der Manipulation lenken.“"
                            },
                            {
                                "example_id": "7a7eef7d-0ed1-4a4c-87ca-000c6f02ec15",
                                "sense_id": "e90ffac2-b672-3c7c-b219-d8777817cdbb",
                                "text": "„Ist eine Backdoor einmal im Modell eingepflanzt, bleibt sie auch nach weiteren Trainingszyklen bestehen und lässt sich in späteren Versionen eines Modells aktivieren.“"
                            },
                            {
                                "example_id": "ff4346d7-8879-4bdf-b685-6f782587a918",
                                "sense_id": "e90ffac2-b672-3c7c-b219-d8777817cdbb",
                                "text": "„Weltweit etwa 150 ausgewählte Software- und Beratungsfirmen durchlaufen einen gründlichen und umfassenden Trainingszyklus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
