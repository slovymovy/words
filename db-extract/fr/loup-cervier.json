                ],
                "senses": [
                    {
                        "sense_id": "f0814ffc-23fd-32ed-b6fe-4e7619a14f3c",
                        "entry_id": "9edcefc2-64bb-3412-b4a7-365f45c93b4e",
                        "glosses": [
                            "Terme désignant deux espèces de félins :"
                        ],
                        "tags": [
                            "Félinologie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a5b0e089-aaeb-321e-b3b4-589c504696ca",
                        "entry_id": "9edcefc2-64bb-3412-b4a7-365f45c93b4e",
                        "glosses": [
                            "Terme désignant deux espèces de félins :",
                            "Synonyme de lynx d’Eurasie."
                        ],
                        "tags": [
                            "Félinologie"
                        ],
                        "examples": [
                            {
                                "example_id": "195674ee-e4de-494f-9398-6d5bbdc88bae",
                                "sense_id": "a5b0e089-aaeb-321e-b3b4-589c504696ca",
                                "text": "on parle aussi fort de la férocité du loup-cervier, qui est comme un chat sauvage de la grandeur d’un léopard, et a une veüe si aiguë et perçante, qu’il peut voir à travers une muraille."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cb80566-d162-3cf9-9fa8-c6c1c12a71a8",
                        "entry_id": "9edcefc2-64bb-3412-b4a7-365f45c93b4e",
                        "glosses": [
                            "Terme désignant deux espèces de félins :",
                            "Synonyme de lynx du Canada."
                        ],
                        "tags": [
                            "Félinologie"
                        ],
                        "examples": [
                            {
                                "example_id": "07df5f23-679d-4a7c-8403-a02cadfa1c25",
                                "sense_id": "8cb80566-d162-3cf9-9fa8-c6c1c12a71a8",
                                "text": "Ces animaux souples, agiles, à pelage roux clair et tacheté de mouchetures noirâtres, redoutables même aux rennes, ne sont à vrai dire que des loups-cerviers qui se défendent bravement."
                            },
                            {
                                "example_id": "7ce837d9-a8b0-4f35-95d0-bdd3f8dd575f",
                                "sense_id": "8cb80566-d162-3cf9-9fa8-c6c1c12a71a8",
                                "text": "Il resta immobile et muet quelques instants, attendant le silence, les mains à fond dans les poches de son grand manteau de loup-cervier, plissant le front et fermant à demi ses yeux vifs sous la toque de fourrure profondément enfoncée."
                            }
                        ]
                    },
                    {
                        "sense_id": "1076d4ee-784f-3d70-9eb0-55cfb8bfb88a",
                        "entry_id": "9edcefc2-64bb-3412-b4a7-365f45c93b4e",
                        "glosses": [
                            "Homme féroce. Financier rapace, peu scrupuleux."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0c8d5dc7-6fc2-4aae-8f00-806c02df6319",
                                "sense_id": "1076d4ee-784f-3d70-9eb0-55cfb8bfb88a",
                                "text": "Eh! bien, Esther est un gibier après lequel je vais faire courir ce Loup-cervier de manière à le dégraisser d’un million."
                            },
                            {
                                "example_id": "4c844a07-84fa-4d37-b64e-c574ca9795df",
                                "sense_id": "1076d4ee-784f-3d70-9eb0-55cfb8bfb88a",
                                "text": "Sa mère, madame Roguin, est une fine commère qui fait ce qu’elle veut du fameux banquier du Tillet, l’un des compères de Nucingen, tous deux liés avec les Keller, et ces trois maisons rendent des services ou au gouvernement ou à ses hommes les plus dévoués, les bureaux sont au mieux avec ces loups-cerviers de la Banque, et ces gens-là connaissent tout Paris."
                            }
                        ]
                    }
                ],
