                "translations": [
                    {
                        "translation_id": "f49b891f-2057-4a15-ac55-2101e9c804e0",
                        "source_entry_id": "d3515a11-b4b8-3f37-b07d-d1ce4bd45e83",
                        "source_sense_id": "3346f2a5-ee7d-3119-8ca1-52c23230e594",
                        "target_lang_word": "falconer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falconer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f0b412e-f050-3280-a571-425d4a3d7b00",
                                        "entry_id": "a114f1d1-acce-3df3-858c-72696cdd5034",
                                        "glosses": [
                                            "A person who breeds or trains hawks or other birds of prey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b4df1d-a016-43a6-bdef-d0d177864063",
                                                "sense_id": "6f0b412e-f050-3280-a571-425d4a3d7b00",
                                                "text": "And to add force to his remonstrances, he conferred a cuff or two on the negligent attendant of the hawks, who, shouting rather louder than was necessary under all the circumstances, brought the master falconer to his assistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b951b31e-0906-3d90-b53f-74eb576ea382",
                                        "entry_id": "a114f1d1-acce-3df3-858c-72696cdd5034",
                                        "glosses": [
                                            "One who follows the sport of fowling with hawks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bc2b483-4396-4b1d-80b5-3b187f4d2ba8",
                        "source_entry_id": "d3515a11-b4b8-3f37-b07d-d1ce4bd45e83",
                        "source_sense_id": "3346f2a5-ee7d-3119-8ca1-52c23230e594",
                        "target_lang_word": "fauconnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fauconnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5bc4bec-d451-3463-b247-7461a3623811",
                                        "entry_id": "05927590-f55a-3922-bb2a-1e9a6a7bc6ef",
                                        "glosses": [
                                            "Celui qui dresse et gouverne les oiseaux de proie et qui les fait voler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "033fa2a6-7dc6-4d09-84ea-7200e555cd15",
                                                "sense_id": "d5bc4bec-d451-3463-b247-7461a3623811",
                                                "text": "Ils ont même fondé un village qui , à un certain temps , était presqu’exclusivement habité par des fauconniers et qui doit à l'industrie du piégeage qui le fit vivre le nom qu'il porte encore aujourd'hui de Valkenswaard , « le village des Faucons »."
                                            },
                                            {
                                                "example_id": "612f750e-46a8-4f85-9e88-a5f5816f7aa8",
                                                "sense_id": "d5bc4bec-d451-3463-b247-7461a3623811",
                                                "text": "L'opération principale était la ciliure, qui consistait à coudre les paupières de l'oiseau; on lui rendait l'usage de la lumière quand il était habitué à obéir à la voix du fauconnier; […]."
                                            },
                                            {
                                                "example_id": "8cafdab2-fdc2-4f28-9ec1-74df519635d5",
                                                "sense_id": "d5bc4bec-d451-3463-b247-7461a3623811",
                                                "text": "Monter à cheval en fauconnier : Monter du côté droit, du pied droit, comme faisaient les fauconniers, parce qu’ils tenaient l’oiseau sur le poing gauche."
                                            },
                                            {
                                                "example_id": "5ff6ed82-cb6f-4f8f-be17-0020fb3da967",
                                                "sense_id": "d5bc4bec-d451-3463-b247-7461a3623811",
                                                "text": "Grand fauconnier : Le chef de la fauconnerie royale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fauconnier",
                                "target_lang_code": "fr",
                                "target_senses": [
