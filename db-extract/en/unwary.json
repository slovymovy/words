                                        "entry_id": "9e2daab9-8880-38b6-98e7-8a0d80516a9b",
                                        "glosses": [
                                            "die notwendige Wachsamkeit und/oder Achtsamkeit vermissen lassend; die negativen Folgen oder Schäden seines Handelns außer Acht lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dc3ca62-7d35-4bf4-8a71-907ed06eb7e5",
                                                "sense_id": "cc09dfa2-c472-3828-a7ca-bcb4355f2874",
                                                "text": "„Meist sind es Brandstiftung und das unvorsichtige Verhalten von Waldbesuchern sowie Fahrlässigkeit bei forst- und landwirtschaftlichen Arbeiten, die Flammen den Weg bereiten.“"
                                            },
                                            {
                                                "example_id": "57f6e1f1-a1d9-4acf-b32a-0d1be01d30ae",
                                                "sense_id": "cc09dfa2-c472-3828-a7ca-bcb4355f2874",
                                                "text": "„Kriminelle haben offenbar eine Schwachstelle des Mobilfunk-Netzes gefunden, um die Konten von unvorsichtigen Bankkunden leerzuräumen.“"
                                            },
                                            {
                                                "example_id": "c9ab026f-0726-4fc4-bce9-70a8c8c56b29",
                                                "sense_id": "cc09dfa2-c472-3828-a7ca-bcb4355f2874",
                                                "text": "„Der jüngste, heißblütigste und auch unvorsichtigste unter allen diesen Söldnerführern war Christian Herzog von Braunschweig-Wolfenbüttel, der protestantische Administrator von Halberstadt.“"
                                            }
