                "senses": [
                    {
                        "sense_id": "630fc502-87f4-3a99-8eca-797ccc3af3c0",
                        "entry_id": "25b1aee3-8585-31d8-beb2-34076e2a0160",
                        "glosses": [
                            "Élever à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c30fab09-cf20-4981-93ba-2df37b5309b9",
                                "sense_id": "630fc502-87f4-3a99-8eca-797ccc3af3c0",
                                "text": "Il avait été repéré un élargissement de la Vrille au niveau du petit pont, M. CACHELEUX a fait procéder à un remblaiement avec des bordures de trottoirs et de la terre pour ré-élever le sol afin que la Vrille ne déborde plus à cet endroit."
                            },
                            {
                                "example_id": "5550edec-9792-4b7d-bcc9-954892ed6fa5",
                                "sense_id": "630fc502-87f4-3a99-8eca-797ccc3af3c0",
                                "text": "Il a été programmé de manière à annihiler les effets délétères de ces compteurs sur le plan énergétique et permettre de ré-élever le niveau vibratoire de votre habitat."
                            },
                            {
                                "example_id": "12deb165-4fec-4649-9dda-1691b7361664",
                                "sense_id": "630fc502-87f4-3a99-8eca-797ccc3af3c0",
                                "text": "ainsi nous pouvons espérer ré-élever le niveau de ces newsgroups au niveau qu'ils avaient précédemment."
                            },
                            {
                                "example_id": "5df3e082-d34b-44a9-a6c8-eda0c70e01f9",
                                "sense_id": "630fc502-87f4-3a99-8eca-797ccc3af3c0",
                                "text": "Il faut avoir des prédispositions à ré-élever le niveau, à anticiper le fait que cela allait être un match compliqué."
                            }
                        ]
                    }
                ],
