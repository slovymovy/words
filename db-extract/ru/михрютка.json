                "senses": [
                    {
                        "sense_id": "c740269d-0478-3d33-821f-9d2342064d31",
                        "entry_id": "5e058046-d7d6-33c9-b58d-f9b7d9cc47b4",
                        "glosses": [
                            "прост., презр. тщедушный, невзрачный или неловкий человек; замухрышка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a5a23ff-9c58-44d7-a4d3-e1dd0a49e994",
                                "sense_id": "c740269d-0478-3d33-821f-9d2342064d31",
                                "text": "— Экий ты, братец, михрютка, — кротко упрекнул капитан. — Нужно идти сразу, когда зовут."
                            },
                            {
                                "example_id": "a69cc614-5fc2-42bb-95ee-43dedd53b01e",
                                "sense_id": "c740269d-0478-3d33-821f-9d2342064d31",
                                "text": "— Знаю я вас, мошенников… михрютки вы сиволапые! Так один за другого и тянете."
                            }
                        ]
                    }
                ],
