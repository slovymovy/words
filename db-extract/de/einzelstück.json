                        ],
                        "form": "die Einzelstücke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f27d8f1-91f4-3d6b-9f4d-f2e55a244cfe",
                        "entry_id": "386922b3-fbb7-3e12-bc30-f4db7b03ff86",
                        "glosses": [
                            "ein Exemplar von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ee783d4-03c7-4e98-a83c-ee306af356df",
                                "sense_id": "3f27d8f1-91f4-3d6b-9f4d-f2e55a244cfe",
                                "text": "„Sofern Sie ein Einzelstück erwerben, bringt der Hinweis darauf, dass ja schon wer weiss wie viele Leute vor Ihnen die Kühlschranktür geöffnet haben und man deshalb nicht den vollen Preis verlangen könnte, weitere Verbilligungs-Argumente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3cfdc77a-a72c-333a-8ed3-87fd0dcf82d6",
                        "entry_id": "386922b3-fbb7-3e12-bc30-f4db7b03ff86",
                        "glosses": [
                            "Gegenstand, der einmalig ist/der nur ein einziges Mal existiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4c55dcd-4f2f-4ba8-aca4-c1bf2374f52c",
                                "sense_id": "3cfdc77a-a72c-333a-8ed3-87fd0dcf82d6",
                                "text": "„Herausragende Einzelstücke der keltischen Kunst aus Britannien sind der Bronzebeschlag eines Schildes, der im 19. Jahrhundert im Fluss Witham bei Lincoln zutage kam, sowie die beiden Schildbuckel aus Bronze, die ebenfalls im 19. Jahrhundert bei Wandsworth in der Themse gefunden wurden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
