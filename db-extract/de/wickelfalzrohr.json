                "senses": [
                    {
                        "sense_id": "730b766f-99de-3530-8606-897c7b99cfff",
                        "entry_id": "14204071-29b4-3aa4-bca0-97ba8915d02f",
                        "glosses": [
                            "aus einem Blechstreifen gewickeltes und durch Falzen verbundenes Rohr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7786fc1-7635-4680-96eb-0d5f5db289bd",
                                "sense_id": "730b766f-99de-3530-8606-897c7b99cfff",
                                "text": "„Ein klassisches Beispiel ist das Wickelfalzrohr, bei dem ein schräg aufgewickelter Blechstreifen durch Falzverbindung seiner Ränder ein gerades oder gebogenes Rohr bildet.“"
                            },
                            {
                                "example_id": "f827a9b1-73f5-4f1c-bc5a-666975192e28",
                                "sense_id": "730b766f-99de-3530-8606-897c7b99cfff",
                                "text": "„Bewährt haben sich Systeme aus Wickelfalzrohr (verzinktes Blech) und Flachkanäle aus Kunststoff, die auch kombinierbar sind.“"
                            },
                            {
                                "example_id": "e21acd5c-0ccd-45d3-867f-6585e361de64",
                                "sense_id": "730b766f-99de-3530-8606-897c7b99cfff",
                                "text": "„Oft werden Leitungsführungen mit Wickelfalzrohr verwirklicht, aber auch das MINI-Kanalsystem findet hier Anwendung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
