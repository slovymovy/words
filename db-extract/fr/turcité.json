                        "entry_id": "bfd54dac-1940-3ec0-853b-26d9d9e91b90",
                        "glosses": [
                            "identité turcique ou appartenance à un groupe ethnique d’origine turcique ou turque"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d372981-32df-4f1c-aaf2-202df6f85734",
                                "sense_id": "4d5e2457-fcf2-3b8e-ad73-e6829f928776",
                                "text": "Ankara a simplement proclamé la « turcité » des Kurdes, avant d’assouplir sa doctrine dans les années 1990, puis de reconnaître la culture et l’identité kurde en juillet 2002."
                            },
                            {
                                "example_id": "3f170fd1-8296-4124-946c-f9b80407ef4d",
                                "sense_id": "4d5e2457-fcf2-3b8e-ad73-e6829f928776",
                                "text": "Depuis les indépendances, on assiste à un clivage entre la république de Turquie et les États d’Asie centrale sur la notion de turcité."
                            },
                            {
                                "example_id": "15ef4822-56f2-4ddd-8890-67e7a79f8bc1",
                                "sense_id": "4d5e2457-fcf2-3b8e-ad73-e6829f928776",
                                "text": "Le mot turkluk abstrait de turk et qui signifie « le peuple turc, la cause turque, la qualité de turc, la turcité » ne doit pas être confondu avec turkdjuluk « turquisme »."
                            }
                        ]
                    }
