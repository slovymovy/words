                            {
                                "example_id": "ac35d2e3-e00f-4ab4-8e7d-9e151c230e2e",
                                "sense_id": "56caec78-a08b-355f-918e-e84abe721195",
                                "text": "Er trinkt frühmorgens gerne eine Tasse Kaffee."
                            },
                            {
                                "example_id": "c553b02e-8a2a-4c53-8d44-54ef34c00280",
                                "sense_id": "56caec78-a08b-355f-918e-e84abe721195",
                                "text": "„Er brach frühmorgens auf, kehrte abends wieder, ohne Kopfbedeckung, die Jacke zerrissen und die Hosen mit Schlamm beschmutzt.“"
                            },
                            {
                                "example_id": "54056aa8-bde7-441e-8587-2175abf6f270",
                                "sense_id": "56caec78-a08b-355f-918e-e84abe721195",
                                "text": "„Ich versprach also, am nächsten Tag frühmorgens mit ihnen aufzubrechen.“"
                            }
                        ],
