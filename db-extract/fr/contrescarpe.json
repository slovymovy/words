                        "glosses": [
                            "Partie de l'enceinte comprenant le mur extérieur du fossé et le glacis qui le prolonge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d134bbc6-a3c9-430a-b1dc-0691a64b316c",
                                "sense_id": "b92a094d-3a84-3736-a9e5-7e425fecb9a2",
                                "text": "Tout au plus essaierait-on de dégager la partie antérieure de l'enceinte, de manière à former un fossé dont la contrescarpe protégerait encore la palissade."
                            },
                            {
                                "example_id": "75e5cf48-d106-4c54-acf7-78bc2526a43d",
                                "sense_id": "b92a094d-3a84-3736-a9e5-7e425fecb9a2",
                                "text": "Le mur de contrescarpe était haut et paraissait difficile à escalader."
                            }
                        ]
