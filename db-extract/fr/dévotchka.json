                "translations": [
                    {
                        "translation_id": "2ef0052e-6d9d-4ce8-a188-444d32beaea7",
                        "source_entry_id": "d097ed4e-4b37-3a9a-a643-216b77641745",
                        "source_sense_id": "775fd157-e762-3075-8cd8-5102c009b8a6",
                        "target_lang_word": "devotchka",
                        "target_lang_code": "en",
