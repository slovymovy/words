                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa8472b0-15f4-4da4-a7c5-bfad866623cd",
                                "sense_id": "ce81cfcb-9c39-3891-96c0-f3885bd39b3c",
                                "text": "„De wijwaterbak zou wel eens een bron van besmetting kunnen zijn”, stelde Honings, pastoor van het cluster Roerstreek met kerken in Posterholt, Vlodrop, Montfort, Sint-Odilienberg, Melick en Herkenbosch. Hij riep de kerkgangers verder op zich te"
                            },
                            {
                                "example_id": "3b166af4-5f70-462a-b8e2-30b2029cdc4c",
                                "sense_id": "ce81cfcb-9c39-3891-96c0-f3885bd39b3c",
                                "text": "Hij was het binnenste toen te gemoet geloopen, de stoeptrap op en was bij de wijwaterbak blijven staan."
                            }
                        ]
                    }
