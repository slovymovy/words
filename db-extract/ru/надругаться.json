                    {
                        "form_id": "eaaaea9a-06b4-422a-bec9-36e1a06920ea",
                        "entry_id": "bd0b09cc-e1aa-35a4-8536-55010b17a224",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "надруга́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62708f61-4460-3a5e-837b-4bbe0bd5a702",
                        "entry_id": "bd0b09cc-e1aa-35a4-8536-55010b17a224",
                        "glosses": [
                            "подвергнуть кого-либо, что-либо надругательству, грубому, оскорбительному издевательству"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d49041-cdbe-42dd-950f-cb60dffee33a",
                                "sense_id": "62708f61-4460-3a5e-837b-4bbe0bd5a702",
                                "text": "И его убийца пришёл теперь обезглавить труп недавнего друга, надругаться над его останками; как вор гробокопный, пришёл похитить достояние могилы, спорить с чакалами о добыче."
                            },
                            {
                                "example_id": "93b5cbac-1b41-49c2-b9d3-ed9fc424b6aa",
                                "sense_id": "62708f61-4460-3a5e-837b-4bbe0bd5a702",
                                "text": "Он обворовал церковь, но ему мало было обворовать её: он сорвал покров с алтаря и надругался над ним."
                            },
                            {
                                "example_id": "d36b0351-a216-405b-86fd-009fed03cf61",
                                "sense_id": "62708f61-4460-3a5e-837b-4bbe0bd5a702",
                                "text": "Потом схватили Гиршфельдта, повели его в лес, раздели, привязали к дереву, истязали и надругались над ним, после чего убили."
                            }
                        ]
                    },
                    {
                        "sense_id": "15375f3a-a56e-3086-9f75-af47fb2045e9",
                        "entry_id": "bd0b09cc-e1aa-35a4-8536-55010b17a224",
                        "glosses": [
                            "совершить сексуальное насилие над кем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79826fe1-1dec-49eb-b1b2-670f838394b5",
                                "sense_id": "15375f3a-a56e-3086-9f75-af47fb2045e9",
                                "text": "Они затащили её в конюшню, надругались над девочкой и закололи её ножом в спину."
                            },
                            {
                                "example_id": "11b872fb-01eb-4a5a-8ead-6f8b83ef3443",
                                "sense_id": "15375f3a-a56e-3086-9f75-af47fb2045e9",
                                "text": "К графине Демидовой, старухе семидесяти лет, ночью залезли уголовные: графиню убили, дом разграбили, надругались над девушкой-приживалкой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93ea4bda-e5d8-4404-bc27-112b5b9904f5",
                        "source_entry_id": "bd0b09cc-e1aa-35a4-8536-55010b17a224",
                        "target_lang_word": "outrage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outrage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29ce8576-2214-3cf0-ba59-4570f13af9e7",
                                        "entry_id": "87622073-4ff3-3d74-adfe-eea05537da74",
                                        "glosses": [
                                            "An excessively violent or vicious attack; an atrocity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be92a211-85ea-45d6-8dbc-5204b4b8b967",
                                                "sense_id": "29ce8576-2214-3cf0-ba59-4570f13af9e7",
                                                "text": "There the cause of death was soon ascertained ; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which […] was subsequently found under the cushions of the hansom.[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28b343d1-c1da-3102-b817-b6e80a84212b",
                                        "entry_id": "87622073-4ff3-3d74-adfe-eea05537da74",
                                        "glosses": [
                                            "An offensive, immoral or indecent act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc70b84e-e035-3cc4-90fc-07aceb8163b3",
                                        "entry_id": "87622073-4ff3-3d74-adfe-eea05537da74",
                                        "glosses": [
                                            "The resentful, indignant, or shocked anger aroused by such acts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6d2d24d-805c-390e-856e-8715ecf5948f",
                                        "entry_id": "87622073-4ff3-3d74-adfe-eea05537da74",
                                        "glosses": [
                                            "A destructive rampage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32355ea1-cb39-44a2-b421-e7b775ddea3b",
                                                "sense_id": "f6d2d24d-805c-390e-856e-8715ecf5948f",
                                                "text": "The Lords acknowledge the great and happy Providence of Almighty God, in the preventing of ſo horrid an Outrage, which might have endangered the Lives of the Chief Magiſtrates, and alſo hazarded the Spoil of the whole City of London."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outrage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4085745-56ab-35f9-ae62-e0fdc7295bc6",
                                        "entry_id": "8b9db6f2-9411-39ca-b60a-3b869aa1cc8b",
                                        "glosses": [
                                            "To cause or commit an outrage upon; to treat with violence or abuse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b1d4c7a-e822-4f06-b613-c42417d6ef3a",
                                                "sense_id": "a4085745-56ab-35f9-ae62-e0fdc7295bc6",
                                                "text": "August 30, 1706, Francis Atterbury, a sermon preach'd in the Cathedral Church of St. Paul, at the funeral of Mr. Tho. Bennet\nBase and insolent minds […] outrage men when they have Hopes of doing it without a Return."
                                            },
                                            {
                                                "example_id": "eb53fcb0-3e0c-4520-8758-26d792faf850",
                                                "sense_id": "a4085745-56ab-35f9-ae62-e0fdc7295bc6",
                                                "text": "1725-1726, William Broome, Odyssey\nThe interview […] outrages all the rules of decency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeb8d9d9-4567-3b99-87d6-861e4541abb0",
                                        "entry_id": "8b9db6f2-9411-39ca-b60a-3b869aa1cc8b",
                                        "glosses": [
                                            "To inspire feelings of outrage in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4f41a09-fd46-40a6-9d10-09738e23ff57",
                                                "sense_id": "eeb8d9d9-4567-3b99-87d6-861e4541abb0",
                                                "text": "The senator's comments outraged the community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dbd6ee0-424e-36f8-87a2-ef98a6d3bf44",
                                        "entry_id": "8b9db6f2-9411-39ca-b60a-3b869aa1cc8b",
                                        "glosses": [
                                            "To sexually violate; to rape."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2857a7a1-2a95-37c3-80f0-93644bee2aa3",
                                        "entry_id": "8b9db6f2-9411-39ca-b60a-3b869aa1cc8b",
                                        "glosses": [
                                            "To rage in excess of."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef7888a-2729-4c48-b0d6-3ff6033b5535",
                                                "sense_id": "2857a7a1-2a95-37c3-80f0-93644bee2aa3",
                                                "text": "Their will the tiger sucked, outraged the storm"
