                                "sense_id": "4c694a7b-fd66-3a40-99f1-3840fcf78faf",
                                "text": "Karol Wojtyła został ochrzczony w Wadowicach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e482fcec-de95-3afa-8cf3-769679a4eb26",
                        "entry_id": "f7e560ad-3693-35be-9afe-3ff84347b80c",
                        "glosses": [
                            "uczynić nad kimś znak inicjujący nową jakość w życiu, zrywający z przeszłością"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7d74991d-f401-475a-afcb-63801064eed8",
                                "sense_id": "e482fcec-de95-3afa-8cf3-769679a4eb26",
                                "text": "Jan chrzcił wodą, ale wy wkrótce zostaniecie ochrzczeni Duchem Świętym."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
