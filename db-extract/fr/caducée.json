                                        "entry_id": "c34646fe-216e-3766-a6d0-9a62ea0e2125",
                                        "glosses": [
                                            "staf van Mercurius, met bovenaan twee vleugels en omwonden door twee slangen, in de oudheid gedragen door boodschappers als teken van hun functie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09868485-52f9-4e64-be7a-89dbae95b352",
                                                "sense_id": "35e603c3-e4b5-34b5-9126-1a3c7d37f2fe",
                                                "text": "De caduceus van Mercurius en de staf die Aaron volgens de bijbel bij zich had, was een traditioneel symbool van macht dat ook de magiërs van de Egyptische farao's gebruikten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f66acb0-2618-3c41-b45e-d0d4d8ad3bab",
                                        "entry_id": "c34646fe-216e-3766-a6d0-9a62ea0e2125",
                                        "glosses": [
                                            "weergave van de staf van Mercurius, gebruikt als symbool voor boodschappers en kooplieden en daarmee voor vrede en voorspoed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd19f1f-6c27-4ad9-9800-0dd970c4aae6",
                                                "sense_id": "5f66acb0-2618-3c41-b45e-d0d4d8ad3bab",
                                                "text": "De emblemen in het midden van de twee vleugels van de balustrade drukken de idee van verbinding, en de zegeningen van de vrede uit. Het linker toont in een krans twee verenigde rechterhanden, waarboven een caduceus en enkele korenaren."
                                            }
                                        ]
                                    }
                                ]
                            }
