                {
                    "sense_id": "b150afd7-15d8-3613-877a-dd797b78d523",
                    "sense_definition": "Тактическое войсковое соединение, состоящее из нескольких батальонов или дивизионов.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
