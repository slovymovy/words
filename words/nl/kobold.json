                {
                    "sense_id": "17272e18-155c-339c-b5e9-fd7b7133cc23",
                    "sense_definition": "Een aardgeest of kwaadaardige kabouter in de Germaanse mythologie en volksverhalen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het oude sprookje woonde er een boosaardige <w>kobold</w> die reizigers dwarsboomde.Het dorp was bang voor de streken van de <w>kobold</w>.",
                            "target_lang_translations": {
                                "en": "In the old fairy tale, there lived a wicked <w>goblin</w> who thwarted travelers. The village was afraid of the <w>goblin</w>'s tricks."
                            }
                        },
                        {
                            "text": "De kleine <w>kobold</w> verstopt zich het liefst in donkere bossen.",
                            "target_lang_translations": {
                                "en": "The small <w>kobold</w> prefers to hide in dark forests."
                            }
                        }
                    ],
                    "synonyms": [
                        "aardgeest",
                        "kabouter"
                    ],
                    "common_phrases": [
                        "boosaardige kobold",
                        "kleine kobold"
                    ],
                    "target_lang_definitions": {
                        "en": "An earth spirit or malevolent goblin in Germanic mythology and folklore."
                    },
                    "translations": {
                        "en": [
                            {
