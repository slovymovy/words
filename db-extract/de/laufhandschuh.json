                "senses": [
                    {
                        "sense_id": "1db8d964-88be-328a-8c17-8ffd1109fe45",
                        "entry_id": "2f19b77f-1ce6-380d-8111-55121b95b974",
                        "glosses": [
                            "Handschuh, der speziell für das Laufen (bei kühlerem Wetter) bestimmt ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "ba28649b-3576-4a60-b867-57d67a2b03bd",
                                "sense_id": "1db8d964-88be-328a-8c17-8ffd1109fe45",
                                "text": "„Eine Laufmütze auf dem Kopf und Laufhandschuhe an den Fingern vervollständigten mein Winter-Outfit.“"
                            },
                            {
                                "example_id": "de83e31e-2aef-4569-8427-767aca22b2cd",
                                "sense_id": "1db8d964-88be-328a-8c17-8ffd1109fe45",
                                "text": "„Kombinieren Sie unsere Laufhandschuhe für Frauen mit unseren Damen-Hoodies und -Sweatshirts für einen bequemen Lauf in den kälteren Monaten und entdecken Sie unsere Mützen für Frauen, um Ihre Ohren kuschelig und kühl zu halten.“"
                            },
                            {
                                "example_id": "6010800a-3f6c-4632-a833-bd28d524a1a7",
                                "sense_id": "1db8d964-88be-328a-8c17-8ffd1109fe45",
                                "text": "„Nimm also nach Möglichkeit Gummihandschuhe, Laufhandschuhe oder Gartenhandschuhe mit, wenn du beabsichtigst Müll zu sammeln.“"
                            },
                            {
                                "example_id": "a864bf5d-6e2a-40ae-bae8-e079b19aab56",
                                "sense_id": "1db8d964-88be-328a-8c17-8ffd1109fe45",
                                "text": "„Zum Beispiel gibt es Laufhandschuhe mit Touch-Funktion – um auch bei kalten Temperaturen während dem Laufen seine Fitnessuhr oder sein Smartphone checken zu können.“"
                            },
                            {
                                "example_id": "2fccf6c2-446f-4b67-a1bf-5a6cc461c56b",
                                "sense_id": "1db8d964-88be-328a-8c17-8ffd1109fe45",
                                "text": "„Dazu kommen Laufhandschuhe und ein Schlauchschal, den ich bei kalten Temperaturen über dem Mund trage, um nicht direkt die kalte Luft einzuatmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
