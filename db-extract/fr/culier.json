                        "sense_id": "b2ca77f7-1a0b-36e0-b448-638237e5314a",
                        "entry_id": "57ef60c6-cdb0-3079-9d7b-e38b0d171b08",
                        "glosses": [
                            "Qui se termine à l’anus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42840513-e192-49ce-a07b-6315bdf46ce7",
                                "sense_id": "b2ca77f7-1a0b-36e0-b448-638237e5314a",
                                "text": "Boyau culier. On dit plus ordinairement rectum."
                            },
                            {
                                "example_id": "0553a867-df91-4470-a528-17ab3f5ca727",
                                "sense_id": "b2ca77f7-1a0b-36e0-b448-638237e5314a",
                                "text": "Il apercevait le bas de l'épine dorsale un peu saillante et en dessous, la raie culière commençait."
                            },
                            {
                                "example_id": "612d3c65-7893-4530-982c-9414d2c7ec8a",
                                "sense_id": "b2ca77f7-1a0b-36e0-b448-638237e5314a",
                                "text": "Sangle culière ou absolument culière, sangle fixée au derrière du cheval pour immobiliser la selle."
                            },
                            {
                                "example_id": "eb5da6c3-81d8-4b1d-87a1-f2e4c5d8fa17",
                                "sense_id": "b2ca77f7-1a0b-36e0-b448-638237e5314a",
                                "text": "A d'autres, à travers les couilles il perçait le boyau culier."
                            },
                            {
                                "example_id": "8753ed16-486d-4eda-a6cc-0770b7220621",
                                "sense_id": "b2ca77f7-1a0b-36e0-b448-638237e5314a",
                                "text": "De la relaxation du boyau culier"
                            },
                            {
                                "example_id": "0bc8db24-e717-4a1f-971c-8cde9bf40386",
                                "sense_id": "b2ca77f7-1a0b-36e0-b448-638237e5314a",
                                "text": "Je m'enflamme à la vue d'une croupe, je me consume pour une raie culière, et j'entre en extase devant un anus joliment étoilé."
                            }
                        ]
                    }
