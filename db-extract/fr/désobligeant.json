                        "entry_id": "bff5e6b7-5146-33bf-8c1d-dee5e12f3e42",
                        "glosses": [
                            "Qui est porté à la désobligeance, à ne pas rendre service."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "cd29d351-fd07-4a6d-b4d0-c96750e2a382",
                                "sense_id": "a97e4e35-1f91-3ed7-820b-c8ee36e69263",
                                "text": "Il a toujours été désobligeant à mon égard."
                            }
                        ]
                    },
                    {
                        "sense_id": "30636d42-c8f5-37ed-9283-39f70b80764a",
                        "entry_id": "bff5e6b7-5146-33bf-8c1d-dee5e12f3e42",
                        "glosses": [
                            "Peu aimable."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "86828f46-aebb-4da6-8ae3-f2efbae03f3e",
                                "sense_id": "30636d42-c8f5-37ed-9283-39f70b80764a",
                                "text": "Ne soyez pas désobligeant."
                            },
                            {
                                "example_id": "ddfaffe7-6a31-4f0b-bc5a-f9adc1c92a62",
                                "sense_id": "30636d42-c8f5-37ed-9283-39f70b80764a",
                                "text": "Il leur arrivait de faire des réflexions désobligeantes : « Alors ? ta maman trotte toujours ? »"
                            }
                        ]
