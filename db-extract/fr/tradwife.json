                "senses": [
                    {
                        "sense_id": "7b0a84f5-ce7a-396b-97d6-1d24407437f1",
                        "entry_id": "ddf6624f-5057-3f90-b060-8e1317a09b39",
                        "glosses": [
                            "Femme pratiquante du mouvement TradWife, soumise à son mari, sans emploi et s’occupant du foyer, à l’instar des femmes des années 1950."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "a2963eff-c971-45b8-8916-65ac36ae833d",
                                "sense_id": "7b0a84f5-ce7a-396b-97d6-1d24407437f1",
                                "text": "\"Me soumettre à mon mari comme en 1959\". C’est le mot d’ordre très sérieux - et presque provoc’ - des \"tradwives\", ces femmes qui, à l’heure des grandes révolutions pour l’égalité des sexes, souhaitent en revenir aux assignations de genre les plus désuètes, pour ne pas dire rétrogrades"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97c9fdea-d23b-4530-ad3a-54f55bd02bf6",
                        "source_entry_id": "ddf6624f-5057-3f90-b060-8e1317a09b39",
                        "source_sense_id": "7b0a84f5-ce7a-396b-97d6-1d24407437f1",
                        "target_lang_word": "tradwife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tradwife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f309b6f8-9703-308a-9068-52004437bcbc",
                                        "entry_id": "7fa77e7f-7b99-3266-8871-8fb6066bd2fc",
                                        "glosses": [
                                            "A wife who fulfills a traditional gender role based on Western middle-class femininity of the mid twentieth century."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb8dccd3-3f81-4d85-bea4-4f15e76a127f",
                                                "sense_id": "f309b6f8-9703-308a-9068-52004437bcbc",
                                                "text": "I hate her, hate groups, incel, tradwives, the fact that I don't usually hate anybody, ..."
                                            },
                                            {
                                                "example_id": "0221dd07-d3af-4d5e-b0d6-a5fd7ec5f587",
                                                "sense_id": "f309b6f8-9703-308a-9068-52004437bcbc",
                                                "text": "The tradwife movement is one of the most concerning trends to have emerged in the past few years, with more and more women looking to switch their careers and independence for tending to hearth and home - and every will of their husbands."
                                            },
                                            {
                                                "example_id": "266e5175-5bfc-431e-8ab1-20f9eefb32e2",
                                                "sense_id": "f309b6f8-9703-308a-9068-52004437bcbc",
                                                "text": "Ms. Jorgenson is being interviewed on Radio 3Fourteen, a white supremacist talk radio program; it is interviewing her because she considers herself a tradwife."
                                            },
                                            {
                                                "example_id": "85448a6b-eefc-4ed5-beb4-4bbd18e18ef0",
                                                "sense_id": "f309b6f8-9703-308a-9068-52004437bcbc",
                                                "text": "Blond and blue-eyed, just like the #tradwife ideal, but her eyes held a fierceness that overshadowed her fame."
                                            },
                                            {
                                                "example_id": "f6d275e6-de7f-48c1-99fa-09a2b3a1eb9e",
                                                "sense_id": "f309b6f8-9703-308a-9068-52004437bcbc",
                                                "text": "He notes that many “white supremacists call for 'tradwives'—traditional wives—to produce more white children” (ibid.), an association between misogyny and racism."
                                            },
                                            {
                                                "example_id": "fc8961ae-50d2-48ba-b9e8-ecc8a0140832",
                                                "sense_id": "f309b6f8-9703-308a-9068-52004437bcbc",
                                                "text": "Reactionary motifs are chic: Trump hats and “tradwife” frocks, monarchist and anti-feminist sentiments. Perhaps the ultimate expression of this contrarian aesthetic is its embrace of Catholicism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
