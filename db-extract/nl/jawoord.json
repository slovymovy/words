                                "target_senses": [
                                    {
                                        "sense_id": "69f9232a-fde0-3fe9-a633-891a02d7e081",
                                        "entry_id": "4af2f38d-5eb1-3a49-95ea-070160a237f8",
                                        "glosses": [
                                            "To express willingness, to give permission."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43e9f0aa-b5b2-47a1-b02a-7a758babafdd",
                                                "sense_id": "69f9232a-fde0-3fe9-a633-891a02d7e081",
                                                "text": "After reflecting a little bit, I've decided to consent to her practising the piano in the house."
                                            },
                                            {
                                                "example_id": "c75e46bd-ad1c-42b9-a3f2-20ecb718d971",
                                                "sense_id": "69f9232a-fde0-3fe9-a633-891a02d7e081",
                                                "text": "My poverty, but not my will, consents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b8de3c3-7b06-3deb-a527-0028930a23c1",
                                        "entry_id": "4af2f38d-5eb1-3a49-95ea-070160a237f8",
                                        "glosses": [
                                            "To cause to sign a consent form."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "370f5905-3c4a-40b1-a63a-fe6f5bb23d6a",
                                                "sense_id": "5b8de3c3-7b06-3deb-a527-0028930a23c1",
                                                "text": "When the patient was consented to enter the study and registered, a telephone call was made to research assistant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75970e8c-0b78-3d09-91ef-f7d69f0837ef",
                                        "entry_id": "4af2f38d-5eb1-3a49-95ea-070160a237f8",
                                        "glosses": [
                                            "To grant; to allow; to assent to."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f82979b7-adbe-4c5a-bb92-37fa423cd8e1",
                                                "sense_id": "75970e8c-0b78-3d09-91ef-f7d69f0837ef",
                                                "text": "Interpreters […] will not consent it to be a true story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59a5efb2-1b53-3c9d-9de6-3ec147e54430",
                                        "entry_id": "4af2f38d-5eb1-3a49-95ea-070160a237f8",
                                        "glosses": [
                                            "To agree in opinion or sentiment; to be of the same mind; to accord; to concur."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a469b9ca-924b-4817-9249-38e5338a1b96",
                                                "sense_id": "59a5efb2-1b53-3c9d-9de6-3ec147e54430",
                                                "text": "And Saul was consenting unto his death."
                                            },
                                            {
                                                "example_id": "b1025dd5-ed82-4337-83f1-de1e8fc56a4c",
                                                "sense_id": "59a5efb2-1b53-3c9d-9de6-3ec147e54430",
                                                "text": "Flourishing many years before Wyclif, and much consenting with him in judgment."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd38ce0a-caa8-3f08-876e-6562ae445613",
                                        "entry_id": "ae164bd2-6f90-38f4-80da-3353e1b65d9c",
                                        "glosses": [
                                            "Voluntary agreement or permission."
                                        ],
                                        "tags": [
                                            "countable",
                                            "intransitive",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48ebc8cd-1c2a-47ed-b4b4-6bd9371f5232",
                                                "sense_id": "fd38ce0a-caa8-3f08-876e-6562ae445613",
                                                "text": "All men know by experience, there be some parts of our bodies which often without any consent of ours doe stirre, stand, and lye down againe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c482274f-2b5b-35ed-8785-09e090a6b6a7",
                                        "entry_id": "ae164bd2-6f90-38f4-80da-3353e1b65d9c",
                                        "glosses": [
                                            "Unity or agreement of opinion, sentiment, or inclination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "intransitive",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "249029bb-954c-4358-8e28-fa96c876ea1c",
                                                "sense_id": "c482274f-2b5b-35ed-8785-09e090a6b6a7",
                                                "text": "And they all with one consent began to make excuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "588cf296-c5cc-3801-b33e-bcd6a1298a1f",
                                        "entry_id": "ae164bd2-6f90-38f4-80da-3353e1b65d9c",
                                        "glosses": [
                                            "Advice; counsel."
                                        ],
                                        "tags": [
                                            "countable",
