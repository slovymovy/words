                                                "sense_id": "dc2c8ef0-7cb1-3e02-9071-beb1da72015f",
                                                "text": "Frau Stammler ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "be877ac7-d470-4c68-93e2-c9937b7d8439",
                                                "sense_id": "dc2c8ef0-7cb1-3e02-9071-beb1da72015f",
                                                "text": "Herr Stammler wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "2469b4f6-cfc3-4028-8b45-95d56e68871b",
                                                "sense_id": "dc2c8ef0-7cb1-3e02-9071-beb1da72015f",
                                                "text": "Die Stammlers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "77be1f29-0c00-4ace-a3bd-83911bc64604",
                                                "sense_id": "dc2c8ef0-7cb1-3e02-9071-beb1da72015f",
                                                "text": "Der Stammler trägt nie die Schals, die die Stammler ihm strickt."
                                            },
                                            {
                                                "example_id": "3e45f722-8766-41ac-881a-d4682e9ff1bb",
                                                "sense_id": "dc2c8ef0-7cb1-3e02-9071-beb1da72015f",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stammler kommt, geht der Herr Stammler.“"
                                            },
                                            {
                                                "example_id": "5e93ef79-da13-472a-b8cd-a273bcf3113e",
                                                "sense_id": "dc2c8ef0-7cb1-3e02-9071-beb1da72015f",
                                                "text": "Stammler kommt und geht."
                                            },
                                            {
                                                "example_id": "f05dab7d-ff66-4c2f-b603-e973433a475c",
                                                "sense_id": "dc2c8ef0-7cb1-3e02-9071-beb1da72015f",
                                                "text": "Stammlers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
