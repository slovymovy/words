            {
                "entry_id": "ae81d615-5bba-3632-9a13-8883425574d1",
                "word": "annamite",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "64d8329e-f254-4ae3-83ce-313dc64b1cca",
                        "entry_id": "ae81d615-5bba-3632-9a13-8883425574d1",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "annamites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86237515-968b-3ed9-bc37-8e919310ae7d",
                        "entry_id": "ae81d615-5bba-3632-9a13-8883425574d1",
                        "glosses": [
                            "Relatif à l’Annam et à ses habitants."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "80d25c92-02d5-4962-b42b-3a0ad5d97a7e",
                                "sense_id": "86237515-968b-3ed9-bc37-8e919310ae7d",
                                "text": "Les foules annamites endureront-elles longtemps les assassins payés par la Démocratie ?"
                            },
                            {
                                "example_id": "ead747ce-c605-4b71-8325-b77fd682f3ce",
                                "sense_id": "86237515-968b-3ed9-bc37-8e919310ae7d",
                                "text": "La chevelure blonde suffisait à atténuer sa ressemblance avec Alice, en dépit du nez un peu épaté, le nez annamite de la famille."
                            },
                            {
                                "example_id": "f304e3d3-6107-416f-a1e8-a7edf9ce947b",
                                "sense_id": "86237515-968b-3ed9-bc37-8e919310ae7d",
                                "text": "[…] ; pour sauver les déposants français et les déposants annamites, la Banque de France et le Gouvernement général de l’Indochine sont tout de même plus désignés que nous, […]."
                            },
                            {
                                "example_id": "0b61399f-825d-4895-8f7e-2dfe86b99442",
                                "sense_id": "86237515-968b-3ed9-bc37-8e919310ae7d",
                                "text": "Le général annamite mit le comble au mécontentement du peuple en ordonnant que l'on cadastrât les propriétés et que l'on fît le recensement de la population."
                            },
                            {
                                "example_id": "a4d41723-98c9-4ba6-ab11-de81a2aae6a1",
                                "sense_id": "86237515-968b-3ed9-bc37-8e919310ae7d",
                                "text": "Tourane est tombée. Mais au prix de lourdes pertes des deux côtés, même si je sais très bien que tout le monde se moque bien des morts annamites."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "813b36a9-5502-4cba-8047-0cee4c61db83",
                        "source_entry_id": "ae81d615-5bba-3632-9a13-8883425574d1",
                        "source_sense_ids": [
