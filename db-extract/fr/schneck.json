                    },
                    {
                        "form_id": "90840e81-5cfc-4a07-a957-256f9133f313",
                        "entry_id": "b241b355-a176-3d34-bac6-8633a477bd81",
                        "tags": [],
                        "form": "chnek"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37da6835-6512-31ff-a761-ffc96d785b4b",
                        "entry_id": "b241b355-a176-3d34-bac6-8633a477bd81",
                        "glosses": [
                            "Organes génitaux féminins, vulve."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0244165c-d535-47e2-90dc-27112ad320e7",
                                "sense_id": "37da6835-6512-31ff-a761-ffc96d785b4b",
                                "text": "Ouais à 16 heures j'te paye un grec, à 20 heures j'te r'paye un grec, 22 heures encore un grec, mais cette nuit tu payes ta schneck"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6a1c469-6fe7-414f-abb6-851334ed698c",
                        "source_entry_id": "b241b355-a176-3d34-bac6-8633a477bd81",
                        "source_sense_id": "37da6835-6512-31ff-a761-ffc96d785b4b",
                        "target_lang_word": "Schnecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b942b222-a85e-3df3-b524-0420c5e12914",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "(in zahlreichen land- und wasserlebenden Arten vorkommendes) längliches Weichtier mit zwei Paar Fühlern am Kopf (wobei sich am Ende des oberen Paares die Augen befinden), auf dessen Rückenseite sich häufig ein zumeist spiralförmig gewundenes, aus Kalk bestehendes Gehäuse befindet, und dessen landlebende Vertreter sich auf einer Spur selbst abgesonderten Schleims auf der bauchseitigen Kriechsohle sehr langsam fortbewegen"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9142e90d-ced0-4ce3-9dd9-2eee2016129c",
                                                "sense_id": "b942b222-a85e-3df3-b524-0420c5e12914",
                                                "text": "„Neben ihm, in einem feuchten, düſteren Winkel wucherte Huflattich und ſpreitete ſeine breiten Blätter zu phantaſtiſchen Verſtecken den Schnecken und Würmern.“"
                                            },
                                            {
                                                "example_id": "857dca34-1569-40ce-aec6-3c1f8e3b601c",
                                                "sense_id": "b942b222-a85e-3df3-b524-0420c5e12914",
                                                "text": "«Auf dem Kietzer Friedhof lag ich unter Linden und Kastanien und sah einer Schnecke beim Aufstieg auf den Grabstein von Emil und Minna Munk zu, die Frau hatte ihren Mann um zweiundzwanzig Jahre überlebt.»"
                                            },
                                            {
                                                "example_id": "7d7e5464-b15e-4d4e-be58-f1dc98b18031",
                                                "sense_id": "b942b222-a85e-3df3-b524-0420c5e12914",
                                                "text": "„Ich mag keine Insekten, Anneliese ist dagegen durch ihre Gartenarbeit gegen jeglichen Ekel vor Würmern, Schnecken und anderem Getier immun; lässig wirft sie ein Küchentuch über die Hummel und befördert das brummende Bündel auf schonende Weise nach draußen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f213cb5-d89d-30f3-a5fe-e35c784487d9",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "als Nahrungsmittel verwendetes, essbar zubereitetes Exemplar (bestimmter Arten) des unter [1] beschriebenen Weichtiers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6bf6c1-5399-4ba0-b9a9-111dc54551c9",
                                                "sense_id": "3f213cb5-d89d-30f3-a5fe-e35c784487d9",
                                                "text": "„Mit der Zange greift man sich ein Häuschen, gießt die flüssige Butter in den Löffel und holt mit der Gabel die Schnecke aus dem Häuschen. Zum vollkommenen Genuß wird jeweils etwas Weißbrot mit Schnecke und Butter gekaut und ein Schluck Riesling dazu getrunken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "efde4835-9663-3fb6-8abc-37648b232cbf",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "kleines, spiralförmig (schneckenförmig) zusammengerolltes Feingebäck aus Hefe-, Hefefein- oder Plunderteig mit süßen oder herzhaften Füllungen und/oder Belägen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc3a561f-4c15-426b-ad3f-85c0f09d1acf",
                                                "sense_id": "efde4835-9663-3fb6-8abc-37648b232cbf",
                                                "text": "„Dann geht sie entschlossen in einen Bäckerladen und kauft mir zwei Schnecken à 5 Pfennig.“"
                                            },
                                            {
                                                "example_id": "8745e4da-11af-490e-9397-64eb3bb76b24",
                                                "sense_id": "efde4835-9663-3fb6-8abc-37648b232cbf",
                                                "text": "„Am Sonnabend fragt der Vater die Mutter: Wieviel Semmeln, wieviel Schnecken, wieviel Kuchen brauchste? Wie soll meine Mutter das wissen? Die Kaufwilligkeit der Kunden ändert sich, wie alles, von Woche zu Woche: Den einen Sonnabend bleiben Semmeln und Schnecken über, den anderen Sonnabend reichen sie nicht. Mit Kuchen, der überbleibt, wird meine ausgezeichnete Mutter fertig, aber Semmeln und Schnecken werden altbacken, sie müssen zu halben Preisen verkauft werden, und der Familienkrach ist fertig; Wort kommt zu Wort und Widerwort zu Widerwort, und eines Tages sagt die Mutter, nun hat sie genug, nun geht sie für immer davon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6ae4dbf9-4f26-307f-aa87-056aa4010182",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "über je einem Ohr spiralförmig (schneckenförmig) aufgerollter und festgesteckter Zopf"
                                        ],
                                        "tags": [
                                            "zumeist",
                                            "iPl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7714c3a-05da-4c02-97da-a4193429e246",
                                                "sense_id": "6ae4dbf9-4f26-307f-aa87-056aa4010182",
                                                "text": "„Jetzt nimmt sie ihren Hut ab, dicke strohblonde Schnecken sitzen an den Ohren.“"
                                            },
                                            {
                                                "example_id": "27ceee51-5a3a-4a46-85cb-7aa534a2f601",
                                                "sense_id": "6ae4dbf9-4f26-307f-aa87-056aa4010182",
                                                "text": "„Mit zu Schnecken verflochtenen grauen Haaren und weißem Gesicht hockte sie im Schutz von Theke und Kasse und strickte.“"
                                            },
                                            {
                                                "example_id": "fa20d966-5594-4694-8737-05609627f40b",
                                                "sense_id": "6ae4dbf9-4f26-307f-aa87-056aa4010182",
                                                "text": "„Veronikas Haare waren zu zwei Zöpfen geflochten und über den Ohren zu festen Schnecken gesteckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2d70530d-d877-3db3-89aa-7a238788b35b",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "spiralförmiger (schneckenförmiger) Teil des Innenohrs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e4be553-16a0-4b77-beb3-f445f280e5c0",
                                                "sense_id": "2d70530d-d877-3db3-89aa-7a238788b35b",
                                                "text": "„Das eigentliche Gehörorgan ist das untere Labyrinthsäckchen und besonders sein aufgewundener Anhang, die ‚Schnecke‘.“"
                                            },
                                            {
                                                "example_id": "ff431198-68f4-4897-b824-f042f8f3f392",
                                                "sense_id": "2d70530d-d877-3db3-89aa-7a238788b35b",
                                                "text": "„Etwas unter und vor dem Sacculus liegt eine zweieinhalbfach gewundene Schnecke, in der die Rezeptoren des Hörorgans liegen.“"
                                            },
                                            {
                                                "example_id": "7f12ee65-753a-4379-b80b-c2c06cc7b9ba",
                                                "sense_id": "2d70530d-d877-3db3-89aa-7a238788b35b",
                                                "text": "„Kurz danach war dem Toten ein spitzer Gegenstand, etwa ein Schraubenzieher, in das linke Ohr eingeführt, mit großer Wucht durch das Labyrinth und die Schnecke sowie den knöchernen Bereich der Schädelbasis und die daran anliegende harte Hirnhaut getrieben worden und so ins Kleinhirn eingedrungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "e763e816-1b5a-33d6-acc7-0c626f3f8b54",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "spiralförmig (schneckenförmig) verzierter Abschluss des Halses einiger Streichinstrumente"
                                        ],
                                        "tags": [
                                            "Geigenbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad1f3da6-86de-40cd-a579-d506157d32e3",
                                                "sense_id": "e763e816-1b5a-33d6-acc7-0c626f3f8b54",
                                                "text": "„Am Geigenhals sind Griffbrett, Wirbelkasten und die Schnecke angebracht.“"
                                            },
                                            {
                                                "example_id": "0a1ac6fb-c40d-4e4d-b69b-bf71780c8a51",
                                                "sense_id": "e763e816-1b5a-33d6-acc7-0c626f3f8b54",
                                                "text": "„Geigenbauer biegen dagegen Fichtenhölzer und Palisander und schaffen formschöne Streichinstrumente mit gedrechselten Schnecken und Wirbeln.“"
                                            },
                                            {
                                                "example_id": "092c0517-5eae-47ad-afbe-2827d4ea12b0",
                                                "sense_id": "e763e816-1b5a-33d6-acc7-0c626f3f8b54",
                                                "text": "„Kurz vor ihrem Auftritt wirft sie noch schnell einen Blick auf ihr Cello, mit der Schnecke am oberen Ende, dem Griffbrett und der Decke sowie dem Stachel, der das Ende des Instrumentes markiert.“"
                                            },
                                            {
                                                "example_id": "75c4183e-d3e9-411f-8605-9e7720396742",
                                                "sense_id": "e763e816-1b5a-33d6-acc7-0c626f3f8b54",
                                                "text": "„Die Form der Schnecke ist typisch für das Vogtland, wodurch der Herkunftshinweis im Innern des Instruments auf den italienischen Geigenbauer Stradivari hinfällig wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "0bc4ee25-8190-309b-b815-593cd7c764e7",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "spiralförmig (schneckenförmig) eingerolltes Zierelement von Bauteilen wie Konsolen, Giebeln oder Kapitellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "201710a7-ab0b-4fb2-88b5-788c039b01b0",
                                                "sense_id": "0bc4ee25-8190-309b-b815-593cd7c764e7",
                                                "text": "„Aber die Terracotta-Säulen der Vorhalle mit ihren Schnecken am Kapitell sind sehr lieblich anzuschauen und die Glocke läutet auch noch und zwar zu jeder vollen Stunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "7ea9f092-f914-3934-9cfc-ab4001a88d95",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "Treppe, deren Stufen spiralförmig um eine Achse verlaufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a86de2-2dff-4202-85ab-a0f47c529f26",
                                                "sense_id": "7ea9f092-f914-3934-9cfc-ab4001a88d95",
                                                "text": "„Wie betäubt stolperte Adelheid die Schnecke hinauf, die enge und steile Wendeltreppe, die vom Saal direkt in die Kemenaten führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "38201459-4a74-3da8-843b-a565f895d341",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "Gewinde, das spiralförmig in ein zylindrischen, kegelförmigen oder dergleichen Körper gefräst wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fb4ed7-7b5e-499c-a4c4-8f7fff6dc8fd",
                                                "sense_id": "38201459-4a74-3da8-843b-a565f895d341",
                                                "text": "„Man wollte von mir wissen, ob die Haltevorrichtung durch einen am Lagerblock befestigten Motor sich drehen lasse, und zwar mit Hilfe des aus der Schnecke 9 oder des aus dem Schneckenrad 8 bestehenden Getriebes.“"
                                            },
                                            {
                                                "example_id": "53c93d8f-be4a-4adf-aff5-d93b853af1fe",
                                                "sense_id": "38201459-4a74-3da8-843b-a565f895d341",
                                                "text": "„Bei jeder Umdrehung dreht die Schnecke das Schneckenrad um einen Zahn weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "a271d2dd-bb80-3d2e-bdbe-72d79b8fb9ff",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "auf dem Funktionsprinzip der archimedischen Schraube beruhende Förderanlage für vor allem Schüttgut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fabbe63-6133-4139-a291-3e18c4e358d2",
                                                "sense_id": "a271d2dd-bb80-3d2e-bdbe-72d79b8fb9ff",
                                                "text": "„Die Anlage wird täglich befüllt, zum Beispiel mit Mais, der neben der Anlage gelagert wird. Über Förderbänder und Schnecken gelangt das Material in die Behälter, unter deren Foliendächern bei der Vergärung Methan und Kohlendioxid entstehen.“"
                                            },
                                            {
                                                "example_id": "7633db6f-c4ba-4a42-99bf-5903022f6795",
                                                "sense_id": "a271d2dd-bb80-3d2e-bdbe-72d79b8fb9ff",
                                                "text": "„Das Holzheizkraftwerk besteht aus einem kleinen Hackschnitzelbunker mit einer Fördereinrichtung, einem Schubboden, mittels dessen die Hackschnitzel über ein Förderband oder eine Schnecke in den Heizkessel transportiert und verbrannt werden.“"
                                            },
                                            {
                                                "example_id": "051dd3b7-c707-4d0b-8127-a940b815a03b",
                                                "sense_id": "a271d2dd-bb80-3d2e-bdbe-72d79b8fb9ff",
                                                "text": "„Über Rohre wird von oben Wasser eingelassen – unten schwimmen die Äpfel durch einen schmalen Einlass ins Gebäude. Mit einer Schnecke werden sie dann etwa fünf Meter hoch zu einem Förderband transportiert, wo eine Mitarbeiterin die faulen Früchte aussortiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "03a1f66c-777b-37f0-811f-689502e972e0",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "Horn des männlichen Muffelwildes"
                                        ],
                                        "tags": [
                                            "Jägersprache",
                                            "zumeist",
                                            "iPl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8813a68-ad24-4745-bfca-1515ef2f5193",
                                                "sense_id": "03a1f66c-777b-37f0-811f-689502e972e0",
                                                "text": "„Auffallend neben der schönen Fellzeichnung und dem quirligen Wesen sind die zum Teil stark gedrehten Hörner, die so genannten Schnecken, der Widder, also der männlichen Tiere. Anders als die Hirsche, die ihr Geweih jedes Jahr abwerfen, bleibt den Mufflons ihre Schnecke ein Leben lang erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    },
                                    {
                                        "sense_id": "af96b97d-4800-3190-8c22-33e3b84eb6e9",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "etwas, was der äußerlichen Form des Schneckenhauses ähnelt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91c43428-4b96-4767-b902-b13202fe98b0",
                                                "sense_id": "af96b97d-4800-3190-8c22-33e3b84eb6e9",
                                                "text": "„Beide Schmalfronten, hier am Château d’Eau, dort an der obersten Böschung, enden mit eingezogenem Halbkreis und ausgewölbten Schnecken; in den Buchtungen steht oben das Oktogon, unten ein doppeltes Ehrentor – doppelt, damit der Tragbaldachin einschweben kann, unter welchem das Königs-Paar morgen Abend die Defilier-Cour abnehmen wird.“"
                                            },
                                            {
                                                "example_id": "5561359f-42c6-45af-bf59-d4cb9504c786",
                                                "sense_id": "af96b97d-4800-3190-8c22-33e3b84eb6e9",
                                                "text": "„Der Zug der Heilsarmee formte eine Schnecke, schloß einen Kreis, und da standen sie und riefen, bliesen und paukten ihr Lobet den Herrn, und die Hexen lachten weiter, hielten sich den Wolkenbauch, pißten und legten sich vor dem Wind auf den Rücken.“"
                                            },
                                            {
                                                "example_id": "3c8d148a-9bc9-4b33-bcf1-659f0c7cc79b",
                                                "sense_id": "af96b97d-4800-3190-8c22-33e3b84eb6e9",
                                                "text": "„Die Russen saßen vor den Häusern in der dünnen Februarsonne, sortierten Armband- und Taschenuhren, putzten mit Sand Silberlöffel, benutzten Büstenhalter als Ohrenwärmer, übten Kunstfahren auf Fahrrädern, hatten sich ein Hindernisgelände aus Ölgemälden, Standuhren, Badewannen, Radioapparaten und Garderobenständern aufgebaut, radelten dazwischen Achten, Schnecken, Spiralen, wichen Gegenständen wie Kinderwagen und Hängelampen, die aus den Fenstern geworfen wurden, geistesgegenwärtig aus und wurden für ihre Geschicklichkeit mit Beifall bedacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"12\""
                                    },
                                    {
                                        "sense_id": "8106f99d-022d-3a27-bdc9-7bb5fc013bfd",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "(hübsches, niedliches) Kind, besonders ein Mädchen"
                                        ],
                                        "tags": [
                                            "rare",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "637c2cb4-e752-4902-9da8-222e56e3917c",
                                                "sense_id": "8106f99d-022d-3a27-bdc9-7bb5fc013bfd",
                                                "text": "„Am 9. November tat sie mit exakt 3042 Gramm und 48 Zentimetern ihren ersten Schrei und ist seitdem liebevoll umsorgter Mittelpunkt. Von Mama, die sie ‚süße Schnecke‘ nennt, hat sie angeblich die Pausbäckchen, von Papa hingegen den Mund und den nächtlichen Appetit geerbt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"13\""
                                    },
                                    {
                                        "sense_id": "f2e05e6d-3cd7-35d2-9b60-3201174dd488",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "junge Frau"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6594aa35-6c78-47dc-b820-60f1afaa90bf",
                                                "sense_id": "f2e05e6d-3cd7-35d2-9b60-3201174dd488",
                                                "text": "„Der steht mit seinen Kumpels an der Theke, ein Bier in der Hand und die Augen auf der Tanzfläche – Schnecken checken.“"
                                            },
                                            {
                                                "example_id": "f66ec2ce-e396-497a-9d9a-d36376217e3a",
                                                "sense_id": "f2e05e6d-3cd7-35d2-9b60-3201174dd488",
                                                "text": "„»Na fantastisch«, knurrte Katinka ihn an. »Hier verläuft ein Fahrradweg!«",
                                                "translation": "»Ach, reg dich nicht auf, Schnecke«, brummte der Mercedesbesitzer gemütlich und biss in sein Frühstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"14\""
                                    },
                                    {
                                        "sense_id": "502bea07-02a3-3cbf-988c-bafc49e0f808",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "weibliche Person, mit der man in einer festen Beziehung, in einer festen Lebensgemeinschaft zusammenlebt; weibliche Person, für die man Liebe empfindet oder mit der man eine sexuelle Beziehung pflegt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "jocular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e1d3ad-4af0-4e59-bb6d-7d7a92f0e03b",
                                                "sense_id": "502bea07-02a3-3cbf-988c-bafc49e0f808",
                                                "text": "„‚Ich glaube, du verwechselst mich mit deiner Geliebten.‘",
                                                "translation": "‚Die vergiß mal. Die kleine Schnecke hat mich beklaut. Dabei hätte sie alles von mir haben können. […]‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"15\""
                                    },
                                    {
                                        "sense_id": "2b4e6692-5070-3621-a273-99a1da5bc524",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "weibliche Person, die für ein Entgelt sexuelle Handlungen als Dienstleistung anbietet und ausübt"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e42e9fce-c611-4b89-b43e-e81fae7a9977",
                                                "sense_id": "2b4e6692-5070-3621-a273-99a1da5bc524",
                                                "text": "„»[…] Ich wollte die fetteste Schnecke im Bordell bezahlen, dass sie deinen kleinen Pimmel zum Glühen bringt!«“"
                                            }
                                        ],
                                        "sense_index_json": "\"16\""
                                    },
                                    {
                                        "sense_id": "9ff2d13b-6e31-31a1-9be8-227b4d2031ea",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "die äußeren und/oder ein Teil der inneren primären weiblichen Geschlechtsorgane"
                                        ],
                                        "tags": [
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fc8f5c9-fce3-4460-9b9e-e6e179c4413d",
                                                "sense_id": "9ff2d13b-6e31-31a1-9be8-227b4d2031ea",
                                                "text": "„Anna atmete an seiner Seite, »mein Wildpferd«, und Paul saugte an Annas Lippen und schleckte Annas weiche Brust ab und stieg vom Bett und steckte seine Nase in Annas Hintern, der ein warmer, weißer und nasser Mond war, und Annas Hintern preßte sich gegen sein Gesicht, und sie wand sich, und es schauderte sie, und in Annas Poloch schmeckte es bitter und herb, und er raste mit seinem Gesicht vom engen schwarzen Loch zu Annas behaarter Schnecke (oder Annas Schnabeltier mit winzigem, rotem Schnabel), wo es heiß war und roch, als rieche man an einem Waldboden oder an Sauerkraut oder verklebten und staubigen Karamellen, und er schleckerte sie aus, als sei sie ein Honigfaß, und Annas Finger verknoteten sich, und Annas Gesicht, das sie im Kissen versteckte, war von Schweiß bedeckt, und Pauls Specht erwachte aus seinem Viertelstundenschlaf und pochte bei Anna an, und es riß sie hoch, als er in sie drang.“"
                                            },
                                            {
                                                "example_id": "d9ab9382-edbd-4ed0-828b-7a9b293b83f7",
                                                "sense_id": "9ff2d13b-6e31-31a1-9be8-227b4d2031ea",
                                                "text": "„‚Reifes Team verw. Dich! Mutter bläst Dich in den Himmel, während Du Tochters Schnecke leckst!‘ Diese Sex-Anzeige im Berliner Tip war die eine Anzeige zu viel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"17\""
                                    },
                                    {
                                        "sense_id": "ae63d9bf-7baf-367a-9493-a6396e74ec2b",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "jemand, der langweilig, schwerfällig, träge ist"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8a16842-d674-4700-bb40-808e354fde54",
                                                "sense_id": "ae63d9bf-7baf-367a-9493-a6396e74ec2b",
                                                "text": "„Als markante und präzise Charakterisierung von Menschen sind Angsthase, Löwenmut, Hundetreue, lahme Schnecke, eitler Pfau ebenso in Gebrauch wie dumme Gans, listiger Fuchs und falsche Katze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"18\""
                                    },
                                    {
                                        "sense_id": "2263e0d4-3462-335f-9d73-7ad4d75a46dd",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "jemand, der langsam handelt und deshalb das von ihm Erwartete nicht leisten kann"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afac97ab-390c-4542-a6f1-2aa71ca2eaa2",
                                                "sense_id": "2263e0d4-3462-335f-9d73-7ad4d75a46dd",
                                                "text": "„Das Bild eines Herrschers, sagte Friedrich zu Berzejew, in feudalen Zeiten war ein Herr über fünfzig Angestellte ein Herr. Der da ist eine Schnecke, der Vetter des Onkels meiner Mutter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"19\""
                                    },
                                    {
                                        "sense_id": "5f2260b1-15b6-3f66-82bf-0bd57f81a5fd",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "Verkehrsmittel, das sich nur langsam (im Kriech- oder Schleichtempo) fortbewegt"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc59ac5a-a86e-468b-9da2-90cfe8cce8a8",
                                                "sense_id": "5f2260b1-15b6-3f66-82bf-0bd57f81a5fd",
                                                "text": "„‚Du, Papa‘, sagt Susanne, ‚ich glaub’, der ICE ist ’ne lahme Schnecke.‘“"
                                            },
                                            {
                                                "example_id": "1b844549-2183-4174-9367-bf7f6f573c7e",
                                                "sense_id": "5f2260b1-15b6-3f66-82bf-0bd57f81a5fd",
                                                "text": "„Frau Sasse mußte nach Wörlitz, der Mietwagen war eine Schnecke – als ich Zerbst erreichte, war niemand mehr da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"20\""
                                    },
                                    {
                                        "sense_id": "e3cb4253-5090-3bc8-8e92-f47b429b623a",
                                        "entry_id": "229044fa-9b71-32c5-ae65-8835855336ce",
                                        "glosses": [
                                            "jemand, der langsam (im Kriech- oder Schleichtempo) fährt"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c76de3f-9030-449d-a7eb-745dc4f11c45",
                                                "sense_id": "e3cb4253-5090-3bc8-8e92-f47b429b623a",
                                                "text": "„Es gibt sie überall, die Raser und lahmen Schnecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"21\""
                                    }
                                ]
                            }
                        ]
                    }
