            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cb0e1878-d909-3569-ac78-babb481ff778",
                    "sense_definition": "Having a compatible temperament or being in agreement with another person or thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After talking for hours, they realized they were truly <w>simpatico</w> regarding their future business goals.",
                            "target_lang_translations": {
                                "ru": "После многочасового разговора они поняли, что действительно <w>единомышленны</w> в своих будущих деловых целях."
                            }
                        },
                        {
                            "text": "It is often difficult to work in a team when the members are not <w>simpatico</w> with each other.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно работать в команде, когда ее члены не <w>совместимы</w> друг с другом."
                            }
                        }
                    ],
                    "synonyms": [
                        "compatible",
                        "like-minded",
                        "harmonious"
                    ],
                    "antonyms": [
                        "incompatible",
                        "clashing",
                        "disagreeable"
                    ],
                    "common_phrases": [
                        "truly simpatico",
                        "not simpatico",
                        "perfectly simpatico"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий совместимым темпераментом или находящийся в согласии с другим человеком или вещью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единомышленный",
                                "target_lang_sense_clarification": "имеющий схожие взгляды"
                            },
                            {
                                "target_lang_word": "совместимый",
                                "target_lang_sense_clarification": "подходящий по характеру"
                            },
                            {
                                "target_lang_word": "близкий по духу",
                                "target_lang_sense_clarification": "имеющий общие интересы и ценности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c27006f1-0ad0-3111-b3ca-cf04a7a71b08",
                    "sense_definition": "Possessing pleasing, likable, or attractive qualities that make someone easy to get along with.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new manager has a very <w>simpatico</w> personality that immediately put the nervous staff at ease.",
                            "target_lang_translations": {
                                "ru": "У нового менеджера очень <w>располагающий</w> характер, который сразу же успокоил нервничающий персонал."
                            }
                        },
                        {
                            "text": "She found the local culture to be quite <w>simpatico</w> and decided to extend her stay in the village.",
                            "target_lang_translations": {
                                "ru": "Местная культура показалась ей весьма <w>симпатичной</w>, и она решила продлить свое пребывание в деревне."
                            }
                        }
                    ],
                    "synonyms": [
                        "likable",
                        "congenial",
                        "pleasant"
                    ],
                    "antonyms": [
                        "unpleasant",
                        "obnoxious"
                    ],
                    "common_phrases": [
                        "simpatico personality",
                        "simpatico nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий приятными, симпатичными или привлекательными качествами, которые облегчают общение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симпатичный",
                                "target_lang_sense_clarification": "вызывающий симпатию и расположение"
                            },
                            {
                                "target_lang_word": "приятный",
                                "target_lang_sense_clarification": "легкий в общении"
                            },
                            {
                                "target_lang_word": "располагающий",
                                "target_lang_sense_clarification": "вызывающий доверие и интерес"
                            }
                        ]
                    }
                }
            ]
        }
    ]
