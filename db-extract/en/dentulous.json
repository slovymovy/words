                        ],
                        "examples": [
                            {
                                "example_id": "94a4d761-895c-4231-abad-193c9161e3b6",
                                "sense_id": "e31c0bd6-11ee-39d0-a14a-b9ad08490740",
                                "text": "The teeth of such of the reptiles as are dentulous, are simple organs of prehension, and not intended for mastication."
                            },
                            {
                                "example_id": "6e6dfff5-dbad-4444-a972-35295a3bc0c2",
                                "sense_id": "e31c0bd6-11ee-39d0-a14a-b9ad08490740",
                                "text": "No dentulous jaws of multituberculates found in deposits of Early Cretaceous age have yet been described."
                            },
                            {
                                "example_id": "b8773560-e99b-472f-9d60-168617520a0f",
                                "sense_id": "e31c0bd6-11ee-39d0-a14a-b9ad08490740",
                                "text": "Edentulous patients with an atrophic mandible require a different plating strategy than dentulous patients who have a greater amount of bone."
                            }
                        ]
                    }
