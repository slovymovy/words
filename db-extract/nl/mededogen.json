        "nl-extract.jsonl": [
            {
                "entry_id": "24d7a00d-da32-34a6-9daa-ab06835a8302",
                "word": "mededogen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                        "entry_id": "24d7a00d-da32-34a6-9daa-ab06835a8302",
                        "glosses": [
                            "welwillend medelijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41e6b977-be2a-4a82-b46a-88924038da3a",
                                "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                "text": "Hij kreeg geen mededogen van zijn vrienden."
                            },
                            {
                                "example_id": "f2269054-a593-44c2-ae59-37d4e949c4bd",
                                "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                "text": "Engeland was ook het probleem niet, er was geen enkele reden voor mededogen met de onmenselijke Engelsen."
                            },
                            {
                                "example_id": "fd97d86f-5ea9-4652-9e2d-3a91b408f136",
                                "sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                                "text": "Koning Willem-Alexander en koningin Máxima zeggen \"diep getroffen\" te zijn door zijn dood. \"Vanuit een rotsvast geloof in Gods liefde pleitte hij voor mededogen en menselijkheid. Sober en eenvoudig levend koos hij steeds de kant van de kwetsbaren en behoeftigen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a90d511-1f50-4fdc-87bb-ae49029d43d7",
                        "source_entry_id": "24d7a00d-da32-34a6-9daa-ab06835a8302",
                        "source_sense_id": "5a9bfe07-b3e3-3114-9c83-1d83cdbb63d7",
                        "source_sense_description": "welwillend medelijden",
                        "target_lang_word": "жалость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жалость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d4e9b993-4ae1-363a-8fab-2bba53ccd738",
                                        "entry_id": "23c77162-a80e-3925-a942-347942ab7361",
                                        "glosses": [
                                            "сострадание, соболезнование"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2eca452-49ed-4522-aae8-4fe523689337",
                                                "sense_id": "d4e9b993-4ae1-363a-8fab-2bba53ccd738",
                                                "text": "Мы порой скрываем от человека правду из жалости к нему, из нежелания унизить его."
                                            },
                                            {
                                                "example_id": "64ebb3d2-e311-43f4-abc3-67b1a88b7f1b",
                                                "sense_id": "d4e9b993-4ae1-363a-8fab-2bba53ccd738",
                                                "text": "При отступлении под Рославлем Кузнецов видел раз, как солдаты из жалости пристреливают раненых лошадей, переставших быть тягловой силой."
                                            },
                                            {
                                                "example_id": "7b301a7e-353f-455e-a328-0218203e4c18",
                                                "sense_id": "d4e9b993-4ae1-363a-8fab-2bba53ccd738",
                                                "text": "Братья показались ей ужасными — они стали совсем деревенскими, в рванине, босые и чумазые, дрались и матерились, как взрослые мужики. В Томе они не вызвали ни сочувствия, ни жалости. А уж о любви и речи быть не могло."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d580419-9beb-314d-a8f8-0f5235b78754",
                                        "entry_id": "23c77162-a80e-3925-a942-347942ab7361",
                                        "glosses": [
                                            "сожаление, грусть, печальное чувство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9577be05-cfc4-4953-b1bc-7c508ea49920",
                                                "sense_id": "1d580419-9beb-314d-a8f8-0f5235b78754",
                                                "text": "Ах, какая жалость!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
