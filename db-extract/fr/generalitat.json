                        "glosses": [
                            "gouvernement de la Généralité de Catalogne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc43274e-7604-4c4a-b4f8-6a48e50d46a6",
                                "sense_id": "6f756443-ed96-324e-a32c-9626b0946571",
                                "text": "Bien sûr, il y a le nouveau statut qui, remplaçant celui de 1979, devait élargir l'autonomie de la Generalitat, notamment sur le plan de la politique fiscale."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b1894f6-a5aa-334e-a723-d90003a6ee90",
                        "entry_id": "fedabb35-591c-3389-83a7-a6986bab7b87",
                        "glosses": [
                            "gouvernement de la Généralité valencienne."
