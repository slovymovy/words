                    {
                        "sense_id": "2af616b9-53a8-357c-b244-a4af0c071272",
                        "entry_id": "8776eac4-43d3-3013-a7bc-996aa25c014b",
                        "glosses": [
                            "Person, die die Schuld an einem Unfall trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9b25c82-a6ea-44f6-b96c-e74d94ad43d3",
                                "sense_id": "2af616b9-53a8-357c-b244-a4af0c071272",
                                "text": "Der Unfallverursacher floh vom Unfallort, konnte aber kurz darauf von der Polizei gestellt werden."
                            },
                            {
                                "example_id": "9b0f7304-8319-41c7-b1c0-57c158c082ca",
                                "sense_id": "2af616b9-53a8-357c-b244-a4af0c071272",
                                "text": "„Das komme daher, sagt die Ortspolizei, dass der Mopedfahrer – der jetzt als alleiniger Unfallverursacher eingestuft ist – ohne Helm gefahren sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
