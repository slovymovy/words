                        "examples": [
                            {
                                "example_id": "ae48b0e4-2578-4e0d-adec-71539c0474b3",
                                "sense_id": "4aa759bb-5e46-37d9-ae72-ffddbc1985a2",
                                "text": "Het voorlopige label is gebaseerd op openbare gegevens uit het Kadaster zoals het type huis, de grootte en het bouwjaar, en op gegevens van vergelijkbare huizen. Die gegevens van vergelijkbare huizen komen uit een onderzoek over het totale huizenbestand in Nederland uit 2006."
                            },
