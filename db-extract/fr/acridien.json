                                        "glosses": [
                                            "A fruit or pod of a carob tree (Ceratonia siliqua)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6d3b4a-9672-40a3-bed1-8458a3a09ba0",
                                                "sense_id": "e13e237e-9899-36e9-b808-91101b2aedf7",
                                                "text": "Among other articles, they brought with them a great quantity of locusts, which are a kind of pulse, sweet and pleasant to the palate, and in shape resembling French beans, but longer."
                                            }
                                        ]
                                    },
