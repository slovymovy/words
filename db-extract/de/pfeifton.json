                "senses": [
                    {
                        "sense_id": "733c8902-321b-3003-9df8-4cac2b29511a",
                        "entry_id": "a0e4fbb7-90a8-3c93-ad3b-7bd0341bbd5f",
                        "glosses": [
                            "meist hohes Geräusch (Ton), das zum Beispiel durch Blasen von Luft (Pfeifen) entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dce6a8e-81c3-46a9-803e-bab4f1b6ec09",
                                "sense_id": "733c8902-321b-3003-9df8-4cac2b29511a",
                                "text": "Der Wasserkessel gibt einen Pfeifton von sich."
                            },
                            {
                                "example_id": "89b948d2-9549-4c33-b11c-e4aea86d8a20",
                                "sense_id": "733c8902-321b-3003-9df8-4cac2b29511a",
                                "text": "Ich nehme den Hörer hoch und höre einen unangenehmen Pfeifton."
                            },
                            {
                                "example_id": "17739035-f15a-4e19-8477-dce903b2e82c",
                                "sense_id": "733c8902-321b-3003-9df8-4cac2b29511a",
                                "text": "„Bouvard, der mit weit abgespreizten Ellbogen auf sein Schreibpult hingeflegelt lag, um seine Bastardschrift recht schwungvoll abzurunden, pustete seinen Pfeifton vor sich hin und kniff dabei die schweren Augenlider listig zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
