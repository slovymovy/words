                                    {
                                        "sense_id": "7e4fec12-a912-3dee-8bb0-0f9647350bbc",
                                        "entry_id": "3e4ea25f-80ab-3674-b879-7ecac59167fa",
                                        "glosses": [
                                            "menschenunwürdige Behandlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcbdbd06-a718-410f-88cc-7364a83ad016",
                                                "sense_id": "7e4fec12-a912-3dee-8bb0-0f9647350bbc",
                                                "text": "„Wie lange lassen sich die Völker von Mauretanien bis Jemen und vom Sudan bis Syrien diese Erniedrigungen noch gefallen?“"
                                            },
                                            {
                                                "example_id": "564679c7-9468-4338-8d0c-314cd366d5b1",
                                                "sense_id": "7e4fec12-a912-3dee-8bb0-0f9647350bbc",
                                                "text": "„Der Unterschied zwischen völliger Unschuld und völliger Erniedrigung ist so gering, daß sie sogleich bei ihrem ersten Versuch jenen Grad gewollter Niedrigkeit erreichte, durch den sie mich zu verführen dachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4aab2af0-630d-33d2-854c-46a65165cae7",
                                        "entry_id": "3e4ea25f-80ab-3674-b879-7ecac59167fa",
                                        "glosses": [
                                            "Maßnahme oder Ergebnis der Verringerung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de5eaab5-9091-4b01-a864-8ca20b2ba777",
                                                "sense_id": "4aab2af0-630d-33d2-854c-46a65165cae7",
                                                "text": "„Bei der antihypertensiven Therapie ist es die Erniedrigung des Blutdrucks, die das Risiko für Schlaganfall, Herzinfarkt, Herzinsuffizienz und Nierenschädigung verringert. “"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
