                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While we are in Brighton, let's get a stick of <w>rock</w>!",
                            "target_lang_translations": {
                                "ru": "Пока мы в Брайтоне, давай купим палочку <w>леденца</w>!"
                            }
                        },
                        {
                            "text": "The children enjoyed their colorful sticks of <w>rock</w> from the seaside shop.",
                            "target_lang_translations": {
                                "ru": "Дети наслаждались своими разноцветными палочками <w>карамели</w> из лавки на побережье."
                            }
                        }
                    ],
                    "synonyms": [
                        "candy"
                    ],
                    "common_phrases": [
                        "stick of rock"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид кондитерского изделия из сахара в форме палочки, традиционно с текстом внутри."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "леденец",
                                "target_lang_sense_clarification": "твердая конфета"
                            },
                            {
                                "target_lang_word": "карамель",
                                "target_lang_sense_clarification": "сахарное изделие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cbbd49b-b16d-389e-83c0-dbbd8792aac5",
                    "sense_definition": "A crystallized lump of crack cocaine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found several <w>rocks</w> of crack in the suspect's pocket.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла несколько <w>камней</w> крэка в кармане подозреваемого."
                            }
                        },
                        {
                            "text": "He was arrested for selling <w>rocks</w> on the street corner.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за продажу <w>крэка</w> на углу улицы."
                            }
                        }
                    ],
                    "synonyms": [
                        "crack",
                        "crack rock"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кристаллизованный комок крэк-кокаина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крэк",
                                "target_lang_sense_clarification": "наркотическое вещество"
                            }
                        ]
                    }
                }
