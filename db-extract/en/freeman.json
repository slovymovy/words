                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33f9a0db-8efb-46f9-81e2-cfbc1830141c",
                        "source_entry_id": "0f750fcc-c8d2-3170-9bad-2d08a122902e",
                        "source_sense_description": "person who is not a serf or slave",
                        "target_lang_word": "homme libre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homme libre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ff697c9-1835-300e-9017-0d618655251b",
                                        "entry_id": "4b63ef59-16bb-33ce-b15a-bb7a7c56e3dc",
                                        "glosses": [
                                            "Homme qui n’est pas soumis au servage ou à l’esclavage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba72c97-db34-4b79-9c44-a19a64e1845d",
                                                "sense_id": "9ff697c9-1835-300e-9017-0d618655251b",
                                                "text": "Homme libre, toujours tu chériras la mer !"
                                            },
                                            {
                                                "example_id": "612b98f5-b9e8-4633-8476-65320b48c6d1",
                                                "sense_id": "9ff697c9-1835-300e-9017-0d618655251b",
                                                "text": "A moins d’une lieue de Vendœuvres, en allant sur le marais de Bellebouche, au lieu dit « le button aux fades », une famille d’hommes libres, venant de la région d’Erfurt, a été pourvue par notre souverain d’un domaine, en remplacement d’Aquitains qui avaient péri pendant la guerre, il y a cela plus de vingt ans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "535ee806-5a4a-4d52-81d2-e7d2a1868f06",
                        "source_entry_id": "0f750fcc-c8d2-3170-9bad-2d08a122902e",
                        "source_sense_description": "person who is not a serf or slave",
                        "target_lang_word": "Kerl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kerl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                        "entry_id": "5273b05d-4a7d-3e1e-a6ba-3be159b7faae",
                                        "glosses": [
                                            "eine (meistens männliche) Person (Dieser Begriff kann sowohl eine positive als auch eine negative Konnotation tragen je nach Eigenschaft der Männlichkeit, die angesprochen wird.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "167a0450-b4c1-43df-94d2-386591da20ed",
                                                "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                                "text": "Letztens spricht doch so ein Kerl in der Kneipe meine Freundin an."
                                            },
                                            {
                                                "example_id": "86988a84-4437-4d3f-a8a5-73b1b1c1cca6",
                                                "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                                "text": "„Unten am Hafen stehen zwei alte Kerle mit einer Angelrute und fangen Fische.“"
                                            },
                                            {
                                                "example_id": "156ec4dd-b0b8-4b3f-b0eb-cb73c59e1c19",
                                                "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                                "text": "„Claudia hat mich zurückgenommen, sie ist ein guter Kerl, Ritchie tat auch ganz erfreut.“"
                                            },
                                            {
                                                "example_id": "3be2bd7a-d0d2-4ebf-b803-b6763aeb63ac",
                                                "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                                "text": "„Der Kerl wartete, bis sein Drink kam.“"
                                            },
                                            {
                                                "example_id": "47248036-2381-4444-8c03-6e0208fc8dc6",
                                                "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                                "text": "„Sie war einfach ein feiner Kerl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
