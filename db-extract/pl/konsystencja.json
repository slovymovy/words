                        "entry_id": "adc95599-c3bb-3936-9c61-4b91e2dee57f",
                        "glosses": [
                            "poziom określonych cech fizycznych (gęstość, twardość, lepkość) danej substancji; spoistość"
                        ],
                        "tags": [],
                        "examples": [
