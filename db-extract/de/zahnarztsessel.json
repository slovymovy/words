                "senses": [
                    {
                        "sense_id": "95592f27-fb5e-31ab-869d-98d0522fdc07",
                        "entry_id": "4a0374fd-f4e7-3718-a5f2-f163ba7dbb0e",
                        "glosses": [
                            "das Möbel, auf dem der Zahnarzt seine Patienten behandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0076341-554d-4c21-a6bf-e4a75f085378",
                                "sense_id": "95592f27-fb5e-31ab-869d-98d0522fdc07",
                                "text": "„Ein Zahnarztsessel kostet ca. 4000 Manat und mein Monatsgehalt wäre 100 Manat.“"
                            },
                            {
                                "example_id": "ef569f4b-68e9-41cc-a4ea-a9a892c31494",
                                "sense_id": "95592f27-fb5e-31ab-869d-98d0522fdc07",
                                "text": "„Es seien die Kleinigkeiten, die sich summierten und das Geschäft am Laufen hielten – die verschlissenen Motorradbänke, die gerissenen Hundeleinen und Lederhandtaschen, oder hie und da ein lederbezogener Rollstuhl oder Zahnarztsessel.“"
                            },
                            {
                                "example_id": "78ee24a9-f64a-45fb-b722-d33051dd5577",
                                "sense_id": "95592f27-fb5e-31ab-869d-98d0522fdc07",
                                "text": "„Allein der Umstand, dass er sich ausgerechnet auf den Zahnarztsessel seiner Ex-Freundin legte, lässt manche Online-Portale an seinem Verstand zweifeln.“"
                            },
                            {
                                "example_id": "3f24611e-bac3-4239-8ae1-85089d806e6d",
                                "sense_id": "95592f27-fb5e-31ab-869d-98d0522fdc07",
                                "text": "„Sein Nachtlager bezieht er auf einem alten Zahnarztsessel im Wohnzimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
