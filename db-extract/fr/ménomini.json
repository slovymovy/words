                                    },
                                    {
                                        "sense_id": "a8109075-8c32-3b0e-8b91-1f92c9cc8fec",
                                        "entry_id": "f46f789e-0118-3004-88ac-1ff802a039de",
                                        "glosses": [
                                            "Any of several other fish, such as whiting (Merlangius merlangus) or menhaden (Brevoortia spp. and Ethmidium spp.)."
                                        ],
                                        "tags": [],
