                                    {
                                        "sense_id": "b56229d0-64e6-3c83-9b26-615895cb3d69",
                                        "entry_id": "732a0afe-8958-3eda-b26a-2c485461cecb",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de murmurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "088c8d4c-c38d-470f-836f-05b7fd306f6e",
                                                "sense_id": "b56229d0-64e6-3c83-9b26-615895cb3d69",
                                                "text": "Pendant quarante minutes, chaque semaine (la case de diffusion n’a pas encore été officialisée, mais il se murmure que le programme s’installera en après-midi le week-end), et en présence d’un ou deux invités, ils rebondiront sur l’actualité avec leur prisme sarcastique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b67b338-4a61-3408-8cbd-f399f4f1fe51",
                                        "entry_id": "732a0afe-8958-3eda-b26a-2c485461cecb",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de murmurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f078e5ff-c0d7-3384-9f8c-3a814fdda834",
                                        "entry_id": "732a0afe-8958-3eda-b26a-2c485461cecb",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de murmurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4aaee83-7a2d-31d2-ab8f-f9c95d737da4",
                                        "entry_id": "732a0afe-8958-3eda-b26a-2c485461cecb",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de murmurer."
                                        ],
