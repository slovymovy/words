                ],
                "senses": [
                    {
                        "sense_id": "e1bd18f9-6e19-3a3f-b286-dde7d673ae62",
                        "entry_id": "b86e6371-9b3c-3058-a694-911b82372d83",
                        "glosses": [
                            "Person, die für die Verwertung und Entsorgung nicht essbarer toter Nutztiere verantwortlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bd8d309-03e2-49b3-a085-c676c973bef7",
                                "sense_id": "e1bd18f9-6e19-3a3f-b286-dde7d673ae62",
                                "text": "„Ist ein solches Stück Vieh gefallen oder getötet worden, und das Fleisch desselben ungenießbar oder als ungenießbar erklärt worden, so ist binnen 6 (bei kalter Witterung binnen 12) Stunden einem Wasenmeister hiervon Anzeige zu machen.“"
                            },
                            {
                                "example_id": "c7d95513-e02e-495d-9bb4-e0b2582e4788",
                                "sense_id": "e1bd18f9-6e19-3a3f-b286-dde7d673ae62",
                                "text": "„Der Wasenmeister nach – damaligem Herkommen war mit Fuhrwerk schnell bei der Hand.“"
                            },
                            {
                                "example_id": "4718c873-7f93-4fd9-a922-3a856bf3bbfa",
                                "sense_id": "e1bd18f9-6e19-3a3f-b286-dde7d673ae62",
                                "text": "„Der Wasenmeister, jener Mensch mit dem Bajonett, konnte uns nicht sagen, ob der streunende Köter die Krankheit in sich trug.“"
                            },
                            {
                                "example_id": "4170bde1-6e1e-4222-9e35-3fb742f544ac",
                                "sense_id": "e1bd18f9-6e19-3a3f-b286-dde7d673ae62",
                                "text": "„In der Neuzeit (bis 1816) fungierte der Scharfrichter zugleich als Wasenmeister (Abdecker).“",
                                "translation": "„So sei der Neufarner Berg seit der frühen Neuzeit eine wichtige Landmarke für die von und nach München fahrenden Fuhrwerke gewesen, und es habe wohl auch schon lange einen Wasenmeister - also jemanden, der für den Erhalt der Straße zuständig war - gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
