                        "examples": [
                            {
                                "example_id": "1ebd59b7-0377-4863-a084-a7758f029efd",
                                "sense_id": "df15d1bc-9687-3b06-a6ce-b163e1efe884",
                                "text": "In fact, the everliving differs from the eternal."
                            },
                            {
                                "example_id": "db52c104-fbb9-49d0-a794-0e6d0cbbdb3d",
                                "sense_id": "df15d1bc-9687-3b06-a6ce-b163e1efe884",
                                "text": "Be aware you are, and discover the everliving."
                            },
                            {
                                "example_id": "c2ea96e0-dc1d-4b55-8d54-b3be77731ddb",
                                "sense_id": "df15d1bc-9687-3b06-a6ce-b163e1efe884",
                                "text": "Lucifer and his followers among the Everliving manifested the beauty of God."
                            }
                        ]
