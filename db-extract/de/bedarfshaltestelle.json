                        "entry_id": "65edf5a8-cee5-37c8-9170-ae79d61f071e",
                        "glosses": [
                            "Haltestelle, an der nur auf Wunsch eines Fahrgastes angehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5fcf2e6-f92e-45b9-a57b-bdcb75aec41e",
                                "sense_id": "942a93ed-bcfd-3a7d-8287-cc39f00e4799",
                                "text": "„Der Ostbahnhof am Maidamm war einst Bedarfshaltestelle.“"
                            },
                            {
                                "example_id": "662a6471-49b0-4d23-a53c-c7e568f10367",
                                "sense_id": "942a93ed-bcfd-3a7d-8287-cc39f00e4799",
                                "text": "„Genutzt werden soll die Haltestelle - gemäss SBB- Terminologie eine Bedarfshaltestelle - bei Grossanlässen im St.-Jakob-Park und in der benachbarten St.-Jakobs-Halle.“"
                            },
                            {
                                "example_id": "152e4d03-8c47-4a27-8a1a-2ed063bc323c",
                                "sense_id": "942a93ed-bcfd-3a7d-8287-cc39f00e4799",
                                "text": "„Bei Bedarfshaltestellen können Fahrgäste den Bus via SMS rufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
