                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова \"string\" (веревка, струна, нить).",
                        "fr": "Pluriel de \"string\" (corde, ficelle, fil)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "струны",
