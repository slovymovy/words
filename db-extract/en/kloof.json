                    {
                        "sense_id": "448dd701-9279-3685-b9cb-68c3900d4eaa",
                        "entry_id": "23f5dc66-1e4a-3441-b454-8cc2c61344fb",
                        "glosses": [
                            "A deep glen or ravine."
                        ],
                        "tags": [
                            "South-Africa"
                        ],
                        "examples": [
                            {
                                "example_id": "85b0d558-7c1c-4986-83ff-2add3fb310da",
                                "sense_id": "448dd701-9279-3685-b9cb-68c3900d4eaa",
                                "text": "Forming the south boundary of the valley is a range of disrupted bushy hills, with intervening deep and rugged kloofs and ravines, which constituted the retreat of Jan Pockbaas and his rebel banditti."
                            },
                            {
                                "example_id": "29ba2045-75ea-4457-ab0d-bb2ef8f02866",
                                "sense_id": "448dd701-9279-3685-b9cb-68c3900d4eaa",
                                "text": "The grass is rich and matted, you cannot see the soil. It holds the rain and the mist, and they seep into the ground, feeding the streams in every kloof."
                            },
                            {
                                "example_id": "475ce159-4390-4ae1-a82a-4b34268f567c",
                                "sense_id": "448dd701-9279-3685-b9cb-68c3900d4eaa",
                                "text": "Occasionally the narrow dirt road rose above the mist on the slopes of the high round hills, from where one looked down on the silver clouds in the valleys and kloofs below, a magical, incredible sight."
                            }
                        ]
                    }
                ],
