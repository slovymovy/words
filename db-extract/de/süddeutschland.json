                ],
                "senses": [
                    {
                        "sense_id": "aec20398-3430-355b-94e8-130f9408bae0",
                        "entry_id": "a8ee0da3-d476-3129-866e-94f9e1d632b1",
                        "glosses": [
                            "südlicher Landesteil Deutschlands, der unscharf abgegrenzt ist, häufig wird der Main als dessen nördliche Grenze betrachtet"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "35b2bbb0-da1c-4750-aebe-973c2f56c427",
                                "sense_id": "aec20398-3430-355b-94e8-130f9408bae0",
                                "text": "Ob man in Süddeutschland wirklich besser studiert als in Ostdeutschland, weiß niemand so genau."
                            },
                            {
                                "example_id": "10147229-bc29-4cc9-8f06-64a71e42ffac",
                                "sense_id": "aec20398-3430-355b-94e8-130f9408bae0",
                                "text": "„An Mittel- und Oberrhein und in Süddeutschland waren die Kelten zu jener Zeit die unmittelbaren Nachbarn der Germanen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fe73a876-a657-37d7-870b-63ad95858933",
                        "entry_id": "a8ee0da3-d476-3129-866e-94f9e1d632b1",
                        "glosses": [
                            "der oberdeutsche Sprachraum, in dem Oberdeutsch gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "627e2d55-c1ac-45ad-86bf-20bf8e190842",
                                "sense_id": "fe73a876-a657-37d7-870b-63ad95858933",
                                "text": "„In Süddeutschland und in Österreich sagt man dennoch \"Ich bin gesessen\", \"Ich bin gelegen\" und \"Ich bin gestanden\".“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
