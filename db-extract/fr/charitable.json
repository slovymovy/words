        "fr-extract.jsonl": [
            {
                "entry_id": "2f49ca45-4795-3536-bc84-dbed3a263d4c",
                "word": "charitable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1d1e175a-9661-46f8-be4a-5033006778bb",
                        "entry_id": "2f49ca45-4795-3536-bc84-dbed3a263d4c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "charitables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "404f2736-496b-3c5a-922c-dcdf1823eba9",
                        "entry_id": "2f49ca45-4795-3536-bc84-dbed3a263d4c",
                        "glosses": [
                            "Qui a de la charité pour son prochain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe4a238d-335c-41bb-a7e1-03df349b08ca",
                                "sense_id": "404f2736-496b-3c5a-922c-dcdf1823eba9",
                                "text": "Nous autres, Parisiens, sommes charitables au provincial..."
                            },
                            {
                                "example_id": "5aa01fe0-0f1a-4f78-8927-a3287e8ec49f",
                                "sense_id": "404f2736-496b-3c5a-922c-dcdf1823eba9",
                                "text": "C'est en réalité par respect pour l'artiste, dont j'ai toujours été envieux du coup de crayon, que je me suis jusqu'ici montré charitable."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d34f5bf-1787-3cb4-8ecc-60a04fca8e06",
                        "entry_id": "2f49ca45-4795-3536-bc84-dbed3a263d4c",
                        "glosses": [
                            "Qui fait l’aumône."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "95ffb9ca-9634-4d20-9f9b-496213469ec2",
                                "sense_id": "9d34f5bf-1787-3cb4-8ecc-60a04fca8e06",
                                "text": "Il remâchait, avec une sorte d'amère délectation, les heures de pourchas fastidieux, à l'affût de la poire charitable et tapable."
                            }
                        ]
                    },
                    {
                        "sense_id": "15cd96ce-f5b4-3201-b4c8-711878c28fd4",
                        "entry_id": "2f49ca45-4795-3536-bc84-dbed3a263d4c",
                        "glosses": [
                            "Qui part d’un principe de charité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d56a6751-3d04-4af3-983d-841e3dbeccf5",
                                "sense_id": "15cd96ce-f5b4-3201-b4c8-711878c28fd4",
                                "text": "Secours charitable. Conseil charitable. Avis charitable."
                            },
                            {
                                "example_id": "b002c4a7-1d3c-4131-8162-ceb6ca02ff8e",
                                "sense_id": "15cd96ce-f5b4-3201-b4c8-711878c28fd4",
                                "text": "Mais Rébecca était déjà occupée à mettre à exécution son projet charitable sans écouter les paroles de son père."
                            }
                        ]
                    },
                    {
                        "sense_id": "68bb240c-fb20-3c9b-ac02-4517d7fcedd7",
                        "entry_id": "2f49ca45-4795-3536-bc84-dbed3a263d4c",
                        "glosses": [
                            "Qui est indulgent."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "547ea8cb-d631-4d4a-bec7-ddc4042eee64",
                                "sense_id": "68bb240c-fb20-3c9b-ac02-4517d7fcedd7",
                                "text": "Quoi ? Je suis charitable : je ne lui ai pas présenté la petite sœur dans les gencives…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a621c834-f886-4f70-8f71-a4ad1a48d16e",
                        "source_entry_id": "2f49ca45-4795-3536-bc84-dbed3a263d4c",
                        "target_lang_word": "charitable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
