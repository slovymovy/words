                "senses": [
                    {
                        "sense_id": "e4498ed7-3636-389b-b96a-6e3b6c094e60",
                        "entry_id": "8aa0756d-1c61-3abc-bc91-980cab2e4ac1",
                        "glosses": [
                            "von dem Germanisten Franz Joseph Beranek so benannte früheste Form des Jiddischen, die sich noch wenig vom Deutschen unterscheidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec469c6f-2b18-4e4b-9789-0647297bf894",
                                "sense_id": "e4498ed7-3636-389b-b96a-6e3b6c094e60",
                                "text": "„Das verarmte Ghettodeutsch der Juden in Deutschland selber, das zunächst wenig vom korrekten Deutsch abwich und nur mit einer geringen Menge hebräischer und romanischer Elemente vermischt war, das dann zwar im sechzehnten Jahrhundert schon deutliche eigene Formen entwickelte, für den deutschen Nichtjuden jedoch nach wie vor leicht verständlich war, nennt er das Urjiddisch.“"
                            },
                            {
                                "example_id": "4134618b-b2b5-45be-906f-4115a1de2b94",
                                "sense_id": "e4498ed7-3636-389b-b96a-6e3b6c094e60",
                                "text": "„Ebenso neueren Ursprungs ist die chronologische Unterteilung Urjiddisch (bis 1250), Altjiddisch (bis 1500), Mitteljiddisch (bis 1750) und Neujiddisch (seit 1750).“"
                            },
                            {
                                "example_id": "e3f7c9d0-d3d3-4de4-96ba-46ad2b7d62c1",
                                "sense_id": "e4498ed7-3636-389b-b96a-6e3b6c094e60",
                                "text": "„Eine Unterteilung nach zeitlichen Phasen in der Geschichte der Sprache ist folgendermaßen üblich: Urjiddisch (laut Max Weinreich: 1000 bis 1250), Altjiddisch (1250 bis 1500), Mitteljiddisch (1500 bis 1700) und schließlich Neujiddisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
