                    {
                        "sense_id": "467c6354-c285-319e-a95e-7f8a9b44ab59",
                        "entry_id": "851629cd-5314-3b81-8441-dea773d6d5f7",
                        "glosses": [
                            "Qui présente partiellement les caractères du délire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42c45f47-d024-4589-b7a1-1b9aaf68a52d",
                                "sense_id": "467c6354-c285-319e-a95e-7f8a9b44ab59",
                                "text": "Il ne faut pas confondre cette chorée procursive avec les accidents semi-délirants qui entraînent les malades, malgré eux, au début de certains accidents cérébraux, ou à la suite d’attaque d’épilepsie."
                            },
                            {
                                "example_id": "4989ca26-901f-4227-bab2-9892a3c402d2",
                                "sense_id": "467c6354-c285-319e-a95e-7f8a9b44ab59",
                                "text": "Une sorte de fièvre teintée de pensées semi-délirantes."
                            },
                            {
                                "example_id": "ee39a171-9440-4ffc-aed6-abb7e01872bc",
                                "sense_id": "467c6354-c285-319e-a95e-7f8a9b44ab59",
                                "text": "Ces sortes de réveils étaient marquées par un cri aigu et par la projection des membres, tantôt d’un côté, tantôt d’un autre, et les premiers jours par une loquacité semi-délirante qui n’inquiétait pas moins que la stupeur."
                            }
                        ]
                    }
