                        "tags": [],
                        "examples": [
                            {
                                "example_id": "989504ca-0ef2-40af-990f-4ff4e7d28993",
                                "sense_id": "48bc41ca-c280-3674-ad83-eaf253799aa2",
                                "text": "Наиболее успешно на водных дорожках выступали шведский байдарочник Герт Фредериксен и немецкая байдарочница Биргит Фишер — 6-кратные олимпийские чемпионы."
                            }
                        ]
                    }
