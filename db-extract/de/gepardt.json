                ],
                "senses": [
                    {
                        "sense_id": "fd33a0b2-5fd1-39ba-bc4a-191f28324919",
                        "entry_id": "99b1f907-1628-339e-872b-bfb8edf62357",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ab70fa-4c73-476b-a84b-68538aa2ca6f",
                                "sense_id": "fd33a0b2-5fd1-39ba-bc4a-191f28324919",
                                "text": "Frau Gepardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9d717d03-16e0-49c8-972b-0120fe86c4bc",
                                "sense_id": "fd33a0b2-5fd1-39ba-bc4a-191f28324919",
                                "text": "Herr Gepardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ef0943c3-f479-4567-aea5-1fda8d4b2792",
                                "sense_id": "fd33a0b2-5fd1-39ba-bc4a-191f28324919",
                                "text": "Die Gepardts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5f4518fd-5a28-456b-afa8-30fc115827c8",
                                "sense_id": "fd33a0b2-5fd1-39ba-bc4a-191f28324919",
                                "text": "Der Gepardt trägt nie die Schals, die die Gepardt ihm strickt."
                            },
                            {
                                "example_id": "bfce7466-4303-4f41-80a6-44fde6cae031",
                                "sense_id": "fd33a0b2-5fd1-39ba-bc4a-191f28324919",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gepardt kommt, geht der Herr Gepardt.“"
                            },
                            {
                                "example_id": "547a0fc8-6c86-4a90-a24d-22b5309bf7fb",
                                "sense_id": "fd33a0b2-5fd1-39ba-bc4a-191f28324919",
                                "text": "Gepardt kommt und geht."
                            },
                            {
                                "example_id": "24733d8b-8d51-45c9-9761-23816b8f1027",
                                "sense_id": "fd33a0b2-5fd1-39ba-bc4a-191f28324919",
                                "text": "Gepardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
