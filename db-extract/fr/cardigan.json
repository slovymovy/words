            {
                "entry_id": "f1ccd7be-4075-378e-aa08-1b924b169bd1",
                "word": "cardigan",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "93bd2964-0c22-4938-a204-8c95f0a7a668",
                        "entry_id": "f1ccd7be-4075-378e-aa08-1b924b169bd1",
                        "tags": [
                            "plural"
                        ],
                        "form": "cardigans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                        "entry_id": "f1ccd7be-4075-378e-aa08-1b924b169bd1",
                        "glosses": [
                            "Veste tricotée, boutonnée par devant, sans col."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "608c24a6-5d5c-4226-b283-8c617a72ebbf",
                                "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                "text": "Elle portait une jupe de tweed et un cardigan en shetland."
                            },
                            {
                                "example_id": "352b0344-9273-45f5-853c-545c4db2377f",
                                "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                "text": "Le cardigan : impeccablement réalisé dans une matière raffinée, [74% acétate et 26% polyamide], fraîche, chatoyante, de belle tenue et facile à entretenir."
                            },
                            {
                                "example_id": "6aa710e7-2b2e-4b24-b57b-3c911c90db34",
                                "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                "text": "Une jupe évasée, une crinoline si large que j'entrerai difficilement dans l'autobus et un petit cardigan tout mignon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3f89276-c4ec-43b8-aaae-a2144d1ad9f4",
                        "source_entry_id": "f1ccd7be-4075-378e-aa08-1b924b169bd1",
                        "source_sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                        "target_lang_word": "Strickjacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strickjacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                        "entry_id": "32a0b633-078a-33aa-9047-753313dc8ebe",
                                        "glosses": [
                                            "gestrickte Jacke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299425a5-b7ab-4ac9-b1b1-d48adeeaa8a5",
                                                "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                                "text": "Weil mein Vater seine Strickjacke tagtäglich trägt, ist sie mittlerweile völlig ausgeleiert."
                                            },
                                            {
                                                "example_id": "7f78e095-ddb4-41fa-b374-c1610540144b",
                                                "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                                "text": "„Aber Dincklages Bursche hatte den Ofen in der Schreibstube geheizt, so daß sie die Strickjacke ausziehen konnte.“"
                                            },
                                            {
                                                "example_id": "6a9f7561-2da9-4a7b-8044-b1b41496d5dc",
                                                "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                                "text": "„Es ist schattig geworden und kühler, die Dame zieht die Ärmel der Strickjacke nach unten.“"
                                            },
                                            {
                                                "example_id": "79d6fcd5-cb80-4a0f-974c-45c5f90a99a0",
                                                "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                                "text": "„Ich roch die muffige Strickjacke und ein süßliches Putzmittel.“"
                                            },
                                            {
                                                "example_id": "814f3f03-5cde-4746-a394-0c81a5540569",
                                                "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                                "text": "„Ich lief in ihr Schlafzimmer und warf die Strickjacke aufs Bett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dca13138-8926-4632-9d64-06d37679af8f",
                        "source_entry_id": "f1ccd7be-4075-378e-aa08-1b924b169bd1",
