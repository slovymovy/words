                "senses": [
                    {
                        "sense_id": "4694618c-0562-3543-a744-415903bc4713",
                        "entry_id": "fc753bb6-0f63-382d-a84a-1ab3619fb842",
                        "glosses": [
                            "Verbaliser (envoyer un procès-verbal aux contrevenants) en utilisant des images vidéo pour détecter les infractions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "651ddb12-4d76-4a59-9f01-9c03be3edf59",
                                "sense_id": "4694618c-0562-3543-a744-415903bc4713",
                                "text": "Depuis longtemps, on a même assermenté des agents administratifs et techniques afin qu’ils puissent vidéoverbaliser."
                            },
                            {
                                "example_id": "e21a3f72-1456-4673-a7b7-3567707439df",
                                "sense_id": "4694618c-0562-3543-a744-415903bc4713",
                                "text": "La RTM va \"vidéoverbaliser\" les automobilistes marseillais."
                            },
                            {
                                "example_id": "c9ce4093-e58a-4d9a-a3e9-3b24103d5e1d",
                                "sense_id": "4694618c-0562-3543-a744-415903bc4713",
                                "text": "\"L'an prochain, nous passons de 1370 à 4000 appareils\", annonce Karim Zéribi, qui projette aussi d'installer des mouchards dans les voies de bus pour \"vidéoverbaliser\" les chauffards qui y circulent."
                            }
                        ]
                    }
