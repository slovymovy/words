                ],
                "translations": [
                    {
                        "translation_id": "f884f12e-6147-4638-a545-eae547ce4b21",
                        "source_entry_id": "996167a5-eada-3393-83d2-0e299e2c72f2",
                        "source_sense_id": "e94b3f08-ab9d-3af1-89dc-951b866328de",
                        "source_sense_description": "someone from Rhineland",
                        "target_lang_word": "Rheinländer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rheinländer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99398497-ee91-36e5-a81f-83e05c800446",
                                        "entry_id": "4cf7a06b-9966-3ca7-9409-6cd2fca5d6c2",
                                        "glosses": [
                                            "Bewohner des Rheinlandes, jemand, der aus dem Rheinland stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd8d1056-32da-4560-bd22-af07356aeac0",
                                                "sense_id": "99398497-ee91-36e5-a81f-83e05c800446",
                                                "text": "„Was also sollten die Rheinländer von den Preußen halten?“"
                                            },
                                            {
                                                "example_id": "bc18764c-62f2-43fd-81e3-fcbf60fbd10e",
                                                "sense_id": "99398497-ee91-36e5-a81f-83e05c800446",
                                                "text": "„Geistige Beweglichkeit, Aufgeschlossenheit für Neuerungen, leichtbeschingte Fröhlichkeit mit Witz und Humor charakterisieren den Rheinländer.“"
                                            },
                                            {
                                                "example_id": "428f78ad-df6a-4aa6-80ea-c3519f43f0b4",
                                                "sense_id": "99398497-ee91-36e5-a81f-83e05c800446",
                                                "text": "Jupp ist ein typischer Rheinländer."
                                            },
                                            {
                                                "example_id": "0da6a9bb-a951-43d5-8608-86d3fce62ed4",
                                                "sense_id": "99398497-ee91-36e5-a81f-83e05c800446",
                                                "text": "„So wie Siegmund A. Wolf nahezu die Hälfte der über 6000 Belege seines berühmten „Wörterbuch des Rotwelschen“ auf das Jiddische zurückführen möchte, so ist die Gleichsetzung von Viehhändlersprache und Judendeutsch zumindest bei den älteren Rheinländern und Rheinländerinnen weit verbreitet.“"
                                            },
                                            {
                                                "example_id": "27fe6224-e88b-4b42-9165-c4432374c5fd",
                                                "sense_id": "99398497-ee91-36e5-a81f-83e05c800446",
                                                "text": "„Die Rheinländer waren nicht begeistert, sie nahmen die Tatsache einfach hin.“"
                                            },
                                            {
                                                "example_id": "0ae411f5-01b5-4874-a2f5-610b77da205b",
                                                "sense_id": "99398497-ee91-36e5-a81f-83e05c800446",
                                                "text": "„Die Direktheit der Rheinländer ist Legende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4f1e311-a748-36b7-9b02-bf7c7e589344",
                                        "entry_id": "4cf7a06b-9966-3ca7-9409-6cd2fca5d6c2",
                                        "glosses": [
                                            "Gesellschaftstanz im Zweivierteltakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922f4aec-b6be-42c6-96d4-9403c833ffda",
                                                "sense_id": "c4f1e311-a748-36b7-9b02-bf7c7e589344",
                                                "text": "Sie tanzten einen Rheinländer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
