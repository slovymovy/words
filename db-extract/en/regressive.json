    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "52dc07d8-4593-3bbb-a6a9-909832e614b3",
                "word": "regressive",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "af03c2b5-c95e-4497-8429-de5813b7fa89",
                        "entry_id": "52dc07d8-4593-3bbb-a6a9-909832e614b3",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more regressive"
                    },
                    {
                        "form_id": "2c42d14f-8856-49e8-a3a3-eaebc1b6b358",
                        "entry_id": "52dc07d8-4593-3bbb-a6a9-909832e614b3",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most regressive"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "597e088d-b188-316d-af80-9e2bd9e2f588",
                        "entry_id": "52dc07d8-4593-3bbb-a6a9-909832e614b3",
                        "glosses": [
                            "That tends to return, revert or regress."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea491d35-33ce-4de4-a3c9-f23f4a2d084b",
                                "sense_id": "597e088d-b188-316d-af80-9e2bd9e2f588",
                                "text": "Some say history repeats itself, that time is cyclical. Others cling to the notion of progress and change over time. Apparently Nancy Walker marches to a different drummer — marches backwards, that is. Her ideas on art and society seem quaint and odd on the one hand and, on the other, petty and regressive."
                            },
                            {
                                "example_id": "4e2c02ea-aa89-4511-90ec-cb0c48fdd953",
                                "sense_id": "597e088d-b188-316d-af80-9e2bd9e2f588",
                                "text": "A contributing factor to this slightly regressive femininity may have been the sugary fabrics (silver lamé, tulle over sequins) and the meringuelike puffs and baby Googums bows at the neck."
                            },
                            {
                                "example_id": "b969d126-b647-46fb-a8ac-5aa382113845",
                                "sense_id": "597e088d-b188-316d-af80-9e2bd9e2f588",
                                "text": "He likes experimenting with flamboyant clothes! That’s it! It’s weird and regressive to think that means he is making a statement about his sexual orientation or gender identity. Let the man wear his “clowncore” jumpsuits in peace."
                            }
                        ]
                    },
                    {
                        "sense_id": "6501c434-64d4-3ed7-8774-041d0c2b2ece",
                        "entry_id": "52dc07d8-4593-3bbb-a6a9-909832e614b3",
                        "glosses": [
                            "Whose rate decreases as the taxed amount increases."
                        ],
                        "tags": [
                            "of a tax"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "665890f5-bd00-47d5-bf7b-049320c5f0fe",
                        "source_entry_id": "52dc07d8-4593-3bbb-a6a9-909832e614b3",
                        "source_sense_description": "that tends to return, revert, or regress",
                        "target_lang_word": "régressif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régressif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98e73dd2-f76b-3d1b-a6da-b9085a208fd6",
                                        "entry_id": "d2322c33-d6f3-3768-8e6e-758314b9520c",
                                        "glosses": [
                                            "Qui va en arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "635508f3-90d8-4a18-9556-42b00ec2fffa",
                                                "sense_id": "98e73dd2-f76b-3d1b-a6da-b9085a208fd6",
                                                "text": "Une marche régressive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54fe4b18-68ad-3aaf-bc98-dec89a2d36e9",
                                        "entry_id": "d2322c33-d6f3-3768-8e6e-758314b9520c",
                                        "glosses": [
                                            "Qui revient vers un stade plus primitif."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b65e12-908c-4557-a42c-9e06b17d57e5",
                                                "sense_id": "54fe4b18-68ad-3aaf-bc98-dec89a2d36e9",
                                                "text": "Dans le monde musulman, on assiste à un mouvement contradictoire, avec d'un côté, un retour vers le religieux pur et dur, parfois régressif, de l’autre, des appels formidables à sortir de la religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "144a99fc-761f-3f57-b02b-04e3eafbb6cc",
                                        "entry_id": "d2322c33-d6f3-3768-8e6e-758314b9520c",
                                        "glosses": [
                                            "Qui ramène à l’enfance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "759c2fad-46b6-4c36-9c82-b0a570a9d561",
                                                "sense_id": "144a99fc-761f-3f57-b02b-04e3eafbb6cc",
                                                "text": "Plaisir régressif de plonger dans les premières pages d’un album de Blake et Mortimer, en profitant d’autant mieux du club londonien, whisky, bibliothèque et fauteuil chesterfield, que la menace d’Olrik ne va pas tarder à se manifester dans un décor tout différent, souterrain ou portuaire."
                                            },
                                            {
                                                "example_id": "411c3eb9-5cb6-40d6-96b4-d27e419ddcfd",
                                                "sense_id": "144a99fc-761f-3f57-b02b-04e3eafbb6cc",
                                                "text": "Le cookie est une sorte de sablé, agrémenté d’ingrédients divers (pépites de chocolat, fruits secs torréfiés, gingembre, etc.), tellement régressif qu’il a été la star des confinements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
