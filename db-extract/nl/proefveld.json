                        "examples": [
                            {
                                "example_id": "e89e4d4d-ee57-437a-9ebe-cc6cef4b2a04",
                                "sense_id": "624bdd3c-750e-30ad-92cb-9677d2675e72",
                                "text": "Twee Nederlandse en negen Belgische milieuactivisten hebben dinsdag in België een lagere straf gekregen voor het vernielen van een proefveld aardappelen en bendevorming."
                            },
                            {
                                "example_id": "09e0a2cd-f6a2-4791-a8e2-f588c999de64",
                                "sense_id": "624bdd3c-750e-30ad-92cb-9677d2675e72",
                                "text": "Aan de Denekamperweg in Vasse is inmiddels een proefveld in gebruik, waar boeren ervaring opdoen met nieuwe technieken om met minder bemesting meer te kunnen bereiken."
                            }
                        ]
                    }
