                            {
                                "example_id": "4ba5a06c-c28a-4e32-92ff-d7ffaddc8aa3",
                                "sense_id": "180cf90e-9bc1-3d66-b82b-d0f8f29ad25b",
                                "text": "Ik houd niet van friet in krantenpapier."
