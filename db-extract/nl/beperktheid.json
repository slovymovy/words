                            {
                                "example_id": "a8636946-3f62-412e-95d5-330718190797",
                                "sense_id": "4b327ddf-3004-3157-a7bf-2a6c932a17f5",
                                "text": "De onwetendheid van zijn kameraden, de zwakheid en de nietswaardigheid van zijn tegenstanders, de openlijke leugenachtigheid en de schitterende, van zichzelf overtuigde beperktheid van deze man, zorgen ervoor dat hij aan het hoofd van het leger komt te staan."
                            },
                            {
                                "example_id": "ac91da16-2325-4a9f-bf39-15b0b49250c3",
                                "sense_id": "4b327ddf-3004-3157-a7bf-2a6c932a17f5",
                                "text": "Het tekent de grilligheid van de 19-jarige Amsterdammer. Het ene moment laat hij geniale dingen zien en maakt hij indruk met zijn sterkte en snelheid, het andere moment verliest hij de bal na een knulligheid en komt zijn technische beperktheid aan het licht."
                            }
                        ]
                    },
                    {
                        "sense_id": "649ae1e3-0b97-32fb-8975-defa499ffb86",
                        "entry_id": "f388aa2b-4137-3e32-b1a8-3c2feb92edda",
                        "glosses": [
                            "de zaken die men niet tot zijn beschikking heeft"
