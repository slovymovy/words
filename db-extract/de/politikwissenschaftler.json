                "senses": [
                    {
                        "sense_id": "5ab6d4c3-9785-3bc7-9cbf-860a4d705eb0",
                        "entry_id": "2a7f8d66-f552-3fa0-93d7-3fb8771e5d7d",
                        "glosses": [
                            "Wissenschaftler mit dem Forschungsschwerpunkt Politik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba7748e5-6fb8-4db8-81a5-3274e19e9b0d",
                                "sense_id": "5ab6d4c3-9785-3bc7-9cbf-860a4d705eb0",
                                "text": "„Ansprechpartner für die Forscher sind weltweit nicht nur Wissenschaftskollegen, sondern auch die Vertreter der politischen Praxis, ein Feld, auf dem die Potsdamer Politikwissenschaftler über umfangreiche Erfahrungen verfügen.“"
                            },
                            {
                                "example_id": "a8a09a3b-6b8d-4b7f-8b6e-1f48ed91b53b",
                                "sense_id": "5ab6d4c3-9785-3bc7-9cbf-860a4d705eb0",
                                "text": "„Für den Politikwissenschaftler Jonathan Moyo hatte Mugabe «keine eigenen politischen Werte».“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
