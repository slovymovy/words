                ],
                "senses": [
                    {
                        "sense_id": "64186147-994a-3ba4-b54e-02f069dd5b4a",
                        "entry_id": "017661d7-4cdd-3497-89da-c3e54e30d6a4",
                        "glosses": [
                            "Soldat envoyé en patrouille."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "14ad0428-1bc7-3f28-8bbb-8a07c3b86b87",
                        "entry_id": "017661d7-4cdd-3497-89da-c3e54e30d6a4",
                        "glosses": [
                            "Policier en patrouille."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fb338287-21f8-3cb3-8e9d-a22ab4fe6317",
                        "entry_id": "017661d7-4cdd-3497-89da-c3e54e30d6a4",
                        "glosses": [
                            "Petit bâtiment de guerre employé pour des reconnaissances, des surveillances."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "696d95a4-1be7-4c38-9dc3-32e8dd76941a",
                                "sense_id": "fb338287-21f8-3cb3-8e9d-a22ab4fe6317",
                                "text": "La France a dépêché un patrouilleur de haute mer, l’Enseigne de vaisseau Jacoubet, qui doit arriver cet après-midi pour participer aux recherches sous-marines de la carlingue, des corps et des débris."
                            }
                        ]
                    },
                    {
                        "sense_id": "521c59ed-3bd2-3c2a-9c35-e600af87b2aa",
                        "entry_id": "017661d7-4cdd-3497-89da-c3e54e30d6a4",
                        "glosses": [
                            "Employé d’une société autoroutière chargé d’inspecter un tronçon d’autoroute afin de vérifier qu’il n’y a pas de danger pour les usagers (accident, automobiliste en panne, détritus pouvant causer un accident…)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e66c2675-3b0a-434c-a341-895730aee694",
                                "sense_id": "521c59ed-3bd2-3c2a-9c35-e600af87b2aa",
                                "text": "Alors, sur ses réseaux sociaux, la société d’autoroutes multiplie les messages pour inciter à la prudence sur ses routes à l’approche d’un patrouilleur en intervention, notamment en respectant un “corridor de sécurité”."
                            },
                            {
                                "example_id": "b5b5ab1f-b61f-4168-b7b3-d5db81b4ad05",
                                "sense_id": "521c59ed-3bd2-3c2a-9c35-e600af87b2aa",
                                "text": "Comme sur l’A72 et une partie de l’A89, où les patrouilleurs de Vinci Autoroute basés au centre d’entretien de Feurs veillent au moindre détail."
                            },
                            {
                                "example_id": "0415966b-7699-459d-9a4c-910a18bbf06a",
                                "sense_id": "521c59ed-3bd2-3c2a-9c35-e600af87b2aa",
                                "text": "Il est à peine 7 h du matin lorsqu’un patrouilleur s’arrête sur la voie d’arrêt d’urgence entre les échangeurs de Saint-Maximin et de Trets en direction d’Aix-en-Provence. Il intervient accompagné d’un véhicule de gendarmerie pour protéger des véhicules accidentés. “Tous les dispositifs de signalisation lumineuse étaient activés”, assure Vinci dans un communiqué."
                            },
                            {
                                "example_id": "ea567567-53ce-4384-8479-fac685f09df0",
                                "sense_id": "521c59ed-3bd2-3c2a-9c35-e600af87b2aa",
                                "text": "l’une des 29 patrouilleuses en poste au Cannet-des-Maures, le centre ouest Provence-Alpes-Côte d’Azur du réseau Escota, géré par Vinci Autoroutes"
                            }
                        ]
                    },
                    {
                        "sense_id": "4a63a38d-d9ad-3772-8bf5-71787e9acf70",
                        "entry_id": "017661d7-4cdd-3497-89da-c3e54e30d6a4",
                        "glosses": [
                            "Personne qui consacre une partie de son temps à vérifier que les modifications effectuées sont acceptables, et qui les annule si elles ne le sont pas."
                        ],
                        "tags": [
                            "Wikis"
                        ],
                        "examples": [
                            {
                                "example_id": "69e373a5-46db-4fff-aa57-2be19fb0d85e",
                                "sense_id": "4a63a38d-d9ad-3772-8bf5-71787e9acf70",
                                "text": "Afin de juguler le vandalisme dès les premières modifications de pages, un corps de patrouilleurs (RC) formé de volontaires est chargé de détecter les ajouts malveillants."
                            }
                        ]
                    }
                ],
