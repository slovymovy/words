                "senses": [
                    {
                        "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                        "entry_id": "28c56b92-1c46-3fb9-b5df-c716889bab9d",
                        "glosses": [
                            "A lack of hope; despair."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "916591c0-80f4-44ab-9307-570819fe57cf",
                                "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                "text": "Depression can induce an overwhelming sense of sadness and hopelessness."
                            },
                            {
                                "example_id": "e00d7018-d676-462f-a2d1-f22175c7325b",
                                "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                "text": "The survey found increasing mental health challenges, experiences of violence, and suicidal thoughts and behavior among all teens. More than 40% of high school students said that feelings of sadness or hopelessness prevented them from engaging in their regular activities for at least two weeks of the year."
                            },
                            {
                                "example_id": "8fd428eb-b347-41ce-8035-7e92a998c5cd",
                                "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                "text": "On the app I’d ultimately go with, I presented myself truthfully, as a Republican-curious woman tired of the Democrats’ hopelessness and constant pivoting during a highly charged election year."
                            }
                        ]
                    }
                ],
