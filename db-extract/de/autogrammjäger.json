                                "sense_id": "bf06445b-ea85-3459-82a8-c805839e7661",
                                "text": "Die Autogrammjäger belagerten Udo Jürgens nach seinem Konzert."
                            },
                            {
                                "example_id": "96c01a09-bc48-4df2-8624-5846fda012e1",
                                "sense_id": "bf06445b-ea85-3459-82a8-c805839e7661",
                                "text": "„Natürlich sind auch die Autogrammjäger häufig die Zielscheibe des guten Witzes.“"
                            }
                        ],
