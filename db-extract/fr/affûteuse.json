                                "text": "Affûteuse à couteaux."
                            },
                            {
                                "example_id": "033787d3-282e-4b63-baa9-8e36d437f057",
                                "sense_id": "ff01d7a9-11e2-3d81-a8ee-47197668028f",
                                "text": "Affûteuse de broches."
                            },
                            {
                                "example_id": "2f707941-7feb-4e3c-bd2d-1e99bb939754",
                                "sense_id": "ff01d7a9-11e2-3d81-a8ee-47197668028f",
                                "text": "L’affûteuse électrique étant en panne, j’ai dû recourir à une bonne vieille meule pour aiguiser mes couteaux."
                            },
                            {
                                "example_id": "1f8b1e1c-9206-4a0f-9cb9-a13f3278fbd7",
                                "sense_id": "ff01d7a9-11e2-3d81-a8ee-47197668028f",
                                "text": "Martin se dirige vers une affûteuse rivée à l’établi et la met en marche."
                            }
                        ]
                    }
                ],
