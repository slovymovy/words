        "nl-extract.jsonl": [
            {
                "entry_id": "ff1090b6-e057-337b-87c6-80eff5261343",
                "word": "dringend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d108e2e-c599-3f9f-85cd-70fccf797c23",
                        "entry_id": "ff1090b6-e057-337b-87c6-80eff5261343",
                        "glosses": [
                            "geen uitstel duldend want heel belangrijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96b0f3c1-777d-40e1-9f56-b940064ae436",
                                "sense_id": "5d108e2e-c599-3f9f-85cd-70fccf797c23",
                                "text": "„Het konvooi heeft noodhulp gebracht naar 60.000 mensen die dringend behoefte hebben aan voedsel en medicijnen, en die al vijf maanden verstoken waren van humanitaire hulp”, zei Jakob Kern, de directeur van het WFP in Syrië."
                            },
                            {
                                "example_id": "8b769344-cc64-4ecc-b0f1-6258b6d6989b",
                                "sense_id": "5d108e2e-c599-3f9f-85cd-70fccf797c23",
                                "text": "Ik moet dringend koffie."
                            },
                            {
                                "example_id": "dc9f151c-5eb5-4fd1-b0fc-f812fe06f0cf",
                                "sense_id": "5d108e2e-c599-3f9f-85cd-70fccf797c23",
                                "text": "Ze liet zich informeren over wat zich in en rond het dorp had afgespeeld en over de opruimwerkzaamheden en het dringend nodige dijkherstel."
                            }
                        ]
                    },
                    {
                        "sense_id": "11917d64-43c4-3fd5-ad69-797483b1835e",
                        "entry_id": "ff1090b6-e057-337b-87c6-80eff5261343",
                        "glosses": [
                            "met grote nadruk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2586145d-9ebb-4957-b292-23278d6a7c70",
                                "sense_id": "11917d64-43c4-3fd5-ad69-797483b1835e",
                                "text": "Dinsdag maakte de vereniging via haar eigen website zelf ook melding van een ander incident, dat gisteren plaats heeft gevonden. Een lid van Vindicat zou daarbij met een luchtbuks op op een Vindicat-huis hebben geschoten. Het bestuur heeft de betrokkenen naar eigen zeggen dringend geadviseerd hiervan aangifte te doen bij de politie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45f0f8d4-8327-4db9-9eef-f586c1457642",
                        "source_entry_id": "ff1090b6-e057-337b-87c6-80eff5261343",
                        "target_lang_word": "urgent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urgent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f34de082-e798-3e9f-8a73-a44be3db77a7",
                                        "entry_id": "abcc9cfd-82aa-38e5-9798-54bb2dcf9840",
                                        "glosses": [
                                            "Requiring immediate attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f2fd34-a52d-4842-ac7a-a18d697829cb",
                                                "sense_id": "f34de082-e798-3e9f-8a73-a44be3db77a7",
                                                "text": "An urgent appeal was sent out for assistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f43653a4-ec5e-3c52-a6b7-3e6cf351536b",
                                        "entry_id": "abcc9cfd-82aa-38e5-9798-54bb2dcf9840",
                                        "glosses": [
                                            "Of people: insistent, solicitous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bbbba72-4a30-475f-a460-1b9c467675db",
                                                "sense_id": "f43653a4-ec5e-3c52-a6b7-3e6cf351536b",
                                                "text": "The Egyptians were vrgent vpon the people that they might send them out of the land in haste."
                                            },
                                            {
                                                "example_id": "6defaee7-3f82-4968-92d2-fb4e1723a288",
                                                "sense_id": "f43653a4-ec5e-3c52-a6b7-3e6cf351536b",
                                                "text": "My kind friends here are most affectionately urgent with me to prolong my stay […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef0df91f-2cdc-47e6-a72a-8175db5481f4",
                        "source_entry_id": "ff1090b6-e057-337b-87c6-80eff5261343",
                        "target_lang_word": "urgent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urgent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "beaa8702-f11a-3f7e-ac06-94a346c8de6b",
                                        "entry_id": "ed53d443-4d76-3c6c-8d61-25f5571e7eaa",
                                        "glosses": [
                                            "Qui est pressant, qui ne souffre aucun retard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2314f0b-aaf3-43f7-98f2-296fe1d15c1b",
                                                "sense_id": "beaa8702-f11a-3f7e-ac06-94a346c8de6b",
                                                "text": "Le coulage consiste à faire faire des travaux qui ne sont pas urgents ou nécessaires, à dégalonner et regalonner les troupes, à commander des vaisseaux sans s’inquiéter s’il y a du bois et de payer alors le bois trop cher, à se préparer à la guerre sans la faire, à payer les dettes d’un État sans lui en demander le remboursement ou des garanties, etc."
                                            },
                                            {
                                                "example_id": "57140d26-84dd-4032-88ea-0bd3724b1fc1",
                                                "sense_id": "beaa8702-f11a-3f7e-ac06-94a346c8de6b",
                                                "text": "Dans ce contexte, il n'est pas étonnant de constater que quatre Français sur cinq (80 %, +4 points depuis octobre) estiment désormais « qu'il est urgent de réduire la dette publique en France »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
