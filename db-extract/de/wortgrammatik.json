                "senses": [
                    {
                        "sense_id": "d387d282-9efb-30ed-a99d-ce8dab9a89d4",
                        "entry_id": "5bdbeda7-4a56-34e7-aaf1-1e32dde607f2",
                        "glosses": [
                            "Gesamtheit der grammatischen Regeln, die innerhalb der Wortgrenzen wirken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e82ef365-f903-447f-9cc4-8483a64d6155",
                                "sense_id": "d387d282-9efb-30ed-a99d-ce8dab9a89d4",
                                "text": "Eine Wortgrammatik beschreibt die einzelnen Wortklassen nach ihrer Funktion, ihren Formen und ihrer Bedeutung."
                            },
                            {
                                "example_id": "e952a6fd-43c4-408d-b868-baa44657524d",
                                "sense_id": "d387d282-9efb-30ed-a99d-ce8dab9a89d4",
                                "text": "„Bei der Wortgrammatik im engeren Sinn (Phonologie, Graphematik, Morphologie) ist die Übereinstimmung beziehungsweise Nichtübereinstimmung eines Wortes mit den Strukturen des Kernwortschatzes zu erfassen.“"
                            },
                            {
                                "example_id": "6b0bab38-296e-414c-b422-48703aef9ec4",
                                "sense_id": "d387d282-9efb-30ed-a99d-ce8dab9a89d4",
                                "text": "„Die Morphologie wird auch als „Wortgrammatik“ in Anlehnung an den Terminus „Satzgrammatik“ für die Syntax bezeichnet.“"
                            },
                            {
                                "example_id": "9616b90f-0384-40df-8488-088d7cbc32cd",
                                "sense_id": "d387d282-9efb-30ed-a99d-ce8dab9a89d4",
                                "text": "„Die Wortgrammatik handelt in der Lektürephase ebenso wie in der Lehrbuchphase vor allem von den Formen der Verben und Nomina.“"
                            },
                            {
                                "example_id": "fdf24e14-9bda-425f-853c-cdb01e9e7536",
                                "sense_id": "d387d282-9efb-30ed-a99d-ce8dab9a89d4",
                                "text": "„Eine einfache Wortgrammatik ist eine Grammatik, deren Ableitungsstruktur einem binären Baum entspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
