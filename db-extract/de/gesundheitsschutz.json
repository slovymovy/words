                ],
                "senses": [
                    {
                        "sense_id": "47166b7d-1c58-3d7e-8205-5260c2278c81",
                        "entry_id": "a26da18c-34fa-3d7d-bc5a-af4d15449245",
                        "glosses": [
                            "Summe der Maßnahmen und Regeln, die eine Person/Personen vor Schaden an Leib und Seele bewahren sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e0bc934-cf1d-4b4a-a58e-cea01c7e8f59",
                                "sense_id": "47166b7d-1c58-3d7e-8205-5260c2278c81",
                                "text": "„Mit aller gebotenen Zurückhaltung sehen wir die Aussage als berechtigt an, daß die Bindung an einen Arzt des Vertrauens die Voraussetzung für den vorbeugenden Gesundheitsschutz verbessert.“"
                            },
                            {
                                "example_id": "22a6f97a-6ce5-428c-8efb-504a056eed26",
                                "sense_id": "47166b7d-1c58-3d7e-8205-5260c2278c81",
                                "text": "„Die §§ 87–90 stellen dabei wichtige Grundlagen der Tätigkeit des Betriebsrats dar, wenn es um die Belange der betrieblichen Arbeitssicherheit und des Gesundheitsschutzes geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46c67117-211d-48a8-8c6f-219108583f9c",
                        "source_entry_id": "a26da18c-34fa-3d7d-bc5a-af4d15449245",
                        "source_sense_id": "47166b7d-1c58-3d7e-8205-5260c2278c81",
