                "senses": [
                    {
                        "sense_id": "7fa4d024-5fa2-3458-9aa6-8cd06266ec74",
                        "entry_id": "f45f8445-2e9e-3a6c-9136-410c20bf128c",
                        "glosses": [
                            "Someone who dosses, someone known for avoiding work."
                        ],
                        "tags": [
                            "British",
                            "Ireland"
                        ],
                        "examples": [
                            {
                                "example_id": "6e1f2929-0385-4f9e-bf2d-60ce64cf8ccc",
                                "sense_id": "7fa4d024-5fa2-3458-9aa6-8cd06266ec74",
                                "text": "Illustrating the strength of feeling, some said Dorries was “never here and is as useful as a chocolate teapot”, while “Dosser Dorries” posters appeared in the area."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c640223-9e0f-3f93-af61-a5537d697478",
                        "entry_id": "f45f8445-2e9e-3a6c-9136-410c20bf128c",
                        "glosses": [
                            "A homeless and jobless person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e756e53e-c16c-44f6-a663-1ebd3610a7e1",
                                "sense_id": "7c640223-9e0f-3f93-af61-a5537d697478",
                                "text": "Formerly they endeavoured to occupy all the seats, but the lynx-eyed Metropolitan Police declined to allow any such proceedings, and the dossers, knowing the invariable kindness of the City Police, made tracks for that portion of the Embankment which, lying east of the Temple, comes under the control of the Civic Fathers."
                            }
                        ]
                    },
                    {
                        "sense_id": "8aac465e-1c29-3c5a-a2fd-7acec6041723",
                        "entry_id": "f45f8445-2e9e-3a6c-9136-410c20bf128c",
                        "glosses": [
                            "One who lodges in a doss-house."
                        ],
                        "tags": [],
                        "examples": []
                    }
