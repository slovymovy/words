                "word": "maandagochtend",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d5b04fc9-5631-3a89-940e-b81505aa9fcc",
                        "entry_id": "99150d58-a854-3876-9aea-ad96fa79f7bc",
                        "glosses": [
                            "in de ochtend van de maandag"
                        ],
                        "tags": [
                            "tijdrekening"
                        ],
                        "examples": [
                            {
                                "example_id": "2e813c29-4eb5-4330-80c6-4331ba2d6305",
                                "sense_id": "d5b04fc9-5631-3a89-940e-b81505aa9fcc",
                                "text": "Kun je maandagochtend ook komen?"
                            },
                            {
                                "example_id": "fc26be3d-7c56-4f27-b93e-2defb6f4b73f",
                                "sense_id": "d5b04fc9-5631-3a89-940e-b81505aa9fcc",
                                "text": "Bij de supermarkt aan de Iepenlaan in Woerden heeft de politie maandagochtend een 17-jarige jongen uit Litouwen aangehouden op verdenking van diefstal van boodschappen met een winkelwaarde van € 57,-. De dief wilde die morgen rond tien uur een winkelwagen vol boodschappen zonder te betalen de winkel uitloodsen."
                            },
                            {
                                "example_id": "a30c8fbf-03ec-48cb-b741-faf2a13d42df",
                                "sense_id": "d5b04fc9-5631-3a89-940e-b81505aa9fcc",
                                "text": "Maar na een week in de woestijn en 5.000 dollar lichter, zit je vaak gewoon weer op maandagochtend op kantoor in een vergadering over targets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e580bd2c-97b5-478d-a56a-f84cee661eff",
                        "source_entry_id": "99150d58-a854-3876-9aea-ad96fa79f7bc",
                        "source_sense_id": "d5b04fc9-5631-3a89-940e-b81505aa9fcc",
                        "source_sense_description": "de voormiddag van een maandag",
                        "target_lang_word": "Montagmorgen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Montagmorgen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63bfb7e7-5023-35d3-9118-ad531b271415",
                                        "entry_id": "8d3b5567-3335-3bb2-a9fe-662e0f375a1c",
                                        "glosses": [
                                            "der Morgen eines Montages"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8085c3bc-888c-4e79-bc27-1ab953c613bf",
                                                "sense_id": "63bfb7e7-5023-35d3-9118-ad531b271415",
                                                "text": "„Am Montagmorgen wurde sie Herrn Castrup vorgestellt.“"
                                            },
                                            {
                                                "example_id": "ee59a70c-d14b-4713-85d2-cf2c6dbd77aa",
                                                "sense_id": "63bfb7e7-5023-35d3-9118-ad531b271415",
                                                "text": "An allen Montagmorgen dieses Monats werden wir ein dreistündiges Treffen abhalten."
                                            },
                                            {
                                                "example_id": "3522f6db-16b5-4558-9210-5e1943571396",
                                                "sense_id": "63bfb7e7-5023-35d3-9118-ad531b271415",
                                                "text": "Der Montagmorgen ist für viele Menschen der schlimmste Morgen der Woche."
                                            },
                                            {
                                                "example_id": "a38d1c17-f782-412c-8c74-d4b209a0d496",
                                                "sense_id": "63bfb7e7-5023-35d3-9118-ad531b271415",
                                                "text": "Bei Eisglätte kam es am Montagmorgen zu zahlreichen Unfällen mit Blechschäden."
                                            },
                                            {
                                                "example_id": "9a4b0c13-96f5-44a5-b7a2-6f17270d6321",
                                                "sense_id": "63bfb7e7-5023-35d3-9118-ad531b271415",
                                                "text": "„Es ist ein früher Montagmorgen im europäischen Sommer.“"
                                            },
                                            {
                                                "example_id": "2bb0f53a-9e9e-42ef-a804-d5f92298f272",
                                                "sense_id": "63bfb7e7-5023-35d3-9118-ad531b271415",
                                                "text": "„Es war ein frostiger Montagmorgen im November.“"
                                            },
                                            {
                                                "example_id": "a1e5d8c7-0ec0-4f04-94fe-ef91409740ef",
                                                "sense_id": "63bfb7e7-5023-35d3-9118-ad531b271415",
                                                "text": "„Am Montagmorgen also traf ich P. C., und er bestätigte mir das Zusammentreffen für die gleiche Zeit und den gleichen Ort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fee41aae-0f40-4107-96f8-3f3a434271f5",
                        "source_entry_id": "99150d58-a854-3876-9aea-ad96fa79f7bc",
                        "source_sense_id": "d5b04fc9-5631-3a89-940e-b81505aa9fcc",
