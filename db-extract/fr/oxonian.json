                                "sense_id": "e6e7bb91-98bf-311f-9f5e-cd1741ab5786",
                                "text": "Ma parole, vous vous exprimez comme un Oxonian !"
                            },
                            {
                                "example_id": "0cd3330d-a4db-434d-8444-a86a7ab2d840",
                                "sense_id": "e6e7bb91-98bf-311f-9f5e-cd1741ab5786",
                                "text": "De l’autre côté de College-Green, c’est l’Université, désignée sous le nom de Trinity-College - « la sœur silencieuse », comme la surnomment ironiquement les Oxonians et les Cantabs."
                            },
                            {
                                "example_id": "d299a183-0576-40bd-86d1-c0326ebde91f",
                                "sense_id": "e6e7bb91-98bf-311f-9f5e-cd1741ab5786",
                                "text": "Les Oxonians se lèvent alors et entonnent l’air traditionnel."
                            }
                        ]
