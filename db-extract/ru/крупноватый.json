                "senses": [
                    {
                        "sense_id": "1b8b00ab-8a9b-3c6f-ad9d-68a2e6e2a3fd",
                        "entry_id": "78ab2720-9e77-38a3-9892-0f5e539eba58",
                        "glosses": [
                            "разг. довольно крупный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e18490-617f-4bb9-a447-c110c271705f",
                                "sense_id": "1b8b00ab-8a9b-3c6f-ad9d-68a2e6e2a3fd",
                                "text": "Сила властная, притягательная ― в ее крупноватой неполной фигуре."
                            }
                        ]
                    },
                    {
                        "sense_id": "512712a0-6d87-3fcf-b672-04cf49e611ce",
                        "entry_id": "78ab2720-9e77-38a3-9892-0f5e539eba58",
                        "glosses": [
                            "разг. несколько более крупный, чем следует, чем нужно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32e6a31-5497-4305-ae55-9483e900b415",
                                "sense_id": "512712a0-6d87-3fcf-b672-04cf49e611ce",
                                "text": "Для его среднего роста и худощавой комплекции голова была, пожалуй, крупновата, зато, доведись кому-либо хоть и Пачкалиной, опознавать Горового, пускай даже по самой плохой фотографии, это не вызвало бы затруднений."
                            }
                        ]
                    }
