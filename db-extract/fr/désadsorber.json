                "senses": [
                    {
                        "sense_id": "2b61b988-0989-3140-89e0-9ef96461d4e8",
                        "entry_id": "51cc2994-7419-3708-ba39-966f26dbdeb6",
                        "glosses": [
                            "Restituer (ce qui avait été adsorbé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9185743b-ce6b-4e1c-9798-3c77d927cdc6",
                                "sense_id": "2b61b988-0989-3140-89e0-9ef96461d4e8",
                                "text": "Cela permet de désadsorber rapidement toutes les espèces organiques de la couche externe du capillaire et d’obtenir un chromatogramme normal."
                            },
                            {
                                "example_id": "23ac8378-2edf-41e5-bc01-5ef57bfa5a70",
                                "sense_id": "2b61b988-0989-3140-89e0-9ef96461d4e8",
                                "text": "Un petit volume de l’échantillon gazeux à analyser est introduit au moyen d’un « gaz porteur » dans une colonne remplie d’une phase adsorbante stationnaire, capable de restituer (c’est-à-dire désadsorber) séparément les différents constituants, suivant un ordre caractéristique immuable dans le temps."
                            }
                        ]
                    }
                ],
