{
    "word_family": [
        "implicate",
        "implicit",
        "implicitly",
        "implicational"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "345de53a-84f7-3d43-a34b-f0ef7e5c3827",
                    "sense_definition": "A possible effect or result of a decision or action.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dumping waste in the river will have serious <w>implications</w> for the environment.",
                            "target_lang_translations": {
                                "ru": "Сброс отходов в реку будет иметь серьезные <w>последствия</w> для окружающей среды.",
                                "tr": "Nehre atık boşaltmanın çevre üzerinde ciddi <w>sonuçları</w> olacaktır."
                            }
                        },
                        {
                            "text": "The manager needs to consider the long-term <w>implications</w> of this new policy.",
                            "target_lang_translations": {
                                "ru": "Менеджеру необходимо учитывать долгосрочные <w>последствия</w> этой новой политики.",
                                "tr": "Yöneticinin bu yeni politikanın uzun vadeli <w>etkilerini</w> değerlendirmesi gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "consequence",
                        "aftermath",
                        "ramification"
                    ],
                    "common_phrases": [
                        "long-term implications",
                        "serious implications",
                        "legal implications"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможный эффект или результат решения или действия.",
                        "tr": "Bir kararın veya eylemin olası etkisi veya sonucu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последствие",
                                "target_lang_sense_clarification": "результат действия"
                            },
                            {
                                "target_lang_word": "значение",
                                "target_lang_sense_clarification": "важность для будущего"
                            },
                            {
                                "target_lang_word": "влияние",
                                "target_lang_sense_clarification": "воздействие на что-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sonuç",
                                "target_lang_sense_clarification": "bir eylemin ortaya çıkardığı durum"
                            },
                            {
                                "target_lang_word": "etki",
                                "target_lang_sense_clarification": "bir durumun başka bir şey üzerindeki gücü"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e291a48-5341-3103-96c3-7f24936e0a4d",
                    "sense_definition": "Something that is suggested or understood without being stated directly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>implication</w> of his statement was that we were to blame for the error.",
                            "target_lang_translations": {
                                "ru": "<w>Подтекст</w> его заявления заключался в том, что в ошибке виноваты мы.",
                                "tr": "Söylediklerinin <w>iması</w>, hatadan bizim sorumlu olduğumuzdu."
                            }
                        },
                        {
                            "text": "She was offended by the <w>implication</w> that she had not been working hard enough.",
                            "target_lang_translations": {
                                "ru": "Ее оскорбил <w>намёк</w> на то, что она работала недостаточно усердно.",
                                "tr": "Yeterince sıkı çalışmadığına dair yapılan <w>ima</w> onu kırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "inference",
                        "suggestion",
                        "innuendo",
                        "undertone"
                    ],
                    "antonyms": [
                        "explication"
                    ],
                    "common_phrases": [
                        "by implication",
                        "clear implication"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что предлагается или понимается без прямого высказывания; подтекст.",
                        "tr": "Doğrudan ifade edilmeden önerilen veya anlaşılan şey; alt metin."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намёк",
                                "target_lang_sense_clarification": "косвенное указание"
                            },
                            {
                                "target_lang_word": "подтекст",
                                "target_lang_sense_clarification": "скрытый смысл"
                            },
                            {
                                "target_lang_word": "подразумевание",
                                "target_lang_sense_clarification": "неявное утверждение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ima",
                                "target_lang_sense_clarification": "dolaylı olarak anlatma veya işaret etme"
                            },
                            {
                                "target_lang_word": "dolaylı anlatım",
                                "target_lang_sense_clarification": "açıkça söylenmeyen ifade biçimi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f40aa216-a141-3232-abfe-499fa216e512",
                    "sense_definition": "The act of showing that someone is involved in a crime or a dishonest act; the state of being <w>implicated</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "involvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>implication</w> of the senator in the scandal led to his immediate resignation.",
                            "target_lang_translations": {
                                "ru": "<w>Причастность</w> сенатора к скандалу привела к его немедленной отставке.",
                                "tr": "Senatörün skandala <w>karışması</w> onun derhal istifa etmesine yol açtı."
                            }
                        },
                        {
                            "text": "New evidence emerged regarding his <w>implication</w> in the robbery.",
                            "target_lang_translations": {
                                "ru": "Появились новые улики относительно его <w>соучастия</w> в ограблении.",
                                "tr": "Soyguna <w>karıştığına</w> dair yeni kanıtlar ortaya çıktı."
                            }
                        }
                    ],
                    "synonyms": [
                        "involvement",
                        "incrimination"
                    ],
                    "antonyms": [
                        "exoneration"
                    ],
                    "common_phrases": [
                        "implication in a crime"
                    ],
                    "target_lang_definitions": {
                        "ru": "Факт того, что кто-то замешан в преступлении или нечестном поступке.",
                        "tr": "Birinin bir suça veya dürüst olmayan bir işe karıştığını gösterme durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причастность",
                                "target_lang_sense_clarification": "вовлеченность в дело"
                            },
                            {
                                "target_lang_word": "соучастие",
                                "target_lang_sense_clarification": "совместное участие в преступлении"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karışma",
                                "target_lang_sense_clarification": "bir olaya dahil olma durumu"
                            },
                            {
                                "target_lang_word": "suç ortaklığı",
                                "target_lang_sense_clarification": "bir suça dahil olma durumu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "831797b3-415b-31ca-a8f7-3006d3a4218a",
                    "sense_definition": "A relationship between two statements such that if the first is true, the second must also be true.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In formal logic, the material <w>implication</w> is often represented by an arrow symbol.",
                            "target_lang_translations": {
                                "ru": "В формальной логике материальная <w>импликация</w> часто обозначается символом стрелки.",
                                "tr": "Biçimsel mantıkta, koşullu <w>gerektirme</w> genellikle ok sembolü ile gösterilir."
                            }
                        },
                        {
                            "text": "The student struggled to understand the logical <w>implication</w> between the two premises.",
                            "target_lang_translations": {
                                "ru": "Студенту было трудно понять логическое <w>следствие</w> между двумя предпосылками.",
                                "tr": "Öğrenci, iki önerme arasındaki mantıksal <w>çıkarımı</w> anlamakta zorlandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "logical consequence",
                        "entailment"
                    ],
                    "common_phrases": [
                        "logical implication",
                        "material implication"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in logic and mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Логическая связь между двумя утверждениями, при которой из истинности первого следует истинность второго.",
                        "tr": "İki önerme arasındaki, birincisinin doğru olması durumunda ikincisinin de doğru olması gereken mantıksal ilişki."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "импликация",
                                "target_lang_sense_clarification": "логическое следование"
                            },
                            {
                                "target_lang_word": "логическое следствие",
                                "target_lang_sense_clarification": "вывод из посылок"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gerektirme",
                                "target_lang_sense_clarification": "mantıksal zorunluluk"
                            },
                            {
                                "target_lang_word": "çıkarım",
                                "target_lang_sense_clarification": "mantıksal sonuç çıkarma"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}