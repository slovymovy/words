                                "target_senses": [
                                    {
                                        "sense_id": "682601b0-e4bd-3dc1-8a03-3d7a766de0b9",
                                        "entry_id": "8941cb54-9335-3732-8543-e9834cefc166",
                                        "glosses": [
                                            "A person who owns, plays or practices with the saxophone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f55a383c-bb6d-4337-8e64-c33bf08d4ec4",
                                                "sense_id": "682601b0-e4bd-3dc1-8a03-3d7a766de0b9",
                                                "text": "They enjoyed music from a live saxophonist during the journey before visiting Braintree Town Hall for refreshments and Christmas cake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95a8767d-4d62-49cb-8bfc-90cc51036f65",
                        "source_entry_id": "3c5e37a2-1dca-3795-9053-e63f43634be4",
                        "source_sense_id": "7db0530c-e189-391a-bb73-e146206daf17",
                        "target_lang_word": "saxophoniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saxophoniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "158d17fb-99f2-3933-9209-47e03ab1d5a3",
                                        "entry_id": "08260e32-ba85-3844-8272-a17c66c43957",
                                        "glosses": [
                                            "Celui, celle qui fait profession de jouer du saxophone, ou qui, n’étant qu’amateur, en joue avec plus ou moins de talent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15f133c2-5723-4988-9b7a-62a49b5b59c6",
                                                "sense_id": "158d17fb-99f2-3933-9209-47e03ab1d5a3",
                                                "text": "Le saxophoniste britannique Andy Sheppard, s’inspirant du théâtre et de la musique indienne, poursuit son exploration des genres et des arts à Coutances (Manche) avec le festival Jazz sous les Pommiers, qui s’achève ce week-end."
                                            },
                                            {
                                                "example_id": "25d1295a-925b-4096-b836-fa5f142fac41",
                                                "sense_id": "158d17fb-99f2-3933-9209-47e03ab1d5a3",
                                                "text": "Swing traditionnel, boogie-woogie, blues… les sonorités et les prestations seront variées avec le showman Lluís Coloma, le saxophoniste David Sauzay ou encore le trompettiste Michel Bonnet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aabce500-5988-4d82-9577-2040c2210a9c",
                        "source_entry_id": "3c5e37a2-1dca-3795-9053-e63f43634be4",
