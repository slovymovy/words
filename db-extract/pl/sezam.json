                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sésame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a34ba1fb-01cc-3ee0-a708-6ba598ea0234",
                                        "entry_id": "42395e9b-7321-3ec0-8e0b-e97fdcef4e6d",
                                        "glosses": [
                                            "Plante à fleurs blanches et ponctuées de pourpre, dont les graines, un peu plus grosses que celles du millet, sont alimentaires et fournissent de l’huile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0482191-60d4-4ab7-9823-d02c3037dfab",
                                                "sense_id": "a34ba1fb-01cc-3ee0-a708-6ba598ea0234",
                                                "text": "La farine de graine de sésame sert à faire de la bouillie, des galettes, etc."
                                            },
                                            {
                                                "example_id": "4843b402-34cc-4a5b-96eb-0fdc93bd26ed",
                                                "sense_id": "a34ba1fb-01cc-3ee0-a708-6ba598ea0234",
                                                "text": "Huile de sésame. — Le sésame est de la même famille botanique que la bignone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd7e0f7b-73f5-3655-afc7-7f2b627bef3f",
                                        "entry_id": "42395e9b-7321-3ec0-8e0b-e97fdcef4e6d",
                                        "glosses": [
                                            "Graine de cette plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75fdcf3c-e76a-438a-ad36-eb6eea617638",
                                                "sense_id": "dd7e0f7b-73f5-3655-afc7-7f2b627bef3f",
                                                "text": "En revanche, on en prend, de la graine, et à gogo : lin, chia, chanvre, pavot, sésame, tournesol, courge, sarrasin, fenouil ! Et des baies, d’açaï, de goji ! Et des poudres, guarana, curcuma, thé matcha !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sésame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c158a0c-27ea-3e55-b437-91717530525b",
                                        "entry_id": "64a5d232-512b-3b6a-9cfb-66f93dcbd8e9",
                                        "glosses": [
                                            "Recommandation, indication, pour franchir une étape cruciale, pour traverser une épreuve, ou triompher des obstacles, des difficultés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d431b073-14e7-4499-89a5-d3c66c79a7f6",
                                                "sense_id": "7c158a0c-27ea-3e55-b437-91717530525b",
                                                "text": "Cette école est le sésame vers la réussite."
                                            },
                                            {
                                                "example_id": "ecfb3eb8-dfec-4d6e-8bf1-3ce0e58cd6f0",
                                                "sense_id": "7c158a0c-27ea-3e55-b437-91717530525b",
                                                "text": "Classes préparatoires : l’indispensable sésame pour les grandes écoles !"
                                            },
                                            {
                                                "example_id": "2cc6b9cb-fa85-4c8a-ac29-fc3fd35a5f03",
                                                "sense_id": "7c158a0c-27ea-3e55-b437-91717530525b",
                                                "text": "Avoir un animal reproducteur n’est pas suffisant. Seule la détention de la femelle peut donner le sésame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
