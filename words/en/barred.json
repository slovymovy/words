{
    "word_family": [
        "bar",
        "barrier",
        "barricade",
        "barring",
        "bartender",
        "barman"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3d9e34f-f046-32b8-ad96-0518c6fac3f8",
                    "sense_definition": "Simple past and past participle of <w>bar</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_block",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard <barred> the entrance to the private club.",
                            "target_lang_translations": {
                                "ru": "Охранник <преградил> вход в частный клуб.",
                                "pl": "Ochroniarz <zagrodził> wejście do prywatnego klubu.",
                                "zh": "保安<阻挡>了私人俱乐部的入口。"
                            }
                        },
                        {
                            "text": "A fallen tree <barred> the road, forcing us to turn back.",
                            "target_lang_translations": {
                                "ru": "Упавшее дерево <перегородило> дорогу, заставив нас повернуть назад.",
                                "pl": "Powalone drzewo <zatarasowało> drogę, zmuszając nas do zawrócenia.",
                                "zh": "一棵倒下的树<封锁>了道路，迫使我们折返。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "barred the way",
                        "barred the door",
                        "barred access"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола <w>bar</w> (преграждать, запирать).",
                        "pl": "Forma czasu przeszłego i imiesłów czasu przeszłego od czasownika 'bar' (blokować, zagradzać, zamykać).",
                        "zh": "动词 bar 的过去式和过去分词，意为阻挡、封锁或禁止进入。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преградил",
                                "target_lang_sense_clarification": "заблокировал путь или вход"
                            },
                            {
                                "target_lang_word": "перегородил",
                                "target_lang_sense_clarification": "создал препятствие поперек чего-либо"
                            },
                            {
                                "target_lang_word": "запер",
                                "target_lang_sense_clarification": "закрыл на засов или заблокировал дверь"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zagrodził",
                                "target_lang_sense_clarification": "zablokował przejście lub dostęp"
                            },
                            {
                                "target_lang_word": "zatarasował",
                                "target_lang_sense_clarification": "utworzył przeszkodę w poprzek drogi"
                            },
                            {
                                "target_lang_word": "zamknął",
                                "target_lang_sense_clarification": "zablokował dostęp do pomieszczenia"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阻挡",
                                "target_lang_sense_clarification": "挡住去路或入口"
                            },
                            {
                                "target_lang_word": "封锁",
                                "target_lang_sense_clarification": "封闭通道或区域"
                            },
                            {
                                "target_lang_word": "关上",
                                "target_lang_sense_clarification": "将门窗锁住或挡住"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14d2e9a3-6bb4-3b43-9c39-8fd275c8df94",
                    "sense_definition": "Simple past and past participle of <w>barr</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the ancient manuscript, it was written that they <barred> the gates at dusk.",
                            "target_lang_translations": {
                                "ru": "В древней рукописи было написано, что они <запирали> ворота на закате.",
                                "pl": "W starożytnym manuskrypcie napisano, że <zamykali> bramy o zmierzchu.",
                                "zh": "古籍中记载，他们在黄昏时分<关闭>了城门。"
                            }
                        },
                        {
                            "text": "The merchant <barred> the goods from being sold in the market.",
                            "target_lang_translations": {
                                "ru": "Торговец <не допустил> товары к продаже на рынке.",
                                "pl": "Kupiec <zablokował> możliwość sprzedaży towarów na targu.",
                                "zh": "商人<禁止>这些商品在市场上出售。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "obsolete spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола <w>barr</w> (устаревшее написание).",
                        "pl": "Forma czasu przeszłego i imiesłów czasu przeszłego od przestarzałej pisowni czasownika 'barr'.",
                        "zh": "动词 barr 的过去式和过去分词（古旧拼写）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запирал",
                                "target_lang_sense_clarification": "устаревшая или книжная форма действия"
                            },
                            {
                                "target_lang_word": "преграждал",
                                "target_lang_sense_clarification": "блокировал доступ (в историческом контексте)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zamykał",
                                "target_lang_sense_clarification": "forma archaiczna lub literacka"
                            },
                            {
                                "target_lang_word": "zagradzał",
                                "target_lang_sense_clarification": "blokowanie dostępu w kontekście historycznym"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关闭",
                                "target_lang_sense_clarification": "古语或书面语中指锁闭门窗"
                            },
                            {
                                "target_lang_word": "阻隔",
                                "target_lang_sense_clarification": "历史语境下指阻挡进入"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fc7238c1-23aa-30f3-90da-dbf5d7237fe4",
                    "sense_definition": "Not allowed to do something or go somewhere; officially prohibited.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_block",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <barred> from practicing law due to his past misconduct.",
                            "target_lang_translations": {
                                "ru": "Он <отстранён> от юридической практики из-за проступков в прошлом.",
                                "pl": "Jest <odsunięty> od praktyki prawniczej z powodu swoich dawnych przewinień.",
                                "zh": "由于过去的违规行为，他被<禁止>从事法律工作。"
                            }
                        },
                        {
                            "text": "Players found guilty of doping are <barred> from the competition for two years.",
                            "target_lang_translations": {
                                "ru": "Игроки, уличенные в допинге, <отстраняются> от соревнований на два года.",
                                "pl": "Zawodnicy uznani za winnych dopingu są <wykluczeni> z zawodów na dwa lata.",
                                "zh": "被查出服用兴奋剂的运动员将被<禁止>参加比赛两年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "banned",
                        "prohibited",
                        "forbidden",
                        "excluded"
                    ],
                    "common_phrases": [
                        "barred from entering",
                        "barred from holding office",
                        "permanently barred"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально не допущенный к чему-либо или запрещённый.",
                        "pl": "Oficjalnie niedopuszczony do czegoś lub objęty zakazem.",
                        "zh": "形容词，指被官方禁止做某事或进入某地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстранённый",
                                "target_lang_sense_clarification": "временно или постоянно лишенный права участвовать"
                            },
                            {
                                "target_lang_word": "лишённый права",
                                "target_lang_sense_clarification": "юридически не имеющий разрешения"
                            },
                            {
                                "target_lang_word": "запрещённый",
                                "target_lang_sense_clarification": "не разрешенный к использованию или посещению"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odsunięty",
                                "target_lang_sense_clarification": "pozbawiony prawa do uczestnictwa"
                            },
                            {
                                "target_lang_word": "wykluczony",
                                "target_lang_sense_clarification": "usunięty z grupy lub możliwości działania"
                            },
                            {
                                "target_lang_word": "objęty zakazem",
                                "target_lang_sense_clarification": "posiadający formalny zakaz wstępu lub aktywności"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被禁止",
                                "target_lang_sense_clarification": "受到官方限制或禁止"
                            },
                            {
                                "target_lang_word": "被剥夺",
                                "target_lang_sense_clarification": "失去参与某项活动的权利"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a3478fb-6797-3d5c-8f22-bcdb780fa7c6",
                    "sense_definition": "Marked with stripes or bands; secured or covered with metal bars.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_bars",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner stared out through the <barred> window of his small cell.",
                            "target_lang_translations": {
                                "ru": "Заключенный смотрел через <зарешёченное> окно своей маленькой камеры.",
                                "pl": "Więzień patrzył przez <zakratowane> okno swojej małej celi.",
                                "zh": "囚犯透过小牢房<带栅栏的>窗户向外凝视。"
                            }
                        },
                        {
                            "text": "We were lucky to spot a <barred> owl resting on a high branch.",
                            "target_lang_translations": {
                                "ru": "Нам повезло заметить <пёструю> неясыть, отдыхающую на высокой ветке.",
                                "pl": "Mieliśmy szczęście dostrzec <pasiastą> sowę odpoczywającą na wysokiej gałęzi.",
                                "zh": "我们很幸运地发现了一只<条纹>猫头鹰停在高高的树枝上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "striped",
                        "banded",
                        "grated",
                        "reinforced"
                    ],
                    "common_phrases": [
                        "barred window",
                        "barred owl",
                        "barred spiral galaxy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий полосы или защищённый металлической решёткой.",
                        "pl": "Oznaczony pasami lub zabezpieczony metalowymi prętami.",
                        "zh": "形容词，指带有条纹的，或被金属栅栏保护/覆盖的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарешёченный",
                                "target_lang_sense_clarification": "закрытый решёткой (об окнах, дверях)"
                            },
                            {
                                "target_lang_word": "полосатый",
                                "target_lang_sense_clarification": "имеющий окрас в виде полос"
                            },
                            {
                                "target_lang_word": "пёстрый",
                                "target_lang_sense_clarification": "в названиях животных (например, пёстрая неясыть)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zakratowany",
                                "target_lang_sense_clarification": "zamknięty za kratami (o oknach, drzwiach)"
                            },
                            {
                                "target_lang_word": "pasiasty",
                                "target_lang_sense_clarification": "posiadający wzór w pasy"
                            },
                            {
                                "target_lang_word": "w prążki",
                                "target_lang_sense_clarification": "określenie wzoru lub ubarwienia"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "带栅栏的",
                                "target_lang_sense_clarification": "指窗户或门被金属条封住"
                            },
                            {
                                "target_lang_word": "条纹状的",
                                "target_lang_sense_clarification": "指带有条纹图案的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d149910e-477a-37bc-851d-a37b01a5b16c",
                    "sense_definition": "Relating to a crossword grid where words are separated by thick lines rather than black squares.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <barred> grid offers a different challenge compared to a standard blocked one.",
                            "target_lang_translations": {
                                "ru": "Сетка <с перегородками> предлагает иную задачу по сравнению со стандартной блочной.",
                                "pl": "Siatka <z liniami podziału> oferuje inne wyzwanie w porównaniu do standardowej siatki z czarnymi polami.",
                                "zh": "与标准的黑格网格相比，<带分隔线的>网格带来了不同的挑战。"
                            }
                        },
                        {
                            "text": "She enjoys solving <barred> crosswords because they often have more complex clues.",
                            "target_lang_translations": {
                                "ru": "Ей нравится разгадывать кроссворды <с перегородками>, потому что в них часто более сложные подсказки.",
                                "pl": "Lubi rozwiązywać krzyżówki <z liniami podziału>, ponieważ często mają bardziej złożone wskazówki.",
                                "zh": "她喜欢解<带分隔线的>填字游戏，因为它们的线索通常更复杂。"
                            }
                        }
                    ],
                    "antonyms": [
                        "blocked"
                    ],
                    "common_phrases": [
                        "barred grid",
                        "barred crossword"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к типу кроссвордов, где слова разделяются линиями, а не чёрными клетками.",
                        "pl": "Dotyczący typu krzyżówki, w której słowa są oddzielone liniami zamiast czarnymi polami.",
                        "zh": "指填字游戏网格中，单词之间用粗线分隔而非黑格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с перегородками",
                                "target_lang_sense_clarification": "о сетке кроссворда с разделительными линиями"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "z liniami podziału",
                                "target_lang_sense_clarification": "o siatce krzyżówki bez czarnych pól"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "带分隔线的",
                                "target_lang_sense_clarification": "指填字游戏网格的特殊样式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f928edf8-446f-3354-b361-4cdb69372db8",
                    "sense_definition": "Intoxicated or high on the drug Xanax.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so <barred> that he could barely stand up or speak clearly.",
                            "target_lang_translations": {
                                "ru": "Он был настолько <обдолбанным>, что едва мог стоять или говорить внятно.",
                                "pl": "Był tak <naćpany>, że ledwo mógł ustać na nogach lub wyraźnie mówić.",
                                "zh": "他当时<嗑药>嗑得太厉害，几乎站不稳，话也说不清楚。"
                            }
                        },
                        {
                            "text": "They spent the entire night getting <barred> and listening to loud music.",
                            "target_lang_translations": {
                                "ru": "Они провели всю ночь, <накачиваясь> и слушая громкую музыку.",
                                "pl": "Spędzili całą noc, <odurzając się> i słuchając głośnej muzyki.",
                                "zh": "他们整晚都在<嗑药>并听着大声的音乐。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии сильного наркотического опьянения (сленг).",
                        "pl": "Będący pod wpływem leku Xanax (slang).",
                        "zh": "俚语，指处于药物（通常指阿普唑仑）影响下的极度兴奋或昏沉状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдолбанный",
                                "target_lang_sense_clarification": "грубый сленг: под воздействием веществ"
                            },
                            {
                                "target_lang_word": "под кайфом",
                                "target_lang_sense_clarification": "в состоянии опьянения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "naćpany",
                                "target_lang_sense_clarification": "pod wpływem środków odurzających"
                            },
                            {
                                "target_lang_word": "odurzony",
                                "target_lang_sense_clarification": "w stanie silnego otumanienia"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嗑药的",
                                "target_lang_sense_clarification": "俚语，指处于药物影响下"
                            },
                            {
                                "target_lang_word": "神志不清的",
                                "target_lang_sense_clarification": "指因药物作用而无法正常行动或说话"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}