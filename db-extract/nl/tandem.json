                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b752895e-26d4-315c-aee3-fd89909dda78",
                                        "entry_id": "ecedaf89-d8c2-3c07-9ac2-456e8d1dc2e5",
                                        "glosses": [
                                            "Fahrrad für zwei (selten auch mehr) Personen, die hintereinander sitzen"
                                        ],
                                        "tags": [
                                            "Fahrradtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d52cba8-d9c5-44bd-90f9-5cfa356aa006",
                                                "sense_id": "b752895e-26d4-315c-aee3-fd89909dda78",
                                                "text": "Zu Herrentag fuhren sie mit einem Tandem durch die Ortschaften."
                                            },
                                            {
                                                "example_id": "55b4f58d-870f-492e-9e7a-1ca46489782d",
                                                "sense_id": "b752895e-26d4-315c-aee3-fd89909dda78",
                                                "text": "„Nachbarn waren sich einmal sicher, sie hätten es jetzt gelüftet: Helge und Toni waren per Tandem gekommen, und: Helge hatte vorn gesessen.“"
                                            },
                                            {
                                                "example_id": "d86b1e17-4598-411c-8fe0-80c6464d548c",
                                                "sense_id": "b752895e-26d4-315c-aee3-fd89909dda78",
                                                "text": "„Jetzt kommt mir ein Tandem entgegen: Ein Mann und eine Frau in gleich gemusterten Pullovern treten die Pedale.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82ec1d7d-9885-373b-b278-5c0adbb15b21",
                                        "entry_id": "ecedaf89-d8c2-3c07-9ac2-456e8d1dc2e5",
                                        "glosses": [
                                            "Kurzform von Tandemschach, eine Schachvariante"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94f20586-8c86-411d-b394-42eb493e9009",
                                                "sense_id": "82ec1d7d-9885-373b-b278-5c0adbb15b21",
                                                "text": "Wir suchen immer Partner zum Tandem."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c6dc1c42-cb47-3bf9-8ec0-06f54760e1c6",
                                        "entry_id": "ecedaf89-d8c2-3c07-9ac2-456e8d1dc2e5",
                                        "glosses": [
                                            "Methode zum Erlernen von Fremdsprachen, bei der sich zwei Personen mit unterschiedlicher Muttersprache gegenseitig Sprachkenntnisse vermitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c335a5c-54e4-4f76-bea6-8a8e34f0e301",
                                                "sense_id": "c6dc1c42-cb47-3bf9-8ec0-06f54760e1c6",
                                                "text": "Wir suchen immer Partner zum Tandem."
                                            },
                                            {
                                                "example_id": "390a1d2a-73ca-48ca-b397-3cbbabc14183",
                                                "sense_id": "c6dc1c42-cb47-3bf9-8ec0-06f54760e1c6",
                                                "text": "Tschechisch und Deutsch lernen wir per Tandem beim Schwarzbier."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
