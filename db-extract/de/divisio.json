                                        "sense_id": "e7f5e79a-a9f3-3f87-8d97-c04ef22a18d7",
                                        "entry_id": "2555f0cd-db72-3232-8d11-c8d059e2ffb5",
                                        "glosses": [
                                            "Point de rencontre de deux ou de plusieurs chemins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b9f8aa6-599b-49e7-8dd2-ebe892f8f1d3",
                                                "sense_id": "e7f5e79a-a9f3-3f87-8d97-c04ef22a18d7",
                                                "text": "Après une demi-heure de marche, elle parvint à une maison située auprès de l’embranchement formé par la rue principale du faubourg et par celle qui mène à la barrière de Pantin."
                                            },
                                            {
                                                "example_id": "ab4d8e78-43b4-46de-beca-f67651455048",
                                                "sense_id": "e7f5e79a-a9f3-3f87-8d97-c04ef22a18d7",
                                                "text": "À l’embranchement des deux voies, il quitta la Grande-Rue pour se jeter dans la rue de Diane, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c81be3c-a3bc-3fba-a98e-397f01df1e29",
                                        "entry_id": "2555f0cd-db72-3232-8d11-c8d059e2ffb5",
                                        "glosses": [
                                            "Point de jonction de deux ou plusieurs voies. Point de rencontre de deux lignes ferroviaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c92f1f5e-70dd-4803-9142-2b7905490c19",
                                                "sense_id": "1c81be3c-a3bc-3fba-a98e-397f01df1e29",
                                                "text": "La gare d’Évreux-Normandie se nommait autrefois Évreux-Embranchement."
                                            },
                                            {
                                                "example_id": "75589b24-7550-4596-9cb3-dcf5892fab7c",
                                                "sense_id": "1c81be3c-a3bc-3fba-a98e-397f01df1e29",
                                                "text": "Un embranchement particulier relie les voies d’un établissement privé à celles du réseau d’intérêt général."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20abc42-f30f-3dc2-be7a-238b5af3ba38",
                                        "entry_id": "2555f0cd-db72-3232-8d11-c8d059e2ffb5",
                                        "glosses": [
                                            "Niveau de classification des êtres vivants, regroupant plusieurs classes présentant des caractères structuraux communs, situé entre la classe et le règne dans la hiérarchie taxinomique. Terme utilisé en classification phylogénétique pour diviser les différents règnes, y compris animal, végétal, fongique et autres."
                                        ],
                                        "tags": [
                                            "Systématique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7174f033-bae2-4959-b04b-416fe38754c0",
                                                "sense_id": "a20abc42-f30f-3dc2-be7a-238b5af3ba38",
                                                "text": "Le règne animal compte 15 embranchements : Annélides, Arthropodes, Chordés, Cnidaires, Cténaires, Echinodermes, Lophophoriens, Mollusques, Némathelminthes, Némertiens, Plathelminthes, Pogonophores, Rotifères, Spongiaires, et Protozoaires (ces derniers occupent en fait une position particulière, puisqu’il s’agit d’êtres unicellulaires)."
                                            },
                                            {
                                                "example_id": "66f2d7e3-771f-4d7b-bd5d-ab375bfa9b6a",
                                                "sense_id": "a20abc42-f30f-3dc2-be7a-238b5af3ba38",
                                                "text": "Les Mollusques forment un embranchement de plus de 100,000 espèces réparties en sept classes : les Scaphopodes, les Aplacophores, les Monoplacophores, les Polyplacophores, les Gastéropodes, les Lamellibranches et les Céphalopodes."
                                            }
                                        ]
                                    }
