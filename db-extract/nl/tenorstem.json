                                    },
                                    {
                                        "sense_id": "484e5b95-80f6-352d-b095-815951745ed6",
                                        "entry_id": "9278b764-a580-3b57-8683-98e74b70667d",
                                        "glosses": [
                                            "A musical part or section that holds or performs the main melody, as opposed to the contratenor bassus and contratenor altus, who perform countermelodies."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cd2e3bf-1434-33d6-9ea6-75158129b5d0",
                                        "entry_id": "9278b764-a580-3b57-8683-98e74b70667d",
                                        "glosses": [
                                            "The lowest tuned in a ring of bells."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91641385-dc9b-3e2a-aad8-2dd7b3a505c5",
                                        "entry_id": "9278b764-a580-3b57-8683-98e74b70667d",
                                        "glosses": [
                                            "Tone, as of a conversation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2304ee51-e83d-4353-a4d1-12ff833d65fa",
                                                "sense_id": "91641385-dc9b-3e2a-aad8-2dd7b3a505c5",
                                                "text": "Colonel Walton, who had striven to check the conversation at moments when he became conscious of its tenor, now gladly engaged his guest on other and more legitimate topics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ad16c2d-6eb7-36fd-9387-f857c016535a",
                                        "entry_id": "9278b764-a580-3b57-8683-98e74b70667d",
                                        "glosses": [
                                            "duration; continuance; a state of holding on in a continuous course; general tendency; career."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b7b2a5d-691b-4a8a-898e-2a212a32c2d4",
                                                "sense_id": "5ad16c2d-6eb7-36fd-9387-f857c016535a",
                                                "text": "It is the conſciouſneſs of this merited approbation and eſteem which is alone capable of ſupporting the agent in this tenour of conduct."
                                            },
                                            {
                                                "example_id": "db322dee-3025-4acd-bf49-71901c6a6eb9",
                                                "sense_id": "5ad16c2d-6eb7-36fd-9387-f857c016535a",
                                                "text": "Along the cool sequestered vale of life / They kept the noiseless tenor of their way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29512320-3094-3b2c-8b38-07723e187ef8",
                                        "entry_id": "9278b764-a580-3b57-8683-98e74b70667d",
                                        "glosses": [
                                            "The subject in a metaphor to which attributes are ascribed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d6d7eae-994f-39b5-93a7-b1e73d3b76f1",
                                        "entry_id": "9278b764-a580-3b57-8683-98e74b70667d",
                                        "glosses": [
                                            "Time to maturity of a bond."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1754f3b8-0743-3788-ba13-05520df71008",
                                        "entry_id": "9278b764-a580-3b57-8683-98e74b70667d",
                                        "glosses": [
                                            "Stamp; character; nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e67a939-b1b3-4618-8e25-dea5bda11e71",
                                                "sense_id": "1754f3b8-0743-3788-ba13-05520df71008",
                                                "text": "This success would look like chance, if it were perpetual, and always of the same tenor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a486bb50-ed36-308a-8f5d-733287d76233",
                                        "entry_id": "9278b764-a580-3b57-8683-98e74b70667d",
                                        "glosses": [
                                            "An exact copy of a writing, set forth in the words and figures of it. It differs from purport, which is only the substance or general import of the instrument."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2529d8f7-2e3a-4f8f-a9ce-440083aa6150",
                                                "sense_id": "a486bb50-ed36-308a-8f5d-733287d76233",
                                                "text": "Than he shall delyuer to vs a tenour of that he ought to do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76549b33-92af-3533-a828-3d3917bb61fa",
                                        "entry_id": "9278b764-a580-3b57-8683-98e74b70667d",
                                        "glosses": [
                                            "That course of thought which holds on through a discourse; the general drift or course of thought; purport; intent; meaning; understanding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5edc77c5-3246-477d-a02c-2bab247b019c",
                                                "sense_id": "76549b33-92af-3533-a828-3d3917bb61fa",
                                                "text": "When it [the bond] is paid according to the tenor."
                                            },
                                            {
                                                "example_id": "71193c5b-8de3-4192-b433-5bfff9aa89bb",
                                                "sense_id": "76549b33-92af-3533-a828-3d3917bb61fa",
                                                "text": "He would have learned , by the whole tenor of the divine law , and especially by the example of the absent Lord , whose property he was for a season trusted with , that he was to do as much good to humanity , and win as much glory to God, as was compatible with the measure of his trust, and for the time for which he might retain it."
                                            },
                                            {
                                                "example_id": "fc46d19d-8e49-4279-96fa-bfef5f4b825f",
                                                "sense_id": "76549b33-92af-3533-a828-3d3917bb61fa",
                                                "text": "The general tenor of the report on No. 35020 is that all the improvements in performance aimed at in the rebuilding of these engines have been achieved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a8a2a43-97e0-3e0d-8ee6-ad478bab8e42",
                                        "entry_id": "9278b764-a580-3b57-8683-98e74b70667d",
                                        "glosses": [
                                            "A tenor saxophone."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tenor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df58ba0b-46a6-3ee2-bff8-650b8b40b205",
                                        "entry_id": "04c02e41-10a2-357f-8ed3-73e9a1545506",
                                        "glosses": [
                                            "Of or pertaining to the tenor part or range."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed7e76ea-bc40-400a-922a-218931accacd",
                                                "sense_id": "df58ba0b-46a6-3ee2-bff8-650b8b40b205",
                                                "text": "He has a tenor voice."
                                            },
                                            {
                                                "example_id": "59d192eb-7bf9-425c-8c4a-3a70429958a6",
                                                "sense_id": "df58ba0b-46a6-3ee2-bff8-650b8b40b205",
                                                "text": "Many a star athlete has very little hair anywhere except what he wears on top of his head, and a voice that is absolutely tenor."
                                            },
                                            {
                                                "example_id": "dee44338-6b32-43e1-ab46-5239f6e33228",
                                                "sense_id": "df58ba0b-46a6-3ee2-bff8-650b8b40b205",
                                                "text": "Sometimes Charlie would sing notes that were more tenor than original melody, forcing Bill to sing a high baritone-style line."
                                            },
                                            {
                                                "example_id": "d70369c7-f856-466f-bfe0-5b45d6e14116",
                                                "sense_id": "df58ba0b-46a6-3ee2-bff8-650b8b40b205",
                                                "text": "The door swung open, and a masculine voice—a little more tenor than Brookes's bass tones—called, “Brookes, come in. Do you have your colleague with you?”"
                                            },
                                            {
                                                "example_id": "06c46b7d-915b-42c5-9a81-7369bec7dd47",
                                                "sense_id": "df58ba0b-46a6-3ee2-bff8-650b8b40b205",
                                                "text": "Kahn was not a big man and he had a voice that was a little more tenor than most preferred."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
