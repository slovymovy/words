                        "glosses": [
                            "The bleeding or release of air from a system."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e5435c1-7833-4e0b-adac-176854ab86a2",
                                "sense_id": "b0f7416f-9f19-39d2-89cc-b0797859ab80",
                                "text": "With shrouding to prevent this outbleed, thrusts 5 to 10 percent less than those of the unperforated nozzle were obtained."
                            },
                            {
                                "example_id": "65f7172d-6afc-4e25-8832-dfb86d41f2a6",
                                "sense_id": "b0f7416f-9f19-39d2-89cc-b0797859ab80",
                                "text": "The mass flow m is constant along the duct, that is no mass flow inbleed or outbleed occurs;"
                            },
                            {
                                "example_id": "7970398f-d187-414b-b571-9083492f3ffd",
                                "sense_id": "b0f7416f-9f19-39d2-89cc-b0797859ab80",
                                "text": "Control of the moisture within the tunnel circuit is maintained with the dry-air inbleed and outbleed system (described in ref. 9) in conjunction with a water-injection system."
                            }
                        ]
                    }
                ],
