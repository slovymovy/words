                        {
                            "text": "Wszyscy moi <w>krewni</w> przyjechali na wesele.",
                            "target_lang_translations": {
                                "en": "All my <w>relatives</w> came to the wedding.",
                                "ru": "Все мои <w>родственники</w> приехали на свадьбу.",
                                "nl": "Al mijn <w>familieleden</w> zijn naar de bruiloft gekomen.",
                                "de": "Alle meine <w>Verwandten</w> sind zur Hochzeit gekommen.",
                                "fr": "Tous mes <w>parents</w> sont venus au mariage.",
                                "it": "Tutti i miei <w>parenti</w> sono venuti al matrimonio.",
                                "cs": "Všichni moji <w>příbuzní</w> přijeli na svatbu.",
                                "tr": "Bütün <w>akrabalarım</w> düğüne geldi.",
                                "es": "Todos mis <w>parientes</w> vinieron a la boda.",
                                "zh": "我所有的<w>亲戚</w>都来参加了婚礼。"
                            }
                        },
                        {
                            "text": "To jest mój daleki <w>krewny</w> z zagranicy.",
                            "target_lang_translations": {
                                "en": "This is my distant <w>relative</w> from abroad.",
                                "ru": "Это мой дальний <w>родственник</w> из-за границы.",
                                "nl": "Dit is een verre <w>verwant</w> van mij uit het buitenland.",
                                "de": "Das ist ein entfernter <w>Verwandter</w> von mir aus dem Ausland.",
                                "fr": "C'est un de mes <w>parents</w> éloignés qui vit à l'étranger.",
                                "it": "Questo è un mio lontano <w>parente</w> dall'estero.",
                                "cs": "To je můj vzdálený <w>příbuzný</w> ze zahraničí.",
                                "tr": "Bu, benim yurt dışından uzaktan bir <w>akrabam</w>.",
                                "es": "Este es mi <w>pariente</w> lejano del extranjero.",
                                "zh": "这是我从国外回来的远房<w>亲戚</w>。"
