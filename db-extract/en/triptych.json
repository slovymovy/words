                    },
                    {
                        "sense_id": "6f19feb8-e81d-3b88-95cc-6049168c210f",
                        "entry_id": "161e60da-2d58-30bb-829c-a618744afd3e",
                        "glosses": [
                            "三个紧密相关的想法或事物的组合"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "14b4d647-13d5-49ef-8908-3b8be27ad4eb",
                                "sense_id": "6f19feb8-e81d-3b88-95cc-6049168c210f",
                                "text": "Witchcraft, heresy, and counterfeiting formed a triptych in popular imagination and in the law.",
                                "translation": "在民众的想象和法律中，巫术、异端邪说和伪造货币构成了一幅“三联画”。"
                            },
                            {
                                "example_id": "036e2a71-0a79-46bb-8ac5-303f5992b2e7",
                                "sense_id": "6f19feb8-e81d-3b88-95cc-6049168c210f",
                                "text": "The interest here is […] to construct for heuristic purposes a triptych of different “roads to salvation” as reflected in domains of preaching of contemporary Egypt.",
                                "translation": "这里的兴趣在于 […] 为了启发式目的，构建一个不同的“救赎之路”的三联画，正如当代埃及的布道领域所反映的那样。"
                            },
                            {
                                "example_id": "134c2b44-d3f6-4529-87c2-27fb860db489",
                                "sense_id": "6f19feb8-e81d-3b88-95cc-6049168c210f",
                                "text": "There was nothing quite like Hanalei Bay, that great horseshoe of protected water fed by the thick artery of the Hanalei River and framed by a triptych of mountains.",
                                "translation": "哈纳雷湾是独一无二的，它像一个巨大的马蹄形海湾，受到保护，由哈纳雷河这条粗壮的河流注入，周围环绕着三座山脉。"
                            }
                        ]
                    }
