                    {
                        "translation_id": "d581244c-9ffb-4cd1-b79b-b2a1e879663b",
                        "source_entry_id": "5be2330c-e001-37c7-9e8d-974f1066927f",
                        "source_sense_id": "3ba3a729-c8b0-3835-9d63-66e671609b09",
