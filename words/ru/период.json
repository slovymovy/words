                {
                    "sense_id": "3f6e5be5-976a-3198-8074-597ad8f43b83",
                    "sense_definition": "Законченная музыкальная мысль, часть музыкальной формы.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот музыкальный <w>период</w> состоит из двух предложений.",
