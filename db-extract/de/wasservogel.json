                        "examples": [
                            {
                                "example_id": "26852185-d9ed-492a-978b-6a43c8347324",
                                "sense_id": "80ade7d9-8fee-3920-ba80-16c5f160b19a",
                                "text": "Das Steinhuder Meer ist ein Paradies für Wasservögel.",
                                "translation": "Le lac de Steinhude est un paradis pour les oiseaux aquatiques."
                            },
                            {
                                "example_id": "c088e54c-3dd5-409b-b708-cddff5a1c61c",
                                "sense_id": "80ade7d9-8fee-3920-ba80-16c5f160b19a",
                                "text": "Im Herbst versammeln sich an diesem See zahlreiche Wasservögel und stärken sich, bevor sie nach Afrika abfliegen.",
                                "translation": "En automne, de nombreux oiseaux aquatiques se rassemblent sur ce lac et reprennent des forces avant de s'envoler pour l'Afrique."
                            }
                        ]
                    }
