    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9711926d-e81c-3b1f-98bf-a4f794f2a188",
                    "sense_definition": "To smear or rub a surface with oil or a similar substance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "apply_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor told him to <w>anoint</w> the dry skin with a soothing cream."
                        },
                        {
                            "text": "She began to <w>anoint</w> the wooden table with oil to protect the surface."
                        }
                    ],
                    "synonyms": [
                        "salve"
                    ],
                    "common_phrases": [
                        "anoint with oil"
                    ]
                },
                {
                    "sense_id": "c600a1fd-35c5-3d8b-88fb-3f4666e295bd",
                    "sense_definition": "To apply oil as part of a religious or sacred ceremony for consecration.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "apply_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest will <w>anoint</w> the sick person during the special prayer service."
                        },
                        {
                            "text": "Ancient kings were often <w>anointed</w> with holy oil to signify their divine right."
                        }
                    ],
                    "common_phrases": [
                        "anoint with oil"
                    ]
                },
                {
                    "sense_id": "9a6f03b2-d11d-3ebc-b684-7eb0fe639456",
                    "sense_definition": "To formally mark or crown someone as a monarch during a religious ceremony.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appoint_leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archbishop will <w>anoint</w> the new queen during the coronation ceremony."
                        },
                        {
                            "text": "History records how the high priest would <w>anoint</w> the chosen successor as king."
                        }
                    ]
                },
                {
                    "sense_id": "4ef86e77-491c-3265-9a31-c242980d679f",
                    "sense_definition": "To choose or nominate someone for an important position or as a successor.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appoint_leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The retiring CEO decided to <w>anoint</w> his deputy as the next company leader."
                        },
                        {
                            "text": "Political analysts watched to see who the party would <w>anoint</w> as their candidate."
                        }
                    ],
                    "common_phrases": [
                        "anoint a successor"
                    ]
                }
            ]
        }
    ]
