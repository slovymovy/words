                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "732ff613-db9f-4c42-8c2a-46e6c2bf33dc",
                        "source_entry_id": "13e90431-f640-30e0-b880-c6eb96e241a9",
                        "source_sense_id": "0141975a-087b-3212-b83a-5e8e9ee90cea",
                        "source_sense_description": "Selection of nocturnal activities",
                        "target_lang_word": "Nachtleben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtleben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23207697-8396-3525-a99f-a1e6e863f557",
                                        "entry_id": "474dc332-9b22-3498-b69c-0ab82ca50cab",
                                        "glosses": [
                                            "ein nächtliches Vergnügen in der Öffentlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1b341a3-d947-47f8-a8e8-13b6d3d19f48",
                                                "sense_id": "23207697-8396-3525-a99f-a1e6e863f557",
                                                "text": "Vom Nachtleben in Deiner Stadt war ich nicht begeistert."
                                            },
                                            {
                                                "example_id": "f56ffa66-0b88-4b23-8508-72f01f7c07b0",
                                                "sense_id": "23207697-8396-3525-a99f-a1e6e863f557",
                                                "text": "Bei uns ist das Nachtleben ungefährlich."
                                            },
                                            {
                                                "example_id": "63fe6905-7961-44cf-b6ea-c24b919c1a56",
                                                "sense_id": "23207697-8396-3525-a99f-a1e6e863f557",
                                                "text": "Erst vor Mitternacht beginnt das Nachtleben richtig."
                                            },
                                            {
                                                "example_id": "1ed22aa3-3ffa-4212-b39f-1cde018830c7",
                                                "sense_id": "23207697-8396-3525-a99f-a1e6e863f557",
                                                "text": "„Mexikaner pendeln zum Shopping und für bessere Schulen nach San Diego, Amerikaner für Nachtleben und Krebsoperationen nach Tijuana.“"
                                            },
                                            {
                                                "example_id": "a391fa43-b562-4225-aba3-39a06b5311ea",
                                                "sense_id": "23207697-8396-3525-a99f-a1e6e863f557",
                                                "text": "„Nun erreichte das Nachtleben Faranahs seinen Höhepunkt.“"
                                            },
                                            {
                                                "example_id": "044d5864-0f41-43b5-a77f-5eb6fa0921c9",
                                                "sense_id": "23207697-8396-3525-a99f-a1e6e863f557",
                                                "text": "„Das Nachleben wird nicht von der Schickeria geprägt und ähnelt eher einer heimischen Privatparty.“"
                                            },
                                            {
                                                "example_id": "966884cd-2297-4851-b217-2bcb6d2c4b34",
                                                "sense_id": "23207697-8396-3525-a99f-a1e6e863f557",
                                                "text": "„Die Familie lässt sich ab Juli 1927 in Berlin nieder, dessen quirliges Nachtleben der Junggeselle Jünger schon einige Jahre zuvor bei Besuchen schätzen lernte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
