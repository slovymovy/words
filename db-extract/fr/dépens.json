                                        "entry_id": "d59c5df7-2ffe-36a8-8726-ee8c15fa81b9",
                                        "glosses": [
                                            "A spending or consuming, often a disbursement of funds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a99ef0-203c-430a-98d0-0ef6ed4ccca7",
                                                "sense_id": "35bca17a-a2b1-3b13-bb91-68c140f59e26",
                                                "text": "She went to great expense to ensure her children would get the best education."
                                            },
                                            {
                                                "example_id": "2c1fbf30-2373-41b7-a5b4-188d7c443281",
                                                "sense_id": "35bca17a-a2b1-3b13-bb91-68c140f59e26",
                                                "text": "Buying the car was a big expense, but will be worth it in the long run."
                                            },
                                            {
                                                "example_id": "fbc21156-e973-401b-b4b2-f0ab3c2850bf",
                                                "sense_id": "35bca17a-a2b1-3b13-bb91-68c140f59e26",
                                                "text": "We had a training weekend in New York, at the expense of our company."
                                            },
                                            {
                                                "example_id": "5b28e97c-42fe-4b05-bd18-4a75f30be062",
                                                "sense_id": "35bca17a-a2b1-3b13-bb91-68c140f59e26",
                                                "text": "Husband nature's riches from expense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd4b7d14-2340-3ad5-9c27-b3f0269febd3",
                                        "entry_id": "d59c5df7-2ffe-36a8-8726-ee8c15fa81b9",
                                        "glosses": [
                                            "The elimination or consumption of something, sometimes with the notion of loss or damage to the thing eliminated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19ea0a94-5a8b-4146-bda7-6ededfa6451b",
                                                "sense_id": "dd4b7d14-2340-3ad5-9c27-b3f0269febd3",
                                                "text": "Jones reached the final at the expense of Smith, who couldn't beat him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31edf576-5731-34fa-b3df-46e3c4f2177d",
                                        "entry_id": "d59c5df7-2ffe-36a8-8726-ee8c15fa81b9",
                                        "glosses": [
                                            "Loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2841b658-680d-411f-a5e0-c7b1ce142307",
                                                "sense_id": "31edf576-5731-34fa-b3df-46e3c4f2177d",
                                                "text": "And moan the expense of many a vanished sight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "expense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c118964b-5bcb-3652-873c-f17103ef83c7",
                                        "entry_id": "33a03bc3-3fb2-3e57-b8e3-5fef80f2c6a8",
                                        "glosses": [
                                            "To charge a cost against an expense account; to bill something to the company for which one works."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37953f1-5e68-4338-b1f5-1b08aaaa6b8f",
                                                "sense_id": "c118964b-5bcb-3652-873c-f17103ef83c7",
                                                "text": "It should be acceptable to expense a business lunch with a client."
                                            },
                                            {
                                                "example_id": "6bb43d3b-7239-43d5-a3a7-cbc1c3551b07",
                                                "sense_id": "c118964b-5bcb-3652-873c-f17103ef83c7",
                                                "text": "“Looking snazzy, Mr. Sarner.” “[screams] I have a body.” “Fucking hell. Yes, we brought you back to life.” “I was floating in the eternal glow for a million years. Safe, warm.” “You need to remember what you were going to say to the board of directors to justify expensing a ping ping table.” “I've been here before.” “I've made some flashcards to help jog your memory. \"Ping ping increases productivity by 50 percent.\" I mean, that's bullshit, but let's see if it flies.” “How did I get back on this plane of existence?” “Would you shut up? Literally no one has ever cared about what happens after you die.” “The board is here.” “I need more time, Terry. Sarner's being a baby about his resurrection.” “I traversed the black mountain. Why am I back?” “Okay, I'll just have to stall them with the old razzle-dazzle.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cf011c6-38f0-4f32-8417-06493f32bd18",
                        "source_entry_id": "2c8e0f8d-f574-3d72-8a6a-97ddf7163cdd",
                        "source_sense_description": "Ce qu’on dépense",
                        "target_lang_word": "kosten",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kosten",
