                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ware beter dat hij de strijd <w>opgave</w> voordat het erger werd.",
                            "target_lang_translations": {
                                "en": "It would be better if he <w>gave up</w> the fight before it got worse."
                            }
                        },
                        {
                            "text": "Indien zij haar verzet <w>opgave</w>, zou er vrede kunnen zijn.",
                            "target_lang_translations": {
                                "en": "If she <w>surrendered</w> her resistance, there could be peace."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Deze vorm wordt in modern Nederlands nauwelijks meer gebruikt."
