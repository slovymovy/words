                                "target_senses": [
                                    {
                                        "sense_id": "f437f1a4-ca3a-3763-90ff-7db951f3e88a",
                                        "entry_id": "5f4a0d53-539d-39d9-bc75-d2da3f4200e8",
                                        "glosses": [
                                            "Peaceful, quiet, especially free from anger and anxiety."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2272024a-37d6-3fb1-bded-6c156104b30f",
                                        "entry_id": "5f4a0d53-539d-39d9-bc75-d2da3f4200e8",
                                        "glosses": [
                                            "Free of noise and disturbance."
                                        ],
                                        "tags": [
                                            "of a place or situation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f4ba3f9-4135-4b5c-a1bb-5c077798df46",
                                                "sense_id": "2272024a-37d6-3fb1-bded-6c156104b30f",
                                                "text": "Calm is the morn without a sound,\n⁠Calm as to suit a calmer grief,\n⁠And only thro’ the faded leaf\nThe chestnut pattering to the ground: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0ed3259-8237-3deb-8727-ed6a19cad7d7",
                                        "entry_id": "5f4a0d53-539d-39d9-bc75-d2da3f4200e8",
                                        "glosses": [
                                            "with few or no waves on the surface; not rippled."
                                        ],
                                        "tags": [
                                            "of water"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f598ebc-80f1-3b5c-b07f-a70bf5c1d823",
                                        "entry_id": "5f4a0d53-539d-39d9-bc75-d2da3f4200e8",
                                        "glosses": [
                                            "Without wind or storm."
                                        ],
                                        "tags": [
                                            "of weather"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "calm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ff239a5-de95-3b4c-af91-3423edb6eed7",
                                        "entry_id": "8a5b6f49-7137-373d-8e02-1fa51a4c3ab8",
                                        "glosses": [
                                            "The state of being calm; peacefulness; absence of worry, anger, fear or other strong negative emotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10c61a1-f1ad-4332-a008-d518363a3e78",
                                                "sense_id": "7ff239a5-de95-3b4c-af91-3423edb6eed7",
                                                "text": "Calm on the seas, and silver sleep,\n⁠And waves that sway themselves in rest,\n⁠And dead calm in that noble breast\nWhich heaves but with the heaving deep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f838e1f-b56e-32e3-be32-97b28b538987",
                                        "entry_id": "8a5b6f49-7137-373d-8e02-1fa51a4c3ab8",
                                        "glosses": [
                                            "The state of being calm; absence of noise and disturbance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18970b2a-3dec-3114-9933-d0fcd7b5ad1c",
                                        "entry_id": "8a5b6f49-7137-373d-8e02-1fa51a4c3ab8",
                                        "glosses": [
                                            "The absense of wind; a period of time without wind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff85e55-b1c5-4200-bd48-e59ae8dab87c",
                                                "sense_id": "18970b2a-3dec-3114-9933-d0fcd7b5ad1c",
                                                "text": "The wind ceased, and there was a great calm."
                                            },
                                            {
                                                "example_id": "8121ed18-1697-45fa-97b5-3c592400a998",
                                                "sense_id": "18970b2a-3dec-3114-9933-d0fcd7b5ad1c",
                                                "text": "It was a calm ; so, forming a tandem of three boats, we commenced the slow business of towing the trophy to the Pequod."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
