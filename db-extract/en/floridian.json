                        "glosses": [
                            "Of, or pertaining to, Florida or its culture."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "97b25006-800c-4fa2-9d91-d6319484d087",
                                "sense_id": "f7150de0-3595-3c96-8e69-8b73d80cdaa9",
                                "text": "Recess’s website features the charms of vaporwave internet art and Lisa Frank-style nostalgia, while their Instagram account evokes the combined look of “Endless Summer” with “Floridian retiree” and the summer-camp psychedelia that has replaced “Lifestyle Lumberjack” as the default millennial style choice."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
