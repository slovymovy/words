                                    },
                                    {
                                        "sense_id": "04f83ae7-87b1-3473-8f39-1f9658f768c5",
                                        "entry_id": "4fea721b-1d34-3fdd-816f-d02dc90793b7",
                                        "glosses": [
                                            "Dicho de una persona (especialmente una mujer), que es muy dramática, escandalosa o parlanchina."
                                        ],
                                        "tags": [
                                            "colloquial",
