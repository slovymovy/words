                                        "sense_id": "bd577aa4-8892-3605-97e9-3a285b8b7e05",
                                        "entry_id": "f148e024-fd5a-3e0f-add7-57f98145b691",
                                        "glosses": [
                                            "To jerk sharply and briefly."
