                "senses": [
                    {
                        "sense_id": "323a7f47-79c2-3f09-baab-85cb96ab612a",
                        "entry_id": "0ddcc37a-da58-34d4-a9df-c8919bc6e42f",
                        "glosses": [
                            "bouncer (male or of unspecified gender)"
                        ],
