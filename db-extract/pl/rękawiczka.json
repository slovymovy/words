                            {
                                "example_id": "5e2f498c-abda-4724-b69d-7d12b4f7ee63",
                                "sense_id": "381bd7b0-5774-3063-94a1-fb03c1edcaf1",
                                "text": "Zimą prawie wszystkie babcie robią na drutach swetry, szaliki i rękawiczki."
                            },
                            {
                                "example_id": "071746bd-e20d-43e9-9dde-a5064ae0b927",
                                "sense_id": "381bd7b0-5774-3063-94a1-fb03c1edcaf1",
                                "text": "Wieczorem, w granatowym cieniu, wysoki bufetowy w nicianych rękawiczkach wynosi na werandę lampę z jedwabnym abażurem."
                            }
                        ],
