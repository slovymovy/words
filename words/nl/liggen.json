                {
                    "sense_id": "961732c2-98bd-3689-b1ce-a69bd5a03a32",
                    "sense_definition": "Hulpwerkwoord dat aangeeft dat iemand langdurig met iets bezig is (vaak in een liggende houding).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar_aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>lag</w> de hele middag een boek te lezen.",
                            "target_lang_translations": {
                                "ru": "Он <w>лежал</w> и читал книгу весь день.",
                                "en": "He <w>lay</w> reading a book all afternoon.",
                                "pl": "Całe popołudnie <w>leżał</w> i czytał książkę.",
                                "de": "Er <w>lag</w> den ganzen Nachmittag und las ein Buch.",
                                "fr": "Il <w>était couché</w> en train de lire un livre tout l'après-midi.",
                                "it": "<w>Stava</w> leggendo un libro per tutto il pomeriggio.",
                                "cs": "Celé odpoledne <w>ležel</w> a četl knihu.",
                                "tr": "Bütün öğleden sonra <w>uzanıp</w> kitap okudu.",
                                "es": "Se <w>pasó</w> toda la tarde leyendo un libro."
                            }
                        },
                        {
                            "text": "Je biefstuk <w>ligt</w> daar koud te worden.",
                            "target_lang_translations": {
                                "ru": "Твой стейк <w>лежит</w> там и остывает.",
                                "en": "Your steak <w>is lying</w> there getting cold.",
                                "pl": "Twój stek tam <w>leży</w> i stygnie.",
                                "de": "Dein Steak <w>liegt</w> dort und wird kalt.",
                                "fr": "Ton steak <w>est en train de</w> refroidir là-bas.",
                                "it": "La tua bistecca <w>sta</w> lì a raffreddarsi.",
                                "cs": "Tvůj steak tam <w>leží</w> a chladne.",
                                "tr": "Bifteğin orada <w>durup</w> soğuyor.",
                                "es": "Tu filete se <w>está</w> enfriando allí."
                            }
                        }
                    ],
                    "common_phrases": [
                        "liggen te slapen",
                        "liggen te dromen",
                        "liggen te wachten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вспомогательный глагол, указывающий на продолжительность действия (часто в лежачем положении).",
                        "en": "Auxiliary verb indicating that someone is busy with something for a long time (often in a lying position).",
                        "pl": "Czasownik posiłkowy wskazujący, że ktoś wykonuje jakąś czynność przez dłuższy czas (często w pozycji leżącej).",
                        "de": "Hilfsverb, das anzeigt, dass jemand längere Zeit mit etwas beschäftigt ist (oft in liegender Haltung).",
                        "fr": "Verbe auxiliaire indiquant qu'une action se prolonge (souvent en position allongée).",
                        "it": "Verbo ausiliare che indica che qualcuno è impegnato a fare qualcosa per un periodo prolungato (spesso in posizione sdraiata).",
                        "cs": "Pomocné sloveso vyjadřující, že někdo dlouho vykonává nějakou činnost (často vleže).",
                        "tr": "Birinin bir şeyle uzun süre meşgul olduğunu (genellikle yatar pozisyonda) belirten yardımcı fiil.",
                        "es": "Verbo auxiliar que indica que alguien está realizando una acción de forma continua o prolongada (a menudo en posición acostada)."
                    },
