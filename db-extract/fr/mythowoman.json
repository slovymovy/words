                                "target_senses": [
                                    {
                                        "sense_id": "48ddd1cf-0bb5-3559-baeb-049aefa083b7",
                                        "entry_id": "0beb25d9-8f5a-3d24-8e96-c043c68a5b3f",
                                        "glosses": [
                                            "A person who frequently lies; someone who tells a lie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26315097-df91-4787-b96e-b10142725470",
                                                "sense_id": "48ddd1cf-0bb5-3559-baeb-049aefa083b7",
                                                "text": "She paused and took a defiant breath. ‘If you don't believe me, I can't help it. But I'm not a liar.’ ¶ ‘No,’ said Luke, grinning at her. ‘You're not dull enough![…]What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything?[…]’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                        "entry_id": "0beb25d9-8f5a-3d24-8e96-c043c68a5b3f",
                                        "glosses": [
                                            "A swabber responsible for cleaning the outside parts of the ship rather than the cabins, a role traditionally assigned to a person caught telling a lie the previous week."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b14fb9-d5f1-4632-8d73-329ae21dfc9a",
                                                "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                                "text": "The Swabber is to keep the Cabbins, and all the Rooms of the Ship clean within board, and the Liar to do the like without board. The Liar holds his Place but for a week; and he that is first taken with a Lie upon a Monday morning, […] for that week he is under the Swabber, and meddles not with making clean the Ship within board, but without."
                                            },
                                            {
                                                "example_id": "b14ac5f7-2b53-4beb-9e5e-b685328fa22c",
                                                "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                                "text": "The swabber, perhaps the lowliest position on the ship, was responsible for cleaning the decks. By tradition, each Monday a new crewmember was appointed the liar—the first person caught telling a lie the previous week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
