                        "glosses": [
                            "Conflictualiser de nouveau."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "note": "Surtout attesté dans le domaine de la psychanalyse",
                        "examples": [
                            {
                                "example_id": "13087adf-0d5d-4f18-b8ea-ebec86847044",
                                "sense_id": "c944d2ba-3e57-3b58-838d-a44db791d1c9",
                                "text": "C’est pourquoi je parle de repolitiser le combat contre le racisme et les discriminations ethniques et de reconflictualiser l’espace de la régulation sociale."
                            },
                            {
                                "example_id": "04a33a77-d76a-44d7-970b-0fe1fcbdbdf9",
                                "sense_id": "c944d2ba-3e57-3b58-838d-a44db791d1c9",
                                "text": "Cela donne l’occasion de dégager ce qu’il en est du noyau mélancolique de ces patients et comment reconflictualiser des imagos primaires immobilisées sur le versant persécutif."
                            }
                        ]
                    }
