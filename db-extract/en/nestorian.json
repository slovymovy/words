                                        "entry_id": "5c00eb00-c970-3d62-bdd6-f087510258c7",
                                        "glosses": [
                                            "sich auf den Nestorianismus beziehend, zum Nestorianismus gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "172203d1-09af-4a27-aeb0-18205434c522",
                                                "sense_id": "e2e04769-128a-3518-89ca-13677764efe3",
                                                "text": "„Bei einer Befragung sagte Suydam, er halte dieses Ritual für einen Überrest des nestorianischen Christentums, vermengt mit dem Schamanismus Tibets.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
