                        ],
                        "form": "das Versteckspiel"
                    },
                    {
                        "form_id": "8c114d48-c11e-4085-8f20-7b3b92890a2c",
                        "entry_id": "95cc96b6-c9db-3541-9697-00740c80649d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Versteckspiele"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "be0e64e6-7741-3dff-b1a7-095fe3ea27c6",
                        "entry_id": "95cc96b6-c9db-3541-9697-00740c80649d",
                        "glosses": [
                            "Spielform, bei der Gegenstände oder Personen verborgen werden, um sie von Spielpartnern suchen zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502a1394-d6bb-409f-8d28-bfe100b393ec",
                                "sense_id": "be0e64e6-7741-3dff-b1a7-095fe3ea27c6",
                                "text": "„Ein wild verwachsenes Stück ursprünglicher Landschaft, vielleicht um eine alte Burgruine herum mit Mauern, Höhlen, Treppen, Nischen, ist ein idealer Platz für diese Art Versteckspiel.“"
                            },
                            {
                                "example_id": "304073ef-044b-403c-a28d-9aa32170e8f2",
                                "sense_id": "be0e64e6-7741-3dff-b1a7-095fe3ea27c6",
                                "text": "„Bei Treffen rede ich inzwischen lieber über vergangene Versteckspiele auf Zeltplätzen, die Kinderstreitereien zwischen meinem Bruder und mir oder ich helfe ihm bei Computerproblemen.“"
                            },
                            {
                                "example_id": "376c3a9e-c0b2-42dc-98c4-cc7601f49ae1",
                                "sense_id": "be0e64e6-7741-3dff-b1a7-095fe3ea27c6",
                                "text": "„Der Kindergarten Filefant in Ottensen wird zur Artistenkolonie auf Zeit, weil die Kunsthalle ihre Zielgruppe dort erreichen will, wo sie noch nicht komplett von YouTube und Facebook vereinnahmt ist: zwischen Tunnelkriechen, Versteckspielen und Liedersingen.“"
                            },
                            {
                                "example_id": "52572f83-bce8-407f-b81b-726f83c86c99",
                                "sense_id": "be0e64e6-7741-3dff-b1a7-095fe3ea27c6",
                                "text": "„An jeder Wand, in jedem Bild, in den Gesichtern der herumgehenden Leute, in den Geräuschen, die das Versteckspiel der Kinder zwischen den Stelen erzeugte.“"
                            },
                            {
                                "example_id": "a642c2e9-f1f8-4230-9868-f2d41241d581",
                                "sense_id": "be0e64e6-7741-3dff-b1a7-095fe3ea27c6",
                                "text": "„Ich finde es zum Beispiel herrlich, mich beim Kuchenbacken von oben bis unten mit Mehl einzusauen oder beim Versteckspielen zusammengekauert im kleinsten Schrank zu sitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f374dc28-321e-36ad-a6eb-2402c741ca47",
                        "entry_id": "95cc96b6-c9db-3541-9697-00740c80649d",
                        "glosses": [
                            "Versuch, Ereignisse, Handlungen oder Vorgänge zu verbergen beziehungsweise zu verschleiern, um andere hinzuhalten oder zu täuschen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "43a8eae9-d0ac-4b7b-aaa8-4a05c803b964",
                                "sense_id": "f374dc28-321e-36ad-a6eb-2402c741ca47",
                                "text": "„Lasst Euch überraschen, bemerkte Mittelfeldspieler Toni Kroos am Donnerstag auf dem Pressepodium im DFB-Medienzentrum lächelnd zum Versteckspiel.“"
                            },
                            {
                                "example_id": "22a2afb0-4d4d-469b-98f3-da1db2e41a49",
                                "sense_id": "f374dc28-321e-36ad-a6eb-2402c741ca47",
                                "text": "„Bis er irgendwann genug von dem ewigen Versteckspiel hatte, all seinen Mut zusammennahm und sich outete.“"
                            },
                            {
                                "example_id": "a528d5da-ae9f-4df5-b721-fd7c29cbdec1",
                                "sense_id": "f374dc28-321e-36ad-a6eb-2402c741ca47",
                                "text": "„Genau an dieser Stelle warf Schulz der Kanzlerin in Paris ein Versteckspiel vor.“"
                            },
                            {
                                "example_id": "ef78baf1-e9a3-41fb-a566-708b49e10228",
                                "sense_id": "f374dc28-321e-36ad-a6eb-2402c741ca47",
                                "text": "„Nach dem Versteckspiel um ein umstrittenes Treffen zwischen sächsischen AfD-Landtagsabgeordneten und Organisatoren des islamkritischen Pegida-Bündnisses wollen beide Seiten heute Einzelheiten mitteilen.“"
                            },
                            {
                                "example_id": "da79dcee-df7d-4730-a4ee-5e9aefd43c31",
                                "sense_id": "f374dc28-321e-36ad-a6eb-2402c741ca47",
                                "text": "„Dass der Film dieses Thema so stark in den Fokus rückt, nicht zuletzt durch das prominent gezeigte Versteckspiel Assanges mit der britischen Justiz, hat vier Juristinnen auf den Plan gerufen, die mit WikiLeaks zusammenarbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e29c7669-c457-456c-a0f0-906ef333747a",
                        "source_entry_id": "95cc96b6-c9db-3541-9697-00740c80649d",
                        "source_sense_id": "be0e64e6-7741-3dff-b1a7-095fe3ea27c6",
                        "target_lang_word": "hide and seek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hide and seek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1644d56-fa94-362a-bea3-8f0b682dd3b7",
                                        "entry_id": "5496973a-92fe-37c2-933a-0375365ec957",
                                        "glosses": [
                                            "A game where the players have to hide and one has to seek them out."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fef5e099-f418-4ccd-9780-d89e6d6a2310",
                                                "sense_id": "b1644d56-fa94-362a-bea3-8f0b682dd3b7",
                                                "text": "I would sometimes lie down, and let five or six of them dance on my hand; and at last the boys and girls would venture to come and play at hide-and-seek in my hair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1753257-ed8f-4f7e-b140-38865e67421b",
                        "source_entry_id": "95cc96b6-c9db-3541-9697-00740c80649d",
                        "source_sense_id": "be0e64e6-7741-3dff-b1a7-095fe3ea27c6",
                        "target_lang_word": "cache-cache",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cache-cache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c3d7ca2-d903-3cb0-bda7-6c400c3e2028",
                                        "entry_id": "33a87fda-779e-3c01-a34e-ce3e6e2c95f9",
                                        "glosses": [
                                            "Jeu d’enfants dans lequel l’un d’eux ferme les yeux, tandis que les autres se cachent en divers endroits, où il doit ensuite les chercher pour les prendre."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b23e71a5-154b-409b-a83f-ea3183df1b9d",
                                                "sense_id": "2c3d7ca2-d903-3cb0-bda7-6c400c3e2028",
                                                "text": "Les élèves sont en récréation. On les entend, qui préparent une partie de « cache-cache » et qui tirent au sort « pour savoir qui en sera ».\nAstramgram pickepick et colegram..."
                                            },
                                            {
                                                "example_id": "8240c6a2-cb5a-4014-9971-226a908a5d27",
                                                "sense_id": "2c3d7ca2-d903-3cb0-bda7-6c400c3e2028",
                                                "text": "Une manière excellente de compter pour cache-cache :\nQuatre à quatre à la charrue\nQuand on donne on reprend plus\nAutrement on est perdu\nDans le bois du p’tit bossu. — (Colette Vivier, La maison des petits bonheurs, 1939, réédition Casterman Poche, page 84)"
                                            },
                                            {
                                                "example_id": "ecc03d3d-6e8b-460e-a407-357b6676e8ee",
                                                "sense_id": "2c3d7ca2-d903-3cb0-bda7-6c400c3e2028",
                                                "text": "Dans la cour de récréation, avec les autres enfants, je n’aime plus jouer à cache-cache parce que je ressens la peur douloureuse d’être découverte – la peur de la proie. À l’une des surveillantes qui s’interroge sur mes pleurs, je réponds : « Dans ma famille on est juifs ». Je me souviens de son regard étonné à ce moment-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b74c21-6145-3555-bfad-09ff350494bf",
                                        "entry_id": "33a87fda-779e-3c01-a34e-ce3e6e2c95f9",
                                        "glosses": [
                                            "Poursuite de quelqu’un sans arriver à l’attraper."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f78faf1-732d-4556-bad9-76f052fe0e63",
                                                "sense_id": "72b74c21-6145-3555-bfad-09ff350494bf",
                                                "text": "— Nous en avons assez de ce jeu de cache-cache. Depuis des mois que nous grenouillons sur les pistes et dans les marais en croisant sans arrêt les traces d’une bande de fellouzes insaisissables […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cache-cache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82bf166e-dbf0-3280-a7a9-30c354a03ae7",
