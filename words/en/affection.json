        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                    "sense_definition": "A feeling of love or strong attachment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotion_love",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a deep <w>affection</w> for her younger sister.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала глубокую <w>привязанность</w> к своей младшей сестре.",
                                "de": "Sie empfand eine tiefe <w>Zuneigung</w> für ihre jüngere Schwester."
                            }
                        },
                        {
                            "text": "The couple was not afraid to show <w>affection</w> in public.",
                            "target_lang_translations": {
                                "ru": "Пара не боялась проявлять <w>нежность</w> на людях.",
                                "de": "Das Paar hatte keine Angst, in der Öffentlichkeit <w>Zuneigung</w> zu zeigen."
                            }
                        },
                        {
                            "text": "He tried to win her <w>affection</w> by bringing her flowers every day.",
                            "target_lang_translations": {
                                "ru": "Он пытался завоевать её <w>расположение</w>, принося ей цветы каждый день.",
                                "de": "Er versuchte, ihre <w>Zuneigung</w> zu gewinnen, indem er ihr jeden Tag Blumen brachte."
                            }
                        }
                    ],
                    "synonyms": [
                        "fondness",
                        "love",
                        "tenderness",
                        "attachment"
                    ],
                    "common_phrases": [
                        "show affection",
                        "deep affection",
                        "win someone's affection",
                        "public display of affection"
