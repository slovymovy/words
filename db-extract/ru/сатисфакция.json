                                "target_senses": [
                                    {
                                        "sense_id": "41865133-bef7-374b-a66f-5b05d599cdc0",
                                        "entry_id": "a05226f9-0255-3367-8e91-8b9d53aa374e",
                                        "glosses": [
                                            "Genugtuung (durch Duell oder Ehrenerklärung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f97e746-2927-4bcd-81c6-6d23ee751339",
                                                "sense_id": "41865133-bef7-374b-a66f-5b05d599cdc0",
                                                "text": "„Das berühmteste Opfer eingeforderter Satisfaktion ist und bleibt aber Alexander Puschkin.“"
                                            },
                                            {
                                                "example_id": "8dc6daae-ed01-4c55-8690-63a512e294ec",
                                                "sense_id": "41865133-bef7-374b-a66f-5b05d599cdc0",
                                                "text": "„In Madrid wurde kein einziges Duell ausgetragen, ohne daß mein Vater die Förmlichkeiten dafür festgelegt hätte, und sobald er erklärte, daß hinlänglich Genugtuung erteilt worden sei, hielt jeder der Duellanten die Satisfaktion für ausreichend.“"
                                            }
                                        ],
