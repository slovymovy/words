                    {
                        "translation_id": "84f2381a-1c6b-4108-b714-1da249a0f2eb",
                        "source_entry_id": "17b89909-4805-3f50-b644-cc505ac0b09d",
                        "source_sense_id": "433c5c76-021d-35ec-8968-fd013693812b",
