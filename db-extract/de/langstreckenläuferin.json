                    {
                        "sense_id": "cefa399c-0960-360e-9d52-a1568b02a26e",
                        "entry_id": "613975d9-2be0-32f7-b984-7f8c2b8a4467",
                        "glosses": [
                            "Sportlerin, die sich auf Langstrecken spezialisiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8ceafba-7091-4828-9529-4d5654f0d3b6",
                                "sense_id": "cefa399c-0960-360e-9d52-a1568b02a26e",
                                "text": "Monika ist eine begabte Langstreckenläuferin."
                            },
                            {
                                "example_id": "c46c9e02-e715-43b4-9ac3-fba25e19789e",
                                "sense_id": "cefa399c-0960-360e-9d52-a1568b02a26e",
                                "text": "„Gardi hatte bereits mit Zweiunddreißig, noch bevor ihr sportlicher Höhepunkt erreicht war, ihre Karriere als Langstreckenläuferin aufgegeben.“"
                            },
                            {
                                "example_id": "472036b3-6032-41a0-bc5c-edd747da6312",
                                "sense_id": "cefa399c-0960-360e-9d52-a1568b02a26e",
                                "text": "„Langstreckenläuferin Konstanze Klosterhalfen bricht einen deutschen Rekord nach dem anderen und gehört zur Weltspitze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
