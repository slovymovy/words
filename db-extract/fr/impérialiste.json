            {
                "entry_id": "3b91c308-d3e5-3d46-8742-9651c6849b1b",
                "word": "impérialiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78fce924-63a2-409e-b0c8-97eea586596c",
                        "entry_id": "3b91c308-d3e5-3d46-8742-9651c6849b1b",
                        "tags": [
                            "plural"
                        ],
                        "form": "impérialistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b68c6a6-960b-3433-b59d-e63cfefb1593",
                        "entry_id": "3b91c308-d3e5-3d46-8742-9651c6849b1b",
                        "glosses": [
                            "Partisan du régime politique impérial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d04adeb-c08a-4bad-805e-bddbdde82d8d",
                                "sense_id": "7b68c6a6-960b-3433-b59d-e63cfefb1593",
                                "text": "Impérialiste convaincu, il gardait en lui-même la religion du passé ; les fautes de l’Empire lui restaient cachées ; […]."
                            },
                            {
                                "example_id": "529557e2-22ca-4cbe-b5d5-0bf0405105b3",
                                "sense_id": "7b68c6a6-960b-3433-b59d-e63cfefb1593",
                                "text": "L'entente était plus complète encore entre les boulangistes et les plébiscitaires du prince Napoléon. Les plébiscitaires n'avaient pas d'influence électorale comparable à celle des impérialistes, mais ils possédaient à Paris une organisation assez forte comportant des comités d'arrondissement et de quartier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "658c0c4d-d664-4901-8086-bbc443c689ab",
                        "source_entry_id": "3b91c308-d3e5-3d46-8742-9651c6849b1b",
                        "source_sense_id": "7b68c6a6-960b-3433-b59d-e63cfefb1593",
                        "target_lang_word": "Imperialist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Imperialist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ee8ed56-a0c6-31b7-b144-c4b065601858",
                                        "entry_id": "b2d170b1-40d7-3f7b-93de-7911e55c5131",
                                        "glosses": [
                                            "Anhänger/Vertreter des Imperialismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdceab0a-77d3-4a47-a0aa-48528a006e6f",
                                                "sense_id": "7ee8ed56-a0c6-31b7-b144-c4b065601858",
                                                "text": "„Die kaisertreuen Imperialisten wollten das ausgedehnte Gebiet zu einer Siedlungskolonie machen, in die Arbeitslose aus dem Reich einwandern sollten.“"
                                            },
                                            {
                                                "example_id": "5128c98c-7b8a-41d5-bf78-f3039168f9d4",
                                                "sense_id": "7ee8ed56-a0c6-31b7-b144-c4b065601858",
                                                "text": "„Doch zu jener Zeit profilierte sich Winston Churchill als harter Imperialist, der Indien allenfalls eine «provincial autonomy», also die Bildung indischer Landesregierungen bei voller Erhaltung der britisch-indischen Zentralmacht, gewähren wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3b1645d-6f99-4d64-92ad-5ee966d9269a",
                        "source_entry_id": "3b91c308-d3e5-3d46-8742-9651c6849b1b",
