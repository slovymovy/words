            {
                "entry_id": "134ef4d5-90bf-3d82-9372-16f72eb2a887",
                "word": "Lulu",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b112cac7-2b3d-45fc-a032-7986b3087f7c",
