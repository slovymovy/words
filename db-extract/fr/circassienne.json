                                        "glosses": [
                                            "Angehörige des kaukasischen Volks der Tscherkessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b90cb4-01ff-4163-be04-fec7284749c2",
                                                "sense_id": "a8667258-8873-3ae8-91ef-23b2bd9a3a07",
                                                "text": "Die gebürtige Tscherkessin lebt seit vielen Jahren in Moskau."
