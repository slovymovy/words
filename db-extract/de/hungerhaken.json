                ],
                "senses": [
                    {
                        "sense_id": "988bd2c4-4cc0-3169-ae52-f0292048998b",
                        "entry_id": "8391f5de-7ce6-3fea-b401-6223c1c1a630",
                        "glosses": [
                            "dünner, schwächlicher Mensch"
                        ],
                        "tags": [
                            "herablassend"
                        ],
                        "examples": [
                            {
                                "example_id": "881b468a-b6f6-4255-a0ae-406aa299b2e3",
                                "sense_id": "988bd2c4-4cc0-3169-ae52-f0292048998b",
                                "text": "Dich Hungerhaken braucht man ja nur umzupusten!"
                            },
                            {
                                "example_id": "76a414ab-350b-4872-831d-c326f482218f",
                                "sense_id": "988bd2c4-4cc0-3169-ae52-f0292048998b",
                                "text": "Die Ära der Supermodels fing […] in den 60ern an: Verushka, […] Twiggy und Jean Shrimpton waren die ersten der hübschen Hungerhaken."
                            },
                            {
                                "example_id": "572b5d74-6055-4844-ad51-101ac6c487f3",
                                "sense_id": "988bd2c4-4cc0-3169-ae52-f0292048998b",
                                "text": "Gleich am Eingang […] läuft ein Film, der auf den flüchtigen Blick eine ganz normale Modenschau zeigt: In glamouröser Szenerie stolzieren schick gekleidete Hungerhaken über einen Catwalk."
                            },
                            {
                                "example_id": "023cb9a4-6b00-49db-a6a2-ece28c0faa25",
                                "sense_id": "988bd2c4-4cc0-3169-ae52-f0292048998b",
                                "text": "Das medial vermittelte Schönheitsideal stellt eher den \"Hungerhaken\" als attraktiv dar. \"Magermodels\" werden nach wie vor gebucht."
                            },
                            {
                                "example_id": "deecd4bf-7468-49ea-b5e3-4ebf8923b0fa",
                                "sense_id": "988bd2c4-4cc0-3169-ae52-f0292048998b",
                                "text": "Hungerhaken die ihre Kleider auf dem Laufsteg präsentieren? Davon hält Christa de Carouge nicht viel: „Die Epoche der magersüchtigen Models ist vorbei, das darf nicht mehr sein“, sagt sie am Rande der «Mode Suisse» […]"
                            },
                            {
                                "example_id": "042f7030-6167-4aee-a1db-90146cb042fe",
                                "sense_id": "988bd2c4-4cc0-3169-ae52-f0292048998b",
                                "text": "Nachdem man De Niro als drahtigen Hungerhaken in Filmen wie \"Hexenkessel\" und \"Taxi Driver\" kennengelernt hatte, verblüffte der Amerikaner sein Publikum 1980 mit einem scheinbar ganz anderen Körper: Für das Boxerdrama \"Wie ein wilder Stier\" hatte der Schauspieler etliche Kilos zugelegt, um überzeugend auch den alternden Boxer Jake LaMotta zu spielen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
