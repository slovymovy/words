        "fr-extract.jsonl": [
            {
                "entry_id": "11a28497-352b-3e01-81c4-7db2098ca4b6",
                "word": "solstice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cadbd6ff-d8ad-427c-a10c-34aec2ede79a",
                        "entry_id": "11a28497-352b-3e01-81c4-7db2098ca4b6",
                        "tags": [
                            "plural"
                        ],
                        "form": "solstices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a591db3-6c6e-39dd-aa8d-82260330d176",
                        "entry_id": "11a28497-352b-3e01-81c4-7db2098ca4b6",
                        "glosses": [
                            "Chacune des deux époques où le Soleil est arrivé à son plus grand éloignement de l’équateur et paraît être stationnaire pendant quelques jours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c8838e-be22-4380-a751-68a7a9bf8e2b",
                                "sense_id": "7a591db3-6c6e-39dd-aa8d-82260330d176",
                                "text": "Les solstices marquent les moments de l’année où les hémisphères reçoivent des quantités de lumière solaire les plus contrastées – et que les jours et les nuits sont les plus inégaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "22e5ce60-3f4b-3baa-bf00-ecd7abc7c7af",
                        "entry_id": "11a28497-352b-3e01-81c4-7db2098ca4b6",
                        "glosses": [
                            "Jour comprenant cet évènement, dont le jour (par opposition à la nuit) est le plus long ou le plus court dans une année."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3fa40612-4335-4cc3-b22a-ec5d2a9c5fe6",
                                "sense_id": "22e5ce60-3f4b-3baa-bf00-ecd7abc7c7af",
                                "text": "Le calendrier chinois est luni-solaire, c’est-à-dire qu’il est basé sur l’année solaire débutant au solstice d’hiver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "148e715c-7de8-48cf-9007-6716633df715",
                        "source_entry_id": "11a28497-352b-3e01-81c4-7db2098ca4b6",
                        "target_lang_word": "Solstitium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Solstitium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c37b8eaa-6d8b-3b8e-a8d7-b2f468076619",
                                        "entry_id": "50479a6f-5920-3d55-b953-cbc27acdc558",
                                        "glosses": [
                                            "Zeitpunkt, zu dem die Sonne im Laufe eines Sonnenjahres die größte nördliche oder südliche Deklination erreicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87b4c3f6-2a2e-47e8-bb69-a3db0c7e38a9",
                                                "sense_id": "c37b8eaa-6d8b-3b8e-a8d7-b2f468076619",
                                                "text": "„Als Humboldt kurz darauf seine Instrumente einpackte, wußte er, daß die Sonne am Tag des Solstitiums von der Chaussee aus gesehen genau über der Spitze der größten Pyramide auf- und durch die Spitze der zweitgrößten unterging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4acb5382-93a1-4fe5-9d65-f06c3424aff4",
                        "source_entry_id": "11a28497-352b-3e01-81c4-7db2098ca4b6",
                        "target_lang_word": "Sonnenwende",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenwende",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da913602-1412-3c45-afc6-fe063f7bcc4c",
                                        "entry_id": "33b47476-0685-3a76-8126-4e38585ff541",
                                        "glosses": [
                                            "Zeitpunkt, zu dem die Sonne im Laufe eines Sonnenjahres die größte nördliche oder südliche Deklination erreicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3288956-6a7f-41f7-b072-b08c994d7382",
                                                "sense_id": "da913602-1412-3c45-afc6-fe063f7bcc4c",
                                                "text": "Die Sonnenwende wird hier groß gefeiert."
                                            },
                                            {
                                                "example_id": "815609c8-aed4-4bd9-a0f4-e6e974b0b755",
                                                "sense_id": "da913602-1412-3c45-afc6-fe063f7bcc4c",
                                                "text": "„Vieles spricht dafür, dass Harald sich im Winter 1065 dem großen Julfest um die Zeit der Sonnenwende widmen kann, ohne an den nächsten Kriegszug zu denken.“"
                                            },
                                            {
                                                "example_id": "1b1a8ed8-d317-4d41-b62f-fcd80ff75bf6",
                                                "sense_id": "da913602-1412-3c45-afc6-fe063f7bcc4c",
                                                "text": "„In das Innere der Kathedrale, das wir wenige Tage vor der Sonnenwende besuchen, fließt ein unglaubliches Licht, ein sanfter magnetischer Strom.“"
                                            },
                                            {
                                                "example_id": "c4dcb7a1-1e9c-4e04-826c-e764b693e20f",
                                                "sense_id": "da913602-1412-3c45-afc6-fe063f7bcc4c",
                                                "text": "„Es war um die Zeit der Sonnenwende; ich hatte also nur zwei Stunden vor mir und verlor auch keine einzige Minute; sie verflogen in wiederholten Beweisen des Feuers, das mich nach der göttlichen Frau verzehrte, die ich überzeugt war, in den Armen zu halten.“"
                                            },
                                            {
                                                "example_id": "53cbd603-4a84-41c8-b36f-db9e928c7de9",
                                                "sense_id": "da913602-1412-3c45-afc6-fe063f7bcc4c",
                                                "text": "„Der Forscher Wolfgang Zäck betrachtete in einem 1992 erschienenen Büchlein den Goloring als Kalender: Wichtige Festtage, insbesondere die Sonnenwenden, seien durch Bergkuppen, Grabhügel ud Menhire markiert, die man vom Kreisinnern aus anpeilte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f463e1df-b3e7-3e01-93ae-d45d9083ec41",
                                        "entry_id": "33b47476-0685-3a76-8126-4e38585ff541",
                                        "glosses": [
                                            "deutscher Name für die Pflanze Heliotrop (Heliotropium), die ihre Blütenstände der Sonne zuwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796401ac-db3f-43b8-afba-54a03fdfa919",
                                                "sense_id": "f463e1df-b3e7-3e01-93ae-d45d9083ec41",
                                                "text": "Da kommt eine Reihe Sonnenwende hin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00bb8d88-20eb-48a2-99ad-6446deb103ef",
                        "source_entry_id": "11a28497-352b-3e01-81c4-7db2098ca4b6",
