                "senses": [
                    {
                        "sense_id": "a8eea573-a5ba-3300-b491-9b440e7f580e",
                        "entry_id": "636f9a31-f223-3020-ac2c-39c52de64519",
                        "glosses": [
                            "Variante de bléser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "837557ba-e936-48a2-9528-c42d10935255",
                                "sense_id": "a8eea573-a5ba-3300-b491-9b440e7f580e",
                                "text": "Qu’on ne se méprenne pas, blaiser (pour les non-spécialistes), cela équivaut à zézayer c’est-à-dire substituer une consonne faible à une consonne forte en prononçant par exemple : un pizon pour un pigeon, une zerbe pour une gerbe, un zob pour un job."
                            },
                            {
                                "example_id": "3af10c6c-3fa3-454a-8392-bc7e2b332a92",
                                "sense_id": "a8eea573-a5ba-3300-b491-9b440e7f580e",
                                "text": "Dans le même roman, George Sand parle de blaiser la romance du saule."
                            }
                        ]
                    }
