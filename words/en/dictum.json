{
    "word_family": [
        "dictate",
        "dictation",
        "dictatorial",
        "diction",
        "dictionary",
        "dictator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b2acfef-0171-339c-9ffe-2e36fdd9a955",
                    "sense_definition": "An authoritative, formal statement or maxim expressing a general truth or principle.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager frequently quoted the famous <w>dictum</w> that time is money.",
                            "target_lang_translations": {
                                "ru": "Управляющий часто цитировал известное <w>изречение</w> о том, что время — деньги."
                            }
                        },
                        {
                            "text": "Her entire philosophy of life seemed based on an ancient Latin <w>dictum</w>.",
                            "target_lang_translations": {
                                "ru": "Вся её жизненная философия, казалось, основывалась на древнем латинском <w>афоризме</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "maxim",
                        "saying",
                        "proverb",
                        "adage",
                        "aphorism",
                        "motto"
                    ],
                    "common_phrases": [
                        "famous dictum",
                        "old dictum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Авторитетное официальное высказывание, афоризм или максима, выражающие общую истину или принцип."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изречение",
                                "target_lang_sense_clarification": "афоризм, мудрая мысль"
                            },
                            {
                                "target_lang_word": "афоризм",
                                "target_lang_sense_clarification": "краткое емкое выражение"
                            },
                            {
                                "target_lang_word": "сентенция",
                                "target_lang_sense_clarification": "нравоучительное высказывание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c6d78ff-501d-306d-a1a0-6269607c37cf",
                    "sense_definition": "A formal remark or opinion expressed by a judge that is not essential to the court's final decision.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer argued that the judge's comment was merely a <w>dictum</w> and therefore not legally binding.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что комментарий судьи был лишь <w>попутным замечанием</w> и потому не имел обязательной юридической силы."
                            }
                        },
                        {
                            "text": "Although included in the ruling, that controversial statement is regarded as judicial <w>dictum</w>.",
                            "target_lang_translations": {
                                "ru": "Хотя это спорное утверждение и вошло в текст решения, оно рассматривается как попутное судебное <w>замечание</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "obiter dictum"
                    ],
                    "common_phrases": [
                        "judicial dictum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Попутное замечание или особое мнение судьи, не являющееся обязательным основанием судебного решения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попутное замечание судьи",
                                "target_lang_sense_clarification": "юридический термин (obiter dictum)"
                            },
                            {
                                "target_lang_word": "мнение судьи",
                                "target_lang_sense_clarification": "необязательное для прецедента суждение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}