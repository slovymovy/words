                "senses": [
                    {
                        "sense_id": "e228a6eb-b0d3-36d0-961f-5602e315726d",
                        "entry_id": "3ac7a9c0-f354-3d38-8364-ca8a793b8554",
                        "glosses": [
                            "In conformance to, or in agreement with; used with to."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11c62a4a-a6bc-4ff2-809b-bed85075f687",
                                "sense_id": "e228a6eb-b0d3-36d0-961f-5602e315726d",
                                "text": "And pursuant to this idea of a holiday, he insisted upon playing cards after we had eaten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d594609-d49c-42c1-bab9-876dde666e18",
                        "source_entry_id": "3ac7a9c0-f354-3d38-8364-ca8a793b8554",
                        "source_sense_id": "e228a6eb-b0d3-36d0-961f-5602e315726d",
                        "source_sense_description": "in conformance to, or in agreement with",
                        "target_lang_word": "en conformité avec",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3e2ccb70-f684-4a09-9b96-297d237c19ab",
                        "source_entry_id": "3ac7a9c0-f354-3d38-8364-ca8a793b8554",
                        "source_sense_id": "e228a6eb-b0d3-36d0-961f-5602e315726d",
                        "source_sense_description": "in conformance to, or in agreement with",
                        "target_lang_word": "gemäß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gemäß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13df98ae-0230-35f6-b3f3-aa2ddba33675",
                                        "entry_id": "7317fd90-7d40-3dba-9396-baf5a307f1b1",
                                        "glosses": [
                                            "jemandem oder einer Sache angemessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c446f57-3d21-42de-ac07-388788e28eab",
                                                "sense_id": "13df98ae-0230-35f6-b3f3-aa2ddba33675",
                                                "text": "Sie sucht eine ihren Qualifikationen gemäße Arbeitsstelle."
                                            },
                                            {
                                                "example_id": "12439afe-e280-4695-96da-4cecf39d0388",
                                                "sense_id": "13df98ae-0230-35f6-b3f3-aa2ddba33675",
                                                "text": "Wir haben Formen der äußeren sowohl als inneren sinnlichen Anschauung a priori an den Vorstellungen von Raum und Zeit, und diesen muß die Synthesis der Apprehension des Mannigfaltigen der Erscheinung jederzeit gemäß sein, weil sie selbst nur nach dieser Form geschehen kann. (Immanuel Kant, Kritik der reinen Vernunft, § 26, z.n. Projekt Gutenberg)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "gemäß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d710c1cc-0e44-330a-a310-ccc022e78870",
                                        "entry_id": "fd368c50-b56a-3a95-8a3a-4e6a37e48194",
                                        "glosses": [
                                            "entsprechend, zufolge, nach"
                                        ],
                                        "tags": [
                                            "Präposition mit Dativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3b340af-49e6-45d7-a1d9-81ff8e037184",
                                                "sense_id": "d710c1cc-0e44-330a-a310-ccc022e78870",
                                                "text": "Gemäß seinem Wunsch wurde auf der Feier kein Alkohol getrunken."
                                            },
                                            {
                                                "example_id": "45916273-986c-43c3-8727-dc733cb19682",
                                                "sense_id": "d710c1cc-0e44-330a-a310-ccc022e78870",
                                                "text": "Ist aber die Natur dem Sittengesetze gemäß, so würde ja dieses durch das Handeln, durch das Aufheben des Seienden verletzt. (Georg Wilhelm Friedrich Hegel, Phänomenologie des Geistes, VI, C, b, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "1fc05cd6-8244-4ac0-8e34-8482c72edfc2",
                                                "sense_id": "d710c1cc-0e44-330a-a310-ccc022e78870",
                                                "text": "Gemäß § 41 GmbHG sind die Geschäftsführer verpflichtet, für eine ordnungsgemäße Buchführung der Gesellschaft zu sorgen."
                                            },
                                            {
                                                "example_id": "4f10724b-08f3-4331-8b99-0e708f3d3c64",
                                                "sense_id": "d710c1cc-0e44-330a-a310-ccc022e78870",
                                                "text": "„Die deutsche Luftwaffe greift die italienische Schlachtflotte an, die den Waffenstillstandsbedingungen mit den Alliierten gemäß von La Spezia nach Malta ausgelaufen ist, und versenkt das Schlachtschiff \"Roma\".“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
