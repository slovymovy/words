                "senses": [
                    {
                        "sense_id": "5f81475b-5668-3a98-8aac-932f5f0a97b5",
                        "entry_id": "0df793e2-6d8d-31ae-8dc1-f217b18a5f00",
                        "glosses": [
                            "Que l’on peut abaisser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fbd3d7d-94ae-485f-ad50-7883bf56a535",
                                "sense_id": "5f81475b-5668-3a98-8aac-932f5f0a97b5",
                                "text": "Le 29 décembre 2016, une nouvelle réglementation interdira la fabrication, la vente et l’importation de lits d’enfant ayant des côtés abaissables conventionnels ainsi que toute publicité à leur sujet."
                            },
                            {
                                "example_id": "ff2d093d-e841-4c93-8611-15cb4cd423c5",
                                "sense_id": "5f81475b-5668-3a98-8aac-932f5f0a97b5",
                                "text": "Dans le placard qui le surplombe, un panier manuellement abaissable permettant d’accéder aux objets ou denrées rangés en hauteur."
                            },
                            {
                                "example_id": "b5db4418-3564-447e-b783-e84a000e6e1d",
                                "sense_id": "5f81475b-5668-3a98-8aac-932f5f0a97b5",
                                "text": "La remorque abaissable est idéale pour le transport de véhicules et s’abaisse même – selon le modèle – jusqu’au niveau du sol."
                            }
                        ]
                    }
                ],
