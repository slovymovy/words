{
    "word_family": [
        "appetite",
        "appetizing",
        "appetizingly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e74f4319-beed-38be-80c8-29de02fb40ed",
                    "sense_definition": "A small, light, and usually savory first course in a meal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_course",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered garlic bread as an <w>appetizer</w> before having our pasta.",
                            "target_lang_translations": {
                                "pl": "Zamówiliśmy pieczywo czosnkowe jako <w>przystawkę</w> przed makaronem."
                            }
                        },
                        {
                            "text": "The waiter brought a tasty <w>appetizer</w> to the table while we waited.",
                            "target_lang_translations": {
                                "pl": "Kelner przyniósł do stolika smaczną <w>przekąskę</w>, podczas gdy czekaliśmy."
                            }
                        }
                    ],
                    "synonyms": [
                        "starter",
                        "hors d'oeuvre",
                        "entrée",
                        "appy"
                    ],
                    "common_phrases": [
                        "serve an appetizer",
                        "order an appetizer"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niewielkie danie serwowane przed posiłkiem głównym w celu pobudzenia apetytu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przystawka",
                                "target_lang_sense_clarification": "danie podawane przed posiłkiem głównym"
                            },
                            {
                                "target_lang_word": "zakąska",
                                "target_lang_sense_clarification": "drobna potrawa serwowana przed posiłkiem lub do alkoholu"
                            },
                            {
                                "target_lang_word": "czekadełko",
                                "target_lang_sense_clarification": "darmowa, mała przekąska podawana w restauracji w oczekiwaniu na danie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "135900a2-5b60-3d30-83ad-cd54cf5a0cb6",
                    "sense_definition": "Something that creates or increases excitement for what is to follow.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The short preview was just an <w>appetizer</w> for the upcoming movie.",
                            "target_lang_translations": {
                                "pl": "Krótki zwiastun był tylko <w>przedsmakiem</w> nadchodzącego filmu."
                            }
                        },
                        {
                            "text": "The band played an acoustic track as an <w>appetizer</w> before the main concert.",
                            "target_lang_translations": {
                                "pl": "Zespół zagrał utwór akustyczny jako <w>przedsmak</w> przed głównym koncertem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "just an appetizer"
                    ],
                    "target_lang_definitions": {
                        "pl": "Coś, co rozbudza ciekawość lub zainteresowanie tym, co ma dopiero nadejść."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przedsmak",
                                "target_lang_sense_clarification": "wstęp zapowiadający coś większego"
                            },
                            {
                                "target_lang_word": "zapowiedź",
                                "target_lang_sense_clarification": "coś, co zwiastuje nadchodzące wydarzenie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}