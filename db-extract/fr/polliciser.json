                "senses": [
                    {
                        "sense_id": "f758efa4-e61d-38fa-8d6f-6964f6f13389",
                        "entry_id": "dbcad215-1f7f-3463-8def-0ff1887280bd",
                        "glosses": [
                            "Faire jouer à un autre doigt le rôle du pouce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c43cd04-9437-4932-b4ed-d46a54c5df0e",
                                "sense_id": "f758efa4-e61d-38fa-8d6f-6964f6f13389",
                                "text": "En cas d'index sain, le choix du doigt à polliciser est alors fonction à la fois des habitudes de l'opérateur et du choix du patient."
                            },
                            {
                                "example_id": "9624a04c-e077-4a3b-8961-05531222a6ef",
                                "sense_id": "f758efa4-e61d-38fa-8d6f-6964f6f13389",
                                "text": "Au niveau de la main, polliciser un doigt sain, c'est redistribuer une chaîne digitale en créant un pouce fonctionnellement performant mais qui laissera pour séquelle une main moins large, donc moins puissante lors du verrouillage."
                            }
                        ]
                    }
