                    },
                    {
                        "translation_id": "2273b4b0-33da-49dc-acc0-e0507dae7f27",
                        "source_entry_id": "ecfcb367-cf19-3f63-a087-76ae3fa6858c",
                        "source_sense_description": "of a theory, argument etc: capable of being maintained or justified; well-founded",
                        "target_lang_word": "haltbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haltbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d2e7893-ae81-39a1-9d34-7d374d8dee31",
                                        "entry_id": "d5191bf1-138e-3ff9-a78a-81c37a29bf68",
                                        "glosses": [
                                            "über einen längeren Zeitraum brauchbar, genießbar sein (Lebensmittel, Medikamente und Ähnliches)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9f859b-953e-40ce-a22d-e647b7b628d6",
                                                "sense_id": "9d2e7893-ae81-39a1-9d34-7d374d8dee31",
                                                "text": "Misten Sie jedes Jahr mindestens einmal Ihre Hausapotheke aus, denn Arzneimittel sind nicht unbegrenzt haltbar!"
                                            },
                                            {
                                                "example_id": "bf729f1d-667d-4460-9b48-ff99b981c5f6",
                                                "sense_id": "9d2e7893-ae81-39a1-9d34-7d374d8dee31",
                                                "text": "„Das Ragout kann in Gläser abgefüllt werden, dann bleibt es eine Woche haltbar. Heiß ins Glas geben, Glas auf den Kopf stellen, damit ein Vakuum entsteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "819f4a82-d7d7-3b8b-b2f0-bbc3d290500b",
                                        "entry_id": "d5191bf1-138e-3ff9-a78a-81c37a29bf68",
                                        "glosses": [
                                            "über einen längeren Zeitraum seinen guten Zustand behaltend (Kleidung, Möbel und Ähnliches)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c83d6076-6ab5-4b13-93d9-2d90d3117e25",
                                                "sense_id": "819f4a82-d7d7-3b8b-b2f0-bbc3d290500b",
                                                "text": "Die massive Schrankwand ist zwar potthässlich, dafür aber so haltbar, dass noch die Urenkel eine Freude an ihr haben können."
                                            },
                                            {
                                                "example_id": "f4d368b5-8b65-4267-af56-a75c499d4e86",
                                                "sense_id": "819f4a82-d7d7-3b8b-b2f0-bbc3d290500b",
                                                "text": "„Mehr als 5.500 Exemplare des ASR-Hüftsystems des amerikanischen Herstellers DePuy waren allein in Deutschland eingesetzt worden. Es sollte ein besonders widerstandsfähiger und lange haltbarer Gelenkersatz sein. Doch bereits nach sechs Jahren waren 29 Prozent der Implantate mürbe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f0ce572d-2b9e-3355-9cad-b658787d3293",
                                        "entry_id": "d5191bf1-138e-3ff9-a78a-81c37a29bf68",
                                        "glosses": [
                                            "Bestand habend, sich beibehalten, aufrechterhalten lassend, von Dauer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f1a63f8-f603-4849-bcb3-d625bcfcdab2",
                                                "sense_id": "f0ce572d-2b9e-3355-9cad-b658787d3293",
                                                "text": "Die Anschuldigungen waren nach den Zeugenaussagen nicht mehr haltbar."
                                            },
                                            {
                                                "example_id": "9bdbdfe9-a447-4cb4-8665-08cccaf9df31",
                                                "sense_id": "f0ce572d-2b9e-3355-9cad-b658787d3293",
                                                "text": "Ob der vereinbarte Waffenstillstand haltbar ist, wird sich in den kommenden Wochen herausstellen."
                                            },
                                            {
                                                "example_id": "c0a033ac-4e34-46b2-8b3c-6b2176d0e939",
                                                "sense_id": "f0ce572d-2b9e-3355-9cad-b658787d3293",
                                                "text": "„Waters hält seine Artefakte nun für die ersten haltbaren Gegenbeweise der Theorie, dass die Clovis-Menschen die ersten Amerikaner waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "504ef34a-724e-38ab-93ca-b00909b10e30",
                                        "entry_id": "d5191bf1-138e-3ff9-a78a-81c37a29bf68",
                                        "glosses": [
                                            "(gesagt von einem Wurf, einem Schuss) die Möglichkeit der Abwehr bietend, da zu unplatziert oder zu schwach gespielt"
                                        ],
                                        "tags": [
                                            "Ballspiele"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5e1aef1-73a8-474f-832a-35ec1fb4a7f3",
                                                "sense_id": "504ef34a-724e-38ab-93ca-b00909b10e30",
                                                "text": "Das war ein haltbarer Elfmeter."
                                            },
                                            {
                                                "example_id": "186907f2-b224-4d7d-b419-157eccc91fb0",
                                                "sense_id": "504ef34a-724e-38ab-93ca-b00909b10e30",
                                                "text": "„Schon zu diesem frühen Zeitpunkt im Halbfinal-Hinspiel der Champions League hatte der Schalker Torhüter die Engländer offenbar so sehr beeindruckt, dass sie die direkte Konfrontation mit ihm scheuten. Neuer hielt auch in der Folge alle haltbaren und unhaltbaren Bälle. Bis zur 67. Minute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
