                "senses": [
                    {
                        "sense_id": "1ab2e5e5-400f-3d0c-a56d-eca11426e43e",
                        "entry_id": "2e696bda-6a28-3aa7-b21c-81f3dc291780",
                        "glosses": [
                            "Inflammation d’un ou des sinus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "135ffda9-4a6e-42d0-a19b-7d210be90a26",
                                "sense_id": "1ab2e5e5-400f-3d0c-a56d-eca11426e43e",
                                "text": "Depuis vingt-quatre ans, M. B… souffrait d’une sinusite frontale qui avait nécessité onze opérations !! Malgré tout la sinusite persistait, accompagnée de douleurs intolérables."
                            },
                            {
                                "example_id": "409811c1-29a3-44f7-be00-e38220d9481a",
                                "sense_id": "1ab2e5e5-400f-3d0c-a56d-eca11426e43e",
                                "text": "Blandine mijotait dans sa fièvre, au lit, avec une bonne grippe, compliquée d’une sinusite frontale si tenace qu’il fallut, pour la traiter, lui faire poser des tuyaux dans le nez."
                            }
                        ]
                    }
                ],
