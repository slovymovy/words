                ],
                "senses": [
                    {
                        "sense_id": "abdd8afc-e6c1-3474-827d-065cdfeb9cae",
                        "entry_id": "01bf358f-aae7-388e-b966-2408bc9a1ea8",
                        "glosses": [
                            "Tisch, auf dem Billard gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7faafd95-b624-4937-a1e2-218363121d51",
                                "sense_id": "abdd8afc-e6c1-3474-827d-065cdfeb9cae",
                                "text": "Die Größe der Spielfläche eines Billardtisches ist genau festgelegt."
                            },
                            {
                                "example_id": "c12ed235-e823-42c1-97a7-e0d5e4d7103f",
                                "sense_id": "abdd8afc-e6c1-3474-827d-065cdfeb9cae",
                                "text": "„Die Ausgaben für Billardtisch, Wuzzler (beide in Miniaturausführung), Espressomaschine und möglicherweise bald auch einen Beamer werden geteilt.“"
                            },
                            {
                                "example_id": "114e8ab9-c93b-4427-8b0e-6fe265d3bb3d",
                                "sense_id": "abdd8afc-e6c1-3474-827d-065cdfeb9cae",
                                "text": "„Der Billardtisch wirkt weniger dunkel.“"
                            },
                            {
                                "example_id": "9fdc3bef-a820-4b74-bc9f-d211658a11ce",
                                "sense_id": "abdd8afc-e6c1-3474-827d-065cdfeb9cae",
                                "text": "„Es liegt in der Natur begründet, daß Fortuna mit einem Menschen, der sich ihren Launen überläßt, das gleiche tut, wie ein kleines Kind mit einer Elfenbeinkugel auf einem Billardtisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
