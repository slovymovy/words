                    {
                        "sense_id": "bee1aae3-3999-333e-b75f-0908583e339e",
                        "entry_id": "e7379d43-1fb7-3973-b0ee-bbec68d03ca7",
                        "glosses": [
                            "Pièce où l'on vit."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "d2c456fc-4c26-4789-ae03-00459412a6cb",
                                "sense_id": "bee1aae3-3999-333e-b75f-0908583e339e",
                                "text": "Recevoir des amis dans le vivoir."
                            },
                            {
                                "example_id": "5f6345d4-71ee-4745-8160-b082507ea881",
                                "sense_id": "bee1aae3-3999-333e-b75f-0908583e339e",
                                "text": "Malheureusement, tandis que nous chipotions dans nos assiettes, les enfants ne décollaient pas du vivoir, attendant Gonzague et m'empêchant ainsi de parler à Bertille dont les regards affichaient de l'inquiétude."
                            }
                        ]
                    }
                ],
