                    {
                        "form_id": "dc4659a6-de5f-4874-97ed-7f89ca066e75",
                        "entry_id": "85937dcd-3213-3589-94e0-2f1a0c1f37a1",
                        "tags": [
                            "partitive",
                            "positive"
                        ],
                        "form": "alomvattends"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "890e5a31-e370-3fda-b84c-4cb041fc0844",
                        "entry_id": "85937dcd-3213-3589-94e0-2f1a0c1f37a1",
                        "glosses": [
                            "compleet, alles bij elkaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f24b7b4-81d4-4c28-926a-1893bfeeea71",
                                "sense_id": "890e5a31-e370-3fda-b84c-4cb041fc0844",
                                "text": "Om de groei van Amsterdam in goede banen te leiden, wilde het stadsbestuur toen een alomvattend plan voor de stadsuitbreidingen. Daartoe werd de Dienst Stadsontwikkeling opgericht, die pas na jarenlange sociaal-economische onderzoeken in 1935 met het (A)lomvattend (U)itbreidingsP(lan) kwam."
                            },
                            {
                                "example_id": "e43534ea-47b9-4b31-aa01-4d2ee94d8882",
                                "sense_id": "890e5a31-e370-3fda-b84c-4cb041fc0844",
                                "text": "Te midden van een alomvattende onzekerheid was de Gute Hoffnung een bolwerk, een rots in de branding."
                            },
                            {
                                "example_id": "8b61e855-cada-4420-8121-612ebf21958d",
                                "sense_id": "890e5a31-e370-3fda-b84c-4cb041fc0844",
                                "text": "Op dat moment drong het tot me door dat ik een eerste stap had gezet op een pad dat me zou wegvoeren uit de alomvattende ellende waarin ik de laatste weken had geleefd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05de63bd-da75-4973-8618-f8b49c260a9f",
                        "source_entry_id": "85937dcd-3213-3589-94e0-2f1a0c1f37a1",
                        "source_sense_id": "890e5a31-e370-3fda-b84c-4cb041fc0844",
                        "source_sense_description": "compleet, alles bij elkaar",
                        "target_lang_word": "comprehensive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comprehensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6c3549-7caa-3ad4-bf01-10ae535a5a76",
                                        "entry_id": "98fda171-b43e-35af-8f88-78a32256fd01",
                                        "glosses": [
                                            "Broadly or completely covering; including a large proportion of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc1e84ea-b6b9-4f1d-b4f1-34d2c5a972f7",
                                                "sense_id": "ee6c3549-7caa-3ad4-bf01-10ae535a5a76",
                                                "text": "When there are diametrically opposing views on a big issue that concerns millions of people, doing comprehensive research just makes sense."
                                            },
                                            {
                                                "example_id": "29459872-bb3b-4f17-b620-088a22beff4b",
                                                "sense_id": "ee6c3549-7caa-3ad4-bf01-10ae535a5a76",
                                                "text": "Nevertheless, the comprehensive comparative analysis of pumpkin viromes across various geographic regions by NGS remains deficient."
                                            },
                                            {
                                                "example_id": "6fcdde41-5867-4e9f-a77a-92eec9dcbe75",
                                                "sense_id": "ee6c3549-7caa-3ad4-bf01-10ae535a5a76",
                                                "text": "So what is it that makes SBB (Swiss national railways) tick? In my humble opinion, two things. Firstly, a comprehensive and set-in-stone integrated timetable (incorporating trains, ferries, cable cars and buses, including the world-famous yellow 'post-autos'), compiled four years in advance and which gets tested twice before it becomes operational."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comprehensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dcf2341-7e6e-3020-9315-d51a58e22a7d",
                                        "entry_id": "10b5e4a3-7f2d-345d-a2cf-17670b0a42c4",
                                        "glosses": [
                                            "A comprehensive school."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93fca2fd-bc17-4576-bf75-3ab7cdf8a03f",
                                                "sense_id": "6dcf2341-7e6e-3020-9315-d51a58e22a7d",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
