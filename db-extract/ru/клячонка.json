                        "examples": [
                            {
                                "example_id": "47d80b86-bbd7-4b73-86db-85a64bd21686",
                                "sense_id": "51a365c5-c392-32e9-b66c-fc9982f17368",
                                "text": "Клячонка рвётся, и вот он начинает сечь её, беззащитную, по плачущим, по «кротким глазам»."
                            },
                            {
                                "example_id": "ba3c0d44-64c4-4ac6-bc4c-dda480cf32ed",
                                "sense_id": "51a365c5-c392-32e9-b66c-fc9982f17368",
                                "text": "Мимо окна проехал четырёхугольный ящик, который везла плохая, заморенная клячонка."
                            }
                        ]
                    }
