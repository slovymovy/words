                "senses": [
                    {
                        "sense_id": "8c034ec8-88fe-31bd-b1e2-ec4a7141faa1",
                        "entry_id": "ada4d3e2-8416-360b-a43a-d4e2c490e689",
                        "glosses": [
                            "Relatif à l'histoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac53b96-8310-4957-8f4a-dddea034315f",
                                "sense_id": "8c034ec8-88fe-31bd-b1e2-ec4a7141faa1",
                                "text": "Il faut s’interroger sur la haute capacité d’érudition de l’Occident industriel, sur la signification stratégique du savoir historisant qui permet de revenir sur le passé, c'est-à-dire de le refouler d’une manière moderne en l’épurant. Pierre Legendre, Leçons II."
                            },
                            {
                                "example_id": "e4671445-806a-4da6-95fa-368c5cd1b65f",
                                "sense_id": "8c034ec8-88fe-31bd-b1e2-ec4a7141faa1",
                                "text": "Le crime sexuel réalise un crime contre toutes les humanités. Il efface les constructions historisantes de l’ontogenèse et de la phylogenèse. Sa contingence est transculturelle, transconfessionnelle et transhistorique."
                            }
                        ]
                    },
                    {
                        "sense_id": "51f636a1-e947-3392-8b39-ec4738452016",
                        "entry_id": "ada4d3e2-8416-360b-a43a-d4e2c490e689",
                        "glosses": [
                            "Relatif à l'historique (de fichiers informatiques par exemple)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11433379-9890-41df-b1fb-f6178a3d1ede",
                                "sense_id": "51f636a1-e947-3392-8b39-ec4738452016",
                                "text": "L' instruction /log donne une partition contenant les journaux historisants."
                            }
                        ]
                    },
                    {
                        "sense_id": "2781ec21-4305-33eb-beb4-85d4b35a5b5d",
                        "entry_id": "ada4d3e2-8416-360b-a43a-d4e2c490e689",
                        "glosses": [
                            "Traditionnel, passéiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3411bcb8-5630-4aae-96e4-2993b8198d31",
                                "sense_id": "2781ec21-4305-33eb-beb4-85d4b35a5b5d",
                                "text": "La devise latine « Veritas - Iustitia - Libertas » (Vérité, Justice, Liberté) marque la distance idéologique [de la nouvellement fondée Université libre de Berlin] à l'égard de la vieille université berlinoise dominée par le communisme, et un sceau historisant la rattache à sa tradition."
                            }
                        ]
                    }
                ],
