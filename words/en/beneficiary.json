                                "target_lang_word": "бенефициар",
                                "target_lang_sense_clarification": "в юридическом контексте"
                            },
                            {
                                "target_lang_word": "выгодоприобретатель",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "tr": [
