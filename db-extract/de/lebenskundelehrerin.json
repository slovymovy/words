                "senses": [
                    {
                        "sense_id": "dc38f404-27cc-35c4-92ea-33051e307cac",
                        "entry_id": "8e118999-39e1-3535-8a8f-c2b0f3f70cad",
                        "glosses": [
                            "Lehrerin, die das Fach Lebenskunde unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc084eb-62af-404b-8316-385a6a4a51cb",
                                "sense_id": "dc38f404-27cc-35c4-92ea-33051e307cac",
                                "text": "„Die Theater-AGs, die Werklehrerinnen, die Kunstlehrerinnen und, in auffälliger Zahl, die Lebenskundelehrerinnen der benachbarten Schulen fanden Kontakt zu der Kollegin, die es geschafft hatte, ihren Direktor an der Seite des Schulamtleiters so hübsch derangiert aussehen zu lassen.“"
                            },
                            {
                                "example_id": "42c0e0f6-4ee7-4597-832f-919c79f3cedc",
                                "sense_id": "dc38f404-27cc-35c4-92ea-33051e307cac",
                                "text": "„Sie ist Lebenskundelehrerin und Lerntherapeutin. Frau Christiane Sprenger unterrichtet das Fach seit 2015 und ist Lebenskundelehrerin.“"
                            },
                            {
                                "example_id": "e56b4435-1442-4c40-b223-a8d1c5cf9912",
                                "sense_id": "dc38f404-27cc-35c4-92ea-33051e307cac",
                                "text": "„Unter Leitung ihrer Lebenskundelehrerin Jeanette Eggert entwickelten Schüler Ideen, was sie sich in künftigen Schwimmhallen alles wünschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
