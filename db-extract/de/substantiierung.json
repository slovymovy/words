                        "sense_id": "a4869322-a366-389b-b242-29f459b2de14",
                        "entry_id": "af619336-d2c7-3301-b11a-96dd65876104",
                        "glosses": [
                            "inhaltliche Ausfüllung zum Beispiel einer Behauptung mit gewissen Einzelheiten oder eines Begehrens mit bestimmten Gründen"
                        ],
                        "tags": [
                            "Prozessrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "f8345d9f-1085-409e-9cec-992b56de9c3f",
                                "sense_id": "a4869322-a366-389b-b242-29f459b2de14",
                                "text": "„Die Substantiierung erfordert regelmäßig die Vorlage eines gewissen Mindestanforderungen genügenden fachärztlichen Attestes, aus dem sich nachvollziehbar ergeben muss, auf welcher Grundlage der Arzt zu seiner Diagnose gelangt ist und wie sich die Krankheit im konkreten Fall darstellt.“"
                            },
                            {
                                "example_id": "d76a9869-b023-492d-8d02-e7d74f815454",
                                "sense_id": "a4869322-a366-389b-b242-29f459b2de14",
                                "text": "„Differenzierende Substantiierungen sind insoweit schon deswegen rechtlich gefordert, weil die dem Antragsteller über viele Jahre bescheinigten hervorragenden Leistungen gerade in derjenigen Abteilung erbracht worden sind, in der der Beförderungsdienstposten zu vergeben ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
