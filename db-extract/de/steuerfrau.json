                                        "glosses": [
                                            "Celle qui tient la barre du gouvernail."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e802b5ef-0376-444d-bd68-67bea1557781",
                                                "sense_id": "5f3785f1-4f5a-311f-b868-0ddc167749a0",
                                                "text": "Pareilles à des fleurs étranges, à des fleurs qui nageraient, les ombrelles de soie rouge, verte, bleue ou jaune des barreuses s’épanouissaient à l’arrière des canots."
                                            },
                                            {
                                                "example_id": "1f3aead7-59db-4f11-8354-69db3dd4d8f1",
                                                "sense_id": "5f3785f1-4f5a-311f-b868-0ddc167749a0",
                                                "text": "La barreuse le réoriente aussitôt et les rameurs décuplent leurs efforts pour accélérer derechef."
                                            }
                                        ]
                                    }
                                ]
                            }
