                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db70a285-cdce-3928-9f33-bbd5c51e0d9a",
                                        "entry_id": "04a66bab-24b1-3338-a901-4d862bdbdae0",
                                        "glosses": [
                                            "Frauenhasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb213dad-fa10-4007-875f-a12a69dbdc01",
                                                "sense_id": "db70a285-cdce-3928-9f33-bbd5c51e0d9a",
                                                "text": "„Brunis Verdacht, Percy könnte ein Misogyn oder sogar schwul sein, hat Isolde aufgrund seines Umgangs mit den anderen weiblichen Wesen des Seminars von sich gewiesen, das vor allem wegen der in keiner Weise berührungsfreien Flirts mit seiner taxodiumrot geflammten Assistentin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c7e3f54-f104-4c8a-9298-9235b88396d4",
                        "source_entry_id": "b6aacfc1-b7b1-3d2f-8b09-aac82c159db5",
                        "source_sense_id": "e296715b-f8da-3afb-a796-384547393feb",
                        "target_lang_word": "Weiberfeind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weiberfeind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf68d4ae-ddf6-30bf-a88e-86b4bea41570",
                                        "entry_id": "3188bbc5-ff6f-3ad1-9afa-f7c287758705",
                                        "glosses": [
                                            "Person, die Frauen nicht mag; Person, die eine sehr starke Abneigung gegen Frauen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7eb5a28-3843-4dda-89b3-13c2770e9698",
                                                "sense_id": "cf68d4ae-ddf6-30bf-a88e-86b4bea41570",
                                                "text": "„Seine Zuhörerschaft bestand denn auch nur aus Frauen; trotzdem war er ein geschworener Weiberfeind, und er sah niemals einer ins Gesicht, wenn er mit ihr sprechen mußte.“"
                                            },
                                            {
                                                "example_id": "7dde01e2-fe04-46e8-8600-a6c60f35c75d",
                                                "sense_id": "cf68d4ae-ddf6-30bf-a88e-86b4bea41570",
                                                "text": "„Man sieht, daß Wilhelm Busch, vielfach als Weiberfeind verschrien, sich auch noch als zweiunddreißigjähriger, immer noch junger Mann am sommerlichen Funkenregen einer jugendlichen Verliebtheit begeistern konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
