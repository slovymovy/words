                                "target_senses": [
                                    {
                                        "sense_id": "91d580a6-5997-3424-85a3-bc33a82d8b6d",
                                        "entry_id": "ec506c49-7a29-338e-bf64-3622cd780750",
                                        "glosses": [
                                            "The property of being sonorous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7f3c341-76b4-4094-9cfc-34453d8c1746",
                                                "sense_id": "91d580a6-5997-3424-85a3-bc33a82d8b6d",
                                                "text": "Another quality that bothers me is Brendel's inconsistent sonority. The treble is hard and pingy; the midrange is weighed down with a booming bass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8f33d4c-4be2-3473-8a95-dbc3376661f4",
                                        "entry_id": "ec506c49-7a29-338e-bf64-3622cd780750",
                                        "glosses": [
                                            "Relative loudness (of a speech sound); degree of being sonorous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "643cb855-3b51-45b7-b619-c7e13abd7123",
                                                "sense_id": "a8f33d4c-4be2-3473-8a95-dbc3376661f4",
                                                "text": "It can be seen that vowels have the highest sonority of all phonemes in English, with low vowels being even more sonorous than high vowels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
