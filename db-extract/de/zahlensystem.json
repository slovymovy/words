                ],
                "senses": [
                    {
                        "sense_id": "014fcbd5-8ea9-36a5-9a72-22367e26b823",
                        "entry_id": "e55db11b-adb5-3f6e-b2d8-a3482f06ba14",
                        "glosses": [
                            "sayı sistemi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f6b8da5-1be3-4697-add3-411ea8e6f5bd",
                                "sense_id": "014fcbd5-8ea9-36a5-9a72-22367e26b823",
                                "text": "Leider wissen viele nicht, dass es in den jeweiligen Sprachen große Unterschiede im Zahlensystem geben kann.",
                                "translation": "Maalesef birçokları farklı lisanlardaki sayı sistemlerinde büyük farklılıklar olabileceğini bilmiyor."
                            },
                            {
                                "example_id": "4b1b46ce-4659-4890-a466-f5111e17ba94",
                                "sense_id": "014fcbd5-8ea9-36a5-9a72-22367e26b823",
                                "text": "Die alten Römer verwendeten ein anderes Zahlensystem als wir heute.",
                                "translation": "Eski Romalılar, bugün kullandığımızdan farklı bir sayı sistemi kullanıyordu."
                            },
                            {
                                "example_id": "042a43b7-5ce6-421a-8a02-93d299f62b1b",
                                "sense_id": "014fcbd5-8ea9-36a5-9a72-22367e26b823",
                                "text": "„Das Zahlensystem sollte so sein, dass man mit den dargestellten Zahlen effizient rechnen kann.“",
                                "translation": "Sayı sistemi, gösterilen sayılarla verimli hesaplama yapılabilecek şekilde olmalıdır."
                            },
                            {
                                "example_id": "1d99d1a5-051e-4ca0-976b-cac865c3cf7b",
                                "sense_id": "014fcbd5-8ea9-36a5-9a72-22367e26b823",
                                "text": "„Vor allem zwei Leistungen im Feld der Mathematik sind es, mit denen der Name Leibniz unmittelbar in Zusammenhang gebracht wird: das duale oder auch dyadisch oder binär genannte Zahlensystem und die Infinitesimalrechnung.“",
                                "translation": "Özellikle matematik alanında Leibniz adının doğrudan ilişkilendirildiği iki başarı vardır: ikili sayı sistemi ve sonsuz küçükler hesabı."
                            }
                        ]
                    }
                ],
