                "senses": [
                    {
                        "sense_id": "60c6aa74-cf21-34bd-bd92-64a7126de315",
                        "entry_id": "49328cd2-a957-3157-9b91-919b8b4b515b",
                        "glosses": [
                            "мед. связанный с воспалительным поражением тканей, органов и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3e28215-2724-472e-ad66-9089a6b2386f",
                                "sense_id": "60c6aa74-cf21-34bd-bd92-64a7126de315",
                                "text": "Клиническое течение интерстициальной болезни лёгких при ревматоидном артрите бывает как очень медленным (в течение 10 лет), так и фульминантным."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a22fbb23-e726-4e38-9bcd-b6a0b4a8d9b0",
                        "source_entry_id": "49328cd2-a957-3157-9b91-919b8b4b515b",
                        "source_sense_id": "60c6aa74-cf21-34bd-bd92-64a7126de315",
                        "target_lang_word": "rheumatoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rheumatoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6e0397e-f289-34e4-92e7-6c425cf7984c",
                                        "entry_id": "140c0e90-653b-3887-a9cf-f07edfed7d76",
                                        "glosses": [
                                            "Involving or pertaining to rheumatism, especially rheumatoid arthritis."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f73f7e3-0049-4e50-84ad-0af8d263edf4",
                                                "sense_id": "b6e0397e-f289-34e4-92e7-6c425cf7984c",
                                                "text": "Rheumatoid sufferers have such pain and discomfort every day of their lives that they live eternally in high hopes of something effective turning up."
                                            },
                                            {
                                                "example_id": "fd1bd7f9-372e-468b-8358-7747839a7b5a",
                                                "sense_id": "b6e0397e-f289-34e4-92e7-6c425cf7984c",
                                                "text": "Juvenile rheumatoid arthritis (JRA), often referred to by doctors today as juvenile idiopathic arthritis (JIA), is a type of arthritis that causes joint inflammation and stiffness for more than six weeks in a child aged 16 or younger. It affects approximately 50,000 children in the United States. Inflammation causes redness, swelling, warmth, and soreness in the joints, although many children with JRA do not complain of joint pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76bb154c-8b8e-32bc-9e3b-58d652ce4958",
                                        "entry_id": "140c0e90-653b-3887-a9cf-f07edfed7d76",
                                        "glosses": [
                                            "Presenting analogies with rheumatism."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rheumatoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdcbf8f7-9d0d-31a9-b9bd-c74e74105c27",
                                        "entry_id": "f64771fe-1946-3e88-8d54-75bd8a6b4c40",
                                        "glosses": [
                                            "A person with rheumatoid arthritis."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f558b42-4794-4e78-b789-bfb7edaf6c8d",
                                                "sense_id": "cdcbf8f7-9d0d-31a9-b9bd-c74e74105c27",
                                                "text": "The highly significant findings with regard to hurt feelings suggests that the hypothesis that rheumatoids learn to hide their hurt feelings [7] and are reticent about expressing their dissatisfactions [4] may be correct."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
