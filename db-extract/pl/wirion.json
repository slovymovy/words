                                    {
                                        "sense_id": "541c1c8a-073c-35ee-a45e-95dba6630657",
                                        "entry_id": "83d6f4d0-a47f-3cec-b0e7-4a12a2d90526",
                                        "glosses": [
                                            "Particule extracellulaire infectieuse d’un virus sans activité métabolique, qui sert au transport du matériel génétique d’un virus avant l’intégration de celui-ci dans une cellule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dedf3709-ad39-4167-a081-b1f5367b2118",
                                                "sense_id": "541c1c8a-073c-35ee-a45e-95dba6630657",
                                                "text": "Or, si l’on sait infecter des tissus de Tabac cultivés in vitro avec des virions ⁽³⁾, aucune tentative n’a été faite pour viroser des cultures de tissus avec l’ARN du VMT et vérifier si les colonies éventuellement infectées restaient virosés après des repiquages successifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "021912cc-6e98-4f54-9144-80e037528b96",
                        "source_entry_id": "e8792b5f-08e9-3724-b18c-dd4fed022009",
                        "source_sense_id": "aee69fdc-5fb6-32ac-953e-78e94e48366f",
                        "target_lang_word": "virión",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "488f14e0-81d5-44c9-ada8-4e0928e516ed",
                        "source_entry_id": "e8792b5f-08e9-3724-b18c-dd4fed022009",
                        "source_sense_id": "aee69fdc-5fb6-32ac-953e-78e94e48366f",
                        "target_lang_word": "Virion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Virion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15fd932a-2e92-3485-9956-62e116340980",
                                        "entry_id": "6749f4a3-ff2e-3fda-ae00-dd9eeadf2270",
                                        "glosses": [
                                            "reifes, infektiöses Virus, das außerhalb der Wirtszelle vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "561f7a66-42fb-42da-8759-f2dda769c503",
                                                "sense_id": "15fd932a-2e92-3485-9956-62e116340980",
                                                "text": "„Im Gegensatz hierzu neutralisiert das korrespondierende Antiserum das Virion, da es mit den Antigenen des Hüllproteins reagiert; das gleiche Antiserum ist ohne jeden Einfluß auf die infektiöse Nucleinsäure, die aus dem Virion isoliert wurde.“"
                                            },
                                            {
                                                "example_id": "581290a2-1339-4398-8f11-857d9a594e27",
                                                "sense_id": "15fd932a-2e92-3485-9956-62e116340980",
                                                "text": "„Das Virion wird zum bösen Virus, und unterwirft sie zur Zwangsarbeit.“"
                                            },
                                            {
                                                "example_id": "68831e57-6d17-478d-8db1-062ed03165cb",
                                                "sense_id": "15fd932a-2e92-3485-9956-62e116340980",
                                                "text": "„Mit dem S-Protein bindet das Virion an die Zellmembran der Wirtszelle.“"
                                            },
                                            {
                                                "example_id": "dc828281-cfff-413d-b0bb-5f7bdaa633c9",
                                                "sense_id": "15fd932a-2e92-3485-9956-62e116340980",
                                                "text": "„Merkwürdigerweise enthält das Virion Ribosomen, die durch Mitnahme aus der Zelle in das Virion gelangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
