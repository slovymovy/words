{
    "word_family": [
        "eyewitness",
        "witness-box",
        "witness-stand"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a990047f-cfac-32a2-a6a7-87ef9f858381",
                    "sense_definition": "To see or gain knowledge of an event through personal experience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>witnessed</w> the accident while walking home from work yesterday.",
                            "target_lang_translations": {
                                "ru": "Он <w>стал свидетелем</w> аварии, когда вчера шел домой с работы."
                            }
                        },
                        {
                            "text": "Many people gathered to <w>witness</w> the event and celebrate the victory.",
                            "target_lang_translations": {
                                "ru": "Множество людей собралось, чтобы <w>увидеть</w> это событие и отпраздновать победу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "witness the event",
                        "witness the change",
                        "witness the dawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Видеть или узнавать о событии на основе личного опыта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть свидетелем",
                                "target_lang_sense_clarification": "события или происшествия"
                            },
                            {
                                "target_lang_word": "видеть",
                                "target_lang_sense_clarification": "своими глазами"
                            },
                            {
                                "target_lang_word": "застать",
                                "target_lang_sense_clarification": "какой-либо момент или эпоху"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7096aa9b-1ae4-3c34-85cd-80ade82200ef",
                    "sense_definition": "To see the signing of a legal document and sign it yourself to verify its authenticity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer asked her to <w>witness</w> a signature on the new contract.",
                            "target_lang_translations": {
                                "ru": "Адвокат попросил её <w>засвидетельствовать</w> подпись на новом контракте."
                            }
                        },
                        {
                            "text": "You need two people to <w>witness</w> the deed for it to be valid.",
                            "target_lang_translations": {
                                "ru": "Вам нужно два человека, чтобы <w>заверить</w> акт, чтобы он был действителен."
                            }
                        }
                    ],
                    "synonyms": [
                        "certify"
                    ],
                    "common_phrases": [
                        "witness a signature",
                        "witness a deed",
                        "witness a will"
                    ],
                    "target_lang_definitions": {
                        "ru": "Присутствовать при подписании юридического документа и поставить свою подпись для подтверждения его подлинности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засвидетельствовать",
                                "target_lang_sense_clarification": "подпись или документ"
                            },
                            {
                                "target_lang_word": "удостоверить",
                                "target_lang_sense_clarification": "подлинность документа"
                            },
                            {
                                "target_lang_word": "подписать в качестве свидетеля",
                                "target_lang_sense_clarification": "официально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ec8aa0c-6dad-3f76-86e4-36fb1ce32476",
                    "sense_definition": "To serve as evidence of something or to show proof.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This certificate <w>witnesses</w> his presence at the seminar on that day.",
                            "target_lang_translations": {
                                "ru": "Этот сертификат <w>подтверждает</w> его присутствие на семинаре в тот день."
                            }
                        },
                        {
                            "text": "His tired eyes <w>witnessed</w> the huge affliction and dismay he felt.",
                            "target_lang_translations": {
                                "ru": "Его усталые глаза <w>свидетельствовали</w> о глубоком страдании и смятении, которые он испытывал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "witness his presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить доказательством чего-либо или демонстрировать подтверждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "о чем-либо, служить доказательством"
                            },
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "факт или состояние"
                            },
                            {
                                "target_lang_word": "говорить о",
                                "target_lang_sense_clarification": "указывать на что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d56e5414-e669-3dd8-a133-b9beb15c3a06",
                    "sense_definition": "Used in the imperative to introduce an example that proves a point.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economy is struggling in many sectors; <w>witness</w> the recent decline in retail sales.",
                            "target_lang_translations": {
                                "ru": "Экономика испытывает трудности во многих секторах; <w>взять хотя бы</w> недавний спад розничных продаж."
                            }
                        },
                        {
                            "text": "Depression often goes undetected until it is too late; <w>witness</w> the recent tragedy.",
                            "target_lang_translations": {
                                "ru": "Депрессия часто остается незамеченной, пока не становится слишком поздно; <w>посмотрите на</w> недавнюю трагедию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "witness the recent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в повелительном наклонении для введения примера, подтверждающего мысль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взять хотя бы",
                                "target_lang_sense_clarification": "в качестве примера"
                            },
                            {
                                "target_lang_word": "посмотрите на",
                                "target_lang_sense_clarification": "в качестве доказательства"
                            },
                            {
                                "target_lang_word": "вспомните",
                                "target_lang_sense_clarification": "недавний случай"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11206374-f695-30bf-b1a4-1df4f43a8571",
                    "sense_definition": "To give a religious testimony or preach about one's faith.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The missionaries went from door to door to <w>witness</w> to the local community.",
                            "target_lang_translations": {
                                "ru": "Миссионеры ходили от двери к двери, чтобы <w>свидетельствовать</w> о своей вере местным жителям."
                            }
                        },
                        {
                            "text": "He felt a strong calling to <w>witness</w> his faith to everyone he met.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал сильное призвание <w>проповедовать</w> свою веру каждому встречному."
                            }
                        }
                    ],
                    "common_phrases": [
                        "witness to faith"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать религиозное свидетельство или проповедовать о своей вере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "о своей вере"
                            },
                            {
                                "target_lang_word": "проповедовать",
                                "target_lang_sense_clarification": "религиозные убеждения"
                            },
                            {
                                "target_lang_word": "нести слово Божье",
                                "target_lang_sense_clarification": "религиозный контекст"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0055dea-907a-353d-8843-4f43e26bfaf5",
                    "sense_definition": "A person who sees an event happen or has personal knowledge of it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are looking for an eye <w>witness</w> who saw the robbery.",
                            "target_lang_translations": {
                                "ru": "Полиция ищет <w>очевидца</w>, который видел ограбление."
                            }
                        },
                        {
                            "text": "As a <w>witness</w> to the event, I can confirm exactly what happened.",
                            "target_lang_translations": {
                                "ru": "Как <w>свидетель</w> происшествия, я могу точно подтвердить, что случилось."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eye witness",
                        "witness to the event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который видит происходящее событие или обладает личными знаниями о нем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетель",
                                "target_lang_sense_clarification": "очевидец события"
                            },
                            {
                                "target_lang_word": "очевидец",
                                "target_lang_sense_clarification": "непосредственный наблюдатель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dfb55a0-8790-347e-922f-3d60d7124ca3",
                    "sense_definition": "A person who is called to provide evidence or testimony in a court of law.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>witness</w> for the prosecution gave a very convincing statement.",
                            "target_lang_translations": {
                                "ru": "<w>Свидетель</w> со стороны обвинения дал очень убедительные показания."
                            }
                        },
                        {
                            "text": "The judge asked the <w>witness</w> to tell the truth during the trial.",
                            "target_lang_translations": {
                                "ru": "Судья попросил <w>свидетеля</w> говорить правду во время процесса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prosecution witness",
                        "defense witness",
                        "expert witness",
                        "call a witness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, вызванное для дачи показаний или предоставления доказательств в суде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетель",
                                "target_lang_sense_clarification": "в судебном процессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cebfee7-e105-388a-985a-b36a7c9a018d",
                    "sense_definition": "A person who watches the signing of a document or a ceremony to confirm it took place.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They needed a <w>witness</w> to sign the marriage certificate at the wedding.",
                            "target_lang_translations": {
                                "ru": "Им нужен был <w>свидетель</w>, чтобы подписать свидетельство о браке на свадьбе."
                            }
                        },
                        {
                            "text": "The best man usually serves as a <w>witness</w> during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Шафер обычно выступает в качестве <w>свидетеля</w> во время церемонии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wedding witness",
                        "serve as witness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, присутствующий при подписании документа или на церемонии для подтверждения факта их совершения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетель",
                                "target_lang_sense_clarification": "на свадьбе или при сделке"
                            },
                            {
                                "target_lang_word": "понятой",
                                "target_lang_sense_clarification": "при официальном осмотре или обыске"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f537f06e-abb5-3157-b8c0-0ea5103ec1d8",
                    "sense_definition": "The act of providing testimony or attestation of a fact or event.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "testimony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was able to bear <w>witness</w> to the truth because she was there.",
                            "target_lang_translations": {
                                "ru": "Она смогла <w>засвидетельствовать</w> правду, потому что была там."
                            }
                        },
                        {
                            "text": "The old building stands as a silent <w>witness</w> to the city's long history.",
                            "target_lang_translations": {
                                "ru": "Старое здание стоит как безмолвный <w>свидетель</w> долгой истории города."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bear witness",
                        "silent witness",
                        "give witness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт предоставления показаний или подтверждения факта или события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетельство",
                                "target_lang_sense_clarification": "подтверждение факта"
                            },
                            {
                                "target_lang_word": "показания",
                                "target_lang_sense_clarification": "свидетельские"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08d220df-1c43-312e-bd3f-820174d9a866",
                    "sense_definition": "An object or sign that serves as evidence of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ruins are a <w>witness</w> to the greatness of the past civilization.",
                            "target_lang_translations": {
                                "ru": "Древние руины являются <w>свидетельством</w> величия прошлой цивилизации."
                            }
                        },
                        {
                            "text": "Let this stone heap be a <w>witness</w> of the agreement we made today.",
                            "target_lang_translations": {
                                "ru": "Пусть эта груда камней будет <w>подтверждением</w> соглашения, которое мы заключили сегодня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "be witness",
                        "stand as witness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или знак, который служит доказательством чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетельство",
                                "target_lang_sense_clarification": "неодушевленное доказательство"
                            },
                            {
                                "target_lang_word": "памятник",
                                "target_lang_sense_clarification": "в значении немого свидетеля истории"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "24dc6ace-0acf-321e-accd-c580abd5f6ee",
                    "sense_definition": "A member of the Jehovah's Witnesses religious group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been a devout <w>Witness</w> for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Он является преданным <w>Свидетелем</w> уже более двадцати лет."
                            }
                        },
                        {
                            "text": "The <w>Witnesses</w> often visit neighborhoods to share their religious beliefs.",
                            "target_lang_translations": {
                                "ru": "<w>Свидетели</w> часто посещают жилые районы, чтобы поделиться своими религиозными убеждениями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Jehovah's Witness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член религиозной организации «Свидетели Иеговы»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Свидетель",
                                "target_lang_sense_clarification": "Иеговы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}