                "senses": [
                    {
                        "sense_id": "85445173-c86d-3d96-b206-92b2d34135e8",
                        "entry_id": "a5b7ec39-160f-33f3-bc26-809be8c42c00",
                        "glosses": [
                            "Korn des Pollens^([1])"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "9019b602-f22e-4c98-91b3-89b8f6325b2f",
                                "sense_id": "85445173-c86d-3d96-b206-92b2d34135e8",
                                "text": "Bisher galt die Polle als klassischer Allergieauslöser im Sommer. (Internetbeleg)"
                            },
                            {
                                "example_id": "47d5d812-dc9a-4139-bd6b-7475b120a9b0",
                                "sense_id": "85445173-c86d-3d96-b206-92b2d34135e8",
                                "text": "„Eine Polle, dachte sie automatisch. Eine Polle des Ätzzitronenbaumes. Die Polle ähnelte einem Papierdrachen, war fast quadratisch, und der frische Morgenwind pfiff unter die Tragfläche aus dünn gewebten Pflanzenfasern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe9da01b-8a92-4945-9468-7e14abbde442",
                        "source_entry_id": "a5b7ec39-160f-33f3-bc26-809be8c42c00",
                        "source_sense_id": "85445173-c86d-3d96-b206-92b2d34135e8",
                        "target_lang_word": "pollen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pollen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16c394d3-963d-3174-a8ea-95e80dccff07",
                                        "entry_id": "bc930704-7420-315f-8a88-08ce2e2f215e",
                                        "glosses": [
                                            "A fine, granular substance produced in flowers."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8915a108-07df-3b07-ac0b-2949607e70a5",
                                        "entry_id": "bc930704-7420-315f-8a88-08ce2e2f215e",
                                        "glosses": [
                                            "Pollen grains (microspores) produced in the anthers of flowering plants."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "689f7cf6-9904-41e9-97d4-14865c731bb9",
                                                "sense_id": "8915a108-07df-3b07-ac0b-2949607e70a5",
                                                "text": "In plants, the ability to recognize self from nonself plays an important role in fertilization, because self-fertilization will result in less diverse offspring than fertilization with pollen from another individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68178c3c-2ac9-3998-83ce-532ef1b79253",
                                        "entry_id": "bc930704-7420-315f-8a88-08ce2e2f215e",
                                        "glosses": [
                                            "Fine powder in general, fine flour."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee7aa3da-80d3-43e8-bfb7-1320c6f38235",
                                                "sense_id": "68178c3c-2ac9-3998-83ce-532ef1b79253",
                                                "text": "and ther was good wyne of Gascoyne,[…]as well of pollen, as of other vitailes"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pollen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c29a05f-9638-321b-b255-32c76375081d",
                                        "entry_id": "a3f585e9-f78f-390d-be38-40c3347d147b",
                                        "glosses": [
                                            "To cover with, or as if with, pollen."
                                        ],
