                "senses": [
                    {
                        "sense_id": "a53839f9-fcd7-3105-bdbd-9d3a5499d8f5",
                        "entry_id": "32992986-52ab-30ac-8c5f-c7d1d45e1e4f",
                        "glosses": [
                            "взять себе или унести, увезти с собой"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2ed194f1-6240-3b43-a492-4c939c92c23b",
                        "entry_id": "32992986-52ab-30ac-8c5f-c7d1d45e1e4f",
                        "glosses": [
                            "разг. взять, присвоить, захватить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c41ac3f-715b-4519-8519-506d0e993282",
                                "sense_id": "2ed194f1-6240-3b43-a492-4c939c92c23b",
                                "text": "Мебелишку, какая была у нас, хозяин за долг забрал."
                            },
                            {
                                "example_id": "e9b85f4f-84c4-48a3-9865-73b49c620e21",
                                "sense_id": "2ed194f1-6240-3b43-a492-4c939c92c23b",
                                "text": "Неприятель забрал все пограничные города."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5a03b3f-5824-31cb-a171-0a952cd39f57",
                        "entry_id": "32992986-52ab-30ac-8c5f-c7d1d45e1e4f",
                        "glosses": [
                            "разг. арестовать, задержать; захватить, взять (в плен, в неволю)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6beb1b73-c812-46e8-8345-d78165022582",
                                "sense_id": "b5a03b3f-5824-31cb-a171-0a952cd39f57",
                                "text": "Явилась полиция … кузнеца забрали и повели."
                            },
                            {
                                "example_id": "fb95aaef-9333-44ca-ac44-9dd2db5c2745",
                                "sense_id": "b5a03b3f-5824-31cb-a171-0a952cd39f57",
                                "text": "Забрать в солдаты."
                            },
                            {
                                "example_id": "35202c75-a86e-441b-9b8e-28172725c7db",
                                "sense_id": "b5a03b3f-5824-31cb-a171-0a952cd39f57",
                                "text": "В кабалу меня и забрал."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c578776-8b07-325d-bbd2-64d0e2721549",
                        "entry_id": "32992986-52ab-30ac-8c5f-c7d1d45e1e4f",
                        "glosses": [
                            "перен., разг. овладеть чьими-либо мыслями, чувствами, заполнить всё существо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e07f50f8-579d-4637-8904-062e7fdfdced",
                                "sense_id": "2c578776-8b07-325d-bbd2-64d0e2721549",
                                "text": "Взял жену, чтоб жить вдвоём, и вдвое забрала зевота."
                            },
                            {
                                "example_id": "f3a66a4b-509b-41ba-97b1-838db91114f5",
                                "sense_id": "2c578776-8b07-325d-bbd2-64d0e2721549",
                                "text": "Забрала охота (что-н. делать)."
                            }
                        ]
                    },
                    {
                        "sense_id": "01fe6ea4-057c-3092-bd7b-82a52ce487f6",
                        "entry_id": "32992986-52ab-30ac-8c5f-c7d1d45e1e4f",
                        "glosses": [
                            "разг. встретить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff6977d6-62db-4012-9271-2d76ce79c0fe",
                                "sense_id": "01fe6ea4-057c-3092-bd7b-82a52ce487f6",
                                "text": "Мне нужно, чтобы ты меня забрала со школы."
                            }
                        ]
                    },
                    {
                        "sense_id": "e754abdd-02ba-3613-a814-1f3633f3c2da",
                        "entry_id": "32992986-52ab-30ac-8c5f-c7d1d45e1e4f",
                        "glosses": [
                            "разг. безл. сильно подействовать, совсем захватить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f865d673-8d96-481e-9593-fa2aa922eff5",
                                "sense_id": "e754abdd-02ba-3613-a814-1f3633f3c2da",
                                "text": "Как его забрало́!"
                            },
                            {
                                "example_id": "224ae28e-fcc8-42d7-aeaf-741f9e690d80",
                                "sense_id": "e754abdd-02ba-3613-a814-1f3633f3c2da",
                                "text": "Забрало́ меня за живое ещё больше."
                            }
                        ]
                    },
                    {
                        "sense_id": "f23611b5-e439-36c3-89f5-5b0be6100b8a",
                        "entry_id": "32992986-52ab-30ac-8c5f-c7d1d45e1e4f",
                        "glosses": [
                            "швейн. немного подобрав, сузить, укоротить, уменьшить размеры чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f456cea4-7b87-4b3e-b61a-0775799466df",
                                "sense_id": "f23611b5-e439-36c3-89f5-5b0be6100b8a",
                                "text": "Забрать шов."
                            },
                            {
                                "example_id": "be780c22-1ba2-4bcd-9cf1-e90c02a969a8",
                                "sense_id": "f23611b5-e439-36c3-89f5-5b0be6100b8a",
                                "text": "Забрать в рукаве небольшой кусок."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f02dba9-f7f4-3935-8bcb-586366aa6fff",
                        "entry_id": "32992986-52ab-30ac-8c5f-c7d1d45e1e4f",
                        "glosses": [
                            "спец. заделать, заколотить, загородить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e812b4c0-c2f6-438f-a880-47f1b9bcc4dc",
                                "sense_id": "7f02dba9-f7f4-3935-8bcb-586366aa6fff",
                                "text": "Забрали окно до половины досками, чтоб нельзя было ничего видеть, кроме неба."
                            }
                        ]
                    },
