                        "glosses": [
                            "Any of a group of flagellate protozoa, of the class Choanoflagellatea, thought to be the closest unicellular ancestors of animals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f39e2f4f-0fc3-4579-bc95-25adeac979b6",
                                "sense_id": "88995a56-05b2-35f6-96d0-ce75a4a0d8be",
                                "text": "Choanoflagellates are plankton: tiny protozoans that feed on even tinier bacteria."
                            },
                            {
                                "example_id": "07fcbfe2-06a1-4989-a15c-6d0ca7d429d9",
                                "sense_id": "88995a56-05b2-35f6-96d0-ce75a4a0d8be",
                                "text": "Detailed studies showed that the sponge and the cells of a protist called a choanoflagellate used a different set of genes and proteins to build similar-looking structures."
                            }
                        ]
                    }
                ],
