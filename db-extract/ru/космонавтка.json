                                    {
                                        "sense_id": "a78483bf-e59b-3d36-9158-f8b083ca7417",
                                        "entry_id": "7c3450c5-4d1d-33f0-809f-a659ee78530c",
                                        "glosses": [
                                            "eine weibliche Person, die selbst Raumfahrt betreibt, sich im Weltraum bewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7626e985-3b1f-4708-ad93-9ea3deef867d",
                                                "sense_id": "a78483bf-e59b-3d36-9158-f8b083ca7417",
                                                "text": "„Der erste Flug einer weiblichen Raumfahrerin war ein weltweiter Prestigegewinn für die UdSSR.“"
                                            },
                                            {
                                                "example_id": "7247c802-6f94-4cb8-a68a-854ee93cf30f",
                                                "sense_id": "a78483bf-e59b-3d36-9158-f8b083ca7417",
                                                "text": "„Mittlerweile hat sie [Sunita Williams] sich insgesamt mehr als 40 Stunden außerhalb der ISS im Weltraum aufgehalten und damit länger als jede andere Raumfahrerin bisher.“"
                                            },
                                            {
                                                "example_id": "5034dae4-2a9d-446a-9882-24c09fd7dddf",
                                                "sense_id": "a78483bf-e59b-3d36-9158-f8b083ca7417",
                                                "text": "„Die chinesische Raumfahrtbehörde will ab dem kommenden Jahr Abiturientinnen die Ausbildung zu Raumfahrerinnen ermöglichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
