                        ],
                        "examples": [
                            {
                                "example_id": "7ca3fe4e-d314-48fc-be53-c6f2b8190029",
                                "sense_id": "66042913-a429-373c-9e08-b054832d261c",
                                "text": "Plus mystérieux que la fin de l’indépendance des Dembos, l’arasement de la résistance de ces Mbundu du Cuanza Sul n’est pas encore chronologiquement jalonnable."
                            },
                            {
                                "example_id": "11909f92-1ebd-4227-b702-120b266e0e6b",
                                "sense_id": "66042913-a429-373c-9e08-b054832d261c",
                                "text": "Ce faisceau d’horizons calcaréo-phosphatés et volcaniques renferme localement des débris de Cystidés primitifs et est jalonnable sur plus de 20 km dans la direction SW-NE, constituant ainsi un véritable marqueur lithostratigraphique."
                            },
                            {
                                "example_id": "c9f7a0d6-e159-490b-8d3e-42cd7b0dbc15",
                                "sense_id": "66042913-a429-373c-9e08-b054832d261c",
                                "text": "Nous proposons en annexe une liste de 11 continuités maillant les communes de l’agglomération et facilement jalonnables."
                            }
                        ]
                    }
