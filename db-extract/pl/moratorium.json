                    {
                        "sense_id": "b5946e0a-370f-3850-ae51-27293d4a9e5e",
                        "entry_id": "85ace51a-9e46-3852-b576-c0e73050f7a8",
                        "glosses": [
                            "czasowe wstrzymanie określonych działań ze względu na szczególne okoliczności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd9468ee-c9fb-4c79-b76a-667e2a39ada8",
                                "sense_id": "b5946e0a-370f-3850-ae51-27293d4a9e5e",
                                "text": "Optymizmu łupkoentuzjastów nie popsuł zatem ani wprowadzony właśnie zakaz wydobycia gazu łupkowego we Francji, ani przedłużenie moratorium obowiązującego w amerykańskim stanie Nowy Jork, ani rosnący w Kanadzie opór przed łupkowym przemysłem, a szczególnie przed najniebezpieczniejszą metodą szczelinowania hydraulicznego, która ma być stosowana w Polsce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f633ab25-ed80-423a-8422-5c5c62348555",
                        "source_entry_id": "85ace51a-9e46-3852-b576-c0e73050f7a8",
                        "source_sense_id": "b5946e0a-370f-3850-ae51-27293d4a9e5e",
                        "target_lang_word": "moratorium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moratorium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7277171-0731-34fc-be5c-a9ba28732945",
                                        "entry_id": "ed8b767f-7d11-30f0-bf6a-f93ce62a732c",
                                        "glosses": [
                                            "An authorization to a debtor, permitting temporary suspension of payments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                                        "entry_id": "ed8b767f-7d11-30f0-bf6a-f93ce62a732c",
                                        "glosses": [
                                            "A suspension of an ongoing activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8143a1b3-3f39-4568-b5a8-ff9cdb3bea40",
                                                "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                                                "text": "Canada may put a moratorium on cloning for research."
                                            },
                                            {
                                                "example_id": "24ccb446-6732-402f-b977-157c10802199",
                                                "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                                                "text": "It so happened that at that time the moratorium on the death penalty caused by the Supreme Court decision in the Furman case was still in effect."
                                            },
                                            {
                                                "example_id": "b4429f88-8f34-4638-a7c3-ca2682d6af17",
                                                "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                                                "text": "If such a pause cannot be enacted quickly, governments should step in and institute a moratorium."
                                            },
                                            {
                                                "example_id": "017e3379-d0cd-40b0-b000-ecb8167c0951",
                                                "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                                                "text": "Proponents of an AI moratorium had argued that a patchwork of state and local AI laws is hindering progress in the AI industry and the ability of U.S. firms to compete with China."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
