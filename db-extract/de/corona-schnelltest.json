                "senses": [
                    {
                        "sense_id": "033269b0-b99b-3bf7-886e-5ef3deb69efb",
                        "entry_id": "d8f36382-e245-39a2-a1f2-1e8017d0a274",
                        "glosses": [
                            "Prüfverfahren, mit dem auf einfache Weise in kurzer Zeit eine Infektion mit SARS-CoV-2 nachgewiesen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abc83634-b648-4a9f-8d57-49563c2f448e",
                                "sense_id": "033269b0-b99b-3bf7-886e-5ef3deb69efb",
                                "text": "„Jetzt müssen wir drei einen Corona-Schnelltest machen, um zu sehen, ob auch wir das Corona-Virus haben.“"
                            },
                            {
                                "example_id": "155fb7f5-dcef-40b9-8cc0-409adbd51cdf",
                                "sense_id": "033269b0-b99b-3bf7-886e-5ef3deb69efb",
                                "text": "„Wegen Terminanfragen für Corona-Schnelltests laufen Telefone in den Testzentren, bei Hausärzten und Apotheken heiß: Es fehlt aber an klaren Abläufen und Vorgaben zur Kostenübernahme.“"
                            },
                            {
                                "example_id": "bd6636b3-0cc6-4f05-9944-526ffcdf9926",
                                "sense_id": "033269b0-b99b-3bf7-886e-5ef3deb69efb",
                                "text": "„Corona-Schnelltests gelten als wichtige Waffe im Kampf gegen die Pandemie – und ein entsprechender Nachweis wird auch von Geimpften immer häufiger verlangt. Doch mit dem Angebot gibt es Probleme.“"
                            },
                            {
                                "example_id": "a18cba2e-8134-485c-ac84-3b7007a8bd01",
                                "sense_id": "033269b0-b99b-3bf7-886e-5ef3deb69efb",
                                "text": "„Eine Mitarbeiterin eines Testzentrums nimmt einen Nasenabstrich für einen Corona-Schnelltest.“"
                            },
                            {
                                "example_id": "8c47150e-5786-46cd-9299-114435ab8fbf",
                                "sense_id": "033269b0-b99b-3bf7-886e-5ef3deb69efb",
                                "text": "„Gerade war ich im Urlaub in Dänemark. Genau, im November. Das Programm: Keine Menschen treffen. Das hat gut geklappt, bis zu dem Morgen, an dem auf meinem Corona-Schnelltest nicht ein, sondern zwei Striche auftauchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
