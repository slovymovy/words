                },
                {
                    "sense_id": "ab0a8142-d4fb-3a68-bd86-a237f7923010",
                    "sense_definition": "Об ощущении сильного тепла или перегрева, испытываемом кем-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Открой окно, мне стало слишком <w>жарко</w>.",
