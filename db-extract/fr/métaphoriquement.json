                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metaphorically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2575d192-6515-37b8-ac77-36b71568e788",
                                        "entry_id": "8423a918-9b87-32bb-b252-5286c635f1ff",
                                        "glosses": [
                                            "In a metaphorical manner; not literally; by means of metaphor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15f7695b-0c02-4190-a423-f42d1d5442c4",
                                                "sense_id": "2575d192-6515-37b8-ac77-36b71568e788",
                                                "text": "He conveyed his teachings metaphorically."
                                            },
                                            {
                                                "example_id": "abcf953b-a694-4442-a6f7-d685bf3f9c47",
                                                "sense_id": "2575d192-6515-37b8-ac77-36b71568e788",
                                                "text": "[…] as, for example, in the present case of throwing herself, metaphorically speaking, at Mr Casaubon's feet, and kissing his unfashionable shoe-ties as if he were a Protestant Pope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a13a835f-d810-336e-8c97-042fe98c568c",
                                        "entry_id": "8423a918-9b87-32bb-b252-5286c635f1ff",
                                        "glosses": [
                                            "Used to draw attention that what follows is a metaphor, not to be taken literally"
                                        ],
                                        "tags": [
                                            "as a sentence adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2fd59d7-eb9f-4556-a9b1-6e29920728d3",
                                                "sense_id": "a13a835f-d810-336e-8c97-042fe98c568c",
                                                "text": "Metaphorically, he was crushed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5651b778-8435-482e-a031-92b1e9a7c976",
