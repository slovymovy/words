                                "example_id": "9b9d5b68-e547-4df5-a084-dadc93ab8eca",
                                "sense_id": "fad33edb-6d5c-3cbe-9179-6bfb01b957ae",
                                "text": "Der Schullehrer unterrichtete ohne Haselstock und Birkenrute."
                            },
                            {
                                "example_id": "9370c160-6b89-4a0b-8003-6322a2c16a45",
                                "sense_id": "fad33edb-6d5c-3cbe-9179-6bfb01b957ae",
                                "text": "Die Frau bindet im Wald Birkenruten."
                            }
