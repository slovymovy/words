                        "glosses": [
                            "besonders leistungsfähiger Personal Computer für einen Arbeitsplatz, der meist an ein lokales Netz angeschlossen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb389aad-41f1-44a7-8dc6-a117969835fc",
                                "sense_id": "3f8ece92-2ed8-34e7-b3d1-b9db11b35b21",
                                "text": "Meine Workstation ist zwar gut ausgestattet, hat aber keine Webkamera."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5e8bc85-e052-455a-b5a6-c72d9f13a6ee",
