                        "glosses": [
                            "Einrichtung des Anbieters eines Paketdienstes zur Zustellung von Paketen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b39f3656-62e8-49ec-9870-63551ac8c301",
                                "sense_id": "586c2849-ad93-3aa5-873a-a1b010460f51",
                                "text": "„Von der neuen Zustellbasis aus werden die DHL-Fahrer sämtliche Zustellbezirke in der Innenstadt, in Neuhausen/Nymphenburg und in Laim beliefern.“"
                            },
                            {
                                "example_id": "f29e0a05-60e8-4a6f-bad0-904bdcd5a39b",
                                "sense_id": "586c2849-ad93-3aa5-873a-a1b010460f51",
                                "text": "Die Sendung ist in der Zustellbasis eingegangen."
                            },
                            {
                                "example_id": "801fd483-1ce2-494c-b7cf-38275498488a",
                                "sense_id": "586c2849-ad93-3aa5-873a-a1b010460f51",
                                "text": "„Konkret bringen die Großlaster die Post zu den sieben großen Paketverteilzentren (sechs davon kombiniert mit Briefverteilzentren) in ganz Österreich oder dann weiter zu den 14 Zustellbasen.“"
                            }
                        ],
