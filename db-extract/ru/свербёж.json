                                        "entry_id": "06bcbc60-0d1c-3209-bcdd-673a71dbed32",
                                        "glosses": [
                                            "A sensation that itches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "609dc871-cf06-422d-b11f-1f9d64ff5343",
                                                "sense_id": "8704755c-a04b-3b1f-bd03-6b210c81c49f",
                                                "text": "Itchings, hitherto unknown, are felt all over the body, and render my skin sometimes painfully tender, sometimes quite benumbed, as if it were dead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
