                        "examples": [
                            {
                                "example_id": "7cd0cb31-32f3-4f87-af24-5239360ea393",
                                "sense_id": "61414716-dda9-3c44-9aa3-28e0b7ab68e9",
                                "text": "„Säbel und Federhut lagen auf einem Seitentische.“"
                            },
                            {
                                "example_id": "e77b98f4-557d-487a-96ca-a472868d8c67",
                                "sense_id": "61414716-dda9-3c44-9aa3-28e0b7ab68e9",
                                "text": "„Eine Frau mit einem Federhut trat ein.“"
                            },
                            {
                                "example_id": "144c4981-0794-4e1f-9d22-5765ef3d8ad4",
                                "sense_id": "61414716-dda9-3c44-9aa3-28e0b7ab68e9",
                                "text": "„Jene junge Dame, die im Auto an Adam vorübergefahren war, kam in Federhut, Reitkleid und wehendem Mantel die Freitreppe herunter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
