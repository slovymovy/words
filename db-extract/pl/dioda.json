                                        "sense_id": "84ef8c34-f1eb-34fa-843a-bd6a8fd49950",
                                        "entry_id": "a3ad46c2-c61e-3de5-9d8d-525263b77d03",
                                        "glosses": [
                                            "An electronic device that allows current to flow in one direction only; used chiefly as a rectifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd8b4c1-5e96-461a-8537-43cf52aa6f7b",
                                                "sense_id": "84ef8c34-f1eb-34fa-843a-bd6a8fd49950",
                                                "text": "I propose to give the name diode to a tube with two electrodes."
                                            },
                                            {
                                                "example_id": "1e7067b1-8c89-4d73-bf18-dff47a5b3e11",
                                                "sense_id": "84ef8c34-f1eb-34fa-843a-bd6a8fd49950",
                                                "text": "If a crystal or a diode is used, the amplifier-voltmeter combination may be used with an amplitude-modulated source; or with a c-w source, the detector may be connected to a microammeter or galvanometer as an indicating device."
                                            },
                                            {
                                                "example_id": "4a781884-3ebe-41df-a4a4-e4549f065e0d",
                                                "sense_id": "84ef8c34-f1eb-34fa-843a-bd6a8fd49950",
                                                "text": "In this circuit when the diode is forward biased, the voltage across the diode remains fairly close to the diode's barrier potential."
                                            }
