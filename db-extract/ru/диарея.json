                    {
                        "translation_id": "127a0fd0-211f-40ca-8693-6ed91c17769f",
                        "source_entry_id": "5647b775-1226-3d6a-bd3d-737f8be57f22",
                        "source_sense_id": "c35ecb2b-1b21-33a5-9904-e88386804899",
                        "target_lang_word": "diarrhée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diarrhée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff9d6fa6-3887-3732-97bc-dd0d8a087e21",
                                        "entry_id": "594c1527-d34f-3cb4-849f-aabe1860cdef",
                                        "glosses": [
                                            "Maladie caractérisée par des évacuations de selles, liquides et fréquentes, et qui est ordinairement due à l’inflammation de l’intestin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d810277-0c4e-4d53-ac1a-5ba0dd41893f",
                                                "sense_id": "ff9d6fa6-3887-3732-97bc-dd0d8a087e21",
                                                "text": "« J’avais en outre une diarrhée du diable, que j’ai vaincue sans nul médicament, par la contention mentale et donc musculaire. Le résultat fut magnifique, mais c’est un effort que je ne demanderais pas au passant de la rue »"
                                            },
                                            {
                                                "example_id": "98e729b7-8736-44a7-ad25-c035c4a26ad1",
                                                "sense_id": "ff9d6fa6-3887-3732-97bc-dd0d8a087e21",
                                                "text": "Ce fut encore cette diarrhée verte qui faillit l’enlever, qui, d’une enfant « rêtue » déjà, et plaisante, fit une sorte de morte."
                                            },
                                            {
                                                "example_id": "ff6d1ea7-76fc-43af-a409-434e94f884ff",
                                                "sense_id": "ff9d6fa6-3887-3732-97bc-dd0d8a087e21",
                                                "text": "Ces comprimés lui feront un pansement gastrique, et s’il n’a pas d’autres vomissements ou diarrhées, tu pourras considérer qu’il est sorti d’affaire."
                                            },
                                            {
                                                "example_id": "583ea3e3-cdb4-4b69-8386-490de992a6f7",
                                                "sense_id": "ff9d6fa6-3887-3732-97bc-dd0d8a087e21",
                                                "text": "Le traitement des formes non compliquées est simple et comporte à chacun des changes une désinfection bactérienne par un antiseptique à base de chlorhexidine par exemple suivie d’un séchage soigneux puis de l’application d’une crème ou d’un lait antifungique associée à un traitement antifungique per os uniquement en cas de muguet ou de diarrhée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b109d52b-45f7-3516-9c0a-ef9f7389fb39",
                                        "entry_id": "594c1527-d34f-3cb4-849f-aabe1860cdef",
                                        "glosses": [
                                            "Fort écoulement de liquide."
                                        ],
                                        "tags": [
                                            "Par comparaison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b1093a4-df31-451b-8e34-cb4021b0b777",
                                                "sense_id": "b109d52b-45f7-3516-9c0a-ef9f7389fb39",
                                                "text": "Comme une soudaine diarrhée le lahar engloutit le village."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5e75e12-8d11-3c71-9793-7c98fad6feb2",
                                        "entry_id": "594c1527-d34f-3cb4-849f-aabe1860cdef",
                                        "glosses": [
                                            "Flot d’informations intenses et sans intérêt pour l’interlocuteur."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f37e800-3aeb-425f-9a64-38550bca7f29",
                                                "sense_id": "e5e75e12-8d11-3c71-9793-7c98fad6feb2",
                                                "text": "Sa diarrhée nous assommait à longueur de journée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
