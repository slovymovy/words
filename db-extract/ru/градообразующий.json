                            "plural",
                            "prepositional"
                        ],
                        "form": "градообразу́ющих"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55f3e242-78d1-3aea-9457-c0d3b2e85b80",
                        "entry_id": "e01b1355-c5c9-38d0-b51b-1d76a635fb0b",
                        "glosses": [
                            "связанный с возникновением, развитием города"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee5a70a3-78ed-4d53-bb2d-a3eeffb5e747",
                                "sense_id": "55f3e242-78d1-3aea-9457-c0d3b2e85b80",
                                "text": "Особо хотел бы заметить, что для большинства прибрежных регионов Севера и Дальнего Востока рыбная отрасль сохраняет высокую социальную значимость и зачастую является градообразующей."
                            },
                            {
                                "example_id": "555fda22-fc4f-4f70-b727-e6fe1f8a3d8f",
                                "sense_id": "55f3e242-78d1-3aea-9457-c0d3b2e85b80",
                                "text": "Мировая практика показывает, что города, экономически зависящие от стабильной работы одного или двух градообразующих предприятий, сильнее остальных подвержены общественным рискам."
                            },
                            {
                                "example_id": "52c16bc6-c859-440d-b106-0af73162f793",
                                "sense_id": "55f3e242-78d1-3aea-9457-c0d3b2e85b80",
                                "text": "Это градообразующее предприятие, которое снабжает город и его инфраструктуру тепловой и электрической энергией, кислородом, сжатым воздухом."
                            },
                            {
                                "example_id": "d0e2af9e-31ca-454a-9c77-a7eebd3fbd69",
                                "sense_id": "55f3e242-78d1-3aea-9457-c0d3b2e85b80",
                                "text": "Тальковый комбинат и по сей день остаётся градообразующим предприятием, хотя молодёжь предпочитает ездить на заработки в город."
                            }
                        ]
                    }
                ],
