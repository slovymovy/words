                    {
                        "form_id": "d97a0f7a-ede8-4971-aba8-fadfb5eae7fb",
                        "entry_id": "3af01903-247a-38e5-b0a8-a859565368a3",
                        "tags": [],
                        "form": "demifille"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2bd733d-59a8-3e58-98c8-ccb690423e24",
                        "entry_id": "3af01903-247a-38e5-b0a8-a859565368a3",
                        "glosses": [
                            "Personne dont l’identité de genre est partiellement femme et partiellement un autre genre (ou partiellement agenre)."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "79a01751-51fd-4ca2-a177-38e3d0fe8148",
                                "sense_id": "c2bd733d-59a8-3e58-98c8-ccb690423e24",
                                "text": "Eden s'imagina s'affirmant demi-fille, puis demi-garçon, sans ressentir l'attirance qu'elle éprouvait pour le terme nonbinaire. Cela lui semblait toujours n'être qu'une partie de ce qu'elle expérimentait. Androgyne lui paraissait plus juste, mais la définition impliquait un mélange qu'elle n’approuvait pas, tout en restant insuffisant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72415f5a-dc31-41e6-8ec8-22722c6027f5",
                        "source_entry_id": "3af01903-247a-38e5-b0a8-a859565368a3",
                        "source_sense_id": "c2bd733d-59a8-3e58-98c8-ccb690423e24",
                        "target_lang_word": "demigirl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demigirl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "326b31d5-7114-3c9a-a602-4d9080a4db3d",
                                        "entry_id": "99e1812f-f0b9-3bc6-b180-9bb170aef0cb",
                                        "glosses": [
                                            "One who identifies as partially, but not completely, female."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b4b54d1-e011-403f-b4bc-617311627426",
                                                "sense_id": "326b31d5-7114-3c9a-a602-4d9080a4db3d",
                                                "text": "Hamlet identifies as a demigirl, although the term is used here by her best friend, Rachel Yorick, […]"
                                            },
                                            {
                                                "example_id": "6fad7616-ddd1-4b08-bf21-fdd4fa105684",
                                                "sense_id": "326b31d5-7114-3c9a-a602-4d9080a4db3d",
                                                "text": "Near-synonym: demiwoman"
                                            },
                                            {
                                                "example_id": "1c9aaab0-5bfe-4e34-8157-3a85c888e00a",
                                                "sense_id": "326b31d5-7114-3c9a-a602-4d9080a4db3d",
                                                "text": "Me: male-bodied demigirl with big black headphones and pink bow-headband in front of you on the bus to Ballard."
                                            },
                                            {
                                                "example_id": "f2c00af9-17b6-446d-a0f1-e8123f1eb8e0",
                                                "sense_id": "326b31d5-7114-3c9a-a602-4d9080a4db3d",
                                                "text": "Among the students planning to attend Lavender Graduation is senior Julia Heath, who identifies as an asexual non-binary demigirl."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demigirl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b3d5d14-33b0-30de-8533-e6df0df0c5ce",
                                        "entry_id": "56b1ad0f-6eab-3b99-904a-1637b0065de2",
                                        "glosses": [
                                            "Identifying as partially, but not completely, female."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "436a4358-77cc-4d1a-8509-f3b163eddea1",
                                                "sense_id": "0b3d5d14-33b0-30de-8533-e6df0df0c5ce",
                                                "text": "I've settled upon demigirl to describe my gender, a nonbinary identity meaning partially girl, partially something else."
                                            },
                                            {
                                                "example_id": "bf00b157-ae04-4d92-846a-7dfd0b54d192",
                                                "sense_id": "0b3d5d14-33b0-30de-8533-e6df0df0c5ce",
                                                "text": "People who identify as demigirl may or may not have other gender identities too."
                                            },
                                            {
                                                "example_id": "c020301a-d1f8-4c35-9569-c77c87b76fc3",
                                                "sense_id": "0b3d5d14-33b0-30de-8533-e6df0df0c5ce",
                                                "text": "I identify as demigirl but there are times when I fluctuate from agender to demigirl to female."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a116a85f-5fdf-4d94-91d7-b32d248ac06f",
