                                            {
                                                "example_id": "7a5f5a85-1d36-4aa8-80b0-a09df2fc706b",
                                                "sense_id": "936a27b2-8406-3e13-b846-8ca390d44020",
                                                "text": "Nachdem er die Nachricht erfahren hatte, hat er nur noch apathisch herumgesessen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "839280aa-e8d4-4596-a657-8eb9da17a130",
