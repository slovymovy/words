                    {
                        "sense_id": "bc9e7db7-73a1-388e-8710-c20b1f95d208",
                        "entry_id": "557d53f0-65b0-3011-a985-a6d6bfe7c3eb",
                        "glosses": [
                            "Commune, ville et chef-lieu de département français, situé dans le département de Saône-et-Loire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "369520fd-5463-49c3-b8a0-013f4e8a333c",
                                "sense_id": "bc9e7db7-73a1-388e-8710-c20b1f95d208",
                                "text": "Ces observations permettent de se demander si le Glazi du Petit Thalamus n'est pas Laizé, commune située entre Mâcon et Tournus, à onze kilomètres au nord de Mâcon, à peu de distance de la Saône, en face à peu près de Saint-Trivier-de-Courtes d'autant mieux que la forme Glazi pour Laizé peut très bien s'expliquer."
                            },
                            {
                                "example_id": "ac6a09eb-dd50-46e3-b8bb-97c86129d440",
                                "sense_id": "bc9e7db7-73a1-388e-8710-c20b1f95d208",
                                "text": "Le Concile de Mâcon (581) recommande aux chrétiens de racheter les esclaves chrétiens servent chez les juifs, pour le prix de 12 sols."
                            },
                            {
                                "example_id": "9f2bbf33-1d96-4be9-8f8a-430aa8cef558",
                                "sense_id": "bc9e7db7-73a1-388e-8710-c20b1f95d208",
                                "text": "Comptine en vogue au cours moyen, l’année de la communion solennelle : À Marseille je l’essaye / À Paris je me marie / À Toulon j’ai le ballon / À Mâcon j’ai le morpion."
                            }
                        ]
                    }
                ],
