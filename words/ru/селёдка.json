    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "77398bca-a580-3f5b-a073-11e464586916",
                    "sense_definition": "Мясо сельди, а также холодное блюдо, приготовленное из солёной или маринованной рыбы этого вида.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fish_and_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На праздничный стол бабушка всегда ставила солёную <w>селёдку</w> с репчатым луком.",
                            "target_lang_translations": {
                                "en": "For the holiday table, grandmother always served salted <w>herring</w> with onions."
                            }
                        },
                        {
                            "text": "Мы купили в магазине картошку, масло и банку пряной <w>селёдки</w> на ужин.",
                            "target_lang_translations": {
                                "en": "At the store we bought potatoes, butter, and a jar of spiced <w>herring</w> for dinner."
                            }
                        }
                    ],
                    "synonyms": [
                        "сельдь"
                    ],
                    "common_phrases": [
                        "селёдка под шубой",
                        "селёдка с луком"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Herring meat, or a cold dish prepared from salted or pickled herring."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "herring",
                                "target_lang_sense_clarification": "food or prepared dish"
                            },
                            {
                                "target_lang_word": "pickled herring",
                                "target_lang_sense_clarification": "marinated fish dish"
                            },
                            {
                                "target_lang_word": "salt herring",
                                "target_lang_sense_clarification": "salted fish dish"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85494361-9303-3883-a71a-85e1f7d1e141",
                    "sense_definition": "Морская рыба семейства сельдевых; <w>сельдь</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fish_and_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В Северном море рыбаки выловили сетью целую стаю серебристой <w>селёдки</w>.",
                            "target_lang_translations": {
                                "en": "In the North Sea, the fishermen netted an entire school of silvery <w>herring</w>."
                            }
                        },
                        {
                            "text": "В этом мелком заливе крупная <w>селёдка</w> обычно не водится.",
                            "target_lang_translations": {
                                "en": "Large <w>herring</w> are usually not found in this shallow bay."
                            }
                        }
                    ],
                    "synonyms": [
                        "сельдь",
                        "сельга",
                        "сельдина"
                    ],
                    "common_phrases": [
                        "тихоокеанская селёдка",
                        "ловить селёдку"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A marine fish belonging to the family Clupeidae; herring."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "herring",
                                "target_lang_sense_clarification": "the fish species"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "835f4e3e-498a-322e-8835-98baf43aa9f8",
                    "sense_definition": "Узкий длинный мужской галстук.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_and_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодой человек надел строгий тёмный костюм и модный узкий галстук <w>селёдку</w>.",
                            "target_lang_translations": {
                                "en": "The young man put on a formal dark suit and a trendy <w>skinny tie</w>."
                            }
                        },
                        {
                            "text": "В гардеробе отца до сих пор хранилась старая шёлковая <w>селёдка</w>.",
                            "target_lang_translations": {
                                "en": "An old silk <w>skinny tie</w> was still kept in father's wardrobe."
                            }
                        }
                    ],
                    "synonyms": [
                        "галстук-селёдка"
                    ],
                    "common_phrases": [
                        "галстук селёдка",
                        "узкая селёдка"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "молодёжный сленг"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A long, narrow necktie; skinny tie."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "skinny tie",
                                "target_lang_sense_clarification": "narrow necktie"
                            },
                            {
                                "target_lang_word": "narrow tie",
                                "target_lang_sense_clarification": "slender necktie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f86ae615-5a82-3bf4-92aa-0e08fcda7205",
                    "sense_definition": "Сабля или офицерская шашка.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Городовой важно поправил казённую <w>селёдку</w> на боку и пошёл вдоль улицы.",
                            "target_lang_translations": {
                                "en": "The policeman pompously adjusted the official <w>saber</w> at his hip and walked down the street."
                            }
                        },
                        {
                            "text": "Офицер резко выхватил блестящую стальную <w>селёдку</w> из потёртых ножен.",
                            "target_lang_translations": {
                                "en": "The officer swiftly drew his shiny steel <w>blade</w> from the scuffed scabbard."
                            }
                        }
                    ],
                    "synonyms": [
                        "сабля",
                        "шашка"
                    ],
                    "common_phrases": [
                        "офицерская селёдка"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "дореволюционное просторечие"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорно-сниженное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A saber, cavalry sword, or officer's shashka."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "saber",
                                "target_lang_sense_clarification": "slang for an officer's sword"
                            },
                            {
                                "target_lang_word": "sword",
                                "target_lang_sense_clarification": "slang or humorous designation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d638d26-ec5f-3c8e-a299-a70330eec943",
                    "sense_definition": "Очень худой, щуплый или скучный человек.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_characterization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из-за высокого роста и сильной худобы одноклассники часто дразнили парня сушёной <w>селёдкой</w>.",
                            "target_lang_translations": {
                                "en": "Because of his tall height and extreme thinness, his classmates often teased the guy, calling him a dried-up <w>beanpole</w>."
                            }
                        },
                        {
                            "text": "Эта бледная худая <w>селёдка</w> снова сидела в углу комнаты и весь вечер молчала.",
                            "target_lang_translations": {
                                "en": "That pale, skinny <w>bore</w> sat in the corner of the room again and stayed silent all evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "худоба",
                        "худышка",
                        "слабак",
                        "хиляк",
                        "дрищ",
                        "дрыщ",
                        "зануда"
                    ],
                    "common_phrases": [
                        "сушёная селёдка"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "молодёжный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A very thin, scrawny person, or a dull, boring person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beanpole",
                                "target_lang_sense_clarification": "scrawny or skinny person"
                            },
                            {
                                "target_lang_word": "skinny minny",
                                "target_lang_sense_clarification": "very thin person"
                            },
                            {
                                "target_lang_word": "bore",
                                "target_lang_sense_clarification": "dull person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3cadf31-4c7a-3787-93d8-bd20f406d9e5",
                    "sense_definition": "Предмет продолговатой формы, который болтается и мешает движениям.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing_and_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Длинный оторванный ремень висел на сумке ненужной <w>селёдкой</w> и путался в ногах.",
                            "target_lang_translations": {
                                "en": "The long, torn strap hung from the bag like a useless <w>dangling strip</w> and tangled in my feet."
                            }
                        },
                        {
                            "text": "Отрежь наконец эту лишнюю <w>селёдку</w> от старой куртки, она только мешает при ходьбе.",
                            "target_lang_translations": {
                                "en": "Finally cut off that superfluous <w>dangling flap</w> from the old jacket; it just gets in the way when walking."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "молодёжный сленг"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An oblong hanging object that dangles and gets in the way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dangling strip",
                                "target_lang_sense_clarification": "loose strap or flap"
                            },
                            {
                                "target_lang_word": "tag end",
                                "target_lang_sense_clarification": "hanging loose piece"
                            }
                        ]
                    }
                }
            ]
        }
    ]
