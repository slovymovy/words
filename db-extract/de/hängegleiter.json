                                    {
                                        "sense_id": "42786b1d-0b91-3835-96aa-6391e3c486a1",
                                        "entry_id": "98072e4c-ebf4-397f-83ca-f1995ce8adf3",
                                        "glosses": [
                                            "Aile d'un avion en forme de triangle isocèle, forme géométrique ressemblant à Δ, une lettre grecque majuscule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f24a10-94ff-4e93-ba0a-3b707084a8a1",
                                                "sense_id": "42786b1d-0b91-3835-96aa-6391e3c486a1",
                                                "text": "La conception de l’aile delta a été un choix populaire pour de nombreuses générations d’avions, allant des chasseurs militaires aux jets de passagers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48100dad-ca18-3d57-a835-0205fcfb374e",
                                        "entry_id": "98072e4c-ebf4-397f-83ca-f1995ce8adf3",
                                        "glosses": [
                                            "Aile d'un avion ressemblant à un triangle isocèle, forme géométrique ressemblant à Δ, une lettre grecque majuscule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77d312ec-e279-4d2d-ae5c-aed77440ceae",
                                                "sense_id": "48100dad-ca18-3d57-a835-0205fcfb374e",
                                                "text": "L’aile delta est une configuration aérodynamique en forme de triangle, couramment utilisée sur les avions de chasse, en raison de ses nombreux avantages dans le domaine militaire."
                                            }
                                        ]
                                    }
                                ]
                            }
