                "senses": [
                    {
                        "sense_id": "a3431e49-56c6-3cf4-9a38-90c2822a115e",
                        "entry_id": "fd0717a7-614a-3c34-82a0-46fe3e7b0335",
                        "glosses": [
                            "włoski koncern samochodowy i marka samochodów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b460e0dd-3d09-4cfb-9a5b-1de0da3450a1",
                                "sense_id": "a3431e49-56c6-3cf4-9a38-90c2822a115e",
                                "text": "Fiat przejął kolejne udziały Chryslera i stał się większościowym udziałowcem amerykańskiego koncernu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b34111af-fa88-35bb-a26d-8a1b16da0a16",
                        "entry_id": "fd0717a7-614a-3c34-82a0-46fe3e7b0335",
                        "glosses": [
                            "fabryka Fiata (1.1)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dc115a03-705c-4395-bdb9-c98852d0e965",
                                "sense_id": "b34111af-fa88-35bb-a26d-8a1b16da0a16",
                                "text": "Na skrzyżowaniu przy Fiacie zamontowaliśmy nowoczesne urządzenie, które komputerowo reguluje światłami w poszczególnych kierunkach, zależnie od natężenia ruchu."
                            },
                            {
                                "example_id": "c5bed65b-60ff-4e07-bdb2-4351494e5969",
                                "sense_id": "b34111af-fa88-35bb-a26d-8a1b16da0a16",
                                "text": "Fiat w Bielsku-Białej rozpoczął produkcję nowych silników."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "83b8ed01-ce75-3648-a7a0-50919b2b6225",
                        "entry_id": "fd0717a7-614a-3c34-82a0-46fe3e7b0335",
                        "glosses": [
                            "Zespół Szkół Samochodowych w Tychach"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fa35420c-82d1-49d1-a18a-f542b74c7c05",
                                "sense_id": "83b8ed01-ce75-3648-a7a0-50919b2b6225",
                                "text": "Piotrek skończył Fiata i poszedł na polibudę."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
