                        "examples": [
                            {
                                "example_id": "0265f05b-d24a-47b2-a8cc-f86105bfc9cf",
                                "sense_id": "75962e56-3fae-3ce5-a2e8-324ee7072758",
                                "text": "„Ich hatte seinen Sohn erschossen; der ausgesuchteste Martertod war mir gewiß; doch das kümmerte mich jetzt nicht; […].“"
                            },
                            {
                                "example_id": "e0a9efd0-d6ba-4045-8bdf-45aead6119ab",
                                "sense_id": "75962e56-3fae-3ce5-a2e8-324ee7072758",
                                "text": "„Unter dem Petersplatz ruhen bis heute Teile der Rennbahnen vom Circus Kaiser Neros in der Erde, wo Roms erste Christen den Martertod fanden.“"
                            }
                        ],
