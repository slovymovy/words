                "senses": [
                    {
                        "sense_id": "0bac285b-da5f-3c32-b609-9a0044dfacc7",
                        "entry_id": "1d8f66de-f8b4-3b4a-8700-0f27b2518188",
                        "glosses": [
                            "Tisch, der in der Küche steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55771f19-11a4-4fe0-b935-045f13bfec6e",
                                "sense_id": "0bac285b-da5f-3c32-b609-9a0044dfacc7",
                                "text": "„Rings um den Küchentisch raucht eine Gruppe von Leuten einen Joint und unterhält sich auf Färöisch.“"
                            },
                            {
                                "example_id": "b9910f9b-f1df-4946-8566-76728820748f",
                                "sense_id": "0bac285b-da5f-3c32-b609-9a0044dfacc7",
                                "text": "„Er setzt sich an den Küchentisch und schlürft ein Glas Buttermilch.“"
                            },
                            {
                                "example_id": "f03fbd49-fab1-4750-8c39-1aeb38f259bc",
                                "sense_id": "0bac285b-da5f-3c32-b609-9a0044dfacc7",
                                "text": "„Bertram saß schon am Küchentisch.“"
                            },
                            {
                                "example_id": "58ab36a2-6efb-465d-b7c2-0609a2e32866",
                                "sense_id": "0bac285b-da5f-3c32-b609-9a0044dfacc7",
                                "text": "„Auf dem Küchentisch stand ihr Abendessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
