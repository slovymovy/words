                "senses": [
                    {
                        "sense_id": "9940bcf5-c400-3f45-b688-1915544016e6",
                        "entry_id": "bc807e24-998b-33d8-96bc-4282d9a20454",
                        "glosses": [
                            "Viner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faddfa84-9dba-4bf0-a024-ff2db9d88f20",
                                "sense_id": "9940bcf5-c400-3f45-b688-1915544016e6",
                                "text": "Au bout d'un mois on les revine encore, puis on les vend au marchand de demi-gros, ou au détaillant, qui demande au marchand en gros de les faire reviner encore pour leur compte."
                            },
                            {
                                "example_id": "d2e0e1dd-d91a-4eb1-af97-ba7bcbe7abae",
                                "sense_id": "9940bcf5-c400-3f45-b688-1915544016e6",
                                "text": "Lorsque les commerçants des grands centres reçoivent les vins du Midi, il les revinent et survinent, en introduisant à chaque opération cinq litres d'alcool pur par hectolitre."
                            }
                        ]
                    }
                ],
