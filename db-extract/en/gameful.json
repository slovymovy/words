        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b7e14ec1-7112-3636-9499-039d83735239",
                "word": "gameful",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9951ff18-84cc-44d2-b6c8-159a3fdfbb0b",
                        "entry_id": "b7e14ec1-7112-3636-9499-039d83735239",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more gameful"
                    },
                    {
                        "form_id": "236b08bf-0faa-46d0-8a24-4931232ac3a1",
                        "entry_id": "b7e14ec1-7112-3636-9499-039d83735239",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most gameful"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5fae06ae-2a72-303a-9799-51b802935a41",
                        "entry_id": "b7e14ec1-7112-3636-9499-039d83735239",
                        "glosses": [
                            "Full of game (prey for a hunter)."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "7ed8b673-dc11-4401-be72-ed52cd714908",
                                "sense_id": "5fae06ae-2a72-303a-9799-51b802935a41",
                                "text": "For warlike Toil he leaves the gameful Wood, / And fleſht his Courage firſt in Saxon Blood."
                            },
                            {
                                "example_id": "4eeff68b-0d8a-4583-848c-1650e3e12ca8",
                                "sense_id": "5fae06ae-2a72-303a-9799-51b802935a41",
                                "text": "The condition of liberty not only covers the 'sandy Wilds' with 'yellow Harvests' (1.88) but also transforms the 'empty Wilds and Woods' to 'gameful Woods' (I. 95), and the tyrant hunter having become a prey, the liberated swain becomes a hunter."
                            },
                            {
                                "example_id": "8f0d3972-ae79-4f07-a912-2b42704f8b76",
                                "sense_id": "5fae06ae-2a72-303a-9799-51b802935a41",
                                "text": "Ye vig'rous Swains! while Youth ferments your Blood, And purer Spirits swell the sprightly Flood, Now range the Hills, the gameful Woods beset, Wind the shrill Horn, or spread the waving Net."
                            }
                        ]
                    },
                    {
                        "sense_id": "217f5c51-3f34-3fed-a18b-27766d573daf",
                        "entry_id": "b7e14ec1-7112-3636-9499-039d83735239",
                        "glosses": [
                            "Characteristic of prey; game-like."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535085c0-08c1-4c86-8861-71f5204af115",
                                "sense_id": "217f5c51-3f34-3fed-a18b-27766d573daf",
                                "text": "As such they not only made them the sport of the pulpit, which was become but a more solemn sort of stage; but every stage, and every table, and every puppet play, belched forth profane scoffs upon them; the drunkards made them their songs; all fiddlers and mimics learned to abuse them, as finding its most gameful way of fooling."
                            },
                            {
                                "example_id": "8ac81d62-dd72-4556-a281-696a9b40ad49",
                                "sense_id": "217f5c51-3f34-3fed-a18b-27766d573daf",
                                "text": "Unlike the red foxes these animals can, and often do, climb trees that are sufficiently inclined to warrant a foothold. And they also depend more upon their ability to hide when pursued than upon the more gameful tactics of track deception."
                            },
                            {
                                "example_id": "a1d63d2f-5945-42f1-b6b6-6132c6033577",
                                "sense_id": "217f5c51-3f34-3fed-a18b-27766d573daf",
                                "text": "One of the pistoleros went to her but not getting any reaction from an overly sleepy and disinterested passenger returned to more gameful victims."
                            }
                        ]
                    },
                    {
                        "sense_id": "20b5a3aa-3b36-311d-9f7b-50ad24f0f0ea",
                        "entry_id": "b7e14ec1-7112-3636-9499-039d83735239",
                        "glosses": [
                            "Having the characteristics of a game that can be played."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c618e62-1e94-4ed7-8703-80968fd59e60",
                                "sense_id": "20b5a3aa-3b36-311d-9f7b-50ad24f0f0ea",
                                "text": "Then time shall never grieve me, for by that vow, E'en absent I enjoy her, assuredly confirmed that none Else shall, which will make tedious years seem gameful To me."
                            },
                            {
                                "example_id": "fcecd007-504b-4ff7-b320-7f62cbe5b062",
                                "sense_id": "20b5a3aa-3b36-311d-9f7b-50ad24f0f0ea",
                                "text": "How does one conduct research on gameful L2TL?"
                            },
                            {
                                "example_id": "e27ac49c-b764-436f-9942-4d0c7c474428",
                                "sense_id": "20b5a3aa-3b36-311d-9f7b-50ad24f0f0ea",
                                "text": "We acknowledge that sometimes playful activities occur within games and gameful activities are part of play."
                            }
                        ]
                    },
                    {
                        "sense_id": "76971c6a-d368-3e15-9d4e-c2a1a1e980d1",
                        "entry_id": "b7e14ec1-7112-3636-9499-039d83735239",
                        "glosses": [
                            "Pertaining to games."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d722b44-ad71-4e05-a4ed-c7b4179f3c56",
                                "sense_id": "76971c6a-d368-3e15-9d4e-c2a1a1e980d1",
                                "text": "How can gameful designers incorporate meaningful, relevant realworld application into their gamified learning experiences?"
                            },
                            {
                                "example_id": "f7acea5e-d0ea-4420-a754-16e9ee902384",
                                "sense_id": "76971c6a-d368-3e15-9d4e-c2a1a1e980d1",
                                "text": "Incorporating gameful digital rhetoric into the real world contributes to enhancing the meaning of the real world if the gameful digital rhetoric is meaningful to people."
                            },
                            {
                                "example_id": "6bbbfe00-913b-45c2-823c-c6ced1d78ac3",
                                "sense_id": "76971c6a-d368-3e15-9d4e-c2a1a1e980d1",
                                "text": "Seeking out and completing quests is just one of the seven gameful skills that will help you become stronger, happier, and braver in everyday life."
                            }
                        ]
                    }
                ],
