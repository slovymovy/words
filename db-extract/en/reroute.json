                                            {
                                                "example_id": "fa3bfb2d-5260-418a-9911-bc1452defa3a",
                                                "sense_id": "7e285ddb-1671-3b30-9015-5e24ca323dca",
                                                "text": "Comment pourrait on \"recircuiter\" les choses car mon psy ne croit absolument pas à cette hypothèse."
