        "fr-extract.jsonl": [
            {
                "entry_id": "cb65000e-d7e2-39ec-94cb-ef6f7a5bdd45",
                "word": "saladier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8dcff932-fcc0-4d66-8ea0-9b376e9c92d3",
                        "entry_id": "cb65000e-d7e2-39ec-94cb-ef6f7a5bdd45",
                        "tags": [
                            "plural"
                        ],
                        "form": "saladiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a8fc7c2-7e97-3b5b-a859-a4caa30d5c3c",
                        "entry_id": "cb65000e-d7e2-39ec-94cb-ef6f7a5bdd45",
                        "glosses": [
                            "Grand bol dans lequel on prépare et on peut servir une salade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6773a62b-c998-4fa5-853c-d2deb137bf4b",
                                "sense_id": "9a8fc7c2-7e97-3b5b-a859-a4caa30d5c3c",
                                "text": "Dans un grand bol ou un saladier, mélangez la passata de tomates avec l’huile d’olive, une 1/2 c. à café de sel de mer, l’ail haché, le piment, les lentilles égouttées, la courge râpée, les olives hachées, les câpres et le zeste de citron."
                            },
                            {
                                "example_id": "912f26f7-adc2-42a6-987c-5140ea31f943",
                                "sense_id": "9a8fc7c2-7e97-3b5b-a859-a4caa30d5c3c",
                                "text": "Elle a fait semblant de ne pas entendre et s’est retournée pour attraper le saladier sur le plan de travail."
                            }
                        ]
                    },
                    {
                        "sense_id": "10861cc5-decd-3737-920b-258f3e19efad",
                        "entry_id": "cb65000e-d7e2-39ec-94cb-ef6f7a5bdd45",
                        "glosses": [
                            "Contenu de ce grand bol."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "fbf52311-b44f-40b6-8b5e-af8b79eb05c4",
                                "sense_id": "10861cc5-decd-3737-920b-258f3e19efad",
                                "text": "Ce soir, un plein saladier de fraise en provenance de notre potager."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0324355-6731-48ce-81fa-e50a33ee9b87",
                        "source_entry_id": "cb65000e-d7e2-39ec-94cb-ef6f7a5bdd45",
                        "source_sense_description": "contenant à salade",
                        "target_lang_word": "Salatschüssel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salatschüssel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81040cbc-6c57-3862-ae53-727d4491e3c2",
                                        "entry_id": "e794ada9-a1c9-397f-901e-c83c7c3d0d9f",
                                        "glosses": [
                                            "vertieftes Gefäß für Salatgerichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ebe008-f4d2-41dc-a633-48fb44b97ad2",
                                                "sense_id": "81040cbc-6c57-3862-ae53-727d4491e3c2",
                                                "text": "In der großen Salatschüssel befindet sich hausgemachter Gurkensalat, in der kleineren ist Fleischsalat vom Metzger."
                                            },
                                            {
                                                "example_id": "d11b2876-54cc-464d-98f2-70ed8cc363e1",
                                                "sense_id": "81040cbc-6c57-3862-ae53-727d4491e3c2",
                                                "text": "„Er nahm das Glas Pernod, trank einen Schluck und zwang sich, langsam auf die Salatschüssel zu blicken, als interessiere ihn die Zubereitung.“"
                                            },
                                            {
                                                "example_id": "33ec5502-d780-47e9-99aa-c3337f924463",
                                                "sense_id": "81040cbc-6c57-3862-ae53-727d4491e3c2",
                                                "text": "„Lindner vollführte mit Thomas einen kleinen Freudentanz, bei welchem das Ende einer Salatschüssel zu beklagen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14f63693-3064-4989-9976-a6fe77ec02be",
