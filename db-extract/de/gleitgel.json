                "senses": [
                    {
                        "sense_id": "91969480-d49d-397a-881a-de488f827f72",
                        "entry_id": "bffa8d86-943b-3f10-95d0-4d8903ff5efb",
                        "glosses": [
                            "zähflüssige, einer Creme ähnelnde Substanz, die die Reibung mindern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13c8af58-0a4c-41a1-8d73-b35508d47010",
                                "sense_id": "91969480-d49d-397a-881a-de488f827f72",
                                "text": "„Das Einführen und Bewegen des Penis in der Scheide geht oft leichter, wenn das Gleitgel zusätzlich zur natürlichen Feuchtigkeit der Scheide aufgetragen wird.“"
                            },
                            {
                                "example_id": "7421b261-2e54-45a3-ab1a-b9fe8b9325e3",
                                "sense_id": "91969480-d49d-397a-881a-de488f827f72",
                                "text": "„Anschließend wird die Sonde mit Gleitgel […] versehen und durch ein Nasenloch eingeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
