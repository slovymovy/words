                        "target_lang_word": "kudos",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kudos",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14ed11ee-1def-315d-8cc5-ee1b82e71737",
                                        "entry_id": "638e59b6-2ae9-3e64-a1b2-14e18bafc615",
                                        "glosses": [
                                            "Praise; accolades."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0874c6eb-26f3-4418-bb05-a4545885c87a",
                                                "sense_id": "14ed11ee-1def-315d-8cc5-ee1b82e71737",
                                                "text": "Allen Gregory DeLongpre: Pat, I gotta tell you, you did a lot of things right with this lunch―kudos. You got back quickly, you showed initiative, and, best of all, you left plenty of room for improvement."
                                            },
                                            {
                                                "example_id": "f5056703-17ff-4913-8c9e-4442b2e64dc7",
                                                "sense_id": "14ed11ee-1def-315d-8cc5-ee1b82e71737",
                                                "text": "The talented, young playwright received much kudos for his new drama."
                                            },
                                            {
                                                "example_id": "946950ca-73be-48d4-9ece-6f8c86cc7abb",
                                                "sense_id": "14ed11ee-1def-315d-8cc5-ee1b82e71737",
                                                "text": "I gave Chelsea much kudos for the birth of her first daughter."
                                            },
                                            {
                                                "example_id": "132809e9-f35c-44cc-b3f1-ec79597e022a",
                                                "sense_id": "14ed11ee-1def-315d-8cc5-ee1b82e71737",
                                                "text": "And… and to that… to that Turkish horse, I say this, “You should not step on people’s balls, but, in this solitary instance, kudos, horse, kudos.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dadaf77d-728d-31f8-9c5a-64d63213b5bb",
                                        "entry_id": "638e59b6-2ae9-3e64-a1b2-14e18bafc615",
                                        "glosses": [
                                            "Credit for one's achievements."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89c5e5d7-6429-4813-a96f-6438bce60489",
                                                "sense_id": "dadaf77d-728d-31f8-9c5a-64d63213b5bb",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
