                                                "sense_id": "d42a5e49-b776-3104-ae3c-c572f22b8174",
                                                "text": "esistono numerosi software che consentono di comprimere e decomprimere i file"
                                            },
                                            {
                                                "example_id": "c35787c0-7a16-432c-a1ee-c50e0b80f162",
                                                "sense_id": "d42a5e49-b776-3104-ae3c-c572f22b8174",
