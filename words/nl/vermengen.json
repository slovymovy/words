{
    "word_family": [
        "mengen",
        "mengsel",
        "vermenging",
        "vermengbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3867e0d1-1ff5-3f25-92ef-ab2a111357cc",
                    "sense_definition": "verschillende stoffen of zaken door elkaar doen om een geheel te vormen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mengen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>vermengde</w> de rode wijn met een beetje water om de smaak te verzachten.",
                            "target_lang_translations": {
                                "en": "He <w>mixed</w> the red wine with a little water to soften the taste."
                            }
                        },
                        {
                            "text": "Je moet de bloem goed met de eieren <w>vermengen</w> voor een glad beslag.",
                            "target_lang_translations": {
                                "en": "You must <w>blend</w> the flour well with the eggs for a smooth batter."
                            }
                        }
                    ],
                    "synonyms": [
                        "mengen",
                        "mixen",
                        "door elkaar roeren"
                    ],
                    "antonyms": [
                        "scheiden",
                        "sorteren"
                    ],
                    "common_phrases": [
                        "met water vermengen",
                        "goed vermengen"
                    ],
                    "target_lang_definitions": {
                        "en": "to put different substances or things together to form a whole"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mix",
                                "target_lang_sense_clarification": "to stir ingredients together"
                            },
                            {
                                "target_lang_word": "blend",
                                "target_lang_sense_clarification": "to combine substances intimately"
                            },
                            {
                                "target_lang_word": "mingle",
                                "target_lang_sense_clarification": "to intermix parts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d42ae8c4-2af7-38ce-8159-b94560655f27",
                    "sense_definition": "zich met iets anders verenigen tot een geheel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mengen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water van deze twee rivieren <w>vermengde</w> zich niet zo snel na de splitsing.",
                            "target_lang_translations": {
                                "en": "The water from these two rivers did not <w>mingle</w> so quickly after the split."
                            }
                        },
                        {
                            "text": "De geur van verse koffie <w>vermengde</w> zich met de koude ochtendlucht in de keuken.",
                            "target_lang_translations": {
                                "en": "The scent of fresh coffee <w>blended</w> with the cold morning air in the kitchen."
                            }
                        }
                    ],
                    "synonyms": [
                        "samengaan",
                        "zich mengen",
                        "mixen"
                    ],
                    "antonyms": [
                        "afscheiden"
                    ],
                    "common_phrases": [
                        "zich vermengen met"
                    ],
                    "target_lang_definitions": {
                        "en": "to unite with something else to form a whole"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blend",
                                "target_lang_sense_clarification": "to pass or shade into each other"
                            },
                            {
                                "target_lang_word": "mingle",
                                "target_lang_sense_clarification": "to become mixed or combined"
                            },
                            {
                                "target_lang_word": "mix",
                                "target_lang_sense_clarification": "to associate or join with"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62f0fa1c-63b1-38a9-919d-c82b63b8dc8a",
                    "sense_definition": "zaken die niet bij elkaar horen onjuist met elkaar in verband brengen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwarring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet deze twee verschillende juridische begrippen niet met elkaar <w>vermengen</w>.",
                            "target_lang_translations": {
                                "en": "You should not <w>mix up</w> these two different legal concepts."
                            }
                        },
                        {
                            "text": "In zijn verhaal <w>vermengde</w> hij feiten met fictie, waardoor niemand hem meer geloofde.",
                            "target_lang_translations": {
                                "en": "In his story, he <w>conflated</w> facts with fiction, so that no one believed him anymore."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwarren",
                        "verhaspelen",
                        "dooreenhalen"
                    ],
                    "antonyms": [
                        "onderscheiden"
                    ],
                    "common_phrases": [
                        "feiten en fictie vermengen"
                    ],
                    "target_lang_definitions": {
                        "en": "to incorrectly associate things that do not belong together"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mix up",
                                "target_lang_sense_clarification": "to confuse or conflate different things"
                            },
                            {
                                "target_lang_word": "conflate",
                                "target_lang_sense_clarification": "to combine two distinct ideas into one"
                            },
                            {
                                "target_lang_word": "blend",
                                "target_lang_sense_clarification": "to merge different concepts"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}