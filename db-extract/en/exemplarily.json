                                        "sense_id": "92a1e4a2-7347-34fb-bd2d-97fd679a133c",
                                        "entry_id": "23125540-7546-387e-84f4-b1bad74a3df3",
                                        "glosses": [
                                            "D’une manière exemplaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "831b069b-51a2-4f11-a08c-2022b4a177ca",
                                                "sense_id": "92a1e4a2-7347-34fb-bd2d-97fd679a133c",
                                                "text": "Le peuple chrétien, châtié si longtemps et si exemplairement par la justice du ciel."
                                            },
                                            {
                                                "example_id": "ac722227-79fe-4350-87c6-a52a8bda26bc",
                                                "sense_id": "92a1e4a2-7347-34fb-bd2d-97fd679a133c",
                                                "text": "Vous devez là-dessus, non-seulement accomplir votre devoir, mais l’accomplir exemplairement."
                                            },
                                            {
                                                "example_id": "8ffd74e4-a9be-4dfa-9f31-000d9bbe6d19",
                                                "sense_id": "92a1e4a2-7347-34fb-bd2d-97fd679a133c",
                                                "text": "Le scélérat ! je le ferai punir exemplairement."
                                            },
                                            {
                                                "example_id": "06b30a70-e8a1-4dfd-aa0d-c0b7547fafde",
                                                "sense_id": "92a1e4a2-7347-34fb-bd2d-97fd679a133c",
                                                "text": "Mais le trait remarquable de l’éloquence française classique, et qui fonde l'étonnante impression de cohérence qu'elle inspire, c'est que les valeurs de simplicité, clarté, bon sens naturel, mises en avant par la raison géométrique, sont également les valeurs rectrices de l'éloquence classique, exemplairement atticiste."
                                            }
                                        ]
                                    }
                                ]
                            }
