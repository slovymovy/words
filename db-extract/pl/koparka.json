                "senses": [
                    {
                        "sense_id": "7aa14617-c00b-3054-8d5d-cc85958085eb",
                        "entry_id": "36ec5af1-e4d3-3a6b-a93a-1d7a4b7ba18b",
                        "glosses": [
                            "maszyna budowlana, pojazd służący do kopania dużych dołów w miękkim gruncie lub do wybierania gruntu"
                        ],
                        "tags": [
                            "masz."
                        ],
                        "examples": [
                            {
                                "example_id": "75c9556d-77b7-46ca-8b8c-9732b9f439ea",
                                "sense_id": "7aa14617-c00b-3054-8d5d-cc85958085eb",
                                "text": "Największą trudność w obsłudze koparki stanowi kierowanie jej łyżką."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "208d4587-8886-4982-9a98-2b4892dc1b7a",
                        "source_entry_id": "36ec5af1-e4d3-3a6b-a93a-1d7a4b7ba18b",
                        "source_sense_id": "7aa14617-c00b-3054-8d5d-cc85958085eb",
                        "target_lang_word": "digger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cb20d7d-d272-3c69-a1de-c88f185e99e3",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "A large piece of machinery that digs holes or trenches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4938c25f-859d-47a9-84e3-3acac423a5a3",
                                                "sense_id": "4cb20d7d-d272-3c69-a1de-c88f185e99e3",
                                                "text": "The cables are placed from 16 in. to 2 ft. down, and to save time and labour use was made of a mechanical digger lent by the Swedish State Railways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1090cbf-bbbc-3e7c-96db-7db2d3c24b75",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "A tool for digging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a1ce9d-7dbb-4125-b293-54d491e4fb54",
                                                "sense_id": "b1090cbf-bbbc-3e7c-96db-7db2d3c24b75",
                                                "text": "The post hole digger did look ancient. I was pretty certain myself that it hadn′t dug any holes for a long, long time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de2f5637-4dd5-303b-a785-301fb9f3cf45",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "A spade (playing card)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a59ac77-d16a-38ce-9b35-31c64b0ff9c2",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "One who digs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9877f7-aaf5-4b79-be4d-279fd9009a00",
                                                "sense_id": "0a59ac77-d16a-38ce-9b35-31c64b0ff9c2",
                                                "text": "You′ve tried the supposedly sure method of squirting the digger with water from a hose, and that hasn′t worked.[…]This step will discourage 99 percent of the diggers."
                                            },
                                            {
                                                "example_id": "ae47ce29-98fb-4a82-8b3b-42c94b48e4ff",
                                                "sense_id": "0a59ac77-d16a-38ce-9b35-31c64b0ff9c2",
                                                "text": "Most retrievers are not inveterate diggers — that′s a trait usually reserved for other breeds like wire-haired terriers and schnauzers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39f2ef9a-345c-39ce-83c7-bb8d2aa689b6",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "A gold miner, one who digs for gold."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a1ac5b3-23cb-4002-9b52-e08be97f8207",
                                                "sense_id": "39f2ef9a-345c-39ce-83c7-bb8d2aa689b6",
                                                "text": "A successful Australian digger — successful, not merely in siftings and washings, but bearing the title, and its best credentials, of a “nuggetter” − came down from Forest Creek recently and took up his abode in a low lodging-house in Little Bourke Street, Melbourne."
                                            },
                                            {
                                                "example_id": "0060c073-9b57-4aa9-92ac-c3d770e3b258",
                                                "sense_id": "39f2ef9a-345c-39ce-83c7-bb8d2aa689b6",
                                                "text": "Proofs of the presence of the white man are found all over the Territory in the shape of old bouilli tins, &c., and often when out after a strayed horse, I have imagined myself to be in wilds untrodden except by the foot of the blackfellow, but the sight of an unassuming empty sardine tin would remind me that the ubiquitous digger had been there first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b16ff50f-034f-3b27-874e-dec38b634035",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "An Australian soldier."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "095d6f6f-32c2-4870-b661-62f4e8e21476",
                                                "sense_id": "b16ff50f-034f-3b27-874e-dec38b634035",
                                                "text": "Costume played a key part in his differentiation from British soldiers as the Digger uniform came to embody Australian versions of masculinity and mateship."
                                            },
                                            {
                                                "example_id": "59715d30-cdd6-45a8-9727-337deb8fa315",
                                                "sense_id": "b16ff50f-034f-3b27-874e-dec38b634035",
                                                "text": "For many, the congruencies of the Anzac legend and the diggers who served in Vietnam were slight, too slight, and the legend seemed unable to accommodate them."
                                            },
                                            {
                                                "example_id": "9b62f9c3-d208-4322-be8a-8d5a7904c826",
                                                "sense_id": "b16ff50f-034f-3b27-874e-dec38b634035",
                                                "text": "Like many other Queensland communities, the workers from the North Ipswich Railway Workshops chose a statue of a soldier, or digger, to honour their fellow workers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0498ac2-4f1c-3136-a446-de92cff564eb",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "a friendly term of address, especially to a man."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
