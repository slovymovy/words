                    {
                        "sense_id": "bf9ddc22-6e69-3630-9880-23499bba67c2",
                        "entry_id": "ad0049fb-4995-30b3-9240-124307d3a394",
                        "glosses": [
                            "Période préhistorique hypothétique de la fin du paléolithique supérieur nommée d’après les découvertes archéologiques du site de Glozel."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "441b59ca-d309-4325-94f9-d7f6cc68849c",
                                "sense_id": "bf9ddc22-6e69-3630-9880-23499bba67c2",
                                "text": "Le glozélien, industrie de Glozel, près de Vichy, (Allier), de 5.000 à 10.000 ans environ avant notre ère, constitue le magdalénien terminal ou néolithique."
                            }
                        ]
                    },
                    {
                        "sense_id": "35e3261f-c084-3512-a8a7-4c4cda48c764",
                        "entry_id": "ad0049fb-4995-30b3-9240-124307d3a394",
                        "glosses": [
                            "Partisan de la véracité des découvertes archéologiques faites à Glozel."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "21701d7b-049e-478f-90d9-ebe812e356ad",
                                "sense_id": "35e3261f-c084-3512-a8a7-4c4cda48c764",
                                "text": "L’affaire de Glozel a empoisonné la vie de la communauté des préhistoriens français pendant toutes les années vingt et au début des années trente, divisant durablement la communauté scientifiques entre « glozéliens » et « anti-glozéliens »."
                            }
                        ]
                    },
                    {
                        "sense_id": "94e18ade-9f46-3119-848c-9f4c24540595",
                        "entry_id": "ad0049fb-4995-30b3-9240-124307d3a394",
                        "glosses": [
                            "Écriture et langue hypothétique trouvées sur les inscriptions de Glozel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "964a044b-abde-4840-9a90-a6813e361edf",
                                "sense_id": "94e18ade-9f46-3119-848c-9f4c24540595",
                                "text": "Le glozélien n’est pas une langue indigène. Il s'agit d’une langue indo-européenne et très probablement d’un ancêtre du slavon."
                            }
                        ]
                    }
