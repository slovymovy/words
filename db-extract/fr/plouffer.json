                        "glosses": [
                            "Employer une formulette d’élimination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e7b9ff0-777e-47cc-abec-8f601825c82b",
                                "sense_id": "1731e6b7-1bf6-3442-8c36-c9c8d727e6b2",
                                "text": "Elles servent souvent à se départager entre enfants, à plouffer et s’appellent alors formulettes d’élimination : souvenez-vous, l’un des joueurs scande la comptine, en détachant bien chaque syllabe, tout en touchant du doigt tour à tour les autres enfants."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad11281d-79f2-36dd-a0e2-3f24017530ed",
                        "entry_id": "01d15573-6e30-3e3f-9022-6451b802c750",
                        "glosses": [
                            "Faire plouf, plonger."
                        ],
                        "tags": [],
                        "examples": [
