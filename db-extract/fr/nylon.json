                                "target_senses": [
                                    {
                                        "sense_id": "da3fc15d-b17b-3c10-a6ed-f5ff84db4b84",
                                        "entry_id": "68055198-53c6-34e0-9399-51e461391478",
                                        "glosses": [
                                            "Originally, the DuPont company trade name for polyamide, a copolymer whose molecules consist of alternating diamine and dicarboxylic acid monomers bonded together; now generically used for this type of polymer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c17ae385-1dc8-3028-a23e-aa46adc32c5e",
                                        "entry_id": "68055198-53c6-34e0-9399-51e461391478",
                                        "glosses": [
                                            "A stocking originally fabricated from nylon; also used generically for any long, sheer stocking worn on a woman's legs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6d26353-c67c-4b46-a4b1-4a61dc5ea0f2",
                                                "sense_id": "c17ae385-1dc8-3028-a23e-aa46adc32c5e",
                                                "text": "I tore a hole in my nylons while walking home through the woods."
                                            },
                                            {
                                                "example_id": "1c6cf605-ead4-4858-a7dd-ceae54c39401",
                                                "sense_id": "c17ae385-1dc8-3028-a23e-aa46adc32c5e",
                                                "text": "1970-1975, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nHe put on make-up, nylons, panties, a dress."
                                            },
                                            {
                                                "example_id": "00f9869f-875b-4a26-ab22-6f6ebdac656f",
                                                "sense_id": "c17ae385-1dc8-3028-a23e-aa46adc32c5e",
                                                "text": "What you call love was invented by guys like me, to sell nylons. You're born alone and you die alone and this world just drops a bunch of rules on top of you to make you forget those facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90776faa-9fa6-3c79-b34b-b2f8b6fb4cdd",
                                        "entry_id": "68055198-53c6-34e0-9399-51e461391478",
                                        "glosses": [
                                            "A Queen's Counsel, King's Counsel or Senior Counsel who was appointed as a courtesy, rather than on merit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
