                "senses": [
                    {
                        "sense_id": "cc55807b-93c0-3f21-8239-1296cef760d6",
                        "entry_id": "05b4f458-51ef-32c7-8c80-5d7a51727021",
                        "glosses": [
                            "Donner un caractère gastronomique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0e0892e-e8f7-4849-bebb-e84e2f3c9bc3",
                                "sense_id": "cc55807b-93c0-3f21-8239-1296cef760d6",
                                "text": "Ne pas escamoter le petit déjeuner, diversifier l'alimentation éviter la monotonie, rendre les repas appétissants, gastronomiser les menus."
                            },
                            {
                                "example_id": "08754157-1b95-4622-af9e-e6acfe7e09a6",
                                "sense_id": "cc55807b-93c0-3f21-8239-1296cef760d6",
                                "text": "Car \"gastronomiser\" vos repas n'est pas défendu !"
                            },
                            {
                                "example_id": "f8f115f3-506c-4d41-91b1-8df593db8f07",
                                "sense_id": "cc55807b-93c0-3f21-8239-1296cef760d6",
                                "text": "Le Little Fernand a donc vu les choses en grand et décider de gastronomiser à la française le fameux sandwich."
                            }
                        ]
                    }
