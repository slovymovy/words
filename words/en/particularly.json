{
    "word_family": [
        "particular",
        "particularity",
        "particularize",
        "particularism"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "00af5e4a-b806-361d-a03c-51050f2a52a4",
                    "sense_definition": "To a higher degree than is usual or average; especially or extremely.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather today is <w>particularly</w> cold for this time of year.",
                            "target_lang_translations": {
                                "ru": "Погода сегодня <w>особенно</w> холодная для этого времени года."
                            }
                        },
                        {
                            "text": "She was <w>particularly</w> helpful when I was trying to find the right office.",
                            "target_lang_translations": {
                                "ru": "Она была <w>чрезвычайно</w> полезна, когда я пытался найти нужный офис."
                            }
                        }
                    ],
                    "synonyms": [
                        "exceedingly",
                        "primarily"
                    ],
                    "antonyms": [
                        "slightly",
                        "barely"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "В большей степени, чем обычно; крайне или в высшей степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "особенно",
                                "target_lang_sense_clarification": "в большей степени"
                            },
                            {
                                "target_lang_word": "чрезвычайно",
                                "target_lang_sense_clarification": "крайне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23814b65-6c1c-3fde-85db-0a06d6b19328",
                    "sense_definition": "Used to single out one person, thing, or situation from others; specifically.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "specification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I enjoy all kinds of music, <w>particularly</w> jazz and classical.",
                            "target_lang_translations": {
                                "ru": "Мне нравится любая музыка, <w>в частности</w> джаз и классика."
                            }
                        },
                        {
                            "text": "The teacher was <w>particularly</w> clear when explaining the new grammar rules.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснял новые грамматические правила <w>особенно</w> понятно."
                            }
                        }
                    ],
                    "synonyms": [
                        "specifically",
                        "in particular",
                        "above all",
                        "first and foremost"
                    ],
                    "antonyms": [
                        "generally",
                        "universally"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Используется для выделения одного человека, предмета или ситуации из ряда других; специально."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в частности",
                                "target_lang_sense_clarification": "для выделения конкретного примера"
                            },
                            {
                                "target_lang_word": "особенно",
                                "target_lang_sense_clarification": "прежде всего"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bef735fe-2122-3af0-b48d-4367c8d126b9",
                    "sense_definition": "In a way that provides specific details or considers individual parts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "detail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report describes <w>particularly</w> how the funds were allocated to each department.",
                            "target_lang_translations": {
                                "ru": "В отчете <w>подробно</w> описывается, как средства были распределены между отделами."
                            }
                        },
                        {
                            "text": "He spoke <w>particularly</w> about the challenges faced by the local community.",
                            "target_lang_translations": {
                                "ru": "Он <w>детально</w> рассказал о проблемах, с которыми сталкивается местное сообщество."
                            }
                        }
                    ],
                    "synonyms": [
                        "thoroughly",
                        "completely"
                    ],
                    "antonyms": [
                        "vaguely",
                        "broadly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробно, с учетом отдельных деталей или частей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подробно",
                                "target_lang_sense_clarification": "с деталями"
                            },
                            {
                                "target_lang_word": "детально",
                                "target_lang_sense_clarification": "по пунктам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaaca1be-9bd5-3b77-ba6a-a03eaa9daeaf",
                    "sense_definition": "In a way that is very careful or fastidious, often to an excessive degree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He arranged the books on the shelf <w>particularly</w>, ensuring every spine was perfectly aligned.",
                            "target_lang_translations": {
                                "ru": "Он <w>педантично</w> расставил книги на полке, следя за тем, чтобы каждый корешок стоял идеально ровно."
                            }
                        },
                        {
                            "text": "She was <w>particularly</w> fussy about the temperature of her tea.",
                            "target_lang_translations": {
                                "ru": "Она была <w>придирчива</w> к температуре своего чая."
                            }
                        }
                    ],
                    "synonyms": [
                        "fastidiously",
                        "pedantically",
                        "pickily",
                        "exacting"
                    ],
                    "antonyms": [
                        "carelessly",
                        "sloppily"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used to describe a fussy or exacting manner"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень тщательно или привередливо, часто до чрезмерной степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придирчиво",
                                "target_lang_sense_clarification": "с излишней тщательностью"
                            },
                            {
                                "target_lang_word": "педантично",
                                "target_lang_sense_clarification": "строго следуя правилам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}