                ],
                "senses": [
                    {
                        "sense_id": "f62c8dcb-b42e-351b-a288-08a10746d357",
                        "entry_id": "576857e6-357a-3db5-a969-651aafbcfe87",
                        "glosses": [
                            "Art zu leben, die sich auf dem Land (abseits von Städten) einstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2de17f00-81f3-4545-83d5-3a6ecf61ab85",
                                "sense_id": "f62c8dcb-b42e-351b-a288-08a10746d357",
                                "text": "„Du bist unglaublich gelassen, und vielleicht hatte das Landleben eine derartige Wirkung auf dich.“"
                            },
                            {
                                "example_id": "62dd21fc-a637-494f-a862-d80aa1fb0cb1",
                                "sense_id": "f62c8dcb-b42e-351b-a288-08a10746d357",
                                "text": "„Die Tradition des Landlebens wurzelt tief in der texanischen Seele.“"
                            },
                            {
                                "example_id": "ae4eddf8-fd5c-499b-ab4d-f10af3e158a5",
                                "sense_id": "f62c8dcb-b42e-351b-a288-08a10746d357",
                                "text": "„Das Brot war etwa eine Woche alt, und weil das Feuer schon glühte, röstete es Marcell als angehender Landbewohner und Fachmann für das Landleben an einer Gabel.“"
                            },
                            {
                                "example_id": "6d01a580-1b38-4a48-b055-0951d2fa89e5",
                                "sense_id": "f62c8dcb-b42e-351b-a288-08a10746d357",
                                "text": "„Das Landleben ist ruhig, unspektakulär und friedlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
