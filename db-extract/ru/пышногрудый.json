                ],
                "senses": [
                    {
                        "sense_id": "2f36b83c-b5b9-3a4f-acfa-fdf022d2c2ff",
                        "entry_id": "cdeca6b0-dee0-31f9-8a9a-9a05f71ccf9e",
                        "glosses": [
                            "имеющий высокую полную грудь (о человеке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b9a0a9d-fadf-4dbb-b75a-f4460cdb4913",
                                "sense_id": "2f36b83c-b5b9-3a4f-acfa-fdf022d2c2ff",
                                "text": "И тут Мишель столкнулась с заговором режиссеров, мечтавших эксплуатировать уже наработанный образ пышногрудой красавицы, романтической и эротической одновременно."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4a98de6-97cc-3564-80c1-2e71fc678eb6",
                        "entry_id": "cdeca6b0-dee0-31f9-8a9a-9a05f71ccf9e",
                        "glosses": [
                            "имеющий пышную грудку (о птицах и т. п.)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1eec29e-2b5a-4a55-bb63-bb863442e938",
                        "source_entry_id": "cdeca6b0-dee0-31f9-8a9a-9a05f71ccf9e",
                        "source_sense_description": "имеющий высокую полную грудь",
                        "target_lang_word": "full-bosomed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "full-bosomed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1104a2e1-0f82-30d5-96de-251a8416ec12",
                                        "entry_id": "e0533502-6194-3b88-8129-c8aaa7f3f1f4",
                                        "glosses": [
                                            "Having an ample bosom, having large breasts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf812c7-fa9c-487a-9c2a-e4f72e55592c",
                                                "sense_id": "1104a2e1-0f82-30d5-96de-251a8416ec12",
                                                "text": "A favorite epithet of the Greek poets, lyrical, epic, and dramatic, is deep-bosomed. […] Full-bosomed might imply a luxuriance every way. Deep-bosomed is spoken in one of those poetical feelings of contrast, which imply rather a dislike of the reverse quality"
                                            },
                                            {
                                                "example_id": "bf91ec6f-b01f-417c-ab7a-49f7b9f45064",
                                                "sense_id": "1104a2e1-0f82-30d5-96de-251a8416ec12",
                                                "text": "When he grew into a man, though, he sought out full-bosomed women like Inés, but unlike her, he wanted full-bosomed women who were also docile, compliant, and susceptible to flattery; in a word, he concentrated on women who would submit to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d16274f2-e142-319c-862a-0fa71e7d1fb9",
                                        "entry_id": "e0533502-6194-3b88-8129-c8aaa7f3f1f4",
                                        "glosses": [
                                            "Abundant, generous, large, excessive."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a39b46f-dfbd-4575-8865-ca6f3bf67877",
                                                "sense_id": "d16274f2-e142-319c-862a-0fa71e7d1fb9",
                                                "text": "For there's a something in the air. Summer is at its most full-bosomed ripeness. Soon it will be a little overripe."
                                            },
                                            {
                                                "example_id": "14704a28-f5a8-4508-91e6-477f2e977314",
                                                "sense_id": "d16274f2-e142-319c-862a-0fa71e7d1fb9",
                                                "text": "By the time Ama got to the scene, Egeonu had given four more full-bosomed wails. The lamentation did not leave anybody in doubt that something terrible had happened."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5e9a2c4-e382-43e5-bd9f-89fd7879103a",
                        "source_entry_id": "cdeca6b0-dee0-31f9-8a9a-9a05f71ccf9e",
                        "source_sense_description": "имеющий высокую полную грудь",
                        "target_lang_word": "buxom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buxom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f686d27-38e7-30b2-b18b-889561ea1397",
                                        "entry_id": "de3dcd9a-71b4-33db-bac0-9fda888212ab",
                                        "glosses": [
                                            "Having a full, voluptuous figure, especially possessing large breasts."
                                        ],
                                        "tags": [
                                            "of a woman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "367a13c9-c6ad-408d-94ce-d4010adc6d8c",
                                                "sense_id": "1f686d27-38e7-30b2-b18b-889561ea1397",
                                                "text": "Aarfy's buxom trollop had vanished with her smutty cameo ring, and Nurse Duckett was ashamed of him because he had refused to fly more combat missions and would cause a scandal."
                                            },
                                            {
                                                "example_id": "07ef4330-7e34-4c09-8724-8e739e09518d",
                                                "sense_id": "1f686d27-38e7-30b2-b18b-889561ea1397",
                                                "text": "DIED. Robert Brooks, 69, canny businessman who, as chairman of Hooters, turned the bar-restaurant chain, famed for buxom waitresses in orange hot pants, into an international success."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb651f2-7fba-304b-8f55-4b3e7beea902",
                                        "entry_id": "de3dcd9a-71b4-33db-bac0-9fda888212ab",
                                        "glosses": [
                                            "Full of health, vigour, and good temper."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c301c707-b110-49b0-8767-a7f42507d1c7",
                                                "sense_id": "0cb651f2-7fba-304b-8f55-4b3e7beea902",
                                                "text": "There on Beds of Violets blew, / And freſh-blown Roſes waſht in dew, / Fill'd her with thee a daughter fair, / So buckſom, blith, and debonair."
                                            },
                                            {
                                                "example_id": "52a74310-b906-4432-b6cc-6a19f013f71d",
                                                "sense_id": "0cb651f2-7fba-304b-8f55-4b3e7beea902",
                                                "text": "Claypole, the buxom novelist,...[his] bubbling utterances...."
                                            },
                                            {
                                                "example_id": "a5a8b9bf-456c-457e-aabc-59a9f00dcca3",
                                                "sense_id": "0cb651f2-7fba-304b-8f55-4b3e7beea902",
                                                "text": "So heated and impassioned, indeed, would they become, that the lady hardly felt herself safe in their company at such times, notwithstanding that she was a brave and buxom damsel, not easily put out, and with a daring spirit of humour in her composition."
                                            },
                                            {
                                                "example_id": "422739f3-8f10-40c4-a284-86beec89f4b7",
                                                "sense_id": "0cb651f2-7fba-304b-8f55-4b3e7beea902",
                                                "text": "He had not seen Zilla since Paul had shot her, and he still pictured her as buxom, high-colored, lively, and a little blowsy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc9e868b-f7e1-3af0-9e48-9345fd31f360",
                                        "entry_id": "de3dcd9a-71b4-33db-bac0-9fda888212ab",
                                        "glosses": [
                                            "Physically flexible or unresisting."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8aeb443-b356-474c-832e-966eb9574278",
                                                "sense_id": "fc9e868b-f7e1-3af0-9e48-9345fd31f360",
                                                "text": "Their substance is of a middle Nature betwixt bones and gristles moderately hard, the better to beare the violence of outward iniures, flexible or buxome that they should not breake but giue way to violence, pellucide or transparant and therefore they are either red or liuid according to their flesh vnder them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81340095-7435-3c2d-92a2-9f310ce31125",
                                        "entry_id": "de3dcd9a-71b4-33db-bac0-9fda888212ab",
                                        "glosses": [
                                            "Morally pliant; obedient and easily yielding to pressure."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114743e4-6c62-4afd-b524-8dc38f3337e9",
                                                "sense_id": "81340095-7435-3c2d-92a2-9f310ce31125",
                                                "text": "They downe him hold, and fast with cords do bynde, / Till they him force the buxome yoke to beare […]."
                                            },
                                            {
                                                "example_id": "33219fc3-80b4-4634-81b5-b185f7d32cfc",
                                                "sense_id": "81340095-7435-3c2d-92a2-9f310ce31125",
                                                "text": "You will certainly be rewarded for this improvement in your conduct by a notable increase of tranquillity and cheerfulness in your view both of the past and of the future; and in the hope that you will be buxom and good, I conclude by New Year's lecture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c66594e1-f124-4cac-90b3-9a672c9c3123",
