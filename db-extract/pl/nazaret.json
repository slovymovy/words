                    {
                        "translation_id": "fd95c2f0-21ef-448d-88e7-fe9c7524b00a",
                        "source_entry_id": "6968ad2c-4ce9-39a1-bfc9-77a9c0256e93",
                        "source_sense_id": "3d3bed5b-9102-3a38-a7ef-db74e5018f04",
