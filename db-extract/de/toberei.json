                            {
                                "example_id": "8a450fd5-1122-4596-969a-6ed0423a06c0",
                                "sense_id": "f1c6b67f-2b29-3843-bdb1-e9b79b8afd53",
                                "text": "„Lange spannten sie mich nicht auf die Folter, und bald begann die Balgerei, Toberei und Spielerei von Neuem.“"
                            },
                            {
                                "example_id": "ff34c9b5-e440-4cbd-a6b4-73083a6d5163",
                                "sense_id": "f1c6b67f-2b29-3843-bdb1-e9b79b8afd53",
                                "text": "„Ihre Toberei hatte man hinzunehmen wie ein Unwetter im Sommer - man musste eben gucken, dass man sich rechtzeitig in Sicherheit brachte.“"
                            }
                        ],
