                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02ba0356-9088-4e00-9e3a-b1e8d6410817",
                                "sense_id": "0ffb73e0-3e87-3971-bb78-c555a20016bb",
                                "text": "Er is een gedicht geschreven voor de man wiens romp in het IJ gevonden is. Donderdag werd het dichtstuk voorgedragen bij de begrafenis van de nog onbekende man."
                            },
                            {
                                "example_id": "5b5576b6-be54-4d1c-ae88-cb2bf042873f",
                                "sense_id": "0ffb73e0-3e87-3971-bb78-c555a20016bb",
                                "text": "Dit dichtstuk, geschreven als drama, dat dus als toneelstuk zou kunnen worden opgevoerd, is ook prachtig van zeggingskracht. Milton stierf in 1674. Zijn evenknie John Bunyan overleefde hem veertien jaar."
                            }
                        ]
                    }
