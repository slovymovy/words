                "senses": [
                    {
                        "sense_id": "630b8b23-c781-3211-b000-672a98b4d704",
                        "entry_id": "32e30850-3830-3c48-9725-57c3d9b35df6",
                        "glosses": [
                            "To own, to defeat or dominate (someone or something, especially a game or someone playing a game)."
                        ],
                        "tags": [
                            "Internet",
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "43525fee-4a1d-45ed-9704-d3d8863d2769",
                                "sense_id": "630b8b23-c781-3211-b000-672a98b4d704",
                                "text": "I pwned them in game!"
                            },
                            {
                                "example_id": "2c6f30f2-cdb3-486d-af24-16a62c3d95ea",
                                "sense_id": "630b8b23-c781-3211-b000-672a98b4d704",
                                "text": "2nd guard: \"Yeah, shiiit! I PWNED YO @zz!\""
                            },
                            {
                                "example_id": "79d21257-5d13-4b00-882e-c75acb8077fe",
                                "sense_id": "630b8b23-c781-3211-b000-672a98b4d704",
                                "text": "Otherwise I use fury as my normal attack. Fury completely pwns!"
                            },
                            {
                                "example_id": "30606103-1518-4c35-a930-c80b2430cd22",
                                "sense_id": "630b8b23-c781-3211-b000-672a98b4d704",
                                "text": "When you get to the Temple of Marr, look very closely at the vases at zone-in and see if you can find the picture where Mith Marr \"pwns\" someone."
                            },
                            {
                                "example_id": "39a80d71-625a-4608-bc8a-a9b4e2d37946",
                                "sense_id": "630b8b23-c781-3211-b000-672a98b4d704",
                                "text": "My Trident pwns the Cirrus Logics!"
                            },
                            {
                                "example_id": "699eb947-7db6-4ba5-b3bb-2fd391334771",
                                "sense_id": "630b8b23-c781-3211-b000-672a98b4d704",
                                "text": "NOOBZ STILL R NOT PWNED. CONTINUE PWNERSHIP UNTIL ALL NOOBZ R PWNED."
                            },
                            {
                                "example_id": "ceb50c14-f767-47a6-9c1a-425ea7db3321",
                                "sense_id": "630b8b23-c781-3211-b000-672a98b4d704",
                                "text": "The episode follows two different stories: in one, the show’s resident bigot, Eric Cartman, is outraged to learn that fellow fourth grader Clyde has risen to prominence as a white nationalist podcaster who makes offensive claims about women, Jewish people, Black people and other minority groups to goad them into debating him in exploitative viral videos (“WOKE STUDENT TOTALLY PWNED”)."
                            }
                        ]
                    }
                ],
