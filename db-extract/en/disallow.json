                "senses": [
                    {
                        "sense_id": "75a33c75-4085-39a4-bf1a-eaa144023c82",
                        "entry_id": "9c417838-ee47-370d-b23b-321ab4cdfc05",
                        "glosses": [
                            "To refuse to allow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32167cbd-c273-4d8e-acd5-6adb3305461c",
                                "sense_id": "75a33c75-4085-39a4-bf1a-eaa144023c82",
                                "text": "The prisoners were disallowed to contact with a lawyer."
                            }
                        ]
                    },
                    {
                        "sense_id": "aabed668-e177-3459-b611-7c6a6554e47d",
                        "entry_id": "9c417838-ee47-370d-b23b-321ab4cdfc05",
                        "glosses": [
                            "To reject as invalid, untrue, or improper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b308c66-563a-421b-bdca-df300ccdc197",
                                "sense_id": "aabed668-e177-3459-b611-7c6a6554e47d",
                                "text": "The goal was disallowed because the player was offside."
                            },
                            {
                                "example_id": "549398e2-2ed3-41b0-bc7f-f87fc955e315",
                                "sense_id": "aabed668-e177-3459-b611-7c6a6554e47d",
                                "text": "England will regard it as a measure of justice for Frank Lampard's disallowed goal against Germany in Bloemfontein at the 2010 World Cup - but it was also an illustration of how they rode their luck for long periods in front of a predictably partisan home crowd."
                            }
                        ]
                    },
                    {
                        "sense_id": "d90d1173-29b1-3dbd-a914-7a7c76634dce",
                        "entry_id": "9c417838-ee47-370d-b23b-321ab4cdfc05",
                        "glosses": [
                            "To overrule a colonial legislation by the sovereign-in-privy council."
                        ],
                        "tags": [
                            "UK",
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
