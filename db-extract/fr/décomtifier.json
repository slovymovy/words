                "senses": [
                    {
                        "sense_id": "9c66afeb-e9c5-3f2d-a971-8f54bc1b6b7f",
                        "entry_id": "79b0f07b-21b5-3f1e-bce3-83960a2e96e0",
                        "glosses": [
                            "Enlever à quelqu'un son statut de comte ou de comtesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f28ad88-6a5f-437e-a052-b8900bb5ea5b",
                                "sense_id": "9c66afeb-e9c5-3f2d-a971-8f54bc1b6b7f",
                                "text": "BAUDARINET. Décomtifiez-la. MAD. KURIKLA. Oui ; vieux fou, je la décomtifierai."
                            },
                            {
                                "example_id": "7515143a-855b-4e38-8da2-a2fc3e6c25f5",
                                "sense_id": "9c66afeb-e9c5-3f2d-a971-8f54bc1b6b7f",
                                "text": "Toutefois, les siens, fort nombreux, figurant dans le Bottin, se trouvèrent du même coup moralement « décomtifiés »."
                            },
                            {
                                "example_id": "c1efa194-1871-45c4-bef7-b1d848f61885",
                                "sense_id": "9c66afeb-e9c5-3f2d-a971-8f54bc1b6b7f",
                                "text": "Alexis priait ses amis de le « décomtifier » parce qu’il croyait les titres nobiliaires insupportables dans les temps démocratiques."
                            }
                        ]
                    }
                ],
