                ],
                "senses": [
                    {
                        "sense_id": "60ba79cf-f57b-3a0d-aee7-0b442aec6e6a",
                        "entry_id": "90e5e952-875d-3e8e-ae65-5641199b6f37",
                        "glosses": [
                            "Hervorhebung der besonderen Eigenschaften typischer Kunststoffe; das Charakterisieren oder auch das Charakterisiertwerden von Polymeren"
                        ],
                        "tags": [
                            "Polymercharakterisierung"
                        ],
                        "examples": [
                            {
                                "example_id": "f60a8a5f-92ff-463f-95fa-4388825878f2",
                                "sense_id": "60ba79cf-f57b-3a0d-aee7-0b442aec6e6a",
                                "text": "Es gibt Messsysteme zur Kunststoffcharakterisierung."
                            },
                            {
                                "example_id": "ca9ca81d-bf01-4aeb-8d28-b93cf44eed54",
                                "sense_id": "60ba79cf-f57b-3a0d-aee7-0b442aec6e6a",
                                "text": "„Das Labor für Kunststofftechnik bietet vielfältige Möglichkeiten zur Kunststoffverarbeitung, Kunststoffprüfung und zur Kunststoffcharakterisierung.“"
                            },
                            {
                                "example_id": "1fd4fddf-5c7f-43dd-97bf-8334135862bd",
                                "sense_id": "60ba79cf-f57b-3a0d-aee7-0b442aec6e6a",
                                "text": "„Zu den Labordienstleistungen für Polyscope gehören die Kunststoffcharakterisierung für Materialien sowie die Optimierung der Verarbeitbarkeit von XIRAN®.“"
                            },
                            {
                                "example_id": "a9b9f358-bfb4-4080-8616-11b65d987f92",
                                "sense_id": "60ba79cf-f57b-3a0d-aee7-0b442aec6e6a",
                                "text": "„Dabei werden Standardversuche aus der Blechwerkstoff- und Kunststoffcharakterisierung für verschiedene Belastungszustände durchgeführt.“"
                            },
                            {
                                "example_id": "15e20c73-c407-4005-b443-37db66242703",
                                "sense_id": "60ba79cf-f57b-3a0d-aee7-0b442aec6e6a",
                                "text": "„Graz - Mit dem Grazer \"CePoL\" (Central Polymer Laboratory) wird am kommenden Freitag, 6. Juni, ein österreichweit einzigartiges Zentrum zur Kunststoffcharakterisierung eröffnet.“"
                            },
                            {
                                "example_id": "4459d3e0-c76d-45e2-8697-91897db65ae0",
                                "sense_id": "60ba79cf-f57b-3a0d-aee7-0b442aec6e6a",
                                "text": "„In Übersichtsvorträgen, Kurzvorträgen, Postern und Diskussionsrunden sollen Fortschritte in der Grundlagenforschung und der angewandten Forschung auf dem Gebiet der Kunststoffcharakterisierung und -prüfung diskutiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
