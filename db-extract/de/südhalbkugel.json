                "senses": [
                    {
                        "sense_id": "940678da-f7a0-3fa7-81fd-b942da89960d",
                        "entry_id": "8627e372-93d8-35b5-9d41-a1b8e21a19e3",
                        "glosses": [
                            "südlich des Äquators gelegener Erdteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "818db563-c6a0-44e2-b54a-d0e725681108",
                                "sense_id": "940678da-f7a0-3fa7-81fd-b942da89960d",
                                "text": "Wenn auf der Nordhalbkugel Sommer ist, herrscht auf der Südhalbkugel Winter."
                            },
                            {
                                "example_id": "ed7c96ae-d6e5-47ac-9923-452070051f1e",
                                "sense_id": "940678da-f7a0-3fa7-81fd-b942da89960d",
                                "text": "„Auf der Südhalbkugel zählen das südliche Chile, Südostaustralien und die Südinsel Neuseelands zu den kühlgemäßigten Breiten.“"
                            },
                            {
                                "example_id": "4fc9318c-6ea2-4e53-a93e-2281f16e9969",
                                "sense_id": "940678da-f7a0-3fa7-81fd-b942da89960d",
                                "text": "„Auf dem Gondwanaland der Südhalbkugel herrschte ein kühlgemäßigtes Klima, das auch Vereisungsspuren hinterließ (Permokarbonische Eiszeit).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
