                                "sense_id": "ab2dc01f-ee77-3bbb-9255-29c051da4f0f",
                                "text": "We spent all day doing the tiling in the bathroom."
                            }
                        ]
                    },
                    {
                        "sense_id": "4430c032-e389-3a84-ad6f-1dbe18803e31",
                        "entry_id": "475146f3-b1e3-3b99-ba7d-d4490713813f",
                        "glosses": [
