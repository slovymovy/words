                    {
                        "sense_id": "e0aba2eb-d995-3b5f-b076-07345794325b",
                        "entry_id": "59dcb86a-ed4f-3214-a38f-d9187b5a3d29",
                        "glosses": [
                            "Qui promeut comme norme le fait qu’une personne née mâle s’identifie comme homme et qu’une personne née femelle s’identifie comme femme."
                        ],
                        "tags": [
                            "Transféminisme"
                        ],
                        "examples": [
                            {
                                "example_id": "c532fc2d-6982-4531-9d0c-a88bd4eda99f",
                                "sense_id": "e0aba2eb-d995-3b5f-b076-07345794325b",
                                "text": "En plus, on nous impose un « parcours » psychiatrisé, cisnormé et hétérocentré qui ne prend pas en considération le fait que nous sommes des êtres humains avec des identités propres, avec des besoins et des désirs qui nous sont propres."
                            },
                            {
                                "example_id": "0254b08f-fc1a-4c1e-93ab-c867ce788d3b",
                                "sense_id": "e0aba2eb-d995-3b5f-b076-07345794325b",
                                "text": "Peut être que ça va changer si je considère plus mon corps comme féminin vu que j’ai un cerveau hyper cisnormé."
                            }
                        ]
                    }
