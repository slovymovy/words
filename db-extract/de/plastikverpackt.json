                "senses": [
                    {
                        "sense_id": "21ba2d2a-3687-32c3-ab42-3fa4b80fe8e9",
                        "entry_id": "b8fa770d-cabf-3f2c-9ceb-f3a558c3732f",
                        "glosses": [
                            "mit Plastik verpackt, in einer Plastikverpackung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba304d4-449b-4a90-9e5a-799af540e008",
                                "sense_id": "21ba2d2a-3687-32c3-ab42-3fa4b80fe8e9",
                                "text": "„An einem Automaten vor einer Bar mit Klavier zog er sich einen Kaffee, eine Flasche Wasser und plastikverpackte Würstchen, die er dann auf Deck verzehrte und die nach Plastik schmeckten.“"
                            },
                            {
                                "example_id": "6b18fa10-cd96-40fc-92d7-513e1598480e",
                                "sense_id": "21ba2d2a-3687-32c3-ab42-3fa4b80fe8e9",
                                "text": "„Ein kleiner Pickup, ganzflächig bemalt mit einer Werbung für die Daily Nation, hielt kurz an, und ein Mann warf ein plastikverpacktes Bündel von der Ladefläche Richtung Kiosk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
