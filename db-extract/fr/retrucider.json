                                "example_id": "00b72a38-fe6e-4a99-a3d1-00e455c7c130",
                                "sense_id": "3f3db2e6-4105-3b27-848f-679feb04afa3",
                                "text": "14 ans après, on tourne un film sur ce meurtre, et quelqu’un a la bonne idée de retrucider tout ce qui bouge."
                            },
