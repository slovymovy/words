                                    },
                                    {
                                        "sense_id": "d84d1f32-c79c-377e-89f5-02eaae69e419",
                                        "entry_id": "0e2522c2-849e-37d6-9d43-ea6739e805f9",
                                        "glosses": [
                                            "A brief oration or script at the end of a literary piece; an afterword"
