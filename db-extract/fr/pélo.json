                        "entry_id": "a0c07925-f5e6-3224-ae4c-8c5f444a0e3e",
                        "glosses": [
                            "Mec, gars, type (avec ou sans connotation péjorative)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6c227baa-0b83-4d0e-b1e8-874af31bfac0",
                                "sense_id": "ef29c718-f8da-319f-9dbe-2cd3501eb006",
                                "text": "Tu sais où c’est, la falaise du Saut ? Au milieu de nulle part. Y a pas un pélo là-bas."
                            }
                        ]
                    }
