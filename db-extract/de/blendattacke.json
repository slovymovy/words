                "senses": [
                    {
                        "sense_id": "a4688492-6218-3b51-8d05-ace8ee4d6b2e",
                        "entry_id": "7c7d7cf7-3b88-3709-9209-dccd8ae57737",
                        "glosses": [
                            "das Blenden der Piloten von startenden oder landenden Flugzeugen/Hubschraubern mithilfe eines leuchtstarken Laserpointers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aead858-30fc-485b-8034-952e85588997",
                                "sense_id": "a4688492-6218-3b51-8d05-ace8ee4d6b2e",
                                "text": "„In den USA muss ein Mann wegen einer Blendattacke mit einem Laserstrahl zweieinhalb Jahre hinter Gitter.“"
                            },
                            {
                                "example_id": "114c69bd-4b5c-4b23-b84f-241fcae70a7b",
                                "sense_id": "a4688492-6218-3b51-8d05-ace8ee4d6b2e",
                                "text": "„Die 22 und 33 Jahre alten Männer hatten die Blendattacke auf einen Linienflieger im Anflug auf den Düsseldorfer Flughafen zwar zugegeben, aber nicht gesagt, wer von ihnen der Täter war.“"
                            },
                            {
                                "example_id": "b7c9ad3a-b19d-4628-9143-c36b774ee271",
                                "sense_id": "a4688492-6218-3b51-8d05-ace8ee4d6b2e",
                                "text": "„Offiziellen Angaben zufolge haben die Blendattacken mit Laserpointern auf Piloten in den vergangenen Monaten drastisch zugenommen.“"
                            },
                            {
                                "example_id": "8c90a3a7-5c2d-4467-ba03-dfa38590e17a",
                                "sense_id": "a4688492-6218-3b51-8d05-ace8ee4d6b2e",
                                "text": "„Auch an anderen deutschen Flughäfen hat es immer wieder solche Blendattacken gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
