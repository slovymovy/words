                        "examples": [
                            {
                                "example_id": "97190015-8e67-455b-bc37-fc6a1fdd1443",
                                "sense_id": "a6dbce8a-0c76-3f6e-83ce-70e95abf3ed3",
                                "text": "Een zwemmer draagt bij voorkeur badkleding."
                            },
                            {
                                "example_id": "4e04d14e-fcfe-4d89-8347-c9120ae28433",
                                "sense_id": "a6dbce8a-0c76-3f6e-83ce-70e95abf3ed3",
                                "text": "Op de drempel van het portaal leken ze net twee zwemmers die op het punt stonden een duik te nemen, en toen Leo opzijkeek, werd zijn aandacht getrokken door iets vlak boven haar hoofd."
                            },
                            {
                                "example_id": "e76e735f-6735-4026-bb62-2416613a9f74",
                                "sense_id": "a6dbce8a-0c76-3f6e-83ce-70e95abf3ed3",
                                "text": "' 'Maar er is nog een mogelijkheid: die grote persoonlijkheden van jou waren misschien wel niets meer dan zwemmers in de rivier van de geschiedenis."
                            }
                        ]
                    }
