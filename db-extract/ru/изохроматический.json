                    },
                    {
                        "translation_id": "c7a8384d-728d-462c-9de3-f6a252bca297",
                        "source_entry_id": "1f4b18cc-0a50-3273-b425-a3ce42ff88fd",
                        "target_lang_word": "gleichfarbig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gleichfarbig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aff3cfa2-8040-35e3-8356-9b3a36f3bb8d",
                                        "entry_id": "5e558d71-9554-3714-ac66-9684bb6f9cbd",
                                        "glosses": [
                                            "von gleicher Farbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d7c09b-3e01-4268-9de4-ebf46c738059",
                                                "sense_id": "aff3cfa2-8040-35e3-8356-9b3a36f3bb8d",
                                                "text": "Zu den Fußpässen gehören gleichfarbige Sticker, mit denen beispielsweise die Patientenakte markiert werden kann."
                                            },
                                            {
                                                "example_id": "31eaf9a2-4e0c-4819-b5b4-6b733779d3ab",
                                                "sense_id": "aff3cfa2-8040-35e3-8356-9b3a36f3bb8d",
                                                "text": "Für die Veranstaltung hatte sich die Popröhre stilecht in Schale geworfen, sie wählte eine schwarze Lederjacke und ein gleichfarbiges Top."
                                            },
                                            {
                                                "example_id": "e36d867a-08a9-43f4-a241-c75179db76ea",
                                                "sense_id": "aff3cfa2-8040-35e3-8356-9b3a36f3bb8d",
                                                "text": "Um auf dem Spielfeld Platz zu schaffen, muss der Spieler fünf oder mehr gleichfarbige Bälle in horizontalen, vertikalen oder diagonalen Linien anordnen."
                                            },
                                            {
                                                "example_id": "a0ddf8cd-1417-4c10-b1f9-a9b28e9e0cb4",
                                                "sense_id": "aff3cfa2-8040-35e3-8356-9b3a36f3bb8d",
                                                "text": "Ein Endspiel beispielsweise von König und Leichtfigur gegen König und Leichtfigur oder Bauer ist also als Sieg zu werten, sofern es sich bei den beiden Leichtfiguren nicht um gleichfarbige Läufer handelt, da ein Hilfsmatt noch möglich ist."
                                            },
                                            {
                                                "example_id": "c1752d14-7e05-4661-abee-64c45d065e22",
                                                "sense_id": "aff3cfa2-8040-35e3-8356-9b3a36f3bb8d",
                                                "text": "Sie besitzt ein mikrogestrahltes und dadurch reflexfreies Titangehäuse, das nahtlos in ein gleichfarbiges Kautschukarmband mit markantem „geländegängigem“ Profil übergeht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
