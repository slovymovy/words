                    {
                        "sense_id": "2d757c52-6901-3ee4-9f81-3a1069a91c85",
                        "entry_id": "805a29f9-22ec-3690-933c-3d46c373ff39",
                        "glosses": [
                            "eenzelvig persoon, iemand die niet tot een groep behoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a494331-40f7-4881-9739-8ed5689abc8e",
                                "sense_id": "2d757c52-6901-3ee4-9f81-3a1069a91c85",
                                "text": "De AIVD is bang voor eenlingen met kwade bedoelingen, want die zijn moeilijk te traceren."
                            },
                            {
                                "example_id": "add17bd8-9b1a-45f7-9b85-fc5b3d15b308",
                                "sense_id": "2d757c52-6901-3ee4-9f81-3a1069a91c85",
                                "text": "Agractie-voorman Bart Kemp beschouwt de boeren die minister Van der Wal en verschillende Kamerleden bedreigen als eenlingen. Hij weigert een verzoek te doen om de bedreigingen en gewelddadigheden te stoppen. \"Roep ik daartoe op dan? Ik heb nooit iets anders gedaan dan oproepen tot protest binnen de wettelijke grenzen,\" zegt hij tegen NU.nl."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5eea2c1b-0315-4f73-b974-22680a02602b",
                        "source_entry_id": "805a29f9-22ec-3690-933c-3d46c373ff39",
                        "source_sense_id": "2d757c52-6901-3ee4-9f81-3a1069a91c85",
                        "target_lang_word": "loner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                        "entry_id": "250d9019-1170-33ad-a60d-87db8ce134da",
                                        "glosses": [
                                            "One who is alone, lacking or avoiding the company of others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375be8ce-68db-4825-946a-8635e7f18b1e",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "I actually enjoy being a loner."
                                            },
                                            {
                                                "example_id": "3b0c1299-eb28-437c-91b4-47c998d2ab6a",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "For one thing, he wanted to see if anyone was following Ricketts. The Cockney had been thrown out of SAS because he was a loner and a canteen cowboy."
                                            },
                                            {
                                                "example_id": "7e7d9617-bff3-4fac-9c81-9fab24c7de85",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "I remember reading an article that described three personality types – socializers, loners, and aloners."
                                            },
                                            {
                                                "example_id": "95295597-8540-4f6f-9cde-e59fc0f15759",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "An unaspected planet bides its time and then emerges, often explosively and seemingly out of character. These potent loners are a hidden influence within the chart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
