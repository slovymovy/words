                    "sense_id": "4cbb8a00-6ba6-38e8-b244-40a8d2844007",
                    "sense_definition": "Formule familière employée pour se dire au revoir au moment de se quitter.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois partir maintenant pour attraper mon train, alors je vous dis <w>ciao</w> et à demain !",
                            "target_lang_translations": {
                                "en": "I have to go now to catch my train, so I'll say <w>bye</w> and see you tomorrow!",
                                "ru": "Мне надо сейчас уйти, чтобы не опоздать на поезд, так что <w>пока</w> и до завтра!",
                                "de": "Ich muss jetzt los, um meinen Zug nicht zu verpassen, also sage ich Ihnen <w>Tschüs</w> und bis morgen!",
                                "es": "¡Tengo que irme ya para tomar el tren, así que les digo <w>chao</w> y hasta mañana!",
                                "zh": "我现在得走了，要赶火车，先跟你们说<w>再见</w>，明天见！"
                            }
                        },
                        {
                            "text": "Il a fait un geste de la main avant de lancer un joyeux <w>ciao</w> à tous ses amis.",
                            "target_lang_translations": {
                                "en": "He gave a little wave before calling out a cheery <w>bye</w> to all his friends.",
                                "ru": "Он помахал рукой и весело крикнул всем друзьям: «<w>Пока</w>!»",
                                "de": "Er winkte kurz, bevor er allen seinen Freunden ein fröhliches <w>Tschüs</w> zurief.",
                                "es": "Hizo un gesto con la mano antes de gritar un alegre <w>chao</w> a todos sus amigos.",
                                "zh": "他挥了挥手，然后向所有朋友欢快地喊了一声<w>拜拜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "au revoir",
                        "salut"
                    ],
                    "common_phrases": [
                        "dire ciao"
                    ],
                    "traits": [
                        {
