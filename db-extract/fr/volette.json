                        "examples": [
                            {
                                "example_id": "1d18e623-618b-48ac-9bac-6c8ea7f4026b",
                                "sense_id": "2180dc97-9283-3dc2-8b4e-b32764628e39",
                                "text": "Les vanniers font des corbeilles qui ressemblent aux tables hyperboloïdes. Ils lient à une baguette droite, un cercle d'osier destiné à former le pied de la corbeille, puis la volette circulaire du fond, puis le cercle d'osier du bord. Le rayon de la volette est moindre que celui du pied et il en est de même de ce dernier relativement au rayon du bord."
                            }
                        ]
                    },
                    {
                        "sense_id": "7755f77b-1268-3f9c-b92d-19bf96b1060b",
                        "entry_id": "43f678c0-b4ef-3485-98da-429dd053ec33",
                        "glosses": [
                            "Rangée de cordelette du réseau dont on couvrait les chevaux pour chasser les mouches quand le cheval se secouait."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
