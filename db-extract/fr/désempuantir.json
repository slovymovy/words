                "senses": [
                    {
                        "sense_id": "9c43c7f2-55e0-3638-9160-57f108c7de9e",
                        "entry_id": "a9d5e349-cf37-38e8-b504-ecb00b2ece99",
                        "glosses": [
                            "Faire cesser la puanteur de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f550bb8-82fe-4003-8fad-5a8fa386865f",
                                "sense_id": "9c43c7f2-55e0-3638-9160-57f108c7de9e",
                                "text": "Il fut difficile de désempuantir la pièce."
                            },
                            {
                                "example_id": "72152d29-5e18-43b0-b05d-ede6883def2d",
                                "sense_id": "9c43c7f2-55e0-3638-9160-57f108c7de9e",
                                "text": "On peut pas rester sous cette croûte… on finirait par en crever… d’intoxication… les pores obturés. Absolument trouver de la flotte… se baigner… se désempuantir…"
                            },
                            {
                                "example_id": "9eb77107-8f39-4152-a445-b02a9ac7c454",
                                "sense_id": "9c43c7f2-55e0-3638-9160-57f108c7de9e",
                                "text": "Il se dit qu’il avait trouvé là le plus beau moyen de se désempuantir."
                            }
                        ]
                    }
