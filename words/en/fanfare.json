    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48d515f8-e6ea-350c-8d8f-6c9f404c7a5e",
                    "sense_definition": "A short, loud musical flourish played on trumpets or horns to announce someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They played a short <w>fanfare</w> to announce the arrival of the king."
                        },
                        {
                            "text": "The orchestra began the ceremony with a triumphant <w>fanfare</w> of trumpets."
                        }
                    ],
                    "synonyms": [
                        "flourish",
                        "blast"
                    ],
                    "common_phrases": [
                        "trumpet fanfare"
                    ]
                },
                {
                    "sense_id": "d391d893-cc46-3535-a11b-a5099d0664b1",
                    "sense_definition": "A showy, noisy, or elaborate display of ceremony or celebration.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ceremony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The town opened the new library with <w>fanfare</w> and a speech from the mayor."
                        },
                        {
                            "text": "The product was launched with great <w>fanfare</w> and media attention."
                        }
                    ],
                    "synonyms": [
                        "pomp",
                        "pageantry",
                        "spectacle"
                    ],
                    "common_phrases": [
                        "with much fanfare"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
