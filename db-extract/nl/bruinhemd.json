                                        "glosses": [
                                            "Person, die [1] trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305d66c8-3886-416d-9f39-c267d3c221f7",
                                                "sense_id": "da1c05e2-9219-3d1a-bcbf-bcd0a931e2ae",
                                                "text": "„Johann hatte keine gute Meinung von ihr und wurde sogar einmal von den Braunhemden verprügelt, aber er wollte überleben.“"
                                            },
                                            {
                                                "example_id": "2db4350d-f4a6-4576-bf58-2f25d56b2df0",
                                                "sense_id": "da1c05e2-9219-3d1a-bcbf-bcd0a931e2ae",
                                                "text": "„Ein Trupp von Braunhemden war gerade dabei, die Litfaßsäule mit knallroten Transparenten zu überkleben.“"
                                            },
                                            {
                                                "example_id": "a32a2f4e-cdbc-45c2-82e7-a40c0783038a",
                                                "sense_id": "da1c05e2-9219-3d1a-bcbf-bcd0a931e2ae",
                                                "text": "„Seine Braunhemden sind nichts als Pöbel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
