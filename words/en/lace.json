                            "trait_type": "archaic",
                            "comment": "slang or colloquial in older usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бить; хлестать; оставлять полосы.",
                        "zh": "鞭打；抽打；在身上留下条纹。"
