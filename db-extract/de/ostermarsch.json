                                "sense_id": "57def155-ab83-32e8-9e15-29a9612abd82",
                                "text": "„In Hamburg beteiligten sich rund tausend Menschen an einem Ostermarsch.“"
                            },
                            {
                                "example_id": "630a256c-f9b1-476d-8af7-f55149135c2d",
                                "sense_id": "57def155-ab83-32e8-9e15-29a9612abd82",
                                "text": "„Gemeinsam zogen sie beim Ostermarsch von Bochum nach Essen, gingen mit im Trauermarsch für Benno Ohnesorg, protestierten gegen den Krieg in Vietnam.“"
                            },
                            {
                                "example_id": "1b7ad778-4990-4ab2-956c-690dd521694d",
                                "sense_id": "57def155-ab83-32e8-9e15-29a9612abd82",
                                "text": "„Kästner marschiert bei Ostermärschen mit, protestiert gegen den Vietnam-Krieg.“"
                            }
