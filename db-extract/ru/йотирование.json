                ],
                "senses": [
                    {
                        "sense_id": "835e2ccf-ba95-3bf3-8490-dc1ec71bb5b0",
                        "entry_id": "bfc97b75-a1d6-3266-9b8a-c30ce4f506c7",
                        "glosses": [
                            "лингв. действие по значению гл. йотировать; добавление или появление звука j (йот) перед гласным звуком в начале слова или между гласными"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3a6a892-3c78-45a6-9965-11e5a0a6dec9",
                                "sense_id": "835e2ccf-ba95-3bf3-8490-dc1ec71bb5b0",
                                "text": "Из всех славянских языков особенностью только современного русского является усиленное развитие йотирования, приведшее к тому, что подавляющее количество слов с архаическим, свойственным всем другим славянским языкам «э» превратилось в «е», т. е. в й+э."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "266aeed5-f4cf-4921-bf56-658e5202b613",
                        "source_entry_id": "bfc97b75-a1d6-3266-9b8a-c30ce4f506c7",
                        "source_sense_id": "835e2ccf-ba95-3bf3-8490-dc1ec71bb5b0",
                        "target_lang_word": "iotation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iotation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa43a457-12ae-3184-8634-6c7058c4ba61",
                                        "entry_id": "19b665ae-ffdc-32a4-ba89-55f86ccb2fda",
                                        "glosses": [
                                            "A specific occurrence of palatalization that occurred in the Proto-Slavic language, in which a consonant combined with the palatal approximant /j/ to form a palatalized consonant."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3239fdf1-7300-3f9f-948f-4bdd913f4e85",
                                        "entry_id": "19b665ae-ffdc-32a4-ba89-55f86ccb2fda",
                                        "glosses": [
                                            "Any similar process occurring in a later Slavic language or elsewhere."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ac16083-0c1b-466e-bb44-10b81a2926f9",
                                                "sense_id": "3239fdf1-7300-3f9f-948f-4bdd913f4e85",
                                                "text": "A form of iotation in the Serbo-Croatian language: s (/s/) + j (/ʲ/) = sj (/sʲ/), which is then superseded into ś (/ɕ/)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
