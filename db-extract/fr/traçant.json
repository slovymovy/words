                    {
                        "sense_id": "cd39fd2d-480f-3c4a-848f-b0b9081c9dd5",
                        "entry_id": "34f16f25-5998-3068-949f-5c806a5290a8",
                        "glosses": [
                            "Qui trace."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4a18341c-61e9-3696-923e-bacabafaab96",
                        "entry_id": "34f16f25-5998-3068-949f-5c806a5290a8",
                        "glosses": [
                            "Qualifie la ou les racine(s) d’arbre ou de plante qui s’étendent horizontalement, par opposition à pivotant."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3cadd8a8-8e7f-4cf1-bb6f-5c7170389b3d",
                                "sense_id": "4a18341c-61e9-3696-923e-bacabafaab96",
                                "text": "C’est le cas de certains pruniers, cognassiers ou pommiers à fruits de qualité quelconque, mais à bois rigide et enracinement traçant (dont la racine s’étend horizontalement entre deux terres)."
                            },
                            {
                                "example_id": "c561430f-7ad6-45fa-a552-4e6d0bfefb07",
                                "sense_id": "4a18341c-61e9-3696-923e-bacabafaab96",
                                "text": "Pour la majorité des arbres en effet, 50 à 80% de l'appareil racinaire s'installe et s'étale à l'horizontale dans les couches superficielles du sol (on parle de « racines traçantes »), à savoir les tout premiers 30 centimètres seulement."
                            }
                        ]
                    }
                ],
