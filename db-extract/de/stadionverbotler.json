                "senses": [
                    {
                        "sense_id": "135130fd-8a02-3472-a8b9-9cb22d5beb09",
                        "entry_id": "cd44dce5-f1d2-3a0c-b757-b5956705edef",
                        "glosses": [
                            "Person, der das Betreten eines Stadions untersagt worden ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "739f0677-3dd3-4a6b-96ab-7470b6beb69d",
                                "sense_id": "135130fd-8a02-3472-a8b9-9cb22d5beb09",
                                "text": "„Die Stadionverbotler werden berühmt, da genießen 15-jährige Pennäler höchstes Ansehen.“"
                            },
                            {
                                "example_id": "c733fda7-9762-4b18-91ff-58bfdb352414",
                                "sense_id": "135130fd-8a02-3472-a8b9-9cb22d5beb09",
                                "text": "„Stadionverbote werden beim DFB als Allheilmittel angesehen, ähnlich wie die Geldstrafen gegenüber den Vereinen. Aber sie haben keine positive Wirkung. Im Gegenteil: Sie stärken nur die Ultraszene; die Stadionverbotler werden dort wie Helden gefeiert.“"
                            },
                            {
                                "example_id": "c1a1494c-24a0-4de2-b054-9775b2b091c5",
                                "sense_id": "135130fd-8a02-3472-a8b9-9cb22d5beb09",
                                "text": "„Über die Junkersdorfer Straße bewegte sich die etwa 100 Mann starke Gruppe dann \"Eisern Union\" rufend in Richtung Südtribüne - ausgerechnet an den Beachvolleyballplätzen \"Playa\" vorbei, wo Kölner Extrem-Fans und Stadionverbotler die Heimspiele im Fernsehen verfolgen.“"
                            },
                            {
                                "example_id": "51af3c59-6181-4463-ba43-b3ecc7dd6ad1",
                                "sense_id": "135130fd-8a02-3472-a8b9-9cb22d5beb09",
                                "text": "„Michael, 24, ist einer von bundesweit 3.000 Stadionverbotlern.“"
                            },
                            {
                                "example_id": "8a52529b-c959-4515-bd46-22e3ea5057b7",
                                "sense_id": "135130fd-8a02-3472-a8b9-9cb22d5beb09",
                                "text": "„Fanbusse aus Traunstein, Cham oder Günzburg fahren am Hügel der Stadionverbotler vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
