                        "target_lang_word": "bavard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bavard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93ea6209-1921-352b-acd1-b7ffb2a67226",
                                        "entry_id": "ec5c4e7e-a3ca-35f6-9d18-11d3c89e2761",
                                        "glosses": [
                                            "Qui a l’habitude de bavarder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89ad9be-e47f-4d18-9e65-4dace2d78221",
                                                "sense_id": "93ea6209-1921-352b-acd1-b7ffb2a67226",
                                                "text": "Mettons dans la même classe les dialecticiens et les sophistes, gens qui font plus de bruit que tous les chaudrons de Dodone, et dont le moins babillard pourrait tenir tête aux vingt plus bavardes commères qu'on puisse trouver sous le ciel."
                                            },
                                            {
                                                "example_id": "29fc2fa2-92dd-4d34-97ab-bdcdcb8e6453",
                                                "sense_id": "93ea6209-1921-352b-acd1-b7ffb2a67226",
                                                "text": "Tout en procédant à sa toilette, elle parle toute seule, bavarde, gaie, animée, à cause qu’on est encore au printemps de la journée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bavard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11f8c97e-9880-345e-bcb9-841de99a4d5d",
                                        "entry_id": "af52d628-4346-3731-ad46-106ec1d56a4a",
                                        "glosses": [
                                            "Homme qui parle beaucoup"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47b11b1e-b9ff-4d2b-8120-158abc46dca9",
                                                "sense_id": "11f8c97e-9880-345e-bcb9-841de99a4d5d",
                                                "text": "Les autres s'accroupirent en cercle et quelques-uns se postèrent à mi–chemin du village pour que nul bavard indiscret ne vînt aux nouvelles avant de savoir ce qui motivait ce retour nocturne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b7db6dd-7a3c-3a08-80ec-840aa073eb72",
                                        "entry_id": "af52d628-4346-3731-ad46-106ec1d56a4a",
                                        "glosses": [
                                            "Avocat."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6162d4bb-a512-40d2-978b-75d759f7f10f",
                                                "sense_id": "9b7db6dd-7a3c-3a08-80ec-840aa073eb72",
                                                "text": "Je dois aussi m'enfoncer dans la turbine les conseils de mes deux bavards – conseilleurs nabots –, qui ne sont pas du tout chaudards, du tout, pour me laisser balancer les vrais patronymes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "283780ec-79fe-3e1e-902e-06d8c43a37b3",
                                        "entry_id": "af52d628-4346-3731-ad46-106ec1d56a4a",
                                        "glosses": [
                                            "Chabot commun, poisson des rivières et lacs bien oxygénés."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d24e7ec-fcb6-431d-9eb5-6f4444a73046",
                        "source_entry_id": "47b3ca01-1e2f-3013-8b56-71fc0dd07cfe",
                        "source_sense_description": "chatting a lot or fond of chatting",
                        "target_lang_word": "loquace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loquace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94839868-f737-3163-b1fe-add51a50529f",
                                        "entry_id": "d753c15f-3c72-3176-901e-c4c03271ec73",
                                        "glosses": [
                                            "Qui parle beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f712c2-28e4-4875-b95c-7a01289cdd32",
                                                "sense_id": "94839868-f737-3163-b1fe-add51a50529f",
                                                "text": "Et pendant cette opération, le loquace caporal interpellait toujours le voyageur, qui ne pouvait l’entendre."
                                            },
                                            {
                                                "example_id": "a17bc396-08a9-49e5-b297-05e75cb4308d",
                                                "sense_id": "94839868-f737-3163-b1fe-add51a50529f",
                                                "text": "Je me propose de converser à discrétion avec ce brave homme pour peu qu’il soit loquace."
                                            },
                                            {
                                                "example_id": "7967713e-dbbd-4237-ac2a-05b65ebc9268",
                                                "sense_id": "94839868-f737-3163-b1fe-add51a50529f",
                                                "text": "Maintenant qu’est passée la période loquace où la facilité de langage et les attitudes impressionnantes étaient une condition nécessaire pour atteindre à la prééminence politique, le contrôle tombe de plus en plus entièrement dans les mains d’une classe d’avocassiers et d’intrigants, à l’esprit souple et tenace."
                                            },
                                            {
                                                "example_id": "20d0b68a-de85-4ea0-b97a-d52b260b9c9d",
                                                "sense_id": "94839868-f737-3163-b1fe-add51a50529f",
                                                "text": "Alors le vieux devint subitement loquace, comme si la contrainte s’était levée, qui pesait sur ses paroles, les faisait rares et précautionneuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83737378-b7d3-4bc1-840c-5c53c9694b77",
                        "source_entry_id": "47b3ca01-1e2f-3013-8b56-71fc0dd07cfe",
                        "source_sense_description": "chatting a lot or fond of chatting",
                        "target_lang_word": "geschwätzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geschwätzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                        "entry_id": "36c3c009-5a51-3f46-84ad-3457a5233f53",
                                        "glosses": [
                                            "viel und aufdringlich redend"
                                        ],
                                        "tags": [
                                            "häufig abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c056bd2-1665-4ff4-baa8-bb661a00b38e",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Die Leute beim Kongress waren so geschwätzig, dass ich keine Lust hatte, selbst etwas zu sagen."
                                            },
                                            {
                                                "example_id": "e971ef64-633a-429a-b669-a93e23a48260",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Ich kann deine ganzen geschwätzigen Verwandten nicht mehr länger ertragen."
                                            },
                                            {
                                                "example_id": "a6052674-afa1-4a59-bfef-8d8f1e5f2b6e",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Die geschwätzige Amanda unterhielt wieder die ganze Kaffeetafel."
                                            },
                                            {
                                                "example_id": "6ce900b1-6dd1-43dd-919a-eb4c9b0cefce",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Sieh bloß zu, dass du dem geschwätzigen Nachbarn nicht begegnest. Der quatscht dir eine Frikadelle ans Ohr."
                                            },
                                            {
                                                "example_id": "6ab3b6fe-caf3-4ec5-9266-26ae040f46bc",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "„In der selbstlosen und opferfreudigen Liebe eines Tieres ist etwas, das jedem tief zu Herzen gehen muß, der je Gelegenheit hatte, die armselige ›Freundschaft‹ und geschwätzige Treue des ›erhabenen‹ Menschen zu erproben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
