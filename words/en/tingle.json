                                "ru": "Моряку пришлось <w>залатать</w> корпус лодки, чтобы остановить небольшую течь."
                            }
                        },
                        {
                            "text": "If the damage is small, you can <w>tingle</w> it over with a piece of lead.",
                            "target_lang_translations": {
                                "ru": "Если повреждение небольшое, его можно <w>заделать</w> куском свинца."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tingle it over"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in nautical or roofing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "заделывать отверстие небольшим куском металла или материала для обеспечения водонепроницаемости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "латать",
