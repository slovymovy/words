{
    "word_family": [
        "about"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac6396f7-5b59-37d0-9316-88536541fdfe",
                    "sense_definition": "A short period of time during which someone suffers from an illness or experiences an unpleasant condition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "period_of_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She missed a week of school due to a <w>bout</w> of the flu.",
                            "target_lang_translations": {
                                "nl": "Ze miste een week school vanwege een <w>aanval</w> van griep."
                            }
                        },
                        {
                            "text": "The patient suffered from a painful <w>bout</w> of coughing during the night.",
                            "target_lang_translations": {
                                "nl": "De patiënt leed 's nachts aan een pijnlijke <w>aanval</w> van hoesten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bout of illness"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een korte periode waarin iemand lijdt aan een ziekte of een onaangename toestand ervaart."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "aanval",
                                "target_lang_sense_clarification": "gebruikt voor een plotselinge periode van ziekte of symptomen"
                            },
                            {
                                "target_lang_word": "periode",
                                "target_lang_sense_clarification": "algemene term voor een tijdsduur van lijden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "345efe0d-1874-33a1-9dab-b7addf0bcbf0",
                    "sense_definition": "A competitive match in sports such as boxing or fencing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "period_of_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer trained for months before his championship <w>bout</w>.",
                            "target_lang_translations": {
                                "nl": "De bokser trainde maandenlang voor zijn <w>kampioenschapspartij</w>."
                            }
                        },
                        {
                            "text": "The referee stopped the <w>bout</w> because one fighter was injured.",
                            "target_lang_translations": {
                                "nl": "De scheidsrechter stopte de <w>wedstrijd</w> omdat een vechter geblesseerd was."
                            }
                        }
                    ],
                    "synonyms": [
                        "attack"
                    ],
                    "common_phrases": [
                        "boxing bout"
                    ],
                    "target_lang_definitions": {
