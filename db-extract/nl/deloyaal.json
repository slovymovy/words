                    {
                        "sense_id": "c09db57f-0de9-3e6d-aecd-c9fe8ec7d99b",
                        "entry_id": "d5bdd0d1-3e7f-3ce7-9f0d-e0121963008e",
                        "glosses": [
                            "niet trouw zijnd aan iemand of de groep waartoe iemand behoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4282980-82b6-448e-9011-354fb5dbee88",
                                "sense_id": "c09db57f-0de9-3e6d-aecd-c9fe8ec7d99b",
                                "text": "De officiële Poolse tegenkandidaat, Europarlementariër Jacek Saryusz-Wolski, heeft maar kort van zijn status als kandidaat-president mogen genieten. De Europese christendemocraten knikkerden hem wegens deloyaal – hij en Tusk zijn partijgenoten – meteen de partij uit."
                            },
                            {
                                "example_id": "f085d878-09fb-450b-a6a7-ec5e04057c86",
                                "sense_id": "c09db57f-0de9-3e6d-aecd-c9fe8ec7d99b",
                                "text": "Dat er in Duitsland zwaarder wordt getild aan deloyaal gedrag jegens politieke vrienden had hem het voorzitterschap van de Europese Commissie gekost."
                            }
                        ]
                    },
