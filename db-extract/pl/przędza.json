                "translations": [
                    {
                        "translation_id": "6becc85c-af41-4486-b6ee-6313b3305369",
                        "source_entry_id": "0caa35c5-44c6-3a3f-9746-9461ba9b1a44",
                        "source_sense_id": "1c271a54-bc25-35af-a7b6-5f3c8fb57361",
                        "target_lang_word": "yarn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yarn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f26428fd-768a-38bb-8026-cec9b5d84f2e",
                                        "entry_id": "b66ad31a-a1cb-3538-a0fd-c03b360e5892",
                                        "glosses": [
                                            "A twisted strand of fibre used for knitting or weaving."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3601acc8-6716-385d-970b-45e4d4d3c66a",
                                        "entry_id": "b66ad31a-a1cb-3538-a0fd-c03b360e5892",
                                        "glosses": [
                                            "Bundles of fibres twisted together, and which in turn are twisted in bundles to form strands, which in their turn are twisted or plaited to form rope."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0f97298-678c-32fc-b51f-177d1c2f8e1e",
                                        "entry_id": "b66ad31a-a1cb-3538-a0fd-c03b360e5892",
                                        "glosses": [
                                            "A story, a tale, especially one that is incredible."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e890884d-4110-45fc-96bc-945ce3bb3a93",
                                                "sense_id": "b0f97298-678c-32fc-b51f-177d1c2f8e1e",
                                                "text": "Spin a yarn"
                                            },
                                            {
                                                "example_id": "47d85ada-533f-4eba-b4d6-e3187ff9965f",
                                                "sense_id": "b0f97298-678c-32fc-b51f-177d1c2f8e1e",
                                                "text": "I told him about everything I could think of; and what I couldn't think of he did. He asked about six questions during my yarn, but every question had a point to it. At the end he bowed and thanked me once more. As a thanker he was main-truck high; I never see anybody so polite."
                                            },
                                            {
                                                "example_id": "d3dcbc78-adb8-4d29-9a4a-9c1995788131",
                                                "sense_id": "b0f97298-678c-32fc-b51f-177d1c2f8e1e",
                                                "text": "\"I'm hanged if I know how you've got the immortal rind to come at me with a yarn like this.\""
                                            },
                                            {
                                                "example_id": "940b09d9-a1cb-4e3d-bbb4-ac87918406e1",
                                                "sense_id": "b0f97298-678c-32fc-b51f-177d1c2f8e1e",
                                                "text": "Statistically, this person is also likely to be male and well off, but more essentially this person wants to be educated, to be obsessed, wants more than just a good yarn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yarn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3021f79-b13a-3d5f-9aa9-5b966c8b015d",
                                        "entry_id": "e73c6ce4-14a9-3ccf-9649-0e24fe23a7ae",
                                        "glosses": [
                                            "To tell a story or stories, especially one that is lengthy or unlikely to be true."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe45d7c9-4498-4813-999b-02d1c3041f2a",
                                                "sense_id": "a3021f79-b13a-3d5f-9aa9-5b966c8b015d",
                                                "text": "\"He yarns good,\" said Tom Platt. \"T'other night he told us abaout a kid of his own size steerin' a cunnin' little rig an' four ponies up an' down Toledo, Ohio, I think 'twas, an' givin' suppers to a crowd o' sim'lar kids. Cur'us kind o' fairy-tale, but blame interestin'. He knows scores of 'em.\""
                                            },
                                            {
                                                "example_id": "16ee8738-032f-4532-92ca-49a239cc250f",
                                                "sense_id": "a3021f79-b13a-3d5f-9aa9-5b966c8b015d",
                                                "text": "1935, Christopher Isherwood, Mr Norris Changes Trains (U.S. title: The Last of Mr Norris), Chapter Thirteen, in The Berlin Stories, New York: New Directions, 1963, p. 152,\n“Well, well!” exclaimed Mr. van Hoorn. “Here are the boys! As hungry as hunters, I’ll be bound! And we two old fogies have been wasting the whole afternoon yarning away indoors. My goodness, is it as late as that? I say, I want my tea!”"
                                            },
                                            {
                                                "example_id": "e66a5c81-389b-44a4-84b4-88fde1142738",
                                                "sense_id": "a3021f79-b13a-3d5f-9aa9-5b966c8b015d",
                                                "text": "They had stayed in some little pension and had gone for little, bored walks while the colonel went out in the boats with the fisherman, or sat yarning with them in the café."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "446c830f-f4c1-4f14-a619-ce289b7d5298",
                        "source_entry_id": "0caa35c5-44c6-3a3f-9746-9461ba9b1a44",
                        "source_sense_id": "1c271a54-bc25-35af-a7b6-5f3c8fb57361",
                        "target_lang_word": "Garn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Garn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e1067f9-78e5-3ebb-886f-28b4c81817a7",
                                        "entry_id": "0366ef93-f83a-3931-bebc-740f8ed4f175",
                                        "glosses": [
                                            "gesponnener Faden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb34dd03-22f3-48a8-a461-49465076b51e",
                                                "sense_id": "8e1067f9-78e5-3ebb-886f-28b4c81817a7",
                                                "text": "„Frau, sagte er, es ist doch eine Schande, daß das gesponnene Garn da auf dem Klauel liegen bleibt“ in Brüder Grimm: Die faule Spinnerin"
                                            },
                                            {
                                                "example_id": "463f8c94-4e3c-47d5-8e66-8489f684735c",
                                                "sense_id": "8e1067f9-78e5-3ebb-886f-28b4c81817a7",
                                                "text": "Nach dem Färben wird das Garn getrocknet und auf Spulen gewickelt."
                                            },
                                            {
                                                "example_id": "b93916c3-2fb8-472f-8c75-bbad4c5ae6cd",
                                                "sense_id": "8e1067f9-78e5-3ebb-886f-28b4c81817a7",
                                                "text": "„Garne in allen Farben wurden verkauft.“"
                                            },
                                            {
                                                "example_id": "276f7e7d-4a37-4879-a057-48a199027aa9",
                                                "sense_id": "8e1067f9-78e5-3ebb-886f-28b4c81817a7",
                                                "text": "„Die Spinnräder wurden mit einer Tretkurbel angetrieben, und das Garn war nicht gefärbt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "214bbb40-3c15-3e98-a76a-d76f696990b8",
                                        "entry_id": "0366ef93-f83a-3931-bebc-740f8ed4f175",
                                        "glosses": [
                                            "Netz, das zum Fangen von Wild, Vögeln und Fischen dient"
                                        ],
                                        "tags": [
                                            "Jagd",
                                            "Fischerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23acd7f6-44ee-46fc-b026-8a79b06ab5de",
                                                "sense_id": "214bbb40-3c15-3e98-a76a-d76f696990b8",
                                                "text": "Gelbes Garn soll die Vögel angeblich weniger erschrecken als weißes."
                                            },
                                            {
                                                "example_id": "efd135ae-1cb1-4b6e-8969-cda85c6977e0",
                                                "sense_id": "214bbb40-3c15-3e98-a76a-d76f696990b8",
                                                "text": "Klebgarne waren sehr leichte Garne mit kleinen, engen Maschen, sie enthielten aber keinen Klebstoff."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
