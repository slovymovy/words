                    "sense_id": "092d68f4-2e99-3e39-aa85-68f3c16e0430",
                    "sense_definition": "In compliance with applicable time limits or deadlines.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_compliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant <w>timely</w> filed an appeal against the court's decision.",
                            "target_lang_translations": {
                                "ru": "Ответчик <w>своевременно</w> подал апелляцию на решение суда.",
                                "de": "Der Beklagte legte <w>fristgerecht</w> Berufung gegen das Gerichtsurteil ein."
                            }
                        },
                        {
                            "text": "If the documents are not <w>timely</w> submitted, the case may be dismissed.",
                            "target_lang_translations": {
                                "ru": "Если документы не будут <w>своевременно</w> представлены, дело может быть прекращено.",
                                "de": "Wenn die Dokumente nicht <w>fristgerecht</w> eingereicht werden, kann der Fall abgewiesen werden."
                            }
                        }
                    ],
                    "antonyms": [
                        "late"
                    ],
                    "common_phrases": [
                        "timely filed",
                        "timely appeal"
