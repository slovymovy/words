                                        "glosses": [
                                            "Qui appartient ou qui est relatif à la communauté homosexuelle, bisexuelle, transgenre ou intersexe."
                                        ],
                                        "tags": [
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9145ec94-cdf7-41a6-bb15-e5a945e5ef13",
                                                "sense_id": "0154a22a-2939-356b-9b7d-a6872947e767",
                                                "text": "Certains collectifs militants - qui peuvent recouper ceux cités précédemment à propos de l'antiracisme, du féminisme et des luttes LGBTI – se sont, plus récemment, référés aux théories de l’intersectionnalité dont la philosophe Elsa Dorlin est une des représentantes en France."
                                            },
                                            {
                                                "example_id": "549d9d5b-6914-4913-8e44-65a4b3e42b36",
                                                "sense_id": "0154a22a-2939-356b-9b7d-a6872947e767",
                                                "text": "Le terme queer circule toutefois dans les espaces militants LGBTI dès la première moitié des années 1990."
                                            },
                                            {
                                                "example_id": "51369930-1719-4a5b-880a-d2207120b9ba",
                                                "sense_id": "0154a22a-2939-356b-9b7d-a6872947e767",
                                                "text": "Ce chapitre questionne l'enjeu de l’homosexualité au croisement de l'activisme LGBTI transnational."
                                            }
                                        ]
                                    }
                                ]
