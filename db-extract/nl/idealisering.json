                        "glosses": [
                            "te goede en perfecte voorstelling van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f72645-e9eb-4831-9a4c-19f78b1b2fb0",
                                "sense_id": "a5b37b3c-e346-3ed3-85cd-0ed5c49cf4af",
                                "text": "Misschien zette Shakespeare met de jonge held uit Hamlet wel een idealisering van zijn eigen zoon neer, en vermomde hij zichzelf als voyeuristische geest."
                            },
                            {
                                "example_id": "edaa4119-dd56-4113-874d-c1302d75ac32",
                                "sense_id": "a5b37b3c-e346-3ed3-85cd-0ed5c49cf4af",
                                "text": "Ook zei hij dat hij niet houdt van persoonsverheerlijking. „We mogen niet vergeten dat de idealisering van iemand altijd ook een onderhuidse vorm van agressie is. Wanneer ik word geïdealiseerd, voel ik me aangevallen”, aldus de paus."
                            }
                        ]
                    }
