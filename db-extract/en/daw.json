                    {
                        "sense_id": "3d37cfc2-3bca-3c4b-89ee-04ac3f6ffce3",
                        "entry_id": "c8755d62-26c8-368c-83a5-737f5e5d5dde",
                        "glosses": [
                            "To wake (someone) up."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1841178f-2c3c-4300-bfa0-12e33357a2e4",
                                "sense_id": "3d37cfc2-3bca-3c4b-89ee-04ac3f6ffce3",
                                "text": "ANd whanne the Quene herd them saye soo\n she felle to the erthe in a dede swoune\n and thenne syr Bors took her vp\n and dawed her\n & whanne she was awaked she kneled afore the thre knyghtes\n and helde vp bothe their handes and besoughte them to seke hym\nAnd when the queen heard them say so she fell to the earth in a dead swoon. And then Sir Bors took her up, and dawed her; and when she was awaked she kneeled afore the three knights, and held up both their hands, and besought them to seek him"
                            }
                        ]
                    },
