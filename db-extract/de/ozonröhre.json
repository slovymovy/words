                "senses": [
                    {
                        "sense_id": "eed0bf74-4974-3d36-9413-ca9ce0551616",
                        "entry_id": "bdab0ba5-bd95-3308-be9a-0f5596afe564",
                        "glosses": [
                            "dünnes Glasrohr mit innerer Anode und äußerer Kathode zur Ionisation von reinem Sauerstoff zur Ozonerzeugung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21618ab3-b6e0-42dc-95ca-096f719e08e7",
                                "sense_id": "eed0bf74-4974-3d36-9413-ca9ce0551616",
                                "text": "„Die Erzeugung erfolgt mittels Coronaentladung in einer Edelstahl-Ozonröhre mit Borosilikatglaselektroden.“"
                            },
                            {
                                "example_id": "4eb2051b-a86a-46af-82a5-3d751f5a0d81",
                                "sense_id": "eed0bf74-4974-3d36-9413-ca9ce0551616",
                                "text": "„Die Ozonröhre wurde 1857 von Werner von Siemens erfunden und wird daher als “Siemenssche Ozonröhre” bezeichnet.“"
                            },
                            {
                                "example_id": "049d8d05-2655-4bfe-8f01-352f4e3009d4",
                                "sense_id": "eed0bf74-4974-3d36-9413-ca9ce0551616",
                                "text": "„Eine Ozonröhre besteht im wesentlichen aus zwei zylindrischen Glasgefäßen (A und B), die so zusammengeschmolzen sind, dass zwischen Ihnen ein zylindrischer Raum (R) entsteht, durch den das elektrisch zu behandelnde Gas geleitet wird.“"
                            },
                            {
                                "example_id": "d86d7228-6d7b-4452-bf97-4d891ce73ca2",
                                "sense_id": "eed0bf74-4974-3d36-9413-ca9ce0551616",
                                "text": "„Genau 100 Jahre nach der Entwicklung der ersten Ozonröhre – deren Nachfolger trotz erheblicher Änderungen noch heute Siemens Röhren genannt werden -, entwickelte Hänsler den ersten medizinischen Ozongenerator, der aufgrund der exakten Dosierbarkeit des Ozon-Sauerstoff-Gemisches ein breites Anwendungsspektrum der Ozontherapie ermöglichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f8a8384-15ef-3015-be48-407980869690",
                        "entry_id": "bdab0ba5-bd95-3308-be9a-0f5596afe564",
                        "glosses": [
                            "Leuchtstoffröhre, die UV-C abstrahlt und den Sauerstoff in der Umgebung, zur Ozonerzeugung, stark ionisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "349015ec-60b4-4575-afb6-ea992d5c55ad",
                                "sense_id": "3f8a8384-15ef-3015-be48-407980869690",
                                "text": "„Das ist bei den Ozonröhren nicht anders.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
