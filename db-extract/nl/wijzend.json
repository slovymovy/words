                "senses": [
                    {
                        "sense_id": "10e4e8b5-b460-3892-b349-345b574771a3",
                        "entry_id": "a8980281-0433-37a9-968d-64fe0f17c846",
                        "glosses": [
                            "naar iets of iemand gericht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1addcd3d-77da-47a4-ac00-a3e5ff046b11",
                                "sense_id": "10e4e8b5-b460-3892-b349-345b574771a3",
                                "text": "Onderzoeken naar het vermogen van poezen om te communiceren met mensen, staan nog in de kinderschoenen. We weten bijvoorbeeld nog niet zo lang dat katten het menselijke wijzende gebaar kunnen gebruiken om verborgen voedsel te vinden."
                            },
                            {
                                "example_id": "ba1218b4-5e19-4d14-88d1-47544e69c211",
                                "sense_id": "10e4e8b5-b460-3892-b349-345b574771a3",
                                "text": "De onlangs door vandalen vernielde Trollpikken in de Noorse gemeente Eigersund staat weer fier overeind. Een aannemer heeft de loodzware rots - die een beetje lijkt op een penis in opgewonden toestand - weer vastgemaakt aan de berg. De omhoog wijzende steen is al sinds mensenheugenis een populaire bestemming voor wandelaars en klimmers in het zuiden van Noorwegen."
                            }
                        ]
                    }
