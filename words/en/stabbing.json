{
    "word_family": [
        "stab",
        "stabber"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c6ee5e3-53b3-3988-b777-e42129d632a5",
                    "sense_definition": "An incident or crime in which a person is wounded with a pointed weapon, such as a knife.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A fatal <w>stabbing</w> took place in the alley behind the restaurant last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером в переулке за рестораном произошло смертельное <w>нападение с ножом</w>."
                            }
                        },
                        {
                            "text": "The local emergency room frequently treats victims of late-night <w>stabbings</w>.",
                            "target_lang_translations": {
                                "ru": "В местное отделение неотложной помощи часто поступают жертвы ночных <w>поножовщин</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fatal stabbing",
                        "knife stabbing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происшествие или преступление, в ходе которого человеку наносятся ранения колюще-режущим оружием, например, ножом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ножевое ранение",
                                "target_lang_sense_clarification": "рана, нанесенная ножом"
                            },
                            {
                                "target_lang_word": "нападение с ножом",
                                "target_lang_sense_clarification": "атака с применением холодного оружия"
                            },
                            {
                                "target_lang_word": "поножовщина",
                                "target_lang_sense_clarification": "драка или инцидент с применением ножей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5d61d194-5114-314e-90be-9662e9203d37",
                    "sense_definition": "Extremely sharp, piercing, and intense, usually describing a sensation of physical pain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Running too fast in the cold weather gives me a <w>stabbing</w> pain in the chest.",
                            "target_lang_translations": {
                                "ru": "Слишком быстрый бег в холодную погоду вызывает у меня <w>колющую</w> боль в груди."
                            }
                        },
                        {
                            "text": "She woke up suddenly because of a <w>stabbing</w> headache.",
                            "target_lang_translations": {
                                "ru": "Она внезапно проснулась из-за <w>острой</w> головной боли."
                            }
                        }
                    ],
                    "synonyms": [
                        "piercing",
                        "sharp"
                    ],
                    "antonyms": [
                        "dull"
                    ],
                    "common_phrases": [
                        "stabbing pain",
                        "stabbing sensation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно острый, пронзительный и сильный (обычно о боли)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колющий",
                                "target_lang_sense_clarification": "о боли, похожей на укол"
                            },
                            {
                                "target_lang_word": "пронзительный",
                                "target_lang_sense_clarification": "о резком, сильном ощущении"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "о внезапной и сильной боли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b4d0c4c-e314-3af8-b89d-6a6e61240895",
                    "sense_definition": "Present participle of <w>stab</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The attacker fled the scene after repeatedly <w>stabbing</w> his victim.",
                            "target_lang_translations": {
                                "ru": "Нападавший скрылся с места происшествия, неоднократно <w>ударив ножом</w> свою жертву."
                            }
                        },
                        {
                            "text": "She was <w>stabbing</w> holes in the cardboard box with a pair of scissors.",
                            "target_lang_translations": {
                                "ru": "Она <w>проделывала</w> ножницами дырки в картонной коробке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола stab (колоть, наносить удары ножом)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наносящий удары ножом",
                                "target_lang_sense_clarification": "о человеке, ранящем оружием"
                            },
                            {
                                "target_lang_word": "протыкающий",
                                "target_lang_sense_clarification": "прокалывающий что-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}