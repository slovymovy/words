                "senses": [
                    {
                        "sense_id": "b45e9a78-f2c1-3a98-ad1e-9647915eae05",
                        "entry_id": "37f24230-98c1-3f22-951a-68ac96cc9088",
                        "glosses": [
                            "sterke mening of geloof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e920a01-b210-49e7-b3d5-9eed39da474f",
                                "sense_id": "b45e9a78-f2c1-3a98-ad1e-9647915eae05",
                                "text": "Ik ben van overtuiging dat ik gelijk heb."
                            },
                            {
                                "example_id": "8c62612c-b11f-4995-b93e-4b9782c25a07",
                                "sense_id": "b45e9a78-f2c1-3a98-ad1e-9647915eae05",
                                "text": "\"We moeten nadenken over hoe we met die publieke ruimte willen omgaan. Vroeger lag de nadruk op terughoudendheid, gereserveerdheid. Men was wel van een kerk of een levensopvatting, maar er was een soort afspraak om het private en de overtuiging niet al te sterk aanwezig te laten zijn in de publieke ruimte. Zo bleef de publieke ruimte een neutrale, betrekkelijk veilige sfeer.\""
                            },
                            {
                                "example_id": "cbc3fd0b-f2c8-499a-85aa-1d5b8b8828e1",
                                "sense_id": "b45e9a78-f2c1-3a98-ad1e-9647915eae05",
                                "text": "Hij was niet veroordelend, in deze kwestie was hij niet alleen uit eigen overtuiging beginselvast, hij was ook decennialang opgevoed door zowel Ingeborg als haar beste vriendin en bovendien zijn schoonzus Christa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7481c145-f2ab-48eb-9929-1118445172b9",
                        "source_entry_id": "37f24230-98c1-3f22-951a-68ac96cc9088",
                        "source_sense_id": "b45e9a78-f2c1-3a98-ad1e-9647915eae05",
                        "source_sense_description": "sterke mening of geloof",
                        "target_lang_word": "Überzeugung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überzeugung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8d445b-417a-359b-aa1c-71c4f6a0ad90",
                                        "entry_id": "7a67c925-4792-3651-8c42-ae9a6a8819db",
                                        "glosses": [
                                            "gefestigter Glaube, feste Gewissheit, dass etwas richtig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "708c69c4-e5ac-4af4-803f-954f39de71c1",
                                                "sense_id": "ed8d445b-417a-359b-aa1c-71c4f6a0ad90",
                                                "text": "Bist Du wirklich der Überzeugung, dass Atomstrom das Klima retten kann?"
                                            },
                                            {
                                                "example_id": "9309eec5-dc13-4f9d-aeff-3e40b5867b88",
                                                "sense_id": "ed8d445b-417a-359b-aa1c-71c4f6a0ad90",
                                                "text": "„Er kann aus einem großen Fundus an Erfahrung schöpfen, hat Überzeugungen, die nun in die Zeit passen.“"
                                            },
                                            {
                                                "example_id": "659e03f3-3462-499f-ad2c-d257120f45af",
                                                "sense_id": "ed8d445b-417a-359b-aa1c-71c4f6a0ad90",
                                                "text": "„Die Vereinten Nationen sind für die Verhinderung von Völkermord in einzigartiger Weise geeignet und legitimiert, das ist meine feste Überzeugung.“"
                                            },
                                            {
                                                "example_id": "52ea1f4f-33f5-4316-aac2-e74225651baf",
                                                "sense_id": "ed8d445b-417a-359b-aa1c-71c4f6a0ad90",
                                                "text": "„Aber trotz der vorbildlichen Haltung der Musiker und der Überzeugung ihres Chefs fühlt sich Billie von der Last des herrschenden Rassismus erdrückt und will ihren Kollegen keine Probleme machen.“"
                                            },
                                            {
                                                "example_id": "a46d0ae8-44b2-4789-a853-cb1dc20f28b1",
                                                "sense_id": "ed8d445b-417a-359b-aa1c-71c4f6a0ad90",
                                                "text": "„Er hatte die Überzeugung gewonnen, eine Ablehnung jeder Zusammenarbeit mit den Nazis sei Selbstmord.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f450d71b-75df-354d-82ab-5c8309238479",
                                        "entry_id": "7a67c925-4792-3651-8c42-ae9a6a8819db",
                                        "glosses": [
                                            "der Vorgang, bei dem man jemanden die Richtigkeit von etwas glaubhaft macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89dbba5-b14e-4632-89fe-9d750d26b6a8",
                                                "sense_id": "f450d71b-75df-354d-82ab-5c8309238479",
                                                "text": "Die Überzeugung meiner Schwester, dass sie falsch lag, hat einige Zeit gedauert."
                                            },
                                            {
                                                "example_id": "e9fecee8-d58e-4e05-86af-dd00a8258183",
                                                "sense_id": "f450d71b-75df-354d-82ab-5c8309238479",
                                                "text": "„Mas'ûd unterwarf die Turduler mehr durch Überzeugung als durch Gewalt: er lernte ihre Sprache und lehrte sie die Glaubenssätze des Islams.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c852612-aa6b-4129-b2fc-156c70178106",
                        "source_entry_id": "37f24230-98c1-3f22-951a-68ac96cc9088",
                        "source_sense_id": "b45e9a78-f2c1-3a98-ad1e-9647915eae05",
                        "source_sense_description": "sterke mening of geloof",
                        "target_lang_word": "conviction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conviction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecd2eeb1-b850-38bd-82cf-4d967e05981f",
                                        "entry_id": "a3136f9a-60f0-3e6a-b96c-4fa8d26a5b1a",
                                        "glosses": [
                                            "A firmly held belief."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5172000-817e-4512-ae82-fc7aa09c65e8",
                                                "sense_id": "ecd2eeb1-b850-38bd-82cf-4d967e05981f",
                                                "text": "\"...I imagined...that the husband of the lady might very easily be in Russia while his wife's health might necessitate her wintering in Egypt...\" \"But my mother thinks not. My mother thinks there is not a husband at all,—that there never was a husband. In fact my mother has very strong convictions on the subject...\""
                                            },
                                            {
                                                "example_id": "fd49c8b7-0b0d-4101-9aaf-d1a64b2a5885",
                                                "sense_id": "ecd2eeb1-b850-38bd-82cf-4d967e05981f",
                                                "text": "It is of the nature of the intellectual's job that he must use his own knowledge and convictions in performing his daily task."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8be3efc2-660f-3a17-baf9-1fc9933a7c76",
                                        "entry_id": "a3136f9a-60f0-3e6a-b96c-4fa8d26a5b1a",
                                        "glosses": [
                                            "A judgement of guilt in a court of law."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d8ad871-5424-4006-8605-ee48939da7fd",
                                                "sense_id": "8be3efc2-660f-3a17-baf9-1fc9933a7c76",
                                                "text": "He said Robins had not been in trouble with the law before and had no previous convictions. Jail would have an adverse effect on her and her three children as she was the main carer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9593f8fe-85f9-35a3-8a5f-a1458492a219",
                                        "entry_id": "a3136f9a-60f0-3e6a-b96c-4fa8d26a5b1a",
                                        "glosses": [
                                            "The state of being wholly convinced."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc814fc-3503-404d-b7ff-8515f09d98ee",
                                                "sense_id": "9593f8fe-85f9-35a3-8a5f-a1458492a219",
                                                "text": "Analogies are used in aid of Conviction: Metaphors, as means of Illustration."
                                            },
                                            {
                                                "example_id": "58c74bd0-e8e1-409c-a84b-66dea632e786",
                                                "sense_id": "9593f8fe-85f9-35a3-8a5f-a1458492a219",
                                                "text": "The visitors were being pinned back by the end of the first half. Yet Gordon Strachan's side played with great conviction and always had a chance of springing a surprise when their opponents were so susceptible at the back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73a8f8c9-131e-3e42-8d73-0d322c106531",
                                        "entry_id": "a3136f9a-60f0-3e6a-b96c-4fa8d26a5b1a",
                                        "glosses": [
                                            "The state of being found or proved guilty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "324a4dd9-7089-40d1-8102-21e80f30d05d",
                                                "sense_id": "73a8f8c9-131e-3e42-8d73-0d322c106531",
                                                "text": "From G. R. Ratts , Game Warden , fines collected on conviction of violation of State game law ."
                                            },
                                            {
                                                "example_id": "f029a315-7c76-4577-8a7d-fdbf3c85759f",
                                                "sense_id": "73a8f8c9-131e-3e42-8d73-0d322c106531",
                                                "text": "I do not know of any Federal statute which carries with it forfeiture of citizenship or civil rights except this one that we are discussing, which is conviction of desertion committed in time of war and conviction of treason."
                                            },
                                            {
                                                "example_id": "df0525a7-bf0c-4a62-bf03-ff1cb1310757",
                                                "sense_id": "73a8f8c9-131e-3e42-8d73-0d322c106531",
                                                "text": "Thus, the argument continues, federal prosecutors would be motivated to seek Major Crimes Act indictments in marginal cases because they could be relatively certain of getting some conviction."
                                            },
                                            {
                                                "example_id": "30261a4d-c528-4c4e-8d01-abc88681ddf9",
                                                "sense_id": "73a8f8c9-131e-3e42-8d73-0d322c106531",
                                                "text": "Where evidence in prosecution for larceny of two doors of the value of more than $50.00 sustained verdict that defendant had stolen the doors but was insufficient to establish that the doors were worth $50.00 or more, conviction of grand larceny would be reduced, on appeal to conviction of petit larceny."
                                            },
                                            {
                                                "example_id": "91896132-3200-4e90-a6b8-481843d478d5",
                                                "sense_id": "73a8f8c9-131e-3e42-8d73-0d322c106531",
                                                "text": "The rush to convict suspects on weak evidence may well lead not only to conviction of the innocent, but also to the release of the guilty from liability for the crime, as occurred in the famous Alfred Dreyfus case, which I shall discuss later."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db633449-bac7-4cfe-9e1a-7ecaba83127d",
                        "source_entry_id": "37f24230-98c1-3f22-951a-68ac96cc9088",
                        "source_sense_id": "b45e9a78-f2c1-3a98-ad1e-9647915eae05",
                        "source_sense_description": "sterke mening of geloof",
                        "target_lang_word": "conviction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conviction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70b33db4-bfbc-3cd8-bc7d-88e6c3ae7056",
                                        "entry_id": "fa0f659f-a85f-3177-99bb-f62978eeee7a",
                                        "glosses": [
                                            "Effet qu’une preuve évidente produit dans l’esprit, certitude que l’on a de la vérité d’un fait, d’un principe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f46b2ba-7062-464a-97d3-785b3819151a",
                                                "sense_id": "70b33db4-bfbc-3cd8-bc7d-88e6c3ae7056",
                                                "text": "Quelles que soient la bonne foi et la conviction de ceux qui proclament le danger de cet article, et qui veulent le faire rejeter, j'atteste qu'avec la même bonne foi je suis intimement convaincu de ses salutaires effets."
                                            },
                                            {
                                                "example_id": "4a360f22-b3a4-43f8-8e06-6e5a94865ecb",
                                                "sense_id": "70b33db4-bfbc-3cd8-bc7d-88e6c3ae7056",
                                                "text": "Il est certaines situations dont bénéficient seuls les gens tarés. Ils fondent leur fortune là où des hommes mieux posés et plus influents n’auraient point osé risquer la leur. Certes, Roudier, Granoux et les autres, par leur position d’hommes riches et respectés, semblaient devoir être mille fois préférés à Pierre comme chefs actifs du parti conservateur. Mais aucun d’eux n’aurait consenti à faire de son salon un centre politique ; leurs convictions n’allaient pas jusqu’à se compromettre ouvertement ; en somme, ce n’étaient que des braillards, des commères de province, qui voulaient bien cancaner chez un voisin contre la République, du moment où le voisin endossait la responsabilité de leurs cancans."
                                            },
                                            {
                                                "example_id": "f5fb9058-2e18-443f-b752-e2d8813bf033",
                                                "sense_id": "70b33db4-bfbc-3cd8-bc7d-88e6c3ae7056",
                                                "text": "Je ne suis pas arrivé à l'âge de quatre-vingt ans pour rétracter en rien les convictions de ma vie entière."
                                            },
                                            {
                                                "example_id": "58f52fd6-a412-495e-a97a-c064fd52a50b",
                                                "sense_id": "70b33db4-bfbc-3cd8-bc7d-88e6c3ae7056",
                                                "text": "Nous voyons ainsi que la conviction se fonde sur la concurrence de communions, dont chacune se considère comme étant l'armée de la vérité ayant à combattre les armées du mal."
                                            },
                                            {
                                                "example_id": "69d1a20d-b7f5-4176-b259-49161e41e041",
                                                "sense_id": "70b33db4-bfbc-3cd8-bc7d-88e6c3ae7056",
                                                "text": "Mais nous avons vu comment Saint Louis, poussé par ses convictions religieuses, voulut rendre l'usure impraticable."
                                            },
                                            {
                                                "example_id": "0c809c32-2f0e-433c-847f-df57b59db5dd",
                                                "sense_id": "70b33db4-bfbc-3cd8-bc7d-88e6c3ae7056",
                                                "text": "Semblable à beaucoup de ces entrepreneurs dopés à l’hyper-croissance, Cyborg génère par atavisme, mimétisme cupide, conviction idiote ou crainte pleutre, un comportement déviant auprès de ses plus proches cadres."
                                            },
                                            {
                                                "example_id": "66fd32a9-a34e-4f9c-898e-56907585cb12",
                                                "sense_id": "70b33db4-bfbc-3cd8-bc7d-88e6c3ae7056",
                                                "text": "Le traitement des données à caractère personnel qui révèle l'origine raciale ou ethnique, les opinions politiques, les convictions religieuses ou philosophiques ou l'appartenance syndicale, ainsi que le traitement des données génétiques, des données biométriques aux fins d'identifier une personne physique de manière unique, des données concernant la santé ou des données concernant la vie sexuelle ou l'orientation sexuelle d'une personne physique sont interdits. Le paragraphe 1 ne s'applique pas si l'une des conditions suivantes est remplie:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30117333-91ee-32f5-8564-8fbdf9874bf9",
                                        "entry_id": "fa0f659f-a85f-3177-99bb-f62978eeee7a",
                                        "glosses": [
                                            "Preuve évidente d’un fait dont quelqu’un est accusé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4d706a8-67ff-4456-bd60-3c2e66df2bbf",
                                                "sense_id": "30117333-91ee-32f5-8564-8fbdf9874bf9",
                                                "text": "Les magistrats acquirent bientôt la conviction que l’empoisonneur était… une empoisonneuse : la propre mère du petit Henri, Charlotte Lamarche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
