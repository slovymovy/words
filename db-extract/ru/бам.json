                ],
                "senses": [
                    {
                        "sense_id": "704ba038-2547-3627-9d62-5ce7952e2271",
                        "entry_id": "bb5d071f-9d9d-3f0c-876f-fda1d9b08ba5",
                        "glosses": [
                            "фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f6311d6-f4d5-4c69-9e8d-73b2defb00cd",
                                "sense_id": "704ba038-2547-3627-9d62-5ce7952e2271",
                                "text": "[Елизавета Бам] Сейчас, того и гляди, откроется дверь и они войдут… Они обязательно войдут, чтобы поймать меня и стереть с лица земли. Что я наделала? Если бы я только знала… Бежать? Но куда бежать? Эта дверь ведёт на лестницу, а на лестнице я встречу их. В окно? смотрит в окно Ууу, высоко! мне не прыгнуть! Ну что же мне делать?.. Э! чьи-то шаги! Это они. Запру дверь и не открою. Пусть стучат, сколько хотят. // Стук в дверь, потом голос Елизавета Бам, откройте! Елизавета Бам, откройте!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
