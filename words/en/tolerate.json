{
    "word_family": [
        "tolerance",
        "tolerant",
        "tolerable",
        "toleration",
        "intolerant",
        "intolerance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c2dc29ee-e6d3-3863-8afc-5c0b8c8b8c87",
                    "sense_definition": "To allow or permit something to happen or exist, even if one does not like or agree with it.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school administration will not <w>tolerate</w> bullying on campus.",
                            "target_lang_translations": {
                                "ru": "Администрация школы не <w>потерпит</w> издевательств на территории кампуса.",
                                "pl": "Dyrekcja szkoły nie będzie <w>tolerować</w> znęcania się na terenie kampusu."
                            }
                        },
                        {
                            "text": "She refused to <w>tolerate</w> bad behavior from her employees.",
                            "target_lang_translations": {
                                "ru": "Она отказалась <w>терпеть</w> плохое поведение своих сотрудников.",
                                "pl": "Odmówiła <w>tolerowania</w> złego zachowania swoich pracowników."
                            }
                        }
                    ],
                    "synonyms": [
                        "allow",
                        "permit",
                        "put up with",
                        "accept",
                        "brook",
                        "countenance"
                    ],
                    "antonyms": [
                        "prohibit"
                    ],
                    "common_phrases": [
                        "tolerate behavior",
                        "tolerate dissent",
                        "will not tolerate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позволять чему-либо происходить или мириться с чем-либо, даже если это не нравится.",
                        "pl": "Pozwalać na to, aby coś się działo lub istniało, nawet jeśli się tego nie lubi lub nie akceptuje."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терпеть",
                                "target_lang_sense_clarification": "мириться с чем-либо неприятным"
                            },
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "позволять происходить"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "tolerować",
                                "target_lang_sense_clarification": "zgadzać się na czyjeś zachowanie lub poglądy mimo braku aprobaty"
                            },
                            {
                                "target_lang_word": "pobłażać",
                                "target_lang_sense_clarification": "odnosić się z wyrozumiałością do nagannych zachowań"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d618476-55c4-34cd-a01c-9a0ed710f7db",
                    "sense_definition": "To be able to bear, withstand, or endure difficult conditions or unpleasant situations.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "endurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certain plants can <w>tolerate</w> extreme heat and very little water.",
                            "target_lang_translations": {
                                "ru": "Некоторые растения могут <w>переносить</w> сильную жару и недостаток воды.",
                                "pl": "Niektóre rośliny potrafią <w>znosić</w> ekstremalne upały i bardzo małą ilość wody."
                            }
                        },
                        {
                            "text": "I cannot <w>tolerate</w> loud noise when I am trying to sleep.",
                            "target_lang_translations": {
                                "ru": "Я не могу <w>терпеть</w> громкий шум, когда пытаюсь уснуть.",
                                "pl": "Nie potrafię <w>znieść</w> głośnego hałasu, kiedy próbuję zasnąć."
                            }
                        }
                    ],
                    "synonyms": [
                        "bear",
                        "endure",
                        "stand",
                        "stomach",
                        "withstand",
                        "live with"
                    ],
                    "common_phrases": [
                        "tolerate pain",
                        "tolerate heat",
                        "tolerate the cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть способным выдерживать трудные условия, боль или неприятные ситуации.",
                        "pl": "Być w stanie znieść, wytrzymać lub przetrwać trudne warunki lub nieprzyjemne sytuacje."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "выдерживать воздействие (о климате, болезни)"
                            },
                            {
                                "target_lang_word": "выносить",
                                "target_lang_sense_clarification": "справляться с чем-либо трудным"
                            },
                            {
                                "target_lang_word": "терпеть",
                                "target_lang_sense_clarification": "стойко переносить"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "znosić",
                                "target_lang_sense_clarification": "wytrzymywać trudne warunki, ból lub hałas"
                            },
                            {
                                "target_lang_word": "tolerować",
                                "target_lang_sense_clarification": "o organizmie: nie ponosić szkody w wyniku działania określonych bodźców"
                            },
                            {
                                "target_lang_word": "wytrzymywać",
                                "target_lang_sense_clarification": "radzić sobie z trudnymi warunkami fizycznymi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}