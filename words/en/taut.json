{
    "word_family": [
        "tauten",
        "tautly",
        "tautness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ef4f51ac-323f-3df1-8a5f-3485cb5a8a52",
                    "sense_definition": "Stretched or pulled tight; under tension.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tightness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure the rope stays <w>taut</w> while you tie the knot.",
                            "target_lang_translations": {
                                "de": "Achte darauf, dass das Seil <w>straff</w> bleibt, während du den Knoten knüpfst."
                            }
                        },
                        {
                            "text": "The sailor pulled the line until it became <w>taut</w> as a bowstring.",
                            "target_lang_translations": {
                                "de": "Der Seemann zog die Leine an, bis sie <w>gespannt</w> wie eine Bogensehne war."
                            }
                        }
                    ],
                    "synonyms": [
                        "tight",
                        "stretched",
                        "tense"
                    ],
                    "antonyms": [
                        "slack",
                        "loose"
                    ],
                    "common_phrases": [
                        "taut rope",
                        "taut wire",
                        "hold taut"
                    ],
                    "target_lang_definitions": {
                        "de": "Straff gezogen oder unter Spannung stehend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "straff",
                                "target_lang_sense_clarification": "stark gespannt, ohne Durchhang"
                            },
                            {
                                "target_lang_word": "gespannt",
                                "target_lang_sense_clarification": "unter Seil- oder Drahtspannung stehend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ad877b5-d36b-3ab3-95c2-cf0ab6c65b64",
                    "sense_definition": "Having a firm, toned body or smooth, stretched skin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of swimming had given her a <w>taut</w>, athletic body.",
                            "target_lang_translations": {
                                "de": "Jahre des Schwimmens hatten ihr einen <w>straffen</w>, athletischen Körper verliehen."
                            }
                        },
                        {
                            "text": "His face remained <w>taut</w> with concentration throughout the match.",
                            "target_lang_translations": {
                                "de": "Sein Gesicht blieb während des gesamten Spiels vor Konzentration <w>angespannt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tight",
                        "strained"
                    ],
                    "antonyms": [
                        "flaccid",
                        "sagging",
                        "lax"
                    ],
                    "common_phrases": [
                        "taut muscle",
                        "taut skin"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen festen, trainierten Körper oder eine glatte, straffe Haut habend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "straff",
                                "target_lang_sense_clarification": "für Haut oder Muskeln"
                            },
                            {
                                "target_lang_word": "durchtrainiert",
                                "target_lang_sense_clarification": "für den Körper"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5af509ef-b90e-3983-982f-0f69b76b1467",
                    "sense_definition": "Concise, controlled, and free from unnecessary elements.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "literary_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director created a <w>taut</w> thriller that kept everyone on the edge of their seats.",
                            "target_lang_translations": {
                                "de": "Der Regisseur schuf einen <w>packenden</w> Thriller, der alle in Atem hielt."
                            }
                        },
                        {
                            "text": "Her latest novel features a <w>taut</w> storyline with no filler.",
                            "target_lang_translations": {
                                "de": "Ihr neuester Roman bietet eine <w>straffe</w> Handlung ohne überflüssige Längen."
                            }
                        }
                    ],
                    "synonyms": [
                        "concise",
                        "crisp",
                        "terse",
                        "succinct",
                        "brief"
                    ],
                    "common_phrases": [
                        "taut thriller",
                        "taut storyline",
                        "taut plot"
                    ],
                    "target_lang_definitions": {
                        "de": "Prägnant, kontrolliert und ohne überflüssige Elemente."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "straff",
                                "target_lang_sense_clarification": "knapp und dicht aufgebaut, z.B. eine Handlung"
                            },
                            {
                                "target_lang_word": "packend",
                                "target_lang_sense_clarification": "Spannung erzeugend, dramatisch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69448ab6-8b9d-35d9-a456-1836f6d97236",
                    "sense_definition": "Feeling mentally or emotionally strained and anxious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The atmosphere in the meeting room was <w>taut</w> with silent conflict.",
                            "target_lang_translations": {
                                "de": "Die Atmosphäre im Besprechungsraum war von stummem Konflikt <w>angespannt</w>."
                            }
                        },
                        {
                            "text": "His outward appearance was calm, but inside he felt <w>taut</w> and worried.",
                            "target_lang_translations": {
                                "de": "Äußerlich war er ruhig, aber innerlich fühlte er sich <w>angespannt</w> und besorgt."
                            }
                        }
                    ],
                    "synonyms": [
                        "tense",
                        "strained",
                        "unrelaxed"
                    ],
                    "antonyms": [
                        "relaxed"
                    ],
                    "common_phrases": [
                        "taut atmosphere",
                        "taut nerves"
                    ],
                    "target_lang_definitions": {
                        "de": "Geistig oder emotional belastet und ängstlich; unter Stress stehend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "angespannt",
                                "target_lang_sense_clarification": "emotional oder mental belastet"
                            },
                            {
                                "target_lang_word": "geladen",
                                "target_lang_sense_clarification": "voller Konflikt oder Spannung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "398e3334-3e7a-3f61-bc93-42d2bc6fb369",
                    "sense_definition": "Neat, well-disciplined, and efficiently organized.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain ran a <w>taut</w> ship where rules were strictly enforced.",
                            "target_lang_translations": {
                                "de": "Der Kapitän führte ein <w>straff</w> organisiertes Schiff, auf dem die Regeln streng durchgesetzt wurden."
                            }
                        },
                        {
                            "text": "Under new leadership, the company became a <w>taut</w> organization.",
                            "target_lang_translations": {
                                "de": "Unter neuer Führung wurde das Unternehmen zu einer <w>straff</w> geführten Organisation."
                            }
                        }
                    ],
                    "synonyms": [
                        "strict"
                    ],
                    "common_phrases": [
                        "taut ship"
                    ],
                    "target_lang_definitions": {
                        "de": "Ordentlich, gut diszipliniert und effizient organisiert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "straff",
                                "target_lang_sense_clarification": "streng und gut organisiert, z.B. Führung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf91ce2d-3eca-37ec-b26d-cadd30d94481",
                    "sense_definition": "Having a strong, firm, or uncompromising flavor profile.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry white wine was fresh, <w>taut</w>, and perfectly balanced.",
                            "target_lang_translations": {
                                "de": "Der trockene Weißwein war frisch, <w>straff</w> und perfekt ausbalanciert."
                            }
                        },
                        {
                            "text": "Sommeliers described the vintage as <w>taut</w> with high acidity.",
                            "target_lang_translations": {
                                "de": "Sommeliers beschrieben den Jahrgang als <w>straff</w> mit hoher Säure."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einen kräftigen, festen oder kompromisslosen Geschmack aufweisend (z. B. beim Wein)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "straff",
                                "target_lang_sense_clarification": "mit prägnanter Säure oder Struktur bei Wein"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f48aa5f-1060-3f23-9d65-8cb06ab9cfb5",
                    "sense_definition": "To make something tight or tense; to stretch firmly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tightness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A steel counterweight <w>tauts</w> the cable to ensure smooth motion.",
                            "target_lang_translations": {
                                "de": "Ein Gegengewicht aus Stahl <w>strafft</w> das Kabel, um eine reibungslose Bewegung zu gewährleisten."
                            }
                        },
                        {
                            "text": "She <w>tauted</w> the muscles in her arms to lift the heavy weight.",
                            "target_lang_translations": {
                                "de": "Sie <w>spannte</w> die Muskeln in ihren Armen <w>an</w>, um das schwere Gewicht zu heben."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas festziehen oder anspannen; fest dehnen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "straffen",
                                "target_lang_sense_clarification": "etwas festziehen oder anspannen"
                            },
                            {
                                "target_lang_word": "spannen",
                                "target_lang_sense_clarification": "unter Spannung setzen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}