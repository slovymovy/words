                "senses": [
                    {
                        "sense_id": "aaba9c90-2a18-36bc-8e6c-0f30bc2c4d18",
                        "entry_id": "2872ed4f-2de3-394a-8743-a0ef1a26dc9b",
                        "glosses": [
                            "aanvaring met andere persoon of zware problemen tussen groepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8b809b-8899-4180-9570-08c5edfb935f",
                                "sense_id": "aaba9c90-2a18-36bc-8e6c-0f30bc2c4d18",
                                "text": "Als ik niet door mijn schoonmoeder mee op reis was gevraagd, had ik deze confrontatie waarschijnlijk nog dagen voor me uit kunnen schuiven, maar nu ontkom ik er niet aan."
                            },
                            {
                                "example_id": "62584022-3208-480b-98ca-fa730233ca91",
                                "sense_id": "aaba9c90-2a18-36bc-8e6c-0f30bc2c4d18",
                                "text": "Ze wist best dat ze een confrontatie over haar ware ik uit de weg ging door in Spanje te blijven - nu hoefde ze haar vader niet op te biechten dat ze zich had aangemeld voor de kunstacademie."
                            }
                        ]
                    },
                    {
                        "sense_id": "076ee10f-eb0c-393f-9039-c6985bf254be",
                        "entry_id": "2872ed4f-2de3-394a-8743-a0ef1a26dc9b",
                        "glosses": [
                            "blootstelling aan (onaangename) feiten en/of problemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "438d9ddb-c393-4176-ab9d-f12b8c68f38c",
                                "sense_id": "076ee10f-eb0c-393f-9039-c6985bf254be",
                                "text": "Dit was de eerste echte beproeving die dag. De directe confrontatie met water."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0e89882-729f-457f-a0ff-2f5513aee88e",
                        "source_entry_id": "2872ed4f-2de3-394a-8743-a0ef1a26dc9b",
