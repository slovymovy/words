{
    "word_family": [
        "marriage",
        "marriageable",
        "remarry",
        "intermarry"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "073fe2e3-2745-379f-a306-e2d4a78b9a08",
                    "sense_definition": "In a state of marriage; having a wife or a husband.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you <w>married</w> or single?",
                            "target_lang_translations": {
                                "ru": "Вы <w>женаты</w> или холосты?",
                                "pl": "Jesteś <w>żonaty</w> / <w>zamężna</w> czy wolny / wolna?",
                                "zh": "你是<w>已婚</w>还是单身？"
                            }
                        },
                        {
                            "text": "My sister got <w>married</w> to her childhood sweetheart last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году моя сестра <w>вышла замуж</w> за свою школьную любовь.",
                                "pl": "Moja siostra <w>wyszła za mąż</w> za swoją szkolną miłość w zeszłym roku.",
                                "zh": "我姐姐去年和她的青梅竹马<w>结婚</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wedded",
                        "wed"
                    ],
                    "antonyms": [
                        "single",
                        "unmarried"
                    ],
                    "common_phrases": [
                        "get married",
                        "happily married",
                        "married couple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий в браке; имеющий мужа или жену.",
                        "pl": "Będący w związku małżeńskim; mający żonę lub męża.",
                        "zh": "处于婚姻状态；有配偶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "женатый",
                                "target_lang_sense_clarification": "о мужчине"
                            },
                            {
                                "target_lang_word": "замужняя",
                                "target_lang_sense_clarification": "о женщине"
                            },
                            {
                                "target_lang_word": "замужем",
                                "target_lang_sense_clarification": "о женщине (состояние)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "żonaty",
                                "target_lang_sense_clarification": "o mężczyźnie"
                            },
                            {
                                "target_lang_word": "zamężna",
                                "target_lang_sense_clarification": "o kobiecie"
                            },
                            {
                                "target_lang_word": "zamężni",
                                "target_lang_sense_clarification": "o parze lub osobach w związku małżeńskim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "已婚",
                                "target_lang_sense_clarification": "形容词，指处于婚姻状态"
                            },
                            {
                                "target_lang_word": "结婚",
                                "target_lang_sense_clarification": "动词，指处于婚姻关系中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d012f930-56ea-39b4-9bba-d0c41e674b0e",
                    "sense_definition": "Showing commitment or devotion normally reserved for a spouse; strongly committed or attached to something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is completely <w>married</w> to his work and rarely takes a vacation.",
                            "target_lang_translations": {
                                "ru": "Он полностью <w>женат</w> на своей работе и редко берет отпуск.",
                                "pl": "On jest całkowicie <w>poślubiony</w> swojej pracy i rzadko bierze urlop.",
                                "zh": "他<w>全身心投入</w>到工作中，很少休假。"
                            }
                        },
                        {
                            "text": "We are not <w>married</w> to this idea, so feel free to suggest changes.",
                            "target_lang_translations": {
                                "ru": "Мы не <w>привязаны</w> к этой идее, так что смело предлагайте изменения.",
                                "pl": "Nie jesteśmy <w>przywiązani</w> do tego pomysłu, więc śmiało proponuj zmiany.",
                                "zh": "我们并不<w>执着于</w>这个想法，所以请随意提出修改建议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wedded"
                    ],
                    "common_phrases": [
                        "married to the job",
                        "married to an idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Всецело преданный делу или идее; неразрывно связанный с чем-либо.",
                        "pl": "Wykazujący oddanie lub zaangażowanie typowe dla małżonka; silnie przywiązany do czegoś lub oddany czemuś.",
                        "zh": "对某事表现出极大的投入或执着，如同对配偶般忠诚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преданный",
                                "target_lang_sense_clarification": "сильно увлечённый"
                            },
                            {
                                "target_lang_word": "поглощённый",
                                "target_lang_sense_clarification": "полностью занятый чем-то"
                            },
                            {
                                "target_lang_word": "привязанный",
                                "target_lang_sense_clarification": "не желающий менять что-то"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "poślubiony",
                                "target_lang_sense_clarification": "przenośnie, np. pracy"
                            },
                            {
                                "target_lang_word": "oddany",
                                "target_lang_sense_clarification": "całkowicie zaangażowany w coś"
                            },
                            {
                                "target_lang_word": "przywiązany",
                                "target_lang_sense_clarification": "niechętny do zmian, np. do pomysłu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全身心投入",
                                "target_lang_sense_clarification": "形容对工作或事业极度专注"
                            },
                            {
                                "target_lang_word": "执着于",
                                "target_lang_sense_clarification": "形容对某种想法或事物难以割舍"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3dfc531-5c74-3a14-ba1c-a00693435e33",
                    "sense_definition": "Simple past and past participle of <w>marry</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>married</w> in a small ceremony on the beach.",
                            "target_lang_translations": {
                                "ru": "Они <w>поженились</w> на скромной церемонии на пляже.",
                                "pl": "Oni <w>pobrali się</w> podczas skromnej ceremonii na plaży.",
                                "zh": "他们在海滩上举行了一个小型仪式<w>结婚</w>了。"
                            }
                        },
                        {
                            "text": "She <w>married</w> into a very wealthy and influential family.",
                            "target_lang_translations": {
                                "ru": "Она <w>вышла замуж</w> за человека из очень богатой и влиятельной семьи.",
                                "pl": "Ona <w>wyszła za mąż</w> do bardzo bogatej i wpływowej rodziny.",
                                "zh": "她<w>嫁</w>入了一个非常富有且有影响力的家庭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wed"
                    ],
                    "common_phrases": [
                        "just married"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола marry (жениться, выходить замуж).",
                        "pl": "Forma czasu przeszłego i imiesłowu czasu przeszłego od czasownika 'marry' (ożenić się, wyjść za mąż, pobrać się).",
                        "zh": "marry 的过去式和过去分词，指结为夫妻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поженились",
                                "target_lang_sense_clarification": "о паре"
                            },
                            {
                                "target_lang_word": "женился",
                                "target_lang_sense_clarification": "о мужчине"
                            },
                            {
                                "target_lang_word": "вышла замуж",
                                "target_lang_sense_clarification": "о женщине"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pobrali się",
                                "target_lang_sense_clarification": "o parze"
                            },
                            {
                                "target_lang_word": "ożenił się",
                                "target_lang_sense_clarification": "o mężczyźnie"
                            },
                            {
                                "target_lang_word": "wyszła za mąż",
                                "target_lang_sense_clarification": "o kobiecie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结婚",
                                "target_lang_sense_clarification": "指结为夫妻的动作"
                            },
                            {
                                "target_lang_word": "嫁",
                                "target_lang_sense_clarification": "指女性结婚"
                            },
                            {
                                "target_lang_word": "娶",
                                "target_lang_sense_clarification": "指男性结婚"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84202b40-9007-36e4-a702-e2f2c2bc27e2",
                    "sense_definition": "A married person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The resort offers special vacation packages designed specifically for young <w>marrieds</w>.",
                            "target_lang_translations": {
                                "ru": "Курорт предлагает специальные путевки, разработанные специально для молодых <w>супругов</w>.",
                                "pl": "Ośrodek oferuje specjalne pakiety wakacyjne zaprojektowane specjalnie dla młodych <w>małżeństw</w>.",
                                "zh": "该度假村提供专为年轻<w>夫妻</w>设计的特别度假套餐。"
                            }
                        },
                        {
                            "text": "Many <w>marrieds</w> find that buying a home is their first major joint financial decision.",
                            "target_lang_translations": {
                                "ru": "Многие <w>семейные пары</w> считают покупку жилья своим первым крупным совместным финансовым решением.",
                                "pl": "Wielu <w>małżonków</w> uważa, że zakup domu to ich pierwsza poważna wspólna decyzja finansowa.",
                                "zh": "许多<w>夫妻</w>发现，买房是他们第一个重大的共同财务决定。"
                            }
                        }
                    ],
                    "antonyms": [
                        "single"
                    ],
                    "common_phrases": [
                        "young marrieds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, состоящий в браке (обычно во множественном числе).",
                        "pl": "Osoba pozostająca w związku małżeńskim (zwykle w liczbie mnogiej: małżonkowie).",
                        "zh": "已婚人士（通常指夫妻）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "супруги",
                                "target_lang_sense_clarification": "муж и жена"
                            },
                            {
                                "target_lang_word": "семейные пары",
                                "target_lang_sense_clarification": "люди в браке"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "małżonkowie",
                                "target_lang_sense_clarification": "mąż i żona"
                            },
                            {
                                "target_lang_word": "osoby zamężne",
                                "target_lang_sense_clarification": "ludzie w związkach małżeńskich"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "夫妻",
                                "target_lang_sense_clarification": "指已婚的男女双方"
                            },
                            {
                                "target_lang_word": "已婚人士",
                                "target_lang_sense_clarification": "指处于婚姻状态的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}