{
    "word_family": [
        "чесать",
        "расчёска",
        "чесотка",
        "расчёсывать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3f409ccf-d170-3654-a486-7342c85f3e7e",
                    "sense_definition": "царапать или тереть кожу, чтобы унять зуд",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Комар укусил, и теперь рука постоянно <w>чешется</w>.",
                            "target_lang_translations": {
                                "en": "A mosquito bit me, and now my arm is constantly <w>itching</w>."
                            }
                        },
                        {
                            "text": "Не <w>чешись</w>, иначе на коже останутся следы.",
                            "target_lang_translations": {
                                "en": "Don't <w>scratch</w>, otherwise you'll leave marks on your skin."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To scratch or rub the skin to relieve an itch."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to scratch",
                                "target_lang_sense_clarification": "the act of rubbing skin with nails to relieve itching"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a38a799-1409-328f-8b6c-f825f83ccf8b",
                    "sense_definition": "вызывать неприятное ощущение на коже, требующее почесывания",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня от этой шерстяной кофты всё тело <w>чешется</w>.",
                            "target_lang_translations": {
                                "en": "My whole body is <w>itching</w> from this wool sweater."
                            }
                        },
                        {
                            "text": "Если рана <w>чешется</w>, значит она начинает заживать.",
                            "target_lang_translations": {
                                "en": "If a wound <w>itches</w>, it means it is starting to heal."
                            }
                        }
                    ],
                    "synonyms": [
                        "свербеть"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause an unpleasant sensation on the skin that creates a desire to scratch."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to itch",
                                "target_lang_sense_clarification": "to have or cause an itchy sensation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "255de228-9487-3082-b42f-8751233340f4",
                    "sense_definition": "приводить волосы в порядок с помощью расчески",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grooming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она долго стояла перед зеркалом и <w>чесалась</w>.",
                            "target_lang_translations": {
                                "en": "She stood in front of the mirror for a long time <w>combing her hair</w>."
                            }
                        },
                        {
                            "text": "Перед выходом на улицу обязательно <w>почешись</w>.",
                            "target_lang_translations": {
                                "en": "Make sure to <w>comb your hair</w> before going out."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To groom or arrange one's hair using a comb."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to comb one's hair",
                                "target_lang_sense_clarification": "the act of grooming hair with a comb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdda139f-bc4d-30b0-acc1-026e12a1c77d",
                    "sense_definition": "проявлять нерасторопность или бездействие в важном деле",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сроки поджимают, а никто из рабочих даже не <w>чешется</w>.",
                            "target_lang_translations": {
                                "en": "The deadlines are looming, but none of the workers are even <w>lifting a finger</w>."
                            }
                        },
                        {
                            "text": "Пока начальник не прикрикнет, никто не <w>почешется</w> исправлять ошибки.",
                            "target_lang_translations": {
                                "en": "Until the boss yells, no one will <w>bother</w> to fix the mistakes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "никто не чешется"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be sluggish, inactive, or fail to take necessary action in an important matter."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drag one's feet",
                                "target_lang_sense_clarification": "idiomatic expression for delaying action"
                            },
                            {
                                "target_lang_word": "to be slow to act",
                                "target_lang_sense_clarification": "failing to respond or work promptly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}