                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84090252-b8af-4200-ae49-61d1813abddd",
                                                "sense_id": "ecc12050-2642-301b-b677-87dbca91dca4",
                                                "text": "blocking of major opposition sites"
                                            },
                                            {
                                                "example_id": "cc007ef6-0f4e-4ad8-a2ae-956a62a2e916",
                                                "sense_id": "ecc12050-2642-301b-b677-87dbca91dca4",
                                                "text": "Miss H.'s voice was clear and intelligible, although it alternated between vocal blockings and extreme vocal hurry, every clause being jetted out suddenly, and rapidly decaying into aphonia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dd6310a-8010-32cb-88ad-b868456b8b6f",
                                        "entry_id": "45aa5a9f-8a63-356f-af9e-e7f0a86fc8a8",
                                        "glosses": [
                                            "The precise movement and positioning of actors in order to facilitate a performance (originally planned using miniature blocks)."
                                        ],
                                        "tags": [
