                "senses": [
                    {
                        "sense_id": "27c8d7e0-3c95-31ba-8dcc-2bee66cb5ee3",
                        "entry_id": "b95832c7-7643-3536-86c8-fae13fbe8015",
                        "glosses": [
                            "amtliches Dokument, das zum Führen bestimmter Schusswaffen berechtigt"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "cfeb1b48-5135-4912-bef2-502e4f48a1fe",
                                "sense_id": "27c8d7e0-3c95-31ba-8dcc-2bee66cb5ee3",
                                "text": "„Der Waffenschein ist nicht zu verwechseln mit der Waffenbesitzkarte, die zum Besitz, Erwerb und dem nicht zugriffsbereiten Transport einer erlaubnispflichtigen Schusswaffe berechtigt. Der Waffenschein berechtigt nur zum Führen der Waffe, nicht aber zum Besitz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53b5b09f-83d3-4c5d-8ec4-719a3e9ef7cb",
                        "source_entry_id": "b95832c7-7643-3536-86c8-fae13fbe8015",
                        "source_sense_id": "27c8d7e0-3c95-31ba-8dcc-2bee66cb5ee3",
                        "source_sense_description": "Deutschland: amtliches Dokument, das zum Führen bestimmter Schusswaffen berechtigt",
                        "target_lang_word": "wapenvergunning",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wapenvergunning",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c4e2e131-c00e-32c8-8bae-7eb1e2864ccb",
                                        "entry_id": "20813a12-d7c6-38c8-a174-b72eeb19c9d4",
                                        "glosses": [
                                            "formele, wettelijke toestemming om een vuurwapen te bezitten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dde539b-dad8-40a0-b8f8-e6057c7adfdf",
                                                "sense_id": "c4e2e131-c00e-32c8-8bae-7eb1e2864ccb",
                                                "text": "Maar erger nog, ik raak mijn wapenvergunning kwijt?"
                                            },
                                            {
                                                "example_id": "f92446c3-d521-4ce3-a116-056e2212749f",
                                                "sense_id": "c4e2e131-c00e-32c8-8bae-7eb1e2864ccb",
                                                "text": "De proef loopt onder meer in de Friese gemeente Ooststellingwerf. Daar is Guus Hellingman gevraagd om te helpen, omdat hij over de benodigde wapenvergunning beschikt. \"Ik heb nu ongeveer veertig bomen gehad, dus we zijn net iets over de helft\", zegt hij. In totaal worden er aan een weg zeventig bomen behandeld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
