                {
                    "sense_id": "b162a40a-9007-308f-9692-6df414a6c005",
                    "sense_definition": "To be worthy of something or entitled to it, typically because of one's actions or qualities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After playing so well, the team really <w>deserved</w> their win.",
                            "target_lang_translations": {
                                "ru": "После такой хорошей игры команда действительно <w>заслужила</w> свою победу.",
                                "pl": "Po tak dobrej grze drużyna naprawdę <w>zasłużyła</w> na zwycięstwo."
                            }
                        },
                        {
                            "text": "She worked hard all year and <w>deserves</w> a holiday.",
                            "target_lang_translations": {
                                "ru": "Она усердно работала весь год и <w>заслуживает</w> отпуска.",
                                "pl": "Pracowała ciężko przez cały rok i <w>zasługuje</w> na urlop."
                            }
                        },
                        {
                            "text": "Everyone <w>deserves</w> a chance to prove themselves.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>заслуживает</w> шанса проявить себя.",
                                "pl": "Każdy <w>zasługuje</w> na szansę, aby się wykazać."
                            }
                        }
                    ],
                    "synonyms": [
                        "merit",
                        "earn",
                        "be worthy of",
                        "warrant",
                        "have a right to"
                    ],
                    "common_phrases": [
                        "deserve better",
                        "deserve credit",
                        "deserve a chance",
                        "deserve it",
                        "richly deserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть достойным чего-либо или иметь право на что-либо, как правило, благодаря своим поступкам или качествам.",
                        "pl": "Być godnym czegoś lub mieć do czegoś prawo, zazwyczaj ze względu na swoje działania lub cechy."
                    },
