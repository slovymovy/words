                                ]
                            },
                            {
                                "target_word": "fouille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f712d57-2930-3e19-a338-0e31fd4a9cf6",
                                        "entry_id": "ccb1004f-2754-393f-a88f-3e37a2c5f989",
                                        "glosses": [
                                            "Ouverture que l’on pratique dans la terre pour mettre à découvert ce qui y est enfermé ou pour faire les fondations d’une maison, pour creuser une mine, un canal, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c9e30e7-602b-4a68-8df3-6fba5288ee0f",
                                                "sense_id": "5f712d57-2930-3e19-a338-0e31fd4a9cf6",
                                                "text": "Faire une fouille, des fouilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f04bbac-594e-3214-967e-71b2ff65d9b8",
                                        "entry_id": "ccb1004f-2754-393f-a88f-3e37a2c5f989",
                                        "glosses": [
                                            "Recherche méthodique dans le sol de traces archéologiques."
                                        ],
                                        "tags": [
                                            "especially",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e2a1ec-27eb-430f-8a0e-2b8fc3598729",
                                                "sense_id": "1f04bbac-594e-3214-967e-71b2ff65d9b8",
                                                "text": "Avant les découvertes des plates-tombes de l’abbaye Notre-Dame-du-Vœu, des fouilles de céramiques tombales importantes ont eu lieu au prieuré Saint-Martin de Deux-Jumeaux […]."
                                            },
                                            {
                                                "example_id": "0458b473-6608-40a0-bb65-0220f129e206",
                                                "sense_id": "1f04bbac-594e-3214-967e-71b2ff65d9b8",
                                                "text": "Paléolithicienne de formation, elle avait suivi jusqu’au DEA l’enseignement de Préhistoire de l’université de Paris I. C’est dans ce cadre qu’elle participa activement aux fouilles magdaléniennes d’Etiolles […]."
                                            },
                                            {
                                                "example_id": "d184c353-e528-45b5-87cc-1a7c12a343e3",
                                                "sense_id": "1f04bbac-594e-3214-967e-71b2ff65d9b8",
                                                "text": "Si certaines industries du Maroc sont technologiquement proches de l’Oldowayen, en l’absence de fouille de sols d’habitat, on ne peut rien dire sur le plan palethnologique du mode de vie de leurs auteurs."
                                            },
                                            {
                                                "example_id": "a9918a5d-fca4-417e-867b-e292a2666df6",
                                                "sense_id": "1f04bbac-594e-3214-967e-71b2ff65d9b8",
                                                "text": "Les fouilles de la grotte qu'on a fait exploser ont soudain fait de nous des héros."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d17f2982-7c94-37bc-b3e1-98498553eeaa",
                                        "entry_id": "ccb1004f-2754-393f-a88f-3e37a2c5f989",
                                        "glosses": [
                                            "Opération consistant à sonder les vêtements ou les possessions d’un suspect dans le cadre d’une action policière ou de sécurité en vue de recherche des substances ou articles prohibées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "451a340d-07f4-4210-a3e2-ee6ad4ce3a63",
                                                "sense_id": "d17f2982-7c94-37bc-b3e1-98498553eeaa",
                                                "text": "Une fouille à corps."
                                            },
                                            {
                                                "example_id": "fddb6844-0ad3-4d8b-aba6-856ac5915420",
                                                "sense_id": "d17f2982-7c94-37bc-b3e1-98498553eeaa",
                                                "text": "La fouille systématique des bagages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "407c1cb1-9057-3100-98ea-f4a98f0637f1",
                                        "entry_id": "ccb1004f-2754-393f-a88f-3e37a2c5f989",
                                        "glosses": [
                                            "Poche d’un vêtement."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae1768e9-2e47-4477-b350-cc84b12424da",
                                                "sense_id": "407c1cb1-9057-3100-98ea-f4a98f0637f1",
                                                "text": "[…], quand une nuit v’là l’Dudule qui rapplique, les fouilles pleines de fafiots et d’perlouses, qui pose tout ça d’ssus l’plume et qui m’regarde."
                                            },
                                            {
                                                "example_id": "963b85b2-696e-4ed1-85e5-1062e9659deb",
                                                "sense_id": "407c1cb1-9057-3100-98ea-f4a98f0637f1",
                                                "text": "Comme j'étais maintenant sans un maravédis en fouille, j'avais calculé voir si c'était rentable de m'engager dans cette armée clandestine de passeurs de picton..."
                                            },
                                            {
                                                "example_id": "40e82c8b-f577-42f3-8781-271af10716c6",
                                                "sense_id": "407c1cb1-9057-3100-98ea-f4a98f0637f1",
                                                "text": "Il a remis son porte-lazagne dans sa fouille."
                                            },
                                            {
                                                "example_id": "54b840e0-e524-4408-9e53-464902d6304b",
                                                "sense_id": "407c1cb1-9057-3100-98ea-f4a98f0637f1",
                                                "text": "N'importe comment, on dirait qu'il ne sait pas s'y prendre. C'est pas pareil qu'au cinéma. Elle s'approche de lui parce qu'il doit avoir de l'argent plein les fouilles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76a68f7a-6e13-49f2-a08e-cbef2aff51c1",
                        "source_entry_id": "48a0dfac-e49c-3fd0-8186-777ed4633871",
                        "source_sense_id": "ab0cf6e8-5c7f-33f7-85e6-8ad66abb2a09",
                        "target_lang_word": "excavation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excavation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be0cd3d0-e523-395a-ade1-040c6330c681",
                                        "entry_id": "3e89cfe5-506f-321b-a7df-050e53f80cd8",
                                        "glosses": [
                                            "Action de creuser un terrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a396105-b75b-4ad1-b012-89beae91b175",
                                                "sense_id": "be0cd3d0-e523-395a-ade1-040c6330c681",
                                                "text": "L’excavation des fondements de cet édifice a coûté beaucoup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de21a1bf-f472-3bdb-b9be-79855fbf29d0",
                                        "entry_id": "3e89cfe5-506f-321b-a7df-050e53f80cd8",
                                        "glosses": [
                                            "Creux fait dans un terrain, soit de main d’homme ou par un instrument, soit par un accident naturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7daf33d5-4151-4daf-8953-a82e8fe5f538",
                                                "sense_id": "de21a1bf-f472-3bdb-b9be-79855fbf29d0",
                                                "text": "Puis il tendit la main au sergent qui, sûr de ce point d'appui, parvint à sortir de l'excavation."
                                            },
                                            {
                                                "example_id": "067c72dc-4606-4263-b586-9ee0072662c6",
                                                "sense_id": "de21a1bf-f472-3bdb-b9be-79855fbf29d0",
                                                "text": "[…], quelques minutes plus tard les deux bandits revinrent annoncer qu’ils avaient découvert une excavation qui provisoirement pouvait leur offrir un abri."
                                            },
                                            {
                                                "example_id": "9d4c5ee9-e6fa-40cb-a4cc-bf51a57415db",
                                                "sense_id": "de21a1bf-f472-3bdb-b9be-79855fbf29d0",
                                                "text": "La minière de Rauboudin, près Sommerance, est très-bien installée ; les terres chargées dans des wagons qui roulent sur un petit chemin de fer, servent à remblayer l’excavation au fur et à mesure de l'avancement ; […]."
                                            },
                                            {
                                                "example_id": "bb08f45e-60dc-44c7-919b-5b929756752e",
                                                "sense_id": "de21a1bf-f472-3bdb-b9be-79855fbf29d0",
                                                "text": "Dans l'excavation, […], on descendit les misérables bières de sapin, on les rangea l'une près de l'autre puis, […], les fossoyeurs saisirent leurs pelles et comblèrent la tranchée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
