                "senses": [
                    {
                        "sense_id": "21e91358-70fe-366d-b2db-615cd47bc067",
                        "entry_id": "a7bce370-69d0-3802-8db2-23c96df3f923",
                        "glosses": [
                            "To stand against; resist, oppose; withstand."
                        ],
                        "tags": [
                            "UK",
                            "dialectal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9236c286-dbd7-4d0f-b23f-607eb30d96de",
                                "sense_id": "21e91358-70fe-366d-b2db-615cd47bc067",
                                "text": "He perceived three French Gentlemen, who alone, with an incredible and undaunted boldnesse, gainstood the enraged violence, and made head against the furie of his victorious armie."
                            },
                            {
                                "example_id": "b1afccde-6c52-48a2-9871-c4d8d48f304f",
                                "sense_id": "21e91358-70fe-366d-b2db-615cd47bc067",
                                "text": "And you, now last in accusing us of these most odious crimes, whereof we be most innocent, ye and your brethern, I say, in teaching this your pestilent doctrine, and accusing us who gainstand your devilish errors, do plainely declare what ye have already intended, if God by his great power bridle not your furie."
                            },
                            {
                                "example_id": "0482f053-7088-4e90-a222-22543ed320fc",
                                "sense_id": "21e91358-70fe-366d-b2db-615cd47bc067",
                                "text": "It was the New Castle built upon Tyne to gainstand the Scots, who then and for some centuries afterwards sadly troubled these rough borderers, and in turn were sadly troubled by them."
                            },
                            {
                                "example_id": "1bc97c58-d260-4636-a82b-6bf24682b117",
                                "sense_id": "21e91358-70fe-366d-b2db-615cd47bc067",
                                "text": "And therefore I conclude that they who gainstood his commandment resisted not the ordinance of God."
                            }
                        ]
                    },
                    {
                        "sense_id": "f50a4e68-2334-3ff2-91ee-fe5df20a35fc",
                        "entry_id": "a7bce370-69d0-3802-8db2-23c96df3f923",
