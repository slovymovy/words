                                "target_senses": [
                                    {
                                        "sense_id": "e4364fc9-f1c1-30f9-befd-d8cf69815af9",
                                        "entry_id": "f74f5436-cf60-3797-9034-84c7a7dfd1c0",
                                        "glosses": [
                                            "The selection of one thing or person over others (with the main adposition being \\\"for\\\" in relation to the thing or person, but possibly also \\\"of\\\")"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9b84662-6927-4a20-bc2b-0745a19b8a43",
                                                "sense_id": "e4364fc9-f1c1-30f9-befd-d8cf69815af9",
                                                "text": "He has a preference for crisp wines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2167c4bd-4a3a-3942-b1e9-58eca3bbcd2e",
                                        "entry_id": "f74f5436-cf60-3797-9034-84c7a7dfd1c0",
                                        "glosses": [
                                            "The option to so select, and the one selected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "739ae9a2-1c15-4ccf-9a63-6e738ab60a79",
                                                "sense_id": "2167c4bd-4a3a-3942-b1e9-58eca3bbcd2e",
                                                "text": "Can I keep my preferences when I upgrade to the new version of this application?"
                                            },
                                            {
                                                "example_id": "5f974fad-aaac-40d9-8df6-6ba48c289743",
                                                "sense_id": "2167c4bd-4a3a-3942-b1e9-58eca3bbcd2e",
                                                "text": "Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet. Perhaps we assume that our name, address and search preferences will be viewed by some unseen pair of corporate eyes, probably not human, and don't mind that much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c91ca8cd-c6d9-33fd-9bfa-8c3d885d5f46",
                                        "entry_id": "f74f5436-cf60-3797-9034-84c7a7dfd1c0",
                                        "glosses": [
                                            "The state of being preferred over others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e50dd694-ede9-3c27-84ef-3dc57d4fe4c5",
                                        "entry_id": "f74f5436-cf60-3797-9034-84c7a7dfd1c0",
                                        "glosses": [
                                            "A strong liking or personal valuation."
                                        ],
                                        "tags": [
