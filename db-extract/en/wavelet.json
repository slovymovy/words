    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "235463fd-ed1b-3f42-8577-75cf4c46002b",
                "word": "wavelet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f91ef592-087d-4e6e-81b2-7809f4d51fb8",
                        "entry_id": "235463fd-ed1b-3f42-8577-75cf4c46002b",
                        "tags": [
                            "plural"
                        ],
                        "form": "wavelets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d22c874-0625-362a-b414-a0d015716241",
                        "entry_id": "235463fd-ed1b-3f42-8577-75cf4c46002b",
                        "glosses": [
                            "A small wave; a ripple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "621df912-cfbb-4b2a-b40f-cf23dc6b521a",
                                "sense_id": "7d22c874-0625-362a-b414-a0d015716241",
                                "text": "1851, “Speaker’s Meaning dimly descried” (Fragment) in Poems, London: William Pickering, p. 110,\nI know not whether\nI see your meaning: if I do, it lies\nUpon the wordy wavelets of your voice,\nDim as an evening shadow in a brook,\nWhen the least moon has silver on’t no larger\nThan the pure white of Hebe’s nail."
                            },
                            {
                                "example_id": "b83c8199-c045-482f-8cb7-b449bfe16439",
                                "sense_id": "7d22c874-0625-362a-b414-a0d015716241",
                                "text": "1856, Herman Melville, “The Piazza” in The Piazza Tales, New York: Dix & Edwards, pp. 6-7,\n[…] long ground-swells roll the slanting grain, and little wavelets of grass ripple over upon the low piazza, as their beach, and the blown down of dandelions is wafted like the spray […]"
                            },
                            {
                                "example_id": "017f0791-94f7-48f7-aec3-db4a486c8ba3",
                                "sense_id": "7d22c874-0625-362a-b414-a0d015716241",
                                "text": "The water danced and sparkled, multitudes of birds were on the wing, now dipping in the wavelets, now rising and shaking off the glittering drops."
                            },
                            {
                                "example_id": "194aa93e-ab1e-4c8c-97fe-8b68bfcb74fc",
                                "sense_id": "7d22c874-0625-362a-b414-a0d015716241",
                                "text": "They sat on the beach and watched the hissing wavelets."
                            },
                            {
                                "example_id": "9e5e446f-9d4d-4691-8cbe-d70f225f038d",
                                "sense_id": "7d22c874-0625-362a-b414-a0d015716241",
                                "text": "A little, rubbishy wavelet, full of candy wrappers and orange peel and seaweed, folded over my foot."
                            },
                            {
                                "example_id": "060b8fa3-45fa-4e48-b182-24860368b6a9",
                                "sense_id": "7d22c874-0625-362a-b414-a0d015716241",
                                "text": "They left the shop in a united wavelet of amusement […]"
                            },
                            {
                                "example_id": "3065fa9c-aa3b-47cc-8a29-85a433b99e8e",
                                "sense_id": "7d22c874-0625-362a-b414-a0d015716241",
                                "text": "Attractive cottages look out on a scene so peaceful that lapping wavelets, stirred by the breeze, are often the loudest sound to be heard."
                            }
                        ]
                    },
                    {
                        "sense_id": "a63f2457-16cb-3bba-85ba-b7d8e386a43a",
                        "entry_id": "235463fd-ed1b-3f42-8577-75cf4c46002b",
                        "glosses": [
                            "A fast-decaying oscillation."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fad3a7cb-f767-4256-aaf0-3fa0bdfa8dd0",
                        "source_entry_id": "235463fd-ed1b-3f42-8577-75cf4c46002b",
                        "source_sense_description": "a small wave; a ripple",
                        "target_lang_word": "vaguelette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaguelette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9e690cc-915c-33d8-95ca-5518f4c77f2b",
                                        "entry_id": "cc857961-bc6f-32ae-aca5-efc70b251965",
                                        "glosses": [
                                            "Petite vague."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "170b6391-4bf5-4a42-a4e0-fa2fa9bb2178",
                                                "sense_id": "b9e690cc-915c-33d8-95ca-5518f4c77f2b",
                                                "text": "Une après-midi grise et calme tombait sur les Syrtes du ciel laiteux, à peine troublée par le bruit assoupi des vaguelettes."
                                            },
                                            {
                                                "example_id": "6366671a-43d6-493b-a96f-f8ff2fcd27d2",
                                                "sense_id": "b9e690cc-915c-33d8-95ca-5518f4c77f2b",
                                                "text": "Je marchais à la limite des vaguelettes, là où les pieds s'enfoncent peu dans le sable lisse et frais. Le léger ressac effaçait aussitôt l'empreinte de mes pas."
                                            },
                                            {
                                                "example_id": "999e37b8-f293-4f61-89c3-a6336a0307f3",
                                                "sense_id": "b9e690cc-915c-33d8-95ca-5518f4c77f2b",
                                                "text": "Florian Phiippot, sèchement battu, quant à lui, dans la 6ᵉ circonscription de la Moselle, a troué cette explication pour justifier sa défaite : « On (!) a été emportés par la vague Macron, qui est plutôt une vaguelette, vu le taux d’absentéistes. » Une « vaguelette » qui a pourtant suffi à le noyer…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fd240f5-462c-47b2-950a-839a4ccee0c8",
                        "source_entry_id": "235463fd-ed1b-3f42-8577-75cf4c46002b",
                        "source_sense_description": "a small wave; a ripple",
                        "target_lang_word": "Wellchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6489d753-bfa0-4d84-b17b-75174e9595ec",
                        "source_entry_id": "235463fd-ed1b-3f42-8577-75cf4c46002b",
                        "source_sense_description": "a small wave; a ripple",
                        "target_lang_word": "зыбь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зыбь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "473bcf66-087c-3b77-a602-350b1c06f29d",
                                        "entry_id": "eef50805-0e43-3457-bb12-7126522da613",
                                        "glosses": [
                                            "волнение на водной поверхности в отсутствие ветра; лёгкое колебание нетвёрдой поверхности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4811d902-3ba6-481b-afa9-c550727ab6f4",
                                                "sense_id": "473bcf66-087c-3b77-a602-350b1c06f29d",
                                                "text": "Изредка под нависшим кустом всплывала большая рыба, пускала пузыри и тихо погружалась на дно, оставив за собою лёгкую зыбь."
                                            },
                                            {
                                                "example_id": "07434b2b-1bf6-4ebc-9cc0-68b12ee05dfa",
                                                "sense_id": "473bcf66-087c-3b77-a602-350b1c06f29d",
                                                "text": "Всё это делается не так, как бы делалось стоя на якоре. Невозможно: после бури идет сильная зыбь, качка, хотя и не прежняя, всё продолжается."
                                            },
                                            {
                                                "example_id": "f3210d9f-6624-4d8f-ba26-483259f660e2",
                                                "sense_id": "473bcf66-087c-3b77-a602-350b1c06f29d",
                                                "text": "Я вышел на палубу. Что за картина! Вместо уродливых бугров с пеной и брызгами — крупная, но ровная зыбь."
                                            },
                                            {
                                                "example_id": "df82ed9a-d54a-4fcd-8b8b-e94c3d58ab4a",
                                                "sense_id": "473bcf66-087c-3b77-a602-350b1c06f29d",
                                                "text": "Осенний день в лиловой крупной зыби // Блистал, как медь. Эол и Посейдон // Вели в снастях певучий долгий стон, // И наш корабль нырял подобно рыбе."
                                            },
                                            {
                                                "example_id": "b2d447dc-0723-4709-9dae-24a6254bd8d7",
                                                "sense_id": "473bcf66-087c-3b77-a602-350b1c06f29d",
                                                "text": "Мы стояли с Лавровой у окна, смотрели на снег, и метроном раскачивал тишину, как ровная зыбь бьёт парусник в море, и от этого еще сильнее хотелось спать."
                                            },
                                            {
                                                "example_id": "1ee8d458-e7ab-4653-81b1-513e9d63576e",
                                                "sense_id": "473bcf66-087c-3b77-a602-350b1c06f29d",
                                                "text": "Зыбь по́ля"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c81a80-dcbd-3b1e-b332-b8c084b47195",
                                        "entry_id": "eef50805-0e43-3457-bb12-7126522da613",
                                        "glosses": [
                                            "поэт. то же, что волны"
                                        ],
                                        "tags": [
                                            "преимущественно морские"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb6b8cf6-059c-4600-af34-707287ebf46b",
                                                "sense_id": "44c81a80-dcbd-3b1e-b332-b8c084b47195",
                                                "text": "Сильное стремление валов отнимало у кормила направление, и порывистый ветр, то вознося нас на мокрые хребты, то низвергая в утёсистые рытвины водяных зыбей, отнимал у гребущих силу шественного движения."
                                            },
                                            {
                                                "example_id": "b03e86b5-8da0-4bc3-95a9-62530144a1a7",
                                                "sense_id": "44c81a80-dcbd-3b1e-b332-b8c084b47195",
                                                "text": "Смиренный парус рыбарей… скользит отважно средь зыбей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2233d246-ccc0-384a-ba08-19e5cf550f23",
                                        "entry_id": "eef50805-0e43-3457-bb12-7126522da613",
                                        "glosses": [
                                            "неустойчивая, дрожащая, поддающаяся перемещению поверхность чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1bfa470-721f-415b-989f-28c28bc0b95a",
                                                "sense_id": "2233d246-ccc0-384a-ba08-19e5cf550f23",
                                                "text": "Осеннее поле ржи подёрнулось мелкой зыбью от лёгкого ветерка."
                                            },
                                            {
                                                "example_id": "bc9c6c19-8c0b-4edd-9a89-53301349a5b0",
                                                "sense_id": "2233d246-ccc0-384a-ba08-19e5cf550f23",
                                                "text": "Зыбь песка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "718d5570-2f14-40fe-9b3a-ace9f3550bad",
