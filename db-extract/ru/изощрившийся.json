                "senses": [
                    {
                        "sense_id": "1a05a46a-c2d9-302c-adde-92e3a50a56fa",
                        "entry_id": "c8cb5d9e-c1aa-3bf5-975b-b1e92e3cb4fe",
                        "glosses": [
                            "прич. от изощриться; дошедший до тонкости, до виртуозности в чём-нибудь, делающий что-либо мастерски"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7074ca23-994f-36fc-9970-741a37441528",
                        "entry_id": "c8cb5d9e-c1aa-3bf5-975b-b1e92e3cb4fe",
                        "glosses": [
                            "ставший более восприимчивым, острым (о слухе, внимании)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a53c2b93-685f-4bbf-8339-39201b13ef96",
                                "sense_id": "7074ca23-994f-36fc-9970-741a37441528",
                                "text": "Но духовный взор, достаточно изощрившийся на страдальческом опыте революции и потому обозревающий достаточно широкий горизонт, не останавливается на этом."
                            }
                        ]
                    }
