                ],
                "senses": [
                    {
                        "sense_id": "e0d1a421-94d8-34b3-9dc6-2e5bc17a17ca",
                        "entry_id": "6e459cfd-aba0-3bf0-a10f-32609c6a99e0",
                        "glosses": [
                            "der östliche Teil des Staatsgebiets der Schweiz, der von den Kantonen Glarus, Schaffhausen, Appenzell Ausserrhoden, Appenzell Innerrhoden, St. Gallen, Graubünden und Thurgau gebildet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cf99f3d-b266-492f-a00e-f65411274c4e",
                                "sense_id": "e0d1a421-94d8-34b3-9dc6-2e5bc17a17ca",
                                "text": "„Die Luft in der Ostschweiz ist in den letzten zehn Jahren sauberer geworden.“"
                            },
                            {
                                "example_id": "88c9b9a2-75ed-4254-956c-70028031c336",
                                "sense_id": "e0d1a421-94d8-34b3-9dc6-2e5bc17a17ca",
                                "text": "„Die Polizeikorps der Ostschweiz haben am Mittwoch 441 Last- und Lieferwagen kontrolliert und dabei 68 Widerhandlungen gegen Strassenverkehrsvorschriften festgestellt.“"
                            },
                            {
                                "example_id": "bfdd8ed4-c4ed-45b5-b48f-579636d53944",
                                "sense_id": "e0d1a421-94d8-34b3-9dc6-2e5bc17a17ca",
                                "text": "„Am Montag hat eine Delegation aus der Ostschweiz bei der Bundeskanzlei in Bern eine Petition mit 12 000 Unterschriften hinterlegt.“"
                            },
                            {
                                "example_id": "d36b137b-aac4-4f14-9598-4acc73dc7656",
                                "sense_id": "e0d1a421-94d8-34b3-9dc6-2e5bc17a17ca",
                                "text": "„Während die Ostschweiz viel Sonne erhielt, war es auf der Alpensüdseite ausgesprochen trüb.“"
                            },
                            {
                                "example_id": "e7c4c37d-a392-4858-9f5d-c974830bb3be",
                                "sense_id": "e0d1a421-94d8-34b3-9dc6-2e5bc17a17ca",
                                "text": "„Die 120 auf 120 Meter und damit 14'400 Quadratmeter grosse Fahne ist so gross wie zwei Fussballfelder und bei schönem Wetter nicht nur von der Schwägalp, sondern von der halben Ostschweiz aus zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
