                        "examples": [
                            {
                                "example_id": "66290220-cd59-4ec2-8364-1d9897d9f70e",
                                "sense_id": "b70c866b-3df5-3917-b931-ce4fe6befdfe",
                                "text": "Beobachter, die es gut mit Boer meinen, sagen, sie bekomme damit endlich die Prokura, den Laden vollends auf den Kopf zu stellen.",
                                "translation": "Observers meaning well with Boer opine that thereby she finally obtains the agency to completely overhaul the business.",
                                "english": "Observers meaning well with Boer opine that thereby she finally obtains the agency to completely overhaul the business."
                            },
                            {
                                "example_id": "5dc33233-f231-4a46-abec-2c167a65052c",
                                "sense_id": "b70c866b-3df5-3917-b931-ce4fe6befdfe",
                                "text": "Zu oft hatte Habeck als Vizekanzler und Minister keine Prokura, um mit Lindner und Bundeskanzler Olaf Scholz (SPD) verbindlich verhandeln zu können. Die grüne Partei und die Fraktion wollten mitreden, es entstanden Chaos und Frust."
                            }
                        ]
