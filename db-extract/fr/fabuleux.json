                                                "sense_id": "6d1ad559-56be-3796-bd09-63d55610eaac",
                                                "text": "Es war ein fabelhafter Abend."
                                            },
                                            {
                                                "example_id": "27022c02-8a9b-40cb-8b13-312556805a80",
                                                "sense_id": "6d1ad559-56be-3796-bd09-63d55610eaac",
