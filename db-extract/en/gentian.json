                    {
                        "translation_id": "03eb4e15-cb4c-4b42-993e-2bc76d8cf883",
                        "source_entry_id": "4fe4364f-0baa-3445-8ef2-7746b1cb69cf",
                        "source_sense_description": "Any of various herbs of the family Gentianaceae",
                        "target_lang_word": "гореча́вка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гореча́вка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "49f848a0-aa47-31f2-97f7-59c0c8aa6014",
                                        "entry_id": "4b1cb2de-a577-3982-bc99-e9610c261c7a",
                                        "glosses": [
                                            "ботан. травянистое растение семейства горечавковых (Gentiana)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3dbe30-44ca-42c5-8d0c-5debb78a2df6",
                                                "sense_id": "49f848a0-aa47-31f2-97f7-59c0c8aa6014",
                                                "text": "По дну долины местами струился прозрачный родник и в соседстве залегал богатый луг с пышным ковром голубых горечавок, шариков, красных Oxytropis’ов, желтых хохлаток и т. п."
                                            },
                                            {
                                                "example_id": "7af08d79-68c6-4125-8f8f-64d34be7ab01",
                                                "sense_id": "49f848a0-aa47-31f2-97f7-59c0c8aa6014",
                                                "text": "Горечавка — это такая скромная в блеклом цветневом уборе травка, обычно затеривающаяся в толпах луговых стеблей; некоторые разновидности её цветут в досенокосные месяцы, другие много позже, но есть и такая разновидность горечавки (о ней-то и речь), которая имеет смелость цвести как раз в сенокосную пору, так что все её попытки пропылиться летучей пыльцой в будущее попадают под лезвия кос."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
