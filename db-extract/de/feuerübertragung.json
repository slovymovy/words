                ],
                "senses": [
                    {
                        "sense_id": "6c12bf3a-0e05-3372-86bb-07b122b62a32",
                        "entry_id": "6f7fcc93-140d-3d11-ae77-c46d7909d98c",
                        "glosses": [
                            "das schadhafte Durchdringen von Hindernissen oder das Überwinden von Entfernungen durch Feuer/Flammen in andere Brandabschnitte"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "c4a1b6f5-7f4e-4def-96d4-a92eb49522ab",
                                "sense_id": "6c12bf3a-0e05-3372-86bb-07b122b62a32",
                                "text": "„Eine pyrotechnische Zündung ist eine Zündung durch Feuerübertragung.“"
                            },
                            {
                                "example_id": "8be05bbc-0577-490b-8844-579f1ac46ae3",
                                "sense_id": "6c12bf3a-0e05-3372-86bb-07b122b62a32",
                                "text": "„Infolge unzulänglicher Abtrennung der Übergänge in beiden Stockwerken ist es zu der Feuerübertragung gekommen, obwohl bei der breiten Fahrstraße sonst ein Überspringen des Brandes kaum zu befürchten wäre.“"
                            },
                            {
                                "example_id": "59369a2e-0b06-4d82-90c3-f2b7dec70378",
                                "sense_id": "6c12bf3a-0e05-3372-86bb-07b122b62a32",
                                "text": "„Bei freistehenden Gebäuden werden in bezug auf Feuerübertragung die Entfernung bis zum nächsten Gebäude sowie die Bedachungsart eine wichtige Rolle spielen. Bei Gebäuden, welche mit den Breitseiten einander gegenüber stehen, erfolgt die Feuerübertragung auch auf grössere Distanzen.“"
                            },
                            {
                                "example_id": "28f47806-3fb8-4688-9f29-ef91c901dd56",
                                "sense_id": "6c12bf3a-0e05-3372-86bb-07b122b62a32",
                                "text": "„Das Feuergebiet hat 8 sq.m gemacht, Retter haben Zünden liquidiert und haben Feuerübertragung auf in der Nähe den gelegenen Geschäften nicht erlaubt.“"
                            },
                            {
                                "example_id": "13d0318d-d360-4bd4-84c1-bd5304f78357",
                                "sense_id": "6c12bf3a-0e05-3372-86bb-07b122b62a32",
                                "text": "„Auf Brandmauern darf der Dachfuß nur dann aufgelegt werden, wenn durch geeignete Vorkehrungen ein entsprechender Schutz gegen Feuerübertragung geschaffen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
