{
    "word_family": [
        "pace",
        "pacer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "598d1c65-7cab-367a-91be-6d139c5209e5",
                    "sense_definition": "The speed, rate, or timing at which something happens, develops, or is done.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speed_and_timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director managed the <w>pacing</w> of the movie perfectly, keeping the audience engaged from start to finish.",
                            "target_lang_translations": {
                                "ru": "Режиссер идеально выдержал <w>темп</w> фильма, удерживая внимание зрителей от начала до самого конца."
                            }
                        },
                        {
                            "text": "She struggled with the <w>fast</w> <w>pacing</w> of the university lectures during her first semester.",
                            "target_lang_translations": {
                                "ru": "В первом семестре ей было тяжело справляться с <w>быстрым</w> <w>темпом</w> университетских лекций."
                            }
                        }
                    ],
                    "synonyms": [
                        "tempo",
                        "speed",
                        "rate",
                        "timing"
                    ],
                    "common_phrases": [
                        "fast pacing",
                        "slow pacing",
                        "pacing of the story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скорость, темп или ритм, с которым что-либо происходит, развивается или выполняется."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темп",
                                "target_lang_sense_clarification": "скорость развития событий, повествования или работы"
                            },
                            {
                                "target_lang_word": "ритм",
                                "target_lang_sense_clarification": "размеренность и чередование элементов в произведении или процессе"
                            },
                            {
                                "target_lang_word": "динамика",
                                "target_lang_sense_clarification": "скорость и характер развития сюжета или действия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a0af3a80-d647-3fb6-8d83-88989284c34d",
                    "sense_definition": "Present participle and gerund of <w>pace</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was nervously <w>pacing</w> back and forth in the hospital waiting room.",
                            "target_lang_translations": {
                                "ru": "Он нервно <w>ходил</w> взад-вперед по приемному покою больницы."
                            }
                        },
                        {
                            "text": "By <w>pacing</w> herself during the marathon, she managed to finish with a personal best time.",
                            "target_lang_translations": {
                                "ru": "Правильно <w>распределив</w> свои силы во время марафона, она смогла финишировать с личным рекордом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pacing back and forth",
                        "pacing the floor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола pace (ходить взад-вперед, мерить шагами, распределять силы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шагающий",
                                "target_lang_sense_clarification": "ходящий взад-вперед или меряющий шагами"
                            },
                            {
                                "target_lang_word": "распределение сил",
                                "target_lang_sense_clarification": "в контексте бега или работы (pacing oneself)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}