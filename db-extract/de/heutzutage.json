                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нынче",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c0ad2d52-a926-3aa5-983c-be913026b35c",
                                        "entry_id": "f626304e-7fb5-395a-803b-a31b3b630c60",
                                        "glosses": [
                                            "разг. то же, что теперь, в настоящее время"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ad4b0b-b7f4-4937-989e-b611e34052ad",
                                                "sense_id": "c0ad2d52-a926-3aa5-983c-be913026b35c",
                                                "text": "[Чацкий:] Нет, нынче свет уж не таков."
                                            },
                                            {
                                                "example_id": "70344517-da11-4d0b-a121-7d1d83ceacd7",
                                                "sense_id": "c0ad2d52-a926-3aa5-983c-be913026b35c",
                                                "text": "[Барон:] Стар, государь, я нынче: при дворе // Что делать мне?"
                                            },
                                            {
                                                "example_id": "75c7e411-063a-4b23-9f0e-c7cf979daaac",
                                                "sense_id": "c0ad2d52-a926-3aa5-983c-be913026b35c",
                                                "text": "— Всяких людей я нынче вижу, а вот сильных нет! Где ж они?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dcc88ca-d77d-37a8-b256-03558054798e",
                                        "entry_id": "f626304e-7fb5-395a-803b-a31b3b630c60",
                                        "glosses": [
                                            "разг. в этом, текущем году"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f53a0a7c-af94-4084-89e2-101c5460ef8f",
                                                "sense_id": "3dcc88ca-d77d-37a8-b256-03558054798e",
                                                "text": "Ребятишки и молодёжь побежали в тальник смотреть, уродилась ли нынче чёрная смородина."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e38db8c-513d-3be7-87e5-1080a46010fb",
                                        "entry_id": "f626304e-7fb5-395a-803b-a31b3b630c60",
                                        "glosses": [
                                            "разг. то же, что сегодня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674ee604-2658-4907-bc5f-b5f23f119d93",
                                                "sense_id": "1e38db8c-513d-3be7-87e5-1080a46010fb",
                                                "text": "Жаль, что нынче погода дурная."
                                            },
                                            {
                                                "example_id": "21745e07-5cd2-40e4-93e6-1e95df737c50",
                                                "sense_id": "1e38db8c-513d-3be7-87e5-1080a46010fb",
                                                "text": "[Николай:] Нынче у вас каприз — приласкать человека, завтра каприз — оттолкнуть."
                                            },
                                            {
                                                "example_id": "ab90b713-4f0a-4690-95b1-7c69cd32aa16",
                                                "sense_id": "1e38db8c-513d-3be7-87e5-1080a46010fb",
                                                "text": "Нынче годовщина смерти моей матушки, я приехал помолиться на её могиле и случайно увидел вас."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
