                "senses": [
                    {
                        "sense_id": "8f3d2e45-f31f-31ec-9aa4-a5fd159545a2",
                        "entry_id": "9aa3dbbd-7afd-318a-a303-2b54f77ddd57",
                        "glosses": [
                            "прост. прийти в чувство; очнуться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc49a328-4748-4285-ac26-1044f14fc1d7",
                                "sense_id": "8f3d2e45-f31f-31ec-9aa4-a5fd159545a2",
                                "text": "Думали — покойник. Очухался потом. Дрожа, выпил рюмку водки и ушел окровавленный."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb38677f-9491-3832-a471-7ba6ee323bdf",
                        "entry_id": "9aa3dbbd-7afd-318a-a303-2b54f77ddd57",
                        "glosses": [
                            "перен. опомниться, одуматься"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5365385a-5d61-447d-8e95-d12131c1091a",
                                "sense_id": "cb38677f-9491-3832-a471-7ba6ee323bdf",
                                "text": "Кричит: — Запасайтесь, дьяволы, гробами, сейчас стрелять буду! Только после этих роковых слов народ маленько очухался."
                            }
                        ]
                    }
