                "senses": [
                    {
                        "sense_id": "dd5c1dd2-17ae-32b9-94a1-739256b2669f",
                        "entry_id": "b9cbd101-f0fd-3642-8f19-8cadcf729814",
                        "glosses": [
                            "The character or fundamental values of a person, people, culture, or movement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29f8dfc6-8e22-4fa2-bd2f-541a82a64441",
                                "sense_id": "dd5c1dd2-17ae-32b9-94a1-739256b2669f",
                                "text": "To slip past censors, Chinese bloggers have become masters of comic subterfuge, cloaking their messages in protective layers of irony and satire. This is not a new concept, but it has erupted so powerfully that it now defines the ethos of the Internet in China."
                            },
                            {
                                "example_id": "d12737e9-a979-4e01-836e-4776b1111758",
                                "sense_id": "dd5c1dd2-17ae-32b9-94a1-739256b2669f",
                                "text": "As we saw with Housing Problems, this 'telling one's own story' is an ethos Edgar Anstey would have applauded, and it was an ethos that has fed into Network Rail's work during the COVID-19 pandemic. Green explains: \"COVID has produced huge challenges for us, but it showed there is such a need for film-making at a time like this.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "255c2bc4-8d90-3845-8253-46f1eab9be7a",
                        "entry_id": "b9cbd101-f0fd-3642-8f19-8cadcf729814",
                        "glosses": [
                            "A form of rhetoric in which the writer or speaker invokes their authority, competence or expertise in an attempt to persuade others that their view is correct."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5612ee43-1d0a-30b8-b61d-e9106949e82c",
                        "entry_id": "b9cbd101-f0fd-3642-8f19-8cadcf729814",
                        "glosses": [
                            "The traits in a work of art which express the ideal or typic character, as influenced by the ethos (character or fundamental values) of a people, rather than emotional situations or individual character traits in a narrow sense; opposed to pathos."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
