                "senses": [
                    {
                        "sense_id": "c79ab781-646e-37d0-8169-8ffd109c496b",
                        "entry_id": "ac7b5e0b-492d-34a3-aa37-b2e043c51a29",
                        "glosses": [
                            "schräg abfallender Verlauf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84f4f37d-44ec-4fad-ac07-2079d526e26b",
                                "sense_id": "c79ab781-646e-37d0-8169-8ffd109c496b",
                                "text": "Der Turm der Oberkirche in Bad Frankenhausen weist eine gefährliche Schiefe auf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c9540bee-c51b-34b8-a94a-2fa9cf19ef5d",
                        "entry_id": "ac7b5e0b-492d-34a3-aa37-b2e043c51a29",
                        "glosses": [
                            "seitliche Abweichung einer Verteilung von der (symmetrischen) Normalverteilung"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "5086abd5-e8f5-45f0-a739-07dea8364790",
                                "sense_id": "c9540bee-c51b-34b8-a94a-2fa9cf19ef5d",
                                "text": "„Man kann den Mittelwert, die Varianz, die Schiefe, den Exzess, den Median und andere Maßzahlen benutzen, die ein statistisches Programm automatisch ausgibt.“"
                            },
                            {
                                "example_id": "36443ff8-4164-4d5e-b20a-20ea2c0ef5c1",
                                "sense_id": "c9540bee-c51b-34b8-a94a-2fa9cf19ef5d",
                                "text": "„Diese Verteilung weist bei normalverteilter Wölbung eine positive Schiefe auf.“"
                            },
                            {
                                "example_id": "632dde68-c0d0-4a45-9bae-f5283a1340cf",
                                "sense_id": "c9540bee-c51b-34b8-a94a-2fa9cf19ef5d",
                                "text": "„Es gibt verschiedene Parameter zur Messung der Schiefe; sie werden jedoch nicht oft genug verwendet, um ihre Behandlung an dieser Stelle zu rechtfertigen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6059d0d4-8600-41f2-9c66-f48d4a55cca2",
                        "source_entry_id": "ac7b5e0b-492d-34a3-aa37-b2e043c51a29",
