                                        "entry_id": "665cefc4-9dab-394a-9328-6832f272a920",
                                        "glosses": [
                                            "The first of the two terms by which a point is referred to, in a system of fixed rectilinear coordinate (Cartesian coordinate) axes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9aa2959-ad32-4696-80f0-9282a1182419",
                                                "sense_id": "5a67eca9-a9ce-33e5-b9ef-fc44de342eb4",
                                                "text": "The point (3,2) has 3 as its abscissa and 2 as its ordinate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e11eef2-942e-3fd7-8ba8-835432d6801f",
                                        "entry_id": "665cefc4-9dab-394a-9328-6832f272a920",
                                        "glosses": [
                                            "The horizontal line representing an axis of a Cartesian coordinate system, on which the abscissa (sense above) is shown."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
