                        "glosses": [
                            "Donner un caractère absurde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e413644-b58f-499d-b928-d7e8cf89393a",
                                "sense_id": "3e9dffa9-7c9e-36c1-8c84-3755b548b0ad",
                                "text": "Jamais sur terre, Ben : toujours en train de dériver, de déraper, d’absurdiser le moindre grain de poussière."
                            },
                            {
                                "example_id": "20560dae-0991-4bfc-9e76-e4ad523f6756",
                                "sense_id": "3e9dffa9-7c9e-36c1-8c84-3755b548b0ad",
                                "text": "Si Dieu fait mourir l’homme, ce n’est point pour absurdiser de plus belle la vie humaine."
                            }
                        ]
                    }
