            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e2fbf49-8e71-3f4d-821e-61f6d3786fe5",
                    "sense_definition": "Faire connaître une personne à une autre pour qu'elles fassent connaissance ; au pronominal, se faire connaître soi-même.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "faire connaître",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vous <w>présente</w> mon collègue Thomas, qui travaille avec moi depuis deux ans."
                        },
                        {
                            "text": "Permettez-moi de me <w>présenter</w> : je m'appelle Claire et je suis la nouvelle voisine."
                        },
                        {
                            "text": "Il m'a <w>présenté</w> à ses parents pendant le dîner."
                        }
                    ],
                    "common_phrases": [
                        "présenter un ami",
                        "présenter quelqu'un à ses parents",
                        "se présenter à quelqu'un"
                    ]
                },
                {
                    "sense_id": "df98e70f-5118-3f19-a31a-090b491a70ec",
                    "sense_definition": "Montrer ou faire voir quelque chose au public ou à quelqu'un, notamment pour la première fois.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "montrer ou tendre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise va <w>présenter</w> sa nouvelle voiture électrique au salon de l'automobile."
                        },
                        {
                            "text": "Le créateur a <w>présenté</w> sa collection devant un public enthousiaste."
                        }
                    ],
                    "synonyms": [
