                "senses": [
                    {
                        "sense_id": "6dafce7b-9d1e-3f4d-af26-5af59be79450",
                        "entry_id": "987dcfae-8ef4-350a-9489-2c4c9aad0264",
                        "glosses": [
                            "Geldsumme (Preis), die man für den Erwerb eines landwirtschaftlichen Erzeugnisses (Agrarerzeugnisses/Agrarproduktes) aufwenden muss"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "b4b32cf1-8a93-4244-8ffe-01834a852193",
                                "sense_id": "6dafce7b-9d1e-3f4d-af26-5af59be79450",
                                "text": "„Angesichts der wachsenden Zahl von Hungernden wäre es eigentlich notwendig, die internationalen Agrarpreise zu stabilisieren, damit gerade Kleinbauern ihre Produktion nachhaltig steigern können.“"
                            },
                            {
                                "example_id": "43656f6a-ad37-4801-a381-a45991134cc4",
                                "sense_id": "6dafce7b-9d1e-3f4d-af26-5af59be79450",
                                "text": "Die Öl- und Agrarpreise steigen, weil diese Güter knapper werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
