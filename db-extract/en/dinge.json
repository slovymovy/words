                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c362af45-f35b-41ab-8f23-592a57ebdba7",
                                "sense_id": "1c772278-5694-3e9d-ac7d-9a45a4b3a1c9",
                                "text": "‘A dinge,’ he said. ‘I just thrown him out. You seen me throw him out?’"
                            },
                            {
                                "example_id": "efcb6e74-9a3f-4cad-aec2-c928a8cfe52e",
                                "sense_id": "1c772278-5694-3e9d-ac7d-9a45a4b3a1c9",
                                "text": "‘You made a hit with the dinge,’ Bob was saying."
                            }
                        ]
