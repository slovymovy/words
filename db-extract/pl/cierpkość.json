                                "target_senses": [
                                    {
                                        "sense_id": "05a29ac8-8657-3755-8653-823362772df1",
                                        "entry_id": "4913a7fe-e7be-3086-b936-cdcdcf494bab",
                                        "glosses": [
                                            "Qualité de ce qui est âcre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "507139e3-1aa4-4d49-96d8-577f5e1d0a6a",
                                                "sense_id": "05a29ac8-8657-3755-8653-823362772df1",
                                                "text": "Sa saveur est d'une âcreté insupportable, mais celle-ci est souvent lente à se manifester."
                                            },
                                            {
                                                "example_id": "009b97c1-8751-4369-857a-291222b8c4ee",
                                                "sense_id": "05a29ac8-8657-3755-8653-823362772df1",
                                                "text": "L’âcreté du sel., de la bile."
                                            },
                                            {
                                                "example_id": "e2662c45-27a9-4576-b723-2a3d60727e51",
                                                "sense_id": "05a29ac8-8657-3755-8653-823362772df1",
                                                "text": "Avoir de l’âcreté dans l’humeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
