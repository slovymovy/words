                ],
                "senses": [
                    {
                        "sense_id": "7d644b7d-74ba-3ffe-933c-c56b5882391e",
                        "entry_id": "d77a4136-e187-3d40-8797-e075fa491342",
                        "glosses": [
                            "Enlever, supprimer les poils. → voir bucler et épiler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5efe9dcb-086e-4613-8ddd-7cfd99c9352d",
                                "sense_id": "7d644b7d-74ba-3ffe-933c-c56b5882391e",
                                "text": "Il ne reste plus que les pattes du caniche à dépoiler."
                            },
                            {
                                "example_id": "53703bc9-0321-4825-88ac-92cb43bfa3e2",
                                "sense_id": "7d644b7d-74ba-3ffe-933c-c56b5882391e",
                                "text": "J’ai passé cinq minutes à dépoiler mon manteau noir, c’est un véritable aimant à poils et à cheveux."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff2548ac-8f5d-36ad-b652-efe4ea2f3236",
                        "entry_id": "d77a4136-e187-3d40-8797-e075fa491342",
                        "glosses": [
                            "Déshabiller, mettre à poil."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "98b76cc4-f8e9-4b9f-b4c5-fd911944e46f",
                                "sense_id": "ff2548ac-8f5d-36ad-b652-efe4ea2f3236",
                                "text": "Au début, je le trouvais marrant mais quand il a commencé à me dépoiler, je l’ai remis à sa place."
                            }
                        ]
                    },
                    {
                        "sense_id": "99778ae1-2557-3f4b-b4ab-c0d4823a62fd",
                        "entry_id": "d77a4136-e187-3d40-8797-e075fa491342",
                        "glosses": [
                            "Mettre à nu, révéler; dépouiller."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1b5bd85a-3238-4bb1-b7d5-31d13217c0ec",
                                "sense_id": "99778ae1-2557-3f4b-b4ab-c0d4823a62fd",
                                "text": "À la guerre, tout est poilu. Le poil est l’arme du guerrier. On tond les prisonniers, les traîtres, les mauvais soldats pour les dépoiler."
                            },
                            {
                                "example_id": "ecb47de1-be8b-466a-8bf6-744fc992f9d3",
                                "sense_id": "99778ae1-2557-3f4b-b4ab-c0d4823a62fd",
                                "text": "Olivier Dubois se met en scène dans Pour tout l’or du monde et dépoile les dessous de la danse avec un humour acide et provoquant."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c89ce6b-2c62-3c26-855f-a5e1af6f2b75",
                        "entry_id": "d77a4136-e187-3d40-8797-e075fa491342",
                        "glosses": [
                            "Se déshabiller, se mettre à poil."
                        ],
                        "tags": [
                            "familiar",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "7068c4d2-8473-470c-a161-7a0162b52861",
                                "sense_id": "9c89ce6b-2c62-3c26-855f-a5e1af6f2b75",
                                "text": "Je me dépoile entièrement, j’ouvre en grand le vasistas et je fume la suprême cigarette de la journée, le buste émergeant du toit."
                            },
                            {
                                "example_id": "df5cf0a6-d1bb-4cf7-ac2f-5eeedc1250a1",
                                "sense_id": "9c89ce6b-2c62-3c26-855f-a5e1af6f2b75",
                                "text": "On voit de plus en plus de gens se dépoiler pour le calendrier d’un club sportif, pour une association ou pour une bonne cause."
                            },
                            {
                                "example_id": "751355c9-22f9-4c6d-873f-baeb5392203e",
                                "sense_id": "9c89ce6b-2c62-3c26-855f-a5e1af6f2b75",
                                "text": "Jamie Cullum, 26 ans, grimpe sur le piano, chante comme Sinatra en baskets, se dépoile façon clown : d’abord la veste, puis la cravate, la chemise, reste en tee-shirt."
                            }
                        ]
                    }
                ],
