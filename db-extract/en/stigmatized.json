                    },
                    {
                        "sense_id": "a3f31406-9f37-38ce-a212-3b45f52ea042",
                        "entry_id": "4c1ce2b3-c0b7-35e7-83b1-65db636050d1",
                        "glosses": [
                            "Bearing the stigmata."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b4442c-28c6-43c6-b629-f19e259ab8eb",
                                "sense_id": "a3f31406-9f37-38ce-a212-3b45f52ea042",
                                "text": "This gift of the Lord is not confined to past centuries. It still exists in full strength in our days. Catherine Emmerich, who died in 1824, is an example of it, and a stigmatized Saint still nearer to our times, for she did not die until 1885, Catherine Putigny, the sister of the Visitation, was seen in two parts of Metz at one and the same time."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81a29184-cb27-45d4-ae2d-26e6a2ad9cbf",
                        "source_entry_id": "4c1ce2b3-c0b7-35e7-83b1-65db636050d1",
                        "source_sense_description": "marked with stigma",
                        "target_lang_word": "stigmatisé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stigmatisé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b905087f-f581-3049-a461-19a8793bb3f4",
                                        "entry_id": "7cb87cc0-99a2-3190-a49d-b3df40d4d167",
                                        "glosses": [
                                            "Qui a subi une stigmatisation, qui a été stigmatisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c586637-c082-4778-9ceb-e007aa9f015d",
                                                "sense_id": "b905087f-f581-3049-a461-19a8793bb3f4",
                                                "text": "Mais pire encore, le corps, en plus d’être stigmatisé, est aujourd’hui la cible d’un projet de consommation sexuelle généré par des discours misogynes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stigmatisé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7d3fef9-c5bf-380e-bfaf-30696efb80c4",
                                        "entry_id": "845b4afb-d18d-38fb-8099-dec6bafef99f",
                                        "glosses": [
                                            "Celui qui a subi une stigmatisation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4389786b-ced4-394a-b641-57cb9f08ac7e",
                                        "entry_id": "845b4afb-d18d-38fb-8099-dec6bafef99f",
                                        "glosses": [
                                            "Celui qui présente des plaies similaires à celles que la tradition prête à Jésus-Christ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1448070a-03e3-4224-ab62-0444541d182e",
                                                "sense_id": "4389786b-ced4-394a-b641-57cb9f08ac7e",
                                                "text": "Saint François d’Assise est célèbre pour être un stigmatisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28791788-3c76-38b9-921a-d5a1d31ded8d",
                                        "entry_id": "845b4afb-d18d-38fb-8099-dec6bafef99f",
                                        "glosses": [
                                            "Celui qui présente des signes distinctifs naturels sur le corps, pouvant conduire à prêter à cette personne certains pouvoirs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b0425f8-1b65-4298-b6b2-fd3e08714344",
                                                "sense_id": "28791788-3c76-38b9-921a-d5a1d31ded8d",
                                                "text": "(…) il faut que vous sachiez, chers lecteurs, que Garau Marie est privilégiée ; d'abord elle est septième enfant de la même famille et puis elle est stigmatisée ; et pas d'une façon ordinaire ; Garau Marie a en effet une fleur de lys... devinez où ? c'est difficile à dire, et cela ne se montre pas, paraît-il, car la chaste Marie n'a jamais voulu faire constater la présence de la fleur de lys ; mais où diable aussi va se nicher cet emblème royal ?"
                                            }
                                        ]
                                    }
                                ]
