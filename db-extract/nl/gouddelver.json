                    {
                        "sense_id": "02df3c72-07a7-35d0-bdf0-f70dd2adf511",
                        "entry_id": "44eec7b1-5b3c-39a9-9461-c20f0d3b1b80",
                        "glosses": [
                            "sporter die veel gouden medailles wint"
