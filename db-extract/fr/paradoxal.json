                    {
                        "translation_id": "c24c8202-3599-41f8-8cc7-76b58f2f89bf",
                        "source_entry_id": "55c90f91-bc18-3bc4-a4e3-5dade56c2265",
                        "target_lang_word": "παράδοξος",
