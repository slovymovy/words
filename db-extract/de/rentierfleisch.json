                        "entry_id": "932fbe4e-39e3-37d8-8b14-c654d8399555",
                        "glosses": [
                            "das zubereitete oder zur Zubereitung vorgesehene Fleisch eines Rentiers"
                        ],
                        "tags": [
                            "Nahrungsmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "dbe41464-469f-4f9f-adaf-58d374f11cbd",
                                "sense_id": "5a5d955c-1a58-35e0-899c-7f3998d598ba",
                                "text": "„Es gibt Kohlsuppe mit Rentierfleisch und Brot dazu.“"
                            },
                            {
                                "example_id": "0d55d296-3be6-45fe-9d97-cd4c0b12824b",
                                "sense_id": "5a5d955c-1a58-35e0-899c-7f3998d598ba",
                                "text": "„Frische Beeren und Pilze, leckere Kartoffeln und Rentierfleisch benötigen keine gastronomischen Klimmzüge, um zu einer überaus schmackhaften Mahlzeit zu werden.“"
                            },
                            {
                                "example_id": "45bb240e-daac-4002-ae76-950e6bf3a368",
                                "sense_id": "5a5d955c-1a58-35e0-899c-7f3998d598ba",
                                "text": "„In seinem Lederrucksack hatte er neben dem Kaffeekessel und einem Ledersäckchen mit Kaffeeersatz, ein Säckchen mit Zucker, getrocknetes Rentierfleisch und eine Art Dauerbrot.“"
                            }
                        ],
