                                "target_lang_sense_clarification": "большая сила"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "güç",
                                "target_lang_sense_clarification": "fiziksel kuvvet"
                            },
                            {
                                "target_lang_word": "kuvvet",
                                "target_lang_sense_clarification": "bedensel güç"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ba5f09a-7f34-3848-ac07-1fae3e0780b5",
                    "sense_definition": "A positive quality, ability, or attribute that gives someone an advantage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We all have our own <w>strengths</w> and weaknesses in the workplace.",
                            "target_lang_translations": {
                                "ru": "У всех нас есть свои <w>сильные стороны</w> и слабости на рабочем месте.",
                                "tr": "İş yerinde hepimizin kendine göre <w>güçlü yönleri</w> ve zayıflıkları vardır."
                            }
                        },
                        {
                            "text": "You should try to play to your <w>strengths</w> during the interview.",
                            "target_lang_translations": {
                                "ru": "Вам следует стараться использовать свои <w>сильные стороны</w> во время собеседования.",
                                "tr": "Mülakat sırasında <w>güçlü taraflarınızı</w> öne çıkarmaya çalışmalısınız."
                            }
