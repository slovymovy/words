                ],
                "senses": [
                    {
                        "sense_id": "8e392d12-c464-3f23-a690-2e23548851cc",
                        "entry_id": "6f0fdc4b-4e9e-3877-9a84-bd45f4fdc937",
                        "glosses": [
                            "Sprachvarietät, die im Niveau zwischen einer voll ausgebauten und einer sehr einfachen, nur für sehr begrenzte kommunikative Zwecke fähigen Sprachform steht und nicht viel Prestige hat"
                        ],
                        "tags": [
                            "Soziolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "67b26da2-39bc-4503-9d51-003d60ae00ca",
                                "sense_id": "8e392d12-c464-3f23-a690-2e23548851cc",
                                "text": "„Dies ist zuerst im Rahmen der Kreolistik gesagt worden, wo zahlreiche Übergangsformen und keine eigentlichen Einschnitte zwischen den verschiedenen Sprachniveaus (Basilekt - Mesolekt(e) - Akrolekt) feststellbar sind.“"
                            },
                            {
                                "example_id": "a2a4cdea-ef50-4f52-8fb3-a8ecc1c319c1",
                                "sense_id": "8e392d12-c464-3f23-a690-2e23548851cc",
                                "text": "„Das Kreol wird als ‚Basilekt‘, die Prestigevarietät als ‚Akrolekt‘ bezeichnet, die Zwischenstufen sind in der Bezeichnung Mesolekt zusammengefasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e04d639d-8079-4022-b376-c32471d56a0f",
                        "source_entry_id": "6f0fdc4b-4e9e-3877-9a84-bd45f4fdc937",
                        "source_sense_id": "8e392d12-c464-3f23-a690-2e23548851cc",
                        "target_lang_word": "mesolect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesolect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a9f062d-9b00-31af-8288-3c17d066f880",
                                        "entry_id": "a88f0dce-1ddd-31de-b4a2-b5b6b7fea2a7",
                                        "glosses": [
                                            "A variety of speech that is midway between the acrolect and the basilect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "190f2591-613d-48bf-b19c-6ea57f349c1c",
                                                "sense_id": "0a9f062d-9b00-31af-8288-3c17d066f880",
                                                "text": "[...] one characteristic of the mesolect seems to be that it contains, not merely forms from the polar lects, but forms which in function, if not always in phonetic shape, are peculiar to itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb2092c9-b933-47c0-8849-e4feafaeb3da",
                        "source_entry_id": "6f0fdc4b-4e9e-3877-9a84-bd45f4fdc937",
                        "source_sense_id": "8e392d12-c464-3f23-a690-2e23548851cc",
                        "target_lang_word": "mésolecte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mésolecte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a65a7709-41dd-3641-a0b7-f0cfff00b79c",
                                        "entry_id": "689d27a6-32cc-37a7-a34b-5ce11849eed4",
                                        "glosses": [
                                            "Variété d’une langue pouvant être considérée comme entre le basilecte et l’acrolecte, donc de prestige intermédiaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f347dc-a384-4c5e-8cf6-1936216b0207",
                                                "sense_id": "a65a7709-41dd-3641-a0b7-f0cfff00b79c",
                                                "text": "Ce troisième niveau n’est autre que le mésolecte, qui se situe efectivement entre les deux pôles que sont l’« acrolecte » (la variété la plus proche du standard) et le « basilecte » (la variété la plus éloignée du standard)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
