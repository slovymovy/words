                            {
                                "example_id": "d26ba69b-c08b-4988-ba42-463ed0564fa3",
                                "sense_id": "48e42f1b-c446-3f24-bd7e-981d27ed8157",
                                "text": "Die Pflanzen sind mit Gaze umhüllt."
                            },
                            {
                                "example_id": "fa834236-269e-4168-be5b-60a3bca35721",
                                "sense_id": "48e42f1b-c446-3f24-bd7e-981d27ed8157",
                                "text": "„Sie sah schöne, alte Möbel, Polstersessel, auf denen Bezüge lagen, einen Kristallüster, der in Gaze eingebunden war, und einige gute Bilder.“"
                            }
                        ],
