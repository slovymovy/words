    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c641a823-e5b2-3f54-b71e-f5866404521f",
                    "sense_definition": "een verlengstuk van de ruggengraat bij sommige dieren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat zwiepte haar <w>staart</w> heen en weer terwijl ze naar de vogel keek.",
                            "target_lang_translations": {
                                "en": "The cat flicked her <w>tail</w> back and forth while she looked at the bird.",
                                "ru": "Кошка виляла <w>хвостом</w> туда-сюда, глядя на птицу."
                            }
                        },
                        {
                            "text": "De meeste honden kwispelen met hun <w>staart</w> als ze hun baasje zien.",
                            "target_lang_translations": {
                                "en": "Most dogs wag their <w>tail</w> when they see their owner.",
                                "ru": "Большинство собак виляют <w>хвостом</w>, когда видят своего хозяина."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwans"
                    ],
                    "common_phrases": [
                        "met de staart kwispelen",
                        "een lange staart"
                    ],
                    "target_lang_definitions": {
                        "en": "an extension of the spine in some animals",
                        "ru": "продолжение позвоночника у некоторых животных"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tail",
                                "target_lang_sense_clarification": "of an animal"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хвост",
                                "target_lang_sense_clarification": "часть тела животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84ef115b-2b35-344e-8d07-cb1fa506eb87",
                    "sense_definition": "een bundel lang haar die bij elkaar is gebonden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kapsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze droeg haar haar in een strakke <w>staart</w> tijdens het sporten.",
                            "target_lang_translations": {
                                "en": "She wore her hair in a tight <w>ponytail</w> while exercising.",
                                "ru": "Во время занятий спортом она собирала волосы в тугой <w>хвост</w>."
                            }
                        },
                        {
                            "text": "Het meisje vroeg haar moeder om een <w>staart</w> in haar haar te maken.",
                            "target_lang_translations": {
                                "en": "The girl asked her mother to put her hair in a <w>ponytail</w>.",
                                "ru": "Девочка попросила маму сделать ей <w>хвост</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een staart maken",
                        "haar in een staart"
                    ],
                    "target_lang_definitions": {
                        "en": "a bundle of long hair tied together",
                        "ru": "пучок длинных волос, собранных вместе"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ponytail",
                                "target_lang_sense_clarification": "hair style"
                            },
                            {
                                "target_lang_word": "tail",
                                "target_lang_sense_clarification": "hair style"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хвост",
                                "target_lang_sense_clarification": "причёска"
                            },
                            {
                                "target_lang_word": "конский хвост",
                                "target_lang_sense_clarification": "тип причёски"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ef8c63a-6503-3402-bb35-0b8b3c8185f3",
                    "sense_definition": "het achterste deel van een voertuig, zoals een vliegtuig of auto",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "achterzijde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens het opstijgen raakte de <w>staart</w> van het vliegtuig per ongeluk de grond.",
                            "target_lang_translations": {
                                "en": "During takeoff, the <w>tail</w> of the plane accidentally touched the ground.",
                                "ru": "Во время взлета <w>хвост</w> самолета случайно коснулся земли."
                            }
                        },
                        {
                            "text": "Het logo van de luchtvaartmaatschappij staat groot op de <w>staart</w> afgebeeld.",
                            "target_lang_translations": {
                                "en": "The airline's logo is displayed large on the <w>tail</w>.",
                                "ru": "Логотип авиакомпании крупно изображен на <w>хвосте</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de staart van het vliegtuig"
                    ],
                    "target_lang_definitions": {
                        "en": "the rear part of a vehicle, such as an airplane or car",
                        "ru": "задняя часть транспортного средства, например самолета или автомобиля"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tail",
                                "target_lang_sense_clarification": "of an aircraft or vehicle"
                            },
                            {
                                "target_lang_word": "rear",
                                "target_lang_sense_clarification": "back part"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хвост",
                                "target_lang_sense_clarification": "задняя часть самолёта или поезда"
                            },
                            {
                                "target_lang_word": "задняя часть",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24bab27d-8aca-3ec5-9eeb-0641bfa5697a",
                    "sense_definition": "het laatste deel of einde van een reeks, periode of gebeurtenis",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "einde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aan de <w>staart</w> van de file stonden de auto's nog steeds helemaal stil.",
                            "target_lang_translations": {
                                "en": "At the <w>tail end</w> of the traffic jam, the cars were still completely stationary.",
                                "ru": "В <w>хвосте</w> пробки машины все еще стояли без движения."
                            }
                        },
                        {
                            "text": "Met hem zou ik nog wel een leuke <w>staart</w> aan deze avond kunnen breien.",
                            "target_lang_translations": {
                                "en": "With him, I could still put a nice <w>finish</w> to this evening.",
                                "ru": "С ним я бы еще мог придумать приятное <w>завершение</w> этого вечера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een staartje krijgen",
                        "de staart van de file"
                    ],
                    "target_lang_definitions": {
                        "en": "the final part or end of a series, period, or event",
                        "ru": "последняя часть или конец серии, периода или события"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tail end",
                                "target_lang_sense_clarification": "of a queue or event"
                            },
                            {
                                "target_lang_word": "end",
                                "target_lang_sense_clarification": "final part"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хвост",
                                "target_lang_sense_clarification": "конец очереди или пробки"
                            },
                            {
                                "target_lang_word": "конец",
                                "target_lang_sense_clarification": "завершение чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc62c872-2c03-3f6e-a8d8-84e087f1f2fa",
                    "sense_definition": "een ietwat spottende bijnaam voor een jongen of man die zijn haar in een staart draagt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bijnaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kunnen die <w>staarten</w> van hiernaast de muziek niet wat zachter zetten?",
                            "target_lang_translations": {
                                "en": "Can't those <w>ponytail guys</w> next door turn the music down a bit?",
                                "ru": "Не могли бы эти <w>хвостатые</w> из соседней квартиры сделать музыку потише?"
                            }
                        },
                        {
                            "text": "Er liepen een paar <w>staarten</w> rond bij het rockconcert in het park.",
                            "target_lang_translations": {
                                "en": "There were a few <w>guys with ponytails</w> walking around at the rock concert in the park.",
                                "ru": "На рок-концерте в парке разгуливало несколько <w>парней с хвостами</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a slightly mocking nickname."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a somewhat mocking nickname for a boy or man who wears his hair in a ponytail",
                        "ru": "несколько насмешливое прозвище парня или мужчины, носящего волосы в хвосте"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ponytail guy",
                                "target_lang_sense_clarification": "mocking nickname"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хвостатый",
                                "target_lang_sense_clarification": "ироничное прозвище человека с хвостом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b6071c1-aa8f-30f2-b234-ef7f6df07c27",
                    "sense_definition": "de tweede of derde persoon enkelvoud tegenwoordige tijd van <w>staren</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>staart</w> al minutenlang uit het raam zonder iets te zeggen.",
                            "target_lang_translations": {
                                "en": "He has been <w>staring</w> out the window for minutes without saying anything.",
                                "ru": "Он уже несколько минут <w>смотрит</w> в окно, ничего не говоря."
                            }
                        },
                        {
                            "text": "Waarom <w>staart</w> zij zo vreemd naar die onbekende man?",
                            "target_lang_translations": {
                                "en": "Why is she <w>staring</w> so strangely at that unknown man?",
                                "ru": "Почему она так странно <w>глазеет</w> на того незнакомца?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "voor zich uit staart"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "conjugated form of staren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the second or third person singular present tense of 'to stare'",
                        "ru": "форма второго или третьего лица единственного числа настоящего времени глагола 'staren' (пристально смотреть)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stares",
                                "target_lang_sense_clarification": "present tense of to stare"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "смотрит",
                                "target_lang_sense_clarification": "пристально, не отрываясь"
                            },
                            {
                                "target_lang_word": "глазеет",
                                "target_lang_sense_clarification": "разговорно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21ef8deb-98f8-3116-8868-a54406c03200",
                    "sense_definition": "de gebiedende wijs (meervoud) van <w>staren</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Staart</w> niet zo naar die mensen, dat is onbeleefd!",
                            "target_lang_translations": {
                                "en": "Don't <w>stare</w> at those people like that, it's rude!",
                                "ru": "Не <w>глазейте</w> так на тех людей, это невежливо!"
                            }
                        },
                        {
                            "text": "Kom op jongens, <w>staart</w> niet naar je telefoon maar let op de weg.",
                            "target_lang_translations": {
                                "en": "Come on guys, don't <w>stare</w> at your phone but watch the road.",
                                "ru": "Давайте, ребята, не <w>утыкайтесь</w> в свои телефоны, а следите за дорогой."
                            }
                        }
                    ],
