                    "frequency": "Middle",
                    "semantic_group_id": "graad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dominee keek bezorgd naar de <w>schrikwekkend</w> lege kerk.",
                            "target_lang_translations": {
