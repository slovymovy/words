                                    {
                                        "sense_id": "2ea86df9-984b-362c-96ed-de9598403e92",
                                        "entry_id": "b898bbd4-254b-31a5-96d9-be8c5c241937",
                                        "glosses": [
                                            "Apparat, der – nach Einführen und Auslesen einer Bargeldbezugskarte sowie nach der Autorisierung durch Eingabe einer Geheimzahl – Bargeld von einem Giro- oder Kreditkartenkonto in Banknoten auszahlt"
                                        ],
                                        "tags": [
                                            "amtssprachlich",
                                            "ansonsten veraltend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef464d02-a426-4b46-b9b8-63b4d611e2c9",
                                                "sense_id": "2ea86df9-984b-362c-96ed-de9598403e92",
                                                "text": "„Geldausgabeautomaten gibt es nicht bei E-Bay, aber ab sofort kann man sie trotzdem im Internet kaufen: Der Online-Shop für IT-Equipment und Services des Bank-Verlages bietet neben Hardware, Software und Verbrauchsmaterialien auch eine ganze Reihe bankspezifischer Produkte vom Geldausgabeautomaten über Kontoauszugs-, Sparbuch- und Belegdrucker, Geldkartenladeterminals, Depotsysteme wie Tresore oder Mietfachanlagen bis hin zu Zutrittskontrollsystemen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33a3c254-2042-48cb-9744-5eb1af22a3bc",
                        "source_entry_id": "3415fbc2-be89-353a-b9d7-24286f87e871",
                        "source_sense_id": "81147a8b-5bc2-3d1f-92d4-dd569d26d93c",
                        "target_lang_word": "Geldautomat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geldautomat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5489ed9-8532-3686-92ca-a2f10a3a2690",
                                        "entry_id": "edb53fad-b9d8-32ea-b4f4-7eafa1023b09",
                                        "glosses": [
                                            "Geldausgabeautomat"
                                        ],
                                        "tags": [
                                            "in Deutschland gängig",
                                            "in der Schweiz selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2e29123-97aa-4a83-9da3-89c92d1cd887",
                                                "sense_id": "b5489ed9-8532-3686-92ca-a2f10a3a2690",
                                                "text": "„Unvergesslich der Bankangestellte, der offen und schmerzlich erklärte, er gehe in Rente, weil die neuen Geldautomaten ihn in seinem Glaskasten überflüssig machen“"
                                            },
                                            {
                                                "example_id": "f8877542-6e24-43bc-86ac-18260679235b",
                                                "sense_id": "b5489ed9-8532-3686-92ca-a2f10a3a2690",
                                                "text": "„Ein heutiger Geldautomat besteht aus einem Industrie-Standard-PC mit angeschlossener Spezialperipherie und einem Tresor.“"
                                            },
                                            {
                                                "example_id": "cc52d288-b3df-4836-9118-77b058542409",
                                                "sense_id": "b5489ed9-8532-3686-92ca-a2f10a3a2690",
                                                "text": "„Wir hielten im Stadtzentrum an, um etwas vom Geldautomaten zu holen.“"
                                            },
                                            {
                                                "example_id": "d27c02d3-97d3-42e7-9fe2-6de7ccb91a1d",
                                                "sense_id": "b5489ed9-8532-3686-92ca-a2f10a3a2690",
                                                "text": "„Dann zeigte er mir den Weg zu einem Geldautomaten, an dem ich für 100 Euro knapp 20.000 moldawische Leu abhob.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
