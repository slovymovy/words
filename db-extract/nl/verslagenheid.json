        "nl-extract.jsonl": [
            {
                "entry_id": "eed3b55c-3032-3d66-9c0e-6359c4e0863f",
                "word": "verslagenheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1b87225f-c40f-326b-8ca9-517a91193423",
                        "entry_id": "eed3b55c-3032-3d66-9c0e-6359c4e0863f",
                        "glosses": [
                            "het heftige, verdrietige, verwarde gevoel dat men heeft als men iets heel belangrijks verloren heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dfda15f-8fc9-443c-97af-b4eab7d717a8",
                                "sense_id": "1b87225f-c40f-326b-8ca9-517a91193423",
                                "text": "De Belgische kranten openen woensdag vooral met verslagenheid. Na de aanslagen van dinsdagochtend, waarbij zeker 34 mensen werden gedood en tweehonderd anderen gewond raakten, tekent collectieve rouw de voorpagina’s."
                            },
                            {
                                "example_id": "6ea75677-f75e-4674-b867-ca95635c0e59",
                                "sense_id": "1b87225f-c40f-326b-8ca9-517a91193423",
                                "text": "Verslagenheid na fatale val renner: Wielrennen Antoine Demoitié overleed na een val in Gent-Wevelgem. De discussie over veiligheid in de koers laait weer op na de dood van de Belgische renner."
                            },
                            {
                                "example_id": "85397211-4816-4847-b8e5-bbc537c61362",
                                "sense_id": "1b87225f-c40f-326b-8ca9-517a91193423",
                                "text": "De verslagenheid is groot, zegt Van de Laar. \"Iedereen kent hem wel in onze wereld. Hij heeft mij en vele anderen in de restaurantwereld gebracht naar waar ze nu staan\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0737d513-aa03-4528-a996-cbfba858e481",
                        "source_entry_id": "eed3b55c-3032-3d66-9c0e-6359c4e0863f",
                        "source_sense_id": "1b87225f-c40f-326b-8ca9-517a91193423",
                        "target_lang_word": "dection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ec00cf6d-2544-4c92-bac8-99c3982848e3",
                        "source_entry_id": "eed3b55c-3032-3d66-9c0e-6359c4e0863f",
                        "source_sense_id": "1b87225f-c40f-326b-8ca9-517a91193423",
                        "target_lang_word": "despondence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despondence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8930ec8f-3d8b-3ecd-914e-3b06b26b4091",
                                        "entry_id": "4e4e5aa5-74e2-3d7f-84e6-97ff6d9ba335",
                                        "glosses": [
                                            "The state of being downcast or despondent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ff09a9-0664-4922-8b5d-26a0ec1f768b",
                                                "sense_id": "8930ec8f-3d8b-3ecd-914e-3b06b26b4091",
                                                "text": "When adverse winds and waves arise,\nAnd in my heart despondence sighs,\n....\nGrateful I hear the kind decree\nThat \"as my day,—my strength shall be.\"—"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "613acee7-94c5-4b66-8072-f4d6adfa99c4",
                        "source_entry_id": "eed3b55c-3032-3d66-9c0e-6359c4e0863f",
                        "source_sense_id": "1b87225f-c40f-326b-8ca9-517a91193423",
                        "target_lang_word": "consternation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consternation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                        "entry_id": "c953c29d-b9c5-3f61-852f-825947492f3a",
                                        "glosses": [
                                            "Amazement or horror that confounds the faculties, and incapacitates for reflection; terror, combined with amazement; dismay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098bfb65-8e1b-4454-bae9-e14445728e4d",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "\"Out!\" exclaimed her husband, with something like genuine consternation in his voice."
                                            },
                                            {
                                                "example_id": "602baf81-173e-4c3e-9592-ba81593c7eac",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "Their audience had been listening in increasing consternation."
                                            },
                                            {
                                                "example_id": "48b24c20-55c4-46c7-89d5-0265fe6cc51c",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "It was probably worth four millennia of consternation and regret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
