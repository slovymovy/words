                            {
                                "example_id": "9c05f016-3742-49d9-a79a-a4b422adca8f",
                                "sense_id": "714abfaf-1835-3d06-8c6c-6a7eadb72f9d",
                                "text": "Tel est frigélisation remplaçant winterization pour désigner le traitement qui prive les huiles comestibles de leurs composés figeables."
                            },
                            {
                                "example_id": "e4e55fc0-86b9-47cc-9495-fef54513e25a",
                                "sense_id": "714abfaf-1835-3d06-8c6c-6a7eadb72f9d",
                                "text": "Lorsque le but est de fabriquer par hydrogénation une autre huile plus stable, il faut parfois séparer par refroidissement (frigélisation) une fraction de l’huile qui a tendance à cristalliser."
                            }
                        ]
                    }
