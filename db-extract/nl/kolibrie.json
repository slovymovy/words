                                "target_senses": [
                                    {
                                        "sense_id": "4f18df52-342a-361d-9d50-8775711d72df",
                                        "entry_id": "e152b1e2-5d25-3652-8354-ee67f9082619",
                                        "glosses": [
                                            "ein Vogel, welcher der Familie der Kolibris [2] angehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6df5417-5b30-4163-b348-3395e75f3092",
                                                "sense_id": "4f18df52-342a-361d-9d50-8775711d72df",
                                                "text": "Das charakteristische der Kolibris ist ihr schneller Flügelschlag."
                                            },
                                            {
                                                "example_id": "cd349d99-8cd2-4b25-9fac-3dc07dfed1f5",
                                                "sense_id": "4f18df52-342a-361d-9d50-8775711d72df",
                                                "text": "Vergleichende Betrachtungen großer und kleiner Vögel, etwa die Gegenüberstellung des monströsen Oberschenkelknochens eines fossilen Riesenstraußes und des winzigen Skelettes eines Kolibris, lassen zunächst auf die spektakuläre Darstellung von Extremleistungen schließen.“"
                                            },
                                            {
                                                "example_id": "642e017f-02db-48a2-9fbe-b86a50914434",
                                                "sense_id": "4f18df52-342a-361d-9d50-8775711d72df",
                                                "text": "„Zahlreiche Tierdarstellungen von Kolibris, Kondoren, aber auch menschliche Figuren fanden Berücksichtigung.“"
                                            },
                                            {
                                                "example_id": "8f35903f-2279-45ce-80de-9288b193d0c1",
                                                "sense_id": "4f18df52-342a-361d-9d50-8775711d72df",
                                                "text": "„Mein Blick fiel auf den mit schimmernden Kolibris bestickten Kimono, der an der Badezimmertür hing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "254ae466-d4d2-3832-b33c-83ffb50fca62",
                                        "entry_id": "e152b1e2-5d25-3652-8354-ee67f9082619",
                                        "glosses": [
                                            "eine Familie der Seglervögel"
                                        ],
                                        "tags": [
                                            "im Plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4be9f5d-679d-4b98-bc27-934bf6c02db6",
                        "source_entry_id": "008955f5-5a11-3551-9516-cf3d75f31d48",
                        "source_sense_id": "4113bd39-50b4-3af4-9351-ddcdb1e25c0b",
                        "source_sense_description": "een zeer klein vogeltje met een zeer snelle vleugelslag van de familie Trochilidae uit de orde der grootvleugeligen",
                        "target_lang_word": "hummingbird",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hummingbird",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2081408c-bf0c-39e4-984e-b7d6739987fd",
                                        "entry_id": "fd1fbe55-d49d-3b03-888d-e2a6493d5683",
                                        "glosses": [
                                            "Any of various small American birds in the family Trochilidae that have the ability to hover."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e92b264d-d97b-49e0-a6f1-5ba0d6942342",
                                                "sense_id": "2081408c-bf0c-39e4-984e-b7d6739987fd",
                                                "text": "Soon I hear the low all-pervading hum of an approaching hummingbird circling above the rock, …"
                                            },
                                            {
                                                "example_id": "1a9d186c-e195-4494-a4ce-76c57715de67",
                                                "sense_id": "2081408c-bf0c-39e4-984e-b7d6739987fd",
                                                "text": "Beyond the veranda was a small cleared garden, bounded with cactus hedges and adorned with clumps of flowering shrubs, round which the great blue butterflies and the tiny humming-birds fluttered and darted in crescents of sparkling light."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbf424c2-30cd-4b6e-a64d-c438981f15ed",
                        "source_entry_id": "008955f5-5a11-3551-9516-cf3d75f31d48",
                        "source_sense_id": "4113bd39-50b4-3af4-9351-ddcdb1e25c0b",
                        "source_sense_description": "een zeer klein vogeltje met een zeer snelle vleugelslag van de familie Trochilidae uit de orde der grootvleugeligen",
                        "target_lang_word": "colibri",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colibri",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81a06bc1-e407-32e9-b8c9-2f3a9cf51ba0",
                                        "entry_id": "cba519be-3cce-32dc-92d7-993868378b9f",
                                        "glosses": [
                                            "Nom normalisé qu’on donne à environ 70 genres d’oiseaux de la famille des trochilidés et de la sous-famille des trochilinés, comportant plus de 145 espèces à plumage iridescent, et qu’on retrouve dans l’écozone néarctique, mais dont la plupart des espèces habitent les régions subtropicales et tropicales de l’écozone néotropicale. (genres principaux: Archilochus, Colibri, Lampornis, Oreotrochilus, Trochilus, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c3b4ea5-c395-4731-b47f-c4e27ab1a6ad",
                                                "sense_id": "81a06bc1-e407-32e9-b8c9-2f3a9cf51ba0",
                                                "text": "En règle générale, les genres de la sous-famille des trochilinés ne comportant qu'une, deux ou trois espèces ont été baptisés colibris par défaut, alors que ceux qui comportent plus de membres portent des noms qui leur sont propres (e.g. campyloptère, ariane, brillant, etc.)."
                                            },
                                            {
                                                "example_id": "d22ea218-97c2-452b-80e0-3d369e1a90fb",
                                                "sense_id": "81a06bc1-e407-32e9-b8c9-2f3a9cf51ba0",
                                                "text": "Celui de colibri est pris de la langue des Caribes. Marcgrave ne distingue pas les colibris des oiseaux-mouches, et les appelle tous indifféremment du nom bresilien , guainumbi *. Cependant ils diffèrent les uns des autres par un caractère évident et constant : cette différence est dans le bec. Celui des colibris, égal et filé, légèrement renflé par le bout, n'est pas droit comme dans l'oiseau-mouche , mais courbé dans toute sa longueur : il est aussi plus long a proportion."
                                            },
                                            {
                                                "example_id": "92b620fb-eeb6-42a0-a649-c0d2d00f1d26",
                                                "sense_id": "81a06bc1-e407-32e9-b8c9-2f3a9cf51ba0",
                                                "text": "Ses caleçons noirs étaient semés de mandragores, et d’une manière indolente elle faisait claquer de petites pantoufles en duvet de colibri."
                                            },
                                            {
                                                "example_id": "4329558f-f74d-4e77-b9a7-1731ba388d80",
                                                "sense_id": "81a06bc1-e407-32e9-b8c9-2f3a9cf51ba0",
                                                "text": "Des plaintes avaient fait état de nids de colibris d'Anna et d'autres oiseaux migrateurs endommagés par les travaux d'élargissement de l'ouvrage qui appartient au gouvernement canadien depuis 2018."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "781da1ed-d1fb-3f07-8059-f2da767c43f3",
                                        "entry_id": "cba519be-3cce-32dc-92d7-993868378b9f",
                                        "glosses": [
                                            "Nom générique désignant familièrement tous les oiseaux de la famille des trochilidés, i.e. les oiseaux-mouches, sans distinction des genres visés."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d698982-b3a6-4d87-a9e7-fc49ea5cdcb6",
                                                "sense_id": "781da1ed-d1fb-3f07-8059-f2da767c43f3",
                                                "text": "Les colibris bourdonnent dans les massifs de fleurs."
                                            },
                                            {
                                                "example_id": "5a0b04de-f7d9-4c23-8c11-f4c4d31fd8f2",
                                                "sense_id": "781da1ed-d1fb-3f07-8059-f2da767c43f3",
                                                "text": "Un colibri, quasi immobile dans son vol, cueille le suc des fleurs du prunier devant la maison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4536ae5f-c480-4418-a3a5-30ed41904ec6",
                        "source_entry_id": "008955f5-5a11-3551-9516-cf3d75f31d48",
                        "source_sense_id": "4113bd39-50b4-3af4-9351-ddcdb1e25c0b",
                        "source_sense_description": "een zeer klein vogeltje met een zeer snelle vleugelslag van de familie Trochilidae uit de orde der grootvleugeligen",
                        "target_lang_word": "oiseau-mouche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oiseau-mouche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd354cbe-0d8f-3a96-aa61-2ef053f2e92c",
                                        "entry_id": "89d722b0-3454-3008-b946-5685d7117189",
                                        "glosses": [
                                            "Colibri."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215aec60-44da-4374-a269-b0f0fa40b3a2",
                                                "sense_id": "cd354cbe-0d8f-3a96-aa61-2ef053f2e92c",
                                                "text": "Ce que nous avons dit de la beauté de l’oiseau-mouche, de sa vivacité, de son vol bourdonnant et rapide, de sa constance à visiter les fleurs, de sa manière de nicher et de vivre, doit s’appliquer également au colibri. Un même instinct anime ces deux charmans oiseaux, et c’est leur ressemblance qui les a fait souvent confondre sous un même nom, cependant ils différent l’un de l’autre par un caractère évident et constant. Cette différence est dans le bec ; celui des colibris, égal et affilé, n’est pas droit comme dans l’oiseau-mouche, mais courbé dans toute sa longueur. De plus, la taille svelte et légère des colibris parait plus allongée que celle des oiseaux-mouche; ils sont généralement plug gros : cependant il y en a de plus petits que les grands oiseaux-mouche."
                                            },
                                            {
                                                "example_id": "1ed70480-17fb-42a7-b902-0ffe1de7fd3e",
                                                "sense_id": "cd354cbe-0d8f-3a96-aa61-2ef053f2e92c",
                                                "text": "Oiseaux-mouches aux couleurs resplendissantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb3a84b1-7252-4e3a-a399-f4e93bad6f02",
                        "source_entry_id": "008955f5-5a11-3551-9516-cf3d75f31d48",
