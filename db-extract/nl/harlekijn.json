                                        "entry_id": "1ddc0bf9-934d-33b3-ba13-257073ca0682",
                                        "glosses": [
                                            "A pantomime fool, typically dressed in colorful checkered clothes, used as a stock character in commedia dell'arte and other genres."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8caba2dd-4400-4f46-b425-1ec994c54c9d",
                                                "sense_id": "be33f7ad-bfa6-36cd-b3ad-0e83a27ea6f2",
                                                "text": "[…] were certainly the worst and dullest company into which an audience was ever introduced; and (which was a secret known to few) were actually intended so to be, in order to contrast the comic part of the entertainment, and to display the tricks of harlequin to the better advantage."
                                            },
                                            {
                                                "example_id": "633ca812-ecb7-4a03-968d-1afaf76dfd3c",
                                                "sense_id": "be33f7ad-bfa6-36cd-b3ad-0e83a27ea6f2",
                                                "text": "Motives are like harlequins—there is always a second dress beneath their first."
                                            }
                                        ]
                                    },
