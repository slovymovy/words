                "senses": [
                    {
                        "sense_id": "5e3a06ee-a4a4-358e-bf3e-add3e72b788a",
                        "entry_id": "5ead52cf-0256-3112-8747-a4b1de45c28a",
                        "glosses": [
                            "to slander, to backbite, to slag off, to find fault (with), to run down"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60877641-4922-4abe-b79c-f675eb16f841",
                                "sense_id": "5e3a06ee-a4a4-358e-bf3e-add3e72b788a",
                                "text": "Е́сли тебя́ ха́ют за твое́й спино́й, они́ про́сто зна́ют, что ты а́нгел... и хотя́т подре́зать тебе́ кры́лья.",
                                "translation": "If they slander you behind your back, they simply know that you're an angel... and want to cut your wings.",
                                "english": "If they slander you behind your back, they simply know that you're an angel... and want to cut your wings."
                            }
                        ]
                    }
                ],
