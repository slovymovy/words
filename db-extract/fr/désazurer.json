                "senses": [
                    {
                        "sense_id": "7f2ec4e0-7f2e-3930-89b6-165fc2e2a9db",
                        "entry_id": "2f6d0fe6-99e0-3633-a665-ec81729a852e",
                        "glosses": [
                            "Faire perdre son caractère azur à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49121c7-43e4-4473-bdde-c4b607195c8b",
                                "sense_id": "7f2ec4e0-7f2e-3930-89b6-165fc2e2a9db",
                                "text": "Déglaçonnée, désazurée, Médie met ses mains dans l’eau pendante et jaillissante."
                            },
                            {
                                "example_id": "579bd615-6e9c-4d88-83c6-fb0a1c0afe7c",
                                "sense_id": "7f2ec4e0-7f2e-3930-89b6-165fc2e2a9db",
                                "text": "Toujours le même ciel comme « désazuré » et, de nouveau, la forêt."
                            },
                            {
                                "example_id": "d8e16d7e-9a5b-4c46-8564-273f2a26fdd9",
                                "sense_id": "7f2ec4e0-7f2e-3930-89b6-165fc2e2a9db",
                                "text": "La nuit ne se désazure Que pour s’adorer obscure"
                            },
                            {
                                "example_id": "432b6fc2-b4a5-4159-9476-1d5537492b24",
                                "sense_id": "7f2ec4e0-7f2e-3930-89b6-165fc2e2a9db",
                                "text": "Et notre ex-beau ciel bleu se “désazure” de voeux en voeux."
                            }
                        ]
                    }
                ],
