                        "examples": [
                            {
                                "example_id": "98a914bc-3a8e-4b51-926d-5599d7971686",
                                "sense_id": "c7e22505-8cae-3b3d-8318-51e1f93cdfbf",
                                "text": "Une crue un peu forte s’est produite pendant la nuit, et le fleuve a recueilli un certain nombre d’objets imprudemment déposés trop près de ses rives, poutres, futailles vides, et autres matériaux susceptibles de flotter.",
                                "translation": "A rather strong flood occurred during the night, and the river collected a certain number of objects imprudently deposited too close to its banks, beams, empty barrels, and other materials likely to float.",
                                "english": "A rather strong flood occurred during the night, and the river collected a certain number of objects imprudently deposited too close to its banks, beams, empty barrels, and other materials likely to float."
                            }
                        ]
