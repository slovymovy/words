            {
                "entry_id": "d2969da3-9b7a-32be-9efb-19bd921e5dd5",
                "word": "Poucette",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "72bf70cf-5dbd-3f65-b909-98895277d90d",
                        "entry_id": "d2969da3-9b7a-32be-9efb-19bd921e5dd5",
                        "glosses": [
                            "Prénom donné par Hans Christian Andersen à une petite fille minuscule qui se confronte à des difficultés très au-dessus de sa dimension, dans le conte éponyme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e253d4-6e6a-4597-abb8-0de862a7836c",
                                "sense_id": "72bf70cf-5dbd-3f65-b909-98895277d90d",
                                "text": "Dieu sait quelle fut la frayeur de la pauvre petite Poucette quand le hanneton l’emporta dans l’arbre !"
                            }
                        ]
                    },
                    {
                        "sense_id": "09ddb903-838f-3651-a20f-d43fe6e94d45",
                        "entry_id": "d2969da3-9b7a-32be-9efb-19bd921e5dd5",
                        "glosses": [
                            "Adolescent(e) de la génération Z."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "19754c72-a9c8-4e44-813f-8f89f923509c",
                                "sense_id": "09ddb903-838f-3651-a20f-d43fe6e94d45",
                                "text": "Petite Poucette apostrophe ses pères : Me reprochez-vous mon égoïsme, mais qui me le montra ? Mon individualisme, mais qui me l'enseigna ?"
                            },
                            {
                                "example_id": "c8e1135a-931b-4587-a428-c458db1890f8",
                                "sense_id": "09ddb903-838f-3651-a20f-d43fe6e94d45",
                                "text": "Je le baptise Petite Poucette, pour sa capacité à envoyer des SMS avec son pouce. C’est l’écolier, l’étudiante d’aujourd’hui, qui vivent un tsunami tant le monde change autour d’eux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51ac2389-3de3-4e21-a086-d5e19b8887e5",
                        "source_entry_id": "d2969da3-9b7a-32be-9efb-19bd921e5dd5",
                        "source_sense_description": "poucette",
                        "target_lang_word": "Däumelinchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Däumelinchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b94c082b-9253-34c7-bade-2a1f7080d495",
                                        "entry_id": "774e5ea3-1044-3496-871e-28523ceb4d4b",
                                        "glosses": [
                                            "fiktives weibliches Wesen von der Größe eines menschlichen Daumens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae92ee72-522f-46b8-ba7d-e37db3e3b23b",
                                                "sense_id": "b94c082b-9253-34c7-bade-2a1f7080d495",
                                                "text": "Das nur daumengroße Däumelinchen wird von einer Kröte entführt, die eine Frau für ihren Sohn sucht."
                                            },
                                            {
                                                "example_id": "39208a45-219e-4172-8403-51b36f19a5be",
                                                "sense_id": "b94c082b-9253-34c7-bade-2a1f7080d495",
                                                "text": "„Sie ist den ganzen Tag über geschrumpft. Wenn sie nicht aufpasst, wird sie noch so klein wie Däumelinchen, und dann sieht sie irgendwann niemand mehr, dann ist sie einfach weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
