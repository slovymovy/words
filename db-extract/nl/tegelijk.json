        "nl-extract.jsonl": [
            {
                "entry_id": "32718efa-45eb-3bcc-8f66-a255836afade",
                "word": "tegelijk",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c8933207-f41d-3069-a61b-eae2533a95a6",
                        "entry_id": "32718efa-45eb-3bcc-8f66-a255836afade",
                        "glosses": [
                            "op hetzelfde moment"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0981891-f8a6-4701-b581-a2e9ef11c5e4",
                                "sense_id": "c8933207-f41d-3069-a61b-eae2533a95a6",
                                "text": "Zij draaiden zich allebei plotseling om en liepen tegelijk naar de ijskraam terug."
                            },
                            {
                                "example_id": "827e9cf6-e159-43c9-bb13-48da6d7436ac",
                                "sense_id": "c8933207-f41d-3069-a61b-eae2533a95a6",
                                "text": "Ik verkeerde in shock - ze kwamen met zo'n heel andere energie dan die van mij het huis binnen: opdringerig en tegelijk op hun hoede, met een air waaruit sprak dat ze vaker met dit bijltje hadden gehakt."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c309bf6-5b84-3f40-a6fe-564050f33759",
                        "entry_id": "32718efa-45eb-3bcc-8f66-a255836afade",
                        "glosses": [
                            "in dezelfde periode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31c8d654-60ab-44f2-afa6-321878ef8733",
                                "sense_id": "8c309bf6-5b84-3f40-a6fe-564050f33759",
                                "text": "Volgens mij hebben zij tegelijk gestudeerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "51b888df-1365-3961-a22e-745e28a5afa9",
                        "entry_id": "32718efa-45eb-3bcc-8f66-a255836afade",
                        "glosses": [
                            "tevens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0220043-6669-4d80-a684-66327a46f4ac",
                                "sense_id": "51b888df-1365-3961-a22e-745e28a5afa9",
                                "text": "Zij is arts en tegelijk schrijfster."
                            },
                            {
                                "example_id": "bb01cc0a-d650-4e20-980e-8edb6cbcf303",
                                "sense_id": "51b888df-1365-3961-a22e-745e28a5afa9",
                                "text": "Maar tegelijk voelt de mens zich ook bezorgd, woedend en angstig."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d2beead-7a1a-3f51-a8ee-3e8e3fbbb2e6",
                        "entry_id": "32718efa-45eb-3bcc-8f66-a255836afade",
                        "glosses": [
                            "samen met iemand of iets anders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de6e0de1-74f5-46ed-9e2b-ac04f5ad281a",
                                "sense_id": "1d2beead-7a1a-3f51-a8ee-3e8e3fbbb2e6",
                                "text": "Als de timmerman toch komt, kun je tegelijk de rest van de meubels laten repareren."
                            },
                            {
                                "example_id": "d155749c-3194-49aa-855e-b0c643c73b43",
                                "sense_id": "1d2beead-7a1a-3f51-a8ee-3e8e3fbbb2e6",
                                "text": "We besloten allemaal tegelijk af te dalen om elkaar tijdens de steile stukken bij te kunnen staan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a550d39a-6939-4182-95ee-643c9869bfac",
                        "source_entry_id": "32718efa-45eb-3bcc-8f66-a255836afade",
                        "source_sense_id": "c8933207-f41d-3069-a61b-eae2533a95a6",
                        "source_sense_description": "op hetzelfde moment",
                        "target_lang_word": "zugleich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zugleich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                        "entry_id": "0b5f7d23-8979-3259-8235-55ffabf05930",
                                        "glosses": [
                                            "zur gleichen Zeit mit etwas anderem ablaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "580bfc59-c95d-4be5-9d1e-95dab9e857d0",
                                                "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                                "text": "Es stürmte und regnete zugleich."
                                            },
                                            {
                                                "example_id": "9c824681-45a8-4d2e-a1a3-7514c91cf707",
                                                "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                                "text": "Sie lachte und weinte zugleich."
                                            },
                                            {
                                                "example_id": "da0a49af-f58a-46ff-a1cc-4a9627a084f2",
                                                "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                                "text": "„Richtig wäre es gewesen, den Menschen in beiden Teilen Deutschlands reinen Wein einzuschenken und ihnen zugleich Zuversicht zu vermitteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                        "entry_id": "0b5f7d23-8979-3259-8235-55ffabf05930",
                                        "glosses": [
                                            "auch noch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13ae7547-15b2-407b-8d23-7f0cedf1f280",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "Zugleich mit dem Sturm kam heftiger Regen auf."
                                            },
                                            {
                                                "example_id": "64815d40-dc87-4309-84f8-5c6d4d654a63",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "Sie ist Unternehmerin und zugleich Mutter einer vierjährigen Tochter."
                                            },
                                            {
                                                "example_id": "e7250c8f-8b15-4ac0-ac30-214f0c59dd5f",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "Das Buch ist zugleich informativ und spannend."
                                            },
                                            {
                                                "example_id": "0292c0a5-3df2-4f3a-8274-79abfa7e0e18",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "„Die Holzdielen sind herausgerissen, aber in der Turnhalle, die zugleich Aula war, hängen noch die Basketballkörbe an der Wand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4c08361-468b-44eb-8d37-705fc44f6b40",
                        "source_entry_id": "32718efa-45eb-3bcc-8f66-a255836afade",
                        "source_sense_id": "c8933207-f41d-3069-a61b-eae2533a95a6",
                        "source_sense_description": "op hetzelfde moment",
                        "target_lang_word": "gleichzeitig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gleichzeitig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                        "entry_id": "75b4721e-8311-334d-a542-198fdc650611",
                                        "glosses": [
                                            "zur selben/gleichen Zeit ablaufend, stattfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49837d2-81c0-43cc-a8bf-242674918503",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "Ich kann nicht gleichzeitig an verschiedenen Orten sein."
                                            },
                                            {
                                                "example_id": "078a879a-2b28-4615-ae03-f171711d8851",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "„Seit der Jahrtausendwende könne jedoch ein Rückgang der Deutschlernenden bei gleichzeitigem Anstieg der Englischlernenden festgestellt werden.“"
                                            },
                                            {
                                                "example_id": "66fadb38-67bc-437f-9ba9-54ecd3ade6e7",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "„In den Alpen und im Alpenvorland kreisen bei guter Thermik nicht weniger als zwei bis drei Dutzend Gleit- und Deltaflieger gleichzeitig über dem Tal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                        "entry_id": "75b4721e-8311-334d-a542-198fdc650611",
                                        "glosses": [
                                            "auch noch, daneben, zugleich"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd657abb-350d-46ca-8119-0ccc5303950c",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "„K. wartete noch ein Weilchen, sah von seinem Kopfkissen aus die alte Frau, die ihm gegenüber wohnte und die ihn mit einer an ihr ganz ungewöhnlichen Neugierde beobachtete, dann aber, gleichzeitig befremdet und hungrig, läutete er.“"
                                            },
                                            {
                                                "example_id": "915b2cf7-ea87-4aec-a48f-a00c5ed5c151",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "Er war Edelmann und gleichzeitig Prolet."
                                            },
                                            {
                                                "example_id": "23df94f1-c644-441c-994c-690d3d55ddf7",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "Unser Nachbar ist gleichzeitig unser Vermieter."
                                            },
                                            {
                                                "example_id": "dc804a4b-abf5-4711-804a-c64e6eb998a4",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "„Gleichzeitig könnte der Vulkanausbruch auch das Ende der Trichterbecherkultur in Skandinavien eingeläutet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68938ad1-57dd-48bb-a5f4-056777ef55f4",
                        "source_entry_id": "32718efa-45eb-3bcc-8f66-a255836afade",
                        "source_sense_id": "c8933207-f41d-3069-a61b-eae2533a95a6",
                        "source_sense_description": "op hetzelfde moment",
                        "target_lang_word": "at the same time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at the same time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                        "entry_id": "73bfff3f-ec81-3182-9d3a-f79647229543",
                                        "glosses": [
                                            "At the same instant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8608ac4d-459e-4321-b493-1dec99f23cd7",
                                                "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                                "text": "Their departures were at the same time."
                                            },
                                            {
                                                "example_id": "a7b7000e-ee3d-4ca2-b9fe-798afda0fbbd",
                                                "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                                "text": "They departed at the same time."
                                            },
                                            {
                                                "example_id": "dc26530c-95a2-47f9-8796-0dd73f7729e6",
                                                "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                                "text": "I bid him come towards me and give me his letter, at the same time throwing down, carelessly, a book I had in my hands.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                        "entry_id": "73bfff3f-ec81-3182-9d3a-f79647229543",
                                        "glosses": [
                                            "Overlapping or coinciding in duration."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bab6badd-fad5-4e15-b6f4-981e7eca78b4",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "His service as chairman was at the same time as his board membership"
                                            },
                                            {
                                                "example_id": "b5a99962-f54f-4efd-9f8f-a31ba212df61",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "I'm working. But at the same time, I'm exercising too."
                                            },
                                            {
                                                "example_id": "4a8eed97-83df-40cb-9413-c8406b41a943",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                                            },
                                            {
                                                "example_id": "39aa47fe-7058-49cd-b2dd-c5672a051261",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "At the same time, it is pouring money into cleaning up the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2cb6b64-bab6-37aa-85a4-083be4581f2f",
                                        "entry_id": "73bfff3f-ec81-3182-9d3a-f79647229543",
                                        "glosses": [
                                            "On the other hand (introducing an opposing viewpoint)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68f6b37b-ac7d-4b6c-a12b-2cf23fc7d9b0",
                        "source_entry_id": "32718efa-45eb-3bcc-8f66-a255836afade",
