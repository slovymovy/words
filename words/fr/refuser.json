{
    "word_family": [
        "refus"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d025043-23c2-3798-acf9-46847ef32345",
                    "sense_definition": "Décliner une proposition ou ne pas accepter ce qui est offert.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rejet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de <w>refuser</w> cette proposition d'emploi car les conditions ne lui convenaient pas."
                        },
                        {
                            "text": "Il ne pouvait pas décemment <w>refuser</w> une invitation aussi chaleureuse de ses amis."
                        }
                    ],
                    "synonyms": [
                        "rejeter"
                    ],
                    "antonyms": [
                        "accepter"
                    ],
                    "common_phrases": [
                        "refuser une offre",
                        "refuser une invitation"
                    ]
                },
                {
                    "sense_id": "3477e1cd-772c-3dc1-a0f9-8f5fe602b2ff",
                    "sense_definition": "Ne pas vouloir faire ce qui est demandé, exigé ou commandé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rejet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin a catégoriquement <w>refusé</w> de répondre aux questions posées par le juge."
                        },
                        {
                            "text": "L'enfant fatigué <w>refuse</w> d'aller se coucher malgré les demandes répétées de ses parents."
                        }
                    ],
                    "synonyms": [
                        "rejeter"
                    ],
                    "antonyms": [
                        "accepter"
                    ],
                    "common_phrases": [
                        "refuser de répondre",
                        "refuser d'obéir"
                    ]
                },
                {
                    "sense_id": "ef065850-b985-3f4f-83e3-7bdb56092466",
                    "sense_definition": "Ne pas accorder ce qui est sollicité ou demandé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "non_attribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a choisi de lui <w>refuser</w> l'augmentation de salaire qu'il espérait tant."
                        },
                        {
                            "text": "La banque a malheureusement <w>refusé</w> le prêt nécessaire à l'achat de leur appartement."
                        }
                    ],
                    "antonyms": [
                        "accorder"
                    ],
                    "common_phrases": [
                        "refuser un prêt",
                        "refuser une autorisation"
                    ]
                },
                {
                    "sense_id": "0df7e55b-8a68-3c4e-8218-571ecf30a0e6",
                    "sense_definition": "Ne pas admettre une personne dans un lieu ou la déclarer non reçue à une épreuve.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les agents de sécurité ont <w>refusé</w> plusieurs personnes à l'entrée de la salle de concert."
                        },
                        {
                            "text": "Il était très déçu d'avoir été <w>refusé</w> à son examen de permis de conduire."
                        }
                    ],
                    "synonyms": [
                        "rejeter"
                    ],
                    "antonyms": [
                        "accepter"
                    ],
                    "common_phrases": [
                        "refuser l'entrée",
                        "être refusé à l'examen"
                    ]
                },
                {
                    "sense_id": "c81036f3-cae3-3fef-b38a-e5ecffcac17c",
                    "sense_definition": "Éviter d'engager une confrontation ou un affrontement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "evitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voyant l'adversaire supérieur en nombre, le général a préféré <w>refuser</w> le combat."
                        },
                        {
                            "text": "Le boxeur a habilement manœuvré sur le ring pour <w>refuser</w> l'affrontement direct."
                        }
                    ],
                    "antonyms": [
                        "accepter"
                    ],
                    "common_phrases": [
                        "refuser le combat"
                    ]
                },
                {
                    "sense_id": "6106f76c-503b-3cc1-80d8-01a63f3c99ea",
                    "sense_definition": "Devenir contraire ou moins favorable à la marche d'un navire, en parlant du vent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'approche du cap, le vent a brusquement <w>refusé</w>, contraignant l'équipage à changer d'allure."
                        },
                        {
                            "text": "Dès que le vent a commencé à <w>refuser</w>, le navigateur a dû ajuster la voilure du voilier."
                        }
                    ]
                }
            ]
        }
    ]
}