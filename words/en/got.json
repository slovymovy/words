                                "ru": "У меня <w>есть</w> два брата и одна сестра.",
                                "fr": "J'<ai> deux frères et une sœur."
                            }
                        },
                        {
                            "text": "You <got> any money to lend me?",
                            "target_lang_translations": {
                                "ru": "У тебя <есть> деньги, чтобы одолжить мне?",
                                "fr": "Tu <as> de l'argent à me prêter ?"
                            }
