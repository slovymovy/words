                "senses": [
                    {
                        "sense_id": "0eac44fc-eaf7-3d69-9289-7eef5582faba",
                        "entry_id": "1a40ae6a-25cb-3e87-97cc-b22ed3beb697",
                        "glosses": [
                            "woord dat hetzelfde wordt uitgesproken als een ander woord, maar anders wordt geschreven en een andere betekenis heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b00a400f-386c-40aa-beef-8fb14cd7b1e0",
                                "sense_id": "0eac44fc-eaf7-3d69-9289-7eef5582faba",
                                "text": "Homofonen zijn woorden die hetzelfde klinken maar die je anders schrijft. Er zijn in het Nederlands vrij veel van deze woorden omdat we bijvoorbeeld de ei en ij hebben en ook de ou en au."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11513d83-6406-486c-bc0a-044256081656",
                        "source_entry_id": "1a40ae6a-25cb-3e87-97cc-b22ed3beb697",
                        "source_sense_id": "0eac44fc-eaf7-3d69-9289-7eef5582faba",
                        "source_sense_description": "gelijkklinkend woord",
                        "target_lang_word": "Homophon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Homophon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12996845-b710-3fbe-9ac4-694ade4b93c8",
                                        "entry_id": "4d69fd40-a07b-33eb-94ee-20782195ed5a",
                                        "glosses": [
                                            "eine sprachliche Einheit (vor allem Morphem oder Wort), die genau so ausgesprochen wird wie eine andere, obwohl sie verschiedene Einheiten sind, was durch ihre unterschiedliche Bedeutung und oft auch durch verschiedene Schreibweise deutlich wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "918b853e-f13d-4449-9b3e-022c2750b521",
                                                "sense_id": "12996845-b710-3fbe-9ac4-694ade4b93c8",
                                                "text": "„Ein anderer Grund, der gegen eine Transliteration der japanischen Schrift spricht, ist die große Zahl der Homophone.“"
                                            },
                                            {
                                                "example_id": "4a08ed20-e487-4523-8539-9efd4fded7d4",
                                                "sense_id": "12996845-b710-3fbe-9ac4-694ade4b93c8",
                                                "text": "Ein bekanntes Beispiel für Homophone sind die Wörter „Seite“ und „Saite“, die gleich ausgesprochen werden, aber unterschiedlich geschrieben werden und zugleich eine verschiedene Bedeutung haben."
                                            },
                                            {
                                                "example_id": "4d536aff-0dd3-45a4-b280-17e3da6fefb2",
                                                "sense_id": "12996845-b710-3fbe-9ac4-694ade4b93c8",
                                                "text": "„Die zahlreichen Homophone seines Alphabets versucht er durch das ziemlich fragwürdige Prinzip der Akrophonie zu erklären (das davon ausgeht, ein Ägypter habe beim Betrachten eines Zeichens stets den gemalten Gegenstand erkannt, seinen Namen und den Anfangsbuchstaben dieses Namens gewußt, so daß das Lesen des Lautes von ihm weder großes Können noch besonders gutes Gedächtnis erfordert hätten!);…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a17321c-6415-431c-b09b-4a8116999638",
                        "source_entry_id": "1a40ae6a-25cb-3e87-97cc-b22ed3beb697",
                        "source_sense_id": "0eac44fc-eaf7-3d69-9289-7eef5582faba",
