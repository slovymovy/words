                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e4134c5-96f6-4757-9b93-6becd90a0a9f",
                                "sense_id": "f79afe0a-7fbb-37d2-be35-be0d7320f19f",
                                "text": "A Bagnes, on a préféré tergiverser, tortuiser, lambiniser et se caresser le popotin plutôt que de désintégrer avec un missile procédural cette faune puante."
                            },
                            {
                                "example_id": "5f077d48-c129-4238-b29b-56bc98841d93",
                                "sense_id": "f79afe0a-7fbb-37d2-be35-be0d7320f19f",
                                "text": "Même Lepus americanus s'est fait « tortuiser » par nos adversaires."
                            },
                            {
                                "example_id": "5aa0aa2e-4294-442a-acbb-da54138fa26a",
                                "sense_id": "f79afe0a-7fbb-37d2-be35-be0d7320f19f",
                                "text": "Je sais pas si vous avez encore besoin qu'on poste les Gantelets ou autre objets polyformes, donc dans le doute, voici un Gantelet renommé puis tortuisé : 660939. Bâton de Mage Sativa des Tortues"
                            }
                        ]
