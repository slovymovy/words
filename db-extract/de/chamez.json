                    }
                ],
                "senses": [
                    {
                        "sense_id": "9062e8a1-a989-3f7b-85b2-6fffd9368c19",
                        "entry_id": "ea735393-ef49-35aa-a322-21dc5e50a27f",
                        "glosses": [
                            "der während Passah verbotene Sauerteig beziehungsweise die aus ihm hergestellten gesäuerten Backwaren, die vor dem Fest traditionell verbrannt werden müssen"
                        ],
                        "tags": [
                            "jüdische Religion; Judaismus"
                        ],
                        "examples": [
                            {
                                "example_id": "26ad3ab2-ba69-4b7e-9b6c-3e6ed51ee979",
                                "sense_id": "9062e8a1-a989-3f7b-85b2-6fffd9368c19",
                                "text": "„Sie fotografierten die Verbrennung des Chamez, des gesäuerten Backwerks, vor dem Passah-Fest.“"
                            },
                            {
                                "example_id": "dccd4ce6-bbf1-416e-a1ca-d35c3d118064",
                                "sense_id": "9062e8a1-a989-3f7b-85b2-6fffd9368c19",
                                "text": "„Auch das Pessachfest zeichnet sich durch ihm eigene Mizwot aus — dem Gebot, Maza (ungesäuertes Brot) zu essen, und dem Verbot, während der gesamten Festzeit Chamez (Gesäuertes) zu sich zu nehmen, zu besitzen oder auch nur in einem jüdischen Haus aufzubewahren.“"
                            },
                            {
                                "example_id": "ceb639a6-10c6-40ae-82de-e13ffcd93b59",
                                "sense_id": "9062e8a1-a989-3f7b-85b2-6fffd9368c19",
                                "text": "„Denn bevor acht Tage lang nur Mazze und andere ungesäuerte Lebensmittel auf dem Speiseplan stehen, muss das Haus vom ganzen Chamez befreit werden.“"
                            },
                            {
                                "example_id": "8ff753c4-ffa2-4427-a4b7-4a24fea6d2ab",
                                "sense_id": "9062e8a1-a989-3f7b-85b2-6fffd9368c19",
                                "text": "„Nach kurzem Zögern sagte der Mann verlegen: »Na, ich habe vergessen, den Chamez zu verbrennen, so daß er immer noch auf dem Balken im Zimmer liegt.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "accc724b-415c-49fb-b528-ffadd3241b54",
                        "source_entry_id": "ea735393-ef49-35aa-a322-21dc5e50a27f",
                        "source_sense_id": "9062e8a1-a989-3f7b-85b2-6fffd9368c19",
                        "source_sense_description": "während Passah verbotener Sauerteig und die aus ihm hergestellten gesäuerten Backwaren",
                        "target_lang_word": "chametz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chametz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e97f4fe-3a79-3d07-add7-71a6831a251d",
                                        "entry_id": "0f8c4d35-9d73-322e-982d-f2534770c01f",
                                        "glosses": [
                                            "Food products made from leavened grain flour, which may not be consumed on Passover."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87dd32f1-2e76-481a-b08e-98a39d7a9194",
                                                "sense_id": "9e97f4fe-3a79-3d07-add7-71a6831a251d",
                                                "text": "The eating of chametz (leavened products) is explicitly prohibited on Passover (Exod. 12:19–20; 13:3), for the Israelites “took their dough before it was leavened” (Exod. 12:34) and left Egypt in great haste."
                                            },
                                            {
                                                "example_id": "0d03bcf5-9c7f-4d95-964a-8507b76f6262",
                                                "sense_id": "9e97f4fe-3a79-3d07-add7-71a6831a251d",
                                                "text": "A chametz-free total environment is the Passover goal, so any place where chametz was or might have been used during the year is thoroughly checked and cleaned lest any chametz has been left behind."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chametz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e701b4bd-8157-31a0-a3a0-abdaf594350a",
                                        "entry_id": "ce5f615d-8540-32ca-bc8b-7519901402be",
                                        "glosses": [
                                            "Made of chametz."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da5ff5dd-26e2-4f16-a239-fb8f1af99a2d",
                                                "sense_id": "e701b4bd-8157-31a0-a3a0-abdaf594350a",
                                                "text": "It is permitted, therefore, to store and use all types of ointments, hand lotions, nail polish or medicated drops (for the ear or nose), etc., even if they contain an active chametz ingredient. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "743e8136-53d1-307d-8e3f-fcb6d7d9526c",
                                        "entry_id": "ce5f615d-8540-32ca-bc8b-7519901402be",
                                        "glosses": [
                                            "Used with or to be used with chametz."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff58a136-7d83-43ac-883e-79aaf0f07606",
                                                "sense_id": "743e8136-53d1-307d-8e3f-fcb6d7d9526c",
                                                "text": "One of the many preparations one must make for Pesach is kashering (a process to prepare a non-kosher vessel for kosher use or a chametz vessel for use on Pesach). […] All chametz utensils that will be used for Pesach must be thoroughly cleaned. […] Remove the filter covering the drain and put it away for Pesach with the chametz dishes. […] The pots may be chametz pots. […] Where needed, one can use a chametz microwave on Pesach by[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
