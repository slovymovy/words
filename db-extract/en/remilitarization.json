                        "glosses": [
                            "The act or process of remilitarizing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c2599fa3-da36-4d85-a966-c42ffa18a930",
                                "sense_id": "5399c888-f7e9-31d1-84a9-b48f27876dd1",
                                "text": "In more sophisticated versions, the German people are understood to have been taken in by Hitler’s charisma not least because the remilitarization he initiated — not to mention the Wehrmacht’s early battlefield successes — was a balm to wounded national pride."
                            }
                        ]
