                "senses": [
                    {
                        "sense_id": "f2b65a78-2408-30d0-9276-e07b8032e5c3",
                        "entry_id": "de312109-ea34-315e-a397-ea0afdde811f",
                        "glosses": [
                            "Holding a commission; officially appointed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1e36a4e1-e7b9-4b03-a44d-6b6878e66ea6",
                                "sense_id": "f2b65a78-2408-30d0-9276-e07b8032e5c3",
                                "text": "And be it further enacted, &c. That any commissioned auctioneer who shall violate any of the provisions contained in this act, shall for any such offence or violation, forfeit the sum of five hundred dollars, to be recovered in the manner prescribed for other forfeitures in the act aforesaid,"
                            },
                            {
                                "example_id": "d785afb2-e5bb-4876-8c7e-10a4867e91fc",
                                "sense_id": "f2b65a78-2408-30d0-9276-e07b8032e5c3",
                                "text": "Nothing in this Act contained shall subject ot forfeiture any commissioned ship of any foreign state, or give to any British court over or in respect of any ship entitled to recognition as a commissioned ship of any foreign state any jurisdiction which it would not have had if this Act had not passed."
                            },
                            {
                                "example_id": "2dadd0ee-115f-4c2e-9f26-f00e55e5c6ff",
                                "sense_id": "f2b65a78-2408-30d0-9276-e07b8032e5c3",
                                "text": "That the colonel of each regiment shall appoint his commissioned and non-commissioned staff officers as follows: One surgeon of the rank and grade of major, and one adjutant, one chaplain, one quartermaster, one commissary of subsistence, one inspector of rifle practice and two assitant surgeons, each of the grade and rank of capatin […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "baa9ff4f-2f08-3bd9-a77b-7169438afecf",
                        "entry_id": "de312109-ea34-315e-a397-ea0afdde811f",
                        "glosses": [
                            "Specially ordered."
