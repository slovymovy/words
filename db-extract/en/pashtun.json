                    },
                    {
                        "translation_id": "4955cafb-fcca-4df7-bce6-f91d369e6a34",
                        "source_entry_id": "41d184e1-a82b-321b-9f7f-438ff95c2dee",
                        "source_sense_description": "Pashtun person",
                        "target_lang_word": "Pachtoune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pachtoune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5eb82b5d-175c-3cfe-a3d1-0040e6265c8d",
                                        "entry_id": "fd8de54e-6bf2-354d-92f9-c4d30be02c2f",
                                        "glosses": [
                                            "Membre d’un peuple d’Asie centrale parlant le pachto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4acc7c2-70da-4162-9c3b-97c7ff152156",
                                                "sense_id": "5eb82b5d-175c-3cfe-a3d1-0040e6265c8d",
                                                "text": "[En Afghanistan], le plus grand groupe ethnique est les Pachtounes. Les Pachtounes sont de descendance aryenne. Ils peuvent avoir la peau claire et les yeux verts. Ils occupent la moitié sud du pays et la plupart des zones le long de la frontière orientale."
                                            },
                                            {
                                                "example_id": "9270dba3-9093-4bbb-b33b-b09e13a80a86",
                                                "sense_id": "5eb82b5d-175c-3cfe-a3d1-0040e6265c8d",
                                                "text": "Au Pakistan, les Pachtounes représentent environ 15,42 % de la population et vivent dispersés dans les quatre provinces du pays avec cependant une certaine prééminence dans les régions nord-ouest du pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da4f8f3d-faab-4c81-bec0-69c076db6930",
                        "source_entry_id": "41d184e1-a82b-321b-9f7f-438ff95c2dee",
                        "source_sense_description": "Pashtun person",
                        "target_lang_word": "Paschtune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paschtune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4351ad11-a4ff-379a-8192-a0bebae96880",
                                        "entry_id": "fc3cc900-5c5a-35b8-b415-a980674f8a4e",
                                        "glosses": [
                                            "in Afghanistan und Pakistan lebendes iranisches Volk"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abcd7d28-a658-49d9-810f-8535fd540c40",
                                                "sense_id": "4351ad11-a4ff-379a-8192-a0bebae96880",
                                                "text": "„Die Silhouetten der drei Männer im Türrahmen wirkten wie Riesen, deutlich größer und breiter als die Paschtunen aus der Gegend.“"
                                            },
                                            {
                                                "example_id": "d834f1b1-039f-4246-a840-3128f987a375",
                                                "sense_id": "4351ad11-a4ff-379a-8192-a0bebae96880",
                                                "text": "„Sie geht durch den Empress Market, wo Paschtunen Tomaten und junge Falken an einem Strand verkaufen, Frauen mit Armreifen bis zum Ellbogen rosa Küken feilbieten, die auf Körben mit garantiert frischen Landeiern sitzen, ein Blinder Geldbäume in leeren Whiskey-Flaschen hochhält, die ohne Erde wachsen, und ein Mann, der wie ein Burmese aussieht, ein Plastikgerät verkauft, das Zwiebeln, Karotten und Kohlrabi zu Rosen schneidet.“"
                                            },
                                            {
                                                "example_id": "cbc3838f-93d4-4acf-a238-9c8c59890636",
                                                "sense_id": "4351ad11-a4ff-379a-8192-a0bebae96880",
                                                "text": "„Mürrische Männer vom Stamm der Paschtunen mit langen Bärten und schwarzem, eng um den Kopf gewundenem Turban bahnten sich ihren Weg durch die engen, staubigen Gassen zum Fußballstadion, das genau oberhalb des Hauptbasars lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c549d5d2-e6f5-3b8a-b8cf-cbd08bb90d58",
                                        "entry_id": "fc3cc900-5c5a-35b8-b415-a980674f8a4e",
                                        "glosses": [
                                            "Angehöriger des gleichnamigen iranischen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1df0d31-f0fb-4974-ac73-5d4f2b91bbe1",
                                                "sense_id": "c549d5d2-e6f5-3b8a-b8cf-cbd08bb90d58",
                                                "text": "„Er wartete in seinem Landrover, während ein Junge aus dem Dorf Azzam Bescheid sagte, und einige Minuten später trat der Paschtune umgeben von Leibwächtern aus dem Haus.“"
                                            },
                                            {
                                                "example_id": "4b3ec7a1-d163-460c-bc65-5a810d80c6b4",
                                                "sense_id": "c549d5d2-e6f5-3b8a-b8cf-cbd08bb90d58",
                                                "text": "„Die Ziegen im Pferch gerieten in Bewegung, aber der Amerikaner stieß dem Paschtunen weiterhin den Unterarm in den Mund, um dessen Rufe zu ersticken.“"
                                            },
                                            {
                                                "example_id": "9b25d1e8-5d54-427b-9204-2006374f93ab",
                                                "sense_id": "c549d5d2-e6f5-3b8a-b8cf-cbd08bb90d58",
                                                "text": "„Als Paschtune hatte er schon damals das Interesse der CIA geweckt.“"
                                            },
                                            {
                                                "example_id": "75405038-7f1b-4573-a136-667e27086acb",
                                                "sense_id": "c549d5d2-e6f5-3b8a-b8cf-cbd08bb90d58",
                                                "text": "„Der Paschtune ist groß, hat riesige Hände und Füße, eine lange, dicke Nase, schwarze Augen und einen buschigen, langen Bart, der bis auf den Schreibtisch vor ihm reicht.“"
                                            },
                                            {
                                                "example_id": "132c9083-9826-4529-ae18-918ddce97ae1",
                                                "sense_id": "c549d5d2-e6f5-3b8a-b8cf-cbd08bb90d58",
                                                "text": "„Chef des Ganzen war Salim Kaka, ein baumlanger Paschtune mit einem langen Bart, ein kampferprobter, wehrhafter Mann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "178a89a3-b666-4e24-b198-4c3df0c225b7",
                        "source_entry_id": "41d184e1-a82b-321b-9f7f-438ff95c2dee",
                        "source_sense_description": "Pashtun person",
                        "target_lang_word": "Paschtunin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paschtunin",
