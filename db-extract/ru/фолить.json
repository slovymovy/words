                                        "sense_id": "31e7fe7b-33e0-3a40-b21b-5c1912389d0b",
                                        "entry_id": "1d3b6708-1081-3dde-9982-c948cf227c9a",
                                        "glosses": [
                                            "To hit outside of the baselines."
