    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3dacf79b-44b3-3178-ae7b-94ad06505d09",
                    "sense_definition": "Avoir la même sonorité finale, en parlant de mots ou de vers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "poésie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce poème, le poète a voulu faire <w>rimer</w> ces deux mots."
                        },
                        {
                            "text": "Les enfants s'amusent à trouver des mots qui <w>riment</w> bien."
                        }
                    ],
                    "common_phrases": [
                        "faire rimer"
                    ]
                },
                {
                    "sense_id": "4f0e48e0-ede5-38bf-849e-f53e16d7ced9",
                    "sense_definition": "Avoir du sens, de la logique ou de la cohérence, principalement dans des tournures négatives.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sens_figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa décision soudaine de tout abandonner ne <w>rime</w> à rien."
                        },
                        {
                            "text": "Cette nouvelle organisation du travail ne <w>rime</w> vraiment à rien."
                        }
                    ],
                    "common_phrases": [
                        "ne rimer à rien"
                    ]
                },
                {
                    "sense_id": "136d0351-43a5-3030-b5a9-b642cb10d251",
                    "sense_definition": "Être associé à, aller de pair avec ou être équivalent à quelque chose d'autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sens_figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour ces étudiants, les vacances d'été doivent toujours <w>rimer</w> avec aventure."
                        },
                        {
                            "text": "Dans cette entreprise, la rapidité d'exécution ne doit jamais <w>rimer</w> avec négligence."
                        }
                    ],
                    "synonyms": [
                        "concorder",
                        "s'accorder"
                    ],
                    "common_phrases": [
                        "rimer avec"
                    ]
                },
                {
                    "sense_id": "4f831b2e-ae6c-35c7-b23d-650bbe1fa280",
                    "sense_definition": "Composer des vers ou écrire de la poésie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "poésie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès son adolescence, il s'est mis à <w>rimer</w> passionnément dans ses carnets."
                        },
                        {
                            "text": "Cet auteur solitaire préfère <w>rimer</w> dans le calme de la nuit."
                        }
                    ],
                    "synonyms": [
                        "poétiser",
                        "versifier"
                    ]
                },
                {
                    "sense_id": "e9cce402-5fb2-3653-b1d4-185a87dd2732",
                    "sense_definition": "Mettre un texte ou un récit sous forme poétique en utilisant des rimes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "poésie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dramaturge a patiemment <w>rimé</w> cette ancienne légende médiévale pour la scène."
                        },
                        {
                            "text": "Elle a <w>rimé</w> une courte fable morale pour instruire ses jeunes élèves."
                        }
                    ],
                    "synonyms": [
