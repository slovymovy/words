                        "target_lang_word": "blitz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blitz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dafbf68-49fd-311f-85ce-2599a8048385",
                                        "entry_id": "68fb3d01-56a9-39b2-9ea2-fc93ea792520",
                                        "glosses": [
                                            "A sudden attack, especially an air raid; usually with reference to the Blitz."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d83dbc5-a498-3f97-b7a5-1d0623650470",
                                        "entry_id": "68fb3d01-56a9-39b2-9ea2-fc93ea792520",
                                        "glosses": [
                                            "A swift and overwhelming attack or effort."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b36be08e-cd63-4104-bdfb-2290239edcc1",
                                                "sense_id": "3d83dbc5-a498-3f97-b7a5-1d0623650470",
                                                "text": "We embarked on a publicity blitz, putting posters and flyers all around town."
                                            },
                                            {
                                                "example_id": "2f8e64d2-3c7d-4c23-8ca1-514643a70d57",
                                                "sense_id": "3d83dbc5-a498-3f97-b7a5-1d0623650470",
                                                "text": "Ultimately, though, Liverpool had inflicted a grievous result in the first leg when they scored three times in a 19-minute blitz and, importantly, did not concede an away goal."
                                            },
                                            {
                                                "example_id": "bb88bf82-49f8-4ce3-bf01-8f9077e61851",
                                                "sense_id": "3d83dbc5-a498-3f97-b7a5-1d0623650470",
                                                "text": "He [Yoshihide Suga] seems to be counting on a media blitz with feel-good effects around the Games to improve his sagging popularity."
                                            },
                                            {
                                                "example_id": "da9953ee-fc61-4c9e-b74e-c4cd76706469",
                                                "sense_id": "3d83dbc5-a498-3f97-b7a5-1d0623650470",
                                                "text": "Liberal activists promised a well-funded summertime blitz, replete with home-state rallies and million-dollar ad campaigns, to try to ramp up pressure on a handful of Senate Democrats opposed to changing the rules."
                                            },
                                            {
                                                "example_id": "f0d9f120-0dfd-4361-a6e4-ad3ae72bc38d",
                                                "sense_id": "3d83dbc5-a498-3f97-b7a5-1d0623650470",
                                                "text": "As well as its revamped search bar, Google unveiled a blitz of other innovations that point to the longer-term evolution of the product."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24f2c2b3-aabe-34c8-b057-83f10dfb79a4",
                                        "entry_id": "68fb3d01-56a9-39b2-9ea2-fc93ea792520",
                                        "glosses": [
                                            "A play in which additional defenders beyond the defensive linemen rush the passer."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7605c3f-86e5-36ac-a04c-0abd1e0f808f",
                                        "entry_id": "68fb3d01-56a9-39b2-9ea2-fc93ea792520",
                                        "glosses": [
                                            "Ellipsis of blitz chess."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65004a6f-42f1-4a75-938a-de6f2b03b1f6",
                                                "sense_id": "e7605c3f-86e5-36ac-a04c-0abd1e0f808f",
                                                "text": "What I had played was chess. Specially, I knocked out some 2,000 games of speed (or \"blitz\") chess in the two months leading up to the tournament. In fact, I played so much that I'm currently in the top half-percent of more than 1.3 million of blitz players at an online chess competition site."
                                            },
                                            {
                                                "example_id": "53856064-94f5-46ec-9dd2-7520415f3509",
                                                "sense_id": "e7605c3f-86e5-36ac-a04c-0abd1e0f808f",
                                                "text": "In order to avoid misunderstanding, I must note that I object to the attempts to displace normal chess with fast play, not rapid or blitz in general. I love them both, and, if I were to choose which to play, classic or rapid, I would choose rapid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e4ddbab-d5a7-3c14-ad4e-62ae82970b07",
                                        "entry_id": "68fb3d01-56a9-39b2-9ea2-fc93ea792520",
                                        "glosses": [
                                            "The act of blending or puréeing food using a blender or processor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "610efe79-efc0-3f1e-a017-ff5df5a9037c",
                                        "entry_id": "68fb3d01-56a9-39b2-9ea2-fc93ea792520",
                                        "glosses": [
                                            "An occurrence in which large numbers of fish, typically striped bass or bluefish, feed on a school of baitfish, typically one in which the occurrence can be seen from the surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blitz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ee371d3-9faa-3e57-9f55-46cfd1579bd0",
                                        "entry_id": "1b0bc3be-ce98-325b-9c35-1e2202d022de",
                                        "glosses": [
                                            "To attack quickly or suddenly, as by an air raid or similar action."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d34b9a5c-dd4f-4eac-a52b-bf25b9773327",
                                                "sense_id": "3ee371d3-9faa-3e57-9f55-46cfd1579bd0",
                                                "text": "So the question remains — what to do with ignorance, which I must presume is deliberate, as in this media-blitzed era it is not possible to be truly ignorant after age 12."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cf4a2bf-40ac-33f0-84f6-9f8cd193174c",
                                        "entry_id": "1b0bc3be-ce98-325b-9c35-1e2202d022de",
                                        "glosses": [
                                            "To perform a blitz."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06ed6032-82aa-4d7b-88a3-7cdac6e1385f",
                                                "sense_id": "0cf4a2bf-40ac-33f0-84f6-9f8cd193174c",
                                                "text": "The Washington High defense almost always blitzes on third down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "723d49b0-1c63-3a08-94c7-17e0b69a3d07",
                                        "entry_id": "1b0bc3be-ce98-325b-9c35-1e2202d022de",
                                        "glosses": [
                                            "To purée or chop (food products) using a food processor or blender."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7279d739-3bd3-4f91-b148-46465e5a0f39",
                                                "sense_id": "723d49b0-1c63-3a08-94c7-17e0b69a3d07",
                                                "text": "To make nut roast, you have to blitz the nuts in the food processor before adding the parsley and breadcrumbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9048e32-ae84-3a61-98d1-8b3c978ec4c2",
                                        "entry_id": "1b0bc3be-ce98-325b-9c35-1e2202d022de",
                                        "glosses": [
                                            "To do something quickly or in one session."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0683ee0f-94b0-4726-9f37-63914511940f",
                        "source_entry_id": "d62322cc-0dba-3251-af3a-1d27f7058597",
                        "source_sense_description": "молниеносная война",
                        "target_lang_word": "Blitzkrieg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blitzkrieg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7eeb850c-72e1-3ac7-9233-e8df31a1cb9b",
                                        "entry_id": "109a7e88-0543-3fc0-ba6f-fc25975f46dd",
                                        "glosses": [
                                            "Kriegsführung, die schnell eine Entscheidung bringen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7beee23-6765-4c63-b75e-9212632004b4",
                                                "sense_id": "7eeb850c-72e1-3ac7-9233-e8df31a1cb9b",
                                                "text": "Der Blitzkrieg an der Westfront war schnell gewonnen."
                                            },
                                            {
                                                "example_id": "c3e819b3-ae8a-40fa-bd81-5af55ae1d3a2",
                                                "sense_id": "7eeb850c-72e1-3ac7-9233-e8df31a1cb9b",
                                                "text": "„Ich aber, ganz elend von dem Transitgeflüster, ich staunte sehr, wenn ich derer gedachte, die in den Flammen der Bombardements und in den rasenden Einschlägen des Blitzkrieges zugrunde gegangen waren, zu Tausenden, zu Hunderttausenden, und viele waren daselbst auch zur Welt gekommen, ganz ohne Kenntnis der Konsuln.“"
                                            },
                                            {
                                                "example_id": "2c12e8a2-827a-4e22-9940-7455f7c2a60a",
                                                "sense_id": "7eeb850c-72e1-3ac7-9233-e8df31a1cb9b",
                                                "text": "„Der Blitzkrieg spukte in den Köpfen, und ich sollte so schnell wie möglich die Seesiege der Kriegsmarine erleben, um sie später als eine Art Hellebarde schildern zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
