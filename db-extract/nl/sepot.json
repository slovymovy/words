                        "glosses": [
                            "besluit van het Openbaar Ministerie om niet strafrechtelijk te vervolgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a9ca9a7-4ca4-4661-af05-1e56c597e425",
                                "sense_id": "88aebb45-d8c6-3d2c-bcdb-bf6414226711",
                                "text": "„De heer Brandt Corstius reageerde op ons persbericht. Hij zegt in zijn reactie hetzelfde als daarvoor”, aldus de woordvoerder. Advocaat Nico Meijering laat weten dat Jelle Brandt Corstius tevreden is over het sepot. „Hij hoopt dat het boek gesloten kan worden.”"
                            },
                            {
                                "example_id": "ec787309-4eb5-442e-b582-8430f099a526",
                                "sense_id": "88aebb45-d8c6-3d2c-bcdb-bf6414226711",
                                "text": "De dossiers over artsen die bij een euthanasie een of meer van de zorgvuldigheidseisen van de Wet toetsing levensbeëindiging niet helemaal volgden, zijn in 2017 en 2018 vrijwel allemaal uitgelopen op een sepot, een besluit om niet te vervolgen. Dat staat in het Jaarverslag 2018 van de Regionale Toetsingscommissie Euthanasie (RTE). Het is donderdag aangeboden aan gezondheidsminister Hugo de Jonge."
                            }
                        ]
                    }
