                "senses": [
                    {
                        "sense_id": "556e5b72-7846-3eea-a6b6-a2042570bcb5",
                        "entry_id": "1b26f584-290c-3221-8181-61ebbbed64b2",
                        "glosses": [
                            "ein Haus, bei dem Torf als Baustoff verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d6dd4b8-bda6-4c1c-934a-0938272d2519",
                                "sense_id": "556e5b72-7846-3eea-a6b6-a2042570bcb5",
                                "text": "„Ihr Torfhaus stand an der halbverwaisten Sudurgata, aber jenseits dieser Gasse wohnten die Wohlhabenden unterhalb von einem Hügel, so daß man bloß die Dächer sehen konnte.“"
                            },
                            {
                                "example_id": "e813635e-5f4b-4da9-a8de-07db28c66e35",
                                "sense_id": "556e5b72-7846-3eea-a6b6-a2042570bcb5",
                                "text": "„Heute sind die Torfhäuser ein Teil des isländischen Kulturgutes.“"
                            },
                            {
                                "example_id": "efe7de78-d009-42e3-b7ad-4eaaf113e38e",
                                "sense_id": "556e5b72-7846-3eea-a6b6-a2042570bcb5",
                                "text": "„Die Torfhäuser auf Island weisen allesamt bewachsene Dächer auf.“"
                            },
                            {
                                "example_id": "ee90d201-f5f8-42af-9bb4-0044e8eb2dde",
                                "sense_id": "556e5b72-7846-3eea-a6b6-a2042570bcb5",
                                "text": "„Der dänisch-amerikanische Architekt und Stadtplaner Alfred Jensen Raavad (1848-1933) plädierte für die Verwendung einheimischer Bauformen der Torfhäuser: dicke, solide Seitenwände und separate Giebeldächer.“"
                            },
                            {
                                "example_id": "e1d2d6ce-159c-4759-991c-cf241ca06d60",
                                "sense_id": "556e5b72-7846-3eea-a6b6-a2042570bcb5",
                                "text": "„In idyllischer Landschaft stehen dort aus ganz Island zusammengetragene historische Torfhäuser sowie zwei Museen, die das frühere Alltagsleben auf der Insel nahe am Polarkreis zeigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
