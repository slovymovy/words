                        "examples": [
                            {
                                "example_id": "36d4dee4-9d52-42ed-8f1a-4f502de22596",
                                "sense_id": "1835a9f8-e3c5-3797-a4f9-1acae5a07be9",
                                "text": "Pensioenfondsen verliezen geld omdat ze de beleggingsrisico's onderschatten. De kwaliteit van het beleggingsbeleid en risicobeheer bij pensioenfondsen is onvoldoende. Dat staat in een brief die de toezichthouder, de Nederlandsche Bank, onlangs naar de pensioenfondsen stuurde."
                            },
                            {
                                "example_id": "fb5545c4-c129-45aa-abb6-5e6abc1e8af7",
                                "sense_id": "1835a9f8-e3c5-3797-a4f9-1acae5a07be9",
                                "text": "De Commissie Risicobeheer en Beleggingsbeleid, zoals de commissie voluit heet, is ingesteld door minister Donner van Sociale Zaken. Frijns brengt aan het einde van de middag verslag aan hem uit."
                            }
                        ]
