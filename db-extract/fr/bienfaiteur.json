                        "cross_references": [
                            {
                                "target_word": "weldoener",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e65f0504-6984-37cb-8299-583a34e873c4",
                                        "entry_id": "6d5a2162-2991-33d8-8ebf-5986d766ddb4",
                                        "glosses": [
                                            "iemand die een goede daad doet door iemand vooral financieël te helpen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4be646d6-0622-4f03-8454-34f3f0e5bdd6",
                                                "sense_id": "e65f0504-6984-37cb-8299-583a34e873c4",
                                                "text": "Zo was de eenvoudige monnik uit Myra, die in de vierde eeuw plotseling in de geschiedenis kwam als de weldoener van alle mensen - en er korte tijd later weer uit verdween - nu in oost en west bekend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0eea9730-2322-42f2-a15a-4b941377f765",
                        "source_entry_id": "c268bd75-d481-39aa-b392-b9f3d36d8efc",
                        "source_sense_id": "e835ae1c-3ade-38d7-83d4-2bdfbf4a9dcc",
                        "target_lang_word": "dobroczyńca",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dobroczyńca",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "a6e91c8a-a4b2-3e66-9599-05f85b5b4c22",
                                        "entry_id": "b079eed1-63ae-3b96-8563-f358ac9b02a7",
                                        "glosses": [
                                            "osoba świadcząca innym dobro, osoba dobroczynna"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fa1f6b0-8dd7-4670-a138-f1ee7f0d0ac9",
                                                "sense_id": "a6e91c8a-a4b2-3e66-9599-05f85b5b4c22",
                                                "text": "Dnia 31 marca 1888 r. zmarł w Turynie we Włoszech siedemdziesięciotrzyletni starzec, ksiądz Jan Bosco, dobroczyńca młodzieży, prawdziwy apostoł i założyciel zakonu św. Franciszka Salezego całkowicie poświęcającego się wychowaniu młodzieży zaniedbanej, osieroconej i opuszczonej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3ca2e0d-772e-4819-9f90-aa2d97e58986",
                        "source_entry_id": "c268bd75-d481-39aa-b392-b9f3d36d8efc",
                        "source_sense_id": "e835ae1c-3ade-38d7-83d4-2bdfbf4a9dcc",
                        "target_lang_word": "благодетель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "благодетель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fec3d955-2169-3f71-ab3b-aaab2008789a",
                                        "entry_id": "944014ee-950b-376a-8d0d-8d9900cb93f4",
                                        "glosses": [
                                            "тот, кто оказывает благодеяния кому-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5cb5b3-b260-4313-bd13-160213641fb8",
                                                "sense_id": "fec3d955-2169-3f71-ab3b-aaab2008789a",
                                                "text": "Дядя мой, господин Сипягин, брат моей матери, призрел меня — я у него на хлебах, он мой благодетель, и Валентина Михайловна моя благодетельница, — а я им плачу чёрной неблагодарностью, потому что у меня, должно быть, сердце чёрствое — и чужой хлеб горек — и я не умею переносить снисходительных оскорблений — и покровительства не терплю… и не умею скрывать — и когда меня беспрестанно колют булавками, я только оттого не кричу, что я очень горда."
                                            },
                                            {
                                                "example_id": "6c728567-524d-4426-88f1-e2dfb7614133",
                                                "sense_id": "fec3d955-2169-3f71-ab3b-aaab2008789a",
                                                "text": "Вот что, говорит, честная вдова, хочу я твоему сыну чтобы истинным благодетелем быть и беспредельные милости ему оказать: беру его отселе к себе, в самый мой дом."
                                            },
                                            {
                                                "example_id": "abd2b88c-7eab-4443-8cb9-a39b3b50970e",
                                                "sense_id": "fec3d955-2169-3f71-ab3b-aaab2008789a",
                                                "text": "Щедр был Алексей Сергеич не по состоянию; но не любил, когда его величали благодетелем. «Какой я вам, сударь, благодетель!. Я себе благо делаю ― а не вам, сударь мой!» (когда он гневался или негодовал, он всегда «выкал»)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
