                        "sense_id": "e735d08b-340c-3a0b-aa09-70868401b077",
                        "entry_id": "86d8e624-d4de-3459-937b-cf2597c7cee1",
                        "glosses": [
                            "Féminin singulier de marmoréen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "975fecfe-894e-4d2e-a3ad-03abc447c531",
                                "sense_id": "e735d08b-340c-3a0b-aa09-70868401b077",
                                "text": "Partout le marbre blanc régnait. De la pierre marmoréenne émanait une douce clarté que les délicates nervures noires qui la parcouraient ne suffisaient pas à affaiblir."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d73845a-196a-3148-944e-9e5704ab4e2a",
                        "entry_id": "86d8e624-d4de-3459-937b-cf2597c7cee1",
                        "glosses": [
                            "Qui a l’apparence du marbre, des statues en marbre."
                        ],
                        "tags": [
                            "figuratively",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "9a8e200e-c2a2-44fa-875b-57ac33b2d146",
                                "sense_id": "1d73845a-196a-3148-944e-9e5704ab4e2a",
                                "text": "La fausse morte fermait les yeux et respirait à peine, mais elle respirait, et cette poitrine marmoréenne, tout à l’heure immobile, se soulevait faiblement au rythme de la vie."
                            }
                        ]
                    }
