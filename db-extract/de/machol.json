                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a726b9c7-3c28-4967-80cf-5d2c14466708",
                                "sense_id": "f7c30991-693c-36be-aba4-f8060b75ab24",
                                "text": "Frau Machol ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9cbf9fea-f329-430b-b7dc-b521d7894cc9",
                                "sense_id": "f7c30991-693c-36be-aba4-f8060b75ab24",
                                "text": "Herr Machol wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6fbc139a-dc8f-4cf8-a247-66388c61cfaf",
                                "sense_id": "f7c30991-693c-36be-aba4-f8060b75ab24",
                                "text": "Die Machols fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f3ba3d8a-5396-4bed-b5d8-730500e5de48",
                                "sense_id": "f7c30991-693c-36be-aba4-f8060b75ab24",
                                "text": "Der Machol trägt nie die Schals, die die Machol ihm strickt."
                            },
                            {
                                "example_id": "fa67fc60-af8f-49f8-b6c7-89233cf54666",
                                "sense_id": "f7c30991-693c-36be-aba4-f8060b75ab24",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Machol kommt, geht der Herr Machol.“"
                            },
                            {
                                "example_id": "a31f7bb2-9c1f-4304-9515-fa888fe163b1",
                                "sense_id": "f7c30991-693c-36be-aba4-f8060b75ab24",
                                "text": "Machol kommt und geht."
                            },
                            {
                                "example_id": "d955acbe-b6b2-48d0-a9c2-cd56272beeae",
                                "sense_id": "f7c30991-693c-36be-aba4-f8060b75ab24",
                                "text": "Machols kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
