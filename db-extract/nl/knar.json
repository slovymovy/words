                "senses": [
                    {
                        "sense_id": "a88e1ad4-ef9c-3db1-b0a1-6ee254c1e5bd",
                        "entry_id": "7c91277f-17b8-3f3c-8e4a-30ed04f56929",
                        "glosses": [
                            "iemand die oud en taai is"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "5dd5c233-7046-4567-8896-cf000030fad6",
                                "sense_id": "a88e1ad4-ef9c-3db1-b0a1-6ee254c1e5bd",
                                "text": "Voor de realitysoap Krasse knarren stopt omroep MAX vijf bekende ouderen in een huis, dat geheel in seventiesstijl is ingericht. Dit met het idee dat ze daar hun jonge zelf hervinden. De vormgeving is een feest voor designfans, de parade van oude bekenden een feest voor de liefhebbers van alles dat was."
                            },
                            {
                                "example_id": "412aac22-83e8-43f5-b63a-022e2457993e",
                                "sense_id": "a88e1ad4-ef9c-3db1-b0a1-6ee254c1e5bd",
                                "text": "A Thief's End steekt evenwel nog altijd met kop en schouders boven veel games in zijn genre uit. Het mag in de collectie van geen enkele gameliefhebber ontbreken. En miljoenen hopen waarschijnlijk stiekem, maar vurig dat Sony, dat de rechten heeft op Uncharted, in de nabije toekomst nog een Indiana Jonesje doet. Als Harrison Ford als krasse knar nog door hoepels springt, moet Nathan Drake dat zeker kunnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "17cdcb78-c4d5-3bee-8215-fd71648c9bd3",
                        "entry_id": "7c91277f-17b8-3f3c-8e4a-30ed04f56929",
                        "glosses": [
                            "botterik, domoor"
                        ],
                        "tags": [
                            "jongerentaal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a0a95060-97e0-353b-869d-f8a2e606226d",
                        "entry_id": "7c91277f-17b8-3f3c-8e4a-30ed04f56929",
                        "glosses": [
                            "kluif waar weinig vlees aan zit"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d2fe8118-ae08-30ee-8c56-a0182c6a196d",
                        "entry_id": "7c91277f-17b8-3f3c-8e4a-30ed04f56929",
                        "glosses": [
                            "bovenste deel van het menselijk lichaam boven de hals, waarin zich de hersenen en oren, ogen en neus bevinden"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "50720f48-4adf-4fce-a001-5fdbb1930563",
                                "sense_id": "d2fe8118-ae08-30ee-8c56-a0182c6a196d",
                                "text": "Ik herinner me die keer dat hij, als een gekooide leeuw in mijn eigen kleine appartement in Amersfoort, een hoed in zijn handen nam die op de hoek van de boekenkast hing, en die sierlijke hoed met geweld op zijn knar duwde, de rand met beide handen omlaag trekkend."
                            }
                        ]
                    }
