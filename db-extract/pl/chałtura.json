                ],
                "senses": [
                    {
                        "sense_id": "670f8543-a500-376c-a8e8-7575f591e1e7",
                        "entry_id": "ae2e782b-23a7-3057-8523-9a358ece56ed",
                        "glosses": [
                            "dodatkowa, łatwa praca (szczególnie z dziedziny kultury, sztuki), ale zazwyczaj mało ambitna, wykonywana jedynie dla szybkiego zarobku, często niedbale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72051700-13ea-4e23-a241-462ba45fc97e",
                                "sense_id": "670f8543-a500-376c-a8e8-7575f591e1e7",
                                "text": "Nie mogę dziś wpaść do ciebie, bo mam chałturę na bankiecie dla jakichś nowobogackich."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2c692c5a-0f06-30c5-82af-d2553cc45593",
                        "entry_id": "ae2e782b-23a7-3057-8523-9a358ece56ed",
                        "glosses": [
                            "efekt, produkt chałtury (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a95e7e72-e124-42d2-a37a-280d4bebd20c",
                                "sense_id": "2c692c5a-0f06-30c5-82af-d2553cc45593",
                                "text": "Przyszedł właściciel galerii obejrzeć moje obrazy, a tu na wierzchu leżą same chałtury."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3ca205d-5f67-4124-ae53-e8821c2a9d0a",
                        "source_entry_id": "ae2e782b-23a7-3057-8523-9a358ece56ed",
                        "source_sense_id": "670f8543-a500-376c-a8e8-7575f591e1e7",
                        "target_lang_word": "petit boulot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petit boulot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6733b6b3-8daa-357d-a7fc-561ff504eb02",
                                        "entry_id": "8ddb39cc-e0b4-35da-8883-241bca50f0c2",
                                        "glosses": [
                                            "Travail temporaire, dont ce n’est pas la spécialité du salarié, et dont le salaire est souvent bas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7abe1d6-4dff-4476-9a8e-dfbc7e15ebf3",
                                                "sense_id": "6733b6b3-8daa-357d-a7fc-561ff504eb02",
                                                "text": "Commerces informels et petits boulots de fortune : voilà le lot d’une large part de la population ghanéenne."
                                            },
                                            {
                                                "example_id": "191b9d96-0c37-49ae-aef6-7390d8dba1dc",
                                                "sense_id": "6733b6b3-8daa-357d-a7fc-561ff504eb02",
                                                "text": "Elle cherche depuis des années un poste de femme de ménage, sans succès. Alors elle enchaîne les petits boulots. Elle s’est improvisée traiteur pour fêtes et mariages – 100 euros en moyenne le couscous pour 200 personnes – avant de renoncer l’an dernier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d70fd52b-4a88-4a95-b21c-ac5dfb57c5c8",
                        "source_entry_id": "ae2e782b-23a7-3057-8523-9a358ece56ed",
