                    {
                        "translation_id": "a2f16b3b-f2c6-4d74-92dd-f6a5105b46ab",
                        "source_entry_id": "54603e75-7f7a-3fd2-8a09-2bd3c6a9b16f",
                        "source_sense_description": "The construction and use of a computer model",
                        "target_lang_word": "modélisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modélisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d8c4f78-7c7b-36f0-a918-a500549a1b4b",
                                        "entry_id": "b8148dce-80d3-341d-ad9c-d71b97aaa5af",
                                        "glosses": [
                                            "Action de modéliser, ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a792bb-d6fc-4a61-ba47-80c916970532",
                                                "sense_id": "7d8c4f78-7c7b-36f0-a918-a500549a1b4b",
                                                "text": "Une dernière classe de modélisations rencontrées dans la littérature est celle qui cherche à rendre compte des phénomènes hystérétiques (à savoir hystérésis et effet Mullins)."
                                            },
                                            {
                                                "example_id": "bad6863a-2d7c-4355-bc89-a5eacf84b7d1",
                                                "sense_id": "7d8c4f78-7c7b-36f0-a918-a500549a1b4b",
                                                "text": "Météo France se base pour ses prévisions sur des modélisations de dispersion du panache de fumée du volcan Eyjafjöll ainsi que sur des observations satellitaires et collabore avec les services météorologiques des pays voisins."
                                            },
                                            {
                                                "example_id": "01c1f2d9-54db-465a-97d1-43d3df48bb92",
                                                "sense_id": "7d8c4f78-7c7b-36f0-a918-a500549a1b4b",
                                                "text": "Si le principe de cette « sismologie stellaire », ou astérosismologie, est simple, sa mise en œuvre est un véritable défi, tant en termes d'observations que de modélisation théorique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fefb8784-5fe3-448b-ba5d-e760143c170f",
