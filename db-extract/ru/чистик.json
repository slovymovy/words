                                                "example_id": "91eb567a-a029-474f-ad47-f6f1cafb7c4a",
                                                "sense_id": "59f3d64f-756f-39e1-8cf8-4515ca441e39",
                                                "text": "There is a scraper as well as a mat, and Mrs. Challenger is most particular."
                                            }
