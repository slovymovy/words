                        "glosses": [
                            "Horloge enregistreuse automatique destinée à constater les heures d’arrivée des pigeons voyageurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1da6a3b5-e0b9-4cd9-9c77-db247a8d039f",
                                "sense_id": "e4d18fcc-10d0-36fa-bfc6-20f47fed9782",
                                "text": "Dès qu’un pigeon rentrait, l’enfant récupérait la bague et se précipitait jusqu’au constateur."
                            },
                            {
                                "example_id": "e9bba09a-74fb-4b86-8255-a76fbace5806",
                                "sense_id": "e4d18fcc-10d0-36fa-bfc6-20f47fed9782",
                                "text": "À l’origine, les constateurs appartenaient aux sociétés colombophiles ou aux colombophiles les plus aisés, mais à partir des années 1920, ils se sont démocratisés et ont été produits en grand nombre."
                            }
