                        "glosses": [
                            "Gemüse, das aus ökologischer Landwirtschaft und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "590e6d96-e498-426e-8498-1cfcdc4de0f8",
                                "sense_id": "810fd3b1-6b76-371b-a116-f7692bdcc614",
                                "text": "„Auf ihrer Farm unweit von New York baut die Schauspielerin Biogemüse an, hält fünf Schafe, zwei Schweine, Bienenvölker, Gänse, Truthähne – und eine ganze Menge Hühner.“"
                            },
                            {
                                "example_id": "2eec342d-c05d-4ec6-8ba9-bfaa50bcf0db",
                                "sense_id": "810fd3b1-6b76-371b-a116-f7692bdcc614",
                                "text": "„Es ist erst mittags, und schon habe ich mühelos eine gute Tat vollbracht: fünf Kilo Biogemüse gerettet!“"
                            }
                        ],
