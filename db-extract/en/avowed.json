                    {
                        "translation_id": "b36b8632-71a8-48e9-b801-791f842423b5",
                        "source_entry_id": "376762c1-a826-3668-bf77-0d54cf6c233d",
                        "source_sense_description": "acknowledged",
                        "target_lang_word": "anerkannt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anerkannt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e12de95d-8a67-3c01-91ec-d5169a49b280",
                                        "entry_id": "39c57699-d65e-36ec-bf4d-549fe77cfe94",
                                        "glosses": [
                                            "in Bezug auf eine oder mehrere Personen: wegen besonderer Fähigkeiten oder besonderer Qualitäten allgemein geschätzt sein, hoch angesehen sein, ein hohes Renommee habend, einen exzellenten Ruf habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe9710a5-4d75-464a-8b71-1e5be6c2e5b4",
                                                "sense_id": "e12de95d-8a67-3c01-91ec-d5169a49b280",
                                                "text": "Wir freuen uns, diesen anerkannten Wissenschaftler als Vortragsredner gewonnen zu haben."
                                            },
                                            {
                                                "example_id": "1684513b-2f06-492c-a53c-fe9b21ee86b9",
                                                "sense_id": "e12de95d-8a67-3c01-91ec-d5169a49b280",
                                                "text": "Er ist der mit Abstand anerkannteste Experte, den ich auf diesem Gebiet kenne."
                                            },
                                            {
                                                "example_id": "2075b870-5437-4399-97a1-9d60b2789f7a",
                                                "sense_id": "e12de95d-8a67-3c01-91ec-d5169a49b280",
                                                "text": "„Binnen weniger Jahre wurde aus dem Büroschreiber eine international anerkannte Koryphäe der Kriminalistik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b225328-71b0-3710-802d-83685e0558af",
                                        "entry_id": "39c57699-d65e-36ec-bf4d-549fe77cfe94",
                                        "glosses": [
                                            "allgemein respektiert in Bezug auf ein von staatlichen Stellen ausgestelltes Zeugnis für einen Schulabschluss / Berufsabschluss oder für eine andere von staatlichen Stellen ausgestellte Bescheinigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77507409-3f66-4c16-812c-a1613098a407",
                                                "sense_id": "4b225328-71b0-3710-802d-83685e0558af",
                                                "text": "Die vom Gericht anerkannte Darstellung des Zeugen führte zum Freispruch des Angeklagten."
                                            },
                                            {
                                                "example_id": "3f502093-dc83-4f56-af10-c6861709bdd0",
                                                "sense_id": "4b225328-71b0-3710-802d-83685e0558af",
                                                "text": "Unser Verein ist als gemeinnützig anerkannt, steuerlich absetzbare Spendengelder können sie auf unser Konto überweisen."
                                            },
                                            {
                                                "example_id": "dbe4edc7-7d3d-411f-a04e-de6263eb79a8",
                                                "sense_id": "4b225328-71b0-3710-802d-83685e0558af",
                                                "text": "Ich weiß nicht, ob das deutsche Abitur in Neuseeland anerkannt ist. Wenn nicht muss ich dort eine Nachprüfung ablegen."
                                            },
                                            {
                                                "example_id": "8639ce3a-884d-4132-8881-74432ed744e6",
                                                "sense_id": "4b225328-71b0-3710-802d-83685e0558af",
                                                "text": "Dies ist eine vom Finanzamt anerkannte Software zur Führung eines Fahrtenbuches."
                                            },
                                            {
                                                "example_id": "072cda1a-9927-43a5-abf9-c19a99968374",
                                                "sense_id": "4b225328-71b0-3710-802d-83685e0558af",
                                                "text": "„Im Januar 1822 bat Naumann um das Bürgerrecht der Freien Stadt Frankfurt, im März 1822 leistete er den Bürgereid und als anerkannter Bürger heiratete er einen Monat später Eleonora Susanna Ochs […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "eaf3e91f-d55a-347e-b31d-3c1b44782ed6",
                                        "entry_id": "39c57699-d65e-36ec-bf4d-549fe77cfe94",
                                        "glosses": [
                                            "in Bezug auf ein Vorgehen oder eine Methode zur Erlangung von Zielen: zu praktisch verwendbaren Ergebnissen führend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3013f4c-ab48-4e0f-b412-718892b89389",
                                                "sense_id": "eaf3e91f-d55a-347e-b31d-3c1b44782ed6",
                                                "text": "„Mit Strahlung können Tumorzellen effektiv zerstört werden. Eine Strahlentherapie ist deshalb ein anerkanntes Verfahren zur Krebsbehandlung.“"
                                            },
                                            {
                                                "example_id": "4bac44ab-d187-41b3-8ba2-45b5d0a7fd81",
                                                "sense_id": "eaf3e91f-d55a-347e-b31d-3c1b44782ed6",
                                                "text": "[Schlagzeile:] „Sekten: Heilssuche abseits anerkannter Pfade“"
                                            },
                                            {
                                                "example_id": "318d98a6-1135-4584-81a1-b3307193bcd4",
                                                "sense_id": "eaf3e91f-d55a-347e-b31d-3c1b44782ed6",
                                                "text": "„Körperpsychotherapie als alleinige Therapiemethode ist jedoch nicht abrechnungsfähig. Der Grund: Körperpsychotherapie ist derzeit kein in der Psychotherapierichtlinie anerkanntes Verfahren (2024).“"
                                            },
                                            {
                                                "example_id": "1e5a3664-82db-40ab-b64a-694a7425de6e",
                                                "sense_id": "eaf3e91f-d55a-347e-b31d-3c1b44782ed6",
                                                "text": "„Eine übliche und auch juristisch anerkannte Methode der Diskriminierungsmessung ist die Residualmethode, auch bekannt als Methode der Komponentenzerlegung.“"
                                            },
                                            {
                                                "example_id": "5bc7a9fa-0c7c-4ffb-94dd-3e6dd6d0eb18",
                                                "sense_id": "eaf3e91f-d55a-347e-b31d-3c1b44782ed6",
                                                "text": "„Die Sinus Markt- und Sozialforschung GmbH (auch: SINUS-Institut) ist ein Markt- und Sozialforschungsinstitut mit Sitz Heidelberg und Berlin. […] In der Milieuforschung hat es mit den Sinus-Milieus eine eigene und auch in wissenschaftlichen Kreisen anerkannte Methode zur Zielgruppenanalyse entwickelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
