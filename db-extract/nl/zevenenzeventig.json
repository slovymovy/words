                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e08fe90-351f-4bd9-87e5-c2d91bd08e7c",
                                "sense_id": "7b6b8064-ef00-327b-bf7d-9654a9decaca",
                                "text": "Het is weer de zevenenzeventig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "a59deb78-7d89-481a-94a4-959e23e00ddb",
                                "sense_id": "7b6b8064-ef00-327b-bf7d-9654a9decaca",
                                "text": "Haar achtenzeventigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zevenenzeventig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fd4a6f3-00fb-35f5-a502-8176474b5090",
                        "entry_id": "e6fd6e94-f35c-377f-ab3c-8baef231b00d",
                        "glosses": [
                            "groep van 77 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "485dfc1c-55c3-4973-bf34-e99cbab8ae91",
                                "sense_id": "8fd4a6f3-00fb-35f5-a502-8176474b5090",
                                "text": "De zevenenzeventig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
