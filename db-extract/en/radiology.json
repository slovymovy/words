                                                "sense_id": "4c403985-d493-39c8-ba53-01f2de1e6a3e",
                                                "text": "La radiologie numérique permet au médecin qui interprète l'examen d'être éloigné du lieu où est effectué ce dernier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7da2012b-cbe3-3548-a92d-23fb31875be2",
                                        "entry_id": "2e9e2a2a-ecc8-34b2-aaf1-f44f824d378e",
                                        "glosses": [
                                            "Actes médicaux réalisés par des médecins radiologues et sous contrôle radiologique (radiologie interventionnelle)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "934edfa5-dd03-4d4e-8998-659d27a7900d",
                                                "sense_id": "7da2012b-cbe3-3548-a92d-23fb31875be2",
                                                "text": "Beaucoup d'autres opérations chirurgicales et interventions guidées par la radiologie ou menées sous endoscopie peuvent être effectuées avec l'aide de l'hypnose."
                                            }
                                        ]
                                    }
                                ]
                            }
