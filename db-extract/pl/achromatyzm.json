                    {
                        "translation_id": "1936f994-16f3-4d9b-80e4-14bcf3fd39f9",
                        "source_entry_id": "c25c5f63-14a1-31f1-96f9-e92c996e3482",
                        "source_sense_id": "6ed5e5f0-f70b-3b9d-94cc-b08894e36bf9",
