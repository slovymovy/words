        "fr-extract.jsonl": [
            {
                "entry_id": "b52371e6-4528-3b6b-ab18-97691b60b97b",
                "word": "hideusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "593a98e3-cabc-3d08-9155-5439e73b93ac",
                        "entry_id": "b52371e6-4528-3b6b-ab18-97691b60b97b",
                        "glosses": [
                            "D’une manière hideuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d89430af-0594-4841-be6f-e11cc522b651",
                                "sense_id": "593a98e3-cabc-3d08-9155-5439e73b93ac",
                                "text": "Ce petit cadavre me poursuivait ; toujours je voyais cette tête hideusement écrasée, le sang giclant sur les étoffes claires de la chambre, et le lit, taché de sang ineffaçablement !…"
                            },
                            {
                                "example_id": "2b016e9e-0200-419d-b794-7f4a92ca84a7",
                                "sense_id": "593a98e3-cabc-3d08-9155-5439e73b93ac",
                                "text": "Aux crins de ses coursiers hideusement traînée."
                            },
                            {
                                "example_id": "e10d9292-365d-45bf-be6e-59830fe1363b",
                                "sense_id": "593a98e3-cabc-3d08-9155-5439e73b93ac",
                                "text": "Et tout ce corps remue et tend sa large croupe\nBelle hideusement d'un ulcère à l'anus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abb30157-0b04-46b6-a65c-1db535400442",
                        "source_entry_id": "b52371e6-4528-3b6b-ab18-97691b60b97b",
                        "source_sense_id": "593a98e3-cabc-3d08-9155-5439e73b93ac",
                        "target_lang_word": "hideously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hideously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0267182-af9f-38d5-8d96-c52f441ea59a",
                                        "entry_id": "11b7dce5-e7a5-3262-a62a-3f35f1ad574c",
                                        "glosses": [
                                            "In a hideous manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c6e793f-f45c-3976-a720-18e612a7e0f0",
                                        "entry_id": "11b7dce5-e7a5-3262-a62a-3f35f1ad574c",
                                        "glosses": [
                                            "To an extreme degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054622e8-1181-419c-a7ee-1efff577fc23",
                                                "sense_id": "7c6e793f-f45c-3976-a720-18e612a7e0f0",
                                                "text": "Speaking now as a condemned criminal might speak ere the drop-bolts are drawn, my story, wild and hideously improbable as it may appear, demands at least attention."
                                            },
                                            {
                                                "example_id": "24044636-990c-4db8-91e2-18e5db063ec3",
                                                "sense_id": "7c6e793f-f45c-3976-a720-18e612a7e0f0",
                                                "text": "Pack a larger-than-normal hypochondria kit that includes sunscreen, plastic bandages and allergy pills. Such things are hard to find or hideously expensive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceda0234-8225-432d-88ce-2c82d93082c4",
                        "source_entry_id": "b52371e6-4528-3b6b-ab18-97691b60b97b",
                        "source_sense_id": "593a98e3-cabc-3d08-9155-5439e73b93ac",
                        "target_lang_word": "awfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "awfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d17a747e-bdeb-39ab-afdf-0e3c5c371cca",
                                        "entry_id": "2c1fc951-9185-3270-a972-aa615ac39e97",
                                        "glosses": [
                                            "Badly, terribly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4ede0c4-1521-4400-a2c2-ceda7472642a",
                                                "sense_id": "d17a747e-bdeb-39ab-afdf-0e3c5c371cca",
                                                "text": "She led after the swimming and cycling, but ran awfully and came in fourth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c34cc5b-4ffd-33c2-994a-c1b38a67cd76",
                                        "entry_id": "2c1fc951-9185-3270-a972-aa615ac39e97",
                                        "glosses": [
                                            "Very; exceedingly; extremely; excessively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5595cc5-c351-4e6f-8d3d-d15d4f859ac5",
                                                "sense_id": "0c34cc5b-4ffd-33c2-994a-c1b38a67cd76",
                                                "text": "It was wondrous. 'I'm awfully glad I came now,' his thought ran; 'I'm managing it rather well.'"
                                            },
                                            {
                                                "example_id": "a03bb0bb-e97d-4593-a3fe-bd19ec653d44",
                                                "sense_id": "0c34cc5b-4ffd-33c2-994a-c1b38a67cd76",
                                                "text": "It’s awfully considerate of you to think of me here / And I’m most obliged to you for making it clear that I’m not here"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d33e704-d9b7-3f92-ad73-3762eb23b975",
                                        "entry_id": "2c1fc951-9185-3270-a972-aa615ac39e97",
                                        "glosses": [
                                            "In a manner inspiring awe."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4e7c298-e44d-38e9-b475-b1593f2ebfa4",
                                        "entry_id": "2c1fc951-9185-3270-a972-aa615ac39e97",
                                        "glosses": [
                                            "Reverently."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7bf4e91-3a2e-3819-a565-b36a0877393f",
                                        "entry_id": "2c1fc951-9185-3270-a972-aa615ac39e97",
                                        "glosses": [
                                            "Fearfully."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25b42f13-5389-4259-a56e-213389ab767c",
                                                "sense_id": "f7bf4e91-3a2e-3819-a565-b36a0877393f",
                                                "text": "I returned to the inn yard, and, impressed by my remembrance of the face, looked awfully around for it. It was not there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
