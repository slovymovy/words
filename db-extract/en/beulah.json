                    {
                        "sense_id": "be41a6f1-74de-370d-9e85-e5099d66b34f",
                        "entry_id": "bc668b93-3b52-3b8b-86e0-d36543c8aa01",
                        "glosses": [
                            "A female given name from Hebrew."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fe30f88-0491-4359-9441-240a84fc6722",
                                "sense_id": "be41a6f1-74de-370d-9e85-e5099d66b34f",
                                "text": "Thou shalt no more be termed Forsaken; neither shall thy land any more be termed Desolate: but thou shalt be called Hephzibah, and thy land Beulah: for the LORD delighteth in thee, and thy land shall be married."
                            },
                            {
                                "example_id": "67f68fbb-1556-44e5-8f3b-34c8d5de489c",
                                "sense_id": "be41a6f1-74de-370d-9e85-e5099d66b34f",
                                "text": "I was into names then for some reason, and hit upon the name Beulah. When I was a child it was a name like Bertha, and you made a joke about Beulah, Big Beulah. I thought, wouldn't it be nice to use the name Beulah and try to get it in a poem."
                            }
                        ]
