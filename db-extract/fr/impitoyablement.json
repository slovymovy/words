        "fr-extract.jsonl": [
            {
                "entry_id": "7538385f-f8d6-3da4-8550-1cd332d3a16c",
                "word": "impitoyablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                        "entry_id": "7538385f-f8d6-3da4-8550-1cd332d3a16c",
                        "glosses": [
                            "D’une manière impitoyable, sans aucune pitié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "919b110d-1e86-418b-b48b-cddbcda0ce83",
                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                "text": "Il replongea dans ses fleurs, sectionnant impitoyablement les boutons qui lui déplaisaient."
                            },
                            {
                                "example_id": "55f763d2-5bcd-4181-beb0-5dd2767633e0",
                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                "text": "Mais cette fois, il n’attendit pas que son adversaire se relevât ; il se jeta sur ses genoux, l’empoigna à la gorge et serra impitoyablement."
                            },
                            {
                                "example_id": "302f81bc-000e-473d-836f-13e20b1bbee6",
                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                "text": "Il accordait à son frère une grande habileté. Selon lui, ce gros garçon endormi ne sommeillait jamais que d’un œil, comme les chats à l’affût devant un trou de souris. Et voilà qu’Eugène passait les soirées entières dans le salon jaune, écoutant religieusement ces grotesques que lui, Aristide, avait si impitoyablement raillés."
                            },
                            {
                                "example_id": "aacdd1ac-3b99-4069-8a87-fa761afe9570",
                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                "text": "Les patrouilles de surveillance qui, d’abord, avaient impitoyablement fusillé les maraudeurs et les pillards, étaient maintenant dispersées par l’épidémie […]"
                            },
                            {
                                "example_id": "9fb44ef2-a5b9-43a6-900d-53a5bcc285ff",
                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                "text": "Le temps avait passé. Dix heures venaient de sonner à la vieille horloge comtoise dont le nombril de verre laissait voir la lentille de cuivre du balancier passer et repasser impitoyablement."
                            },
                            {
                                "example_id": "70d79b54-176f-4ce2-8c87-89c5c1d869e0",
                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                "text": "— Nous serions également coupables parce que nous aurions, de concert, impitoyablement sabré les demandes de crédits formulées par les services du ministère de la Guerre."
                            },
                            {
                                "example_id": "17db7f9a-ec73-4364-a7b0-6527947eb72f",
                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                "text": "— Le balayage est impitoyablement proscrit, les poussières pouvant être mortelles pour les vers à soie."
                            },
                            {
                                "example_id": "82e04f6a-0971-4597-ba7a-c3fbf2b2d058",
                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                "text": "— Le pauvre homme vivotait dans un chaos d’innovations continuelles et acharnées, en un endroit précisément où ces innovations s’effectuaient ostensiblement et impitoyablement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8c8e9c1-16ec-4f67-987b-89b6b4172b13",
                        "source_entry_id": "7538385f-f8d6-3da4-8550-1cd332d3a16c",
                        "source_sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                        "target_lang_word": "pitilessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pitilessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dc6b240-7e59-34d1-93a8-071426af79be",
                                        "entry_id": "3e3925fd-f262-36d2-a7ac-c7b5f57b160e",
                                        "glosses": [
                                            "In a pitiless manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d47aa4-bb47-474b-a923-74bac1c0f9d5",
                                                "sense_id": "5dc6b240-7e59-34d1-93a8-071426af79be",
                                                "text": "The simple questions of the tattered man had been knife thrusts to him. They asserted a society that probes pitilessly at secrets until all is apparent."
                                            },
                                            {
                                                "example_id": "7456c6c1-7c03-4edc-8574-32978c8bf82d",
                                                "sense_id": "5dc6b240-7e59-34d1-93a8-071426af79be",
                                                "text": "They treated the prisoners roughly [...] slashing pitilessly with their whips to drive them as wretched animals before them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9d504fd-13e4-45ae-835a-1caa558adfa4",
                        "source_entry_id": "7538385f-f8d6-3da4-8550-1cd332d3a16c",
                        "source_sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                        "target_lang_word": "ruthlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruthlessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1033a7d9-029e-3cd4-87e7-214604b08057",
                                        "entry_id": "7c70cf4a-fe41-31f7-9072-de24418ed810",
                                        "glosses": [
                                            "In a ruthless manner; with cruelty; without pity or compassion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7a10380-5c97-4409-9920-69c91561b201",
                                                "sense_id": "1033a7d9-029e-3cd4-87e7-214604b08057",
                                                "text": "Standing on the mountain above Caerphilly, one may reflect upon the gap where once stood Llanbradach Viaduct, and look near at hand upon the restored ruins of Caerphilly Castle; man labours to rebuild the mediaeval whilst he ruthlessly scraps the modern."
                                            },
                                            {
                                                "example_id": "81c1f86b-d343-472c-8404-aa957be114a5",
                                                "sense_id": "1033a7d9-029e-3cd4-87e7-214604b08057",
                                                "text": "Southgate's side kept their nerve and discipline in the unsettling, intimidating surroundings of Budapest, with the behaviour of Hungary's fans leaving much to be desired, to turn up the heat and punish their opponents ruthlessly once they had gone ahead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab1b98d1-1cab-4b16-981d-c0d8b576e85f",
                        "source_entry_id": "7538385f-f8d6-3da4-8550-1cd332d3a16c",
                        "source_sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                        "target_lang_word": "mercilessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mercilessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4ff5b6-3abe-3463-bca6-49b69cd72310",
                                        "entry_id": "f53c48f5-6cb5-324a-9348-68c697344310",
                                        "glosses": [
                                            "In a merciless manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86cdad8b-d599-42cc-a4cc-0a12bdd4707c",
                                                "sense_id": "5e4ff5b6-3abe-3463-bca6-49b69cd72310",
                                                "text": "She mercilessly read off the list of his wrongs in front of their friends."
                                            },
                                            {
                                                "example_id": "540e48e1-cddf-4457-a689-e898d412485c",
                                                "sense_id": "5e4ff5b6-3abe-3463-bca6-49b69cd72310",
                                                "text": "Therefore he whacked the old nigger mercilessly, while a big crowd of his people watched him, thunderstruck[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a17814c-6574-49e1-9c1e-ac760ed019a1",
                        "source_entry_id": "7538385f-f8d6-3da4-8550-1cd332d3a16c",
