                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebeda0bb-3eb2-4e90-b393-94d1b299931f",
                                "sense_id": "db6dfa65-715f-38e1-89cb-5ef4525fb6bb",
                                "text": "In 1939 werd het hoogtepunt van die landverhuizing bereikt en woonden er 17.695 Joden, 16 procent van de lokale bevolking, die verder vooral uit kozakken en etnischeRussen bestond."
                            },
                            {
                                "example_id": "a608f1af-16b9-4c6e-99cc-14fefd937837",
                                "sense_id": "db6dfa65-715f-38e1-89cb-5ef4525fb6bb",
                                "text": "De landverhuizing naar Fiji is slechts een van de uitwijkmogelijkheden uit een arsenaal dat Tong hoopt te verzamelen. Hij wees er vrijdag op dat het beoogde perceel driemaal zo groot is als het eiland Tarawa, waar momenteel de meerderheid van Tongs burgers woont."
                            }
                        ]
                    }
