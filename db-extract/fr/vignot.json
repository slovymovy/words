                        "sense_id": "9c44556f-d450-3ea9-a713-37cd680bacb2",
                        "entry_id": "a9df1625-b7aa-3189-8036-937e6c2fa1a3",
                        "glosses": [
                            "Table pour étaler la morue sortant de l'eau."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "11a69271-6057-4e19-915a-9410006eaff8",
                                "sense_id": "9c44556f-d450-3ea9-a713-37cd680bacb2",
                                "text": "L’hirondelle glissait entre des jardins, où l’on apercevait, par une claire-voie, des statues, un vignot, des ifs taillés et une escarpolette."
                            }
                        ]
                    },
                    {
                        "sense_id": "cac61010-22f6-3f5a-a7cb-5430d14bc457",
                        "entry_id": "a9df1625-b7aa-3189-8036-937e6c2fa1a3",
                        "glosses": [
                            "Bigorneau."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "3143ca70-ca2b-44fe-8fd2-8498d6c1de69",
                                "sense_id": "cac61010-22f6-3f5a-a7cb-5430d14bc457",
                                "text": "Dans cette même baignoire apparaissaient beaucoup de coquilles bivalves, telles que huîtres et moules, et univalves, telles que lampottes et vignots, et quelques cailloux roulés de la mer."
                            },
                            {
                                "example_id": "146e4560-64f9-4c5d-b6a2-7ebff8a0ac49",
                                "sense_id": "cac61010-22f6-3f5a-a7cb-5430d14bc457",
                                "text": "Leurs seules parures, colliers de vignots et bracelets de coquillages, ornaient leurs poignets ou leur cou sans dissimuler quoi que ce soit des organes que la pudeur européenne destine à l’obscurité."
                            }
                        ]
                    }
