                "senses": [
                    {
                        "sense_id": "c8ce3a8e-970f-3b83-ae80-ae5236f0e0f6",
                        "entry_id": "c071a686-09c0-326f-9653-c2b1c724293d",
                        "glosses": [
                            "van iets dat je er voordeel van hebt; van iets dat het winstgevend is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61d7e2d8-d8e5-4954-8b04-c614c982c8aa",
                                "sense_id": "c8ce3a8e-970f-3b83-ae80-ae5236f0e0f6",
                                "text": "Een paal in de winkel waar het tegoed van de ov-chipkaart kan worden opgewaardeerd, is voor de winkelier minder profijtelijk dan de strippenkaart. 'Mensen kunnen de kaart ook thuis via internet opladen. Het levert de winkelier ongeveer 55 procent van het aantal transacties van de strippenkaart."
                            },
                            {
                                "example_id": "0e0d458d-acb2-4e91-9e13-5e91d44bb848",
                                "sense_id": "c8ce3a8e-970f-3b83-ae80-ae5236f0e0f6",
                                "text": "Verder zette Aldo van der Laan vol in op merken als Huls (droge worst), Kips (leverworst), Linera (paté) en Zwan (conserven). Die strategie heeft er voor gezorgd, dat het bedrijf de laatste jaren minder private label produceert en meer eigen merken, wat meer profijtelijk is."
                            },
                            {
                                "example_id": "d00245c8-e2f0-4736-bff5-c3d6ad449604",
                                "sense_id": "c8ce3a8e-970f-3b83-ae80-ae5236f0e0f6",
                                "text": "'De staatsrechtelijke relatie tussen Nederland en de Caribische delen van het Koninkrijk is in 2010 veranderd. Sindsdien is er steeds meer aandacht voor samenwerking op economisch terrein. Dat is profijtelijk voor alle partijen. Het draagt ook bij aan de noodzakelijke financiële zelfstandigheid en stabiliteit van de Caribische eilanden', zei koning Willem-Alexander in de Troonrede."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3569ad18-775b-42eb-80d2-ae0943012105",
                        "source_entry_id": "c071a686-09c0-326f-9653-c2b1c724293d",
                        "source_sense_id": "c8ce3a8e-970f-3b83-ae80-ae5236f0e0f6",
                        "target_lang_word": "lucrative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lucrative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "773ec48a-7642-3b89-87ce-2d7ac6b869df",
                                        "entry_id": "7cdd7d0c-9403-31ca-9782-a2cf211857c0",
                                        "glosses": [
                                            "Producing a surplus; profitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed90e74-1781-4c5e-8c8f-4efbb97a5da8",
                                                "sense_id": "773ec48a-7642-3b89-87ce-2d7ac6b869df",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia. The cheapest way to clear logged woodland is to burn it, producing an acrid cloud of foul white smoke that, carried by the wind, can cover hundreds, or even thousands, of square miles."
                                            },
                                            {
                                                "example_id": "b52dcdda-563d-4227-bb9b-2b3bc127b021",
                                                "sense_id": "773ec48a-7642-3b89-87ce-2d7ac6b869df",
                                                "text": "In a given recent year, Celine has earned $40-$50 million from her various endeavors, though the majority of that income was thanks to a lucrative Las Vegas residency deal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2e51d52-4125-37ba-a92e-7e09dab442a8",
                                        "entry_id": "7cdd7d0c-9403-31ca-9782-a2cf211857c0",
                                        "glosses": [
                                            "Of a target: worth attacking; whose destruction is militarily useful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa70b4c5-c9d4-4001-97aa-8d6b58e6a386",
                                                "sense_id": "a2e51d52-4125-37ba-a92e-7e09dab442a8",
                                                "text": "Command and Control centers and headquarters are strategically important and lucrative targets."
                                            },
                                            {
                                                "example_id": "932797c0-7e06-4270-8a0d-1a21e4abf1cc",
                                                "sense_id": "a2e51d52-4125-37ba-a92e-7e09dab442a8",
                                                "text": "Its troops can be widely dispersed as light infantry, using light anti-ship, anti-air and anti-land missiles and weapons to defenda given area or facility without presenting lucrative targets for air, missile, and artillery fire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
