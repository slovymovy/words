                                        "entry_id": "3c4addc1-21ad-34da-8453-04bd2cc6edb7",
                                        "glosses": [
                                            "To devote (oneself) to a given activity, occupation, thing etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
