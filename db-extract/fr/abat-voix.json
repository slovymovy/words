                        "entry_id": "ff1f7734-9d50-3ae7-a158-4f2158010c2d",
                        "glosses": [
                            "Dessus d’une chaire à prêcher, lequel sert à rabattre vers l’auditoire la voix du prédicateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca9c85a0-a322-49a1-8b1d-11d1b94aab3e",
                                "sense_id": "bf5a595e-753c-3add-84cd-2d542dc23ff6",
                                "text": "Cette chaire n’a pas d’abat-voix, aussi on entend mal le prédicateur."
                            },
                            {
                                "example_id": "b61afed3-71b5-41bf-9f08-b0ca23acb52c",
                                "sense_id": "bf5a595e-753c-3add-84cd-2d542dc23ff6",
                                "text": "Un abat-voix complétera avantageusement notre chaire de vérité."
                            }
                        ]
                    }
                ],
