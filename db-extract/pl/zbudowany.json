                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "206f8b9b-0aac-4b70-a292-1d70bffe5f4f",
                                                "sense_id": "84030ac3-246f-3055-bfb4-8828757b82e2",
                                                "text": "He inherited a substantial amount of money from his uncle."
                                            },
                                            {
                                                "example_id": "8508e0fc-81d5-4e0a-8ab3-a2b403c03cd3",
                                                "sense_id": "84030ac3-246f-3055-bfb4-8828757b82e2",
                                                "text": "A substantial number of people went to the event."
