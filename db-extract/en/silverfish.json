                        "target_lang_word": "zilvervisje",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zilvervisje",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "23577843-1023-3db9-9a1a-4af73130d8c0",
                                        "entry_id": "29d4378c-a19b-314b-8453-ae942b9694bb",
                                        "glosses": [
                                            "benaming voor insecten uit de orde Zygentoma"
                                        ],
                                        "tags": [
                                            "insecten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28d28b56-dd3e-4f30-af77-b5425292a905",
                                                "sense_id": "23577843-1023-3db9-9a1a-4af73130d8c0",
                                                "text": "Elke bibliofiel kan t.z.t. rekenen op bezoek van het zilvervisje, het kwikzilveren insect dat zich met een onstilbare honger door bladzijden heenvreet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30746fb9-f864-364f-ae8c-94ef02a2c8ea",
                                        "entry_id": "29d4378c-a19b-314b-8453-ae942b9694bb",
                                        "glosses": [
                                            "benaming voor insecten uit de orde Zygentoma",
                                            "zilvergrijs twee centimeter lang insect, Lepisma saccharina, dat als ongedierte in huis kan voorkomen"
                                        ],
                                        "tags": [
                                            "insecten",
                                            "zilvervisjes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d46fc1b-084d-432f-8038-fe10925d1f05",
                                                "sense_id": "30746fb9-f864-364f-ae8c-94ef02a2c8ea",
                                                "text": "Elke bibliofiel kan t.z.t. rekenen op bezoek van het zilvervisje, het kwikzilveren insect dat zich met een onstilbare honger door bladzijden heenvreet."
                                            },
                                            {
                                                "example_id": "4fd24ea2-ec59-48df-871f-7538eb9ff310",
                                                "sense_id": "30746fb9-f864-364f-ae8c-94ef02a2c8ea",
                                                "text": "Het papiervisje (dat vaak verward wordt met het zilvervisje) komt waarschijnlijk uit droge gebieden zoals steppes of woestijnen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a756f014-45cb-36c9-ab3c-3cc6c01fe8e7",
                                        "entry_id": "29d4378c-a19b-314b-8453-ae942b9694bb",
                                        "glosses": [
                                            "verkleinwoord enkelvoud van het zelfstandig naamwoord zilvervis"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af94ece9-0334-4483-ad7a-508e1cfe617c",
                                                "sense_id": "a756f014-45cb-36c9-ab3c-3cc6c01fe8e7",
                                                "text": "Maandag namiddag liepen de eerste kustvisserijvaartuigen met sprot te Oostende binnen. (…) Hopen wij voor onze kustvissers dat het zilvervisje weldra in overvloed zal worden binnengebracht en dat de prijzen daarom niet door de vloer zullen zakken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
