                    {
                        "translation_id": "96a0c914-588d-4353-8363-d6e117f03bf9",
                        "source_entry_id": "ca4480e3-a773-3d5b-af9d-dad4b5c3a118",
                        "source_sense_id": "fd9b6f99-b965-3dac-bc26-cbeac23dc6d9",
