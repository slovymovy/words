                "senses": [
                    {
                        "sense_id": "27b6f3e0-9a19-3f60-977d-8594a7f30acd",
                        "entry_id": "cbb675f9-cc7f-35d0-8fe9-2dfb813a0fb7",
                        "glosses": [
                            "Donner un caractère immonde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecb024ac-24e6-4d2f-a3b9-5de46f4c9662",
                                "sense_id": "27b6f3e0-9a19-3f60-977d-8594a7f30acd",
                                "text": "Ils vont \"immondiser\" notre belle région de la commune des Baux, pour leur émission fascisante."
                            },
                            {
                                "example_id": "e2261476-6c05-430c-9565-2fc88c0a0b2e",
                                "sense_id": "27b6f3e0-9a19-3f60-977d-8594a7f30acd",
                                "text": "Eux, ils vendent leur mère pour immondiser leur voiture, alors quel besoin ont-il de prendre des poêles ?"
                            },
                            {
                                "example_id": "054a4c99-2dfe-4fd9-a4b6-78c3da37e7cd",
                                "sense_id": "27b6f3e0-9a19-3f60-977d-8594a7f30acd",
                                "text": "Son ami-toyen lui a eu l'autorisation de se vêtir d'une chemise, mais il a fallu immondiser le tout avec un pull made in \"Saupiquet\" histoire de se rapprocher du peuple qui ne vivra jamais en Armani."
                            }
                        ]
                    }
