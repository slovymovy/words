                "senses": [
                    {
                        "sense_id": "99d8b8a8-1d14-3db6-8141-d6a1a58729fc",
                        "entry_id": "4007afd2-fe04-3954-b1ad-87c38dcad465",
                        "glosses": [
                            "An ant."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8fe1696b-d637-3e9f-b751-5b3f964b991d",
                        "entry_id": "4007afd2-fe04-3954-b1ad-87c38dcad465",
                        "glosses": [
                            "An insignificant person."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5ac3f107-b035-45ee-a369-cb6410831ec4",
                                "sense_id": "8fe1696b-d637-3e9f-b751-5b3f964b991d",
                                "text": "It is the beauty of well designed fascism that it gives every piss-ant an ant hill to piss from."
                            },
                            {
                                "example_id": "ff803886-51a3-4a36-872c-4c9a6fc66020",
                                "sense_id": "8fe1696b-d637-3e9f-b751-5b3f964b991d",
                                "text": "“Everyone is saying, ‘You can’t be serious about targeting Iran. Look at Iraq,’” the former intelligence official told me. “But they say, ‘We’ve got some lessons learned—not militarily, but how we did it politically. We’re not going to rely on agency pissants.’ No loose ends, and that’s why the C.I.A. is out of there.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "7b7828b9-adc0-32a1-8f4f-091c1138e106",
                        "entry_id": "4007afd2-fe04-3954-b1ad-87c38dcad465",
                        "glosses": [
                            "A person who adheres strictly to a rule or policy despite current circumstances."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f2be89cc-ab1f-42d8-bde9-8d2668bf96a8",
                                "sense_id": "7b7828b9-adc0-32a1-8f4f-091c1138e106",
                                "text": "Their manager is a real pissant about break times."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b453057-16e0-3eda-a169-b2fe2a24b8f7",
                        "entry_id": "4007afd2-fe04-3954-b1ad-87c38dcad465",
                        "glosses": [
                            "A person seemingly incapable of focusing on anything but the trivial, especially in the sense of trivial or irrelevant criticism."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": []
                    }
