                                    {
                                        "sense_id": "412abebe-c2b8-3a55-abdd-26f35915f16f",
                                        "entry_id": "400a695e-bbe7-3ea5-bd49-5a22730ae9b6",
                                        "glosses": [
                                            "A bird of the extinct species †Ectopistes migratorius, formerly endemic to North America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f77878c0-ecc9-44b8-b42e-0c688a2b697d",
                                                "sense_id": "412abebe-c2b8-3a55-abdd-26f35915f16f",
                                                "text": "Martha was a remnant of a species that had once dominated North America; it is estimated that there were as many as four billion – yes, billion – passenger pigeons when the Europeans arrived."
                                            },
                                            {
                                                "example_id": "e0573e82-7aa2-4860-b689-1e9bdf2b00d1",
                                                "sense_id": "412abebe-c2b8-3a55-abdd-26f35915f16f",
                                                "text": "Revive & Restore, a branch of the Long Now Foundation, is currently attempting to de-extinct the passenger pigeon in a project called The Great Comeback."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
