                            }
                        },
                        {
                            "text": "Hij stond op, pakte zijn jas <w>en</w> liep naar de deur.",
                            "target_lang_translations": {
                                "ru": "Он встал, взял пальто <w>и</w> направился к двери.",
                                "en": "He stood up, grabbed his coat <w>and</w> walked to the door.",
                                "pl": "Wstał, wziął płaszcz <w>i</w> podszedł do drzwi.",
                                "de": "Er stand auf, nahm seinen Mantel <w>und</w> ging zur Tür.",
                                "fr": "Il s'est levé, a pris son manteau <w>et</w> s'est dirigé vers la porte.",
                                "it": "Si alzò, prese il cappotto <w>e</w> andò verso la porta.",
                                "cs": "Vstal, vzal si kabát <w>a</w> šel ke dveřím.",
                                "tr": "Ayağa kalktı, ceketini aldı <w>ve</w> kapıya doğru yürüdü.",
                                "es": "Se levantó, cogió su chaqueta <w>y</w> caminó hacia la puerta."
