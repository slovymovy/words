                        "glosses": [
                            "To cause not to be numb, to relieve of numbness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a820df05-82b3-4569-9cda-801b2fa1a5aa",
                                "sense_id": "81d1ad0b-f8eb-3bc0-aebf-8257af5d19ec",
                                "text": "I was now an invited contributor to art shows in the East. Sympathetic criticisms were unnumbing me; I desired to paint again."
                            },
                            {
                                "example_id": "83d07f7c-75f7-4f68-971d-36906799c6b7",
                                "sense_id": "81d1ad0b-f8eb-3bc0-aebf-8257af5d19ec",
                                "text": "2013, Steve Ercolani, “Baseball League Creates ‘Islands’ of Refuge for Camden Kids,” npr.org, 16 July, 2013,\n“If that had happened in your community, everything [would have] stopped,” he says. “This says two things about these kids: One, they’re resilient, because we’re back to baseball. But two, some part of them is numb. And so we’re going to try and use baseball to unnumb that.”"
                            }
