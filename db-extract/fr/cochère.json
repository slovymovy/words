                    {
                        "sense_id": "b54a54c0-964e-387d-a785-66e2dc1c7fdd",
                        "entry_id": "96cf383d-eba9-3351-9be1-2cbbb769ad29",
                        "glosses": [
                            "Celle qui dirige l’attelage d’une voiture de maître ou d’une voiture publique."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "f1ad8237-d5e6-4e50-a07d-62a8367f608b",
                                "sense_id": "b54a54c0-964e-387d-a785-66e2dc1c7fdd",
                                "text": "Rassurez-vous, lecteur, et vous de même, chère lectrice, ce cocher était une cochère."
                            },
                            {
                                "example_id": "166a2e4b-6f66-44c6-97e0-e96aa4856af0",
                                "sense_id": "b54a54c0-964e-387d-a785-66e2dc1c7fdd",
                                "text": "C’est, depuis un demi-siècle, en effet, une ascension continue : l’avocate, la doctoresse, la cochère, qui indignèrent nos pères ou nous firent sourire, passent inaperçues aujourd’hui."
                            },
                            {
                                "example_id": "fe405ee6-7425-4933-b0d4-cc224761ccc4",
                                "sense_id": "b54a54c0-964e-387d-a785-66e2dc1c7fdd",
                                "text": "L’exemple des premières cochères montre le rôle de la presse qui « dans sa course pour obtenir des exclusivités (…) avait contribué à faire advenir le phénomène qu’elle pensait décrire » (152)."
                            }
                        ]
                    }
