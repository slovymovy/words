                                            {
                                                "example_id": "e01d494a-0dc1-477a-8e9d-c4c5b83df8b5",
                                                "sense_id": "26d1b1f4-597d-32f9-9f45-7edde1cd84a7",
                                                "text": "Originaire d’Ouzbékistan, Anastasia Trevogin a été reconnue apatride en 2008, après plus de dix ans de clandestinité en France."
                                            },
                                            {
                                                "example_id": "2c9870cb-122c-4849-8916-fd25b86823ea",
                                                "sense_id": "26d1b1f4-597d-32f9-9f45-7edde1cd84a7",
                                                "text": "Anastasia se força à sourire à la dérangeuse."
                                            },
                                            {
                                                "example_id": "7c78a568-ea4d-46ba-bbe5-456755b3fd41",
                                                "sense_id": "26d1b1f4-597d-32f9-9f45-7edde1cd84a7",
                                                "text": "Datée de 1915, cette photo d’archives montre le dernier tsar de Russie, Nicolas II (à gauche), son épouse, la tsarine Alexandra Feodorovna (2ᵉ à partir de la droite), le prince Alexis et les princesses Olga, Tatyana, Maria et Anastasia."
                                            }
                                        ]
                                    }
                                ]
                            }
