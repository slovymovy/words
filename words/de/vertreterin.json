                        "gesetzliche Vertreterin"
                    ]
                },
                {
                    "sense_id": "211aee60-1160-36c5-a849-8b75db1b8bbe",
                    "sense_definition": "Weibliche Person, die gewerblich Waren oder Dienstleistungen im Außendienst für ein Unternehmen anbietet und verkauft.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Vertreterin</w> einer Kosmetikfirma stellte den Kundinnen die neuesten Produkte vor."
                        },
                        {
                            "text": "Seit vielen Jahren reist sie als erfolgreiche <w>Vertreterin</w> für einen großen Verlag."
