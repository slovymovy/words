                "senses": [
                    {
                        "sense_id": "6dc10a9d-e69f-306c-9487-5e41051385a9",
                        "entry_id": "1b06f790-839f-39a4-b570-5bc00bbb438c",
                        "glosses": [
                            "Joggen ohne Kleidung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a390b94f-f9e9-4073-a1d8-0053e1ec5d35",
                                "sense_id": "6dc10a9d-e69f-306c-9487-5e41051385a9",
                                "text": "„Genauso viel kostet es beispielsweise, einen Baum als Toilette zu missbrauchen, und auch das ‚Nacktjoggen‘ ist mit 20 Euro im Verwarnungsgeldkatalog aufgelistet.“"
                            },
                            {
                                "example_id": "4f55be9e-366a-46cb-add1-0e6b8ce5c046",
                                "sense_id": "6dc10a9d-e69f-306c-9487-5e41051385a9",
                                "text": "Das Nacktjoggen im städtischen Bereich ist mitunter strafbewehrt."
                            },
                            {
                                "example_id": "b6bc3fa5-4d4b-4f75-83c6-267f3825b863",
                                "sense_id": "6dc10a9d-e69f-306c-9487-5e41051385a9",
                                "text": "„Bloße Nacktheit stellt kein sittenwidriges Verhalten dar. […] Ganz anders sieht es hingegen bei ‚öffentlichem Geschlechtsverkehr‘ oder ‚provokativem Zur-Schau-stellen‘, wie zum Beispiel Nacktjoggen, aus.“"
                            },
                            {
                                "example_id": "2c6fc524-cab2-4f8b-95b7-68e0fb9c2ca6",
                                "sense_id": "6dc10a9d-e69f-306c-9487-5e41051385a9",
                                "text": "„Zumindest glaubt das ein reifer Herr um die 60, der dort nur mit Socken und Schuhen bekleidet umherjoggte, einer des Weges kommenden Dame einen gehörigen Schrecken einjagte und ihr weismachen wollte, dass Nacktjoggen bis 17 Uhr erlaubt sei.“"
                            },
                            {
                                "example_id": "15e5db5a-bfe9-4bd5-85b4-f2a1ba485c2b",
                                "sense_id": "6dc10a9d-e69f-306c-9487-5e41051385a9",
                                "text": "„Und alles nur, weil der Rektor so höhnisch gelacht hatte, als der Rechtsdirektor vom Ordnungsamt sich mit einer ‚Rechtsphilosophischen Fallstudie zum Nacktjoggen‘ um die C-3-Professur beworben hatte.“"
                            },
                            {
                                "example_id": "cdd93886-4ff5-4604-bad3-49111af3a642",
                                "sense_id": "6dc10a9d-e69f-306c-9487-5e41051385a9",
                                "text": "„Im Harz fand in diesem Jahr erstmalig ein ‚Nacktrodelwettbewerb‘ statt, es gibt Nacktjoggen, Nacktreiten und Nacktgärtnern, von Nacktduschen und Nacktschlafen ganz zu schweigen.“"
                            },
                            {
                                "example_id": "ce718e35-fd1b-4f94-8d31-ff35c54fd507",
                                "sense_id": "6dc10a9d-e69f-306c-9487-5e41051385a9",
                                "text": "„Kann man in der Eiseskälte gefahrlos joggen? Ein Tübinger Mediziner beruhigt: Kein Problem, es könne lediglich zu lokalen Erfrierungen kommen - etwa an der Nase, den Ohren und im Genitalbereich. Angesichts dieser Einschätzung sei an dieser Stelle dringend vor dem Nacktjoggen gewarnt.“"
                            },
                            {
                                "example_id": "f9888d4d-6b22-4a79-b6f8-843a6ab71046",
                                "sense_id": "6dc10a9d-e69f-306c-9487-5e41051385a9",
                                "text": "„Doch der Mann wehrte sich: seiner Meinung nach sei Nacktjoggen ein ihm zustehendes Bürgerrecht! Das Oberlandesgericht (OLG) Karlsruhe sah das allerdings anders.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
