                                                "example_id": "5b100571-d9b2-4af3-833d-ab74f0243326",
                                                "sense_id": "fc7530d9-a306-3f34-97f6-d6a3ac112a1e",
                                                "text": "Наслушавшись разных людей, вы, возможно, будете считать, что приучить ребёнка пользоваться горшком — тяжёлый труд."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "223b3234-3e5b-3f1d-a9cc-7cd0697d22ef",
