                                    {
                                        "sense_id": "2f1233b9-2306-3915-8759-c40b25e61e90",
                                        "entry_id": "b4690844-2031-357a-ab39-438d34820a2f",
                                        "glosses": [
                                            "Interaction existant entre deux ou plusieurs gènes pour le contrôle d’un caractère."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2c9186-a42a-4ec8-9aca-d78a6fc8cd68",
                                                "sense_id": "2f1233b9-2306-3915-8759-c40b25e61e90",
                                                "text": "On déduit une épistasie lorsqu’un allèle d’un gène élimine l’expression des allèles des autres gènes et exprime son propre phénotype à la place."
                                            },
                                            {
                                                "example_id": "11fbaa41-6ff8-4d1a-a0cc-52c33189a2e8",
                                                "sense_id": "2f1233b9-2306-3915-8759-c40b25e61e90",
                                                "text": "Elle a ainsi constaté qu’introduire une valine en 111 et une histidine en 122 accroissait de manière inattendue la résistance au glycoside, bien plus que la somme des deux substitutions prises individuellement. Il y avait donc un effet de synergie entre les deux mutations, ce qu’on appelle en génétique de « l’épistasie »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
