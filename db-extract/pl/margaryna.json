                                "target_senses": [
                                    {
                                        "sense_id": "b3b513f7-3b19-31f9-80fc-5f65ae04bcf3",
                                        "entry_id": "bbcc7ed9-db47-3540-8047-a5cc62f3e9a4",
                                        "glosses": [
                                            "пищевой жир, имеющий вид коровьего масла и приготовляемый обычно из говяжьего сала или растительных масел и молока с добавлением яиц"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bd45c04-6df3-4fe9-bbda-4026a343a6d6",
                                                "sense_id": "b3b513f7-3b19-31f9-80fc-5f65ae04bcf3",
                                                "text": "Желая получить побольше барышей и поскорее разбогатеть, стали эти люди всё больше и больше подмешивать разных дешёвых и вредных примесей в свои товары: в муку сыпали отруби и извёстку, в масло пускали маргарин, в молоко — воду и мел."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
