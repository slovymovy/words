            {
                "entry_id": "85efcb81-4ec9-32c1-9a56-80d99053f8f1",
                "word": "kapok",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f1dc3d01-b272-41ea-9e12-323a5a0b91d4",
                        "entry_id": "85efcb81-4ec9-32c1-9a56-80d99053f8f1",
                        "tags": [],
                        "form": "capuk"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6cb496d-d4d7-37bb-bbf4-9426cb284c22",
                        "entry_id": "85efcb81-4ec9-32c1-9a56-80d99053f8f1",
                        "glosses": [
                            "Fibre végétale, très légère, fine et soyeuse, imperméable et imputrescible, constituée des poils recouvrant les graines du kapokier ou fromager."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b143695e-04fe-45a7-92b3-177db937407d",
                                "sense_id": "d6cb496d-d4d7-37bb-bbf4-9426cb284c22",
                                "text": "Le kapok naturel imperméable et gonflant est largement utilisé pour la confection des coussins."
                            },
                            {
                                "example_id": "c2a3fcf4-680e-4c37-a4a1-fdf92af60797",
                                "sense_id": "d6cb496d-d4d7-37bb-bbf4-9426cb284c22",
                                "text": "Lady Diana, à cette minute même exerçait peut-être les artifices de sa séduction entre deux monticules de kapok emmaillotés de velours brodé… Je la devinais, presque nue, sous sa robe rose et blanche…"
                            },
                            {
                                "example_id": "30b3f19d-5669-4385-a860-f35d40922610",
                                "sense_id": "d6cb496d-d4d7-37bb-bbf4-9426cb284c22",
                                "text": "J’avais fait la sottise de prendre une croisière de trois semaines et, au fil des jours, j’ai senti l’accablement, un matelas de kapok qui me tombait sur les épaules."
                            },
                            {
                                "example_id": "dd091f80-c03c-45d7-9760-06cac930e63f",
                                "sense_id": "d6cb496d-d4d7-37bb-bbf4-9426cb284c22",
                                "text": "En lacérant les gilets, les femmes recueillirent le kapok qui se trouvait à l’intérieur. Elle s’en servirent plus tard pour fabriquer des serviettes périodiques."
                            },
                            {
                                "example_id": "4e14ff19-34d1-4074-90c9-4bd15d50678d",
                                "sense_id": "d6cb496d-d4d7-37bb-bbf4-9426cb284c22",
                                "text": "Assis dans un rocking-chair rococo garni d’un coussin à capitons fait d’un kapok trop mou mais qu’un joli cuir à cordon galonnait, il s’offrait pour l’instant un imposant rollmops au vin blanc qu’il noyait dans un grand bocal à cornichons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ade7a0e-4d1c-4d06-8342-0584fd327a26",
                        "source_entry_id": "85efcb81-4ec9-32c1-9a56-80d99053f8f1",
                        "source_sense_id": "d6cb496d-d4d7-37bb-bbf4-9426cb284c22",
                        "target_lang_word": "kapok",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kapok",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66aa6ac3-e714-3624-961a-37186899c7c5",
                                        "entry_id": "279553e5-0730-3f37-99e9-dca96b6ffb72",
                                        "glosses": [
                                            "A silky fibre obtained from seed pods of the silk-cotton tree (Ceiba pentandra) used for insulation and stuffing for mattresses, pillows, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f03482b-ca1a-46d5-8c97-fa3ce86d880f",
                                                "sense_id": "66aa6ac3-e714-3624-961a-37186899c7c5",
                                                "text": "The moon came out of hiding and for a moment Jerry forgot his anxiety as a little grey-clad figure, small and sturdy [...], in a kapok coat and bulging proletarian cap, lowered himself over the side and leapt for the waiting arms of the sampan's crew."
                                            },
                                            {
                                                "example_id": "9f6886ab-90e7-4e16-b9b7-cf512a758eb5",
                                                "sense_id": "66aa6ac3-e714-3624-961a-37186899c7c5",
                                                "text": "You can stuff them full of kapok to make a decent cushion and there is nothing better to carry frogs in."
                                            },
                                            {
                                                "example_id": "0ebafb4f-a7ab-4fb6-b405-b843e782b797",
                                                "sense_id": "66aa6ac3-e714-3624-961a-37186899c7c5",
                                                "text": "A still summer night a world away in a house that smells of cactus and dust and musty kapok."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2d5f23-1e25-3d3b-88bd-4fdcabac2e0e",
                                        "entry_id": "279553e5-0730-3f37-99e9-dca96b6ffb72",
                                        "glosses": [
                                            "A silk-cotton tree (Ceiba pentandra)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10629a4d-7685-333e-80a9-39cb2e1dc8f0",
