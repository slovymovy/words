                "senses": [
                    {
                        "sense_id": "6397c1a8-a13d-390f-a811-8264eccd51cf",
                        "entry_id": "7c6ddbe9-6234-3e41-a510-017075584bfd",
                        "glosses": [
                            "militärischer Angriff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a014a0-ecea-4f95-9c80-8515ba5bbd12",
                                "sense_id": "6397c1a8-a13d-390f-a811-8264eccd51cf",
                                "text": "„Die Schwäche der Kollaborateure wurde offenkundig, als Arminius und Flavus im Jahre 16 bei einem Kriegszug an der Weser einander gegenüberstanden.“"
                            },
                            {
                                "example_id": "b58373e8-d4ec-40b9-b520-7229977c6868",
                                "sense_id": "6397c1a8-a13d-390f-a811-8264eccd51cf",
                                "text": "„Um den Deutschen den Vorwand für einen weiteren Kriegszug zu nehmen, bekennt sich der König um 965 zum Gott der Christen.“"
                            },
                            {
                                "example_id": "f86eb5e8-beb6-4603-aac9-3640ee727c51",
                                "sense_id": "6397c1a8-a13d-390f-a811-8264eccd51cf",
                                "text": "„Insgesamt fordern Bugeauds Kriegszüge wohl mehrere Zehntausend Tote.“"
                            },
                            {
                                "example_id": "96d9faff-16fc-442c-8c03-12211378c71a",
                                "sense_id": "6397c1a8-a13d-390f-a811-8264eccd51cf",
                                "text": "„Sie erzählten von bedeutenden Taten, die jeden Kriegszug begleitet hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
