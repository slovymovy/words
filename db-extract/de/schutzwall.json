                "senses": [
                    {
                        "sense_id": "2e0e682e-aa4e-3e11-94be-d7f9c92a0955",
                        "entry_id": "6d5864cd-5541-321b-8040-b05a12ad9a7e",
                        "glosses": [
                            "Wall, der dem Schutz gegen Angriffe, Lärm oder unerwünschte Beeinträchtigungen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7c59d16-026c-4c11-a10e-7b7dac5cecca",
                                "sense_id": "2e0e682e-aa4e-3e11-94be-d7f9c92a0955",
                                "text": "„Aus Furcht vor einem möglichen Angriff seiner südlichen Nachbarn lässt Harald um 968 das Danewerk ausbauen, mit Palisaden verstärken und an den Schutzwall heranführen, der seit Kurzem Haithabu umgibt.“"
                            },
                            {
                                "example_id": "0464840b-546f-4b82-88f1-c7c7de91ef6e",
                                "sense_id": "2e0e682e-aa4e-3e11-94be-d7f9c92a0955",
                                "text": "„Im Schutzwall ihrer Leiber schlossen sie ihn ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
