                "senses": [
                    {
                        "sense_id": "f0206016-fe09-3453-b780-aedd2068feb1",
                        "entry_id": "ce9d9f48-3195-3c53-8f05-b7c6a581f882",
                        "glosses": [
                            "lackluster or timid; effeminate; without spirit."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "83a8a6ef-10d6-4a5c-91e8-7cde10c14496",
                                "sense_id": "f0206016-fe09-3453-b780-aedd2068feb1",
                                "text": "Placed in a tumultuous community, where obedience and study are deemed \"muffish,\" and reckless mischief passes for \"pluck,\" a high-spirited, impulsive boy needs aid from without to bear up against the temptations which assail him."
                            },
                            {
                                "example_id": "cb0f9631-5194-4e00-89b4-d581ed422bd7",
                                "sense_id": "f0206016-fe09-3453-b780-aedd2068feb1",
                                "text": "I wouldn't be so muffish as to choose anything else."
                            },
                            {
                                "example_id": "4b893bf1-5eaa-495a-89d7-515fc52f89f6",
                                "sense_id": "f0206016-fe09-3453-b780-aedd2068feb1",
                                "text": "Nothing looks so cocktail and muffish on a coach as to see a man learning to catch his whip, and after many futile efforts taking it upside down for this purpose, and twisting the thong round and round with the point downwards, as if he was stirring porridge for a pack of hounds."
                            },
                            {
                                "example_id": "84e8538c-957c-4263-8a0f-7e5ca64f18c0",
                                "sense_id": "f0206016-fe09-3453-b780-aedd2068feb1",
                                "text": "'In my opinion,' he added, recovering himself, 'it's you who are muffish if you can't manage your tricks by yourself. You were always better at that kind of thing than I was.'"
                            },
                            {
                                "example_id": "82d652de-05af-4841-bab9-a06cece1fa4b",
                                "sense_id": "f0206016-fe09-3453-b780-aedd2068feb1",
                                "text": "He might assure his red cheeks and sprouting moustache in the looking-glass that that fellow, St. Denis, had muffish ways, and that girls, especially spirited girls like Peggy, would infinitely prefer a more manly chap."
                            },
                            {
                                "example_id": "29bc13b7-94dd-42d9-b19e-e1bd2babea6b",
                                "sense_id": "f0206016-fe09-3453-b780-aedd2068feb1",
                                "text": "\"Is that what's the matter with you? You look awfully muffish.\""
                            }
                        ]
                    }
                ],
