                "senses": [
                    {
                        "sense_id": "1cc5a51b-0c49-3d51-94c9-de0316cf070a",
                        "entry_id": "d0d06f1e-4fe2-35fd-a8c4-54919bfab693",
                        "glosses": [
                            "winkel waar men luxe, fijne, exclusieve etenswaren verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8b1c04-a581-495c-98ce-1e317579f3ad",
                                "sense_id": "1cc5a51b-0c49-3d51-94c9-de0316cf070a",
                                "text": "Op de tweede en derde plek eindigden respectievelijk traiteur Caulilis in Amsterdam en interieurwinkel Inenom in Zoetermeer. Vorig jaar werd delicatessenzaak Ariola in Groningen verkozen tot leukste winkel van Nederland."
                            },
                            {
                                "example_id": "1be8aa89-4f05-4f65-83fe-5a7c9f4a96dc",
                                "sense_id": "1cc5a51b-0c49-3d51-94c9-de0316cf070a",
                                "text": "Ook Roger Hekelaar, eigenaar van een delicatessenzaak, beaamt dat het veel moeite kostte om zijn zaak te verduurzamen. Het familiebedrijf verkoopt onder meer noten en gedroogde vruchten. Vier keer per week staan zij met een kraam op de markt. \"Ik moest alles zelf uitzoeken en merkte dat er erg weinig kennis bij de overheid is. Daar kregen we dus ook niet veel hulp.\""
                            },
                            {
                                "example_id": "c1270e45-c452-4e84-b0ca-a659973cc414",
                                "sense_id": "1cc5a51b-0c49-3d51-94c9-de0316cf070a",
                                "text": "Naast een aantal lokale ondernemers en de huisarts die nooit zijn weg gegaan, zitten er tegenwoordig onder andere een Lidl, een Jumbo, Kruidvat, maar liefst drie bakkers, een aantal fastfoodzaken en een delicatessenzaak."
                            }
                        ]
                    }
