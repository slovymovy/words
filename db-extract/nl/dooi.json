                        "target_lang_word": "thaw",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thaw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48073b06-9aca-3202-a7db-b811603f823c",
                                        "entry_id": "41d8cc74-5f09-3bcf-8561-392ebf337c3a",
                                        "glosses": [
                                            "To gradually melt, dissolve, or become fluid; to soften from frozen."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61e02f35-6f8f-4f36-bf72-15576d8fd538",
                                                "sense_id": "48073b06-9aca-3202-a7db-b811603f823c",
                                                "text": "the ice thaws"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a4c447f-a810-3eb5-ba5b-0ef34d8ce324",
                                        "entry_id": "41d8cc74-5f09-3bcf-8561-392ebf337c3a",
                                        "glosses": [
                                            "To become sufficiently warm to melt ice and snow, said in reference to the weather."
                                        ],
                                        "tags": [
                                            "impersonal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507b76ba-4ef4-4243-930f-8cb04e5f1180",
                                                "sense_id": "1a4c447f-a810-3eb5-ba5b-0ef34d8ce324",
                                                "text": "It's beginning to thaw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa13c68f-9d5d-3908-83cf-9c5e06b6ec50",
                                        "entry_id": "41d8cc74-5f09-3bcf-8561-392ebf337c3a",
                                        "glosses": [
                                            "To grow gentle or genial."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3302708-76a7-4180-a5cd-c07ec9ff61ae",
                                                "sense_id": "aa13c68f-9d5d-3908-83cf-9c5e06b6ec50",
                                                "text": "Her anger has thawed."
                                            },
                                            {
                                                "example_id": "dd21b9f0-6ac4-40e5-ab8b-c5cb934d9ae1",
                                                "sense_id": "aa13c68f-9d5d-3908-83cf-9c5e06b6ec50",
                                                "text": "The atmosphere at the meeting never really thawed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9f87c08-8d2b-3095-abc8-5f24b6287f29",
                                        "entry_id": "41d8cc74-5f09-3bcf-8561-392ebf337c3a",
                                        "glosses": [
                                            "To gradually cause frozen things (such as earth, snow, ice) to melt, soften, or dissolve."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1f2c6fb-c540-4148-979b-43e61a254262",
                                                "sense_id": "c9f87c08-8d2b-3095-abc8-5f24b6287f29",
                                                "text": "Mor. Miſlike me not for my complexion, / The ſhadowed liuerie of the burniſht ſunne, / To whom I am a neighbour,and neere bred. / Bring me the faireſt creature North-ward borne, / Where Phœbus fire ſcarce thawes the yſicles, / And let vs make inciſion for your loue, / To proue whoſe blood is reddeſt,his or mine."
                                            },
                                            {
                                                "example_id": "bfb4435d-2b63-4023-b828-993bc41252e3",
                                                "sense_id": "c9f87c08-8d2b-3095-abc8-5f24b6287f29",
                                                "text": "The frame of burnish'd steel, that cast a glare / From far, and seemed to thaw the freezing air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thaw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b803631-f239-3e7c-ad8f-eccf92f823dc",
                                        "entry_id": "0ec6e7b4-fb24-39cd-88a0-20ca58e16c11",
                                        "glosses": [
                                            "The melting of ice, snow, or other frozen or congealed matter; the transformation of ice or the like into the state of a fluid; liquefaction by heat of anything congealed by frost"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d227ff6-30f8-3493-88fd-8ec287ad7fc4",
                                        "entry_id": "0ec6e7b4-fb24-39cd-88a0-20ca58e16c11",
                                        "glosses": [
                                            "a period of weather warm enough to melt that which is frozen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e9fe6c6-9975-4c93-959f-17d78258344a",
                                                "sense_id": "5d227ff6-30f8-3493-88fd-8ec287ad7fc4",
                                                "text": "raging floods pursue their hasty thaw; / Our thaw was mild , the cold not chased away"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b2f8c75-67e7-3a3f-ab48-f455abe23704",
                                        "entry_id": "0ec6e7b4-fb24-39cd-88a0-20ca58e16c11",
                                        "glosses": [
                                            "A period of relaxation, of reduced reserve, tension, or hostility or of increased friendliness or understanding."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ca72acd-bb9e-4f67-9c65-3e128a67d390",
                        "source_entry_id": "14a1d16d-b1f1-36dd-86af-72698c59db5e",
                        "source_sense_id": "7775a974-bf59-3c75-9d2a-0255bc454547",
                        "source_sense_description": "smelten",
                        "target_lang_word": "dégel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                        "entry_id": "b0e5b557-16c3-3003-bdb0-3d94ba0e93a3",
                                        "glosses": [
                                            "Fonte naturelle de la glace et de la neige par l’adoucissement de la température, qui remonte au-dessus de zéro degrés Celsius."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb85557f-2bbd-443d-801e-d29b1cf9581c",
                                                "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                                "text": "Nous avons eu de cruels temps, de cruels froids, et je n’en ai pas été seulement enrhumée ; voilà le dégel, je me porte si bien […]"
                                            },
                                            {
                                                "example_id": "7c1d7d35-0761-4ca9-816e-ad00bf63a160",
                                                "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                                "text": "Les vastes plaines subissaient un dégel complet. La nappe blanche s'en allait en eau."
                                            },
                                            {
                                                "example_id": "6a6f2913-9429-4766-855a-c6f0a308ab5d",
                                                "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                                "text": "Les grands floes épais mis en liberté sont usés par la friction, rongés par les mouvements de la mer et par le dégel, ils constituent fréquemment des masses aux formes bizarres et élégantes d'une glace bleue-verdâtre très dure."
                                            },
                                            {
                                                "example_id": "c1a3ff56-8934-44a6-8410-b778d11e404f",
                                                "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                                "text": "Sur la pente des toits exposés au soleil, la neige commença à mollir, puis elle fondit presque aussitôt et un bruit d'eau dégorgeant des chanlates ou ruisselant des tuiles sur la chaussée, annonça le dégel."
                                            },
                                            {
                                                "example_id": "17ca99cd-5846-4683-b384-d510ea693773",
                                                "sense_id": "58e73e58-0e96-33e1-aa44-494b17c63b1e",
                                                "text": "Lors du dégel printanier, cette situation, qui est d'ailleurs commune au Québec (…), favorise la création d’embâcles surtout le long de son cours inférieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f517b3c-e569-3c5e-ba0e-21b6bea357e1",
                                        "entry_id": "b0e5b557-16c3-3003-bdb0-3d94ba0e93a3",
                                        "glosses": [
                                            "Adoucissement de l’air."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "570ba447-2a1c-4a70-9826-72c0fcba3550",
                                                "sense_id": "8f517b3c-e569-3c5e-ba0e-21b6bea357e1",
                                                "text": "L'hiver était rude. Sur les routes que le court dégel de midi amollissait vaguement, la boue se ridait, se hérissait en lilliputiennes murailles et les sillons durcis qui bordaient les ornières ne s'affaissaient point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
