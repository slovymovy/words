                            "target_lang_translations": {
                                "pl": "Przejechali przez <w>Bison</w>, podróżując przez wiejskie obszary Kansas."
                            }
                        },
                        {
                            "text": "The small community of <w>Bison</w> has a very low population.",
                            "target_lang_translations": {
                                "pl": "Niewielka społeczność <w>Bison</w> liczy bardzo niewielu mieszkańców."
                            }
