                        "cross_references": [
                            {
                                "target_word": "Kuřátka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "f8d66867-d3f5-35fd-b66e-de1d0e8ba2a6",
                                        "entry_id": "c5c8e33a-5e3b-3118-81e4-fcd831a5291c",
                                        "glosses": [
                                            "otevřená hvězdokupa v souhvězdí Býka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "829d8288-9dcb-452a-b309-8220bba81fb5",
                                                "sense_id": "f8d66867-d3f5-35fd-b66e-de1d0e8ba2a6",
                                                "text": "Když k vám vesel hledím, zlatá vy Kuřátka,/ slyším naše písně, česká zřím děvčátka."
                                            },
                                            {
                                                "example_id": "0e9595fa-1bd5-44ab-bd84-4f00cc1f936c",
                                                "sense_id": "f8d66867-d3f5-35fd-b66e-de1d0e8ba2a6",
                                                "text": "Hledejte Hospodina, […] / Toho, kterýž učinil Kuřátka i Oriona, kterýž proměňuje stín smrti v jitro, a den v temnosti noční, kterýž přivolává vody mořské, a vylévá je na svrchek země, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f32e13b8-054f-4390-bd58-97092b4c118e",
                        "source_entry_id": "6297620c-194e-3a1c-9361-aff59c727c76",
                        "source_sense_id": "2a33b4d6-702c-3f67-a091-7b12b52aacd1",
                        "target_lang_word": "Pléyades",
