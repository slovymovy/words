                "senses": [
                    {
                        "sense_id": "96746bc8-2d7d-360c-abf9-cdc60ce146f8",
                        "entry_id": "663e0472-54b4-350f-957f-aa42475d6795",
                        "glosses": [
                            "Ort, an dem sich die Menschen treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5078707-3ddd-434e-970f-420526ccff0e",
                                "sense_id": "96746bc8-2d7d-360c-abf9-cdc60ce146f8",
                                "text": "„An ihren Zusammenkunftsorten sucht bei ausbrechendem Kampfe Jeder möglichst viele dieser Gefäße zu ergreifen und schleudert sie dann ungemein weit.“"
                            },
                            {
                                "example_id": "0bfab5d7-46c0-46fe-9eea-6ad654b6a315",
                                "sense_id": "96746bc8-2d7d-360c-abf9-cdc60ce146f8",
                                "text": "„Nachdem kürzlich der Fußboden in der Revierbude - dem ans eigentliche Museum angegliederten Zusammenkunftsort mit Kneipe - mit Holz erneuert wurde, steht jetzt noch ein weiteres schickes Teilchen kurz davor, im Museum ausgestellt werden zu können: eine so genannte Dieselkatze, eine Einschienen-Hängebahn."
                            },
                            {
                                "example_id": "6d56278a-be5e-46ba-b0d0-735cd0c7d384",
                                "sense_id": "96746bc8-2d7d-360c-abf9-cdc60ce146f8",
                                "text": "„1957 wurde das Pfarrheim St. Wolfgang errichtet, als Zusammenkunftsort für Vereine und Jugendliche, für Veranstaltungen wie Hochzeiten, Bälle und vieles mehr gedacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
