                "senses": [
                    {
                        "sense_id": "48bf4bf9-f6f9-384d-84a3-8ec795a08127",
                        "entry_id": "5adf24a2-8c4b-3aed-b382-5d3ceaf13833",
                        "glosses": [
                            "een draagbaar bedoeld om patiënten te vervoeren die niet ambulant zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e34d9e-0cde-4040-abd6-17f36fef12ed",
                                "sense_id": "48bf4bf9-f6f9-384d-84a3-8ec795a08127",
                                "text": "Er kwamen verzorgers het veld op met een brancard om de geblesseerde speler van het veld te dragen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59856ab2-c0ac-434f-a32e-4b2733ab66a2",
                        "source_entry_id": "5adf24a2-8c4b-3aed-b382-5d3ceaf13833",
                        "source_sense_id": "48bf4bf9-f6f9-384d-84a3-8ec795a08127",
                        "source_sense_description": "een draagbaar bedoeld om patiënten te vervoeren die niet ambulant zijn",
                        "target_lang_word": "stretcher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stretcher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fabf2823-496f-3af3-8cff-8062203eb112",
                                        "entry_id": "5fd0ac9b-59a3-365b-be48-b7ff66d27f1f",
                                        "glosses": [
                                            "One who, or that which, stretches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91352e42-4faa-33a7-bac7-f6d53da6cfc3",
                                        "entry_id": "5fd0ac9b-59a3-365b-be48-b7ff66d27f1f",
                                        "glosses": [
                                            "A simple litter designed to carry a sick, injured, or dead person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b34191e0-d6b3-4b9c-a0db-f40b260694c2",
                                                "sense_id": "91352e42-4faa-33a7-bac7-f6d53da6cfc3",
                                                "text": "This done, he sank on to a stretcher, and glanced meditatively about the room."
                                            },
                                            {
                                                "example_id": "4e3facdb-038a-41a3-9076-39aa7281629d",
                                                "sense_id": "91352e42-4faa-33a7-bac7-f6d53da6cfc3",
                                                "text": "After all this has been done, the funeral-procession begins. The stretcher is borne to the burialplace by male persons, even when the deceased is a woman; this work is to be done carefully."
                                            },
                                            {
                                                "example_id": "692ce0b7-e7d4-4660-8e5e-b1fee6c368f6",
                                                "sense_id": "91352e42-4faa-33a7-bac7-f6d53da6cfc3",
                                                "text": "The goal also cost the Blues the services of Luiz, who was injured in attempting to clear and was taken off on a stretcher and replaced by Gary Cahill."
                                            },
                                            {
                                                "example_id": "f2d8d4ec-723a-4244-81d5-f1f04df8c0c3",
                                                "sense_id": "91352e42-4faa-33a7-bac7-f6d53da6cfc3",
                                                "text": "There, characteristically, he refused to be carried on a stretcher, saying he was too heavy for nurses. He walked in with their support."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e20100ff-6af5-3de2-880a-fccb7563010a",
                                        "entry_id": "5fd0ac9b-59a3-365b-be48-b7ff66d27f1f",
                                        "glosses": [
                                            "A frame on which a canvas is stretched for painting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96244676-099d-422f-89ad-2c724f9fb90d",
                                                "sense_id": "e20100ff-6af5-3de2-880a-fccb7563010a",
                                                "text": "A twelve-by-fourteen canvas would not pin in his box, so he had to make a stretcher for it, and very neatly he made it, out of strips of butter-box."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afad17ce-777e-3e66-be2e-20c4d72182ce",
                                        "entry_id": "5fd0ac9b-59a3-365b-be48-b7ff66d27f1f",
                                        "glosses": [
                                            "A device to stretch shoes or gloves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c80b0ad5-b4a8-35b7-8ff1-8badd31dc549",
                                        "entry_id": "5fd0ac9b-59a3-365b-be48-b7ff66d27f1f",
                                        "glosses": [
                                            "A brick laid with the longest (but least tall) side exposed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f674de70-c7da-4772-bda2-ffb27de40d65",
                                                "sense_id": "c80b0ad5-b4a8-35b7-8ff1-8badd31dc549",
                                                "text": "The quoins should be two feet long and one foot broad on the bed, and regularly built, stretcher and header alternately"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a8911cc-4b7d-3e2c-8963-3d60291ab23a",
                                        "entry_id": "5fd0ac9b-59a3-365b-be48-b7ff66d27f1f",
                                        "glosses": [
                                            "A piece of timber used in building."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45e1a428-202e-3b98-b64c-1b4474be90c9",
                                        "entry_id": "5fd0ac9b-59a3-365b-be48-b7ff66d27f1f",
                                        "glosses": [
                                            "A lie; an overstretching of the truth."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa2001b3-1a59-31a7-b719-550d6566c2dd",
                                        "entry_id": "5fd0ac9b-59a3-365b-be48-b7ff66d27f1f",
                                        "glosses": [
                                            "A board against which a rower places his feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e64b7cd-d9a8-4aff-935d-bfb5d1608792",
                                                "sense_id": "aa2001b3-1a59-31a7-b719-550d6566c2dd",
                                                "text": "The jointed stretcher is used in place of the sectional bottom board, with two sideboards, one each side of stretcher. The boat set up this way only weights 20 pounds, and makes a very convenient boat for trout-fishing, duck-hunting, or exploring in ponds or streams where the paddle will do as well as the oars."
                                            },
                                            {
                                                "example_id": "c3432dcd-c0f4-4687-a938-ce27c8d6ed44",
                                                "sense_id": "aa2001b3-1a59-31a7-b719-550d6566c2dd",
                                                "text": "Directly the oar has been disengaged from the water, all pressure on the stretcher ceases, and the strain of the recovery of the body is eased by a slight pull with the feet on the straps of the stretcher."
                                            },
                                            {
                                                "example_id": "5823c166-b9ed-4a93-99fa-0d83ff8324ec",
                                                "sense_id": "aa2001b3-1a59-31a7-b719-550d6566c2dd",
                                                "text": "Betwean each beam of the boat is also fastened a piece of timber called a stretcher or footspur, against which they place their feet when rowing, to enable them to have a more complete command of their oar."
                                            },
                                            {
                                                "example_id": "99b6dcaf-ee7f-4e21-ac04-caa87d95e37d",
                                                "sense_id": "aa2001b3-1a59-31a7-b719-550d6566c2dd",
                                                "text": "Each rower's feet are set in shoes which are secured in the boat in a stretcher (or foot board) set into a fixed position to suit the length of the rower's legs."
                                            },
                                            {
                                                "example_id": "6ed84d36-693c-44b3-b79b-0181d62fff29",
                                                "sense_id": "aa2001b3-1a59-31a7-b719-550d6566c2dd",
                                                "text": "[…] these seem to indicate a thwart, foot-timber (stretcher), thole-pin combination for rowing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ba13a4-ed1e-32c0-9205-3c8a1edd85de",
                                        "entry_id": "5fd0ac9b-59a3-365b-be48-b7ff66d27f1f",
                                        "glosses": [
                                            "One of the rods in an umbrella, attached at one end to one of the ribs, and at the other to the tube sliding upon the handle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57d0cb21-59e3-35d4-aff4-15f48cc1299e",
                                        "entry_id": "5fd0ac9b-59a3-365b-be48-b7ff66d27f1f",
                                        "glosses": [
                                            "A penis, especially a long penis."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1641ed9d-4f61-4276-91be-8943fc5f2248",
                                                "sense_id": "57d0cb21-59e3-35d4-aff4-15f48cc1299e",
                                                "text": "When our mutual trance was a little over, and the young fellow had withdrawn that delicious stretcher, with which he had most plentifully drowned all thoughts of revenge in the sense of actual pleasure, the widen'd wounded passage refunded a stream of pearly liquids, which flowed down my thighs, mixed with streaks of blood",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stretcher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0089a01-79ea-3f34-a396-0e40f90ad833",
                                        "entry_id": "fb337694-c0d8-30b1-a6ba-49170741d7e2",
                                        "glosses": [
                                            "To carry (an injured person) on a stretcher."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a11838af-1c4a-441f-99f3-6181df2f555a",
                                                "sense_id": "d0089a01-79ea-3f34-a396-0e40f90ad833",
                                                "text": "Claire Elise Tisdall, a volunteer nurse working in London, watched as a soldier was strechered past her one night."
                                            },
                                            {
                                                "example_id": "64132122-0854-4037-94d7-4dd073efb720",
                                                "sense_id": "d0089a01-79ea-3f34-a396-0e40f90ad833",
                                                "text": "But with Germany’s Olaf Scholz and France’s Emmanuel Macron facing red cards at home, Spain’s Pedro Sánchez briefly stretchered off[…], Giorgia Meloni – post-fascist poster girl turned star centre-forward of the new right – is shooting at an open goal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c4fae27-a472-46b7-bba4-1abd1521227a",
                        "source_entry_id": "5adf24a2-8c4b-3aed-b382-5d3ceaf13833",
                        "source_sense_id": "48bf4bf9-f6f9-384d-84a3-8ec795a08127",
                        "source_sense_description": "een draagbaar bedoeld om patiënten te vervoeren die niet ambulant zijn",
                        "target_lang_word": "gurney",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gurney",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70ee214c-2020-3280-9a18-fb659f3e604f",
                                        "entry_id": "94ccac21-0eb0-3674-99cf-d3a447a893de",
                                        "glosses": [
                                            "A stretcher having wheeled legs."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f84389b-843d-4fe5-98d6-9f97fe11d0f2",
                                                "sense_id": "70ee214c-2020-3280-9a18-fb659f3e604f",
                                                "text": "The death row convict was strapped into the gurney in order to be given the lethal injection."
                                            },
                                            {
                                                "example_id": "a47f1010-4d25-4a90-8410-84ca8788db02",
                                                "sense_id": "70ee214c-2020-3280-9a18-fb659f3e604f",
                                                "text": "Yet her vision has narrowed strangely (good, for she was in a medical facility, if she were having a hemorrhage or a stroke it could not be happening at a more convenient time) so that she was able to see little in the fluorescent-lit space except the man who lay motionless on a gurney beneath the strongest of the lights."
                                            },
                                            {
                                                "example_id": "e508c65f-dbb4-4e91-b7c4-f5cc08d0a70c",
                                                "sense_id": "70ee214c-2020-3280-9a18-fb659f3e604f",
                                                "text": "I’m pretty sure I didn’t actively steer towards the tree, but… I don’t know. I just remember that wave of despair and then the EMTs pulling me out of the car and putting me on a gurney."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b5b716e-4341-4946-b537-d964ea986980",
                        "source_entry_id": "5adf24a2-8c4b-3aed-b382-5d3ceaf13833",
                        "source_sense_id": "48bf4bf9-f6f9-384d-84a3-8ec795a08127",
                        "source_sense_description": "een draagbaar bedoeld om patiënten te vervoeren die niet ambulant zijn",
                        "target_lang_word": "brancard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brancard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31e25c7f-a8e2-3ce2-8a5c-eca9332201e1",
                                        "entry_id": "6cdc08dc-3efd-356a-bac7-1288b0897d43",
                                        "glosses": [
                                            "Chacune des deux pièces de bois longitudinales sur lesquelles repose la caisse d’une charrette ou de certaines voitures à quatre roues et qui se prolongent en avant pour permettre d’atteler un cheval entre elles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27eabf15-4d53-4d50-86d3-bb8fc385f0d8",
                                                "sense_id": "31e25c7f-a8e2-3ce2-8a5c-eca9332201e1",
                                                "text": "Il avait dû geler fort, la nuit précédente. Les toits des maisons, les brancards des chariots, la paille des fumiers saupoudrés de givre fin miroitaient doucement dans le jour."
                                            },
                                            {
                                                "example_id": "e2c4bf41-e41f-4dc1-875d-d77a714809fa",
                                                "sense_id": "31e25c7f-a8e2-3ce2-8a5c-eca9332201e1",
                                                "text": "Dans les cours, faucheuses, herseuses aux métalliques roues crantées, l’air de mantes religieuses sur la défensive, levaient haut leurs brancards de fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c223c28f-7632-327f-8f5d-dc9b8f3ac06d",
                                        "entry_id": "6cdc08dc-3efd-356a-bac7-1288b0897d43",
                                        "glosses": [
                                            "Deux pièces de bois cintrées qui s’adaptent à l’avant-train d’une voiture à deux roues et entre lesquelles on attelle une bête de somme pour la tirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e2edc3d-4e24-4f81-9f4b-6b4a25b86967",
                                                "sense_id": "c223c28f-7632-327f-8f5d-dc9b8f3ac06d",
                                                "text": "Nous la parcourions au petit trot dans un cabriolet paisible qu'un enfant conduisait, assis dans le brancard."
                                            },
                                            {
                                                "example_id": "7b2ac575-6063-431a-8b12-ad3b3bf10054",
                                                "sense_id": "c223c28f-7632-327f-8f5d-dc9b8f3ac06d",
                                                "text": "— C’est à nous d’aller assez loin pour qu’on ne découvre jamais rien. Et d’ailleurs, c’est un vieux brancard hors d’usage depuis vingt ans, et que j’ai sorti d’une grange abandonnée."
                                            },
                                            {
                                                "example_id": "98d24b13-a83b-4e42-b7d8-5f4e13dd0331",
                                                "sense_id": "c223c28f-7632-327f-8f5d-dc9b8f3ac06d",
                                                "text": "Les hommes de garde causaient derrière un tombereau, qui implorait la nuit de ses deux brancards vides."
                                            },
                                            {
                                                "example_id": "12dd2c04-fafb-4bd4-abaa-8880d6e34ed0",
                                                "sense_id": "c223c28f-7632-327f-8f5d-dc9b8f3ac06d",
                                                "text": "Voilà du cheval solide, bien sûr, mais ce n’est pas le trotteur qu’il fallait dans les brancards d’un cabriolet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b7244d2-0072-36e2-92b5-cd65dc7b5a15",
                                        "entry_id": "6cdc08dc-3efd-356a-bac7-1288b0897d43",
                                        "glosses": [
                                            "Bras entre lesquels se plaçaient les porteurs d’une civière."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda60206-b321-4929-bb11-fd7312922dd9",
                                                "sense_id": "7b7244d2-0072-36e2-92b5-cd65dc7b5a15",
                                                "text": "Derrière eux vient une litière fermée recouverte de maroquin et pourvue, devant et derrière, de brancards entre lesquels marchent des mules richement harnachées."
                                            },
                                            {
                                                "example_id": "bd708944-40e0-47f8-b5d2-30e68759be42",
                                                "sense_id": "7b7244d2-0072-36e2-92b5-cd65dc7b5a15",
                                                "text": "Telcide est encastrée dans les brancards capitonnés d’une statue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edcc38ff-0499-3b6f-b208-75ef2cbf3e38",
                                        "entry_id": "6cdc08dc-3efd-356a-bac7-1288b0897d43",
                                        "glosses": [
                                            "Civière."
                                        ],
                                        "tags": [
                                            "common",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7074cba2-6287-4699-bf95-91227a1cb3af",
                                                "sense_id": "edcc38ff-0499-3b6f-b208-75ef2cbf3e38",
                                                "text": "Lors du brancardage, réalisé après l'installation de la victime sur le brancard par des techniques de relevage adaptées et son arrimage ([…]), le brancard doit être maintenu le plus à l'horizontale possible."
                                            },
                                            {
                                                "example_id": "43ca2701-7c37-4c9d-85e3-81aca1b3a08a",
                                                "sense_id": "edcc38ff-0499-3b6f-b208-75ef2cbf3e38",
                                                "text": "Il est indiqué lorsqu’on ne peut pas accéder à la victime avec un brancard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97b87d97-9eb1-473c-9a2f-74d55785c461",
                        "source_entry_id": "5adf24a2-8c4b-3aed-b382-5d3ceaf13833",
                        "source_sense_id": "48bf4bf9-f6f9-384d-84a3-8ec795a08127",
                        "source_sense_description": "een draagbaar bedoeld om patiënten te vervoeren die niet ambulant zijn",
                        "target_lang_word": "civière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6416db5-0b8a-3c71-9a7b-131e85311245",
                                        "entry_id": "66382c04-d344-3f6c-be51-a9423603e7c5",
                                        "glosses": [
                                            "Dispositif muni de brancards sur lequel on porte à bras des fardeaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2daaf1c6-53ec-4b0f-b8b1-0f488a2f848b",
                                                "sense_id": "c6416db5-0b8a-3c71-9a7b-131e85311245",
                                                "text": "Les séances de nettoyage des étables, la samedi matin, étaient bien dures aussi. C’est avec le Louis que j’effectuais ce travail. Nous avions une grosse civière de chêne que je trouvais déjà lourde sans qu’elle fût chargée. Munis chacun d’un « bigot », nous piquions violemment dans la couche épaisse de fumier chaud et nous entassions sur la civière des « bigochées » monstres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb806dd1-7663-3eac-afb0-daf4387a4fff",
                                        "entry_id": "66382c04-d344-3f6c-be51-a9423603e7c5",
                                        "glosses": [
                                            "Dispositif destiné au portage des malades et blessés."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b365dd03-87d6-4a5b-b5e6-ce72bffc8c9c",
                                                "sense_id": "eb806dd1-7663-3eac-afb0-daf4387a4fff",
                                                "text": "Avait-elle rêvé ce qu'elle racontait d'un homme tombé au bout de la rue la Huchette et emporté sur une civière ?"
                                            },
                                            {
                                                "example_id": "8ea13386-350d-493b-8df0-9fe36c193382",
                                                "sense_id": "eb806dd1-7663-3eac-afb0-daf4387a4fff",
                                                "text": "François marchait près de la civière. On n'apercevait pas Lulu : elle avait le visage couvert d'un drap et la forme de son corps disparaissait sous un amas de couvertures étroitement bordées."
                                            },
                                            {
                                                "example_id": "6bce917a-130a-4402-a436-c55ff2b41460",
                                                "sense_id": "eb806dd1-7663-3eac-afb0-daf4387a4fff",
                                                "text": "Alors que Montpellier menait 4-2, en Ligue 1, face à Clermont, le match a été définitivement arrêté après un jet de pétard qui a explosé tout près du gardien clermontois, Mory Diaw, évacué sur civière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f16763-06aa-3d21-8d22-e0f73d0d521d",
                                        "entry_id": "66382c04-d344-3f6c-be51-a9423603e7c5",
                                        "glosses": [
                                            "Anciennement, noble sans fief, du dernier ordre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
