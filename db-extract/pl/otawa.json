                "senses": [
                    {
                        "sense_id": "925ac8b4-d31d-3ba2-8e6d-232e6e6fb680",
                        "entry_id": "32de1b0b-7bc5-3b93-bf8d-6fea81c96fa6",
                        "glosses": [
                            "trawa odrastająca ponownie po skoszeniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c7b4439-68d4-4d87-a790-d81c47f56149",
                                "sense_id": "925ac8b4-d31d-3ba2-8e6d-232e6e6fb680",
                                "text": "Skręcił z drogi w lewo, przeciął jęzor łąkowej otawy i zanurzył się w cienisty olszniak"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1b3c0b7a-5c6b-341b-8a34-55c4ab7e21ee",
                        "entry_id": "32de1b0b-7bc5-3b93-bf8d-6fea81c96fa6",
                        "glosses": [
                            "drugi pokos, zbiór siana z powtórnie skoszonej trawy"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3024b8ce-9b42-4844-aae7-b7d937dd2646",
                        "source_entry_id": "32de1b0b-7bc5-3b93-bf8d-6fea81c96fa6",
                        "source_sense_id": "925ac8b4-d31d-3ba2-8e6d-232e6e6fb680",
                        "target_lang_word": "otava",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "otava",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "36e9cdb8-56ed-3e3b-918a-2ed2177d27b3",
                                        "entry_id": "7f50b2c4-6886-30a3-a410-831d55c4551b",
                                        "glosses": [
                                            "druhá či pozdější senoseč v určitém roce"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6db60a8-4b1e-4878-a658-4e0f4145fc2f",
                                                "sense_id": "36e9cdb8-56ed-3e3b-918a-2ed2177d27b3",
                                                "text": "Tak minula senoseč, bylo už po žních a sklizená otava voněla už v seníku."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9a36cdd-b589-3ecb-b2fb-a7efba18a8a1",
                                        "entry_id": "7f50b2c4-6886-30a3-a410-831d55c4551b",
                                        "glosses": [
                                            "znovuzískání fyzických či duševních sil"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9dfd535-8360-444c-8351-34e937c85745",
                        "source_entry_id": "32de1b0b-7bc5-3b93-bf8d-6fea81c96fa6",
                        "source_sense_id": "925ac8b4-d31d-3ba2-8e6d-232e6e6fb680",
                        "target_lang_word": "отава",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "отава",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b3a8c920-984d-3bfc-9f03-40d2b3dd5d08",
                                        "entry_id": "afa77201-3e0c-36d3-9a92-ab0436f900f8",
                                        "glosses": [
                                            "с.-х. трава, выросшая на месте скошенной в том же году"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e3c2101-c22c-42a5-a9e2-5ce5c21b54c4",
                                                "sense_id": "b3a8c920-984d-3bfc-9f03-40d2b3dd5d08",
                                                "text": "То в луг иду смотреть траву, … Велю в саду ее косить, … Сбираю добрую отаву // С поречных я моих лужков."
                                            },
                                            {
                                                "example_id": "7ba74c02-7536-4228-9b2f-23e7f63f6d32",
                                                "sense_id": "b3a8c920-984d-3bfc-9f03-40d2b3dd5d08",
                                                "text": "А всё везде было тихо и отрадно, ровная отава в лугах как расчёсанная, застыли, не шевельнутся на бровках сухие былиночки."
                                            },
                                            {
                                                "example_id": "72a45b16-4fad-4e66-a5f7-07f6f1b786a8",
                                                "sense_id": "b3a8c920-984d-3bfc-9f03-40d2b3dd5d08",
                                                "text": "Золотится поздняя отава // Шёлковой ребячьей головой."
                                            },
                                            {
                                                "example_id": "a9269ead-d7a0-4fab-9aa5-be531eef1063",
                                                "sense_id": "b3a8c920-984d-3bfc-9f03-40d2b3dd5d08",
                                                "text": "А дальше, где кончается отава подкошенная, народу тьма!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
