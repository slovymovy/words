                ],
                "senses": [
                    {
                        "sense_id": "c2b42058-3b84-32b3-916a-50b294ae3243",
                        "entry_id": "969c28e1-35ab-35db-bd22-07d0b1aaf259",
                        "glosses": [
                            "Mitglied einer Verbrecherbande"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ca02d77-77b6-4484-84f9-f5183520ccf2",
                                "sense_id": "c2b42058-3b84-32b3-916a-50b294ae3243",
                                "text": "Die Gangster verschiedener Gangs bekriegen sich untereinander."
                            },
                            {
                                "example_id": "0f521ab6-9f92-425e-ae89-c78180411b13",
                                "sense_id": "c2b42058-3b84-32b3-916a-50b294ae3243",
                                "text": "„Sie sammeln monatelang Beweismaterial und überwachen die Gangster.“"
                            },
                            {
                                "example_id": "801efadd-7549-40c8-b3c2-a3bd72fce63a",
                                "sense_id": "c2b42058-3b84-32b3-916a-50b294ae3243",
                                "text": "„Sie hatten sich getrennt wie Gangter nach der Tat.“"
                            },
                            {
                                "example_id": "ec9c8b64-c5c3-4a31-93e5-526e904155b5",
                                "sense_id": "c2b42058-3b84-32b3-916a-50b294ae3243",
                                "text": "In den 1920er Jahren haben in der Wiener Unterwelt viele Gangster ihr Unwesen getrieben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78da2f40-641b-4ba6-9c06-d5708be9d635",
                        "source_entry_id": "969c28e1-35ab-35db-bd22-07d0b1aaf259",
