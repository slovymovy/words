                "senses": [
                    {
                        "sense_id": "305ca638-04e2-3754-9da9-2c66f6f70c61",
                        "entry_id": "472e0ed6-3bd0-3a38-9f30-c160b01f3e3a",
                        "glosses": [
                            "Psychologie / Kriminologie: Die psychologische Tatsache, dass sich Opfer von Schwerstverbrechen (Entführungen, Banküberfälle etc.), die sich in einer als lebensbedrohlich und ausweglos empfundenen Situation befinden, Sympathie für die Täter empfinden und sich mit diesen solidarisieren."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a196455-c2f7-4d5a-818f-62b5e23a7d68",
                                "sense_id": "305ca638-04e2-3754-9da9-2c66f6f70c61",
                                "text": "„Nach Auskunft der Ermittlungsbeamten weist Frau … Anzeichen des „Stockholm-Syndroms“ auf, einer starken Opfer-Täter-Beziehung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "773331ec-fb95-40dc-a282-5d9883649ce3",
                        "source_entry_id": "472e0ed6-3bd0-3a38-9f30-c160b01f3e3a",
                        "source_sense_id": "305ca638-04e2-3754-9da9-2c66f6f70c61",
                        "target_lang_word": "Stockholm syndrome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stockholm syndrome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cade862-f338-3aec-a5bc-95397435c9a0",
                                        "entry_id": "cfce5304-c092-35c8-9f2b-d2f9940cef9d",
                                        "glosses": [
                                            "A psychological condition in which a hostage emotionally bonds to their captor."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3435a7e2-16ad-4764-8680-bd6b49320e0a",
                                                "sense_id": "5cade862-f338-3aec-a5bc-95397435c9a0",
                                                "text": "You're suffering from what humans call Stockholm Syndrome: you have bonded with your captors."
                                            },
                                            {
                                                "example_id": "83179416-7efc-4604-80b3-7fc36dd5353c",
                                                "sense_id": "5cade862-f338-3aec-a5bc-95397435c9a0",
                                                "text": "Natascha Kampusch, the 18 year old Austrian woman who escaped from her kidnapper last week after eight years in captivity,[…] is thought to be suffering from an extreme version of Stockholm syndrome, in which victims begin to associate and sympathise with their attackers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Stockholm syndrome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "316baf98-f20b-34c1-beb3-34baefb9627e",
                                        "entry_id": "5a22cee1-53f8-345c-beaf-ea3c754a84d5",
                                        "glosses": [
                                            "To cause someone to become affected by Stockholm syndrome."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5535531-9279-447e-b20a-a1fb89b73e78",
                                                "sense_id": "316baf98-f20b-34c1-beb3-34baefb9627e",
                                                "text": "The girls, it turns out, found the experience oddly positive, and not because they were brainwashed or Stockholm syndromed."
                                            },
                                            {
                                                "example_id": "e96182a0-eea5-403d-a966-92dff41d7aa4",
                                                "sense_id": "316baf98-f20b-34c1-beb3-34baefb9627e",
                                                "text": "Eventually, you Stockholm Syndromed yourself into believing that what happened to the Bills mattered to your life. Off the top of my head, I can still list more members of the 1990-93 Super Bowl-averse Bills than kids in my Grade 8 class."
                                            },
                                            {
                                                "example_id": "ebe1fa9e-a0af-45e1-acec-95e3dd3d33af",
                                                "sense_id": "316baf98-f20b-34c1-beb3-34baefb9627e",
                                                "text": "Britannia's is the best because they understand that a bunny is as much a feat of engineering as cooking. The quarter loaf of bread must, must be of the generic, mass-produced sort (not a farmhouse loaf, definitely not a milk bread, just standard unsliced white), with the light crust a dam wall holding in a reservoir of rich mutton curry that's Stockholm-syndroming massive potato halves, the sauce riveted with cloves and singing to the tune of ginger and curry leaves, the whole edible edifice capped with a dome built of the belly of the bread."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e754aa7-9ca0-4e1c-ae01-695a5c2a587f",
                        "source_entry_id": "472e0ed6-3bd0-3a38-9f30-c160b01f3e3a",
                        "source_sense_id": "305ca638-04e2-3754-9da9-2c66f6f70c61",
                        "target_lang_word": "syndrome de Stockholm",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syndrome de Stockholm",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ea54b28-f759-3910-933d-969bba993f86",
                                        "entry_id": "32f5691a-7a27-3191-a437-dd863443a199",
                                        "glosses": [
                                            "Propension paradoxale, souvent observée chez les victimes de prise d’otage, à développer un sentiment d’empathie ou même de sympathie, voire à prendre fait et cause pour leurs ravisseurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b4e16b-2bd5-4ee1-81a6-39a6c99a090d",
                                                "sense_id": "3ea54b28-f759-3910-933d-969bba993f86",
                                                "text": "En ce sens, le syndrome de Stockholm est une situation paradoxale en elle-même, puisque la victime va ressentir des sentiments envers son « bourreau » : sympathie, affection, compréhension, voire même amour."
                                            },
                                            {
                                                "example_id": "bfac837b-19b8-43a3-8e83-35dc75650617",
                                                "sense_id": "3ea54b28-f759-3910-933d-969bba993f86",
                                                "text": "On m’accusera d’être frappé du syndrome de Stockholm et d’exagérément sympathiser avec mes « ravisseurs », mais des centaines de millions de personnes sur la planète tout autant que les Américains eux-mêmes ont besoin d’une Maison-Blanche active, volontaire, dynamique et souriante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3929116-8b44-416c-b752-24f1f4f22c98",
                        "source_entry_id": "472e0ed6-3bd0-3a38-9f30-c160b01f3e3a",
                        "source_sense_id": "305ca638-04e2-3754-9da9-2c66f6f70c61",
                        "target_lang_word": "стокгольмский синдром",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стокгольмский синдром",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6c2165c7-0c6f-3be7-8774-2e22f6abed48",
                                        "entry_id": "625fad7a-3a73-3fd2-9f0b-2249f77dfb2a",
                                        "glosses": [
                                            "психол. термин, описывающий защитно-бессознательную травматическую связь, взаимную или одностороннюю симпатию, возникающую между жертвой и агрессором в процессе захвата, похищения и/или применения угрозы или насилия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "263a25f1-001f-491b-978b-1025c12cb1ab",
                                                "sense_id": "6c2165c7-0c6f-3be7-8774-2e22f6abed48",
                                                "text": "Исследователи полагают, что стокгольмский синдром является не психологическим парадоксом, не расстройством или синдромом, а скорее нормальной реакцией человека на сильно травмирующее психику событие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
