    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d21ac45-1fd4-3a65-8be4-120401ca8079",
                    "sense_definition": "A very long period of time, often used hyperbolically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It feels like <w>eons</w> since we last spoke to one another."
                        },
                        {
                            "text": "The students waited for <w>eons</w> outside the locked classroom."
                        }
                    ],
                    "synonyms": [
                        "aeon",
                        "ages",
                        "eternity",
                        "forever",
                        "years",
                        "yonks"
                    ],
                    "antonyms": [
                        "moment",
                        "jiffy"
                    ],
                    "common_phrases": [
                        "for eons",
                        "eons ago"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "frequently used hyperbolically in everyday speech"
                        }
                    ]
                },
                {
                    "sense_id": "891a263c-6f60-3fcc-92ce-839ff1ae3caa",
                    "sense_definition": "The largest formal unit of geological time, spanning hundreds of millions or billions of years and divided into eras.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Earth formed during the Hadean <w>eon</w> over four billion years ago."
                        },
                        {
                            "text": "Geologists divide the history of our planet into several distinct <w>eons</w>."
                        }
                    ],
                    "synonyms": [
                        "aeon"
                    ],
                    "common_phrases": [
                        "geological eon"
                    ]
                },
                {
                    "sense_id": "bdc79a66-105e-3e1f-b7e4-a3dfbbb85b90",
                    "sense_definition": "A unit of time equal to one billion years.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cosmologists often use an <w>eon</w> to define a timespan of one billion years."
                        },
                        {
                            "text": "The star has remained relatively stable over the course of an entire <w>eon</w>."
                        }
                    ],
                    "synonyms": [
                        "aeon"
                    ]
                },
                {
                    "sense_id": "da89b30a-4ffb-30f7-b186-d84434aedc20",
                    "sense_definition": "An immeasurably or indefinitely long period of time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mountains slowly crumble into dust across an <w>eon</w> of natural erosion."
                        },
                        {
                            "text": "Ancient myths describe the universe enduring across an endless <w>eon</w>."
                        }
                    ],
                    "synonyms": [
                        "aeon",
                        "age",
                        "eternity"
                    ]
                },
                {
                    "sense_id": "d041b770-b5b4-351f-bf06-87311a469b93",
                    "sense_definition": "Eternity; the entire duration of the universe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers have long pondered the nature of time throughout the entire <w>eon</w>."
                        },
                        {
                            "text": "Matter and energy will interact continuously across the cosmic <w>eon</w>."
                        }
                    ],
                    "synonyms": [
                        "aeon",
                        "eternity"
                    ]
                },
                {
                    "sense_id": "a185c99d-c843-3284-aaf1-3741fe2851f4",
                    "sense_definition": "In Gnosticism, a divine power or spirit being emanating from the Supreme Being.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "According to Gnostic theology, each spiritual <w>eon</w> emanates directly from the divine source."
                        },
                        {
                            "text": "Sophia was regarded as the final divine <w>eon</w> within that philosophical system."
                        }
                    ],
                    "synonyms": [
                        "aeon"
                    ]
                }
            ]
        },
        {
