                        "source_entry_id": "201e3cb0-a7fc-396e-9841-8acb105e74fa",
                        "source_sense_id": "1c7367e3-b4af-3a54-b933-84fca6cdf4ac",
                        "source_sense_description": "in der Landwirtschaft eingesetzte Maschine",
                        "target_lang_word": "machine agricole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machine agricole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b2c6d84-38b4-33b1-94ea-57baf78dd623",
                                        "entry_id": "5eae4af2-7ed6-3434-a95a-06178d3343a8",
                                        "glosses": [
                                            "Engin mécanique destiné à assister le travail humain dans l’agriculture, y compris les tracteurs substitués aux animaux de trait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d62b71-3983-4f5c-afa6-6d9969996d21",
                                                "sense_id": "4b2c6d84-38b4-33b1-94ea-57baf78dd623",
                                                "text": "Mr. Marshall, non-seulement attribue l’origine de ce moulin à battre, aux Écossais, mais il ajoute que c’est la machine agricole la plus utile qui ait été inventée ; …"
                                            },
                                            {
                                                "example_id": "511f294b-881e-470d-a5e0-a8114fc64aeb",
                                                "sense_id": "4b2c6d84-38b4-33b1-94ea-57baf78dd623",
                                                "text": "Son cahier des charges dit qu’il doit être à la fois tracteur et fourgon, disposer des prises de force pour entraîner tous types de machines agricoles, et être aussi rapide sur route qu’une voiture."
                                            },
                                            {
                                                "example_id": "149289ca-ba77-4756-88cc-b607273de40d",
                                                "sense_id": "4b2c6d84-38b4-33b1-94ea-57baf78dd623",
                                                "text": "Pierre Foulon, ingénieur diplômé en Arts et métiers a conçu une machine agricole révolutionnaire, l’arracheuse-écapsuleuse de lin, appelée la Kronox."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
