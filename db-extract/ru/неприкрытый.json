                "translations": [
                    {
                        "translation_id": "59979dc6-3165-4138-8449-090ae6a77a31",
                        "source_entry_id": "6f3a75b0-aa20-3c37-929f-9140f0822a38",
                        "source_sense_id": "660d00b3-a371-3469-bbfa-075978ca5151",
                        "target_lang_word": "non dissimulé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4e2c1bee-274c-4057-91be-17febdff652d",
                        "source_entry_id": "6f3a75b0-aa20-3c37-929f-9140f0822a38",
                        "source_sense_id": "660d00b3-a371-3469-bbfa-075978ca5151",
                        "target_lang_word": "manifeste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manifeste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c00c6e2-ca1f-3193-bf5b-db5f70a9e55c",
                                        "entry_id": "46103062-abd3-32ca-a67f-8a7e7e35d498",
                                        "glosses": [
                                            "Qui peut en quelque sorte être touché par la main, qu’on prend sur le fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b74ed6f-1dd0-4977-981b-747dea20ebdb",
                                                "sense_id": "0c00c6e2-ca1f-3193-bf5b-db5f70a9e55c",
                                                "text": "C’est un faussaire, un plagiaire manifeste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7d7a419-fab9-3179-a63e-ee4d2d26e11b",
                                        "entry_id": "46103062-abd3-32ca-a67f-8a7e7e35d498",
                                        "glosses": [
                                            "Notoire ; évident pour tout le monde."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9db152da-0979-4ac7-a8f1-ac436c6d4652",
                                                "sense_id": "a7d7a419-fab9-3179-a63e-ee4d2d26e11b",
                                                "text": "Après la défaite de Kœniggraetz […], François-Joseph reçut du Saint-Esprit l'ordre d'appeler au pouvoir, […], un ministre saxon. L’inspiration céleste est ici manifeste, parce que le choix de l'Empereur ne saurait évidemment s'expliquer par aucune raison humaine."
                                            },
                                            {
                                                "example_id": "88f48897-b627-4fa2-8989-7c6ded76f895",
                                                "sense_id": "a7d7a419-fab9-3179-a63e-ee4d2d26e11b",
                                                "text": "Ce patchwork est encore plus manifeste dans les mégapoles, l’archétype étant New York avec ses communautés irlandaise, italienne, chinoise…, leurs quartiers et leurs festivités."
                                            }
                                        ]
                                    }
                                ]
