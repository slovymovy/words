{
    "word_family": [
        "suit",
        "suitable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83dac2ac-d90c-3207-b00d-e9cec04ab763",
                    "sense_definition": "A man who pursues a relationship with a woman, usually with a view to marriage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He proved to be a persistent <w>suitor</w> who sent flowers every day.",
                            "target_lang_translations": {
                                "ru": "Он оказался настойчивым <w>поклонником</w>, который каждый день присылал цветы."
                            }
                        },
                        {
                            "text": "The young princess rejected every prospective <w>suitor</w> who came to the castle.",
                            "target_lang_translations": {
                                "ru": "Молодая принцесса отвергала каждого потенциального <w>жениха</w>, приезжавшего в замок."
                            }
                        }
                    ],
                    "synonyms": [
                        "wooer",
                        "courter",
                        "admirer"
                    ],
                    "common_phrases": [
                        "prospective suitor",
                        "wealthy suitor",
                        "rejected suitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, который ухаживает за женщиной, обычно с намерением жениться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жених",
                                "target_lang_sense_clarification": "потенциальный муж или сватающийся мужчина"
                            },
                            {
                                "target_lang_word": "поклонник",
                                "target_lang_sense_clarification": "мужчина, ухаживающий за женщиной"
                            },
                            {
                                "target_lang_word": "ухажёр",
                                "target_lang_sense_clarification": "разговорное; человек, оказывающий знаки внимания"
                            },
                            {
                                "target_lang_word": "кавалер",
                                "target_lang_sense_clarification": "поклонник или спутник дамы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546e2a88-a85f-3e0c-b969-6bca69dd0063",
                    "sense_definition": "A company or person showing interest in acquiring or partnering with another business.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several corporate <w>suitors</w> have made offers to buy the struggling firm.",
                            "target_lang_translations": {
                                "ru": "Несколько корпоративных <w>претендентов на покупку</w> сделали предложения о приобретении терпящей бедствие фирмы."
                            }
                        },
                        {
                            "text": "The tech startup rejected a takeover bid from a potential <w>suitor</w>.",
                            "target_lang_translations": {
                                "ru": "Технологический стартап отклонил предложение о поглощении от потенциального <w>покупателя</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "potential suitor",
                        "corporate suitor",
                        "takeover suitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компания или лицо, заинтересованное в поглощении, покупке или партнерстве с другим бизнесом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "претендент на покупку",
                                "target_lang_sense_clarification": "о компании или инвесторе"
                            },
                            {
                                "target_lang_word": "потенциальный покупатель",
                                "target_lang_sense_clarification": "в бизнесе"
                            },
                            {
                                "target_lang_word": "инвестор",
                                "target_lang_sense_clarification": "заинтересованная сторона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2e5448d-d0e6-3b0e-b322-beae8736754f",
                    "sense_definition": "A party involved in a lawsuit; a litigant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court listened to arguments presented by the persistent <w>suitor</w>.",
                            "target_lang_translations": {
                                "ru": "Суд выслушал доводы, представленные настойчивым <w>истцом</w>."
                            }
                        },
                        {
                            "text": "As a legal <w>suitor</w>, she sought compensation for the damages.",
                            "target_lang_translations": {
                                "ru": "Как <w>истец</w>, она требовала возмещения причиненного ущерба."
                            }
                        }
                    ],
                    "synonyms": [
                        "litigant",
                        "plaintiff",
                        "claimant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сторона судебного процесса; тяжущийся или истец."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истец",
                                "target_lang_sense_clarification": "юридическая сторона, подающая иск"
                            },
                            {
                                "target_lang_word": "тяжущийся",
                                "target_lang_sense_clarification": "участник судебного разбирательства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19904872-cb01-37db-94fd-06feba9a9f9c",
                    "sense_definition": "A person who petitions or formally requests something from an authority.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king received each <w>suitor</w> seeking mercy in his grand hall.",
                            "target_lang_translations": {
                                "ru": "В своем парадном зале король принимал каждого <w>просителя</w>, молившего о милости."
                            }
                        },
                        {
                            "text": "A humble <w>suitor</w> brought a petition directly to the council.",
                            "target_lang_translations": {
                                "ru": "Скромный <w>проситель</w> подал петицию прямо совету."
                            }
                        }
                    ],
                    "synonyms": [
                        "petitioner",
                        "applicant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обращающийся с официальным прошением или ходатайством к властям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проситель",
                                "target_lang_sense_clarification": "подающий прошение"
                            },
                            {
                                "target_lang_word": "челобитчик",
                                "target_lang_sense_clarification": "историческое"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3633516a-133b-389f-b62c-daeaadf65433",
                    "sense_definition": "To court or woo someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire summer <w>suitoring</w> his future wife.",
                            "target_lang_translations": {
                                "ru": "Он провел все лето, <w>ухаживая за</w> своей будущей женой."
                            }
                        },
                        {
                            "text": "In classical tales, knights were frequently depicted as <w>suitoring</w> noblewomen.",
                            "target_lang_translations": {
                                "ru": "В классических сказках рыцари часто изображались <w>добивающимися руки</w> знатных дам."
                            }
                        }
                    ],
                    "synonyms": [
                        "court",
                        "woo",
                        "romance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ухаживать за кем-либо, добиваться расположения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухаживать",
                                "target_lang_sense_clarification": "оказывать знаки внимания"
                            },
                            {
                                "target_lang_word": "свататься",
                                "target_lang_sense_clarification": "добиваться согласия на брак"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}