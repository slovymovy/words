                ],
                "senses": [
                    {
                        "sense_id": "6a970d82-4126-398b-b4b4-060760e4be0f",
                        "entry_id": "e1630531-6353-3952-86ff-6960f12b7239",
                        "glosses": [
                            "Kleinigkeit, Nichtigkeit, Bagatelle"
                        ],
                        "tags": [
                            "gehoben",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "9a1d98f3-c524-43da-b381-8eeff2a3d49e",
                                "sense_id": "6a970d82-4126-398b-b4b4-060760e4be0f",
                                "text": "„Immer dramatischer klangen die Nachrichten, immer albtraumhafter sahen die Videoberichte von den Küsten aus, da konnte er doch wohl nicht wie in Normalzeiten über Quisquilien aus dem eigenen Land sprechen?“"
                            },
                            {
                                "example_id": "89fadb14-f7a7-457a-b4a9-c95d0ff7927c",
                                "sense_id": "6a970d82-4126-398b-b4b4-060760e4be0f",
                                "text": "„Was auf den ersten Blick wie eine geschichtspolitische Quisquilie wirken mag, ist in Wirklichkeit elementar.“"
                            },
                            {
                                "example_id": "ffe6936e-daed-4cb1-8c0f-5b205567506e",
                                "sense_id": "6a970d82-4126-398b-b4b4-060760e4be0f",
                                "text": "„Noch einmal eine Quisquilie: Über idiolektal bedingte Dialektwörter in den Volksstücken Joachim Perinets (1765-1816).“"
                            },
                            {
                                "example_id": "8fd5e67a-4b3f-40a5-ad02-be30f8bbab96",
                                "sense_id": "6a970d82-4126-398b-b4b4-060760e4be0f",
                                "text": "„Den ideologischen Streit über Borkenkäfer und den Sinn von Totholzzonen würde er selbst wohl heute auch als lächerliche Quisquilien bezeichnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d859f197-d123-4af0-8d62-74936d25b2a8",
                        "source_entry_id": "e1630531-6353-3952-86ff-6960f12b7239",
                        "source_sense_id": "6a970d82-4126-398b-b4b4-060760e4be0f",
                        "source_sense_description": "meist Plural: Kleinigkeit, Nichtigkeit, Bagatelle",
                        "target_lang_word": "bagatelle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bagatelle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c4e9bbf-d9d7-3b28-866a-08df1d173acd",
                                        "entry_id": "7685f04e-8027-37eb-82d1-6763c2ddb412",
                                        "glosses": [
                                            "A trifle; an insubstantial thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "195bf62d-5d12-4356-b2df-dc1922a0bb90",
                                                "sense_id": "0c4e9bbf-d9d7-3b28-866a-08df1d173acd",
                                                "text": "The repayment of the cost of the western part of the road, whatever it might be, would be a mere bagatelle, for the older provinces would have been enriched by the stimulus given to business by the opening up of the plains,[…]"
                                            },
                                            {
                                                "example_id": "aa2b68f2-0958-43f2-b775-33a64ceb3ad2",
                                                "sense_id": "0c4e9bbf-d9d7-3b28-866a-08df1d173acd",
                                                "text": "Sir C. Oh! dear madam, don't ask me, it's a very foolish song—a mere bagatelle.\nChar. Oh! Sir Callaghan, I will admit of no excuse."
                                            },
                                            {
                                                "example_id": "a2c6f251-2bb3-4e0a-9b0c-fe019df9ec09",
                                                "sense_id": "0c4e9bbf-d9d7-3b28-866a-08df1d173acd",
                                                "text": "[…] the jails were larger and fuller, the number of murders was incomparably greater, the thefts and swindlings in the old country were a bagatelle to the large depredations there […]"
                                            },
                                            {
                                                "example_id": "833228f9-e907-4270-ac0a-6979e0acc104",
                                                "sense_id": "0c4e9bbf-d9d7-3b28-866a-08df1d173acd",
                                                "text": "They'd purchased a little house in the eighth arrondissement in Paris that for them was just a bagatelle, since they rarely lived there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fbd9d27-3bd1-33f3-ab5d-0ec35d4f2c96",
                                        "entry_id": "7685f04e-8027-37eb-82d1-6763c2ddb412",
                                        "glosses": [
                                            "A short piece of literature or of instrumental music, typically light or playful in character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42db1775-810b-486b-828f-81bb96eac685",
                                                "sense_id": "6fbd9d27-3bd1-33f3-ab5d-0ec35d4f2c96",
                                                "text": "One afternoon in 1920. a young pianist sat down in a shuttered room in the capital of defeated Germany and played a Bagatelle by Beethoven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b11992a-434c-3556-844b-f34b469acaf9",
                                        "entry_id": "7685f04e-8027-37eb-82d1-6763c2ddb412",
                                        "glosses": [
                                            "A game similar to billiards played on an oblong table with pockets or arches at one end only."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f419ad9-0e59-4323-8e83-5ff9561463f3",
                                                "sense_id": "2b11992a-434c-3556-844b-f34b469acaf9",
                                                "text": "For some time they did nothing save box, but at last they went down to the bagatelle room, and played bagatelle for a bit. They marked this advance in civilization by prodding holes in the ceiling with the bagatelle cues, which gave the ceiling the appearance of a cloth target after a Gatling gun had been shooting at it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ecd2333-016c-3519-853e-d6c2af08c189",
                                        "entry_id": "7685f04e-8027-37eb-82d1-6763c2ddb412",
                                        "glosses": [
                                            "Any of several smaller wooden tabletop games developed from the original bagatelle in which the pockets are made of pins."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bagatelle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd1cccc3-46b9-31f1-9152-95aa48852b57",
                                        "entry_id": "b7f869ca-69a6-3216-af1b-7b160fb8960e",
                                        "glosses": [
                                            "To meander or move around, in a manner similar to the ball in the game of bagatelle."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59f7b601-e6a5-4596-95b4-3d0dc7e4d951",
                                                "sense_id": "cd1cccc3-46b9-31f1-9152-95aa48852b57",
                                                "text": "Admittedly Mané’s strike did rebound off a post as the ball bagatelled around the home area. It was characteristically cleared before Roberto Firmino could redirect the fall out beyond Henderson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6c3ea6c-7bb1-3197-bac3-eb2ff48bcbcf",
                                        "entry_id": "b7f869ca-69a6-3216-af1b-7b160fb8960e",
                                        "glosses": [
                                            "To bagatellize; to regard as a bagatelle."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a3494db-4715-4de0-932f-d8752a794e51",
                                                "sense_id": "a6c3ea6c-7bb1-3197-bac3-eb2ff48bcbcf",
                                                "text": "That Saddam Hussein announced his intentions to destroy Israel a long time ago was either ignored or bagatelled. “We just didn't have time to address the threat to Israel,” explained Brigitte Erler on the eve of a large peace demonstration in Bonn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57cf2fce-83a6-4512-9dd0-5a2859f3857b",
                        "source_entry_id": "e1630531-6353-3952-86ff-6960f12b7239",
                        "source_sense_id": "6a970d82-4126-398b-b4b4-060760e4be0f",
                        "source_sense_description": "meist Plural: Kleinigkeit, Nichtigkeit, Bagatelle",
                        "target_lang_word": "petitesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petitesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b95ca95-4fb5-3eac-8240-96cdab89aef8",
                                        "entry_id": "8193d494-2685-3c99-b7e2-f7e43567ff2c",
                                        "glosses": [
                                            "Petite dimension, petite étendue, petit volume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4077a5b-e9e3-4f6d-afa0-749f8c59ac57",
                                                "sense_id": "1b95ca95-4fb5-3eac-8240-96cdab89aef8",
                                                "text": "Mais, pour contre-balancer de tels désavantages, la marquise d’Aubrion avait donné à sa fille un air très distingué, l’avait soumise à une hygiène qui maintenait provisoirement le nez à un ton de chair raisonnable, lui avait appris l’art de se mettre avec goût, l’avait dotée de jolies manières, lui avait enseigné ces regards mélancoliques qui intéressent un homme et lui font croire qu’il va rencontrer l’ange si vainement cherché ; elle lui avait montré la manœuvre du pied, pour l’avancer à propos et en faire admirer la petitesse, au moment où le nez avait l’impertinence de rougir ; enfin, elle avait tiré de sa fille un parti très satisfaisant."
                                            },
                                            {
                                                "example_id": "38d5340c-7096-4c73-b7dd-30d87325e7b1",
                                                "sense_id": "1b95ca95-4fb5-3eac-8240-96cdab89aef8",
                                                "text": "La Girafe […] ne soutient point longtemps cet effort, qu’elle ressent comme une fatigue : c’est que ses poumons n’ont pas assez d’ampleur ; défaut que révèle la petitesse du coffre qui les contient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0c7bbb2-c67a-37d3-9e2e-c43d18ebf650",
                                        "entry_id": "8193d494-2685-3c99-b7e2-f7e43567ff2c",
                                        "glosses": [
                                            "Modicité, surtout en parlant de dons, de présents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "297364d2-aa60-45db-8084-6d1805c58e82",
                                                "sense_id": "e0c7bbb2-c67a-37d3-9e2e-c43d18ebf650",
                                                "text": "La petitesse de ce don sera pour vous un motif de l’accepter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d726f7d-9cf4-3bf6-aad0-e85b47113990",
                                        "entry_id": "8193d494-2685-3c99-b7e2-f7e43567ff2c",
                                        "glosses": [
                                            "Faiblesse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8221751d-8fbe-43c3-b032-d5d4c74ebdc6",
                                                "sense_id": "1d726f7d-9cf4-3bf6-aad0-e85b47113990",
                                                "text": "Plus rarement, il existe des troubles cardiaques très marqués : petitesse et fréquence extrême du pouls, lipothymies et syncopes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f7d5d6c-0245-3dd2-a60a-6551da1499fa",
                                        "entry_id": "8193d494-2685-3c99-b7e2-f7e43567ff2c",
                                        "glosses": [
                                            "Étroitesse ; mesquinerie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "445ce577-893e-498e-8b92-6b686e4105f8",
                                                "sense_id": "6f7d5d6c-0245-3dd2-a60a-6551da1499fa",
                                                "text": "Vilquin eut la petitesse d’élever un mur du côté des vergers et des potagers. Depuis cette vengeance, les quelques centiares que le bail laisse au Chalet ressemblent à un jardin de Paris."
                                            },
                                            {
                                                "example_id": "a166b142-09cc-41b7-b267-9b1fce293eee",
                                                "sense_id": "6f7d5d6c-0245-3dd2-a60a-6551da1499fa",
                                                "text": "Il y a aussi Filoche, le dieu de la petitesse, des préjugés, du mépris, de la haine..."
                                            },
                                            {
                                                "example_id": "c99ff4f3-5282-4694-b4b2-6ae88bbb6d44",
                                                "sense_id": "6f7d5d6c-0245-3dd2-a60a-6551da1499fa",
                                                "text": "Au lieu de reconnaître leurs erreurs et de s’engager à les corriger, les principaux intéressés ont plutôt démontré la petitesse de leur caractère en déversant un flot d’insultes sur le journaliste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1940f19e-1b91-3bec-b851-3029886cc18e",
                                        "entry_id": "8193d494-2685-3c99-b7e2-f7e43567ff2c",
                                        "glosses": [
                                            "Actions qui dénotent cette petitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45cfd2de-c380-42d7-ae34-a3b50dde3367",
                                                "sense_id": "1940f19e-1b91-3bec-b851-3029886cc18e",
                                                "text": "C’est une petitesse à lui de s’être offensé de si peu de chose. C’est un homme plein de petitesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
