            "senses": [
                {
                    "sense_id": "0f2aeed0-3893-3808-94cb-643ef66158c3",
                    "sense_definition": "To make someone or something famous; to bring renown to.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victory <w>famoused</w> the young captain throughout the empire.",
                            "target_lang_translations": {
                                "ru": "Эта победа <w>прославила</w> молодого капитана на всю империю.",
                                "nl": "De overwinning <w>maakte</w> de jonge kapitein <w>beroemd</w> in het hele rijk.",
                                "pl": "To zwycięstwo <w>wsławiło</w> młodego kapitana w całym imperium.",
                                "de": "Der Sieg <w>machte</w> den jungen Kapitän im ganzen Reich <w>berühmt</w>.",
                                "fr": "La victoire <w>rendit célèbre</w> le jeune capitaine dans tout l'empire.",
                                "it": "La vittoria <w>rese famoso</w> il giovane capitano in tutto l'impero.",
                                "cs": "Toto vítězství <w>proslavilo</w> mladého kapitána po celé říši.",
                                "tr": "Bu zafer, genç kaptanı tüm imparatorlukta <w>ünlendirdi</w>.",
                                "es": "La victoria <w>hizo famoso</w> al joven capitán en todo el imperio.",
                                "zh": "这场胜利使这位年轻的船长在整个帝国<w>扬名</w>。"
                            }
                        },
                        {
                            "text": "Ancient poets <w>famoused</w> their heroes in epic songs.",
                            "target_lang_translations": {
                                "ru": "Древние поэты <w>прославляли</w> своих героев в эпических песнях.",
                                "nl": "Oude dichters <w>bezingden</w> hun helden in epische liederen.",
                                "pl": "Starożytni poeci <w>wsławiali</w> swoich bohaterów w pieśniach epickich.",
                                "de": "Antike Dichter <w>priesen</w> ihre Helden in epischen Gesängen.",
                                "fr": "Les poètes de l'Antiquité <w>glorifiaient</w> leurs héros dans des chants épiques.",
                                "it": "I poeti antichi <w>celebravano</w> i loro eroi in canti epici.",
                                "cs": "Dávní básníci <w>oslavovali</w> své hrdiny v epických písních.",
                                "tr": "Antik şairler, kahramanlarını destansı şarkılarla <w>meşhur ettiler</w>.",
                                "es": "Los poetas antiguos <w>hicieron famosos</w> a sus héroes en cantos épicos.",
                                "zh": "古代诗人在史诗中<w>歌颂</w>他们的英雄。"
                            }
                        }
                    ],
                    "traits": [
