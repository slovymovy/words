{
    "word_family": [
        "meekness",
        "meekly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dcd891cc-7cad-3a4c-a847-4b03dd702eee",
                    "sense_definition": "Humble, modest, and gentle in nature; not boastful or proud.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his incredible success, he remained a <w>meek</w> and gentle man who never bragged about his achievements.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свой невероятный успех, он оставался <w>кротким</w> и мягким человеком, который никогда не хвастался своими достижениями.",
                                "de": "Trotz seines unglaublichen Erfolgs blieb er ein <w>bescheidener</w> und sanfter Mann, der nie mit seinen Leistungen prahlte."
                            }
                        },
                        {
                            "text": "She spoke in a <w>meek</w> voice, hoping not to draw too much attention to herself during the meeting.",
                            "target_lang_translations": {
                                "ru": "Она говорила <w>тихим</w> голосом, надеясь не привлекать к себе слишком много внимания во время собрания.",
                                "de": "Sie sprach mit <w>leiser</w> Stimme, in der Hoffnung, während des Treffens nicht zu viel Aufmerksamkeit auf sich zu ziehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "humble",
                        "modest",
                        "gentle",
                        "mild"
                    ],
                    "antonyms": [
                        "boastful",
                        "proud",
                        "arrogant"
                    ],
                    "common_phrases": [
                        "meek and mild",
                        "meek voice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кроткий, скромный и мягкий по характеру; не хвастливый и не гордый.",
                        "de": "Bescheiden, zurückhaltend und sanftmütig im Wesen; nicht prahlerisch oder stolz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроткий",
                                "target_lang_sense_clarification": "скромный, мягкий по характеру"
                            },
                            {
                                "target_lang_word": "тихий",
                                "target_lang_sense_clarification": "не привлекающий внимания, скромный"
                            },
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "спокойный и благожелательный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bescheiden",
                                "target_lang_sense_clarification": "zurückhaltend, nicht prahlerisch"
                            },
                            {
                                "target_lang_word": "sanftmütig",
                                "target_lang_sense_clarification": "von sanftem, friedfertigem Wesen"
                            },
                            {
                                "target_lang_word": "zurückhaltend",
                                "target_lang_sense_clarification": "sich nicht in den Vordergrund drängend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9b64fa9-1354-3d11-9a36-8f1ce11cd98b",
                    "sense_definition": "Submissive, easily imposed upon, or lacking spirit and courage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you are too <w>meek</w> in this competitive industry, others will take advantage of your hard work.",
                            "target_lang_translations": {
                                "ru": "Если вы будете слишком <w>покорными</w> в этой конкурентной индустрии, другие воспользуются результатами вашего тяжелого труда.",
                                "de": "Wenn du in dieser wettbewerbsintensiven Branche zu <w>unterwürfig</w> bist, werden andere deine harte Arbeit ausnutzen."
                            }
                        },
                        {
                            "text": "He gave a <w>meek</w> acceptance of the unfair terms because he was too afraid to argue.",
                            "target_lang_translations": {
                                "ru": "Он выразил <w>безропотное</w> согласие с несправедливыми условиями, потому что слишком боялся спорить.",
                                "de": "Er akzeptierte die unfairen Bedingungen <w>widerstandslos</w>, weil er zu viel Angst hatte, zu widersprechen."
                            }
                        }
                    ],
                    "synonyms": [
                        "submissive",
                        "docile",
                        "compliant",
                        "yielding"
                    ],
                    "antonyms": [
                        "assertive",
                        "bold",
                        "rebellious"
                    ],
                    "common_phrases": [
                        "meek acceptance",
                        "meek surrender"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покорный, безропотный, легко поддающийся чужому влиянию или лишенный смелости.",
                        "de": "Unterwürfig, leicht beeinflussbar oder es an Mut und Durchsetzungsvermögen fehlen lassend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безропотный",
                                "target_lang_sense_clarification": "терпеливо сносящий обиды, не протестующий"
                            },
                            {
                                "target_lang_word": "покорный",
                                "target_lang_sense_clarification": "послушный, подчиняющийся чужой воле"
                            },
                            {
                                "target_lang_word": "слабохарактерный",
                                "target_lang_sense_clarification": "неспособный постоять за себя"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "unterwürfig",
                                "target_lang_sense_clarification": "sich bereitwillig unterordnend"
                            },
                            {
                                "target_lang_word": "kleinlaut",
                                "target_lang_sense_clarification": "unsicher, ohne Selbstvertrauen"
                            },
                            {
                                "target_lang_word": "widerstandslos",
                                "target_lang_sense_clarification": "keine Gegenwehr leistend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1f1daaf9-da04-3d8e-83c3-d040915ae01c",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Professor <w>Meek</w> to deliver the keynote lecture on historical linguistics.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили профессора <w>Мика</w> выступить с пленарным докладом по исторической лингвистике.",
                                "de": "Wir haben Professor <w>Meek</w> eingeladen, den Hauptvortrag über historische Linguistik zu halten."
                            }
                        },
                        {
                            "text": "The local library was named in honor of the philanthropist Arthur <w>Meek</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Артура <w>Мика</w>.",
                                "de": "Die örtliche Bibliothek wurde zu Ehren des Philanthropen Arthur <w>Meek</w> benannt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия Мик.",
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мик",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Meek",
                                "target_lang_sense_clarification": "Nachname"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37a0bd8e-3da8-344d-b070-edd5f8021ac6",
                    "sense_definition": "An unincorporated community in Holt County, Nebraska, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small settlement of <w>Meek</w> is located in the northern part of Holt County.",
                            "target_lang_translations": {
                                "ru": "Небольшое поселение <w>Мик</w> расположено в северной части округа Холт.",
                                "de": "Die kleine Siedlung <w>Meek</w> liegt im nördlichen Teil des Holt County."
                            }
                        },
                        {
                            "text": "Driving through Nebraska, they passed near <w>Meek</w>, a quiet unincorporated community.",
                            "target_lang_translations": {
                                "ru": "Проезжая через Небраску, они миновали <w>Мик</w>, тихое невключённое сообщество.",
                                "de": "Auf der Fahrt durch Nebraska kamen sie in der Nähe von <w>Meek</w> vorbei, einer ruhigen, nicht eingemeindeten Siedlung."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specific to Nebraska, United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мик, невключённая территория в округе Холт, штат Небраска, США.",
                        "de": "Eine nicht eingemeindete Siedlung im Holt County, Nebraska, USA."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мик",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Meek",
                                "target_lang_sense_clarification": "Ortsname"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c198bdb3-65c6-37ce-a574-21f9a9a767f4",
                    "sense_definition": "To tame or break, especially a horse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old rancher knew exactly how to <w>meek</w> a wild stallion without breaking its spirit.",
                            "target_lang_translations": {
                                "ru": "Старый ранчер точно знал, как <w>укротить</w> дикого жеребца, не сломив его дух.",
                                "de": "Der alte Rancher wusste genau, wie man einen wilden Hengst <w>zähmt</w>, ohne seinen Geist zu brechen."
                            }
                        },
                        {
                            "text": "It took several weeks of patient training to <w>meek</w> the young horse.",
                            "target_lang_translations": {
                                "ru": "Потребовалось несколько недель терпеливых тренировок, чтобы <w>объездить</w> молодую лошадь.",
                                "de": "Es dauerte mehrere Wochen geduldigen Trainings, das junge Pferd <w>einzureiten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tame",
                        "break",
                        "subdue"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Укрощать или объезжать, особенно лошадь.",
                        "de": "Zähmen oder gefügig machen, insbesondere bei einem Pferd."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрощать",
                                "target_lang_sense_clarification": "делать смирным, подчинять своей воле"
                            },
                            {
                                "target_lang_word": "объезжать",
                                "target_lang_sense_clarification": "приучать лошадь к езде"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zähmen",
                                "target_lang_sense_clarification": "an den Menschen gewöhnen"
                            },
                            {
                                "target_lang_word": "einreiten",
                                "target_lang_sense_clarification": "ein Pferd an das Reiten gewöhnen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}