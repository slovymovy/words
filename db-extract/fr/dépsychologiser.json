                "senses": [
                    {
                        "sense_id": "952cd967-9d56-3512-a97b-865bda6bac0d",
                        "entry_id": "9fdb6df9-08ec-3e28-9c3e-8bc0f03c6204",
                        "glosses": [
                            "Faire perdre son caractère psychologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9de8d5ae-7d15-445e-b5eb-c5c13f2c3ee8",
                                "sense_id": "952cd967-9d56-3512-a97b-865bda6bac0d",
                                "text": "Parce que dépsychologiser le management fait équivalence, pour la plupart des managers, à reconnaître leur souffrance quotidienne dans leur métier de manager, c’est là un travail ardu."
                            },
                            {
                                "example_id": "adc5da4c-b15e-46b0-9d11-ae0ac2f01c22",
                                "sense_id": "952cd967-9d56-3512-a97b-865bda6bac0d",
                                "text": "Le Viagra supprime ce trouble constitutif du moi ; de ce fait, il dépsychologise autant qu’il déségoïse la sexualité."
                            }
                        ]
                    }
