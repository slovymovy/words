                    },
                    {
                        "translation_id": "2b8b78f2-302a-4d8a-b574-d1f023b81814",
                        "source_entry_id": "884f3494-6309-3089-8c17-568a2812c570",
                        "source_sense_description": "To make a quick evasive turn",
                        "target_lang_word": "zigzaguer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zigzaguer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7e17158-6ead-39d6-9fcb-ef8b8c9432c8",
                                        "entry_id": "2e7742e7-276b-3fa9-bd9e-f7e3e9c95791",
                                        "glosses": [
                                            "Ne pas aller droit ; avancer en faisant des zigzags."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c370b5-b879-4656-a4b3-7fe13181a82d",
                                                "sense_id": "b7e17158-6ead-39d6-9fcb-ef8b8c9432c8",
                                                "text": "Nous en profitons pour bifurquer brusquement et nous arrivons enfin en zigzaguant à nous mettre hors de la portée de notre intrus."
                                            },
                                            {
                                                "example_id": "edf0e9ed-eedf-49e1-a42b-2d7b4ef40932",
                                                "sense_id": "b7e17158-6ead-39d6-9fcb-ef8b8c9432c8",
                                                "text": "M. Tumarche haussa les épaules et il s’éloigna, zigzaguant."
                                            },
                                            {
                                                "example_id": "f8baec53-89c3-4625-a853-909b517f78f3",
                                                "sense_id": "b7e17158-6ead-39d6-9fcb-ef8b8c9432c8",
                                                "text": "Comme fait un mur dont la construction ou fondation sont ausi vicieuses, qui cependant, peut avoir quelques assises assez fortes, pour faire dévier et zigzaguer la fracture verticale."
                                            },
                                            {
                                                "example_id": "4e681ed8-f411-4200-991d-ddefcb13493e",
                                                "sense_id": "b7e17158-6ead-39d6-9fcb-ef8b8c9432c8",
                                                "text": "Il se décida à regarder du côté de Marcelle. Aussitôt, chez la jeune fille, un petit tremblement nerveux de la joue ou de l’œil (mais vraiment il allait de la joue ou de l’œil, en zigzaguant comme un éclair) avertit le colonel qu’il s’était bien passé quelque chose de grave."
                                            },
                                            {
                                                "example_id": "e7de85e4-ac16-4d33-aa99-837078e33328",
                                                "sense_id": "b7e17158-6ead-39d6-9fcb-ef8b8c9432c8",
                                                "text": "[…] notre appareil était balloté par un vent de trois quarts debout. Nous étions à 4.000 mètres d'altitude. C'était à la fois irréel et fantastique. Je zigzaguais pour trouver le moyen de sortir de ces masses de vapeur d’eau."
                                            },
                                            {
                                                "example_id": "d318ec65-7fda-44c1-b6e1-d577aab4ae15",
                                                "sense_id": "b7e17158-6ead-39d6-9fcb-ef8b8c9432c8",
                                                "text": "[…] : avec cette chaleur, en pleine nuit, il porte sur le crâne, de guingois, un Borsalino beige, une chemise à pois blancs sur fond noir qui zigzague au bombé de l'estomac, […]."
                                            },
                                            {
                                                "example_id": "90e7f37e-3b3d-40e7-97d0-a57fa8c15d14",
                                                "sense_id": "b7e17158-6ead-39d6-9fcb-ef8b8c9432c8",
                                                "text": "« Le sommeil, c’est important. Plus important que manger. Bien dormir : sinon, après, tu zigzagues. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
