                ],
                "senses": [
                    {
                        "sense_id": "4bccbfd8-525c-3c1c-8a88-45df285aed39",
                        "entry_id": "dc0256df-ae47-3d9c-a07f-49e82c2de9d8",
                        "glosses": [
                            "Enlever son chapeau."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "1da80329-a1d2-45a5-9dcf-54febe10eac3",
                                "sense_id": "4bccbfd8-525c-3c1c-8a88-45df285aed39",
                                "text": "Nous prendrions froid de nous déchapeauter."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3feadc2-17a7-36c4-bdf9-e6962c48d67d",
                        "entry_id": "dc0256df-ae47-3d9c-a07f-49e82c2de9d8",
                        "glosses": [
                            "Enlever le chapeau de quelqu’un ou quelque chose (un vrai chapeau, ou quelque chose qu’on compare à un chapeau, par exemple le bouchon d’une bouteille, le sommet d’une tomate, etc.)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "47e7efce-3c36-4edb-a6bd-0bbf78b8905c",
                                "sense_id": "f3feadc2-17a7-36c4-bdf9-e6962c48d67d",
                                "text": "Et puis, plus de fuites intempestives, avec une valve coincée qu’on vient de déchapeauter au moment du départ."
                            },
                            {
                                "example_id": "0b77ad61-4efb-493c-bd80-09272157538b",
                                "sense_id": "f3feadc2-17a7-36c4-bdf9-e6962c48d67d",
                                "text": "Dans la rue Tisserand, où débouchait l’impasse, le vent d’autan déchapeautait les cheminées, culbutait les inventaires, retroussait les passantes."
                            }
                        ]
                    }
                ],
