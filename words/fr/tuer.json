    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1818fc02-8e62-3157-9482-e729c0ca2001",
                    "sense_definition": "Ôter la vie à un être vivant de manière délibérée ou violente.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chasseur a <w>tué</w> un sanglier dans la forêt tôt ce matin."
                        },
                        {
                            "text": "Cette terrible maladie peut facilement <w>tuer</w> les personnes les plus fragiles."
                        }
                    ],
                    "synonyms": [
                        "abattre",
                        "assassiner",
                        "éliminer",
                        "exterminer",
                        "liquider",
                        "mettre à mort",
                        "occire",
                        "supprimer"
                    ],
                    "antonyms": [
                        "épargner",
                        "protéger"
                    ],
                    "common_phrases": [
                        "tuer net"
                    ]
                },
                {
                    "sense_id": "6f83ce99-d03a-385e-9dad-333cae2ce50f",
                    "sense_definition": "Mettre volontairement fin à ses propres jours.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le héros de cette tragédie préfère se <w>tuer</w> plutôt que de trahir ses amis."
                        },
                        {
                            "text": "Désespéré après la faillite de son entreprise, l'homme a menacé de se <w>tuer</w>."
                        }
                    ]
                },
                {
                    "sense_id": "21a0dbee-9286-3f2a-93ef-eed6a4aefbcc",
                    "sense_definition": "Passer ou occuper le temps pour tromper l'ennui en attendant quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons joué aux cartes pour <w>tuer</w> le temps avant le départ du train."
                        },
                        {
                            "text": "Il marchait le long des quais afin de <w>tuer</w> les deux heures d'attente."
                        }
                    ],
                    "common_phrases": [
                        "tuer le temps"
                    ]
                },
                {
                    "sense_id": "88dc01b3-133e-32cf-8e55-2ec6d296eb63",
                    "sense_definition": "Faire disparaître ou détruire complètement quelque chose d'abstrait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le développement des grandes surfaces a fini par <w>tuer</w> le petit commerce de proximité."
                        },
                        {
                            "text": "Une routine pesante risque souvent de <w>tuer</w> la créativité des artistes."
                        }
                    ],
                    "synonyms": [
                        "éliminer",
                        "supprimer"
                    ],
                    "common_phrases": [
                        "tuer dans l'œuf"
                    ]
                },
                {
                    "sense_id": "3dce76b9-470e-3dc1-8cde-e9eb71138c27",
                    "sense_definition": "Se donner une peine excessive ou s'épuiser à faire quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet ouvrier se <w>tue</w> à la tâche depuis des années pour nourrir sa famille."
                        },
                        {
                            "text": "Je me <w>tue</w> à vous répéter les mêmes consignes de sécurité tous les matins."
                        }
                    ],
                    "common_phrases": [
                        "se tuer à la tâche",
                        "se tuer au travail"
                    ]
                },
                {
                    "sense_id": "b1c5601c-80e0-3fd1-bc2c-8792c87da62e",
                    "sense_definition": "Provoquer une vive émotion, de l'exaspération ou un fou rire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce comédien a tellement d'humour que sa dernière blague m'a totalement <w>tué</w>."
                        },
                        {
                            "text": "Entendre constamment de fausses excuses de sa part, franchement, cela me <w>tue</w>."
                        }
                    ],
                    "common_phrases": [
                        "ça me tue"
                    ],
                    "traits": [
