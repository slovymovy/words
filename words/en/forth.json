                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "The engineer chose to write the firmware in <w>Forth</w> because of its efficiency in embedded systems.",
                            "target_lang_translations": {
                                "ru": "Инженер решил написать прошивку на языке <w>Форт</w> из-за его эффективности во встраиваемых системах."
                            }
