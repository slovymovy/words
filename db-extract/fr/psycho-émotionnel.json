                                "example_id": "1bb55721-11be-438d-9a60-5c1cde09a5dd",
                                "sense_id": "20064e94-b961-30f2-8dd1-4ba068c19bea",
                                "text": "Sans aucun doute, certains chercheurs ont déjà essayé de mettre en relation les signes iriens avec les états psycho-émotionnels."
                            },
