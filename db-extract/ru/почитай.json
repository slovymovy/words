        "ru-extract.jsonl": [
            {
                "entry_id": "3f98efd7-2070-3a64-a564-438baa8c6f78",
                "word": "почитай",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d254734d-e95a-370b-809d-59f15e3ff5d6",
                        "entry_id": "3f98efd7-2070-3a64-a564-438baa8c6f78",
                        "glosses": [
                            "вводн. сл.; прост. то же, что пожалуй, вероятно, наверное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d74e7139-4526-4c71-8222-c7441eb22981",
                                "sense_id": "d254734d-e95a-370b-809d-59f15e3ff5d6",
                                "text": "― Так-то у нас дома баба была, ― начал Чикин: ― так с печи, почитай, два года не сходила."
                            },
                            {
                                "example_id": "5abb4d12-f635-4fb3-a3e4-4d1931096bfc",
                                "sense_id": "d254734d-e95a-370b-809d-59f15e3ff5d6",
                                "text": "― Давно это было, почитай годов с десять."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5a0e735-47bc-33ab-b3aa-af32aa90dbc8",
                        "entry_id": "3f98efd7-2070-3a64-a564-438baa8c6f78",
                        "glosses": [
                            "прост. то же, что почти"
                        ],
                        "tags": [
                            "нареч."
                        ],
                        "examples": [
                            {
                                "example_id": "32400e80-5040-4158-a358-66a6ca1fa60d",
                                "sense_id": "b5a0e735-47bc-33ab-b3aa-af32aa90dbc8",
                                "text": "― Пожар у нас был большой, почитай все село сгорело…"
                            },
                            {
                                "example_id": "f3327acd-dc96-471e-bab2-b0425928cadb",
                                "sense_id": "b5a0e735-47bc-33ab-b3aa-af32aa90dbc8",
                                "text": "― Почитай всю вотчину перепороли через десятого, пятьсот с гаком человек, ― отдышавшись, стали жаловаться вновь пригнанные крестьяне."
                            }
                        ]
                    }
                ],
