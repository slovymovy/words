                                        "entry_id": "3d0d7e53-b8dc-3253-ae51-b595134e4886",
                                        "glosses": [
                                            "das Handwerk betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05982fc4-7684-41ef-82c0-e8da740760b2",
                                                "sense_id": "13c9d2de-67e6-3011-a59b-24f55cf6184e",
                                                "text": "Mein Bruder ist handwerklich sehr begabt."
                                            },
                                            {
                                                "example_id": "979270a0-ad46-4ed0-abde-b74f7785ae81",
                                                "sense_id": "13c9d2de-67e6-3011-a59b-24f55cf6184e",
                                                "text": "Dieser Teppich ist eine handwerkliche Meisterleistung."
                                            },
                                            {
                                                "example_id": "1ecaae30-49de-4cb3-815f-40040402e33b",
                                                "sense_id": "13c9d2de-67e6-3011-a59b-24f55cf6184e",
                                                "text": "„Der überwiegende Teil der handwerklichen Produktion war zweifellos für den eigenen Bedarf bestimmt […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
