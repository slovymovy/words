                            {
                                "example_id": "7aa5ea8c-c4de-432d-8178-e2f6b26fece1",
                                "sense_id": "d5e55c80-36b6-3e47-8451-fdb2f2d1d31e",
                                "text": "En été, je torsade la ficelle des tomates et je dois les dégourmander."
                            },
                            {
