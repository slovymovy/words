                ],
                "senses": [
                    {
                        "sense_id": "cab34af6-d3a3-3768-97cd-9689d09e2aa5",
                        "entry_id": "aed17092-38da-3fda-a1d3-cf5e346809bc",
                        "glosses": [
                            "meist rückwärtslaufende Uhr, die die Restzeit (evtl. auch die Restmenge von CO₂) anzeigt, die bei konstanten CO₂-Emissionen verbleibt, um danach gar keine klimawirksamen Gase emittieren zu dürfen ohne das 1,5-Grad-Ziel oder das 2,0-Grad-Ziel des Pariser Klimaschutzabkommens zu reißen (und damit die Folgen für die Menschheit auszulösen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c3a6701-cf1e-4d8a-9318-ebf5e419e31d",
                                "sense_id": "cab34af6-d3a3-3768-97cd-9689d09e2aa5",
                                "text": "Es gibt mehrere online verfügbare Klimauhren."
                            },
                            {
                                "example_id": "10e83990-93a4-4bca-9627-36a837281a79",
                                "sense_id": "cab34af6-d3a3-3768-97cd-9689d09e2aa5",
                                "text": "„Im Prager Letná-Park wurde am Dienstagabend eine Klimauhr angebracht.“"
                            },
                            {
                                "example_id": "99ddc6db-7c6b-42e7-be81-78b9229a8940",
                                "sense_id": "cab34af6-d3a3-3768-97cd-9689d09e2aa5",
                                "text": "„Auf der Verkehrsinsel vor dem Wiesbadener Hauptbahnhof soll künftig eine Klimauhr installiert werden.“"
                            },
                            {
                                "example_id": "1f07e8e2-6f34-4165-a28e-f0453f671cac",
                                "sense_id": "cab34af6-d3a3-3768-97cd-9689d09e2aa5",
                                "text": "„Für die Form des Klimabarometers kannte die Kreativität der Teilnehmenden fast keine Grenzen:“ […] „eine „Klimauhr“, die in Anlehnung an die bundesdeutsche Schuldenuhr die Treibhausgasemissionen digital anzeigt“"
                            },
                            {
                                "example_id": "c09f8349-1c09-4618-8e2a-c34ebc5da11a",
                                "sense_id": "cab34af6-d3a3-3768-97cd-9689d09e2aa5",
                                "text": "„Für die Klimauhr ist zum einen denkbar, dass von dem für die Universität Stuttgart noch zulässigen Emissionsbudget zum Beispiel die täglich anfallenden Emissionen kontinuierlich abgezogen werden.“"
                            },
                            {
                                "example_id": "27d93d44-62f4-4195-851c-2349dc4fc3bc",
                                "sense_id": "cab34af6-d3a3-3768-97cd-9689d09e2aa5",
                                "text": "„Ausserdem zeigt die Klimauhr an, wie lange es dauern wird, bis diese Menge an CO2 ausgestossen sein wird, wenn es der Weltgemeinschaft nicht gelingt, ihre CO2-Emissionen umgehend und drastisch zu reduzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
