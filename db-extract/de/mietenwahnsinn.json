                "senses": [
                    {
                        "sense_id": "3d190604-8abc-3a27-872e-4f8915c32834",
                        "entry_id": "284eaf74-fadb-33fa-a722-f49fc397df38",
                        "glosses": [
                            "überhöhter Anstieg der Mietpreise (insbesondere für Wohnungen) in Folge von Gentrifizierung"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "84953446-649d-4cc3-99a1-16d6598f1aca",
                                "sense_id": "3d190604-8abc-3a27-872e-4f8915c32834",
                                "text": "„In großen Städten steigen die Mieten in atemberaubenden Tempo. Gegen den \"Mietenwahnsinn\" zogen Demonstranten in mehreren deutschen Städten auf die Straße.“"
                            },
                            {
                                "example_id": "cd47615d-f9ef-403b-a2a6-17db55470807",
                                "sense_id": "3d190604-8abc-3a27-872e-4f8915c32834",
                                "text": "[Schlagzeile:] „Mit Enteignungen gegen den \"Mietenwahnsinn\"?“"
                            },
                            {
                                "example_id": "df95bed9-6507-4020-9a19-1313704df59e",
                                "sense_id": "3d190604-8abc-3a27-872e-4f8915c32834",
                                "text": "„Mit seiner Guerilla-Aktion schafft das Künstlerduo Raum für Debatten über den Münchner Mietenwahnsinn.“"
                            },
                            {
                                "example_id": "8a6ec462-9aa0-4231-8be9-2e980a8abdb9",
                                "sense_id": "3d190604-8abc-3a27-872e-4f8915c32834",
                                "text": "„Die Sanierung eines Wohnblocks in Pankow wurde 2017 zum Politikum. Viele Mieter hatten Angst vor Verdrängung und suchten Hilfe bei der Politik. Seither wächst der Unmut über den \"Mietenwahnsinn\" in der Hauptstadt.“"
                            },
                            {
                                "example_id": "0399abd7-6f62-459c-9827-def995f8facc",
                                "sense_id": "3d190604-8abc-3a27-872e-4f8915c32834",
                                "text": "„[…] da wir nicht langfristig mit diesem Mietenwahnsinn in Berlin leben wollen, haben wir uns entschlossen, eine grundsätzliche und radikale Lösung vorzuschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
