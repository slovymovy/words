                                        "sense_id": "328e1332-abe1-380a-975b-8cf956cd3831",
                                        "entry_id": "539e6020-6813-34ea-86cd-3fb7529a4b25",
                                        "glosses": [
                                            "Trachurus trachurus een straalvinnige vis, de typesoort uit de familie van horsmakrelen (Carangidae) uit de orde van baarsachtigen (Perciformes). De vis is gemiddeld tussen de 22 en 30 cm, maar kan maximaal 70 cm lang en 2 kg zwaar worden. Er zijn twee rugvinnen, de voorste met 8 vinstralen, de achterste met 23-34 vinstralen. De aarsvin heeft 25-34 vinstralen"
                                        ],
                                        "tags": [
                                            "straalvinnigen"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dda97789-61f6-4ab6-8049-6fae803b6a2d",
                        "source_entry_id": "8d3a9b81-c9e2-36a8-ae3b-368554745543",
                        "source_sense_id": "38698f27-6a79-3889-82e2-bb468689ba26",
