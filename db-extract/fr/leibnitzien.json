                "senses": [
                    {
                        "sense_id": "62b147f2-1f1b-3f01-9a2d-90b655e843a1",
                        "entry_id": "d83f1d2a-efa7-3dfb-895d-e06e0957fc70",
                        "glosses": [
                            "Partisan de la philosophie de Gottfried Wilhelm Leibniz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd76580-1cea-4085-a5dc-40651b86f62b",
                                "sense_id": "62b147f2-1f1b-3f01-9a2d-90b655e843a1",
                                "text": "Je suis très mortifié, monsieur, que vous soyez assez leibnitzien pour imaginer que vous avez une raison suffisante d'être en colère contre moi."
                            },
                            {
                                "example_id": "43a942e3-e9cc-458b-9400-13e672e881db",
                                "sense_id": "62b147f2-1f1b-3f01-9a2d-90b655e843a1",
                                "text": "Il n'a pas été peu étonné d'entendre dire à M. Robert (du Var), dans son exposé, que Leibnitz était un bon chrétien. C'est pour prouver, au contraire, que toute la philosophie leibnitzienne est hostile au christianisme, qu'il a demandé la parole."
                            }
                        ]
                    }
                ],
