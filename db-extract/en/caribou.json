                        "entry_id": "f0808487-ee35-3354-9244-b786a6d26662",
                        "glosses": [
                            "Vertreter einer der nordamerikanischen Unterarten des Rentiers (Rangifer tarandus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af0f9800-06aa-4d37-8db8-5a1dbac74abf",
                                "sense_id": "223a52d8-45b8-3d44-b9c0-aae93bea80de",
                                "text": "The caribou snorted, looked at Peter, turned around and ran away.",
                                "translation": "Das Karibu schnaubte, sah Peter an, drehte sich um und rannte weg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfc2eb80-9346-48e4-8c10-a21dfeed8f47",
                        "source_entry_id": "f0808487-ee35-3354-9244-b786a6d26662",
                        "source_sense_id": "223a52d8-45b8-3d44-b9c0-aae93bea80de",
                        "source_sense_description": "Vertreter einer der nordamerikanischen Unterarten des Rentiers (Rangifer tarandus)",
                        "target_lang_word": "Karibu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karibu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b79dae0-2500-311c-a9e3-21cd67f46ea8",
                                        "entry_id": "54dc6ca9-207f-35ff-857d-1d845da851af",
                                        "glosses": [
                                            "nordamerikanisches Ren, das vor allem in Kanada vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cc9bf47-d5dc-4bdf-8395-7d1d0bedec06",
                                                "sense_id": "4b79dae0-2500-311c-a9e3-21cd67f46ea8",
                                                "text": "„Die sommerliche Ernährung des Karibus umfasst blühende Pflanzen der Tundra wie Wollgras und andere Seggen, Pilze und Weidenblätter.“"
                                            },
                                            {
                                                "example_id": "c6eab8a9-58d4-4dce-bcb4-837817dc04d1",
                                                "sense_id": "4b79dae0-2500-311c-a9e3-21cd67f46ea8",
                                                "text": "„Elche immerhin sind einige unterwegs, und auch Karibus, die nordamerikanische Variante der Rentiere.“"
                                            },
                                            {
                                                "example_id": "666ce468-2872-4204-ac46-0fe4ac3d8ea8",
                                                "sense_id": "4b79dae0-2500-311c-a9e3-21cd67f46ea8",
                                                "text": "„Und die Küche, einfach, aber gut, präsentierte meist Produkte der Region wie Karibu oder Seesaibling.“"
                                            },
                                            {
                                                "example_id": "abf93013-bf07-4633-b0a8-0ae36d03f76a",
                                                "sense_id": "4b79dae0-2500-311c-a9e3-21cd67f46ea8",
                                                "text": "„Elefanten in Afrika zum Beispiel gehen ebenso regelmäßig auf Wanderschaft wie Karibus in Nordamerika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1a9c729-452f-4381-b74c-663dbf10a2de",
                        "source_entry_id": "f0808487-ee35-3354-9244-b786a6d26662",
                        "source_sense_id": "223a52d8-45b8-3d44-b9c0-aae93bea80de",
