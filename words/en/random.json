{
    "word_family": [
        "randomize",
        "randomization",
        "randomly",
        "randomness",
        "rando"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f442e5e5-fc53-375b-9656-40688b4dc01a",
                    "sense_definition": "Occurring for no particular reason; haphazard, unpredictable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "unpredictable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city has been plagued by <w>random</w> acts of violence lately.",
                            "target_lang_translations": {
                                "ru": "В последнее время город страдает от <w>случайных</w> актов насилия.",
                                "zh": "最近这座城市一直受到<w>随机</w>暴力事件的困扰。"
                            }
                        },
                        {
                            "text": "Doing <w>random</w> acts of kindness can make someone's day much better.",
                            "target_lang_translations": {
                                "ru": "Совершение <w>спонтанных</w> добрых поступков может сделать чей-то день намного лучше.",
                                "zh": "做一些<w>随手</w>的善举能让别人的一天变得更美好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "desultory"
                    ],
                    "antonyms": [
                        "planned",
                        "systematic",
                        "deliberate"
                    ],
                    "common_phrases": [
                        "random acts of kindness",
                        "random acts of violence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий без особой причины; беспорядочный, непредсказуемый.",
                        "zh": "没有特定原因地发生；杂乱无章，不可预测。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "происходящий без плана"
                            },
                            {
                                "target_lang_word": "беспорядочный",
                                "target_lang_sense_clarification": "хаотичный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随机",
                                "target_lang_sense_clarification": "没有特定规律或计划"
                            },
                            {
                                "target_lang_word": "偶然",
                                "target_lang_sense_clarification": "非预期的发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ee495af-d73b-3e83-b8c8-c95a9e527f09",
                    "sense_definition": "Selected for no particular reason; arbitrary; unspecified.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "arbitrary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I didn't have time to look at the menu, so I just ordered a <w>random</w> dish.",
                            "target_lang_translations": {
                                "ru": "У меня не было времени смотреть меню, поэтому я просто заказал <w>первое попавшееся</w> блюдо.",
                                "zh": "我没时间看菜单，所以就<w>随便</w>点了一道菜。"
                            }
                        },
                        {
                            "text": "You shouldn't trust the word of <w>random</w> people on the internet.",
                            "target_lang_translations": {
                                "ru": "Не стоит доверять словам <w>случайных</w> людей в интернете.",
                                "zh": "你不应该相信网上<w>陌生</w>人的话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "desultory"
                    ],
                    "antonyms": [
                        "specific",
                        "chosen"
                    ],
                    "common_phrases": [
                        "random people",
                        "random choice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбранный без особой причины; произвольный; неуказанный.",
                        "zh": "没有特定原因地被选中；任意的；未指定的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "произвольный",
                                "target_lang_sense_clarification": "выбранный наугад"
                            },
                            {
                                "target_lang_word": "первый попавшийся",
                                "target_lang_sense_clarification": "взятый без разбора"
                            },
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "незнакомый или выбранный случайно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任意",
                                "target_lang_sense_clarification": "没有特定选择标准"
                            },
                            {
                                "target_lang_word": "随便",
                                "target_lang_sense_clarification": "不加挑选地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5aec473-ec89-32b4-83de-eebeab6bab35",
                    "sense_definition": "Being part of a varied, unrelated, and apparently arbitrary collection of things; diverse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diverse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My notebook has turned into a <w>random</w> collection of thoughts and sketches.",
                            "target_lang_translations": {
                                "ru": "Мой блокнот превратился в <w>разрозненное</w> собрание мыслей и набросков.",
                                "zh": "我的笔记本变成了一堆<w>零散</w>的想法和草图。"
                            }
                        },
                        {
                            "text": "I brought a bunch of <w>random</w> snacks to the party since I was in a hurry.",
                            "target_lang_translations": {
                                "ru": "Я принес на вечеринку кучу <w>всяких</w> закусок, так как очень спешил.",
                                "zh": "因为走得急，我带了一堆<w>杂七杂八</w>的零食去聚会。"
                            }
                        }
                    ],
                    "antonyms": [
                        "organized",
                        "uniform"
                    ],
                    "common_phrases": [
                        "random collection",
                        "random assortment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся частью разнообразной, несвязанной и, по-видимому, произвольной коллекции вещей; разнообразный.",
                        "zh": "属于各种各样、互不相关且看似随意的集合；多样化的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрозненный",
                                "target_lang_sense_clarification": "не связанный между собой"
                            },
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "о наборе предметов"
                            },
                            {
                                "target_lang_word": "всякий",
                                "target_lang_sense_clarification": "разнообразный и мелкий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杂乱",
                                "target_lang_sense_clarification": "缺乏组织和关联"
                            },
                            {
                                "target_lang_word": "零散",
                                "target_lang_sense_clarification": "不成体系的集合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02cd9241-5b09-3c07-9b9e-f12f33f3c8d3",
                    "sense_definition": "Involving an outcome which is impossible to predict, but which may be represented by a probability distribution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "statistical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper conducted a <w>random</w> sample of five hundred teenagers for the survey.",
                            "target_lang_translations": {
                                "ru": "Газета провела <w>случайную</w> выборку из пятисот подростков для опроса.",
                                "zh": "报社为这项调查对五百名青少年进行了<w>随机</w>抽样。"
                            }
                        },
                        {
                            "text": "The flip of a fair coin is a purely <w>random</w> event.",
                            "target_lang_translations": {
                                "ru": "Подбрасывание честной монеты — это чисто <w>случайное</w> событие.",
                                "zh": "抛掷一枚公平的硬币是一个纯粹的<w>随机</w>事件。"
                            }
                        }
                    ],
                    "antonyms": [
                        "deterministic",
                        "biased"
                    ],
                    "common_phrases": [
                        "random sample",
                        "random variable"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с исходом, который невозможно предсказать, но который может быть представлен распределением вероятностей.",
                        "zh": "涉及无法预测但可以用概率分布表示的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "математический термин"
                            },
                            {
                                "target_lang_word": "рандомный",
                                "target_lang_sense_clarification": "статистический контекст"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随机",
                                "target_lang_sense_clarification": "统计学或数学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54cc8680-03cc-323e-86de-e7d71d96b657",
                    "sense_definition": "Lacking context, relevance, or any connection to the previous situation; unexpected.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "out_of_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>random</w> guy just came up to me to say he liked my shoes.",
                            "target_lang_translations": {
                                "ru": "<w>Какой-то</w> парень просто подошел ко мне сказать, что ему нравятся мои туфли.",
                                "zh": "有个<w>不认识</w>的家伙突然走过来跟我说他喜欢我的鞋子。"
                            }
                        },
                        {
                            "text": "Thank you for that completely <w>random</w> comment, but let's get back to the topic.",
                            "target_lang_translations": {
                                "ru": "Спасибо за этот совершенно <w>неуместный</w> комментарий, но давайте вернемся к теме.",
                                "zh": "谢谢你那句完全<w>没头没脑</w>的评论，但我们还是回到正题吧。"
                            }
                        }
                    ],
                    "antonyms": [
                        "relevant"
                    ],
                    "common_phrases": [
                        "random guy",
                        "random comment"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный контекста, уместности или какой-либо связи с предыдущей ситуацией; неожиданный.",
                        "zh": "缺乏语境、关联性或与前文无关；出乎意料的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуместный",
                                "target_lang_sense_clarification": "не к месту"
                            },
                            {
                                "target_lang_word": "левый",
                                "target_lang_sense_clarification": "посторонний, сленг"
                            },
                            {
                                "target_lang_word": "какой-то",
                                "target_lang_sense_clarification": "неизвестный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突兀",
                                "target_lang_sense_clarification": "不合时宜或突然"
                            },
                            {
                                "target_lang_word": "没头没脑",
                                "target_lang_sense_clarification": "指言语缺乏逻辑或关联"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76c53019-ebf8-3761-b3bf-82613afe4dfc",
                    "sense_definition": "Being out of the ordinary; unusual or unexpected; odd, strange, or bizarre.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "strange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is a rather <w>random</w> fact to share during a business meeting.",
                            "target_lang_translations": {
                                "ru": "Это довольно <w>странный</w> факт для обсуждения на деловой встрече.",
                                "zh": "在商务会议上分享这个事实显得相当<w>古怪</w>。"
                            }
                        },
                        {
                            "text": "I can't believe he would say that; it was just so <w>random</w> and weird.",
                            "target_lang_translations": {
                                "ru": "Не верится, что он это сказал; это было так <w>неожиданно</w> и странно.",
                                "zh": "真不敢相信他会那么说；那真是太<w>离奇</w>且奇怪了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ordinary",
                        "predictable"
                    ],
                    "common_phrases": [
                        "random fact"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выходящий за рамки обычного; необычный или неожиданный; странный или причудливый.",
                        "zh": "超出寻常；不寻常或出乎意料；奇怪或古怪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "странный",
                                "target_lang_sense_clarification": "необычный"
                            },
                            {
                                "target_lang_word": "неожиданный",
                                "target_lang_sense_clarification": "внезапный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古怪",
                                "target_lang_sense_clarification": "行为或事实不寻常"
                            },
                            {
                                "target_lang_word": "离奇",
                                "target_lang_sense_clarification": "非常奇怪且出人意料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6235c390-7df5-3c15-b8ba-00f6e700d45a",
                    "sense_definition": "Of a person: characterized by saying unexpected things or using non sequiturs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are so <w>random</w> that I never know what you are going to do next.",
                            "target_lang_translations": {
                                "ru": "Ты такой <w>непредсказуемый</w>, что я никогда не знаю, что ты сделаешь в следующий момент.",
                                "zh": "你太<w>不可预测</w>了，我永远不知道你下一步要做什么。"
                            }
                        },
                        {
                            "text": "He is known for being <w>random</w> and making everyone laugh with his odd jokes.",
                            "target_lang_translations": {
                                "ru": "Он известен своей <w>эксцентричностью</w> и тем, что смешит всех своими странными шутками.",
                                "zh": "他以<w>跳脱</w>的性格著称，总能用那些古怪的笑话逗得大家大笑。"
                            }
                        }
                    ],
                    "antonyms": [
                        "consistent"
                    ],
                    "common_phrases": [
                        "so random"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О человеке: склонный говорить неожиданные вещи или использовать фразы, не связанные с темой.",
                        "zh": "指人：以言行出人意料或逻辑跳跃为特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непредсказуемый",
                                "target_lang_sense_clarification": "о поведении человека"
                            },
                            {
                                "target_lang_word": "странный",
                                "target_lang_sense_clarification": "со своими причудами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不可预测",
                                "target_lang_sense_clarification": "行为难以预料"
                            },
                            {
                                "target_lang_word": "跳脱",
                                "target_lang_sense_clarification": "思维或言行不按常理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64ed236f-e0a4-3072-8b08-ca5dd8472740",
                    "sense_definition": "Mimicking the result of random selection; pseudorandom.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer function generates a <w>random</w> number based on a specific seed.",
                            "target_lang_translations": {
                                "ru": "Компьютерная функция генерирует <w>случайное</w> число на основе определенного значения.",
                                "zh": "计算机函数根据特定的种子生成一个<w>伪随机</w>数。"
                            }
                        },
                        {
                            "text": "We need a <w>random</w> sequence of digits for the security encryption.",
                            "target_lang_translations": {
                                "ru": "Нам нужна <w>случайная</w> последовательность цифр для защитного шифрования.",
                                "zh": "我们需要一串<w>随机</w>数字来进行安全加密。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "random number",
                        "random generator"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имитирующий результат случайного выбора; псевдослучайный.",
                        "zh": "模拟随机选择的结果；伪随机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "о числах в программировании"
                            },
                            {
                                "target_lang_word": "псевдослучайный",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伪随机",
                                "target_lang_sense_clarification": "计算机科学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8954d3a-75a4-3368-8031-c42b384b6f4a",
                    "sense_definition": "An undefined, unknown, or unimportant person; a person of no consequence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party was boring because it was full of <w>randoms</w> I didn't know.",
                            "target_lang_translations": {
                                "ru": "Вечеринка была скучной, потому что там было полно <w>незнакомых людей</w>, которых я не знал.",
                                "zh": "聚会很无聊，因为到处都是我不认识的<w>路人</w>。"
                            }
                        },
                        {
                            "text": "I don't want a bunch of <w>randoms</w> showing up at our private event.",
                            "target_lang_translations": {
                                "ru": "Я не хочу, чтобы на нашем частном мероприятии появилась куча <w>посторонних</w>.",
                                "zh": "我不希望一堆<w>陌生人</w>出现在我们的私人活动上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rando",
                        "nobody",
                        "nonentity"
                    ],
                    "antonyms": [
                        "celebrity",
                        "somebody"
                    ],
                    "common_phrases": [
                        "full of randoms"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопределенный, неизвестный или неважный человек; человек, не имеющий значения.",
                        "zh": "未定义的、未知的或不重要的人；无名小卒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "левый чел",
                                "target_lang_sense_clarification": "незнакомец, сленг"
                            },
                            {
                                "target_lang_word": "случайный человек",
                                "target_lang_sense_clarification": "посторонний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陌生人",
                                "target_lang_sense_clarification": "不认识的人"
                            },
                            {
                                "target_lang_word": "路人",
                                "target_lang_sense_clarification": "无关紧要的普通人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "784b5676-5126-3bec-a4b2-2676c92cf2e0",
                    "sense_definition": "A roving motion; course without definite direction; lack of rule or method.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrows were sent at <w>random</w> into the air without a target.",
                            "target_lang_translations": {
                                "ru": "Стрелы были пущены <w>наугад</w> в воздух, без цели.",
                                "zh": "箭被<w>随意</w>地射向空中，没有目标。"
                            }
                        },
