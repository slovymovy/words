                ],
                "senses": [
                    {
                        "sense_id": "1dc587ae-49ef-3bdc-a1f9-4313b39d5753",
                        "entry_id": "7ee0f6ff-cd4a-35da-a08a-aed0f668b298",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e1f9a2-371f-4899-98ce-9803348e7461",
                                "sense_id": "1dc587ae-49ef-3bdc-a1f9-4313b39d5753",
                                "text": "Der Holzwarth trägt nie die Schals, die die Holzwarth ihm strickt."
                            },
                            {
                                "example_id": "cf8a5e9e-ebed-4276-82f6-53238dc9a1f4",
                                "sense_id": "1dc587ae-49ef-3bdc-a1f9-4313b39d5753",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Holzwarth kommt, geht der Herr Holzwarth.“"
                            },
                            {
                                "example_id": "072acea9-1f85-455c-84f1-5e0db43a72ae",
                                "sense_id": "1dc587ae-49ef-3bdc-a1f9-4313b39d5753",
                                "text": "Holzwarth kommt und geht."
                            },
                            {
                                "example_id": "f08ab416-9a71-4e62-9699-8fa28c42b33e",
                                "sense_id": "1dc587ae-49ef-3bdc-a1f9-4313b39d5753",
                                "text": "Holzwarths kamen, sahen und siegten."
                            },
                            {
                                "example_id": "10020013-1113-4337-9379-ec71448dad8b",
                                "sense_id": "1dc587ae-49ef-3bdc-a1f9-4313b39d5753",
                                "text": "Frau Holzwarth ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "48854fd3-76be-486d-ad66-96dae61c2af3",
                                "sense_id": "1dc587ae-49ef-3bdc-a1f9-4313b39d5753",
                                "text": "Herr Holzwarth wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2966aa8c-2eae-4d9c-bdcf-e421940d1394",
                                "sense_id": "1dc587ae-49ef-3bdc-a1f9-4313b39d5753",
                                "text": "Die Holzwarths fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
