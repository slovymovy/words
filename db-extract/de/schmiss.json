                ],
                "senses": [
                    {
                        "sense_id": "acff85ad-6db9-331f-ba60-94425d4feb02",
                        "entry_id": "f318cba9-c8e4-3ba0-ad37-b4b802b15133",
                        "glosses": [
                            "bei einer Mensur davongetragene Verletzung und die daraus entstandene Narbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ac39b1-fed0-42d6-bd91-872e374bb060",
                                "sense_id": "acff85ad-6db9-331f-ba60-94425d4feb02",
                                "text": "Der Paukant wurde auf Schmiss abgeführt."
                            },
                            {
                                "example_id": "8bb40a2d-69b5-4d91-aded-48bc8120befc",
                                "sense_id": "acff85ad-6db9-331f-ba60-94425d4feb02",
                                "text": "Schulte-Noelle trägt einen respektablen Schmiss im Gesicht."
                            },
                            {
                                "example_id": "f5d62a23-9e10-4677-858b-182b60f8fa9d",
                                "sense_id": "acff85ad-6db9-331f-ba60-94425d4feb02",
                                "text": "„Der Student mit den Schmissen verlangt kurz und knapp einen blauen Trenchcoat.“"
                            },
                            {
                                "example_id": "e5ca769c-7ad1-4243-a13d-db5eceed7ffc",
                                "sense_id": "acff85ad-6db9-331f-ba60-94425d4feb02",
                                "text": "„Die dürften sich nicht mucksen, sonst wär die Mensur ungültig, so, ohne Betäubung die Schmisse zunähen.“"
                            },
                            {
                                "example_id": "0547711b-228c-43b1-aa80-5c2fbbced62b",
                                "sense_id": "acff85ad-6db9-331f-ba60-94425d4feb02",
                                "text": "„Der Herr mit den Schmissen und der Empörung wurde von seinen Bekannten auf den Stuhl gezogen und beschwichtigt.“"
                            },
                            {
                                "example_id": "b73a9bd2-2f6b-4eec-846b-ff9be55a0e8a",
                                "sense_id": "acff85ad-6db9-331f-ba60-94425d4feb02",
                                "text": "„Schulz, ein kleiner, schmächtiger Mann, der in seinen Schnurrbart nuschelte und einen tiefen Schmiss quer über den Mund hatte, drückte sich so gewunden aus, dass es manchmal schwer war, ihm zu folgen;…“"
                            },
                            {
                                "example_id": "680b7eb9-7f15-44e4-b2a7-ecbd9bf0cd6b",
                                "sense_id": "acff85ad-6db9-331f-ba60-94425d4feb02",
                                "text": "„Sein Gesicht ist ausgeheilt, die Pflasterstreifen sind weg. Ein paar Schmisse sind übriggeblieben, die er stolz wie ein Korpsstudent zur Schau trägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "150527ed-26ce-3215-8525-b7c1a90a0e5a",
                        "entry_id": "f318cba9-c8e4-3ba0-ad37-b4b802b15133",
                        "glosses": [
                            "lange Wunde, Wundverletzung (meist im Gesicht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a48e64f4-03ef-4657-a9b0-374971afe935",
                                "sense_id": "150527ed-26ce-3215-8525-b7c1a90a0e5a",
                                "text": "„Der Herr mit den Schmissen und der Empörung wurde von seinen Bekannten auf den Stuhl gezogen und beschwichtigt.“"
                            },
                            {
                                "example_id": "1df891c4-1f12-4501-9e55-0f63ca9100c6",
                                "sense_id": "150527ed-26ce-3215-8525-b7c1a90a0e5a",
                                "text": "„Schulz, ein kleiner, schmächtiger Mann, der in seinen Schnurrbart nuschelte und einen tiefen Schmiss quer über den Mund hatte, drückte sich so gewunden aus, dass es manchmal schwer war, ihm zu folgen;…“"
                            },
                            {
                                "example_id": "2d3979c3-e2cb-4d0b-a17f-2bf8ef03518d",
                                "sense_id": "150527ed-26ce-3215-8525-b7c1a90a0e5a",
                                "text": "„Sein Gesicht ist ausgeheilt, die Pflasterstreifen sind weg. Ein paar Schmisse sind übriggeblieben, die er stolz wie ein Korpsstudent zur Schau trägt.“"
                            },
                            {
                                "example_id": "3a27210c-5fcb-4131-aa1c-3b4cb77fe1c0",
                                "sense_id": "150527ed-26ce-3215-8525-b7c1a90a0e5a",
                                "text": "Beim Rad fahren hat sich dein Sohn ja einen anständigen Schmiss zugezogen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
