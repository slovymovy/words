                                        "glosses": [
                                            "Any small piece of ice used for cooling drinks, larger than crushed ice, and regardless of their shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ce39444-92bf-4239-9b36-1c986fa17d3e",
                                                "sense_id": "2f6135fb-ac43-320b-adda-bddba5ccb067",
                                                "text": "The new freezer in our kitchen makes round ice cubes!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feebbde2-15f4-3b1e-900f-30189db5fd62",
                                        "entry_id": "f0ab5066-2a6d-3513-9818-1d536414342a",
