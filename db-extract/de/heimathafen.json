                        "glosses": [
                            "„Hafen, in dessen Schiffsregister ein Schiff eingetragen ist“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeb2a313-8d00-4244-9452-0375e81d53ee",
                                "sense_id": "ae1e56a7-2f92-340c-a7ca-5e78c61af32d",
                                "text": "„Vom Erlös kaufte er dort Erzeugnisse wie Zuckerrohr und Baumwolle, womit er in die Heimathäfen zurückkehrte.“"
                            }
