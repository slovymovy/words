                                "target_senses": [
                                    {
                                        "sense_id": "d40d7689-2e4f-3f54-a9d4-bc60217323dd",
                                        "entry_id": "58cacd4c-c901-34dc-95c9-44e6a8a0d113",
                                        "glosses": [
                                            "Grand amas d’eau retenu par une chaussée naturelle ou artificielle."
                                        ],
                                        "tags": [
                                            "Limnologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91d5175b-9664-4881-a6ec-785f6ebf001c",
                                                "sense_id": "d40d7689-2e4f-3f54-a9d4-bc60217323dd",
                                                "text": "Tous les étangs gisent gelés,\nMon âme est noire ! où-vis-je ? où vais-je ?"
                                            },
                                            {
                                                "example_id": "d6103dd7-3bcb-4e7c-ac60-2472fa30f2f9",
                                                "sense_id": "d40d7689-2e4f-3f54-a9d4-bc60217323dd",
                                                "text": "[…], après une autre étape de quatre heures, atteignons Souk El-Arbâ (le marché du mercredi), dans un cirque rocheux où les pluies ont formé de nombreux étangs regorgeant d’oiseaux aquatiques : canards, poules d’eau, bécassines, hérons, etc."
                                            },
                                            {
                                                "example_id": "dc6c82aa-5748-4d99-91fd-348b4b7031a7",
                                                "sense_id": "d40d7689-2e4f-3f54-a9d4-bc60217323dd",
                                                "text": "Et le métal doré des eaux éclate lorsque bondissent les bêtes lourdes, dans les étangs."
                                            },
                                            {
                                                "example_id": "dd6a13cf-5eab-42cc-b461-69322d16690f",
                                                "sense_id": "d40d7689-2e4f-3f54-a9d4-bc60217323dd",
                                                "text": "[…] la multitude de tourbières et d’étangs, qui parsèment ce plateau à hydrographie indécise, représente autant de cuvettes d’origine glaciaire donnant à cette région l’aspect triste et désolé d’un paysage finlandais."
                                            },
                                            {
                                                "example_id": "838d5012-0fb8-4c77-b36b-90cb7a214bd0",
                                                "sense_id": "d40d7689-2e4f-3f54-a9d4-bc60217323dd",
                                                "text": "Étang salé, étang qui communique avec la mer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7225a8ca-4d2b-49bd-95a6-7482cc72a666",
                        "source_entry_id": "8eb13108-0791-3d72-ad6d-9c5eb37b0cde",
                        "source_sense_id": "8b79f5cf-9779-3687-bdc8-748957684c1d",
                        "source_sense_description": "tamelijk klein door de mens aangelegd water",
                        "target_lang_word": "пруд",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пруд",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7653d744-9d98-3de3-8788-e76f04a8c088",
                                        "entry_id": "8654ce90-c976-3940-885c-b347cad85f59",
                                        "glosses": [
                                            "сравнительно небольшой искусственный или естественный водоём, например, устроенный путём перегораживания реки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c482b22b-175d-45e4-a24f-118e08d3fc30",
                                                "sense_id": "7653d744-9d98-3de3-8788-e76f04a8c088",
                                                "text": "Возить воду с пруда, топить печи, варить «хлебово», месить резку белому мерину и курить по вечерам с барином махорку ― невелик труд."
                                            },
                                            {
                                                "example_id": "98d6eaa9-6f90-4c42-97bc-3b585349247f",
                                                "sense_id": "7653d744-9d98-3de3-8788-e76f04a8c088",
                                                "text": "Нежданов добрался до пруда; утренний туман с него слетел, но он ещё дымился местами — в тенистых излучинах берегов."
                                            },
                                            {
                                                "example_id": "026f9066-6f2a-4840-845f-a92df975ac32",
                                                "sense_id": "7653d744-9d98-3de3-8788-e76f04a8c088",
                                                "text": "Тушью и красками нарисованы были храмы на горе, амуры, пруд с плавающими лебедями…"
                                            },
                                            {
                                                "example_id": "5a733a7b-43f4-48b7-8b76-1b295b555e61",
                                                "sense_id": "7653d744-9d98-3de3-8788-e76f04a8c088",
                                                "text": "Старичок буфетчик в женской кацавейке рассказывал, как при покойном барине женщина в пруду утопилась."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad858585-a4ff-4daa-adc4-9a1d04870be7",
                        "source_entry_id": "8eb13108-0791-3d72-ad6d-9c5eb37b0cde",
                        "source_sense_id": "8b79f5cf-9779-3687-bdc8-748957684c1d",
