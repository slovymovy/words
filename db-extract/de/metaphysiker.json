                "senses": [
                    {
                        "sense_id": "3841a75b-f3f6-3452-a8b6-57dd888a5eb7",
                        "entry_id": "1c85dcdd-d775-3fb1-9a91-fb5a1d2bcc93",
                        "glosses": [
                            "Philosoph, der sich mit der theoretischen Philosophie, der Metaphysik, beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "959732fb-d833-406a-8797-9d63e37f012e",
                                "sense_id": "3841a75b-f3f6-3452-a8b6-57dd888a5eb7",
                                "text": "Ein bekannter Metaphysiker war der Philosoph Immanuel Kant."
                            },
                            {
                                "example_id": "bf6a9d67-9fe1-4f82-911a-2998fda81383",
                                "sense_id": "3841a75b-f3f6-3452-a8b6-57dd888a5eb7",
                                "text": "„Der junge Studiosus wagte es, sich in eine Diskussion einzuschalten, die die größten Metaphysiker der Neuzeit, Descartes und Leibniz, entzweit hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c787b9d-789b-48c2-8700-c409f1344806",
                        "source_entry_id": "1c85dcdd-d775-3fb1-9a91-fb5a1d2bcc93",
                        "source_sense_id": "3841a75b-f3f6-3452-a8b6-57dd888a5eb7",
                        "source_sense_description": "Philosoph, der sich mit der theoretischen Philosophie, der Metaphysik, beschäftigt",
                        "target_lang_word": "metaphysician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metaphysician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7ecdd65-3869-3ca5-a91e-190817161f23",
                                        "entry_id": "47bed829-7081-31c9-8299-0885da435571",
                                        "glosses": [
                                            "A philosopher who specializes in the scholarly study of metaphysics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b126fc2-80d4-418f-b95f-052035c42cde",
                                                "sense_id": "c7ecdd65-3869-3ca5-a91e-190817161f23",
                                                "text": "Thomas Aquinas was a notable metaphysician."
                                            },
                                            {
                                                "example_id": "ab4799fb-81c6-4e1b-b114-fbad4361eda3",
                                                "sense_id": "c7ecdd65-3869-3ca5-a91e-190817161f23",
                                                "text": "Professor Jones is an eminent metaphysician; she has produced more than one hundred refereed publications concerning metaphysics."
                                            },
                                            {
                                                "example_id": "de3b40c5-438c-4f5e-b0f1-5ab3049cef77",
                                                "sense_id": "c7ecdd65-3869-3ca5-a91e-190817161f23",
                                                "text": "Now it so happened that Francis was Mrs. Clarke's favourite: whether from having seen the least of him, or from the great difference between them—two common causes of liking—or because she felt some sort of vanity in her near relationship to so very fine a gentleman, are points too curious to be decided by any but a metaphysician."
                                            },
                                            {
                                                "example_id": "53dac55e-7229-471f-a27e-1d224084c15d",
                                                "sense_id": "c7ecdd65-3869-3ca5-a91e-190817161f23",
                                                "text": "PROPOSITION IV."
                                            },
                                            {
                                                "example_id": "bc3523a3-70a8-4455-a42a-1d7ccd2065c5",
                                                "sense_id": "c7ecdd65-3869-3ca5-a91e-190817161f23",
                                                "text": "In 1928 Heidegger succeeded Husserl to take a chair at Freiburg and in his inaugural lecture made a pronouncement that earned him a reputation as an archetypal metaphysician with his claim that our awareness of people as a whole depends on our experience of dread in the face of nothingness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9b3f283-fee6-449e-abb5-2c43e4977ce0",
                        "source_entry_id": "1c85dcdd-d775-3fb1-9a91-fb5a1d2bcc93",
                        "source_sense_id": "3841a75b-f3f6-3452-a8b6-57dd888a5eb7",
                        "source_sense_description": "Philosoph, der sich mit der theoretischen Philosophie, der Metaphysik, beschäftigt",
                        "target_lang_word": "métaphysicien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métaphysicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44d224d0-c121-372a-ace3-c74ed159e0bc",
                                        "entry_id": "0e52dd66-67fb-37f8-9931-d81c4aa97a4e",
                                        "glosses": [
                                            "Qui participe de la métaphysique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b94c8f82-4aab-4efa-988f-5cd1098b90e8",
                                                "sense_id": "44d224d0-c121-372a-ace3-c74ed159e0bc",
                                                "text": "Réaumur, plus observateur et moins métaphysicien que son disciple, fut beaucoup plus embarrassé. Il proposa plusieurs hypothèses, sans s’arrêter sérieusement à aucune. L’une d’elles est au moins ingénieuse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "métaphysicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9396c642-4e76-30a8-9644-12ff1607655a",
                                        "entry_id": "d6e647e8-77a0-3ae3-9d38-29f204ff3e6e",
                                        "glosses": [
                                            "Celui qui fait son étude de la métaphysique, celui qui étudie la science de l'«être»."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fab87f7-2717-4cf9-8168-115f02ecf5dd",
                                                "sense_id": "9396c642-4e76-30a8-9644-12ff1607655a",
                                                "text": "Entre les grands systèmes de philosophie que l'Orient et l'Occident ont enfantés, il n'en est pas un qui n'ait eu cours à la Chine. Ce que nous connaissons de ses métaphysiciens suffit à nous en convaincre, et cependant nous sommes loin de les connaître tous."
                                            },
                                            {
                                                "example_id": "88972c82-902f-4730-9be7-04ea81d4b408",
                                                "sense_id": "9396c642-4e76-30a8-9644-12ff1607655a",
                                                "text": "Savez-vous qu’il n’y a guère plus de huit ou neuf cents ans que les métaphysiciens ont consenti pour la première fois à délivrer le peuple de cette étrange idée : qu’il n’existait que deux routes praticables conduisant à la Vérité ?"
                                            },
                                            {
                                                "example_id": "dce97236-5dba-4216-a6cc-0d92d63dce3f",
                                                "sense_id": "9396c642-4e76-30a8-9644-12ff1607655a",
                                                "text": "Toute la métaphysique d'Aristote est conditionnée par la nécessité d'échapper au monisme du Père des Métaphysiciens, de Parménide."
                                            },
                                            {
                                                "example_id": "4227383a-e370-444b-9a6f-8daba59f7084",
                                                "sense_id": "9396c642-4e76-30a8-9644-12ff1607655a",
                                                "text": "Dans un discours du 11 mai 1907, à la Chambre des députés, Jaurès m'a appelé le « métaphysicien du syndicalisme », sans aucun doute avec une intention ironique."
                                            },
                                            {
                                                "example_id": "9db2bb7d-f31d-4f8b-82d2-4b2800f48c8c",
                                                "sense_id": "9396c642-4e76-30a8-9644-12ff1607655a",
                                                "text": "L’idée de ces valeurs abstraites, conçues en tant qu’abstraites, n’est nullement, comme certains le prétendent, une idée que des métaphysiciens prêtent gratuitement à la conscience humaine. Elle lui est consubstantielle et l’on a l’une dès qu’on a l’autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
