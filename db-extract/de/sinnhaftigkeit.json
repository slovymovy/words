                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932f0c7b-bf55-4878-b339-f14504ef03fd",
                                "sense_id": "489178f2-8db7-3d9b-a964-13c815792e53",
                                "text": "„Die republikanischen Senatoren John McCain und Lindsey stellten die Sinnhaftigkeit der Anordnung infrage.“"
                            },
                            {
                                "example_id": "70eb6312-cfa1-4951-a1ce-4200bc538cda",
                                "sense_id": "489178f2-8db7-3d9b-a964-13c815792e53",
                                "text": "„Den Wegen so beschriebener Ungereimtheiten nachzugehen und die eigentliche, ehedem wohl vorhandene Sinnhaftigkeit der Namensgebung aufzuspüren, ist wiederum Aufgabe der Etymologie, auch wenn diese nicht in allen Fällen eine befriedigende Lösung bereitstellen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
