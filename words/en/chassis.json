                    "frequency": "Low",
                    "semantic_group_id": "mechanical_frame",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy artillery piece was mounted on a rotating <w>chassis</w> for better aim.",
                            "target_lang_translations": {
