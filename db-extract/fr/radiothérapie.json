        "fr-extract.jsonl": [
            {
                "entry_id": "a847d708-fb4f-3757-ba92-ffc6f2265554",
                "word": "radiothérapie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f17493e-a80a-4167-a62c-75e76cfd28c7",
                        "entry_id": "a847d708-fb4f-3757-ba92-ffc6f2265554",
                        "tags": [
                            "plural"
                        ],
                        "form": "radiothérapies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ccc10099-73ab-3270-b548-e65e19873867",
                        "entry_id": "a847d708-fb4f-3757-ba92-ffc6f2265554",
                        "glosses": [
                            "Méthode thérapeutique fondée sur l’action des radiations, lumineuses ou autres, et particulièrement des rayons X."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6735caf9-43bc-4751-bffd-09749b3b92f6",
                                "sense_id": "ccc10099-73ab-3270-b548-e65e19873867",
                                "text": "Il s’acharnera au travail, il ne ménagera ni son temps, ni ses forces, à une époque où le radium et la radiothérapie profonde était encore inconnue."
                            },
                            {
                                "example_id": "dee66f8d-230d-48db-b68e-938dcbd8d2f1",
                                "sense_id": "ccc10099-73ab-3270-b548-e65e19873867",
                                "text": "En outre, la distinction opérable / inopérable se complique, certains cancers inopérables peuvent devenir accessibles à l’exérèse si celle-ci est couplée à la radiothérapie."
                            },
                            {
                                "example_id": "e0217e09-0dd7-42c2-9376-ebeaaf26e4fd",
                                "sense_id": "ccc10099-73ab-3270-b548-e65e19873867",
                                "text": "Les perforations sont rares, de 0,1 à 0,3 % des procédures, avec un risque majoré en cas d’entéroscopie par voie basse, de sténose liée à une maladie de Crohn, d’anastomose intestinale récente ou de lymphome traité par radiothérapie."
                            }
                        ]
                    }
                ],
