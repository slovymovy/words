                "senses": [
                    {
                        "sense_id": "6acd3dfa-85aa-3ac2-8211-e297c7c9143e",
                        "entry_id": "d4d589ad-1df8-3a8c-9815-fede846e4033",
                        "glosses": [
                            "alle middelen opeisend en verbruikend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f36dc68e-79d1-4803-977f-3533009f55c4",
                                "sense_id": "6acd3dfa-85aa-3ac2-8211-e297c7c9143e",
                                "text": "Hij vond helemaal geen woorden meer, er was alleen nog die allesverslindende leegte."
                            },
                            {
                                "example_id": "04c968db-9b57-4232-a427-0642a9af9cdb",
                                "sense_id": "6acd3dfa-85aa-3ac2-8211-e297c7c9143e",
                                "text": "Ondertussen had het kleine landje, zeker in vergelijking met de allesverslindende hectiek van het moderne Amerika, nog altijd de rustige landelijke charme van vroeger."
                            },
                            {
                                "example_id": "4eac1d6d-56f0-4c37-84ae-7def91a69791",
                                "sense_id": "6acd3dfa-85aa-3ac2-8211-e297c7c9143e",
                                "text": "Verder stelt het CDA voor te snijden in toeslagen en uitgaven van de overheid. \"De grenzen van de groei van de overheid zijn bereikt. Het is een allesverslindend monster geworden.\""
                            }
                        ]
                    }
