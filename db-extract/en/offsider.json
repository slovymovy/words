                        "examples": [
                            {
                                "example_id": "4558db94-913d-47bf-85c2-834e444b4a42",
                                "sense_id": "56839c97-100f-301e-906f-788d9e0db26a",
                                "text": "Kidman, riding hell for leather and carrying a heavy stockwhip, caught up with him soon after, or rather with his offsider, who was tailing the mob, and demanded an explanation for their trespassing.\n“Don′t ask me,” said the offsider. “You see the boss.”"
                            },
                            {
                                "example_id": "fb0038ba-4152-455a-a78f-ad32a97fe796",
                                "sense_id": "56839c97-100f-301e-906f-788d9e0db26a",
                                "text": "With the 2005 incarnation of Temptation, Livinia Nixon has completed the trifecta of TV seconds: variety offsider, game show hostess and weather girl."
                            },
                            {
                                "example_id": "31985cfe-032c-43fd-bb49-68008cf68124",
                                "sense_id": "56839c97-100f-301e-906f-788d9e0db26a",
                                "text": "Tom also brought an offsider. I will never forget the look on the faces of the airline staff when Big Tony hauled his shooter out and slammed it on the counter. Tom and his sidekick did the same. I couldn′t believe these blokes were armed and how cool everyone was about it."
                            }
                        ]
                    }
