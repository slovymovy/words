                        "source_sense_id": "2ed22556-7e4f-34ab-abeb-f313a9c73aff",
                        "source_sense_description": "toestand waarin men niet is staat is zich te bewegen",
                        "target_lang_word": "Lähmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lähmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5077154-d27c-367e-ace9-e8ba87244067",
                                        "entry_id": "5bd8156c-1f71-3f75-a14a-d5a748d6a73b",
                                        "glosses": [
                                            "anteiliger oder kompletter Funktionsverlust eines Körperteils oder Organsystems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94c94eaf-f665-4871-92d9-70c081607990",
                                                "sense_id": "b5077154-d27c-367e-ace9-e8ba87244067",
                                                "text": "Eine Tetanusinfektion kann zu Lähmungen führen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62614792-67cd-396c-9a41-e6da96dcb164",
                                        "entry_id": "5bd8156c-1f71-3f75-a14a-d5a748d6a73b",
                                        "glosses": [
                                            "verringerte Funktion der Nerven, mit Ausfällen des Empfindens und der Bewegungsfähigkeit"
                                        ],
                                        "tags": [
                                            "Neurologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92bd1a31-3abf-4d0a-8de1-dbb5b4bdd79f",
                                                "sense_id": "62614792-67cd-396c-9a41-e6da96dcb164",
                                                "text": "„Der Schmerz wächst, ich bekomme heftiges Fieber bis zum Schüttelfrost, eine Lähmung tritt hinzu, die die linke Körperseite erfaßt; ich kann meinen Arm nicht mehr bewegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5ba52a28-14fc-31bf-a16f-6691d963df8c",
                                        "entry_id": "5bd8156c-1f71-3f75-a14a-d5a748d6a73b",
                                        "glosses": [
                                            "Zustand, in dem sich in einem System nichts verändert, es nicht mehr funktioniert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3632bddc-d4b8-4b8b-a382-be7226f25a84",
                                                "sense_id": "5ba52a28-14fc-31bf-a16f-6691d963df8c",
                                                "text": "„Tatsächlich markieren die beiden Personalien das nahe Ende einer fast zweijährigen Lähmung der polnischen Innenpolitik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e48b5d7d-96ec-4e12-8914-fb4b8d7b1cc1",
                        "source_entry_id": "75c55181-6d8a-33c7-a1eb-cf123b20515b",
                        "source_sense_id": "2ed22556-7e4f-34ab-abeb-f313a9c73aff",
                        "source_sense_description": "toestand waarin men niet is staat is zich te bewegen",
                        "target_lang_word": "paralysis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralysis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43eab8b7-13f8-3401-9ac7-4ff9975cc069",
                                        "entry_id": "27d1537d-1d85-3f3a-9d17-249776620a57",
                                        "glosses": [
                                            "The complete loss of voluntary control of part of a person's body, such as one or more limbs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6dd4260-1315-39cb-a1ef-54323c61ee4b",
                                        "entry_id": "27d1537d-1d85-3f3a-9d17-249776620a57",
                                        "glosses": [
                                            "A state of being unable to act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23c34aa0-be1d-405e-b40b-2bf213653747",
                                                "sense_id": "c6dd4260-1315-39cb-a1ef-54323c61ee4b",
                                                "text": "The government has been in a paralysis since it lost its majority in the parliament."
                                            },
                                            {
                                                "example_id": "c8dfcf14-d1c0-47b9-9bf7-f2e063aae35b",
                                                "sense_id": "c6dd4260-1315-39cb-a1ef-54323c61ee4b",
                                                "text": "Until then, the Sunak administration remains a study in ineffectuality on multiple fronts, leading Goldsmith to cite, not unreasonably, “a kind of paralysis”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27c9a0da-f50a-45f5-96b3-f7ffb088f728",
                        "source_entry_id": "75c55181-6d8a-33c7-a1eb-cf123b20515b",
                        "source_sense_id": "2ed22556-7e4f-34ab-abeb-f313a9c73aff",
                        "source_sense_description": "toestand waarin men niet is staat is zich te bewegen",
                        "target_lang_word": "paralysie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralysie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "971cc542-1236-36ea-a8b7-bbc0a030a456",
                                        "entry_id": "5a63d2b9-2208-3519-997b-b6672f8d694a",
                                        "glosses": [
                                            "Privation ou diminution considérable de la sensibilité et du mouvement volontaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40734761-3d1d-4ef1-a27a-589c5bb1fa13",
                                                "sense_id": "971cc542-1236-36ea-a8b7-bbc0a030a456",
                                                "text": "Puis, vers la fin de cette année, le bonhomme fut enfin, à l’âge de quatre-vingt-deux ans, pris par une paralysie qui fit de rapides progrès."
                                            },
                                            {
                                                "example_id": "487309b2-19f9-4a2c-9d02-2f1599bffc6c",
                                                "sense_id": "971cc542-1236-36ea-a8b7-bbc0a030a456",
                                                "text": "J'ai souvenance du cas d'un de mes camarades d'étude, qui, à l'âge de 18 ans, racolé un soir sur nos grands boulevards par une professionnelle, contracta d'elle la syphilis et mourut dix ans plus tard d'une paralysie générale due à cette infection."
                                            },
                                            {
                                                "example_id": "ad9df453-759f-4a78-945d-6248c8159135",
                                                "sense_id": "971cc542-1236-36ea-a8b7-bbc0a030a456",
                                                "text": "Marcoul reposait de si étrange façon qu'elle courut chercher l’officier de santé au village, mais c'était vain de lui poser des sangsues derrière les oreilles et de lui inciser les lobes : la paralysie avait envahi les deux côtés du corps."
                                            },
                                            {
                                                "example_id": "215685ef-5d01-4dba-aea8-2f5a4e224f91",
                                                "sense_id": "971cc542-1236-36ea-a8b7-bbc0a030a456",
                                                "text": "En août, Proust apprend le suicide par pendaison, à Londres, d'Emmanuel Bibesco qui souffrait de paralysie faciale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "447158fe-bac2-42ce-8b0d-072f21936160",
                        "source_entry_id": "75c55181-6d8a-33c7-a1eb-cf123b20515b",
