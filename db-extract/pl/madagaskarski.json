                        "translation_id": "28ab63e8-10ef-4910-aef9-8ca14fb4dea0",
                        "source_entry_id": "96be04fc-4e67-361b-a168-c95ef95b0b2d",
                        "source_sense_id": "685eb38f-875c-35a9-b6aa-bbc9b95a6ab8",
                        "target_lang_word": "malgache",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malgache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ba7e596-a345-3de7-9b84-4e903b393eb7",
                                        "entry_id": "f93f6792-a39a-310b-98f5-dff012285309",
                                        "glosses": [
                                            "Relatif à Madagascar, aux Malgaches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f25e6d-8ba4-4e5a-994a-f5c935661b86",
                                                "sense_id": "7ba7e596-a345-3de7-9b84-4e903b393eb7",
                                                "text": "Les cieux malgaches sont fréquentés par près de 294 espèces d’oiseaux, dont 107 sont endémiques."
                                            },
                                            {
                                                "example_id": "46087380-2992-4299-8dc9-c1c34400f9c6",
                                                "sense_id": "7ba7e596-a345-3de7-9b84-4e903b393eb7",
                                                "text": "Ainsi la géologie ancienne voudrait que l’on fît un groupe indo-malgache et un groupe africano-brésilien."
                                            },
                                            {
                                                "example_id": "c3173bf3-52b0-4cac-88bf-5b4f7fb85ef1",
                                                "sense_id": "7ba7e596-a345-3de7-9b84-4e903b393eb7",
                                                "text": "Elie montra à Hoffmeister un communiqué paru dans Le Courrier, selon lequel un agent de la Sécurité malgache avait été décoré."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "malgache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cd620ea-e7ec-3d9f-81ed-3450ffb3de7b",
                                        "entry_id": "6c15d0d2-87b0-3310-b3fd-0e2c5789b9a3",
                                        "glosses": [
                                            "À la façon des Malgaches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b6d60a9-89b0-4b2b-8f5e-681d04bcf6e5",
                                                "sense_id": "3cd620ea-e7ec-3d9f-81ed-3450ffb3de7b",
                                                "text": "Il parle malgache."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "malgache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "914de2cf-dc94-3696-8f6e-21d3c9875de7",
                                        "entry_id": "ee7bbd6e-5e0e-32d5-8ca9-99a078d39b86",
                                        "glosses": [
                                            "Langue malayo-polynésienne parlée à Madagascar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8696e750-9692-4251-afb8-a6e16d59e746",
                                                "sense_id": "914de2cf-dc94-3696-8f6e-21d3c9875de7",
                                                "text": "Contrairement à une idée reçue, les apports africains sont négligeables. Par contre les emprunts – aux langues caraïbes, au malgache, au portugais selon les cas - sont plus importants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
