                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "eca690fa-4650-49c7-9870-c7a2bde16cdc",
                                "sense_id": "a0b8288b-c19a-34c9-a242-1cc3863ef1db",
                                "text": "- Oh! oh! cher père, interrompit Gustave, ce mais me fait l’effet d’une tache d’huile prête à gâter votre belle page d’éloge. Je le sentais arriver ; pardonnez-moi de lui avoir barré le passage, et permettez-moi de vous le dire : l’éloge d’Antoine ne comporte pas de mais correctif, diminutif, adversif."
                            },
                            {
                                "example_id": "38ac0807-aade-443d-a444-d55814b6ef22",
                                "sense_id": "a0b8288b-c19a-34c9-a242-1cc3863ef1db",
                                "text": "Le « mouvement vers » adversif oppose l’individu au groupe et le réduit à des conduites de jungle."
                            },
                            {
                                "example_id": "538749cd-90e3-4669-8679-961e64ad513a",
                                "sense_id": "a0b8288b-c19a-34c9-a242-1cc3863ef1db",
                                "text": "L’esprit de résistance lui aussi a des origines intellectuelles et morales. Au-delà du réflexe adversif de sauvegarde, il est un phénomène de culture."
                            }
                        ]
                    }
