                                "target_senses": [
                                    {
                                        "sense_id": "df31ed70-3a36-39c2-9095-e3e3db2f657b",
                                        "entry_id": "3bbb60dd-a92e-3e7f-a65d-06394054a66b",
                                        "glosses": [
                                            "die Nennung wert sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd814792-5016-49c5-b872-611cf50df530",
                                                "sense_id": "df31ed70-3a36-39c2-9095-e3e3db2f657b",
                                                "text": "Alle anderen Leistungen sind nicht nennenswert."
                                            },
                                            {
                                                "example_id": "9f5c1689-3884-486e-b8db-3639b5627c7f",
                                                "sense_id": "df31ed70-3a36-39c2-9095-e3e3db2f657b",
                                                "text": "„Abgesehen von dem für Ätzmittel erforderlichen Kali verfügt das Deutsche Reich weder über qualitativ nennenswerte noch nachgefragte Rohstoffvorkommen.“"
                                            },
                                            {
                                                "example_id": "d5657196-009f-4aa1-84e4-03cfdbd9f773",
                                                "sense_id": "df31ed70-3a36-39c2-9095-e3e3db2f657b",
                                                "text": "„Der letzte nennenswerte Impuls, der von einem Tennisplatz kam, waren die T-Shirts der Russin Anna Kurnikowa. Aus pastellfarbenem Stretchstoff und bauchfrei.“"
                                            },
                                            {
                                                "example_id": "4b0a7b1f-98d3-48c8-8884-b09c3583ac1a",
                                                "sense_id": "df31ed70-3a36-39c2-9095-e3e3db2f657b",
                                                "text": "„Stickstoff ist aufgrund der hohen Bindungsenergie der N₂-Moleküle sehr reaktionsträge; er reagiert erst bei Temperaturen von mehreren Hundert Grad mit nennenswerter Geschwindigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a1256f8-c773-4025-acea-aafebb3edb26",
                        "source_entry_id": "0e9fdd8e-0c88-3ffd-8046-2020e61729b7",
