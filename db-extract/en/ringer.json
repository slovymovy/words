            {
                "entry_id": "73df4574-0b37-33c3-ad7a-4e5e45520843",
                "word": "Ringer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "844b7bd7-22af-421d-82c2-23ab6a3c7179",
                        "entry_id": "73df4574-0b37-33c3-ad7a-4e5e45520843",
                        "tags": [
                            "plural"
                        ],
                        "form": "Ringers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2ffdabb-2efe-397e-8601-4ecc88787889",
                        "entry_id": "73df4574-0b37-33c3-ad7a-4e5e45520843",
                        "glosses": [
                            "A fan of the novel The Lord of the Rings by J. R. R. Tolkien and/or the film trilogy based on it."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "daf848b8-8469-4e36-9eb8-00f7dbde9068",
                                "sense_id": "c2ffdabb-2efe-397e-8601-4ecc88787889",
                                "text": "Readers flocked online to articulate their angst, discovering 400 websites where \"Ringers\" congregated to converse in Quenya – one of Tolkien's fictional languages – and discuss such burning issues as whether elves have pointy ears."
                            },
                            {
                                "example_id": "731a55df-b5ad-4e6b-8145-7a583dffd691",
                                "sense_id": "c2ffdabb-2efe-397e-8601-4ecc88787889",
                                "text": "One Ringer travels all over and takes pictures of her \"Lord of the Rings\" figurines."
                            },
                            {
                                "example_id": "fbf57e4d-c9b4-4a9a-810a-4ddf8d8778a8",
                                "sense_id": "c2ffdabb-2efe-397e-8601-4ecc88787889",
                                "text": "Trekkers, Whovians and Ringers were out in force over the weekend as sci-fi and fantasy fans descended on Cardiff for the city's Film and Comic Convention."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "96d3c459-4ee6-4cfd-b6d5-9d56533efa9d",
                        "source_entry_id": "73df4574-0b37-33c3-ad7a-4e5e45520843",
                        "source_sense_ids": [
                            "c2ffdabb-2efe-397e-8601-4ecc88787889"
                        ],
                        "linkage_type": "synonyms",
                        "word": "Ringnut"
