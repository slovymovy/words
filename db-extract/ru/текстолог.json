                    {
                        "translation_id": "7ee17378-d6ab-4395-9eba-cb9df880959c",
                        "source_entry_id": "d04a1843-4a5e-3a32-a8c6-4fa9067ef7fa",
                        "source_sense_id": "020599b5-b1bc-3438-9a09-1c2a192f522a",
                        "target_lang_word": "textólogo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c0a051be-8698-4cc5-9729-4b8ad0965692",
                        "source_entry_id": "d04a1843-4a5e-3a32-a8c6-4fa9067ef7fa",
                        "source_sense_id": "020599b5-b1bc-3438-9a09-1c2a192f522a",
                        "target_lang_word": "testologo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b93c9a82-d716-4940-ad10-291b6436f025",
                        "source_entry_id": "d04a1843-4a5e-3a32-a8c6-4fa9067ef7fa",
                        "source_sense_id": "020599b5-b1bc-3438-9a09-1c2a192f522a",
                        "target_lang_word": "Textologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Textologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "726a5b59-e703-3084-9d09-65464c6412ec",
                                        "entry_id": "a103ed4b-69fe-35cb-960b-dd6f3847af97",
                                        "glosses": [
                                            "Person, die sich (wissenschaftlich) mit Texten beschäftigt und diese eventuell auch ediert/herausgibt"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87feef16-6a9f-4f82-ad2d-7e0a69c3af48",
                                                "sense_id": "726a5b59-e703-3084-9d09-65464c6412ec",
                                                "text": "„Ein ausschließlich quantitativ arbeitender Textologe kann nur danach trachten, im scheinbaren Chaos des Textes nach Inseln der Stabilität zu suchen, die weder dem Autor noch dem Leser bewusst sind, deren Existenz aber mit bestimmten Methoden erfassbar ist.“"
                                            },
                                            {
                                                "example_id": "788aee01-fe69-4c9a-a692-3537a890c263",
                                                "sense_id": "726a5b59-e703-3084-9d09-65464c6412ec",
                                                "text": "„In einem weiteren Plenarvortrag machte der »Textologe« J. S. Petöfi (Bielefeld) auf die Kulturgebundenheit von Texten aufmerksam und beschäftigte sich mit der Thematik »Was kann die Textlinguistik für den … Unterricht Deutsch als Fremdsprache leisten?«.“"
                                            },
                                            {
                                                "example_id": "2c145e2e-a592-41ba-86ba-52d6db376975",
                                                "sense_id": "726a5b59-e703-3084-9d09-65464c6412ec",
                                                "text": "„Er war auch ein hervorragender Textologe und Redakteur.“"
                                            },
                                            {
                                                "example_id": "5a2f5072-6274-4c89-bd3d-e418383c70b1",
                                                "sense_id": "726a5b59-e703-3084-9d09-65464c6412ec",
                                                "text": "„Wohl war Kittner weder Textologe noch Philologe.“"
                                            },
                                            {
                                                "example_id": "862eb233-a6a3-4f22-a226-74580b18fc4b",
                                                "sense_id": "726a5b59-e703-3084-9d09-65464c6412ec",
                                                "text": "„Auch seine solide Vorbereitung als Textologe ist hier zu erwähnen, die eine gekonnte und genaue Arbeit mit den Quellen ermöglichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
