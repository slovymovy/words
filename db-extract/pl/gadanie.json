                "translations": [
                    {
                        "translation_id": "12bd9d72-33e0-40f1-9077-a8083c5f14c8",
                        "source_entry_id": "232b86da-08ad-3139-be8a-e7c9a3a8ad70",
                        "source_sense_id": "5640872c-a3aa-34e6-b67b-5b573e6ddae3",
                        "target_lang_word": "chatter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f85ca0b6-dd3a-3506-b15f-0f8dc696c496",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "Talk, especially meaningless or unimportant talk."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e171e5-318a-43fb-978c-0d25da73b0ff",
                                                "sense_id": "f85ca0b6-dd3a-3506-b15f-0f8dc696c496",
                                                "text": "Although hardly coming under my theme, I cannot omit this: \"Against a woman's chatter: Taste at night fasting a root of radish, that day the chatter cannot harm thee.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75fc2605-3980-3119-8c62-fb5c7008afd7",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The sound of talking."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72b03cd0-281f-32f5-9152-581da9a557aa",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The vocalisations of a Eurasian magpie, Pica pica."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The vocalisations of various birds or other animals."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "214c9d92-da3a-4904-83fe-c557ab7484f0",
                                                "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                                "text": "The hare cried and complained of the terrible February cold and the disgusting chatter of the owls[.]"
                                            },
                                            {
                                                "example_id": "e1d5138f-31ff-44ba-81bc-b421baa784a7",
                                                "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                                "text": "At dawn and at sunset the howler monkeys screamed together and the parakeets broke into shrill chatter, but during the hot hours of the day only the full drone of insects, like the beat of a distant surf, filled the ear, while nothing moved amid the solemn vistas of stupendous trunks, fading away into the darkness which held us in."
                                            },
                                            {
                                                "example_id": "345459e4-375a-48fe-92c6-99e98018933a",
                                                "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                                "text": "The wind rose as the earth darkened, so that fading chatters of woodland animals were countered by the strengthening sounds of waving trees […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a27350-ef10-3911-98ce-437a3befd249",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "An intermittent noise, as from vibration."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5e2d543-0fec-4429-89cf-ea0d32e2fe89",
                                                "sense_id": "66a27350-ef10-3911-98ce-437a3befd249",
                                                "text": "Proper brake adjustment will help to reduce the chatter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61010195-9eef-350b-8561-bc507a46ef2c",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "In national security, the degree of communication between suspect groups and individuals, used to gauge the degree of expected terrorist activity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a811908-7320-4dfa-a4a5-8e6e8d94d1c9",
                                                "sense_id": "61010195-9eef-350b-8561-bc507a46ef2c",
                                                "text": "The NSA is concerned about increased chatter between known terror groups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "131a1b05-3719-3e98-864c-60d0b8c84c76",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The situation where a drill or similar tool vibrates and tears the material rather than cutting it cleanly."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e0f1f2d-4edb-364f-98c0-eddbddc1f577",
                                        "entry_id": "b47829c6-7743-3509-a518-b32db18309a4",
                                        "glosses": [
                                            "To talk idly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b50502d4-151b-4013-a637-785d90577d79",
                                                "sense_id": "7e0f1f2d-4edb-364f-98c0-eddbddc1f577",
                                                "text": "They knitted and chattered the whole time."
                                            },
                                            {
                                                "example_id": "52901761-1456-4f98-a346-c27a6186dff8",
                                                "sense_id": "7e0f1f2d-4edb-364f-98c0-eddbddc1f577",
                                                "text": "That teacheth trickes eleuen and twentie long, / To tame a ſhrew, and charme her chattering tongue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b26fbf5-2412-3f5a-a621-c8a53ad3bd27",
                                        "entry_id": "b47829c6-7743-3509-a518-b32db18309a4",
                                        "glosses": [
                                            "To make a noise by rapid collisions."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923acaea-15da-4199-a7dc-e73ed1fb39aa",
                                                "sense_id": "8b26fbf5-2412-3f5a-a621-c8a53ad3bd27",
                                                "text": "He was so cold that his teeth were chattering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d687982-9e42-3e61-825e-7f023636a8cb",
                                        "entry_id": "b47829c6-7743-3509-a518-b32db18309a4",
                                        "glosses": [
                                            "To utter sounds which somewhat resemble language, but are inarticulate and indistinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc7f89b-f55f-4808-8037-f252cc1237a3",
                                                "sense_id": "3d687982-9e42-3e61-825e-7f023636a8cb",
                                                "text": "The jay makes answer, as the magpie chatters with delight."
                                            },
                                            {
                                                "example_id": "24f2a94d-9047-4076-9bde-bd056c2cdfe7",
                                                "sense_id": "3d687982-9e42-3e61-825e-7f023636a8cb",
                                                "text": "Is your cat intently staring out the window at a bird on a branch and “chattering” in a kind of shaky, high-pitched, breathy way? If so, she is expressing excitement at what she's observing (or maybe the desire to attack what she sees as prey)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "599b4609-7d6c-3e56-8cac-d0c4010e3afc",
                                        "entry_id": "6318f1d0-f98f-3e57-b127-3645d75e8ae9",
                                        "glosses": [
                                            "One who chats."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b71c1d8-abbf-3c80-8048-91ffd49d2eb3",
                                        "entry_id": "6318f1d0-f98f-3e57-b127-3645d75e8ae9",
                                        "glosses": [
                                            "A user of chat rooms."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6527e415-644c-451e-80aa-743d7db842da",
                                                "sense_id": "4b71c1d8-abbf-3c80-8048-91ffd49d2eb3",
                                                "text": "During the chat sessions, two outreach team members would engage in a conversation about the topic chosen for that event in the main chat room and entice other chatters to join in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceadd2cb-0cad-4888-abdf-e32f89cac568",
                        "source_entry_id": "232b86da-08ad-3139-be8a-e7c9a3a8ad70",
                        "source_sense_id": "5640872c-a3aa-34e6-b67b-5b573e6ddae3",
                        "target_lang_word": "idle talk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "43bc19aa-2af1-499a-a0d4-8ec0698e2daf",
                        "source_entry_id": "232b86da-08ad-3139-be8a-e7c9a3a8ad70",
                        "source_sense_id": "5640872c-a3aa-34e6-b67b-5b573e6ddae3",
                        "target_lang_word": "blather",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b551d31-4f04-3923-9255-82b9b639ec0d",
                                        "entry_id": "b9df745b-c69f-32a7-bf8e-6ebdadec542c",
                                        "glosses": [
                                            "To talk rapidly without making much sense."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eba3344-35e1-40d7-a709-4077d4fc6e0c",
                                                "sense_id": "2b551d31-4f04-3923-9255-82b9b639ec0d",
                                                "text": "“There you go blatherin’,” said Brindle, intending a mild rebuke."
                                            },
                                            {
                                                "example_id": "57cfb5f7-8470-4aee-b47e-f8f2679d182b",
                                                "sense_id": "2b551d31-4f04-3923-9255-82b9b639ec0d",
                                                "text": "It was at the unveiling of Sir John Gray's statue. Edmund Dwyer Gray was speaking, blathering away, and here was this old fellow, crabbed-looking old chap, looking at him from under his bushy eyebrows."
                                            },
                                            {
                                                "example_id": "28374a35-1533-41e3-8cfd-7e0fdebf7d53",
                                                "sense_id": "2b551d31-4f04-3923-9255-82b9b639ec0d",
                                                "text": "On and on he blathered, taking refuge in the one thing he felt lent him superiority: words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec18cbe4-b564-331b-8d76-24088577de75",
                                        "entry_id": "b9df745b-c69f-32a7-bf8e-6ebdadec542c",
                                        "glosses": [
                                            "To say (something foolish or nonsensical); to say (something) in a foolish or overly verbose way."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "822550b2-d45e-4da1-a2ec-29d5e8d01429",
                                                "sense_id": "ec18cbe4-b564-331b-8d76-24088577de75",
                                                "text": "Then, just before the wedding, the old man feels he’s honor bound to tell his future son-in-law the secret of his past; so the damned idiot blathers the whole story of his killing the man and breaking jail!"
                                            },
                                            {
                                                "example_id": "e8741a64-89f2-4201-b0d9-b5f139b0e1cf",
                                                "sense_id": "ec18cbe4-b564-331b-8d76-24088577de75",
                                                "text": "[…] the church attitude has never been that a teacher should be allowed to blather anything that comes into his head without any accountability at all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efa81f7f-11a8-3e88-95ab-35875ea56947",
                                        "entry_id": "995007a3-e91e-3f37-abc8-43e038bdd941",
                                        "glosses": [
                                            "Foolish or nonsensical talk."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a75146d3-5639-4223-a407-cbd8ff94d4d8",
                                                "sense_id": "efa81f7f-11a8-3e88-95ab-35875ea56947",
                                                "text": "That is the worst of being in an Irish regiment, nothing can be done widout ever so much blather;"
                                            },
                                            {
                                                "example_id": "b3cf1df8-3089-42d2-8075-b7800542e649",
                                                "sense_id": "efa81f7f-11a8-3e88-95ab-35875ea56947",
                                                "text": "Will you cease your blather of mutiny and treason and courts-martial?"
                                            },
                                            {
                                                "example_id": "a185ef24-4201-40a6-86ea-72569c0af6f6",
                                                "sense_id": "efa81f7f-11a8-3e88-95ab-35875ea56947",
                                                "text": "With years of proofreading under my belt, I knew exactly the blather and bluster favoured by professional politicians."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f55eaf0-cc9d-3433-b37c-5592fdf80860",
                                        "entry_id": "c3fae61e-5062-3f84-b149-6af8a4004a97",
                                        "glosses": [
                                            "Obsolete form of bladder."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6d32c70-e631-4892-a531-7b0aa049a8c1",
                                                "sense_id": "7f55eaf0-cc9d-3433-b37c-5592fdf80860",
                                                "text": "1596, Charles Fitzgeoffrey, Sir Francis Drake His Honorable Lifes Commendation, and His Tragicall Deathes Lamentation, Oxford: Joseph Barnes,\n[…] on Vlisses Circe did bestowe\nA blather, where the windes imboweld were,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
