                        "examples": [
                            {
                                "example_id": "df7ea906-8d7e-45a4-b2cf-4a1f84055583",
                                "sense_id": "00ed5b4d-a48e-3b49-aef1-59194f14e3a5",
                                "text": "This was a noble achievement on the part of our paradoxist. At one stroke it established his theory of the weather, and promised to ensure him text-book immortality as one of the observers of Vulcan."
                            },
                            {
                                "example_id": "ef5f77a8-eaae-4e74-9f37-ec8b8ae5e61a",
                                "sense_id": "00ed5b4d-a48e-3b49-aef1-59194f14e3a5",
                                "text": "But these paradoxists and grumblers were a quite infinitesimal minority. The common sense and sound instinct of Britain and of the Empire realised that here was an issue like scarcely another in history — a clear issue of right and wrong[…]"
                            }
                        ]
                    },
