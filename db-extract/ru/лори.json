                                        "sense_id": "9dab4b65-b804-31f2-902b-947066b20591",
                                        "entry_id": "f95f8563-1aa0-3b8a-ab6c-9af6f1d180ad",
                                        "glosses": [
                                            "Any of several small, slow-moving primates, of the subfamily Lorisinae, found in India and southeast Asia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b73042b-3bce-4205-9c78-78355daa8ffb",
                                                "sense_id": "9dab4b65-b804-31f2-902b-947066b20591",
                                                "text": "If the stairs allow such room for thought it’s because Trudy is taking them at the pace of the slowest loris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
