            {
                "entry_id": "f8eccb0d-2abd-30b3-b6d2-3f48247a2058",
                "word": "stabilisateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "793bad8b-2cea-43e3-a6a2-0ee7d9752ae2",
                        "entry_id": "f8eccb0d-2abd-30b3-b6d2-3f48247a2058",
                        "tags": [
                            "plural"
