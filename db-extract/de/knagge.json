                ],
                "senses": [
                    {
                        "sense_id": "b87eb913-54b9-36a6-bcb8-79fa903b5ed3",
                        "entry_id": "04a5c62a-f6fd-3f66-930e-79a58a9208f8",
                        "glosses": [
                            "ein Dreiecksholz im Fachwerkverbund zur Aussteifung des Gerüstes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b28f18-f843-4776-8a1a-e0d1233b3adf",
                                "sense_id": "b87eb913-54b9-36a6-bcb8-79fa903b5ed3",
                                "text": "„In vielen Sparrendächern werden Knaggen zur Abtragung der Kräfte aus den Sparren in die Auflager einer Betondecke eingesetzt.“"
                            },
                            {
                                "example_id": "434c78a5-4729-4f87-b2e3-52046c7422d8",
                                "sense_id": "b87eb913-54b9-36a6-bcb8-79fa903b5ed3",
                                "text": "„Es gibt längliche Knaggen unter Geschoßvorsprüngen gotischer Häuser oder gleichschenklige in der Wand im Fachwerkbau des 17. / 18. Jh. […]“"
                            },
                            {
                                "example_id": "2faa56c3-7aec-442c-90a2-63bcf036dbea",
                                "sense_id": "b87eb913-54b9-36a6-bcb8-79fa903b5ed3",
                                "text": "„Der Überhang über dem 1. Obergeschoß wird durch Knaggen gestützt.“"
                            },
                            {
                                "example_id": "261f7094-e779-44f9-a9cf-58da6a991de1",
                                "sense_id": "b87eb913-54b9-36a6-bcb8-79fa903b5ed3",
                                "text": "„Ein im Jahr des Bauernkriegs errichtetes Haus am Großen Markt in Perleberg ist mit 13, immerhin jeweils 80 Zentimeter hohen Schnitzfiguren an den Knaggen geschmückt, also an den nach außen vorkragenden Tragebalken unter dem Dach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
