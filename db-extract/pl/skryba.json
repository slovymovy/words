                ],
                "translations": [
                    {
                        "translation_id": "2e112b9c-90bd-494a-b374-b7fa52f2bf66",
                        "source_entry_id": "8b059352-5267-3ed1-ae16-9460c090f02f",
                        "source_sense_id": "d469b0c5-be57-3d70-83f2-4560cd4386fb",
                        "target_lang_word": "scribe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scribe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1d311c6-cf2f-3215-bd86-0bbd5b82e114",
                                        "entry_id": "f3e33b8d-83c6-3142-bf38-39ae99fc5d60",
                                        "glosses": [
                                            "Someone who writes; a draughtsperson; a writer for another; especially, an official or public writer; an amanuensis, secretary, notary, or copyist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e86e05-5fe0-4cae-ab28-f2d7663842e3",
                                                "sense_id": "a1d311c6-cf2f-3215-bd86-0bbd5b82e114",
                                                "text": "[T]he pleasure of writing on wax with a stylus is exemplified by the fine, flowing hand of a Roman scribe who made out the birth certificate of Herennia Gemella, born March 128 AD."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fe8152c-2605-305f-a7dc-4d7c01ef0f0c",
                                        "entry_id": "f3e33b8d-83c6-3142-bf38-39ae99fc5d60",
                                        "glosses": [
                                            "Someone who writes; a draughtsperson; a writer for another; especially, an official or public writer; an amanuensis, secretary, notary, or copyist.",
                                            "A person who writes books or documents by hand as a profession.ᵂ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c52897-65df-48bf-a70c-d0499ae42fdb",
                                                "sense_id": "9fe8152c-2605-305f-a7dc-4d7c01ef0f0c",
                                                "text": "The ability of a segment of a glass sphere to magnify whatever is placed before it was known around the year 1000, when the spherical segment was called a reading stone,[…]. Scribes, illuminators, and scholars held such stones directly over manuscript pages as an aid in seeing what was being written, drawn, or read."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e8c04a6-77ef-3548-9b57-bd1f72d4af12",
                                        "entry_id": "f3e33b8d-83c6-3142-bf38-39ae99fc5d60",
                                        "glosses": [
                                            "A journalist."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6c556ec-5b63-3cee-8dbe-67f839410a5a",
                                        "entry_id": "f3e33b8d-83c6-3142-bf38-39ae99fc5d60",
                                        "glosses": [
                                            "A writer and doctor of the law; one skilled in the law and traditions; one who read and explained the law to the people."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ad0ded6-05ce-3cc1-b37b-536899caf96c",
                                        "entry_id": "f3e33b8d-83c6-3142-bf38-39ae99fc5d60",
                                        "glosses": [
                                            "A very sharp, steel drawing implement used in engraving and etching, a scriber."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scribe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3a72239-bd4d-3db1-b5ec-bde02723c5cf",
                                        "entry_id": "6084a180-e93d-3aeb-9f37-aa096da16e2f",
                                        "glosses": [
                                            "To write."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c457e1a-6b41-3ce7-80dc-206c3d4d8873",
                                        "entry_id": "6084a180-e93d-3aeb-9f37-aa096da16e2f",
                                        "glosses": [
                                            "To write, engrave, or mark upon; to inscribe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3268a6c-2deb-4f68-9345-6e3b95de567f",
                                                "sense_id": "4c457e1a-6b41-3ce7-80dc-206c3d4d8873",
                                                "text": "There—at Ioue wexed wroth, and in his ſpright / Did inly grudge, yet did it well conceale; / And bade Dan Phœbus Scribe her Appellation ſeale."
                                            },
                                            {
                                                "example_id": "ed4d554c-bdcf-46fb-80a4-8bdd6d87b102",
                                                "sense_id": "4c457e1a-6b41-3ce7-80dc-206c3d4d8873",
                                                "text": "he scribed his name on the mould, and wrote it on the two pieces of pasteboard"
                                            },
                                            {
                                                "example_id": "5a1edf3c-0b37-48cf-8258-e7f287a1fc2e",
                                                "sense_id": "4c457e1a-6b41-3ce7-80dc-206c3d4d8873",
                                                "text": "There was the curious fascination expressed regarding the triangular relationship between the poor white, the black, and the hookworm — suggesting a desire to differentiate and segregate the poor white body from that of the black and to scribe more boldly what was often, for the poorest people of the South, a very thin line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2357e7a4-2136-304a-b984-dc0e0734abbf",
                                        "entry_id": "6084a180-e93d-3aeb-9f37-aa096da16e2f",
                                        "glosses": [
                                            "To record, as a scribe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b789732c-f50a-3694-870d-f59dc5bab053",
                                        "entry_id": "6084a180-e93d-3aeb-9f37-aa096da16e2f",
                                        "glosses": [
                                            "To write or draw with a scribe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65378637-a6ea-359e-8d89-7e098c21fa59",
                                        "entry_id": "6084a180-e93d-3aeb-9f37-aa096da16e2f",
                                        "glosses": [
                                            "To cut (something) in order to fit it closely to an irregular surface, as a baseboard to a floor which is out of level, a board to the curves of a moulding, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbb25eb2-6b0c-347a-a132-0a1856b9dfd0",
                                        "entry_id": "6084a180-e93d-3aeb-9f37-aa096da16e2f",
                                        "glosses": [
                                            "To score or mark with compasses or a scribing iron."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "356f67a9-46ec-42aa-907e-e69d5377f73d",
                        "source_entry_id": "8b059352-5267-3ed1-ae16-9460c090f02f",
                        "source_sense_id": "d469b0c5-be57-3d70-83f2-4560cd4386fb",
                        "target_lang_word": "scribe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scribe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d1eac3d-8521-3192-a812-ff5edca39955",
                                        "entry_id": "68b3fbff-ff78-3ad2-a1d9-966153464565",
                                        "glosses": [
                                            "Copiste, homme employé à faire des écritures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65faad88-5ade-4dd7-9200-65f9da5b4c76",
                                                "sense_id": "7d1eac3d-8521-3192-a812-ff5edca39955",
                                                "text": "Chez les Juifs on donnait ce nom à des espèces de docteurs qui se divisaient en trois classes : les scribes du sanhédrin, qui n’étaient que des greffiers de ce tribunal; les scribes de la loi, dont les décisions étaient exécutées à l’égal de la loi elle-même, et les scribes du peuple, véritables magistrats prononçant des sentences dans les affaires privées et contre les coupables de délits."
                                            },
                                            {
                                                "example_id": "7a1594d7-120e-41bd-b745-9ac2a0cba442",
                                                "sense_id": "7d1eac3d-8521-3192-a812-ff5edca39955",
                                                "text": "Mais une fois établis les principes de la comptabilité, n’importe quel scribe s'en serait tiré au moins aussi bien que moi."
                                            },
                                            {
                                                "example_id": "34a0db59-cb04-4360-a1b2-85229726c10b",
                                                "sense_id": "7d1eac3d-8521-3192-a812-ff5edca39955",
                                                "text": "Ces vieillards de quarante à cinquante ans, tous réservistes, certains anciens combattants de la Première Guerre Mondiale, avaient été, malgré les \"macarons\" de pilote qu’ils arboraient fièrement, maintenus pendant toute la guerre dans des fonctions \"de rampants\", popotiers, scribes, chefs de bureau, en dépit des promesses de mise à l’entraînement aérien toujours renouvelées et jamais tenues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9425401f-0acb-3551-956d-b29a26203538",
                                        "entry_id": "68b3fbff-ff78-3ad2-a1d9-966153464565",
                                        "glosses": [
                                            "Docteur qui enseignait la loi de Moïse au peuple et qui l’interprétait."
                                        ],
                                        "tags": [
                                            "Antiquité judaïque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a4ef3be-fcc5-423c-9534-c6176f5c696c",
                                                "sense_id": "9425401f-0acb-3551-956d-b29a26203538",
                                                "text": "Les scribes et les pharisiens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
