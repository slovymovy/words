            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "55b39aa0-9b50-3aac-99b1-a74082d3400d",
                    "sense_definition": "Qui est situé au-dessous ou plus bas dans l'espace.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La douleur se concentre principalement sur la partie <w>inférieure</w> du dos.",
                            "target_lang_translations": {
                                "en": "The pain is mainly concentrated in the <w>lower</w> part of the back.",
                                "ru": "Боль в основном сосредоточена в <w>нижней</w> части спины.",
                                "de": "Der Schmerz konzentriert sich hauptsächlich auf den <w>unteren</w> Teil des Rückens.",
                                "es": "El dolor se concentra principalmente en la parte <w>baja</w> de la espalda.",
                                "zh": "疼痛主要集中在后背<w>下方的</w>部分。"
                            }
                        },
                        {
                            "text": "Le médecin a examiné attentivement les membres <w>inférieurs</w> de l'athlète blessé.",
                            "target_lang_translations": {
                                "en": "The doctor carefully examined the injured athlete's <w>lower</w> limbs.",
                                "ru": "Врач внимательно осмотрел <w>нижние</w> конечности травмированного спортсмена.",
                                "de": "Der Arzt untersuchte die <w>unteren</w> Gliedmaßen des verletzten Sportlers sorgfältig.",
                                "es": "El médico examinó con cuidado los miembros <w>inferiores</w> del deportista lesionado.",
                                "zh": "医生仔细检查了这名受伤运动员<w>下方的</w>肢体。"
                            }
                        }
                    ],
                    "antonyms": [
                        "supérieur"
                    ],
                    "common_phrases": [
                        "partie inférieure",
                        "membres inférieurs",
                        "étage inférieur"
                    ],
                    "target_lang_definitions": {
