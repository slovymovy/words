                "senses": [
                    {
                        "sense_id": "dfda5eff-722f-3cbf-b987-db3cc25dd4f1",
                        "entry_id": "25f4ef23-1e15-3d6e-aab3-2d9b0ae316c2",
                        "glosses": [
                            "нацист, нацистка, фашист, фашистка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21e44a0f-8183-4aea-ad18-32a6a62a849e",
                                "sense_id": "dfda5eff-722f-3cbf-b987-db3cc25dd4f1",
                                "text": "Как, ваша жена — наци?! — изумился я. — И вы это терпите? — Ах, вы не представляете, сколько это мне доставляет неприятностей! Но что остается делать? Не разводиться же из-за политических разногласий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ef898d3-4954-493e-939b-bef0144b5066",
                        "source_entry_id": "25f4ef23-1e15-3d6e-aab3-2d9b0ae316c2",
                        "source_sense_id": "dfda5eff-722f-3cbf-b987-db3cc25dd4f1",
                        "target_lang_word": "Nazi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83cec129-fe64-3a6c-bbb7-f067433274fe",
                                        "entry_id": "62da0666-09aa-3141-bf48-edc9e7bd2d07",
                                        "glosses": [
                                            "A member of the Nazi Party (the National Socialist German Workers' Party or NSDAP)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "966ffc6a-5ded-4d65-b4c5-a79e3609d05a",
                                                "sense_id": "83cec129-fe64-3a6c-bbb7-f067433274fe",
                                                "text": "Taiwan fears Xi Jinping has been inspired by Adolf Hitler's tactics, and is calling on our federal government to take action, warning a Chinese invasion would allow Beijing to rule the world by weaponising its computer chip industry. The Taiwanese Deputy Foreign Minister compared the sector to the Czech armaments which boosted the capability of the Nazis in World War II."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a0a611-2cc1-3a36-bdaf-5ac9102be20b",
                                        "entry_id": "62da0666-09aa-3141-bf48-edc9e7bd2d07",
                                        "glosses": [
                                            "One who advocates neo-Nazism, or a similarly fascist, racist, anti-Semitic, xenophobic, ethnic supremacist, or ultranationalist ideology; a neo-Nazi."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6983b07d-5820-352c-ba73-10a5a077fda5",
                                        "entry_id": "62da0666-09aa-3141-bf48-edc9e7bd2d07",
                                        "glosses": [
                                            "One who imposes their views on others; one who is unfairly oppressive or needlessly strict. (also frequently uncapitalised: nazi)"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "slang",
                                            "sometimes",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4546a984-b287-4c60-a0e5-2425a2daedad",
                                                "sense_id": "6983b07d-5820-352c-ba73-10a5a077fda5",
                                                "text": "She's a total grammar Nazi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Nazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63f8cf5f-1bff-303e-ac3a-16c712792e37",
                                        "entry_id": "5c25fb61-762e-3471-a557-d67624f6d02b",
                                        "glosses": [
                                            "Of or pertaining to the Nazi Party specifically, or to Nazism, neo-Nazism, or neo-Nazis more generally."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "023e41ca-9f66-385a-9fc1-73aedfd60110",
                                        "entry_id": "5c25fb61-762e-3471-a557-d67624f6d02b",
                                        "glosses": [
                                            "Of or pertaining to the Nazi Party specifically, or to Nazism, neo-Nazism, or neo-Nazis more generally.",
                                            "Of or pertaining to the Third Reich."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb620527-6b5d-4612-a386-664a9a319b1c",
                                                "sense_id": "023e41ca-9f66-385a-9fc1-73aedfd60110",
                                                "text": "They have good reason to fear them too, for their machine gun strafing, their rockets, and their bombs knock out Nazi bridges, trucks, tanks, and kill them by the score."
                                            },
                                            {
                                                "example_id": "6c1d4c2b-e15b-4e8b-9f83-2a771e4a14be",
                                                "sense_id": "023e41ca-9f66-385a-9fc1-73aedfd60110",
                                                "text": "The second development was the program for the redesign (Neugestaltung) of several German cities as representative Nazi cities."
                                            },
                                            {
                                                "example_id": "582a6d75-e60e-429e-8b0b-ee952b9d9f3f",
                                                "sense_id": "023e41ca-9f66-385a-9fc1-73aedfd60110",
                                                "text": "It was reminiscent of the rallies held by Adolph Hitler during the 1930s-1940s before adoring crowds in Nazi Germany. At many of these Nazi rallies, the German participants swore personal allegiance to their nation’s leader-Adolph Hitler over and above their own Nation-Germany."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab5b0c6f-9134-3d2d-bee1-199810857ae2",
                                        "entry_id": "5c25fb61-762e-3471-a557-d67624f6d02b",
                                        "glosses": [
                                            "Domineering, totalitarian, or intolerant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Nazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4db5744b-d3e0-3bf5-9c7f-c4fd8ba65d4e",
                                        "entry_id": "1405315e-37d6-37a4-b839-aad12885a841",
                                        "glosses": [
                                            "The language (ideological jargon) of Nazis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41368617-ceb9-45e2-a53a-a9d5c5785a65",
                                                "sense_id": "4db5744b-d3e0-3bf5-9c7f-c4fd8ba65d4e",
                                                "text": "All this requires some very careful unpacking, for obviously, Dr. Bosse is “speaking Nazi with the Bormann dialect.”"
                                            },
                                            {
                                                "example_id": "42d362ba-bf7d-463f-9e3e-9d16e52115ad",
                                                "sense_id": "4db5744b-d3e0-3bf5-9c7f-c4fd8ba65d4e",
                                                "text": "He must write and speak “Nazi”, which is essentially anti-scientific' (Schreiber 1935a: 79). Falk Ruttke's presentation was illustrative in this sense. Ruttke was a member of the Reich Committee for Public Health Policy, as well as a member of the Advisory Board for Population and Racial Policy at the Reich Interior Ministry. Ruttke told the participants that after Hitler's accession to power, the 'knowledge of genetic laws was invoked towards the creation of a healthy race,...'"
                                            },
                                            {
                                                "example_id": "82eb4a41-1444-4dd4-9fe5-a32280ffa7d5",
                                                "sense_id": "4db5744b-d3e0-3bf5-9c7f-c4fd8ba65d4e",
                                                "text": "What is pertinent is that it was possible to effectively speak Nazi to Nazis and then become an “innocent nationalist” during the Cold War. Kubiiovych's truth, if any, was that he mastered both. Pragmatism and brutality thus meshed seamlessly. For Kubiiovych, developing the Ukrainian cooperative system under Germans would not only strengthen the Ukrainian economy but also protect Ukrainian peasants from Jewish exploitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afd1ceb1-9ca3-36f9-b5b4-32ca5ec8c219",
                                        "entry_id": "1405315e-37d6-37a4-b839-aad12885a841",
                                        "glosses": [
                                            "The German language."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9a58177-aa74-4ef5-82b3-10b972469176",
                                                "sense_id": "afd1ceb1-9ca3-36f9-b5b4-32ca5ec8c219",
                                                "text": "In Hitler's Own Words: Shut up, Yank — learn to speak NAZI!"
                                            },
                                            {
                                                "example_id": "29243e30-1822-4a6f-ab4d-8565669da2a3",
                                                "sense_id": "afd1ceb1-9ca3-36f9-b5b4-32ca5ec8c219",
                                                "text": "He pushed aside his ponytailed minion and stepped right up to Tank, who gave him a perplexed look as he barked a few words in guttural German. “I don't speak Nazi,” Tank said."
                                            },
                                            {
                                                "example_id": "9e86ea94-a1cb-499d-850b-3e9ce5c4e3cd",
                                                "sense_id": "afd1ceb1-9ca3-36f9-b5b4-32ca5ec8c219",
                                                "text": "“This is all sounding very pretty, Shaw,” Spencer checks his watch. “But how about you share what's being said for the rest of us who don't speak Nazi.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
