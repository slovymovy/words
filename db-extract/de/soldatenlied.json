                "senses": [
                    {
                        "sense_id": "e1b7e63f-df9a-31d0-8546-38fb344fabb8",
                        "entry_id": "b6be09f2-770b-37e7-9d96-7f200e0ad845",
                        "glosses": [
                            "Lied der Soldaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcb41766-a0ed-4c14-af29-e934e59c393f",
                                "sense_id": "e1b7e63f-df9a-31d0-8546-38fb344fabb8",
                                "text": "„Er war noch mitten darin, als wieder von den Feldern her Hurrageschrei kam, das jetzt noch disharmonischer klang als zuvor und mit den Klängen von Militärmusik und Soldatenliedern verschmolz.“"
                            },
                            {
                                "example_id": "5e5239d6-9a2a-44bc-946e-a6be260121e5",
                                "sense_id": "e1b7e63f-df9a-31d0-8546-38fb344fabb8",
                                "text": "„Ich weiß nicht mehr, wer als erster die Melodie anstimmte, und ich weiß nicht, weshalb ihm ausgerechnet dieses Soldatenlied in den Sinn gekommen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
