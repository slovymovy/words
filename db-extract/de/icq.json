                                        "glosses": [
                                            "A program allowing users to send each other instant messages via the Internet."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bbcce7c-2951-447a-9737-f3dd6f357ae4",
                                                "sense_id": "0781ec20-cf15-3f49-ab31-c66b19e4d544",
                                                "text": "ICQ was unusual among instant-messaging systems because it used what is called peer-to-peer technology—ICQ users essentially communicated with each other directly, without having all their messages pass through a central server."
                                            }
                                        ]
                                    }
                                ]
