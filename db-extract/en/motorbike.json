                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f3da7a5-0ba8-4528-af86-b8f6da6dbb7c",
                        "source_entry_id": "1d761413-c9b0-3c7c-925c-48fddf4392de",
                        "source_sense_id": "f0057bb8-4ec4-396f-a309-b964f8aa9f7e",
                        "source_sense_description": "das (kleine) motorisierte Zweirad",
                        "target_lang_word": "Mofa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mofa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "788da4d5-c9ad-3404-849a-099df3a6407e",
                                        "entry_id": "0d7fa194-e036-32e9-ac7e-cedb387566a8",
                                        "glosses": [
                                            "schwach motorisiertes Kraftrad mit einer erlaubten Bauartgeschwindigkeit von maximal 25 km/h in Deutschland und von maximal 45 km/h in Österreich und der Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5233ba3-f7c3-4b6c-a5c6-7c2304f5acbf",
                                                "sense_id": "788da4d5-c9ad-3404-849a-099df3a6407e",
                                                "text": "Die meisten Mofas werden durch einen Zweitaktmotor angetrieben."
                                            },
                                            {
                                                "example_id": "3596a6e3-0d86-49bd-a3f6-b955cf12bb24",
                                                "sense_id": "788da4d5-c9ad-3404-849a-099df3a6407e",
                                                "text": "„Vergeblich schaute ich nach dem Mofa aus, als ich mit Peter den Friedhof verließ.“"
                                            },
                                            {
                                                "example_id": "2d682126-4161-4036-aaa1-bda2c2e27df4",
                                                "sense_id": "788da4d5-c9ad-3404-849a-099df3a6407e",
                                                "text": "„Deshalb mußte er mit dem Mofa zu seiner Arbeitsstelle nach Sprendlingen fahren und konnte mittags nicht mehr zum Essen nach Hause kommen, weil die Zeit nicht reichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb7ce350-003c-42b3-8c59-8be8761c03f1",
                        "source_entry_id": "1d761413-c9b0-3c7c-925c-48fddf4392de",
                        "source_sense_id": "f0057bb8-4ec4-396f-a309-b964f8aa9f7e",
                        "source_sense_description": "das (kleine) motorisierte Zweirad",
                        "target_lang_word": "Moped",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moped",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4312f34-9d9b-360b-a94a-33b75bf26a8a",
                                        "entry_id": "e7d24578-8b98-3ba1-b576-389c15c745a3",
                                        "glosses": [
                                            "Ein kleines Kraftrad mit nicht mehr als 50 cm³, das mit Pedalen ausgestattet ist. Moped ist kein verkehrsrechtlich definierter Begriff. Mitunter werden auch Krafträder im Allgemeinen als Moped bezeichnet. Einige Mofas zählen zu den Mopeds, Fahrräder mit Hilfsmotor dagegen nicht, da sie keine vollwertigen Krafträder sind."
                                        ],
                                        "tags": [
                                            "Fahrzeug",
                                            "Transport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1715f11-f29c-4676-9a0d-c6c6e5574db5",
                                                "sense_id": "f4312f34-9d9b-360b-a94a-33b75bf26a8a",
                                                "text": "Erwin fährt mit seinem Moped zur Schule."
                                            },
                                            {
                                                "example_id": "3ed30e4f-5b1f-49ee-a538-e0b9f024e23c",
                                                "sense_id": "f4312f34-9d9b-360b-a94a-33b75bf26a8a",
                                                "text": "„Der Halter eines Mopeds hat seiner Sorgfaltspflicht zur Sicherung des Mopeds gegen unbefugte Benützung Genüge getan, wenn er das Moped absperrt und den Schlüssel in seiner Hosentasche verwahrt, während er sich bekleidet zum Schlafen niederlegt.“"
                                            },
                                            {
