{
    "word_family": [
        "burtowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83e2fece-2412-31d8-91a0-32d05137cf1c",
                    "sense_definition": "zewnętrzna ściana kadłuba statku lub łodzi",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nautyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Silny wiatr uderzył w <w>burtę</w> statku, powodując jego silne przechylenie.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер ударил в <w>борт</w> судна, вызвав его сильный крен."
                            }
                        },
                        {
                            "text": "Marynarze musieli szybko naprawić uszkodzoną <w>burtę</w> podczas sztormu.",
                            "target_lang_translations": {
                                "ru": "Моряки должны были быстро починить поврежденный <w>борт</w> во время шторма."
                            }
                        }
                    ],
                    "synonyms": [
                        "bok"
                    ],
                    "common_phrases": [
                        "za burtą"
                    ],
                    "target_lang_definitions": {
                        "ru": "внешняя стенка корпуса судна или лодки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борт",
                                "target_lang_sense_clarification": "в морской терминологии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e16b51b-c0e7-32f5-957a-fcf7901c1192",
                    "sense_definition": "boczna ściana skrzyni ładunkowej pojazdu ciężarowego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kierowca opuścił tylną <w>burtę</w> ciężarówki, aby ułatwić rozładunek towaru.",
                            "target_lang_translations": {
                                "ru": "Водитель опустил задний <w>борт</w> грузовика, чтобы облегчить разгрузку товара."
                            }
                        },
                        {
                            "text": "Wysokie <w>burty</w> przyczepy chronią przewożony ładunek przed wypadnięciem.",
                            "target_lang_translations": {
                                "ru": "Высокие <w>борта</w> прицепа защищают перевозимый груз от выпадения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "боковая стенка грузовой платформы транспортного средства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борт",
                                "target_lang_sense_clarification": "в автомобильной технике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58f1f7fe-9814-3555-8500-e55866c8129b",
                    "sense_definition": "boczna część kadłuba samolotu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lotnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pasażerowie siedzący przy <w>burcie</w> samolotu mogli podziwiać chmury z bliska.",
                            "target_lang_translations": {
                                "ru": "Пассажиры, сидящие у <w>борта</w> самолета, могли любоваться облаками вблизи."
                            }
                        },
                        {
                            "text": "Technicy sprawdzali szczelność poszycia na <w>burcie</w> kadłuba maszyny.",
                            "target_lang_translations": {
                                "ru": "Техники проверяли герметичность обшивки на <w>борту</w> фюзеляжа машины."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "боковая часть фюзеляжа самолета"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борт",
                                "target_lang_sense_clarification": "в авиации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7fb5a6a-6bd8-36ac-a5d5-d87f9f9d6dc5",
                    "sense_definition": "pionowe umocnienie brzegu kanału lub rzeki",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "budownictwo_wodne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Betonowa <w>burta</w> kanału wymagała gruntownego remontu po zimie.",
                            "target_lang_translations": {
                                "ru": "Бетонная <w>стенка</w> канала требовала капитального ремонта после зимы."
                            }
                        },
                        {
                            "text": "Statek zacumował bezpośrednio przy wzmocnionej <w>burcie</w> nabrzeża.",
                            "target_lang_translations": {
                                "ru": "Судно пришвартовалось непосредственно к укрепленной <w>стенке</w> набережной."
                            }
                        }
                    ],
                    "synonyms": [
                        "nabrzeże"
                    ],
                    "target_lang_definitions": {
                        "ru": "вертикальное укрепление берега канала или реки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набережная",
                                "target_lang_sense_clarification": "укрепленный берег"
                            },
                            {
                                "target_lang_word": "стенка",
                                "target_lang_sense_clarification": "гидротехническое сооружение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76f9d46a-477e-354b-b0ad-446ddfb3523f",
                    "sense_definition": "wykończony brzeg materiału lub tkaniny",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "krawiectwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Krawcowa starannie wykończyła <w>burtę</w> płaszcza, aby materiał się nie strzępił.",
                            "target_lang_translations": {
                                "ru": "Портниха тщательно обработала <w>кромку</w> пальто, чтобы материал не осыпался."
                            }
                        },
                        {
                            "text": "Wzmocniona <w>burta</w> tkaniny zapewnia trwałość całego ubrania.",
                            "target_lang_translations": {
                                "ru": "Укрепленная <w>кромка</w> ткани обеспечивает долговечность всей одежды."
                            }
                        }
                    ],
                    "synonyms": [
                        "lamówka",
                        "brzeg"
                    ],
                    "target_lang_definitions": {
                        "ru": "обработанный край материала или ткани"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кромка",
                                "target_lang_sense_clarification": "в швейном деле"
                            },
                            {
                                "target_lang_word": "обтачка",
                                "target_lang_sense_clarification": "деталь одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38f1d5f6-b0cf-3ead-9ea9-f057f56c7fba",
                    "sense_definition": "magiczne praktyki lub czary",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych podaniach ludowych często wspominano o mrocznych <w>burtach</w> rzucanych przez wiedźmy.",
                            "target_lang_translations": {
                                "ru": "В старинных народных преданиях часто упоминались мрачные <w>чары</w>, накладываемые ведьмами."
                            }
                        },
                        {
                            "text": "Wierzył, że jego niepowodzenia to wynik rzuconej na niego <w>burty</w>.",
                            "target_lang_translations": {
                                "ru": "Он верил, что его неудачи — это результат наложенных на него <w>чар</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "czary",
                        "uroki"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "używane w kontekście dawnych wierzeń"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "магические практики или колдовство"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чары",
                                "target_lang_sense_clarification": "магическое воздействие"
                            },
                            {
                                "target_lang_word": "ворожба",
                                "target_lang_sense_clarification": "архаичное колдовство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}