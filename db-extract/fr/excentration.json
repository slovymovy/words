                        "tags": [],
                        "examples": [
                            {
                                "example_id": "523f01a6-e74a-4623-aa78-a737886711d3",
                                "sense_id": "defe2f01-cb7a-3a2d-b4d7-cc120c8ea413",
                                "text": "Pendant le travail, le moteur électrique fait tourner l’axe à excentration par la poulie de moteur. La mâchoire active s’approche et s’éloigne de la mâchoire statique."
                            },
                            {
                                "example_id": "b25dff3f-aced-473a-a898-327568a4e79a",
                                "sense_id": "defe2f01-cb7a-3a2d-b4d7-cc120c8ea413",
                                "text": "L’ordre de grandeur des balourds provoqués par une excentration est souvent dix fois plus important que celui provoqué par le faux-arbre lui-même."
                            }
                        ]
                    }
