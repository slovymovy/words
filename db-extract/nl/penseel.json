                    {
                        "sense_id": "6a04b138-1285-3927-a32b-b848c3040f71",
                        "entry_id": "08447c02-890f-3a15-a3c4-c15852f274b2",
                        "glosses": [
                            "een gereedschap om verf aan te brengen dat bestaat uit een steel waarop zacht en soepel haar is bevestigd"
                        ],
                        "tags": [
                            "schilderkunst"
                        ],
                        "examples": [
                            {
                                "example_id": "1b89dcfc-d789-4034-b9bb-dfc61f89cb4b",
                                "sense_id": "6a04b138-1285-3927-a32b-b848c3040f71",
                                "text": "Het puntje van het penseel is in rode verf gedoopt - rood als bloed, als zijn aardbeien, het rood van het leven."
                            },
                            {
                                "example_id": "d2d2e803-994c-4f52-af7b-b1a49d07f24c",
                                "sense_id": "6a04b138-1285-3927-a32b-b848c3040f71",
                                "text": "Zij gebruikte een penseel voor een beter resultaat."
                            },
                            {
                                "example_id": "20fe5a0b-c750-48e1-b619-9b5134c10135",
                                "sense_id": "6a04b138-1285-3927-a32b-b848c3040f71",
                                "text": "Bij het afscheid kreeg ik van iedereen een warme hug en ook nog twee water-kwasten. Dat zijn met water te vullen penselen waaruit water komt als je erop drukt."
                            }
                        ]
                    }
                ],
