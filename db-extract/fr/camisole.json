                    {
                        "translation_id": "edf1cdda-e9b4-40c3-bbae-c840247e65de",
                        "source_entry_id": "af5dff87-fb5c-34fc-86ba-1d333c2f3a5f",
                        "source_sense_id": "aace4dd3-163c-3e8d-b611-4c345a943171",
                        "target_lang_word": "straitjacket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "straitjacket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c83ce09c-e812-34cc-89c2-c09d57ed521b",
                                        "entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                                        "glosses": [
                                            "A jacket-like garment with very long sleeves which can be secured in place, thus preventing the wearer from moving his or her arms. Often used in psychiatric hospitals to prevent patients from injuring themselves or others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ecd8d88-11d7-4eb7-afbd-aa1f0a820e06",
                                                "sense_id": "c83ce09c-e812-34cc-89c2-c09d57ed521b",
                                                "text": "There’s a couple of people actually wearing duct-tape straitjackets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81196bb-b593-30f1-bd0e-1c95edddc06d",
                                        "entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                                        "glosses": [
                                            "Any situation seen as confining or restricting."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae282672-e8da-4400-846b-551b4c327b57",
                                                "sense_id": "e81196bb-b593-30f1-bd0e-1c95edddc06d",
                                                "text": "our ever-increasing bureaucratic straitjacket of regulations"
                                            },
                                            {
                                                "example_id": "ee4eb903-6235-42d7-a3ce-fbe99f1c4a53",
                                                "sense_id": "e81196bb-b593-30f1-bd0e-1c95edddc06d",
                                                "text": "[I]f we remain in one discipline, we remain in a straitjacket; an adequate theory of language evolution requires a lot of interdisciplinary work."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "straitjacket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce2eef06-abd3-3d2f-a4e8-4045b0be33d9",
                                        "entry_id": "9c78d3f1-695a-3921-ad8b-7d5590c9a78e",
                                        "glosses": [
                                            "To put someone into a straitjacket."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12f29c64-3e44-49ae-ba20-619da7b243c3",
                                                "sense_id": "ce2eef06-abd3-3d2f-a4e8-4045b0be33d9",
                                                "text": "What he asked himself now was,—could Miss Edge and Miss Baker, in order to get him out of the house, have set Birt onto Elizabeth, be in league with the man to break a poor old fellow down by simply driving his sad girl out of her wits? To have her straitjacketted even, muffled in a padded room?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                        "entry_id": "9c78d3f1-695a-3921-ad8b-7d5590c9a78e",
                                        "glosses": [
                                            "To restrict the freedom of, either physically or psychologically."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "042cea6b-25ca-48a0-8609-63327187c4e0",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "Charles for five whole days in a Victorian topper and tailcoat when he practically had to be straitjacketted to get him into tails for a three-hour wedding?"
                                            },
                                            {
                                                "example_id": "5a5d3651-6178-4180-8ab3-98b685386d94",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "Encouraging, allowing for, and maintaining a plurality of viewpoints concerning public policy, for instance, adaptively (even though partially and incompletely) reduces the chances of a rigidly deterministic and reductionistic mindset maladaptively straitjacketting our abilities to deal with dynamic complexity and to appreciate the benefits of malleability and self-criticality in remaining open to the challenges of our environment."
                                            },
                                            {
                                                "example_id": "96e7f470-a20c-48ed-90c2-fd7409fc2a15",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "But it has not always been like this. The last time human remains hit the headlines occurred when the government-sponsored Palmer Report was published. It was deeply antagonistic to research on human remains, and recommended straitjacketing archaeological research within the same framework as medical science."
                                            },
                                            {
                                                "example_id": "a788cb87-160f-4816-bcb3-b604fdd5efb2",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "Where most primates have a respectable pair of grasping rear hands we have two changelings: long arched pads with rounded chins at one end and stumpy thumbs straight-jacketed to baby fingers at the other."
                                            },
                                            {
                                                "example_id": "fe139531-88e6-4a7a-b600-a15fffb4b4b6",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "she couldnʼt wait to go to college, have a career and leave her parentsʼ straitjacketed lives behind"
                                            },
                                            {
                                                "example_id": "0c8fa98c-4c19-49e3-88cd-0158ea5c3cd0",
                                                "sense_id": "63241a02-aadf-3602-b192-25bebdb40f19",
                                                "text": "A Labour opposition that has straitjacketed its pledges and ambitions with its fears of blowing its strongest chance in years to gain power."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37ce6818-74ce-4e1e-8a92-56fe4041666f",
                        "source_entry_id": "af5dff87-fb5c-34fc-86ba-1d333c2f3a5f",
                        "source_sense_id": "db4d5ebd-a3c4-322a-b2ae-3fc6e9adfb7e",
                        "target_lang_word": "wifebeater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wifebeater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd92f59-1f25-3cd1-8219-0e66dc80bc6c",
                                        "entry_id": "658d1583-818b-3aa5-8692-dce0154ca0d9",
                                        "glosses": [
                                            "One who (usually as a repeated practice) beats his wife, or a husband prone to violence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3138834c-c9cb-492b-932b-59001f55f9d7",
                                                "sense_id": "bfd92f59-1f25-3cd1-8219-0e66dc80bc6c",
                                                "text": "Depp, 57, had sued the Sun’s publisher, News Group Newspapers (NGN), and its executive editor, Dan Wootton, over an article published in the Sun that originally carried the headline “Gone Potty: How can JK Rowling be ‘genuinely happy’ casting wife beater Johnny Depp in the new Fantastic Beasts film?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb4d43f3-6b16-3589-9524-beb3ce37c6c1",
                                        "entry_id": "658d1583-818b-3aa5-8692-dce0154ca0d9",
                                        "glosses": [
                                            "A type of sleeveless shirt, often but not exclusively worn as an undershirt."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38bae43d-7e08-400c-9f7d-750b45a3a0a1",
                                                "sense_id": "eb4d43f3-6b16-3589-9524-beb3ce37c6c1",
                                                "text": "[A]s I walked down the bustling street toward campus with my friends, he came out of nowhere and gave me a pick-up line only a wifebeater guy could muster."
                                            },
                                            {
                                                "example_id": "b3c8d7cc-f0ff-4a66-a183-b625e1d7b86c",
                                                "sense_id": "eb4d43f3-6b16-3589-9524-beb3ce37c6c1",
                                                "text": "So, at the first sign of any sunny weather, overweight males all over the country are drawn to their \"wifebeaters\" like footy fans to the digibox, with every lager-drinking dad labouring under the illusion that he looks like that gardener from Desperate Housewives in his black vest."
                                            },
                                            {
                                                "example_id": "a3a226b6-7650-4ded-9bbd-855d1810b6fa",
                                                "sense_id": "eb4d43f3-6b16-3589-9524-beb3ce37c6c1",
                                                "text": "Just then, a tall, lanky white man wearing a sleeveless tee or \"wifebeater\" as it is often referred to walked around the corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "793c65e1-a5e8-3c80-bc23-ca0907bd25be",
                                        "entry_id": "658d1583-818b-3aa5-8692-dce0154ca0d9",
                                        "glosses": [
                                            "Stella Artois, a brand of lager beer."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e7e6247-ae92-4aa8-9a1b-8cbf028d07ae",
                                                "sense_id": "793c65e1-a5e8-3c80-bc23-ca0907bd25be",
                                                "text": "And then we were walking back alleys, trudging through the drifts of chip papers, the bottles and empty cans of wifebeater[…]"
                                            },
                                            {
                                                "example_id": "59b3dfc9-aae2-453d-a1a5-71b96ec2abb3",
                                                "sense_id": "793c65e1-a5e8-3c80-bc23-ca0907bd25be",
                                                "text": "But Stella shouldn't really be drunk in pints the same way our dads used to drink bitter or mild that was effectively half as strong. Drink Stella in goblets like people do in its native country and, hey presto! It's no longer 'wifebeater'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b536c8f0-cef5-46fe-a35e-150373f096a8",
                        "source_entry_id": "af5dff87-fb5c-34fc-86ba-1d333c2f3a5f",
                        "source_sense_id": "db4d5ebd-a3c4-322a-b2ae-3fc6e9adfb7e",
