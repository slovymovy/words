                        "entry_id": "7a1edcd6-f73c-3acb-a222-50cde429530a",
                        "glosses": [
                            "A fool; a contemptible person."
                        ],
                        "tags": [
                            "derogatory",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "02ad9e23-a87e-420d-bf73-ddecf19d1337",
                                "sense_id": "a19e7a8f-d026-3d13-9a7d-1e75f0df8637",
                                "text": "And experience sheweth, that he which was void of gifts before he was ordered priest, is as very an ass and dogbolt as he was before,[…]."
                            },
                            {
                                "example_id": "067a2576-008e-4a0d-8ce3-a0fbdeb7ead4",
                                "sense_id": "a19e7a8f-d026-3d13-9a7d-1e75f0df8637",
                                "text": "1621, Thomas Middleton, Honourable Entertainments, 2007, Gary Taylor, John Lavagnino, Collected Works, page 1440,\nDull dogbolt!"
                            },
                            {
                                "example_id": "9597fb14-c351-4bdd-9bdb-16e36fb1f6bc",
                                "sense_id": "a19e7a8f-d026-3d13-9a7d-1e75f0df8637",
                                "text": "1655, James Shirley, The Gentleman of Venice Act 3, Scene 1, 1833, William Gifford, Alexander Dyce (editors), The Dramatic Works and Poems of James Shirley, Volume 5, page 35,\nThey are dogbolts!"
                            },
                            {
                                "example_id": "8007c5fb-6473-46b2-8038-068f34de8b1e",
                                "sense_id": "a19e7a8f-d026-3d13-9a7d-1e75f0df8637",
                                "text": "Thou wilt never be such a dogbolt to refuse a hint to a friend?"
                            }
                        ]
                    }
