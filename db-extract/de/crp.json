                            {
                                "example_id": "5d83a3e1-61d3-4e73-8ce4-e2fb45e7ce64",
                                "sense_id": "fdc55de4-e61a-3df5-a94b-affdb909e502",
                                "text": "Als C-reaktives Protein (CRP) wird ein Eiweißkörper bezeichnet, der zur Familie der Pentraxine zählt. CRP wird in der Leber gebildet und ins Blut abgegeben."
                            },
                            {
                                "example_id": "e2ba3370-0c15-4ea8-be54-59ae9d93f6ce",
                                "sense_id": "fdc55de4-e61a-3df5-a94b-affdb909e502",
                                "text": "Demnach sind Einschränkungen beim koordinierten Denken mit einem relativ hohen Spiegel des sogenannten C-reaktiven Proteins (CRP) im Blut und entsprechenden Veränderungen der Nervenfasern im Gehirn verbunden."
                            }
                        ],
                        "sense_index_json": "\"1\""
