                "senses": [
                    {
                        "sense_id": "2faf2607-d060-3672-9618-bd6ac97e5125",
                        "entry_id": "a4bd63bf-01db-3f18-b10b-8c463299c943",
                        "glosses": [
                            "englischsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e50b2f9-bea4-477d-8cc3-d3c0ab35bdcd",
                                "sense_id": "2faf2607-d060-3672-9618-bd6ac97e5125",
                                "text": "Die Snowdens fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "f72bc82b-cce2-44bd-8939-b3d55c48f46a",
                                "sense_id": "2faf2607-d060-3672-9618-bd6ac97e5125",
                                "text": "Herr Snowden wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9afb9af1-cb2d-4f47-885c-54c770b125d0",
                                "sense_id": "2faf2607-d060-3672-9618-bd6ac97e5125",
                                "text": "Frau Snowden ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5a5d2114-5312-4917-9b55-0785ade880a5",
                                "sense_id": "2faf2607-d060-3672-9618-bd6ac97e5125",
                                "text": "Der Snowden trägt nie die Pullover, die die Snowden ihm strickt."
                            },
                            {
                                "example_id": "6fa13f18-23a4-44e1-b59b-a0309acbd2ec",
                                "sense_id": "2faf2607-d060-3672-9618-bd6ac97e5125",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Snowden kommt, geht der Herr Snowden.“"
                            },
                            {
                                "example_id": "6fd05d33-29a4-4937-9a79-72e1d9fb2ea4",
                                "sense_id": "2faf2607-d060-3672-9618-bd6ac97e5125",
                                "text": "Snowden kommt und geht."
                            },
                            {
                                "example_id": "f4dc33ca-daad-49a4-a476-d3c69e243fe5",
                                "sense_id": "2faf2607-d060-3672-9618-bd6ac97e5125",
                                "text": "Snowdens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
