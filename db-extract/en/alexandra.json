                                            {
                                                "example_id": "7c33b6b9-ca0b-44dd-8579-94b2f28ee04f",
                                                "sense_id": "424557be-3632-3be3-930c-5284d3e8279a",
                                                "text": "V jedné z vedlejších rolí filmu Čertova nevěsta jsme mohli vidět také bývalého televizního hlasatele Alexandra Hemalu."
                                            }
