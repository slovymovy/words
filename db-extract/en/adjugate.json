                                            {
                                                "example_id": "1c457828-83f8-413f-932d-33a00a786abb",
                                                "sense_id": "b39aa681-8860-3d16-adf0-f290dd1b8d33",
                                                "text": "König Sigmund vereinte die Herzogtümer der Gegend unter seinem Zepter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b4690638-5a41-3ec3-b617-a18772d4f2ac",
                                        "entry_id": "f6133156-3c25-3cc1-9213-850d3a30c821",
                                        "glosses": [
                                            "sich zusammentun"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c682d43-a6f0-41b3-a703-2250d8dc9215",
                                                "sense_id": "b4690638-5a41-3ec3-b617-a18772d4f2ac",
                                                "text": "„In Kairo vereinten sich die algerischen Pilger mit ihren ägyptischen Glaubensbrüdern zu einer gigantischen Karawane, um die verbleibende Strecke bis nach Mekka gemeinsam zurückzulegen.“"
                                            }
