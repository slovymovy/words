                ],
                "senses": [
                    {
                        "sense_id": "5b18cab2-0c90-3d97-a81e-f2b72ef5a063",
                        "entry_id": "0898ce64-ef48-327c-9f9d-08e571dc01fe",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60d397f7-cf87-4be1-9731-29dd301dea6b",
                                "sense_id": "5b18cab2-0c90-3d97-a81e-f2b72ef5a063",
                                "text": "Frau Jorzig ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dc9d6960-cc47-4ed2-8b28-9ca356a69fa7",
                                "sense_id": "5b18cab2-0c90-3d97-a81e-f2b72ef5a063",
                                "text": "Herr Jorzig wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5afb1e0b-3329-48fc-b186-29b3683a1390",
                                "sense_id": "5b18cab2-0c90-3d97-a81e-f2b72ef5a063",
                                "text": "Die Jorzigs kommen heute vom Vierwaldstättersee."
                            },
                            {
                                "example_id": "a04de74c-c537-4ddf-9d38-867174f9e630",
                                "sense_id": "5b18cab2-0c90-3d97-a81e-f2b72ef5a063",
                                "text": "Der Jorzig trägt nie die Schals, die die Jorzig ihm strickt."
                            },
                            {
                                "example_id": "71f11991-dbc7-48fe-a930-428d72b983ce",
                                "sense_id": "5b18cab2-0c90-3d97-a81e-f2b72ef5a063",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jorzig kommt, geht der Herr Jorzig.“"
                            },
                            {
                                "example_id": "48616b79-32e7-43b7-bf84-1a3d12c481a0",
                                "sense_id": "5b18cab2-0c90-3d97-a81e-f2b72ef5a063",
                                "text": "Jorzig kommt und geht."
                            },
                            {
                                "example_id": "f92260dd-b015-45e5-8f1e-6964956158eb",
                                "sense_id": "5b18cab2-0c90-3d97-a81e-f2b72ef5a063",
                                "text": "Jorzigs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "5d0da233-48a5-4bd5-9e21-1479f756fab1",
                                "sense_id": "5b18cab2-0c90-3d97-a81e-f2b72ef5a063",
                                "text": "An verregneten Herbsttagen ist Familie Jorzigs liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "e8c15793-3f48-4dab-9c35-e810e300b416",
                                "sense_id": "5b18cab2-0c90-3d97-a81e-f2b72ef5a063",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Jorzig das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
