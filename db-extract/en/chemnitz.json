                                    {
                                        "sense_id": "af7a2b11-73d0-39f7-a478-83216e4d82ef",
                                        "entry_id": "3c33014e-8949-3972-b423-0c4ed1ab52e0",
                                        "glosses": [
                                            "Ville, commune et arrondissement d’Allemagne, située dans la Saxe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d20b9471-19d6-4340-af7e-0fdc11278fee",
                                                "sense_id": "af7a2b11-73d0-39f7-a478-83216e4d82ef",
                                                "text": "Avait-elle, ainsi que des malveillants le prétendirent, de lointaines accointances à la cour du roi de Saxe dont les bandes pouilleuses levées dans les faubourgs de Leipzick, de Chemnitz et de Dresde, occupèrent à poste fixe, dès le 18 septembre, l’espace compris entre Chelles et Claye, de la Marne à la route d’Allemagne ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a78c446b-903a-45c3-a883-98568b7482b6",
                        "source_entry_id": "ab6ba4f7-208a-30cb-8a5b-ecde464395d4",
                        "source_sense_id": "7eb977b7-b35f-3b11-bafb-189becb49637",
                        "source_sense_description": "city in Saxony",
                        "target_lang_word": "Chemnitz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chemnitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b98c2ba-b913-35ad-b077-f367130faf51",
                                        "entry_id": "8d570abf-66dd-38cf-8b51-8c7d39c39bee",
                                        "glosses": [
                                            "Großstadt in Sachsen, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "008b6de0-5465-4457-af95-e2a49b8934df",
                                                "sense_id": "1b98c2ba-b913-35ad-b077-f367130faf51",
                                                "text": "Das Chemnitz der Kaiserzeit ist weitgehend unerforscht."
                                            },
                                            {
                                                "example_id": "8bfa4910-17ed-47cd-b9c8-2182698bf441",
                                                "sense_id": "1b98c2ba-b913-35ad-b077-f367130faf51",
                                                "text": "Ich bin in Chemnitz geboren."
                                            },
                                            {
                                                "example_id": "51047e8d-4d21-4fe1-8780-1166b21d899b",
                                                "sense_id": "1b98c2ba-b913-35ad-b077-f367130faf51",
                                                "text": "Wir haben in Chemnitz unseren Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "ec0987c5-1f3c-43bf-99a4-4a48a39120a3",
                                                "sense_id": "1b98c2ba-b913-35ad-b077-f367130faf51",
                                                "text": "Nach Chemnitz führen viele Wege."
                                            },
                                            {
                                                "example_id": "84fb76e5-ea3e-495c-aeb8-94108b4121b0",
                                                "sense_id": "1b98c2ba-b913-35ad-b077-f367130faf51",
                                                "text": "Das Chemnitz des 18. Jahrhunderts hinterließ noch einen ländlichen Eindruck."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f1b5f4d-490c-3424-916f-ef6399534a88",
                                        "entry_id": "8d570abf-66dd-38cf-8b51-8c7d39c39bee",
                                        "glosses": [
                                            "Stadtkreis in Sachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea29543d-19dd-4be1-95a8-924fc731c865",
                                                "sense_id": "5f1b5f4d-490c-3424-916f-ef6399534a88",
                                                "text": "Der Stadtkreis Chemnitz hatte 1875 circa 85.000 Einwohner."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Chemnitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c9f5fa0-fb30-376e-abea-f68f145d9f55",
                                        "entry_id": "1b16a635-2898-3591-bf7c-ae02c54893a7",
                                        "glosses": [
                                            "Fluss in Sachsen, durch Chemnitz fließend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad413053-f7e5-4e4d-9d51-9a897650e174",
                                                "sense_id": "3c9f5fa0-fb30-376e-abea-f68f145d9f55",
                                                "text": "Fahr mit mir die Chemnitz hinunter!"
                                            },
                                            {
                                                "example_id": "e62446ae-162c-4dd1-b4ab-457497a301f2",
                                                "sense_id": "3c9f5fa0-fb30-376e-abea-f68f145d9f55",
                                                "text": "Wir überquerten die Chemnitz."
                                            },
                                            {
                                                "example_id": "c35ba3a4-2b5a-42f7-b60d-94847f14c0de",
                                                "sense_id": "3c9f5fa0-fb30-376e-abea-f68f145d9f55",
                                                "text": "Die Kinder versuchten, in der Chemnitz zu baden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Chemnitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f267ef65-9620-3e6e-8597-90ce4879d374",
                                        "entry_id": "3041e04e-1936-3c8b-a044-b626c2ac6eb5",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae92b6d7-13f7-46a0-9776-70732aed9ba2",
                                                "sense_id": "f267ef65-9620-3e6e-8597-90ce4879d374",
                                                "text": "Chemnitzens kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "35fa95ce-dc56-415e-90ab-d71dc7c527c3",
                                                "sense_id": "f267ef65-9620-3e6e-8597-90ce4879d374",
                                                "text": "Frau Chemnitz ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "3989006e-f356-4c1c-a7d2-535b27950740",
                                                "sense_id": "f267ef65-9620-3e6e-8597-90ce4879d374",
                                                "text": "Herr Chemnitz wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "8a2bb386-1c13-4763-a30a-f3470974421d",
                                                "sense_id": "f267ef65-9620-3e6e-8597-90ce4879d374",
                                                "text": "Die Chemnitzens kommen heute aus dem Vogtland."
                                            },
                                            {
                                                "example_id": "fda963ce-f5d7-48cc-8e98-1d470b0166d9",
                                                "sense_id": "f267ef65-9620-3e6e-8597-90ce4879d374",
                                                "text": "Der Chemnitz trägt nie die Schals, die die Chemnitz ihm strickt."
                                            },
                                            {
                                                "example_id": "83b8bfea-2e39-4102-b784-b8b3aa3899b7",
                                                "sense_id": "f267ef65-9620-3e6e-8597-90ce4879d374",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Chemnitz kommt, geht der Herr Chemnitz.“"
                                            },
                                            {
                                                "example_id": "827e41f7-ec78-4a8b-b190-f00ab5923b8d",
                                                "sense_id": "f267ef65-9620-3e6e-8597-90ce4879d374",
                                                "text": "Chemnitz kommt und geht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
