                "senses": [
                    {
                        "sense_id": "cb3b73ab-58cb-3b38-b133-4abfa483ec02",
                        "entry_id": "f9a1e68c-de8a-38ad-a571-fb7d8c577c6d",
                        "glosses": [
                            "Schlüssel, mit dem ein Aufzug bedient werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9968168b-5153-4ecf-8fe1-6b5aaa1e1770",
                                "sense_id": "cb3b73ab-58cb-3b38-b133-4abfa483ec02",
                                "text": "„Mit einem Aufzugsschlüssel, den nur die Direktion und Oberkellner Alfred benutzen durften, versuchte dieser auf der Zwischenetage zwischen Hotelempfang und erstem Stockwerk den Personenlift zu stoppen.“"
                            },
                            {
                                "example_id": "47de848b-1a27-4484-9549-4cabd3a8a039",
                                "sense_id": "cb3b73ab-58cb-3b38-b133-4abfa483ec02",
                                "text": "„Schüler, die aufgrund von Krankheit oder anderen Beeinträchtigungen Probleme mit dem Treppensteigen haben, können von den Hausmeistern einen Aufzugsschlüssel erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c42dcb9a-4ea1-3e3e-a4f5-cce00ade2020",
                        "entry_id": "f9a1e68c-de8a-38ad-a571-fb7d8c577c6d",
                        "glosses": [
                            "Schlüssel, mit dem man eine Uhr oder ein anderes Gerät (zum Beispiel aufziehbare Spielzeuge) aufziehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a136c45f-d730-41b7-b911-49c325d20e12",
                                "sense_id": "c42dcb9a-4ea1-3e3e-a4f5-cce00ade2020",
                                "text": "„Die Aufzugsschlüssel haben die Form von Gehstöcken mit Stein im Knauf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
