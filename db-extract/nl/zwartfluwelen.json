                                "sense_id": "e43e11e0-377f-34bc-834b-2be6176bc934",
                                "text": "Zij droeg een statige zwartfluwelen mantel."
                            },
                            {
                                "example_id": "1db95544-7752-4e03-898f-88883d7b6ddc",
