                "senses": [
                    {
                        "sense_id": "efd4b462-a86f-384a-a049-005931adfb35",
                        "entry_id": "2b5a5f53-2bf4-30a7-8956-70f4f124d811",
                        "glosses": [
                            "Schule für die gebildete Bevölkerungsschicht (mit Latein als Unterrichtsschwerpunkt)"
                        ],
                        "tags": [
                            "früher"
                        ],
                        "examples": [
                            {
                                "example_id": "d5d2443e-e06e-412a-a6fb-95a8040ebf0d",
                                "sense_id": "efd4b462-a86f-384a-a049-005931adfb35",
                                "text": "„Wo Luther von der Schule sprach, da hatte er fast immer die Lateinschule im Sinn .“"
                            },
                            {
                                "example_id": "70ec7b45-6811-4f36-90fc-a7978333fc8f",
                                "sense_id": "efd4b462-a86f-384a-a049-005931adfb35",
                                "text": "„Diese Sprache mußte aber nun, da sie niemandes Muttersprache mehr war, in Kloster- und Lateinschulen in Wort und Schrift erst mühsam erlernt werden, hatte aber den unschätzbaren Vorteil, daß sie dann ein supranationales Verständigungsmittel darstellte und überdies nahtlos an die schriftliche Trdition des Lateinischen der Antike anknüpfen konnte.“"
                            },
                            {
                                "example_id": "62a25f80-b9b4-40ce-9666-12c8a703532f",
                                "sense_id": "efd4b462-a86f-384a-a049-005931adfb35",
                                "text": "„Bemerkenswert erscheint der Hinweis, dass 1502 ein Konrad Kunne das Amt des Schulmeisters der städtischen Lateinschule bekleidete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
