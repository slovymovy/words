                        ]
                    },
                    {
                        "translation_id": "c01a1fc0-0db2-4801-8975-0ea38788ff5f",
                        "source_entry_id": "21c22698-857d-3020-98dc-2b801dbcdc4e",
                        "target_lang_word": "européaniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "européaniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "def86e2c-1766-3af9-a264-971eadd259b6",
                                        "entry_id": "eb321c75-9f6d-3bcc-b801-5f32f989ec63",
                                        "glosses": [
                                            "Rendre (des étrangers) plus européen ou plus conforme aux pratiques européennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1b20e8-e962-4dae-b028-55a574b122a8",
                                                "sense_id": "def86e2c-1766-3af9-a264-971eadd259b6",
                                                "text": "Quelques années, passées en Europe, sans doute, ont certainement européanisé ses manières et même son costume."
                                            },
                                            {
                                                "example_id": "dc1c8551-8904-4ef2-9389-d245c1fe67e6",
                                                "sense_id": "def86e2c-1766-3af9-a264-971eadd259b6",
                                                "text": "Les deux seules tentatives pour européaniser l’Abyssinie avaient été amorcées par Ménélik. C’était une réorganisation de l’armée -[…]- et l’établissement de la voie ferrée (1908) construite et exploitée par une compagnie française."
                                            },
                                            {
                                                "example_id": "14cfd65f-e347-4824-a79d-90abe3a5d4cb",
                                                "sense_id": "def86e2c-1766-3af9-a264-971eadd259b6",
                                                "text": "Les intérêts de l’Europe sont que ces trois parties se civilisent, afin que l’homme, partout européen ou européanisé, agrandisse le cercle de nos idées, de nos jouissances, et multiplie les points sensibles de notre existence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "416d8d6d-14cf-31ae-8cc3-d71133137f91",
                                        "entry_id": "eb321c75-9f6d-3bcc-b801-5f32f989ec63",
                                        "glosses": [
                                            "Rendre plus européen ou plus conforme aux pratiques européennes ce qui est local ou national"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "176469cd-7d04-41d4-8f38-a26d3301fdf6",
                                                "sense_id": "416d8d6d-14cf-31ae-8cc3-d71133137f91",
                                                "text": "On s'intéresse essentiellement à ce que fait Emmanuel Macron, ce que ne fait pas Emmanuel Macron et comment cela va être possible éventuellement de le mettre en difficulté. On a du mal à \"européaniser ce scrutin.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
