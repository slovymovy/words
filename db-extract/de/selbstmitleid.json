                "senses": [
                    {
                        "sense_id": "ff0e2f6f-d9b5-3436-a3e8-406178d7e1e7",
                        "entry_id": "e8fc8ae6-fe35-3687-a64e-e9b2356acda2",
                        "glosses": [
                            "Gefühl des Mitleids mit sich selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "980f4846-4fbf-479c-b2ce-3a41fc6c518b",
                                "sense_id": "ff0e2f6f-d9b5-3436-a3e8-406178d7e1e7",
                                "text": "„Sie empfindet Selbstmitleid.“"
                            },
                            {
                                "example_id": "a9aeb949-4c3d-4bbc-ae33-ea893a4555f9",
                                "sense_id": "ff0e2f6f-d9b5-3436-a3e8-406178d7e1e7",
                                "text": "„So fiel er in ein tiefes Tal des Selbstmitleids und sang das herzergreifende Lamentoso des Orpheus.“"
                            },
                            {
                                "example_id": "d5ab81f5-95d9-4d6d-8282-df882c9a862e",
                                "sense_id": "ff0e2f6f-d9b5-3436-a3e8-406178d7e1e7",
                                "text": "„Ihr Mann hatte lange mit Dingen aus seiner Vergangenheit zu kämpfen und ein Alkoholproblem, und Tove fürchtete, er könne den Halt verlieren, wieder zu trinken beginnen, Anfälle von Tobsucht und Selbstmitleid bekommen, wenn sie ihn verließe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
