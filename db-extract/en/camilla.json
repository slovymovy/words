                        "entry_id": "32045906-54d6-3576-aec6-691711106bce",
                        "glosses": [
                            "A warrior queen of the Volscians according to Virgil's Aeneid."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "55f5820e-92a9-3d9a-826b-b1e3aaba6160",
                        "entry_id": "32045906-54d6-3576-aec6-691711106bce",
                        "glosses": [
                            "A female given name from Latin."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "df817786-90d0-4fdc-b601-122f7d9844f2",
                                "sense_id": "55f5820e-92a9-3d9a-826b-b1e3aaba6160",
                                "text": "Fancy southern names which she couldn't remember five minutes after they'd told her. Camilla? Amelia? Jemima? It didn't matter. Ashworth would have made a note of them."
                            }
                        ]
                    },
                    {
                        "sense_id": "d62c22c8-0bc0-3629-aebe-4e5910311d6d",
                        "entry_id": "32045906-54d6-3576-aec6-691711106bce",
                        "glosses": [
                            "A city, the county seat of Mitchell County, Georgia, United States."
                        ],
