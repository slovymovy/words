                        "sense_id": "e2642aab-4eba-31cd-8c3f-748afd8b9764",
                        "entry_id": "fd6304bd-9f9d-3fc2-ba32-fe7a6bb255a6",
                        "glosses": [
                            "Variante orthographique de biodiesel."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "172a4ec4-cca9-4964-8bd8-b702252f886a",
                                "sense_id": "e2642aab-4eba-31cd-8c3f-748afd8b9764",
                                "text": "En 2005, les États-Unis ont succédé au Brésil comme premier producteur mondial d’éthanol, alors que l’Union européenne (UE) est le plus gros producteur de biodiésel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c45a786-9932-4880-9af9-b48bb8fbf649",
                        "source_entry_id": "fd6304bd-9f9d-3fc2-ba32-fe7a6bb255a6",
                        "source_sense_id": "e2642aab-4eba-31cd-8c3f-748afd8b9764",
                        "target_lang_word": "biodiesel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biodiesel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b9b7303-f12b-393d-a01b-58695648e680",
                                        "entry_id": "1aff0170-7bf4-3112-a115-d966d823f563",
                                        "glosses": [
                                            "Fuel for diesel engines made from renewable organic raw materials, as opposed to fossil hydrocarbons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46604b03-b499-47cf-b512-81d4c6684c1b",
                                                "sense_id": "1b9b7303-f12b-393d-a01b-58695648e680",
                                                "text": "Biodiesel is an increasingly popular alternative fuel because it's made by refining oil. Thinner than vegetable oil, biodiesel can power diesel engines without further conversion."
                                            },
                                            {
                                                "example_id": "7179c9cb-3aff-4a81-8402-abbf245d9cc5",
                                                "sense_id": "1b9b7303-f12b-393d-a01b-58695648e680",
                                                "text": "Biodiesel is a technologically feasible alternative to petrodiesel, but nowadays biodiesel costs 1.5 to 3 times more than fossil diesel in developed countries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bb479f5-f5c9-4da3-8197-0fbe49ec93c5",
                        "source_entry_id": "fd6304bd-9f9d-3fc2-ba32-fe7a6bb255a6",
                        "source_sense_id": "e2642aab-4eba-31cd-8c3f-748afd8b9764",
                        "target_lang_word": "biofuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biofuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                        "entry_id": "e0fb236a-3cb2-3cd7-b58f-4f181c4640af",
                                        "glosses": [
                                            "Any fuel that is obtained from a renewable biological resource, especially from biomass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7eef6db-0f59-4a0a-83e7-429aff85058c",
                                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                                "text": "Even second-generation biofuels, made from crop wastes or wood, are an environmental disaster, either extending the cultivated area or removing the straw and stovers which protect the soil from erosion and keep carbon and nutrients in the ground."
                                            },
                                            {
                                                "example_id": "86a12086-d47b-4836-84ed-afdac1311da3",
                                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                                "text": "The Environmental Protection Agency announced proposed changes to its biofuels program Tuesday to spur more biofuel use and crack down on waivers issued to refineries by the Trump administration, notching a win for the biofuels industry and farmers and a blow to oil refineries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
