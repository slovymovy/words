                        "examples": [
                            {
                                "example_id": "029d26bb-76d3-420c-9ed3-273f9d8943bd",
                                "sense_id": "94b30ce7-6808-3dbc-a88b-8150a6c33cf1",
                                "text": "De manier waarop we werken zal blijvend veranderen, verwachten veel Nederlanders. Uit onderzoek van het Kennisinstituut voor Mobiliteitsbeleid (KiM) blijkt dat een kwart van de mensen die meer zijn gaan thuiswerken, denkt dat in de toekomst te blijven doen. Die mening wordt gedeeld door werkgevers; zij zeggen dat thuiswerken ook na de crisis onderdeel blijft van de werkcultuur."
                            },
                            {
                                "example_id": "b4210e0a-27c5-493a-9252-1ae0f1e06775",
                                "sense_id": "94b30ce7-6808-3dbc-a88b-8150a6c33cf1",
                                "text": "De overheid baseert zich op andere cijfers, van het Kennisinstituut voor Mobiliteitsbeleid, waarin staat dat volgend jaar alweer 97 procent van de reizigers terugkeert naar de treinen, bussen, trams en metro's."
                            }
                        ]
