                    },
                    {
                        "translation_id": "93c59ebe-bf16-4367-9a87-287fbc7f36ad",
                        "source_entry_id": "e79852b6-361a-3119-952e-9380c9688981",
                        "source_sense_id": "86811f75-63b8-32d1-b22a-a3037dac2abd",
                        "source_sense_description": "een gebeurtenis waarbij op grote schaal bloed vergoten wordt",
                        "target_lang_word": "massacre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "massacre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                        "entry_id": "0390ac39-5e97-3cba-80b2-857864ba4a50",
                                        "glosses": [
                                            "Action de massacrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "441e8240-1446-4c4b-88ed-a1bd59e3a3f7",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "Dans les salles cinématographiques de Mars, après les massacres de Kitnicheff, les scènes de la guerre balkanique récoltaient le plus d'applaudissements. Tout le monde s'efforçait de découvrir la signification de ces charivaris effarants."
                                            },
                                            {
                                                "example_id": "08be6b5f-32a3-4740-8328-360330c58bf5",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "Ici, les gens parlaient d’incendies et de massacres, de cruautés et de représailles, du meurtre d’inoffensifs Asiatiques par des tourbes que déchaînait la haine de race, de villes mises à sac et complètement brûlées."
                                            },
                                            {
                                                "example_id": "b16d6424-3c44-49cb-ac41-afbb7b1adab7",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "S'ils se sont répandus, nombreux, à travers d'autres pays, c'est soit pour fuir des catastrophes (guerres, révolutions, massacres,) soit pour échapper aux inconvénients de la surpopulation."
                                            },
                                            {
                                                "example_id": "04c7e6bf-a04f-4fd6-8077-8eef326a46f8",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "J'avais des lettres de Gontier, qui n'étaient pas réconfortantes ; les batteries étaient à Verdun et les obus y faisaient des massacres."
                                            },
                                            {
                                                "example_id": "73946e8e-58f5-4bf3-bf57-e1a538435ec3",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "Le mouvement pacifiste, au XXᵉ siècle, a été très largement porté par les femmes, plus sensibles que les hommes à l'absurdité d'une puissance qui s'édifie en semant la mort, et qui appelle « champs d'honneur » les lieux des pires massacres."
                                            },
                                            {
                                                "example_id": "53077ca3-35c6-4f0f-83e0-44cc7924dda3",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "Sans remonter à l’événement traumatique fondateur que furent les massacres de la Saint-Barthélemy, on rappellera que la minorité réformée fut l'objet, sous Louis XIV, d'un « mémoricide » sans précédent : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33f886b4-bda9-35b5-8597-b607915e84b1",
                                        "entry_id": "0390ac39-5e97-3cba-80b2-857864ba4a50",
                                        "glosses": [
                                            "Grande tuerie de gibier, d'animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc9d5da-e61d-4983-824c-56540949cca2",
                                                "sense_id": "33f886b4-bda9-35b5-8597-b607915e84b1",
                                                "text": "Cet enclos est une canardière ; ces massacres ont lieu presque journellement, et les victimes en sont d'innombrables canards, attirés par ce silence absolu, garantie menteuse d'une parfaite sécurité !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6285bd58-c458-3738-9400-80df49679812",
                                        "entry_id": "0390ac39-5e97-3cba-80b2-857864ba4a50",
                                        "glosses": [
                                            "Ramure, tête du gibier tué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32104aac-4e5d-46c8-8a59-53cda6ec2310",
                                                "sense_id": "6285bd58-c458-3738-9400-80df49679812",
                                                "text": "On connaît ainsi plusieurs exemples où d’énormes massacres d’aurochs, qui ont été trouvés sur le sol des cavernes, semblent être tombés des parois."
                                            },
                                            {
                                                "example_id": "44a969fb-8349-4bc8-86ab-08543c82f55b",
                                                "sense_id": "6285bd58-c458-3738-9400-80df49679812",
                                                "text": "Les chasseurs accrochent à leurs murs des hures de sangliers et des massacres de cerfs : vous, vous devriez y épingler des pucelages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53da72e-66e2-354c-81bc-8e033de66d6a",
                                        "entry_id": "0390ac39-5e97-3cba-80b2-857864ba4a50",
                                        "glosses": [
                                            "Discours, critique très sévère qui n’épargne rien ni personne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aee4d81f-80a9-4ea0-b00f-09e1cb25fd1f",
                                                "sense_id": "e53da72e-66e2-354c-81bc-8e033de66d6a",
                                                "text": "Cet article est un véritable massacre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac6f7d65-3fff-3cc2-b6ea-1d0404800b11",
                                        "entry_id": "0390ac39-5e97-3cba-80b2-857864ba4a50",
                                        "glosses": [
                                            "Meuble représentant une ramure de cervidé attachée à un crâne complet ou non dans les armoiries. Il est représenté de front. À rapprocher de caboché, hure, massacre crucifère, rencontre et tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edbba15c-ce3d-4274-9eca-5f6c97987c42",
                                                "sense_id": "ac6f7d65-3fff-3cc2-b6ea-1d0404800b11",
                                                "text": "De sable au massacre de cerf d’argent, qui est de Venère de Haute-Saône → voir illustration « armoiries avec un massacre »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "massacre",
