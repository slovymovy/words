                    {
                        "translation_id": "730a4676-47f4-4ad7-83fa-078fa725c6bb",
                        "source_entry_id": "93d941f1-8e75-3160-ba7a-b67fc161591d",
                        "source_sense_id": "deeda71d-dfe6-3cb9-bc0f-6506699f90a9",
                        "source_sense_description": "een verandering ten goede",
                        "target_lang_word": "amélioration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amélioration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79021c52-af6d-37a0-a86b-c9e958030584",
                                        "entry_id": "fc6e1d30-7a96-3951-8cab-bdfe5b834abd",
                                        "glosses": [
                                            "Action de prendre quelque chose pour le transformer en le rendant meilleur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19e112c6-c3dc-473f-9be5-6cc50b7b34ca",
                                                "sense_id": "79021c52-af6d-37a0-a86b-c9e958030584",
                                                "text": "Le kaizen est un processus d'améliorations concrètes, simples et peu onéreuses réalisées dans un laps de temps très court."
                                            },
                                            {
                                                "example_id": "458e4cfd-8109-4215-88b2-0b0bf5c5e0b0",
                                                "sense_id": "79021c52-af6d-37a0-a86b-c9e958030584",
                                                "text": "Il n’est pas de question zootechnique qui ait été plus débattue, plus controversée que celle de l’amélioration des races chevalines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca5fd307-a59d-3f9f-8b04-0ef491014ad2",
                                        "entry_id": "fc6e1d30-7a96-3951-8cab-bdfe5b834abd",
                                        "glosses": [
                                            "Résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "759315a5-3170-4643-8b87-c90ebd9ae6b3",
                                                "sense_id": "ca5fd307-a59d-3f9f-8b04-0ef491014ad2",
                                                "text": "Le Dʳ Aignier déclare au Congrès des monistes (Magdebourg, 6-10 septembre 1912) n’avoir constaté à Lourdes ni guérison ni amélioration véritables."
                                            },
                                            {
                                                "example_id": "4ac5a7b5-52c6-497e-a7e2-b6fdb0bbcb10",
                                                "sense_id": "ca5fd307-a59d-3f9f-8b04-0ef491014ad2",
                                                "text": "Une psychasthénique mysophobe, avec rituels de propreté, n’a accusé aucune amélioration par le R 1625. Il convient cependant de multiplier les essais chez les obsédés-phobiques."
                                            },
                                            {
                                                "example_id": "82eff728-84be-4e0b-9f02-87465d5a53e2",
                                                "sense_id": "ca5fd307-a59d-3f9f-8b04-0ef491014ad2",
                                                "text": "Tout échange monétaire est délicat : il serait bon de faire coïncider l'introduction du saarmark, et plus encore l'introduction du franc, avec une amélioration des conditions matérielles et politiques de la vie sarroise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                        "entry_id": "fc6e1d30-7a96-3951-8cab-bdfe5b834abd",
                                        "glosses": [
                                            "Investissement dans un fonds de terre ou dans une maison pour les mettre en état et pour en augmenter le revenu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f865aab1-84f6-4285-83e8-6581983f0d35",
                                                "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                                "text": "Ce dernier conservera toujours sa valeur pour la culture intensive ; les scories Thomas, grâce au bon marché de leur acide phosphorique, doivent servir seulement à l’amélioration des grandes étendues des sols de minime valeur."
                                            },
                                            {
                                                "example_id": "36d499a6-eac2-4797-87e9-bcb2e80180e4",
                                                "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                                "text": "Le problème de l’excès de sel se pose dans de nombreux périmètres irrigués des régions sèches. Leur amélioration peut se faire par des apports de gypse ou de phosphogypse."
                                            },
                                            {
                                                "example_id": "793097f5-d713-44e8-ab6e-cda830f35401",
                                                "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                                "text": "L’éclaircie est généralement une coupe d’amélioration réalisée dans un peuplement régulier dans le but de favoriser la stabilité, la dominance et la croissance soutenue des tiges d’avenir."
                                            },
                                            {
                                                "example_id": "c4e38382-b5cc-459d-976b-42d7172961da",
                                                "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                                "text": "Améliorations utiles."
                                            },
                                            {
                                                "example_id": "fa0ef0b6-ad1e-4450-8781-b2609386475f",
                                                "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                                "text": "Améliorations voluptuaires, qui n’ont en vue que l’agrément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3515ebea-08dd-324c-bc92-08113ef0ae80",
                                        "entry_id": "fc6e1d30-7a96-3951-8cab-bdfe5b834abd",
                                        "glosses": [
                                            "Amélioration des plantes : technique qui consiste à rendre les variétés mieux adaptées aux besoins des utilisateurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98138a40-fe80-3ec3-8e05-91d2144f2376",
                                        "entry_id": "fc6e1d30-7a96-3951-8cab-bdfe5b834abd",
                                        "glosses": [
                                            "Augmentation de la qualité globale d’un peuplement par la coupe de tiges au profit d’essences de plus grande valeur, d’arbres à la bille de pied mieux conformée…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc2dbbab-fcb5-405c-b35b-3371b412230f",
                                                "sense_id": "98138a40-fe80-3ec3-8e05-91d2144f2376",
                                                "text": "La qualification est la phase qui débute lorsque le peuplement a atteint la hauteur de 3 m (qui marque, par convention, le seuil de passage de la phase de régénération à la phase d’amélioration) et s’achève lorsque la hauteur dominante du peuplement atteint 11 à 14 m selon l’essence et la fertilité de la station."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
