                            }
                        },
                        {
                            "text": "Getting a <w>midnight</w> on the first throw is considered bad luck here.",
                            "target_lang_translations": {
                                "ru": "Выпадение <двух шестёрок> при первом броске здесь считается плохой приметой.",
                                "zh": "在这里，第一掷就掷出<w>双六</w>被认为是不吉利的。"
                            }
                        }
                    ],
                    "synonyms": [
