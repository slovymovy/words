            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f3f750be-3e03-338c-9ae2-5ef04eeaf41c",
                    "sense_definition": "Zapewniający komfort fizyczny, przyjemny w użyciu i dający poczucie odprężenia.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiłem nowe, bardzo <w>wygodne</w> buty do biegania po lesie.",
                            "target_lang_translations": {
                                "ru": "Я купил новые, очень <w>удобные</w> кроссовки для бега по лесу.",
                                "de": "Ich habe neue, sehr <w>bequeme</w> Laufschuhe für den Wald gekauft."
                            }
                        },
                        {
                            "text": "Ten stary fotel jest niezwykle <w>wygodny</w> do czytania książek wieczorami.",
                            "target_lang_translations": {
                                "ru": "Это старое кресло чрезвычайно <w>удобное</w> для чтения книг по вечерам.",
                                "de": "Dieser alte Sessel ist abends extrem <w>bequem</w> zum Lesen von Büchern."
                            }
                        }
                    ],
                    "synonyms": [
                        "komfortowy",
                        "przyjemny"
                    ],
                    "antonyms": [
                        "niewygodny",
                        "niekomfortowy"
                    ],
                    "common_phrases": [
                        "wygodne buty",
                        "wygodny fotel",
                        "wygodne łóżko",
                        "wygodne ubranie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивающий физический комфорт, приятный в использовании и дающий чувство расслабления.",
                        "de": "Körperlichen Komfort bietend, angenehm in der Nutzung und ein Gefühl der Entspannung vermittelnd."
                    },
                    "translations": {
