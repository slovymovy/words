{
    "word_family": [
        "conduct",
        "ductile",
        "conduit",
        "abduct",
        "deduct",
        "induct",
        "product",
        "reduction"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9a454a5-3791-33d2-9b4f-3226cd847e96",
                    "sense_definition": "A pipe, tube, or channel that carries gas, liquid, or air from one place to another.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to clean the air conditioning <w>duct</w> before summer starts. ",
                            "target_lang_translations": {
                                "ru": "Нам нужно почистить <w>воздуховод</w> кондиционера до начала лета."
                            }
                        },
                        {
                            "text": "The builder installed a ventilation <w>duct</w> in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Строитель установил на кухне вентиляционный <w>канал</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pipe",
                        "tube",
                        "conduit"
                    ],
                    "common_phrases": [
                        "ventilation duct",
                        "air duct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Труба, короб или канал для транспортировки газа, жидкости или воздуха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздуховод",
                                "target_lang_sense_clarification": "для систем вентиляции и кондиционирования"
                            },
                            {
                                "target_lang_word": "канал",
                                "target_lang_sense_clarification": "труба или трубка для передачи жидкостей или газов"
                            },
                            {
                                "target_lang_word": "труба",
                                "target_lang_sense_clarification": "полый цилиндрический предмет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55420bec-a188-3e24-947a-c13a77ef74a2",
                    "sense_definition": "A body vessel or passage that conveys bodily fluids, such as tears, bile, or lymph.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A blocked tear <w>duct</w> can cause eyes to become watery and irritated.",
                            "target_lang_translations": {
                                "ru": "Закупоренный слезный <w>проток</w> может вызвать слезотечение и раздражение глаз."
                            }
                        },
                        {
                            "text": "The surgeon carefully checked the bile <w>duct</w> during the operation.",
                            "target_lang_translations": {
                                "ru": "Во время операции хирург тщательно осмотрел желчный <w>проток</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vessel",
                        "canal"
                    ],
                    "common_phrases": [
                        "tear duct",
                        "bile duct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Анатомический проток или канал, проводящий жидкости организма (слезы, желчь, лимфу)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проток",
                                "target_lang_sense_clarification": "анатомический канал в организме"
                            },
                            {
                                "target_lang_word": "канал",
                                "target_lang_sense_clarification": "трубчатое образование в организме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac75c5be-50d4-32b9-bd1a-40cc772270e1",
                    "sense_definition": "A protective casing, enclosure, or channel used for routing electrical cables or wires.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All electrical cables were hidden inside a plastic cable <w>duct</w>.",
                            "target_lang_translations": {
                                "ru": "Все электрические кабели были спрятаны внутри пластикового кабельного <w>канала</w>."
                            }
                        },
                        {
                            "text": "Workers laid a heavy-duty cable <w>duct</w> under the street.",
                            "target_lang_translations": {
                                "ru": "Рабочие проложили высокопрочный кабельный <w>короб</w> под улицей."
                            }
                        }
                    ],
                    "synonyms": [
                        "channel",
                        "casing"
                    ],
                    "common_phrases": [
                        "cable duct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитный короб или канал для прокладки электрических кабелей или проводов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабельный канал",
                                "target_lang_sense_clarification": "короб или труба для прокладки кабелей"
                            },
                            {
                                "target_lang_word": "короб",
                                "target_lang_sense_clarification": "защитный профиль для электропроводки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dbd8697-ff38-3154-afda-8840de0e1f99",
                    "sense_definition": "A vessel or tube in plants that carries water, sap, or nutrients.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water travels from the roots to the leaves through microscopic plant <w>ducts</w>.",
                            "target_lang_translations": {
                                "ru": "Вода поднимается от корней к листьям по микроскопическим <w>сосудам</w> растений."
                            }
                        },
                        {
                            "text": "Botanists studied how the plant <w>duct</w> transports nutrients during cold weather.",
                            "target_lang_translations": {
                                "ru": "Ботаники изучили, как проводящий <w>проток</w> растения транспортирует питательные вещества в холодную погоду."
                            }
                        }
                    ],
                    "synonyms": [
                        "vessel"
                    ],
                    "common_phrases": [
                        "resin duct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд или трубка у растений, транспортирующая воду, сок или питательные вещества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проток",
                                "target_lang_sense_clarification": "канал у растений"
                            },
                            {
                                "target_lang_word": "сосуд",
                                "target_lang_sense_clarification": "элемент проводящей ткани растений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9977aed9-a765-3169-8978-e51a987ed655",
                    "sense_definition": "A layer in the atmosphere or ocean that traps and transmits radio waves or sound signals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An atmospheric <w>duct</w> allowed radio signals to travel much farther than usual.",
                            "target_lang_translations": {
                                "ru": "Атмосферный <w>волновод</w> позволил радиосигналам распространяться намного дальше, чем обычно."
                            }
                        },
                        {
                            "text": "Scientists measured wave propagation through the oceanic sound <w>duct</w>.",
                            "target_lang_translations": {
                                "ru": "Ученые измерили распространение волн через океанический звуковой <w>волновод</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "atmospheric duct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слой в атмосфере или океане, удерживающий и направляющий радиоволны или звуковые сигналы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волновод",
                                "target_lang_sense_clarification": "атмосферный или океанический волновод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "345b2437-2ca6-3d32-9e64-6415d7f78c5e",
                    "sense_definition": "Guidance, direction, or leadership.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They refused to follow the <w>duct</w> of their own base instincts.",
                            "target_lang_translations": {
                                "ru": "Они отказались следовать <w>руководству</w> своих низменных инстинктов."
                            }
                        },
                        {
                            "text": "In ancient texts, humans were warned against relying solely on the <w>duct</w> of personal desire.",
                            "target_lang_translations": {
                                "ru": "В древних текстах людей предостерегали от того, чтобы полагаться исключительно на <w>повод</w> личных желаний."
                            }
                        }
                    ],
                    "synonyms": [
                        "guidance",
                        "direction"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Руководство, направление или управление (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "управление или наставление"
                            },
                            {
                                "target_lang_word": "повод",
                                "target_lang_sense_clarification": "направление или ведение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "778a2063-6aa9-3c47-8466-39e11dab977a",
                    "sense_definition": "To channel or guide something (such as air or signals) through a tube, pipe, or passageway.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system is designed to <w>duct</w> warm air into every room evenly.",
                            "target_lang_translations": {
                                "ru": "Система разработана так, чтобы равномерно <w>подавать</w> теплый воздух в каждую комнату."
                            }
                        },
                        {
                            "text": "Engineers plan to <w>duct</w> air directly to the cooling unit.",
                            "target_lang_translations": {
                                "ru": "Инженеры планируют <w>направить</w> воздух непосредственно к охлаждающему блоку."
                            }
                        }
                    ],
                    "synonyms": [
                        "channel",
                        "pipe",
                        "route"
                    ],
                    "common_phrases": [
                        "duct air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять или проводить что-либо (воздух, сигналы) через трубу, канал или проход."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "передавать по каналу или трубе"
                            },
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "посылать по воздуховоду или трубе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d14d2c22-4a95-380b-9156-2fb6ceace543",
                    "sense_definition": "To place, enclose, or run wires or pipes inside a duct.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Technicians will <w>duct</w> all high-voltage cables to protect them from damage.",
                            "target_lang_translations": {
                                "ru": "Техники <w>проложат в защитных каналах</w> все высоковольтные кабели, чтобы защитить их от повреждений."
                            }
                        },
                        {
                            "text": "It is safer to <w>duct</w> cables before finishing the walls.",
                            "target_lang_translations": {
                                "ru": "Безопаснее <w>убрать в короба</w> кабели до отделки стен."
                            }
                        }
                    ],
                    "synonyms": [
                        "encase",
                        "enclose"
                    ],
                    "common_phrases": [
                        "duct cables"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прокладывать или заключать провода либо трубы внутри защитного канала или короба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокладывать в каналах",
                                "target_lang_sense_clarification": "помещать кабельность или трубы в короба"
                            },
                            {
                                "target_lang_word": "убирать в короб",
                                "target_lang_sense_clarification": "защищать кабельные линии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}