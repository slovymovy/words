                    "frequency": "VeryLow",
                    "semantic_group_id": "waking_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers counted down the days until their final <w>wakey</w> arrived.",
                            "target_lang_translations": {
                                "pl": "Żołnierze odliczali dni do swojego <w>ostatniego dnia służby</w>."
                            }
                        },
                        {
                            "text": "After months away, he was excited to finally reach his <w>wakey</w>.",
                            "target_lang_translations": {
