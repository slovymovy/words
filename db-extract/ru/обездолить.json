                    },
                    {
                        "form_id": "5932a32c-8eb6-41e1-8996-746327ab87a7",
                        "entry_id": "1617ad00-9557-3f55-80de-5895fd5f0513",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "обездо́ливши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02421621-3f78-328e-b41b-246d6071a279",
                        "entry_id": "1617ad00-9557-3f55-80de-5895fd5f0513",
                        "glosses": [
                            "лишить самого необходимого, сделать бедным, нищим"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae364df6-ca4f-4ac3-9175-e6dd96d9cb9d",
                                "sense_id": "02421621-3f78-328e-b41b-246d6071a279",
                                "text": "Сосед мой, ткач, продал полторы десятины за четыреста восемьдесят целковых, сына обездолил, парень на крахмальный завод нанялся."
                            }
                        ]
                    },
                    {
                        "sense_id": "353b8801-3cb4-3f7d-8a37-e9f3fa399e51",
                        "entry_id": "1617ad00-9557-3f55-80de-5895fd5f0513",
                        "glosses": [
                            "сделать несчастным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9788feb-45c7-4563-89a5-53a73bc49038",
                                "sense_id": "353b8801-3cb4-3f7d-8a37-e9f3fa399e51",
                                "text": "Как всякому негодяю со стажем, ему не хватало явственных мучений жертвы. Отчего-то этой породе людей мало просто обокрасть или как-то еще обрести наживу. Им непременно требуется и надругаться: обездолить, изуродовать, привести в ужас."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5178a95c-e48e-4c72-89be-c4770befc637",
                        "source_entry_id": "1617ad00-9557-3f55-80de-5895fd5f0513",
                        "source_sense_description": "лишить самого необходимого, сделать бедным, нищим",
                        "target_lang_word": "elend machen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "987a638a-9895-4056-897c-4e69cfe83608",
                        "source_entry_id": "1617ad00-9557-3f55-80de-5895fd5f0513",
                        "source_sense_description": "лишить самого необходимого, сделать бедным, нищим",
                        "target_lang_word": "dévaster",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dévaster",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df1e0079-82dc-3777-bf24-888f397cc636",
                                        "entry_id": "6fc4c002-65d0-3015-9501-03ed273935c5",
                                        "glosses": [
                                            "Ruiner ; ravager ; piller ; détruire ; faire périr."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed18e4db-f85d-4b82-9b21-a655ca5ad321",
                                                "sense_id": "df1e0079-82dc-3777-bf24-888f397cc636",
                                                "text": "Ils volaient les provisions du logis, ils dévastaient les quelques arbres fruitiers de l’enclos, ils étaient les démons familiers, pillards et criards, de cette étrange maison de la folie lucide."
                                            },
                                            {
                                                "example_id": "08cf06b4-8fbe-4c21-bc8b-487efbde63e7",
                                                "sense_id": "df1e0079-82dc-3777-bf24-888f397cc636",
                                                "text": "Chaque matin, un détachement de soldats précède la colonne pour protéger les douars des velléités pillardes de leurs camarades. Ordre a été donné de ne plus dévaster les champs."
                                            },
                                            {
                                                "example_id": "165798ff-ac06-41d7-9d33-138409c65299",
                                                "sense_id": "df1e0079-82dc-3777-bf24-888f397cc636",
                                                "text": "On la dévasta, comme, au siècle précédent, on avait bombardé d’immenses agglomérations barbares, et parce qu’elle était à la fois trop forte pour être occupée par le vainqueur et trop indisciplinée, trop orgueilleuse pour se rendre dans le but d’échapper à la destruction."
                                            },
                                            {
                                                "example_id": "10e7c337-b3a1-463a-8b03-ddf19b2fe89f",
                                                "sense_id": "df1e0079-82dc-3777-bf24-888f397cc636",
                                                "text": "Raclant, ravageant, dévastant la côte ouest de l’Ile, le cyclone roula vers la mer Polaire, mettant à mal bateaux, engins de pêche, quais, maisons, bétail, récoltes."
                                            },
                                            {
                                                "example_id": "4c73fe2e-63b1-46cd-ac12-9a345e879868",
                                                "sense_id": "df1e0079-82dc-3777-bf24-888f397cc636",
                                                "text": "Le fait est que, bon an, mal an, Garrote avait eu le temps de parcourir sur les galères du roi la côte de Barbarie et les îles d'Orient, dévastant les terres des infidèles, pillant leurs caramousals et leurs navires de guerre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f3078fd-387f-349a-967d-e2eb5b0c5037",
                                        "entry_id": "6fc4c002-65d0-3015-9501-03ed273935c5",
                                        "glosses": [
                                            "Détruire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a407e45-84da-48c0-a3e7-31b5eeb93e39",
                                                "sense_id": "1f3078fd-387f-349a-967d-e2eb5b0c5037",
                                                "text": "Un cœur dévasté par les passions."
                                            },
                                            {
                                                "example_id": "18aa2af9-1b1a-45ec-ba87-5a376d607217",
                                                "sense_id": "1f3078fd-387f-349a-967d-e2eb5b0c5037",
                                                "text": "« C’est là que je me suis trouvée bonne actrice… me dit Claire au soir de sa première rencontre avec les psychologues-experts, j’ai fait la fille dévastée anéantie, je crois que j’ai vraiment réussi à cacher ma joie. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9c9d1c7-c3a0-4e60-a190-eb6caab17f2b",
                        "source_entry_id": "1617ad00-9557-3f55-80de-5895fd5f0513",
                        "source_sense_description": "лишить самого необходимого, сделать бедным, нищим",
                        "target_lang_word": "piller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b9099d-29b1-34a7-bf71-abb83ca268b4",
                                        "entry_id": "046f28bf-b789-313d-852c-f927d4b28406",
                                        "glosses": [
                                            "Emporter violemment les biens d’une ville, d’une maison, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95c24a4d-5160-49a4-8464-e3a4092ed956",
                                                "sense_id": "a4b9099d-29b1-34a7-bf71-abb83ca268b4",
                                                "text": "Ce n’est que le commencement de plus grands malheurs : ces Prussiens, ces Autrichiens, ces Russes, ces Espagnols, et tous ces peuples que nous avons pillés depuis 1804, vont profiter de notre misère pour tomber sur nous."
                                            },
                                            {
                                                "example_id": "53bd9b63-379c-40c9-9c39-a6c76b77950d",
                                                "sense_id": "a4b9099d-29b1-34a7-bf71-abb83ca268b4",
                                                "text": "— […] ils savent qu'une tempête effroyable va tomber sur la côte... ils comptent que le yacht ne tiendra pas sur ses ancres et qu'il viendra se briser sur les rochers de la pointe... ils veulent être là pour piller l'épave."
                                            },
                                            {
                                                "example_id": "0a6ac6fd-cc6d-4629-8016-f24ce5f8d26d",
                                                "sense_id": "a4b9099d-29b1-34a7-bf71-abb83ca268b4",
                                                "text": "Mais généralement l’envoi de quelques troupes met fin aux troubles en peu de temps. Elles envahissent le territoire de la tribu à châtier, pillent les douars, razzient les troupeaux, détruisent les cultures, font des prisonniers et coupent des têtes, […]."
                                            },
                                            {
                                                "example_id": "3a2e85d1-9fd8-49e8-ad02-c048fc8531ef",
                                                "sense_id": "a4b9099d-29b1-34a7-bf71-abb83ca268b4",
                                                "text": "Dans la nuit du 2 au 3 octobre, un détachement se rend au village de Neuville-Day. Il comprend des hussards de Polignac, des Irlandais, des soldats du Royal-Allemand, commandés par 40 émigrés. Ils pillent le village."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df81aaa3-c9c2-3dcd-82a6-ba8ff069ee36",
                                        "entry_id": "046f28bf-b789-313d-852c-f927d4b28406",
                                        "glosses": [
                                            "Commettre des exactions, des concussions, en parlant de ceux qui le font dans leur charge, dans leur emploi, des gains illicites et scandaleux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "659fa5da-5707-4755-9856-0a0742a3d62a",
                                                "sense_id": "df81aaa3-c9c2-3dcd-82a6-ba8ff069ee36",
                                                "text": "Ce gouverneur abusa de son autorité pour piller la province."
                                            },
                                            {
                                                "example_id": "eba46cb7-5298-435e-a0ac-b560cd138f27",
                                                "sense_id": "df81aaa3-c9c2-3dcd-82a6-ba8ff069ee36",
                                                "text": "Cet intendant a si bien pillé son maître qu’il est devenu plus riche que lui."
                                            },
                                            {
                                                "example_id": "77b0b1ad-671c-4d7d-8337-19a9dbbb5d44",
                                                "sense_id": "df81aaa3-c9c2-3dcd-82a6-ba8ff069ee36",
                                                "text": "Le prince de Galles épouse Diana Spencer, et les amis français voudraient connaître le point de vue d’Ann sur le mariage royal. Elle n’en a aucun. Elle se fiche de ces gens qui pillent le peuple, n’ouvrent jamais un livre et s’habillent si mal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "185acefd-b9cd-34f9-99a3-384542c2cd8d",
                                        "entry_id": "046f28bf-b789-313d-852c-f927d4b28406",
                                        "glosses": [
                                            "Prendre dans les ouvrages des autres des choses que l’on donne comme siennes, en parlant de littérature et de beaux-arts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee6023cb-8d4d-4c06-a856-85d5c233f305",
                                                "sense_id": "185acefd-b9cd-34f9-99a3-384542c2cd8d",
                                                "text": "Il a pillé dans de vieux auteurs la plupart des idées que renferme son livre."
                                            },
                                            {
                                                "example_id": "a0e8a025-44a6-4a32-9ecb-24412a819d7f",
                                                "sense_id": "185acefd-b9cd-34f9-99a3-384542c2cd8d",
                                                "text": "Ce musicien a pillé les motifs de ses plus beaux airs dans des partitions italiennes."
                                            },
                                            {
                                                "example_id": "9665f768-77d5-494d-b001-631f6f2e58a5",
                                                "sense_id": "185acefd-b9cd-34f9-99a3-384542c2cd8d",
                                                "text": "Ces vers sont pillés de Racine, pillés dans Racine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7030686-4bc9-3743-ab18-c1eab1065368",
                                        "entry_id": "046f28bf-b789-313d-852c-f927d4b28406",
                                        "glosses": [
                                            "Se jeter sur les animaux ou sur les personnes, en parlant des chiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c59d69a-7685-41d3-84d0-a5eb00fc6423",
                                                "sense_id": "a7030686-4bc9-3743-ab18-c1eab1065368",
                                                "text": "Son chien a pillé le mien."
                                            },
                                            {
                                                "example_id": "a0c646d5-2d48-4d19-bc8d-485baf2e9fd4",
                                                "sense_id": "a7030686-4bc9-3743-ab18-c1eab1065368",
                                                "text": "C’est un chien qui pille tous les passants."
                                            },
                                            {
                                                "example_id": "18262189-63f0-429d-bc71-3c86010da70d",
                                                "sense_id": "a7030686-4bc9-3743-ab18-c1eab1065368",
                                                "text": "Il l’a fait piller par son chien."
                                            },
                                            {
                                                "example_id": "b61d2e31-4f35-45e7-ab07-8b90916ae10c",
                                                "sense_id": "a7030686-4bc9-3743-ab18-c1eab1065368",
                                                "text": "En termes de chasse, on dit pour agacer un chien contre d’autres animaux, ou contre des personnes : Pille !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12d14279-cbc0-3877-8f09-474a83f5fd6d",
                                        "entry_id": "046f28bf-b789-313d-852c-f927d4b28406",
                                        "glosses": [
                                            "Au jeu de l’hombre, action qui consiste à prendre plus de cartes qu’il ne faut."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
