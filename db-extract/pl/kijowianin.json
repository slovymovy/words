                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "киевлянин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6b533554-393b-3fd0-b946-8fafa14c952b",
                                        "entry_id": "6ee0c94f-b89e-342f-9fc8-4eaf4b5fa4bf",
                                        "glosses": [
                                            "житель или уроженец Киева"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc18348-a6c4-4d73-9f98-dcd43cd20973",
                                                "sense_id": "6b533554-393b-3fd0-b946-8fafa14c952b",
                                                "text": "Но киевляне, приученные менять государей и жертвовать победителю побеждённым, сражались только за честь князя; а новогородцы за права собственные, за уставы отцов, которые бывают не всегда мудры, но всегда священны для народа."
                                            },
                                            {
                                                "example_id": "4b8d3920-945d-41c6-baa0-905ce2e5ff88",
                                                "sense_id": "6b533554-393b-3fd0-b946-8fafa14c952b",
                                                "text": "В вечернем заседании воздухоплавательного съезда киевлянин Сикорский ознакомил собрание с устройством аэроплана его системы."
                                            },
                                            {
                                                "example_id": "19e2da7b-d26b-482b-b126-6d92d6d10a51",
                                                "sense_id": "6b533554-393b-3fd0-b946-8fafa14c952b",
                                                "text": "В Чернобыле взорвалось, а киевлян на демонстрацию вывели."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
