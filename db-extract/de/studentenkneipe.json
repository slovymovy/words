                                "example_id": "6aafb41b-db68-4100-8984-d3b39f8add87",
                                "sense_id": "008fe2fd-a10f-3505-8bf6-587c42948b08",
                                "text": "„Die Studentenkneipe ist das eigentliche Habitat des Jungakademikers und besonders häufig in kleineren Städten zu finden.“"
                            },
                            {
                                "example_id": "92e34929-4c1f-4062-b40c-7595973d60db",
                                "sense_id": "008fe2fd-a10f-3505-8bf6-587c42948b08",
                                "text": "„Er entdeckte Fabiola schon von weitem, als er sich der Studentenkneipe näherte.“"
                            },
                            {
                                "example_id": "5bb55643-1c79-4cda-b547-e7abfcb026c7",
                                "sense_id": "008fe2fd-a10f-3505-8bf6-587c42948b08",
                                "text": "„In der Studentenkneipe herrschen keine schönen Sitten.“"
                            }
