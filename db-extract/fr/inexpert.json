                    {
                        "sense_id": "541a6c42-7c2d-3173-80c9-03e0fea315af",
                        "entry_id": "bda1ee49-1bdf-3fe3-9e72-ca8f3cfd9630",
                        "glosses": [
                            "Qui n’a pas d’expérience, qui n’est pas expert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9738d1e7-b480-4ef2-9307-7bac187957b8",
                                "sense_id": "541a6c42-7c2d-3173-80c9-03e0fea315af",
                                "text": "[…] : ils avoient fait cacher l’Exécuteur ; mais on prit un criminel inexpert dans ce métier, qui donna trente-cinq coups, avant que de pouvoir séparer la tête du corps."
                            },
                            {
                                "example_id": "179b8085-30ff-4c32-80c8-59c76be45df0",
                                "sense_id": "541a6c42-7c2d-3173-80c9-03e0fea315af",
                                "text": "Une salle étroite, en forme de losange, d’un losange qui aurait été tracé d’une main inexperte, par un enfant qui n’aurait que des obscurités de la géométrie la plus élémentaire."
                            },
                            {
                                "example_id": "7c5177f3-6602-4eff-bd99-dc08f89c3365",
                                "sense_id": "541a6c42-7c2d-3173-80c9-03e0fea315af",
                                "text": "Et des visions plus sensuelles passaient devant ses yeux. Sentir ce corps inexpert frémir sous les caresses de ses mains."
                            }
                        ]
                    }
                ],
