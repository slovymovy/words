                "senses": [
                    {
                        "sense_id": "8f44d888-820e-315d-9746-b29650b8eebf",
                        "entry_id": "3661aec4-5ce2-358a-ab18-da8bfc87e690",
                        "glosses": [
                            "een ter versiering aangebrachte, (vaak metalen) strook"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "596e2e23-5ec3-4a54-be90-1245c9d811fd",
                                "sense_id": "8f44d888-820e-315d-9746-b29650b8eebf",
                                "text": "Bij het passeren reed dit voertuig de zijspiegel en de sierstrip af van de auto van de aangeefster."
                            },
                            {
                                "example_id": "0041e824-053d-4388-a839-3fc9018d884f",
                                "sense_id": "8f44d888-820e-315d-9746-b29650b8eebf",
                                "text": "Zo hebben we onlangs een taart gemaakt in de vorm van een Porsche met bumper, sierstrip, koplampen en sierlijsten. Mensen komen soms met de gekste ideeën.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99ba534a-1047-486b-9347-a6b1035a5d57",
                        "source_entry_id": "3661aec4-5ce2-358a-ab18-da8bfc87e690",
                        "source_sense_id": "8f44d888-820e-315d-9746-b29650b8eebf",
                        "target_lang_word": "finisher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finisher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71546a44-106c-33b2-ade5-c0334e492bca",
                                        "entry_id": "92549d98-c080-3b14-a893-94c2e14b5421",
                                        "glosses": [
                                            "A person who finishes or completes something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "227e3824-1489-40dd-ae90-670b0d3d228b",
                                                "sense_id": "71546a44-106c-33b2-ade5-c0334e492bca",
                                                "text": "The early finishers waited for the other runners to reach the finish line."
                                            },
                                            {
                                                "example_id": "825c88c9-f46b-459e-ad19-50fe49140e15",
                                                "sense_id": "71546a44-106c-33b2-ade5-c0334e492bca",
                                                "text": "He became the best finsher for Australia's T20I team."
                                            },
                                            {
                                                "example_id": "5dd07058-0025-4426-be99-4e993564c695",
                                                "sense_id": "71546a44-106c-33b2-ade5-c0334e492bca",
                                                "text": "He that of greatest works is finisher\nOft does them by the weakest minister […]"
                                            },
                                            {
                                                "example_id": "b7b38788-2794-46f1-b5d3-db00a426aa45",
                                                "sense_id": "71546a44-106c-33b2-ade5-c0334e492bca",
                                                "text": "[…] let us run with patience the race that is set before us, looking unto Jesus the author and finisher of our faith […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "794d2f63-6d37-36c9-a2c6-1f266c920a3d",
                                        "entry_id": "92549d98-c080-3b14-a893-94c2e14b5421",
                                        "glosses": [
                                            "A person who applies a finish to something, such as furniture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "596e0d81-026b-3734-8593-e047c6fb62ab",
                                        "entry_id": "92549d98-c080-3b14-a893-94c2e14b5421",
                                        "glosses": [
                                            "The person who applies the gilding and decoration in bookbinding."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7549cdaf-9d5a-4447-8d68-e5f72032915c",
                                                "sense_id": "596e0d81-026b-3734-8593-e047c6fb62ab",
                                                "text": "If destruction be our lot, we must ourselves be its author and finisher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98c46c3a-327a-3255-8100-16549457c37a",
                                        "entry_id": "92549d98-c080-3b14-a893-94c2e14b5421",
                                        "glosses": [
                                            "A construction machine used to smooth a newly constructed road surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd844903-5bbe-32ae-b6a3-f1c6fd1fa6de",
                                        "entry_id": "92549d98-c080-3b14-a893-94c2e14b5421",
                                        "glosses": [
                                            "The blow that ends a fight; the knock-out blow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7166cb52-74c9-4d75-a15c-8432dc5409c2",
                                                "sense_id": "dd844903-5bbe-32ae-b6a3-f1c6fd1fa6de",
                                                "text": "A thundering right to the head bent him back over the ropes, and then, just as I was setting myself for the finisher, I felt somebody jerking my pants leg […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bdc7a36-29f5-38bf-86af-7e28fd146c61",
                                        "entry_id": "92549d98-c080-3b14-a893-94c2e14b5421",
                                        "glosses": [
                                            "A finishing move."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bce95c39-138b-4725-9e44-d183d4992c01",
                                                "sense_id": "9bdc7a36-29f5-38bf-86af-7e28fd146c61",
                                                "text": "Tie Up Fallaway Slam (Finisher)"
                                            },
                                            {
                                                "example_id": "7b3aa5d2-38e3-4fd0-b51c-3b8763878f7a",
                                                "sense_id": "9bdc7a36-29f5-38bf-86af-7e28fd146c61",
                                                "text": "Shadow Kick (OO+O) is best used as a punishing move and a combo finisher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e6ca60f-528e-304f-821b-88887f9614f9",
                                        "entry_id": "92549d98-c080-3b14-a893-94c2e14b5421",
                                        "glosses": [
                                            "A player who scores points for their team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c01b061-2755-4a84-bcd7-596155986594",
                                                "sense_id": "8e6ca60f-528e-304f-821b-88887f9614f9",
                                                "text": "After suffering a broken leg in a challenge from Stoke's Ryan Shawcross in 2010, the goal allowed Ramsey to put a positive slant on this fixture and show how he is evolving into a composed finisher."
                                            },
                                            {
                                                "example_id": "c1a5b38a-20bd-4ac5-9742-d025ffec6dc8",
                                                "sense_id": "8e6ca60f-528e-304f-821b-88887f9614f9",
                                                "text": "As such, when Doncic was on the court, Brunson was a secondary facilitator and more of a finisher than a creator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c641ded4-6a36-361d-8558-d53ac6073827",
                                        "entry_id": "92549d98-c080-3b14-a893-94c2e14b5421",
                                        "glosses": [
                                            "A substitute player who plays at the end of the game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eb92bb3-1e01-4b4d-874d-8fb599596225",
                                                "sense_id": "c641ded4-6a36-361d-8558-d53ac6073827",
                                                "text": "[Eddie] Jones has used his bench as finishers and repeated last year’s ploy that helped overcome France when he brought on Ben Te’o for [George] Ford. [Dylan] Hartley and [Mike] Brown had already gone off, along with [Nathan] Hughes, whose replacement Sam Underhill was making an impact at the breakdown when he was sent to the sin-bin for a no-arms tackle on Barclay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f406135b-c5c6-386a-b506-68c732a02568",
                                        "entry_id": "92549d98-c080-3b14-a893-94c2e14b5421",
                                        "glosses": [
                                            "A visible trim element."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "496085d0-6ae8-4f61-bb8e-d5902e47c452",
                                                "sense_id": "f406135b-c5c6-386a-b506-68c732a02568",
                                                "text": "Inside, the revised F-Type gets lightweight slimline seats and new chrome and aluminium trim finishers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7773f01-4d0e-3813-8007-d774b91d658d",
                                        "entry_id": "92549d98-c080-3b14-a893-94c2e14b5421",
                                        "glosses": [
                                            "Synonym of inker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
