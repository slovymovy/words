                            "trait_type": "form",
                            "comment": "verbal noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по глаголу «объяснять» или «выяснять»; процесс внесения ясности.",
                        "en": "Verbal noun from the verb 'wyjaśnić'; the act of clarifying or clearing up a matter."
                    },
