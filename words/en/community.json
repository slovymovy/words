    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b10201d-6d7f-3c21-8127-a8b952f03c01",
                    "sense_definition": "A group of people living in the same place or having a particular characteristic in common, such as language, religion, or interests.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>community</w> came together to build a new playground for the children.",
                            "target_lang_translations": {
                                "ru": "Местная <w>община</w> собралась вместе, чтобы построить новую игровую площадку для детей."
                            }
                        },
                        {
                            "text": "She felt a strong sense of belonging within the international <w>community</w> of scientists.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала сильную причастность к международному <w>сообществу</w> ученых."
                            }
                        }
                    ],
                    "synonyms": [
                        "society",
                        "neighborhood",
                        "fellowship"
                    ],
                    "common_phrases": [
                        "local community",
                        "international community",
                        "sense of community"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, проживающих в одном месте или обладающих определенной общей характеристикой, такой как язык, религия или интересы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщество",
                                "target_lang_sense_clarification": "группа людей с общими интересами"
                            },
                            {
                                "target_lang_word": "община",
                                "target_lang_sense_clarification": "религиозная или этническая группа"
                            },
                            {
                                "target_lang_word": "общество",
                                "target_lang_sense_clarification": "совокупность людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55c11376-f75c-3773-a43e-c3f29e5a92ec",
                    "sense_definition": "A group of people interacting via the internet for social, professional, or educational purposes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The online gaming <w>community</w> has its own unique slang and social rules.",
                            "target_lang_translations": {
                                "ru": "У онлайн-игрового <w>сообщества</w> есть свой уникальный сленг и социальные правила."
                            }
                        },
                        {
                            "text": "Moderators help maintain standards within the virtual <w>community</w> to prevent harassment.",
                            "target_lang_translations": {
                                "ru": "Модераторы помогают поддерживать стандарты внутри виртуального <w>сообщества</w>, чтобы предотвратить домогательства."
                            }
                        }
                    ],
                    "synonyms": [
                        "online community",
                        "virtual community"
                    ],
                    "common_phrases": [
                        "gaming community"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, взаимодействующих через интернет в социальных, профессиональных или образовательных целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщество",
                                "target_lang_sense_clarification": "группа по интересам в сети"
                            },
                            {
                                "target_lang_word": "комьюнити",
                                "target_lang_sense_clarification": "сленговое обозначение интернет-сообщества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7922405-d57b-372f-9783-7e217295e0b5",
                    "sense_definition": "The feeling of sharing common attitudes, interests, and goals with others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shared_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shared experience of the marathon created a deep <w>community</w> of interest among the runners.",
                            "target_lang_translations": {
                                "ru": "Общий опыт марафона создал глубокую <w>общность</w> интересов среди бегунов."
                            }
                        },
                        {
                            "text": "They worked in <w>community</w> with one another to finish the project on time.",
                            "target_lang_translations": {
                                "ru": "Они работали в <w>согласии</w> друг с другом, чтобы закончить проект вовремя."
                            }
                        }
                    ],
                    "synonyms": [
                        "solidarity",
                        "togetherness",
                        "unity"
                    ],
                    "common_phrases": [
                        "community of interest",
                        "in community with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство разделения общих взглядов, интересов и целей с другими людьми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общность",
                                "target_lang_sense_clarification": "единство взглядов или интересов"
                            },
                            {
                                "target_lang_word": "единение",
                                "target_lang_sense_clarification": "чувство сплоченности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1929fc3b-d879-32a7-a736-a32c5c281640",
                    "sense_definition": "A group of people living together and sharing possessions and responsibilities, such as a religious order or a commune.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monks lived in a secluded religious <w>community</w> high in the mountains.",
                            "target_lang_translations": {
                                "ru": "Монахи жили в уединенной религиозной <w>общине</w> высоко в горах."
                            }
                        },
                        {
                            "text": "Many young people in the sixties chose to live in a residential <w>community</w> to share costs.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди в шестидесятые годы предпочитали жить в жилой <w>коммуне</w>, чтобы делить расходы."
                            }
                        }
                    ],
                    "synonyms": [
                        "commune",
                        "collective",
                        "monastery"
                    ],
                    "common_phrases": [
                        "religious community",
                        "residential community"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, живущих вместе и разделяющих имущество и обязанности, например, религиозный орден или коммуна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "община",
                                "target_lang_sense_clarification": "религиозная или социальная группа"
                            },
                            {
                                "target_lang_word": "коммуна",
                                "target_lang_sense_clarification": "коллектив с общим имуществом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a89ea785-cf14-3c81-817b-ce2b18dac254",
                    "sense_definition": "A group of different species of organisms living and interacting in the same environment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coral reef supports a diverse biological <w>community</w> of fish and invertebrates.",
                            "target_lang_translations": {
                                "ru": "Коралловый риф поддерживает разнообразное биологическое <w>сообщество</w> рыб и беспозвоночных."
                            }
                        },
                        {
                            "text": "Pollution can disrupt the delicate balance of a forest <w>community</w>.",
                            "target_lang_translations": {
                                "ru": "Загрязнение может нарушить хрупкий баланс лесного <w>сообщества</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ecosystem",
                        "biota"
                    ],
                    "common_phrases": [
                        "biological community",
                        "ecological community"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа различных видов организмов, обитающих и взаимодействующих в одной среде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщество",
                                "target_lang_sense_clarification": "биологическое объединение организмов"
                            },
                            {
                                "target_lang_word": "колония",
                                "target_lang_sense_clarification": "скопление микроорганизмов или полипов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b70a1c81-65d7-30f6-a96d-932f7292b6f2",
                    "sense_definition": "The state of sharing or having something in common; joint ownership or participation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shared_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>community</w> of goods was a central tenet of their utopian philosophy.",
                            "target_lang_translations": {
                                "ru": "<w>Общность</w> имущества была центральным постулатом их утопической философии."
                            }
                        },
                        {
                            "text": "There was a complete <w>community</w> of thought between the two business partners.",
                            "target_lang_translations": {
                                "ru": "Между двумя деловыми партнерами было полное <w>единство</w> мыслей."
                            }
                        }
                    ],
                    "synonyms": [
                        "sharing",
                        "jointness"
                    ],
                    "common_phrases": [
                        "community of goods",
                        "community of property"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние совместного владения или участия в чем-либо; общность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общность",
                                "target_lang_sense_clarification": "совместное владение или единство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79e8255-4fe5-3d72-8c0b-ef566b8a99f2",
                    "sense_definition": "A small administrative division in certain regions, such as Wales or Scotland, similar to a civil parish.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>community</w> council met to discuss the planning application for the new library.",
                            "target_lang_translations": {
                                "ru": "Совет <w>общины</w> собрался, чтобы обсудить заявку на планирование новой библиотеки."
                            }
                        },
                        {
                            "text": "Each <w>community</w> in the county has its own elected representatives.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>административная единица</w> в округе имеет своих выборных представителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "parish",
                        "district"
                    ],
                    "common_phrases": [
                        "community council"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK administrative term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая административная единица в некоторых регионах (например, в Уэльсе или Шотландии), аналогичная гражданскому приходу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коммуна",
                                "target_lang_sense_clarification": "административно-территориальная единица"
                            },
                            {
                                "target_lang_word": "община",
                                "target_lang_sense_clarification": "местное самоуправление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e8af646-ae20-30da-ba08-a74f2be9aa14",
                    "sense_definition": "The quality of being similar or having a common character.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shared_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued for the essential <w>community</w> of nature between all living things.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал сущностную <w>общность</w> природы всех живых существ."
                            }
                        },
                        {
                            "text": "There can be no <w>community</w> between justice and lawlessness.",
                            "target_lang_translations": {
                                "ru": "Между правосудием и беззаконием не может быть ничего <w>общего</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "likeness",
                        "similarity",
                        "affinity"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество сходства или наличие общего характера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общность",
                                "target_lang_sense_clarification": "наличие общих свойств"
                            },
                            {
                                "target_lang_word": "сходство",
                                "target_lang_sense_clarification": "подобие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95e48fc8-2de5-3b0d-b99f-6edaf07ccb1d",
                    "sense_definition": "The state of being common or frequent; commonness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shared_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>community</w> of the occurrence made it lose its special significance over time.",
                            "target_lang_translations": {
                                "ru": "<w>Обыденность</w> этого происшествия со временем заставила его утратить особое значение."
                            }
                        }
                    ],
                    "synonyms": [
                        "commonness",
                        "frequency"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние распространенности или частоты; обычность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распространенность",
                                "target_lang_sense_clarification": "частота появления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}