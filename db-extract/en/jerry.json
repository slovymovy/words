                        "examples": [
                            {
                                "example_id": "a742270b-3f4d-4202-bfee-26d9faff7ab0",
                                "sense_id": "f26f07ec-0158-31d3-a22b-dfa15d61eca3",
                                "text": "Watch stealing, or jerry getting, as the thieving fraternity designate the operation, is carried on to a considerable extent all the year round."
                            },
                            {
                                "example_id": "c82dc88d-d4d7-4e62-9af5-48489a316242",
                                "sense_id": "f26f07ec-0158-31d3-a22b-dfa15d61eca3",
                                "text": "R. Austin Freeman, A Savant's Vendetta\n'Do you know a jerry when you sees one — a red 'un, mind you?' […] The fellow looked furtively at the door and then, diving into an inner pocket, pulled out a handsome gold watch with a massive chain attached, exhibited it for a moment and then dropped it back."
                            }
                        ]
                    }
