                ],
                "senses": [
                    {
                        "sense_id": "d7d2a6ae-ce55-3761-b670-8a09009ffa30",
                        "entry_id": "e53ac2f4-cf45-347b-9777-073908d50c17",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b1f03a-a81b-4393-a760-555f1ca231f7",
                                "sense_id": "d7d2a6ae-ce55-3761-b670-8a09009ffa30",
                                "text": "Frau Steimle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7b7a6fbf-afdb-43e1-8987-38857cdb70c7",
                                "sense_id": "d7d2a6ae-ce55-3761-b670-8a09009ffa30",
                                "text": "Herr Steimle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c5585d01-f787-4512-b45e-5890bd150c93",
                                "sense_id": "d7d2a6ae-ce55-3761-b670-8a09009ffa30",
                                "text": "Die Steimles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "95f23e57-509d-4f6e-9eea-82f9382b4fd3",
                                "sense_id": "d7d2a6ae-ce55-3761-b670-8a09009ffa30",
                                "text": "Der Steimle trägt nie die Pullover, die die Steimle ihm strickt."
                            },
                            {
                                "example_id": "b79661f8-645e-4582-8a5c-9e5091e146f5",
                                "sense_id": "d7d2a6ae-ce55-3761-b670-8a09009ffa30",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Steimle kommt, geht der Herr Steimle.“"
                            },
                            {
                                "example_id": "bb84498e-e777-4d28-975d-8fe328e6d8f2",
                                "sense_id": "d7d2a6ae-ce55-3761-b670-8a09009ffa30",
                                "text": "Steimle kommt und geht."
                            },
                            {
                                "example_id": "2fe835ec-c03d-42d9-b85c-ba1bd7e477a7",
                                "sense_id": "d7d2a6ae-ce55-3761-b670-8a09009ffa30",
                                "text": "Steimles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
