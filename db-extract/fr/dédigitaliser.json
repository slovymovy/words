                "senses": [
                    {
                        "sense_id": "928b6380-afae-3d37-8c82-771d20b6f443",
                        "entry_id": "0a75a953-60ba-3f47-b110-586c9e7c1dbd",
                        "glosses": [
                            "Faire perdre son caractère digital à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87347f7a-51ab-4a4c-970a-d8a9e28a8a42",
                                "sense_id": "928b6380-afae-3d37-8c82-771d20b6f443",
                                "text": "Moi à l’isolement, et eux tous, ici et en bas, tétanisés, sans voix, dénumérisés, dédigitalisés comme ils disent."
                            },
                            {
                                "example_id": "5812c43a-2176-411a-8510-9540b6affaf7",
                                "sense_id": "928b6380-afae-3d37-8c82-771d20b6f443",
                                "text": "Un Amas de vieux OS dédigitalisés, exhumés des abîmes du primeware."
                            },
                            {
                                "example_id": "344f9b4e-35f9-40b1-b7ae-adf2a6d04d54",
                                "sense_id": "928b6380-afae-3d37-8c82-771d20b6f443",
                                "text": "Plus sérieusement, ma génération est née avec Internet, mais j’ai l’impression que beaucoup de gens autour de moi sont en train de se « dédigitaliser »."
                            }
                        ]
                    }
                ],
