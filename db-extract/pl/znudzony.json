                                    {
                                        "sense_id": "fb1d7ccb-9d5e-35b7-bb4a-59dd0e6b45c4",
                                        "entry_id": "aa5b7f84-d7ed-3482-895f-d3ecc6e70c0a",
                                        "glosses": [
