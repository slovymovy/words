                                            {
                                                "example_id": "eda9ac44-c938-40f6-853b-f397d11abc53",
                                                "sense_id": "02f8cfa0-b0b4-3c62-8ffd-337f8a7c0134",
                                                "text": "As late as the 1950s and early 1960s, when \"funk\" and \"funky\" were used increasingly in the context of jazz music, the terms still were considered indelicate and inappropriate for use in polite company."
                                            }
                                        ]
                                    },
                                    {
