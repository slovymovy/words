                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5c93e86-1906-4877-9e4e-dc9ed48821d4",
                                "sense_id": "a9bb348e-46f8-3e98-bf43-d695ed4f6131",
                                "text": "Look at the little fellows, mere bundles of fluff, paddling along so busily and sturdily."
                            },
                            {
                                "example_id": "70eff445-542c-44aa-8eb3-584c89cb53a7",
                                "sense_id": "a9bb348e-46f8-3e98-bf43-d695ed4f6131",
                                "text": "But these sweet thoughts do ever refresh my labours,/ Most busil'est when I do it."
                            },
                            {
                                "example_id": "a79cb05c-4dfb-4fae-8f64-471b23b6a31e",
                                "sense_id": "a9bb348e-46f8-3e98-bf43-d695ed4f6131",
                                "text": "Quite a crowd of townspeople turned out to see the train start, and several pressmen were busily engaged in taking notes and photographs."
                            }
                        ]
                    }
                ],
