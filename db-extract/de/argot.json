                    {
                        "translation_id": "42240234-78e1-4375-a368-793725e91fbb",
                        "source_entry_id": "500482c4-b625-34b7-9658-7091f7155152",
                        "source_sense_id": "f723d9d0-7cc1-38b4-9bc0-6bfbec0e29f9",
                        "source_sense_description": "Linguistik: französische Bezeichnung für die Sondersprache der Bettler und Gauner",
                        "target_lang_word": "арго",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "арго",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3dfba72f-077e-3b57-b1ba-55933b457b6f",
                                        "entry_id": "2987d3cc-c7b7-3e26-9572-8b9f73903343",
                                        "glosses": [
                                            "лингв. язык обособленной социальной группы, профессии или сообщества, состоящий из произволь­но избираемых видо­из­ме­нён­ных элементов одного или несколь­ких естествен­ных языков, употребляющийся с целью сокрытия предмета коммуни­ка­ции, а также как средство обособления группы от остальной части общества"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fec1528-b203-4447-8f80-77f7291ec7c6",
                                                "sense_id": "3dfba72f-077e-3b57-b1ba-55933b457b6f",
                                                "text": "Нет, вопрос о воспроизведении на родном языке чужих жаргонов, диалектов, арго — вопрос очень трудный и сложный, и его не решить с кондачка, как хотелось бы моему оппоненту."
                                            },
                                            {
                                                "example_id": "d2091691-2f37-463f-85cc-f74c23102b38",
                                                "sense_id": "3dfba72f-077e-3b57-b1ba-55933b457b6f",
                                                "text": "Бранное обращение «свинья» Анна Андреевна заменяла домашним арго — «свин», «полусвин», «свинец»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
