                "senses": [
                    {
                        "sense_id": "fd1e58b9-ad87-31d5-ba25-17c67815a755",
                        "entry_id": "128fb86b-c3cb-3a46-bc4d-867fff5f900a",
                        "glosses": [
                            "das Erzeugen einer Wirkung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89353dd0-3e68-42a1-ab06-6373c7f8d427",
                                "sense_id": "fd1e58b9-ad87-31d5-ba25-17c67815a755",
                                "text": "„Der Glaube an unterschwellige Beeinflussung durch Werbung ist nicht totzukriegen.“"
                            },
                            {
                                "example_id": "06913a34-f99c-4902-a441-cd9430dd59a4",
                                "sense_id": "fd1e58b9-ad87-31d5-ba25-17c67815a755",
                                "text": "„Zu stark war noch die Beeinflussung durch die Eltern, Lehrer und Priester, die ihm allesamt eingeredet hatten, es sei eine Schande und Sünde, sich mit Mädchen abzugeben.“"
                            },
                            {
                                "example_id": "454847b3-fdf9-4a43-afac-eed890bb517a",
                                "sense_id": "fd1e58b9-ad87-31d5-ba25-17c67815a755",
                                "text": "„Bezugnehmend auf die Reliabilität der empirischen Erhebung kann nicht hundertprozentig ausgeschlossen werden, dass im Falle einer Bearbeitung zu zweit – also mit Dolmetscher/in – eine gegenseitige (unbewusste) Beeinflussung teilweise stattgefunden haben mag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
