                                        "entry_id": "7855312a-1af7-3d5e-924e-4b47c6fce6c4",
                                        "glosses": [
                                            "анат. ограниченное скопление нейронов, расположенное по ходу нерва и окруженное соединительнотканной капсулой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
