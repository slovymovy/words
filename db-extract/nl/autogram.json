                                    {
                                        "sense_id": "b38c18a1-b837-308c-b0c3-1c5fb302a7f0",
                                        "entry_id": "da6100fe-fb0c-3890-addd-caa430333de0",
                                        "glosses": [
                                            "A person’s own handwriting, especially the signature of a famous or admired person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5530ea-0c87-41ac-b9a7-29b5400b4292",
                                                "sense_id": "b38c18a1-b837-308c-b0c3-1c5fb302a7f0",
                                                "text": "Some autograph-hunters were pestering the players after the game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d44f5cd-cd75-37a3-8a1d-8abac2250a6c",
                                        "entry_id": "da6100fe-fb0c-3890-addd-caa430333de0",
                                        "glosses": [
                                            "A person's signature used as a mark of formal approval."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "301fe2bc-9fb9-47dc-ba99-318c0a8b38e9",
                                                "sense_id": "9d44f5cd-cd75-37a3-8a1d-8abac2250a6c",
                                                "text": "If you could just put your autograph on the ol’ contract, please…"
                                            },
                                            {
                                                "example_id": "40ba0a05-e22c-4b63-bf91-891d5731f2f1",
                                                "sense_id": "9d44f5cd-cd75-37a3-8a1d-8abac2250a6c",
                                                "text": "For me, identifying an autograph is one of the most exciting aspects of collecting. I enjoy the detective work that comes with discerning a fake from the real deal, and subsequently valuing the item against other examples."
                                            },
                                            {
                                                "example_id": "5b46c33b-7a77-4cf9-bb98-434db838b305",
                                                "sense_id": "9d44f5cd-cd75-37a3-8a1d-8abac2250a6c",
                                                "text": "“Based on the scarcity of signed images from this period, in general, coupled with the miniscule population of original Jackson autographs we cannot overstate the rarity of this offering,” it said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "923a99db-8c35-38c1-9c74-eb4116c1795b",
                                        "entry_id": "da6100fe-fb0c-3890-addd-caa430333de0",
                                        "glosses": [
                                            "A manuscript in the author’s handwriting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
