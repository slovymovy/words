                    "sense_id": "95f6f615-04d9-3665-ac2f-107679cd0296",
                    "sense_definition": "Wat in het geheim of op een bedekte manier gebeurt, vaak met een licht slechte of heimelijke bedoeling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij lachte op een <w>besmuikte</w> manier toen de leraar zich vergiste.",
                            "target_lang_translations": {
                                "en": "He laughed in a <w>furtive</w> manner when the teacher made a mistake.",
                                "de": "Er lachte auf eine <w>verstohlene</w> Art, als der Lehrer sich irrte."
                            }
                        },
                        {
                            "text": "Iedereen zat <w>besmuikt</w> te lachen toen de baas een grapje maakte over zijn eigen fout.",
                            "target_lang_translations": {
                                "en": "Everyone was laughing <w>surreptitiously</w> when the boss made a joke about his own mistake.",
                                "de": "Alle saßen da und lachten <w>verkniffen</w>, als der Chef einen Witz über seinen eigenen Fehler machte."
                            }
                        }
                    ],
                    "synonyms": [
                        "heimelijk",
                        "geniepig",
                        "achterbaks"
                    ],
                    "common_phrases": [
                        "besmuikt lachen",
                        "besmuikte lach"
                    ],
                    "target_lang_definitions": {
                        "en": "Done in secret or in a covered manner, often with a slightly bad or stealthy intention.",
                        "de": "Heimlich, verstohlen oder verdeckt geschehend, oft mit einer leicht boshaften, spöttischen oder unaufrichtigen Absicht."
                    },
