                },
                {
                    "sense_id": "592aa986-cf4b-331b-bb5f-f1f4462ad669",
                    "sense_definition": "Having only one color throughout, without any patterns or stripes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to wear a <w>solid</w> blue shirt for the interview.",
                            "target_lang_translations": {
                                "ru": "Он решил надеть на собеседование <w>однотонную</w> синюю рубашку.",
                                "tr": "Mülakat için <w>düz</w> mavi bir gömlek giymeye karar verdi."
                            }
                        },
                        {
                            "text": "The walls were painted a <w>solid</w> white to make the room look bigger.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в <w>чисто</w> белый цвет, чтобы комната казалась больше.",
                                "tr": "Odanın daha büyük görünmesi için duvarlar <w>düz</w> beyaza boyandı."
                            }
