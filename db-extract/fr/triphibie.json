                "senses": [
                    {
                        "sense_id": "74635720-3c9c-392d-8c29-b9cf5350c3a5",
                        "entry_id": "7cabd211-afdb-399b-8545-927bfb6e7255",
                        "glosses": [
                            "Qui implique les forces navales, aériennes et terrestres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "494f0622-49db-4f32-8c91-26b0ec8c2260",
                                "sense_id": "74635720-3c9c-392d-8c29-b9cf5350c3a5",
                                "text": "C’est, à n’en pas douter, l’offensive « triphibie », comme disait naguère Winston Churchill, et menée à un rythme si soutenu et si rapide qu’elle puisse submerger l’Europe occidentale, avant que ne se pose la question d’un échange d’arguments thermonucléaires."
                            },
                            {
                                "example_id": "9835828f-a142-4bca-b7af-da7b0b6403c7",
                                "sense_id": "74635720-3c9c-392d-8c29-b9cf5350c3a5",
                                "text": "La stratégie «triphibie»: ce néologisme hasardé résume l’expression anglaise triphibius strategy qui désigne les opérations opérées de concert par les forces navales, aériennes et terrestres."
                            }
                        ]
                    },
                    {
                        "sense_id": "263e73d8-5cdb-3a22-960b-d7890d6c8f73",
                        "entry_id": "7cabd211-afdb-399b-8545-927bfb6e7255",
                        "glosses": [
                            "Qui peut être utilisé tant dans les airs que sur l’eau et sous l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a18f4808-6c7d-44d9-94b3-dd5699b25ffd",
                                "sense_id": "263e73d8-5cdb-3a22-960b-d7890d6c8f73",
                                "text": "L’espadon est un engin triphibie télécommandé ou piloté […] capable de jaillir des flots telle une fusée, de fondre sur l’objectif et de replonger […] ou encore d’attaquer en surface en glissant sur l’eau à la manière d’un hors-bord, soit enfin de torpiller en plongée comme un submersible."
                            },
                            {
                                "example_id": "4f7ae8fb-238a-4700-aa8c-6af94be978ea",
                                "sense_id": "263e73d8-5cdb-3a22-960b-d7890d6c8f73",
                                "text": "Le concept du sous-marin volant (« Flying Sub ») aussi appelé « engin triphibie » (sur l’eau, dans l’eau, dans l’air) est né au XIXe siècle alors qu’avions et sous-marins étaient en plein développement."
                            }
                        ]
                    }
