                        "source_sense_id": "851907c9-6e0b-3dee-a53a-181180688678",
                        "source_sense_description": "a follower of Zoroastrianism",
                        "target_lang_word": "Zoroastrier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zoroastrier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67f1e1bd-4746-357b-85ec-f2545d1c4d92",
                                        "entry_id": "d3aaac05-9f04-3d7a-b5ee-3c74bd121c87",
                                        "glosses": [
                                            "Anhänger des Zoroastrismus, der vom Religionsstifter Zarathustra begründet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66e12e27-a230-4d1d-85cf-800253c1dbc1",
                                                "sense_id": "67f1e1bd-4746-357b-85ec-f2545d1c4d92",
                                                "text": "„Sogar die Juden werden die Stirn runzeln, wenn ich sie daran erinnere, wie viele Ideen sie von den Zoroastriern entlehnt haben.“"
                                            },
                                            {
                                                "example_id": "6d7031ba-2cc2-484d-8980-052e4e0fff81",
                                                "sense_id": "67f1e1bd-4746-357b-85ec-f2545d1c4d92",
                                                "text": "„Waren dies anfangs überwiegend Muslime, so kamen später Brahmanen, Christen, Jains und Zoroastrier dazu.“"
                                            },
                                            {
                                                "example_id": "8857b644-69af-4257-8fb7-92089f2a4c4d",
                                                "sense_id": "67f1e1bd-4746-357b-85ec-f2545d1c4d92",
                                                "text": "„Dennoch ist bis heute ungeklärt, ob die achämenidischen Herrscher selbst Zoroastrier waren oder altiranische Götter verehrten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
