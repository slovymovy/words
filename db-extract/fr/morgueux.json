                        "glosses": [
                            "Méprisant, rempli de morgue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f87cc8d1-0020-41ea-9c4d-847d3d968a74",
                                "sense_id": "02d7595c-b472-3749-95ed-595bb172c073",
                                "text": "J’ai allumé la télé et il s’est assis à table sans ôter son manteau, l’air morgueux d’un type qui attend, l’air d’un type qui s’ennuie."
                            },
                            {
                                "example_id": "09180262-a014-4bdb-bbc7-356262f300f7",
                                "sense_id": "02d7595c-b472-3749-95ed-595bb172c073",
                                "text": "La pratique du français l’a rendu cérébral, conceptualiste, introspectisant, analysomaniaque, bistourisant, morgueux, morbidiste, camembéroroqueforiste, sublimisant, autopsiant."
                            },
                            {
                                "example_id": "7741e38f-fb33-4774-9655-90dbb91b9392",
                                "sense_id": "02d7595c-b472-3749-95ed-595bb172c073",
                                "text": "Ce messager lui proposait rien moins qu’une troupe « d’honnêtes garçons, tout dévoués aux idées de liberté, et prêts à verser leur sang, pour aider les braves paysans à secouer le joug des aristocrates morgueux »."
                            }
                        ]
                    }
