                        "entry_id": "62b5fcc6-bcaf-316e-9127-9c4600012b68",
                        "glosses": [
                            "Person, die nur während einer bestimmten Zeitspanne (Saison) im Jahr als Arbeiter beschäftigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3e98899-5e34-4839-96b9-97cbbd8b9789",
                                "sense_id": "1af7b1a8-70a0-39a3-a741-e0004cef7a45",
                                "text": "„Diesen Verdienstausfall können sich die Saisonarbeiter aus Fernost nicht erlauben.“"
                            },
                            {
                                "example_id": "40d2e361-ee84-4fa8-a508-0470068c94ab",
                                "sense_id": "1af7b1a8-70a0-39a3-a741-e0004cef7a45",
                                "text": "„Hinten im Hof standen zwei Hütten, die meine Mutter an Wander- und Saisonarbeiter vermietete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
