                "senses": [
                    {
                        "sense_id": "d10757c4-4d85-3827-af35-7af156933ef7",
                        "entry_id": "64e16d64-2115-3b4a-be9e-f30715a527b7",
                        "glosses": [
                            "begeisterte Anhängerin von etwas oder jemandem"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "44b73994-02ac-4683-8660-376423a3b867",
                                "sense_id": "d10757c4-4d85-3827-af35-7af156933ef7",
                                "text": "Ich bin ihre größte Fanin."
                            },
                            {
                                "example_id": "2f012a30-bd08-4f71-9c13-d7691a98a4d4",
                                "sense_id": "d10757c4-4d85-3827-af35-7af156933ef7",
                                "text": "„Als Erstes treffe ich mich mit Susanne Franke. Sie ist gebürtige Gelsenkirchenerin und Schalke-Fan. Wobei ich mir nicht sicher bin, ob man korrekterweise Fanin sagt.“"
                            },
                            {
                                "example_id": "e15d6c44-0208-49cf-a370-472279b07582",
                                "sense_id": "d10757c4-4d85-3827-af35-7af156933ef7",
                                "text": "„Und was ist erst mit der letzten Frau, der Libera und deren größten Anhängerin, der Fanin. Und wie umkurvt man die Klippe der Manndeckerin, die neben der Mannschaftskapitänin ihre Frau steht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
