                ],
                "senses": [
                    {
                        "sense_id": "5e436936-b899-3590-9e15-d4df3f7653b2",
                        "entry_id": "6ab4b649-69e7-3ec4-aa60-52b0d9beea18",
                        "glosses": [
                            "Retourner à un endroit au galop."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "805ba6c5-1f1e-43b8-9cdb-350cd4bb18c1",
                                "sense_id": "5e436936-b899-3590-9e15-d4df3f7653b2",
                                "text": "Le mot de folie n'eût jamais dû être écrit. Et l'auteur quitte son frère mort pour regaloper à fond de train vers ego-Hugo avec une satisfaction trop visible …"
                            }
                        ]
                    },
                    {
                        "sense_id": "99c6607c-f258-387b-a86f-1727642e2e4a",
                        "entry_id": "6ab4b649-69e7-3ec4-aa60-52b0d9beea18",
                        "glosses": [
                            "Galoper de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d60f997-9630-4d57-93ef-3e9db5530502",
                                "sense_id": "99c6607c-f258-387b-a86f-1727642e2e4a",
                                "text": "De ce moment jusqu'au soir, nous n'avons fait que galoper dans la montagne, se balader dans la ville, courir, trotter, regaloper."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f53b4eb-89d9-3ea1-b066-e0ab72c6221b",
