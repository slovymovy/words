                        ],
                        "form": "den Eiskasten"
                    },
                    {
                        "form_id": "62ee2a78-8677-4e9d-bf24-f8c022374afa",
                        "entry_id": "0ef4a662-dd03-3eb6-922c-54937cd22a94",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Eiskästen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee42f8b6-6834-32b6-a6bc-59ec719c9361",
                        "entry_id": "0ef4a662-dd03-3eb6-922c-54937cd22a94",
                        "glosses": [
                            "kastenförmiges, einem Schrank ähnliches, gegen Wärme isoliertes und mit einem Kühlsystem ausgestattetes Behältnis, in dem leicht verderbliche Lebensmittel kühl aufbewahrt werden, um sie frischzuhalten"
                        ],
                        "tags": [
                            "outdated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8e4c1a43-452d-4ac1-bc05-ca686fdf875b",
                                "sense_id": "ee42f8b6-6834-32b6-a6bc-59ec719c9361",
                                "text": "„Ich hole mir ein Bier aus dem Eiskasten und trinke es, ganz allein vor mich hinstarrend, wie ein Mann, der im Wirtshaus sitzt.“"
                            },
                            {
                                "example_id": "5f6d84c8-5e0a-449d-910e-a3891a6dae4a",
                                "sense_id": "ee42f8b6-6834-32b6-a6bc-59ec719c9361",
                                "text": "„Im Eiskasten hinter der Kasse kugelten nur Coca-Cola-Dosen und Limonadeflaschen herum.“"
                            },
                            {
                                "example_id": "1aa2aea7-bed1-4f05-9669-6a05f6cd9276",
                                "sense_id": "ee42f8b6-6834-32b6-a6bc-59ec719c9361",
                                "text": "„So bat ich meinen Sohn, einen Augenblick zu warten und stürzte in die Küche zum Eiskasten.“"
                            },
                            {
                                "example_id": "ed5888e9-9413-4927-b101-461b1375e6ad",
                                "sense_id": "ee42f8b6-6834-32b6-a6bc-59ec719c9361",
                                "text": "„Wer sich 1995 einen der sparsamsten Eiskästen der Klasse A statt einen der Klasse G gekauft hat, hat sich bis zum heutigen Tag rund 1000 Euro an Stromkosten erspart, rechneten die Kommissionsexperten am Dienstag vor. Tatsächlich ist die EU-Politik bei Eiskästen, Waschmaschinen und Geschirrspülern so erfolgreich, dass es heute fast unmöglich ist, noch sparsamere Geräte zu bauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
