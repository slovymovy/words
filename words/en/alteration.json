{
    "word_family": [
        "alter",
        "alterable",
        "unalterable",
        "alterative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2543e836-2def-3d5c-96d3-0229d65f86fa",
                    "sense_definition": "A change or modification made to the form, character, or nature of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect made a slight <w>alteration</w> to the original building plans to allow more natural light.",
                            "target_lang_translations": {
                                "ru": "Архитектор внес небольшое <w>изменение</w> в первоначальные планы здания, чтобы впустить больше естественного света."
                            }
                        },
                        {
                            "text": "We noticed a significant <w>alteration</w> in his behavior after he returned from his long trip.",
                            "target_lang_translations": {
                                "ru": "Мы заметили значительное <w>изменение</w> в его поведении после того, как он вернулся из своей долгой поездки."
                            }
                        }
                    ],
                    "synonyms": [
                        "change",
                        "modification",
                        "adjustment",
                        "amendment"
                    ],
                    "antonyms": [
                        "preservation",
                        "maintenance"
                    ],
                    "common_phrases": [
                        "make an alteration",
                        "slight alteration",
                        "significant alteration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение или модификация, внесенные в форму, характер или природу чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменение",
                                "target_lang_sense_clarification": "поправка, модификация"
                            },
                            {
                                "target_lang_word": "переделка",
                                "target_lang_sense_clarification": "внесение изменений в конструкцию или план"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b370f4e-b5c8-32c0-bbe5-af0c22a7be66",
                    "sense_definition": "A minor adjustment made to clothing, such as shortening or tightening, to make it fit better.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor charged twenty dollars for the suit <w>alteration</w>.",
                            "target_lang_translations": {
                                "ru": "Портной взял двадцать долларов за <w>переделку</w> костюма."
                            }
                        },
                        {
                            "text": "She took her wedding dress in for a final <w>alteration</w> a week before the ceremony.",
                            "target_lang_translations": {
                                "ru": "За неделю до церемонии она отнесла свое свадебное платье на финальную <w>подгонку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "adjustment",
                        "fitting"
                    ],
                    "common_phrases": [
                        "clothing alteration",
                        "suit alteration",
                        "final alteration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая подгонка одежды (например, укорачивание или ушивание) для лучшей посадки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переделка",
                                "target_lang_sense_clarification": "подгонка одежды по фигуре"
                            },
                            {
                                "target_lang_word": "подгонка",
                                "target_lang_sense_clarification": "корректировка размера одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1949b2f2-69a2-3b31-a5c3-698c4ddcd302",
                    "sense_definition": "The process or act of altering, changing, or making something different.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The continuous <w>alteration</w> of the landscape by human activity is a major environmental concern.",
                            "target_lang_translations": {
                                "ru": "Непрерывное <w>изменение</w> ландшафта в результате человеческой деятельности вызывает серьезную экологическую озабоченность."
                            }
                        },
                        {
                            "text": "Any <w>alteration</w> of the contract requires the written consent of both parties.",
                            "target_lang_translations": {
                                "ru": "Любое <w>изменение</w> договора требует письменного согласия обеих сторон."
                            }
                        }
                    ],
                    "synonyms": [
                        "altering",
                        "changing",
                        "modification"
                    ],
                    "antonyms": [
                        "continuation",
                        "preservation"
                    ],
                    "common_phrases": [
                        "subject to alteration",
                        "process of alteration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или действие по изменению или преобразованию чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменение",
                                "target_lang_sense_clarification": "процесс перемены или модификации"
                            },
                            {
                                "target_lang_word": "преобразование",
                                "target_lang_sense_clarification": "существенное изменение формы или свойств"
                            },
                            {
                                "target_lang_word": "перемена",
                                "target_lang_sense_clarification": "действие по значению глагола переменить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}