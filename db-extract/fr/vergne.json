                    {
                        "form_id": "51cf3535-64a9-43f2-85f4-ce271dc8e931",
                        "entry_id": "ddb44b30-1895-32b1-a00b-ee6f0e00f9bc",
                        "tags": [],
                        "form": "verne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06856a4b-57f0-3b66-8522-b931b32da432",
                        "entry_id": "ddb44b30-1895-32b1-a00b-ee6f0e00f9bc",
                        "glosses": [
                            "Aulne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0858b8be-868c-46a5-ae38-daabd2078311",
                                "sense_id": "06856a4b-57f0-3b66-8522-b931b32da432",
                                "text": "Nous gagnons une prairie isolée, […], près d'un ruisseau qui coule; à l'ombre d'un vergne que le vent agite."
                            },
                            {
                                "example_id": "065cb589-4e2e-4f97-9f71-d6fbef66434b",
                                "sense_id": "06856a4b-57f0-3b66-8522-b931b32da432",
                                "text": "Les filles apportèrent à oncle Xavier des branches de vergne pour qu’il leur fit des sifflets."
                            },
                            {
                                "example_id": "b591fe99-88c7-410b-9d46-a7fe13c7304c",
                                "sense_id": "06856a4b-57f0-3b66-8522-b931b32da432",
                                "text": "[…] le grand berceau herbu où la jolie rivière chante toujours la même chanson qu’applaudissent de leurs mille mains vertes les peupliers et les vergnes."
                            },
                            {
                                "example_id": "55ec52e1-02b5-4910-bb91-8dfa8aae9948",
                                "sense_id": "06856a4b-57f0-3b66-8522-b931b32da432",
                                "text": "Je remarquai que la bordure d’aulnes (pourquoi ne pas donner aux aulnes leur nom d’ici : les vergnes ?), la bordure de vergnes paraissait bleue."
                            }
                        ]
                    }
                ],
