        "fr-extract.jsonl": [
            {
                "entry_id": "ce270749-b608-3cca-b1d3-65f9d3f339ec",
                "word": "géométrique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ec6a587-ccc6-4840-a5a5-10bbc7ab5096",
                        "entry_id": "ce270749-b608-3cca-b1d3-65f9d3f339ec",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "géométriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e29498df-f38d-3e60-b3ff-f24c72532868",
                        "entry_id": "ce270749-b608-3cca-b1d3-65f9d3f339ec",
                        "glosses": [
                            "Relatif à la géométrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "203792a4-18b2-415e-ac08-800e592899ee",
                                "sense_id": "e29498df-f38d-3e60-b3ff-f24c72532868",
                                "text": "Ils portaient, sous la couche de huita qui les noircissait des pieds à la tête, des tatouages géométriques, et leurs oreilles étaient percées pour livrer passage à des petits bouts de bois."
                            },
                            {
                                "example_id": "268ca1d1-a893-4566-9cbb-ca1afcf02b1c",
                                "sense_id": "e29498df-f38d-3e60-b3ff-f24c72532868",
                                "text": "A l’inverse, l'étendue de telle plaine divisée en une mosaïque de parcelles culturalement distinctes se verra différenciée par des contenus, eux aussi dotés d'attributs géométriques et de surface."
                            }
                        ]
                    },
                    {
                        "sense_id": "09a5920a-e655-359f-97ad-89a1a2e80497",
                        "entry_id": "ce270749-b608-3cca-b1d3-65f9d3f339ec",
                        "glosses": [
                            "Qui paraît être issu de la géométrie."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5769ee19-4297-4574-9b56-f101e8195997",
                                "sense_id": "09a5920a-e655-359f-97ad-89a1a2e80497",
                                "text": "Sur l’escarpement voisin de la verticale, croissent dans les fentes ou les petits replats ménagés par la cassure géométrique de la roche."
                            },
                            {
                                "example_id": "fc8080e0-cbc5-4251-a4f1-03082e0cc1cb",
                                "sense_id": "09a5920a-e655-359f-97ad-89a1a2e80497",
                                "text": "Mes yeux, sous les paupières crispées, étaient traversées d’images de feu, de dessins géométriques lumineux, et je croyais les sentir s’arracher par saccades de leurs orbites, comme poussés de l’intérieur."
                            }
                        ]
                    },
                    {
                        "sense_id": "02fc727b-778e-3643-8280-15a065414614",
                        "entry_id": "ce270749-b608-3cca-b1d3-65f9d3f339ec",
                        "glosses": [
                            "Qui s’étudie, se démontre par la géométrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ae6a83-bc65-4603-96e6-3bb3c4a93487",
                                "sense_id": "02fc727b-778e-3643-8280-15a065414614",
                                "text": "Méthode géométrique."
                            },
                            {
                                "example_id": "f9584239-ba72-47b7-9b97-f4115e5ff498",
                                "sense_id": "02fc727b-778e-3643-8280-15a065414614",
                                "text": "Démonstration géométrique."
                            }
                        ]
                    },
                    {
                        "sense_id": "642efdfe-ce75-30d2-b67c-c34916ba2220",
                        "entry_id": "ce270749-b608-3cca-b1d3-65f9d3f339ec",
                        "glosses": [
                            "Mathématique, scientifique, rigoureux, précis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab439e89-e604-40c9-bbd3-dc10528fc29d",
                                "sense_id": "642efdfe-ce75-30d2-b67c-c34916ba2220",
                                "text": "Le terrible Pascal, hanté par son esprit géométrique, doutait sans cesse : il ne se tira de son malheur qu’en se précipitant dans la foi."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e7134cc-dee1-337d-824e-2bd1ef24509f",
                        "entry_id": "ce270749-b608-3cca-b1d3-65f9d3f339ec",
                        "glosses": [
                            "Qui progresse de manière exponentielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78cdcd61-17ce-47c0-a75c-c47bc0fbb7bf",
                                "sense_id": "4e7134cc-dee1-337d-824e-2bd1ef24509f",
                                "text": "La suite des puissances entières de 2 (1, 2, 4, 8, 16…) est une suite géométrique de raison 2."
                            },
                            {
                                "example_id": "15f35aed-ce56-46f0-b25e-bbd804e9dbc9",
                                "sense_id": "4e7134cc-dee1-337d-824e-2bd1ef24509f",
                                "text": "A partir d'un certain moment, la consommation du champagne cesse d'être arithmétique pour devenir géométrique."
                            },
                            {
                                "example_id": "31160255-0bab-4385-9a2f-5e767eda9329",
                                "sense_id": "4e7134cc-dee1-337d-824e-2bd1ef24509f",
                                "text": "Mais quand, avec la baisse des prix, le manque de confiance, le krach de Wall Street, les gens cessèrent d’acheter, ce chômage augmenta en progression géométrique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5732365-6117-41fb-b515-4cc949ea010a",
                        "source_entry_id": "ce270749-b608-3cca-b1d3-65f9d3f339ec",
                        "target_lang_word": "geometrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
