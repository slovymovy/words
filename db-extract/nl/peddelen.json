                        "sense_id": "c56b766d-c014-3dfa-ac53-539dd3904b87",
                        "entry_id": "e074359c-bfba-31d4-ae3a-58c848de5bb2",
                        "glosses": [
                            "zich door middel van een peddel afduwend over het water ergens heen bewegen"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "6083b578-45dc-4060-8d99-059f2ad455a9",
                                "sense_id": "c56b766d-c014-3dfa-ac53-539dd3904b87",
                                "text": "Hij was in New Hampshire een stuk over een meer gepeddeld en kwam daar een paar ijsduikers tegen."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfb1673d-2255-3e08-b89d-fd891ca00288",
                        "entry_id": "e074359c-bfba-31d4-ae3a-58c848de5bb2",
                        "glosses": [
                            "zich door middel van een peddel afduwen tegen het water"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "7c3d33b3-3f76-4011-adf1-8992124893bf",
                                "sense_id": "bfb1673d-2255-3e08-b89d-fd891ca00288",
                                "text": "Er werd verwoed gepeddeld, maar de andere ploeg won toch de wedstrijd."
                            }
                        ]
                    },
                    {
                        "sense_id": "02c4d080-69f5-3ebb-8f9a-11a8b3dcd000",
                        "entry_id": "e074359c-bfba-31d4-ae3a-58c848de5bb2",
                        "glosses": [
                            "rustig fietsen"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "c88d6c7d-4980-4457-9aa1-0de97fbbe05b",
                                "sense_id": "02c4d080-69f5-3ebb-8f9a-11a8b3dcd000",
                                "text": "In Utrecht, dé fietsstad van Nederland, peddelen vrijwel alle fietsers nog rustig zonder helm door de straten. Ook ouderen, kinderen en hun ouders. Willem (63) is onderweg met een ov-fiets en denkt er \"wel eens over na\", maar gebruikt tot nu toe alleen een helm met mountainbiken."
                            }
                        ]
                    }
