                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4cacc2a-2f01-454f-9029-81d6315ba68e",
                                "sense_id": "4408edde-6233-33a1-9910-8127442152e5",
                                "text": "― Ну, мол, ребятушки, выручайте! царю-батюшке деньги надобны, давайте подати."
                            },
                            {
                                "example_id": "9f28e7f3-ebfe-4fef-bc70-dd90d375a748",
                                "sense_id": "4408edde-6233-33a1-9910-8127442152e5",
                                "text": "Ты бы мог живя в Петербурге доложить о том царю-батюшке, а он бы не дал нас в обиду."
                            }
                        ]
                    }
