                                            {
                                                "example_id": "4b6b6714-4b45-4ce9-8be7-6ae3472fa7b2",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Der Steuermann trug eine braunweiß gestreifte Strickmütze, die am Hinterkopf hochgeschlagen war.“"
                                            },
                                            {
                                                "example_id": "dbe1285b-7c08-4eae-95c6-4a59791664cc",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Bis in die 80er Jahre wurde zu jeder Fahrt auf dieser Strecke ein ortskundiger Rheinlotse als Steuermann hinzugezogen.“"
                                            },
                                            {
                                                "example_id": "e6d89a0c-d47f-463b-8076-2f5b7bcb5d25",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Der Steuermann war allein an Bord, und ich nahm meinen Mut zusammen und fragte ihn, ob er nicht einen Schiffsjungen brauche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
