                                "target_senses": [
                                    {
                                        "sense_id": "f8a92d4c-b83b-3a50-b43c-7726e2e1bff2",
                                        "entry_id": "72f2623b-48fe-3321-958a-bacae2a8332e",
                                        "glosses": [
                                            "A piece of clothing worn on the upper body outside a shirt or blouse, often waist length to thigh length."
