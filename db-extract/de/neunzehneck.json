                "senses": [
                    {
                        "sense_id": "f7d6b896-4c08-3544-a2c4-6c78c9547a5e",
                        "entry_id": "360b95ba-c30f-33ee-a1c9-0a2156058e9f",
                        "glosses": [
                            "geometrische Figur mit neunzehn Ecken"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "0f411c97-f079-4f88-8de7-cb0ce6fd8c7c",
                                "sense_id": "f7d6b896-4c08-3544-a2c4-6c78c9547a5e",
                                "text": "Das regelmäßige Neunzehneck ist kein konstruierbares Polygon."
                            },
                            {
                                "example_id": "5c6e8bdc-9418-4aee-95e4-c6f369fd98d0",
                                "sense_id": "f7d6b896-4c08-3544-a2c4-6c78c9547a5e",
                                "text": "„Ich erinnere mich sehr deutlich, daß ich so durch jahrelange Übung bis zum regulären Neunzehneck gelangte und dieses schliefslich in schnellem Wechsel mit dem Achtzehneck in voller Deutlichkeit und Exaktheit visuell entwerfen und auch auf Papier nachzeichnen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
