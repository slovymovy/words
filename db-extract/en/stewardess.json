                        "target_lang_word": "Flugbegleiterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugbegleiterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c3bfb5a-1720-3cdf-9d90-eccead50a7b6",
                                        "entry_id": "ea747ca5-125b-32d4-bf06-fbea37ff9778",
                                        "glosses": [
                                            "Betreuerin von Gästen auf einer Flugreise"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1451076-64e7-47b0-b292-df1c2b92338e",
                                                "sense_id": "2c3bfb5a-1720-3cdf-9d90-eccead50a7b6",
                                                "text": "Die Flugbegleiterin begrüßt jeden Fluggast freundlich, wenn dieser das Flugzeug betritt."
                                            },
                                            {
                                                "example_id": "a5376ab6-9539-423a-bc64-ecc31e8db532",
                                                "sense_id": "2c3bfb5a-1720-3cdf-9d90-eccead50a7b6",
                                                "text": "„Doch die Flugbegleiterinnen - ich kann mich noch erinnern: Früher hießen sie Stewardessen - fanden ihn wohl reizend und bei der Ankunft sprach er gut ein Dutzend Passagiere mit dem Vornamen an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da71da1c-8d14-40f7-8810-08431004ac67",
                        "source_entry_id": "2340a23e-b1bc-3429-8323-133f0d2a4e30",
                        "source_sense_description": "female flight attendant",
                        "target_lang_word": "Stewardess",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stewardess",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d03b1484-aabc-35e6-9f92-984ef524d30e",
                                        "entry_id": "332079e6-3f74-3f79-ace4-b6fa72c3577e",
                                        "glosses": [
                                            "Betreuerin von Gästen, vor allem in Flugzeugen und auf Schiffen"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5957e021-8ab0-443e-888b-6afd3a7f8d24",
                                                "sense_id": "d03b1484-aabc-35e6-9f92-984ef524d30e",
                                                "text": "„Doch die Flugbegleiterinnen - ich kann mich noch erinnern: Früher hießen sie Stewardessen - fanden ihn wohl reizend und bei der Ankunft sprach er gut ein Dutzend Passagiere mit dem Vornamen an.“"
                                            },
                                            {
                                                "example_id": "f675d46a-b07b-4aa1-850e-22f7b19fa6c3",
                                                "sense_id": "d03b1484-aabc-35e6-9f92-984ef524d30e",
                                                "text": "„Früher flog sie als Stewardess für Air Greenland, jetzt ist sie pensioniert und kümmert sich um die Quanen in ihrem Garten.“"
                                            },
                                            {
                                                "example_id": "4b1918ec-c832-40f9-b715-c0d5e0aa4b61",
                                                "sense_id": "d03b1484-aabc-35e6-9f92-984ef524d30e",
                                                "text": "„Elisabeth beobachtete unterdessen die Mitpassagiere, die Stewardessen und Stewards, die durch den Gang glitten, lauschte dem Gemurmel und blickte aus dem Fenster, obwohl draußen alles schwarz war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
