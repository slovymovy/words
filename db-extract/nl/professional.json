                                    {
                                        "sense_id": "5a7ec143-ed3d-3c9e-a84e-682bc88f149f",
                                        "entry_id": "e5d58502-1420-38d3-8519-68dda98e7515",
                                        "glosses": [
                                            "von einem Fachmann ausgeführt, auf fachmännische Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc2c2767-10b1-42ea-8ac2-79080276e746",
                                                "sense_id": "5a7ec143-ed3d-3c9e-a84e-682bc88f149f",
                                                "text": "Die Reinigung war professionell."
                                            },
                                            {
                                                "example_id": "1d239ef5-09d9-4188-a08c-a78ab16c86dd",
                                                "sense_id": "5a7ec143-ed3d-3c9e-a84e-682bc88f149f",
                                                "text": "Er tritt sehr professionell auf."
                                            },
                                            {
                                                "example_id": "c91bb603-ceb1-41ff-bdaa-46eef4f6faac",
                                                "sense_id": "5a7ec143-ed3d-3c9e-a84e-682bc88f149f",
                                                "text": "„Die niedersächsische Wissenschaftsministerin warf der Universitätsführung und der Vorgängerregierung vor, jahrelang schöngerechnet zu haben und von üblichen Standards abgewichen zu sein, setzte selbst aber auch erst spät eine professionelle Projektsteuerung durch.“"
                                            },
                                            {
                                                "example_id": "dcc5e9b6-8ef0-4d91-802b-c9874cb259d9",
                                                "sense_id": "5a7ec143-ed3d-3c9e-a84e-682bc88f149f",
                                                "text": "„Auch der professionelle Grenzgänger hat in der Regel Ambitionen, die als vordergründiges Reizstreben nicht begreifbar sind: Er sucht nach einer Intensivierung seines Lebens.“"
                                            },
                                            {
                                                "example_id": "0aeddb96-8625-417d-a46d-0c8c1d76cf54",
                                                "sense_id": "5a7ec143-ed3d-3c9e-a84e-682bc88f149f",
                                                "text": "„Möchte man das Fotografieren ein wenig professioneller gestalten, sollte man eine manuell einstellbare Kamera, ein Stativ und eventuell eine kleine Taschenlampe mitnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e34734a-dcd8-3eaa-9374-e23be103d54a",
                                        "entry_id": "e5d58502-1420-38d3-8519-68dda98e7515",
                                        "glosses": [
                                            "kommerziell, das heißt gegen Bezahlung; hierbei ist ausdrücklich keine Aussage über die Qualität gemeint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea60c64b-908e-41fa-a5e6-e804b30414d3",
                                                "sense_id": "2e34734a-dcd8-3eaa-9374-e23be103d54a",
                                                "text": "Professionelle Fußballspieler gehören zu den bestverdienenden Menschen im Land."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
