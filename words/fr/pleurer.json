    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7e241ab-c08a-3143-845f-233ee3dd35f4",
                    "sense_definition": "Verser des larmes sous l'effet d'une émotion vive comme la tristesse, la douleur ou la joie.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "larmes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a commencé à <w>pleurer</w> après avoir perdu son jouet favori dans le parc."
                        },
                        {
                            "text": "Elle était tellement émue lors de la fête qu'elle s'est mise à <w>pleurer</w> de joie."
                        }
                    ],
                    "synonyms": [
                        "sangloter",
                        "chialer",
                        "larmoyer",
                        "pleurnicher"
                    ],
                    "antonyms": [
                        "rire",
                        "sourire"
                    ],
                    "common_phrases": [
                        "pleurer de joie",
                        "pleurer de rire",
                        "pleurer à chaudes larmes"
                    ]
                },
                {
                    "sense_id": "3a6a167c-7db8-3e96-a279-b6d05a2df9b1",
                    "sense_definition": "Regretter ou déplorer profondément la perte d'un proche ou la disparition de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deuil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la communauté s'est réunie pour <w>pleurer</w> la disparition de cet homme généreux."
                        },
                        {
                            "text": "Le pays tout entier a continué de <w>pleurer</w> ces artistes morts au combat."
                        }
                    ],
                    "common_phrases": [
                        "pleurer un proche",
                        "pleurer un mort"
                    ]
                },
                {
                    "sense_id": "f8967767-ac23-3b20-bf0a-cbb0dd8e31ac",
                    "sense_definition": "Laisser échapper des larmes en raison d'une irritation physique ou oculaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "larmes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand je prépare le repas, couper des oignons me fait toujours <w>pleurer</w>."
                        },
                        {
                            "text": "Avec le vent d'hiver et la poussière, ses yeux sensibles n'arrêtaient pas de <w>pleurer</w>."
                        }
                    ],
                    "synonyms": [
                        "larmoyer"
                    ],
                    "common_phrases": [
                        "yeux qui pleurent"
                    ]
                },
                {
                    "sense_id": "d2bf8a5c-1623-3b30-a53d-edf00c1fd505",
                    "sense_definition": "Se plaindre de manière insistante ou s'apitoyer pour obtenir quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il passe son temps à <w>pleurer</w> auprès de son patron pour réclamer une prime."
                        },
                        {
                            "text": "Bien qu'il possède plusieurs maisons, il continue de <w>pleurer</w> misère à la moindre dépense."
                        }
                    ],
                    "synonyms": [
                        "pleurnicher"
                    ],
                    "common_phrases": [
                        "pleurer misère"
                    ]
                },
                {
                    "sense_id": "781d77a7-3662-3498-b502-b76213a596aa",
                    "sense_definition": "Dégoutter de la sève après une taille fraîche, en parlant d'un végétal.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au retour du printemps, après la coupe, la vigne commence aussitôt à <w>pleurer</w>."
                        },
                        {
                            "text": "Le jardinier a constaté que les branches taillées se mettaient à <w>pleurer</w> abondamment."
                        }
                    ],
                    "common_phrases": [
                        "vigne qui pleure"
                    ]
                },
                {
                    "sense_id": "b10c37cc-1340-3e64-b1ec-fe09a1626e8c",
                    "sense_definition": "Émettre un cri plaintif analogue à un gémissement humain, chez certains animaux comme le goéland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la brume matinale du rivage, on entendait les oiseaux marins <w>pleurer</w> au-dessus des vagues."
                        },
                        {
                            "text": "La nuit, on entendait le chat abandonné <w>pleurer</w> devant la porte."
                        }
                    ]
                }
            ]
        },
        {
