                                    {
                                        "sense_id": "aca111b8-ef2a-3022-903f-7e1437de5200",
                                        "entry_id": "fa55a9b7-4e5e-339e-bc25-6ed60c1a2fb0",
                                        "glosses": [
                                            "een hoger bod uitbrengen dan een ander."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e60275a-43ce-4eb3-832a-85ed6c722e38",
                                                "sense_id": "aca111b8-ef2a-3022-903f-7e1437de5200",
                                                "text": "Je bent overboden en daarom gaat het huis naar de andere bieder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overbieden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a9bb9591-29ef-350b-a679-1150c0f701f3",
                                        "entry_id": "9b2631d0-8ad7-3f32-8d9e-fc4f153edd29",
                                        "glosses": [
                                            "opnieuw de bieding zijn beslag laten krijgen."
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf79a2a-0c11-41ed-b20f-101865fa3295",
                                                "sense_id": "a9bb9591-29ef-350b-a679-1150c0f701f3",
                                                "text": "Het spijt me, maar er wordt niet overgeboden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e046c80b-20a3-4666-a0a4-aae53260b6db",
                        "source_entry_id": "b876aa91-3c14-3e0b-b169-5c794da9b271",
                        "source_sense_id": "6dac5e16-132d-3fe2-824e-a687d713f132",
                        "source_sense_description": "to bid more than somebody else",
                        "target_lang_word": "surenchérir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surenchérir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "728bff2d-ab27-3f65-80eb-3d2a7c8ea667",
                                        "entry_id": "7d529817-07b9-3c3a-aa0f-d7a9e31a08b5",
                                        "glosses": [
                                            "Faire une surenchère."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c988da7-b206-4a26-acc7-35c23405e127",
                                                "sense_id": "728bff2d-ab27-3f65-80eb-3d2a7c8ea667",
                                                "text": "L’actrice australienne Nicole Kidman a surenchéri jusqu’à la somme faramineuse de 100 000 $ (soit 97 000 €) pour acquérir le chapeau que portait Hugh Jackman dans la comédie musicale The Music Man, rapporte The Guardian."
                                            },
                                            {
                                                "example_id": "ec6af685-7eaf-4b50-a3d5-52467be3c59e",
                                                "sense_id": "728bff2d-ab27-3f65-80eb-3d2a7c8ea667",
                                                "text": "Le délai pour surenchérir est expiré."
                                            },
                                            {
                                                "example_id": "e6e02ae9-42b1-4685-971f-6e1bff3ea7a9",
                                                "sense_id": "728bff2d-ab27-3f65-80eb-3d2a7c8ea667",
                                                "text": "L'administration n'y est pas a priori hostile, mais comme l'engagiste est prêt à surenchérir, elle refuse de laisser les communautés s'engager dans une opération ruineuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9107bf10-1269-322c-8a63-b9401a8ab2ba",
                                        "entry_id": "7d529817-07b9-3c3a-aa0f-d7a9e31a08b5",
                                        "glosses": [
                                            "Rivaliser de promesses, être en compétition forcenée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "097597b0-60b8-4ae6-b306-fa4fd27f255f",
                                                "sense_id": "9107bf10-1269-322c-8a63-b9401a8ab2ba",
                                                "text": "Après chaque fait-divers atroce, les politiciens surenchérissent sur le sécuritaire."
                                            },
                                            {
                                                "example_id": "1036b31f-c4ca-4753-a878-3cdc67e1dd19",
                                                "sense_id": "9107bf10-1269-322c-8a63-b9401a8ab2ba",
                                                "text": "Et de surenchérir alors entre elles, chacune assurant qu'elle a su plus que l'autre tenir la dragée haute à son malheureux époux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
