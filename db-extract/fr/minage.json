                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d524bc9a-c75d-462a-8129-38d12ccb0b04",
                        "entry_id": "41d1f3f8-7c4b-3b88-9356-82cea33a29e7",
                        "tags": [
                            "plural"
                        ],
                        "form": "minages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc82c0d8-ac42-39b2-9f5f-88c667d05d2e",
                        "entry_id": "41d1f3f8-7c4b-3b88-9356-82cea33a29e7",
                        "glosses": [
                            "Action de miner (une forteresse, un terrain, une étendue d’eau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017ee4ac-ad00-42db-a369-19c6f1987c9e",
                                "sense_id": "cc82c0d8-ac42-39b2-9f5f-88c667d05d2e",
                                "text": "Dans les travaux de minage à ciel ouvert nous avons en général deux surfaces de dégagement, (…) dans les travaux de minage en souterrain (…) nous n’avons plus qu’une seule surface de dégagement (…). Les coups de mine seront en conséquence beaucoup plus engagés en souterrain qu'à ciel ouvert et les consommations d’explosifs beaucoup plus élevées (P. TAVERNIER, Poudres et explosifs, Paris, P.U.F., 1975, p.122)"
                            },
                            {
                                "example_id": "bc2c6a13-695d-49f3-81d0-df13c2935095",
                                "sense_id": "cc82c0d8-ac42-39b2-9f5f-88c667d05d2e",
                                "text": "Le minage des eaux territoriales et intérieures nicaraguayennes par les Américains visait le renversement du gouvernement sandiniste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5ce69ef-9f2e-4660-9100-d4c9ebde825e",
                        "source_entry_id": "41d1f3f8-7c4b-3b88-9356-82cea33a29e7",
                        "source_sense_id": "cc82c0d8-ac42-39b2-9f5f-88c667d05d2e",
