        "fr-extract.jsonl": [
            {
                "entry_id": "d5ba2b1c-627c-3fe0-b39f-75d9c2d7f7e5",
                "word": "indivisible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ce4c4c32-aaa4-4a35-983d-21c866e828b7",
                        "entry_id": "d5ba2b1c-627c-3fe0-b39f-75d9c2d7f7e5",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "indivisibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba793b4d-15e9-3542-81a3-e9206e6e84cf",
                        "entry_id": "d5ba2b1c-627c-3fe0-b39f-75d9c2d7f7e5",
                        "glosses": [
                            "Qui ne peut pas être divisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8adcc36c-ca5c-4df9-9307-d92051531059",
                                "sense_id": "ba793b4d-15e9-3542-81a3-e9206e6e84cf",
                                "text": "À coup sûr, l’essence de la laïcité, mis à part la séparation de la religion et de l’État, est l’acceptation de la proposition selon laquelle il n’y a pas de finalité des formes, pas de possession exclusive de la vérité absolue et indivisible."
                            },
                            {
                                "example_id": "f2af1bfe-ac1f-46ef-a054-7058845c276b",
                                "sense_id": "ba793b4d-15e9-3542-81a3-e9206e6e84cf",
                                "text": "Un point indivisible. — L’hypothèque est, de sa nature, indivisible."
                            }
                        ]
                    },
                    {
                        "sense_id": "317ee099-82d3-36ea-b52d-eb2ab840632f",
                        "entry_id": "d5ba2b1c-627c-3fe0-b39f-75d9c2d7f7e5",
                        "glosses": [
                            "Qualifie la république qui n’est pas fédérative."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "5db86534-f4da-4faf-874e-6d9f4c854793",
                                "sense_id": "317ee099-82d3-36ea-b52d-eb2ab840632f",
                                "text": "Ces braves gens, qui n’étaient pas plus malins en l’an IX de la république une et indivisible qu’ils ne le sont aujourd’hui , se laissèrent prendre au piège et proclamèrent dans leur coterie de foyer que les Italiens étaient mis en déroute complète par un Français."
                            },
                            {
                                "example_id": "3a57c0b2-c807-42d6-b690-a3609416d597",
                                "sense_id": "317ee099-82d3-36ea-b52d-eb2ab840632f",
                                "text": "La France est une République indivisible, laïque, démocratique et sociale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16146963-c37f-4113-9c01-1ed93c120ec5",
                        "source_entry_id": "d5ba2b1c-627c-3fe0-b39f-75d9c2d7f7e5",
                        "target_lang_word": "indivisible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indivisible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28b87fcd-89a9-3f64-a633-7583e0e89a25",
                                        "entry_id": "52074591-746c-3d0b-97b3-3d899397387a",
                                        "glosses": [
                                            "Incapable of being divided; atomic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1929298f-950a-474f-9793-9d11da3fe233",
                                                "sense_id": "28b87fcd-89a9-3f64-a633-7583e0e89a25",
                                                "text": "one indivisible point of time"
                                            },
                                            {
                                                "example_id": "a1322096-a406-423c-9e4a-8c76d4b15d3c",
                                                "sense_id": "28b87fcd-89a9-3f64-a633-7583e0e89a25",
                                                "text": "Although the mainland and Taiwan are yet to be reunited, they belong to one and same China, which is an indivisible whole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d28f0b51-74ab-3eec-9dc8-cee74d8e4c7f",
                                        "entry_id": "52074591-746c-3d0b-97b3-3d899397387a",
                                        "glosses": [
                                            "Incapable of being divided by a specific integer without leaving a remainder."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "indivisible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd7ce9f5-624d-39ad-8045-e0079de471bc",
                                        "entry_id": "517256a4-3e35-3cf0-b563-e7d1c525cee4",
                                        "glosses": [
                                            "That which cannot be divided or split."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19a146ae-99ea-471b-844b-cb47a8b14598",
                                                "sense_id": "fd7ce9f5-624d-39ad-8045-e0079de471bc",
                                                "text": "By atom, nobody will imagine we intend to express a perfect indivisible, but only the least sort of natural bodies."
                                            },
                                            {
                                                "example_id": "e417aa02-600c-468d-aa71-a10485816980",
                                                "sense_id": "fd7ce9f5-624d-39ad-8045-e0079de471bc",
                                                "text": "The compoſition of Bodies, whether it be of Diviſibles or Indiviſibles, is a queſtion which must be rank'd with the Indiſſolvibles: For though it hath been attempted by the moſt illuſtrious Wits of all Philoſophick Ages; yet they have done little elſe, but ſhewn their own diviſions to be almoſt as infinite, as ſome ſuppoſe thoſe of their Subject."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22483c9d-915c-35d8-b8de-feaa0a468587",
                                        "entry_id": "517256a4-3e35-3cf0-b563-e7d1c525cee4",
                                        "glosses": [
                                            "An infinitely small quantity which is assumed to admit of no further division."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
