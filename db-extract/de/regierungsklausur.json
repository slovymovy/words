                "senses": [
                    {
                        "sense_id": "fcfea55a-4ec3-3ee0-ac38-d41be150db66",
                        "entry_id": "6bf9ae5b-b73b-39d4-8719-2ef24ee8a500",
                        "glosses": [
                            "Tagung der Mitglieder einer Regierung, die unter Ausschluss der Öffentlichkeit stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d42a787c-4456-43e8-bb7c-34121e219e86",
                                "sense_id": "fcfea55a-4ec3-3ee0-ac38-d41be150db66",
                                "text": "„Sie stoßen sich daran, dass bei der Regierungsklausur in der Steiermark in der Vorwoche auch Nationalratspräsident Wolfgang Sobotka (ÖVP) und die Dritte Präsidentin Anneliese Kitzmüller (FPÖ) anwesend waren.“"
                            },
                            {
                                "example_id": "861b11cf-ce02-4d00-a80e-e959542067d3",
                                "sense_id": "fcfea55a-4ec3-3ee0-ac38-d41be150db66",
                                "text": "„Bei der Regierungsklausur in Mauerbach zeigen sich ÖVP und FPÖ über die Entstehung einer neuen Balkan-Flüchtlingsroute besorgt.“"
                            },
                            {
                                "example_id": "48352ac3-c980-46d6-8486-eda9a03b695b",
                                "sense_id": "fcfea55a-4ec3-3ee0-ac38-d41be150db66",
                                "text": "„Zu Beginn der Woche präsentierte Kurz auf einer Regierungsklausur seine Pläne für eine Reform der sogenannten bedarfsorientierten Mindestsicherung, die das letzte Netz des Sozialstaates bildet, in dem die Schwächsten aufgefangen werden sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
