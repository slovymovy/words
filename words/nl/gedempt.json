{
    "word_family": [
        "dempen",
        "demper",
        "demping"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5e33fd8f-8994-3fd6-9435-7829adc711fb",
                    "sense_definition": "Zacht van geluid, niet luid of scherp klinkend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De buren praatten op <w>gedempte</w> toon om de baby niet wakker te maken.",
                            "target_lang_translations": {
                                "en": "The neighbors spoke in <w>hushed</w> tones so as not to wake the baby."
                            }
                        },
                        {
                            "text": "In de bibliotheek hoorde je alleen het <w>gedempte</w> geluid van omslaande bladzijden.",
                            "target_lang_translations": {
                                "en": "In the library, you could only hear the <w>muted</w> sound of pages turning."
                            }
                        }
                    ],
                    "synonyms": [
                        "zacht",
                        "ingehouden",
                        "mat"
                    ],
                    "antonyms": [
                        "luid",
                        "hard",
                        "schel"
                    ],
                    "common_phrases": [
                        "gedempte toon",
                        "gedempt geluid",
                        "gedempte stemmen"
                    ],
                    "target_lang_definitions": {
                        "en": "Soft in sound, not loud or sharp-sounding."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "muted",
                                "target_lang_sense_clarification": "of sound or voices"
                            },
                            {
                                "target_lang_word": "hushed",
                                "target_lang_sense_clarification": "very quiet and still"
                            },
                            {
                                "target_lang_word": "subdued",
                                "target_lang_sense_clarification": "quiet and low-key"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb20742-bd1b-3bf8-830a-3151a27bcaa3",
                    "sense_definition": "Met aarde of ander materiaal opgevuld, meestal gezegd van waterwegen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opvulling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de <w>gedempte</w> sloot werden de twee stukken land aan elkaar verbonden.",
                            "target_lang_translations": {
                                "en": "The two pieces of land were connected by the <w>filled-in</w> ditch."
                            }
                        },
                        {
                            "text": "De stad heeft veel van haar oude grachten nu als <w>gedempte</w> haven in gebruik.",
                            "target_lang_translations": {
                                "en": "The city now uses many of its old canals as <w>reclaimed</w> harbor areas."
                            }
                        }
                    ],
                    "synonyms": [
                        "dichtgegooid",
                        "opgevuld"
                    ],
                    "antonyms": [
                        "open"
                    ],
                    "common_phrases": [
                        "gedempte sloot",
                        "gedempte gracht",
                        "gedempte haven"
                    ],
                    "target_lang_definitions": {
                        "en": "Filled in with earth or other material, usually said of waterways."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "filled-in",
                                "target_lang_sense_clarification": "of a ditch or canal"
                            },
                            {
                                "target_lang_word": "reclaimed",
                                "target_lang_sense_clarification": "land that was formerly water"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f338eb1-ee52-3003-b04b-e60f900cba1c",
                    "sense_definition": "Voorzien van een mechanisme om de klank of kracht te verzachten.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De solist speelde op een <w>gedempte</w> trompet voor een melancholisch effect.",
                            "target_lang_translations": {
                                "en": "The soloist played on a <w>muted</w> trumpet for a melancholic effect."
                            }
                        },
                        {
                            "text": "De auto heeft een <w>gedempte</w> uitlaat om de geluidsoverlast te beperken.",
                            "target_lang_translations": {
                                "en": "The car has a <w>muffled</w> exhaust to limit noise pollution."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gedempte trompet",
                        "gedempte uitlaat"
                    ],
                    "target_lang_definitions": {
                        "en": "Equipped with a mechanism to soften the sound or force."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "muted",
                                "target_lang_sense_clarification": "of a musical instrument"
                            },
                            {
                                "target_lang_word": "damped",
                                "target_lang_sense_clarification": "of vibrations or mechanical force"
                            },
                            {
                                "target_lang_word": "muffled",
                                "target_lang_sense_clarification": "of an exhaust or engine"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25ffc49f-0cf6-3154-8137-c9d4e860b15c",
                    "sense_definition": "Voltooid deelwoord van <w>dempen</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brandweer heeft het vuur snel <w>gedempt</w> met speciaal schuim.",
                            "target_lang_translations": {
                                "en": "The fire department quickly <w>quenched</w> the fire with special foam."
                            }
                        },
                        {
                            "text": "Hij heeft het licht in de kamer een beetje <w>gedempt</w>.",
                            "target_lang_translations": {
                                "en": "He <w>dimmed</w> the light in the room a little."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle of 'dempen' (to dampen, dim, or fill in)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dimmed",
                                "target_lang_sense_clarification": "of lights"
                            },
                            {
                                "target_lang_word": "quenched",
                                "target_lang_sense_clarification": "of a fire"
                            },
                            {
                                "target_lang_word": "muffled",
                                "target_lang_sense_clarification": "of a sound"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}