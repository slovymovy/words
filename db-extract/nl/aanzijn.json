                        "translation_id": "cf060613-cf3c-4e01-b1cf-aa26bd50e0d2",
                        "source_entry_id": "aa13e9c6-7066-3aeb-a02e-adea335f7ce6",
                        "source_sense_id": "7563e038-99ee-3a87-96ff-c609f0a855a0",
                        "target_lang_word": "existence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "existence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                        "entry_id": "097303ae-2ccd-3321-8f9c-e789f6f705d2",
                                        "glosses": [
                                            "The state of being, existing, or occurring; beinghood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b9466a8-7db2-4455-a509-bcf07092b654",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "In order to destroy evil, we must first acknowledge its existence."
                                            },
                                            {
                                                "example_id": "e2f64c68-d4f1-454f-9a89-61252bef7dec",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "Fortunate it is for the tranquillity of the new-born infant, if he have any turn for philosophy, that he understands none of the nonsense consecrated by old usage to the commencement of existence."
                                            },
                                            {
                                                "example_id": "b2b100d0-e7e5-4517-b3af-76d7c34870c7",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                                            },
                                            {
                                                "example_id": "725bd82d-e992-4c66-b680-9a4c50418d06",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "The physics of elementary particles in the 20th century was distinguished by the observation of particles whose existence had been predicted by theorists sometimes decades earlier."
                                            },
                                            {
                                                "example_id": "933a459d-402a-49d2-9209-efba7455dd07",
                                                "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                                                "text": "The ancients said, “A ruler should exist for the existence of the people.” The famous thinker, Mencius noted, “The people are the most valuable, then the country, and the ruler comes last.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b47581ac-1901-34db-9aab-f235e5ade685",
                                        "entry_id": "097303ae-2ccd-3321-8f9c-e789f6f705d2",
                                        "glosses": [
                                            "Empirical reality; the substance of the physical universe. (Dictionary of Philosophy; 1968)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
