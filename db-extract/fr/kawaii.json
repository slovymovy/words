                                                "sense_id": "d15c065b-e1c0-3934-abb2-871ab41ad33c",
                                                "text": "在商店裡販賣的卡哇伊娃娃"
                                            },
                                            {
                                                "example_id": "b9ea4fa3-97cc-425f-8e0b-cf44de87eeb6",
                                                "sense_id": "d15c065b-e1c0-3934-abb2-871ab41ad33c",
                                                "text": "在商店里贩卖的卡哇伊娃娃"
                                            },
                                            {
                                                "example_id": "2368d3a8-4366-4dff-a017-8b8d16263b23",
                                                "sense_id": "d15c065b-e1c0-3934-abb2-871ab41ad33c",
                                                "text": "卡哇伊的超美飾品，水晶般閃灼的光芒裝飾出聖誕美麗的心情。"
                                            },
                                            {
                                                "example_id": "e0370ce7-50e4-481f-9cf7-3cd751dd2788",
                                                "sense_id": "d15c065b-e1c0-3934-abb2-871ab41ad33c",
                                                "text": "卡哇伊的超美饰品，水晶般闪灼的光芒装饰出圣诞美丽的心情。"
                                            }
                                        ]
                                    }
