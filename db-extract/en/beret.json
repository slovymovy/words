                                    {
                                        "sense_id": "5957a941-4a4e-3e00-b248-40f0987a16b6",
                                        "entry_id": "cba88883-40fe-3781-abca-8e0817645dd5",
                                        "glosses": [
                                            "plat hoofddeksel zonder klep, o.a. in gebruik bij militairen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9064f79-4ed9-4dd8-8330-ae52d54951f6",
                                                "sense_id": "5957a941-4a4e-3e00-b248-40f0987a16b6",
                                                "text": "De kleur van de baret geeft aan bij welk onderdeel de militair is ingedeeld. De rode baret krijgt een militair na de zware opleiding tot luchtmobiel infanterist."
                                            }
                                        ]
