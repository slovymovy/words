    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35627c9b-28fd-387e-93fa-0ab14e633ad4",
                    "sense_definition": "Émettre ou réfléchir une lumière vive et éclatante.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil commence à <w>briller</w> à travers les rideaux de la chambre."
                        },
                        {
                            "text": "Toutes les étoiles du ciel <w>brillent</w> intensément pendant cette nuit claire."
                        }
                    ],
                    "synonyms": [
                        "luire"
                    ],
                    "common_phrases": [
                        "briller de mille feux",
                        "faire briller"
                    ]
                },
                {
                    "sense_id": "23f2f15a-8a16-3386-b60b-56e684811d2a",
                    "sense_definition": "Avoir un éclat particulier exprimant une émotion vive, en parlant des yeux ou du visage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses yeux <w>brillent</w> de joie quand elle ouvre ses cadeaux d'anniversaire."
                        },
                        {
                            "text": "Le visage de l'enfant a <w>brillé</w> de fierté en recevant sa récompense."
                        }
                    ],
                    "common_phrases": [
                        "yeux qui brillent",
                        "briller de joie"
                    ]
                },
                {
                    "sense_id": "87b4c873-5eb8-35c6-b79b-f1af29dde25f",
                    "sense_definition": "Se distinguer par des qualités remarquables ou exceller dans un domaine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet élève sérieux <w>brille</w> particulièrement dans les matières scientifiques."
                        },
                        {
                            "text": "Elle a su <w>briller</w> lors de cette compétition internationale de piano."
                        }
                    ],
                    "common_phrases": [
                        "briller dans ses études",
                        "briller en société"
                    ]
                },
                {
                    "sense_id": "c11faa9f-2095-32ab-9816-1eabbc1536d5",
                    "sense_definition": "Attirer l'attention par sa présence ou sa renommée, souvent employé ironiquement pour souligner un manque.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a <w>brillé</w> par son absence lors de cette réunion importante."
                        },
                        {
                            "text": "Cet hôtel décevant ne <w>brille</w> absolument pas par la propreté de ses chambres."
                        }
                    ],
                    "common_phrases": [
                        "briller par son absence"
                    ]
                },
                {
                    "sense_id": "3e98ee18-536f-3433-bfe1-7a775f6f2d80",
                    "sense_definition": "S'agiter avec vivacité ou frétiller d'impatience.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les jeunes soldats <w>brillaient</w> d'impatience avant le début de la bataille."
                        },
                        {
                            "text": "Le destrier nerveux <w>brillait</w> d'ardeur sous les rênes de son cavalier."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sens vieilli"
                        }
                    ]
                },
                {
                    "sense_id": "e9ce1ce6-31d7-3cd5-a621-b42ddd3dc1ee",
                    "sense_definition": "Fureter et chercher le gibier avec ardeur, en parlant d'un chien.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maître laissait ses chiens <w>briller</w> librement à travers les sous-bois."
                        },
                        {
                            "text": "La meute a <w>brillé</w> pendant des heures avant de lever le lièvre."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme de vénerie"
                        }
                    ]
                }
            ]
