                "senses": [
                    {
                        "sense_id": "94a37981-69d8-3e77-90cc-4a62056c1faa",
                        "entry_id": "da40dde8-959f-35c5-aa59-9ca49f5e070f",
                        "glosses": [
                            "Sprache, die vom Volk der Achinesen in der indonesischen Provinz Aceh gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c6d808a-ba94-4cd1-8f84-72b44c80b807",
                                "sense_id": "94a37981-69d8-3e77-90cc-4a62056c1faa",
                                "text": "„Und nun spricht diese sechsundfünfzigjährige Greisin aus einem sumatrischen Bergdorf, die anders als die übrigen Flüchtlinge nicht einmal Indonesisch, sondern nur Acehnesisch spricht, die sich in der Stadt, unter all den jungen Frauen aus fremden Dörfern verlassen fühlen muß wie jemals ein Mensch[.]“"
                            },
                            {
                                "example_id": "5cf1dc94-109a-4158-b910-4cb78dc3cf64",
                                "sense_id": "94a37981-69d8-3e77-90cc-4a62056c1faa",
                                "text": "„1906 kam er nach Leiden zurück und lehrte dort an der Universität Arabisch und später auch Acehnesisch – die Sprache von Aceh, einer Region in Nord-Sumatra.“"
                            },
                            {
                                "example_id": "cf4098c1-137e-4868-80a7-fb0e696b0145",
                                "sense_id": "94a37981-69d8-3e77-90cc-4a62056c1faa",
                                "text": "„Etwa drei Millionen Menschen sprechen Acehnesisch, eine Sprache, die eng mit dem Malaiischen verwandt ist.“"
                            },
                            {
                                "example_id": "da80b8cc-990a-4599-aef1-aafff4377ab2",
                                "sense_id": "94a37981-69d8-3e77-90cc-4a62056c1faa",
                                "text": "„In Van Valin/LaPolla (1997: 275) wird das Acehnesische als Beispiel für eine Sprache ohne syntaktische Relationen angeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
