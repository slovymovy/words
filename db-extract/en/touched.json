                                ]
                            },
                            {
                                "target_word": "ontroerd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cd5eadcb-e73f-3d79-82f8-4f7e5e1071d8",
                                        "entry_id": "7024c816-199c-3cf1-93b7-f3b97bacf0a0",
                                        "glosses": [
                                            "voltooid deelwoord van ontroeren"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97858aba-811e-4e51-99c2-43f8498f4417",
                                                "sense_id": "cd5eadcb-e73f-3d79-82f8-4f7e5e1071d8",
                                                "text": "De leerling was ontroerd en aangeslagen door wat er vanmiddag in de klas was gebeurd."
                                            },
                                            {
                                                "example_id": "dcc0e6d7-5227-406e-aefa-b030eebb87d7",
                                                "sense_id": "cd5eadcb-e73f-3d79-82f8-4f7e5e1071d8",
                                                "text": "Ik was erg ontroerd door haar bezorgdheid, maar ook door haar praktische advies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48f6f848-d34c-4b36-9528-dd1670843545",
                        "source_entry_id": "98cfeffe-dbb4-3fba-9a5a-0cde1a6c7c2d",
                        "source_sense_description": "moved",
                        "target_lang_word": "ému",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ému",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2b61674-c05e-359a-a50f-fd808e2c7492",
                                        "entry_id": "d0b33a58-9884-34ac-b029-8f516203f247",
                                        "glosses": [
                                            "En proie à une émotion plus ou moins vive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b0a2386-d501-4c09-8592-46b4e0848ef9",
                                                "sense_id": "f2b61674-c05e-359a-a50f-fd808e2c7492",
                                                "text": "J’étais si ému que je ne pouvais plus parler."
                                            },
                                            {
                                                "example_id": "3ba81b12-7329-410e-b95a-a41e713cb90b",
                                                "sense_id": "f2b61674-c05e-359a-a50f-fd808e2c7492",
                                                "text": "Étymologiquement, que signifie « é-mu »? Mû hors de. Un homme ému est un homme arraché à lui-même, arraché au « je » relatif qui aurait pu se manifester en lui. Un homme ému est un homme aliéné, décentré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0d21415-ba02-3e26-91b9-d4a9eedd3b69",
                                        "entry_id": "d0b33a58-9884-34ac-b029-8f516203f247",
                                        "glosses": [
                                            "Qui manifeste une émotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a09f27c3-0379-400a-bbbd-6522bbbcb0a3",
                                                "sense_id": "d0d21415-ba02-3e26-91b9-d4a9eedd3b69",
                                                "text": "J’ai couru deux ou trois fois — je ne sais plus ! — le Tour du Finistère, appelé aussi le Tourduf, dans le milieu des années deux mille, et j’en garde un souvenir particulièrement ému."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ému",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2a08cb7-48f8-3612-8a6e-42226334ae3b",
                                        "entry_id": "42cc59c7-95e8-3a8c-a76d-50c38c94a27c",
                                        "glosses": [
                                            "Participe passé masculin singulier de émouvoir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88884db4-36e1-4512-8164-7521962a8710",
                                                "sense_id": "e2a08cb7-48f8-3612-8a6e-42226334ae3b",
                                                "text": "Tel s’est ému de l’irrévérence de ce jeune homme qui vient traiter de grotesque la candidature de M. Labiche à l’Académie candidature patronnée par MM. Augier et Legouvé, des gens si sérieux, qui, rentré chez lui et désétourdi du bruit fait par des amis complaisants, s’avouera que l’idée était bouffonne et que l’auteur du Chapeau de paille d’Italie n’a pas exactement le genre de talent qui mène au fauteuil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f475e5e8-cebd-429d-ad4c-5bab7b0f3211",
