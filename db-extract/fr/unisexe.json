                                        "examples": [
                                            {
                                                "example_id": "059dc6e4-ea2f-45e2-a8cb-a257ba4ed918",
                                                "sense_id": "e84d49df-fc16-300a-96fb-3fc1230bc139",
                                                "text": "Kim is a unisex name."
                                            },
                                            {
                                                "example_id": "386ca25a-9744-4f39-a327-9f3629447839",
                                                "sense_id": "e84d49df-fc16-300a-96fb-3fc1230bc139",
                                                "text": "So while today’s unisex fashions may seem like another benchmark for equality, it’s rarely progressive when you look at it through the lens of a lucrative fashion industry that’s looking to turn a profit."
                                            }
                                        ]
                                    },
                                    {
