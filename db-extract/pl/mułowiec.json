                                "target_senses": [
                                    {
                                        "sense_id": "3ec30a93-0a31-3730-ba20-d133ae818e35",
                                        "entry_id": "05ece35a-4f2a-3138-a6b2-db2e17460190",
                                        "glosses": [
                                            "A fine-grained sedimentary rock whose original constituents were clays or muds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a97d3458-16a9-4478-9ef6-491993348631",
                                                "sense_id": "3ec30a93-0a31-3730-ba20-d133ae818e35",
                                                "text": "The new fossils come from mudstones in central Poland, in beds that have been dated using other, much more common and cosmopolitan, fossils."
                                            },
                                            {
                                                "example_id": "1a297144-2600-4052-b0f2-f94ffe1d9130",
                                                "sense_id": "3ec30a93-0a31-3730-ba20-d133ae818e35",
                                                "text": "Excavation of the twin bore tunnel will produce around 500,000 tonnes of mudstone and soil, which will be processed on site and then reused to build embankments elsewhere along the route."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
