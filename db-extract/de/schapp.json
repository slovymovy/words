                "senses": [
                    {
                        "sense_id": "77a24324-196d-3aeb-a0e5-1d480a3a63b0",
                        "entry_id": "cf50d720-3dc7-3c95-9ec6-badeebac6ce1",
                        "glosses": [
                            "großes Möbelstück zum Unterbringen von Kleidung oder Sachen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3d3da968-e569-3659-bba9-cb728bbad66c",
                        "entry_id": "cf50d720-3dc7-3c95-9ec6-badeebac6ce1",
                        "glosses": [
                            "einzelne Schublade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bc34105-df08-44eb-b664-638a073fc76d",
                                "sense_id": "3d3da968-e569-3659-bba9-cb728bbad66c",
                                "text": "„Innen im Schapp lag das große Brotmesser mit den scharfen Zacken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "56f92969-f63e-3217-a707-d37690629697",
                        "entry_id": "cf50d720-3dc7-3c95-9ec6-badeebac6ce1",
                        "glosses": [
                            "Fach zum Verstauen aller möglichen Gegenstände auf einem Schiff"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "cd21d35d-5252-4628-9365-87f314e0ad10",
                                "sense_id": "56f92969-f63e-3217-a707-d37690629697",
                                "text": "Vergiss nicht, vor dem Ausfahren die Schapps zu schließen, sonst purzelt dir alles heraus."
                            },
                            {
                                "example_id": "20d5f9b8-580a-4a2f-aad2-1f91eb67649a",
                                "sense_id": "56f92969-f63e-3217-a707-d37690629697",
                                "text": "„Aber jetzt wollen Eiríkur und ich Kuchen, sagte Páll und kletterte nach achtern zum Schapp, aus dem er drei dicke Scheiben von Hafrúns Schokoladenkuchen holte.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be21fa68-482c-414b-9726-5937fa91cc29",
                        "source_entry_id": "cf50d720-3dc7-3c95-9ec6-badeebac6ce1",
                        "source_sense_id": "77a24324-196d-3aeb-a0e5-1d480a3a63b0",
                        "source_sense_description": "großes Möbelstück zum Unterbringen von Kleidung oder Sachen",
                        "target_lang_word": "armoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "540e967e-4f30-3ce1-a5b9-7177d40ff95e",
                                        "entry_id": "2a255d05-da38-3059-a6c5-75a1290100a1",
                                        "glosses": [
                                            "Meuble haut fermé par une ou deux portes et destiné au rangement du linge, des vêtements ou d’autres objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8daf21c6-08e1-4f5b-8537-28d9e484dc68",
                                                "sense_id": "540e967e-4f30-3ce1-a5b9-7177d40ff95e",
                                                "text": "Moi qui croyais qu’on couchait dans des armoires, en Bretagne…"
                                            },
                                            {
                                                "example_id": "f03f1c5f-6811-485f-a0b8-6e8f6e6c6abd",
                                                "sense_id": "540e967e-4f30-3ce1-a5b9-7177d40ff95e",
                                                "text": "Ces sacraires sont munis d’armoires doubles, fortement ferrées et prises aux dépens de l’épaisseur des murs."
                                            },
                                            {
                                                "example_id": "565ee5e0-d016-4a7c-a2b5-37aa3d94cee5",
                                                "sense_id": "540e967e-4f30-3ce1-a5b9-7177d40ff95e",
                                                "text": "Elle retrouva pourtant sa présence d’esprit pour aller atteindre, au haut d’une armoire, un bocal de mirabelles à l’eau-de-vie."
                                            },
                                            {
                                                "example_id": "a8410313-50e7-4864-9fab-b24c92a9b996",
                                                "sense_id": "540e967e-4f30-3ce1-a5b9-7177d40ff95e",
                                                "text": "Toutes les clés de la maison, des armoires et des coffres, cliquetaient autour de sa taille en un trousseau noué à sa ceinture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0599c467-94cf-35fb-9685-c6d91450eb9c",
                                        "entry_id": "2a255d05-da38-3059-a6c5-75a1290100a1",
                                        "glosses": [
                                            "Placard, meuble de rangement, notamment pour le matériel de cuisine."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f60812e5-588f-48bc-b7e2-868eec35f18b",
                                                "sense_id": "0599c467-94cf-35fb-9685-c6d91450eb9c",
                                                "text": "ARMOIRE, n.f. Meuble renfermant du linge, de la vaisselle ou d'autres articles ménagers. Il existe des armoires mobiles et des armoires fixées dans les murs. Les armoires mobiles sont occasionnellement rencontrées dans les marchés de construction mais elles ne font pas partie de l'architecture d'intérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "470ad5f0-511f-336d-9a8f-8ec03e698c10",
                                        "entry_id": "2a255d05-da38-3059-a6c5-75a1290100a1",
                                        "glosses": [
                                            "Armoire en muraille : Placard situé dans l'épaisseur d'un mur."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb163c35-de00-437a-b486-7b7cfa7db467",
                                                "sense_id": "470ad5f0-511f-336d-9a8f-8ec03e698c10",
                                                "text": "… et au Québec se composait de meubles intégrés a la structure même de l'édifice, comme une armoire en muraille, …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
