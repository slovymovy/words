    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b21b0ca-5d77-3df6-8c0b-5d293091ec88",
                    "sense_definition": "Сведения, знания или новости, которые передаются, хранятся или получаются людьми или системами.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В интернете есть любая <w>информация</w>, которая может тебе понадобиться.",
                            "target_lang_translations": {
                                "en": "The internet has any <w>information</w> that you might need.",
                                "zh": "互联网上有任何你可能需要的<w>信息</w>。"
                            }
                        },
                        {
                            "text": "Этот источник <w>информации</w> кажется мне очень надёжным.",
                            "target_lang_translations": {
                                "en": "This source of <w>information</w> seems very reliable to me.",
                                "zh": "这个<w>信息</w>来源对我来说似乎非常可靠。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сведение",
                        "данные",
                        "знание",
                        "сообщения",
                        "вести"
                    ],
                    "antonyms": [
                        "дезинформация"
                    ],
                    "common_phrases": [
                        "полезная информация",
                        "источник информации",
                        "сбор информации",
                        "обмен информацией",
                        "доступ к информации"
                    ],
                    "target_lang_definitions": {
                        "en": "Facts, knowledge, or news that are transmitted, stored, or received by people or systems.",
                        "zh": "由人或系统传输、存储或接收的事实、知识或新闻。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "information",
                                "target_lang_sense_clarification": "knowledge or facts about something"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信息",
                                "target_lang_sense_clarification": "指客观事物状态及其运动特征的普遍性形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2221c959-24b1-3975-8c83-4fe3c14cb931",
                    "sense_definition": "Действие по значению глагола информировать; процесс сообщения сведений или ознакомления с чем-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Своевременная <w>информация</w> сотрудников — важная обязанность менеджера.",
                            "target_lang_translations": {
                                "en": "Timely <w>informing</w> of employees is an important duty of a manager.",
                                "zh": "及时<w>通知</w>员工是经理的一项重要职责。"
                            }
                        },
                        {
                            "text": "Средства массовой <w>информации</w> играют огромную роль в современном обществе.",
                            "target_lang_translations": {
                                "en": "Mass <w>media</w> plays a huge role in modern society.",
                                "zh": "大众<w>信息</w>传播媒介在现代社会中扮演着巨大的角色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "информирование",
                        "оповещение"
                    ],
                    "common_phrases": [
                        "средства массовой информации",
                        "бюро информации"
                    ],
                    "target_lang_definitions": {
                        "en": "The action of informing; the process of communicating details or familiarizing someone with something.",
                        "zh": "告知的动作；传达细节或使某人熟悉某事的过程。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "informing",
                                "target_lang_sense_clarification": "the act of imparting knowledge"
                            },
                            {
                                "target_lang_word": "notification",
                                "target_lang_sense_clarification": "formal announcement or warning"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通知",
                                "target_lang_sense_clarification": "将事项告知相关人员"
                            },
                            {
                                "target_lang_word": "告知",
                                "target_lang_sense_clarification": "正式或非正式地向某人传达信息"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}