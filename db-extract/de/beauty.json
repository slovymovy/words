                ],
                "senses": [
                    {
                        "sense_id": "df0f498e-5fee-3c33-8703-a9a42fdd0d22",
                        "entry_id": "c11a55ad-440d-362b-a102-9f6f8fc05889",
                        "glosses": [
                            "schöne Frau; ein schönes Exemplar"
                        ],
                        "tags": [
                            "auch für weibliche Haustiere oder Objekte"
                        ],
                        "examples": [
                            {
                                "example_id": "35850a18-20d1-487e-b3c9-ab6499a47f04",
                                "sense_id": "df0f498e-5fee-3c33-8703-a9a42fdd0d22",
                                "text": "„Nur die natürlichste Beauty ist eine wirkliche Beauty!“"
                            },
                            {
                                "example_id": "6497534b-0c4e-496a-bb63-18fd2380cb8a",
                                "sense_id": "df0f498e-5fee-3c33-8703-a9a42fdd0d22",
                                "text": "„Nicht zu vergessen Walter Schönauer, der aus dem Ganzen eine Beauty gemacht hat, und meine Saskia, die mir immer in allen Belangen – auch den unangenehmen - zur Seite steht.“"
                            },
                            {
                                "example_id": "08f54431-3815-4598-9ad0-5c4bc8c0cee0",
                                "sense_id": "df0f498e-5fee-3c33-8703-a9a42fdd0d22",
                                "text": "„Sie war eine Beauty, die Tochter von unserem Oberboss.“"
                            },
                            {
                                "example_id": "cbe7c0e1-3662-4951-a11f-537c5e1be94b",
                                "sense_id": "df0f498e-5fee-3c33-8703-a9a42fdd0d22",
                                "text": "„‚Hey, Beauty.‘ Ohne zu fragen, setzte er sich neben mich.“"
                            },
                            {
                                "example_id": "e741ceef-a934-4d9e-9f0f-3821c51c0c7c",
                                "sense_id": "df0f498e-5fee-3c33-8703-a9a42fdd0d22",
                                "text": "„Nach meiner Kopfrestauration konnte ich mich einfach nicht überwinden, die Beautys aus der Beautylounge um einen spontanen und wahrscheinlich utopisch teuren Termin mit einer Personal Shopperin zu bitten.“"
                            },
                            {
                                "example_id": "c075eb7a-8c15-45c0-88db-6579c50f0bf6",
                                "sense_id": "df0f498e-5fee-3c33-8703-a9a42fdd0d22",
                                "text": "„Aber warum wird im Biker-Magazin ein so deutscher Gegenstand wie der «Sitzrohrschnellspanner» als eine Beauty vorgestellt, und warum sind nicht nur korrekte Justages der Pedal Cleats wichtig, sondern auch leichte Wheels?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a213f2bb-c102-3dbc-bbb4-39237995410c",
                        "entry_id": "c11a55ad-440d-362b-a102-9f6f8fc05889",
                        "glosses": [
                            "das Marktsegment Kosmetik; Schönheit, schönes Aussehen, gepflegtes Äußeres"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7966402c-9940-4b65-ab0f-05b7e514c647",
                                "sense_id": "a213f2bb-c102-3dbc-bbb4-39237995410c",
                                "text": "„Daneben gibt es einen neuen Naturlook sowohl in der Mode als auch im Segment Beauty zu verzeichnen.“"
                            },
                            {
                                "example_id": "bbf91561-6979-4457-92d2-bef196c565bc",
                                "sense_id": "a213f2bb-c102-3dbc-bbb4-39237995410c",
                                "text": "„Beauty ist heute nur glaubwürdig, wenn sie ein außergewöhnliches Behandlungsprogramm bietet, das sich individuell zusammenstellen lässt.“"
                            },
                            {
                                "example_id": "db701def-7b1b-4557-a01d-84507e6d6cbb",
                                "sense_id": "a213f2bb-c102-3dbc-bbb4-39237995410c",
                                "text": "„Das Großartige an Fashion und Beauty ist heute, dass es kein Richtig oder Falsch gibt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
