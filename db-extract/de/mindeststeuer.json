                "senses": [
                    {
                        "sense_id": "8c0fbd0a-fa16-31d4-9dae-a11f2416546e",
                        "entry_id": "1ed84a3a-286c-3b6c-b177-08971e5a6dff",
                        "glosses": [
                            "Mindestbetrag/steuerliche Untergrenze an Einnahmen durch eine Steuer, die trotz Inanspruchnahme von gesetzlicher Steuervergünstigungen oder trotz Verrechnung von positiven und negativen Einkünften (\\\"Verlustvorträgen\\\") zu entrichten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52e31430-5eb8-4bfd-b5cb-4338a6c109cd",
                                "sense_id": "8c0fbd0a-fa16-31d4-9dae-a11f2416546e",
                                "text": "„Herzstück des Kompromisses, der als historisch gilt, ist eine Mindeststeuer für Großkonzerne in Höhe von mindestens 15 Prozent.“"
                            },
                            {
                                "example_id": "df881c01-faa5-4fc0-8094-fce83e0d9a3a",
                                "sense_id": "8c0fbd0a-fa16-31d4-9dae-a11f2416546e",
                                "text": "„Der Bundestag hat ein Gesetz zur Einführung einer globalen Mindeststeuer für international tätige Unternehmen beschlossen.“"
                            },
                            {
                                "example_id": "ed9f2586-21b1-4951-b4fc-d6d99e3e9652",
                                "sense_id": "8c0fbd0a-fa16-31d4-9dae-a11f2416546e",
                                "text": "„Die G7-Staaten haben sich darauf geeinigt, große US-Konzerne von der globalen Mindeststeuer auszunehmen.“"
                            },
                            {
                                "example_id": "24e5d8d0-96f8-4a87-a863-1053e2a6c2d4",
                                "sense_id": "8c0fbd0a-fa16-31d4-9dae-a11f2416546e",
                                "text": "„Auch für Pfeifentabak wurde eine Mindeststeuer eingeführt, um die EU-weite Mindeststeuer für alle Preislagen im Pfeifentabakbereich einzuhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
