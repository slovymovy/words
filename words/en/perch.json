{
    "word_family": [
        "percher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23963bef-0057-3159-ae39-7c72fe606310",
                    "sense_definition": "To rest on a branch or similar support, especially of a bird.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rest_elevated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The colorful parrot <w>perched</w> on the thick branch.",
                            "target_lang_translations": {
                                "zh": "那只色彩斑斓的鹦鹉<w>栖息</w>在粗壮的树枝上。"
                            }
                        },
                        {
                            "text": "A small bird <w>perched</w> on the garden fence to sing.",
                            "target_lang_translations": {
                                "zh": "一只小鸟<w>栖息</w>在花园篱笆上唱歌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "roost",
                        "sit"
                    ],
                    "common_phrases": [
                        "bird perches"
                    ],
                    "target_lang_definitions": {
                        "zh": "指鸟类等停在树枝或类似支撑物上。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "栖息",
                                "target_lang_sense_clarification": "指鸟类停在树枝或高处。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9efd738-4a73-325a-ab46-3aaa9d85f9ab",
                    "sense_definition": "To sit on the edge of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rest_elevated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>perched</w> on the edge of the chair to talk.",
                            "target_lang_translations": {
                                "zh": "那把椅子她只<w>坐在边缘</w>，就这样跟人聊了起来。"
                            }
                        },
                        {
                            "text": "The children <w>perched</w> on the wall to watch the parade.",
                            "target_lang_translations": {
                                "zh": "那道墙上，孩子们<w>坐在边缘</w>看游行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sit"
                    ],
                    "common_phrases": [
                        "perch on edge"
                    ],
                    "target_lang_definitions": {
                        "zh": "坐在某物的边缘。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "坐在边缘",
                                "target_lang_sense_clarification": "指人坐在椅子或墙壁的边缘。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38f19459-f8a8-3d0a-b2fc-2f0676793376",
                    "sense_definition": "To place something in an elevated or precarious position.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rest_elevated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>perched</w> his glasses on the tip of his nose.",
                            "target_lang_translations": {
                                "zh": "他把眼镜<w>架</w>在鼻尖上。"
                            }
                        },
                        {
                            "text": "The statue was <w>perched</w> high above the city square.",
                            "target_lang_translations": {
                                "zh": "那座雕像被<w>安置</w>在城市广场上方的高处。"
                            }
                        }
                    ],
                    "synonyms": [
                        "balance",
                        "position"
                    ],
                    "common_phrases": [
                        "perched high"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物放置在高处或不稳固的位置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放置",
                                "target_lang_sense_clarification": "指将物体小心地放在高处或边缘。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15a9fa3c-f340-3941-898d-930522d685e3",
                    "sense_definition": "A type of spiny-finned freshwater fish.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman caught a large <w>perch</w> in the lake.",
                            "target_lang_translations": {
                                "zh": "渔夫在湖里钓到了一条大<w>河鲈</w>。"
                            }
                        },
                        {
                            "text": "Fresh <w>perch</w> is a popular dish in this region.",
                            "target_lang_translations": {
                                "zh": "新鲜的<w>河鲈</w>是这个地区的一道名菜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "freshwater perch"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种棘鳍淡水鱼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "河鲈",
                                "target_lang_sense_clarification": "指鲈鱼类的一种。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9944231-216e-3a3c-9c22-64e25395149c",
                    "sense_definition": "A rod, branch, or ledge used as a resting place for a bird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rest_elevated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parrot sat quietly on its wooden <w>perch</w>.",
                            "target_lang_translations": {
                                "zh": "鹦鹉安静地待在它的木制<w>栖木</w>上。"
                            }
                        },
                        {
                            "text": "The bird flew down from its high <w>perch</w>.",
                            "target_lang_translations": {
                                "zh": "那只鸟从它高处的<w>栖木</w>上飞了下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "roost"
                    ],
                    "common_phrases": [
                        "bird perch"
                    ],
                    "target_lang_definitions": {
                        "zh": "供鸟类休息的杆子、树枝或架子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "栖木",
                                "target_lang_sense_clarification": "指鸟笼中或自然界中供鸟休息的横杆。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "addda15f-7c88-363c-8018-1ee977d93eae",
                    "sense_definition": "A secure, advantageous, or elevated position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rest_elevated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From his <w>perch</w> on the hill, he could see the whole valley.",
                            "target_lang_translations": {
                                "zh": "从他在山上的<w>高处</w>，他能俯瞰整个山谷。"
                            }
                        },
                        {
                            "text": "She maintained her <w>perch</w> as the company leader for years.",
                            "target_lang_translations": {
                                "zh": "她多年来一直保持着公司领导的<w>高位</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vantage-point"
                    ],
                    "common_phrases": [
                        "elevated perch"
                    ],
                    "target_lang_definitions": {
                        "zh": "一个安全、有利或高处的位置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "高处",
                                "target_lang_sense_clarification": "指视野开阔或占据优势的地点。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a8bbfc39-6372-3c56-a179-9136d5929b08",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named Mr. <w>Perch</w>.",
                            "target_lang_translations": {
                                "zh": "这本书的作者名叫<w>珀奇</w>先生。"
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Perch</w> at the conference.",
                            "target_lang_translations": {
                                "zh": "我在会议上遇到了一位名叫莎拉·<w>珀奇</w>的女士。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "珀奇",
                                "target_lang_sense_clarification": "用于人名的音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}