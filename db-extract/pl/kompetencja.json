                                            {
                                                "example_id": "d0b09f81-5d45-419a-b6ef-5aa5f701a825",
                                                "sense_id": "ac18b99f-2153-3dd4-82eb-8b0c268fe097",
                                                "text": "Will it be said that the fundamental principles of the Confederation were not within the purview of the convention, and ought not to have been varied?"
                                            },
                                            {
                                                "example_id": "e1c610a0-5a08-4df0-a077-1c3dd8d4a4d7",
                                                "sense_id": "ac18b99f-2153-3dd4-82eb-8b0c268fe097",
                                                "text": "Rhetorical relations have truth conditional effects that contribute to meaning but lie outside the purview of compositional semantics."
                                            },
                                            {
                                                "example_id": "56906522-bb3e-4def-9e84-5b7f5d226821",
                                                "sense_id": "ac18b99f-2153-3dd4-82eb-8b0c268fe097",
                                                "text": "Several air marshals have asked Congress to remove the program from T.S.A.’s purview and entrust it to a different agency, like Customs and Border Protection or the Federal Bureau of Investigation."
                                            },
                                            {
                                                "example_id": "83add003-237f-4c8d-b2fe-f6f13c595012",
                                                "sense_id": "ac18b99f-2153-3dd4-82eb-8b0c268fe097",
                                                "text": "It was 2015 when Jain—whose purview includes commissioning new series, acquiring the rights to foreign hits, and publicly answering for any perceived misdeeds of ITV—set out to overhaul the tepidly received Celebrity Love Island, a 12-person British popularity contest and ostensible matchmaker that disappeared after two seasons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d42c121f-f9ad-317f-9ff1-f32e70473e81",
                                        "entry_id": "6efe8ef8-057b-3b97-bae6-2fffb211a422",
                                        "glosses": [
                                            "Range of understanding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2442faab-8331-4091-8231-1397e1cbc718",
                                                "sense_id": "d42c121f-f9ad-317f-9ff1-f32e70473e81",
                                                "text": "Our company were noisy, gay, quarrelsome, full of facile theories, with glib explanations of everything, persuaded that there is nothing they could not understand and no human destiny outside the purview of their system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13f13b17-6f04-4b23-b6e9-3024a1ddb8a9",
                        "source_entry_id": "2920911a-c0b3-30b1-a76f-6706dc636549",
                        "source_sense_id": "15283dd3-3a76-35b6-9eee-604a1f7bb000",
                        "target_lang_word": "компетенция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "компетенция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "734788ba-e716-3045-844d-74d138357a85",
                                        "entry_id": "ca1b323b-6a01-3e61-869d-afabc12e94c4",
                                        "glosses": [
                                            "знания и опыт в определённой области; круг вопросов, в которых кто-либо хорошо осведомлён"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93c13124-29d1-4308-a33e-6c0dd2dfbb6d",
                                                "sense_id": "734788ba-e716-3045-844d-74d138357a85",
                                                "text": "Также в практике используются интервью по компетенциям."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c51acad-c467-3e7c-b245-e957dd00768d",
                                        "entry_id": "ca1b323b-6a01-3e61-869d-afabc12e94c4",
                                        "glosses": [
                                            "офиц. совокупность полномочий, прав и обязанностей какого-либо органа, должностного лица"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd2b75b2-fe5a-437c-bb55-bcff8a09b1c5",
                                                "sense_id": "7c51acad-c467-3e7c-b245-e957dd00768d",
                                                "text": "Исключительная компетенция арбитражных судов в Российской Федерации по делам с участием третьих лиц."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
