                ],
                "senses": [
                    {
                        "sense_id": "01ee2a66-7d12-379f-87f4-1981c0fb9207",
                        "entry_id": "82308c42-b6b3-32c0-928f-fdc0a10d1d79",
                        "glosses": [
                            "Action de recouvrir les poteries d’un enduit qui au feu doit se vitrifier."
                        ],
                        "tags": [
                            "Céramique"
                        ],
                        "examples": [
                            {
                                "example_id": "a9a04111-482b-482b-af5b-e1c3e0d22a57",
                                "sense_id": "01ee2a66-7d12-379f-87f4-1981c0fb9207",
                                "text": "Très tôt les Égyptiens surent fabriquer des verres. L’origine de ce matériau semble avoir été dans les glaçures recouvrant les poteries pour les rendre imperméables et les décorer."
                            }
                        ]
                    },
                    {
                        "sense_id": "52c4e19f-8fb9-3c25-9cfd-9274c7bb7272",
                        "entry_id": "82308c42-b6b3-32c0-928f-fdc0a10d1d79",
                        "glosses": [
                            "Enduit que le potier applique sur les céramiques avant la cuisson. Ce vernis les rend imperméables et leur donne de la brillance."
                        ],
                        "tags": [
                            "Céramique"
                        ],
                        "examples": [
                            {
                                "example_id": "ce53a75d-3c24-405a-b1a4-88213f916e94",
                                "sense_id": "52c4e19f-8fb9-3c25-9cfd-9274c7bb7272",
                                "text": "Une révolution s’opère avec la faïence : une terre couverte d’une glaçure à base d’étain, qui lui confère lumière et douceur, et permet des décors raffinés."
                            },
                            {
                                "example_id": "e636e8b8-bf3d-4972-9378-02c01f436f01",
                                "sense_id": "52c4e19f-8fb9-3c25-9cfd-9274c7bb7272",
                                "text": "Le vert est à la mode au début du XVIᵉ siècle : jattes, écuelles et cruches sont très souvent recouvertes d’une glaçure verte brillante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfc8580a-7fd9-4d0c-9b1a-31dc479133a8",
                        "source_entry_id": "82308c42-b6b3-32c0-928f-fdc0a10d1d79",
