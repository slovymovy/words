        "nl-extract.jsonl": [
            {
                "entry_id": "4a6b1b17-1356-3463-b129-1b2927e03d47",
                "word": "opnoemen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d2802a2-bab4-35d0-8013-f8e09d3ffcaa",
                        "entry_id": "4a6b1b17-1356-3463-b129-1b2927e03d47",
                        "glosses": [
                            "één voor één vermelden van de namen van personen of zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72182ae6-57ce-4bbc-ae6b-febd60f41d18",
                                "sense_id": "7d2802a2-bab4-35d0-8013-f8e09d3ffcaa",
                                "text": "Tijdens mijn studie moest ik de namen van alle hersenzenuwen kunnen opnoemen."
                            },
                            {
                                "example_id": "b3d32d7c-bb12-473d-9823-48505d232326",
                                "sense_id": "7d2802a2-bab4-35d0-8013-f8e09d3ffcaa",
                                "text": "Dokter Nikkels ziet de dispensatieregeling als een zegen. Hij wil als arts niet belemmerd worden in zijn werkzaamheden. „Als behandelaar wil ik de vrijheid hebben een sporter voor te schrijven wat nodig is, daar heeft een theoreticus of welk WADA-type dan ook geen moer mee te maken. Daar zal ik altijd knetterhard voor gaan liggen. Ik moet een sporter gewoon kunnen behandelen voor eczeem of astma. Daarom vind ik ook dat in de commissie die dispensatieverzoeken behandelt clinici moeten zitten. Of ik ook epo zou voorschrijven? In theorie wel, al kan ik geen met topsport verenigbare ziekte opnoemen die epo zou rechtvaardigen.”"
                            }
                        ]
                    }
                ],
