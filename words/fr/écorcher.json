{
    "word_family": [
        "écorchure",
        "écorcheur",
        "écorchoir",
        "écorchement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6dcdfae9-8a39-35b4-9fbb-e3a7ab3d7d4d",
                    "sense_definition": "Déchirer ou enlever superficiellement la peau en heurtant ou en frottant une surface rugueuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "blessure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En tombant sur le gravier, le petit garçon s'<w>écorche</w> le genou."
                        },
                        {
                            "text": "Fais attention aux ronces dans la forêt, elles vont t'<w>écorcher</w> les bras."
                        }
                    ],
                    "common_phrases": [
                        "s'écorcher le genou",
                        "s'écorcher la jambe"
                    ]
                },
                {
                    "sense_id": "0beac259-69e5-32e0-a881-b0f23c3d7e95",
                    "sense_definition": "Prononcer mal un mot ou parler de manière très fautive une langue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "langue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le présentateur débutant <w>écorche</w> souvent le nom de ses invités étrangers."
                        },
                        {
                            "text": "Il essaie de parler espagnol mais il <w>écorche</w> la plupart des phrases simples."
                        }
                    ],
                    "common_phrases": [
                        "écorcher un nom",
                        "écorcher une langue"
                    ]
                },
                {
                    "sense_id": "1e085d85-d4ad-3b2c-b061-a50ebc24bab0",
                    "sense_definition": "Être très désagréable ou insupportable à entendre, en parlant d'un son, d'une voix ou d'une note fausse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette fausse note au violon vient d'<w>écorcher</w> les oreilles du public attentif."
                        },
                        {
                            "text": "Sa façon de chanter faux nous <w>écorche</w> les oreilles depuis le début du spectacle."
                        }
                    ],
                    "common_phrases": [
                        "écorcher les oreilles"
                    ]
                },
                {
                    "sense_id": "b1572776-a0fd-31e8-99d6-6b8938ae74f9",
                    "sense_definition": "Dépouiller entièrement un animal mort de sa peau.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "blessure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boucher expérimenté <w>écorche</w> le lapin avant de découper la viande."
                        },
                        {
                            "text": "Les chasseurs ont appris comment <w>écorcher</w> le gibier dans les règles de l'art."
                        }
                    ],
                    "common_phrases": [
                        "écorcher un lapin",
                        "écorcher un animal"
                    ]
                },
                {
                    "sense_id": "56ce14aa-f1f3-3c94-b2dd-ded9bc20f8ae",
                    "sense_definition": "Faire payer à un client un prix excessif ou injuste.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette boutique de luxe pour touristes, les commerçants <w>écorchent</w> leurs clients."
                        },
                        {
                            "text": "Nous avons refusé de payer cette facture car le garagiste cherchait à nous <w>écorcher</w>."
                        }
                    ],
                    "common_phrases": [
                        "se faire écorcher"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "e95abf40-09f4-3af4-ac9c-a1f6ef0bb96a",
                    "sense_definition": "Irriter la gorge ou le palais par une forte sensation d'âpreté, en parlant d'un aliment ou d'une boisson.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vin très jeune et trop acide <w>écorche</w> la gorge à chaque gorgée."
                        },
                        {
                            "text": "Le pain trop dur et sec lui <w>écorchait</w> le palais dès la première bouchée."
                        }
                    ],
                    "common_phrases": [
                        "écorcher la gorge",
                        "écorcher le palais"
                    ]
                },
                {
                    "sense_id": "c3bb7da4-66bc-33c6-9d94-9181b54fc5b0",
                    "sense_definition": "Supplicier un condamné en lui arrachant la peau.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "blessure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chroniques historiques racontent que ce tyran faisait <w>écorcher</w> vifs ses pires ennemis."
                        },
                        {
                            "text": "Le bourreau menaçait d'<w>écorcher</w> le captif s'il refusait de révéler son secret."
                        }
                    ],
                    "common_phrases": [
                        "écorcher vif"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "supplice ancien"
                        }
                    ]
                },
                {
                    "sense_id": "580d7e6b-f2c5-3ef0-a2bf-9d71c6d123f7",
                    "sense_definition": "Critiquer vivement quelqu'un ou attaquer durement sa réputation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éditorialiste n'a pas hésité à <w>écorcher</w> le ministre dans sa dernière tribune politique."
                        },
                        {
                            "text": "Lors de cette réunion houleuse, le responsable a été sérieusement <w>écorché</w> par ses collègues."
                        }
                    ]
                }
            ]
        }
    ]
}