                        ],
                        "examples": [
                            {
                                "example_id": "89318e1d-75d8-4b93-ae7f-14395fe62a98",
                                "sense_id": "8a05fc4f-2c1d-3b3d-bbd2-e89297dcea34",
                                "text": "„Manche Forscher halten REM-Phasen für nichts weiter als Aufwachversuche des Gehirns und Träume für sinnloses Geflimmer. Andere betrachten Träume als überlebenswichtig, sie glauben, dass wir im Traum unser genetisch programmiertes Trieb- und Instinktverhalten in einer selbst erzeugten virtuellen Welt erproben. Dafür spricht, dass Menschen im Embryonalstadium am meisten träumen, später immer weniger.“"
                            }
                        ],
