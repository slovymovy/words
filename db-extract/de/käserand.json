                "senses": [
                    {
                        "sense_id": "41d724d9-a65e-3bfc-832c-c768f8a0e5df",
                        "entry_id": "6e53559d-31f1-3d65-9030-14e46578a3f1",
                        "glosses": [
                            "mit einem festen Milchprodukt gefüllte äußere Begrenzung einer Pizza"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "233c6aee-feff-4dce-ac7e-10e59a794502",
                                "sense_id": "41d724d9-a65e-3bfc-832c-c768f8a0e5df",
                                "text": "Wir zeigen Ihnen, wie Sie Salami mit Käserand lecker zubereiten."
                            },
                            {
                                "example_id": "68d22092-c791-4f70-8862-edc9a237fcbb",
                                "sense_id": "41d724d9-a65e-3bfc-832c-c768f8a0e5df",
                                "text": "Und diese Pizza mit Käserand – Lauren wird uns zeigen, wie’s gemacht wird – wird sie umhauen."
                            },
                            {
                                "example_id": "0a16387d-0564-484e-a2a8-9ae5500f77cf",
                                "sense_id": "41d724d9-a65e-3bfc-832c-c768f8a0e5df",
                                "text": "Geben Sie die Pizza nun bei 230° ca. 20 Minuten in den Ofen und schon haben Sie eine leckere Pizza mit Käserand."
                            },
                            {
                                "example_id": "64cfae9b-dd7d-4b15-91e3-68f3f2a4c905",
                                "sense_id": "41d724d9-a65e-3bfc-832c-c768f8a0e5df",
                                "text": "Ab sofort kann man jede Pizza bei uns mit Würstchen oder Käserand bestellen."
                            },
                            {
                                "example_id": "f2638e4d-11cf-434b-a938-347d6bf64df0",
                                "sense_id": "41d724d9-a65e-3bfc-832c-c768f8a0e5df",
                                "text": "Den Teig sollte man auf eine möglichst große Fläche ziehen, denn der Käserand kostet später auf jeder Seite ein paar Zentimeter."
                            }
                        ],
                        "sense_index_json": "\"1\""
