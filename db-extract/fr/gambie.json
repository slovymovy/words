                                "target_senses": [
                                    {
                                        "sense_id": "7f426520-d9a0-35c0-85a7-56981e5bf876",
                                        "entry_id": "d06f1493-3951-3bc2-a3ec-9d6e40649c13",
                                        "glosses": [
                                            "Land in Westafrika"
