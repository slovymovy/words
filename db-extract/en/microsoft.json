                        "entry_id": "a6ac2d39-b068-30ae-a1fd-5586072fa4cf",
                        "glosses": [
                            "To Microsoftify."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b14c6800-6c83-361c-9631-2f1c14fdd905",
                        "entry_id": "a6ac2d39-b068-30ae-a1fd-5586072fa4cf",
                        "glosses": [
                            "To render more like Microsoft with regards to business practices and tactics."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "91e853cc-16bf-4af2-9f60-456a7ba769e3",
                                "sense_id": "b14c6800-6c83-361c-9631-2f1c14fdd905",
                                "text": "You could call it the Microsofting of the wine industry. Of course, wine is unlikely to be dominated by one producer or one distributor."
                            }
                        ]
                    }
