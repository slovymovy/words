                                "example_id": "03210ec1-fd4e-4c78-96df-c7b1b27e49be",
                                "sense_id": "a27a074f-2784-38ab-a9ff-06962c328952",
                                "text": "2005, Monique van der Zanden, \"De kleine akkerwinde\", Het pad van de regenboog, Christofoor (publ.), page 20.\nEn op een ochtend werd de akkerwinde door de zon wakker gekust en ze bloeide met wel honderd tere roze kelken, de een nog mooier dan de ander.",
                                "translation": "And one morning the field bindweed was woken with a kiss by the sun and she bloomed with a hundred delicate pink calyces, the one being even more beautiful than the other.",
                                "english": "And one morning the field bindweed was woken with a kiss by the sun and she bloomed with a hundred delicate pink calyces, the one being even more beautiful than the other."
                            },
                            {
                                "example_id": "c67603b1-b184-46ab-879d-a926c10fe5b2",
                                "sense_id": "a27a074f-2784-38ab-a9ff-06962c328952",
                                "text": "2012, Glenn Cooper, De tiende kamer, tr. by Riek Borgers, original title The Tenth Chamber, A. W. Bruna Uitgevers (publ.).\n‘[…] De bessen en de akkerwinde zijn nooit een probleem. […]’",
                                "translation": "' […] The berries and the field bindweed never pose a problem [with storage].'",
                                "english": "' […] The berries and the field bindweed never pose a problem [with storage].'"
                            }
                        ]
                    }
