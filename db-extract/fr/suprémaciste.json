                "senses": [
                    {
                        "sense_id": "bd531a90-e4ac-33ac-a779-89fc7556c3a3",
                        "entry_id": "7cf2d820-30e5-3d47-99ea-4ea6398bf35a",
                        "glosses": [
                            "Relatif au suprémacisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad0ceea-db3d-4975-a4b9-2539bc65cf94",
                                "sense_id": "bd531a90-e4ac-33ac-a779-89fc7556c3a3",
                                "text": "La cohésion de ces milices est cependant autant assurée par l’idéologie suprémaciste arabe que par l’appât d’un gain facile et la promesse de pillages."
                            },
                            {
                                "example_id": "9216c498-4f73-4caa-b3fa-59874a369214",
                                "sense_id": "bd531a90-e4ac-33ac-a779-89fc7556c3a3",
                                "text": "L’Aryan Brotherhood (AB) (en français : Fraternité aryenne) est un groupe suprémaciste raciste fondé en Californie en 1967, dans la prison d’État de San Quentin. après la fin de la ségrégation dans les lieux de détention, […]."
                            },
                            {
                                "example_id": "b2efc3b7-3b8c-435a-a520-72133712237e",
                                "sense_id": "bd531a90-e4ac-33ac-a779-89fc7556c3a3",
                                "text": "Jamais un premier ministre ne refuserait de condamner des suprémacistes blancs ou encouragerait des théories du complot."
                            },
                            {
                                "example_id": "ca70a30a-2990-490f-9be7-81e6e33100ed",
                                "sense_id": "bd531a90-e4ac-33ac-a779-89fc7556c3a3",
                                "text": "Racisme, islamophobie et antisémitisme imprègnent la logorrhée suprémaciste de Payton Gendron, qui se pose comme un militant « anti-remplaciste » : « C’est un remplacement ethnique. C’est un remplacement culturel. C’est un remplacement racial. C’est le génocide blanc »."
                            }
                        ]
                    }
                ],
