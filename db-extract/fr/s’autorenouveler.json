                ],
                "senses": [
                    {
                        "sense_id": "086d8ee5-c45b-33d9-9181-b66d72396eec",
                        "entry_id": "933f547b-c215-3437-a4d9-4a50c34398cd",
                        "glosses": [
                            "Se renouveler par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3003e48b-efd0-47f0-9c2a-83a0a39df0de",
                                "sense_id": "086d8ee5-c45b-33d9-9181-b66d72396eec",
                                "text": "Un écosystème en bonne santé est capable de s'autorenouveler."
                            },
                            {
                                "example_id": "8c6cbc38-2976-4319-9102-ba6f748ca645",
                                "sense_id": "086d8ee5-c45b-33d9-9181-b66d72396eec",
                                "text": "Elles se caractérisent par leur capacité, d'une part à s'autorenouveler, c'est à dire à reproduire des CS identiques à elles-même, et d'autre part à se différencier en un ou plusieurs types cellulaires spécialisés."
                            },
                            {
                                "example_id": "189c9a25-34c8-439d-a45a-0a1e98cd75d9",
                                "sense_id": "086d8ee5-c45b-33d9-9181-b66d72396eec",
                                "text": "Prenant le contrepied des théories de la survivance, Bensa montre la vivacité et l'adaptabilité de ces cultes, leur capacité intacte d'autorenouveler leur sens et leur logique, et de dire symboliquement ce qui se dit ailleurs dans le langage de la technique."
                            }
                        ]
                    }
