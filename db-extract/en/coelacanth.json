                "word": "coelacanth",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "95bf98e2-290b-48e3-94f2-868b5f7ada12",
                        "entry_id": "ea9aed15-ba4d-3cad-a79c-066d938cb924",
                        "tags": [
                            "plural"
                        ],
