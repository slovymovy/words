                {
                    "sense_id": "31289432-888a-3ad4-8e20-c9d72eaf6c4e",
                    "sense_definition": "Dans la théorie des graphes, sommet directement relié à un autre par une arête ou un arc.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'algorithme parcourt d'abord chaque <w>voisin</w> du sommet sélectionné.",
                            "target_lang_translations": {
                                "en": "The algorithm first visits each <w>neighbour</w> of the selected vertex.",
                                "ru": "Алгоритм сначала обходит каждую <w>смежную вершину</w> выбранной вершины.",
                                "nl": "Het algoritme doorloopt eerst elke <w>aangrenzende knoop</w> van de geselecteerde knoop.",
                                "de": "Der Algorithmus durchläuft zuerst jeden <w>Nachbarknoten</w> des gewählten Knotens.",
                                "pl": "Algorytm najpierw przegląda każdy <w>sąsiedni wierzchołek</w> wybranego wierzchołka.",
                                "it": "L'algoritmo percorre per primo ogni <w>vertice adiacente</w> del vertice selezionato.",
                                "cs": "Algoritmus nejprve projde každého <w>souseda</w> vybraného vrcholu.",
                                "es": "El algoritmo recorre primero cada <w>vértice adyacente</w> del vértice seleccionado.",
                                "zh": "算法首先遍历所选顶点的每个<w>相邻顶点</w>。",
                                "tr": "Algoritma önce seçilen köşenin her bir <w>komşu köşesini</w> ziyaret eder."
                            }
                        },
                        {
                            "text": "Dans ce graphe, le sommet central possède six <w>voisins</w> reliés directement à lui.",
                            "target_lang_translations": {
                                "en": "In this graph, the central vertex has six <w>neighbours</w> directly connected to it.",
                                "ru": "В этом графе центральная вершина имеет шесть <w>смежных вершин</w>, непосредственно соединённых с ней.",
                                "nl": "In deze graaf heeft de centrale knoop zes <w>aangrenzende knopen</w> die er rechtstreeks mee verbonden zijn.",
                                "de": "In diesem Graphen hat der zentrale Knoten sechs <w>Nachbarknoten</w>, die direkt mit ihm verbunden sind.",
                                "pl": "W tym grafie centralny wierzchołek ma sześciu <w>sąsiadów</w> połączonych z nim bezpośrednio.",
                                "it": "In questo grafo, il vertice centrale ha sei <w>vertici adiacenti</w> collegati direttamente a lui.",
                                "cs": "V tomto grafu má centrální vrchol šest <w>sousedů</w> přímo spojených s ním.",
                                "es": "En este grafo, el vértice central tiene seis <w>vértices adyacentes</w> conectados directamente a él.",
                                "zh": "在这个图中，中心顶点有六个<w>相邻顶点</w>与它直接相连。",
                                "tr": "Bu grafta merkez köşenin doğrudan kendisine bağlı altı <w>komşu köşesi</w> var."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In graph theory, a vertex directly connected to another by an edge or arc.",
                        "ru": "В теории графов — вершина, которая напрямую соединена с другой вершиной ребром или дугой.",
                        "nl": "In de grafentheorie: een knoop die rechtstreeks met een andere knoop is verbonden via een tak of boog.",
                        "de": "Knoten, der über eine Kante oder einen Bogen direkt mit einem anderen Knoten verbunden ist.",
                        "pl": "Wierzchołek grafu bezpośrednio połączony z innym wierzchołkiem krawędzią lub łukiem.",
                        "it": "In teoria dei grafi, vertice collegato direttamente a un altro tramite un lato o un arco.",
                        "cs": "V teorii grafů vrchol přímo spojený hranou nebo obloukem s jiným vrcholem.",
                        "es": "En teoría de grafos, vértice unido directamente a otro por una arista o un arco.",
                        "zh": "图论中，与某个顶点通过一条边或弧直接相连的顶点。",
                        "tr": "Graf teorisinde, bir kenar veya yay ile başka bir köşeye doğrudan bağlı olan köşe."
                    },
