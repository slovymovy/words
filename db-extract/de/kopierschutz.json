                "senses": [
                    {
                        "sense_id": "951502e2-5366-3449-b3ad-3eb97cd3ad40",
                        "entry_id": "e24c7690-9021-3ebe-9c42-aafce66f114f",
                        "glosses": [
                            "Maßnahme, die Daten davor schützen sollen, von Unbefugten vervielfältigt zu werden"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "4451b56f-9e7a-4f81-b706-0726ca580ca8",
                                "sense_id": "951502e2-5366-3449-b3ad-3eb97cd3ad40",
                                "text": "Immer mehr Musik-CDs werden vom Hersteller mit einem Kopierschutz versehen."
                            },
                            {
                                "example_id": "313c5d43-ca7c-449d-912e-382b6450e645",
                                "sense_id": "951502e2-5366-3449-b3ad-3eb97cd3ad40",
                                "text": "„Bei der Windows-PC-Version von \"Battlefield Hardline\" kommt neben dem Kopierschutz durch die Bindung an ein Origin-Konto auch Hardware-Überwachung zum Einsatz.“"
                            },
                            {
                                "example_id": "34098fa7-9a30-488a-a3af-db354031fe31",
                                "sense_id": "951502e2-5366-3449-b3ad-3eb97cd3ad40",
                                "text": "„Mozilla ist der letzte größere Browser-Hersteller, der den neuartigen Kopierschutz \"Encrypted Media Extensions\" (EME) einbaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
