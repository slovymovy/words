            "senses": [
                {
                    "sense_id": "088f1b7f-e448-3f62-8368-1b81b2165a86",
                    "sense_definition": "Causing great pain or mental anguish",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "painful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered <w>excruciating</w> pain after the surgery.",
                            "target_lang_translations": {
                                "nl": "De patiënt leed <w>ondraaglijke</w> pijn na de operatie."
                            }
                        },
                        {
                            "text": "She faced an <w>excruciating</w> decision about her future career.",
                            "target_lang_translations": {
                                "nl": "Ze stond voor een <w>martelende</w> beslissing over haar toekomstige carrière."
                            }
                        }
                    ],
                    "synonyms": [
                        "poignant"
                    ],
                    "common_phrases": [
                        "excruciating pain",
                        "excruciating dilemma"
                    ],
                    "target_lang_definitions": {
                        "nl": "Veroorzaakt grote pijn of geestelijke kwelling"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ondraaglijk",
                                "target_lang_sense_clarification": "niet te verdragen of uit te houden"
                            },
                            {
                                "target_lang_word": "martelend",
                                "target_lang_sense_clarification": "zeer pijnlijk of kwelend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95923b46-49e7-378a-ac71-6340787e8854",
                    "sense_definition": "Exceedingly intense or extreme",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The silence in the room was <w>excruciating</w> for everyone present.",
                            "target_lang_translations": {
                                "nl": "De stilte in de kamer was <w>ondraaglijk</w> voor iedereen die aanwezig was."
                            }
                        },
                        {
                            "text": "He described the event in <w>excruciating</w> detail to the police.",
                            "target_lang_translations": {
                                "nl": "Hij beschreef de gebeurtenis in <w>extreem</w> detail aan de politie."
                            }
                        }
                    ],
                    "synonyms": [
                        "lacerating"
                    ],
                    "common_phrases": [
