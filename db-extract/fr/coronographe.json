                    }
                ],
                "senses": [
                    {
                        "sense_id": "a35f8489-8d4f-374c-a48f-e47a873272ff",
                        "entry_id": "ebfd91c1-a34f-3df2-9c6a-10e6975fcde7",
                        "glosses": [
                            "Instrument optique permettant de simuler des éclipses de Soleil et ainsi d’observer la couronne solaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "923c188b-1777-4c0b-8262-7e0ffae35bc3",
                                "sense_id": "a35f8489-8d4f-374c-a48f-e47a873272ff",
                                "text": "Le coronographe a été inventé en 1930 par le français Bernard Lyot."
                            },
                            {
                                "example_id": "4f8dacd1-b0c9-4f6d-bfcb-e21899099a61",
                                "sense_id": "a35f8489-8d4f-374c-a48f-e47a873272ff",
                                "text": "La pièce maitresse du coronographe est une pièce conique réfléchissante."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6bd461f-a29e-3d8c-9730-d281900fd912",
                        "entry_id": "ebfd91c1-a34f-3df2-9c6a-10e6975fcde7",
                        "glosses": [
                            "Instrument optique permettant de voir ou de photographier la couronne solaire lors d’une éclipse solaire totale."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "957ac4e2-5ffa-4880-a821-91fc3d82a961",
                                "sense_id": "b6bd461f-a29e-3d8c-9730-d281900fd912",
                                "text": "Pour la photographie, il possède : un équatorial spécial, muni d’un objectif de 0m,32 de diamètre et de 3m,46 de distance focale, construit par Steinheil, de Monaco ; un télescope à réflexion, dit coronographe, du système Huggins ;"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "830b630f-f21a-435b-a692-b18badc86c04",
                        "source_entry_id": "ebfd91c1-a34f-3df2-9c6a-10e6975fcde7",
                        "target_lang_word": "Koronograph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koronograph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "838fc73e-de34-37d9-a47c-0e5c59647f4f",
                                        "entry_id": "1c955408-0975-3f34-84a6-639c0f36471e",
                                        "glosses": [
                                            "um 1930 vom französischen Astronomen Bernard Ferdinand Lyot entwickeltes Instrument zur Beobachtung der Sonnenatmosphäre, insbesondere der inneren Korona; es besteht aus Teleskop und speziellen Einrichtungen zum Abdämpfen des Sonnenlichts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393fe13d-ac58-4c6c-aee9-8055b27db7ae",
                                                "sense_id": "838fc73e-de34-37d9-a47c-0e5c59647f4f",
                                                "text": "„Zwischen 1987 und 1989 wurden mit dem Koronographen zehn sonnenstreifende Kometen entdeckt.“"
                                            },
                                            {
                                                "example_id": "939fa775-80f6-40d1-bf7c-e13b5d9e6f10",
                                                "sense_id": "838fc73e-de34-37d9-a47c-0e5c59647f4f",
                                                "text": "„In den sechziger Jahren wurde das Observatorium um einen Koronographen erweitert; mit diesem Gerät konnte nun auch die Sonnenatmosphäre erforscht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf8539e6-8d4d-485e-9252-eedf8db2580e",
                        "source_entry_id": "ebfd91c1-a34f-3df2-9c6a-10e6975fcde7",
