                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schornsteinfeger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "936ba48b-f036-336b-9d82-a214d1251f7c",
                                        "entry_id": "3d6798a3-7234-3a61-9c29-8a035cdbdb9c",
                                        "glosses": [
                                            "Mitglied eines Berufsstandes, der die Schornsteine reinigt, um Schornsteinbrände zu verhindern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59c85fd-57b1-4da6-83f6-b697df027ec0",
                                                "sense_id": "936ba48b-f036-336b-9d82-a214d1251f7c",
                                                "text": "Die Arbeitsgeräte des Schornsteinfegers sind: Kehrgerät, Schultereisen, Rußsack, Stoßbesen, Handbesen und Sonne mit Kugelschlagapparat."
                                            },
                                            {
                                                "example_id": "9fb42653-530c-4b8f-b0f3-5f4f2200539c",
                                                "sense_id": "936ba48b-f036-336b-9d82-a214d1251f7c",
                                                "text": "„Ich hatte wieder darauf hingewiesen, daß ein Schornsteinfeger schlecht dazu geeignet sei, Fachunterricht in der Oberschule zu kontrollieren.“"
                                            },
                                            {
                                                "example_id": "678e9756-734f-41dc-b6e2-cd34a18f1fde",
                                                "sense_id": "936ba48b-f036-336b-9d82-a214d1251f7c",
                                                "text": "Der Beruf des Schornsteinfegers galt bis ins 17. Jahrhundert als verfemt und nicht ehrenhaft."
                                            },
                                            {
                                                "example_id": "2b4d336e-50a3-44c3-a86e-1b6136339690",
                                                "sense_id": "936ba48b-f036-336b-9d82-a214d1251f7c",
                                                "text": "Du hast heute einen Schornsteinfeger gesehen? Das bringt Glück!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9d41849c-f94d-3c31-ab0b-d98a75498973",
                                        "entry_id": "3d6798a3-7234-3a61-9c29-8a035cdbdb9c",
                                        "glosses": [
                                            "brauner Schmetterling aus der Unterfamilie der Augenfalter"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fecc3adf-a435-4ee3-acb4-fce6dfedc838",
                                                "sense_id": "9d41849c-f94d-3c31-ab0b-d98a75498973",
                                                "text": "Die Raupe des Schornsteinfegers frisst an verschiedensten Gräsern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "991330ce-1f10-4501-87b7-1cf12868cb3f",
                        "source_entry_id": "f70a5a97-0d17-3f6d-814f-e4038803e66d",
                        "source_sense_id": "54a69b04-041f-3b0d-82ee-0b52cf6923d7",
                        "target_lang_word": "трубочист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "трубочист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c959c0c8-0086-3dc8-ab33-6c411ec43352",
                                        "entry_id": "d391c95c-cc5c-3864-a39c-4b5f11453644",
                                        "glosses": [
                                            "тот, кто занимается чисткой печных труб и дымоходов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cabfac6-8ec1-4fc6-8e75-89b75478c887",
                                                "sense_id": "c959c0c8-0086-3dc8-ab33-6c411ec43352",
                                                "text": "Дорогою задел его [Акакия Акакиевича] всем нечистым своим боком трубочист и вычернил всё плечо ему .."
                                            },
                                            {
                                                "example_id": "b1f7650c-6dc8-480b-8b9d-9625988afb1e",
                                                "sense_id": "c959c0c8-0086-3dc8-ab33-6c411ec43352",
                                                "text": "У меня есть большой приятель — трубочист Яша. ❬…❭ И весёлый такой трубочист — всё песни поёт. Чистит трубы, а сам напевает."
                                            },
                                            {
                                                "example_id": "5116efa6-da47-43e7-8788-7531723489c7",
                                                "sense_id": "c959c0c8-0086-3dc8-ab33-6c411ec43352",
                                                "text": "Я залез на крышу и, как опытный трубочист, специальной метёлкой на верёвке прочищал трубы от сажи, а Муся собирала её в дымоходах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
