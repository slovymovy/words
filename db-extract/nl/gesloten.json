            },
            {
                "entry_id": "dbfa270b-5380-32d9-ba0a-ffb34fea9484",
                "word": "gesloten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "303a833b-ec2d-3877-b751-a84b86265b53",
                        "entry_id": "dbfa270b-5380-32d9-ba0a-ffb34fea9484",
                        "glosses": [
                            "voltooid deelwoord van sluiten"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "9dabf8db-5984-44d6-833a-53b46bc2f49c",
                                "sense_id": "303a833b-ec2d-3877-b751-a84b86265b53",
                                "text": "De belangstelling voor bloemen en planten die overblijven als de Floriade in Almere binnenkort sluit, is zo groot dat de inschrijving daarvoor per direct is gesloten."
                            },
                            {
                                "example_id": "1c7635f4-314d-4e0a-b67f-0cf9d57bf29c",
                                "sense_id": "303a833b-ec2d-3877-b751-a84b86265b53",
                                "text": "Oogjes gesloten, armpjes omhoog, volledige overgave."
                            },
                            {
                                "example_id": "2dd7e3c5-7012-4034-a100-9cb4e55e9513",
                                "sense_id": "303a833b-ec2d-3877-b751-a84b86265b53",
                                "text": "Ik vermoed dat deze Harris geen kinderen heeft, met zijn pleidooi voor urenlang doelloos rondslenteren op straat, zijn advies om 's ochtends wanneer je wakker wordt eerst nog een halfuur met gesloten ogen te blijven liggen in plaats van meteen in actie te komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63e63feb-c018-4629-8a74-a80fbc314bdc",
                        "source_entry_id": "dbfa270b-5380-32d9-ba0a-ffb34fea9484",
