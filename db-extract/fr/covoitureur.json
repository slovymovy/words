                "senses": [
                    {
                        "sense_id": "2f3d9047-c604-33e1-be3d-0da3ac58c1d7",
                        "entry_id": "f927422b-a170-3d2f-b1e5-70cc213e6a55",
                        "glosses": [
                            "Automobiliste faisant habituellement un trajet en voiture avec un ou plusieurs passagers ou passager en covoiturage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d504236-88ec-48b2-8ce3-41f18bfe7878",
                                "sense_id": "2f3d9047-c604-33e1-be3d-0da3ac58c1d7",
                                "text": "Des citoyens lancent Mobicoop, une alternative au quasi-monopole de BlaBlaCar : une plateforme coopérative mettant gratuitement en relation les covoitureurs. Les prix sont fixés par les conducteurs, le site ne prélève aucune commission sur les trajets."
                            },
                            {
                                "example_id": "62004c29-a467-4dc6-bd3e-bc28e8b9c71f",
                                "sense_id": "2f3d9047-c604-33e1-be3d-0da3ac58c1d7",
                                "text": "Dans ce cas, les covoitureurs s’en remettent à un intermédiaire pouvant prendre la forme d’une association, d’un PDE voire d’une entreprise dédiée à la mise en relation de covoitureurs."
                            },
                            {
                                "example_id": "4bfa7dd0-78df-478e-adab-16f28b7dbe88",
                                "sense_id": "2f3d9047-c604-33e1-be3d-0da3ac58c1d7",
                                "text": "De plus, l’exécutif veut encourager le covoiturage, notamment pour un « bonus », au montant non annoncé, pour tout nouveau covoitureur inscrit sur une plateforme, à partir du 1ᵉʳ janvier 2023."
                            }
                        ]
                    }
