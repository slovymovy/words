                    {
                        "translation_id": "c644890c-8923-4c95-a6de-979c2ad8cec5",
                        "source_entry_id": "30120aa4-82c4-3d7a-a425-7889b9bee605",
                        "source_sense_description": "pitch",
                        "target_lang_word": "soprano",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soprano",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a414dd9-3db7-3d94-ae87-1a182757ba79",
                                        "entry_id": "eac416b4-ce4d-35a0-9c56-0f7405f86ed1",
                                        "glosses": [
                                            "Voix du registre le plus élevé, qu’on appelait autrefois dessus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9fc3a8-27f9-4193-8b40-a980538ddb4a",
                                                "sense_id": "2a414dd9-3db7-3d94-ae87-1a182757ba79",
                                                "text": "Mais surtout la Voix me confia le secret de développer les sons de poitrine dans une voix de soprano."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "869582af-ee41-359b-8b9f-a13fca6cbcc0",
                                        "entry_id": "eac416b4-ce4d-35a0-9c56-0f7405f86ed1",
                                        "glosses": [
                                            "Chanteuse qui possède ce registre de voix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5facbada-3502-4725-ac80-f59be895ec65",
                                                "sense_id": "869582af-ee41-359b-8b9f-a13fca6cbcc0",
                                                "text": "En partenariat avec l’association Son ar Mein de Guimaëc, l’Association pour la sauvegarde de l’ancienne église du XVIᵉ siècle de Henvic a invité, mercredi, Victorien Disse et Étienne Galletier, musiciens aux théorbes et guitares baroques, accompagnés de Caroline Arnaud, soprano."
                                            },
                                            {
                                                "example_id": "5854d7e8-72bc-47c4-93dd-d7b08b455b14",
                                                "sense_id": "869582af-ee41-359b-8b9f-a13fca6cbcc0",
                                                "text": "En l’espace de quelques années, il fit évacuer tous les falsettistes restants pour les remplacer par des castrats sopranos, les parties d’alto demeurant encore assez longtemps confiées à des faussets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b76112ab-e8a7-3eaf-adea-0040d286a640",
                                        "entry_id": "eac416b4-ce4d-35a0-9c56-0f7405f86ed1",
                                        "glosses": [
                                            "Au sein d’une famille d’instruments de musique, instrument dont l’ambitus se situe au-delà de celui de l’alto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "392a39f1-91e0-4bcc-946e-a95c33783e18",
                                                "sense_id": "b76112ab-e8a7-3eaf-adea-0040d286a640",
                                                "text": "Sidney Bechet jouait de la clarinette et du soprano."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
