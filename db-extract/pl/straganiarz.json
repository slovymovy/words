                        ]
                    },
                    {
                        "translation_id": "f767f306-5f93-4b19-a893-ed8c959f9403",
                        "source_entry_id": "61ec4338-245c-3d65-8bb1-f0544476ef95",
                        "source_sense_id": "2b1cde68-22e7-3bf1-9089-7188c200f012",
                        "target_lang_word": "fruitmonger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fruitmonger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b904e110-abe9-3ed9-a0c7-670631399ee9",
                                        "entry_id": "39390add-d5ec-3579-a90d-5bbce4575bff",
                                        "glosses": [
                                            "One who sells fruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1646245-6d16-4fcb-a026-6ac327cd0837",
                                                "sense_id": "b904e110-abe9-3ed9-a0c7-670631399ee9",
                                                "text": "So he wanders through the market, between the old-clothes stalls and the fortune-paper stalls, the fruitmongers and the fried-fish seller, with his little dæmon on his shoulder, […]"
                                            },
                                            {
                                                "example_id": "524d4c10-a413-4874-ba9c-fc1bf8379c02",
                                                "sense_id": "b904e110-abe9-3ed9-a0c7-670631399ee9",
                                                "text": "Dixon has brought a small apple from a fruitmonger's barrow, […]"
                                            },
                                            {
                                                "example_id": "205b1920-0ea2-4e14-95a5-923428d7e451",
                                                "sense_id": "b904e110-abe9-3ed9-a0c7-670631399ee9",
                                                "text": "Will and the Duchess sat in the sunshine and shared an apple Will had nicked from a fruitmonger's stall."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "741f0b35-ea04-4404-9032-00a01ff1e641",
                        "source_entry_id": "61ec4338-245c-3d65-8bb1-f0544476ef95",
                        "source_sense_id": "2b1cde68-22e7-3bf1-9089-7188c200f012",
                        "target_lang_word": "costermonger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "costermonger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "794bc85e-9544-3a3e-a947-7462418b1402",
                                        "entry_id": "c23e6338-4f6e-321c-8444-19305e9d23bd",
                                        "glosses": [
                                            "A trader who sells fruit and vegetables from a cart or barrow in the street."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d76f399-cbb3-4ee3-99ae-98f1adec3f47",
                                                "sense_id": "794bc85e-9544-3a3e-a947-7462418b1402",
                                                "text": "I cannot tell, vertue is of ſo little regard in theſe coſtar-mongers times, that true valour is turnd berod […]"
                                            },
                                            {
                                                "example_id": "a9b316af-bf0f-42c7-81ac-76d1f2448e7d",
                                                "sense_id": "794bc85e-9544-3a3e-a947-7462418b1402",
                                                "text": "The Saint Monday Gemmen held their diversions on the 18th, near Clay-hill, which consisted of a pugilistic exhibition between G. Wilkie, a coster-monger, and Jeffery Smith, a professor, but little calculated to astonish the spectators at his professional skill. The battle was for ten guineas; and, after a contest of about forty minutes, in which the combatants were decently feaked, and the head of Jeffery was a good deal disfigured, he resigned the contest, and the coster-monger was carried to Westminster in triumph, [...]"
                                            },
                                            {
                                                "example_id": "4ed827ca-4f52-4c0d-a035-dcd78c35fa55",
                                                "sense_id": "794bc85e-9544-3a3e-a947-7462418b1402",
                                                "text": "We arrived at Lincoln’s Inn Fields without any new adventures, except encountering an unlucky donkey in a costermonger’s cart, who suggested painful associations to my aunt."
                                            },
                                            {
                                                "example_id": "edc51c56-e381-432f-8d0e-df353107f2b2",
                                                "sense_id": "794bc85e-9544-3a3e-a947-7462418b1402",
                                                "text": "1889, Oscar Wilde, “The Portrait of Mr. W. H.” Chapter 1, in Lord Arthur Savile’s Crime and Other Stories,\nHe was an extraordinary old aristocrat, who swore like a costermonger, and had the manners of a farmer."
                                            },
                                            {
                                                "example_id": "eb98e819-1442-40ca-99ca-e78478135d58",
                                                "sense_id": "794bc85e-9544-3a3e-a947-7462418b1402",
                                                "text": "He had loved too well to imagine himself a glorious racehorse, and now he was condemned to toil without honour like a costermonger’s donkey."
                                            },
                                            {
                                                "example_id": "74ca302f-155a-48fb-b5a4-8a2483f32858",
                                                "sense_id": "794bc85e-9544-3a3e-a947-7462418b1402",
                                                "text": "The twilight was still in the dusky skies; the walking took her nearly always over pieces of wrapping paper and banana peels, and the sawdust and detritus that fell from the costermongers’ stalls, lining all the roadways."
                                            },
                                            {
                                                "example_id": "e40d7950-a65f-4d82-9091-b1a27a0c6bf1",
                                                "sense_id": "794bc85e-9544-3a3e-a947-7462418b1402",
                                                "text": "In more recent times it is recorded that among the London costermongers of the Victorian age a common oath, probably misunderstood or not understood at all, was, So help me testes!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce95e80d-ded8-3320-87e1-f0462ea9aff0",
                                        "entry_id": "c23e6338-4f6e-321c-8444-19305e9d23bd",
                                        "glosses": [
                                            "An apple-seller, usually itinerant and selling from a cart."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
