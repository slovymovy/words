                        "glosses": [
                            "The amount by which someone or something is overspent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6467da08-0b85-45b4-92b0-ddcd8756a643",
                                "sense_id": "3610a2f9-0f2c-32ff-92f0-63d0e6207389",
                                "text": "Whether an underspend or overspend is significant depends upon the size of the budget. A £1,000 overspend on an £8,000 drugs budget is very significant, but a £1,000 overspend may not be significant on a £300,000 ward budget."
                            },
                            {
                                "example_id": "aa180bb1-2291-4eac-8704-70f41f15b086",
                                "sense_id": "3610a2f9-0f2c-32ff-92f0-63d0e6207389",
                                "text": "Electrification was not included in anticipated CP6 spending, after cost uncertainties following the Great Western Main Line overspend led to cutbacks by the Department of Transport to contain costs."
                            }
                        ]
                    }
                ],
