                        "examples": [
                            {
                                "example_id": "975ed5ae-37af-4f69-9d6d-3fe1fcfb07c4",
                                "sense_id": "298a31c3-12df-36aa-81e0-068b923aab3b",
                                "text": "Elles sont couvertes de boules d’argile et de kisiak déposées par les femmes."
                            },
                            {
                                "example_id": "b32a9ddf-2956-4765-ad5d-52e853b5e961",
                                "sense_id": "298a31c3-12df-36aa-81e0-068b923aab3b",
                                "text": "Les hommes plantent la tente, nous empilons les gâteaux de bouse sur nos bras ; avant de les ramasser, on les retourne du pied pour voir s’ils sont bien secs dessous. Un foyer est construit ; cela brûle bien, comme des braises, sans flammes mais donnant beaucoup de chaleur. La senteur âcre du kisiak s’attache aux habits et c’est l’odeur dégagée par tous les nomades que j’ai rencontrés."
                            }
                        ]
                    }
