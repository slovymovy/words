                    "frequency": "High",
                    "semantic_group_id": "méfiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a vite appris à se <w>méfier</w> des inconnus qui lui posent trop de questions."
                        },
                        {
                            "text": "Depuis cette dispute, elle se <w>méfie</w> de ses anciens collègues de bureau."
                        }
                    ],
