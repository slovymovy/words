        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bae159ee-784a-3d4f-9780-f9885906ad91",
                    "sense_definition": "Niet inbegrepen in de prijs; zonder.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De prijs is 15 euro <w>ex</w> verzendkosten.",
                            "target_lang_translations": {
                                "en": "The price is 15 euros <w>excluding</w> shipping costs.",
                                "pl": "Cena wynosi 15 euro <w>bez</w> kosztów wysyłki.",
                                "de": "Der Preis beträgt 15 Euro <w>zzgl.</w> Versandkosten.",
                                "fr": "Le prix est de 15 euros <w>hors</w> frais de port.",
                                "it": "Il prezzo è di 15 euro <w>escluse</w> le spese di spedizione.",
                                "cs": "Cena je 15 eur <w>bez</w> poštovného.",
                                "tr": "Fiyat, kargo ücreti <w>hariç</w> 15 Euro'dur.",
                                "es": "El precio es de 15 euros <w>sin</w> gastos de envío.",
                                "zh": "价格是15欧元，<w>不含</w>运费。"
                            }
                        },
                        {
                            "text": "Het uurtarief is vijftig euro <w>ex</w> btw.",
                            "target_lang_translations": {
                                "en": "The hourly rate is fifty euros <w>excluding</w> VAT.",
                                "pl": "Stawka godzinowa wynosi pięćdziesiąt euro <w>plus</w> VAT.",
                                "de": "Der Stundensatz beträgt fünfzig Euro <w>zzgl.</w> MwSt.",
                                "fr": "Le tarif horaire est de cinquante euros <w>hors</w> TVA.",
                                "it": "La tariffa oraria è di cinquanta euro <w>esclusa</w> IVA.",
                                "cs": "Hodinová sazba je padesát eur <w>bez</w> DPH.",
                                "tr": "Saatlik ücret KDV <w>hariç</w> elli Euro'dur.",
                                "es": "La tarifa por hora es de cincuenta euros <w>sin</w> IVA.",
                                "zh": "时薪是五十欧元，<w>不含</w>增值税。"
                            }
                        }
                    ],
