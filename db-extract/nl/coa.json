                        "examples": [
                            {
                                "example_id": "2847669a-b7c1-4c80-b469-8a2ab579d9f2",
                                "sense_id": "b2317b9f-7ddb-3288-a98f-a9b73c0d36f6",
                                "text": "Het COA is opgericht in 1985, toen Aruba zich losmaakte van de Nederlandse Antillen. Voor die tijd werden Arubaanse sporters vertegenwoordigd door het Olympisch Comité Antillen (NAOC). Het IOC erkende het COA in 1986. Het doel van COA is om de positie van Arubaanse Olympische sporters te versterken."
                            }
                        ]
                    }
