                ],
                "senses": [
                    {
                        "sense_id": "aeb33024-9baa-3d96-9c11-ff6c4fa0173f",
                        "entry_id": "d929cbf9-bf0d-3ec7-8b80-363a1cf08a52",
                        "glosses": [
                            "Présence d’air ou de gaz sous la voûte crânienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534c4ddd-1e2c-4b4c-ba85-d7b996aad31c",
                                "sense_id": "aeb33024-9baa-3d96-9c11-ff6c4fa0173f",
                                "text": "Le diagnostic est posé : ce patient présente ce que les spécialistes appellent une pneumocéphalie, encore appelée pneumatocèle intracrânienne, définie par la présence d’air sous la voûte crânienne."
                            },
                            {
                                "example_id": "23205e45-afe6-4248-9937-eff7dfb8e060",
                                "sense_id": "aeb33024-9baa-3d96-9c11-ff6c4fa0173f",
                                "text": "La pneumocéphalie est diagnostiquée facilement au scanner. L’air y est visible comme de petites zones fortement hypodenses (-1000 UH)."
                            },
                            {
                                "example_id": "a31f76c3-ef37-4a77-a984-9136a6b9c0f9",
                                "sense_id": "aeb33024-9baa-3d96-9c11-ff6c4fa0173f",
                                "text": "La pneumocéphalie postopératoire est une complication fréquente chez le traumatisé crânien mais relativement rare de la chirurgie intracrânienne."
                            }
                        ]
                    }
                ],
