                                        "entry_id": "d957310c-d184-3064-9a8a-b20eae07194e",
                                        "glosses": [
                                            "The land of one's birth, or where one was born."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81485afd-15c2-4f84-963b-de47e282e832",
                                                "sense_id": "cb0d9ee9-54d3-3be5-9b1b-6c64b4b919d4",
                                                "text": "The water of Lhasa is of all lands, But nectar like chang and arak abound only in our birthland."
                                            },
                                            {
                                                "example_id": "f3bb5dda-4e29-4cc8-bb42-8d850cab7e26",
                                                "sense_id": "cb0d9ee9-54d3-3be5-9b1b-6c64b4b919d4",
                                                "text": "\"[...] Give me forgotten days: Give me my birthland mine to bear with me And see it when my eyes may no more see.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
