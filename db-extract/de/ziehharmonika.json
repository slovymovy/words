                ],
                "senses": [
                    {
                        "sense_id": "806ca95c-28a4-3e09-aa48-6c557c074c48",
                        "entry_id": "7e2a2f9d-265a-31e1-a6de-c9cf4da96d6b",
                        "glosses": [
                            "Musikinstrument mit einem Balg, bei dem Töne durch den Luftzug, der durch das Ziehen und Drücken entsteht, erzeugt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a6d624-be70-43ad-892b-31e441ac3c73",
                                "sense_id": "806ca95c-28a4-3e09-aa48-6c557c074c48",
                                "text": "„Irgendwo spielte jemand auf einer Ziehharmonika ein Volkslied.“"
                            },
                            {
                                "example_id": "5ad6c233-9a58-4012-ae8e-8adcb1a5b49e",
                                "sense_id": "806ca95c-28a4-3e09-aa48-6c557c074c48",
                                "text": "„Nebenbei stopfte er Vögel aus und spielte auch zum Tanz auf; denn er versteht sich auf die Ziehharmonika und die Trompete und wird auch ganz gut mit der Fiedel fertig.“"
                            },
                            {
                                "example_id": "152c4481-b67e-433b-b70d-c74d470f9ba4",
                                "sense_id": "806ca95c-28a4-3e09-aa48-6c557c074c48",
                                "text": "„Von einem klang das Jammern einer Ziehharmonika.“"
                            },
                            {
                                "example_id": "694c87e9-af80-4323-be61-00ec2d1a4465",
                                "sense_id": "806ca95c-28a4-3e09-aa48-6c557c074c48",
                                "text": "„Die Beamten auf beiden Seiten identifizierten den soignierten jungen Herrn an Hand seines Diplomatenpasses, der sich wie eine Ziehharmonika öffnen ließ, als William S. Murphy, offiziellen Kurier der amerikanischen Botschaft in Paris.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
