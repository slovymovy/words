        "fr-extract.jsonl": [
            {
                "entry_id": "270a6656-1e06-3e5c-8ac4-87688a48875e",
                "word": "affiquet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "94be07a1-8624-48c0-b823-5291b5488f09",
                        "entry_id": "270a6656-1e06-3e5c-8ac4-87688a48875e",
                        "tags": [
                            "plural"
                        ],
                        "form": "affiquets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ea8d11a-f500-3b85-a59e-a51463e7b841",
                        "entry_id": "270a6656-1e06-3e5c-8ac4-87688a48875e",
                        "glosses": [
                            "Deux espèces de petits godets de bois reliés ensemble par un caoutchouc que l’on met aux extrémités des aiguilles à tricoter quand on interrompt son ouvrage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "438f77f9-f932-40de-afaa-1393d07be146",
                                "sense_id": "5ea8d11a-f500-3b85-a59e-a51463e7b841",
                                "text": "L'affiquet attaché à la ceinture de la jeune fille retient la pointe libre de ses aiguilles à tricoter."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffb140d1-6db0-3745-957d-bb9181657064",
                        "entry_id": "270a6656-1e06-3e5c-8ac4-87688a48875e",
                        "glosses": [
                            "Parure, ajustement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "eff98661-8b32-431a-bd30-beb312ae832f",
                                "sense_id": "ffb140d1-6db0-3745-957d-bb9181657064",
                                "text": "Comment est sa robe ? — En soie lilas, madame. — Et son chapeau ? — En paille, madame ; et tout rond, avec une plume blanche et des affiquets de velours noir."
                            },
                            {
                                "example_id": "f21da842-84c8-42cc-9a79-8f0d01bbe152",
                                "sense_id": "ffb140d1-6db0-3745-957d-bb9181657064",
                                "text": "Car elle était là, encore en ses vertes années, sans rides ni voussures, ni infirmités d'aucune sorte, belle et blonde en ses affiquets, peignée et pulvérisée de parfums, ressentant tout l'amour que mon père avait pour elle, et le lui rendant au centuple, mais en secret, derrière les raideurs de son orgueil."
                            }
                        ]
                    },
                    {
                        "sense_id": "84d5023c-18e7-32df-83bc-82142650c672",
                        "entry_id": "270a6656-1e06-3e5c-8ac4-87688a48875e",
                        "glosses": [
                            "Parure."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f09c15a9-72f5-43e0-bebc-66eb3151d97c",
                                "sense_id": "84d5023c-18e7-32df-83bc-82142650c672",
                                "text": "Elle n’avait pas osé l’appeler Bel Hardi tant ce nom de bravade et d’ailleurs tous les affiquets de la chevalerie perdaient leur force et jusqu’à leur vie en face de telles apparitions."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7ed4c85-2674-3071-ae80-0692ee174f28",
                        "entry_id": "270a6656-1e06-3e5c-8ac4-87688a48875e",
                        "glosses": [
                            "(au pluriel) Menus ajustements d’une femme."
                        ],
                        "tags": [
                            "broadly",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0a6e99ab-3f3d-413b-bfc6-0e1db5642111",
                                "sense_id": "d7ed4c85-2674-3071-ae80-0692ee174f28",
                                "text": "Avec tous ses affiquets, elle se croit jolie."
                            },
                            {
                                "example_id": "1492b5ac-c0ad-4189-b512-b55b2fc8da5f",
                                "sense_id": "d7ed4c85-2674-3071-ae80-0692ee174f28",
                                "text": "C’étaient tous les dimanches parure nouvelle, robes, joyaux, bonnets, des affiquets du diable que les marchands inventent pour la perdition des femmes."
                            },
                            {
                                "example_id": "f52c34a5-e469-46b4-b17f-cc380f257e70",
                                "sense_id": "d7ed4c85-2674-3071-ae80-0692ee174f28",
                                "text": "– C’est bien facile d’avoir tout ce qu’il faut dans son corset, quand on a un vétérinaire qui gagne assez pour vous nourrir à ne rien faire, quand on peut se mettre des affiquets sur le dos et des chapeaux et des bottines !"
                            }
                        ]
                    },
                    {
                        "sense_id": "ca37bcce-56b6-38dd-b38f-98aef31755a5",
                        "entry_id": "270a6656-1e06-3e5c-8ac4-87688a48875e",
                        "glosses": [
                            "Couille."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e3814242-66ef-4508-bb4d-b9bb4a642f18",
                                "sense_id": "ca37bcce-56b6-38dd-b38f-98aef31755a5",
                                "text": "La seconde image, beaucoup plus expressive, les désigne comme des « ornements », des sortes de pompons qui pendent et s’agitent au bout d’une chaîne. Ce sont : des affiquets, des brimborions, des breloques, des dandrilles, des pendeloches, etc."
                            }
                        ]
                    }
                ],
