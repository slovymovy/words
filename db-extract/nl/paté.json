                        "source_sense_id": "5a2b0187-ca71-393c-b053-713cde23ebb1",
                        "source_sense_description": "stevig, maar smeerbaar mengsel van fijngemalen vlees",
                        "target_lang_word": "pâté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pâté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d303869-16ef-363b-8587-82ef83de9544",
                                        "entry_id": "fd212913-d1f6-3cbb-90f3-708ecea608fb",
                                        "glosses": [
                                            "Pâtisserie qui renferme de la viande ou du poisson haché."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a8e6311-ef55-4175-af8d-ad108155a2f4",
                                                "sense_id": "9d303869-16ef-363b-8587-82ef83de9544",
                                                "text": "Pâté chaud."
                                            },
                                            {
                                                "example_id": "524600e8-efed-4762-ac1e-1ef687b89900",
                                                "sense_id": "9d303869-16ef-363b-8587-82ef83de9544",
                                                "text": "Pâté en croûte."
                                            },
                                            {
                                                "example_id": "9d89b4b2-fd60-42e0-a9c1-8711b3fab414",
                                                "sense_id": "9d303869-16ef-363b-8587-82ef83de9544",
                                                "text": "Pâté en terrine"
                                            },
                                            {
                                                "example_id": "f582a2c2-2ff1-49a5-a1f5-9dc5db0c593a",
                                                "sense_id": "9d303869-16ef-363b-8587-82ef83de9544",
                                                "text": "Pâté de saumon."
                                            },
                                            {
                                                "example_id": "35191083-8324-4b66-97c0-53b4bf88c90a",
                                                "sense_id": "9d303869-16ef-363b-8587-82ef83de9544",
                                                "text": "Ouvrir, entamer un pâté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3b8c6b1-a31a-32d2-a26f-4ed90ef7e630",
                                        "entry_id": "fd212913-d1f6-3cbb-90f3-708ecea608fb",
                                        "glosses": [
                                            "Charcuterie de viande hachée (généralement du foie, des abats) de gras, de légumes, d’œufs, d’herbes, d’épices ainsi que d’autres ingrédients tels que des alcools comme le cognac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92112c33-d69c-45d4-9699-a493aafb6601",
                                                "sense_id": "b3b8c6b1-a31a-32d2-a26f-4ed90ef7e630",
                                                "text": "Ils incluent les pâtés de campagne, de jambon, de viande, de volaille, de lapin, de gibier : lièvre, faisan, sanglier, cerf... sans oublier le pâté forestier comprenant des champignons sylvestres (surtout des trompettes-de-la-mort)."
                                            },
                                            {
                                                "example_id": "406e337e-40e1-440e-a385-7e9592e002ed",
                                                "sense_id": "b3b8c6b1-a31a-32d2-a26f-4ed90ef7e630",
                                                "text": "La maîtresse de maison, aidée de ses filles, avait fait le pain, des fougasses aux grattons et aux olives, pâtés truffés en terrine, fouaces, gâteaux à la broche et tartes aux pommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e8d0f78-eb03-3ca7-81c4-7e908dfe14ad",
                                        "entry_id": "fd212913-d1f6-3cbb-90f3-708ecea608fb",
                                        "glosses": [
                                            "Enfant gras et potelé."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "983e750a-021b-46ec-9c7a-be1de0dc7c74",
                                                "sense_id": "9e8d0f78-eb03-3ca7-81c4-7e908dfe14ad",
                                                "text": "Viens ici, gros pâté !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c86b1a51-1547-32df-839a-30c8bf559850",
                                        "entry_id": "fd212913-d1f6-3cbb-90f3-708ecea608fb",
                                        "glosses": [
                                            "Petite masse de sable comprimé que font les enfants pour s’amuser, à l’aide de petits seaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20094d61-4461-4ecf-a1eb-2b71d9a2c438",
                                                "sense_id": "c86b1a51-1547-32df-839a-30c8bf559850",
                                                "text": "Les enfants s’amusaient dans le jardin à faire des pâtés de sable."
                                            },
                                            {
                                                "example_id": "79c9b9f6-90d4-47c0-b56d-d8bfacdb0064",
                                                "sense_id": "c86b1a51-1547-32df-839a-30c8bf559850",
                                                "text": "Son regard tranquille me protégeait pendant que je faisais des pâtés au Luxembourg, pendant que je berçais ma poupée Blondine, descendue du ciel une nuit de Noël avec la malle qui contenait son trousseau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eed1e74-396b-3cc7-921a-f828f62e1ca5",
                                        "entry_id": "fd212913-d1f6-3cbb-90f3-708ecea608fb",
                                        "glosses": [
                                            "Goutte d’encre tombée sur du papier."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4e27b3d-fa5c-4cb4-ab1f-319765dc76ab",
                                                "sense_id": "2eed1e74-396b-3cc7-921a-f828f62e1ca5",
                                                "text": "D’abord, je gâche trois feuilles de papier à compliments : j’ai beau tirer la langue, et la remuer, et la crisper en faisant mes majuscules, j’éborgne les o, j’emplis d’encre la queue des g, et je fais chaque fois un pâté sur le mot « allégresse »."
                                            },
                                            {
                                                "example_id": "9ad7ca40-142d-4433-92fb-beb4728bf7d1",
                                                "sense_id": "2eed1e74-396b-3cc7-921a-f828f62e1ca5",
                                                "text": "Il ne saurait écrire trois lignes sans faire un pâté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b3884a-e685-3059-9a73-6be133e211fd",
                                        "entry_id": "fd212913-d1f6-3cbb-90f3-708ecea608fb",
                                        "glosses": [
                                            "Ouvrage avancé, placé dans un terrain inondé ou entouré d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f10276f-eb63-4816-9582-574594061503",
                                                "sense_id": "12b3884a-e685-3059-9a73-6be133e211fd",
                                                "text": "Le pâté de Blaye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a97b692-cf6c-39a1-8130-048411bcbb8f",
                                        "entry_id": "fd212913-d1f6-3cbb-90f3-708ecea608fb",
                                        "glosses": [
                                            "Ensemble de maisons."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b18a28f1-773d-432e-b52d-9f3dee038330",
                                                "sense_id": "3a97b692-cf6c-39a1-8130-048411bcbb8f",
                                                "text": "La rue et l’impasse du Doyenné, voilà les seules voies intérieures de ce pâté sombre et désert où les habitants sont probablement des fantômes, car on n’y voit jamais personne."
                                            },
                                            {
                                                "example_id": "feb6e0a7-7a8d-47ba-99d8-3a0f018f910d",
                                                "sense_id": "3a97b692-cf6c-39a1-8130-048411bcbb8f",
                                                "text": "Ces bâtiments nommés insulae (îles) s’écroulaient de temps à autre, mais plus souvent encore ils étaient la proie des flammes qui se propageaient avec une vitesse effarante aux pâtés voisins."
                                            },
                                            {
                                                "example_id": "b590e573-3cb9-4228-82bc-7038432bc054",
                                                "sense_id": "3a97b692-cf6c-39a1-8130-048411bcbb8f",
                                                "text": "Pâté de maisons."
                                            },
                                            {
                                                "example_id": "d975eadf-b476-4fd3-ae2c-c5d9184e7bce",
                                                "sense_id": "3a97b692-cf6c-39a1-8130-048411bcbb8f",
                                                "text": "Faire le tour du pâté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8503f49b-7d75-3297-b304-d86055efa466",
                                        "entry_id": "fd212913-d1f6-3cbb-90f3-708ecea608fb",
                                        "glosses": [
                                            "Tas de caractères mêlés et confondus sans aucun ordre, ce qui arrive quand une forme se brise par quelque accident."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
