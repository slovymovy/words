                                        "glosses": [
                                            "A style of music derived from hip-hop and trap music, directly inspired by 1990s Memphis rap."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a3caee9-18b2-3f68-8ed6-3df3bf06fba4",
                                        "entry_id": "914ca254-d5fb-36c7-aff5-4b05c5f80934",
                                        "glosses": [
                                            "Drift phonk."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1dfe5f2-c5c7-463e-861a-826bc84f3c5c",
                                                "sense_id": "5a3caee9-18b2-3f68-8ed6-3df3bf06fba4",
                                                "text": "By smashing together components of hip-hop, EDM, metal and dubstep, phonk is placed as one of the most prominent new genres of music."
                                            }
