{
    "word_family": [
        "stellar",
        "stellate",
        "stellation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f6bf06d-9e7b-3ad3-96a1-32d665538e56",
                    "sense_definition": "A group of stars forming a recognizable pattern in the sky, often named after mythological figures.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The astronomer pointed out the <w>constellation</w> of Orion in the night sky.",
                            "target_lang_translations": {
                                "zh": "天文学家指出了夜空中的猎户座<w>星座</w>。"
                            }
                        },
                        {
                            "text": "Many ancient cultures created stories about each <w>constellation</w> they saw above.",
                            "target_lang_translations": {
                                "zh": "许多古代文明为他们所见的每一个<w>星座</w>都创作了故事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bright constellation"
                    ],
                    "target_lang_definitions": {
                        "zh": "天空中一组恒星形成的特定图案，通常以神话人物命名。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "星座",
                                "target_lang_sense_clarification": "指天文学上的星群。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3849c0da-b0ab-38fd-93aa-1c18eb217b2e",
                    "sense_definition": "A collection or grouping of related things or ideas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project involves a <w>constellation</w> of different factors that must be managed carefully.",
                            "target_lang_translations": {
                                "zh": "这个项目涉及一系列必须谨慎管理的<w>因素</w>。"
                            }
                        },
                        {
                            "text": "She faced a <w>constellation</w> of challenges while trying to launch her new business.",
                            "target_lang_translations": {
                                "zh": "她在尝试创业时面临着一连串的<w>挑战</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "constellation of ideas"
                    ],
                    "target_lang_definitions": {
                        "zh": "一系列相关事物或想法的集合。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "系列",
                                "target_lang_sense_clarification": "指相关联的一组事物。"
                            },
                            {
                                "target_lang_word": "集合",
                                "target_lang_sense_clarification": "指多种因素的汇集。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03e66182-1449-3d9f-a198-1fc4e81bf8c7",
                    "sense_definition": "A group of artificial satellites working together to provide a specific service.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company launched a new <w>constellation</w> of satellites to improve global internet access.",
                            "target_lang_translations": {
                                "zh": "该公司发射了一组新的<w>卫星群</w>以改善全球互联网接入。"
                            }
                        },
                        {
                            "text": "Managing a <w>constellation</w> of satellites requires precise coordination from ground control.",
                            "target_lang_translations": {
                                "zh": "管理一个<w>卫星星座</w>需要地面控制中心进行精确的协调。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "satellite constellation"
                    ],
                    "target_lang_definitions": {
                        "zh": "为提供特定服务而协同工作的一组人造卫星。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卫星星座",
                                "target_lang_sense_clarification": "航天领域中指协同工作的卫星群。"
                            },
                            {
                                "target_lang_word": "卫星群",
                                "target_lang_sense_clarification": "指多颗卫星组成的系统。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73c06328-158f-35f5-809e-7beb36e2c289",
                    "sense_definition": "A scattered collection of marks or small items on a surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>constellation</w> of freckles across his nose and cheeks.",
                            "target_lang_translations": {
                                "zh": "他的鼻梁和脸颊上<w>散布</w>着许多雀斑。"
                            }
                        },
                        {
                            "text": "The artist painted a <w>constellation</w> of tiny dots to create the background texture.",
                            "target_lang_translations": {
                                "zh": "艺术家画了许多细小的<w>点</w>来营造背景纹理。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "表面上零星分布的斑点或小物件。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "星罗棋布",
                                "target_lang_sense_clarification": "形容数量多且分布广。"
                            },
                            {
                                "target_lang_word": "散布",
                                "target_lang_sense_clarification": "指零星分布的状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa2a3f27-7d14-3a31-995c-91d5dbc2fb67",
                    "sense_definition": "A collection of repressed emotions or ideas that influence mental health.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist helped the patient identify a <w>constellation</w> of anxieties rooted in childhood.",
                            "target_lang_translations": {
                                "zh": "治疗师帮助病人识别出根源于童年的一系列<w>焦虑</w>。"
                            }
                        },
                        {
                            "text": "His behavior was driven by a complex <w>constellation</w> of unresolved feelings.",
                            "target_lang_translations": {
                                "zh": "他的行为是由一系列复杂的未解<w>情结</w>所驱动的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "complex"
                    ],
                    "target_lang_definitions": {
                        "zh": "影响心理健康的一系列被压抑的情绪或观念。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "情结",
                                "target_lang_sense_clarification": "心理学中指一组相关联的心理倾向。"
                            },
                            {
                                "target_lang_word": "综合体",
                                "target_lang_sense_clarification": "指多种复杂心理因素的结合。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}