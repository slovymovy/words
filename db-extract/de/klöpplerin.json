                "senses": [
                    {
                        "sense_id": "190136d7-7ec7-3c3e-8c70-ce12a9e36b4c",
                        "entry_id": "b02efb29-c38b-36bc-b67f-a941025dee12",
                        "glosses": [
                            "weibliche Person, die (beruflich) Klöppelspitze herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cc18f44-496b-403d-bf1a-a6ad46911503",
                                "sense_id": "190136d7-7ec7-3c3e-8c70-ce12a9e36b4c",
                                "text": "Ob eine Spitze durch eine Maschine oder eine Klöpplerin gefertigt wurde, kann der Laie nicht unterscheiden."
                            },
                            {
                                "example_id": "3f3619d9-3d7a-469d-b3ec-c3a59f33a637",
                                "sense_id": "190136d7-7ec7-3c3e-8c70-ce12a9e36b4c",
                                "text": "Eines der Motive, die häufig auf Schwibbögen zu finden sind, zeigt Bergleute, Schnitzer und eine Klöpplerin, laut Müller, drei Haupterwerbsquellen der Leute im 18. und 19. Jahrhundert."
                            },
                            {
                                "example_id": "19a21995-34c9-40dc-bcaa-421a3a86f23a",
                                "sense_id": "190136d7-7ec7-3c3e-8c70-ce12a9e36b4c",
                                "text": "Dank des großen Engagements der begeisterten Klöpplerinnen ist es sogar gelungen, dass die Handwerkskunst des Spitzenklöppelns letztes Jahr in das bayerische Landesverzeichnis als immaterielles Kulturerbe eingetragen wurde."
                            },
                            {
                                "example_id": "1eba7239-de37-4bf2-b101-9e2e1427743a",
                                "sense_id": "190136d7-7ec7-3c3e-8c70-ce12a9e36b4c",
                                "text": "Ihren Wert kann nur ermessen, wer Folgendes weiß: 600 Stunden sitzt eine versierte Klöpplerin am Klöppelkissen, bis sie eine Decke für einen Wohnzimmertisch gefertigt hat."
                            },
                            {
                                "example_id": "832db8c1-0d59-4e80-afa0-7c6a2b391050",
                                "sense_id": "190136d7-7ec7-3c3e-8c70-ce12a9e36b4c",
                                "text": "Die Klöpplerinnen hätten weder lesen noch schreiben können. Doch sie konnten mit 200 bis 300 Klöppeln arbeiten – und zwar ohne technische Zeichnungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
