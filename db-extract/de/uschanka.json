                "senses": [
                    {
                        "sense_id": "aa2bc913-470e-3214-8a49-efdfa1f57768",
                        "entry_id": "dc52474c-d4fa-377a-8d36-98f221c96e14",
                        "glosses": [
                            "Pelzmütze, bei der am Mützenrand Klappen eingenäht sind, die nach oben aufgeschlagen sind und bei großer Kälte zum Schutz der Ohren und des Nackens heruntergeklappt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "321522b5-795d-4102-8fc0-72c2ac620c6b",
                                "sense_id": "aa2bc913-470e-3214-8a49-efdfa1f57768",
                                "text": "Ilona hat sich eine Uschanka gekauft."
                            },
                            {
                                "example_id": "c7caf075-750c-429b-a693-26b879c9ee98",
                                "sense_id": "aa2bc913-470e-3214-8a49-efdfa1f57768",
                                "text": "Der Designer präsentiert seine neue Kollektion von Uschankas."
                            },
                            {
                                "example_id": "895418fd-b82c-45a2-a76c-2dfe6b214086",
                                "sense_id": "aa2bc913-470e-3214-8a49-efdfa1f57768",
                                "text": "Im Museum sahen wir originale Uschankas der Roten Armee."
                            },
                            {
                                "example_id": "a60d9483-7390-4418-8e63-fad526e8d279",
                                "sense_id": "aa2bc913-470e-3214-8a49-efdfa1f57768",
                                "text": "„Gegen die klirrende Kälte trägt er mehrere lange Unterhosen übereinander; sogar eine Uschanka, eine »Russenmütze«, hat er sich besorgt, ebenso wie ein Tauschgut: Salz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65734f76-d5bd-4447-a4a5-bb272a8317d2",
                        "source_entry_id": "dc52474c-d4fa-377a-8d36-98f221c96e14",
                        "source_sense_id": "aa2bc913-470e-3214-8a49-efdfa1f57768",
                        "source_sense_description": "Pelzmütze mit Ohrenklappen",
                        "target_lang_word": "ushanka",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ushanka",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cce067f-8597-3b0f-a684-f36eac8ca544",
                                        "entry_id": "d8dfd9fa-973b-3965-8108-5061d2041f44",
                                        "glosses": [
                                            "A traditional Russian fur cap with earflaps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f895e589-01fc-4178-89a1-8dbc1a4bea0b",
                                                "sense_id": "9cce067f-8597-3b0f-a684-f36eac8ca544",
                                                "text": "I have no idea why he's wearing a ushanka in triple digit heat; bro's forehead must be drenched in sweat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ec8f283-916c-40f7-9b34-82fc5888e572",
                        "source_entry_id": "dc52474c-d4fa-377a-8d36-98f221c96e14",
                        "source_sense_id": "aa2bc913-470e-3214-8a49-efdfa1f57768",
                        "source_sense_description": "Pelzmütze mit Ohrenklappen",
                        "target_lang_word": "chapka",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chapka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dec40d87-891a-3015-8087-c89a28168983",
                                        "entry_id": "42e93120-27cd-32a2-ad59-6771b5ee0e3f",
                                        "glosses": [
                                            "Chapeau traditionnel russe ou scandinave, en fourrure, muni de parties rabattables qui peuvent couvrir les oreilles et la nuque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab2a517-27a1-46fa-a72e-c288480f312c",
                                                "sense_id": "dec40d87-891a-3015-8087-c89a28168983",
                                                "text": "Peu de temps après, un Russe vêtu d’une pelisse blanche et coiffé d’une bonne chapka toute neuve avait bondi hors de la tranchée en jurant tout ce qu’il savait et en menaçant les Allemands du poing."
                                            },
                                            {
                                                "example_id": "2f33d7b1-cf5d-4821-b4ca-8bf7cc2b1b61",
                                                "sense_id": "dec40d87-891a-3015-8087-c89a28168983",
                                                "text": "À 14 h 15, cinq hommes entrent dans la banque : un rabbin, un russe en chapka, un élégant et deux lodens verts. Le scénario habituel fonctionne parfaitement."
                                            },
                                            {
                                                "example_id": "232b09d5-7440-4bb7-97d9-ab1d93815448",
                                                "sense_id": "dec40d87-891a-3015-8087-c89a28168983",
                                                "text": "Devant la statue de Lénine, pour nous c’était le grand frisson\nMoins 24°, c’était pas terrible, mais les chapkas étaient en option."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26741792-9519-4f11-900a-c8b32627cd00",
                        "source_entry_id": "dc52474c-d4fa-377a-8d36-98f221c96e14",
                        "source_sense_id": "aa2bc913-470e-3214-8a49-efdfa1f57768",
                        "source_sense_description": "Pelzmütze mit Ohrenklappen",
                        "target_lang_word": "oesjanka",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oesjanka",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "923e85ec-c53d-371b-aac8-d73e6c4139b9",
                                        "entry_id": "b0423824-e825-3f73-8170-72c38ce92078",
                                        "glosses": [
                                            "traditionele Russische bontmuts met oorflappen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f135c27-6ae1-4817-b84d-65b87644b671",
                                                "sense_id": "923e85ec-c53d-371b-aac8-d73e6c4139b9",
                                                "text": "Het Russische leger stopt met het gebruik van Ruslands bekendste kledingstuk: de bontmuts met oorflappen. De oesjanka, zoals de muts heet, wordt vervangen door een hoofddeksel dat kan worden gedragen in combinatie met een helm en moderne communicatiemiddelen."
                                            },
                                            {
                                                "example_id": "39f05a3b-22ea-42ca-a8ba-cd44f2ecbc71",
                                                "sense_id": "923e85ec-c53d-371b-aac8-d73e6c4139b9",
                                                "text": "‘Geef hem jouw oesjanka, Ljosja,’ zegt Grisja, en Ljosja doet zijn muts af en zet hem op Michails hoofd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
