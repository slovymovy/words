                "senses": [
                    {
                        "sense_id": "9ee94d36-f5a8-3e25-a396-34d196d01b9f",
                        "entry_id": "108ada20-f85c-3123-8762-1abd0672ad20",
                        "glosses": [
                            "Décomprimer, desserrer."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "ef83a9e0-0637-431f-b746-479a6ec92678",
                                "sense_id": "9ee94d36-f5a8-3e25-a396-34d196d01b9f",
                                "text": "Je me met la tête en bas et je souffle dans la capuche pour \"désqueezer\" l'entre-jambe."
                            },
                            {
                                "example_id": "82d3f5f8-1bc9-47a0-abe2-e0bcdbe9146b",
                                "sense_id": "9ee94d36-f5a8-3e25-a396-34d196d01b9f",
                                "text": "Je n'ai aucune machine fonctionnelle qui traîne pour tester, sauf l'ordi de secours dont cela m'avait déjà tout pris juste pour convaincre mon père que reformater le disque dur était une meilleure solution que de réparer Windows (suite à un problème de départitionnement en voulant \"désqueezer\" XP qui était trop à l'étroit dans une partition de 4Go)."
                            },
                            {
                                "example_id": "34361f6f-40bc-4362-a2eb-1dc6fb20dcb5",
                                "sense_id": "9ee94d36-f5a8-3e25-a396-34d196d01b9f",
                                "text": "Juste pour signaler qu'une photo d'un nouveau prototype est en ligne sur le site d'Aäton. La voici, un peu désqueezée"
                            }
                        ]
                    }
                ],
