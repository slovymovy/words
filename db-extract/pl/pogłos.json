                "senses": [
                    {
                        "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                        "entry_id": "d3ec5ee8-5db7-3bd5-ae5b-6076421f48ab",
                        "glosses": [
                            "wywołane działaniem fal odbitych w pomieszczeniu zamkniętym, przedłużenie czasu trwania danego dźwięku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d252dc25-bcec-49e3-b179-43dd2381088a",
                                "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                "text": "W pustych korytarzach czy pustych salach pogłos jest bardzo długi"
                            },
                            {
                                "example_id": "6b5d11b0-ab0c-402a-964f-dc4da062e1a7",
                                "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                "text": "Był to pogłos jakiejś rockowej ballady, której słowa wydały się Kubie dziwnie znajome"
                            },
                            {
                                "example_id": "24747355-1d8c-431d-844d-5a4702aea750",
                                "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                "text": "Ich szepty niosły się wyraźnie dzięki pogłosowi"
                            },
                            {
                                "example_id": "0fab7e2d-2fff-4dbc-b175-99a93bee7449",
                                "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                "text": "Na (…) płycie słyszymy melodie znanych pieśni kościelnych, jednak zamiast słów pojawiają się inne dźwięki: szumy, trzaski, dziwne pogłosy"
                            },
                            {
                                "example_id": "bcdf984b-6207-4696-ac0c-c384c0d9bdfa",
                                "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                "text": "Wiele cenionych przez realizatorów pogłosów płytowych tłumi częstotliwości powyżej 5 kHz"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a9c47efd-2b02-339f-8311-f9de18e5e55f",
                        "entry_id": "d3ec5ee8-5db7-3bd5-ae5b-6076421f48ab",
                        "glosses": [
                            "zwielokrotnienie dźwięku"
                        ],
                        "tags": [
                            "akust."
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "3fabfcb6-a1ee-3ec6-8dda-bd6c75c6f7c9",
                        "entry_id": "d3ec5ee8-5db7-3bd5-ae5b-6076421f48ab",
                        "glosses": [
                            "nawiązanie do zdarzeń i zjawisk wcześniejszych"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "7450f96a-1574-3835-8455-bf662701a971",
                        "entry_id": "d3ec5ee8-5db7-3bd5-ae5b-6076421f48ab",
                        "glosses": [
                            "sztuczny efekt stosowany m.in. w muzyce elektronicznej imitujący zachowanie się dźwięku w przestrzeniach zamkniętych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd6382e2-4dc4-43a8-9439-94b44b531a30",
                                "sense_id": "7450f96a-1574-3835-8455-bf662701a971",
                                "text": "W latach pięćdziesiątych studia coraz częściej wyposażane były w urządzenia do wytwarzania sztucznego pogłosu"
                            },
                            {
                                "example_id": "c5a3bafa-3aad-4b8e-b016-4c891ec8c19c",
                                "sense_id": "7450f96a-1574-3835-8455-bf662701a971",
                                "text": "Czasem w trakcie pracy nad miksem możemy zauważyć, że przesadziliśmy z pogłosem"
                            },
                            {
                                "example_id": "a98fc321-ee07-47c3-a6f6-29f6369c458d",
                                "sense_id": "7450f96a-1574-3835-8455-bf662701a971",
                                "text": "Przyszła pora na omówienie jednego z najbardziej nadużywanych efektów przez młodych producentów. Tak, mowa o pogłosie"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0bbe8d9-7fc0-43ec-b66d-feb85ffb70ec",
                        "source_entry_id": "d3ec5ee8-5db7-3bd5-ae5b-6076421f48ab",
                        "source_sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                        "target_lang_word": "aftersound",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aftersound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c79392-6366-39f2-8990-5f1e8fcd4d15",
                                        "entry_id": "f4f4ad56-3ea9-3e54-9681-19478db51d88",
                                        "glosses": [
                                            "A sound that persists or remains audible after its source has ceased to produce it; the perception of such a sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f528e173-7c07-4845-8aef-434f4213799e",
                                                "sense_id": "a8c79392-6366-39f2-8990-5f1e8fcd4d15",
                                                "text": "[…] the strings of an instrument, […] being strucken with the hand, do verberate the ayre in its first sound, and are reverberated by the ayre to an after-sound."
                                            },
                                            {
                                                "example_id": "cfa95611-317f-464e-81d6-deb23201016b",
                                                "sense_id": "a8c79392-6366-39f2-8990-5f1e8fcd4d15",
                                                "text": "He fired the Winchester twice again, into the distance, then lowered it, the ringing aftersound of the gunfire in his ears."
                                            },
                                            {
                                                "example_id": "d9936e74-41a7-457e-a423-fe0c3a4ffc13",
                                                "sense_id": "a8c79392-6366-39f2-8990-5f1e8fcd4d15",
                                                "text": "Edward was awakened that night by a loud clattering noise which left an after-sound of high ringing."
                                            },
                                            {
                                                "example_id": "3ca27234-56fd-413d-b421-2fb64e6fd3d3",
                                                "sense_id": "a8c79392-6366-39f2-8990-5f1e8fcd4d15",
                                                "text": "And the aftersound of the music played in the light-filled drawing room would grow closer to pure silence each year, until time ended."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55de67fe-eefd-3c48-b678-5baccdfe5949",
                                        "entry_id": "f4f4ad56-3ea9-3e54-9681-19478db51d88",
                                        "glosses": [
                                            "The second, slower phase of decay in the sound made by a piano string when it is struck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d1e1bb5-b681-3844-9861-f8d5ba0f3288",
                                        "entry_id": "f4f4ad56-3ea9-3e54-9681-19478db51d88",
                                        "glosses": [
                                            "A weaker sound that immediately follows a more salient one, such as the second, less prominent vowel sound in a falling diphthong."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7722d1b5-c150-4e99-9a05-4a5ce0fce7bd",
                                                "sense_id": "9d1e1bb5-b681-3844-9861-f8d5ba0f3288",
                                                "text": "1881, Louis Lucien Bonaparte, “The simple sounds of all the living Slavonic languages compared with those of the principal Neo-Latin and Germano-Scandinavian Tongues,” Transactions of the Philological Society, 1880-1881, p. 377,\nIn English I cannot hear the sound of Italian o chiuso, but only that of (o 5) followed by an aftersound, as in home, or without this aftersound, as in more."
                                            },
                                            {
                                                "example_id": "7ac8fe68-f915-48d5-b404-4d40bba4e3a4",
                                                "sense_id": "9d1e1bb5-b681-3844-9861-f8d5ba0f3288",
                                                "text": "They [gu and qu] were not groups formed of a guttural stop and the semi-vowel v, but guttural stops with a labial aftersound; the latter receiving a very much weaker articulation than the semi-vowel v."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1351b1af-01c7-4841-b9de-5d2c325beef1",
                        "source_entry_id": "d3ec5ee8-5db7-3bd5-ae5b-6076421f48ab",
                        "source_sense_id": "7450f96a-1574-3835-8455-bf662701a971",
