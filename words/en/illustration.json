{
    "word_family": [
        "illustrate",
        "illustrator",
        "illustrative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6463827e-9253-38c6-8715-8760e8da3221",
                    "sense_definition": "A picture, drawing, or diagram in a book, magazine, or other publication, used to explain the text or make it look attractive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>illustration</w> showing the water cycle made the concept much easier for the children to understand.",
                            "target_lang_translations": {
                                "ru": "<w>Иллюстрация</w>, показывающая круговорот воды, помогла детям гораздо легче понять эту концепцию.",
                                "zh": "那张展示水循环的<w>插图</w>让孩子们更容易理解这个概念。"
                            }
                        },
                        {
                            "text": "This book contains a beautiful full-color <w>illustration</w> on almost every page.",
                            "target_lang_translations": {
                                "ru": "В этой книге почти на каждой странице есть красивая цветная <w>иллюстрация</w>.",
                                "zh": "这本书几乎每一页都有精美的全彩<w>插图</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "picture",
                        "drawing",
                        "image",
                        "sketch",
                        "figure",
                        "diagram"
                    ],
                    "common_phrases": [
                        "book illustration",
                        "graphic illustration",
                        "full-page illustration",
                        "medical illustration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рисунок, фотография или схема в книге, журнале или другой публикации, используемые для пояснения текста или его украшения.",
                        "zh": "书刊或出版物中用于解释文字或美化版面的图片、绘图或图表。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иллюстрация",
                                "target_lang_sense_clarification": "рисунок в тексте"
                            },
                            {
                                "target_lang_word": "рисунок",
                                "target_lang_sense_clarification": "изображение"
                            },
                            {
                                "target_lang_word": "картинка",
                                "target_lang_sense_clarification": "разг. изображение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "插图",
                                "target_lang_sense_clarification": "书刊中的图画"
                            },
                            {
                                "target_lang_word": "图示",
                                "target_lang_sense_clarification": "用于说明的图表"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "796170bb-3692-335e-99fe-4734240b4b0c",
                    "sense_definition": "An example, event, or comparison that clarifies a statement or shows that something is true.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recent power outage serves as a clear <w>illustration</w> of why we need to upgrade the infrastructure.",
                            "target_lang_translations": {
                                "ru": "Недавнее отключение электричества служит наглядной <w>иллюстрацией</w> того, почему нам необходимо модернизировать инфраструктуру.",
                                "zh": "最近的停电事故就是一个明确的<w>例证</w>，说明了我们为什么要升级基础设施。"
                            }
                        },
                        {
                            "text": "He offered a simple <w>illustration</w> to explain how the new software organizes files.",
                            "target_lang_translations": {
                                "ru": "Он привел простой <w>пример</w>, чтобы объяснить, как новое программное обеспечение упорядочивает файлы.",
                                "zh": "他举了一个简单的<w>例子</w>来解释新软件是如何整理文件的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "example",
                        "instance",
                        "demonstration",
                        "case",
                        "exemplification"
                    ],
                    "common_phrases": [
                        "by way of illustration",
                        "serve as an illustration",
                        "clear illustration",
                        "perfect illustration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пример, событие или сравнение, которые проясняют утверждение или служат доказательством чего-либо.",
                        "zh": "用于阐明观点或证明某事属实的例子、事件或比较。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пример",
                                "target_lang_sense_clarification": "случай, образец"
                            },
                            {
                                "target_lang_word": "иллюстрация",
                                "target_lang_sense_clarification": "наглядный пример"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "例证",
                                "target_lang_sense_clarification": "作为证据的例子"
                            },
                            {
                                "target_lang_word": "例子",
                                "target_lang_sense_clarification": "说明问题的实例"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f59220f-a755-3841-b4a6-6640203113cf",
                    "sense_definition": "The act of explaining something or making it clear, often by using examples or pictures.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor devoted the entire lecture to the <w>illustration</w> of complex physical theories.",
                            "target_lang_translations": {
                                "ru": "Профессор посвятил всю лекцию <w>иллюстрации</w> (разъяснению) сложных физических теорий.",
                                "zh": "教授用整堂课的时间来<w>阐明</w>复杂的物理理论。"
                            }
                        },
                        {
                            "text": "Her <w>illustration</w> of the problem was so effective that everyone immediately understood the solution.",
                            "target_lang_translations": {
                                "ru": "Ее <w>иллюстрация</w> (описание) проблемы была настолько эффективной, что все сразу поняли решение.",
                                "zh": "她对这个问题的<w>阐明</w>非常有效，大家立刻就明白了解决方案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "explanation",
                        "clarification",
                        "demonstration",
                        "elucidation"
                    ],
                    "antonyms": [
                        "obfuscation"
                    ],
                    "common_phrases": [
                        "for the illustration of",
                        "illustration of the concept"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс пояснения чего-либо или придания ясности, часто с использованием примеров или изображений.",
                        "zh": "通过使用例子或图片来解释某事或使其清晰的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иллюстрирование",
                                "target_lang_sense_clarification": "процесс пояснения"
                            },
                            {
                                "target_lang_word": "разъяснение",
                                "target_lang_sense_clarification": "пояснение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阐明",
                                "target_lang_sense_clarification": "解释清楚"
                            },
                            {
                                "target_lang_word": "演示",
                                "target_lang_sense_clarification": "通过展示来解释"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bdc5190-e2d9-3d1d-abf8-19d2b4868c37",
                    "sense_definition": "A detailed calculation or projection showing how an insurance policy is expected to perform over time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agent provided a benefit <w>illustration</w> to show the potential growth of the policy's cash value.",
                            "target_lang_translations": {
                                "ru": "Агент предоставил <w>расчет</w> выплат, чтобы показать потенциальный рост денежной стоимости полиса.",
                                "zh": "代理人提供了一份利益<w>测算</w>，以展示保单现金价值的潜在增长。"
                            }
                        },
                        {
                            "text": "You should carefully review the premium <w>illustration</w> before signing the life insurance contract.",
                            "target_lang_translations": {
                                "ru": "Вам следует внимательно изучить <w>расчет</w> страховых взносов перед подписанием договора страхования жизни.",
                                "zh": "在签署人寿保险合同之前，你应该仔细查看保费<w>测算</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "projection"
                    ],
                    "common_phrases": [
                        "benefit illustration",
                        "policy illustration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детальный расчет или прогноз, показывающий ожидаемые показатели страхового полиса с течением времени.",
                        "zh": "显示保险单随时间推移预期表现的详细计算或预测。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расчет",
                                "target_lang_sense_clarification": "финансовый прогноз"
                            },
                            {
                                "target_lang_word": "иллюстрация",
                                "target_lang_sense_clarification": "документ с расчетами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "测算",
                                "target_lang_sense_clarification": "财务预测"
                            },
                            {
                                "target_lang_word": "演示表",
                                "target_lang_sense_clarification": "保险收益预测表"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}