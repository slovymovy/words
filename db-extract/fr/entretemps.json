                                            {
                                                "example_id": "45a4886e-db8d-4ba2-b16e-f8bb8fff745f",
                                                "sense_id": "2bcf8e22-c5fd-3ef4-9819-168713b73fce",
                                                "text": "Ik ga stofzuigen, zet jij intussen even koffie?"
                                            },
                                            {
                                                "example_id": "f5ccb93c-5679-4fd3-b347-383d6086d4a6",
                                                "sense_id": "2bcf8e22-c5fd-3ef4-9819-168713b73fce",
                                                "text": "De mensen die dachten dat de oorlog snel voorbij zou zijn, waren intussen al lang dood."
                                            },
                                            {
                                                "example_id": "af40a713-8dee-49bf-81e0-e6d2d7effa1d",
                                                "sense_id": "2bcf8e22-c5fd-3ef4-9819-168713b73fce",
                                                "text": "Ze heeft haar benen intussen gespreid en kreunt zachtjes."
                                            },
                                            {
                                                "example_id": "5685694a-79af-4f01-8d41-77af787d78bd",
                                                "sense_id": "2bcf8e22-c5fd-3ef4-9819-168713b73fce",
                                                "text": "De Franse cameraploeg maakt intussen opnamen voor een documentaire over de Italiaanse natuurkundige en neutrino- onderzoeker Ettore Majorana, gespeeld door acteur Laurent Mothe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
