                "word": "misty",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6e42f31f-206e-456a-bcba-a16d64580917",
                        "entry_id": "eac035b3-165d-3fda-83fe-478308575fc6",
                        "tags": [
                            "comparative"
                        ],
                        "form": "mistier"
                    },
                    {
                        "form_id": "44179e10-d94b-4491-bf55-d8670374b406",
                        "entry_id": "eac035b3-165d-3fda-83fe-478308575fc6",
                        "tags": [
                            "superlative"
                        ],
                        "form": "mistiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e03909f-16e2-37f9-90d7-267ab18925ef",
                        "entry_id": "eac035b3-165d-3fda-83fe-478308575fc6",
                        "glosses": [
                            "Covered in mist; foggy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78c135c2-0394-4923-93df-4ba05f5c8337",
                                "sense_id": "6e03909f-16e2-37f9-90d7-267ab18925ef",
                                "text": "It's very misty this morning; I can't see a thing!"
                            }
                        ]
                    },
                    {
                        "sense_id": "92f8ad94-2351-3e22-987b-ca3c7cf58a10",
                        "entry_id": "eac035b3-165d-3fda-83fe-478308575fc6",
                        "glosses": [
                            "Dim; vague; obscure."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9d97ee3c-42b7-49f1-b1c4-7ad641913997",
                                "sense_id": "92f8ad94-2351-3e22-987b-ca3c7cf58a10",
                                "text": "My remembrances of the place and its people are misty — all about it seem more like something I once saw in a dream, but whose characters time has effaced."
                            },
                            {
                                "example_id": "e6d965d8-2317-4563-bb9f-9cc9eb06b58a",
                                "sense_id": "92f8ad94-2351-3e22-987b-ca3c7cf58a10",
                                "text": "Mr. Motian's own tunes, folk-simple locomotions of straight melody, fast or slow, with acres of room for interpretation, have accounted for some of the mistier sets."
                            },
                            {
                                "example_id": "f3dc852a-b3d9-4b9c-b67f-c20187703f6c",
                                "sense_id": "92f8ad94-2351-3e22-987b-ca3c7cf58a10",
                                "text": "a misty memory of his childhood"
                            },
                            {
                                "example_id": "06bc4911-c34c-499c-945a-f56cbcb0d03a",
                                "sense_id": "92f8ad94-2351-3e22-987b-ca3c7cf58a10",
                                "text": "But she soon found out how little equipped she was for college study. Not only was Ms. Segovia’s English rocky, but she had only the mistiest notions of what college was all about."
                            }
                        ]
                    },
                    {
                        "sense_id": "588c950d-085a-38f9-82e1-024ae185a44e",
                        "entry_id": "eac035b3-165d-3fda-83fe-478308575fc6",
                        "glosses": [
                            "With tears in the eyes; dewy-eyed."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bebc9a9e-2771-47ce-9b52-aa970c832d0b",
                                "sense_id": "588c950d-085a-38f9-82e1-024ae185a44e",
                                "text": "Her eyes grew misty the night her long-time friend passed away."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af1fd03b-d964-4bfd-99a7-ee6ced62cdc4",
                        "source_entry_id": "eac035b3-165d-3fda-83fe-478308575fc6",
                        "source_sense_description": "with mist; foggy",
                        "target_lang_word": "mistig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
