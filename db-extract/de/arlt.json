                ],
                "senses": [
                    {
                        "sense_id": "8d5ac052-3da6-3474-ad3c-429e341e4867",
                        "entry_id": "3c7c516d-0d2a-3481-8ac3-7af81f6cd4f3",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84c56842-fcb0-481e-bbee-7316f4f5fbcf",
                                "sense_id": "8d5ac052-3da6-3474-ad3c-429e341e4867",
                                "text": "Arlts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "8231a8fe-9de1-43c7-9179-90ab37887506",
                                "sense_id": "8d5ac052-3da6-3474-ad3c-429e341e4867",
                                "text": "Der Arlt trägt nie die Schals, die die Arlt ihm strickt."
                            },
                            {
                                "example_id": "733b8cbc-31b6-4202-8a53-87150142a521",
                                "sense_id": "8d5ac052-3da6-3474-ad3c-429e341e4867",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Arlt kommt, geht der Herr Arlt.“"
                            },
                            {
                                "example_id": "0586c93c-1dd5-4527-af57-a993705e2b7b",
                                "sense_id": "8d5ac052-3da6-3474-ad3c-429e341e4867",
                                "text": "Arlt kommt und geht."
                            },
                            {
                                "example_id": "21df4a55-8af8-419e-a6b7-1d669d0a1ee8",
                                "sense_id": "8d5ac052-3da6-3474-ad3c-429e341e4867",
                                "text": "Frau Arlt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d40c49e8-22a8-46ec-ae8e-551f1510fd4d",
                                "sense_id": "8d5ac052-3da6-3474-ad3c-429e341e4867",
                                "text": "Herr Arlt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e9d128f6-a1e6-47c8-ae91-222bde6d2aa2",
                                "sense_id": "8d5ac052-3da6-3474-ad3c-429e341e4867",
                                "text": "Die Arlts kommen heute von Nordstrand."
                            },
                            {
                                "example_id": "0eff38df-10c5-4009-bbbf-78c135abc76d",
                                "sense_id": "8d5ac052-3da6-3474-ad3c-429e341e4867",
                                "text": "An verregneten Herbsttagen ist Familie Arlts liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "9f8495e7-0cac-4521-a1f8-8a03f68193b0",
                                "sense_id": "8d5ac052-3da6-3474-ad3c-429e341e4867",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Arlt das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
