                ],
                "senses": [
                    {
                        "sense_id": "62c20bb9-f44d-3e37-a1da-b7075741660e",
                        "entry_id": "30207aa9-62b8-34bd-8d03-d84ced9f7151",
                        "glosses": [
                            "Nom d’un genre d’oiseaux palmipèdes plongeurs des genres Uria et Cepphus nichant en colonies sur les côtes Arctiques et Atlantiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c91eba-420c-4a9f-9e8e-4dd189239ab4",
                                "sense_id": "62c20bb9-f44d-3e37-a1da-b7075741660e",
                                "text": "— Allons, se dit-il, la chasse aux guillemots est captivante, la roche où on les massacre est lointaine…"
                            },
                            {
                                "example_id": "c15be55b-8b09-497f-8a45-629346c45ea7",
                                "sense_id": "62c20bb9-f44d-3e37-a1da-b7075741660e",
                                "text": "Le guillemot, reconnaissable à ses pattes orange et à son cri lugubre, passa comme une flèche au-dessus du currach."
                            }
                        ]
                    },
                    {
                        "sense_id": "b310321e-77d0-35ce-8869-ad4684e571ee",
                        "entry_id": "30207aa9-62b8-34bd-8d03-d84ced9f7151",
                        "glosses": [
                            "Variété de raisin ^([1])."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55e33cbe-1a8e-40f8-96ed-545dbb90bcac",
                        "source_entry_id": "30207aa9-62b8-34bd-8d03-d84ced9f7151",
                        "source_sense_description": "Oiseau.",
                        "target_lang_word": "Lumme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lumme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4d2fa81-c1e6-3f1a-844b-17b22911fcd4",
                                        "entry_id": "8db278f1-ce34-3965-8e15-ad8b50392d6d",
                                        "glosses": [
                                            "auf der Nordhalbkugel weit verbreiteter Meeresvogel, bei denen die Oberseite schwarz und die Unterseite weiß gefärbt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35788863-0b61-4433-b3ce-c0e8648f8bdf",
                                                "sense_id": "e4d2fa81-c1e6-3f1a-844b-17b22911fcd4",
                                                "text": "„Er hatte während der letzten Tage Wurzeln und Kräuter gegessen, auch mit glücklichen Schüssen zwei Lummen erlegt; aber er konnte nur das frische, warme Blut der Vögel trinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "775067a2-9560-4ba3-aeae-017f69ab0ebb",
                        "source_entry_id": "30207aa9-62b8-34bd-8d03-d84ced9f7151",
                        "source_sense_description": "Oiseau.",
                        "target_lang_word": "murre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "murre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2a633cf-ff4e-3493-bc5d-3995fb18d6cb",
                                        "entry_id": "35e5aac3-7a85-316e-9b0b-3100528fd927",
                                        "glosses": [
                                            "Any seabird of the genus Uria in the family Alcidae (the auks)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb36cd8-1433-4a60-aaa5-655e47580024",
                                                "sense_id": "a2a633cf-ff4e-3493-bc5d-3995fb18d6cb",
                                                "text": "It may be that in one year alone, the Farallon murre population was reduced to the level at which it stood during the mid-1990s"
                                            },
                                            {
                                                "example_id": "33e686f5-f253-4329-876d-12eabdcb64c6",
                                                "sense_id": "a2a633cf-ff4e-3493-bc5d-3995fb18d6cb",
                                                "text": "1997, Robert Wayne Campbell, Neil K. Dawe, The Birds of British Columbia, Volume 2: Nonpasserines: Diurnal birds of prey through woodpeckers, page 296,\nAbout 2,800 pairs of Common Murres breed in the province, most of which are in the Scott Islands off northwestern Vancouver Island."
                                            },
                                            {
                                                "example_id": "fad52859-3963-44d8-86fe-bba462dd8d2d",
                                                "sense_id": "a2a633cf-ff4e-3493-bc5d-3995fb18d6cb",
                                                "text": "2000, Susan Allport, The Primal Feast: Food, Sex, Foraging, and Love, 2003, paperback, page 52,\nStaking out a spot involves not only the appropriate level of murre aggression (some murres are so aggressive that they throw their mates off the ledge) but, even more fundamentally, the ability to find food efficiently."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
