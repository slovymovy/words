                "senses": [
                    {
                        "sense_id": "0562bad5-0fbb-3149-aa8a-4051aafc3cf1",
                        "entry_id": "c6f2ab2c-adb0-3d6d-9fdc-66a4a04a45ce",
                        "glosses": [
                            "Liste einzelner Gespräche in einem Abrechnungszeitraum"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "11eb13e6-c9c0-4ce6-ad87-d68ba3eb30ba",
                                "sense_id": "0562bad5-0fbb-3149-aa8a-4051aafc3cf1",
                                "text": "Auf Wunsch des Konsumenten müsse auch ein kostenloser Einzelgesprächsnachweis erstellt werden."
                            },
                            {
                                "example_id": "4a67c968-f0b3-4c6e-b2e5-8a682f378d76",
                                "sense_id": "0562bad5-0fbb-3149-aa8a-4051aafc3cf1",
                                "text": "Im Einzelgesprächsnachweis werden in zeitlicher Reihenfolge alle Verbindungen aufgelistet, für die Ihr Anbieter ein Entgelt verrechnet hat. Dazu zählen alle Sprachverbindungen, SMS und Datenverbindungen eines bestimmten Abrechnungszeitraumes."
                            },
                            {
                                "example_id": "cbdde6fb-be70-4d42-899a-9c870306ccbf",
                                "sense_id": "0562bad5-0fbb-3149-aa8a-4051aafc3cf1",
                                "text": "„Sonst würden die Einzelgesprächsnachweise ja geschwärzt.“"
                            },
                            {
                                "example_id": "2956732d-20e4-41a6-b5a2-e204171aa086",
                                "sense_id": "0562bad5-0fbb-3149-aa8a-4051aafc3cf1",
                                "text": "„Telefoniert ein Polizeibeamter innerhalb eines Jahres etwa 117 Stunden vom Telefon in seiner Dienststelle privat (der Einzelgesprächsnachweis listete 424 private Telefonate mit einem Aufwand von 263 Euro auf), so schädigt er seinen Dienstherrn dermaßen, dass er sich in seinem statusrechtlichen Amt disqualifiziert hat.“"
                            },
                            {
                                "example_id": "3fa32061-ac7a-489c-8a08-edde7ebd4fff",
                                "sense_id": "0562bad5-0fbb-3149-aa8a-4051aafc3cf1",
                                "text": "„Taucht bei iPhone-Nutzern eine unbekannte SMS nach England im Einzelgesprächsnachweis auf, könnte es sich dabei um die Aktivierungs-SMS für iMessage oder Facetime handeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
