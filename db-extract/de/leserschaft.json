                "senses": [
                    {
                        "sense_id": "ce82446e-7a8a-3cd7-83ef-36c323b951fe",
                        "entry_id": "c066fc0b-edb0-328e-b9ad-ab5e119e51e0",
                        "glosses": [
                            "Gesamtheit aller Leserinnen und Leser bestimmter Publikationen/Publikationsorgane"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f1b598c-e8f5-465e-87ad-117ddb2dfdab",
                                "sense_id": "ce82446e-7a8a-3cd7-83ef-36c323b951fe",
                                "text": "„Sie konnten also ein breites Interesse ihrer Leserschaft voraussetzen […].“"
                            },
                            {
                                "example_id": "b0eaf027-b7df-49e9-9a83-0282cfd01062",
                                "sense_id": "ce82446e-7a8a-3cd7-83ef-36c323b951fe",
                                "text": "„Wie man damit die Leserschaft abhängig macht, wusste schon Charles Dickens, der so gut wie alle seine Romane kapitelweise herausbrachte.“"
                            },
                            {
                                "example_id": "241b0504-44a0-400b-b725-46e595cb0f62",
                                "sense_id": "ce82446e-7a8a-3cd7-83ef-36c323b951fe",
                                "text": "„Einer drohenden und heiklen Frage meiner Leserschaft möchte ich hier nicht ausweichen.“"
                            },
                            {
                                "example_id": "66f169c4-5bf5-46fb-b683-07602564bd59",
                                "sense_id": "ce82446e-7a8a-3cd7-83ef-36c323b951fe",
                                "text": "„Die Leserschaft dieser Bücher lebte mehrheitlich in Mittel- und Osteuropa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3090db93-0edb-4d42-9624-e8faa42efeb3",
                        "source_entry_id": "c066fc0b-edb0-328e-b9ad-ab5e119e51e0",
                        "source_sense_id": "ce82446e-7a8a-3cd7-83ef-36c323b951fe",
                        "source_sense_description": "Gesamtheit aller Leserinnen und Leser bestimmter Publikationen/Publikationsorgane",
                        "target_lang_word": "lectorat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lectorat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a3693a2-b0bf-374b-803a-156ecff07439",
                                        "entry_id": "3cfea062-4b3d-30a7-99f6-11aa6dc643cd",
                                        "glosses": [
                                            "Ensemble des personnes ayant lu un livre, un auteur."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1a198c9-9abd-4cb2-b1b7-7be8835d2b80",
                                                "sense_id": "2a3693a2-b0bf-374b-803a-156ecff07439",
                                                "text": "Dan Brown a touché un nerf à vif dans la majeure partie de son lectorat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f843fa94-74ef-3da2-af4d-54c702da3e2a",
                                        "entry_id": "3cfea062-4b3d-30a7-99f6-11aa6dc643cd",
                                        "glosses": [
                                            "Ministère (jusqu’au concile Vatican II : ordre mineur) dans l’Église consistant en la mission de lire la parole divine devant l’assemblée lors des célébrations liturgiques"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed1fd7c-e3d3-4f67-8892-1b054ba5f8c9",
                                                "sense_id": "f843fa94-74ef-3da2-af4d-54c702da3e2a",
                                                "text": "Bouchex distingue différents niveaux : d’abord le ministère général que constitue la vie des chrétiens et les initiatives spontanées et passagères que certains d’entre eux prennent; ensuite il y a les responsabilités bien déterminées et d’une importance vitale, assumées pour un certain temps et reconnues comme telles; puis, il y a les ministères institués (le lectorat, l’acolytat) et finalement les ministères ordonnés (épiscopat, presbytérat et diaconat)."
                                            },
                                            {
                                                "example_id": "b1cb6f2b-888b-4daf-86f8-6acaa77791bb",
                                                "sense_id": "f843fa94-74ef-3da2-af4d-54c702da3e2a",
                                                "text": "Par le motu proprio Spiritus Domini du 20 jan. 2021, le pape François a supprimé la clause de réservation aux hommes des ministères institués du lectorat et de l’acolytat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
