{
    "word_family": [
        "sprouter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c2fdca2-6b17-386f-a46b-8857e3de1a7a",
                    "sense_definition": "A new growth of or on a plant, whether from seed or other parts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tree showed a new <w>sprout</w> after the spring rain.",
                            "target_lang_translations": {
                                "ru": "После весеннего дождя на дереве появился новый <w>росто́к</w>."
                            }
                        },
                        {
                            "text": "Every green <w>sprout</w> was carefully protected from the frost.",
                            "target_lang_translations": {
                                "ru": "Каждый зеленый <w>росто́к</w> был тщательно защищен от заморозков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "green sprout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новый отросток на растении, появляющийся из семени или других частей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "росто́к",
                                "target_lang_sense_clarification": "молодой стебель растения в начале развития"
                            },
                            {
                                "target_lang_word": "побе́г",
                                "target_lang_sense_clarification": "молодая ветка или стебель с почками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c2bd1f9-3649-3a09-adbe-bf9711592842",
                    "sense_definition": "A germinated seed or an incipient young plant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tiny <w>sprout</w> pushed through the soil.",
                            "target_lang_translations": {
                                "ru": "Крошечный <w>росто́к</w> пробился сквозь почву."
                            }
                        },
                        {
                            "text": "I watched the <w>sprout</w> grow into a healthy plant.",
                            "target_lang_translations": {
                                "ru": "Я наблюдал, как <w>росто́к</w> превращается в здоровое растение."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проросшее семя или молодое растение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "росто́к",
                                "target_lang_sense_clarification": "молодое растение, только что пробившееся из семени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10729727-2492-3b47-bfa0-62dbc3baa71d",
                    "sense_definition": "An edible variety of a germinated seed, grown and intended as food.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Add a handful of fresh <w>sprouts</w> to your salad for extra crunch.",
                            "target_lang_translations": {
                                "ru": "Добавьте горсть свежих <w>проростков</w> в салат для дополнительного хруста."
                            }
                        },
                        {
                            "text": "These bean <w>sprouts</w> are very healthy and delicious.",
                            "target_lang_translations": {
                                "ru": "Эти <w>проростки</w> фасоли очень полезны и вкусны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bean sprouts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съедобные пророщенные семена, употребляемые в пищу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проростки",
                                "target_lang_sense_clarification": "пророщенные семена, используемые как продукт питания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68c0db36-02eb-3dc5-9fb9-7aaa37d851d5",
                    "sense_definition": "A Brussels sprout.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many children do not like to eat their <w>sprouts</w> at dinner.",
                            "target_lang_translations": {
                                "ru": "Многие дети не любят есть <w>брюссельскую капусту</w> на ужин."
                            }
                        },
                        {
                            "text": "We served roasted <w>sprouts</w> as a side dish for the holiday meal.",
                            "target_lang_translations": {
                                "ru": "Мы подали запеченную <w>брюссельскую капусту</w> в качестве гарнира к праздничному столу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eat sprouts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Брюссельская капуста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брюссельская капуста",
                                "target_lang_sense_clarification": "вид овоща"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01eee2f2-fe72-33fa-8149-991974b2c7c6",
                    "sense_definition": "A child.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Look at how much your little <w>sprouts</w> have grown this year.",
                            "target_lang_translations": {
                                "ru": "Посмотри, как сильно выросли твои маленькие <w>детки</w> в этом году."
                            }
                        },
                        {
                            "text": "The house is always noisy with all those <w>sprouts</w> running around.",
                            "target_lang_translations": {
                                "ru": "В доме всегда шумно из-за всех этих бегающих <w>детишек</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used affectionately or humorously to refer to children."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ребенок (разговорное, ласковое или шутливое обращение)."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "728d9279-b126-3046-a202-17d0ebde5577",
                    "sense_definition": "To grow from seed; to germinate.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seeds will <w>sprout</w> quickly if you keep them warm.",
                            "target_lang_translations": {
                                "ru": "Семена быстро <w>прорастут</w>, если держать их в тепле."
                            }
                        },
                        {
                            "text": "Watch the seeds <w>sprout</w> in the damp paper towel.",
                            "target_lang_translations": {
                                "ru": "Посмотрите, как семена <w>прорастают</w> на влажном бумажном полотенце."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seeds sprout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать расти из семени; прорастать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорастать",
                                "target_lang_sense_clarification": "давать росток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b253f591-74f2-3004-856e-b69db7d68696",
                    "sense_definition": "To emerge or appear suddenly and in large numbers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New cafes <w>sprout</w> up in the city center every month.",
                            "target_lang_translations": {
                                "ru": "Каждый месяц в центре города <w>вырастают</w> новые кафе."
                            }
                        },
                        {
                            "text": "Luxury hotels have <w>sprouted</w> up along the coastline recently.",
                            "target_lang_translations": {
                                "ru": "В последнее время вдоль побережья <w>выросли</w> роскошные отели."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sprout up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно появляться в большом количестве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырастать",
                                "target_lang_sense_clarification": "появляться в большом количестве"
                            },
                            {
                                "target_lang_word": "появляться как грибы после дождя",
                                "target_lang_sense_clarification": "идиома для быстрого появления чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad21227d-2ba9-3f4c-ac93-a20bce900c60",
                    "sense_definition": "To emerge haphazardly from a surface.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark hairs began to <w>sprout</w> on his chin.",
                            "target_lang_translations": {
                                "ru": "На его подбородке начали <w>пробиваться</w> темные волоски."
                            }
                        },
                        {
                            "text": "Small weeds <w>sprouted</w> between the cracks in the pavement.",
                            "target_lang_translations": {
                                "ru": "Маленькие сорняки <w>проросли</w> сквозь трещины в асфальте."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочно пробиваться сквозь поверхность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробиваться",
                                "target_lang_sense_clarification": "появляться сквозь что-либо"
                            },
                            {
                                "target_lang_word": "прорастать",
                                "target_lang_sense_clarification": "появляться на поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "260eb6cb-bdb5-3591-974e-905f1c5deaa6",
                    "sense_definition": "To cause to grow from a seed.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plant_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like to <w>sprout</w> lentils in a jar on my kitchen counter.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>проращивать</w> чечевицу в банке на кухонном столе."
                            }
                        },
                        {
                            "text": "You can <w>sprout</w> many types of seeds for a healthy snack.",
                            "target_lang_translations": {
                                "ru": "Можно <w>проращивать</w> многие виды семян для полезного перекуса."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать прорастание семян."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проращивать",
                                "target_lang_sense_clarification": "создавать условия для прорастания семян"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f7d8dd6-c421-3148-ad51-da48b3510444",
                    "sense_definition": "To remove the sprouts from a vegetable.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>sprout</w> the potatoes before you boil them.",
                            "target_lang_translations": {
                                "ru": "Перед варкой картофель нужно <w>очистить от ростков</w>."
                            }
                        },
                        {
                            "text": "It is important to <w>sprout</w> old potatoes to keep them edible.",
                            "target_lang_translations": {
                                "ru": "Важно <w>удалить ростки</w> со старого картофеля, чтобы он оставался пригодным в пищу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять ростки с овощей (например, картофеля)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обламывать ростки",
                                "target_lang_sense_clarification": "удаление проросших частей с овощей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e9867f9f-1128-3f73-a934-3675aa0b3086",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the article is named Mr. <w>Sprout</w>.",
                            "target_lang_translations": {
                                "ru": "Автора статьи зовут мистер <w>Спраут</w>."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Sprout</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "На конференции я встретил женщину по имени Сара <w>Спраут</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}