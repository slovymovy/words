                        "target_lang_word": "dicotylédone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dicotylédone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f60b985-8ea9-3620-ab75-2e53efc7cb3a",
                                        "entry_id": "c50a91c8-dc06-3a0e-be37-197def59659d",
                                        "glosses": [
                                            "Dont les semences ou embryon ont deux lobes ou cotylédons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad584141-635f-450b-82cc-6ced0cc8f254",
                                                "sense_id": "3f60b985-8ea9-3620-ab75-2e53efc7cb3a",
                                                "text": "Les plantes, les végétaux dicotylédones."
                                            },
                                            {
                                                "example_id": "0b9a1027-ee21-4b4a-adeb-b332be3778ea",
                                                "sense_id": "3f60b985-8ea9-3620-ab75-2e53efc7cb3a",
                                                "text": "On sait que celles [les semences] des ménispermes (...) renferment vers leur partie supérieure un embryon dicotylédone plus petit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dicotylédone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f192cffd-9076-3793-bd2b-2d7636601396",
                                        "entry_id": "6b4dd730-ba13-3da8-9abc-5760eb45ef06",
                                        "glosses": [
                                            "Plante dont l’embryon a deux lobes ou cotylédons. Taxon paraphylétique. Nom scientifique : Magnoliopsida."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9229c245-d85b-4b8f-af8a-f325619a44ad",
                                                "sense_id": "f192cffd-9076-3793-bd2b-2d7636601396",
                                                "text": "D'autres enfin, notamment l’acide 2-4-dichlorophénoxyacétique, l’acide 2-méthyl-4-chlorophénoxyacétique, etc., provoquent une intoxication sélective de certaines Phanérogames ; à dose convenable, elles détruisent la plupart des Dicotylédones, mais ne troublent pas le développement de nombreuses Monocotylédones, en particulier, elles n'agissent guère sur les Graminées."
                                            },
                                            {
                                                "example_id": "0bbfe2e6-50f0-4145-aa91-f3deb87055be",
                                                "sense_id": "f192cffd-9076-3793-bd2b-2d7636601396",
                                                "text": "Mais nous obtenons le même rendement en complétant le désherbage par une simple application de 2,4-D, ceci en l’absence de dicotylédones !"
                                            },
                                            {
                                                "example_id": "836ebad1-1ad0-493e-8b7e-e197d58ba18e",
                                                "sense_id": "f192cffd-9076-3793-bd2b-2d7636601396",
                                                "text": "La phytotoxicité du dichlobénil à l’égard des dicotylédones aussi bien que des monocotylédones a été reconnue en 1958."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
