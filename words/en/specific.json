    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e338e8a1-1be3-3dd3-9f51-a645963929b8",
                    "sense_definition": "Clearly defined or identified; explicit and definite rather than general.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave <w>specific</w> instructions on how to handle the new software.",
                            "target_lang_translations": {
                                "ru": "Менеджер дал <w>конкретные</w> инструкции по работе с новым программным обеспечением."
                            }
                        },
                        {
                            "text": "Could you be more <w>specific</w> about what time you will arrive?",
                            "target_lang_translations": {
                                "ru": "Не могли бы вы <w>уточнить</w>, в какое время вы приедете?"
                            }
                        }
                    ],
                    "synonyms": [
                        "explicit",
                        "unambiguous",
                        "concrete",
                        "particular"
                    ],
                    "antonyms": [
                        "unspecific",
                        "general",
                        "broad",
                        "nonspecific"
                    ],
                    "common_phrases": [
                        "specific instructions",
                        "specific details",
                        "specific information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Четко определенный или идентифицированный; явный и определенный, а не общий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конкретный",
                                "target_lang_sense_clarification": "точно определенный"
                            },
                            {
                                "target_lang_word": "определенный",
                                "target_lang_sense_clarification": "установленный"
                            },
                            {
                                "target_lang_word": "точный",
                                "target_lang_sense_clarification": "детальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb323332-1811-3c93-bed1-71519723a708",
                    "sense_definition": "Intended for, or applying to, a particular thing, person, or situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This medicine is <w>specific</w> to the treatment of seasonal allergies.",
                            "target_lang_translations": {
                                "ru": "Этот препарат <w>предназначен</w> именно для лечения сезонной аллергии."
                            }
                        },
                        {
                            "text": "The training program is <w>specific</w> to the needs of senior employees.",
                            "target_lang_translations": {
                                "ru": "Программа обучения <w>ориентирована</w> на потребности сотрудников старшего звена."
                            }
                        }
                    ],
                    "synonyms": [
                        "particular",
                        "individual",
                        "peculiar"
                    ],
                    "antonyms": [
                        "universal",
                        "general-purpose",
                        "all-purpose"
                    ],
                    "common_phrases": [
                        "specific to",
                        "specific purpose",
                        "specific needs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для определенной вещи, человека или ситуации или применимый к ним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "специальный",
                                "target_lang_sense_clarification": "предназначенный для чего-то одного"
                            },
                            {
                                "target_lang_word": "характерный",
                                "target_lang_sense_clarification": "присущий только чему-то"
                            },
                            {
                                "target_lang_word": "особый",
                                "target_lang_sense_clarification": "индивидуальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbbccd33-3aa4-3fe0-9730-b96e28e0b34d",
                    "sense_definition": "Special, distinctive, or unique to a particular subject or area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher studied the <w>specific</w> challenges faced by urban schools.",
                            "target_lang_translations": {
                                "ru": "Исследователь изучил <w>специфические</w> проблемы, с которыми сталкиваются городские школы."
                            }
                        },
                        {
                            "text": "Each region has its own <w>specific</w> dialect and customs.",
                            "target_lang_translations": {
                                "ru": "В каждом регионе есть свой <w>особый</w> диалект и обычаи."
                            }
