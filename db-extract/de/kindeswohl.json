                        "sense_id": "60e66ab5-26d9-3e07-b6d6-88421ecd80f1",
                        "entry_id": "d454d685-301a-3973-9ce9-e279e595d193",
                        "glosses": [
                            "Erhaltung der körperlichen und seelischen Unversehrtheit sowie ausreichende Förderung (der Entwicklung) eines Kindes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e37e9a-6658-4621-84d7-fa3a2791a0fe",
                                "sense_id": "60e66ab5-26d9-3e07-b6d6-88421ecd80f1",
                                "text": "„Im vergangenen Jahr kam es in 129 000 Fällen zu Überprüfungen des Kindeswohls.“"
                            },
                            {
                                "example_id": "dc22b987-deb8-49f4-9393-2ab2d401fd96",
                                "sense_id": "60e66ab5-26d9-3e07-b6d6-88421ecd80f1",
                                "text": "„Das Kindeswohl muss bei jedem Gesetz vorrangig geprüft werden.“"
                            },
                            {
                                "example_id": "32c63660-0e98-4656-af3f-1f01ee176d53",
                                "sense_id": "60e66ab5-26d9-3e07-b6d6-88421ecd80f1",
                                "text": "„Wenn das Verhältnis zwischen den Eltern das Kindeswohl wesentlich beeinträchtigt, ist eine Ausnahme vom Grundsatz gerechtfertigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
