                "senses": [
                    {
                        "sense_id": "939009ee-0836-3e71-b1c7-c340292c214e",
                        "entry_id": "99237491-7e0a-3c9b-aaf2-e054344b47ce",
                        "glosses": [
                            "прост. то же, что отрубить; отделить что-либо рубящим ударом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e9cc2ec-801e-4967-922f-ec1ab89737d8",
                                "sense_id": "939009ee-0836-3e71-b1c7-c340292c214e",
                                "text": "— А вы думали, я высеку-с? Что я Илюшечку возьму да сейчас и высеку пред вами для вашего полного удовлетворения? Скоро вам это надо-с? — проговорил штабс-капитан, вдруг повернувшись к Алёше с таким жестом, как будто хотел на него броситься. — Жалею, сударь, о вашем пальчике, но не хотите ли я, прежде чем Илюшечку сечь, свои четыре пальца, сейчас же на ваших глазах, для вашего справедливого удовлетворения, вот этим самым ножом оттяпаю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "984cde35-9d57-41bb-95d0-95027ecf6638",
                        "source_entry_id": "99237491-7e0a-3c9b-aaf2-e054344b47ce",
                        "source_sense_id": "939009ee-0836-3e71-b1c7-c340292c214e",
                        "target_lang_word": "chop off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chop off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6448b1f-cfa3-380b-907b-06c29dd48bb1",
                                        "entry_id": "1df4ae55-e151-3592-8b4a-972c0e105ae7",
                                        "glosses": [
                                            "To sever by chopping or as if by chopping."
                                        ],
                                        "tags": [
                                            "literally",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "951ffb35-61c8-4aad-aba6-6c8c6c27dc2d",
                                                "sense_id": "e6448b1f-cfa3-380b-907b-06c29dd48bb1",
                                                "text": "They will chop off your head."
                                            },
                                            {
                                                "example_id": "5cb09155-2fde-4180-a62a-d37f6627cc4b",
                                                "sense_id": "e6448b1f-cfa3-380b-907b-06c29dd48bb1",
                                                "text": "We'll chop off sales from the marketing department."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94941981-76d9-3b4a-b48d-06914b43b64b",
                                        "entry_id": "1df4ae55-e151-3592-8b4a-972c0e105ae7",
                                        "glosses": [
                                            "To end (something); to finish (something)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ef226c2-7ec7-4a31-b6f6-f7140ea6d70a",
                                                "sense_id": "94941981-76d9-3b4a-b48d-06914b43b64b",
                                                "text": "When she found out what happened, she chopped off the engagement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a66a11b7-f945-44da-ba08-64b4d8b9da39",
                        "source_entry_id": "99237491-7e0a-3c9b-aaf2-e054344b47ce",
                        "source_sense_id": "939009ee-0836-3e71-b1c7-c340292c214e",
                        "target_lang_word": "cut off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cut off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7edfd5-cd08-3b52-81d9-0ca1bf67b573",
                                        "entry_id": "eb8359c3-5c0a-3439-8ab3-70ac83001e7f",
                                        "glosses": [
                                            "To remove by cutting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a9ed299-e70e-33ea-9e65-27bf99399209",
                                        "entry_id": "eb8359c3-5c0a-3439-8ab3-70ac83001e7f",
                                        "glosses": [
                                            "To isolate or remove from contact."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "812fd862-00c0-4a73-b8c1-fbfda06f226a",
                                                "sense_id": "0a9ed299-e70e-33ea-9e65-27bf99399209",
                                                "text": "The entranced spectator was cut off from reality as long as the adventure lasted; it was as if he lived a dream yet believed he was awake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78e7f737-b7e7-3feb-a554-1a3132d3837c",
                                        "entry_id": "eb8359c3-5c0a-3439-8ab3-70ac83001e7f",
                                        "glosses": [
                                            "To stop the provision or supply of something, e.g. power, water."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de298313-099f-4371-ab1e-1944d4d3fcda",
                                                "sense_id": "78e7f737-b7e7-3feb-a554-1a3132d3837c",
                                                "text": "The first English Electric units were not fitted with an anti-slip brake, but a hurried consultation of the wiring diagram showed that it should be possible to hold in the low-voltage anti-slip relay for long enough to let speed build up without cutting off the motor current."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c57cb50c-ae5d-30cc-a787-085fe26d0d83",
                                        "entry_id": "eb8359c3-5c0a-3439-8ab3-70ac83001e7f",
                                        "glosses": [
                                            "To stop providing funds or something else to (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b14d75d9-5353-479e-b20f-66d52db955f4",
                                                "sense_id": "c57cb50c-ae5d-30cc-a787-085fe26d0d83",
                                                "text": "His parents cut him off to encourage him to find a job."
                                            },
                                            {
                                                "example_id": "67cf86e7-d04b-428d-b89f-39e04409de16",
                                                "sense_id": "c57cb50c-ae5d-30cc-a787-085fe26d0d83",
                                                "text": "You're drunk, Jerry, I'm cutting you off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b9ec003-f4c8-30fc-9f18-38dfc22a5381",
                                        "entry_id": "eb8359c3-5c0a-3439-8ab3-70ac83001e7f",
                                        "glosses": [
                                            "To end abruptly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "494132d9-d628-4818-a565-6dc3bb48ded0",
                                                "sense_id": "0b9ec003-f4c8-30fc-9f18-38dfc22a5381",
                                                "text": "My phone call was cut off before I could get the information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2d53eac-ead9-3c41-a0ce-1520a59c72b2",
                                        "entry_id": "eb8359c3-5c0a-3439-8ab3-70ac83001e7f",
                                        "glosses": [
                                            "To interrupt (someone speaking)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f48eb6-24e8-46ea-aade-95a30330f443",
                                                "sense_id": "a2d53eac-ead9-3c41-a0ce-1520a59c72b2",
                                                "text": "That dingbat cut me off as I was about to conclude my thesis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1aa2718-ed2f-3970-bca6-9ce4d089bf99",
                                        "entry_id": "eb8359c3-5c0a-3439-8ab3-70ac83001e7f",
                                        "glosses": [
                                            "To swerve in front of (another car) while driving."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0289a06f-5d14-30d0-adde-c0d501283258",
                                        "entry_id": "eb8359c3-5c0a-3439-8ab3-70ac83001e7f",
                                        "glosses": [
                                            "To move so as to block someone else's movement in a direction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67018552-d1a1-47db-b332-16599b2fb9a5",
                                                "sense_id": "0289a06f-5d14-30d0-adde-c0d501283258",
                                                "text": "I ran to the house, but Sally is quicker and cut me off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60db8f84-c77d-3305-908c-62e273e3b8c9",
                                        "entry_id": "eb8359c3-5c0a-3439-8ab3-70ac83001e7f",
                                        "glosses": [
                                            "To turn off or switch off (an electrical device)."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "US",
                                            "regional",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98eb55e3-7d66-4ab0-9d4e-1e86af30ac9a",
                                                "sense_id": "60db8f84-c77d-3305-908c-62e273e3b8c9",
                                                "text": "Cut off the lamp so I can get some sleep."
                                            }
                                        ]
                                    }
                                ]
