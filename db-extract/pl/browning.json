                ],
                "senses": [
                    {
                        "sense_id": "f15605c4-73f5-396a-b961-18e1be62d828",
                        "entry_id": "034f2eb0-fbcd-3349-9e07-1663a2ece30d",
                        "glosses": [
                            "niewielki, płaski, poręczny pistolet szybkostrzelny, w okresie międzywojennym popularny jako broń „kieszonkowa”"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0be6d727-e962-40b9-88c0-c6f79988e75e",
                                "sense_id": "f15605c4-73f5-396a-b961-18e1be62d828",
                                "text": "Siedział ukosem, by nie naciskać tylnej kieszeni, którą rozpychał browning"
                            },
                            {
                                "example_id": "80e16a81-6f40-47de-809b-897f03c08de6",
                                "sense_id": "f15605c4-73f5-396a-b961-18e1be62d828",
                                "text": "Na biurku, prawie niewidoczny poza żółtym kręgiem lampy, leżał mały, czarny browning"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01e4d5ef-0695-47de-8646-e20a4d210741",
                        "source_entry_id": "034f2eb0-fbcd-3349-9e07-1663a2ece30d",
                        "source_sense_id": "f15605c4-73f5-396a-b961-18e1be62d828",
                        "target_lang_word": "браунинг",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "браунинг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "37ab8998-9e48-3d9d-b8dc-6b6f7d283b09",
                                        "entry_id": "2df7780c-506f-35d1-88cf-b6243c454345",
                                        "glosses": [
                                            "пистолет (реже — другое оружие) системы Джона Браунинга"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a0be05-8716-4023-a05f-f4b9f3929560",
                                                "sense_id": "37ab8998-9e48-3d9d-b8dc-6b6f7d283b09",
                                                "text": "Можно было, конечно, допустить, что браунинг кота — какой-нибудь игрушечный, но о маузерах пришедших этого уж никак нельзя было сказать."
                                            },
                                            {
                                                "example_id": "05c4907f-8eb6-4280-bb33-a6bb4bf6e7c7",
                                                "sense_id": "37ab8998-9e48-3d9d-b8dc-6b6f7d283b09",
                                                "text": "Погрозив кулаком кому-то невидимому, я сунул руку в карман, вынул браунинг и два раза выстрелил в воздух."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
