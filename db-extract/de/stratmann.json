                ],
                "senses": [
                    {
                        "sense_id": "845d1d32-4a0f-3c9f-aef5-0008d5930257",
                        "entry_id": "a94b9d74-26d1-3bcb-b183-37cf00dcabe5",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f98fd5d6-f521-4dd7-90b8-4e3aee690898",
                                "sense_id": "845d1d32-4a0f-3c9f-aef5-0008d5930257",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stratmann kommt, geht der Herr Stratmann.“"
                            },
                            {
                                "example_id": "18ae1e00-21b3-45c9-a529-cd31c3ec3f2b",
                                "sense_id": "845d1d32-4a0f-3c9f-aef5-0008d5930257",
                                "text": "Stratmann kommt und geht."
                            },
                            {
                                "example_id": "06705a9e-4b9e-4e9f-a1ac-a59118a1e384",
                                "sense_id": "845d1d32-4a0f-3c9f-aef5-0008d5930257",
                                "text": "Stratmanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "e7ec41ac-22fa-478b-a069-be0cfe012e47",
                                "sense_id": "845d1d32-4a0f-3c9f-aef5-0008d5930257",
                                "text": "Frau Stratmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "77da136d-e24e-4d3f-bec9-5b0bcf2a4d75",
                                "sense_id": "845d1d32-4a0f-3c9f-aef5-0008d5930257",
                                "text": "Herr Stratmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "64a7e7b4-f6b4-4e99-96d3-dd7e1fde7dc9",
                                "sense_id": "845d1d32-4a0f-3c9f-aef5-0008d5930257",
                                "text": "Die Stratmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ec066d63-5511-41f3-a7fc-83a2ea4e24bc",
                                "sense_id": "845d1d32-4a0f-3c9f-aef5-0008d5930257",
                                "text": "Der Stratmann trägt nie die Schals, die die Stratmann ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
