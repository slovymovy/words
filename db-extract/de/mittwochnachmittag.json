                "senses": [
                    {
                        "sense_id": "f16e40c0-28a7-3317-b7bf-8e9c5d8090a8",
                        "entry_id": "8643a7f9-be72-375d-81fd-add648a0f3be",
                        "glosses": [
                            "der Nachmittag eines Mittwochs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75551f28-21ee-409a-9a2c-d4d7b73c2925",
                                "sense_id": "f16e40c0-28a7-3317-b7bf-8e9c5d8090a8",
                                "text": "Mittwochnachmittag gehen wir ins Freibad."
                            },
                            {
                                "example_id": "6095a69a-d5ea-4381-ac1d-4f933850b65f",
                                "sense_id": "f16e40c0-28a7-3317-b7bf-8e9c5d8090a8",
                                "text": "Für Mittwochnachmittag bin ich schon verabredet."
                            },
                            {
                                "example_id": "b2efefe2-68ff-4ba4-8ed1-2f3af03926ed",
                                "sense_id": "f16e40c0-28a7-3317-b7bf-8e9c5d8090a8",
                                "text": "An zwei Mittwochnachmittagen im Monat versammeln die Senioren sich im Gemeindehaus."
                            },
                            {
                                "example_id": "2b912cde-9a0c-45ea-a87a-10865fc9d6a6",
                                "sense_id": "f16e40c0-28a7-3317-b7bf-8e9c5d8090a8",
                                "text": "„Der Grabstein wurde am späten Mittwochnachmittag geliefert.“"
                            },
                            {
                                "example_id": "da28a18f-8130-45de-a1eb-1be63c1cef33",
                                "sense_id": "f16e40c0-28a7-3317-b7bf-8e9c5d8090a8",
                                "text": "„Taucher des Einsatzkommandos Cobra haben am Mittwochnachmittag die Leiche einer jungen Frau aus dem Marchfeldkanal geborgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
