                                        "entry_id": "cf0c2559-019d-3afd-b1bd-32ca4b93a615",
                                        "glosses": [
                                            "Argument construit pour s’opposer à un raisonnement, à un argument donné par quelqu’un d’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71bef04a-1a8d-4618-b3bc-4612d1745194",
                                                "sense_id": "be525f9a-9524-3be0-8996-c32f08c71b67",
                                                "text": "Contre cette position, Malebranche répond par le contre-argument mentionné plus haut et affirme que dans la situation contre-factuelle « Dieu ne serait point trompeur »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8bad644-8546-4508-94e5-92157b107e85",
                        "source_entry_id": "845ef89d-d0db-3eb6-8e7a-3111ee78d70f",
                        "source_sense_id": "6140bcdf-8512-3802-bc37-b4e44e2f778c",
