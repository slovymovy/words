                {
                    "sense_id": "30d8eb75-4191-325d-ba26-6f024ff7a580",
                    "sense_definition": "Het geheel van zeilen, touwen en masten van een schip.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De klippers waren snelle schepen met een imposant <w>tuig</w>.",
                            "target_lang_translations": {
                                "en": "The clippers were fast ships with impressive <w>rigging</w>.",
                                "ru": "Клиперы были быстрыми кораблями с внушительным <w>такелажем</w>.",
                                "fr": "Les clippers étaient des navires rapides avec un <w>gréement</w> imposant."
                            }
                        },
                        {
                            "text": "Door de zware storm is het <w>tuig</w> van de boot beschadigd geraakt.",
                            "target_lang_translations": {
                                "en": "The boat's <w>rigging</w> was damaged by the severe storm.",
                                "ru": "Из-за сильного шторма <w>оснастка</w> лодки была повреждена.",
                                "fr": "À cause de la violente tempête, le <w>gréement</w> du bateau a été endommagé."
                            }
