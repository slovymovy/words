                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7d01d06-5126-4b13-b922-4648c6b349b5",
                        "source_entry_id": "78b2007e-1ab5-3432-af3c-2ab180317651",
                        "source_sense_id": "76bdf477-5f3c-3560-a0e9-f66d02e3709e",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Toilette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Toilette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c05c12aa-be14-3753-84ba-ad31b1090acb",
                                        "entry_id": "da1ec1a7-5d26-3e25-9cfe-778090e54c7d",
                                        "glosses": [
                                            "eine sanitäre Vorrichtung oder Anlage zur Aufnahme von Körperausscheidungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbdcc01b-fe86-4e2c-ba3a-3f18fe1edbca",
                                                "sense_id": "c05c12aa-be14-3753-84ba-ad31b1090acb",
                                                "text": "Ich muss mal schnell auf die Toilette."
                                            },
                                            {
                                                "example_id": "603327ca-4ba4-401b-979f-2e813d9acddf",
                                                "sense_id": "c05c12aa-be14-3753-84ba-ad31b1090acb",
                                                "text": "„Endlich fand ich eine Toilette, musste jedoch feststellen, dass die Warteschlange sich im Schneckentempo vorwärtsbewegte.“"
                                            },
                                            {
                                                "example_id": "e15fbce7-a45a-4ce3-b372-becff4e9cb85",
                                                "sense_id": "c05c12aa-be14-3753-84ba-ad31b1090acb",
                                                "text": "„Wie jeder andere in der Wohnung verbrachte ich möglichst viel Zeit auf der Toilette mit der Lektüre der neuesten Zeitschriften.“"
                                            },
                                            {
                                                "example_id": "e9409be4-57c0-4df6-99fe-af048498027a",
                                                "sense_id": "c05c12aa-be14-3753-84ba-ad31b1090acb",
                                                "text": "„Als Toilette dienen lange Balken, auf denen sich 20 Männer nebeneinander erleichtern können.“"
                                            },
                                            {
                                                "example_id": "5a71ed52-6f83-4ead-aeff-b19844b30604",
                                                "sense_id": "c05c12aa-be14-3753-84ba-ad31b1090acb",
                                                "text": "„Er hört, wie sie in die übelriechende kleine Toilette am Ende des Flurs geht, er hört sie leise husten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df46dcde-3b67-33e8-8948-2c005812068c",
                                        "entry_id": "da1ec1a7-5d26-3e25-9cfe-778090e54c7d",
                                        "glosses": [
                                            "Raum, in dem sich [1] befindet"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "129d2832-14d0-383a-ab4b-bcb09068b1d1",
                                        "entry_id": "da1ec1a7-5d26-3e25-9cfe-778090e54c7d",
                                        "glosses": [
                                            "das Sich-zurecht-Machen (Körperreinigung, Körperpflege und Ankleiden)"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5d79425-2990-428b-a88b-eeff1be9d905",
                                                "sense_id": "129d2832-14d0-383a-ab4b-bcb09068b1d1",
                                                "text": "Als ich kam, war sie noch bei der Toilette."
                                            },
                                            {
                                                "example_id": "7429e3d6-464a-48c8-b8fa-a9d75a231b6f",
                                                "sense_id": "129d2832-14d0-383a-ab4b-bcb09068b1d1",
                                                "text": "„Sie fühlt sich matt und mutlos, zwingt sich aber energisch zu einer sorgfältigen und tadellosen Toilette.“"
                                            },
                                            {
                                                "example_id": "f2629a4e-7d78-4a8f-bf57-494a0fa347d9",
                                                "sense_id": "129d2832-14d0-383a-ab4b-bcb09068b1d1",
                                                "text": "„Sonja war mit ihrer Toilette fast fertig, die Gräfin desgleichen; aber Natascha, die sich mit der Herrichtung der beiden anderen viele Mühe gemacht hatte, war noch im Rückstande.“"
                                            },
                                            {
                                                "example_id": "d7eacd14-2c1b-4674-91c7-57fb00f9701e",
                                                "sense_id": "129d2832-14d0-383a-ab4b-bcb09068b1d1",
                                                "text": "„Seine Toilette war erst halb beendet, als es klopfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9f825830-92cc-3a71-85e8-83a98f41d920",
                                        "entry_id": "da1ec1a7-5d26-3e25-9cfe-778090e54c7d",
                                        "glosses": [
                                            "festliche Kleidung (meist der Frauen)"
                                        ],
                                        "tags": [
                                            "literary",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a2af4e1-64bf-49ae-a331-986a94f69995",
                                                "sense_id": "9f825830-92cc-3a71-85e8-83a98f41d920",
                                                "text": "„Am Warenhaus Karstadt erfaßt sein Blick von der Seite den Schimmer eines großen Schaufensters voll strahlender Toiletten, seidiger Glanz von Frauen, sanfte Helle.“"
                                            },
                                            {
                                                "example_id": "7cdae311-2b31-4ff8-863d-88648eb55759",
                                                "sense_id": "9f825830-92cc-3a71-85e8-83a98f41d920",
                                                "text": "Die Gaslampen warfen eine ungeheure Lichtfülle in den Raum, Damen und Herren in großer Toilette tanzten, aßen und tranken, spielten."
                                            },
                                            {
                                                "example_id": "94e28557-2679-484e-b183-2858c5c58ab3",
                                                "sense_id": "9f825830-92cc-3a71-85e8-83a98f41d920",
                                                "text": "„Sie war in einer Toilette, wie sie sie gewöhnlich auf ihren Petersburger Gesellschaften getragen hatte, und gerade das liess es noch deutlicher werden, wieviel hässlicher sie geworden war.“"
                                            },
                                            {
                                                "example_id": "93666a64-db77-485d-ae9d-0262a1a7b6e8",
                                                "sense_id": "9f825830-92cc-3a71-85e8-83a98f41d920",
                                                "text": "„Ihre Verspätung erklärte sich aus der Sorgfalt ihrer Toilette: einem Kaschmirschal, Hut, Glacéhandschuhen, kurz, dem Gewand, das zu ernsten Angelegenheiten gehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "06a502b0-0086-330a-aca5-eef54772620b",
                                        "entry_id": "da1ec1a7-5d26-3e25-9cfe-778090e54c7d",
                                        "glosses": [
                                            "ein Kosmetiktisch oder Frisiertisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ef2d9c0-b37d-4886-b0b3-f828e7e46424",
                                                "sense_id": "06a502b0-0086-330a-aca5-eef54772620b",
                                                "text": "Im Vordergrund ist links ein Waschtisch zu sehen und rechts ein Frisiertisch (»Toilette«)."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f322fea6-973b-48a1-9087-620adde40356",
                        "source_entry_id": "78b2007e-1ab5-3432-af3c-2ab180317651",
                        "source_sense_id": "76bdf477-5f3c-3560-a0e9-f66d02e3709e",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Waschraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waschraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93c316e7-6cec-3731-96f4-e344d10a1ee5",
                                        "entry_id": "df56888c-3fac-3cee-8540-d2d152e8257c",
                                        "glosses": [
                                            "ein Raum mit Waschstellen; Raum, in dem Personen sich waschen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "857aa2c3-2c11-445b-bc35-80336e0aaa42",
                                                "sense_id": "93c316e7-6cec-3731-96f4-e344d10a1ee5",
                                                "text": "„Der Waschraum ist vier Baracken von unserer entfernt, aber die Wasserleitung ist vorläufig eingefroren.“"
                                            },
                                            {
                                                "example_id": "dc601177-e405-4aa1-9fd7-1842e28fc134",
                                                "sense_id": "93c316e7-6cec-3731-96f4-e344d10a1ee5",
                                                "text": "„Alf kam aus dem Waschraum hervor, lärmend, düster, geladen.“"
                                            },
                                            {
                                                "example_id": "33ab97bd-7124-4dd3-8519-40380776bf80",
                                                "sense_id": "93c316e7-6cec-3731-96f4-e344d10a1ee5",
                                                "text": "„Dann ging ich in den Waschraum und schüttete das kühle Wasser über mich.“"
                                            },
                                            {
                                                "example_id": "96849622-ced6-4af3-b9b6-9e1c3c0e14e2",
                                                "sense_id": "93c316e7-6cec-3731-96f4-e344d10a1ee5",
                                                "text": "„Reidel war so überrascht gewesen, daß er sich umgedreht und den Waschraum verlassen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
