                "senses": [
                    {
                        "sense_id": "8ebf2c7d-babb-3743-a49e-2300f0d52b46",
                        "entry_id": "84f69d03-324a-3753-b33a-df3a0ef8e852",
                        "glosses": [
                            "Gehalt an Gold"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db900b90-d145-42b2-bb2b-bcceaccb0163",
                                "sense_id": "8ebf2c7d-babb-3743-a49e-2300f0d52b46",
                                "text": "„Der Goldgehalt der Ozeane liegt im Bereich von 0,008 bis 4 ppb.“"
                            },
                            {
                                "example_id": "1e62a5a4-d758-48e4-a3af-8aa15592a03e",
                                "sense_id": "8ebf2c7d-babb-3743-a49e-2300f0d52b46",
                                "text": "„Mit 1,8 Millionen Dukaten Kredit seien die Welser der größte Kreditgeber des Kaisers gewesen, so Welser-Experte Jörg Denzer – heute könnte das auf Basis des Goldgehalts etwa 300 Millionen Euro entsprechen.“"
                            },
                            {
                                "example_id": "b7ca4a7b-2233-4bcc-bdc5-167eb8a99af0",
                                "sense_id": "8ebf2c7d-babb-3743-a49e-2300f0d52b46",
                                "text": "„Beim Handel Ware gegen Geld kam es dagegen auf das Vertrauen in den Silber- oder Goldgehalt der Münzen an und auf die Verlässlichkeit ihrer Wertbezeichnungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
