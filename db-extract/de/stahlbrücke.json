                        "examples": [
                            {
                                "example_id": "0b51aeb2-dee8-4645-bedd-d539704811aa",
                                "sense_id": "22eed0a9-bbcf-3248-bdd1-3cc0492383b1",
                                "text": "Die alte, baufällige Holzbrücke wurde durch eine Stahlbrücke ersetzt."
                            },
                            {
                                "example_id": "dd9657df-58c9-46bf-9a5d-c307c2e46607",
                                "sense_id": "22eed0a9-bbcf-3248-bdd1-3cc0492383b1",
                                "text": "„In der Form eines Ypsilons überspannt nun eine gigantische Stahlbrücke das Flussdelta am Südchinesischen Meer und verbindet die Finanzmetropole Hongkong mit der Glücksspielstadt Macao und der Industrieregion Zhuhai auf dem chinesischen Festland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
