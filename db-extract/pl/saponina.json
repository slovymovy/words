                "senses": [
                    {
                        "sense_id": "ae9f00ec-28a8-325f-ae98-f6d9a6c1244b",
                        "entry_id": "246d7c8e-118a-3050-83e7-b03538167bcb",
                        "glosses": [
                            "związek chemiczny należący do glikozydów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2a8a7e8-8b79-4b70-932c-4b685df44082",
                                "sense_id": "ae9f00ec-28a8-325f-ae98-f6d9a6c1244b",
                                "text": "Ciecierzyca zawiera saponiny oraz kwas fitowy, czyli substancje chroniące komórki przed czynnikami rakotwórczymi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88d4be48-c0e2-440b-9378-42b2d44ce3cd",
                        "source_entry_id": "246d7c8e-118a-3050-83e7-b03538167bcb",
                        "source_sense_id": "ae9f00ec-28a8-325f-ae98-f6d9a6c1244b",
                        "target_lang_word": "saponin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saponin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8999a3d6-edee-343a-b547-181395ec0b3c",
                                        "entry_id": "6d588eb7-1ad6-3799-b7c0-2f13fd2fb2d2",
                                        "glosses": [
                                            "Any of various steroid glycosides found in plant tissues that dissolve in water to give a soapy froth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93bf7655-e00d-4a4c-89bf-b451b26aa78a",
                                                "sense_id": "8999a3d6-edee-343a-b547-181395ec0b3c",
                                                "text": "“Saponins aren't absorbed by the intestines. You've got to get the stuff into the blood.”"
                                            },
                                            {
                                                "example_id": "3e15ba8c-7c10-4d71-8200-978be908e453",
                                                "sense_id": "8999a3d6-edee-343a-b547-181395ec0b3c",
                                                "text": "Soapnuts are the dried fruit of a tree called Sapindus mukorossi (Chinese Soapberry) and contain saponin, a natural surfactant that foams just like soap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9a9dcf9-bb71-40a7-9df5-20de65fbc43f",
                        "source_entry_id": "246d7c8e-118a-3050-83e7-b03538167bcb",
                        "source_sense_id": "ae9f00ec-28a8-325f-ae98-f6d9a6c1244b",
                        "target_lang_word": "saponine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saponine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "791aff80-8470-3e20-9a57-6d9da4542162",
                                        "entry_id": "c7ef66f6-24c4-3cec-9ad3-1f06515cb8f0",
                                        "glosses": [
                                            "Hétéroside complexe, appartenant aux terpènes cycliques ou aux stéroïdes, se trouvant chez de nombreux végétaux comme la salsepareille, la saponaire, le quinoa, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1335276-4305-4431-b936-d32fd975b719",
                                                "sense_id": "791aff80-8470-3e20-9a57-6d9da4542162",
                                                "text": "Mais il était heureux, car aux goûts qu’il percevait, il pouvait se convaincre qu’il ingérait, sous leur forme naturelle, de la coumarine et du tanin, de la saponine et d’autres glucosides, des composés du phénol, de la chlorophylle et des acides organiques, du mucus et des huiles essentielles, de l’arbutine, du sucre et bien d’autres substances chimiques encore inconnues, et il espérait que tout cela, dissous et mélangé par la salive, se combinerait pour donner une substance nouvelle et miraculeuse, qui le guérirait tout à fait."
                                            },
                                            {
                                                "example_id": "6a78e960-8620-43af-9b7d-1ebadacebef9",
                                                "sense_id": "791aff80-8470-3e20-9a57-6d9da4542162",
                                                "text": "L'adjuvant employé par Novavax est la Matrix-M, un dérivé de la saponine du bois de panama"
                                            },
                                            {
                                                "example_id": "4035f8e3-0b41-4b2a-9b99-08dffb9ff453",
                                                "sense_id": "791aff80-8470-3e20-9a57-6d9da4542162",
                                                "text": "Les essais de culture qui se multiplient aux XVIIIᵉ et XIXᵉ siècle en Europe font un bide. La faute à l’amertume et à l’âcreté de ses graines, dues à la présence de la saponine, qu’on ne peut enlever qu’après plusieurs lavages à l’eau claire. De plus, la farine tirée du quinoa n’est pas panifiable, en l’absence de gluten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
