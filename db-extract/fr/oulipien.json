                    {
                        "sense_id": "c4a94483-9b5c-3743-9fe1-057297ddce8e",
                        "entry_id": "51a4a83f-a4d8-3873-836d-4348eccbd474",
                        "glosses": [
                            "Membre de l’Ouvroir de littérature potentielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df05997c-a743-4256-88bf-11b52e9df23a",
                                "sense_id": "c4a94483-9b5c-3743-9fe1-057297ddce8e",
                                "text": "Cette affirmation est devenue un des principes fondateurs au point qu’un oulipien a pu dire : « L'OuLiPo, c’est l’anti-hasard. »"
                            },
                            {
                                "example_id": "ff218ab8-889e-436a-abb4-cd17966e7e03",
                                "sense_id": "c4a94483-9b5c-3743-9fe1-057297ddce8e",
                                "text": "Les oulipiens se sont ainsi mis à re-composer des poèmes, sur la base de modèles éprouvés, qui hésitent parfois entre la re-création et la récréation."
                            }
                        ]
                    }
                ],
