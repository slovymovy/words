                                    {
                                        "sense_id": "bf028cf6-19ff-3afb-b98a-00bc227eb294",
                                        "entry_id": "0b1bd1d3-958e-3bf6-bb21-c78eb0635efd",
                                        "glosses": [
                                            "Petit passereau granivore au bec court et conique et dont le mâle est souvent vivement coloré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1e6b09e-4514-4e09-87a2-561d0964f32a",
                                                "sense_id": "bf028cf6-19ff-3afb-b98a-00bc227eb294",
                                                "text": "Le bruant zizi ressemble au bruant jaune par la taille, la silhouette et le comportement, mais il est plus petit et plus compact."
                                            },
                                            {
                                                "example_id": "a45f039c-1ec2-49db-bb65-856906969878",
                                                "sense_id": "bf028cf6-19ff-3afb-b98a-00bc227eb294",
                                                "text": "Ce bruant construit son nid généralement au sol, souvent sur les monticules de linaigrettes (Eriophorum ssp.) et sous des gaules d’épinettes ou de mélèzes."
                                            },
                                            {
                                                "example_id": "32295822-5169-4cbf-97f0-e76fc65422ad",
                                                "sense_id": "bf028cf6-19ff-3afb-b98a-00bc227eb294",
                                                "text": "Toujours les yeux rivés au paysage, Paul repère un ou deux bruants qui sillonnent les alentours. Le bruit des corneilles ne sera pas suffisant. Il faudra sortir la bête qui jacasse à l’arrière du véhicule."
                                            }
                                        ]
                                    }
                                ]
                            }
