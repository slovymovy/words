                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d224a17e-9110-45f3-8a76-4ab451238f26",
                        "entry_id": "79156084-dd99-3cdf-80fe-3c4e5a260146",
                        "tags": [
                            "plural"
