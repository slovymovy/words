                "senses": [
                    {
                        "sense_id": "0fcc852d-bb14-3ea5-9f33-b36b3f80e7f6",
                        "entry_id": "c7158be7-e0ff-329a-8c4b-5f4df5ee0c2c",
                        "glosses": [
                            "kościelne naczynie na wodę święconą zwykle umieszczane przy wejściu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "193cb127-7131-4b98-9515-75783ae37ca3",
                                "sense_id": "0fcc852d-bb14-3ea5-9f33-b36b3f80e7f6",
                                "text": "Zanurzyłam rękę, ale w kropielnicy nie było wody."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bfe3eeed-4889-346d-9cab-d7bcf3d5e7bc",
                        "entry_id": "c7158be7-e0ff-329a-8c4b-5f4df5ee0c2c",
                        "glosses": [
                            "mały kociołek z pałąkiem do przenoszenia wody święconej podczas ceremonii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ea2c34-e5f8-4572-aeed-0d924179456c",
                                "sense_id": "bfe3eeed-4889-346d-9cab-d7bcf3d5e7bc",
                                "text": "Ceremoniarz podał diakonowi kropielnicę i kropidło."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afbafd52-2082-4e9f-b718-c8356d599e38",
                        "source_entry_id": "c7158be7-e0ff-329a-8c4b-5f4df5ee0c2c",
                        "source_sense_id": "0fcc852d-bb14-3ea5-9f33-b36b3f80e7f6",
                        "target_lang_word": "stoup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc730e28-707c-35c0-8264-61ff01d7b75e",
                                        "entry_id": "570080b0-089a-33fc-ae35-20b171821181",
                                        "glosses": [
                                            "A bucket."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "836317f2-6a9d-3532-bfbc-c0969da573a0",
                                        "entry_id": "570080b0-089a-33fc-ae35-20b171821181",
                                        "glosses": [
                                            "A mug or other drinking vessel."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad84920d-90ca-470b-9aa1-ca1a01ec2b0c",
                                                "sense_id": "836317f2-6a9d-3532-bfbc-c0969da573a0",
                                                "text": "Fetch me a stoup of liquor."
                                            },
                                            {
                                                "example_id": "c97c1dd9-d030-4c7f-89ac-119368d422f3",
                                                "sense_id": "836317f2-6a9d-3532-bfbc-c0969da573a0",
                                                "text": "Set me the Stopes of wine vpon that Table."
                                            },
                                            {
                                                "example_id": "b97aee26-8db7-45af-b92a-c32760fee300",
                                                "sense_id": "836317f2-6a9d-3532-bfbc-c0969da573a0",
                                                "text": "…we ran up stairs together without speaking, and were instantly in the apartment I had left, where a stoup of wine still stood untasted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e59c43a-d0da-31f2-869d-003df39355eb",
                                        "entry_id": "570080b0-089a-33fc-ae35-20b171821181",
                                        "glosses": [
                                            "A receptacle for holy water, especially a basin set at the entrance of a church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a97527-afd0-4418-9b57-fec93597a114",
                                                "sense_id": "9e59c43a-d0da-31f2-869d-003df39355eb",
                                                "text": "He was seen [...] bathing in the holy water stoup as if he were its single and beholden bird, pushing aside weary French maids and local tradespeople with the impatience of a soul in physical distress."
                                            },
                                            {
                                                "example_id": "8f6dd43d-7cc2-4f0d-b55a-230f9ee16f6a",
                                                "sense_id": "9e59c43a-d0da-31f2-869d-003df39355eb",
                                                "text": "But, though I liked Morgan well enough, I did not greatly care for his smell, which, incredibly, considering his agnosticism, was not unlike that of stale water in a church stoup."
                                            },
                                            {
                                                "example_id": "f546f579-2ca4-43b4-bd56-62dd5b77d9e2",
                                                "sense_id": "9e59c43a-d0da-31f2-869d-003df39355eb",
                                                "text": "She saw nobody for the moment so that she entered the church formally dipping her fingers in the holy water stoup and signing herself."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stoup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49711b0f-430e-3b66-8c48-acc234d5e12c",
                                        "entry_id": "445113ad-5a42-320d-92c7-8e4ad71ae904",
                                        "glosses": [
                                            "Obsolete form of stoop."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdf45dba-474a-4656-97b5-3ab61250e7a8",
                        "source_entry_id": "c7158be7-e0ff-329a-8c4b-5f4df5ee0c2c",
