                                "target_senses": [
                                    {
                                        "sense_id": "0d76f2a0-266f-3dee-bf88-b6990c7523a4",
                                        "entry_id": "53944507-0505-354f-9f31-41293deb6f88",
                                        "glosses": [
                                            "dwukołowy pojazd ciągnięty przez człowieka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53bf4e6b-7223-4ef4-ad46-9dfed14d4589",
                                                "sense_id": "0d76f2a0-266f-3dee-bf88-b6990c7523a4",
                                                "text": "Tak, czarodziejski jest ten świat podzwrotnikowy, jeśli się go widzi z okien kolei, samochodu lub z rikszy; nie odczuwałem tego także inaczej, kiedy przybyłem tu przed siedmiu laty"
                                            },
                                            {
                                                "example_id": "bb3047b4-7e79-4f4f-b3e4-929cc30ae8bc",
                                                "sense_id": "0d76f2a0-266f-3dee-bf88-b6990c7523a4",
                                                "text": "— Dlaczego pan nigdy nie jeździ rikszami? — zapytano mnie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "926b30bb-1481-30b1-8fca-446dfbc41c29",
                                        "entry_id": "53944507-0505-354f-9f31-41293deb6f88",
                                        "glosses": [
                                            "trójkołowy rower do przewozu bagażu lub osób"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac40a657-571b-4ce0-a750-3496b5ac1f3c",
                                                "sense_id": "926b30bb-1481-30b1-8fca-446dfbc41c29",
                                                "text": "Kauczukowe przewody od tych masek nawlekali później w roku czterdziestym, czterdziestym pierwszym, drugim na kierownice wózków rowerowych: miasto zapełniło się tłumem bezrobotnych kulisów i w użycie weszła trójkołowa riksza"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
