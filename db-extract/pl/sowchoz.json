                                        "entry_id": "c7b95e3d-0240-328f-82e6-43b800ea561f",
                                        "glosses": [
                                            "A large, state-owned farm in the Soviet Union."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f3e7d9e-56a0-4bea-bc62-2a21d093f81d",
                                                "sense_id": "235b0433-c12b-32f5-a98e-eb345d375048",
                                                "text": "The average size of a sovkhoz was 15,300 hectares (153 km²), nearly three times the average kolkhoz (5,900 hectares or 59 km² in 1990.)"
                                            }
                                        ]
                                    }
