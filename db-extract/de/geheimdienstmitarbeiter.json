                "senses": [
                    {
                        "sense_id": "46239a43-dcf3-3e5e-9c3e-092fa7169213",
                        "entry_id": "d279c589-d392-3753-bdf5-97b1dd8ad1e3",
                        "glosses": [
                            "Person, die für einen Geheimdienst tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26b3d653-2673-43c8-83d3-fb0d08cb88b5",
                                "sense_id": "46239a43-dcf3-3e5e-9c3e-092fa7169213",
                                "text": "„Bei der Betrugsprävention greifen Finanzinstitute laut der Agentur Bloomberg nun zu ungewöhnlichen Methoden und heuern zunehmend ehemalige Geheimdienstmitarbeiter an, um sogenannte \"rogue traders\" wie Jérôme Kerviel oder Nick Leeson (haben durch hochriskante Geschäfte Megaverluste eingefahren) frühzeitig zu identifizieren.“"
                            },
                            {
                                "example_id": "c09c4996-d3ca-4a79-a748-ea4533f65b35",
                                "sense_id": "46239a43-dcf3-3e5e-9c3e-092fa7169213",
                                "text": "„Die US-Justiz hat derweil zwölf russische Geheimdienstmitarbeiter wegen der Hackerangriffe während des US-Wahlkampfs 2016 unter Anklage gestellt.“"
                            },
                            {
                                "example_id": "3a2312c9-4879-48bc-8b9f-39144caf74e9",
                                "sense_id": "46239a43-dcf3-3e5e-9c3e-092fa7169213",
                                "text": "„Das Gipfeltreffen zwischen US-Präsident Donald Trump und Russlands Staatschef Wladimir Putin soll trotz der US-Anklage gegen zwölf russische Geheimdienstmitarbeiter stattfinden.“"
                            },
                            {
                                "example_id": "6c2ea3d3-bbaf-4ef4-8d00-948c4c50c323",
                                "sense_id": "46239a43-dcf3-3e5e-9c3e-092fa7169213",
                                "text": "„Ein früherer Geheimdienstmitarbeiter behauptete, das Regime habe Mugabe bewusst entkommen lassen und Smith habe ihn an die Spitze der ZANU platziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
