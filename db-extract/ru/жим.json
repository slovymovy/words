                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b78df3a-f974-4a0b-8166-4d053d08c301",
                        "source_entry_id": "f308a59e-a798-3dac-bb0e-6be15b2b7fde",
                        "source_sense_description": "действие по глаголу жать, сжимать",
                        "target_lang_word": "press",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "press",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e52a0c0-8df7-39bc-9a81-691f5af3b2d8",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "An instance of applying pressure; an instance of pressing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495122e5-7f84-4111-a9f3-c87e65cd30f3",
                                                "sense_id": "5e52a0c0-8df7-39bc-9a81-691f5af3b2d8",
                                                "text": "Connecting to the service is almost idiot proof and takes just a few button presses."
                                            },
                                            {
                                                "example_id": "12375ec0-ed28-45ab-9051-35b14ef0507a",
                                                "sense_id": "5e52a0c0-8df7-39bc-9a81-691f5af3b2d8",
                                                "text": "a slaloming winger putting lumpen defenders on their backsides, or even a sneaky centre-forward, using his boundless energy to lead the press and force mistakes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88097fdf-a70b-33e5-990f-44584c557f64",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "A device used to apply pressure to an item."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ac049b-7d7c-45fb-8686-1cef92828489",
                                                "sense_id": "88097fdf-a70b-33e5-990f-44584c557f64",
                                                "text": "a flower press"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dde0334a-b6dd-370a-a2ed-9ff229554d8a",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "A crowd."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "409cea84-5fdd-4ce2-9995-2666cbce0ae5",
                                                "sense_id": "dde0334a-b6dd-370a-a2ed-9ff229554d8a",
                                                "text": "And he sought to see Jesus who he was; and could not for the press, because he was little of stature."
                                            },
                                            {
                                                "example_id": "eca1a4cc-cb39-4be1-af21-e057fa6fde9e",
                                                "sense_id": "dde0334a-b6dd-370a-a2ed-9ff229554d8a",
                                                "text": "The press in the square grew. Something would happen now."
                                            },
                                            {
                                                "example_id": "bab975e2-8126-49d0-b5cf-f1cf0415cbc5",
                                                "sense_id": "dde0334a-b6dd-370a-a2ed-9ff229554d8a",
                                                "text": "Imagine the press of humanity in a crowded Parisian brasserie, circa the era when Lagerfeld would have been patronizing such joints."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "170d57d2-5386-3b04-8e60-80415671ba63",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "A printing machine."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cf48794-cabe-4c69-8412-67ec024fe7a2",
                                                "sense_id": "170d57d2-5386-3b04-8e60-80415671ba63",
                                                "text": "Stop the presses!"
                                            },
                                            {
                                                "example_id": "97cf4717-8fb1-4c26-a95b-4026c5f8a6e1",
                                                "sense_id": "170d57d2-5386-3b04-8e60-80415671ba63",
                                                "text": "That books are pouring off the world’s presses at unprecedented rates is a fact often alluded to as a flood that is inundating libraries and the book trades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5986a1d7-7744-3769-b758-1f250215d644",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "The print-based media (both the people and the newspapers)."
                                        ],
                                        "tags": [
                                            "collective",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b65325b-0a62-49ed-8f34-531466bec41e",
                                                "sense_id": "5986a1d7-7744-3769-b758-1f250215d644",
                                                "text": "according to a member of the press"
                                            },
                                            {
                                                "example_id": "7a9a7d5c-3976-4a14-ac55-e891599b3fb3",
                                                "sense_id": "5986a1d7-7744-3769-b758-1f250215d644",
                                                "text": "This article appeared in the press."
                                            },
                                            {
                                                "example_id": "cf6f5a3e-0fcb-49f8-893a-e967e15de9ac",
                                                "sense_id": "5986a1d7-7744-3769-b758-1f250215d644",
                                                "text": "From another point of view, it was a place without a soul. The well-to-do had hearts of stone; the rich were brutally bumptious; the Press, the Municipality, all the public men, were ridiculously, vaingloriously self-satisfied."
                                            },
                                            {
                                                "example_id": "f3610cdc-19ff-475c-baa6-629dc5bbce85",
                                                "sense_id": "5986a1d7-7744-3769-b758-1f250215d644",
                                                "text": "British journalists shun complete respectability, feeling a duty to be ready to savage the mighty, or rummage through their bins. Elsewhere in Europe, government contracts and subsidies ensure that press barons will only defy the mighty so far."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2064434e-b29b-30ca-8d43-a111944663f3",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "A publisher."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea7ab813-1a44-3a4b-8dad-48c0bc1155f6",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "An enclosed storage space (e.g. closet, cupboard)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5de5f265-0b02-4b01-87d1-0fde97e75a0c",
                                                "sense_id": "ea7ab813-1a44-3a4b-8dad-48c0bc1155f6",
                                                "text": "Put the cups in the press."
                                            },
                                            {
                                                "example_id": "165591d5-6ab3-4b3a-ae16-e2fa80bcdc7c",
                                                "sense_id": "ea7ab813-1a44-3a4b-8dad-48c0bc1155f6",
                                                "text": "Put the ironing in the linen press."
                                            },
                                            {
                                                "example_id": "16599188-6a2b-4280-bfbd-abae71f7dec2",
                                                "sense_id": "ea7ab813-1a44-3a4b-8dad-48c0bc1155f6",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window at the old mare feeding in the meadow below by the brook, and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99a3f650-fa2b-333a-842b-96da797fec3f",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "An exercise in which weight is forced away from the body by extension of the arms or legs."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3463d3b6-880a-40b3-a636-744baec99feb",
                                                "sense_id": "99a3f650-fa2b-333a-842b-96da797fec3f",
                                                "text": "This is the fourth set of benchpresses. There will be five more; then there will be five sets of presses on an inclined bench[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "258d67e2-5274-3f9b-84e2-679992287a64",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "An additional bet in a golf match that duplicates an existing (usually losing) wager in value, but begins even at the time of the bet."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a6f620-92a6-45c1-a945-e729de31f8fd",
                                                "sense_id": "258d67e2-5274-3f9b-84e2-679992287a64",
                                                "text": "He can even the match with a press."
                                            },
                                            {
                                                "example_id": "2e1858e8-3cff-438f-83d3-8a5d970b4983",
                                                "sense_id": "258d67e2-5274-3f9b-84e2-679992287a64",
                                                "text": "The way a press works is, say you're two down after six holes; you can then start another bet (in effect another match) from the seventh hole, for the same amount, starting all square on the seventh tee."
                                            },
                                            {
                                                "example_id": "35b16126-4300-467b-9b33-8e08a18a98ee",
                                                "sense_id": "258d67e2-5274-3f9b-84e2-679992287a64",
                                                "text": "When a side is two or more points down in the match, they may request a press."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fddc4db-b8fe-3552-8ea1-5109c624b24c",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "Pure, unfermented grape juice."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d92a80a-1ac8-460d-896b-045fbb470d5e",
                                                "sense_id": "7fddc4db-b8fe-3552-8ea1-5109c624b24c",
                                                "text": "I would like some Concord press with my meal tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "201e3728-194c-3499-a75c-c8b822445a90",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "A commission to force men into public service, particularly into the navy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53f61be8-a4bf-482b-836e-5473fef73bfd",
                                                "sense_id": "201e3728-194c-3499-a75c-c8b822445a90",
                                                "text": "I have misused the king's press."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc4e199a-0e35-3261-bef3-c63050679dec",
                                        "entry_id": "d6506d18-eef1-315e-8d60-c1f65acf9f5c",
                                        "glosses": [
                                            "In personology, any environmental factor that arouses a need in the individual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c725d50b-72d8-4afa-a0af-4dc2a7692ef1",
                                                "sense_id": "bc4e199a-0e35-3261-bef3-c63050679dec",
                                                "text": "The environmental comfort category is illustrative of cases in which there are low environmental presses matched against a number of personal competences."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "press",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b35c99d-758a-3057-8be2-3bd214567d5c",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To exert weight or force against, to act upon with force or weight; to exert pressure upon."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40c82802-e526-38b6-a28f-35ea0c7b2cd3",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To activate a button or key by exerting a downward or forward force on it, and then releasing it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4646b16-4a73-3020-97ae-4018a7848271",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To compress, squeeze."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cda66be-37f2-45b4-b2ed-7182c9aa46b3",
                                                "sense_id": "a4646b16-4a73-3020-97ae-4018a7848271",
                                                "text": "to press fruit for the purpose of extracting the juice"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7493c3e0-14bf-3ab6-8eaa-f56893f557d3",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To clasp, hold in an embrace."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b104254c-fff9-4f70-b0f0-e1213ab84657",
                                                "sense_id": "7493c3e0-14bf-3ab6-8eaa-f56893f557d3",
                                                "text": "With tears and ſmiles ſhe took her ſon, and preſs'd / Th' illuſtrious infant to her fragrant breaſt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac964253-f7d9-3463-8bd7-4a983b13fc22",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To reduce to a particular shape or form by pressure, especially flatten or smooth."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ba6245d-dbf5-4392-987f-c5458427e00a",
                                                "sense_id": "ac964253-f7d9-3463-8bd7-4a983b13fc22",
                                                "text": "to press cloth with a clothes-iron"
                                            },
                                            {
                                                "example_id": "af52771c-e5c9-4784-9685-6c40f8693626",
                                                "sense_id": "ac964253-f7d9-3463-8bd7-4a983b13fc22",
                                                "text": "to press a hat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7202c4fa-1c4d-3bbf-81ff-b784d00a7031",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To flatten a selected area of fabric using an iron with an up-and-down, not sliding, motion, so as to avoid disturbing adjacent areas."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
