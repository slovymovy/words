                                        "entry_id": "3b20e9e5-737a-3eab-8adc-3caf043e0448",
                                        "glosses": [
                                            "Messgerät zur Messung von Strömungsgeschwindigkeiten, besonders der Windgeschwindigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "545b06a3-42e1-4df1-98ee-9d1305daacc7",
                                                "sense_id": "f78501bb-3455-3aa1-82a0-301e3d0047c2",
                                                "text": "„Das kompakte Anemometer testo 425 mit fest angeschlossener thermischer Strömungssonde (Sondenkopf Ø 7,5 mm) inkl. Teleskop.“"
                                            },
                                            {
                                                "example_id": "3ebd9f03-a3bb-44b9-b872-feddc31c31e4",
                                                "sense_id": "f78501bb-3455-3aa1-82a0-301e3d0047c2",
                                                "text": "„Auch für die Geschwindigkeitsmessung von Luftströmungen in technischen Anlagen wird die Bezeichnung Anemometer verwendet“"
                                            }
