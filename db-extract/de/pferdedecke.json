                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2acb876e-dcdc-4c2b-b5c0-adc8294d0fd3",
                                "sense_id": "9ded5582-052c-359f-88ca-231885379fdc",
                                "text": "„Als Erika Domin sich in die Pferdedecke gewickelt hatte, reichte ihr die Frau einen Bratapfel.“"
                            },
                            {
                                "example_id": "8e40cbe6-4e41-4dca-ae5e-6e57bc04f3be",
                                "sense_id": "9ded5582-052c-359f-88ca-231885379fdc",
                                "text": "„Dann wurde ein Brett herangeschafft und über zwei Sättel gelegt, darüber wurde eine Pferdedecke gebreitet.“"
                            },
                            {
                                "example_id": "0e57f095-e07e-42b5-9a66-03b916f7bd24",
                                "sense_id": "9ded5582-052c-359f-88ca-231885379fdc",
                                "text": "„In eine Pferdedecke gehüllt, trocknete sie meine Uniform und ihr wollenes Kleid am Feuer, das sie angezündet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
