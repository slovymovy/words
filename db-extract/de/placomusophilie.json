                "senses": [
                    {
                        "sense_id": "ef3c9fc5-b469-3582-9b7a-ac86724d059c",
                        "entry_id": "08cf1012-201c-3edb-acbb-891d249dd538",
                        "glosses": [
                            "das Sammeln von bei Sekt- und Champagnerflaschen üblichen Metallkappen, die sich zwischen der Agraffe und dem Korken befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "732d9dd4-53c6-4b17-bb80-28934d57f4e7",
                                "sense_id": "ef3c9fc5-b469-3582-9b7a-ac86724d059c",
                                "text": "Die Placomusophilie ist zwar in Deutschland weniger beliebt, aber dafür ist sie in Frankreich und in Spanien umso beliebter."
                            },
                            {
                                "example_id": "73b5fd2b-3950-4e07-a433-bbe9abc79477",
                                "sense_id": "ef3c9fc5-b469-3582-9b7a-ac86724d059c",
                                "text": "Mein Schwager beschäftigt sich hobbymäßig mit der Placomusophilie."
                            },
                            {
                                "example_id": "3d434ee2-6830-40b4-85e7-a007b21c45c9",
                                "sense_id": "ef3c9fc5-b469-3582-9b7a-ac86724d059c",
                                "text": "„Die kleine Metallkappe fand bald so viele Liebhaber, dass sie zum begehrten Sammelobjekt wurde. Die neue Sammelleidenschaft hieß: Placomusophilie.“"
                            },
                            {
                                "example_id": "56327efe-800b-4447-a908-47a6b12eb5ea",
                                "sense_id": "ef3c9fc5-b469-3582-9b7a-ac86724d059c",
                                "text": "„Unter Placomusophilie versteht man die Kunst des Sammelns von Schaumwein- oder Champagner-‚Kapseln‘.“"
                            },
                            {
                                "example_id": "96e6c464-8006-4815-b059-3e05147c9543",
                                "sense_id": "ef3c9fc5-b469-3582-9b7a-ac86724d059c",
                                "text": "„In den klassischen Schaumweinregionen Frankreich (Champagne), Spanien (Penedès) und Italien sind diese Champagnerdeckel begehrte Sammlerobjekte. Der Fachausdruck der größten Sammlergemeinde für dieses Sammelgebiet ist Placomusophilie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
