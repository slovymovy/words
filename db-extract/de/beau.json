                        "examples": [
                            {
                                "example_id": "efdc3aad-6255-4164-808c-51458a2b44eb",
                                "sense_id": "9e65caa8-d58b-36b4-af98-e11f01dee42a",
                                "text": "„Ich hatte Pablo in meinem Gedächtnis als eine hübsche Null verzeichnet, einen kleinen, etwas eitlen Beau, ein vergnügtes und problemloses Kind…“"
                            },
                            {
                                "example_id": "c7e4a578-c9ff-40f9-be95-8f81d67498b9",
                                "sense_id": "9e65caa8-d58b-36b4-af98-e11f01dee42a",
                                "text": "„Plötzlich dachte sie an einen alten Beau, den sie vergessen hatte, einen Angestellten im Imperial Hotel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
