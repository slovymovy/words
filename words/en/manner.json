    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "738b86fb-077a-355a-b8cb-3b6f1082f196",
                    "sense_definition": "A particular way in which something is done or happens.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mode_of_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She smiled at him in a friendly <w>manner</w>.",
                            "target_lang_translations": {
                                "ru": "Она улыбнулась ему в дружелюбной <w>манере</w>.",
                                "tr": "Ona dostça bir <w>biçimde</w> gülümsedi."
                            }
                        },
                        {
                            "text": "The problem was solved in an efficient <w>manner</w>.",
                            "target_lang_translations": {
                                "ru": "Проблема была решена эффективным <w>способом</w>.",
                                "tr": "Sorun verimli bir <w>şekilde</w> çözüldü."
                            }
                        }
                    ],
                    "synonyms": [
                        "way",
                        "method",
                        "style",
                        "fashion"
                    ],
                    "common_phrases": [
                        "in a manner",
                        "in this manner",
                        "timely manner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный способ или образ действия.",
                        "tr": "Bir şeyin yapılış veya gerçekleşme biçimi."
