                ],
                "senses": [
                    {
                        "sense_id": "1b0438d9-aed0-3a62-9225-624935db5981",
                        "entry_id": "cc8452c8-e4bf-3e34-945a-23272f209f84",
                        "glosses": [
                            "zo geïnterpreteerd als gezegd of geschreven, zonder overdrachtelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5c4f1c-3902-4e11-b944-dc72a2fa027f",
                                "sense_id": "1b0438d9-aed0-3a62-9225-624935db5981",
                                "text": "De letterlijke betekenis van \"balen\" is een aantal grote gevulde zakken."
                            },
                            {
                                "example_id": "90e00fc3-03de-44ae-923e-ef103e901357",
                                "sense_id": "1b0438d9-aed0-3a62-9225-624935db5981",
                                "text": "Het was zwaar geweest voor de drie broers, vooral de eerste zomer nadat hun vader en oom vermist waren op zee, toen moesten de jongens werken tot ze er letterlijk bij neervielen."
                            },
                            {
                                "example_id": "34a7ec4a-23d8-4e0a-8c1c-978927c978d9",
                                "sense_id": "1b0438d9-aed0-3a62-9225-624935db5981",
                                "text": "Jeroen Post zegt dat hij \"over het randje is gegaan\": \"Ik werd wakker met hartkloppingen. Ik ben er anderhalf jaar goed ziek van geweest\", zegt hij in de documentaire. Ook Miljuschka Witzenhausen zegt dat ze \"vaak letterlijk is omgevallen\"."
                            }
                        ]
                    }
                ],
