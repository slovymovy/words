                                        "sense_id": "7d2c2038-80f3-3257-8130-239de47be236",
                                        "entry_id": "36efd8c6-a182-3388-810d-deda77a54147",
                                        "glosses": [
                                            "A light that illuminates a specific person or thing on the stage."
                                        ],
                                        "tags": [],
