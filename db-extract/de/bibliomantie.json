                        "source_sense_id": "8c8749d0-fc66-3dae-8bd8-8d9fef5444bd",
                        "source_sense_description": "Wahrsagung mithilfe von heiligen oder bedeutenden Texten, insbesondere der Bibel oder des I Ging",
                        "target_lang_word": "bibliomancie",
                        "target_lang_code": "fr",
