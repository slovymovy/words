                "senses": [
                    {
                        "sense_id": "689e5e1b-2ed7-3574-a990-67558bf38d9b",
                        "entry_id": "a88024c9-4a24-3298-b156-8ca786e2c076",
                        "glosses": [
                            "Sportif qui pratique le football."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "a116480b-8d64-4152-a547-2ded64339114",
                                "sense_id": "689e5e1b-2ed7-3574-a990-67558bf38d9b",
                                "text": "L’artiste compare cette formation à celle que vivrait un footballeur international au centre de Clairefontaine."
                            },
                            {
                                "example_id": "f38fdcdc-46eb-45be-86af-53de63eee51c",
                                "sense_id": "689e5e1b-2ed7-3574-a990-67558bf38d9b",
                                "text": "D’une façon générale, un footballeur professionnel français gagne largement sa vie, habite un appartement coquet et roule en voiture. Il n’est pas à plaindre et a le temps, en dix ou quinze années d’activité, d’assurer son avenir."
                            },
                            {
                                "example_id": "54e46d32-4f97-407a-9093-14bad228b780",
                                "sense_id": "689e5e1b-2ed7-3574-a990-67558bf38d9b",
                                "text": "S’agissant du footballeur professionnel, la jurisprudence, la doctrine juridique et comptable précitée considère sa force de travail comme un élément du patrimoine."
                            },
                            {
                                "example_id": "53c37044-3783-43f6-86db-2959ee62d478",
                                "sense_id": "689e5e1b-2ed7-3574-a990-67558bf38d9b",
                                "text": "Le football est complexe et le footballeur est un homme complexe qui fonctionne à partir de cette interaction permanente."
                            },
                            {
                                "example_id": "fc45b818-9ce0-43d6-b8b6-6e66f79361bd",
                                "sense_id": "689e5e1b-2ed7-3574-a990-67558bf38d9b",
                                "text": "Selon le porte-parole de Vias, de nombreux footballeurs, qui bénéficient de véhicules puissants, \"surestiment souvent leurs capacités au volant et sous-estiment les risques\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "140a111f-2810-49a1-b71a-c0f79f7ae78c",
                        "source_entry_id": "a88024c9-4a24-3298-b156-8ca786e2c076",
                        "source_sense_id": "689e5e1b-2ed7-3574-a990-67558bf38d9b",
                        "target_lang_word": "Fußballer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußballer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                        "entry_id": "ea1d2ae9-9ca1-3488-ae7f-da7cb3489abd",
                                        "glosses": [
                                            "ein Spieler des Sportes Fußball"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd9df20-b588-480b-a26c-b2c467f90d73",
                                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                                "text": "Mein Nachbar ist ein begeisterter Fußballer."
                                            },
                                            {
                                                "example_id": "358ab6ae-94a5-4e98-aa0a-95c251366d1a",
                                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                                "text": "„Der ehemalige österreichische Fußballer Ernst Ogris ist im Alter von 49 Jahren in Wien nach kurzer Krankheit gestorben.“"
                                            },
                                            {
                                                "example_id": "a2f36b88-d6c9-438a-8f46-cde4312215d1",
                                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                                "text": "„Der Fall Maradona ist den Italienern noch bekannt, weil dem Fußballer einst ein Diamantohrring und zwei goldene Rolex-Uhren beschlagnahmt wurden, um einen Teil seiner Steuerschuld zu tilgen.“"
                                            },
                                            {
                                                "example_id": "3eb9e2f3-264a-4323-b793-d2e7d320bf4b",
                                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                                "text": "„Viele Fußballer versuchen sich dann entsprechend der in ihnen vermuteten Einsicht möglichst geschwollen auszudrücken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
