                    },
                    {
                        "translation_id": "916e7ef8-f802-43e2-9e54-3c7cd363b1b5",
                        "source_entry_id": "8a95daeb-382c-35d5-8722-df9780c05fb9",
                        "source_sense_id": "44fac204-64ae-3089-b198-8b3563ac83b6",
                        "source_sense_description": "televisieomroep",
                        "target_lang_word": "télévision",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "télévision",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac4683e0-8bc7-3579-bfdc-ab5c4db94e82",
                                        "entry_id": "68c6e6f4-d4c9-3f3f-a53b-354a6052b610",
                                        "glosses": [
                                            "Ensemble des techniques utilisées pour reproduire des séquences audiovisuelles à distance, impliquant généralement la transmission d'un signal par ondes électromagnétiques (hertziennes et/ou filaires)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b930ac8-b3e8-41ef-b3d1-80a39bce46f0",
                                                "sense_id": "ac4683e0-8bc7-3579-bfdc-ab5c4db94e82",
                                                "text": "La télévision est accusée, du fait de son attractivité, de monopoliser le temps de loisirs,notamment des jeunes, au détriment des autres formes de loisirs."
                                            },
                                            {
                                                "example_id": "482566be-3f56-4f1e-90e8-2194335f6ed2",
                                                "sense_id": "ac4683e0-8bc7-3579-bfdc-ab5c4db94e82",
                                                "text": "La télévision divertit de la harassante nécessité de bâtir des projets à partir du rien de nos existences frivoles ; en circonvenant les yeux, elle décharge l’esprit de la grande œuvre du sens."
                                            },
                                            {
                                                "example_id": "24874c07-5204-44ec-ab0f-bf9cbcf516c0",
                                                "sense_id": "ac4683e0-8bc7-3579-bfdc-ab5c4db94e82",
                                                "text": "Au milieu de la catastrophe, Trump pérore tous les jours à la télévision, enfilant mensonges, approximations et bravades autosatisfaites, l’œil rivé sur son propre audimat et sur l’audience qu’il recueille sur les réseaux sociaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ba58683-0de9-3f68-8d6b-f70585368143",
                                        "entry_id": "68c6e6f4-d4c9-3f3f-a53b-354a6052b610",
                                        "glosses": [
                                            "Téléviseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "def00269-9486-4cbb-9e3c-0faae1b9efa7",
                                                "sense_id": "9ba58683-0de9-3f68-8d6b-f70585368143",
                                                "text": "À l’obsolescence technique s’adjoint donc une obsolescence psychologique : un téléphone de deux ans est ringard, un vêtement de six mois est démodé, un écran plat est déjà bien triste face à une télévision 3D."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b2f7e7b-da70-38c5-afcc-8ce3b9ce13b2",
                                        "entry_id": "68c6e6f4-d4c9-3f3f-a53b-354a6052b610",
                                        "glosses": [
                                            "Centre de production et d’émission de programmes télévisés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57c381c4-fee1-42c9-a63f-b77d1b15744c",
                                                "sense_id": "1b2f7e7b-da70-38c5-afcc-8ce3b9ce13b2",
                                                "text": "Elle a en effet mis les trois moyens d'information d’accord en commençant par occuper la radio, puis en mettant la main sur la télévision, tuant au passage une quatorzaine de Lituaniens indépendantistes et sans armes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
