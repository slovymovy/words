                "senses": [
                    {
                        "sense_id": "9aa8bf46-da93-34e1-87d4-57c740de3938",
                        "entry_id": "953c45ef-6098-3640-b822-95658765537e",
                        "glosses": [
                            "Enlever la barbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "859f42bb-1861-4827-b517-8859528d3984",
                                "sense_id": "9aa8bf46-da93-34e1-87d4-57c740de3938",
                                "text": "Le garde insista sur l'urgence, supplia presque et Brisson finit de se débarbifier avant d'accepter de ressortir."
                            },
                            {
                                "example_id": "6a16d4ae-c532-4e15-8e28-c1fe1395e025",
                                "sense_id": "9aa8bf46-da93-34e1-87d4-57c740de3938",
                                "text": "Nous eûmes le plaisir de voir débarquer notre ami JAD, aminci, débarbifié, bref… presque agréable à regarder… et ce fut un soulagement de le voir en bonne forme !"
                            },
                            {
                                "example_id": "fd6181e1-4a5b-4af5-84f1-0ff4405e7d20",
                                "sense_id": "9aa8bf46-da93-34e1-87d4-57c740de3938",
                                "text": "L’électricité qui, sous une forme, peut « débarbifier » une femme, pourrait donc, autrement employée, faire une femme à barbe."
                            }
                        ]
                    }
