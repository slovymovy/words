{
    "word_family": [
        "piernikowy",
        "piernikarstwo",
        "piernikarz",
        "pierniczyć"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c258755-c76d-37c7-a6a1-ac2bd35c797f",
                    "sense_definition": "twarde ciemnobrązowe ciasto z mąki, miodu i przypraw korzennych",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed świętami Bożego Narodzenia pieczemy pyszny <w>piernik</w> z miodem.",
                            "target_lang_translations": {
                                "ru": "Перед Рождеством мы печём вкусный <w>пряник</w> с мёдом."
                            }
                        },
                        {
                            "text": "W tym roku bożonarodzeniowe <w>pierniki</w> były naprawdę wyśmienite.",
                            "target_lang_translations": {
                                "ru": "В этом году рождественские <w>пряники</w> были действительно восхитительными."
                            }
                        }
                    ],
                    "common_phrases": [
                        "piernik toruński",
                        "piec piernik"
                    ],
                    "target_lang_definitions": {
                        "ru": "твёрдое тёмно-коричневое кондитерское изделие из муки, мёда и пряностей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пряник",
                                "target_lang_sense_clarification": "мучное кондитерское изделие с пряностями"
                            },
                            {
                                "target_lang_word": "коврижка",
                                "target_lang_sense_clarification": "большой медовый пряник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32af253c-804a-324a-b1d6-7f9eb4c345e0",
                    "sense_definition": "pogardliwe określenie starego człowieka, zwłaszcza mężczyzny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "człowiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten stary <w>piernik</w> znowu narzeka na głośną muzykę sąsiadów.",
                            "target_lang_translations": {
                                "ru": "Этот старый <w>хрыч</w> снова жалуется на громкую музыку соседей."
                            }
                        },
                        {
                            "text": "Nie słuchaj tego <w>piernika</w>, bo on nic nie rozumie.",
                            "target_lang_translations": {
                                "ru": "Не слушай этого <w>старого пня</w>, он ничего не понимает."
                            }
                        }
                    ],
                    "synonyms": [
                        "ramol"
                    ],
                    "common_phrases": [
                        "stary piernik"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne i lekceważące określenie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "пренебрежительное обозначение пожилого человека, особенно мужчины"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрыч",
                                "target_lang_sense_clarification": "старый хрыч; бранно о старике"
                            },
                            {
                                "target_lang_word": "пень",
                                "target_lang_sense_clarification": "старый пень; пренебрежительно о пожилом человеке"
                            },
                            {
                                "target_lang_word": "песочник",
                                "target_lang_sense_clarification": "старый песочник; разг., ирон."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0f3e3fd-540f-3593-ba1d-a7a7596d0445",
                    "sense_definition": "roślina z rodzaju pieprzowców lub jej owoc",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starych podręcznikach botaniki tę roślinę określano słowem <w>piernik</w>.",
                            "target_lang_translations": {
                                "ru": "В старых учебниках ботаники это растение называли словом <w>перечник</w>."
                            }
                        },
                        {
                            "text": "Dawniej rosnący w ogrodzie pieprzowiec nazywano po prostu <w>piernikiem</w>.",
                            "target_lang_translations": {
                                "ru": "Раньше растущий в саду перечник называли просто <w>перцем</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "papryka",
                        "pieprzowiec"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "dawne znaczenie botaniczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "растение из рода перечных или его плод (устаревшее)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перечник",
                                "target_lang_sense_clarification": "устар. растение рода перечных"
                            },
                            {
                                "target_lang_word": "перец",
                                "target_lang_sense_clarification": "растение или плод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e34aa634-9691-3af4-a9c2-71f9cc04da70",
                    "sense_definition": "mało warta rola teatralna nieprzynosząca efektu",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "teatr",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aktor dostał w spektaklu zupełny <w>piernik</w> i nie mógł pokazać talentu.",
                            "target_lang_translations": {
                                "ru": "Актёру досталась в спектакле совершенно <w>проходная роль</w>, и он не смог показать свой талант."
                            }
                        },
                        {
                            "text": "Reżyser dał mu rolę określaną w żargonie jako zwykły <w>piernik</w>.",
                            "target_lang_translations": {
                                "ru": "Режиссёр дал ему роль, которую на жаргоне называли просто <w>неблагодарной</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "środowiskowe, teatralne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "незначительная, невыигрышная театральная роль, не дающая проявить себя (театральный жаргон)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проходная роль",
                                "target_lang_sense_clarification": "незначительная театральная роль"
                            },
                            {
                                "target_lang_word": "неблагодарная роль",
                                "target_lang_sense_clarification": "роль, не приносящая актёру успеха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8b659ec-b9dc-32da-a2c7-689ac1acff4e",
                    "sense_definition": "chleb w gwarze przestępczej",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnej gwarze więziennej słowem <w>piernik</w> określano zwykły bochenek chleba.",
                            "target_lang_translations": {
                                "ru": "В старом тюремном жаргоне словом «piernik» называли обычную буханку <w>хлеба</w>."
                            }
                        },
                        {
                            "text": "Więzień poprosił kolegę o kawałek <w>piernika</w> do zupy.",
                            "target_lang_translations": {
                                "ru": "Заключённый попросил товарища дать кусочек <w>хлеба</w> к супу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gwara przestępcza"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "хлеб на воровском жаргоне"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлеб",
                                "target_lang_sense_clarification": "буханка хлеба (на тюремном жаргоне)"
                            },
                            {
                                "target_lang_word": "пайка",
                                "target_lang_sense_clarification": "порция тюремного хлеба"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b3a2dbda-cacb-36d8-8f3d-75cbac7acc10",
                    "sense_definition": "nazwisko męskie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Piernik</w> przyszedł dzisiaj punktualnie na zebranie zarządu.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Перник</w> пришёл сегодня вовремя на заседание правления."
                            }
                        },
                        {
                            "text": "Wczoraj spotkałem na ulicy pana Jana <w>Piernika</w>.",
                            "target_lang_translations": {
                                "ru": "Вчера я встретил на улице господина Яна <w>Перника</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "мужская фамилия Перник"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Перник",
                                "target_lang_sense_clarification": "мужская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a14b7ca8-56f9-3aeb-a432-71b8ced8a037",
                    "sense_definition": "nazwisko żeńskie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Piernik</w> odebrała telefon i przekazała nam ważne wiadomości.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Перник</w> взяла трубку и передала нам важные вести."
                            }
                        },
                        {
                            "text": "Dokumenty zostały podpisane osobiście przez Annę <w>Piernik</w>.",
                            "target_lang_translations": {
                                "ru": "Документы были подписаны лично Анной <w>Перник</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "женская фамилия Перник"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Перник",
                                "target_lang_sense_clarification": "женская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}