                    },
                    {
                        "translation_id": "2e8b62eb-c13c-4744-b9a2-1b032ccf6d5b",
                        "source_entry_id": "a37f405c-f2a1-3d8f-81a3-7d06ffa55aba",
                        "source_sense_id": "b11332a4-37cb-3d77-892d-e9e3512e5827",
