                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "84cfadbd-430e-4b1a-a6ee-0be521babedd",
                                "sense_id": "be8bca20-59ba-3871-afd8-64953171d76e",
                                "text": "— Pas mal ! pas mal !… mais c’est un chef-d’œuvre, mon cher, un chef-d’œuvre épatant !…"
                            },
                            {
                                "example_id": "74c31394-6a4f-473b-8509-fea4423828ce",
                                "sense_id": "be8bca20-59ba-3871-afd8-64953171d76e",
                                "text": "J'ai un beau-frère épatant , n'est-ce pas M. le Curé ?"
                            },
                            {
                                "example_id": "f2ab29e5-f679-42fc-a08e-dc664a7b50cc",
                                "sense_id": "be8bca20-59ba-3871-afd8-64953171d76e",
                                "text": "Refaites à neuf, les 19 chambres (salles de bains privatives) de pub à l’étage sont épatantes : linge de lit luxueux, miniréfrigérateurs et grandes TV dans un cadre tout de cuir et de granit."
                            }
                        ]
                    }
