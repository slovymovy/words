                                                "example_id": "b9f9cb71-0c07-4cc0-8571-f40e9b33663a",
                                                "sense_id": "9747d6b8-740b-3bf1-8514-33203df7749b",
                                                "text": "„Auch in den Regionen Katalonien und Aragon im Nordosten des Landes sowie im östlichen Valencia und in Murcia im Süden beeinträchtigte heftiger Schneefall den Verkehr."
                                            }
                                        ],
