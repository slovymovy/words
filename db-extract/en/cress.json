                        "entry_id": "9874ae94-c600-3691-b0f3-bc327c6bd3b5",
                        "glosses": [
                            "A plant of various species, chiefly cruciferous. The leaves have a moderately pungent taste, and are used as a salad and antiscorbutic."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b8086879-52d2-4695-aeb1-e7c3e47eb8ce",
                                "sense_id": "6b6b566a-bdad-33f4-86b5-54f49927bb7d",
                                "text": "Marcus Empiricus, a Roma physician, prescribed three scruples of cress, three of red onion, three of pine seed, three of Indian nard, for impotence."
                            }
                        ]
                    }
                ],
