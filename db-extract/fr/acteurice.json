                "senses": [
                    {
                        "sense_id": "19d5f8f3-fed8-309e-91f8-cce221cdc286",
                        "entry_id": "c7f49a46-1020-349d-b1d1-5f9e5909e6c8",
                        "glosses": [
                            "Personne non-binaire ou sans détermination de genre qui représente un personnage dans une pièce de théâtre, un film…"
                        ],
                        "tags": [
                            "Variations diaéthiques"
                        ],
                        "examples": [
                            {
                                "example_id": "f43db8fd-7b54-4729-8f80-efc95c776ce8",
                                "sense_id": "19d5f8f3-fed8-309e-91f8-cce221cdc286",
                                "text": "non mais ça sert a rien david on ira pas la voir ta croute avec un.e acteurice multi delinquant.e"
                            },
                            {
                                "example_id": "87f3c3ef-a4cd-45f7-b6b0-225f8447753d",
                                "sense_id": "19d5f8f3-fed8-309e-91f8-cce221cdc286",
                                "text": "On se souvient de Xavier Dolan, en 2018, qui avait affirmé que ses films ne présentaient pas de personnes racisées, car il ne connaissait pas d’acteurices de talent pour les incarner."
                            },
                            {
                                "example_id": "684a8f6e-3669-425e-b055-70db3fe19c65",
                                "sense_id": "19d5f8f3-fed8-309e-91f8-cce221cdc286",
                                "text": "C'est un travail de costume arretez de faire chier les cosplayers de live action quand iels ressemblent pas à l’acteurice\n(Cc la meuf qui a pourri mon cosplay de Margaery parce que je ressemblais pas assez à Nathalie Dormer wtf ??)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e1c5963-784f-453e-ab23-0002003b1e66",
                        "source_entry_id": "c7f49a46-1020-349d-b1d1-5f9e5909e6c8",
                        "source_sense_id": "19d5f8f3-fed8-309e-91f8-cce221cdc286",
