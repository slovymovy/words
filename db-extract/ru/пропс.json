                        "examples": [
                            {
                                "example_id": "a2b812e4-ed92-45c6-a0e8-ac096371932b",
                                "sense_id": "4c39979c-b502-3a9c-86ff-53f26ad8b4a8",
                                "text": "Доставка лесотовара в порт производилась по железной дороге, на самоходных и обыкновенных баржах по Сайменскому каналу через Выборг в Макслахти. Самым ходовым экспортным товаром был пропс, т.е. рудничные стойки, крепь."
                            }
                        ]
                    }
