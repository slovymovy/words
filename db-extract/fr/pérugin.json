                    {
                        "sense_id": "6815904f-2079-3a2e-882b-7b6685d8cb46",
                        "entry_id": "ea3a5c87-2848-3e92-baab-96eb7d155a4d",
                        "glosses": [
                            "Habitant ou homme originaire de la ville italienne de Pérouse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84c52567-4759-49c4-881c-3b6a3f9921ec",
                                "sense_id": "6815904f-2079-3a2e-882b-7b6685d8cb46",
                                "text": "Au moyen âge, Spolète fut souvent en lutte avec les villes voisines, surtout avec Pérouse: les Pérugins la saccagèrent en 1324."
                            },
                            {
                                "example_id": "2162ba1a-d9bd-4fe8-8bfd-631c60477674",
                                "sense_id": "6815904f-2079-3a2e-882b-7b6685d8cb46",
                                "text": "La grande peur des gens d'Assise, c'est celle de leurs ennemis traditionnels, les gens de Pérouse. Or, la Porziuncola, dans la plaine, est à la merci d'un coup de main des Pérugins."
                            }
                        ]
                    }
                ],
