{
    "word_family": [
        "print"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe551fc0-5e59-3790-bf84-35ace69fcf1b",
                    "sense_definition": "A detailed technical drawing or design plan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_drawing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect showed the client the <w>blueprint</w> for the new house.",
                            "target_lang_translations": {
                                "ru": "Архитектор показал клиенту <w>чертёж</w> нового дома."
                            }
                        },
                        {
                            "text": "Engineers studied the <w>blueprint</w> to understand the complex machine structure.",
                            "target_lang_translations": {
                                "ru": "Инженеры изучили <w>чертёж</w>, чтобы понять структуру сложного механизма."
                            }
                        }
                    ],
                    "synonyms": [
                        "schematic",
                        "plan",
                        "layout"
                    ],
                    "common_phrases": [
                        "detailed blueprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детальный технический чертеж или проектный план."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертёж",
                                "target_lang_sense_clarification": "Графическое изображение конструкции или устройства."
                            },
                            {
                                "target_lang_word": "прое́кт",
                                "target_lang_sense_clarification": "План создания сооружения или устройства."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "692064fb-9bb2-3a23-89aa-98b102496c3e",
                    "sense_definition": "A detailed plan or strategy for future action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company created a <w>blueprint</w> for future growth and success.",
                            "target_lang_translations": {
                                "ru": "Компания создала <w>план</w> будущего роста и успеха."
                            }
                        },
                        {
                            "text": "This report serves as a <w>blueprint</w> for upcoming environmental policy changes.",
                            "target_lang_translations": {
                                "ru": "Этот отчет служит <w>планом</w> для предстоящих изменений в экологической политике."
                            }
                        }
                    ],
                    "synonyms": [
                        "road map",
                        "plan"
                    ],
                    "common_phrases": [
                        "strategic blueprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробный план или стратегия для будущих действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "план",
                                "target_lang_sense_clarification": "Заранее намеченная последовательность действий."
                            },
                            {
                                "target_lang_word": "прое́кт",
                                "target_lang_sense_clarification": "Инициатива или совокупность мероприятий для решения задачи."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59e6ba49-f360-3dfe-9e7e-fb080ac13638",
                    "sense_definition": "A historical photographic process used to create white-on-blue technical drawings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_drawing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed an original <w>blueprint</w> from the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "В музее была выставлена оригинальная <w>светокопия</w> девятнадцатого века."
                            }
                        },
                        {
                            "text": "Old engineering offices often used the <w>blueprint</w> process for large diagrams.",
                            "target_lang_translations": {
                                "ru": "В старых инженерных бюро часто использовали процесс <w>светокопирования</w> для больших схем."
                            }
                        }
                    ],
                    "synonyms": [
                        "cyanotype"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a largely obsolete technology."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исторический фотографический процесс для создания технических чертежей (светлые линии на синем фоне)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цианоти́пия",
                                "target_lang_sense_clarification": "Исторический способ получения синих копий чертежей."
                            },
                            {
                                "target_lang_word": "светоко́пия",
                                "target_lang_sense_clarification": "Техническая копия, полученная методом светокопирования."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4b62046-e4bd-3954-ae2b-65509e115542",
                    "sense_definition": "A physical copy produced using the blueprint process.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_drawing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He unrolled the dusty <w>blueprint</w> on the table to inspect the lines.",
                            "target_lang_translations": {
                                "ru": "Он развернул на столе пыльную <w>синьку</w>, чтобы изучить линии."
                            }
                        },
                        {
                            "text": "The archive contains every <w>blueprint</w> created during the bridge construction.",
                            "target_lang_translations": {
                                "ru": "В архиве хранятся все <w>чертежи</w>, созданные во время строительства моста."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to physical copies of an obsolete process."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая копия чертежа, созданная методом светокопирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "си́нька",
                                "target_lang_sense_clarification": "Разговорное название копии чертежа, выполненной методом цианотипии."
                            },
                            {
                                "target_lang_word": "светоко́пия",
                                "target_lang_sense_clarification": "Техническая копия чертежа."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d922989b-c90a-3d17-99ff-ca7c010c9340",
                    "sense_definition": "To create a detailed plan or design for something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team will <w>blueprint</w> the entire project before starting work.",
                            "target_lang_translations": {
                                "ru": "Команда <w>спланирует</w> весь проект перед началом работы."
                            }
                        },
                        {
                            "text": "They <w>blueprint</w> every step to ensure the operation runs smoothly.",
                            "target_lang_translations": {
                                "ru": "Они <w>прорабатывают</w> каждый шаг, чтобы операция прошла гладко."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blueprint the plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрабатывать детальный план или стратегию чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плани́ровать",
                                "target_lang_sense_clarification": "Составлять план действий."
                            },
                            {
                                "target_lang_word": "разраба́тывать",
                                "target_lang_sense_clarification": "Создавать детальный проект или стратегию."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88dae20b-a5c2-3026-9bb6-52fb8de5f24a",
                    "sense_definition": "To produce a technical drawing for a structure or object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_drawing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect <w>blueprinted</w> the renovation after the client approved the design.",
                            "target_lang_translations": {
                                "ru": "Архитектор <w>вычертил</w> план реконструкции после того, как клиент одобрил дизайн."
                            }
                        },
                        {
                            "text": "Engineers <w>blueprinted</w> the new engine components with great precision.",
                            "target_lang_translations": {
                                "ru": "Инженеры с большой точностью <w>спроектировали</w> компоненты нового двигателя."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать технический чертеж для структуры или объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черти́ть",
                                "target_lang_sense_clarification": "Выполнять графическое изображение чертежа."
                            },
                            {
                                "target_lang_word": "проекти́ровать",
                                "target_lang_sense_clarification": "Создавать проектную документацию."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}