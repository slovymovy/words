                        "examples": []
                    },
                    {
                        "sense_id": "f388234d-fc40-31b7-8cc5-f6250312cad0",
                        "entry_id": "5023138b-79a4-35ad-95da-24dcf9f0f4c6",
                        "glosses": [
                            "A tobacco pipe."
                        ],
                        "tags": [
                            "UK",
                            "archaic",
                            "countable",
                            "slang",
                            "transitive",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "376ad9ef-c3b4-4891-b314-5cdee6da9007",
                                "sense_id": "f388234d-fc40-31b7-8cc5-f6250312cad0",
                                "text": "Troll us a stave, my antediluvian file, and in the mean time tip me a gage of fogus, Jerry"
                            }
                        ]
                    },
                    {
                        "sense_id": "3e3a61b2-0dd4-3e02-b82b-276e2fe5ec48",
                        "entry_id": "5023138b-79a4-35ad-95da-24dcf9f0f4c6",
                        "glosses": [
                            "A chamber pot."
                        ],
                        "tags": [
                            "UK",
                            "archaic",
                            "countable",
                            "slang",
                            "transitive",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d3b9b35b-e3cd-3b91-9f43-d24f0dae2f60",
                        "entry_id": "5023138b-79a4-35ad-95da-24dcf9f0f4c6",
                        "glosses": [
                            "A small quantity of anything."
                        ],
                        "tags": [
                            "UK",
                            "archaic",
                            "countable",
                            "slang",
                            "transitive",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "be9eed6b-39b6-4a5d-acb5-e5ad7db4d5df",
                                "sense_id": "d3b9b35b-e3cd-3b91-9f43-d24f0dae2f60",
                                "text": "GAGE, a small quantity of anything; as “a gage of tobacco,” meaning a. pipeful; “a gage of gin,” a glassful."
                            }
                        ]
                    },
                    {
                        "sense_id": "45c9d7c1-6f05-35ea-9ef2-5f01f5565af2",
                        "entry_id": "5023138b-79a4-35ad-95da-24dcf9f0f4c6",
                        "glosses": [
                            "A quart pot."
                        ],
                        "tags": [
                            "UK",
                            "countable",
                            "obsolete",
                            "transitive",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "97f15aac-d1b6-4089-b2f0-91bfa3b5fb9d",
                                "sense_id": "45c9d7c1-6f05-35ea-9ef2-5f01f5565af2",
                                "text": "I bowse no lage, but a whole gage / Of this I'll bowse to you."
                            },
                            {
                                "example_id": "f2512260-6c8a-496f-a402-9117315a28d3",
                                "sense_id": "45c9d7c1-6f05-35ea-9ef2-5f01f5565af2",
                                "text": "Harry. To pay, Moll, for I must hike.\nMoll. Did you call me, Master?\nHarry. Ay, to pay, in a Whiff.\nMoll. Let me see. There's a Grunter's Gig, is a Si-Buxom; two Cat's Heads, a Win; a Double Gage of Rum Slobber, is Thrums; and a Quartern of Max, is three Megs: — That makes a Traveller all but a Meg.\nHarry. Here, take your Traveller, and tip the Meg to the Kinchin."
                            }
                        ]
                    }
