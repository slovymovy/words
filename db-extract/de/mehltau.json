                "senses": [
                    {
                        "sense_id": "d67e0690-b4f2-3774-a1f4-f858394952db",
                        "entry_id": "cf74c270-b5d7-3876-a4e1-a6ec2faf0efe",
                        "glosses": [
                            "Pilze, die befallene Pflanzenteile mit einem meist weißen Belag bedecken; Pflanzenkrankheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36db4074-0359-4719-b67c-0318b0c4dbdd",
                                "sense_id": "d67e0690-b4f2-3774-a1f4-f858394952db",
                                "text": "Die Stachelbeeren haben Mehltau."
                            },
                            {
                                "example_id": "5c7570a2-b69f-4faf-9b7d-6a6a0315b6f7",
                                "sense_id": "d67e0690-b4f2-3774-a1f4-f858394952db",
                                "text": "„Seit den 1960er Jahren wurde Triticale vielerorts als Futtergetreide angebaut und zeigte eine hohe Resistenz gegen Befall durch sogenannten Mehltau – eine Reihe von Pflanzenkrankheiten, die auf Pilze als Erreger zurückgehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "061a11a9-337c-41c4-84ac-b98f83176130",
                        "source_entry_id": "cf74c270-b5d7-3876-a4e1-a6ec2faf0efe",
                        "source_sense_id": "d67e0690-b4f2-3774-a1f4-f858394952db",
                        "source_sense_description": "Pilze, die befallene Pflanzenteile mit einem meist weißen Belag bedecken; Pflanzenkrankheit",
                        "target_lang_word": "mildew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mildew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdbec71b-0aea-35a5-8fd1-eb8d6447c64d",
                                        "entry_id": "bf91a06d-9748-32d9-bbf9-ae4551966418",
                                        "glosses": [
                                            "A growth of minute powdery or webby fungi, whitish or of different colors, found on various diseased or decaying substances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mildew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5626af2-d9d1-34bd-b4ec-aa3417a0fd68",
                                        "entry_id": "19d473e1-c726-3119-b8a2-3ae08b39cd13",
                                        "glosses": [
                                            "To taint with mildew."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244b54ad-2695-459f-bb2d-29f2285a14df",
                                                "sense_id": "c5626af2-d9d1-34bd-b4ec-aa3417a0fd68",
                                                "text": "Hee giues the Web and the Pin, ſquints the eye, and makes the Hare‐lippe; Mildewes the white Wheate, and hurts the poore Creature of earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14b9e1b2-552e-3ef0-8287-e11c09af7394",
                                        "entry_id": "19d473e1-c726-3119-b8a2-3ae08b39cd13",
                                        "glosses": [
                                            "To become tainted with mildew."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ed996a4-145e-46c8-b97b-29a2f20ec455",
                                                "sense_id": "14b9e1b2-552e-3ef0-8287-e11c09af7394",
                                                "text": "His bald purplish head now looked for all the world like a mildewed skull."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c550839b-9d28-46d8-ac33-c1a4499f5320",
                        "source_entry_id": "cf74c270-b5d7-3876-a4e1-a6ec2faf0efe",
                        "source_sense_id": "d67e0690-b4f2-3774-a1f4-f858394952db",
                        "source_sense_description": "Pilze, die befallene Pflanzenteile mit einem meist weißen Belag bedecken; Pflanzenkrankheit",
                        "target_lang_word": "oïdium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oïdium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67ccfb0a-7a27-3421-bee7-cd561a73e516",
                                        "entry_id": "8e894bdc-587c-3fb8-8356-8307d89c0545",
                                        "glosses": [
                                            "Champignon microscopique parasite de certains végétaux et, en particulier, de la vigne. Il se présente souvent sous forme de duvet blanchâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d34a2df-b24a-4278-8c0d-edb4df020439",
                                                "sense_id": "67ccfb0a-7a27-3421-bee7-cd561a73e516",
                                                "text": "L’azoxystrobine possède un large spectre sur les champignons pathogènes de la vigne : le mildiou, l’oïdium, le black-rot, le rougeot parasitaire, l’excoriose. Une efficacité secondaire sur la pourriture grise (Botrytis cinerea) a été observée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e1080e7-d377-3cb4-874f-38ad3c8deae3",
                                        "entry_id": "8e894bdc-587c-3fb8-8356-8307d89c0545",
                                        "glosses": [
                                            "Maladie cryptogamique provoquée par ce champignon."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c72b279-8e9f-4310-9665-5d2d677b123c",
                                                "sense_id": "3e1080e7-d377-3cb4-874f-38ad3c8deae3",
                                                "text": "Le Bacchus, qui provient d'un semis de Clinton, est un cépage d'avenir pour la culture en treillages dans les sols profonds. […]. Il est très vigoureux, très fertile, très résistant au phylloxéra, à l’oïdium et au mildew."
                                            },
                                            {
                                                "example_id": "a2e67ec6-ecdf-4164-9fa9-cca89a2408e1",
                                                "sense_id": "3e1080e7-d377-3cb4-874f-38ad3c8deae3",
                                                "text": "La dépense moyenne par hectare pour me défendre contre l’oïdium et le mildew atteignit 106 fr., tandis que dans les années ordinaires, je puis me contenter de cinq traitements mixtes, dont les frais peuvent être réduits à 60 fr."
                                            },
                                            {
                                                "example_id": "6174cbc2-a6b9-4499-88f5-c22d24fd48a7",
                                                "sense_id": "3e1080e7-d377-3cb4-874f-38ad3c8deae3",
                                                "text": "On projette de la fleur de soufre sur les vignes attaquées par l’oïdium, champignon microscopique qui détruit les feuilles."
                                            },
                                            {
                                                "example_id": "52ac4384-59e6-4bd4-a217-ec5a4ec43330",
                                                "sense_id": "3e1080e7-d377-3cb4-874f-38ad3c8deae3",
                                                "text": "Le fénarimol est un fongicide largement utilisé dans la lutte contre l’oïdium. Or, comme beaucoup de fongicides aminés à hétérocycle aromatique, il est toxique via plusieurs mécanismes d’action."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
