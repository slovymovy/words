            "pos": "noun",
            "senses": [
                {
                    "sense_id": "49aa88c9-630f-3ba5-802d-843bc6c50488",
                    "sense_definition": "Véhicule à deux roues, généralement tiré par un animal de trait ou poussé à la main, destiné au transport des charges.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le paysan transportait les bottes de foin sur une vieille <w>charrette</w> en bois."
                        },
                        {
                            "text": "Un cheval vigoureux tirait péniblement la <w>charrette</w> chargée de sacs de blé."
                        }
                    ],
                    "synonyms": [
                        "carriole"
                    ],
                    "common_phrases": [
                        "charrette à bras",
                        "charrette à foin"
                    ]
                },
                {
