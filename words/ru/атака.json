{
    "word_family": [
        "атаковать",
        "контратака"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2c6b828-dd82-38c7-8eff-6d04a66fb0e3",
                    "sense_definition": "Стремительное нападение на противника в бою или активные действия против соперника в спорте с целью добиться победы.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Командир отдал приказ всему батальону идти в <w>атаку</w>.",
                            "target_lang_translations": {
                                "en": "The commander gave the order for the entire battalion to go on the <w>attack</w>.",
                                "pl": "Dowódca wydał rozkaz całemu batalionowi, aby ruszył do <w>ataku</w>."
                            }
                        },
                        {
                            "text": "Наша футбольная команда начала быструю <w>атаку</w> на ворота соперника.",
                            "target_lang_translations": {
                                "en": "Our football team started a fast <w>attack</w> on the opponent's goal.",
                                "pl": "Nasza drużyna piłkarska rozpoczęła szybki <w>atak</w> na bramkę przeciwnika."
                            }
                        }
                    ],
                    "synonyms": [
                        "нападение",
                        "штурм",
                        "наступле́ние"
                    ],
                    "antonyms": [
                        "оборона",
                        "защита",
                        "отступление"
                    ],
                    "common_phrases": [
                        "пойти в атаку",
                        "отразить атаку",
                        "воздушная атака",
                        "начать атаку"
                    ],
                    "target_lang_definitions": {
                        "en": "A rapid assault on an enemy in battle or active actions against an opponent in sports to achieve victory.",
                        "pl": "Gwałtowny napad na przeciwnika w walce lub aktywne działania przeciwko rywalowi w sporcie w celu osiągnięcia zwycięstwa."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attack",
                                "target_lang_sense_clarification": "general military or sports action"
                            },
                            {
                                "target_lang_word": "assault",
                                "target_lang_sense_clarification": "violent military onset"
                            },
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "rushing forward aggressively"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "atak",
                                "target_lang_sense_clarification": "ogólne określenie działań ofensywnych"
                            },
                            {
                                "target_lang_word": "natarcie",
                                "target_lang_sense_clarification": "działanie wojskowe polegające na uderzeniu na wroga"
                            },
                            {
                                "target_lang_word": "szturm",
                                "target_lang_sense_clarification": "gwałtowny, bezpośredni atak na umocnienia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06952b46-84fc-306b-a5fb-8179f63ab205",
                    "sense_definition": "Внезапный и острый приступ боли или болезненного состояния.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач сказал, что это была легкая сердечная <w>атака</w>.",
                            "target_lang_translations": {
                                "en": "The doctor said it was a mild heart <w>attack</w>.",
                                "pl": "Lekarz powiedział, że to był lekki <w>atak</w> serca."
                            }
                        },
                        {
                            "text": "Она почувствовала, как начинается паническая <w>атака</w>.",
                            "target_lang_translations": {
                                "en": "She felt a panic <w>attack</w> coming on.",
                                "pl": "Poczuła, że zaczyna się <w>atak</w> paniki."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сердечная атака",
                        "паническая атака"
                    ],
                    "target_lang_definitions": {
                        "en": "A sudden and acute onset of pain or a medical condition.",
                        "pl": "Nagły i ostry napad bólu lub stan chorobowy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attack",
                                "target_lang_sense_clarification": "medical episode (heart, panic, etc.)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "atak",
                                "target_lang_sense_clarification": "nagłe wystąpienie objawów chorobowych"
                            },
                            {
                                "target_lang_word": "napad",
                                "target_lang_sense_clarification": "nagłe wystąpienie silnego bólu lub dolegliwości"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fffb8a2e-8e04-3d7a-af49-90b6c0396e8a",
                    "sense_definition": "Часть спортивной команды, состоящая из игроков, чья основная задача — нападать.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тренер решил выпустить на поле молодого игрока, чтобы усилить <w>атаку</w>.",
                            "target_lang_translations": {
                                "en": "The coach decided to send a young player onto the field to strengthen the <w>attack</w>.",
                                "pl": "Trener zdecydował się wpuścić na boisko młodego zawodnika, aby wzmocnić <w>atak</w>."
                            }
                        },
                        {
                            "text": "В этом сезоне наша <w>атака</w> играет намного лучше, чем защита.",
                            "target_lang_translations": {
                                "en": "This season our <w>attack</w> is playing much better than the defense.",
                                "pl": "W tym sezonie nasz <w>atak</w> gra znacznie lepiej niż obrona."
                            }
                        }
                    ],
                    "synonyms": [
                        "нападение"
                    ],
                    "antonyms": [
                        "защита",
                        "оборона"
                    ],
                    "common_phrases": [
                        "играть в атаке",
                        "линия атаки"
                    ],
                    "target_lang_definitions": {
                        "en": "The part of a sports team consisting of players whose main task is to attack.",
                        "pl": "Część drużyny sportowej składająca się z zawodników, których głównym zadaniem jest zdobywanie punktów."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attack",
                                "target_lang_sense_clarification": "attacking players or line"
                            },
                            {
                                "target_lang_word": "offense",
                                "target_lang_sense_clarification": "team unit dedicated to scoring"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "atak",
                                "target_lang_sense_clarification": "formacja ofensywna w drużynie"
                            },
                            {
                                "target_lang_word": "napastnicy",
                                "target_lang_sense_clarification": "zawodnicy grający w formacji ofensywnej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc5db6ee-2c25-3554-8e1f-af0126bf19e5",
                    "sense_definition": "Начальная фаза возникновения звука или сигнала, характеризующаяся быстрым нарастанием амплитуды.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Атака</w>, поддержка и затухание формируют уникальный тембр инструмента.",
                            "target_lang_translations": {
                                "en": "<w>Attack</w>, sustain, and decay form the unique timbre of the instrument.",
                                "pl": "<w>Atak</w>, podtrzymanie i wybrzmiewanie tworzą unikalną barwę instrumentu."
                            }
                        },
                        {
                            "text": "У этого звука слишком резкая <w>атака</w> для медленной мелодии.",
                            "target_lang_translations": {
                                "en": "This sound has too sharp an <w>attack</w> for a slow melody.",
                                "pl": "Ten dźwięk ma zbyt ostry <w>atak</w> jak na wolną melodię."
                            }
                        }
                    ],
                    "antonyms": [
                        "затухание",
                        "спад"
                    ],
                    "common_phrases": [
                        "время атаки"
                    ],
                    "target_lang_definitions": {
                        "en": "The initial phase of the onset of a sound or signal, characterized by a rapid increase in amplitude.",
                        "pl": "Początkowa faza powstawania dźwięku lub sygnału, charakteryzująca się szybkim narastaniem amplitudy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attack",
                                "target_lang_sense_clarification": "music/audio term"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "atak",
                                "target_lang_sense_clarification": "termin muzyczny określający narastanie dźwięku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
