                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "855faeab-6c52-4127-af3b-78304d9fbe55",
                                                "sense_id": "cbf949fa-d262-35a2-af42-8703f842e7ee",
                                                "text": "Direkt neben dem Kindergarten war eine Totenhalle, bei der immer ein Fenster kaputt war. Häufig ging ich mit Petra dorthin, um die Leichen anzuschauen, die in der Halle aufgebahrt lagen."
                                            }
