                                        "glosses": [
                                            "Pulpa de la fruta, considerada como alimento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10fd24f3-8bea-4440-aad1-721a5b585a89",
                                                "sense_id": "7c6252cd-d913-3d83-9dde-81a43d7c97f1",
                                                "text": "Yo solo quiero la carne de la manzana, no la cáscara. Por favor, quítala."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c774d8ea-5376-324f-a331-83ec25809d37",
