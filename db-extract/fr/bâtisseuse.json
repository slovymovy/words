                        "examples": [
                            {
                                "example_id": "6a3eb9a7-2a5c-4b89-9bc1-4d28b026ad43",
                                "sense_id": "a54b67af-386f-3756-b272-cb09f8120419",
                                "text": "Parmi les personnes récompensées, Anne-Sophie a pris l’initiative d’un podcast donnant la parole aux bâtisseuses, Baptiste s’est lancé dans une animation autour du réemploi du bois et Pauline a travaillé à la valorisation de la taille de pierre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94942505-e0d5-4c4d-b6a7-75dca192ca0b",
                        "source_entry_id": "2870b7bd-f96a-3359-9186-7cc8b07644cb",
                        "source_sense_id": "a54b67af-386f-3756-b272-cb09f8120419",
                        "target_lang_word": "Baumeisterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baumeisterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c25ed01-9b90-39f7-a612-15fb64f65f50",
                                        "entry_id": "060ee71c-711e-3a7d-b2d3-b9b617bc204c",
                                        "glosses": [
                                            "Fachfrau auf dem Gebiet des Bauhandwerks oder der Bautechnik mit Meisterprüfung, die als selbstständige Bauunternehmerin arbeitet"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf8dce71-aff6-4d5c-a36d-d83c57c3ec4e",
                                                "sense_id": "1c25ed01-9b90-39f7-a612-15fb64f65f50",
                                                "text": "Architektur ist eine Männer-Domäne. Aber die brasilianische Baumeisterin Lina Bo Bardi hat es mit den Berühmtheiten der Moderne aufgenommen."
                                            },
                                            {
                                                "example_id": "83ef3be2-3f83-494c-b125-0f4a64e24edb",
                                                "sense_id": "1c25ed01-9b90-39f7-a612-15fb64f65f50",
                                                "text": "Baumeisterin Palfy ist zuversichtlich, dass ihr Projekt diese strengen Kriterien erfüllen wird: „Erstens sind unsere Stützen deutlich überdimensioniert, damit wir den Brandschutzbestimmungen entsprechen – sie sollten Feuer mindestens 105 Minuten lang standhalten. …“"
                                            },
                                            {
                                                "example_id": "ad25376b-8fc6-4b30-a4e4-9c28bc5cee2b",
                                                "sense_id": "1c25ed01-9b90-39f7-a612-15fb64f65f50",
                                                "text": "Hilda Crozzoli (* 16. August 1900 in Salzburg; † 10. August 1972 ebenda) war die erste weibliche Baumeisterin und Bauingenieurin Österreichs."
                                            },
                                            {
                                                "example_id": "f8ff1643-7183-46a1-9e70-d41950776f4f",
                                                "sense_id": "1c25ed01-9b90-39f7-a612-15fb64f65f50",
                                                "text": "Im Alter von 44 Jahren wagte er gemeinsam mit einer Arbeitskollegin und Baumeisterin – die mittlerweile seine Frau geworden ist – den Sprung in die Selbstständigkeit."
                                            },
                                            {
                                                "example_id": "cfc6fe5f-7225-4f71-b636-81ffabc3ed78",
                                                "sense_id": "1c25ed01-9b90-39f7-a612-15fb64f65f50",
                                                "text": "Die ehemalige ÖVP-Gemeinderätin und Baumeisterin stellt regelmäßig Lehrlinge ein, die sie zu Maurern oder Schalungsbauern ausbildet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
