                {
                    "sense_id": "0a3f8131-c22c-3cf7-80c9-07b99c2c5060",
                    "sense_definition": "À peu près, approximativement, plus ou moins.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "approximation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>environ</w> une heure pour arriver à la gare en voiture.",
                            "target_lang_translations": {
                                "en": "It takes <w>about</w> an hour to reach the station by car.",
                                "ru": "Добраться до вокзала на машине занимает <w>примерно</w> час.",
                                "nl": "Met de auto duurt het <w>ongeveer</w> een uur om bij het station te komen.",
                                "de": "Mit dem Auto braucht man zum Bahnhof <w>etwa</w> eine Stunde.",
                                "pl": "Dojazd samochodem na dworzec zajmuje <w>około</w> godziny.",
                                "it": "Per arrivare alla stazione in macchina ci vuole <w>circa</w> un'ora.",
                                "cs": "Cesta autem na nádraží trvá <w>asi</w> hodinu.",
                                "tr": "Arabayla istasyona varmak <w>yaklaşık</w> bir saat sürer.",
                                "es": "Se tarda <w>aproximadamente</w> una hora en llegar a la estación en coche.",
                                "zh": "开车到火车站<w>大约</w>需要一个小时。"
                            }
                        },
                        {
                            "text": "Ce projet coûtera <w>environ</w> trois mille euros au total.",
                            "target_lang_translations": {
                                "en": "This project will cost <w>about</w> three thousand euros in total.",
                                "ru": "Всего этот проект будет стоить <w>примерно</w> три тысячи евро.",
                                "nl": "Dit project zal in totaal <w>ongeveer</w> drieduizend euro kosten.",
                                "de": "Dieses Projekt wird insgesamt <w>ungefähr</w> dreitausend Euro kosten.",
                                "pl": "Ten projekt będzie kosztował w sumie <w>około</w> trzech tysięcy euro.",
                                "it": "Questo progetto costerà <w>circa</w> tremila euro in tutto.",
                                "cs": "Tento projekt bude celkem stát <w>přibližně</w> tři tisíce eur.",
                                "tr": "Bu proje toplamda <w>yaklaşık</w> üç bin avroya mal olacak.",
                                "es": "Este proyecto costará <w>aproximadamente</w> tres mil euros en total.",
                                "zh": "这个项目总共将花费<w>大约</w>三千欧元。"
                            }
                        }
                    ],
                    "synonyms": [
                        "à peu près",
                        "approximativement",
                        "en gros",
                        "grosso modo"
                    ],
                    "antonyms": [
                        "exactement",
                        "précisément"
                    ],
                    "target_lang_definitions": {
                        "en": "Roughly, more or less; not exact.",
                        "ru": "Приблизительно, не точно, с небольшим отклонением в ту или иную сторону.",
                        "nl": "Niet precies, maar wel in de buurt van een bepaalde hoeveelheid of waarde.",
                        "de": "Nicht genau, sondern annähernd; mit geringer Abweichung nach oben oder unten.",
                        "pl": "W przybliżeniu, nie dokładnie; z niewielkim odchyleniem w górę lub w dół.",
                        "it": "Più o meno, senza esattezza; con un piccolo scarto in un senso o nell'altro.",
                        "cs": "Přibližně, nikoli přesně; s malou odchylkou nahoru nebo dolů.",
                        "tr": "Tam olarak değil, kabaca bir miktar ya da değer belirtir.",
                        "es": "Indica una cantidad o valor aproximado, sin ser exacto.",
                        "zh": "表示数量或程度大致如此，不很精确。"
