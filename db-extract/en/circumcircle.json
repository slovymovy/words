                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43b7a3a-4b54-4c7b-bf3b-27f718f4cdbb",
                                                "sense_id": "9d76b4cb-c17e-33f0-a7a0-9a5bf2ff7c35",
                                                "text": "Fünf Kilometer im Umkreis / Im Umkreis von fünf Kilometern (Radius) gibt es hier keinen Getränkeladen."
                                            },
                                            {
                                                "example_id": "f8149ca5-02e6-4224-919a-26b291acba23",
                                                "sense_id": "9d76b4cb-c17e-33f0-a7a0-9a5bf2ff7c35",
                                                "text": "„Im unmittelbaren Umkreis Goethes war sie aufgewachsen und hatte aus den Begegnungen mit dem Dichter einen ausgeprägten Bildungswillen mitgenommen.“"
                                            },
                                            {
                                                "example_id": "9d3ad2a1-44de-4777-a9b8-40068ed7a385",
                                                "sense_id": "9d76b4cb-c17e-33f0-a7a0-9a5bf2ff7c35",
                                                "text": "„Er wünschte sich zunächst der oberen Stadt in einem größeren Umkreis zu vergewissern, ehe er in dem Katakombenbereich auf Entdeckungsfahrt ging.“"
                                            },
                                            {
                                                "example_id": "3c6826c4-6fce-4d2c-acc9-4fe4fe14a610",
                                                "sense_id": "9d76b4cb-c17e-33f0-a7a0-9a5bf2ff7c35",
                                                "text": "„Die einzige Bar im Umkreis der vierhundrt Inseln – ein Schuppen mit Vordach am Parkplatz der Lände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35fb257f-b766-32b9-8f51-ae51eb2d5ecd",
                                        "entry_id": "5890090b-df8d-3894-8f9a-f3d70a326b21",
                                        "glosses": [
                                            "Kreis, der durch alle Eckpunkte eines Polygons verläuft"
                                        ],
