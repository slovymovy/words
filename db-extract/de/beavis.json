                        "examples": [
                            {
                                "example_id": "b3af6962-5c81-436c-a233-f2bb61da53ef",
                                "sense_id": "0a8296de-41fa-32ce-8eeb-dfce8756c355",
                                "text": "Frau Beavis ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "81f53593-fc0e-43c6-a9cb-801ba1e23fc2",
                                "sense_id": "0a8296de-41fa-32ce-8eeb-dfce8756c355",
                                "text": "Herr Beavis wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d7cb5d3c-e101-4b3b-bfea-3f96e579c402",
                                "sense_id": "0a8296de-41fa-32ce-8eeb-dfce8756c355",
                                "text": "Die Beavisens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e04055f7-54be-4da4-aa3b-8339a8740d65",
                                "sense_id": "0a8296de-41fa-32ce-8eeb-dfce8756c355",
                                "text": "Der Beavis trägt nie die Schals, die die Beavis ihm strickt."
                            },
                            {
                                "example_id": "e9908e72-bd69-42cc-91b5-787869724ee4",
                                "sense_id": "0a8296de-41fa-32ce-8eeb-dfce8756c355",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau ´Beavis kommt, geht der Herr Beavis.“"
                            },
                            {
                                "example_id": "65863929-ceb1-444a-ac30-fad865080618",
                                "sense_id": "0a8296de-41fa-32ce-8eeb-dfce8756c355",
                                "text": "Beavis kommt und geht."
                            },
                            {
                                "example_id": "c2420cf7-b66d-4d5d-ad25-73aa90d43d24",
                                "sense_id": "0a8296de-41fa-32ce-8eeb-dfce8756c355",
                                "text": "Beavis’ kamen, sahen und siegten."
                            }
                        ],
