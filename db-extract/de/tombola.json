                    {
                        "sense_id": "883721c6-520c-3ec4-b44c-2ef4db05a13c",
                        "entry_id": "0ef3b043-f9fa-38df-bdd6-0096a7761c43",
                        "glosses": [
                            "Verlosung, Art der Lotterie; die Gewinne bestehen meist aus Sachwerten, die häufig gespendet wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d09105d-49f2-4c16-97e3-555277805cd2",
                                "sense_id": "883721c6-520c-3ec4-b44c-2ef4db05a13c",
                                "text": "Die Tombola erbrachte dem Verein einen Erlös von 876 Euro."
                            },
                            {
                                "example_id": "99fadebc-8894-43ce-8939-0e7de38300f0",
                                "sense_id": "883721c6-520c-3ec4-b44c-2ef4db05a13c",
                                "text": "Ich habe fünf Lose gekauft und bei der Tombola ein Geschirrhandtuch gewonnen."
                            },
                            {
                                "example_id": "4f741c54-83a3-4a18-ad66-4aeb14cc9a3e",
                                "sense_id": "883721c6-520c-3ec4-b44c-2ef4db05a13c",
                                "text": "„Auch er nahm noch ein paar Lose für die Tombola.“"
                            },
                            {
                                "example_id": "eb42e2fe-0d5f-4cda-9ce0-568ecdea8bf6",
                                "sense_id": "883721c6-520c-3ec4-b44c-2ef4db05a13c",
                                "text": "„Es ist der letzte Abend und es wird eine Tombola stattfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
