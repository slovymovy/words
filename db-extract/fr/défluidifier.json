                            {
                                "example_id": "e6226c84-90ed-4c04-bd0e-59e7ca4ef1ac",
                                "sense_id": "7d3049a1-6a55-3275-bdd5-1f8d5a213ac6",
                                "text": "Comme les pertes d’eau pourraient défluidifier le sang, les capsules surrénales se trouvent là fort à propos pour y déverser une liqueur huileuse qui le délaie un peu."
                            },
                            {
                                "example_id": "f31748b3-af2e-452c-bd2d-5b6e441781f1",
                                "sense_id": "7d3049a1-6a55-3275-bdd5-1f8d5a213ac6",
                                "text": "C’est ce que j'ai fait en y associant des quarts de lavement composés avec l’amidon, le camphre, le laudanum et le sulfate de quinine, afin de modérer les déjections alvines qui épuisent les malades et défluidifient."
                            }
                        ]
