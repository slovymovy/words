                "senses": [
                    {
                        "sense_id": "592022d7-7c2f-31f9-b011-2ee1258c091a",
                        "entry_id": "9e06c94a-bc2a-323e-9a4f-364299f2e4b0",
                        "glosses": [
                            "eine zusätzliche (finanzielle) Unterstützung"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "299d713c-57da-40c7-bfc0-b408eac9e7c8",
                                "sense_id": "592022d7-7c2f-31f9-b011-2ee1258c091a",
                                "text": "„Organisator war der Fussballclub, der sich daraus einen Zustupf in die Vereinskasse erwartete.“"
                            },
                            {
                                "example_id": "e4319e7a-5a51-45bd-91c9-1de0722b2e7f",
                                "sense_id": "592022d7-7c2f-31f9-b011-2ee1258c091a",
                                "text": "„Im Gegenteil: Durch die finanziellen Zustupfe wurde der Sohn in seiner Ansicht bestätigt, keine gravierenden Geldprobleme zu haben.“"
                            },
                            {
                                "example_id": "305a4f66-a0b7-4c2c-93ca-2de83fee0359",
                                "sense_id": "592022d7-7c2f-31f9-b011-2ee1258c091a",
                                "text": "„Zudem ist in keiner Weise gesichert, dass solche Zustüpfe die Holzernte in diejenigen Waldpartien zu lenken vermöchten, wo die tatsächlichen Nutzungsrückstände zu beklagen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
