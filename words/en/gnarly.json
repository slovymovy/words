                    "target_lang_definitions": {
                        "ru": "Неприятный, ужасный или физически уродливый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жуткий",
                                "target_lang_sense_clarification": "о шраме или травме"
                            },
                            {
                                "target_lang_word": "страшный",
                                "target_lang_sense_clarification": "уродливый"
                            },
                            {
                                "target_lang_word": "пакостный",
                                "target_lang_sense_clarification": "о состоянии или виде"
                            }
                        ]
