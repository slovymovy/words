                        "sense_id": "11906e3a-3da5-3045-bd65-44be699839e6",
                        "entry_id": "bcccbbd0-b89b-3237-867e-1019ec4511aa",
                        "glosses": [
                            "Exposé oral de travaux de recherche devant un jury pour l'obtention d'un diplôme, par exemple un doctorat, un master ou une habilitation à diriger des recherches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ee5e0e-44ff-4f6c-9eaf-c04ff16e76da",
                                "sense_id": "11906e3a-3da5-3045-bd65-44be699839e6",
                                "text": "Je ne manquerai pas d’assister à votre soutenance."
                            },
                            {
                                "example_id": "8e4a5c95-db43-465c-b568-6ce559d6f55c",
                                "sense_id": "11906e3a-3da5-3045-bd65-44be699839e6",
                                "text": "Vous êtes cordialement invités à la soutenance publique de la thèse de Doctorat de Mr. X. La soutenance sera suivie d'un pot auquel vous êtes également conviés."
                            },
                            {
                                "example_id": "a879aace-f0d7-4c49-bec8-911ecfbf2449",
                                "sense_id": "11906e3a-3da5-3045-bd65-44be699839e6",
                                "text": "Une brillante soutenance."
                            }
                        ]
                    },
                    {
                        "sense_id": "764a0a8f-ffb8-38bd-abc6-6d8b3e00ef13",
                        "entry_id": "bcccbbd0-b89b-3237-867e-1019ec4511aa",
                        "glosses": [
