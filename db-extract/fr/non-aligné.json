                    {
                        "sense_id": "6eec0197-ab07-3138-bbc0-bf05dab22f94",
                        "entry_id": "6df489fd-3656-3490-807c-6e1d196f7192",
                        "glosses": [
                            "Qui n’est pas dans un alignement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d32ab486-a132-4451-bbb4-6b407010cd05",
                                "sense_id": "6eec0197-ab07-3138-bbc0-bf05dab22f94",
                                "text": "Cette homothétie envoie tout point B non-aligné avec O, M et N sur le point d’intersection de la droite (0B)."
                            }
                        ]
                    },
                    {
                        "sense_id": "7756e873-2b8e-39e4-a94f-bee18d8a89f3",
                        "entry_id": "6df489fd-3656-3490-807c-6e1d196f7192",
                        "glosses": [
                            "Indépendant des États-Unis et de l’Union soviétique lors de la Guerre froide."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8eb9a8a3-c0d1-4005-b04b-084d09fd8988",
                                "sense_id": "7756e873-2b8e-39e4-a94f-bee18d8a89f3",
                                "text": "Pays non-aligné pendant la Guerre froide, le Cap-Vert de Pereira chercha à soutenir la paysannerie dans ses réformes économiques."
                            },
                            {
                                "example_id": "f33856c5-8ec7-4c19-895f-96b7f686a360",
                                "sense_id": "7756e873-2b8e-39e4-a94f-bee18d8a89f3",
                                "text": "Outre les pays membres de l’Otan, la Finlande et la Suède, deux nations officiellement non-alignées mais où le débat sur une adhésion a été relancé par l’invasion russe en Ukraine, devraient envoyer un contingent."
                            }
                        ]
                    },
                    {
                        "sense_id": "28c6cbae-5739-37db-a2a6-1c5c9707db91",
                        "entry_id": "6df489fd-3656-3490-807c-6e1d196f7192",
                        "glosses": [
                            "Qui n’est pas inféodé à une puissance ou un parti."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4450567a-d93b-46e1-ac4b-c6d3fd2aac3a",
                                "sense_id": "28c6cbae-5739-37db-a2a6-1c5c9707db91",
                                "text": "Le Parti communautaire national-européen est une organisation non-alignée dont le siège est à Bruxelles."
                            }
                        ]
                    }
                ],
                "translations": [
