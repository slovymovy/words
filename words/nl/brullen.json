{
    "word_family": [
        "brul",
        "gebrul",
        "brulaap",
        "uitbrullen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5fc9c59e-8bda-3f8a-8f18-805cc8914f25",
                    "sense_definition": "het maken van een luid, diep geluid door een dier of een machine",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geluid maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leeuw begon luid te <w>brullen</w> toen hij de indringer in zijn territorium zag.",
                            "target_lang_translations": {
                                "en": "The lion started to <w>roar</w> loudly when he saw the intruder in his territory.",
                                "fr": "Le lion s'est mis à <w>rugir</w> bruyamment lorsqu'il a vu l'intrus sur son territoire."
                            }
                        },
                        {
                            "text": "De motoren van de snelle sportwagen <w>brullen</w> terwijl hij over het circuit rijdt.",
                            "target_lang_translations": {
                                "en": "The engines of the fast sports car <w>roar</w> as it drives across the track.",
                                "fr": "Les moteurs de la voiture de sport rapide <w>vrombissent</w> tandis qu'elle roule sur le circuit."
                            }
                        }
                    ],
                    "synonyms": [
                        "loeien",
                        "bulderen"
                    ],
                    "common_phrases": [
                        "als een leeuw brullen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a loud, deep sound, typically by an animal or a machine.",
                        "fr": "Émettre un son puissant et grave, en parlant d'un animal ou d'une machine."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "roar",
                                "target_lang_sense_clarification": "of animals or engines"
                            },
                            {
                                "target_lang_word": "bellow",
                                "target_lang_sense_clarification": "deep, resonant sound"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "rugir",
                                "target_lang_sense_clarification": "d'un félin ou d'un moteur"
                            },
                            {
                                "target_lang_word": "mugir",
                                "target_lang_sense_clarification": "d'un bovin, du vent ou d'un moteur"
                            },
                            {
                                "target_lang_word": "vrombir",
                                "target_lang_sense_clarification": "d'un moteur puissant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4da58c6b-0e31-30aa-85bd-84cb4dd0c8a1",
                    "sense_definition": "met een zeer luide stem roepen of geluid maken, vaak door sterke emoties zoals woede of plezier",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geluid maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest <w>brullen</w> van het lachen om de grappige mop die zijn vriend vertelde.",
                            "target_lang_translations": {
                                "en": "He had to <w>roar</w> with laughter at the funny joke his friend told.",
                                "fr": "Il s'est mis à <w>hurler</w> de rire à la blague amusante que racontait son ami."
                            }
                        },
                        {
                            "text": "De boze trainer stond langs de lijn te <w>brullen</w> tegen de spelers van zijn team.",
                            "target_lang_translations": {
                                "en": "The angry coach stood along the sidelines <w>bellowing</w> at the players on his team.",
                                "fr": "L'entraîneur en colère <w>braillait</w> le long de la touche après les joueurs de son équipe."
                            }
                        }
                    ],
                    "synonyms": [
                        "schreeuwen",
                        "briesen",
                        "bulderen"
                    ],
                    "antonyms": [
                        "fluisteren"
                    ],
                    "common_phrases": [
                        "brullen van het lachen",
                        "tegen iemand brullen"
                    ],
                    "target_lang_definitions": {
                        "en": "To shout or make a sound with a very loud voice, often due to strong emotions like anger or joy.",
                        "fr": "Crier très fort ou émettre un bruit intense, souvent sous l'effet d'émotions fortes comme la colère ou la joie."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "roar",
                                "target_lang_sense_clarification": "with laughter or anger"
                            },
                            {
                                "target_lang_word": "bellow",
                                "target_lang_sense_clarification": "shouting loudly"
                            },
                            {
                                "target_lang_word": "shout",
                                "target_lang_sense_clarification": "at a high volume"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "hurler",
                                "target_lang_sense_clarification": "de colère ou de rire"
                            },
                            {
                                "target_lang_word": "brailler",
                                "target_lang_sense_clarification": "crier d'une voix forte ou désagréable"
                            },
                            {
                                "target_lang_word": "rugir",
                                "target_lang_sense_clarification": "crier sous le coup de la colère"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "581caae2-25c1-3e47-842b-67256723855d",
                    "sense_definition": "heel hard en onbedaarlijk huilen, vooral gezegd van een baby of jong kind",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De baby begon te <w>brullen</w> omdat hij honger had en niet kon slapen.",
                            "target_lang_translations": {
                                "en": "The baby started to <w>bawl</w> because he was hungry and couldn't sleep.",
                                "fr": "Le bébé s'est mis à <w>hurler</w> parce qu'il avait faim et n'arrivait pas à dormir."
                            }
                        },
                        {
                            "text": "Het kind bleef maar <w>brullen</w> nadat het zijn knie had geschaafd op het schoolplein.",
                            "target_lang_translations": {
                                "en": "The child kept <w>bawling</w> after scraping his knee on the schoolyard.",
                                "fr": "L'enfant n'arrêtait pas de <w>brailler</w> après s'être écorché le genou dans la cour d'école."
                            }
                        }
                    ],
                    "synonyms": [
                        "huilen",
                        "krijten",
                        "blèren",
                        "janken"
                    ],
                    "antonyms": [
                        "lachen"
                    ],
                    "target_lang_definitions": {
                        "en": "To cry very loudly and uncontrollably, especially said of a baby or young child.",
                        "fr": "Pleurer très fort et sans retenue, en particulier en parlant d'un bébé ou d'un jeune enfant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bawl",
                                "target_lang_sense_clarification": "crying loudly"
                            },
                            {
                                "target_lang_word": "wail",
                                "target_lang_sense_clarification": "prolonged high-pitched cry"
                            },
                            {
                                "target_lang_word": "howl",
                                "target_lang_sense_clarification": "crying with loud noise"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "brailler",
                                "target_lang_sense_clarification": "pleurer bruyamment"
                            },
                            {
                                "target_lang_word": "hurler",
                                "target_lang_sense_clarification": "pleurer à chaudes larmes en criant"
                            },
                            {
                                "target_lang_word": "beugler",
                                "target_lang_sense_clarification": "pleurer très fort, familier"
                            }
                        ]
                    }
                }
            ]
        },
