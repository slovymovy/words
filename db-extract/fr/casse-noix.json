                                        "glosses": [
                                            "een werktuig dat het kraken van noten vergemakkelijkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf82dd08-2f32-4377-909f-d77b2459a06b",
                                                "sense_id": "43e5a0e6-0f61-3a70-96c7-3a09d38245cd",
                                                "text": "Mag ik die notenkraker even?"
                                            },
                                            {
                                                "example_id": "2d1de629-e33c-4063-b121-20db1e214852",
                                                "sense_id": "43e5a0e6-0f61-3a70-96c7-3a09d38245cd",
                                                "text": "Alleen al het inkopen doen voor de kerstmaaltijd. En het je herinneren hoe het zat met dadels en speculaas, het dopen van stukjes brood in hambouillon, varkenspootjes, stokvis met piment en witte saus op Zweedse wijze of spek in eigen vet, mosterd en doperwtenpuree op Noorse wijze, welke soorten noten verplicht waren — en op het laatste moment op kerstavond zelf notenkrakers aanschaffen —, rolham, haring en rijstebrij."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49ee0dfd-2e6f-3340-879a-f4d884c0b9ea",
                                        "entry_id": "5ea0f51b-c2f0-3509-9f8c-a56bd615a3ba",
                                        "glosses": [
                                            "een vogel van het geslacht Nucifraga dat voorkomt in de bossen van Eurazië en Noord-Amerika"
                                        ],
                                        "tags": [
                                            "zangvogels"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4893bb3-6626-4d36-9433-52acfe838b71",
                                                "sense_id": "49ee0dfd-2e6f-3340-879a-f4d884c0b9ea",
                                                "text": "Notenkrakers leven voornamelijk van de zaden in dennenappels."
                                            }
                                        ]
                                    }
                                ]
                            }
