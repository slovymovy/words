{
    "word_family": [
        "seepage",
        "seepy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f61e075-36e8-3820-888c-12e44727bf52",
                    "sense_definition": "To pass slowly through small openings or pores (of liquids).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water started to <w>seep</w> through the basement wall after the heavy rain. ",
                            "target_lang_translations": {
                                "tr": "Şiddetli yağmurun ardından bodrum duvarından su <w>sızmaya</w> başladı."
                            }
                        },
                        {
                            "text": "Cold rainwater <w>seeped</w> through the roof and ruined the ceiling.",
                            "target_lang_translations": {
                                "tr": "Soğuk yağmur suyu çatıdan <w>sızdı</w> ve tavanı mahvetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "leak"
                    ],
                    "common_phrases": [
                        "seep through the roof",
                        "seep through the wall"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sıvıların küçük açıklıklardan veya gözeneklerden yavaşça geçmesi, sızması."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sızmak",
                                "target_lang_sense_clarification": "sıvının yavaşça bir yerden geçmesi"
                            },
                            {
                                "target_lang_word": "süzülmek",
                                "target_lang_sense_clarification": "damla damla sızarak akmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "399c1218-4d10-32af-b931-648e71808945",
                    "sense_definition": "To enter, penetrate, or spread gradually (of emotions, ideas, or influence).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fear began to <w>seep</w> into the community after the sudden news. ",
                            "target_lang_translations": {
                                "tr": "Ani haberlerin ardından topluluğun içine korku <w>sızmaya</w> başladı."
                            }
                        },
                        {
                            "text": "Doubts started to <w>seep</w> into his mind during the difficult exam.",
                            "target_lang_translations": {
                                "tr": "Zor sınav sırasında zihnine şüpheler <w>nüfuz etmeye</w> başladı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seep into the community"
                    ],
                    "target_lang_definitions": {
                        "tr": "Duyguların, fikirlerin veya etkilerin yavaş yavaş içe işlemesi veya yayılması."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sızmak",
                                "target_lang_sense_clarification": "düşünce veya duygunun yavaşça yer etmesi"
                            },
                            {
                                "target_lang_word": "işlemek",
                                "target_lang_sense_clarification": "içine yerleşmek, nüfuz etmek"
                            },
                            {
                                "target_lang_word": "nüfuz etmek",
                                "target_lang_sense_clarification": "iç kısımlara kadar yayılmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6383f106-6392-3c4c-a9e7-0f41a705ec1c",
                    "sense_definition": "To allow a liquid to pass through or leak from a crack or opening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small crack in the pipe was <w>seeping</w> water onto the floor. ",
                            "target_lang_translations": {
                                "tr": "Borudaki küçük çatlak zemine su <w>sızdırıyordu</w>."
                            }
                        },
                        {
                            "text": "They noticed the old container was <w>seeping</w> oil into the garage.",
                            "target_lang_translations": {
                                "tr": "Eski konteynerin garaja yağ <w>sızdırdığını</w> fark ettiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "leak"
                    ],
                    "common_phrases": [
                        "seeping water"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir çatlaktan veya açıklıktan sıvının sızmasına izin vermek veya sızdırmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sızdırmak",
                                "target_lang_sense_clarification": "dışarıya sıvı kaçırmak"
                            },
                            {
                                "target_lang_word": "sızmak",
                                "target_lang_sense_clarification": "dışarıya doğru sızmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a8dd68f-f23a-3a07-8ee3-78fdf79f481d",
                    "sense_definition": "To diminish, drain, or fade away slowly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His remaining confidence slowly <w>seeped</w> away during the interview. ",
                            "target_lang_translations": {
                                "tr": "Mülakat sırasında kalan özgüveni de yavaşça <w>yok oldu</w>."
                            }
                        },
                        {
                            "text": "The energy from the crowd began to <w>seep</w> away as time passed.",
                            "target_lang_translations": {
                                "tr": "Zaman geçtikçe kalabalığın enerjisi <w>tükenmeye</w> başladı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seep away"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yavaşça azalmak, tükenmek veya yok olmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tükenmek",
                                "target_lang_sense_clarification": "yavaşça azalarak bitmek"
                            },
                            {
                                "target_lang_word": "yok olmak",
                                "target_lang_sense_clarification": "yavaşça kaybolmak"
                            },
                            {
                                "target_lang_word": "akıp gitmek",
                                "target_lang_sense_clarification": "elinden kayıp gitmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52e2c887-20f7-3380-bc18-8640bc9dc699",
                    "sense_definition": "To soak thoroughly or saturate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "soak_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After walking in the storm, they were <w>seeped</w> to the skin. ",
                            "target_lang_translations": {
                                "tr": "Fırtınada yürüdükten sonra <w>sırılsıklam oldular</w>."
                            }
                        },
                        {
                            "text": "The heavy morning rain <w>seeped</w> the ground completely.",
                            "target_lang_translations": {
                                "tr": "Sabahki şiddetli yağmur toprağı tamamen <w>ıslattı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seeped to the skin"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Scottish dialect"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İyice ıslanmak, sırılsıklam olmak veya neme doymak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sırılsıklam olmak",
                                "target_lang_sense_clarification": "baştan aşağı ıslanmak"
                            },
                            {
                                "target_lang_word": "ıslanmak",
                                "target_lang_sense_clarification": "tüm vücudu su çekmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59b457a3-7f22-308c-8f96-35bf60dcc250",
                    "sense_definition": "Moisture or liquid that leaks or oozes out gradually.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fluid_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toxic <w>seep</w> from the landfill contaminated the nearby soil. ",
                            "target_lang_translations": {
                                "tr": "Çöp depolama alanından çıkan toksik <w>sızıntı</w> yakındaki toprağı kirletti."
                            }
                        },
                        {
                            "text": "Engineers tried to stop the chemical <w>seep</w> near the river.",
                            "target_lang_translations": {
                                "tr": "Mühendisler nehrin yakınındaki kimyasal <w>sızıntıyı</w> durdurmaya çalıştılar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chemical seep"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yavaşça sızan veya dışarı çıkan nem ya da sıvı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sızıntı",
                                "target_lang_sense_clarification": "dışarı çıkan sıvı veya nem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef39c388-e4b0-3dc3-bf08-d97bcb12d1e1",
                    "sense_definition": "The slow process or act of leaking away.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fluid_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The continuous <w>seep</w> of groundwater caused the soil to erode. ",
                            "target_lang_translations": {
                                "tr": "Yeraltı suyunun sürekli <w>sızması</w> toprağın erozyona uğramasına neden oldu."
                            }
                        },
                        {
                            "text": "They monitored the slow <w>seep</w> of oil from the ship.",
                            "target_lang_translations": {
                                "tr": "Gemiden gerçekleşen yavaş petrol <w>sızıntısını</w> izlediler."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seep of groundwater"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sıvının yavaşça dışarı sızması süreci veya eylemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sızma",
                                "target_lang_sense_clarification": "sızma eylemi veya süreci"
                            },
                            {
                                "target_lang_word": "sızıntı",
                                "target_lang_sense_clarification": "sızan sıvı miktarı veya eylemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c28ae170-66f1-39f4-a0ad-f38042dd075d",
                    "sense_definition": "A spot, spring, or pool where underground liquid oozes to the surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An oil <w>seep</w> was visible on the surface of the rock formation. ",
                            "target_lang_translations": {
                                "tr": "Kaya oluşumunun yüzeyinde bir petrol <w>sızıntı noktası</w> görünüyordu."
                            }
                        },
                        {
                            "text": "Hikers found a tiny water <w>seep</w> near the bottom of the hill.",
                            "target_lang_translations": {
                                "tr": "Yürüyüşçüler tepenin eteğine yakın küçük bir su <w>kaynağı</w> buldular."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oil seep",
                        "water seep"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yeraltı sıvısının yüzeye yavaşça çıktığı nokta, kaynak veya birikinti."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sızıntı noktası",
                                "target_lang_sense_clarification": "sıvının yüzeye çıktığı yer"
                            },
                            {
                                "target_lang_word": "kaynak",
                                "target_lang_sense_clarification": "küçük su veya petrol kaynağı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d7df12a-ed73-30e3-a684-eb7e687cad9d",
                    "sense_definition": "A fluid vent or opening on the ocean floor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_seep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists discovered unique species living near the cold <w>seep</w> on the seafloor. ",
                            "target_lang_translations": {
                                "tr": "Bilim insanları deniz tabanındaki soğuk <w>sızıntı bacasının</w> yakınında yaşayan benzersiz türler keşfetti."
                            }
                        },
                        {
                            "text": "Deep ocean creatures thrive around the cold <w>seep</w>.",
                            "target_lang_translations": {
                                "tr": "Derin okyanus canlıları soğuk <w>sızıntı noktasının</w> etrafında gelişir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cold seep"
                    ],
                    "target_lang_definitions": {
                        "tr": "Okyanus tabanında gaz veya sıvının çıktığı baca veya açıklık."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sızıntı bacası",
                                "target_lang_sense_clarification": "deniz tabanındaki sıvı/gaz çıkışı"
                            },
                            {
                                "target_lang_word": "sızıntı noktası",
                                "target_lang_sense_clarification": "deniz tabanındaki çıkış alanı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}