                "senses": [
                    {
                        "sense_id": "5ce7f29b-76dd-35b4-948a-4e88752de1f7",
                        "entry_id": "c54a2333-4cdc-35dc-9066-602b916628d4",
                        "glosses": [
                            "Personne de très petite taille."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "85a9bd9b-c3c0-4644-940d-3ed454ee740d",
                                "sense_id": "5ce7f29b-76dd-35b4-948a-4e88752de1f7",
                                "text": "Cette grosse nabote alitée avait mis au monde ces trois filles dont la moins grande comptait un mètre soixante-dix."
                            },
                            {
                                "example_id": "581214bf-dd44-4e31-bfe2-ece772c235f7",
                                "sense_id": "5ce7f29b-76dd-35b4-948a-4e88752de1f7",
                                "text": "Or, ma silhouette m'apparaissait sous un nouvel angle à chaque tournant, déformée par les miroirs concaves, convexes et ondulés, qui me transformaient en nabote à la tête gigantesque et aux hanches musculeuses."
                            }
                        ]
                    }
                ],
