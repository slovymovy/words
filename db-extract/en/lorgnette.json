                                "target_senses": [
                                    {
                                        "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                        "entry_id": "6349b85f-3207-3322-a843-32517c00775e",
                                        "glosses": [
                                            "Sehhilfe für ein Auge, die mit einem Stiel vor das Auge gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54488105-0312-4260-ab9d-74515242097f",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "Ich brauche zum Lesen mein Lorgnon."
                                            },
                                            {
                                                "example_id": "575475dc-ee3d-4b18-9f24-51740524efee",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Im abgedunkelten Bibliothekszimmer meines verstorbenen Vaters - in den Kriegsnächten - beschwor er sie in improvisierten Gespensternoveletten, während geisterhaft Rainer Maria Rilke ihm vom Diwan durch sein Lorgnon zusah.“"
                                            },
                                            {
                                                "example_id": "7971a1da-b104-4a12-aeba-9b8bc97c7dcb",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Der Hausherr selbst hatte eine Adlernase und trug das einzige wirkliche Lorgnon, das ich jemals in meinem Leben auf einer Bauernnase gesehen habe.“"
                                            },
                                            {
                                                "example_id": "6630d18d-4587-4991-8617-66152dff46d9",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Fräulein Oppermann hielt sich etwas vor die Augen, das ich nur aus alten Romanen kannte, ein Lorgnon, und musterte mich wie eine aufgespießte Spinne.“"
                                            },
                                            {
                                                "example_id": "8373b173-4b0c-46f4-8a5e-2d36ae25ab61",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Die beiden Burschen konfiszierten ein Lorgnon meiner Großmutter, über dessen Verlust sie bis zum Ende ihres Lebens in den Sechzigerjahren klagte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73a8e490-b0ea-462b-8fbe-eb10a35b212e",
                        "source_entry_id": "4bdbf5a3-a8b4-3255-8549-bd3a6d43c857",
                        "source_sense_description": "opera glass with a handle",
                        "target_lang_word": "Lorgnette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lorgnette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0decce5-896a-3228-99b5-d27444ff82a3",
                                        "entry_id": "88bd6196-82ba-3472-890f-561ce0b1801f",
                                        "glosses": [
                                            "Sehhilfe ohne Bügel, die an einem Griff vor die Augen gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e532f53-aac8-4fa7-9de1-b68376c6bfc7",
                                                "sense_id": "b0decce5-896a-3228-99b5-d27444ff82a3",
                                                "text": "Sie schaute den Herrn durch ihre Lorgnette an, grüßte ihn und ging weiter."
                                            },
                                            {
                                                "example_id": "1e0b49c6-508c-4152-97f7-de0586f044b1",
                                                "sense_id": "b0decce5-896a-3228-99b5-d27444ff82a3",
                                                "text": "„Zwar brachte das Rocky-Mountains-Teleskop den Mond näher heran, aber die Erdatmosphäre schwächte die Lichtstärke derart, daß Barbicane mit Hilfe einer Lorgnette Einzelheiten wahrnehmen konnte, die den Astronomen dort unten verborgen blieben.“"
                                            },
                                            {
                                                "example_id": "abf7cb0d-6e5f-46d8-9aab-32c44bfa3264",
                                                "sense_id": "b0decce5-896a-3228-99b5-d27444ff82a3",
                                                "text": "„Alles das, versteht sich, im Wohnzimmer bei einem Glas starken Tee - die Männer mit buttergelben Handschuhen, die Frauen ließen ihre albernen Lorgnetten baumeln.“"
                                            },
                                            {
                                                "example_id": "954c53a0-b4d5-4af0-8103-b1d0c86bc3ea",
                                                "sense_id": "b0decce5-896a-3228-99b5-d27444ff82a3",
                                                "text": "„Den Kopf beugte sie stets etwas vor, um, ihrer Kurzsichtigkeit trotzend, den Gesprächspartner besser sehen zu können - gelegentlich behalf sie sich mit einer Lorgnette, um jenen Makel auszugleichen.“"
                                            },
                                            {
                                                "example_id": "0fe3af27-9f1b-48be-85fd-6992de821558",
                                                "sense_id": "b0decce5-896a-3228-99b5-d27444ff82a3",
                                                "text": "„Nun blickte er über den Rand seiner Lorgnette und bat Napoleon, seinen Vorwurf zu erläutern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
