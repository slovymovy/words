                                "target_senses": [
                                    {
                                        "sense_id": "91b2b062-2525-3bfb-afa1-432894c4e001",
                                        "entry_id": "d682bb34-b314-3161-9b12-4d45ba0fe660",
                                        "glosses": [
                                            "Variante orthographique de québracho"
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa41851f-ac82-4408-a6ec-4487c4cfd342",
                                                "sense_id": "91b2b062-2525-3bfb-afa1-432894c4e001",
                                                "text": "Il y a moins de 25 ans que l’on importe de l’Amérique du Sud le bois de quebracho et ses extraits et ses produits ont rapidement pris une grande importance en Allemagne, en Angleterre et dans tous les pays qui produisent moins de matières tannantes qu’ils n’en consomment."
                                            },
                                            {
                                                "example_id": "8b73d146-dc02-43a6-a1da-d861819c79ef",
                                                "sense_id": "91b2b062-2525-3bfb-afa1-432894c4e001",
                                                "text": "Les traverses de chemin de fer et les pieux qui permettent d’encercler de fils de fer les immenses étendues de la pampa, sont le principal emploi du quebracho en dehors de l’extraction du tanin."
                                            },
                                            {
                                                "example_id": "91d30041-a07e-40a1-8ab0-e1bfd6d5bdb9",
                                                "sense_id": "91b2b062-2525-3bfb-afa1-432894c4e001",
                                                "text": "Le quebracho est un arbre originaire d’Amérique du Sud dont l’écorce est utilisée à des fins médicinales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea919164-8bf9-48a0-bc70-7bc6d119120c",
                        "source_entry_id": "48abe995-4709-3c2c-9f08-37c3adaaac1d",
                        "source_sense_description": "дерево",
