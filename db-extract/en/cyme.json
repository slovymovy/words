                        "examples": []
                    },
                    {
                        "sense_id": "8bb3c6a4-f4f4-3bd4-9a0f-cc08c95a42ef",
                        "entry_id": "52a058d1-97ad-317c-89b9-b1770410bc04",
                        "glosses": [
                            "A flattish or convex flower cluster, of the centrifugal or determinate type, on which each axis terminates with a flower which blooms before the flowers below it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fbd8e91-0160-4e31-b8ec-7645b5f44f5c",
                                "sense_id": "8bb3c6a4-f4f4-3bd4-9a0f-cc08c95a42ef",
                                "text": "The inflorescence is some form of cyme, and the flowers are usually regular."
                            },
                            {
                                "example_id": "f08b7960-3612-423c-82fa-5179dfcdf9e8",
                                "sense_id": "8bb3c6a4-f4f4-3bd4-9a0f-cc08c95a42ef",
                                "text": "The plant bears small groups of two or three yellowish coloured flowers on an axillary cyme."
                            },
                            {
                                "example_id": "d0be88b0-74b7-431c-a214-61052a431202",
                                "sense_id": "8bb3c6a4-f4f4-3bd4-9a0f-cc08c95a42ef",
                                "text": "The flower cluster is a cyme (terminal flower is the most advanced), is terminal within the bud and may contain up to six individual flowers."
                            }
                        ]
                    },
