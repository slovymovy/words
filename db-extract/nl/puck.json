                                        "entry_id": "f71e8faf-e13c-3cf9-a960-073435d441c7",
                                        "glosses": [
                                            "The mischievous fairy-like creature from English folklore, like Puck from Shakespeare's \\\"A Midsummer Night's Dream\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
