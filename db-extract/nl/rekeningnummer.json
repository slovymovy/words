                    {
                        "sense_id": "073d4ffd-1ade-30ce-a05b-ea14e45a053b",
                        "entry_id": "ddfaaef2-3ced-35da-a8be-b8e8092f4e9d",
                        "glosses": [
                            "factuurnummer, het nummer van een factuur door een bedrijf gestuurd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "197f9f92-a107-4dea-9ef8-4a33ea6fcb1c",
                                "sense_id": "073d4ffd-1ade-30ce-a05b-ea14e45a053b",
                                "text": "Als je de rekening betaalt moet je zowel het rekeningnummer als het klantnummer invullen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5e70093-825a-3114-8ba6-85b74c9d1dd4",
                        "entry_id": "ddfaaef2-3ced-35da-a8be-b8e8092f4e9d",
                        "glosses": [
                            "het nummer van je bankrekening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d526c01b-778a-48f5-9a33-2b6c21e39c0c",
                                "sense_id": "b5e70093-825a-3114-8ba6-85b74c9d1dd4",
                                "text": "Tegenwoordig gebruiken we het IBAN nummer als rekeningnummer."
                            },
                            {
                                "example_id": "a6b073bd-6da2-4c39-b06a-02e147a9b5cc",
                                "sense_id": "b5e70093-825a-3114-8ba6-85b74c9d1dd4",
                                "text": "Van de 222 miljoen verstuurde papieren acceptgiro's vorig jaar, werd al 75 procent via internet betaald. Maar daarvoor moeten steeds het bedrag, rekeningnummer en betalingskenmerk worden overgetikt. Als consumenten rekeningen digitaal ontvangen, kunnen ze de betaling met een paar klikken regelen."
                            }
                        ]
                    }
