                        "sense_id": "41a8571c-b333-33b5-afa8-48a94cca6eb3",
                        "entry_id": "7f81e486-616c-366d-a345-1f42ebfc822b",
                        "glosses": [
                            "Any place or repository where things are placed indiscriminately or without careful thought."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08751ee9-cede-417b-a2e2-b885a785d5b7",
                                "sense_id": "41a8571c-b333-33b5-afa8-48a94cca6eb3",
                                "text": "If you're not careful, the entrance table will quickly become a catch-all for things that come in the door."
                            },
                            {
                                "example_id": "805942b3-3265-4a30-bffd-ab71dafb8d6b",
                                "sense_id": "41a8571c-b333-33b5-afa8-48a94cca6eb3",
                                "text": "The category was a catch-all for items that were not filed elsewhere."
                            },
                            {
                                "example_id": "a233633e-f81a-4659-94a7-cd269e47315c",
                                "sense_id": "41a8571c-b333-33b5-afa8-48a94cca6eb3",
                                "text": "Cancer is a catch-all term that encompasses a wide variety of diseases."
                            }
                        ]
                    }
                ],
