                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7cad7fb-e3ca-4af2-b8a5-3806641eb58e",
                                "sense_id": "f7532045-1401-3bed-97bc-dd4e73b95a16",
                                "text": "„Es gab zwar den vorbereiteten Unterschlupf in Montparnasse und feste Protokolle, an die er sich halten musste, aber davon wollte er angesichts der aktuellen Umstände nichts wissen.“"
                            },
                            {
                                "example_id": "3a400d3c-128e-4501-9a9c-7b7bf4730369",
                                "sense_id": "f7532045-1401-3bed-97bc-dd4e73b95a16",
                                "text": "„Bejammernswert schob sich das Trauergefolge, dem der herabpeitschende Schnee schon ab wenigen Metern völlig die Sicht nahm, durch die verlassenen Straßen Richtung Montparnasse voran.“"
                            },
                            {
                                "example_id": "0759007b-529c-456e-9d0b-8a87089365dc",
                                "sense_id": "f7532045-1401-3bed-97bc-dd4e73b95a16",
                                "text": "„Um sechs fuhr ein Zug nach Paris, bis zum Bahnhof Montparnasse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
