                                "target_senses": [
                                    {
                                        "sense_id": "34b1f0e0-fa1e-320c-87d0-fccdcf568c30",
                                        "entry_id": "04b04fcb-d492-3a30-aa1a-c24e968b522c",
                                        "glosses": [
                                            "Alternative form of burek."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df2acbe9-11da-4827-9044-e83daa6cb206",
                                                "sense_id": "34b1f0e0-fa1e-320c-87d0-fccdcf568c30",
                                                "text": "The leaves are very similar to those of Kazayağı which is found in the same location, and they are favorites for using in omelettes, böreks and meat stews. When very soft and tender the leaves may be fried with oil or butter till soft, and then used in böreks with white cheese, or served alone with cheese."
                                            },
                                            {
                                                "example_id": "a83afa40-1ccf-43c4-90ea-894853cd3fc7",
                                                "sense_id": "34b1f0e0-fa1e-320c-87d0-fccdcf568c30",
                                                "text": "The tall cylindrical basket hung across his shoulders is probably full of böreks."
                                            },
                                            {
                                                "example_id": "398bc095-dd74-48d2-8667-2a39fdbd19cc",
                                                "sense_id": "34b1f0e0-fa1e-320c-87d0-fccdcf568c30",
                                                "text": "Auntie Ipek will be waiting for us in Yozgat, her bags full of böreks. […] ‘Here, have a börek, Suna, and when you’ve eaten your fill, you can tell us all over again about how you found us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
