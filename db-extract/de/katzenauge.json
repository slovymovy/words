                    },
                    {
                        "form_id": "2d6b586f-58fa-4632-8cfe-dab6743e05c1",
                        "entry_id": "db5289ab-28d7-35a8-8869-2538492408dc",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Katzenauge"
                    },
                    {
                        "form_id": "615dfd07-8eca-4ca9-97ef-aa9c7e315ef8",
                        "entry_id": "db5289ab-28d7-35a8-8869-2538492408dc",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Katzenaugen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "205cf704-4f38-3138-b38f-a9fb3b5fcacc",
                        "entry_id": "db5289ab-28d7-35a8-8869-2538492408dc",
                        "glosses": [
                            "Auge einer Katze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db92ed5-42eb-4568-9843-aa3b04a2bcbe",
                                "sense_id": "205cf704-4f38-3138-b38f-a9fb3b5fcacc",
                                "text": "Mit Katzenaugen könnten wir Menschen nachts besser sehen."
                            },
                            {
                                "example_id": "d464f412-db38-4f9a-b854-55c21bd160d3",
                                "sense_id": "205cf704-4f38-3138-b38f-a9fb3b5fcacc",
                                "text": "Werden die Katzenaugen in einer bestimmten, frühen Entwicklungsphase des Tieres geschlossen – die Wissenschaftler sprechen hier von „Reizentzug“ – , können die Katzen später nichts mehr sehen, manchmal ihr ganzes Leben lang."
                            },
                            {
                                "example_id": "ee849491-e7b6-48a8-bace-e230d3843685",
                                "sense_id": "205cf704-4f38-3138-b38f-a9fb3b5fcacc",
                                "text": "Katzenaugen sind immer noch wesentlich empfindlicher als die meisten Kameras."
                            },
                            {
                                "example_id": "0d554aec-b46c-4d25-8892-3ba94080d594",
                                "sense_id": "205cf704-4f38-3138-b38f-a9fb3b5fcacc",
                                "text": "Im spärlichen Abendlicht müssen sich ihre Pupillen sehr weit öffnen können. Dabei wird auch die Linse im Katzenauge großflächig ausgenutzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b2153fa1-d57d-306b-9630-42104f7fb7b7",
                        "entry_id": "db5289ab-28d7-35a8-8869-2538492408dc",
                        "glosses": [
                            "Reflektor an Fahrzeugen, insbesondere am Fahrrad"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "074ed697-9761-4e98-871c-55ba74dad788",
                                "sense_id": "b2153fa1-d57d-306b-9630-42104f7fb7b7",
                                "text": "Durch die Katzenaugen sah der Autofahrer den Fahrradfahrer gerade noch rechtzeitig."
                            },
                            {
                                "example_id": "85471ab5-325e-4fac-9986-aa00ace41139",
                                "sense_id": "b2153fa1-d57d-306b-9630-42104f7fb7b7",
                                "text": "Sein Rollstuhl ist grün angemalt und hat kleine blitzende Katzenaugen auf der Rückseite."
                            },
                            {
                                "example_id": "96807a33-7564-4915-91ff-03630f9f31e8",
                                "sense_id": "b2153fa1-d57d-306b-9630-42104f7fb7b7",
                                "text": "„Oh, es war furchtbar, ihm ohne Katzenauge in die Hände zu fallen!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e18c7729-0664-30e6-acdf-20e3f1de7e46",
                        "entry_id": "db5289ab-28d7-35a8-8869-2538492408dc",
                        "glosses": [
                            "reflektierender Lichteffekt bei Mineralien und Schmucksteinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f08222-4787-4176-805c-5ca1c67630cf",
                                "sense_id": "e18c7729-0664-30e6-acdf-20e3f1de7e46",
                                "text": "Er sammelte seit seiner Kindheit Katzenaugen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
