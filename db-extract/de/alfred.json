                "senses": [
                    {
                        "sense_id": "e55a03df-cf8b-3725-ba13-e18fc6d5ad23",
                        "entry_id": "c9eb0d39-7eb5-327b-8759-5b39af9c1586",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fc23f62-bc4a-412e-9a94-322a24f62316",
                                "sense_id": "e55a03df-cf8b-3725-ba13-e18fc6d5ad23",
                                "text": "Alfred ist eine Seele von Mensch."
                            },
                            {
                                "example_id": "13d42f03-ce85-4d49-830f-f8f29ce41eb7",
                                "sense_id": "e55a03df-cf8b-3725-ba13-e18fc6d5ad23",
                                "text": "„Ins Basislager am Fuß des Bergs begleiteten ihn sein Bruder Vincent und sein Vater Alfred, der als junger Mann Touren im Himalaja unternommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24d0e349-9c02-49a7-adf7-a6bb30c88ddb",
                        "source_entry_id": "c9eb0d39-7eb5-327b-8759-5b39af9c1586",
                        "source_sense_id": "e55a03df-cf8b-3725-ba13-e18fc6d5ad23",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Alfred",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alfred",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d51316a9-71d9-39ad-8e31-7f8a21a61401",
                                        "entry_id": "df7f062b-185a-35ec-8ea0-b0d595d857a7",
                                        "glosses": [
                                            "Prénom masculin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d3887ca-43ce-4286-87d9-fffeef408aa6",
                                                "sense_id": "d51316a9-71d9-39ad-8e31-7f8a21a61401",
                                                "text": "« Alfred. Vous avez les coordonnées ?\n— Presque Monsieur. Il y a plus d’interférences que d’habitude. »"
                                            },
                                            {
                                                "example_id": "185db95c-b077-4ded-aca2-2cf1524fc6c4",
                                                "sense_id": "d51316a9-71d9-39ad-8e31-7f8a21a61401",
                                                "text": "Attablé à une terrasse, cours de la République, un nom qui sonne toujours bien à l'oreille, Alfred expliqua qu'il était en phase de récupération."
                                            },
                                            {
                                                "example_id": "6745d569-64ba-4485-8c58-8d89beae32f8",
                                                "sense_id": "d51316a9-71d9-39ad-8e31-7f8a21a61401",
                                                "text": "L’architecte choisi pour construire cette première gare à Saint-Cloud est Alfred Armand (1805-1888), ancien élève de l'école des beaux-arts, disciple des architectes Jean-Louis Provost et Achille Leclère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
