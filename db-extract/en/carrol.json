                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "fb26be23-0668-4fa7-9901-fd567588d68d",
                                "sense_id": "fe72fe59-c1d0-3185-89b6-01c15d7c9b39",
                                "text": "As the lark with vary'd tune, / Carrols to the evening loud; / Mark the mild reſplendent moon, / Breaking through a parted cloud!"
                            },
                            {
                                "example_id": "0b836987-5edc-40c0-a175-886a2409db19",
                                "sense_id": "fe72fe59-c1d0-3185-89b6-01c15d7c9b39",
                                "text": "[…] Ye villagers rejoice; / And ye who cultivate the fertile glebe / Carrol the gladſome ſong. For you the plain / Shall wave with wheaten harveſts; and the gale / From blooming bean-fields ſhall diffuſe perfume."
                            }
                        ]
                    }
