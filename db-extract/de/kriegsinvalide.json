                "senses": [
                    {
                        "sense_id": "1b6c76ae-7fe9-3061-bc3e-71dfd4fd7e9c",
                        "entry_id": "3dfe0342-8e88-32ed-8e39-a2e735b277c7",
                        "glosses": [
                            "Soldat, der aufgrund von Kriegsfolgen nicht mehr arbeitsfähig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6637e5df-9f8f-4a0a-bf06-8c88775a04a3",
                                "sense_id": "1b6c76ae-7fe9-3061-bc3e-71dfd4fd7e9c",
                                "text": "„Er sei aber kein Kriegsinvalide, habe er zornig gerufen, er sei ein Student, er studiere Philosophie.“"
                            },
                            {
                                "example_id": "b467478b-b575-490b-9180-45701f4cfbd6",
                                "sense_id": "1b6c76ae-7fe9-3061-bc3e-71dfd4fd7e9c",
                                "text": "„In der Regel waren die Kriegsinvaliden die Ersten in jeder Schlange.“"
                            },
                            {
                                "example_id": "2393e7d6-57a1-4488-b772-50321aec301f",
                                "sense_id": "1b6c76ae-7fe9-3061-bc3e-71dfd4fd7e9c",
                                "text": "„Der Kriegsinvalide Bartasch und der Bergmann Handrik erholen sich überhaupt nicht.“"
                            },
                            {
                                "example_id": "eb4c29ab-4578-46c4-9839-f810cfa1318a",
                                "sense_id": "1b6c76ae-7fe9-3061-bc3e-71dfd4fd7e9c",
                                "text": "„Es entstanden große Wohnsiedlungen mit modernen sanitären Anlagen und Elektrizität, vor allem für kinderreiche Familien, Kriegsinvaliden und Kriegerwitwen.“"
                            }
                        ],
