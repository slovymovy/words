                                        "entry_id": "350f9b26-5bc0-3adc-b9ac-d3fa68379fa9",
                                        "glosses": [
                                            "богатый человек, занимающийся благотворительной деятельностью, покровительствующий развитию культуры, искусства, науки и оказывающий им финансовую поддержку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc1c1dff-ce1f-404b-a28b-7e03b6cb6370",
                                                "sense_id": "e5f68a78-3e44-3f41-8e64-90acf120ae5d",
                                                "text": "Муж Аннушки рекомендовал молодого поэта одному вельможному покровителю литературы, и Миша поспешил представиться своему будущему меценату."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cfff317-bdcb-3366-9f8f-cf681c8a14d6",
                                        "entry_id": "350f9b26-5bc0-3adc-b9ac-d3fa68379fa9",
                                        "glosses": [
                                            "разг. тот, кто оказывает бескорыстную помощь людям"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dcb91c8-b929-4657-a609-4d79dd5f48e5",
                        "source_entry_id": "85a4e522-c31c-39b4-b462-5aec818ecabe",
                        "source_sense_id": "17eefcd1-2a14-3653-91ae-942cb9d546ef",
                        "target_lang_word": "Anwalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anwalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                        "entry_id": "ca6ea344-51f4-3f41-8851-b6c1839908f8",
                                        "glosses": [
                                            "bevollmächtigter Rechtsvertreter"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325ae5e1-492a-4ae0-b3f8-c877101a9f9e",
                                                "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                                "text": "Der Angeklagte wird durch seinen Anwalt entlastet."
                                            },
                                            {
                                                "example_id": "e8db64d0-b59f-47cb-95f3-554d92ad9642",
                                                "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                                "text": "„Häufig suchen auch die Anwälte reicher Anleger seinen Rat, wenn sie Ärger mit der Steuer befürchten.“"
                                            },
                                            {
                                                "example_id": "8a0d7bd0-33e5-48b4-929b-ab06664977ba",
                                                "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                                "text": "„Manchen Anwälten entziehen die Behörden die Lizenz, wenn man glaubt, dass es mit den Veränderungen reicht.“"
                                            },
                                            {
                                                "example_id": "346405a2-1311-407f-a663-e6a8e05f9a96",
                                                "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                                "text": "„Die beiden Anwälte werden lebendig.“"
                                            },
                                            {
                                                "example_id": "13078789-3677-4680-9846-73ca67a42482",
                                                "sense_id": "c48656b6-4387-3f87-9d7e-3cd04c5bdd33",
                                                "text": "„Auf der rechten Seite sah er Henni mit ihrem Anwalt und auf der linken Schwester Angelika in ihrem Habit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "913a6947-a413-3e96-8a1e-67caf31864d6",
                                        "entry_id": "ca6ea344-51f4-3f41-8851-b6c1839908f8",
                                        "glosses": [
                                            "Person, die sich für etwas/jemanden nachhaltig einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7ad1a6-73ab-4616-87df-e3077c26bbf0",
                                                "sense_id": "913a6947-a413-3e96-8a1e-67caf31864d6",
                                                "text": "Die Wissenschaftsminister sind nicht immer die besten Anwälte der Studenten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
