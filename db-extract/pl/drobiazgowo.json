                                        "entry_id": "e2794e1f-b1aa-366f-90db-047e868a3a88",
                                        "glosses": [
                                            "With attention to tiny details."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18baf036-ccfe-4798-921c-20a0f04fd982",
                                                "sense_id": "73c74471-48aa-3109-99e7-b79e2e2dbf20",
                                                "text": "To describe them in full, and to recount minutely the ideas held by the Japanese rustics concerning them, would be to compile an octavo work on dragonology."
