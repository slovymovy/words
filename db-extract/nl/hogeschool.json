                    {
                        "sense_id": "3a084204-8c1c-372f-9835-676e76815068",
                        "entry_id": "fda42423-4c08-39cf-86cf-da8984115f0f",
                        "glosses": [
                            "onderwijsinstelling voor hoger beroepsonderwijs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31d4c0b2-df9a-4aed-8671-827ca67c914d",
                                "sense_id": "3a084204-8c1c-372f-9835-676e76815068",
                                "text": "Daar moet meer geld naar het compenseren van scholen die te maken hebben met veel ‘switchers’; leerlingen die stoppen en overstappen naar een andere hogeschool."
                            }
                        ]
                    },
                    {
                        "sense_id": "48edd816-5f46-3b62-a98f-312555fd164b",
                        "entry_id": "fda42423-4c08-39cf-86cf-da8984115f0f",
                        "glosses": [
                            "instelling waar universitair onderwijs wordt gegeven in een beperkt aantal studierichtingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50d5af75-13dc-4369-8ae6-def65caf6a0f",
                                "sense_id": "48edd816-5f46-3b62-a98f-312555fd164b",
                                "text": "Tot halverwege de jaren tachtig van de twintigste eeuw was de naam hogeschool voorbehouden aan instellingen voor hoger onderwijs die op universitair niveau functioneerden, maar niet het (volledige) aanbod van de \"klassieke\", brede universiteiten hadden"
                            },
                            {
                                "example_id": "7ed743f9-9e72-4167-a812-a6aa4a11fb6a",
                                "sense_id": "48edd816-5f46-3b62-a98f-312555fd164b",
                                "text": "Op 25 september 1985 werd wettelijk besloten dat de naam 'Technische Hogeschool Delft' per 1 september 1986 zou worden omgevormd tot 'Technische Universiteit Delft'."
                            }
                        ]
                    },
                    {
                        "sense_id": "87432d7c-4040-396f-b681-5e77085efc59",
                        "entry_id": "fda42423-4c08-39cf-86cf-da8984115f0f",
                        "glosses": [
                            "hogere dressuur van paarden"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6716262-022a-4aa7-b263-76bee3e6b525",
                        "source_entry_id": "fda42423-4c08-39cf-86cf-da8984115f0f",
                        "source_sense_description": "instelling waar hoger onderwijs wordt gegeven in bepaalde vakken",
                        "target_lang_word": "Fachhochschule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fachhochschule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bdffcc8-efff-3cad-8bdf-c0791aeb73fc",
                                        "entry_id": "dd544dad-18a3-3769-aec1-9580aeed6051",
                                        "glosses": [
                                            "Hochschule mit überwiegend anwendungsorientierten Studiengängen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a013af-9bc8-467f-805c-1237957c4fd0",
                                                "sense_id": "7bdffcc8-efff-3cad-8bdf-c0791aeb73fc",
                                                "text": "Die Fachhochschule hat 4000 Studenten in 8 Fachbereichen."
                                            },
                                            {
                                                "example_id": "013a6283-61b4-48b1-84d0-17e762f4f3d1",
                                                "sense_id": "7bdffcc8-efff-3cad-8bdf-c0791aeb73fc",
                                                "text": "„Wenn man derzeit von Forderungen liest, auch den Fachhochschulen das Promotionsrecht einzuräumen, kann man sich die Ergebnisse vorstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74dd4afc-f363-4898-b69e-1f5c34a1e904",
                        "source_entry_id": "fda42423-4c08-39cf-86cf-da8984115f0f",
                        "source_sense_description": "instelling waar hoger onderwijs wordt gegeven in bepaalde vakken",
                        "target_lang_word": "academia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "academia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "03bfe92a-23ba-3866-bab8-90dd6273d669",
                                        "entry_id": "697ff2f4-0d58-39f3-8b56-22cc52afbba9",
                                        "glosses": [
                                            "Sociedad científica, literaria o artística cuyo establecimiento tiene autoridad pública."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac26bed6-b05d-4ba0-8c04-a87e1d78b322",
                                                "sense_id": "03bfe92a-23ba-3866-bab8-90dd6273d669",
                                                "text": "«La academia se alteró con la intempestiva visita, y el atrevido alguacil dijo:\n—Vuestras mercedes no se alboroten (…)»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3388aa04-9dcb-314f-a3a4-db6b6fd1b3d2",
                                        "entry_id": "697ff2f4-0d58-39f3-8b56-22cc52afbba9",
                                        "glosses": [
                                            "Lugar docente donde se da enseñanza a los alumnos que quieren prepararse para una carrera o profesión."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b1a8f3f-d709-4292-bfbd-14e0e8ab8564",
                                                "sense_id": "3388aa04-9dcb-314f-a3a4-db6b6fd1b3d2",
                                                "text": "«(…) Idolatría y perdición\nfue curante este sacro\nevangelista más volante.\nLos estudios de Academia\nde gentiles, los de Atenas y\n Tirenia, tan sutiles, como\n cosas infantiles disputante\nlos venciste, evangelista\nmás volante»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fd6a8785-bbc9-32ae-ae7c-833307f83a5c",
                                        "entry_id": "697ff2f4-0d58-39f3-8b56-22cc52afbba9",
                                        "glosses": [
                                            "Sociedad de hombres de letras, sabios y artistas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd6c445f-88e1-4eca-8cd0-84293ac623f3",
                                                "sense_id": "fd6a8785-bbc9-32ae-ae7c-833307f83a5c",
                                                "text": "«(…) Fue este philosopho plato assi como lo fallamos por los escriptores; grand sabio & philosopho en el saber de la logica (…) & en la astronomia & en otros saberes (…) & ouo este sabio despues de plato Academia»."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f0e6177c-d64d-36cb-af95-8dc376047f0d",
                                        "entry_id": "697ff2f4-0d58-39f3-8b56-22cc52afbba9",
                                        "glosses": [
                                            "Ejercicio de pintura o dibujo en que se trabaja con arreglo a un modelo desnudo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7a08949e-bb44-3c47-b36f-14e05b670bfc",
                                        "entry_id": "697ff2f4-0d58-39f3-8b56-22cc52afbba9",
                                        "glosses": [
                                            "En la terminología antigua se llama así al estudio de una figura entera y desnuda tomada al natural y que no forma parte de una composición."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
