                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De studenten luisterden <w>aandachtig</w> naar de uitleg van de docent.",
                            "target_lang_translations": {
                                "en": "The students listened <w>attentively</w> to the teacher's explanation.",
                                "ru": "Студенты <w>внимательно</w> слушали объяснение преподавателя.",
                                "zh": "学生们<w>专心地</w>听老师讲解。"
                            }
                        },
                        {
                            "text": "Hij bekeek het schilderij <w>aandachtig</w> voordat hij verder liep.",
                            "target_lang_translations": {
                                "en": "He examined the painting <w>closely</w> before walking on.",
                                "ru": "Он <w>внимательно</w> рассмотрел картину, прежде чем пойти дальше.",
                                "zh": "他<w>仔细地</w>端详了那幅画，然后继续往前走。"
                            }
                        }
                    ],
                    "synonyms": [
