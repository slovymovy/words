                        "glosses": [
                            "Trainailler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05a05044-7ca6-47f1-8ee6-32daac972923",
                                "sense_id": "be499176-427f-31e4-977f-abd722cbf9e9",
                                "text": "Il trainaille, il se rendort et retrainaille au lit et puis, résultat, il traine son ptit Poussin qui n’est pas plus réveillé que lui pour partir travailler."
                            },
                            {
                                "example_id": "437a21d4-38e9-459a-981f-0748a6b35293",
                                "sense_id": "be499176-427f-31e4-977f-abd722cbf9e9",
                                "text": "Je me suis levée tôt pour accompagner mon homme à la gare, puis hop j’ai traînaillé devant le pc, des lustres que ça ne m’était pas arrivé, ensuite je suis allée prendre une douche chaude, me suis préparé un masque qui me nettoie la peau alors même que je retrainaille devant le pc."
                            }
                        ]
                    }
