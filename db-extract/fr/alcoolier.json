                        "cross_references": [
                            {
                                "target_word": "Alkohol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5520dfd9-f42e-3e61-a5b3-37357bbeb60e",
                                        "entry_id": "ed012e8b-959f-352c-86e1-946b9ce09a2a",
                                        "glosses": [
                                            "gängige Bezeichnung für Ethanol"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08165a51-4d57-49d6-ba0b-f91d83322591",
                                                "sense_id": "5520dfd9-f42e-3e61-a5b3-37357bbeb60e",
                                                "text": "In diesem Bier sind 5 % Alkohol enthalten."
                                            },
                                            {
                                                "example_id": "84a5852f-b035-43b6-8e5c-5fb29319c37c",
                                                "sense_id": "5520dfd9-f42e-3e61-a5b3-37357bbeb60e",
                                                "text": "„Alkohol ist überall im Norden ein Reizthema, zwischen magnetischer Anziehung und Verteufelung gibt es hier selten einen vernünftigen Mittelweg.“"
                                            },
                                            {
                                                "example_id": "dae43a27-fff8-47dc-bed5-b37783d0d0ca",
                                                "sense_id": "5520dfd9-f42e-3e61-a5b3-37357bbeb60e",
                                                "text": "„Oft sind Alkohol und Drogen im Spiel.“"
                                            },
                                            {
                                                "example_id": "494dc307-e370-42b8-817d-5952d6876809",
                                                "sense_id": "5520dfd9-f42e-3e61-a5b3-37357bbeb60e",
                                                "text": "„Im Ernst: Zu viel Alkohol ist schädlich für Körper und Geist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b215342-2bd1-3b73-b317-e8967cb84c03",
                                        "entry_id": "ed012e8b-959f-352c-86e1-946b9ce09a2a",
                                        "glosses": [
                                            "gängige Bezeichnung für Ethanol",
                                            "speziell und kurz für Getränk, welches Ethanol enthält; Trinkalkohol"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ac0d70a-33f7-4af8-94ad-dcd5d7a73463",
                                                "sense_id": "4b215342-2bd1-3b73-b317-e8967cb84c03",
                                                "text": "Ich habe gestern zu viel Alkohol getrunken."
                                            },
                                            {
                                                "example_id": "de7089b7-5e72-447a-b083-82cf50f4469a",
                                                "sense_id": "4b215342-2bd1-3b73-b317-e8967cb84c03",
                                                "text": "„Mir ist Alkohol nicht so wichtig, ich trinke ihn selten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "fdae070f-4a64-36a2-a7f2-117413cf75a6",
                                        "entry_id": "ed012e8b-959f-352c-86e1-946b9ce09a2a",
                                        "glosses": [
                                            "Bezeichnung für eine Kohlenstoffverbindung mit mindestens einer Hydroxylgruppe als funktionelle Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e354476-b3f3-4926-ace3-42e6cb592948",
                                                "sense_id": "fdae070f-4a64-36a2-a7f2-117413cf75a6",
                                                "text": "Glycerin ist ein dreiwertiger Alkohol."
                                            },
                                            {
                                                "example_id": "dcdb1201-f667-4728-878e-e9124637c026",
                                                "sense_id": "fdae070f-4a64-36a2-a7f2-117413cf75a6",
                                                "text": "„Alkohol ist zwar für die Gesundheit des Menschen schädlich, für viele Krankheitserreger ist er dagegen absolut tödlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
