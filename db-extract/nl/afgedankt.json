                                "target_senses": [
                                    {
                                        "sense_id": "e7e6297d-5f39-3981-b3fa-001bfa5db08a",
                                        "entry_id": "abcffd2e-e9c9-3852-ae5f-7f2dfa34f761",
                                        "glosses": [
                                            "Not having been considered; treated as unimportant; rejected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84fef93e-1712-47dd-b1a8-16cb2b65ff7e",
                                                "sense_id": "e7e6297d-5f39-3981-b3fa-001bfa5db08a",
                                                "text": "Eve and the \"concrete woman\" are no more dismissed than Adam and the \"concrete man\" but are represented as capable of being converted and saved."
                                            },
                                            {
                                                "example_id": "5497bc7d-d13b-4a51-a830-24e30d953dd3",
                                                "sense_id": "e7e6297d-5f39-3981-b3fa-001bfa5db08a",
                                                "text": "I was tearing up, feeling completely out of control, very dismissed."
                                            },
                                            {
                                                "example_id": "c1f73902-229c-490f-a20b-4d210742c0e7",
                                                "sense_id": "e7e6297d-5f39-3981-b3fa-001bfa5db08a",
                                                "text": "The more generic you are when you communicate with someone, the more dismissed they feel."
                                            },
                                            {
                                                "example_id": "f12cc053-90d6-4b41-ae5b-ede202afae33",
                                                "sense_id": "e7e6297d-5f39-3981-b3fa-001bfa5db08a",
                                                "text": "And maybe Hazira was always going to be a gooey marshland, but that doesn't mean you entice the nation's poorest and most dismissed groups to live there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2abfa3ce-3452-3ed9-b26d-9f014a09070f",
                                        "entry_id": "abcffd2e-e9c9-3852-ae5f-7f2dfa34f761",
                                        "glosses": [
                                            "Having been fired or let go; having had one's employment terminated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea906c58-dde3-44a2-960c-0f8b92312890",
                                                "sense_id": "2abfa3ce-3452-3ed9-b26d-9f014a09070f",
                                                "text": "Since this time BPG factory management have reneged on this agreement and stated they will only reemploy the dismissed workers at a separate facility — an hour away from the current one, an offer rejected by the workers, who have the right to return to the same factory and to their previous positions."
                                            },
                                            {
                                                "example_id": "11e8f2e0-a48a-4afd-8ac5-5a617536865c",
                                                "sense_id": "2abfa3ce-3452-3ed9-b26d-9f014a09070f",
                                                "text": "Future studies can examine its other antecedents and its consequences to both the firm and to the dismissed CEO."
                                            },
                                            {
                                                "example_id": "8c78adf5-6f2f-4642-91ad-b68be287e9af",
                                                "sense_id": "2abfa3ce-3452-3ed9-b26d-9f014a09070f",
                                                "text": "During the notice period all dismissed employees – regardless of whether the dismissals was due to economic reasons or incompetence – are entitled to a minimum of two hours per week to search for employment."
                                            }
                                        ]
                                    }
                                ]
                            },
