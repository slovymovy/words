                                        "glosses": [
                                            "An archipelago of Southeast Asia: Indonesian Archipelago, the islands comprising the country of Indonesia or to the geographical groups which include its islands."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de105ef8-2955-3d00-b023-9b8e92897b54",
                                        "entry_id": "6db9dfc2-36f0-39c2-8673-71f667e1ab06",
                                        "glosses": [
                                            "A country in Southeast Asia: Endonym for the Republic of Indonesia, including everything contained within it (i.e., covering the regions, people, cultures, languages, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d188d05-4022-3729-a9f6-6fc4586baf02",
                                        "entry_id": "6db9dfc2-36f0-39c2-8673-71f667e1ab06",
                                        "glosses": [
                                            "The planned capital city of Indonesia in East Kalimantan, on Borneo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82cad17d-d6d8-4a56-bf94-02defbed2826",
                                                "sense_id": "2d188d05-4022-3729-a9f6-6fc4586baf02",
                                                "text": "The de jure capital city of Indonesia is Nusantara, located in the eastern coast of Kalimantan island."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15a179b1-2ea2-3a12-a982-8fd7b32efca0",
                                        "entry_id": "6db9dfc2-36f0-39c2-8673-71f667e1ab06",
                                        "glosses": [
