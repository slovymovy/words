                ],
                "senses": [
                    {
                        "sense_id": "e8f6f263-c231-37e1-a192-71c5ea351fed",
                        "entry_id": "9fea3767-f566-3c2f-88ec-1643e768f10b",
                        "glosses": [
                            "Fähigkeit, mit der Sprache wirkungsvoll umgehen zu können; Redebegabung"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f49c12e5-705a-4a20-b86a-ce5c1ff5befc",
                                "sense_id": "e8f6f263-c231-37e1-a192-71c5ea351fed",
                                "text": "„Sie werden, wenn sie sich nicht ändern, oder zumindest eine Anführereigenschaft wie Charisma und Redebegabtheit, aufweisen, nie etwas Richtiges erreichen.“"
                            },
                            {
                                "example_id": "68996173-b03c-44e4-a5c9-606961fe5bff",
                                "sense_id": "e8f6f263-c231-37e1-a192-71c5ea351fed",
                                "text": "„Der Adel entsteht durch Reichtum, eine große Kinder- oder Sklavenzahl, Redebegabtheit beim Palaver, u. s. w.; er geht nur durch Armut verloren.“"
                            },
                            {
                                "example_id": "72cc1cfb-387d-4eee-8cbc-adefa673ece0",
                                "sense_id": "e8f6f263-c231-37e1-a192-71c5ea351fed",
                                "text": "„Im Spielmannsgedicht liegt der Anlass, den Raben zum Boten zu wählen, in seiner Redebegabtheit.“"
                            },
                            {
                                "example_id": "c6f7e113-d919-4998-8ae8-b6f4c655af46",
                                "sense_id": "e8f6f263-c231-37e1-a192-71c5ea351fed",
                                "text": "„Der Vortritt der Hand verrät teleologische Einsicht in die besondere Eigenart der menschlichen Gestalt: die Hand ist nicht in erster Linie Werkzeug, sondern Voraussetzung für die Redebegabtheit, insofern durch sie der Mund der Bestimmung zu ausschließlich niederen Funktionen […] überhoben wird und zum Organ vernünftiger Rede disponiert ist, die die eine Seite des menschlichen Logos darstellt.“"
                            },
                            {
                                "example_id": "24fc86c4-4f1c-46a0-b313-cc1c13ec7ad5",
                                "sense_id": "e8f6f263-c231-37e1-a192-71c5ea351fed",
                                "text": "„Hieraus läßt sich schließen, daß Kühnen als Führerfigur mit außergewöhnlicher Redebegabtheit und langjähriger, in diesen Kreisen als höchste Ehre angesehener ‚Gesinnungshaftzeit‘ nicht einfach so durch einen anderen Führer ersetzt werden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
