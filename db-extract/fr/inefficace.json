                ],
                "senses": [
                    {
                        "sense_id": "e27a97ab-b9c1-3f14-bebd-1db27ad46dec",
                        "entry_id": "19dab8c3-facf-351c-8631-c74830e8468c",
                        "glosses": [
                            "Qui n’a pas d’efficacité, qui ne produit pas son effet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be1d0465-e28c-44db-bdce-d083df8b2fd4",
                                "sense_id": "e27a97ab-b9c1-3f14-bebd-1db27ad46dec",
                                "text": "Et puis, il a desserré peu à peu le crin, dégagé le cou. Il s’est assuré que la bête est indemne, la strangulation inefficace encore."
                            },
                            {
                                "example_id": "ed509593-95b4-4bac-9d70-21c0a0318e4d",
                                "sense_id": "e27a97ab-b9c1-3f14-bebd-1db27ad46dec",
                                "text": "Tous les remèdes qu’on a appliqués à ce malade ont été inefficaces."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b95c597-4b77-48a2-a836-581fadb5a91f",
                        "source_entry_id": "19dab8c3-facf-351c-8631-c74830e8468c",
                        "source_sense_id": "e27a97ab-b9c1-3f14-bebd-1db27ad46dec",
                        "source_sense_description": "Qui n’a pas d’efficacité",
                        "target_lang_word": "unwirksam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwirksam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72a5c4e1-fff1-373e-98ee-465e5e4762de",
                                        "entry_id": "a924ed8c-f80d-3c24-8aff-00ca8a8cabd0",
                                        "glosses": [
                                            "ohne Wirkung; eine Handlung, die folgenlos bleibt; etwas, das nichts verändert und welches das Vorher und das Nachher ununterscheidbar hinterlässt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "110c067d-9e23-442e-82c8-2c87ee54ac71",
                                                "sense_id": "72a5c4e1-fff1-373e-98ee-465e5e4762de",
                                                "text": "„Er hat kommende Katastrophen vorausgesehen, aber er hat sie mit unwirksamen Mitteln zu verhüten versucht.“"
                                            },
                                            {
                                                "example_id": "7d12debf-6ca5-4777-9516-4e8ab025cb38",
                                                "sense_id": "72a5c4e1-fff1-373e-98ee-465e5e4762de",
                                                "text": "„Es ergibt sich der eigenartige Fall, daß man, nachdem man nicht A sagte, um nicht auch B sagen zu müssen, nunmehr B sagt, um nicht A sagen zu brauchen; denn der empfohlene Abbruch der diplomatischen Beziehungen läuft praktisch auf kaum etwas anderes hinaus als auf eben das, was auch der Artikel 41 vorsieht, und was, wenn es „unwirksam“ bleibt, dann auch zu Artikel 42 führen kann.“"
                                            },
                                            {
                                                "example_id": "36283ec9-ea60-4e88-8774-0ba1349d1950",
                                                "sense_id": "72a5c4e1-fff1-373e-98ee-465e5e4762de",
                                                "text": "„Angesichts der Zollschranken nämlich konnte keine Rede mehr von freiem Unternehmertum sein: Mochten die klassischen Argumente der liberalen Wirtschaftler noch so rational sein – angesichts der irrationalen nationalistischen Leidenschaften waren ihre Lehren unwirksam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6026116-b7ad-38dc-8de9-7cc470dbb862",
                                        "entry_id": "a924ed8c-f80d-3c24-8aff-00ca8a8cabd0",
                                        "glosses": [
                                            "ohne Wirkung; bestimmte Dinge bleiben rechtlich folgenlos"
                                        ],
                                        "tags": [
                                            "Recht/Rechtsgeschäft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b2f29ef-1c4e-45dd-a510-73ad53ce1a44",
                                                "sense_id": "b6026116-b7ad-38dc-8de9-7cc470dbb862",
                                                "text": "Gültigkeit haben nur die schriftlichen Festlegungen und der vertraglich ausgearbeitete Text, alle anderen mündlichen Absprachen sind unwirksam."
                                            },
                                            {
                                                "example_id": "1be59852-fe98-4dd5-a7c8-641b341eefb4",
                                                "sense_id": "b6026116-b7ad-38dc-8de9-7cc470dbb862",
                                                "text": "Man mag es kaum glauben, aber „diese Gesetze stellten sich als unwirksam heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a19d400-e571-44f2-b6bb-25399e4dcf88",
                        "source_entry_id": "19dab8c3-facf-351c-8631-c74830e8468c",
