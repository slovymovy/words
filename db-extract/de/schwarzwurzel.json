                        "translation_id": "1e2ccc7d-1945-47fe-a31a-694f8ac08fb5",
                        "source_entry_id": "2a78a52a-57b2-3d6c-bf57-3f5969832b33",
                        "source_sense_id": "9564431e-23dd-3039-a44d-800839b7eee1",
                        "target_lang_word": "black salsify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "black salsify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee24c1e9-d42e-3b59-90d2-803552ef4c26",
                                        "entry_id": "bedaf744-512c-3205-9936-38476330b232",
                                        "glosses": [
                                            "A perennial member of the sunflower family (Asteraceae), cultivated as a root vegetable (Pseudopodospermum hispanicum, syn. Scorzonera hispanica)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10556f50-11f4-4774-b1d5-77404e7920bc",
                                                "sense_id": "ee24c1e9-d42e-3b59-90d2-803552ef4c26",
                                                "text": "Black salsify is lumped in as a member of the salsify-type vegetable family even though it is a different genus and species due to similarities in its flavor and textural profile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62a16734-4030-484a-9dd5-cfb3ed130c5e",
                        "source_entry_id": "2a78a52a-57b2-3d6c-bf57-3f5969832b33",
                        "source_sense_id": "9564431e-23dd-3039-a44d-800839b7eee1",
                        "target_lang_word": "salsifis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salsifis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1745d259-bed8-38b8-8636-c8ec1ab79c7a",
                                        "entry_id": "6aaee99e-d8a1-3634-b345-07730a1c05b6",
                                        "glosses": [
                                            "Plante à fleurs composées, dont la racine, qui porte le même nom, est comestible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d18cf3-428b-4d78-8339-589263174727",
                                                "sense_id": "1745d259-bed8-38b8-8636-c8ec1ab79c7a",
                                                "text": "L’Herbier d’Otto Brunfels (1532) énumère, en tant que nouvelles bases de l’économie jardinière : salsifis, haricots, pois, aulx et oignons, choux pommés, raves et navets."
                                            },
                                            {
                                                "example_id": "ae9455d0-b4b7-42ba-b497-35058b2db1ab",
                                                "sense_id": "1745d259-bed8-38b8-8636-c8ec1ab79c7a",
                                                "text": "Les longues racines pivotantes à peau blanche du salsifis, parfois aussi ses feuilles, se consomment comme légume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e8cfba0-fbac-3e89-9a08-efb59ea3a221",
                                        "entry_id": "6aaee99e-d8a1-3634-b345-07730a1c05b6",
                                        "glosses": [
                                            "Légume issu de racine de scorsonère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372738e3-b2f2-4292-9864-a8b702dbdad0",
                                                "sense_id": "9e8cfba0-fbac-3e89-9a08-efb59ea3a221",
                                                "text": "Cuisiner des salsifis à la sauce blanche."
                                            },
                                            {
                                                "example_id": "c6d4ddfb-2fb5-4acf-a4f9-a5b5da7e28b5",
                                                "sense_id": "9e8cfba0-fbac-3e89-9a08-efb59ea3a221",
                                                "text": "Des beignets de salsifis."
                                            },
                                            {
                                                "example_id": "8d21e507-67c1-461a-8d45-e1bf4be36ea4",
                                                "sense_id": "9e8cfba0-fbac-3e89-9a08-efb59ea3a221",
                                                "text": "Peut-on avoir une faim irrépressible une heure après s'être bourré de rôti de porc, de salsifis, de patates et de tarte aux pommes?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b4282c5-bf39-3fad-baf1-411dc6afff1d",
                                        "entry_id": "6aaee99e-d8a1-3634-b345-07730a1c05b6",
                                        "glosses": [
                                            "Catogan de la marionnette lyonnaise guignol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1c30ffd-0b9f-3b71-b13b-cf8cb96736e7",
                                        "entry_id": "6aaee99e-d8a1-3634-b345-07730a1c05b6",
                                        "glosses": [
                                            "Doigt de pied."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "765b86fd-29f2-4a23-b4d4-8153b56e29d3",
                                                "sense_id": "f1c30ffd-0b9f-3b71-b13b-cf8cb96736e7",
                                                "text": "J’ai comme qui dirait de l’électricité au bout des salsifis… Je ne suis plus un homme mais un transformateur… Ma main caresse un bas extra-fin tendu par un mollet parfait…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
