{
    "word_family": [
        "rigger",
        "rigging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe4847ac-57b3-354e-be3f-a506ab2b699f",
                    "sense_definition": "To arrange or influence something, such as an election or a game, in a dishonest way to achieve a desired result.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "manipulate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opposition party claimed that the government tried to <rig> the election.",
                            "target_lang_translations": {
                                "ru": "Оппозиционная партия заявила, что правительство пыталось <сфальсифицировать> выборы.",
                                "zh": "反对党声称政府试图<w>操纵</w>选举。"
                            }
                        },
                        {
                            "text": "Many fans felt that the match was <rigged> by the referee.",
                            "target_lang_translations": {
                                "ru": "Многие болельщики считали, что матч был <подстроен> судьей.",
                                "zh": "许多球迷认为这场比赛被裁判<w>作弊</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "semiring",
                        "swing",
                        "harlotize"
                    ],
                    "common_phrases": [
                        "rig an election",
                        "rig the vote",
                        "rig the system",
                        "rig the market"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестным образом организовать или повлиять на что-либо, например, на выборы или игру, для достижения желаемого результата.",
                        "zh": "以不诚实的方式操纵或影响某事（如选举或比赛），以达到预期的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фальсифицировать",
                                "target_lang_sense_clarification": "выборы или документы"
                            },
                            {
                                "target_lang_word": "подтасовывать",
                                "target_lang_sense_clarification": "факты или результаты"
                            },
                            {
                                "target_lang_word": "подстраивать",
                                "target_lang_sense_clarification": "ситуацию или игру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "操纵",
                                "target_lang_sense_clarification": "暗中控制或影响"
                            },
                            {
                                "target_lang_word": "作弊",
                                "target_lang_sense_clarification": "在比赛或考试中违规"
                            },
                            {
                                "target_lang_word": "串通",
                                "target_lang_sense_clarification": "勾结以影响结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "612868a7-c869-3a16-bba4-edb8e4d815a6",
                    "sense_definition": "To assemble or build something quickly using whatever materials are available, often in a temporary or makeshift way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "construct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We managed to <rig> up a temporary shelter using branches and a tarp.",
                            "target_lang_translations": {
                                "ru": "Нам удалось <соорудить> временное укрытие из веток и брезента.",
                                "zh": "我们设法用树枝和防水布<w>临时搭建</w>了一个遮蔽处。"
                            }
                        },
                        {
                            "text": "He had to <rig> up a light in the garage using an old car battery.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <смастерить> освещение в гараже, используя старый автомобильный аккумулятор.",
                                "zh": "他不得不利用旧汽车电池在车库里<w>凑合做</w>了一个照明灯。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rig up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро собрать или построить что-либо из подручных материалов, часто временно или на скорую руку.",
                        "zh": "利用现有材料快速组装或搭建某物，通常是临时性的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сооружать",
                                "target_lang_sense_clarification": "строить"
                            },
                            {
                                "target_lang_word": "мастерить",
                                "target_lang_sense_clarification": "делать своими руками"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "临时搭建",
                                "target_lang_sense_clarification": "快速组装"
                            },
                            {
                                "target_lang_word": "凑合做",
                                "target_lang_sense_clarification": "利用手头材料制作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "833710b5-dda9-37e4-a45c-9f18a3ad6f05",
                    "sense_definition": "To fit a ship or boat with the necessary equipment, such as sails, ropes, and masts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "equip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took the crew several days to fully <rig> the vessel for the long voyage.",
                            "target_lang_translations": {
                                "ru": "Экипажу потребовалось несколько дней, чтобы полностью <оснастить> судно для дальнего плавания.",
                                "zh": "船员们花了几天时间才为长途航行将船只完全<w>装备</w>好。"
                            }
                        },
                        {
                            "text": "The old schooner was <rigged> with new sails before the race.",
                            "target_lang_translations": {
                                "ru": "Старая шхуна была <оснащена> новыми парусами перед гонкой.",
                                "zh": "这艘老式纵帆船在比赛前被<w>装配</w>上了新帆。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснастить судно необходимым оборудованием, таким как паруса, канаты и мачты.",
                        "zh": "为船只配备必要的设备，如帆、绳索和桅杆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оснащать",
                                "target_lang_sense_clarification": "оборудовать судно"
                            },
                            {
                                "target_lang_word": "снаряжать",
                                "target_lang_sense_clarification": "подготавливать к плаванию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装备",
                                "target_lang_sense_clarification": "为船只配备设施"
                            },
                            {
                                "target_lang_word": "装配",
                                "target_lang_sense_clarification": "安装船只部件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a5071b7-938a-34aa-905d-480b7259c9da",
                    "sense_definition": "A large structure equipped with machinery for drilling for oil or gas.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He works two weeks on an oil <rig> in the North Sea and then has two weeks off.",
                            "target_lang_translations": {
                                "ru": "Он работает две недели на нефтяной <платформе> в Северном море, а затем две недели отдыхает.",
                                "zh": "他在北海的石油<w>钻井平台</w>上工作两周，然后休息两周。"
                            }
                        },
                        {
                            "text": "The company operates a drilling <rig> off the coast of Texas.",
                            "target_lang_translations": {
                                "ru": "Компания эксплуатирует буровую <установку> у побережья Техаса.",
                                "zh": "该公司在德克萨斯州海岸外运营着一座<w>钻井平台</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oil rig",
                        "drilling rig",
                        "offshore rig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая конструкция, оборудованная механизмами для бурения нефтяных или газовых скважин.",
                        "zh": "用于石油或天然气钻探的大型机械结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буровая установка",
                                "target_lang_sense_clarification": "комплекс оборудования"
                            },
                            {
                                "target_lang_word": "нефтяная платформа",
                                "target_lang_sense_clarification": "морская"
                            },
                            {
                                "target_lang_word": "буровая вышка",
                                "target_lang_sense_clarification": "башня"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钻井平台",
                                "target_lang_sense_clarification": "海上钻探设施"
                            },
                            {
                                "target_lang_word": "钻井架",
                                "target_lang_sense_clarification": "钻探塔架"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aae366b2-ab2c-36f0-affe-61a082337908",
                    "sense_definition": "A large truck, especially a semi-trailer truck.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The highway was packed with <rigs> transporting goods across the country.",
                            "target_lang_translations": {
                                "ru": "Шоссе было забито <фурами>, перевозящими товары по всей стране.",
                                "zh": "高速公路上挤满了在全国各地运输货物的<w>大型卡车</w>。"
                            }
                        },
                        {
                            "text": "He parked his big <rig> at the truck stop to get some sleep.",
                            "target_lang_translations": {
                                "ru": "Он припарковал свой большой <грузовик> на стоянке, чтобы поспать.",
                                "zh": "他把他的<w>大型卡车</w>停在卡车休息站，以便睡一会儿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "big rig"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой грузовик, особенно седельный тягач с полуприцепом.",
                        "zh": "大型卡车，尤指半挂式卡车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фура",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "грузовик",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "тягач",
                                "target_lang_sense_clarification": "автомобиль-тягач"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大型卡车",
                                "target_lang_sense_clarification": "重型货车"
                            },
                            {
                                "target_lang_word": "半挂车",
                                "target_lang_sense_clarification": "牵引车与挂车组合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68136cdf-83f7-31a1-bb33-076f8d3160a7",
                    "sense_definition": "A particular set of equipment or gear assembled for a specific purpose.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band brought a massive lighting <rig> for their stadium concert.",
                            "target_lang_translations": {
                                "ru": "Группа привезла массивное световое <оборудование> для концерта на стадионе.",
                                "zh": "乐队为他们的体育场演唱会带来了庞大的灯光<w>装置</w>。"
                            }
                        },
                        {
                            "text": "She prepared her fishing <rig> early in the morning before heading to the lake.",
                            "target_lang_translations": {
                                "ru": "Она подготовила свою рыболовную <оснастку> рано утром перед тем, как отправиться на озеро.",
                                "zh": "她在去湖边之前，一大早就准备好了她的钓鱼<w>装备</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lighting rig",
                        "camera rig",
                        "fishing rig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор оборудования или снаряжения, собранный для определенной цели.",
                        "zh": "为特定目的而组装的一套设备或装备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборудование",
                                "target_lang_sense_clarification": "аппаратура"
                            },
                            {
                                "target_lang_word": "оснастка",
                                "target_lang_sense_clarification": "рыболовная или техническая"
                            },
                            {
                                "target_lang_word": "снаряжение",
                                "target_lang_sense_clarification": "экипировка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装备",
                                "target_lang_sense_clarification": "成套器材"
                            },
                            {
                                "target_lang_word": "装置",
                                "target_lang_sense_clarification": "组合设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a4920f6-ed6a-3cbd-8372-c2f523c681ed",
                    "sense_definition": "A personal computer, especially one that is customized or high-performance for gaming.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent all his savings building a powerful new gaming <rig>.",
                            "target_lang_translations": {
                                "ru": "Он потратил все свои сбережения на сборку нового мощного игрового <компьютера>.",
                                "zh": "他花光了所有积蓄组装了一台强大的新<w>游戏电脑</w>。"
                            }
                        },
                        {
                            "text": "My current <rig> can handle the latest graphics without any lag.",
                            "target_lang_translations": {
                                "ru": "Мой нынешний <компьютер> тянет современную графику без каких-либо лагов.",
                                "zh": "我现在的<w>游戏电脑</w>可以流畅运行最新的图形效果，没有任何延迟。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gaming rig"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Персональный компьютер, особенно собранный на заказ или высокопроизводительный для игр.",
                        "zh": "个人电脑，尤指为游戏定制或高性能的电脑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игровой компьютер",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "системный блок",
                                "target_lang_sense_clarification": "корпус с компонентами"
                            },
                            {
                                "target_lang_word": "сборка",
                                "target_lang_sense_clarification": "компьютерная (сленг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游戏电脑",
                                "target_lang_sense_clarification": "高性能游戏主机"
                            },
                            {
                                "target_lang_word": "电脑配置",
                                "target_lang_sense_clarification": "指代整机系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61f0ec8e-27f8-3e21-9316-75ffc8171b5a",
                    "sense_definition": "The arrangement of masts, sails, and ropes on a sailing vessel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "equip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The yacht features a modern <rig> that makes it easy to handle with a small crew.",
                            "target_lang_translations": {
                                "ru": "Яхта отличается современным <парусным вооружением>, которым легко управлять небольшому экипажу.",
                                "zh": "这艘游艇采用了现代化的<w>帆装</w>，使得小规模船员也能轻松操作。"
                            }
                        },
                        {
                            "text": "Sailors must understand the complexities of the ship's <rig> to navigate safely.",
                            "target_lang_translations": {
                                "ru": "Моряки должны понимать сложности корабельного <такелажа> для безопасной навигации.",
                                "zh": "水手必须了解船上<w>索具</w>的复杂性才能安全航行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "square rig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположение мачт, парусов и канатов на парусном судне.",
                        "zh": "帆船上桅杆、帆和绳索的布置方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парусное вооружение",
                                "target_lang_sense_clarification": "тип оснастки судна"
                            },
                            {
                                "target_lang_word": "такелаж",
                                "target_lang_sense_clarification": "снасти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帆装",
                                "target_lang_sense_clarification": "船只的帆具系统"
                            },
                            {
                                "target_lang_word": "索具",
                                "target_lang_sense_clarification": "船上的绳索系统"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}