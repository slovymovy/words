                        "glosses": [
                            "À tête pommée, en parlant de chou, de laitue, de rose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d21cb2a-5e1d-428c-bb26-ad10626d4b02",
                                "sense_id": "1d194c0b-f6f0-3cd8-ae27-219cb0f49795",
                                "text": "Mon oncle, sans vous commander, passez au jardin, rapportez-m’en quelqu'un, de ces bien pommés, bien cabus !"
                            },
                            {
                                "example_id": "0329ca58-5def-4e97-ab1a-1d0a37ce01a3",
                                "sense_id": "1d194c0b-f6f0-3cd8-ae27-219cb0f49795",
                                "text": "La laitue cabusse, ou pommée. Sa feuille s'arrondit & tend d'elle-même à faire la pomme. Ce nom est devenu générique"
                            },
                            {
                                "example_id": "e5a5037b-8a18-4fdb-a729-c6ab8ea0d935",
                                "sense_id": "1d194c0b-f6f0-3cd8-ae27-219cb0f49795",
                                "text": "La rose cent-feuilles (rose cabusse) est sans contredit la plus belle rose du monde"
                            }
                        ]
