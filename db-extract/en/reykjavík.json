                                "target_senses": [
                                    {
                                        "sense_id": "f8bec3ff-1f25-3593-b1a8-1a1f550dbe26",
                                        "entry_id": "07363109-eab0-382c-866b-9b65072500b0",
                                        "glosses": [
                                            "Capitale de l’Islande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497c56de-8d86-4889-9d62-e5284f53f445",
                                                "sense_id": "f8bec3ff-1f25-3593-b1a8-1a1f550dbe26",
                                                "text": "Je n’étais pas revenu dans la ville la plus importante de l’Islande depuis 1913 […] J’avais laissé Reykjavik, un grand village ; les maisons en bois étaient toiturées de tôle ondulée ; les plus importantes s’enorgueillissaient d’un étage surmontant l’entresol ; des poneys et une ou deux mauvaises carrioles assuraient le transport."
                                            },
                                            {
                                                "example_id": "67321529-7b1b-4f80-afec-8b8e282c1b51",
                                                "sense_id": "f8bec3ff-1f25-3593-b1a8-1a1f550dbe26",
                                                "text": "Ayant quitté Reykjavik, le Pourquoi pas ? fait route vers l’ouest. À la sortie du Faxafjord, il doublera Utskalar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4879824b-2688-38e3-9aba-4b37738ac875",
                                        "entry_id": "07363109-eab0-382c-866b-9b65072500b0",
                                        "glosses": [
                                            "Gouvernement islandais."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c9b728b-e37c-419c-9f02-f85481ebd66b",
                        "source_entry_id": "9ecd9734-9175-32a5-912c-03b737b1d97b",
                        "source_sense_id": "08bdd81d-301f-323f-9b45-19f0dde0c092",
                        "source_sense_description": "capital of Iceland",
                        "target_lang_word": "Reykjavík",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reykjavík",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f6ee0e-31bb-303d-9304-302db108d990",
                                        "entry_id": "4647b093-7318-3091-8a21-85400bc768d0",
                                        "glosses": [
                                            "Hauptstadt von Island"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77a4c7e9-555e-456b-879f-40451a2739b4",
                                                "sense_id": "c6f6ee0e-31bb-303d-9304-302db108d990",
                                                "text": "Meine letzten Sommerferien verbrachte ich in Reykjavík."
                                            },
                                            {
                                                "example_id": "0fde356e-ee62-4048-a3aa-49f73b9a09f4",
                                                "sense_id": "c6f6ee0e-31bb-303d-9304-302db108d990",
                                                "text": "„Zurück in Reykjavík kämpfe ich mich durch einen heftigen Sturm…“"
                                            },
                                            {
                                                "example_id": "d70de014-25e2-4f43-99e2-1a7632b5ce3e",
                                                "sense_id": "c6f6ee0e-31bb-303d-9304-302db108d990",
                                                "text": "„Ich fahre zu schnell, als dass ich mich auf die Schönheit Reykjavíks konzentrieren könnte - denn man hat mir gesagt, bisweilen sei die Stadt auf ihre besondere Art schön, obwohl mir das noch nie aufgefallen ist.“"
                                            },
                                            {
                                                "example_id": "bb118d9b-ece7-46d6-8fa0-d47c9618f2ff",
                                                "sense_id": "c6f6ee0e-31bb-303d-9304-302db108d990",
                                                "text": "„Die meisten stellen sich Reykjavík vermutlich als ein hutzeliges Dorf vor, mit rauchenden Schornsteinen und beschlagenen Fensterscheiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
