                "senses": [
                    {
                        "sense_id": "9ff32b0a-fc94-3667-8573-5bd6eddcb80e",
                        "entry_id": "bd9df049-cf42-3cbe-8fc2-d8fdef962350",
                        "glosses": [
                            "A regal Russian mantle or neckpiece made of gold, encrusted with diamonds and other gems."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "963f2ded-f3d0-4c2a-b6ad-e2b2af1dbfca",
                                "sense_id": "9ff32b0a-fc94-3667-8573-5bd6eddcb80e",
                                "text": "The tsar kissed the regalia, and covering the cross and the barma, gave them on the dish to the protopope, and the crown he gave to Lucian Stepan."
                            },
                            {
                                "example_id": "b096531c-732b-4490-9b44-d1289347294d",
                                "sense_id": "9ff32b0a-fc94-3667-8573-5bd6eddcb80e",
                                "text": "Half-length figure of Peter, three-quarters, in full regalia, with barmas, Cap of State, sceptre and orb."
                            },
                            {
                                "example_id": "0b041359-3e85-42fc-a276-9ae9460e35da",
                                "sense_id": "9ff32b0a-fc94-3667-8573-5bd6eddcb80e",
                                "text": "The barmy consisted of panels of lace fastened together to form a circular fabric, which when laid on the tsar’s shoulders over his robe looked like a broad collar."
                            },
                            {
                                "example_id": "3f160ee9-00af-4943-93cb-8cc3e11d13ee",
                                "sense_id": "9ff32b0a-fc94-3667-8573-5bd6eddcb80e",
                                "text": "Barmy were official attributes of the authority of the grand duke and later the tsar."
                            },
                            {
                                "example_id": "5cca5cbb-0ed9-459c-9780-45d4545e74a6",
                                "sense_id": "9ff32b0a-fc94-3667-8573-5bd6eddcb80e",
                                "text": "In 1831 the Armory got a welcome addition in what was described as “the Ryazan treasure”, the gold princely pendants and barmas, the small shoulder mantles of precious décor worn by Moscovite princes."
                            }
                        ]
                    }
