                                        "examples": [
                                            {
                                                "example_id": "81ba60ae-89d7-4415-b2af-7ded9598e33b",
                                                "sense_id": "a3cc3217-680f-32d6-b488-4f1847ffc326",
                                                "text": "Die Deeskalation verhinderte den Konflikt."
                                            },
                                            {
                                                "example_id": "7dda8c16-15d3-4166-9d8d-971801cdd6e0",
                                                "sense_id": "a3cc3217-680f-32d6-b488-4f1847ffc326",
                                                "text": "„Eine Sprecherin der EU-Außenbeauftragten Catherine Ashton sagte, Ziel sei eine Deeskalation der Situation in der Ukraine.“"
