                    {
                        "sense_id": "85ede429-5e01-3613-99c9-96f9c31921fb",
                        "entry_id": "0005c1dc-bfeb-3198-a097-9e76e370c342",
                        "glosses": [
                            "Femme à laquelle on confie l’éducation d’un ou de plusieurs enfants."
                        ],
