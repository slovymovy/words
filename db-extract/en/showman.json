                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f704f0a-48b1-3454-9a05-54333c1a54d9",
                        "entry_id": "d2953fed-768c-39f9-899a-6c828af575dc",
                        "glosses": [
                            "A person (usually a man) involved in putting on shows (of various types); especially, one who plays a central role in doing so."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf0b1f9d-63a4-41f5-97ca-89f68cf47ddb",
                                "sense_id": "3f704f0a-48b1-3454-9a05-54333c1a54d9",
                                "text": "a consummate showman"
                            },
                            {
                                "example_id": "50ac5de7-3bbf-4650-b5dd-773304c224bd",
                                "sense_id": "3f704f0a-48b1-3454-9a05-54333c1a54d9",
                                "text": "David is a showman above all else. His showroom is more than merely a sales floor: it is a spectacle."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e96548f-4fe9-3cb9-9367-daa9407f2747",
                        "entry_id": "d2953fed-768c-39f9-899a-6c828af575dc",
                        "glosses": [
                            "A person (usually a man) involved in putting on shows (of various types); especially, one who plays a central role in doing so.",
                            "One who produces or presents shows as a profession, especially the proprietor, manager, or MC of a circus or variety show."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c1a5b875-d8ba-35ff-8d68-e019a487962d",
                        "entry_id": "d2953fed-768c-39f9-899a-6c828af575dc",
                        "glosses": [
                            "A person (usually a man) involved in putting on shows (of various types); especially, one who plays a central role in doing so.",
                            "One skilled in dramatic or entertaining presentation, performance, or publicity."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb84c973-d579-4e10-9bcd-069375e56bda",
                        "source_entry_id": "d2953fed-768c-39f9-899a-6c828af575dc",
                        "source_sense_description": "person skilled in dramatic or entertaining presentation — see also showwoman",
                        "target_lang_word": "showman",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "showman",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63895995-e9ff-34ea-9c02-bae633a22540",
                                        "entry_id": "f4c9d63d-a1ca-3bc4-8641-f26c77e21801",
                                        "glosses": [
                                            "Artiste se produisant sur scène (ou encore, par analogie, personnalité publique, sportif…) qui a le sens du spectacle et la capacité d’enflammer son public."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67678dff-01b6-4996-a1a7-f5efc8fc03ca",
                                                "sense_id": "63895995-e9ff-34ea-9c02-bae633a22540",
                                                "text": "On retrouvait le grand showman interprétant ses chansons avec son style à lui. Tombant par terre, transpirant, les chaînes, le cuir, le rock'n'roll, quoi… C’était magique."
                                            },
                                            {
                                                "example_id": "3f24df10-ae7f-40e9-b736-6d65d4ac7b37",
                                                "sense_id": "63895995-e9ff-34ea-9c02-bae633a22540",
                                                "text": "En suivant une pente et un dégradé insensibles, on passe du journaliste au présentateur, du présentateur à l’animateur, de l’animateur à l’amuseur, de l’amuseur au comédien, du comédien au showman, du showman au cachetonneur et du cachetonneur au bonimentateur publicitaire."
                                            },
                                            {
                                                "example_id": "7dec4891-2292-481d-bbe0-8e4eb7a3a4cc",
                                                "sense_id": "63895995-e9ff-34ea-9c02-bae633a22540",
                                                "text": "Swing traditionnel, boogie-woogie, blues… les sonorités et les prestations seront variées avec le showman Lluís Coloma, le saxophoniste David Sauzay ou encore le trompettiste Michel Bonnet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7a7541a-4207-4c26-80c5-c3e2c89b86b6",
                        "source_entry_id": "d2953fed-768c-39f9-899a-6c828af575dc",
                        "source_sense_description": "person skilled in dramatic or entertaining presentation — see also showwoman",
                        "target_lang_word": "Schausteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schausteller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1debaf14-4758-374f-8465-3b87d9404ac4",
                                        "entry_id": "cfa5846a-19e3-345a-8174-8a5f40a358f5",
                                        "glosses": [
                                            "jemand, der (von Ort zu Ort ziehend) auf Volksfesten, Märkten ein Fahrgeschäft betreibt oder den Besuchern eine andere (zum Beispiel artistische) Attraktion, Unterhaltung bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c142e9-d5bc-4d2a-887e-dfff3714cc93",
                                                "sense_id": "1debaf14-4758-374f-8465-3b87d9404ac4",
                                                "text": "„Ich ging nach Innsbruck, wo ich mich als Magd verdingte und dann in eine Wirtschaft als Kellnerin. Da übernachteten einmal umherziehende Schausteller, – Leute, die eine kleine Menagerie mit sich führten und auf Jahrmärkten ihre Kunststücke zeigten.“"
                                            },
                                            {
                                                "example_id": "8543bbba-8a6b-406b-bbce-33b46a1ee240",
                                                "sense_id": "1debaf14-4758-374f-8465-3b87d9404ac4",
                                                "text": "„Wegen der sinkenden Zahl an Volksfesten werden die Weihnachtsmärkte für Schausteller in Deutschland immer wichtiger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
