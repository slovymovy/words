                ],
                "senses": [
                    {
                        "sense_id": "8dc56ca9-edc3-3990-bd8e-13608f35b6f9",
                        "entry_id": "2a19aee6-ddb3-36fb-8e17-c93e69144525",
                        "glosses": [
                            "zurechtgelegter großer Stein um eine Totentrage, zur Rast der Träger, abstellen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa8b994-f102-4e34-a9fa-a55f4cfe70c9",
                                "sense_id": "8dc56ca9-edc3-3990-bd8e-13608f35b6f9",
                                "text": "„Am Dorfplatz steht ein \"Totenraststein\" hier wurde die Trage mit den Verstorbenen abgestellt bevor sie die vielen Steinstufen hinauf zum Friedhof getragen werden mussten.“"
                            },
                            {
                                "example_id": "df5ce518-6a04-4089-94a7-8b7d2b67c541",
                                "sense_id": "8dc56ca9-edc3-3990-bd8e-13608f35b6f9",
                                "text": "„Am Dorfplatz; Nürnberger Straße 3a. Totenraststein, Sandsteinplatte auf Steinsockel, wohl mittelalterlich.“"
                            },
                            {
                                "example_id": "952f2974-08ce-40e2-b7ba-4a87d9eba624",
                                "sense_id": "8dc56ca9-edc3-3990-bd8e-13608f35b6f9",
                                "text": "„Die Geschichte hinterließ hier viele Spuren: ein reiches Erbe von Gegenständen aus der Antike, die Festungen Paklaric und Vecka kula aus der Zeit der Türkeneinfälle, die altkroatische Kirche des hl. Petrus sowie die Totenraststeine, welche von den einstigen Begräbnisbräuchen der lokalen Bevölkerung stammen und ein spezifisches Phänomen dieser Gegend darstellen.“"
                            },
                            {
                                "example_id": "fc7c3019-f260-4100-95af-ed021bead93a",
                                "sense_id": "8dc56ca9-edc3-3990-bd8e-13608f35b6f9",
                                "text": "„Mit der neuen Bepflanzung kommt der Totenraststein, der seit 1984 auf dieser Fläche steht, besser zur Geltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4b5a69d9-8cdc-3d7c-98ab-f6407acebac6",
                        "entry_id": "2a19aee6-ddb3-36fb-8e17-c93e69144525",
                        "glosses": [
                            "von Steinen umgebene und damit bedecktes Grab"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a9068ff-1f53-4f00-97c7-aaa6ffd853c5",
                                "sense_id": "4b5a69d9-8cdc-3d7c-98ab-f6407acebac6",
                                "text": "„An den Velebit Bergsättel, -Höhen und Lichtungen, entlang der Bergwege befinden sich „Mirila“ - Totenraststeine, Andenken im Stein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
