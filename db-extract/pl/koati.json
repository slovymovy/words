                                    {
                                        "sense_id": "1b1f9283-0dc2-3908-8df5-f499f995b817",
                                        "entry_id": "316604fc-0b64-3732-b276-dc36de47b674",
                                        "glosses": [
                                            "Any of several omnivorous mammals, of the genus Nasua, that live in the range from southern United States to northern Argentina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3862e17-7025-400c-9acc-5479e3d6722f",
                                                "sense_id": "1b1f9283-0dc2-3908-8df5-f499f995b817",
                                                "text": "Prospectors and cowpunchers who see the animals most often, sometimes call them Mexican monkeys. Others believe the coati to be a peculiar kind of arboreal anteater. More generally in this region, coatis are called “chulo bears” or simply “chulos,” and will be so referred to hereafter."
                                            },
                                            {
                                                "example_id": "e7a5915d-d862-4d6e-bf42-eaabeb38d901",
                                                "sense_id": "1b1f9283-0dc2-3908-8df5-f499f995b817",
                                                "text": "The coatis are four small, carnivorous mammals related to the raccoon, red panda and ringtail, or cacomistle. They range in size from 15 inches (38 cm) in the mountain coati, Nasuella olivacca, to 16-26 inches (41-67 cm) long in the three species Nasua nasua, N. nelsoni and N. narica."
                                            },
                                            {
                                                "example_id": "5c5f6720-5d6d-4c20-b870-87e9d74da3ce",
                                                "sense_id": "1b1f9283-0dc2-3908-8df5-f499f995b817",
                                                "text": "Above: Maya effigy vessel depicting a red coati or opposum with some anthropomorphic traits."
                                            }
                                        ]
                                    }
