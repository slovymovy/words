                    {
                        "form_id": "d5095902-906d-45bf-866f-4a6d8c158cdd",
                        "entry_id": "61795b5b-253d-34e9-a34a-579ee6b7a017",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Weinstock"
                    },
                    {
                        "form_id": "cd73ee6b-e9ca-42fb-a629-8a79d2753d87",
                        "entry_id": "61795b5b-253d-34e9-a34a-579ee6b7a017",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weinstöcke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eeb37262-1fe6-35cc-bd3b-3ff7c8490857",
                        "entry_id": "61795b5b-253d-34e9-a34a-579ee6b7a017",
                        "glosses": [
                            "eine einzelne Pflanze der Weinrebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f7d3f49-9fab-4316-ac4e-0ac29f1f378c",
                                "sense_id": "eeb37262-1fe6-35cc-bd3b-3ff7c8490857",
                                "text": "Die Weinstöcke haben durch den Frost Schaden genommen."
                            },
                            {
                                "example_id": "6f62a8ba-a4e7-4820-9b67-558c93380834",
                                "sense_id": "eeb37262-1fe6-35cc-bd3b-3ff7c8490857",
                                "text": "„Der Weinstock gedeiht, der Wald spendet Schatten.“"
                            },
                            {
                                "example_id": "74acb1c4-475f-4d1d-a7ff-7d7687028ade",
                                "sense_id": "eeb37262-1fe6-35cc-bd3b-3ff7c8490857",
                                "text": "„Er pflanzte Weinstöcke, zäunte sie ein, setzte Stützpfähle und schnitt sie aus.\""
                            },
                            {
                                "example_id": "64f9048b-ec35-40a7-84a9-4f605e412ccc",
                                "sense_id": "eeb37262-1fe6-35cc-bd3b-3ff7c8490857",
                                "text": "„Die Weinstöcke an den Hängen und die gefüllten Weinfässer in den Kellern waren ihm eine gute Erinnerung an Basel.“"
                            },
                            {
                                "example_id": "5bc51a53-eba0-49d9-9ea6-4b7ae3d061c8",
                                "sense_id": "eeb37262-1fe6-35cc-bd3b-3ff7c8490857",
                                "text": "„Sie sagten,die Bauern hätten das Recht, eine Traube von dem Weinstock zu essen, der keine tragen würde, wenn sie ihn nicht bestellt hätten, ebenso wie der Koch das Recht habe, das Essen zu kosten, das er in der Küche für seinen Herrn zubereite, bevor er es auf seinen Tisch bringe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41dff750-0c6b-4925-b3ee-fd30ef5454ca",
                        "source_entry_id": "61795b5b-253d-34e9-a34a-579ee6b7a017",
                        "source_sense_id": "eeb37262-1fe6-35cc-bd3b-3ff7c8490857",
                        "source_sense_description": "Weinbau: eine einzelne Pflanze der Weinrebe",
                        "target_lang_word": "vine stock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0ce5411a-0d4d-4a09-a2bd-008c01c423c1",
                        "source_entry_id": "61795b5b-253d-34e9-a34a-579ee6b7a017",
                        "source_sense_id": "eeb37262-1fe6-35cc-bd3b-3ff7c8490857",
                        "source_sense_description": "Weinbau: eine einzelne Pflanze der Weinrebe",
                        "target_lang_word": "cep",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cep",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd1c47b2-b20c-3b2b-98f2-a961fa277f8a",
                                        "entry_id": "6603920a-f9c2-3580-acb3-64c1fa1dfd46",
                                        "glosses": [
                                            "Pied de vigne, et plus largement tronc d'un arbuste."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3843e6e5-853d-4cf2-9f73-ccb36938aed6",
                                                "sense_id": "fd1c47b2-b20c-3b2b-98f2-a961fa277f8a",
                                                "text": "L’échalassement , s'il est mal soigné , nuit à tous les ceps , mais sur-tout aux jeunes ; ils sont trop foibles pour se soutenir par eux-mêmes, […]."
                                            },
                                            {
                                                "example_id": "3af2212e-d2ca-4c10-8bef-887970f1d79d",
                                                "sense_id": "fd1c47b2-b20c-3b2b-98f2-a961fa277f8a",
                                                "text": "Je remarque que les vignes françaises franches de pied (du reste il n'y en a pas d'autres, à l’exception de deux ou trois ceps d’Isabelle, cépage que l'on sait n'être pas résistant au phylloxéra et qui est vigoureux), à leur deuxième feuille sont aussi belles, […], que les plus beaux greffés de deux ans […]."
                                            },
                                            {
                                                "example_id": "3bbe0c65-e5b9-421f-bffa-4e0e6d41cfae",
                                                "sense_id": "fd1c47b2-b20c-3b2b-98f2-a961fa277f8a",
                                                "text": "AIGUES-MORTES – […] Tout est vignes, les ceps sont gros comme le poignet et donnent souvent chacun jusqu’à dix litres de vin ; malgré l’exportation, il est si bon marché que, l’an dernier, cent litres valaient cinq francs."
                                            },
                                            {
                                                "example_id": "c47f6619-2fb1-45f4-bbd8-4befbe2a8e13",
                                                "sense_id": "fd1c47b2-b20c-3b2b-98f2-a961fa277f8a",
                                                "text": "[…] la saison était revenue où les filles du plateau lorrain descendent dans la vallée de la Moselle, pour travailler aux menus ouvrages de la vigne, nouer les ceps aux échalas avec un brin de paille, ou émonder les feuilles naissantes ; […]"
                                            },
                                            {
                                                "example_id": "1767e1fc-f256-4532-9302-5481b1583773",
                                                "sense_id": "fd1c47b2-b20c-3b2b-98f2-a961fa277f8a",
                                                "text": "Et celle-ci, soumise, obéissant aux files rigides et aux quinconces rigoureux, nourrit la proportion immuablement consacrée de 4400 ceps à l'hectare."
                                            },
                                            {
                                                "example_id": "ab28079b-b8fc-4054-b599-3aef21c92a6a",
                                                "sense_id": "fd1c47b2-b20c-3b2b-98f2-a961fa277f8a",
                                                "text": "Il appartenait au gouvernement de montrer aux populations viticoles la périodicité inévitable des crises tant qu'il serait planté des ceps à tort et à travers, tant que producteurs et commerçants ne feraient pas la guerre aux falsifications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65972040-d9d7-384c-bdba-fdc88e13d784",
                                        "entry_id": "6603920a-f9c2-3580-acb3-64c1fa1dfd46",
                                        "glosses": [
                                            "Pièce de bois ou de fer, fixée à l'age de la charrue, et qui porte le soc et le versoir."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8732cc2e-2500-3047-80a9-f1d30a0d2ba6",
                                        "entry_id": "6603920a-f9c2-3580-acb3-64c1fa1dfd46",
                                        "glosses": [
                                            "La même pièce pour la rasette."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81dcb3e2-b9e4-3096-a08b-7b8a25011825",
                                        "entry_id": "6603920a-f9c2-3580-acb3-64c1fa1dfd46",
