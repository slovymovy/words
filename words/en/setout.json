                    "sense_id": "4330ac81-653f-3287-aedf-627c3be143ce",
                    "sense_definition": "A beginning or start of an activity, journey, or undertaking; an outset.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beginning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From the very <w>setout</w> of the expedition, the crew faced harsh weather conditions.",
                            "target_lang_translations": {
                                "ru": "С самого <w>начала</w> экспедиции команда столкнулась с суровыми погодными условиями."
                            }
                        },
                        {
                            "text": "We realized at the <w>setout</w> that funding would be our greatest challenge.",
                            "target_lang_translations": {
                                "ru": "В самом <w>начале</w> мы поняли, что финансирование станет нашей главной трудностью."
                            }
                        }
                    ],
                    "synonyms": [
                        "outset",
                        "beginning",
                        "start"
                    ],
                    "antonyms": [
                        "conclusion",
                        "end"
                    ],
                    "common_phrases": [
