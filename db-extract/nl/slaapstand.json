                        "sense_id": "5290783f-fb17-3588-aad0-aa37932cb1ec",
                        "entry_id": "6f4ad1aa-903b-38a0-8c96-4af0fd709f4a",
                        "glosses": [
                            "een ruststand, met laag energieverbruik, van een apparaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca4add61-38c3-4a92-aee4-668ce6c1cea6",
                                "sense_id": "5290783f-fb17-3588-aad0-aa37932cb1ec",
                                "text": "Ik staarde naar het plafond, vaag verlicht door het schijnsel van mijn e-reader. Hij lag naast mijn kussen, en om de zoveel tijd drukte ik er even op zodat hij niet in de slaapstand schoot."
                            },
                            {
                                "example_id": "6a2a5b9d-c761-4dee-ac59-779b54d9d7b1",
                                "sense_id": "5290783f-fb17-3588-aad0-aa37932cb1ec",
                                "text": "De Chinese leider van het experiment op de achterkant van de maan zegt dat het was ingecalculeerd dat het katoenplantje het niet zou overleven. Het was bekend dat het in de maannacht zo koud wordt. De nacht op de maan duurt ongeveer twee weken. In die periode staat de sonde Chang'e-4 ook in slaapstand."
                            }
                        ]
                    }
