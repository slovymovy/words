                        "source_sense_id": "57d50ca3-ef3b-3d1d-b81e-2612bb877e50",
                        "source_sense_description": "premium or percentage on a better sort of money when it is given in exchange for an inferior sort",
                        "target_lang_word": "agio",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e276b71-1685-3d13-8ab4-f698ef881dc5",
                                        "entry_id": "ac805f78-0e26-3072-b70e-076e42f6887c",
                                        "glosses": [
                                            "Plus-value ou prime des monnaies métalliques sur les monnaies de compte ou de banque."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba7d935-6a4f-4b46-be7a-ed9f02df0e61",
                                                "sense_id": "1e276b71-1685-3d13-8ab4-f698ef881dc5",
                                                "text": "Si l’argent est abondant sur une place, l’agio est nul."
                                            },
                                            {
                                                "example_id": "308c89bc-b7ed-4f3c-a804-69735c52578e",
                                                "sense_id": "1e276b71-1685-3d13-8ab4-f698ef881dc5",
                                                "text": "La somme de toutes ces commissions s’appelle l'agio."
                                            },
                                            {
                                                "example_id": "9bd7aae4-5140-43f9-a5c9-d51d1f82fcb8",
                                                "sense_id": "1e276b71-1685-3d13-8ab4-f698ef881dc5",
                                                "text": "Note : C’est aussi, dans les pays à double étalon monétaire, la prime de l’une des monnaies par rapport à l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad1ee0f6-b0fa-30ed-838b-c5e05df9d911",
                                        "entry_id": "ac805f78-0e26-3072-b70e-076e42f6887c",
                                        "glosses": [
                                            "Change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dbc6689-41c4-4632-9c15-99646fe96afe",
                                                "sense_id": "ad1ee0f6-b0fa-30ed-838b-c5e05df9d911",
                                                "text": "Frais d'agio, frais de change, de conversion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b4e6865-1fd4-3df1-abca-d05bcac75cc5",
                                        "entry_id": "ac805f78-0e26-3072-b70e-076e42f6887c",
                                        "glosses": [
                                            "Espèce de prime qui était demandée à chaque renouvellement de bien en plus de l’intérêt et des droits de courtage."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bed8840c-f142-33aa-b2f0-0e9c15c73d4c",
                                        "entry_id": "ac805f78-0e26-3072-b70e-076e42f6887c",
                                        "glosses": [
                                            "Bénéfices faits par la spéculation sur la hausse et la baisse du taux de change de la monnaie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f458b429-c965-346c-b20b-b5e3d9598361",
                                        "entry_id": "ac805f78-0e26-3072-b70e-076e42f6887c",
                                        "glosses": [
                                            "Frais retenus par les banques sur les commissions, les intérêts et le change, ou seulement une de ces trois opérations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d5f8cf7-f6cf-4642-9579-a76a752f2522",
                                                "sense_id": "f458b429-c965-346c-b20b-b5e3d9598361",
                                                "text": "L’argent sur un compte en banque est menacé par une facture imprévue, un PV, un découvert inattendue qui conduit à des agios."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fca5365-b11c-3312-ae4a-9f9246220d29",
                                        "entry_id": "ac805f78-0e26-3072-b70e-076e42f6887c",
                                        "glosses": [
                                            "Spéculation déloyale, escroquerie sur la hausse et la baisse des effets publics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d288fcc-6f28-3859-be68-3a65eaaa4cd8",
                                        "entry_id": "ac805f78-0e26-3072-b70e-076e42f6887c",
                                        "glosses": [
                                            "Prime donnée au port variable en fonction des conditions de la mer, de l’importance géographique du lieu et des taux des monnaies."
                                        ],
                                        "tags": [],
                                        "note": "s’emploie uniquement dans la locution agio d’assurance",
                                        "examples": [
                                            {
                                                "example_id": "2e10ada8-f76a-4bc3-ac25-3dfff66ea574",
                                                "sense_id": "5d288fcc-6f28-3859-be68-3a65eaaa4cd8",
                                                "text": "Quelques-uns appellent agio d’assurance, ce que d’autres nomment Prime ou Coût d’assurance"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c1c0017-f82d-32b8-b6e6-ba52249f8f40",
                                        "entry_id": "00764771-08e0-3433-adb9-3195033e6f45",
                                        "glosses": [
                                            "Colifichet, parure."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0f2af1-0349-4d55-a32a-53b384a19bf4",
                                                "sense_id": "3c1c0017-f82d-32b8-b6e6-ba52249f8f40",
                                                "text": "Mon savant confrère M. Littré a bien voulu me communiquer quelques textes, dont aucun malheureusement n’est antérieur au XV siècle, et qui donnent le mot agiaux ou agios, avec le sens de parure, ornements, affiquets. Ménage remarque qu’à Paris on dit les agios de la mariée de village, c’est-à-dire sa parure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e7f6820-dfc0-3ea2-bb89-f12443c76a4e",
                                        "entry_id": "1fedd923-dd41-305c-8533-83f166752a4f",
                                        "glosses": [
                                            "Minauderie ; manière obséquieuse."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afb586ab-3cdb-4625-b663-7019e6cf35f9",
                                                "sense_id": "0e7f6820-dfc0-3ea2-bb89-f12443c76a4e",
                                                "text": "Faire des agios pour se faire bien voir."
                                            },
                                            {
                                                "example_id": "95725c56-63bd-4c07-b4c5-528ae0d1f443",
                                                "sense_id": "0e7f6820-dfc0-3ea2-bb89-f12443c76a4e",
                                                "text": "Dans la salle, il y avait le Tout-Paris de l’Empire : un bruit d’éperons, des entrecroisements de moustaches, des femmes plâtrées, étincelantes de parures, des crânes luisants surchauffés d’agio, des ventres balonnés d’expropriation, des nez affilés par la ruse, une odeur de luxe violent et malappris, de virements, de police et d’indigestion splendide ; c’était superbe !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agio",
                                "target_lang_code": "fr",
                                "target_senses": [
