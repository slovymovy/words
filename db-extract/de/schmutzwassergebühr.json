                "senses": [
                    {
                        "sense_id": "e9693f2c-a3a9-3484-8099-6ff7fbceb6cc",
                        "entry_id": "6d72d82b-7aa9-3520-8aea-af2ffdaa2759",
                        "glosses": [
                            "Abgabe für die Inanspruchnahme der öffentlichen Abwasseranlage durch eingelassenes Abwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e283b488-ca6e-407b-8771-02c1f3045fe2",
                                "sense_id": "e9693f2c-a3a9-3484-8099-6ff7fbceb6cc",
                                "text": "„Die Schmutzwassergebühr bemisst sich nach dem Frischwasserverbrauch.“"
                            },
                            {
                                "example_id": "e4e0d6ef-d471-4984-a6fb-9991120f28a1",
                                "sense_id": "e9693f2c-a3a9-3484-8099-6ff7fbceb6cc",
                                "text": "„Der Abzug der nicht in die öffentliche Abwasseranlage eingeleiteten Wassermengen bei der Berechnung der Schmutzwassergebühr für ein Kalenderjahr ist bis zum 15.02. des Folgejahres schriftlich bei der Stadt Düren - Steuerabteilung - zu beantragen.“"
                            },
                            {
                                "example_id": "35a3d010-e504-4e95-8da0-0e5125037d3c",
                                "sense_id": "e9693f2c-a3a9-3484-8099-6ff7fbceb6cc",
                                "text": "„Die Schmutzwassergebühr bemisst sich nach der von dem Grundstück der öffentlichen Abwasseranlage unmittelbar oder mittelbar zugeführten Schmutzwassermenge des letzten Abrechnungszeitraumes von 12 Monaten.“"
                            },
                            {
                                "example_id": "d34b6819-f545-42ff-aaf5-6c40acc5d9cc",
                                "sense_id": "e9693f2c-a3a9-3484-8099-6ff7fbceb6cc",
                                "text": "„Für die Entleerung von Sammelgruben einschließlich der Beseitigung ihres Inhaltes werden Schmutzwassergebühren erhoben.“"
                            },
                            {
                                "example_id": "961bd3c5-8442-4d76-bd1b-a50cf8951f87",
                                "sense_id": "e9693f2c-a3a9-3484-8099-6ff7fbceb6cc",
                                "text": "„Die Schmutzwassergebühr bemisst sich nach der von dem Grundstück der öffentlichen Abwasseranlage unmittelbar oder mittelbar zugeführten Schmutzwassermenge.“"
                            }
                        ],
