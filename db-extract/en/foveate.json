                        "entry_id": "f60a541a-e089-3970-8cb5-a04e54463eb6",
                        "glosses": [
                            "To angle one's eyes such that the foveae are directed at (an object in one's field of view), the fovea being the portion of the retina responsible for sharp central vision."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "68d08cdd-d094-4538-852a-207e5f5feabc",
                                "sense_id": "5ac4fbec-5837-31ea-a9c9-8f06beff5492",
                                "text": "“Tracking an object requires the person to first move their head and eyes to the target, which always results in a slight overshoot, then quickly flick the eyes back to foveate on the target [get the target centred on the optic nerve]^([sic]),” says Dr Leonard."
                            }
                        ]
