{
    "word_family": [
        "murmurer",
        "murmurant",
        "murmurateur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d0781dd-7ef8-349e-b63f-cb00cb159138",
                    "sense_definition": "Parole prononcée à voix très basse, de façon presque inaudible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a répondu dans un <w>murmure</w> pour ne pas réveiller les enfants endormis."
                        },
                        {
                            "text": "J'ai à peine entendu son <w>murmure</w> au milieu de tout ce vacarme."
                        }
                    ],
                    "common_phrases": [
                        "dans un murmure",
                        "doux murmure"
                    ]
                },
                {
                    "sense_id": "9fe2c770-cf35-3b14-bb50-19149833af5f",
                    "sense_definition": "Bruit sourd et confus produit par plusieurs voix qui parlent bas.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un <w>murmure</w> de surprise a parcouru la salle à l'annonce des résultats."
                        },
                        {
                            "text": "Le <w>murmure</w> confus des conversations remplissait le grand hall de la gare."
                        }
                    ],
                    "synonyms": [
                        "rumeur"
                    ],
                    "common_phrases": [
                        "murmure de la foule",
                        "murmure confus"
                    ]
                },
                {
                    "sense_id": "1b66d63f-7638-34bc-8ee6-1376bd4bb459",
                    "sense_definition": "Bruissement léger et continu produit par les éléments naturels, comme l'eau ou le vent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous nous sommes endormis bercés par le doux <w>murmure</w> du ruisseau."
                        },
                        {
                            "text": "Le <w>murmure</w> du vent dans les arbres calmait son anxiété."
                        }
                    ],
                    "common_phrases": [
                        "murmure du ruisseau",
                        "murmure du vent"
                    ]
                },
                {
                    "sense_id": "ebd4ea17-d66c-38a6-a15d-a9b69870238e",
                    "sense_definition": "Plainte ou protestation discrète mais collective contre une décision ou une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'annonce de cette nouvelle taxe a provoqué des <w>murmures</w> de mécontentement."
                        },
                        {
                            "text": "La décision du directeur a suscité un <w>murmure</w> de protestation parmi les employés."
                        }
                    ],
                    "common_phrases": [
                        "murmures de mécontentement"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b56229d0-64e6-3c83-9b26-615895cb3d69",
                    "sense_definition": "Troisième personne du singulier du présent de l'indicatif de <w>murmurer</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il lui <w>murmure</w> un secret à l'oreille pendant la réunion."
                        },
                        {
                            "text": "Le vent <w>murmure</w> à travers les branches des vieux arbres."
                        }
                    ],
                    "common_phrases": [
                        "il se murmure que"
                    ]
                },
                {
                    "sense_id": "a61cfc65-d962-3fb0-a574-2d09b76f9061",
                    "sense_definition": "Première personne du singulier du présent de l'indicatif de <w>murmurer</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>murmure</w> quelques mots rassurants pour calmer le petit garçon."
                        },
                        {
                            "text": "Chaque soir, je <w>murmure</w> une berceuse pour l'aider à dormir."
                        }
                    ]
                }
            ]
        }
    ]
}