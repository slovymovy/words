                                    {
                                        "sense_id": "7b577e4b-fc09-3821-aaee-6d5058aaa705",
                                        "entry_id": "f6bd9276-4b13-3b51-b443-3db34ae0ec3f",
                                        "glosses": [
                                            "Something of value given in return for an act."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48021aea-e401-463b-8ea2-83b74cfdd04d",
                                                "sense_id": "7b577e4b-fc09-3821-aaee-6d5058aaa705",
                                                "text": "For catching the thief, you'll get a nice reward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98317c1c-e4f3-370f-98a0-8649061cc742",
                                        "entry_id": "f6bd9276-4b13-3b51-b443-3db34ae0ec3f",
                                        "glosses": [
                                            "A prize promised for a certain deed or catch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "400a1b41-2464-478a-bce4-91f0928acda3",
                                                "sense_id": "98317c1c-e4f3-370f-98a0-8649061cc742",
                                                "text": "The rewards for bringing in badly wanted criminals are printed on 'dead or alive' posters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca12c70a-771e-39b8-b3a2-7c47812db59b",
                                        "entry_id": "f6bd9276-4b13-3b51-b443-3db34ae0ec3f",
                                        "glosses": [
                                            "The result of an action, whether good or bad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2a859e5-5300-4880-af48-4a471bd617b0",
                                                "sense_id": "ca12c70a-771e-39b8-b3a2-7c47812db59b",
                                                "text": "Is this the reward I get for telling the truth: to be put in jail?"
                                            },
                                            {
                                                "example_id": "096f20d3-fe6e-4971-b741-cc7f8e881ae7",
                                                "sense_id": "ca12c70a-771e-39b8-b3a2-7c47812db59b",
                                                "text": "Christian Benteke's first-half goal was just reward for Villa's undoubted superiority but Bradford managed to survive without further damage until half-time, before scoring the goal that takes them to Wembley for the first time since 1996."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd12619d-25a4-3861-b0b1-f937283f12da",
                                        "entry_id": "eca0944f-f825-31fe-abc3-bb777729ee3d",
                                        "glosses": [
                                            "To give a reward to or for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04c99a4-d2b5-4e03-ae7a-21de229b79cb",
                                                "sense_id": "bd12619d-25a4-3861-b0b1-f937283f12da",
                                                "text": "Why are you rewarding the child for misbehaving?"
                                            },
                                            {
                                                "example_id": "f8701c09-2d40-428d-8fc7-b0b91b7ca093",
                                                "sense_id": "bd12619d-25a4-3861-b0b1-f937283f12da",
                                                "text": "Why are you rewarding that bad behaviour?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fcb6adc-cc57-3f6c-8139-1ede080e9bbd",
                                        "entry_id": "eca0944f-f825-31fe-abc3-bb777729ee3d",
                                        "glosses": [
                                            "To be a recompense for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a68b7425-0bab-4cfd-a9c2-bad30712b516",
                                                "sense_id": "2fcb6adc-cc57-3f6c-8139-1ede080e9bbd",
                                                "text": "Decorations are meant to reward the most meritous acts and services."
                                            },
                                            {
                                                "example_id": "a20b6c4f-dc9b-4556-9850-173bec2d21ad",
                                                "sense_id": "2fcb6adc-cc57-3f6c-8139-1ede080e9bbd",
                                                "text": "The Italian opted for Bolton's Cahill alongside captain John Terry - and his decision was rewarded with a goal after only 13 minutes. Bulgaria gave a hint of defensive frailties to come when they failed to clear Young's corner, and when Gareth Barry found Cahill in the box he applied the finish past Nikolay Mihaylov."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7194fc3f-c8c7-3b2f-8cb1-abf3869174c1",
                                        "entry_id": "eca0944f-f825-31fe-abc3-bb777729ee3d",
                                        "glosses": [
                                            "To give (something) as a reward."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb455a7-3acc-4786-9331-fc96ad68e7e1",
                                                "sense_id": "7194fc3f-c8c7-3b2f-8cb1-abf3869174c1",
                                                "text": "Thenne syr Marhaus departed and within two dayes his damoysel brought hym where as was a grete tornement that the lady de Vawse has cryed\n[…]\n And there syr Marhaus dyd so nobly that he was renomed\n & had somtyme doune fourty knyghtes\n and soo the serklet of gold was rewarded hym"
                                            },
                                            {
                                                "example_id": "af7b1a1a-b15e-4cae-95d3-9876183fd669",
                                                "sense_id": "7194fc3f-c8c7-3b2f-8cb1-abf3869174c1",
                                                "text": "Thou hast rewarded me good, whereas I have rewarded thee evil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01168901-e047-43d6-a9c5-f9b7266017f2",
                        "source_entry_id": "692798e3-0466-3056-adb3-6c528f91d5c6",
