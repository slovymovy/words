                        "examples": [
                            {
                                "example_id": "b196246b-1550-421c-8c18-3183d668d8f5",
                                "sense_id": "bf7d0c8e-2ee9-3d59-b9d2-f3634c59c89b",
                                "text": "Là-dessus, et pour ainsi dire en même temps, Mareuil surprend Odette en flagrant délit d’adultère prématrimonial avec un type à tête de voyou."
                            },
                            {
                                "example_id": "71440ccb-5245-4053-a8b5-5bac3a49e418",
                                "sense_id": "bf7d0c8e-2ee9-3d59-b9d2-f3634c59c89b",
                                "text": "Si la femme est une jeune célibataire, elle peut éventuellement avoir des rapports amoureux prématrimoniaux, mais ceux-ci restent toujours clandestins."
                            },
                            {
                                "example_id": "8dd171bf-d0f4-4175-82c3-76bf46993d1e",
                                "sense_id": "bf7d0c8e-2ee9-3d59-b9d2-f3634c59c89b",
                                "text": "Là, dans quelques contrées, les relations prématrimoniales sont considérées parfois, par les paysans des deux sexes, comme une espèce de démonstration socialiste contre les préjugés de la société capitaliste."
                            }
                        ]
