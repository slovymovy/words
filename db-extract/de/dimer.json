                ],
                "senses": [
                    {
                        "sense_id": "930dac20-584c-3bfe-bff8-1bbaaa08b35d",
                        "entry_id": "2fd58d47-22ac-327e-baa0-84b676dd5b87",
                        "glosses": [
                            "aus zwei Molekülen bestehendes Polymer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9183105a-ace2-40c1-8f49-67fdb3342100",
                                "sense_id": "930dac20-584c-3bfe-bff8-1bbaaa08b35d",
                                "text": "„Aus Gründen der Energie- und Impulserhaltung können Dimere (und Trimere) nur durch einen Dreikörperstoß stabilisiert werden, während bei der Anlagerung eines Atoms an größere Cluster die Anzahl der inneren Freiheitsgrade meist ausreicht, um überschüssige Energie vorübergehend aufzunehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97775a91-f178-4111-ac37-4e3d828a21e7",
                        "source_entry_id": "2fd58d47-22ac-327e-baa0-84b676dd5b87",
                        "source_sense_id": "930dac20-584c-3bfe-bff8-1bbaaa08b35d",
                        "source_sense_description": "aus zwei Molekülen bestehendes Polymer",
                        "target_lang_word": "dimer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dimer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33a0bd43-9dc6-3761-b70e-43d88e6be609",
                                        "entry_id": "c7ef5600-7916-3de9-ac97-c9b54ba5c8c5",
                                        "glosses": [
                                            "A molecule consisting of two identical halves, formed by joining two identical molecules, sometimes with a single atom acting as a bridge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "194a645b-42f3-4986-aec0-efd724ebd5f7",
                                                "sense_id": "33a0bd43-9dc6-3761-b70e-43d88e6be609",
                                                "text": "Non-polymerized lamins are dimers and they can polymerize to structures such as head to tail or by unparallel dimers which aggregate in tetramers and polymerize to thick fibers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c814a34-b783-42f0-9ca3-2120b4c9c05d",
                        "source_entry_id": "2fd58d47-22ac-327e-baa0-84b676dd5b87",
                        "source_sense_id": "930dac20-584c-3bfe-bff8-1bbaaa08b35d",
                        "source_sense_description": "aus zwei Molekülen bestehendes Polymer",
                        "target_lang_word": "dimère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dimère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d40885b3-b17e-33eb-91d0-983c1ec0210c",
