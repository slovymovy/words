            "senses": [
                {
                    "sense_id": "d5e8d538-2989-300a-92a4-ddd260072e4d",
                    "sense_definition": "tweemaal zo groot worden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "toename",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winst van het bedrijf <w>verdubbelde</w> in het laatste kwartaal van het jaar.",
                            "target_lang_translations": {
                                "en": "The company's profit <w>doubled</w> in the last quarter of the year."
                            }
                        },
                        {
                            "text": "Het aantal inwoners in dit kleine dorp is in tien jaar tijd bijna <w>verdubbeld</w>.",
                            "target_lang_translations": {
                                "en": "The number of inhabitants in this small village has almost <w>doubled</w> in ten years' time."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in aantal verdubbelen",
                        "ruim verdubbeld"
                    ],
                    "target_lang_definitions": {
                        "en": "To become twice as large or numerous."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "double",
                                "target_lang_sense_clarification": "to become twice as much"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3d3b1ba-7a2d-383d-8d72-f393a822ae8e",
                    "sense_definition": "tweemaal zo groot maken, vermenigvuldigen met twee",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "toename",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben hun inspanningen <w>verdubbeld</w> om het project op tijd af te krijgen.",
                            "target_lang_translations": {
                                "en": "They have <w>doubled</w> their efforts to get the project finished on time."
                            }
                        },
                        {
                            "text": "Je kunt de inzet <w>verdubbelen</w> als je zeker bent van je winst.",
                            "target_lang_translations": {
                                "en": "You can <w>double</w> the stake if you are sure of your win."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "inspanningen verdubbelen",
                        "de inzet verdubbelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make twice as large; to multiply by two."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "double",
                                "target_lang_sense_clarification": "to multiply by two"
                            },
                            {
                                "target_lang_word": "duplicate",
                                "target_lang_sense_clarification": "to repeat or double"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad48d33b-0da5-35f7-a248-2f090e0f9ffb",
                    "sense_definition": "zich tweemaal zo groot maken of worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toename",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hun aantal <w>verdubbelde</w> zich in een zeer korte periode.",
                            "target_lang_translations": {
                                "en": "Their number <w>doubled</w> in a very short period."
                            }
                        },
                        {
                            "text": "De bevolking <w>verdubbelt</w> zich elke dertig jaar in dit ontwikkelingsland.",
                            "target_lang_translations": {
                                "en": "The population <w>doubles</w> every thirty years in this developing country."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich verdubbelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To increase or expand to twice the original size or number (reflexive)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "double",
                                "target_lang_sense_clarification": "to become twice as large"
