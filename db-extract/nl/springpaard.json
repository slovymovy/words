                                "target_senses": [
                                    {
                                        "sense_id": "4215df24-f33b-36c5-9155-06865ebbbba9",
                                        "entry_id": "1abd73fc-ecb1-3cfd-b614-386b48c404c8",
                                        "glosses": [
                                            "A woollen sweater or pullover."
                                        ],
                                        "tags": [
