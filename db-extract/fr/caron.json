                                    {
                                        "sense_id": "5caeb5eb-4a4a-332e-b927-f0b5f9a7e8d0",
                                        "entry_id": "e1f714a8-619a-33c5-a3f1-72ab0efe3124",
                                        "glosses": [
                                            "diakritisches Zeichen, das besonders in slawischen Sprachen verwendete Häkchen, das einen stimmhaften Reibelaut oder einen Zischlaut wie den tsch-Laut kennzeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02d1fec-fc56-45ee-84ea-2b7e49724bc6",
                                                "sense_id": "5caeb5eb-4a4a-332e-b927-f0b5f9a7e8d0",
                                                "text": "Der Hatschek geht auf das Werk Böhmische Orthographie aus dem Jahr 1406 zurück, das Jan Hus zugeschrieben wird."
                                            },
                                            {
                                                "example_id": "d2517112-a228-4b21-a2fb-1d1327da8e9f",
                                                "sense_id": "5caeb5eb-4a4a-332e-b927-f0b5f9a7e8d0",
                                                "text": "Diakritische Zeichen wie etwa das tschechische Hatschek oder der französische Zirkumflex sind ohnehin meist der amerikanischen Globalisierung zum Opfer gefallen […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f427784-2bae-4b7a-b805-7f9224df4f9b",
