    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7cd88e9c-d761-3239-a2dc-6e713b7bfe48",
                    "sense_definition": "A large company or group of companies authorized to act as a single entity and recognized as such in law.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She works for a large multinational <w>corporation</w> with offices in over thirty countries.",
                            "target_lang_translations": {
                                "ru": "Она работает в крупной транснациональной <w>корпорации</w> с офисами более чем в тридцати странах.",
                                "zh": "她在一家大型跨国<w>公司</w>工作，在三十多个国家设有办事处。"
                            }
                        },
                        {
                            "text": "The <w>corporation</w> announced record profits during the annual shareholder meeting.",
                            "target_lang_translations": {
                                "ru": "<w>Корпорация</w> объявила о рекордной прибыли во время ежегодного собрания акционеров.",
                                "zh": "该<w>企业</w>在年度股东大会上宣布了创纪录的利润。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "multinational corporation",
                        "major corporation",
                        "global corporation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная компания или группа компаний, уполномоченная действовать как единое юридическое лицо.",
                        "zh": "大型公司或企业集团，在法律上被认可为单一实体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корпорация",
                                "target_lang_sense_clarification": "крупная фирма"
                            },
                            {
                                "target_lang_word": "акционерное общество",
                                "target_lang_sense_clarification": "юридическая форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公司",
                                "target_lang_sense_clarification": "一般商业企业"
                            },
                            {
                                "target_lang_word": "企业",
                                "target_lang_sense_clarification": "大型商业组织"
                            },
                            {
                                "target_lang_word": "集团",
                                "target_lang_sense_clarification": "大型企业集团"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5014793a-9140-3f80-b351-b51de9e11e05",
                    "sense_definition": "The municipal governing body of a borough or city.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "government_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>corporation</w> is responsible for maintaining public parks and roads.",
