                "senses": [
                    {
                        "sense_id": "abb7b359-ebe2-3b1b-87d0-11a28c8d9cd7",
                        "entry_id": "3866462a-daf1-3707-abf1-7acf9335e8e2",
                        "glosses": [
                            "interdisziplinäre Wissenschaft der Steuern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e7ddb9b-ec9f-4039-8bd4-c8a38bb02869",
                                "sense_id": "abb7b359-ebe2-3b1b-87d0-11a28c8d9cd7",
                                "text": "„Die Entscheidung entspricht der Auffassung, die in der Steuerwissenschaft schon lange vertreten wird.“"
                            },
                            {
                                "example_id": "a46a24b6-ca04-4355-b011-cb2bf1d0e3b0",
                                "sense_id": "abb7b359-ebe2-3b1b-87d0-11a28c8d9cd7",
                                "text": "„Steuerwissenschaften lernen Juristen und Ökonomen in einem Ergänzungsstudium der Uni Münster.“"
                            },
                            {
                                "example_id": "d54fce78-4d3a-4333-bb34-5ec1ab09afa1",
                                "sense_id": "abb7b359-ebe2-3b1b-87d0-11a28c8d9cd7",
                                "text": "„Ein Interdisziplinäres Ergänzungsstudium Steuerwissenschaften hat das Institut für Steuerrecht an der Westfälischen Wilhelms-Universität Münster aufgelegt.“"
                            },
                            {
                                "example_id": "59f7cf11-40db-4831-836f-9942343fd34e",
                                "sense_id": "abb7b359-ebe2-3b1b-87d0-11a28c8d9cd7",
                                "text": "„Die Frage, ob Steuern im liberalen Rechtsstaat überhaupt gerechtfertigt sind, stellt eine häufig vergessene Vorfrage der Steuerwissenschaft dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
