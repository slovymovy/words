                                        "entry_id": "fbfe119c-3dfb-3add-81ba-55371c89cb80",
                                        "glosses": [
                                            "Technology which can be used to remotely control dildonics, allowing mutual masturbation over the Internet."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d953b829-c6a8-4485-9f41-fb855702c331",
                                                "sense_id": "bb824d91-6da3-3f34-acb9-ac1be83372ac",
                                                "text": "And considering their comfort level with remote interaction and online gaming, teledildonics will not seem odd at all. It will just be another option on a Wednesday night."
                                            },
                                            {
                                                "example_id": "baa12062-5ee2-4026-98e0-2e77ceee0616",
                                                "sense_id": "bb824d91-6da3-3f34-acb9-ac1be83372ac",
                                                "text": "Wide-eyed futurists have long envisioned a world where teledildonics helps us all get it on with partners half a world away; so far, their predictions have amounted to little more than empty hype."
                                            }
                                        ]
