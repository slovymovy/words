                                "target_senses": [
                                    {
                                        "sense_id": "b74be8a9-5ae1-35e3-9ca6-b4f99a1e30ab",
                                        "entry_id": "d6fc7ff7-34bc-35a5-8145-a4c511b50df3",
                                        "glosses": [
                                            "Stelle, an der ein Weg, eine Straße oder dergleichen von einem/einer anderen wegführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae3f50d4-7dbc-4c82-8bc0-57238d716fb4",
                                                "sense_id": "b74be8a9-5ae1-35e3-9ca6-b4f99a1e30ab",
                                                "text": "Nehmen Sie die erste Abzweigung nach rechts."
                                            },
                                            {
                                                "example_id": "a9d747e0-a7ec-4216-b53b-3b19aca43f8f",
                                                "sense_id": "b74be8a9-5ae1-35e3-9ca6-b4f99a1e30ab",
                                                "text": "„Am 10. August kam das dem Fürsten Andrej unterstellte Regiment auf der Heerstrasse an der Abzweigung des nach Lysyja Gory führenden Nebenweges vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9acac37a-4e30-4efc-8b37-f512334bc03b",
                        "source_entry_id": "b99b4d85-e228-3c03-ad93-5ff82d617ba5",
                        "source_sense_id": "0a80cf86-9d27-3b1d-8142-4caf0b2bbee1",
                        "source_sense_description": "sdü",
                        "target_lang_word": "Abweichung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abweichung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8330e810-4b79-35b2-af0e-f994f265ecf2",
                                        "entry_id": "417f3af5-9080-356e-949e-b85a5ee3735a",
                                        "glosses": [
                                            "die Nichterfüllung einer Regelmäßigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28cba916-f00d-41cc-8263-1588d7303b25",
                                                "sense_id": "8330e810-4b79-35b2-af0e-f994f265ecf2",
                                                "text": "Eine Abweichung vom Zeitplan steht außer Frage."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                        "entry_id": "417f3af5-9080-356e-949e-b85a5ee3735a",
                                        "glosses": [
                                            "Verletzung einer grammatischen Regel oder Verstoß gegen eine geltende Sprachnorm oder -konvention"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c0ead03-7860-40f2-93f4-51b0c01f2544",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "Abweichungen können auf jeder grammatischen oder stilistischen Ebene erfolgen."
                                            },
                                            {
                                                "example_id": "8ac7f817-e59b-4bb9-a64f-0b4a1163d06a",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "„Riffaterres kontextuelle Stilauffassung setzt einen Stilbegriff voraus, der nur der Abweichung von der Lesererwartung Stilcharakter zuerkennt.“"
                                            },
                                            {
                                                "example_id": "c6c5138a-c674-4478-9879-b76843d56da2",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "Über das »Österreichische«: „Sah man in der Betonung der Abweichungen nach 1945 noch die Möglichkeit, eine identitätsstiftende antideutsche Haltung zu demonstrieren, sieht Professor Koppensteiner heute eher ein Imageproblem vorherrschen.“"
                                            },
                                            {
                                                "example_id": "732a125b-8602-497e-922a-5bac6ef74872",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "„In der Schreibpraxis gibt es jedoch Abweichungen davon, die insbesondere den Bereich der Behörden betreffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55707027-9271-436b-84ad-1981560aec52",
                        "source_entry_id": "b99b4d85-e228-3c03-ad93-5ff82d617ba5",
                        "source_sense_id": "27d07334-2cb3-3dde-9806-a0f87e072f79",
                        "source_sense_description": "sdü",
                        "target_lang_word": "Meinungsverschiedenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meinungsverschiedenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                        "entry_id": "42600527-e54f-3bb4-9ca7-ae299cbb9e16",
                                        "glosses": [
                                            "unterschiedliche Beurteilung, Einschätzung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2145cd9e-7287-4880-ad99-15519fc2ad8f",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Im Herbst 1919 startete die Weiße Armee eine Großoffensive auf Moskau, die aber unter anderem wegen Meinungsverschiedenheiten zwischen den Generälen scheiterte.“"
                                            },
                                            {
                                                "example_id": "420da42d-1914-484a-81fa-3eb616401c62",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Am Ende erwiesen sich die alliierten Meinungsverschiedenheiten in der Reparationsfrage als unüberbrückbar.“"
                                            },
                                            {
                                                "example_id": "23279758-86e2-44d5-ab89-71ec04931b71",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Während er zu irgendeinem Gegenstand geführt wurde, merkte er, dass unter seinen Führern Meinungsverschiedenheiten und eine gewisse Verwirrung entstanden waren.“"
                                            },
                                            {
                                                "example_id": "38ef3c91-4edf-448b-acb2-a8d2a4fea93f",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„In den meisten Fällen herrscht ein Geist von Kooperation und gegenseitigem Verstehen, und es hat sich eine Art guter Beziehung entwickelt, die gewöhnlich gravierende Meinungsverschiedenheiten verhindert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f43bcfa8-e1ee-3976-830e-cedea445ae49",
                                        "entry_id": "42600527-e54f-3bb4-9ca7-ae299cbb9e16",
                                        "glosses": [
                                            "verbale Auseinandersetzung, Streit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad229162-e4f1-4d42-8624-ee5b91e2b449",
                                                "sense_id": "f43bcfa8-e1ee-3976-830e-cedea445ae49",
                                                "text": "Nach dieser Meinungsverschiedenheit war die Stimmung vorübergehend etwas getrübt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
