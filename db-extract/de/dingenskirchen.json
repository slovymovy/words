                        "glosses": [
                            "Ersatzwort für einen Namen (ursprünglich Ortsnamen), der nicht zur Verfügung steht oder nicht bekannt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5db928-5b7f-4149-9e1a-87ae63d94a67",
                                "sense_id": "24f26f61-b141-3667-9914-6e49ea4c0fa4",
                                "text": "Niemand ist in Dingenskirchen geboren."
                            },
                            {
                                "example_id": "dcafe480-1249-4ccb-b1a2-d880cb799b4a",
                                "sense_id": "24f26f61-b141-3667-9914-6e49ea4c0fa4",
                                "text": "Niemand hat in Dingenskirchen seinen Urlaub verbracht."
                            },
                            {
                                "example_id": "9b0cac7b-253b-4fa7-9f88-2e150a2fb441",
                                "sense_id": "24f26f61-b141-3667-9914-6e49ea4c0fa4",
                                "text": "Nach Dingenskirchen führen keine Wege."
                            },
                            {
                                "example_id": "de99ea8c-7e1f-46c0-a934-c3ba0a191935",
                                "sense_id": "24f26f61-b141-3667-9914-6e49ea4c0fa4",
                                "text": "Dingenskirchen liegt auf der Mittelhalbkugel."
                            },
