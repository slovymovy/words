                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1474c82d-f22a-301b-a1bc-688ac8746bc5",
                                        "entry_id": "0b097718-e83a-3ef0-9da4-633248b7ca1e",
                                        "glosses": [
                                            "Prinzip der Trennung zwischen Religion/Kirche und Staat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34058363-589f-435f-9e2e-30515948e842",
                                                "sense_id": "1474c82d-f22a-301b-a1bc-688ac8746bc5",
                                                "text": "„Aus unseren bisherigen Überlegungen folgt, daß die Laizität im Kontext des allgemeineren Ideals der Neutralität zu verstehen ist, das der Staat anstreben muß, wenn er seine Bürger gerecht behandeln will. Die Laizität ist eines der Merkmale liberaler und demokratischer Regierungssysteme, die es diesen erlauben, Individuen mit unterschiedlichen Weltbildern und Wertvorstellungen gleiche Achtung entgegenzubringen.“"
                                            },
                                            {
                                                "example_id": "01e53b31-96ea-4aa5-8ad5-195d69106e56",
                                                "sense_id": "1474c82d-f22a-301b-a1bc-688ac8746bc5",
                                                "text": "„Frankreich ist das Land der Laizität schlechthin. So sieht es sich jedenfalls selbst. Das Prinzip der Trennung von Staat und Kirche ist nicht nur in der Verfassung, sondern auch fest im kollektiven Bewußtsein verankert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
