                "senses": [
                    {
                        "sense_id": "4211952d-5aa4-3f11-8992-643c432941a4",
                        "entry_id": "bb7a7a4b-9473-3d55-8f45-73986338c99f",
                        "glosses": [
                            "potrawa kuchni żydowskiej, przyrządzana z wolno duszonego mięsa wołowego, fasoli, kaszy, ziemniaków, czasem jajek, spożywana w szabas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bfbe970-f7ce-45a5-b1d2-e8d6621ffc81",
                                "sense_id": "4211952d-5aa4-3f11-8992-643c432941a4",
                                "text": "To było na Starowiślnej, i tam chodziliśmy na czulent. Krakowski czulent to nie jest dokładnie to, co grodzieński. Moja żona ma, że tak powiem, inne pojęcie o czulencie. W każdym miejscu na świecie czulent ma inne składniki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddb56329-aafd-4650-a5b7-2ce97b1e85cc",
