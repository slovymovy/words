                                "target_senses": [
                                    {
                                        "sense_id": "19e56c5d-9fb4-30d0-86fb-2cb5bf104f18",
                                        "entry_id": "de317bf5-c155-3ad8-93f1-445fd0f462b3",
                                        "glosses": [
                                            "peça de madeira usada em substituição da parte amputada de uma perna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e19f83-7d1a-44d1-b89b-7bb5c67f2fa8",
                                                "sense_id": "19e56c5d-9fb4-30d0-86fb-2cb5bf104f18",
                                                "text": "O português do Brasil ginga, mexe, remexe, efervesce, queima, manda brasa e passa a perna em tudo e todos com suas reformas ortográficas e vernaculares a que insiste, como um pirata da perna de pau, lá no alto da popa, de chamar de \"acordo ortográfico\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043b5b70-1583-3e7e-be8d-028a68139447",
                                        "entry_id": "de317bf5-c155-3ad8-93f1-445fd0f462b3",
                                        "glosses": [
                                            "pessoa a quem falta uma perna ou tem uma delas defeituosa; perneta"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da5f6caf-96c1-3a47-bea2-772a0fac86bb",
                                        "entry_id": "de317bf5-c155-3ad8-93f1-445fd0f462b3",
                                        "glosses": [
                                            "jogador de má qualidade; perneta (Uso: informal, pejorativo)"
                                        ],
                                        "tags": [
                                            "Brazil"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ceb88f94-f6e6-31c7-81e4-33fc5a095232",
                                        "entry_id": "de317bf5-c155-3ad8-93f1-445fd0f462b3",
                                        "glosses": [
                                            "haste de madeira usada para andar, usada principalmente por artistas circenses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ac223dc-e3fa-4ab4-8d38-a252176b1d3e",
                                                "sense_id": "ceb88f94-f6e6-31c7-81e4-33fc5a095232",
                                                "text": "Anteontem de madrugada, o aposentado Hozanar Ferreira da Silva, de 73 anos, garante ter visto um morador apoiando-se nas paredes das casas com uma perna de pau, para evitar se molhar."
                                            }
                                        ]
