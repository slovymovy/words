    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d566cb4-7483-37b4-b196-9529e36e6fa1",
                    "sense_definition": "Document synthétique qui regroupe des renseignements administratifs, techniques ou signalétiques sur une personne, un objet ou une méthode.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employeur doit envoyer la <w>fiche</w> de paie à chaque salarié à la fin du mois."
                        },
                        {
                            "text": "Le professeur nous a demandé de préparer une <w>fiche</w> de lecture avant le cours."
                        }
                    ],
                    "synonyms": [
                        "formulaire",
                        "bordereau"
                    ],
                    "common_phrases": [
                        "fiche de paie",
                        "fiche technique",
                        "fiche de lecture",
                        "fiche de renseignements"
                    ]
                },
                {
                    "sense_id": "eec114ef-7681-3dee-bcad-6f0107e6bc53",
                    "sense_definition": "Petite feuille cartonnée sur laquelle on inscrit des notes brèves pour les classer facilement dans un répertoire.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant a rédigé chaque <w>fiche</w> de révision avec des couleurs différentes pour mieux mémoriser."
                        },
                        {
                            "text": "La bibliothécaire classe soigneusement chaque nouvelle <w>fiche</w> cartonnée dans le tiroir prévu à cet effet."
                        }
                    ],
                    "common_phrases": [
                        "fiche cartonnée",
                        "boîte à fiches"
                    ]
                },
                {
                    "sense_id": "fba7ab99-6f88-3230-bacc-0c671e731c2a",
                    "sense_definition": "Pièce conductrice munie de tiges métalliques destinée à être introduite dans une prise pour établir un contact électrique.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "connecteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut introduire la <w>fiche</w> électrique dans la prise murale pour allumer la lampe."
                        },
                        {
                            "text": "Avant de nettoyer cet appareil, retirez la <w>fiche</w> de la prise de courant."
                        }
                    ],
                    "synonyms": [
                        "prise"
                    ],
                    "common_phrases": [
                        "fiche mâle",
                        "fiche femelle",
                        "fiche électrique"
                    ]
                },
                {
                    "sense_id": "7a4ba6f1-546f-3b7f-9067-d243e4c109bb",
                    "sense_definition": "Ensemble structuré de données informatiques relatives à un individu, un produit ou un élément particulier dans une base de données.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin ouvre la <w>fiche</w> du patient sur son ordinateur avant de commencer la consultation."
                        },
                        {
                            "text": "Notre site internet met à jour chaque <w>fiche</w> client dès qu'un achat est validé."
                        }
                    ],
                    "synonyms": [
                        "enregistrement"
                    ],
                    "common_phrases": [
