                ],
                "senses": [
                    {
                        "sense_id": "7c74dbb3-b081-3d83-b700-c46b528cfbe2",
                        "entry_id": "694e57fc-54be-38f6-aa4c-38edbc6f9cde",
                        "glosses": [
                            "Flasche, in der Wodka aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4622d602-adfb-47a3-9e36-2360b89bb0ae",
                                "sense_id": "7c74dbb3-b081-3d83-b700-c46b528cfbe2",
                                "text": "In einem Spirituosengeschäft kann man auch Wodkaflaschen finden."
                            },
                            {
                                "example_id": "c2cf719a-43fd-4c47-97ab-fceab310f24b",
                                "sense_id": "7c74dbb3-b081-3d83-b700-c46b528cfbe2",
                                "text": "„Sie hatten eine Packtasche dabei, aus der die Hälse von Wodkaflaschen schauten. Es waren die schlanken hellen Flaschen, wie sie die Landser als Marketenderware bekamen.“"
                            },
                            {
                                "example_id": "edd74f7d-062f-474d-b34d-0573e7664ee4",
                                "sense_id": "7c74dbb3-b081-3d83-b700-c46b528cfbe2",
                                "text": "„Ich zog die obere rechte Schublade auf, holte die Wodkaflasche raus und genehmigte mir einen Hit.“"
                            },
                            {
                                "example_id": "186b05fb-b6ac-43ad-a0a5-33e41a7f6db6",
                                "sense_id": "7c74dbb3-b081-3d83-b700-c46b528cfbe2",
                                "text": "„Sie schlendern langsam von der Flammenflut weg, nehmen abwechselnd Schlucke aus Wodkaflaschen und rauchen Black-Death-Zigaretten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
