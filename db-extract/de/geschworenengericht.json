                "senses": [
                    {
                        "sense_id": "bc833c7f-0870-37e5-a372-5dc270ba8152",
                        "entry_id": "1aed3f5a-a91e-38bd-ac79-389a7161a527",
                        "glosses": [
                            "Gericht, dem auch Geschworene angehören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8385567-7785-4f85-af96-8780e9c0c4eb",
                                "sense_id": "bc833c7f-0870-37e5-a372-5dc270ba8152",
                                "text": "„Menschen, die beim Militär dienen, sind durch die Klausel des fünften Verfassungszusatzes zu den Geschworenengerichten weder in Kriegs- noch in Friedenszeiten geschützt.“"
                            },
                            {
                                "example_id": "f8f14100-5ff7-4819-8e11-1954ea59d610",
                                "sense_id": "bc833c7f-0870-37e5-a372-5dc270ba8152",
                                "text": "„Und trotzdem stehen die Chancen fünfzig-fünfzig, dass ein für Himmel und Erde zuständiges Geschworenengericht, das stets genau paritätisch mit den Bewohnern von Himmel und Hölle besetzt wäre, sie freigesprochen hätte.“"
                            }
                        ],
