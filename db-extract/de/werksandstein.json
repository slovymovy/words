                "senses": [
                    {
                        "sense_id": "a4042047-854d-38c9-9ddd-56b09bee77ac",
                        "entry_id": "6e991854-02cf-3c45-80c5-931d15c61fe6",
                        "glosses": [
                            "meist gelblicher Sandstein aus dem Zeitalter des Keupers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2973fec-e6d9-4fe8-a8d9-1267e60b7625",
                                "sense_id": "a4042047-854d-38c9-9ddd-56b09bee77ac",
                                "text": "„Der Werksandstein ist ein feinkörniger, tonig gebundener Sandstein, der vom dunkelrot-braunen bis zum schmutzig-grünen Ton in den oberen Lagen übergeht.“"
                            },
                            {
                                "example_id": "050190ea-b09b-4187-ac7a-07e1ee738283",
                                "sense_id": "a4042047-854d-38c9-9ddd-56b09bee77ac",
                                "text": "„Die Tabelle 4 bringt einige Vergleichswerte für Schilfsandsteine und verwandte Werksandsteine aus der Literatur.“"
                            },
                            {
                                "example_id": "630a9f07-d15b-4a23-a64c-f99ab77c40d5",
                                "sense_id": "a4042047-854d-38c9-9ddd-56b09bee77ac",
                                "text": "„Der Trombach ist weniger hoch als der Korberkopf, Hörnleskopf und Haselstein, und besteht aus einem trefflichen Werksandstein von weißer Farbe.“"
                            },
                            {
                                "example_id": "aee8af8c-b93a-4f2f-9fcd-8db4269e981d",
                                "sense_id": "a4042047-854d-38c9-9ddd-56b09bee77ac",
                                "text": "„Größere Bedeutung besitzt der sogenannte Werksandstein, dessen größere Widerstandsfähigkeit bereits im Landschaftsbilde durch die von ihm geformten schrofferen Rücken hervortritt; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
