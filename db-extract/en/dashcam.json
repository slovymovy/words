                                        "sense_id": "9983b6dd-14bb-316e-b3af-bcc39df666c6",
                                        "entry_id": "6a94a643-bc4e-3710-876c-2b0394dffcb6",
                                        "glosses": [
                                            "Caméra embarquée qui enregistre ce qui se passe en avant du véhicule."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33937cf4-6285-482a-953d-d483af2831ba",
                                                "sense_id": "9983b6dd-14bb-316e-b3af-bcc39df666c6",
                                                "text": "Les dashcams sont ces petites caméras qui peuvent être placées dans l’habitacle des véhicules et qui sont destinées a priori à filmer les itinéraires empruntés."
                                            },
                                            {
                                                "example_id": "feb4957d-e83a-4b34-8a06-3e464d215aab",
                                                "sense_id": "9983b6dd-14bb-316e-b3af-bcc39df666c6",
                                                "text": "Rien de tel qu’une dashcam, comme la 322GW de Nextbase, pour prouver sa bonne foi lors d’un accrochage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
