                    {
                        "sense_id": "fb295f58-7e6c-3835-a062-952865dc63dc",
                        "entry_id": "57720e47-f87c-3a3c-998f-fdce14dae0c2",
                        "glosses": [
                            "Abîmé, blessé."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c9a101f5-ae3c-4819-bee6-b0906d73a44e",
                                "sense_id": "fb295f58-7e6c-3835-a062-952865dc63dc",
                                "text": "Il est vachement amoché !"
                            },
                            {
                                "example_id": "3adb8bc5-5c9e-4949-89e7-150950bd4fcb",
                                "sense_id": "fb295f58-7e6c-3835-a062-952865dc63dc",
                                "text": "La levée en masse contre l'artillerie lourde ne donne qu'un plus grand nombre de braves gens amochés."
                            },
                            {
                                "example_id": "8f7449c1-25c1-47ca-bea4-a2cf75f89006",
                                "sense_id": "fb295f58-7e6c-3835-a062-952865dc63dc",
                                "text": "À peine arrivé dans la cour de cette école transformée en hôpital pour troufions amochés, je compris que ce ne serait pas la vie en rose."
                            },
                            {
                                "example_id": "5a23ab5f-5163-4af3-a30b-a5a2b79680fb",
                                "sense_id": "fb295f58-7e6c-3835-a062-952865dc63dc",
                                "text": "Et la marque conservatrice déjà amochée en prend un coup."
                            }
                        ]
                    }
