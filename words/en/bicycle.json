    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "129f68f4-1c0d-3312-bb13-e5d5507f00b3",
                    "sense_definition": "A vehicle with two wheels, a steering handle, and a seat, usually moved by pushing pedals with the feet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is fun to ride a <w>bicycle</w> in the park on a sunny day.",
                            "target_lang_translations": {
                                "ru": "Весело кататься на <w>велосипеде</w> в парке в солнечный день.",
                                "zh": "在晴朗的日子里，在公园里<w>骑自行车</w>很有趣。"
                            }
                        },
                        {
                            "text": "She parked her <w>bicycle</w> outside the shop and went inside.",
                            "target_lang_translations": {
                                "ru": "Она припарковала свой <w>велосипед</w> у магазина и зашла внутрь.",
                                "zh": "她把<w>自行车</w>停在商店外面，然后走了进去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bike",
                        "cycle",
                        "pushbike",
                        "two-wheeler"
                    ],
                    "common_phrases": [
                        "ride a bicycle",
                        "get on a bicycle",
                        "fall off a bicycle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство с двумя колесами, рулем и сиденьем, обычно приводимое в движение вращением педалей ногами.",
                        "zh": "一种有两个轮子、车把和座位的交通工具，通常靠双脚踩踏板驱动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "велосипед",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "велик",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自行车",
                                "target_lang_sense_clarification": "通用名称"
                            },
                            {
                                "target_lang_word": "单车",
                                "target_lang_sense_clarification": "南方常用词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98bed318-f0ca-3412-a9f0-e5359bfe5204",
                    "sense_definition": "To travel or exercise by riding a bicycle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used to <w>bicycle</w> to work every morning to stay fit.",
                            "target_lang_translations": {
                                "ru": "Раньше он <w>ездил на велосипеде</w> на работу каждое утро, чтобы поддерживать форму.",
                                "zh": "他过去每天早上都<w>骑车</w>去上班以保持健康。"
                            }
                        },
                        {
                            "text": "We decided to <w>bicycle</w> along the coast during our holiday.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>проехать на велосипедах</w> вдоль побережья во время нашего отпуска.",
                                "zh": "我们决定在假期里沿着海岸<w>骑行</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cycle",
                        "bike"
                    ],
                    "common_phrases": [
                        "bicycle to work",
                        "bicycle home"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать или тренироваться, катаясь на велосипеде.",
                        "zh": "通过骑自行车进行旅行或锻炼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ездить на велосипеде",
                                "target_lang_sense_clarification": "передвигаться"
                            },
                            {
                                "target_lang_word": "кататься на велосипеде",
                                "target_lang_sense_clarification": "для удовольствия или спорта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骑自行车",
