                                "target_senses": [
                                    {
                                        "sense_id": "78ff3d86-43eb-31cc-b34c-1118ee82857e",
                                        "entry_id": "13dd4874-6362-332e-bb54-6982029ad250",
                                        "glosses": [
                                            "A stylus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f162932c-4b98-4a03-9860-ba3bc8a8e75c",
                                                "sense_id": "78ff3d86-43eb-31cc-b34c-1118ee82857e",
                                                "text": "If possible, a touch pen on the HP48sx screen is better than a 'MoUsE' ball under the HP48sx."
                                            },
                                            {
                                                "example_id": "7806a05f-c710-4d65-a8cc-4a6cc7181b7a",
                                                "sense_id": "78ff3d86-43eb-31cc-b34c-1118ee82857e",
                                                "text": "Where is the touchpen? Does the lack of a touchpen indicate the gcpp doesn't have touchscreen capabilities? How does this affect ClassiCom game compatability?"
                                            },
                                            {
                                                "example_id": "4d740834-b138-4d62-9149-f0ef72cd13f2",
                                                "sense_id": "78ff3d86-43eb-31cc-b34c-1118ee82857e",
                                                "text": "As much as I love the game, I feel that the DS' touch pen is kinda big for that game. Any good suggestions to better touch pens?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d742d6d5-9b60-46b4-83aa-6f5f655d2cdd",
                        "source_entry_id": "118366ae-f557-3699-9972-957136a51f90",
                        "source_sense_id": "0ad2fc0e-ea70-3ad7-97b8-33584e55c635",
