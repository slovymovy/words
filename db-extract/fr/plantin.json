                    {
                        "sense_id": "682af79f-d30f-3127-923f-70adac973359",
                        "entry_id": "49d8ad2b-8010-3662-a989-1248824ba3d3",
                        "glosses": [
                            "Variante orthographique de plantain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afdcd7e1-6535-4515-b92f-d6ea82c5b25b",
                                "sense_id": "682af79f-d30f-3127-923f-70adac973359",
                                "text": "Quelques marguerites innocentes, un long et maigre plantin qui poussaient dans le voisinage, entendaient ces discours, et y croyaient naïvement."
                            },
                            {
                                "example_id": "15c5b487-51bd-48dd-8f6d-8c8f277b0695",
                                "sense_id": "682af79f-d30f-3127-923f-70adac973359",
                                "text": "La chanson qu'il faut chanter en dépeçant le sanglier pour que l'odeur du sauvage ne s'attache pas au couteau et à la planche d'étal :\nUne branche de fenouil\njonc de corbeil\net beau plantin,\nCameline. Dauphinelle\nCardamine et mon cresson\nbeau cresson qui craque au fond,\nlourde, sauge, lourde sauge,\nArtémise, centaurée.\n— (Jean Giono, L'eau vive, éditeur Gallimard, 1943)"
                            }
                        ]
                    }
