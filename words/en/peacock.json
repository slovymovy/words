{
    "word_family": [
        "peacockish",
        "peacocky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c50acf3c-7004-3a72-aea8-6eede0e62a5a",
                    "sense_definition": "A male peafowl, known for its large, colorful, and patterned tail feathers.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The male <w>peacock</w> spread its tail to attract a mate.",
                            "target_lang_translations": {
                                "nl": "De mannelijke <w>pauw</w> spreidde zijn staart om een partner aan te trekken."
                            }
                        },
                        {
                            "text": "We saw a beautiful <w>peacock</w> walking through the garden.",
                            "target_lang_translations": {
                                "nl": "We zagen een prachtige <w>pauw</w> door de tuin lopen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proud as a peacock"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een mannelijke pauw, bekend om zijn grote, kleurrijke en van oogpatronen voorziene staartveren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pauw",
                                "target_lang_sense_clarification": "mannelijke vogel"
                            },
                            {
                                "target_lang_word": "pauwhaan",
                                "target_lang_sense_clarification": "specifiek het mannetje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86b8911f-21d4-3a69-ae33-83976e10c9d6",
                    "sense_definition": "A person who is very proud, vain, or likes to show off.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is such a <w>peacock</w>, always wearing expensive clothes to get attention.",
                            "target_lang_translations": {
                                "nl": "Hij is zo'n <w>pronker</w>, die altijd dure kleren draagt om aandacht te trekken."
                            }
                        },
                        {
                            "text": "Don't be a <w>peacock</w> and try to act more humble.",
                            "target_lang_translations": {
                                "nl": "Wees niet zo'n <w>ijdelbek</w> en probeer je wat bescheidener op te stellen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die erg trots, ijdel of pronkzuchtig is."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pronker",
                                "target_lang_sense_clarification": "ijdel persoon"
                            },
                            {
                                "target_lang_word": "ijdelbek",
                                "target_lang_sense_clarification": "verwaand persoon"
                            },
                            {
                                "target_lang_word": "fat",
                                "target_lang_sense_clarification": "pronkzuchtige man"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16c14203-f4e3-3874-8432-3448d59875c9",
                    "sense_definition": "A bird of the genus Pavo or Afropavo, regardless of sex.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The zoo has a large enclosure for the <w>peacock</w> population.",
                            "target_lang_translations": {
                                "nl": "De dierentuin heeft een groot verblijf voor de <w>pauwen</w>populatie."
                            }
                        },
                        {
                            "text": "In everyday English, any bird of this species can be called a <w>peacock</w>, male or female.",
                            "target_lang_translations": {
                                "nl": "In alledaags Engels kan elke vogel van deze soort een <w>peacock</w> worden genoemd, mannelijk of vrouwelijk."
                            }
                        }
                    ],
                    "synonyms": [
                        "peafowl"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een vogel van het geslacht Pavo of Afropavo, ongeacht het geslacht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pauw",
                                "target_lang_sense_clarification": "vogelsoort in het algemeen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46c88476-a4c2-3b30-89c1-1118f72624ba",
                    "sense_definition": "A type of Asian butterfly belonging to the genus Papilio.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>peacock</w> butterfly is known for its striking wing patterns.",
                            "target_lang_translations": {
                                "nl": "De <w>peacock</w>-vlinder staat bekend om zijn opvallende vleugelpatronen."
                            }
                        },
                        {
                            "text": "Collectors often search for the rare <w>peacock</w> in the forest.",
                            "target_lang_translations": {
                                "nl": "Verzamelaars zoeken vaak naar de zeldzame <w>page</w> in het bos."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een Aziatische vlinder behorend tot het geslacht Papilio."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "page",
                                "target_lang_sense_clarification": "vlindersoort uit het geslacht Papilio"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30890adb-d857-373a-9a8d-1cd18957f0e3",
                    "sense_definition": "To walk or behave in a very proud or showy way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guards <w>peacocked</w> around the room to show their authority.",
                            "target_lang_translations": {
                                "nl": "De bewakers <w>paradeerden</w> door de kamer om hun gezag te tonen."
                            }
                        },
                        {
                            "text": "He likes to <w>peacock</w> whenever he enters a crowded party.",
                            "target_lang_translations": {
                                "nl": "Hij houdt ervan om te <w>pronken</w> zodra hij een druk feestje binnenstapt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een zeer trotse of pronkende manier lopen of zich gedragen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pronken",
                                "target_lang_sense_clarification": "zich trots tonen"
                            },
                            {
                                "target_lang_word": "paraderen",
                                "target_lang_sense_clarification": "trots rondstappen"
                            },
                            {
                                "target_lang_word": "pauwen",
                                "target_lang_sense_clarification": "pronkgedrag vertonen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0e0570e-3c2b-3c0a-a039-836fb72adee4",
                    "sense_definition": "To dress or act in an ostentatious way to attract attention.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent hours getting ready just to <w>peacock</w> at the club.",
                            "target_lang_translations": {
                                "nl": "Hij deed er uren over om zich klaar te maken, puur om te <w>showen</w> in de club."
                            }
                        },
                        {
                            "text": "It is annoying to watch him <w>peacock</w> in front of everyone.",
                            "target_lang_translations": {
                                "nl": "Het is irritant om hem te zien <w>pronken</w> in het bijzijn van iedereen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Zich opzichtig kleden of gedragen om de aandacht te trekken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pronken",
                                "target_lang_sense_clarification": "opzichtig gedrag vertonen"
                            },
                            {
                                "target_lang_word": "showen",
                                "target_lang_sense_clarification": "de aandacht trekken door uiterlijk vertoon"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "dfc33c2e-0a80-3fe8-976b-cd1a783e6cc5",
                    "sense_definition": "A family name derived from a nickname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Peacock</w> is our new history teacher.",
                            "target_lang_translations": {
                                "nl": "Meneer <w>Peacock</w> is onze nieuwe geschiedenisleraar."
                            }
                        },
                        {
                            "text": "The author of the book is named Sarah <w>Peacock</w>.",
                            "target_lang_translations": {
                                "nl": "De auteur van het boek heet Sarah <w>Peacock</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een familienaam die oorspronkelijk is afgeleid van een bijnaam."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Peacock",
                                "target_lang_sense_clarification": "achternaam"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96445eeb-eab2-34ba-92ac-998a0269ad27",
                    "sense_definition": "A township located in Lake County, Michigan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to move to <w>Peacock</w> last summer.",
                            "target_lang_translations": {
                                "nl": "Ze besloten afgelopen zomer naar <w>Peacock</w> te verhuizen."
                            }
                        },
                        {
                            "text": "The small town of <w>Peacock</w> is very quiet.",
                            "target_lang_translations": {
                                "nl": "Het kleine stadje <w>Peacock</w> is erg rustig."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een township in Lake County, Michigan."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Peacock",
                                "target_lang_sense_clarification": "plaats in Michigan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa6385d4-aa87-3d03-94b9-2e0321873fc6",
                    "sense_definition": "An unincorporated community in Stonewall County, Texas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through <w>Peacock</w> on our way to the city.",
                            "target_lang_translations": {
                                "nl": "We reden door <w>Peacock</w> op weg naar de stad."
                            }
                        },
                        {
                            "text": "The community of <w>Peacock</w> is quite small.",
                            "target_lang_translations": {
                                "nl": "De gemeenschap van <w>Peacock</w> is vrij klein."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gemeentevrij gebied in Stonewall County, Texas."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Peacock",
                                "target_lang_sense_clarification": "plaats in Texas"
                            }
                        ]
                    }
                }
            ]
        }
    ]
