                        "glosses": [
                            "ijzeren haak op een houten stok die men voor diverse doeleinden aan boord van een schip gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3641bc6-bd2d-4096-9155-ee5f7f725591",
                                "sense_id": "36589a67-8b4b-33ed-b95a-40b3961e14e1",
                                "text": "„De bouwput op het Damrak lag bij de Nieuwe Brug. De diversiteit van de bodemvondsten leert ons veel over de functie van die brug. De bootshaken vertellen bijvoorbeeld een verhaal over de brug als ingang van de haven."
                            },
                            {
                                "example_id": "ab7ccc85-adca-4caf-9aed-c49a231bf47e",
                                "sense_id": "36589a67-8b4b-33ed-b95a-40b3961e14e1",
                                "text": "Ook had ik aan een bootshaak een klein zeiltje vastgemaakt, om het bij gelegenheid te kunnen gebruiken."
                            }
                        ]
                    }
                ],
