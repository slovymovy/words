                        "tags": [],
                        "examples": [
                            {
                                "example_id": "985d7acb-fea2-4171-8684-d6dc6250ae44",
                                "sense_id": "0c243800-c2c9-3f50-80a6-cdfeb508d8e2",
                                "text": "«Здорово, Зубо», — сказал грубый Корнеев. — «Эдик, это Зубо. Дай ему документы, а то его сейчас кондрат хватит»."
                            }
                        ]
                    },
