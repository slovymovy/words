                            },
                            {
                                "target_word": "dualist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee8e57af-4446-3ed8-a68d-21f8fd8b786b",
                                        "entry_id": "60adf3f5-970d-322d-af33-a09dc6b8e536",
                                        "glosses": [
                                            "Any person who supports dualism, the belief in absolute good and absolute evil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ac3e841-aef8-4fa0-95be-a10b8ab15006",
                                                "sense_id": "ee8e57af-4446-3ed8-a68d-21f8fd8b786b",
                                                "text": "The Manicheans were dualists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "680aaac9-26af-335f-b90f-fdc304f6ef08",
                                        "entry_id": "60adf3f5-970d-322d-af33-a09dc6b8e536",
                                        "glosses": [
                                            "Any person who believes in or argues for the duality of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "785c70c1-b920-4aa8-bddd-34c415bc267e",
                                                "sense_id": "680aaac9-26af-335f-b90f-fdc304f6ef08",
                                                "text": "Regarding the second option, suppose that a substance dualist who is also a theist accounts for the conceptual possibility of a mental difference by claiming that God decided to put a soul in one individual but not the other."
                                            }
                                        ]
                                    }
