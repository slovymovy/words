    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6720167-259c-3e48-903f-1ec596469ca9",
                    "sense_definition": "zich een voorstelling maken van een situatie of iemands gevoelens om begrip op te brengen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verbeelding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan me heel goed <w>indenken</w> dat je na zo'n lange dag erg moe bent.",
                            "target_lang_translations": {
                                "en": "I can very well <w>imagine</w> that you are very tired after such a long day."
                            }
                        },
                        {
                            "text": "Je moet je eens <w>indenken</w> hoe het zou zijn om in een ander land te wonen.",
                            "target_lang_translations": {
                                "en": "You should <w>imagine</w> for a moment what it would be like to live in another country."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorstellen",
                        "inleven",
                        "begrijpen"
                    ],
                    "common_phrases": [
                        "zich kunnen indenken",
                        "moeilijk indenken"
                    ],
                    "target_lang_definitions": {
                        "en": "to form a mental image of a situation or someone's feelings in order to show understanding or empathy"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imagine",
                                "target_lang_sense_clarification": "to form a mental picture of a situation"
                            },
                            {
                                "target_lang_word": "empathize",
                                "target_lang_sense_clarification": "to understand and share the feelings of another"
                            },
                            {
                                "target_lang_word": "understand",
                                "target_lang_sense_clarification": "to grasp the reason or logic behind a feeling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39da96c2-98f5-3130-9992-2773daa2d383",
                    "sense_definition": "iets mentaal visualiseren of als mogelijkheid beschouwen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbeelding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is bijna niet <w>in te denken</w> dat deze stad vroeger een klein dorpje was.",
                            "target_lang_translations": {
                                "en": "It is almost <w>unimaginable</w> that this city used to be a small village."
                            }
                        },
                        {
                            "text": "Kun jij je een wereld zonder internet <w>indenken</w>?",
                            "target_lang_translations": {
                                "en": "Can you <w>imagine</w> a world without internet?"
                            }
                        }
                    ],
                    "synonyms": [
                        "visualiseren",
                        "fantaseren"
                    ],
                    "common_phrases": [
                        "niet in te denken"
                    ],
                    "target_lang_definitions": {
                        "en": "to mentally visualize something or consider it as a possibility"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imagine",
                                "target_lang_sense_clarification": "to conceive of something as possible"
                            },
                            {
                                "target_lang_word": "visualize",
                                "target_lang_sense_clarification": "to form a mental image of something"
                            },
                            {
                                "target_lang_word": "conceive",
                                "target_lang_sense_clarification": "to be able to imagine or believe something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2daec0d4-c3dd-3400-88de-fc3675972ba8",
                    "sense_definition": "iets van tevoren in een plan of ontwerp opnemen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het oorspronkelijke ontwerp was er geen extra parkeerruimte <w>ingedacht</w>.",
                            "target_lang_translations": {
                                "en": "In the original design, no extra parking space had been <w>planned</w>."
                            }
                        },
                        {
                            "text": "De architect had een prachtige binnentuin in het gebouw <w>ingedacht</w>.",
                            "target_lang_translations": {
                                "en": "The architect had <w>envisioned</w> a beautiful courtyard inside the building."
                            }
                        }
                    ],
                    "synonyms": [
                        "inplannen",
                        "opnemen",
                        "verwerken"
                    ],
                    "antonyms": [
                        "uitsluiten",
                        "vergeten"
                    ],
                    "common_phrases": [
                        "plaats ingedacht"
                    ],
                    "target_lang_definitions": {
                        "en": "to include something in a plan or design beforehand"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incorporate",
                                "target_lang_sense_clarification": "to include as part of a whole"
                            },
                            {
                                "target_lang_word": "plan for",
                                "target_lang_sense_clarification": "to make arrangements for something in advance"
                            },
                            {
                                "target_lang_word": "envision",
                                "target_lang_sense_clarification": "to imagine as a future possibility in a design"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}