                    {
                        "form_id": "0ca14ad5-1f6c-4be4-8e51-82a9cb6092b1",
                        "entry_id": "645d364e-f834-3430-be90-bec66c618ff3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Copylefts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                        "entry_id": "645d364e-f834-3430-be90-bec66c618ff3",
                        "glosses": [
                            "Klausel in urheberrechtlichen Lizenzverträgen, die festlegt, dass die Weiterentwicklung eines Werkes (häufig Software) nur unter den gleichen Bedingungen zur ursprünglichen Lizenz verbreitet werden dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fedacce5-a93b-4b26-9d93-2643b0e6854a",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "Copyleft ist ein Wortspiel mit dem Begriff Copyright (Urheberrecht)."
                            },
                            {
                                "example_id": "bcfca3c4-3484-4ee6-88e9-c851c90e732b",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "„Die Grundlage der freien Software bilden die Lizenzmodelle nach dem Copyleft.“"
                            },
                            {
                                "example_id": "2377ecf6-1002-4d12-a44a-927851417571",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "„Das Copyleft setzt voraus, dass Vervielfältigungen und Bearbeitungen in irgendeiner Weise erlaubt sind.“"
                            },
                            {
                                "example_id": "7f9c2ddf-2d9a-4812-a887-b779f9396c5d",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "„Von entscheidender Bedeutung für die Kategorisierung von Open-Source-Lizenzen ist der von Richard Stallmann geprägte Begriff Copyleft in Anlehnung an das Copyright, das die Verbreitung von Daten nur dem Urheber gestattet.“"
                            },
                            {
                                "example_id": "4be34160-a65a-414f-84ea-119db249a3cf",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "„Copyleft besagt, dass sämtliche Änderungen und Weiterentwicklungen einer Open-Source-Software nur unter der gleichen Lizenz als freie Software weitergegeben werden dürfen.“"
                            },
                            {
                                "example_id": "173abb8a-f22a-4ba0-a919-b6cca9a23535",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "„Copyleft bedeutet, dass der Lizenznehmer das Recht bekommt, die Software zu verwenden, zu untersuchen, anzupassen und weiterzugeben. Wenn er die Software weitergibt, muss der Empfänger aber wieder dieselben Rechte haben.“"
                            },
                            {
                                "example_id": "5f616663-8525-4419-bed4-d85c28756fe1",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "„Der Text des Tutorials zu Copyleft ist bereits über 100 Seiten lang und versucht, alle Aspekte von Copyleft zu diskutieren - von den Grundlagen der Idee der Software-Freiheit über genaue Analysen der wichtigsten Lizenztexte bis zu Fragen der Lizenzkonformität.“"
                            },
                            {
                                "example_id": "9ad961ef-4a79-43be-b334-8b9513fb5695",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "[Wikipedia:] „Die Mission ist, alles menschliche Wissen zusammenzufassen und frei verfügbar zu machen. Der Clou: Auch Dritte dürfen die Texte nach Belieben kopieren und verändern, sofern sie ihre Änderungen frei zur Verfügung stellen - statt Copyright gilt \"Copyleft\".“"
                            },
                            {
                                "example_id": "3a51c239-ed0f-49b4-9612-fdd688fa3b30",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "„Das rechtliche Prinzip des Copylefts ist nicht vereinbar mit dem der Gemeinfreiheit, da Copyleft auf dem Urheberrecht aufbaut, anstatt wie die Gemeinfreiheit darauf zu verzichten.“"
                            },
                            {
                                "example_id": "1931be45-733d-45c7-a222-fa1d45e18c37",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "„Die LGPL erlaubt den Entwicklern und Firmen das Verwenden und Einbinden von LGPL-Software in eigene (sogar proprietäre) Software, ohne durch ein starkes Copyleft gezwungen zu sein, den Quellcode der eigenen Software-Teile offenzulegen.“"
                            },
                            {
                                "example_id": "c3a72a9c-a817-4651-b8bc-b198461f493d",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "„Lizenzen mit strengem Copyleft werden auch als GPL-artige Lizenzen bezeichnet.“"
                            },
                            {
                                "example_id": "94a41a23-cc50-4cb6-9b47-3447b53ef56a",
                                "sense_id": "eb52d01d-8048-322b-8725-97bbba3e8757",
                                "text": "„Lizenzen ohne Copyleft werden als BSD-artige Lizenzen bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
