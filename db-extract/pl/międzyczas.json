                "translations": [
                    {
                        "translation_id": "45ab2eec-772a-44a6-9bfc-184429d1afc8",
                        "source_entry_id": "1294acc8-2abc-33fa-a811-50a6e7e9a87f",
                        "source_sense_id": "609f8e5b-35d0-3aee-a569-b640287af4f0",
                        "target_lang_word": "meantime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meantime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e7776da-d551-30b1-9caa-d4f2644ab33f",
                                        "entry_id": "5f400e2e-895f-3503-ba4e-7e08eebe8cfe",
                                        "glosses": [
                                            "The time spent waiting for another event; time in between."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8fca768-b586-4db2-a618-82791db35d51",
                                                "sense_id": "8e7776da-d551-30b1-9caa-d4f2644ab33f",
                                                "text": "We'll come back asap; just wait here for the meantime."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meantime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                                        "entry_id": "60047127-901c-3460-afaf-f8ff1f3ca2de",
                                        "glosses": [
                                            "During the interval; meanwhile."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bdb12ad-7e5c-435b-beff-6fc10bf66a78",
                                                "sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                                                "text": "Repairs will be done tomorrow so meantime restrain from using the bath."
                                            },
                                            {
                                                "example_id": "5baf04b6-459e-4adf-b744-062c3d3dbf5b",
                                                "sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                                                "text": "Meantime Pope Urban II convoked two councils, one after another."
                                            },
                                            {
                                                "example_id": "2d70673c-bc7c-498a-ad6a-7d5476aaa0e2",
                                                "sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                                                "text": "Lunch will be in twenty minutes. Meantime: I have[…]"
                                            },
                                            {
                                                "example_id": "7c75ef10-cb6e-42e2-8080-510bf6afffb1",
                                                "sense_id": "cbb4d3f6-6b15-31cd-be95-4bc53ee0572d",
                                                "text": "Meantime, the train went on to Brighton without further incident. No small stir was caused by its arrival with No. 61 at its head, resplendent with \"East London Line Special\" head boards, which at once caught the eye of William Stroudley, who was observing the traffic working from his office window."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc458473-e13a-4bf9-910d-815a2d0abf16",
                        "source_entry_id": "1294acc8-2abc-33fa-a811-50a6e7e9a87f",
                        "source_sense_id": "609f8e5b-35d0-3aee-a569-b640287af4f0",
                        "target_lang_word": "Zwischenzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwischenzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb72a4d-1b69-3a22-b181-72beab8db88b",
                                        "entry_id": "6607b82f-40d2-38aa-baa8-35bdca04f11a",
                                        "glosses": [
                                            "Zeitraum zwischen zwei Zeitpunkten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8a67fe4-9373-427c-b967-272262136b83",
                                                "sense_id": "dbb72a4d-1b69-3a22-b181-72beab8db88b",
                                                "text": "„Die Brüder Billy kümmerten sich in der Zwischenzeit darum, dass die Fracht der Diligent gelöscht wurde und der Zucker, der rocou und die Baumwolle aus ihren Laderäumen zum Verkauf gelangte.“"
                                            },
                                            {
                                                "example_id": "ea606743-112e-438e-b8e6-f11099de6324",
                                                "sense_id": "dbb72a4d-1b69-3a22-b181-72beab8db88b",
                                                "text": "„Der gewöhnliche Reykjavíker begnügte sich damit, an der jährlichen Nacht der Kultur im August teilzunehmen, und sah in der Zwischenzeit fern.“"
                                            },
                                            {
                                                "example_id": "28f66bbd-dfb5-4a7f-9d0d-8e6a8b2f5742",
                                                "sense_id": "dbb72a4d-1b69-3a22-b181-72beab8db88b",
                                                "text": "„Aber auch diese Zwischenzeit war bald vorüber.“"
                                            },
                                            {
                                                "example_id": "ffc4f7ce-a240-452b-9381-8fafb6d341a7",
                                                "sense_id": "dbb72a4d-1b69-3a22-b181-72beab8db88b",
                                                "text": "„In der Zwischenzeit blieb der Status der deutschen Bevölkerung unklar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e2a8589-fc93-30d3-bc50-16e1b314a128",
                                        "entry_id": "6607b82f-40d2-38aa-baa8-35bdca04f11a",
                                        "glosses": [
                                            "gemessener Teilabschnitt einer länger dauernden Aktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0faed8-9700-48b4-8ed4-a4ad8307bfc0",
                                                "sense_id": "2e2a8589-fc93-30d3-bc50-16e1b314a128",
                                                "text": "Er gewann das Rennen, obwohl seine Zwischenzeit bei der Hälfte der Distanz nicht besonders gut war."
                                            },
                                            {
                                                "example_id": "afacc0ca-1964-4ffa-9379-dcecd8169ecc",
                                                "sense_id": "2e2a8589-fc93-30d3-bc50-16e1b314a128",
                                                "text": "Man sollte sich Zwischenzeiten für eine bestimmte Marathon-Endzeit berechnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
