                        "cross_references": [
                            {
                                "target_word": "mumifizieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53c1cf0e-37e1-38b2-aeeb-fc442986741e",
                                        "entry_id": "df4bad80-5ea5-3ae9-b7d6-d37250944e70",
                                        "glosses": [
                                            "einen Organismus (nach dessen Tod) durch das Entfernen von Körperflüssigkeiten und Organen sowie den Einfluss von Chemikalien vor der Verwesung schützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7642be7d-50c6-45b0-953e-3d74319d38ea",
                                                "sense_id": "53c1cf0e-37e1-38b2-aeeb-fc442986741e",
                                                "text": "Zu diesem Zeitpunkt mumifizieren die Ägypter ihre Toten noch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "969824dd-6b5c-38af-a40d-dfe22e62fffe",
                                        "entry_id": "df4bad80-5ea5-3ae9-b7d6-d37250944e70",
                                        "glosses": [
                                            "nicht verwesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6467db85-a791-430e-8787-84fd03d2a36d",
                                                "sense_id": "969824dd-6b5c-38af-a40d-dfe22e62fffe",
                                                "text": "Der Körper im Eis mumifizierte durch die trockene Umgebung und die niedrigen Temperaturen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3050986a-53a9-42fe-922a-676a3df48b64",
                        "source_entry_id": "6b2f58ed-87cb-3a16-a640-57833f294117",
                        "source_sense_id": "bc6df3e5-f384-358b-9e77-82b8f85ed665",
                        "target_lang_word": "mummificeren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mummificeren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f2f5d5ee-d78b-3a05-b1c0-a63ba515b6ad",
                                        "entry_id": "a8bdc0a9-9e5e-325e-b521-651f05e68a6f",
                                        "glosses": [
                                            "van een overledene een mummie maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b566afa7-e198-4ded-a36a-263e801f8d00",
                                                "sense_id": "f2f5d5ee-d78b-3a05-b1c0-a63ba515b6ad",
                                                "text": "De oude Egyptenaren mummificeerden de lichamen van hun doden."
                                            },
                                            {
                                                "example_id": "83b62959-775f-4eda-9feb-77780744f11e",
                                                "sense_id": "f2f5d5ee-d78b-3a05-b1c0-a63ba515b6ad",
                                                "text": "Een Britse taxichauffeur heeft een originele manier gevonden om de tand des tijds te weerstaan. De man, Allan Billis, liet zich na zijn dood namelijk mummificeren. Daarmee is Billis de eerste mummie in ruim 3000 jaar. Dat melden verschillende Britse media vandaag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d15eb9aa-8225-3b1c-ade0-fbf2ed9d9b4f",
                                        "entry_id": "a8bdc0a9-9e5e-325e-b521-651f05e68a6f",
                                        "glosses": [
                                            "uitdrogen, verschrompelen, verstenen, concerveren van overleden organismen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c56a176-972c-4ff5-b064-a9bcae276906",
                                                "sense_id": "d15eb9aa-8225-3b1c-ade0-fbf2ed9d9b4f",
                                                "text": "Daar zat hij dan, leunend op zijn rechterarm, voorovergebogen over zijn navigatietafel in zijn zeiljacht. Roerloos, alsof hij zijn zeilroute aan het overpeinzen was. De Filipijnse politie trof hem zo aan op 25 februari, dobberend voor de Filipijnse kust. Hij was van top tot teen gemummificeerd. Naar verluidt is hij gestorven aan een hartaanval."
                                            },
                                            {
                                                "example_id": "fa4f86af-7052-4994-80db-d3054d4afd79",
                                                "sense_id": "d15eb9aa-8225-3b1c-ade0-fbf2ed9d9b4f",
                                                "text": "Goudzoekers hebben dinsdag in de permafrost van Yukon, een gebied in het noordwesten van Canada, een gemummificeerde wolharige babymammoet gevonden. Het dier zou meer dan 30.000 jaar geleden op de wereld hebben gelopen, meldt de gemeente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
