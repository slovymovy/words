                        "target_lang_word": "leicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f217174-7e80-3cd3-a9d5-4a6716c901c5",
                                        "entry_id": "1b8e371d-b86c-35a5-927a-4961b0b1a504",
                                        "glosses": [
                                            "ein geringes Gewicht habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e2e639-622f-4bad-a646-eef84bcec3e4",
                                                "sense_id": "7f217174-7e80-3cd3-a9d5-4a6716c901c5",
                                                "text": "Das ist aber ein sehr leichtes Fahrrad. Das wiegt ja fast nichts!"
                                            },
                                            {
                                                "example_id": "aefd75ab-6518-4cad-a40a-65063690cefc",
                                                "sense_id": "7f217174-7e80-3cd3-a9d5-4a6716c901c5",
                                                "text": "Ich hätte gerne ein leichteres Paar Schuhe."
                                            },
                                            {
                                                "example_id": "c84d5207-2863-4bdc-856e-53113b13fc1a",
                                                "sense_id": "7f217174-7e80-3cd3-a9d5-4a6716c901c5",
                                                "text": "„Blumen produzieren Pollenkörner. Sie sind klein und leicht und einige von ihnen so geformt, dass sie über lange Entfernungen durch die Luft treiben können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11837bd8-3ffa-3885-afe3-b5fdbefe4503",
                                        "entry_id": "1b8e371d-b86c-35a5-927a-4961b0b1a504",
                                        "glosses": [
                                            "einfach, nicht schwierig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3725268-c58c-46fd-950b-4ec326e827de",
                                                "sense_id": "11837bd8-3ffa-3885-afe3-b5fdbefe4503",
                                                "text": "Die Klassenarbeit in Italienisch war wirklich leicht."
                                            },
                                            {
                                                "example_id": "1313a7cf-efe2-4aee-97c9-43410438244f",
                                                "sense_id": "11837bd8-3ffa-3885-afe3-b5fdbefe4503",
                                                "text": "Das ist tatsächlich keine leichte Frage."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "83671e8d-d5fd-37f3-9396-f075322f1afb",
                                        "entry_id": "1b8e371d-b86c-35a5-927a-4961b0b1a504",
                                        "glosses": [
                                            "in geringem Maße ausgebildet, wenig ausgeprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610fce11-5c6d-40a3-800f-53cc819bde34",
                                                "sense_id": "83671e8d-d5fd-37f3-9396-f075322f1afb",
                                                "text": "Martina hat eine leichte Erkältung."
                                            },
                                            {
                                                "example_id": "5a22e47c-d45f-4c84-9cab-42a0aed14e25",
                                                "sense_id": "83671e8d-d5fd-37f3-9396-f075322f1afb",
                                                "text": "Heute Nacht erwarten wir leichten Schneefall."
                                            },
                                            {
                                                "example_id": "bdadde0d-50ea-4677-9636-a38ed2f61461",
                                                "sense_id": "83671e8d-d5fd-37f3-9396-f075322f1afb",
                                                "text": "„Im Landkreis Rottal-Inn steht an einem leichten Osthang ein Bauernhof mit neun Hektar Grund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c5dcad06-cf09-3a3f-9758-2026a627366c",
                                        "entry_id": "1b8e371d-b86c-35a5-927a-4961b0b1a504",
                                        "glosses": [
                                            "wenig Kalorien besitzen, schnell zu verdauen"
                                        ],
                                        "tags": [
                                            "Nahrung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9bcea66-85e7-42a1-b32b-a21651208251",
                                                "sense_id": "c5dcad06-cf09-3a3f-9758-2026a627366c",
                                                "text": "„Fisch läge mir zu schwer im Magen, ich nehme lieber einen leichten Salat.“"
                                            },
                                            {
                                                "example_id": "36594369-8924-4286-8aac-1835beb401f4",
                                                "sense_id": "c5dcad06-cf09-3a3f-9758-2026a627366c",
                                                "text": "Vielleicht sollten wir jetzt einen leichten Imbiss zu uns nehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
