                        "former un tout"
                    ]
                },
                {
                    "sense_id": "c30a982f-d32a-3ac7-8537-34cc55fe8fc8",
                    "sense_definition": "Ce qui constitue l'élément essentiel ou le point le plus important d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "essentiel_nom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Commencer ce projet est facile, mais le <w>tout</w> est de le mener à terme."
                        },
                        {
                            "text": "Dans cette compétition difficile, le <w>tout</w> est de garder confiance en soi."
