{
    "word_family": [
        "fetcher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3290e5fd-0d8d-31d5-9cfd-04da42416f0d",
                    "sense_definition": "To go to a place, get something, and bring it back.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "retrieve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you <w>fetch</w> me a glass of water from the kitchen?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>принести</w> мне стакан воды из кухни?",
                                "zh": "你能从厨房帮我<w>拿</w>一杯水吗？"
                            }
                        },
                        {
                            "text": "The dog loves to <w>fetch</w> the ball when I throw it.",
                            "target_lang_translations": {
                                "ru": "Собака любит <w>приносить</w> мяч, когда я его бросаю.",
                                "zh": "我扔球时，那只狗很喜欢把它<w>衔</w>回来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "collect"
                    ],
                    "common_phrases": [
                        "fetch water",
                        "fetch help"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сходить куда-либо, взять что-либо и принести обратно.",
                        "zh": "去某处取回某物并带回来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принести",
                                "target_lang_sense_clarification": "совершить действие по доставке предмета"
                            },
                            {
                                "target_lang_word": "сходить за",
                                "target_lang_sense_clarification": "отправиться куда-то, чтобы забрать и принести что-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拿",
                                "target_lang_sense_clarification": "取来某物"
                            },
                            {
                                "target_lang_word": "取",
                                "target_lang_sense_clarification": "去拿回某物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63345489-3e99-3d86-84f8-4c8da084fc82",
                    "sense_definition": "To be sold for a specific price.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique chair should <w>fetch</w> a high price at the auction.",
                            "target_lang_translations": {
                                "ru": "Этот антикварный стул должен <w>выручить</w> высокую цену на аукционе.",
                                "zh": "这把古董椅在拍卖会上应该能<w>卖得</w>高价。"
                            }
                        },
                        {
                            "text": "Rare coins often <w>fetch</w> thousands of dollars from collectors.",
                            "target_lang_translations": {
                                "ru": "Редкие монеты часто <w>выручают</w> тысячи долларов от коллекционеров.",
                                "zh": "稀有硬币常能从收藏家那里<w>换取</w>数千美元。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fetch a price"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть проданным за определенную сумму денег.",
                        "zh": "指商品在销售中达到特定的价格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выручить",
                                "target_lang_sense_clarification": "получить деньги в результате продажи"
                            },
                            {
                                "target_lang_word": "стоить",
                                "target_lang_sense_clarification": "иметь определенную рыночную цену"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卖得",
                                "target_lang_sense_clarification": "以某种价格售出"
                            },
                            {
                                "target_lang_word": "换取",
                                "target_lang_sense_clarification": "通过出售获得金钱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3a08a86-c81a-3946-bd5c-e98c0de0bf85",
                    "sense_definition": "To produce or emit a sound or breath, such as a sigh.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "produce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>fetched</w> a deep sigh after hearing the bad news.",
                            "target_lang_translations": {
                                "ru": "Она <w>испустила</w> глубокий вздох, услышав плохие новости.",
                                "zh": "听到坏消息后，她<w>发出</w>了一声长叹。"
                            }
                        },
                        {
                            "text": "He <w>fetched</w> a long breath before starting his speech.",
                            "target_lang_translations": {
                                "ru": "Он <w>сделал</w> глубокий вдох перед началом своей речи.",
                                "zh": "他在开始演讲前<w>深吸</w>了一口气。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fetch a sigh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издать звук или сделать вдох, например, вздох.",
                        "zh": "发出声音或进行呼吸动作，如叹气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испустить",
                                "target_lang_sense_clarification": "издать звук или выдохнуть (например, вздох)"
                            },
                            {
                                "target_lang_word": "сделать",
                                "target_lang_sense_clarification": "выполнить действие (например, вдох)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发出",
                                "target_lang_sense_clarification": "产生某种声音或气息"
                            },
                            {
                                "target_lang_word": "深吸",
                                "target_lang_sense_clarification": "进行深呼吸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3492886f-d565-3d07-a8dd-ae4627d73412",
                    "sense_definition": "To perform a specific action or movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete <w>fetched</w> a quick leap over the hurdle.",
                            "target_lang_translations": {
                                "ru": "Спортсмен <w>совершил</w> быстрый прыжок через барьер.",
                                "zh": "运动员<w>做</w>了一个快速跳跃越过了栏杆。"
                            }
                        },
                        {
                            "text": "I will <w>fetch</w> a turn around the park to clear my head.",
                            "target_lang_translations": {
                                "ru": "Я <w>сделаю</w> круг по парку, чтобы проветрить голову.",
                                "zh": "我打算去公园<w>转</w>一圈，好让头脑清醒一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fetch a turn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнить определенное действие или движение.",
                        "zh": "执行特定的动作或移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершить",
                                "target_lang_sense_clarification": "выполнить какое-либо действие или маневр"
                            },
                            {
                                "target_lang_word": "сделать",
                                "target_lang_sense_clarification": "выполнить простое движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "做",
                                "target_lang_sense_clarification": "执行某个动作"
                            },
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "开展某种活动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa2482cb-dae2-3f58-b54e-6cdc90de60f0",
                    "sense_definition": "A game where a person throws an object for a dog to retrieve.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We played <w>fetch</w> with the dog in the backyard.",
                            "target_lang_translations": {
                                "ru": "Мы играли с собакой в <w>апорт</w> на заднем дворе.",
                                "zh": "我们在后院和狗玩<w>衔取游戏</w>。"
                            }
                        },
                        {
                            "text": "The puppy is still learning how to play <w>fetch</w> properly.",
                            "target_lang_translations": {
                                "ru": "Щенок все еще учится правильно играть в <w>апорт</w>.",
                                "zh": "小狗还在学习如何正确地玩<w>衔取游戏</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play fetch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игра, в которой человек бросает предмет, чтобы собака его принесла.",
                        "zh": "一种人扔出物体让狗去衔回来的游戏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "апорт",
                                "target_lang_sense_clarification": "команда или название игры с приносом предмета"
                            },
                            {
                                "target_lang_word": "игра в принеси",
                                "target_lang_sense_clarification": "описательное название игры с собакой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衔取游戏",
                                "target_lang_sense_clarification": "训练狗取回物品的游戏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f5ecff9-1242-3b0d-b3d9-ecbee1908680",
                    "sense_definition": "A clever trick or deceptive strategy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "trick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His excuse was just another <w>fetch</w> to avoid doing the work.",
                            "target_lang_translations": {
                                "ru": "Его оправдание было лишь очередной <w>уловкой</w>, чтобы не делать работу.",
                                "zh": "他的借口不过是逃避工作的又一个<w>诡计</w>。"
                            }
                        },
                        {
                            "text": "She saw through his little <w>fetch</w> immediately.",
                            "target_lang_translations": {
                                "ru": "Она сразу раскусила его маленькую <w>уловку</w>.",
                                "zh": "她一眼就看穿了他的小<w>花招</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contrivance",
                        "dodge"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хитрый трюк или обманная стратегия.",
                        "zh": "一种巧妙的诡计或欺骗策略。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрый прием для достижения цели"
                            },
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "обманный маневр"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诡计",
                                "target_lang_sense_clarification": "狡猾的手段"
                            },
                            {
                                "target_lang_word": "花招",
                                "target_lang_sense_clarification": "欺骗性的手段"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}