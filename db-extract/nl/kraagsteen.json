                                                "sense_id": "f9dd86e6-c6a5-3962-ab42-50a31e8280e3",
                                                "text": "Es stand eine teure Vase auf der Konsole."
                                            },
                                            {
                                                "example_id": "320cb5d1-c4c9-48f9-8057-9812b98dd0aa",
                                                "sense_id": "f9dd86e6-c6a5-3962-ab42-50a31e8280e3",
                                                "text": "„Feuerrot sprach sie von ihren schönen Handschuhen, die sie auf der Konsole zerknüllte.“"
                                            },
                                            {
                                                "example_id": "6e910559-6d09-4cb4-b0f6-ff350f5e952c",
                                                "sense_id": "f9dd86e6-c6a5-3962-ab42-50a31e8280e3",
                                                "text": "„Ein Abendessen aus Schinken, Kartoffeln und Whisky war auf einer der reichvergoldeten Konsolen vorbereitet worden.“"
                                            },
                                            {
                                                "example_id": "7e91b4ac-e347-4ebb-a057-5d320c162ca8",
                                                "sense_id": "f9dd86e6-c6a5-3962-ab42-50a31e8280e3",
                                                "text": "„Ein hoher Spiegel in goldenem Zierrahmen stand auf einer niedrigen Konsole schräg nach vorn geneigt; daneben erhob sich auf einem gedrechselten Holzständer ein Strauß künstlicher Blumen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
