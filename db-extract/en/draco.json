                    {
                        "translation_id": "d1f31b3d-c7e6-403d-b8f7-0938e5ba207f",
                        "source_entry_id": "017a7f9c-2879-3fb7-83aa-9a5b3a1e1fb7",
                        "source_sense_description": "constellation",
                        "target_lang_word": "Drache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "307fc66f-6a95-3f5f-aae5-30be0b055250",
                                        "entry_id": "ef66f3ee-33a6-3017-816a-d76b70b23511",
                                        "glosses": [
                                            "großes Mischwesen, meist geflügelt, feuerspeiend und mit großen Klauen, das einer Schlange oder Echse ähnelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6efefa25-e8ab-4b77-872e-2ec3b79ea46f",
                                                "sense_id": "307fc66f-6a95-3f5f-aae5-30be0b055250",
                                                "text": "Siegfried kämpfte in der Nibelungensage gegen den Drachen."
                                            },
                                            {
                                                "example_id": "67245b89-8362-4256-bfb1-2135ef405bf0",
                                                "sense_id": "307fc66f-6a95-3f5f-aae5-30be0b055250",
                                                "text": "„Der Hofmarschall Hoang trug ein tiefrotes Gewand, mit Drachen bestickt und mit mehrfarbigem Doppelkragen.“"
                                            },
                                            {
                                                "example_id": "4e4b0cf5-79a1-40b6-8d08-79df23437a8a",
                                                "sense_id": "307fc66f-6a95-3f5f-aae5-30be0b055250",
                                                "text": "„Man zeigte uns Stücke von einem Drachen; das beweise, wie der Besitzer mir sagte, daß der Drache kein Fabelwesen sei.“"
                                            },
                                            {
                                                "example_id": "c05d08f2-6721-4f53-beb8-19debfdb2998",
                                                "sense_id": "307fc66f-6a95-3f5f-aae5-30be0b055250",
                                                "text": "„Dort sitzt in ihrer Kemenate eine blauäugige Frau mit goldschimmernder Gesichtsfarbe und stickt in eine Borte die uralte Saga von Sigurd aus dem Geschlecht der Völsungen, der den Drachen Fafnir bezwang und das Gold eroberte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d52a4cf-7658-3cf1-8132-144697deef1f",
                                        "entry_id": "ef66f3ee-33a6-3017-816a-d76b70b23511",
                                        "glosses": [
                                            "ein Sternbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f93e3e-f72e-4a8e-8173-f4494d23fa94",
                                                "sense_id": "5d52a4cf-7658-3cf1-8132-144697deef1f",
                                                "text": "Der Stern Thuban im Drachen heißt wörtlich übersetzt „Schlange“."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ad1cdd12-64ca-372d-9364-7633621b3a1d",
                                        "entry_id": "ef66f3ee-33a6-3017-816a-d76b70b23511",
                                        "glosses": [
                                            "bösartige Frau (oftmals Ehefrau oder Schwiegermutter)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5effa8c1-589e-4cf6-ac51-1f59a1171fe5",
                                                "sense_id": "ad1cdd12-64ca-372d-9364-7633621b3a1d",
                                                "text": "Mir graut vor dem alten Drachen zu Hause."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
