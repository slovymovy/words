                "senses": [
                    {
                        "sense_id": "d49938bb-bfd8-37c7-afad-58a56dd70562",
                        "entry_id": "9a45a92e-2ee3-302a-b50c-da8500164d5f",
                        "glosses": [
                            "Kletterpflanze, die häufig zur Fassadenbegrünung eingesetzt wird"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "3a4722be-e935-46dd-b1eb-32051c20b786",
                                "sense_id": "d49938bb-bfd8-37c7-afad-58a56dd70562",
                                "text": "„Gleichsam einem neolithischen Penisfutteral, schmiegt sich der Veitschi um sein Gebäude, um es zu schützen, zu kühlen und zu wärmen.“"
                            },
                            {
                                "example_id": "8ec25b6a-7716-4ce7-b681-c40f61ec27bd",
                                "sense_id": "d49938bb-bfd8-37c7-afad-58a56dd70562",
                                "text": "„Auf der Wieden erregt eine Schlingpflanze auf einer Feuermauer die Gemüter: Der Eigentümer der Mauer klagt, weil die Besitzer des Veitschi die Pflanze nicht am Wachsen hindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
