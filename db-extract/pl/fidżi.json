                                                "sense_id": "3c83e7e6-85c2-35ba-be93-9976dd7be71a",
                                                "text": "Wie heißt das auf Fidschi?"
                                            },
                                            {
                                                "example_id": "0b64edd0-3fc0-4974-8f7a-352964e45c38",
                                                "sense_id": "3c83e7e6-85c2-35ba-be93-9976dd7be71a",
