                                        "entry_id": "84172f07-c7d8-3c11-8698-53095a05b6bb",
                                        "glosses": [
                                            "One who carries on a movement or organization from someone else."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "854b4fe0-7fcd-42f9-b2b5-0fa1b089d0c0",
                                                "sense_id": "298632d5-2fed-386e-8308-69d9ba35e5c2",
                                                "text": "The Roman Empire could be considered the torchbearer of Ancient Greek knowledge and wisdom."
                                            }
