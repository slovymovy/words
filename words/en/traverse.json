{
    "word_family": [
        "traversal",
        "traversable",
        "traversement",
        "transverse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1a11feb-0ff7-3ecc-9be6-46ea90c24971",
                    "sense_definition": "To travel, journey, or pass across or through an area, especially one that is large or difficult.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers had to <w>traverse</w> the difficult desert on foot.",
                            "target_lang_translations": {
                                "ru": "Исследователям пришлось пешком <w>пересечь</w> труднопроходимую пустыню."
                            }
                        },
                        {
                            "text": "A scenic railway route <w>traverses</w> the high mountain passes.",
                            "target_lang_translations": {
                                "ru": "Живописный железнодорожный маршрут <w>пересекает</w> высокие горные перевалы."
                            }
                        }
                    ],
                    "synonyms": [
                        "cross"
                    ],
                    "common_phrases": [
                        "traverse the terrain",
                        "traverse the globe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пересекать, проходить или преодолевать какое-либо пространство или территорию, особенно обширную или труднопроходимую."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересекать",
                                "target_lang_sense_clarification": "пространство, местность"
                            },
                            {
                                "target_lang_word": "преодолевать",
                                "target_lang_sense_clarification": "сложный маршрут, препятствия"
                            },
                            {
                                "target_lang_word": "переходить",
                                "target_lang_sense_clarification": "пешком через территорию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef8e61a9-3b80-39b0-847a-a84a79f16c2e",
                    "sense_definition": "To systematically move through or examine all parts of a structure or dataset.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The algorithm was designed to <w>traverse</w> the tree data structure efficiently.",
                            "target_lang_translations": {
                                "ru": "Алгоритм был разработан для эффективного <w>обхода</w> древовидной структуры данных."
                            }
                        },
                        {
                            "text": "We need to <w>traverse</w> the entire directory to find missing files.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>обойти</w> весь каталог, чтобы найти недостающие файлы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "traverse a graph",
                        "traverse the tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Систематически обходить или исследовать все элементы структуры данных или каталога."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обходить",
                                "target_lang_sense_clarification": "дерево, граф, структуру данных"
                            },
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "по структуре или каталогу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81210d53-d920-3f66-ba01-aadec17b8955",
                    "sense_definition": "To climb or descend across a steep slope laterally rather than moving straight up or down.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skiers chose to <w>traverse</w> the slope to maintain safe control.",
                            "target_lang_translations": {
                                "ru": "Лыжники предпочли <w>траверсировать</w> склон, чтобы сохранять надежный контроль."
                            }
                        },
                        {
                            "text": "To avoid the cliffs, the hikers had to <w>traverse</w> along the ridge.",
                            "target_lang_translations": {
                                "ru": "Чтобы обойти скалы, туристам пришлось <w>идти траверсом</w> вдоль хребта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "traverse the slope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться поперек крутого склона вбок, траверсировать, не поднимаясь и не спускаясь прямо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "траверсировать",
                                "target_lang_sense_clarification": "склон в альпинизме или лыжах"
                            },
                            {
                                "target_lang_word": "идти траверсом",
                                "target_lang_sense_clarification": "поперек склона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "213bedd4-4922-3966-b735-7061d492b2b6",
                    "sense_definition": "To turn or rotate a gun, camera, or similar device horizontally around an axis.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew carefully <w>traversed</w> the turret to aim at the approaching target.",
                            "target_lang_translations": {
                                "ru": "Экипаж аккуратно <w>повернул</w> башню, чтобы прицелиться в приближающуюся цель."
                            }
                        },
                        {
                            "text": "He learned how to <w>traverse</w> the heavy artillery piece during training.",
                            "target_lang_translations": {
                                "ru": "Во время учений он научился <w>наводить по горизонтали</w> тяжелое артиллерийское орудие."
                            }
                        }
                    ],
                    "synonyms": [
                        "swivel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поворачивать орудие, башню или камеру в горизонтальной плоскости вокруг оси."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поворачивать",
                                "target_lang_sense_clarification": "орудие или башню по горизонтали"
                            },
                            {
                                "target_lang_word": "наводить по горизонтали",
                                "target_lang_sense_clarification": "огнестрельное оружие или прибор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb8fa76b-2c03-381a-b0b0-1e9e363995b9",
                    "sense_definition": "To thwart, obstruct, or act in opposition to plans or intentions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unforeseen political rivals sought to <w>traverse</w> his ambitious reforms.",
                            "target_lang_translations": {
                                "ru": "Неожиданные политические соперники стремились <w>воспрепятствовать</w> его амбициозным реформам."
                            }
                        },
                        {
                            "text": "She managed to overcome every obstacle that threatened to <w>traverse</w> her plans.",
                            "target_lang_translations": {
                                "ru": "Ей удалось преодолеть все препятствия, угрожавшие <w>нарушить</w> ее планы."
                            }
                        }
                    ],
                    "synonyms": [
                        "thwart",
                        "obstruct"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in formal or literary contexts to mean obstruct or oppose"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Препятствовать, мешать или противодействовать планам или намерениям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "планам, намерениям"
                            },
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "осуществлению чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88edff80-6a2e-3007-9d66-5b3ec0ed6403",
                    "sense_definition": "To make a formal legal denial of an allegation made by the opposing party in a lawsuit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney prepared to <w>traverse</w> the material allegations of the plaintiff.",
                            "target_lang_translations": {
                                "ru": "Адвокат подготовился к тому, чтобы <w>опровергнуть</w> существенные утверждения истца."
                            }
                        },
                        {
                            "text": "Instead of admitting fault, they decided to <w>traverse</w> the entire claim.",
                            "target_lang_translations": {
                                "ru": "Вместо признания вины они решили полностью <w>отклонить</w> иск, оспорив факты."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально опровергать или отрицать факты или утверждения противоположной стороны в суде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опровергать",
                                "target_lang_sense_clarification": "утверждения истца в суде"
                            },
                            {
                                "target_lang_word": "отрицать",
                                "target_lang_sense_clarification": "факты иска"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a2a1e1b-72ed-304a-a5ef-d58e1bd05c67",
                    "sense_definition": "A route or movement across a slope, face, or mountain range, especially in climbing or skiing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountaineers planned a difficult <w>traverse</w> across the icy summit.",
                            "target_lang_translations": {
                                "ru": "Альпинисты запланировали сложный <w>траверс</w> через ледяную вершину."
                            }
                        },
                        {
                            "text": "Completing the <w>traverse</w> of the ridge took nearly three days.",
                            "target_lang_translations": {
                                "ru": "Завершение <w>траверса</w> хребта заняло почти три дня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mountain traverse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маршрут или движение поперек склона, стены или горного хребта в альпинизме и лыжном спорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "траверс",
                                "target_lang_sense_clarification": "боковое движение или прохождение хребта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71f267a8-896f-3741-baa1-5944d9fef686",
                    "sense_definition": "A series of established survey lines connected by measured distances and angles, used to map an area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surveying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surveyor plotted a closed <w>traverse</w> to accurately map the boundary lines.",
                            "target_lang_translations": {
                                "ru": "Геодезист проложил замкнутый <w>полигонометрический ход</w>, чтобы точно нанести границы на карту."
                            }
                        },
                        {
                            "text": "Any slight angle error in the <w>traverse</w> can affect the entire map.",
                            "target_lang_translations": {
                                "ru": "Любая незначительная угловая погрешность в <w>теодолитном ходе</w> может повлиять на всю карту."
                            }
                        }
                    ],
                    "common_phrases": [
                        "closed traverse"
                    ],
                    "target_lang_definitions": {
                        "ru": "В геодезии: полигонометрический или теодолитный ход, последовательность соединенных линий между опорными точками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полигонометрический ход",
                                "target_lang_sense_clarification": "в геодезии"
                            },
                            {
                                "target_lang_word": "теодолитный ход",
                                "target_lang_sense_clarification": "в геодезической съемке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e6c5dac-5625-3981-bd4a-8ff425593a00",
                    "sense_definition": "A defensive barrier or trench section built perpendicular to the main trench line to prevent enfilade fire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soldiers sheltered behind the thick earth <w>traverse</w> during the bombardment.",
                            "target_lang_translations": {
                                "ru": "Солдаты укрылись за толстым земляным <w>траверсом</w> во время бомбардировки."
                            }
                        },
                        {
                            "text": "The zigzag pattern of trenches was broken by an occasional <w>traverse</w>.",
                            "target_lang_translations": {
                                "ru": "Зигзагообразная линия траншей местами прерывалась <w>траверсами</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поперечный вал или насыпь в окопе для защиты от продольного огня противника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "траверс",
                                "target_lang_sense_clarification": "фортификационное защитное сооружение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0995da6c-9776-3493-9488-2fe19289724c",
                    "sense_definition": "A formal denial of a factual allegation asserted by the opposing party in legal pleadings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant filed a formal <w>traverse</w> to dispute the claim entirely.",
                            "target_lang_translations": {
                                "ru": "Ответчик подал официальное <w>возражение по фактам</w>, чтобы полностью оспорить иск."
                            }
                        },
                        {
                            "text": "In his pleading, he entered a <w>traverse</w> against the primary factual assertion.",
                            "target_lang_translations": {
                                "ru": "В своем заявлении он заявил <w>отрицание</w> ключевого фактического утверждения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное отрицание факта или утверждения в судебном состязании бумаг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опровержение фактов",
                                "target_lang_sense_clarification": "в процессуальном праве"
                            },
                            {
                                "target_lang_word": "отрицание иска",
                                "target_lang_sense_clarification": "юридическое возражение по существу фактов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "892d1c50-60f5-3d0b-953c-536f3d360315",
                    "sense_definition": "Extending, lying, or passing across something; transverse.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The structure was reinforced using heavy <w>traverse</w> beams.",
                            "target_lang_translations": {
                                "ru": "Конструкция была усилена тяжелыми <w>поперечными</w> балками."
                            }
                        },
                        {
                            "text": "Workers cleared the <w>traverse</w> trenches along the perimeter.",
                            "target_lang_translations": {
                                "ru": "Рабочие расчистили <w>поперечные</w> траншеи по периметру."
                            }
                        }
                    ],
                    "synonyms": [
                        "transverse",
                        "crosswise"
                    ],
                    "common_phrases": [
                        "traverse beam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный поперек, идущий в поперечном направлении; поперечный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поперечный",
                                "target_lang_sense_clarification": "расположенный поперек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "30a987f6-810f-38d9-ba78-ad7425899503",
                    "sense_definition": "In a crosswise direction; across.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The logs were stacked <w>traverse</w> across the forest path.",
                            "target_lang_translations": {
                                "ru": "Бревна были сложены <w>поперек</w> лесной тропы."
                            }
                        },
                        {
                            "text": "She placed the wooden planks <w>traverse</w> to bridge the ditch.",
                            "target_lang_translations": {
                                "ru": "Она положила деревянные доски <w>поперек</w>, чтобы перекинуть мостик через канаву."
                            }
                        }
                    ],
                    "synonyms": [
                        "athwart",
                        "crosswise"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used archaically in the sense of crosswise or athwart"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поперек, в поперечном направлении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поперек",
                                "target_lang_sense_clarification": "в поперечном направлении"
                            },
                            {
                                "target_lang_word": "наискосок",
                                "target_lang_sense_clarification": "под углом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ef6d0104-89ea-3cd0-9fd8-61d259c88b99",
                    "sense_definition": "A surname of French origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Ms. <w>Traverse</w> joined the committee as an external advisor.",
                            "target_lang_translations": {
                                "ru": "Г-жа <w>Траверс</w> вошла в состав комитета в качестве внешнего консультанта."
                            }
                        },
                        {
                            "text": "The historic documents were signed by a local landowner named <w>Traverse</w>.",
                            "target_lang_translations": {
                                "ru": "Исторические документы были подписаны местным землевладельцем по фамилии <w>Траверс</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "From French"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия французского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Траверс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}