                    },
                    {
                        "translation_id": "aa3be51b-bd5b-4bee-905d-d568acd7d66a",
                        "source_entry_id": "2768e42a-5032-35f6-aaaf-9c608aa1ad88",
                        "source_sense_id": "44918384-394e-37c3-90cb-d2ae05c8029f",
                        "source_sense_description": "ironisch: „schlechtes“ oder „barbarisches“ Latein",
                        "target_lang_word": "latin de cuisine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latin de cuisine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5eea3e2-149a-35e5-b43d-ba88aa58c953",
                                        "entry_id": "fff39cb1-6b06-3cda-84b3-5ac17c62008c",
                                        "glosses": [
                                            "Imitation du latin, qui n’a souvent avec le vrai latin que quelques assonances, à but humoristique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bfbd5fb-8365-4d60-80ff-3c298b04713f",
                                                "sense_id": "f5eea3e2-149a-35e5-b43d-ba88aa58c953",
                                                "text": "« Cartum grisem ! » ^([1]) est un exemple de latin de cuisine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88027e4f-2616-3f94-9998-65014ed80849",
                                        "entry_id": "fff39cb1-6b06-3cda-84b3-5ac17c62008c",
                                        "glosses": [
                                            "Mauvais latin ^([2])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c1c5ea-cb27-4aca-81e9-e291cc47b0c6",
                                                "sense_id": "88027e4f-2616-3f94-9998-65014ed80849",
                                                "text": "En fait, son latin n’était que du « latin de chien » — expression équivalente en Angleterre à celle de « latin de cuisine » — et sa science historique se bornait à ce qu’il lisait dans le Livre d’Or de la race chevaline."
                                            },
                                            {
                                                "example_id": "98c72d38-e62a-43ff-bb71-5c575f0b1c34",
                                                "sense_id": "88027e4f-2616-3f94-9998-65014ed80849",
                                                "text": "— Quel latin de cuisine ! dit-il à mi-voix. Il me semble qu’à la place des bons moines, j’aurais trouvé mieux, tout en obtenant le même résultat."
                                            },
                                            {
                                                "example_id": "0a07aae8-02db-45bf-83f0-e83d0a529333",
                                                "sense_id": "88027e4f-2616-3f94-9998-65014ed80849",
                                                "text": "Elle exhibait alors en rosissant de fierté ma dernière catilinaire : « Rigardez, monsieur le curé, mon pitit-fils, il écrit le latin. » Mon latin de cuisine décernait à Anna je ne sais quel brevet de vieille francité, marquait d’éclatante façon que les diastases de l’assimilation étaient à l’œuvre, nimbait le chef de ma terrible grand-mère d’une auréole de conformité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ed19a18-e2cb-3fb6-a651-a0e2371e89f2",
                                        "entry_id": "fff39cb1-6b06-3cda-84b3-5ac17c62008c",
                                        "glosses": [
                                            "Latin plus ou moins authentique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
