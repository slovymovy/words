                "senses": [
                    {
                        "sense_id": "14669f11-e882-3a1b-b284-586c27a8c95b",
                        "entry_id": "7523e5c6-ddad-38a6-90d6-803f1c95ce98",
                        "glosses": [
                            "Rede, die bei einer Beerdigung gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c2e06b-b47b-404e-ba46-1935ee08cb4a",
                                "sense_id": "14669f11-e882-3a1b-b284-586c27a8c95b",
                                "text": "„Wir haben es schon gesagt, dass er in der Trauerrede für seine Tante ihre gemeinsame Herkunft rühmte.“"
                            },
                            {
                                "example_id": "e4ec8811-ed2d-440a-a2db-3e15250e215e",
                                "sense_id": "14669f11-e882-3a1b-b284-586c27a8c95b",
                                "text": "„Er fragte mich, ob ich die Trauerrede lesen wolle, die er für die Trauerfeier entworfen habe.“"
                            },
                            {
                                "example_id": "f46255f4-4c68-4ebf-b7b9-eb376c7c06ad",
                                "sense_id": "14669f11-e882-3a1b-b284-586c27a8c95b",
                                "text": "„Es gab kaum jemanden, der die Trauerrede von Meghan McCain für ihren verstorbenen Vater nicht als Abrechnung mit Donald Trump empfand.“"
                            },
                            {
                                "example_id": "1e222f63-d278-485d-b714-753b8c3b0bb3",
                                "sense_id": "14669f11-e882-3a1b-b284-586c27a8c95b",
                                "text": "„Eine zweite Frau, Toni Morrison, rief in einer Trauerrede in Princeton ein anderes Amerika auf als jenes, das Präsident Bush beschwor, als er die Amerikaner aufforderte, nach Disneyland zu fahren: ‚Ich möchte, wenn ich den Mut aufbringe, direkt zu den Toten sprechen‘, sagte sie.“"
                            },
                            {
                                "example_id": "91ee0212-1146-445d-b774-1610e685bd9e",
                                "sense_id": "14669f11-e882-3a1b-b284-586c27a8c95b",
                                "text": "„Bundesinnenminister Otto Schily würdigte am Dienstag in seiner Trauerrede die zum Schutz der deutschen Botschaft in Bagdad abgestellten GSG-9-Männer als außergewöhnlich pflichtbewußt und charakterstark.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17ff5b5a-d539-4932-b460-9dd471653c3c",
                        "source_entry_id": "7523e5c6-ddad-38a6-90d6-803f1c95ce98",
