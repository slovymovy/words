                "senses": [
                    {
                        "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                        "entry_id": "2771a6de-a3cc-3adf-a678-ba68eebbecc2",
                        "glosses": [
                            "(in Rückschlagspielen) abwechselndes Spielen des Balls (von zwei Gegnern)"
                        ],
                        "tags": [
                            "Tennis",
                            "Tischtennis",
                            "Badminton",
                            "Squash",
                            "Volleyball"
                        ],
                        "examples": [
                            {
                                "example_id": "b93b79cb-f465-49a7-947e-6eed111c45c8",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "„Ein Ballwechsel ist beendet, sobald einem Spieler ein Fehler unterläuft.“"
                            },
                            {
                                "example_id": "67cb14bb-318f-4561-8863-be53154b1d14",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "„Nach minutenlanger Diskussion wurde der Ballwechsel wiederholt.“"
                            },
                            {
                                "example_id": "3da90b53-4b37-435e-9bdc-6de22bd14a3a",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "[Tischtennis:] „Jorgic diktierte die Ballwechsel, Qiu versuchte dagegenzuhalten. Die Folge waren teils spektakuläre Ballwechsel.“"
                            },
                            {
                                "example_id": "3253a20b-d0ad-4ac1-a1f6-c25e0d3f86e5",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "[Tischtennis:] „Durch die Vergrößerung des Balles“ [Anm.: auf 40 mm] „wurde die maximale Rotation verringert, womit man längere Ballwechsel und eine höhere Attraktivität des Sport erreichen wollte.“"
                            },
                            {
                                "example_id": "3a911b61-fcc6-4a66-a6e1-5c5c2472c256",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "[Volleyball:] „Jeder Ballwechsel ist ein Sprint mit mehrfachen Richtungswechseln, um am Ende die Schläge der gegnerischen Angreifer abzublocken.“"
                            },
                            {
                                "example_id": "890dc9c9-363f-427e-8f8e-c6724e7c8b38",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "[Squash:] […] „bei Spielen mit Anfängern hingegen gelingen mit langsamen Bällen kaum Ballwechsel.“"
                            },
                            {
                                "example_id": "892a6250-f488-4a93-b57f-a56e6707de1d",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "[Squash:] „Er liebt die rasanten Ballwechsel, die präzisen Schläge und die ausgefeilte Lauftechnik auf engstem Raum.“"
                            },
                            {
                                "example_id": "3fe146b2-1432-4b55-b623-ee69b3a4df4d",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "„»Tennis ist zwar sehr anstrengend und körperlich belastend. Aber 70 Prozent der Ballwechsel sind nach vier Schlägen vorbei«, sagt Grambow.“"
                            },
                            {
                                "example_id": "8866e3ba-a274-42db-95a7-b4cab0b65594",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "[Tennis:] „Siegemund fehlen bei einer Vorhand im folgenden Ballwechsel an die Grundlinie nur Millimeter, doch der Schlag ist daneben.“"
                            },
                            {
                                "example_id": "207322c2-2bb0-4aff-bd46-f807962f1cb8",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "[Tennis:] „Überhaupt wirkte Alcaraz von Ballwechsel zu Ballwechsel selbstbewusster, sein Hamburger Gegner dagegen skeptischer.“"
                            },
                            {
                                "example_id": "d03734a7-322b-4543-8277-9611ef7208dc",
                                "sense_id": "6b185bb4-9864-3ebd-a2f3-417d61214c46",
                                "text": "[Tennis:] „Einen Tweener sieht man nicht alle Tage. Gleich zwei Schläge zwischen den Beinen hindurch mit dem Rücken zum Netz in einem Ballwechsel schon gar nicht. Dieses Kunststück schaffte Kyrgios nun an der Seite von Daria Gavrilova im Mixed-Doppel gegen das tschechische Paar Lucie Hradecka/Adam Pavlasek.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
