                ],
                "senses": [
                    {
                        "sense_id": "b3ab090d-02bc-360d-a06a-d70125621831",
                        "entry_id": "c983de56-da53-3d05-b6b1-e2e2d5cb15f9",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0803ca61-3e3c-4abc-b29a-8c1978c10b7a",
                                "sense_id": "b3ab090d-02bc-360d-a06a-d70125621831",
                                "text": "Frau Kneissle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5d893da3-2300-4e3c-aa04-39331fa26a9c",
                                "sense_id": "b3ab090d-02bc-360d-a06a-d70125621831",
                                "text": "Herr Kneissle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4f817af3-4654-4957-9911-d3c59d4dbea7",
                                "sense_id": "b3ab090d-02bc-360d-a06a-d70125621831",
                                "text": "Die Kneissles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "46ba3d2e-27c2-4e7b-a4ce-ed2fa25c1e62",
                                "sense_id": "b3ab090d-02bc-360d-a06a-d70125621831",
                                "text": "Der Kneissle trägt nie die Schals, die die Kneissle ihm strickt."
                            },
                            {
                                "example_id": "b1d7f12c-0529-4934-a2e3-60c3798d54b1",
                                "sense_id": "b3ab090d-02bc-360d-a06a-d70125621831",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kneissle kommt, geht der Herr Kneissle.“"
                            },
                            {
                                "example_id": "95cd1c05-5597-4b05-9519-a7ecfaa61733",
                                "sense_id": "b3ab090d-02bc-360d-a06a-d70125621831",
                                "text": "Kneissle kommt und geht."
                            },
                            {
                                "example_id": "f3e7754b-6788-4320-95ed-2aaa341a43c3",
                                "sense_id": "b3ab090d-02bc-360d-a06a-d70125621831",
                                "text": "Kneissles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
