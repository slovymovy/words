{
    "word_family": [
        "surface",
        "surfacing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f05d3ea8-90bf-3b8c-9899-d71cf39e65ae",
                    "sense_definition": "Having a specific type of outer layer or covering applied to it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surface_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newly <w>surfaced</w> tennis court has a smooth rubber covering.",
                            "target_lang_translations": {
                                "ru": "У теннисного корта, недавно <w>покрытого</w> резиной, гладкая ровная поверхность."
                            }
                        },
                        {
                            "text": "They walked along the <w>surfaced</w> path that led directly to the park entrance.",
                            "target_lang_translations": {
                                "ru": "Они шли по <w>асфальтированной</w> дорожке, которая вела прямо к входу в парк."
                            }
                        }
                    ],
                    "synonyms": [
                        "paved",
                        "covered"
                    ],
                    "antonyms": [
                        "unsurfaced"
                    ],
                    "common_phrases": [
                        "surfaced road",
                        "surfaced path"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий определенный тип внешнего покрытия или слоя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "асфальтированный",
                                "target_lang_sense_clarification": "о дорогах или путях с твердым покрытием"
                            },
                            {
                                "target_lang_word": "покрытый",
                                "target_lang_sense_clarification": "имеющий какое-либо покрытие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f35b71b-9a15-3695-a47d-a0a7d2648226",
                    "sense_definition": "Simple past and past participle of <w>surface</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The submarine <w>surfaced</w> slowly after completing its underwater mission.",
                            "target_lang_translations": {
                                "ru": "Подводная лодка медленно <w>всплыла</w> после завершения своей подводной миссии."
                            }
                        },
                        {
                            "text": "New evidence <w>surfaced</w> during the investigation that changed the entire case.",
                            "target_lang_translations": {
                                "ru": "В ходе расследования <w>обнаружились</w> новые доказательства, которые изменили всё дело."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is the past tense and past participle form of the verb surface."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени глагола surface (всплывать, обнаруживаться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всплыл",
                                "target_lang_sense_clarification": "о поднятии на поверхность воды"
                            },
                            {
                                "target_lang_word": "обнаружился",
                                "target_lang_sense_clarification": "о фактах или информации, ставших известными"
                            }
                        ]
                    }
                }
            ]
        }
    ]
