                },
                {
                    "sense_id": "8a68a99c-2268-3c00-9482-43b3d1f612fe",
                    "sense_definition": "A trading post located in a remote area, historically used for commerce.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trading_post",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fur traders brought their goods to the <w>fort</w> to sell them to the company.",
                            "target_lang_translations": {
                                "ru": "Торговцы пушниной привозили свои товары в <w>форт</w>, чтобы продать их компании.",
                                "zh": "皮毛商人们把货物运到<w>贸易站</w>卖给公司。"
                            }
                        },
                        {
                            "text": "The expedition stopped at the <w>fort</w> to resupply before heading west.",
                            "target_lang_translations": {
                                "ru": "Экспедиция остановилась в <w>форте</w> для пополнения запасов перед отправкой на запад.",
                                "zh": "探险队在向西进发前在<w>商站</w>停下来补充物资。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to historical trading contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Торговый пост в отдаленном районе, исторически использовавшийся для коммерции.",
                        "zh": "历史上位于偏远地区用于商业贸易的据点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фактория",
                                "target_lang_sense_clarification": "торговый пост"
                            },
                            {
                                "target_lang_word": "форт",
                                "target_lang_sense_clarification": "укрепленное поселение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贸易站",
                                "target_lang_sense_clarification": "商业据点"
                            },
                            {
                                "target_lang_word": "商站",
                                "target_lang_sense_clarification": "历史上的贸易据点"
                            }
                        ]
                    }
