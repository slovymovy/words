                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perfektionismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "218ff630-ed55-3b22-924e-428f8fbfbfa6",
                                        "entry_id": "2a3067ad-072c-3345-88c1-0b4498e1f5dd",
                                        "glosses": [
                                            "übertriebenes Streben nach Vollkommenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9770a26d-ab3a-4dcd-af15-746e2471f35d",
                                                "sense_id": "218ff630-ed55-3b22-924e-428f8fbfbfa6",
                                                "text": "Die Beziehung zu ihr scheiterte, weil er mit ihrem Hang zum Perfektionismus nicht klarkam."
                                            },
                                            {
                                                "example_id": "689dad9e-e879-4086-9aba-7bdc44dd8934",
                                                "sense_id": "218ff630-ed55-3b22-924e-428f8fbfbfa6",
                                                "text": "„Als Allzweckwaffe im ewigen Kampf für Perfektionismus und gegen Fussel kommt da der Fusselentferner ins Spiel.“"
                                            },
                                            {
                                                "example_id": "9e6d4680-e345-4ade-9c2c-3c11f3a2ef3a",
                                                "sense_id": "218ff630-ed55-3b22-924e-428f8fbfbfa6",
                                                "text": "„Weiterhin zeichnet solche Personen ein hoher Grad an Verantwortungslosigkeit, Angst, Schuldgefühlen, Perfektionismus und Narzissmus aus.“"
                                            },
                                            {
                                                "example_id": "ea7e382b-046a-493c-b9d9-436c903d9cbe",
                                                "sense_id": "218ff630-ed55-3b22-924e-428f8fbfbfa6",
                                                "text": "„Eines jedoch hat er vollbracht, nämlich mich von den Fesseln des Perfektionismus zu befreien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "999b0a43-bcd3-39db-aefc-f6f8027d64fb",
                                        "entry_id": "2a3067ad-072c-3345-88c1-0b4498e1f5dd",
                                        "glosses": [
