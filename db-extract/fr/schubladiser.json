                "senses": [
                    {
                        "sense_id": "44dd1b47-813b-3e73-9446-69a3e55ffdf8",
                        "entry_id": "f346f716-e91e-359b-a44f-0c541e6a477e",
                        "glosses": [
                            "Mettre au placard un dossier ou une affaire dont on ne reparlera plus, jeter aux oubliettes."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "c2abc9e7-3f1b-49b2-9e96-3ac8643f0788",
                                "sense_id": "44dd1b47-813b-3e73-9446-69a3e55ffdf8",
                                "text": "Nos rapports sont-ils « schubladisés »?"
                            },
                            {
                                "example_id": "d2471651-14ac-4545-8ccc-72fc74899b4a",
                                "sense_id": "44dd1b47-813b-3e73-9446-69a3e55ffdf8",
                                "text": "Les propositions des experts d'Arthur Andersen furent rapidement schubladisées."
                            },
                            {
                                "example_id": "386a5ba2-5bd5-4c9a-a34f-898613d512cb",
                                "sense_id": "44dd1b47-813b-3e73-9446-69a3e55ffdf8",
                                "text": "Et on découvre aujourd'hui qu'une étude a été «schubladisée» par le Conseil d'Etat depuis 2015 tout simplement parce qu’elle démontre à l’évidence que c’est toute la fonction publique et parapublique fribourgeoise (ça fait beaucoup d’électeurs) qui bénéficie de conditions salariales privilégiées si on les compare aux statistiques officielles qui année après année démontrent que les salaires fribourgeois, dans leur ensemble, sont parmi les plus bas de Suisse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47fdd986-3e18-4fc2-b64c-becf77f16a1c",
                        "source_entry_id": "f346f716-e91e-359b-a44f-0c541e6a477e",
                        "source_sense_id": "44dd1b47-813b-3e73-9446-69a3e55ffdf8",
                        "target_lang_word": "schubladisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
