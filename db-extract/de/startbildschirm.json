                "senses": [
                    {
                        "sense_id": "ca633789-eb56-3c27-a415-31f7b6e7dffe",
                        "entry_id": "573c8af9-7f8d-3a9f-ae2d-cf85859e68f3",
                        "glosses": [
                            "homescreen (main or first interface shown in a graphical user interface)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "5d4c3103-0d6e-4f34-9df7-81b1c87e02e0",
                                "sense_id": "ca633789-eb56-3c27-a415-31f7b6e7dffe",
                                "text": "Ihr Huawei-Telefon hat sie neben sich auf den Tisch gelegt. Schließlich nimmt sie es in die Hand und tippt mit dem Zeigefinger auf eine App, die sie auf dem Startbildschirm besonders prominent platziert hat."
                            }
                        ]
                    },
                    {
                        "sense_id": "54e4ca5c-dc37-3015-b7fd-f60163023232",
                        "entry_id": "573c8af9-7f8d-3a9f-ae2d-cf85859e68f3",
                        "glosses": [
                            "splash screen (initial screen displayed by an application)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "f3c7ced5-8f64-4486-b6d3-8bfe828196e4",
                                "sense_id": "54e4ca5c-dc37-3015-b7fd-f60163023232",
                                "text": "Um diesen fiesen Unterton weiß die Ausstellung natürlich: „Wohin führt das Tor zur Welt?“, begrüßt der Startbildschirm der „The Gate“-App."
                            }
                        ]
                    }
