                "senses": [
                    {
                        "sense_id": "64517707-6622-3c9f-8233-7008de5858d1",
                        "entry_id": "d760ffa1-4ecc-3dc0-a19d-38533ad1b817",
                        "glosses": [
                            "Person, die eine Pfeife raucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3abb517-be50-4ca2-ba50-07ebec85aaca",
                                "sense_id": "64517707-6622-3c9f-8233-7008de5858d1",
                                "text": "„Ich glaube, nicht dem klassischen Image eines Pfeifenrauchers zu entsprechen.“"
                            },
                            {
                                "example_id": "77eb9104-a00f-4548-843f-0b425a7a25d7",
                                "sense_id": "64517707-6622-3c9f-8233-7008de5858d1",
                                "text": "„Fast hätte ich den schwerhörigen alten Pfeifenraucher in Leos Konvikt noch einmal angerufen: Ich hätte mich gern mit ihm über das fleischliche Verlangen unterhalten.“"
                            },
                            {
                                "example_id": "bc841605-aec8-481b-8dd2-32f54ba57cf5",
                                "sense_id": "64517707-6622-3c9f-8233-7008de5858d1",
                                "text": "„Pencroff freundete sich noch mehr mit ihm an, die Pfeifenraucher waren jetzt unter sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
