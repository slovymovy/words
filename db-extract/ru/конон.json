                        "examples": [
                            {
                                "example_id": "8337a105-f5a7-4530-95b0-3a73dc612b3a",
                                "sense_id": "0010e05f-681c-3bc9-9e96-4255fdfbf4bc",
                                "text": "Первые поиски палат с сундуками предпринял в 1718 году московский пономарь Конон Осипов."
                            },
                            {
                                "example_id": "be09f228-c311-47de-8690-6d1593710b7c",
                                "sense_id": "0010e05f-681c-3bc9-9e96-4255fdfbf4bc",
                                "text": "Конон и Яков бредут по воде; мне очень не хочется идти за ними: я не верю в непромокаемость своих унтов."
                            }
                        ]
                    },
