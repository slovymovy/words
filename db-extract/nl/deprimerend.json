                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d833373-92dc-3c18-bb75-306e672aab94",
                        "entry_id": "4d3b698f-1df4-3f2e-9060-732b6839f2bf",
                        "glosses": [
                            "somber makend; depressie veroorzakend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de56bd2a-6712-4721-8733-353708a26555",
                                "sense_id": "8d833373-92dc-3c18-bb75-306e672aab94",
                                "text": "Vaak vragen ze zich af hoe ze zo snel mogelijk van mij afkomen. Zelf wil ik mijn betrokkenheid bij een bedrijf zo kort mogelijk houden, maar de deprimerende werkelijkheid is dat het jaren kan duren voordat een klus is geklaard.”"
                            },
                            {
                                "example_id": "6f4cbe43-beb9-4481-9436-69590ea720f3",
                                "sense_id": "8d833373-92dc-3c18-bb75-306e672aab94",
                                "text": "De Britse psycholoog Cliff Arnall bedacht Blue Monday in 2005. Hij maakte een naar eigen zeggen wetenschappelijke formule op basis van een aantal variabelen die op de maandag van de laatste volle week van januari het minst gunstig zouden zijn. Daarmee krijg je de meest deprimerende dag van het jaar."
                            },
                            {
                                "example_id": "7b15372b-435f-4553-96f1-c3adb4423533",
                                "sense_id": "8d833373-92dc-3c18-bb75-306e672aab94",
                                "text": "Haar zwakke en deprimerende 'oké' was een lichte afspiegeling van de apathische toestand waarin ze zich ineens bevond."
                            }
                        ]
                    }
                ],
