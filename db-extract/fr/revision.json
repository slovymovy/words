                        "glosses": [
                            "Action par laquelle on revoit, on examine de nouveau, en vue de corriger, de modifier, de réformer s’il y a lieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a182ff48-5444-48ff-a35a-3521a857954a",
                                "sense_id": "be69f365-49ac-3bc8-a28f-2e0205259c1c",
                                "text": "La revision des lois."
                            },
                            {
                                "example_id": "1292b2a1-6287-45b8-a14b-2629dc5e8a31",
                                "sense_id": "be69f365-49ac-3bc8-a28f-2e0205259c1c",
                                "text": "La revision de la Constitution."
                            },
                            {
                                "example_id": "a86555cd-bb8e-4b92-812e-776fdbce4e3c",
                                "sense_id": "be69f365-49ac-3bc8-a28f-2e0205259c1c",
                                "text": "La revision des listes électorales."
                            },
                            {
                                "example_id": "6cb08e92-7fcd-4b76-acef-909beeccf74a",
                                "sense_id": "be69f365-49ac-3bc8-a28f-2e0205259c1c",
                                "text": "Soumettre à une revision."
                            },
                            {
                                "example_id": "118fb71f-48d8-4865-89c4-81f36495837b",
                                "sense_id": "be69f365-49ac-3bc8-a28f-2e0205259c1c",
                                "text": "Faire la revision d’une feuille, pour s’assurer qu’il n’y reste plus de fautes."
                            },
                            {
                                "example_id": "46c4b2d8-6365-4492-bb52-11b136b57b0b",
                                "sense_id": "be69f365-49ac-3bc8-a28f-2e0205259c1c",
                                "text": "Revision de comptes."
                            },
                            {
                                "example_id": "f22bc3d7-5c3a-4bca-8cfa-79ad288da54c",
                                "sense_id": "be69f365-49ac-3bc8-a28f-2e0205259c1c",
                                "text": "Demander la revision d’un procès."
                            },
                            {
                                "example_id": "55aff04c-7de5-44bf-bcc5-07f0cfbb9c6e",
                                "sense_id": "be69f365-49ac-3bc8-a28f-2e0205259c1c",
                                "text": "Il s’est pourvu en revision."
                            },
                            {
                                "example_id": "28917d5b-068e-4e7c-a888-5695a0708476",
                                "sense_id": "be69f365-49ac-3bc8-a28f-2e0205259c1c",
                                "text": "Au mois de février, il adressa au Gouvernement bulgare des propositions écrites, et il suggéra de faire la revision « sans soulever l’opinion publique et sans laisser les grandes puissances s’immiscer dans l’affaire du partage »."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8712a6c-3029-32aa-9162-925e986ed561",
                        "entry_id": "e318fe06-95e2-34f3-8786-8fa3c7e8a4de",
                        "glosses": [
                            "Action d’examiner l’aptitude physique et les cas d’exemption des jeunes gens en âge de faire le service militaire."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "4650e6fe-ae2d-459b-80f1-5484e965df88",
                                "sense_id": "c8712a6c-3029-32aa-9162-925e986ed561",
                                "text": "On va faire une nouvelle revision des exemptés."
                            },
                            {
                                "example_id": "39058e22-969c-4919-b9a3-f6e714c2977e",
                                "sense_id": "c8712a6c-3029-32aa-9162-925e986ed561",
                                "text": "Et, en amateur qu’une revision militaire a quelquefois intéressé, il suivait des yeux les lignes sculpturales de ces chairs épandant de chaudes émanations de volupté."
                            }
                        ]
                    }
