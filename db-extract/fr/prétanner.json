                        "glosses": [
                            "Réaliser un tannage préparatoire de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db63bb3-9713-41fa-9943-aa3056f099a8",
                                "sense_id": "c5f26862-183d-3eb9-af63-ae6bd3423c1a",
                                "text": "Essai X - Prétannage au chrome : On prétanne les peaux en tripe avec 0,5 % de Cr₂O₃ à 33° Sch. puis on effectue le tannage habituel, (mais plus basique 42° Sch au lie ^([sic : lieu]) de 33° Sch.) en bain neuf."
                            },
                            {
                                "example_id": "ce92dcc6-63b5-4a95-9942-107087a0f2bf",
                                "sense_id": "c5f26862-183d-3eb9-af63-ae6bd3423c1a",
                                "text": "Ajouter enfin du carbonate de sodium à raison de 0,4 à 0,8 pour cent du poids de la peau prétannée, dissoudre le carbonate de sodium dans 10 à 20 fois autant d’eau, et tourner pendant trois heures encore ou jusqu’à ce que le tannage soit achevé."
                            }
                        ]
                    }
