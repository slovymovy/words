                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38f2d361-5938-45d1-8d3b-c70ad4186259",
                                                "sense_id": "58a2ae2d-9a3e-3828-8b51-584560d72b94",
                                                "text": "As the skiing season drew to an end, there was nothing but slush left on the piste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad03167-50c0-3955-8910-dd1f96987a3c",
                                        "entry_id": "0f778496-2880-364c-ae7d-6419622e11ca",
