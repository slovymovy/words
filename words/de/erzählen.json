            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b642bd7b-12e7-3523-b8bc-67fe6ddddee1",
                    "sense_definition": "ein Erlebnis, eine Geschichte oder ein Ereignis mündlich oder schriftlich darstellen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "narrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Mutter <w>erzählt</w> ihren Kindern jeden Abend vor dem Schlafen eine spannende Geschichte."
                        },
                        {
                            "text": "Mein Großvater kann stundenlang interessante Erlebnisse aus seiner Jugend <w>erzählen</w>."
                        }
                    ],
                    "synonyms": [
                        "wiedergeben"
                    ],
                    "antonyms": [
                        "verschweigen"
                    ],
                    "common_phrases": [
                        "eine Geschichte erzählen",
                        "ein Märchen erzählen"
                    ]
                },
                {
                    "sense_id": "7e94a717-e8f2-33ad-b4ed-51c99d94686a",
                    "sense_definition": "jemandem eine Information oder Neuigkeit mitteilen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "inform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat mir gestern <w>erzählt</w>, dass er eine neue Stelle in Hamburg gefunden hat."
                        },
                        {
                            "text": "Sie <w>erzählte</w> ihrer besten Freundin ausführlich von den Plänen für das kommende Wochenende."
                        }
                    ],
                    "synonyms": [
                        "berichten",
                        "mitteilen"
                    ],
                    "antonyms": [
                        "verschweigen"
                    ],
                    "common_phrases": [
