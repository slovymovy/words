            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb5ade13-b7a3-35d8-9d10-ed011ff9ed65",
                    "sense_definition": "A pale greenish-blue color, resembling that of the gemstone.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist mixed shades of deep blue and <w>turquoise</w> to paint the ocean.",
                            "target_lang_translations": {
                                "de": "Der Künstler mischte Töne von tiefem Blau und <w>Türkis</w>, um das Meer zu malen."
                            }
                        },
                        {
                            "text": "She decided to paint the bathroom walls in a soft shade of <w>turquoise</w>.",
                            "target_lang_translations": {
                                "de": "Sie beschloss, die Badezimmerwände in einem sanften <w>Türkiston</w> zu streichen."
                            }
                        }
                    ],
                    "synonyms": [
                        "blue-green",
                        "green-blue",
                        "greenish blue"
                    ],
                    "common_phrases": [
                        "shade of turquoise",
                        "bright turquoise",
                        "turquoise blue"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein blass-grünlichblauer Farbton, ähnlich dem des gleichnamigen Edelsteins."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Türkis",
                                "target_lang_sense_clarification": "Farbton / Farbe"
                            },
                            {
                                "target_lang_word": "Türkisblau",
                                "target_lang_sense_clarification": "Farbnuance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5968ab6-aee6-3ab7-b3da-5c878c1e6f80",
                    "sense_definition": "A blue to greenish-gray semi-precious gemstone often used in jewelry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gemstone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore an antique silver ring set with a polished <w>turquoise</w>.",
                            "target_lang_translations": {
                                "de": "Sie trug einen antiken Silberring, der mit einem polierten <w>Türkis</w> besetzt war."
                            }
                        },
                        {
                            "text": "Traders sold authentic Southwestern jewelry featuring polished pieces of <w>turquoise</w>.",
                            "target_lang_translations": {
                                "de": "Händler verkauften authentischen Schmuck aus dem Südwesten mit polierten Stücken aus <w>Türkis</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "raw turquoise",
                        "polished turquoise"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein blauer bis grünlich-grauer Halbedelstein, der häufig für Schmuck verwendet wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Türkis",
                                "target_lang_sense_clarification": "Halbedelstein"
                            }
                        ]
                    }
                }
            ]
        },
        {
