                {
                    "sense_id": "08f2163c-d1a7-3af1-9574-1d70505dfb09",
                    "sense_definition": "Partie située sous le foyer ou la grille d'un poêle ou d'une chaudière, où tombent les cendres.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de rallumer le poêle à bois, il faut nettoyer le <w>cendrier</w> pour assurer un bon tirage."
                        },
                        {
                            "text": "Le <w>cendrier</w> de la vieille chaudière débordait de résidus de charbon."
                        }
                    ]
                },
                {
                    "sense_id": "24b90b67-3a19-3f80-990b-8a82c3655148",
                    "sense_definition": "Grand sac de toile serrée qui contenait les cendres utilisées pour préparer la lessive traditionnelle.",
