                "senses": [
                    {
                        "sense_id": "2a81267a-dd3e-3912-97d7-060452d93d5f",
                        "entry_id": "ed99268b-e982-3caf-82f1-d57d9d06af4d",
                        "glosses": [
                            "родившийся до истечения нормального срока беременности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a51f3f0c-ff65-40b7-9e4a-d42f4dbfb432",
                                "sense_id": "2a81267a-dd3e-3912-97d7-060452d93d5f",
                                "text": "В условиях клиник нашего института применение указанных режимов с первых дней жизни недоношенных детей быстро привело к снижению первосуточной и ранней неонатальной смертности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f84994e7-7f4a-4ffc-b109-7301c5d6dcb3",
                        "source_entry_id": "ed99268b-e982-3caf-82f1-d57d9d06af4d",
                        "source_sense_id": "2a81267a-dd3e-3912-97d7-060452d93d5f",
                        "target_lang_word": "prématuré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prématuré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60e4121c-5bc3-3a12-a953-3d1d49f92452",
                                        "entry_id": "c2325582-5ecc-3a1b-a926-1ed054db749c",
                                        "glosses": [
                                            "En parlant des fruits, qui mûrit avant le temps ordinaire."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "433bc722-9af5-4e13-b901-443af2bfcd4d",
                                                "sense_id": "60e4121c-5bc3-3a12-a953-3d1d49f92452",
                                                "text": "Ces fruits sont prématurés."
                                            },
                                            {
                                                "example_id": "79c508a2-5dde-4683-bbc9-63d109b4507c",
                                                "sense_id": "60e4121c-5bc3-3a12-a953-3d1d49f92452",
                                                "text": "Les fruits prématurés ne sont ordinairement pas d’aussi bon goût que les autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "030492c9-f224-358e-9edb-0c9953adbebe",
                                        "entry_id": "c2325582-5ecc-3a1b-a926-1ed054db749c",
                                        "glosses": [
                                            "Ce qui se développe, ce qui se produit avant le temps normal, et spécialement des qualités de l’esprit et des passions qui sont plus développées que l’âge de celui dont on parle ne le comporte."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6fd184b-34d4-4162-9940-5c303c613110",
                                                "sense_id": "030492c9-f224-358e-9edb-0c9953adbebe",
                                                "text": "Une sagesse prématurée."
                                            },
                                            {
                                                "example_id": "cafccf91-c40f-450b-9ce2-345c67fb4173",
                                                "sense_id": "030492c9-f224-358e-9edb-0c9953adbebe",
                                                "text": "Une raison prématurée."
                                            },
                                            {
                                                "example_id": "97c10404-2c36-4cc1-8c04-127afe09b239",
                                                "sense_id": "030492c9-f224-358e-9edb-0c9953adbebe",
                                                "text": "Une ambition prématurée."
                                            },
                                            {
                                                "example_id": "b30bea15-475f-474b-bb7a-77003c7be5a4",
                                                "sense_id": "030492c9-f224-358e-9edb-0c9953adbebe",
                                                "text": "Une mort prématurée, une mort qui vient avant le temps ordinaire, plutôt qu’on n’aurait dû l’attendre."
                                            },
                                            {
                                                "example_id": "4528a673-d860-4acd-8c9b-8e40642861b1",
                                                "sense_id": "030492c9-f224-358e-9edb-0c9953adbebe",
                                                "text": "Alors que la pollution de l’air serait responsable de 7 millions de morts prématurées chaque année dans le monde, ces chutes, même temporaires, ont certainement sauvé des vies, selon certains experts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7e7fe3f-3478-32b0-b828-caded7ed87f3",
                                        "entry_id": "c2325582-5ecc-3a1b-a926-1ed054db749c",
                                        "glosses": [
                                            "Qu’il n’est pas encore temps d’entreprendre, d’exécuter."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da5fea2c-a4cc-42bf-8163-b42d4e23f1b6",
                                                "sense_id": "a7e7fe3f-3478-32b0-b828-caded7ed87f3",
                                                "text": "Cette entreprise est prématurée."
                                            },
                                            {
                                                "example_id": "9c5a0573-2544-40cd-a109-47de4b23d0dc",
                                                "sense_id": "a7e7fe3f-3478-32b0-b828-caded7ed87f3",
                                                "text": "Votre démarche paraîtra prématurée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccf2a12a-2830-39ba-9bd7-41e9276aef95",
                                        "entry_id": "c2325582-5ecc-3a1b-a926-1ed054db749c",
                                        "glosses": [
                                            "Qui est annoncé comme accompli lorsqu’il ne l’est pas encore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a14b5cec-7d55-4c7a-ae71-c0ba85bd4076",
                                                "sense_id": "ccf2a12a-2830-39ba-9bd7-41e9276aef95",
                                                "text": "La nouvelle de la reddition de cette place est prématurée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prématuré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecdc3025-428e-38fd-bf40-5ab4397b7312",
                                        "entry_id": "3168edfe-67c6-35ef-bc26-393066082d00",
                                        "glosses": [
                                            "Nouveau-né dont la naissance vient avant terme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3901d98c-15a2-43df-9808-41525309fa3d",
                                                "sense_id": "ecdc3025-428e-38fd-bf40-5ab4397b7312",
                                                "text": "Un bébé de l’État de l’Alabama aux États-Unis né à 21 semaines et un jour est le nouveau détenteur du record du plus jeune prématuré au monde, battant le précédent détenteur par 24 heures."
                                            },
                                            {
                                                "example_id": "e4e6cd11-d709-495a-951d-cd1d17e5e5b9",
                                                "sense_id": "ecdc3025-428e-38fd-bf40-5ab4397b7312",
                                                "text": "En général, un prématuré est un enfant né avant 37 semaines de gestation révolues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08678d53-5dde-3a9d-bfa8-aab68d71d76d",
                                        "entry_id": "3168edfe-67c6-35ef-bc26-393066082d00",
                                        "glosses": [
                                            "Caractère de ce qui se produit avant le moment prévu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6869e5-e5e6-4c69-b184-ac26bd1991e9",
                                                "sense_id": "08678d53-5dde-3a9d-bfa8-aab68d71d76d",
                                                "text": "Un peu avant l’arrivée de madame de Chasteller, Leuwen, pour excuser le prématuré de sa visite, avait proposé aux dames de Serpierre du café au Chasseur vert ; on avait accepté."
                                            }
                                        ]
                                    }
                                ]
