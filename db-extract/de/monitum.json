                "senses": [
                    {
                        "sense_id": "43f1233b-35e6-36dc-8b55-ab3f54d43267",
                        "entry_id": "07c8a187-4582-3b50-9a24-947f60ee5d2c",
                        "glosses": [
                            "etwas, das angemahnt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40c718ae-93fd-4a34-b523-fbae1015b08b",
                                "sense_id": "43f1233b-35e6-36dc-8b55-ab3f54d43267",
                                "text": "„Vor dem Hintergrund der Empfehlung und der Stellungnahme des Wissenschaftsrates aus den Jahren 1990 und 1996 ist einerseits zu fragen, ob und in welcher Weise die UWH seither die Monita, insbesondere bei der Humanmedizin in der Forschung, behoben hat.“"
                            },
                            {
                                "example_id": "a1155ebf-8afb-43cc-88d0-5f718d14c9ac",
                                "sense_id": "43f1233b-35e6-36dc-8b55-ab3f54d43267",
                                "text": "„Da gab es Monita und Tadel und starke Anschnauzer, wir nannten das leichte oder starke oder dicke Zigarren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
