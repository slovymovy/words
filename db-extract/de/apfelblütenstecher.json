                                        "glosses": [
                                            "Espèce de petit coléoptère dont les larves dévorent les bourgeons floraux des pommiers et poiriers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7ce31a-0069-47c3-afe3-671c5d6f5e84",
                                                "sense_id": "2683c438-ac4e-34d3-a6a7-991a1d6eab04",
                                                "text": "L’insecte issu de cette nymphose est un petit coléoptère brun noirâtre de la famille des charançons (dessin du haut), appelé anthonome du pommier."
                                            },
                                            {
                                                "example_id": "f5201efb-f632-45ac-984d-b5e4c3cdf59f",
                                                "sense_id": "2683c438-ac4e-34d3-a6a7-991a1d6eab04",
                                                "text": "La maladie de l’anthonome du pommier est due aux dégâts provoqués par des charançons, larves d’un petit coléoptère (Anthonomus pomorum)."
                                            },
                                            {
                                                "example_id": "20c3b12a-9077-4e4e-a207-db3586f9ae1a",
                                                "sense_id": "2683c438-ac4e-34d3-a6a7-991a1d6eab04",
                                                "text": "L’Anthonome du pommier est connu de tous les arboriculteurs qui redoutent ses méfaits sur les bourgeons floraux."
                                            }
