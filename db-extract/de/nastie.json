                "senses": [
                    {
                        "sense_id": "51c83b4b-a8bf-3517-b980-b946924d1921",
                        "entry_id": "71dfc7fe-cb86-32fb-b748-e7e8dc981b3a",
                        "glosses": [
                            "Bewegung von Teilen festgewachsener Pflanzen auf Reize, die unabhängig von der Richtung des Reizes ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee9ceb95-bdf5-4941-a1fe-0356cf14d18f",
                                "sense_id": "51c83b4b-a8bf-3517-b980-b946924d1921",
                                "text": "„Es dürfte daher zweckmäßiger sein, wenn man den Begriff „Nastie“ mehr einengt, indem man noch eine neue Charakteristik einführt, die gleichzeitig den Vergleich mit den Tropismen treffender macht. Die Definition lautet dann: Tropismus = Bewegung, verursacht und gerichtet durch äußere Umstände, Nastie = Bewegung, verursacht durch äußere Umstände, gerichtet durch die innere Struktur“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d6cc08a-6933-46c5-a234-57922dbcbf15",
                        "source_entry_id": "71dfc7fe-cb86-32fb-b748-e7e8dc981b3a",
