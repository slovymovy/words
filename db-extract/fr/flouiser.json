                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c18fbe11-721e-4c79-9d85-b2dbd3a19027",
                                "sense_id": "de191723-b750-330d-b9c2-396220724a98",
                                "text": "En ajoutant un filtre ND, vous pouvez flouiser votre arrière-plan et isoler votre sujet, même sous la lumière directe du soleil."
                            },
                            {
                                "example_id": "41d600e1-9350-46a2-a449-f8c3ca27a950",
                                "sense_id": "de191723-b750-330d-b9c2-396220724a98",
                                "text": "Maintenant, vous allez \"flouiser\" l'image avec un flou gaussien d'1 px de diamètre, que vous trouverez dans le menu Filtre, Atténuation."
                            },
                            {
                                "example_id": "a9f94287-bd46-4545-a4bf-3da185a5251d",
                                "sense_id": "de191723-b750-330d-b9c2-396220724a98",
                                "text": "Pour moi, ce tuto sert quasiment qu'à montrer qu'on peut \"flouiser\" des trucs avec Tofiltre."
                            }
                        ]
