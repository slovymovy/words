                "senses": [
                    {
                        "sense_id": "3bc00ab6-0b34-315c-9363-f253101be2ff",
                        "entry_id": "0216af71-a6e5-3f95-ab4a-1f21e57f1884",
                        "glosses": [
                            "Eau-de-vie à base de sureau noir (Sambucus nigra), souvent particulièrement corsée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee52c390-2d56-4623-97eb-57ce7468144f",
                                "sense_id": "3bc00ab6-0b34-315c-9363-f253101be2ff",
                                "text": "Son pochtron de mari encore imbibé dans la gnôle qu’il s’était envoyée a été reçu plus que vertement par sa femme."
                            }
                        ]
                    },
                    {
                        "sense_id": "a15d373e-e614-335c-8519-25961801aeb4",
                        "entry_id": "0216af71-a6e5-3f95-ab4a-1f21e57f1884",
                        "glosses": [
                            "Eau-de-vie, avec parfois le sens péjoratif d’eau-de-vie de mauvaise qualité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffef2d2c-9a5d-46bb-bf76-fcb6c11f47dc",
                                "sense_id": "a15d373e-e614-335c-8519-25961801aeb4",
                                "text": "Cordélia tendit le Thermos que nous avions emmené à tout hasard.\n« Qu’est-ce que c’est ? demanda-t-il.\n— Du thé.\n— Vous n’auriez pas plutôt de la gnôle ? »\nNous avions aussi de la gnôle.\n— Ça va t’achever, dit Cordélia.\n— Donne-lui, dis-je. Ça n’a plus d’importance. »\nLe Bressan but un coup de gnôle. Son visage redevint rose. Il ébaucha un sourire."
                            }
                        ]
                    },
                    {
                        "sense_id": "67e324c3-3445-3818-9740-9b0bf6e9ea9b",
                        "entry_id": "0216af71-a6e5-3f95-ab4a-1f21e57f1884",
                        "glosses": [
                            "Veste."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37e539c8-1723-4aa5-b5da-ed7a30b1ed69",
                        "source_entry_id": "0216af71-a6e5-3f95-ab4a-1f21e57f1884",
                        "target_lang_word": "Schnaps",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnaps",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "861fea8f-67f2-3d08-bfc6-07028986776d",
                                        "entry_id": "7ac9647e-2fc5-3db3-bcb1-7d55c4b5a2d7",
                                        "glosses": [
                                            "eine Mundfüllung, ein Schluck, ein Bisschen"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2032fb7-c6e7-4023-b809-ee64fca4d1b4",
                                                "sense_id": "861fea8f-67f2-3d08-bfc6-07028986776d",
                                                "text": "Einen Schnaps mehr, und ich hätte es geschafft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                        "entry_id": "7ac9647e-2fc5-3db3-bcb1-7d55c4b5a2d7",
                                        "glosses": [
                                            "gebranntes, stark alkoholhaltiges Getränk"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa060de0-8fe0-49db-b3f7-80746d55dc5d",
                                                "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                                "text": "Ich hätte gerne noch einen Schnaps."
                                            },
                                            {
                                                "example_id": "a58e2053-a13f-4b34-a4d7-42aa8e0a5997",
                                                "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                                "text": "„„Schnaps“, das war sein letztes Wort, dann trugen ihn die Englein fort.“"
                                            },
                                            {
                                                "example_id": "f2e604d2-5ac2-4968-9cf7-7b3c6dbe6a82",
                                                "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                                "text": "„Er dankt vor jeder Kneipe seinem Schöpfer, daß es Schnaps gibt.“"
                                            },
                                            {
                                                "example_id": "76776c4d-495a-4746-94be-d5728ffed358",
                                                "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                                "text": "„Der Großvater Paweł konnte ohne Machorka und Schnaps nicht leben.“"
                                            },
                                            {
                                                "example_id": "ce0a6e45-45a6-4aae-b94d-e67fcf828729",
                                                "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                                "text": "„Der Schnaps rann als feiner Feuerstrahl in den Magen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "250d960f-f19d-488f-a811-5a724def4d29",
                        "source_entry_id": "0216af71-a6e5-3f95-ab4a-1f21e57f1884",
                        "target_lang_word": "Fusel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fusel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11be6a83-b6f2-33a8-8ce4-6dfdc5109cdf",
                                        "entry_id": "94a96fd1-e854-35ec-84a7-e69f95b7628c",
                                        "glosses": [
                                            "schlechter, billiger, minderwertiger Branntwein, Schnaps oder Wein"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bcaa6d9-2145-4f71-8a6d-14caecec9276",
                                                "sense_id": "11be6a83-b6f2-33a8-8ce4-6dfdc5109cdf",
                                                "text": "Trink' nicht immer diesen billigen Fusel!"
                                            },
                                            {
                                                "example_id": "ddb2c0ce-d265-4a6d-987a-fe41dcb84bd1",
                                                "sense_id": "11be6a83-b6f2-33a8-8ce4-6dfdc5109cdf",
                                                "text": "„An dem Fusel brauchte man nur zu schnuppern, und schon stiegen einem die Tränen in die Augen.“"
                                            },
                                            {
                                                "example_id": "96faaa93-9c1b-4ac1-b1a9-b131917966a5",
                                                "sense_id": "11be6a83-b6f2-33a8-8ce4-6dfdc5109cdf",
                                                "text": "„Aus einer Kammer rechts hinter dem Ladentisch roch es nach Fusel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb68b508-5572-3a12-a8e4-bf5dd6478e7b",
                                        "entry_id": "94a96fd1-e854-35ec-84a7-e69f95b7628c",
                                        "glosses": [
                                            "Gemisch verschiedener Amylalkohole"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1350c491-d3f4-48b7-aa22-6e2c3c9135d2",
                                                "sense_id": "eb68b508-5572-3a12-a8e4-bf5dd6478e7b",
                                                "text": "„Im Bier schwanken die Fuselanteile aufgrund der unterschiedlichen Herstellungsverfahren. Weizenbier hat höhere Konzentrationen als Pilsener oder Exportbier. Ebenso hat Obergäriges Bier mehr Fusel als untergäriges.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f11c888-bc53-4edb-88a5-d779692e7c42",
                        "source_entry_id": "0216af71-a6e5-3f95-ab4a-1f21e57f1884",
