                "senses": [
                    {
                        "sense_id": "122fcb81-4fbb-3e5c-b42b-14df80d0fd35",
                        "entry_id": "69a34b0d-25b2-3058-82ea-046a7f54cbfa",
                        "glosses": [
                            "имеющий толстую шею"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d4764ae-8aa4-4774-bd51-e01c4c98ecc7",
                                "sense_id": "122fcb81-4fbb-3e5c-b42b-14df80d0fd35",
                                "text": "К 1947 году вожди отъелись и стали толстошеими, пузатыми, кругломордыми."
                            },
                            {
                                "example_id": "0c5a7ca8-e583-4799-a171-08286d271498",
                                "sense_id": "122fcb81-4fbb-3e5c-b42b-14df80d0fd35",
                                "text": "Выступила она, ― грузная, толстошеяя, с выпученными глазами, ― и, как всегда, видом своим вызвала к себе враждебное отношение."
                            }
                        ]
                    }
