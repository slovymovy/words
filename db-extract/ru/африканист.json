                                "target_senses": [
                                    {
                                        "sense_id": "65649d5f-1249-37f0-bbcf-00b67f3163e5",
                                        "entry_id": "46c40b3a-0788-31f0-a52e-5f8b58c02400",
                                        "glosses": [
                                            "A specialist in African studies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9384bb-258d-4bd7-a9f7-8bb55709d111",
                                                "sense_id": "65649d5f-1249-37f0-bbcf-00b67f3163e5",
                                                "text": "Noted Africanist, William Fagg, consistently stresses the tribality of sub-Saharan art […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2945c1d-dbe2-3130-b263-a68e25f0be89",
                                        "entry_id": "46c40b3a-0788-31f0-a52e-5f8b58c02400",
                                        "glosses": [
                                            "An African nationalist; someone who subscribes to the doctrine of Africanism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "810e4f68-ccee-4edf-958b-130d2ebe10d0",
                                                "sense_id": "b2945c1d-dbe2-3130-b263-a68e25f0be89",
                                                "text": "The ANC was criticized by a number of Africanist members who accused the leadership of protecting the interests of the landlords at the expense of the tenants."
                                            }
                                        ]
                                    }
                                ]
