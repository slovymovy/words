                                                "example_id": "da4aee0e-53fe-49df-bdcd-4fe6c3902e0a",
                                                "sense_id": "a7e7a559-5ecc-3249-86e2-e547e83fc4df",
                                                "text": "Le matin, faisant un tour dans le jardin, il trouva tas de physalis rouges."
                                            }
