                "senses": [
                    {
                        "sense_id": "deae7700-70fe-3593-83ff-68102868016b",
                        "entry_id": "e1b618fc-35b6-3e8e-9200-fce543114813",
                        "glosses": [
                            "Abfall der bei der Be- und Verarbeitung oder Entsorgung von Holz anfällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2cd07b6-d12d-481d-b6a4-a619d9b3ea83",
                                "sense_id": "deae7700-70fe-3593-83ff-68102868016b",
                                "text": "„Holzabfälle können als Rohstoff beispielsweise für Spanplatten dienen und so frisches Holz ersetzen.“"
                            },
                            {
                                "example_id": "bc04920f-5fe5-47fd-9cd4-8cc746ec82fb",
                                "sense_id": "deae7700-70fe-3593-83ff-68102868016b",
                                "text": "„Holzabfälle sind Abfälle, die überwiegend aus Holz bestehen.“"
                            },
                            {
                                "example_id": "2b953be4-2512-4c3f-a998-5c74677488fb",
                                "sense_id": "deae7700-70fe-3593-83ff-68102868016b",
                                "text": "„Holzabfälle im Sinne der Abfallwirtschaftssatzung sind Möbel und sonstige Gebrauchsgegenstände mit überwiegendem Holzanteil sowie Bau- und Abbruchholz.“"
                            }
                        ],
