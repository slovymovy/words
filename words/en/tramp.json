{
    "word_family": [
        "tramper",
        "trample",
        "trampoline"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1dfe2829-5724-3d92-84e8-2af53ef16bb4",
                    "sense_definition": "A homeless person; a vagabond.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "homeless_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>tramp</w> sat on the park bench, sharing his breadcrumbs with the birds.",
                            "target_lang_translations": {
                                "pl": "Stary <w>włóczęga</w> siedział na ławce w parku, dzieląc się okruchami chleba z ptakami."
                            }
                        },
                        {
                            "text": "He lived as a <w>tramp</w>, traveling from town to town with nothing but a small backpack.",
                            "target_lang_translations": {
                                "pl": "Żył jak <w>włóczęga</w>, podróżując od miasta do miasta z jedynie małym plecakiem."
                            }
                        }
                    ],
                    "synonyms": [
                        "bum",
                        "hobo",
                        "vagabond",
                        "vagrant",
                        "drifter"
                    ],
                    "common_phrases": [
                        "homeless tramp"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba bezdomna; włóczęga."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "włóczęga",
                                "target_lang_sense_clarification": "osoba bez stałego miejsca zamieszkania"
                            },
                            {
                                "target_lang_word": "menel",
                                "target_lang_sense_clarification": "potocznie i pejoratywnie o osobie bezdomnej"
                            },
                            {
                                "target_lang_word": "kloszard",
                                "target_lang_sense_clarification": "bezdomny, często w kontekście miejskim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b9f1e8f-38f3-3c92-b6c0-2f1c043428b9",
                    "sense_definition": "A long walk, possibly of more than one day, in a scenic or wilderness area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "long_walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went on a long <w>tramp</w> through the national park over the weekend.",
                            "target_lang_translations": {
                                "pl": "W weekend wybraliśmy się na długą <w>wędrówkę</w> po parku narodowym."
                            }
                        },
                        {
                            "text": "After a tiring <w>tramp</w> in the hills, they finally reached the mountain cabin.",
                            "target_lang_translations": {
                                "pl": "Po męczącej <w>wędrówce</w> po wzgórzach w końcu dotarli do górskiej chatki."
                            }
                        }
                    ],
                    "synonyms": [
                        "hike",
                        "trek",
                        "ramble"
                    ],
                    "common_phrases": [
                        "long tramp"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in New Zealand and Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Długa wędrówka, trwająca czasem dłużej niż jeden dzień, w malowniczym lub dzikim terenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wędrówka",
                                "target_lang_sense_clarification": "piesza wyprawa"
                            },
                            {
                                "target_lang_word": "marszruta",
                                "target_lang_sense_clarification": "długi marsz"
                            },
                            {
                                "target_lang_word": "trekking",
                                "target_lang_sense_clarification": "wyprawa w trudnym terenie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8aacfd08-c298-33db-931f-010cd9eebb3a",
                    "sense_definition": "A disreputable, promiscuous woman.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "promiscuous_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can't believe you'd let yourself be seen with that <w>tramp</w>.",
                            "target_lang_translations": {
                                "pl": "Nie mogę uwierzyć, że dałeś się zobaczyć z tą <w>dziewką</w>."
                            }
                        },
                        {
                            "text": "She was unfairly labeled a <w>tramp</w> by the local gossips.",
                            "target_lang_translations": {
                                "pl": "Została niesprawiedliwie nazwana <w>szmatą</w> przez lokalne plotkary."
                            }
                        }
                    ],
                    "synonyms": [
                        "slut",
                        "trollop",
                        "tart"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used as a derogatory term"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Kobieta o złej reputacji, prowadząca rozwiązłe życie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dziewka",
                                "target_lang_sense_clarification": "pogardliwie o kobiecie lekkich obyczajów"
                            },
                            {
                                "target_lang_word": "szmata",
                                "target_lang_sense_clarification": "bardzo wulgarne określenie kobiety"
                            },
                            {
                                "target_lang_word": "pindzia",
                                "target_lang_sense_clarification": "potoczne, obraźliwe określenie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "588053db-7b8d-3866-ad03-d20ed7e4d0fd",
                    "sense_definition": "Any ship which does not have a fixed schedule or published ports of call.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cargo was loaded onto an old <w>tramp</w> steamer bound for South America.",
                            "target_lang_translations": {
                                "pl": "Ładunek został załadowany na stary parowiec <w>tramp</w> płynący do Ameryki Południowej."
                            }
                        },
                        {
                            "text": "Unlike regular liners, a <w>tramp</w> ship goes wherever cargo is available.",
                            "target_lang_translations": {
                                "pl": "W przeciwieństwie do regularnych liniowców, statek <w>tramp</w> płynie tam, gdzie dostępny jest ładunek."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tramp steamer",
                        "tramp ship"
                    ],
                    "target_lang_definitions": {
                        "pl": "Statek handlowy nieposiadający stałego rozkładu rejsów ani stałych portów przeznaczenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tramp",
                                "target_lang_sense_clarification": "statek nieregularnej żeglugi"
                            },
                            {
                                "target_lang_word": "trampowiec",
                                "target_lang_sense_clarification": "statek towarowy pływający bez stałego rozkładu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73936a7b-3470-360f-bcb7-7d51be8313ad",
                    "sense_definition": "A clipping of <w>trampoline</w>, especially a very small one.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "trampoline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kids were jumping up and down on the backyard <w>tramp</w>.",
                            "target_lang_translations": {
                                "pl": "Dzieci skakały w górę i w dół na podwórkowej <w>trampolinie</w>."
                            }
                        },
                        {
                            "text": "She bought a mini <w>tramp</w> for her indoor aerobic workouts.",
                            "target_lang_translations": {
                                "pl": "Kupiła mini <w>trampolinę</w> do domowych treningów aerobowych."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mini tramp"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Shortened form"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Skrócona nazwa trampoliny, zwłaszcza małej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "trampolina",
                                "target_lang_sense_clarification": "przyrząd do skakania"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07e41710-df95-3098-9c22-b09bed73d84a",
                    "sense_definition": "To walk for a long time, usually through difficult terrain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>tramped</w> through the muddy woods for hours before we found the main path again.",
                            "target_lang_translations": {
                                "pl": "Godzinami <w>brnęliśmy</w> przez błotnisty las, zanim ponownie znaleźliśmy główną ścieżkę."
                            }
                        },
                        {
                            "text": "They had to <w>tramp</w> across wet fields to reach the remote cottage.",
                            "target_lang_translations": {
                                "pl": "Musieli <w>iść</w> przez mokre pola, aby dotrzeć do oddalonej chatki."
                            }
                        }
                    ],
                    "synonyms": [
                        "hike",
                        "trek",
                        "march"
                    ],
                    "common_phrases": [
                        "tramp through"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wędrować pieszo przez długi czas, zazwyczaj w trudnym terenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wędrować",
                                "target_lang_sense_clarification": "iść pieszo przez dłuższy czas"
                            },
                            {
                                "target_lang_word": "przemierzać",
                                "target_lang_sense_clarification": "iść z trudem przez jakiś obszar"
                            },
                            {
                                "target_lang_word": "brnąć",
                                "target_lang_sense_clarification": "iść z wysiłkiem, np. przez błoto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "621cb157-80d7-3f7c-9943-189da68a0b67",
                    "sense_definition": "To walk with heavy footsteps.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard him <w>tramp</w> up the wooden stairs in his heavy boots.",
                            "target_lang_translations": {
                                "pl": "Słyszałem, jak <w>tupie</w> po drewnianych schodach w swoich ciężkich butach."
                            }
                        },
                        {
                            "text": "Don't <w>tramp</w> around the house while the baby is sleeping.",
                            "target_lang_translations": {
                                "pl": "Nie <w>tup</w> po domu, kiedy dziecko śpi."
                            }
                        }
                    ],
                    "synonyms": [
                        "stomp",
                        "plod",
                        "trudge"
                    ],
                    "common_phrases": [
                        "tramp upstairs"
                    ],
                    "target_lang_definitions": {
                        "pl": "Chodzić ciężkimi, głośnymi krokami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tupać",
                                "target_lang_sense_clarification": "głośno stawiać kroki"
                            },
                            {
                                "target_lang_word": "łomotać",
                                "target_lang_sense_clarification": "iść ciężko, hałasując"
                            },
                            {
                                "target_lang_word": "człapać",
                                "target_lang_sense_clarification": "iść ciężko i powoli"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28479b36-ea63-39e9-ae2a-4663fef4fd56",
                    "sense_definition": "To travel or wander through.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his youth deciding to <w>tramp</w> the country in search of adventure.",
                            "target_lang_translations": {
                                "pl": "Spędził młodość, decydując się <w>przemierzać</w> kraj w poszukiwaniu przygód."
                            }
                        },
                        {
                            "text": "They would <w>tramp</w> the streets of the old city for hours.",
                            "target_lang_translations": {
                                "pl": "Godzinami <w>włóczyli się</w> ulicami starego miasta."
                            }
                        }
                    ],
                    "synonyms": [
                        "wander",
                        "roam",
                        "traverse"
                    ],
                    "common_phrases": [
                        "tramp the streets"
                    ],
                    "target_lang_definitions": {
                        "pl": "Podróżować lub włóczyć się po jakimś obszarze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "włóczyć się",
                                "target_lang_sense_clarification": "chodzić bez celu"
                            },
                            {
                                "target_lang_word": "przemierzać",
                                "target_lang_sense_clarification": "wędrować po jakimś terenie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}