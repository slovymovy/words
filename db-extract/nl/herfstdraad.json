        "nl-extract.jsonl": [
            {
                "entry_id": "2077b72c-2233-392b-b2f6-a1bebf317558",
                "word": "herfstdraad",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8e9c94a3-e567-45ca-b869-f3e60aacacf2",
                        "entry_id": "2077b72c-2233-392b-b2f6-a1bebf317558",
                        "tags": [
                            "plural"
                        ],
                        "form": "herfstdraden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b69f9ec5-41b9-3519-9c72-092436d47dce",
                        "entry_id": "2077b72c-2233-392b-b2f6-a1bebf317558",
                        "glosses": [
                            "een zeer dunne draad spinrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d199717-41bb-4306-85dd-183115f270b3",
                                "sense_id": "b69f9ec5-41b9-3519-9c72-092436d47dce",
                                "text": "'Met gedempte stem ging hij door, hij trachtte Dorrius te omwikkelen met het spinrag van zijn gelispel, hem aan een herfstdraad naar zich toe te trekken: 'Onyx en gitten, zuivere karmozijn en omber, maar nu ook de kleur van de geest, de verschijning van de leegte, de negativiteit."
                            },
                            {
                                "example_id": "be364a0b-53f8-4ecb-ace9-c445826a19dd",
                                "sense_id": "b69f9ec5-41b9-3519-9c72-092436d47dce",
                                "text": "Het boek dat onbetwist het hart zal vormen van deze kast wil ik hierbij nog maar eens aanbevelen. Niet alleen de titel ”De eindigheid der dagen” is donker en herfstig, ook de hoofdpersoon zelf is het, een sombere lekenprediker uit de 19e eeuw die klungelig lange praatzinnen opschrijft zonder interpunctie die je tweemaal moet lezen en nog begrijp je ze niet ze zijn lang en plakkerig als herfstdraden ze laten je niet los. Zoiets dus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96587f58-00c6-4437-b72f-bc9dac0b4a56",
                        "source_entry_id": "2077b72c-2233-392b-b2f6-a1bebf317558",
                        "source_sense_id": "b69f9ec5-41b9-3519-9c72-092436d47dce",
                        "source_sense_description": "een zeer dunne draad spinrag",
                        "target_lang_word": "gossamer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gossamer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baa13e99-551a-36af-8a77-aefc39bf63c0",
                                        "entry_id": "ccaf99ea-0db9-39a0-af43-d83f5e267eb8",
                                        "glosses": [
                                            "A fine film made up of cobwebs, seen floating in the air or caught on bushes, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a3cf7f9-f9ba-4779-b431-c18ffab06b09",
                                                "sense_id": "baa13e99-551a-36af-8a77-aefc39bf63c0",
                                                "text": "A lover may bestride the gossamer / That idles in the wanton summer air, / And yet not fall; so light is vanity."
                                            },
                                            {
                                                "example_id": "64a53e7f-5912-4595-a033-a2eb42bc39de",
                                                "sense_id": "baa13e99-551a-36af-8a77-aefc39bf63c0",
                                                "text": "The filmy Gossamer now flitts no more,"
                                            },
                                            {
                                                "example_id": "e11ee298-6c43-4726-9854-6bf4081ae0dd",
                                                "sense_id": "baa13e99-551a-36af-8a77-aefc39bf63c0",
                                                "text": "I had been dead-heavy before, and now I felt a kind of dreadful lightness, which would not suffer me to walk. I drifted like a gossamer; the ground seemed to me a cloud, the hills a feather-weight, the air to have a current, like a running burn, which carried me to and fro."
                                            },
                                            {
                                                "example_id": "d88e18a7-2326-4405-a232-0067d5e363b5",
                                                "sense_id": "baa13e99-551a-36af-8a77-aefc39bf63c0",
                                                "text": "The dew and gossamer had dried early from the grass"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0644297-f199-3f65-856f-7fafd7d7580d",
                                        "entry_id": "ccaf99ea-0db9-39a0-af43-d83f5e267eb8",
                                        "glosses": [
                                            "A soft, sheer fabric."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d876c137-894f-4124-ac02-d758db78f075",
                                                "sense_id": "f0644297-f199-3f65-856f-7fafd7d7580d",
                                                "text": "Madame wiped the picture with her gossamer handkerchief and impulsively pressed a tender kiss upon the painted canvas."
                                            },
                                            {
                                                "example_id": "8f51c6a5-efe3-40f0-996e-dca149767386",
                                                "sense_id": "f0644297-f199-3f65-856f-7fafd7d7580d",
                                                "text": "She takes a large, gossamer scarf from the trunk and drapes it about her shoulders."
                                            },
                                            {
                                                "example_id": "bc9956a4-fa1f-4147-bf52-d1cbab2dc55d",
                                                "sense_id": "f0644297-f199-3f65-856f-7fafd7d7580d",
                                                "text": "a circle of popes or maybe bishops in white gossamer robes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac61c76a-ca7b-39bb-b708-65f85ea4b84a",
                                        "entry_id": "ccaf99ea-0db9-39a0-af43-d83f5e267eb8",
                                        "glosses": [
                                            "Anything delicate, light and flimsy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gossamer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0273eee-4903-3577-86f6-ec541fe20791",
                                        "entry_id": "3a822b0e-f170-30dc-8f72-e5baf7642f5d",
                                        "glosses": [
                                            "Tenuous, light, filmy or delicate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e4bd48-956e-4c90-9031-29da3cedd544",
                                                "sense_id": "f0273eee-4903-3577-86f6-ec541fe20791",
                                                "text": "There is something in the unselfish and self-sacrificing love of a brute, which goes directly to the heart of him who has had frequent occasion to test the paltry friendship and gossamer fidelity of mere Man."
                                            },
                                            {
                                                "example_id": "1380e36c-d0fb-4225-a517-60ee5f0d3068",
                                                "sense_id": "f0273eee-4903-3577-86f6-ec541fe20791",
                                                "text": "The heaven was spangled with tremulous stars, and at the horizon the clouds hung down in gossamer folds—God's robe trailing in the sea!"
                                            },
                                            {
                                                "example_id": "1281bf5f-f1b3-4b57-baff-8f226014ecb5",
                                                "sense_id": "f0273eee-4903-3577-86f6-ec541fe20791",
                                                "text": "He walked. To the corner of Hamilton Place and Picadilly, and there stayed for a while, for it is a romantic station by night. The vague and careless rain looked like threads of gossamer silver passing across the light of the arc-lamps."
                                            },
                                            {
                                                "example_id": "06fdb8e0-3620-4437-a891-2fa16603668e",
                                                "sense_id": "f0273eee-4903-3577-86f6-ec541fe20791",
                                                "text": "His two previous novels, though much celebrated, I found too ethereal, the style as gossamer and sticky as cotton candy."
                                            },
                                            {
                                                "example_id": "7131d9cb-5881-4a99-9c18-3f57a8f356c9",
                                                "sense_id": "f0273eee-4903-3577-86f6-ec541fe20791",
                                                "text": "A gossamer blanket of coaldust floated down like a dirty blessing and gently smothered the traffic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
