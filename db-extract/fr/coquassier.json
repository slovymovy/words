                        "sense_id": "a5181ecb-0d6c-33e5-a427-d9541668baed",
                        "entry_id": "ffd76537-c710-3ec6-b157-8578da71edde",
                        "glosses": [
                            "Marchand d’œufs et d’animaux de basse-cour, qui achetait ses produits de ferme en ferme, pour les revendre en ville."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f9395b36-152d-4f58-966e-3eaacb80789f",
                                "sense_id": "a5181ecb-0d6c-33e5-a427-d9541668baed",
                                "text": "Les volailles protégées poussèrent des gloussements de bénédiction ; seulement, au bout de six mois, quand passa le coquassier, d’un coup on en saigna cinquante."
                            },
                            {
                                "example_id": "87f92ea5-6a01-4f6c-ac7e-286c5bbf35a0",
                                "sense_id": "a5181ecb-0d6c-33e5-a427-d9541668baed",
                                "text": "Chasseurs, voituriers, coquassiers, trouveraient leur compte à la franchise car les revenus de l’octroi décupleraient et l’on baisserait les taxes."
                            }
                        ]
                    }
