                "senses": [
                    {
                        "sense_id": "6b726f49-da93-311f-87de-168295c3b7d5",
                        "entry_id": "b8bb65da-6d12-3a23-86a1-b5053085036b",
                        "glosses": [
                            "größere gesetzliche Umgestaltung des Gesundheitswesens, oft mit dem Ziel, die Kosten zu senken und/oder die Versorgung zu verbessern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d73b175b-54e5-4c7c-9140-43b39c25d72f",
                                "sense_id": "6b726f49-da93-311f-87de-168295c3b7d5",
                                "text": "Bundesgesundheitsminister Rösler (FDP) hat gestern einen Vorschlag zur Gesundheitsreform unterbreitet, um das Defizit der Krankenkassen […] aufzufangen."
                            },
                            {
                                "example_id": "f1c9d2c6-9308-4d71-9395-5bf15b9277c8",
                                "sense_id": "6b726f49-da93-311f-87de-168295c3b7d5",
                                "text": "„Da ich davon ausgehe, dass Familie Brangelina nicht auf Barack Obamas Gesundheitsreform angewiesen ist, ist zu vermuten, dass bei ihr alles wieder nett anzuschauen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
