                "senses": [
                    {
                        "sense_id": "489b88b9-4ec1-3e7d-91ec-82429547b28d",
                        "entry_id": "9dc97b05-25a6-38f5-a30c-c12e9d3a74a3",
                        "glosses": [
                            "металлический сосуд для кипячения воды с топкой внутри"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc10b991-b4fd-40ee-ae24-dad0fe0bb9e4",
                                "sense_id": "489b88b9-4ec1-3e7d-91ec-82429547b28d",
                                "text": "Наконец открыл он глаза и увидел перед собою работницу, раздувающую самовар."
                            },
                            {
                                "example_id": "4be55f2c-9038-43f0-9e15-e9ca8d68c680",
                                "sense_id": "489b88b9-4ec1-3e7d-91ec-82429547b28d",
                                "text": "Самовар у хозяев маленький, и прежде чем гости напиваются чаю, приходится подогревать его раз пять."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a45edd57-8606-4310-a4fe-e6f2bdda0ba9",
                        "source_entry_id": "9dc97b05-25a6-38f5-a30c-c12e9d3a74a3",
                        "source_sense_id": "489b88b9-4ec1-3e7d-91ec-82429547b28d",
                        "target_lang_word": "samovar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samovar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d48501e9-53fa-31b6-9ede-d179c0f9ba08",
                                        "entry_id": "15577ffe-4520-3902-9cf9-329eb48d5776",
                                        "glosses": [
                                            "A metal urn with a spigot, for boiling water for making tea. Traditionally, the water is heated by hot coals or charcoal in a chimney-like tube which runs through the center of the urn. Today, it is more likely that the water is heated by an electric coil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e46e3c8b-7b32-4387-808f-0a1f3e9d9ef6",
                                                "sense_id": "d48501e9-53fa-31b6-9ede-d179c0f9ba08",
                                                "text": "Come on now with the samovar ─ and make haste sorting the letter-bag."
                                            },
                                            {
                                                "example_id": "3a0d4a60-64b5-4577-bd32-b492582ec7de",
                                                "sense_id": "d48501e9-53fa-31b6-9ede-d179c0f9ba08",
                                                "text": "Eurydice pointed to the cupboard, and sat down on the low divan with folded hands, and looked at the floor.[…]Elsa made her drink a glass of vodka. Then she fetched the samovar from the kitchen, and made tea."
                                            },
                                            {
                                                "example_id": "110b3ad6-e65a-4bbb-9b3b-6ec2049a5af0",
                                                "sense_id": "d48501e9-53fa-31b6-9ede-d179c0f9ba08",
                                                "text": "“Chumley. The beverage situation around here is reprehensible.” “Oh, good morning, sunshine.” “Surely our massive conglomerate parent company could spring for a samovar of coffee.” “Yeah, or like a big coffee dispenser.” “That's what a samovar is.” “Are there other black nerds, or is it just you and Urkel?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dc20cc6-2414-4eff-9a50-be4116233f9f",
                        "source_entry_id": "9dc97b05-25a6-38f5-a30c-c12e9d3a74a3",
                        "source_sense_id": "489b88b9-4ec1-3e7d-91ec-82429547b28d",
                        "target_lang_word": "samovar",
