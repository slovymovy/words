                        "sense_id": "a378fee7-b52d-37aa-9e6d-7eff997cc1da",
                        "entry_id": "bcdab08a-2cb3-3152-a545-689e03308095",
                        "glosses": [
                            "Anrede für Geistliche, die einen päpstlichen Ehrentitel ((i.) Kaplan Seiner Heiligkeit oder Päpstlicher Ehrenkaplan; (ii.) Ehrenprälat Seiner Heiligkeit oder Päpstlicher Ehrenprälat; (iii.) Apostolischer Protonotar) verliehen bekommen haben"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "0177c574-b5e3-4d60-8243-9d7f17ed9f5d",
                                "sense_id": "a378fee7-b52d-37aa-9e6d-7eff997cc1da",
                                "text": "„Kaum hatte ich mich angezogen, ging ich hinunter und besuchte die Messe; ich war sicher, daß Monsignore mich dort sehen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
