{
    "word_family": [
        "cementation",
        "cementer",
        "cementitious",
        "cementum"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1a59ef7-b652-3c53-ab78-3920a818203f",
                    "sense_definition": "A grey powder made from limestone and clay that becomes hard when mixed with water and is used in building.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "building_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction workers mixed the <w>cement</w> with sand and water to make concrete. stories.",
                            "target_lang_translations": {
                                "ru": "Строители смешали <w>цемент</w> с песком и водой, чтобы сделать бетон.",
                                "zh": "建筑工人把<w>水泥</w>和沙子、水混合在一起制成混凝土。"
                            }
                        },
                        {
                            "text": "A large bag of <w>cement</w> was left near the entrance of the building site.",
                            "target_lang_translations": {
                                "ru": "Большой мешок <w>цемента</w> оставили у входа на стройплощадку.",
                                "zh": "工地入口处留下了一大袋<w>水泥</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bag of cement",
                        "wet cement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серый порошок из известняка и глины, который затвердевает при смешивании с водой и используется в строительстве.",
                        "zh": "一种由石灰石和粘土制成的灰色粉末，加水后会变硬，用于建筑工程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цемент",
                                "target_lang_sense_clarification": "строительный материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水泥",
                                "target_lang_sense_clarification": "建筑材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b998a30-c231-3b0f-9d1a-9ef3216e0641",
                    "sense_definition": "Any substance used to stick things together, such as glue or adhesive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adhesive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist used a special <w>cement</w> to fix the crown onto the tooth.",
                            "target_lang_translations": {
                                "ru": "Стоматолог использовал специальный <w>цемент</w>, чтобы закрепить коронку на зубе.",
                                "zh": "牙医用一种特殊的<w>粘合剂</w>把牙冠固定在牙齿上。"
                            }
                        },
                        {
                            "text": "Rubber <w>cement</w> is often used in paper crafts because it does not wrinkle the pages.",
                            "target_lang_translations": {
                                "ru": "Резиновый <w>клей</w> часто используется в поделках из бумаги, потому что он не деформирует страницы.",
                                "zh": "橡胶<w>胶水</w>常用于纸艺，因为它不会使纸张起皱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glue",
                        "adhesive",
                        "binder"
                    ],
                    "common_phrases": [
                        "rubber cement",
                        "dental cement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое вещество, используемое для склеивания предметов, например, клей или адгезив.",
                        "zh": "任何用于将物体粘合在一起的物质，如胶水或粘合剂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клей",
                                "target_lang_sense_clarification": "адгезивное вещество"
                            },
                            {
                                "target_lang_word": "цемент",
                                "target_lang_sense_clarification": "специальный связующий состав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粘合剂",
                                "target_lang_sense_clarification": "用于粘接的物质"
                            },
                            {
                                "target_lang_word": "胶水",
                                "target_lang_sense_clarification": "通用粘合剂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0452ed2b-1b16-3f10-88a3-42d2edc426bd",
                    "sense_definition": "Something that serves to bind people or things together in a strong union.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "union",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Shared values acted as the <w>cement</w> of their long-lasting friendship.",
                            "target_lang_translations": {
                                "ru": "Общие ценности послужили <w>цементом</w> для их долгой дружбы.",
                                "zh": "共同的价值观成为了他们长久友谊的<w>纽带</w>。"
                            }
                        },
                        {
                            "text": "Common interests are often the <w>cement</w> that holds a community together.",
                            "target_lang_translations": {
                                "ru": "Общие интересы часто являются тем <w>связующим звеном</w>, которое объединяет сообщество.",
                                "zh": "共同的利益往往是维系社区的<w>粘合剂</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bond",
                        "tie",
                        "link"
                    ],
                    "common_phrases": [
                        "cement of friendship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что служит для объединения людей или вещей в прочный союз.",
                        "zh": "指将人或事物紧密结合在一起的纽带。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цемент",
                                "target_lang_sense_clarification": "переносное значение, связующее звено"
                            },
                            {
                                "target_lang_word": "узы",
                                "target_lang_sense_clarification": "то, что связывает людей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纽带",
                                "target_lang_sense_clarification": "起联系作用的事物"
                            },
                            {
                                "target_lang_word": "粘合剂",
                                "target_lang_sense_clarification": "比喻义，指维系关系的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4db57a27-708a-33be-9b0a-25b931c993e2",
                    "sense_definition": "The thin layer of bony tissue that covers the root of a tooth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cement</w> helps to anchor the tooth firmly into the jawbone.",
                            "target_lang_translations": {
                                "ru": "Зубной <w>цемент</w> помогает прочно закрепить зуб в челюстной кости.",
                                "zh": "<w>牙骨质</w>有助于将牙齿牢固地锚定在颌骨中。"
                            }
                        },
                        {
                            "text": "Damage to the <w>cement</w> can lead to increased tooth sensitivity.",
                            "target_lang_translations": {
                                "ru": "Повреждение <w>цемента</w> может привести к повышенной чувствительности зубов.",
                                "zh": "<w>牙骨质</w>受损会导致牙齿敏感度增加。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cementum"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in anatomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий слой костной ткани, покрывающий корень зуба.",
                        "zh": "覆盖在牙根表面的一层薄薄的骨组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цемент",
                                "target_lang_sense_clarification": "анатомический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牙骨质",
                                "target_lang_sense_clarification": "解剖学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9087c92d-f9a7-38ff-815c-cea1a9e3d385",
                    "sense_definition": "To make a relationship, idea, or agreement stronger and more certain.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "strengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two companies signed a deal to <w>cement</w> their partnership for the next decade.",
                            "target_lang_translations": {
                                "ru": "Две компании подписали соглашение, чтобы <w>скрепить</w> свое партнерство на следующее десятилетие.",
                                "zh": "两家公司签署了一项协议，以<w>巩固</w>未来十年的合作伙伴关系。"
                            }
                        },
                        {
                            "text": "Winning the championship helped <w>cement</w> his reputation as a great athlete.",
                            "target_lang_translations": {
                                "ru": "Победа в чемпионате помогла <w>укрепить</w> его репутацию великого атлета.",
                                "zh": "赢得冠军有助于<w>加强</w>他作为伟大运动员的声誉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "solidify",
                        "strengthen",
                        "consolidate"
                    ],
                    "antonyms": [
                        "weaken",
                        "undermine"
                    ],
                    "common_phrases": [
                        "cement a relationship",
                        "cement a deal",
                        "cement a reputation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать отношения, идею или соглашение более прочными и определенными.",
                        "zh": "使关系、想法或协议变得更加稳固和确定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скреплять",
                                "target_lang_sense_clarification": "делать союз или сделку прочнее"
                            },
                            {
                                "target_lang_word": "цементировать",
                                "target_lang_sense_clarification": "укреплять, сплачивать"
                            },
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "делать более стабильным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巩固",
                                "target_lang_sense_clarification": "使稳固"
                            },
                            {
                                "target_lang_word": "加强",
                                "target_lang_sense_clarification": "使更强"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2980b60b-25bd-3eb9-9554-850975e95ad2",
                    "sense_definition": "To join or fix things together using cement or a similar adhesive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "join",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>cement</w> the tiles to the wall carefully to ensure they stay level.",
                            "target_lang_translations": {
                                "ru": "Нужно аккуратно <w>приклеить</w> плитку к стене, чтобы она лежала ровно.",
                                "zh": "你需要小心地将瓷砖<w>粘合</w>在墙上，以确保它们保持水平。"
                            }
                        },
                        {
                            "text": "The pipes were <w>cemented</w> together to prevent any water leaks.",
                            "target_lang_translations": {
                                "ru": "Трубы были <w>скреплены</w> цементом, чтобы предотвратить утечку воды.",
                                "zh": "管道被<w>胶合</w>在一起以防止漏水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bond",
                        "glue",
                        "stick"
                    ],
                    "common_phrases": [
                        "cement together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять или закреплять предметы с помощью цемента или аналогичного клея.",
                        "zh": "使用水泥或类似的粘合剂将物体连接或固定在一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склеивать",
                                "target_lang_sense_clarification": "соединять адгезивом"
                            },
                            {
                                "target_lang_word": "цементировать",
                                "target_lang_sense_clarification": "соединять раствором"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粘合",
                                "target_lang_sense_clarification": "用胶粘接"
                            },
                            {
                                "target_lang_word": "胶合",
                                "target_lang_sense_clarification": "用胶水固定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52dd8dea-5e39-3f90-8bcc-bcd6ef5ed76c",
                    "sense_definition": "To cover a surface with a layer of cement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>cement</w> the garden path to make it easier to walk on.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>зацементировать</w> садовую дорожку, чтобы по ней было удобнее ходить.",
                                "zh": "他们决定给花园小径<w>铺水泥</w>，这样走起来更方便。"
                            }
                        },
                        {
                            "text": "The workers will <w>cement</w> the floor of the garage tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>зальют цементом</w> пол в гараже завтра утром.",
                                "zh": "工人们明天早上将为车库地面<w>浇筑</w>水泥。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pave",
                        "surface"
                    ],
                    "common_phrases": [
                        "cement a floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность слоем цемента.",
                        "zh": "在表面覆盖一层水泥。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цементировать",
                                "target_lang_sense_clarification": "покрывать раствором"
                            },
                            {
                                "target_lang_word": "заливать цементом",
                                "target_lang_sense_clarification": "создавать покрытие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铺水泥",
                                "target_lang_sense_clarification": "覆盖水泥层"
                            },
                            {
                                "target_lang_word": "浇筑",
                                "target_lang_sense_clarification": "用水泥覆盖地面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
