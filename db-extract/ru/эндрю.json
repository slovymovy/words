                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f20c72e9-e63d-3990-9025-b021d62cf329",
                                        "entry_id": "2c6fb3aa-d481-3abc-a35f-ed2bf8d36a64",
                                        "glosses": [
                                            "The Royal Navy."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fadb6a3c-4091-48b3-8c38-bbb93f7de565",
                                                "sense_id": "f20c72e9-e63d-3990-9025-b021d62cf329",
                                                "text": "A common British catch phrase is, \"You shouldn't have joined Andrew if you couldn't take a joke.\""
                                            },
                                            {
                                                "example_id": "cb473c4b-765b-40ca-b985-3c6edd00524a",
                                                "sense_id": "f20c72e9-e63d-3990-9025-b021d62cf329",
                                                "text": "“Me muvver always said I should a joined the Andrew.” (Royal Navy.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
