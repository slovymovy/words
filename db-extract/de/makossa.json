                        ],
                        "examples": [
                            {
                                "example_id": "4b70ebab-5f9a-489b-9152-e843e1f05121",
                                "sense_id": "df5476a4-c67a-333b-9aa2-8886a6fcc5c3",
                                "text": "Makossa ist die Musikrichtung bzw. der Rhythmus, die/der in der Nordwestprovinz rund um Bamenda zu Hause ist."
                            },
                            {
                                "example_id": "78bdede4-29d1-499c-941a-ba46bb9870ff",
                                "sense_id": "df5476a4-c67a-333b-9aa2-8886a6fcc5c3",
                                "text": "Die Wurzeln des Makossa sind wie beim Bikutsi in der Volksmusik zu finden, der Makossa hat sich in den Städten mittlerweile zu einer beliebten, meist elektrisch verstärkten Form der Tanzmusik entwickelt, wobei einige Musiker sich einen internationalen Ruf erarbeiten konnten."
                            }
                        ],
