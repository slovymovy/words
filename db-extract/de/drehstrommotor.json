                "senses": [
                    {
                        "sense_id": "6e2769df-b01f-3cb6-830c-ab5461041799",
                        "entry_id": "3c5454a1-3d17-3b4a-ac65-0c2b8ffd6bcf",
                        "glosses": [
                            "mit Drehstrom angetriebener Wechselstrommotor, zur Umwandlung elektrischer in mechanische Energie"
                        ],
                        "tags": [
                            "Wechselstrommaschine"
                        ],
                        "examples": [
                            {
                                "example_id": "2416fbc9-1a5c-4a23-a63c-a4c86aa106bb",
                                "sense_id": "6e2769df-b01f-3cb6-830c-ab5461041799",
                                "text": "„Aufbau und Wirkungsweise eines Drehstrommotors basieren auf einem sogenannten Drehfeld, welches von einem dreiphasigen Wechselstrom (=Drehstrom) gespeist wird.“"
                            },
                            {
                                "example_id": "99a1f2d8-eddd-40f3-a86c-0b2819b61703",
                                "sense_id": "6e2769df-b01f-3cb6-830c-ab5461041799",
                                "text": "„Der Drehstrommotor wird im Gegensatz zum Gleichstrommotor mit einem dreiphasigen Wechselstrom betrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
