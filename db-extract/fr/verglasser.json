                "senses": [
                    {
                        "sense_id": "8e087163-5dbe-3975-bc44-13ad57da2f82",
                        "entry_id": "37be4f1d-5491-308b-8d27-4e2306357de1",
                        "glosses": [
                            "Faire du verglas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c30b6e8-89b3-4902-9535-f31331206334",
                                "sense_id": "8e087163-5dbe-3975-bc44-13ad57da2f82",
                                "text": "Et plus vivace encore me revient le souvenir du pays natal, perdu là-bas dans les lointaines collines du Perche, où il neige et verglasse sans doute à cette heure, pendant qu’ici la douce nuit étoilée répand un peu de ce charme qui fait tant aimer l’Algérie."
                            },
                            {
                                "example_id": "8ff361c4-c476-4c19-a78e-797f17a5762f",
                                "sense_id": "8e087163-5dbe-3975-bc44-13ad57da2f82",
                                "text": "C’est la pire nuit. Il neige et il pleut et il grêle et il vente et il verglasse."
                            }
                        ]
                    }
                ],
