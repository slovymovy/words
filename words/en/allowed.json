                    "sense_definition": "Acknowledged or admitted to be true.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acknowledgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is generally <w>allowed</w> that the new policy has failed.",
                            "target_lang_translations": {
                                "ru": "Обще<w>признано</w>, что новая политика провалилась.",
                                "cs": "Obecně se <w>uznává</w>, že nová politika selhala.",
                                "de": "Es wird allgemein <w>anerkannt</w>, dass die neue Politik gescheitert ist.",
                                "fr": "Il est généralement <w>admis</w> que la nouvelle politique a échoué.",
                                "zh": "人们普遍<w>承认</w>这项新政策已经失败了。"
                            }
                        },
                        {
                            "text": "The <w>allowed</w> facts of the case were not open to debate.",
                            "target_lang_translations": {
                                "ru": "<w>Признанные</w> факты по делу не подлежали обсуждению.",
                                "cs": "<w>Uznaná</w> fakta případu nebyla předmětem diskuse.",
                                "de": "Die <w>zugestandenen</w> Fakten des Falls standen nicht zur Debatte.",
                                "fr": "Les faits <w>admis</w> de l'affaire n'étaient pas sujets à débat.",
                                "zh": "案件中已被<w>承认</w>的事实不容争辩。"
                            }
                        }
                    ],
