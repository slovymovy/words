                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is goed voor uitgeputte grond om een jaar <w>braak</w> te liggen.",
                            "target_lang_translations": {
                                "en": "It is good for exhausted soil to lie <w>fallow</w> for a year."
                            }
                        },
                        {
                            "text": "Nadat de boerderij werd verlaten, kwam de akker <w>braak</w> te liggen.",
                            "target_lang_translations": {
                                "en": "After the farm was abandoned, the field came to lie <w>fallow</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "braak liggen"
                    ],
                    "target_lang_definitions": {
                        "en": "In a state where land is no longer being cultivated"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fallow",
                                "target_lang_sense_clarification": "lying uncultivated"
                            }
                        ]
                    }
                }
            ]
        },
        {
