                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "596cf07f-cc1c-34f5-9fa2-31a1569d453f",
                                        "entry_id": "3ff0fa52-18d6-38db-9ee7-e97a0bdb8f1b",
                                        "glosses": [
                                            "Most recently begun or formed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa296faa-e3dc-4335-95cf-5ed68a654ac0",
                                                "sense_id": "596cf07f-cc1c-34f5-9fa2-31a1569d453f",
                                                "text": "I may be the youngest in my family but I still resent being referred to as the baby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78a4e234-133b-3616-b66a-aecb7766ec7e",
                                        "entry_id": "3ff0fa52-18d6-38db-9ee7-e97a0bdb8f1b",
                                        "glosses": [
                                            "Receiving dealt cards last, i.e. immediately before the next deal to the eldest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "youngest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d3fae55-a2ab-32da-a90a-2ea2ca7a6426",
                                        "entry_id": "367c6508-0157-349d-a180-0d6fbc9d1b2d",
                                        "glosses": [
                                            "The youngest child in a family, or individual in a group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a473fb4-ecd8-4071-a4dd-bd893433cd3d",
                        "source_entry_id": "ce1713b2-aed7-3ee9-94ee-a69931088541",
                        "target_lang_word": "baby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89d7d804-9a5a-32f8-a4bf-a5d9029682f1",
                                        "entry_id": "e091dd56-4d4d-3516-8388-54d59b8b0a82",
                                        "glosses": [
                                            "Picked when small and immature (as in baby corn, baby potatoes)."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38d7379e-afc0-318a-b404-c41732f5c846",
                                        "entry_id": "e091dd56-4d4d-3516-8388-54d59b8b0a82",
                                        "glosses": [
                                            "Newest (overall, or in some group or state); most inexperienced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed484d4c-ed78-4328-93a5-74326806a4a1",
                                                "sense_id": "38d7379e-afc0-318a-b404-c41732f5c846",
                                                "text": "Mrs. Paull held out her hand to the babyest of the quartette, as they tiptoed up to the bed. “Lift her up, please, Marie!” she said, motioning to the place enclosed by her arm. When the rosy cheek touched hers upon the pillow, she asked ..."
                                            },
                                            {
                                                "example_id": "05dec3b6-ac18-4666-ab59-71c9b4ea883e",
                                                "sense_id": "38d7379e-afc0-318a-b404-c41732f5c846",
                                                "text": "That evening, we grouped about the fire in the parlor, a wide circle that left room for the babyest of the party to disport themselves upon the rug, in the glow of the grate piled with cannel coal."
                                            },
                                            {
                                                "example_id": "c60ba753-29e4-461d-83f3-2754f9e526ac",
                                                "sense_id": "38d7379e-afc0-318a-b404-c41732f5c846",
                                                "text": "Of when I was a baby editor. Very baby, it was actually a kind of work experience, I was still at university but I knew what I wanted. With a small independent publisher, good reputation, did some marvellous books, […]"
                                            },
                                            {
                                                "example_id": "e6768252-f215-44e8-bcbd-247adecb1c49",
                                                "sense_id": "38d7379e-afc0-318a-b404-c41732f5c846",
                                                "text": "[…] party for Halloween proper? Just the four of us and some goofy, spooky kids' movies, you know? Some cute pumpkin-shaped cupcakes? I could make my dog a little costume. He could be a baby witch. The babyest Scapegracer.” I blinked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                                        "entry_id": "e091dd56-4d4d-3516-8388-54d59b8b0a82",
                                        "glosses": [
                                            "Like or pertaining to a baby, in size or youth; small, young."
                                        ],
                                        "tags": [
                                            "in the comparative or superlative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4331f41d-6b2f-42ae-8985-0601226e4e79",
                                                "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                                                "text": "Spider. Here let us begin at the beginning, at the babyest of books for Edith's nursery."
                                            },
                                            {
                                                "example_id": "f1c7805c-049a-4b54-a51e-8b07e3600b6d",
                                                "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                                                "text": "She let it drop out of her sleeve, and it was two Chings — the dearest, littlest, babyest, tiny Chings — little balls of fur! And she ran away, and daddy's father picked them up, and put them in his pockets, and brought them home, […]"
                                            },
                                            {
                                                "example_id": "949d04bf-b86a-423c-9ea6-e3fde5301d17",
                                                "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                                                "text": "Lemon-juice for ink spots: Not many weeks ago the babyest member of our household - perhaps moved by a hereditary tendency toward ink - slinging - divided the contents of an ink bottle impartially between the tiles of the bath-room floor ..."
                                            },
                                            {
                                                "example_id": "61984765-e8cd-4e7c-bb97-34b0720b908f",
                                                "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                                                "text": "\"There's a babier baby than Mike,\" she said. \"But you will see her to-morrow. Aren't we rich? Come in and see Matilda - you won't find her much changed. It's so absurd to see her with all these children.\""
                                            },
                                            {
                                                "example_id": "4e0619d4-2c6c-452f-b198-dede8c4d25b5",
                                                "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                                                "text": "Now, we all believe in national defense, but we also believe in peacetime activity, and my personal idea about aviation is that it is still in its absolute “babyest” type of infancy, that it is nothing even approaching what it will be even 10 years [from now]."
                                            },
                                            {
                                                "example_id": "d4d6e08d-bafe-4bfb-af64-f3be6ca954ef",
                                                "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                                                "text": "A doll show held the attention of children at Allen as a special feature during the week. Winners were:[…]baby-est doll, Betty McQueary."
                                            },
                                            {
                                                "example_id": "8aa69a47-5317-4483-9379-8d4b198259d6",
                                                "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                                                "text": "He’ll [Joseph H. Ball] be our baby senator for the next two years. Senator Rush D. Holt of West Virginia will be his baby rival briefly, but Rush is a lame duck. He’ll be out of the picture at the end of the year and Joe will be the baby-est of them all."
                                            },
                                            {
                                                "example_id": "e2210e2b-e7fc-446f-bc15-2643fbb91a4d",
                                                "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                                                "text": "The victorious individuals were as follows: Doll Contest—[…]“baby-est,” 1st, Mary Grew, 2nd, Susan Shamlian;"
                                            },
                                            {
                                                "example_id": "a574ca8a-eaad-4535-ac84-50a5c4d37d2d",
                                                "sense_id": "56535f6b-6196-3f85-b598-7136fa64129a",
                                                "text": "One of them, Allure Potemkin (and don’t you wish that was your name?), hikes up her slip and does a riotous dance number called Baby Legs. Leona Brausen, whose own dimpled gams — “baby-er than ever” as she says — inspired the role, is back onstage Saturday to dance the dance for the last time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2bd32da-5efb-3391-bcec-46034dd1e1cd",
                                        "entry_id": "97c30872-94fe-30af-9beb-e0b680664337",
                                        "glosses": [
                                            "To coddle; to pamper somebody like an infant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "def8a59d-adda-48c5-b8ae-bbc685d6bd5f",
                                                "sense_id": "f2bd32da-5efb-3391-bcec-46034dd1e1cd",
                                                "text": "[…] though he tried to be gruff and mature, he yielded to her and was glad to be babied."
                                            },
                                            {
                                                "example_id": "b0538b43-b430-44ca-96b9-2a1f7f3d5b92",
                                                "sense_id": "f2bd32da-5efb-3391-bcec-46034dd1e1cd",
                                                "text": "Then the man effected measles and stayed off the job for six weeks, babying himself at home, though he lived just round the corner from my half-built house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "053c8e3b-857b-33d9-92af-6525c14925c8",
                                        "entry_id": "97c30872-94fe-30af-9beb-e0b680664337",
                                        "glosses": [
                                            "To tend (something) with care; to be overly attentive to (something), fuss over."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d4405b6-6c1f-421b-b994-c52467e1cc51",
                                                "sense_id": "053c8e3b-857b-33d9-92af-6525c14925c8",
                                                "text": "In the past 27 years, \"Mr. Mac,\" as he is known to his 46,000 teammates, has built and babied his McDonnell Co. from nothing into a $1 billion-a-year corporation."
                                            },
                                            {
                                                "example_id": "5793642f-7698-460b-8365-d6dc2ad9b73a",
                                                "sense_id": "053c8e3b-857b-33d9-92af-6525c14925c8",
                                                "text": "1912, Linda Craig, interviewed by Theresa Forte, \"Tree and Twig farm — a treasure chest of heirloom tomatoes,\" Welland Tribune, 25 May, 2012, https://web.archive.org/web/20171205052150/http://www.wellandtribune.ca/2012/05/23/tree-and-twig-farm--a-treasure-chest-of-heirloom-tomatoes\nI have grown them for years and although some years are better than others, I have always had loads of tomatoes by not babying them, going easy on the water, and fertilizing with compost in the planting hole."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b3b9de8-e529-3ea6-8b4f-9140ab7b51d9",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "A very young human, particularly from birth to a couple of years old or until walking is fully mastered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d68fb81f-fa61-4e3a-a9f5-2412c49cc62b",
                                                "sense_id": "0b3b9de8-e529-3ea6-8b4f-9140ab7b51d9",
                                                "text": "The baby new to earth and sky,\n⁠What time his tender palm is prest\n⁠Against the circle of the breast,\nHas never thought that ‘this is I:’ […]"
                                            },
                                            {
                                                "example_id": "6951c172-c198-43ab-8ed7-f3e5d803bf56",
                                                "sense_id": "0b3b9de8-e529-3ea6-8b4f-9140ab7b51d9",
                                                "text": "In that film, I often hid my head in my hands, unable to watch scenes about dead babies and diving into gruesome lavatories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef250b3-c4c6-364d-96aa-bf93f76d9432",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "A very young human, even if not yet born."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2795049b-2622-428d-ab7c-c12cc3a93000",
                                                "sense_id": "2ef250b3-c4c6-364d-96aa-bf93f76d9432",
                                                "text": "When is your baby due?"
                                            },
                                            {
                                                "example_id": "c83cbc6f-5064-4af3-afff-04eed6ed798c",
                                                "sense_id": "2ef250b3-c4c6-364d-96aa-bf93f76d9432",
                                                "text": "Her baby had always been active, even before he was born, when he would kick her bladder."
                                            },
                                            {
                                                "example_id": "3c9e44d1-81ca-46b0-8876-af44cc0ac3c8",
                                                "sense_id": "2ef250b3-c4c6-364d-96aa-bf93f76d9432",
                                                "text": "Karen went to England to have her baby several months before he was born so he would have the medication she needed before the baby was born and she wanted the doctors she was used to when she lived there. It would be cheaper to have the baby in England. Karen named the baby Bill Joseph […] He laughed a lot and loved his bath which he took in a plastic baby tub."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03db69e5-24dc-31f9-bd34-6e44a5274ad3",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "Any very young animal, especially a vertebrate; many species have specific names for their babies, such as kittens for the babies of cats, puppies for the babies of dogs, and chicks for the babies of birds. See :Category:Baby animals for more."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c28c7f59-2867-35fb-a150-2f0fec6615d4",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "A person who is immature, infantile, or feeble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "362e42f9-b635-445a-ab97-c4378c003bec",
                                                "sense_id": "c28c7f59-2867-35fb-a150-2f0fec6615d4",
                                                "text": "Stand up for yourself – don't be such a baby!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ffb75c5-9276-37ef-bd80-eef0e73ae330",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "A person who is new to or inexperienced in something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41c9970f-d353-4589-aa32-f766220fb223",
                                                "sense_id": "8ffb75c5-9276-37ef-bd80-eef0e73ae330",
                                                "text": "I only qualified as an architect this summer, so I'm still a baby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "175831e0-128c-3551-b08f-a835120204af",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "The lastborn of a family; the youngest sibling, irrespective of age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9621d74c-ed11-4b32-bf08-7bcbf7310d4c",
                                                "sense_id": "175831e0-128c-3551-b08f-a835120204af",
                                                "text": "\"You are very dull this morning, Sheriff,\" said the youngest daughter of the house, who, being the baby and pretty, had grown pettishly privileged in speech."
                                            },
                                            {
                                                "example_id": "5c44dd05-aedd-4278-bb31-25f32ab13972",
                                                "sense_id": "175831e0-128c-3551-b08f-a835120204af",
                                                "text": "\"He's a year older than me.\" \"You're the baby, eh?\""
                                            },
                                            {
                                                "example_id": "2936438d-9a21-4c56-8b15-8a892baad90b",
                                                "sense_id": "175831e0-128c-3551-b08f-a835120204af",
                                                "text": "Adam is the baby of the family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e12eb6-0434-390c-8000-f14f7d780a19",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "A person's romantic partner; a term of endearment used to refer to or address e.g. one's girlfriend, boyfriend, or spouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "071f5ad8-4c4f-4d01-a4cf-335069604d67",
                                                "sense_id": "94e12eb6-0434-390c-8000-f14f7d780a19",
                                                "text": "Too busy thinking about my baby, and I ain't got time for nothing else."
                                            },
                                            {
                                                "example_id": "520f8da9-6c28-458b-80f0-1e509345ee2b",
                                                "sense_id": "94e12eb6-0434-390c-8000-f14f7d780a19",
                                                "text": "Baby, don't cry."
                                            },
                                            {
                                                "example_id": "fe24d277-c7a2-4525-9f7a-60dfe7274a03",
                                                "sense_id": "94e12eb6-0434-390c-8000-f14f7d780a19",
                                                "text": "Well, since my baby left me,\nWell, I found a new place to dwell.\nWell, it's down at the end of Lonely Street\nAt Heartbreak Hotel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c328ee1e-b54c-3db2-bce5-fa8556f744d1",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "A form of address to a person considered to be attractive."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14ea386b-5e88-433b-8511-162e59d714e4",
                                                "sense_id": "c328ee1e-b54c-3db2-bce5-fa8556f744d1",
                                                "text": "Hey baby, what are you doing later?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f7bcecc-383c-3cd4-b176-ac40b10bc084",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "A concept or creation endeared by its creator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d5ae144-099b-4e0d-a264-613bb4f320ac",
                                                "sense_id": "8f7bcecc-383c-3cd4-b176-ac40b10bc084",
                                                "text": "This test program I've designed is my new baby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c83be271-ccf9-3455-9fa2-d376a878ca68",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "A pet project or responsibility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359ad5a3-26b7-4788-bfe3-a709f5a0efc9",
                                                "sense_id": "c83be271-ccf9-3455-9fa2-d376a878ca68",
                                                "text": "You need to talk to John about that – it's his baby."
                                            },
                                            {
                                                "example_id": "d1f8a68f-9208-4c5e-95e9-27bb065c158a",
                                                "sense_id": "c83be271-ccf9-3455-9fa2-d376a878ca68",
                                                "text": "Sovnarkom was Lenin's baby, it was where he focused all his energies […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e57ba136-6e78-3c44-a868-b8a76831b8a6",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "An affectionate term for anything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3aa4cb6-c74f-4fde-a4b0-6ea983c0c8c8",
                                                "sense_id": "e57ba136-6e78-3c44-a868-b8a76831b8a6",
                                                "text": "See my new car here? I can't wait to take this baby for a drive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99145bfe-2748-343a-abea-b6b3854997e1",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "A small image of an infant; a doll."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6ca5ff1-d2fc-3eaa-a388-5744f043da30",
                                        "entry_id": "541a0534-9e63-3e92-aa12-e8677f372dcd",
                                        "glosses": [
                                            "One who is new to an identity or community."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e79db0d2-5389-442e-b649-71b728ffdb6f",
                                                "sense_id": "d6ca5ff1-d2fc-3eaa-a388-5744f043da30",
                                                "text": "baby queer; baby trans"
                                            },
                                            {
                                                "example_id": "3666cfd8-3f6b-405c-b60d-76640bff6df3",
                                                "sense_id": "d6ca5ff1-d2fc-3eaa-a388-5744f043da30",
                                                "text": "These more general spells and rituals can also be helpful for baby witches, who might want more time to practice before they hop into highly-specific spells."
                                            },
                                            {
                                                "example_id": "53c5c1ea-326e-46d1-be72-7bafdd4f0cd3",
                                                "sense_id": "d6ca5ff1-d2fc-3eaa-a388-5744f043da30",
                                                "text": "That was even worse than blurting my sexuality like I had when I was what we called a “baby dyke” in college, desperate to find other lesbians for friendship or more."
                                            },
                                            {
                                                "example_id": "119a39a3-47aa-476e-85da-bc58a2f22edd",
                                                "sense_id": "d6ca5ff1-d2fc-3eaa-a388-5744f043da30",
                                                "text": "As someone who is still a 'baby trans', these collaborations have taught me so much about what it means to live outside cisnormativity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
