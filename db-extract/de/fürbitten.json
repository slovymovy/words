            {
                "entry_id": "eaa9d0c2-1333-3318-b5c8-83ed86578773",
                "word": "fürbitten",
                "pos": "verb",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "162f6990-8c6d-4c68-ba03-b2d73c34b71a",
                        "entry_id": "eaa9d0c2-1333-3318-b5c8-83ed86578773",
                        "tags": [
                            "auxiliary",
                            "perfect"
                        ],
                        "form": "haben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29f0445c-b7ab-344c-b58c-4eab648f44d2",
                        "entry_id": "eaa9d0c2-1333-3318-b5c8-83ed86578773",
                        "glosses": [
                            "für jemand anderen ein Gebet sprechen; Fürbitte leisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970b9cd1-1d6e-4a02-8e56-79a1e6e6b0ba",
                                "sense_id": "29f0445c-b7ab-344c-b58c-4eab648f44d2",
                                "text": "Wir ehren unsere heiligen Patrone, damit sie erfolgreich für uns fürbitten, dass Gott unser Vater uns vom Feuer der Hölle erlöse."
                            },
                            {
                                "example_id": "03d3b8c2-7063-452d-bdb4-17c65c1b7e55",
                                "sense_id": "29f0445c-b7ab-344c-b58c-4eab648f44d2",
                                "text": "„Der Lehrer erzählt, wie der Bischof Flavian vor dem erzürnten Kaiser Theodosius erscheint, um für die Antiochener fürzubitten, und wie Theodosius sich erweichen läßt und den Antiochenern die arge Aeußerung ihres Unwillens verzeiht.“"
                            },
                            {
                                "example_id": "da126449-c94f-4232-a587-e8fe8478172d",
                                "sense_id": "29f0445c-b7ab-344c-b58c-4eab648f44d2",
                                "text": "„fürbitten für einen, dasz er keine schläge bekomme“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87c4b12e-b4a8-4734-b1ff-462fd00423e5",
                        "source_entry_id": "eaa9d0c2-1333-3318-b5c8-83ed86578773",
                        "source_sense_id": "29f0445c-b7ab-344c-b58c-4eab648f44d2",
                        "source_sense_description": "für jemand anderen ein Gebet sprechen; Fürbitte leisten",
                        "target_lang_word": "intercéder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intercéder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d73f29b3-d618-39ba-807b-3ffe4bf1adf1",
                                        "entry_id": "2eb66dfe-77e9-3751-b14a-370eb5808e75",
                                        "glosses": [
                                            "Prier, solliciter pour quelqu’un, afin de lui procurer quelque bien ou de le garantir de quelque mal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3232644b-e73e-4b57-b52c-b132ec1285e6",
                                                "sense_id": "d73f29b3-d618-39ba-807b-3ffe4bf1adf1",
                                                "text": "Sous ces tuiles et ces lattes disjointes, quatre chrétiens allaient intercéder auprès de Dieu pour un Roi de France, et faire son convoi sans cercueil."
                                            },
                                            {
                                                "example_id": "3839cf2e-fe78-47ff-a928-9487d3a0dbe8",
                                                "sense_id": "d73f29b3-d618-39ba-807b-3ffe4bf1adf1",
                                                "text": "C’est qu’il a une faveur à me demander : celle d’intercéder pour lui auprès de l’omnipotent grand vizir. Car il paraît qu’il est assez mal noté en haut lieu et il craint de perdre son poste."
                                            },
                                            {
                                                "example_id": "c829cb22-8f90-4336-af5b-3ca0ffa11277",
                                                "sense_id": "d73f29b3-d618-39ba-807b-3ffe4bf1adf1",
                                                "text": "Il était venu la veille au soir, affolé, me prier d’intercéder pour un ami dont des chenapans avaient malmené la signature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
