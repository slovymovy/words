                                "sense_id": "0e28b86f-1636-309a-871f-ee0df2e96372",
                                "text": "Dyfrakcja to jedno z podstawowych zjawisk falowych – obok interferencji, odbicia, załamania."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
