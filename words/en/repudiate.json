{
    "word_family": [
        "repudiation",
        "repudiator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9026bdb7-69e6-38e4-9fed-03ab93b645d0",
                    "sense_definition": "To reject the truth or validity of something; to deny.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reject",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>repudiate</w> the false claims made by the opposition party."
                        },
                        {
                            "text": "It is difficult to <w>repudiate</w> the evidence presented in such a detailed report."
                        }
                    ],
                    "synonyms": [
                        "deny",
                        "contradict"
                    ],
                    "antonyms": [
                        "accept"
                    ],
                    "common_phrases": [
                        "repudiate claims",
                        "repudiate evidence"
                    ]
                },
                {
                    "sense_id": "20f3fcd9-9342-3ae8-a354-01b27e1cb007",
                    "sense_definition": "To refuse to have any relation to; to disown or reject a belief or person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reject",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician had to <w>repudiate</w> his former radical views to gain public support."
                        },
                        {
                            "text": "She chose to <w>repudiate</w> her family after they refused to support her career choices."
                        }
                    ],
                    "synonyms": [
                        "disavow",
                        "disown",
                        "renounce"
                    ],
                    "common_phrases": [
                        "repudiate views",
                        "repudiate past"
                    ]
                },
                {
                    "sense_id": "cc341a56-c777-38fc-a5e4-5c60ce7ff9ad",
                    "sense_definition": "To refuse to pay or honor a debt or contract.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reject",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company attempted to <w>repudiate</w> the debt by claiming the contract was invalid."
                        },
                        {
                            "text": "It is illegal for a country to <w>repudiate</w> its international financial obligations."
                        }
                    ],
                    "synonyms": [
                        "welsh"
                    ],
                    "antonyms": [
                        "requite"
                    ],
                    "common_phrases": [
                        "repudiate debt",
                        "repudiate contract"
                    ]
                }
            ]
        }
    ]
