{
    "word_family": [
        "lifter",
        "lifting",
        "uplift",
        "shoplift",
        "airlift",
        "weightlift"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc3f65cb-a8a6-3c96-bf69-34e52581edeb",
                    "sense_definition": "A mechanical device for vertically transporting goods or people between floors in a building.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transportation_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take the <w>lift</w> to the fourth floor to find the manager's office.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, поднимитесь на <w>лифте</w> на четвертый этаж, чтобы найти кабинет менеджера."
                            }
                        },
                        {
                            "text": "The <w>lift</w> is currently out of order, so we have to use the stairs.",
                            "target_lang_translations": {
                                "ru": "<w>Лифт</w> сейчас не работает, поэтому нам придется идти по лестнице."
                            }
                        }
                    ],
                    "synonyms": [
                        "elevator"
                    ],
                    "common_phrases": [
                        "take the lift",
                        "passenger lift",
                        "service lift"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическое устройство для вертикального перемещения грузов или людей между этажами в здании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лифт",
                                "target_lang_sense_clarification": "в здании"
                            },
                            {
                                "target_lang_word": "подъёмник",
                                "target_lang_sense_clarification": "механизм для подъёма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c84f0c5-0dfd-3e01-8a21-02fa85ad6005",
                    "sense_definition": "The act of transporting someone in a vehicle; a free ride.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transportation_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave me a <w>lift</w> to the bus station because it was raining.",
                            "target_lang_translations": {
                                "ru": "Он <w>подвез</w> меня до автовокзала, потому что шел дождь."
                            }
                        },
                        {
                            "text": "I need a <w>lift</w> home after the party tonight.",
                            "target_lang_translations": {
                                "ru": "Мне нужно, чтобы кто-нибудь <w>подбросил</w> меня домой после вечеринки сегодня."
                            }
                        }
                    ],
                    "synonyms": [
                        "ride"
                    ],
                    "common_phrases": [
                        "give a lift",
                        "need a lift",
                        "offer a lift"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт перевозки кого-либо на транспортном средстве; бесплатная поездка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвезти",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "попутка",
                                "target_lang_sense_clarification": "бесплатная поездка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee85b7e3-208f-306e-b083-610ca59746dc",
                    "sense_definition": "An improvement in mood or spirits.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The good news gave her a real <w>lift</w> after a difficult week.",
                            "target_lang_translations": {
                                "ru": "Хорошие новости вызвали у нее настоящий душевный <w>подъём</w> после тяжелой недели."
                            }
                        },
                        {
                            "text": "Seeing his old friends gave him a noticeable <w>lift</w> in spirits.",
                            "target_lang_translations": {
                                "ru": "Встреча со старыми друзьями заметно <w>подняла</w> ему настроение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a lift",
                        "needed a lift"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшение настроения или душевного состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "душевный"
                            },
                            {
                                "target_lang_word": "воодушевление",
                                "target_lang_sense_clarification": "эмоциональное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e24272c9-4555-3286-ae8e-91b6876dae61",
                    "sense_definition": "An act of lifting or raising something physically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With one powerful <w>lift</w>, he moved the heavy box onto the shelf.",
                            "target_lang_translations": {
                                "ru": "Одним мощным <w>рывком</w> он поднял тяжелую коробку на полку."
                            }
                        },
                        {
                            "text": "The athlete completed a clean <w>lift</w> during the competition.",
                            "target_lang_translations": {
                                "ru": "Атлет выполнил чистое <w>поднятие</w> во время соревнований."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heavy lift"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт физического поднятия или перемещения чего-либо вверх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднятие",
                                "target_lang_sense_clarification": "физическое действие"
                            },
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "действие по значению поднимать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58c76894-84c3-3d10-bcb4-a38187eed8a7",
                    "sense_definition": "The upward force that keeps an aircraft aloft, generated by wings or airfoils.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plane's wings are designed to generate maximum <w>lift</w> during takeoff.",
                            "target_lang_translations": {
                                "ru": "Крылья самолета спроектированы так, чтобы создавать максимальную <w>подъёмную силу</w> при взлете."
                            }
                        },
                        {
                            "text": "Without enough speed, the aircraft cannot produce the <w>lift</w> required to fly.",
                            "target_lang_translations": {
                                "ru": "Без достаточной скорости самолет не может создать <w>подъёмную силу</w>, необходимую для полета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "generate lift",
                        "aerodynamic lift"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Направленная вверх сила, удерживающая самолет в воздухе, создаваемая крыльями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъёмная сила",
                                "target_lang_sense_clarification": "аэродинамическая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e28e26a9-8da4-34ad-afff-ffc74638e27d",
                    "sense_definition": "The sky, the heavens, or the atmosphere.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "celestial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun must be high in the <w>lift</w> before we venture out.",
                            "target_lang_translations": {
                                "ru": "Солнце должно подняться высоко в <w>небосвод</w>, прежде чем мы рискнем выйти."
                            }
                        },
                        {
                            "text": "Birds soared high into the blue <w>lift</w> above the hills.",
                            "target_lang_translations": {
                                "ru": "Птицы парили высоко в синей <w>выси</w> над холмами."
                            }
                        }
                    ],
                    "synonyms": [
                        "air",
                        "atmosphere",
                        "welkin"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or regional"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небо, небеса или атмосфера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высь",
                                "target_lang_sense_clarification": "литературно"
                            },
                            {
                                "target_lang_word": "небосвод",
                                "target_lang_sense_clarification": "поэтически"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7e7c0da-5113-3bb9-9ba7-02d72319176f",
                    "sense_definition": "To move something to a higher position; to raise.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>lift</w> your feet so I can vacuum the rug.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>поднимите</w> ноги, чтобы я мог пропылесосить ковер."
                            }
                        },
                        {
                            "text": "He had to <w>lift</w> the heavy suitcase onto the top shelf.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>поднимать</w> тяжелый чемодан на верхнюю полку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lift up",
                        "lift a finger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переместить что-либо в более высокое положение; поднять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "перемещать вверх"
                            },
                            {
                                "target_lang_word": "поднять",
                                "target_lang_sense_clarification": "завершённое действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee8dce39-eae7-3b13-a8d4-c59dd6ebd656",
                    "sense_definition": "To officially end or remove a ban, restriction, or rule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>lift</w> the ban on international travel next month.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>снять</w> запрет на международные поездки в следующем месяце."
                            }
                        },
                        {
                            "text": "They will <w>lift</w> the restrictions once the situation is safe.",
                            "target_lang_translations": {
                                "ru": "Они <w>отменят</w> ограничения, как только ситуация станет безопасной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lift a ban",
                        "lift restrictions",
                        "lift a curfew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально прекратить или отменить запрет, ограничение или правило."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "запрет или ограничения"
                            },
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "правило"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd6c4017-47b1-3e30-a6b7-6552e7287871",
                    "sense_definition": "To engage in weightlifting as a form of exercise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>lifts</w> twice a week at the local gym to stay strong.",
                            "target_lang_translations": {
                                "ru": "Она <w>качается</w> дважды в неделю в местном спортзале, чтобы оставаться сильной."
                            }
                        },
                        {
                            "text": "He started to <w>lift</w> weights to improve his athletic performance.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>поднимать</w> веса, чтобы улучшить свои спортивные результаты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lift weights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься тяжелой атлетикой или силовыми упражнениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качаться",
                                "target_lang_sense_clarification": "разг. тренироваться"
                            },
                            {
                                "target_lang_word": "жать",
                                "target_lang_sense_clarification": "выполнять жим"
                            },
                            {
                                "target_lang_word": "поднимать веса",
                                "target_lang_sense_clarification": "упражняться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc85f6f8-a7fd-3f00-84cb-162b91c962c7",
                    "sense_definition": "To alleviate or reduce a negative feeling like pressure, tension, or stress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winning the game helped <w>lift</w> the pressure from the coach.",
                            "target_lang_translations": {
                                "ru": "Победа в игре помогла <w>снять</w> давление с тренера."
                            }
                        },
                        {
                            "text": "The apology served to <w>lift</w> the tension in the room.",
                            "target_lang_translations": {
                                "ru": "Извинение помогло <w>разрядить</w> обстановку в комнате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lift the pressure",
                        "lift the mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Облегчить или уменьшить негативное чувство, такое как давление, напряжение или стресс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снять",
                                "target_lang_sense_clarification": "напряжение или давление"
                            },
                            {
                                "target_lang_word": "разрядить",
                                "target_lang_sense_clarification": "обстановку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4d6b3f8-6316-3b32-bc48-816e531e6eb2",
                    "sense_definition": "To steal something, especially in a casual or sneaky way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was caught trying to <w>lift</w> a watch from the jewelry store.",
                            "target_lang_translations": {
                                "ru": "Его поймали при попытке <w>стащить</w> часы из ювелирного магазина."
                            }
                        },
                        {
                            "text": "The thief managed to <w>lift</w> her wallet without her noticing.",
                            "target_lang_translations": {
                                "ru": "Вору удалось <w>вытащить</w> ее кошелек так, что она не заметила."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shop lift"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for stealing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украсть что-либо, особенно незаметно или случайно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стащить",
                                "target_lang_sense_clarification": "разг. украсть"
                            },
                            {
                                "target_lang_word": "свистнуть",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "872b8f75-d6f9-3da5-8648-a28341ee4e43",
                    "sense_definition": "To plagiarize or copy work directly without giving credit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author was accused of <w>lifting</w> entire paragraphs from an older book.",
                            "target_lang_translations": {
                                "ru": "Автора обвинили в <w>плагиате</w> целых абзацев из старой книги."
                            }
                        },
                        {
                            "text": "It appears the journalist <w>lifted</w> the story directly from a blog post.",
                            "target_lang_translations": {
                                "ru": "Похоже, журналист напрямую <w>позаимствовал</w> историю из поста в блоге."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lifted directly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плагиатить или копировать чужую работу напрямую без указания авторства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдирать",
                                "target_lang_sense_clarification": "разг. плагиатить"
                            },
                            {
                                "target_lang_word": "заимствовать",
                                "target_lang_sense_clarification": "без разрешения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}