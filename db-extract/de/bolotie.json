                ],
                "senses": [
                    {
                        "sense_id": "36134e20-955f-3dd1-8488-d7a207d619ab",
                        "entry_id": "9e221ef0-18e5-3832-9d07-e8d73d232c79",
                        "glosses": [
                            "Lederband mit Schiebeverschluss, das wie eine Krawatte um den Hals getragen wird; häufig Teil der traditionellen Kleidung in Mexiko und im Südwesten der Vereinigen Staaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38a704b3-e379-4fb6-8473-29f564b8ca3d",
                                "sense_id": "36134e20-955f-3dd1-8488-d7a207d619ab",
                                "text": "„Zum Outfit gehören Kragenecken, das Bolotie, Hemd und Hosen in den gleichen Farben, am Gürtel die Schnalle, Stiefel und natürlich nicht zu vergessen den Cowboyhut.“"
                            },
                            {
                                "example_id": "c66b19a4-6879-498d-8c76-1387f9746d9a",
                                "sense_id": "36134e20-955f-3dd1-8488-d7a207d619ab",
                                "text": "„Unter der geöffneten Jacke trug er ein weißes Hemd mit Stickereien an der Knopfleiste. Dazu ein Bolotie aus schwarzem Leder mit einer Brosche aus Silber und einem großen Türkis in der Mitte.“"
                            },
                            {
                                "example_id": "2047a7f3-8465-443e-99df-48f039b4dcd4",
                                "sense_id": "36134e20-955f-3dd1-8488-d7a207d619ab",
                                "text": "„Um den Hals wird die Bolotie getragen, die den Schlips ersetzt.“"
                            },
                            {
                                "example_id": "02cb03ae-30d1-4e47-93eb-ccf038ba7391",
                                "sense_id": "36134e20-955f-3dd1-8488-d7a207d619ab",
                                "text": "„Statt Krawatte trägt der Westerner den ‚Bolotie‘, benannt nach der Bola, einem ursprünglich südamerikanischen Wurflasso.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
