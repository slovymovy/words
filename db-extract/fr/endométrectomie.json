                "senses": [
                    {
                        "sense_id": "9ffa15fd-0c55-3f0b-9135-537f0e0f4e11",
                        "entry_id": "22e58082-e41e-3631-bdca-06174a5809ea",
                        "glosses": [
                            "Ablation de l'endomètre qui tapisse l’intérieur de la cavité utérine et est à l’origine des règles et des saignements, intervention alternative à l’ablation de l’utérus (hystérectomie totale)."
                        ],
                        "tags": [
                            "Gynécologie"
                        ],
                        "examples": [
                            {
                                "example_id": "fe754ad2-03fe-4c52-ae97-a2b16e164bc0",
                                "sense_id": "9ffa15fd-0c55-3f0b-9135-537f0e0f4e11",
                                "text": "L’endométrectomie est moins lourde, plus rapide, et expose à moins de risques que d'autres techniques utilisées dans le cas de règles hémorragiques et de saignements intercurrents."
                            },
                            {
                                "example_id": "89fc4e59-4daa-4998-a497-81fea37960c4",
                                "sense_id": "9ffa15fd-0c55-3f0b-9135-537f0e0f4e11",
                                "text": "L’intervention de référence est la résection d’endomètre ou endométrectomie, qui consiste à retirer l’endomètre et la partie superficielle du myomètre.."
                            }
                        ]
                    }
                ],
