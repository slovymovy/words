        "nl-extract.jsonl": [
            {
                "entry_id": "930f1bbe-a1ce-3c73-b91e-894f7d0ed15a",
                "word": "rijpelijk",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d254762-778c-3caa-82d3-9a2eb885996c",
                        "entry_id": "930f1bbe-a1ce-3c73-b91e-894f7d0ed15a",
                        "glosses": [
                            "met voldoende ernst, zorgvuldigheid en aandacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29feed65-a8b6-4cf9-a79f-28a805521288",
                                "sense_id": "0d254762-778c-3caa-82d3-9a2eb885996c",
                                "text": "De voorzitter van het Front National probeerde zijn positieve verklaringen over Sarkozy van begin augustus recht te zetten. Toen vond hij de beslissingen van Sarkozy nog \"rijpelijk doordacht, gewogen, heel goed geïnformeerd en tot nu toe goed uitgevoerd\"."
                            },
                            {
                                "example_id": "bff8744e-a255-4189-9e40-223cf04a3761",
                                "sense_id": "0d254762-778c-3caa-82d3-9a2eb885996c",
                                "text": "Haar wens het lichaam van Edouard op te gaan halen hield ze lange tijd in beraad. Ze miste hem erg en hem zo ver weg te weten, bijna in een vreemd land, benauwde haar. Er was niets aan te veranderen, de regering was ertegen. Ze overwoog het rijpelijk en daarna (ze ging deze keer nog net zoals haar vader te werk), toen ze haar besluit eenmaal had genomen, kon niets haar meer tegenhouden. Ze zocht alles uit, zette discreet de nodige stappen, vond mensen, organiseerde het vervoer en ze ging eerst tegen de wil, later zonder de goedkeuring van haar vader het lijk van haar broer ophalen op de plaats waar hij was gestorven en ze begroef hem daar waar ze zelf op een dag zou worden begraven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60995c4c-2149-4190-ba8f-74dee1933ba7",
                        "source_entry_id": "930f1bbe-a1ce-3c73-b91e-894f7d0ed15a",
                        "source_sense_id": "0d254762-778c-3caa-82d3-9a2eb885996c",
                        "target_lang_word": "in detail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in detail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "207274f6-7d76-3963-9b3e-b39d71244a76",
                                        "entry_id": "9567554d-729c-3a6c-be88-efdf0b4c1c64",
                                        "glosses": [
                                            "Thoroughly; including every detail; with all particulars."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95606bfb-1a91-4a79-8ed1-998371c983cf",
                                                "sense_id": "207274f6-7d76-3963-9b3e-b39d71244a76",
                                                "text": "I do not understand it; please explain it to me in detail."
                                            },
                                            {
                                                "example_id": "2e501a5d-5c92-4212-8097-76e8e253e4db",
                                                "sense_id": "207274f6-7d76-3963-9b3e-b39d71244a76",
                                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de6ad33-ea9a-30ca-966e-fde2115f9a4d",
                                        "entry_id": "9567554d-729c-3a6c-be88-efdf0b4c1c64",
                                        "glosses": [
                                            "By engaging small sections of an enemy army rather than fighting a single pitched battle against the entire enemy force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7760bef5-800e-4b7a-935f-0517d54f3766",
                                                "sense_id": "0de6ad33-ea9a-30ca-966e-fde2115f9a4d",
                                                "text": "Darius defeated the rebels in detail."
                                            },
                                            {
                                                "example_id": "28e4f136-b46e-4900-8d5c-bfc71e3eb288",
                                                "sense_id": "0de6ad33-ea9a-30ca-966e-fde2115f9a4d",
                                                "text": "Macdonald might easily have destroyed them in detail could he have fallen upon them at once; but the time he spent in reorganising his army in Tuscany, and in concerting measures with Moreau, was well employed by Suvarof in promptly concentrating his forces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f30caae-2644-48ef-b86b-2260e0dbaaeb",
                        "source_entry_id": "930f1bbe-a1ce-3c73-b91e-894f7d0ed15a",
                        "source_sense_id": "0d254762-778c-3caa-82d3-9a2eb885996c",
                        "target_lang_word": "thoroughly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thoroughly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "747b2b31-763c-3072-abe7-7c88d77e193b",
                                        "entry_id": "d008f0bf-69f2-3dce-9110-2da29255b439",
                                        "glosses": [
                                            "In a thorough or complete manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff562b97-1fda-4cdd-8296-ecc8e133f465",
                                                "sense_id": "747b2b31-763c-3072-abe7-7c88d77e193b",
                                                "text": "He went out in the rain and came back thoroughly drenched."
                                            },
                                            {
                                                "example_id": "25ce2da8-657e-4cff-8560-8483f638899a",
                                                "sense_id": "747b2b31-763c-3072-abe7-7c88d77e193b",
                                                "text": "The editor looked thoroughly for any mistakes in the paper."
                                            },
                                            {
                                                "example_id": "3c49a560-2275-4464-9a3d-c3102a8d94e6",
                                                "sense_id": "747b2b31-763c-3072-abe7-7c88d77e193b",
                                                "text": "Another option is to wash spinach and other leafy greens thoroughly in running water before eating them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
