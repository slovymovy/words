                        ],
                        "examples": [
                            {
                                "example_id": "59bf1622-6ee2-4dd3-99f8-1e61f1faa2bc",
                                "sense_id": "d924dc47-e0d3-3de8-bab3-1ac7986e156e",
                                "text": "„Proteine sind die Konstrukteure und Akteure des Lebens. Jetzt haben Forscher gezählt, wie viele dieser Eiweißmoleküle in einer Zelle vorkommen.“"
                            },
                            {
                                "example_id": "4358deab-e6b9-4f11-ba52-c1f394c97887",
                                "sense_id": "d924dc47-e0d3-3de8-bab3-1ac7986e156e",
                                "text": "„Ursache der Huntington-Krankheit ist ein fehlerhaftes Protein, das Huntingtin. Wie alle anderen Eiweißmoleküle besteht es aus einer Abfolge von Aminosäuren – ganz ähnlich, wie ein Satz aus verschiedenen Buchstaben besteht.“"
                            }
                        ],
