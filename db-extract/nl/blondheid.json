                            {
                                "example_id": "e5aac396-6d68-4fcf-aadb-cde7856dceac",
                                "sense_id": "d1870acf-0d9e-3fbc-9329-a2d666724a09",
                                "text": "De blote blondheden langs de rijksweg, de stroom beelden van doorboorde geslachtsdelen en ander lillend roze vlees, muziekclips die meer met seks dan met muziek van doen hebben, cyberseksstriptease, de gewelddadige en aan prostitutie gekoppelde gang- en bimbocultuurtjes in onze achterbuurten – het is voor de moslim geen uitnodiging het land van aankomst te omarmen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b77c861-b183-399d-8ea7-b5923b0c6ef1",
                        "entry_id": "d9b3762f-d13f-35b5-ac6b-ed38aa7e1d56",
                        "glosses": [
