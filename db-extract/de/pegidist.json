                ],
                "senses": [
                    {
                        "sense_id": "8d173c82-d88c-3e8c-b995-28079a4bfa68",
                        "entry_id": "4d0bab78-6bb9-39d1-bdac-c442ce6850a2",
                        "glosses": [
                            "Anhänger der Organisation PEGIDA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbdd5f18-1c67-43c7-8313-701e01b8dd19",
                                "sense_id": "8d173c82-d88c-3e8c-b995-28079a4bfa68",
                                "text": "„Die große Mehrheit von fast zwei Dritteln der auch Pegidisten genannten Pegida-Anhänger bezeichnete Patzelt als \"besorgte Gutwillige\", knapp zehn Prozent als \"empörte Gutwillige\".“"
                            },
                            {
                                "example_id": "db2113a8-03f3-4b3f-a565-1c2ff35f7224",
                                "sense_id": "8d173c82-d88c-3e8c-b995-28079a4bfa68",
                                "text": "„Die ausgetretenen Pegida-Führer wollen ein neues Bündnis gründen. In ihm soll es um direkte Demokratie gehen. Die verbliebenen Pegidisten sind sauer.“"
                            },
                            {
                                "example_id": "0893cf18-75da-4c93-b1f4-92beb1fc6856",
                                "sense_id": "8d173c82-d88c-3e8c-b995-28079a4bfa68",
                                "text": "„Die Pediga-Vertreter verweigern sich den Medien, selbst wenn ihnen der ARD-Talk 4,89 Millionen Zuschauer bietet. Das ist irritierend, speziell für die Medien, die von den Pegidisten als ‚Lügenpresse‘ beschimpft werden.“"
                            },
                            {
                                "example_id": "6ec7e28a-2244-49bf-841a-a873b9ed4d26",
                                "sense_id": "8d173c82-d88c-3e8c-b995-28079a4bfa68",
                                "text": "„Nachdem die Kundgebungen Anfang Februar von einst 20.000 auf nur noch 2.000 Teilnehmer geschrumpft waren, wuchsen sie danach wieder an. 4.300 Pegidisten schätzte die Polizei am 16. Februar, eine Woche später 4.800, am vergangenen Montag 6.200.“"
                            },
                            {
                                "example_id": "f4ae572d-186f-4a7f-8dfe-1a91a935b55e",
                                "sense_id": "8d173c82-d88c-3e8c-b995-28079a4bfa68",
                                "text": "„Die Atmosphäre hatte zuletzt recht gelitten, denn die Pegidisten waren des Spaziergehens müde geworden, teilweise kamen nach Bachmanns Hitler-Selfie und Pöbeleien gegen Ausländer nur noch rund 2000 Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
