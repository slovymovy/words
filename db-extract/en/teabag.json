                        "entry_id": "5867ec48-ea48-35bd-bf50-3b8eb257d819",
                        "glosses": [
                            "A cloth or paper sachet containing tea leaves or herbal tea, designed to act as an infuser when submerged in hot water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d33c737-c4ed-47de-9a74-7adea985899e",
                                "sense_id": "16ca4b05-709d-3797-a2d7-9d806b9e0e28",
                                "text": "He put a spoon and teabag on the saucer and placed it before Mr. McManus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9df96e55-6852-4562-9d2c-7f52a5a52d9e",
