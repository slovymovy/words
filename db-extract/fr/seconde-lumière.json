                        "sense_id": "d9e9dbdd-1172-355e-981f-c5b064f47d2b",
                        "entry_id": "2874f61a-7ecf-3d45-99b9-1c24a9632b9d",
                        "glosses": [
                            "Unité de longueur utilisée en astronomie, correspondant à la distance parcourue par la lumière dans le vide en une seconde. Par définition, une seconde-lumière vaut exactement 299 792 458 mètres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbe24145-3bf8-452e-95b9-28a5e1b0b95f",
                                "sense_id": "d9e9dbdd-1172-355e-981f-c5b064f47d2b",
                                "text": "Pour faire orbiter un trio d’humains autour de notre satellite la lune, distante en moyenne de 384.460 km soit 1,28 secondes-lumière (SL) de notre terre, il a fallu mettre en œuvre une fusée d’un poids de 3000 tonnes."
                            },
                            {
                                "example_id": "ae5658df-4de4-4c55-ae14-614b60173610",
                                "sense_id": "d9e9dbdd-1172-355e-981f-c5b064f47d2b",
                                "text": "La Lune est à 1,3 seconde-lumière de la Terre."
                            }
                        ]
                    }
                ],
