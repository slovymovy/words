                    {
                        "sense_id": "2881d617-e7c2-38fb-bf59-feb66efefe6f",
                        "entry_id": "54a4ba51-1e67-37cf-9ecf-073276059d04",
                        "glosses": [
                            "outcry of indignation, shitstorm"
                        ],
