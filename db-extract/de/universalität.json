                        "form": "der Universalität"
                    },
                    {
                        "form_id": "540c677d-728d-4eef-97ee-1bcb6d30e447",
                        "entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Universalität"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d2f41cf-c38b-3c4d-bf02-bffc4d2f0dda",
                        "entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                        "glosses": [
                            "Eigenschaft, (so gut wie) immer und überall (universal) zu gelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d882f4af-d3aa-4621-a08f-82c038a90882",
                                "sense_id": "7d2f41cf-c38b-3c4d-bf02-bffc4d2f0dda",
                                "text": "„Universalität gerät immer in Konfrontation mit lokalen, kulturellen und rechtsphilosophischen Spezifitäten. Strittig ist dabei auch, ob Menschenrechte schon positive Grundrechte oder nur vorstaatliche Naturrechte sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ea719316-a89d-3058-b9a9-ddd91c7f8d7b",
                        "entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                        "glosses": [
                            "Eigenschaft einer Person, Bildung, Kenntnisse, Wissen oder Kreativität zu besitzen, die sich auf alle/viele Gebiete ausdehnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "806a9ebe-c3c4-4d79-b280-f7003e313d78",
                                "sense_id": "ea719316-a89d-3058-b9a9-ddd91c7f8d7b",
                                "text": "„Daß die Universalität Göthes mit dem Gesagten nicht erschöpft ist, weiß Jeder, der mit deutscher Literatur bekannt ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5e80d6fd-c124-388f-89ff-cdc8c6241ca3",
                        "entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                        "glosses": [
                            "Eigenschaft einer Sache oder eines Verfahrens, für viele Zwecke eingesetzt werden zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0618d703-c0ec-4605-a059-d4cfae7abfbe",
                                "sense_id": "5e80d6fd-c124-388f-89ff-cdc8c6241ca3",
                                "text": "„Beide Methoden zeichnen sich durch Einfachheit und Universalität der Anwendung aus.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c0fa01a-b713-44e1-bb21-1d09de50f3d2",
                        "source_entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                        "source_sense_id": "7d2f41cf-c38b-3c4d-bf02-bffc4d2f0dda",
                        "source_sense_description": "Eigenschaft, (so gut wie) immer und überall (universal) zu gelten",
                        "target_lang_word": "universalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "universalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b8d851e-60be-37c0-9ff3-505f043e8d0c",
                                        "entry_id": "fdd6d87d-9fcf-3969-8119-5c0566aea1bf",
                                        "glosses": [
                                            "Ensemble, totalité, ce qui embrasse les différentes espèces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b07b07ba-259a-4b58-ad94-b64d50053201",
                                                "sense_id": "5b8d851e-60be-37c0-9ff3-505f043e8d0c",
                                                "text": "L’universalité des êtres, des sciences, des arts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb5f25c-c806-3d19-978e-51197976df8c",
                                        "entry_id": "fdd6d87d-9fcf-3969-8119-5c0566aea1bf",
                                        "glosses": [
                                            "Totalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d145ba-8469-4908-b2db-b054fffcb719",
                                                "sense_id": "0cb5f25c-c806-3d19-978e-51197976df8c",
                                                "text": "L’universalité des biens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e871c239-b741-376a-b6f2-e9e662b4b0aa",
                                        "entry_id": "fdd6d87d-9fcf-3969-8119-5c0566aea1bf",
                                        "glosses": [
                                            "Caractère de ce qui est universel, de ce qui s’étend à un très grand nombre de pays, de civilisations, d’hommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "777a52c5-fa23-40d5-b6a8-ccd749da1c73",
                                                "sense_id": "e871c239-b741-376a-b6f2-e9e662b4b0aa",
                                                "text": "Il n’est pas question d’entamer ici une enquête anthropologique sur la question de l’universalité des fictions ni de prendre parti en leur faveur ou en leur défaveur."
                                            },
                                            {
                                                "example_id": "d07a53ce-bf0c-49d9-ad74-7ed96af5b9ec",
                                                "sense_id": "e871c239-b741-376a-b6f2-e9e662b4b0aa",
                                                "text": "On peut sans doute soutenir aujourd'hui que les dénominateurs de l'industrialisation, de la technologie et autres variables analogues ont la force de l’universalité."
                                            },
                                            {
                                                "example_id": "da78e868-898d-46f9-b32a-9344944adfd2",
                                                "sense_id": "e871c239-b741-376a-b6f2-e9e662b4b0aa",
                                                "text": "L’universalité des Droits de l'Homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76f5e15d-7290-3469-8eaa-e1a6924f77de",
                                        "entry_id": "fdd6d87d-9fcf-3969-8119-5c0566aea1bf",
                                        "glosses": [
                                            "Qualité d’une proposition dont l’attribut convient à la totalité du sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fffa2d51-1caa-4bc1-b501-1b1d65d2194f",
                                                "sense_id": "76f5e15d-7290-3469-8eaa-e1a6924f77de",
                                                "text": "L’universalité d’une proposition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
