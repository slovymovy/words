                "senses": [
                    {
                        "sense_id": "e1b14f7d-eb49-3bc9-bde1-b636c1e801ea",
                        "entry_id": "d3e2c9b9-426f-38a0-a922-a1d18505d268",
                        "glosses": [
                            "Récupérer grâce à une salabarde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e229927a-f18c-4d1e-a412-d5083c5b963b",
                                "sense_id": "e1b14f7d-eb49-3bc9-bde1-b636c1e801ea",
                                "text": "Plus tard, ce même bateau annexe aidera à transborder (salabarder) le poisson de la poche de la senne vers le senneur."
                            },
                            {
                                "example_id": "d75520fd-bf20-4b98-a74a-b765c03b2b40",
                                "sense_id": "e1b14f7d-eb49-3bc9-bde1-b636c1e801ea",
                                "text": "Maintenant, il faut salabarder."
                            },
                            {
                                "example_id": "8fd99137-d27a-48d1-aa20-824ff35774e1",
                                "sense_id": "e1b14f7d-eb49-3bc9-bde1-b636c1e801ea",
                                "text": "Pour récolter les lentilles, je traîne un train de rondins articulés pour regrouper les lentilles à une extrémité, pour ensuite les salabarder."
                            }
                        ]
                    }
