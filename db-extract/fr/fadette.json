                "senses": [
                    {
                        "sense_id": "2ceeaf66-e8cc-32a2-bff3-c14303540f2c",
                        "entry_id": "7f0ddd5b-5b95-3ffd-8ecd-b76da3d40f7e",
                        "glosses": [
                            "Dans le jargon des services de renseignement français : facture détaillée mentionnant les appels téléphoniques émis et reçus d’un client d’un opérateur téléphonique ainsi que les positions géographiques au moment de la réception et émission des appels durant les deux derniers mois."
                        ],
                        "tags": [
                            "neologism",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "842476e4-4cdd-4a00-b741-169115523367",
                                "sense_id": "2ceeaf66-e8cc-32a2-bff3-c14303540f2c",
                                "text": "Cette affaire des fadettes déclenche des règlements de comptes sur fond de remaniement."
                            },
                            {
                                "example_id": "c0a50876-d264-4a00-b7f0-2265d5e14430",
                                "sense_id": "2ceeaf66-e8cc-32a2-bff3-c14303540f2c",
                                "text": "C'est peut-être rien, ou au contraire le signe que le tueur ne voulait pas qu'on accède à son agenda. D'où l'importance des fadettes."
                            }
                        ]
                    }
                ],
