                        "cross_references": [
                            {
                                "target_word": "Hochmut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac7e595d-36f3-3bc9-87e3-5dc3c93e7ab3",
                                        "entry_id": "92eac5bf-da74-33a8-9d10-eecfb58d3fe8",
                                        "glosses": [
                                            "übertriebene Aufwertung der eigenen Person und Herablassung gegenüber anderen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c83fb49-4cb5-495b-9e9e-d6ab49d91cfd",
                                                "sense_id": "ac7e595d-36f3-3bc9-87e3-5dc3c93e7ab3",
                                                "text": "Nach der katholischen Morallehre ist Hochmut eine der sieben Todsünden."
                                            },
                                            {
                                                "example_id": "112597e9-c07a-4449-9bad-4ba2f49939a2",
                                                "sense_id": "ac7e595d-36f3-3bc9-87e3-5dc3c93e7ab3",
                                                "text": "„Angesichts des wachsenden Hochmuts in führenden Kreisen der DDR gegenüber den in der Sowjetunion unternommenen Anstrengungen zur Schaffung eines demokratischen und menschlichen Sozialismus wurde es zunehmend schwieriger, Schaden von den Beziehungen zwischen unseren beiden Staaten abzuwenden.“"
                                            },
                                            {
                                                "example_id": "568c8879-7a48-4413-9e5f-d6c8f5265603",
                                                "sense_id": "ac7e595d-36f3-3bc9-87e3-5dc3c93e7ab3",
                                                "text": "„Doch hatte der Marchese keineswegs die Absicht, sie zu kränken, denn er liebte sie; er wollte ihr nur ihren Hochmut abgewöhnen.“"
                                            },
                                            {
                                                "example_id": "3637a45e-6a86-4387-8857-9e6226311787",
                                                "sense_id": "ac7e595d-36f3-3bc9-87e3-5dc3c93e7ab3",
                                                "text": "„Mein Hochmut hatte mich dann so lange abgehalten, mich ihm von neuem zu nähern, bis das andere Gefühl wieder stärker geworden war als mein Hochmut.“"
                                            },
                                            {
                                                "example_id": "37e400ed-1c87-4a2c-a304-424779896bd4",
                                                "sense_id": "ac7e595d-36f3-3bc9-87e3-5dc3c93e7ab3",
                                                "text": "„Hochmut passte gut zu ihren hohen Wangenknochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
