                                "example_id": "f905c4f1-9b96-49f2-90c4-1f4d8fa53bec",
                                "sense_id": "a274ca1a-7b5f-3e5c-8003-d27ecd380e46",
                                "text": "„Der ÖVP-Europaabgeordnete Heinz Becker befürchtet eine Wahlmanipulation über Facebook bei der Europawahl im Mai 2019.“"
                            },
                            {
                                "example_id": "7be76ed9-ffd9-4df3-a30a-2edb7e7a44a8",
                                "sense_id": "a274ca1a-7b5f-3e5c-8003-d27ecd380e46",
                                "text": "„Er hätte den russischen Präsidenten auf klare und unmissverständliche Weise dafür kritisieren können, dass seine Agenten in den USA Wahlmanipulation betrieben haben, und er hätte ihn auffordern können, jeden weiteren Angriff auf die USA zu unterlassen.“"
                            }
                        ],
