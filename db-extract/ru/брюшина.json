                                        "entry_id": "68ea2035-b90d-3f58-949d-aa53bfc311fe",
                                        "glosses": [
                                            "In animals, the membrane lining the coelom cavity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfd4bf6e-fcfc-4f50-bef9-51855d2e35f9",
                        "source_entry_id": "555146d6-c468-3d91-ae1e-f9bb594309dc",
                        "target_lang_word": "peritoneo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peritoneo",
