                "senses": [
                    {
                        "sense_id": "619da64b-2ec7-3ae9-8976-455093e7bfd3",
                        "entry_id": "03fc5ed5-bae2-3b0d-af08-dff5d81b3f7e",
                        "glosses": [
                            "Zusammenballung von Wolken, die optisch wie eine Wand wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "342db3ac-d6db-4d79-91e8-199389a335e0",
                                "sense_id": "619da64b-2ec7-3ae9-8976-455093e7bfd3",
                                "text": "„Hinter den bewegten schwarzen Wipfeln ist eine Wolkenwand mit fahlen Rändern emporgewachsen.“"
                            },
                            {
                                "example_id": "7018e0cc-33f6-47f3-93b2-62a8c1d2b8ca",
                                "sense_id": "619da64b-2ec7-3ae9-8976-455093e7bfd3",
                                "text": "„Eine Stunde lang spähten die beiden empor, während die Nebel wirbelten und die Wolkenwand immer dichter und ruheloser wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
