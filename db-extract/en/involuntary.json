                    {
                        "translation_id": "c1d63549-a4f4-460e-aaa9-e23da8e92d4e",
                        "source_entry_id": "2ceaf849-5ef9-39e4-893c-9ce906305b08",
                        "source_sense_description": "without intention; unintentional",
                        "target_lang_word": "unabsichtlich",
