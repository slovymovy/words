{
    "word_family": [
        "overdoer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b35a9bc-b443-3928-9668-c2640d33a89e",
                    "sense_definition": "To do something to excess, or carry an action too far.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The decoration was nice, but they clearly began to <w>overdo</w> the details.",
                            "target_lang_translations": {
                                "es": "La decoración estaba bien, pero claramente empezaron a <w>exagerar</w> los detalles."
                            }
                        },
                        {
                            "text": "Be careful not to <w>overdo</w> things when you start your new exercise routine.",
                            "target_lang_translations": {
                                "es": "Ten cuidado de no <w>pasarte</w> cuando empieces tu nueva rutina de ejercicios."
                            }
                        }
                    ],
                    "synonyms": [
                        "exaggerate"
                    ],
                    "antonyms": [
                        "underdo",
                        "downplay"
                    ],
                    "common_phrases": [
                        "overdo it",
                        "overdo things"
                    ],
                    "target_lang_definitions": {
                        "es": "Hacer algo en exceso o llevar una acción demasiado lejos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "pasarse",
                                "target_lang_sense_clarification": "hacer algo en exceso"
                            },
                            {
                                "target_lang_word": "exagerar",
                                "target_lang_sense_clarification": "llevar al extremo"
                            },
                            {
                                "target_lang_word": "excederse",
                                "target_lang_sense_clarification": "sobrepasar un límite"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aac031c0-55f4-3de1-8889-7d96b6e8aa1e",
                    "sense_definition": "To cook food for too long, making it dry or spoiled.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Watch the grill closely so that you do not <w>overdo</w> the meat.",
                            "target_lang_translations": {
                                "es": "Vigila la parrilla de cerca para que no se te <w>pase</w> la carne."
                            }
                        },
                        {
                            "text": "If you leave the fish in the oven any longer, you will <w>overdo</w> it.",
                            "target_lang_translations": {
                                "es": "Si dejas el pescado en el horno más tiempo, se te va a <w>cocinar demasiado</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "overcook"
                    ],
                    "antonyms": [
                        "undercook",
                        "underdo"
                    ],
                    "common_phrases": [
                        "overdo the meat"
                    ],
                    "target_lang_definitions": {
                        "es": "Cocinar un alimento durante demasiado tiempo, dejándolo seco o echado a perder."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cocer demasiado",
                                "target_lang_sense_clarification": "comida"
                            },
                            {
                                "target_lang_word": "pasarse",
                                "target_lang_sense_clarification": "en la cocción de alimentos"
                            },
                            {
                                "target_lang_word": "recocinar",
                                "target_lang_sense_clarification": "cocinar en exceso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e604450-ae80-3694-923b-d0181fbe2d15",
                    "sense_definition": "To exhaust or strain oneself or someone through too much physical effort or work.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After recovering from surgery, he was warned not to <w>overdo</w> his strength.",
                            "target_lang_translations": {
                                "es": "Tras recuperarse de la cirugía, le advirtieron que no <w>sobreexigiera</w> sus fuerzas."
                            }
                        },
                        {
                            "text": "Working late every evening will eventually <w>overdo</w> you and cause burnout.",
                            "target_lang_translations": {
                                "es": "Trabajar hasta tarde todas las noches acabará por <w>extenuarte</w> y provocarte agotamiento."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhaust",
                        "overtax",
                        "wear out",
                        "overtask",
                        "fatigue"
                    ],
                    "common_phrases": [
                        "overdo oneself"
                    ],
                    "target_lang_definitions": {
                        "es": "Agotar o sobreexigir a uno mismo o a otra persona mediante un esfuerzo físico o laboral excesivo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "sobreexigir",
                                "target_lang_sense_clarification": "esfuerzo físico o mental"
                            },
                            {
                                "target_lang_word": "extenuar",
                                "target_lang_sense_clarification": "agotar físicamente"
                            },
                            {
                                "target_lang_word": "sobrecargar",
                                "target_lang_sense_clarification": "fuerzas o trabajo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc7e576e-8d26-3e53-b419-d8453a20a97c",
                    "sense_definition": "To exceed, surpass, or do more than another person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rival artisans constantly sought to <w>overdo</w> each other in elaborate design.",
                            "target_lang_translations": {
                                "es": "Los artesanos rivales buscaban constantemente <w>superarse</w> el uno al otro en diseños elaborados."
                            }
                        },
                        {
                            "text": "In natural splendor, the landscape seemed to <w>overdo</w> every human attempt at beauty.",
                            "target_lang_translations": {
                                "es": "En esplendor natural, el paisaje parecía <w>sobrepasar</w> cualquier intento humano de belleza."
                            }
                        }
                    ],
                    "synonyms": [
                        "outdo",
                        "surpass",
                        "excel"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Superar o sobrepasar a otra persona en algo (arcaico)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "superar",
                                "target_lang_sense_clarification": "a alguien"
                            },
                            {
                                "target_lang_word": "sobrepasar",
                                "target_lang_sense_clarification": "en rendimiento o habilidad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}