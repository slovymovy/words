                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a42f471f-29a9-30c1-981c-c8ffd218f9f7",
                                        "entry_id": "de79741b-69dd-3422-88e1-60a04cd2a8fe",
                                        "glosses": [
                                            "A club-shaped, round-headed stick used in a mortar to pound, crush, rub or grind things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786acad8-1eeb-4608-a564-af84f1358caf",
                                                "sense_id": "a42f471f-29a9-30c1-981c-c8ffd218f9f7",
                                                "text": "She then sat down by the fire, and carefully separated the stone from the pulp, which she burnt; and her next task was to extract the kernel, which she did by means of a heavy pestle and the hearth. The kernels were next crushed together, and placed to simmer over the furnace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1bce503-69b8-3336-a13a-38aa6b4b8d3a",
                                        "entry_id": "de79741b-69dd-3422-88e1-60a04cd2a8fe",
                                        "glosses": [
                                            "A constable's or bailiff's staff; so called from its shape."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f590331-50f6-4279-b2e1-e81444ba9dba",
                                                "sense_id": "b1bce503-69b8-3336-a13a-38aa6b4b8d3a",
                                                "text": "[…]whether the chopping-knife or their pestles were the better weapons"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b56eaed6-cdfb-3a32-bd23-4839b2f959e4",
                                        "entry_id": "de79741b-69dd-3422-88e1-60a04cd2a8fe",
                                        "glosses": [
                                            "The leg and leg bone of an animal, especially of a pig."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b315cde-2a16-4405-badf-e64ca5f33542",
                                                "sense_id": "b56eaed6-cdfb-3a32-bd23-4839b2f959e4",
                                                "text": "a pestle of pork"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pestle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50b867a0-7a1d-31b2-a016-db8619557fd9",
                                        "entry_id": "154c6d1a-2062-3323-a176-04098ffd012b",
                                        "glosses": [
                                            "To pound, crush, rub or grind, as in a mortar with a pestle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f11c995a-d948-428b-baaa-4ac2abe9da6f",
                                                "sense_id": "50b867a0-7a1d-31b2-a016-db8619557fd9",
                                                "text": "‘Next time, boy, that you use that mortar for garlic, I will personally knock out your brain, place it in the said mortar, pestle it to a fine paste and give it to Dick Purser for feeding the dogs.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af585d25-9e91-424b-9555-7ef5895d006f",
                        "source_entry_id": "1a96fb7c-8d8a-3a5a-ad54-387f9fa93f83",
                        "source_sense_id": "456aeaa5-a453-35aa-b1b6-c36129a7d4b0",
