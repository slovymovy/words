                "senses": [
                    {
                        "sense_id": "7326ddc2-1d19-3901-b154-702e48779864",
                        "entry_id": "5e497984-fdf9-34e4-be60-c548dd751f54",
                        "glosses": [
                            "Surnom, sobriquet de Bernard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bed7823-f032-4980-9d5d-f330bc1e985e",
                                "sense_id": "7326ddc2-1d19-3901-b154-702e48779864",
                                "text": "Nanard qui chante, Nanard qui vend des télés, Nanard qui gagne avec l’OM, Nanard qui affronte Le Pen, et puis Nanard qui va en prison."
                            },
                            {
                                "example_id": "2afab825-997e-4d4d-be26-72e509ae5b08",
                                "sense_id": "7326ddc2-1d19-3901-b154-702e48779864",
                                "text": "Dans l’p’tit bar à Nanard\nLes fêtards, les soiffards\nS’payent des coups à boire\nAu son de la guitare.\nIls refont le monde\nAutour de tables rondes\nEt en fin d’soirée…\nY’a qu’le monde qu’est pas fait !"
                            }
                        ]
                    }
                ],
