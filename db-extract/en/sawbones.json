                ],
                "translations": [
                    {
                        "translation_id": "447e989d-1607-48d8-9625-6d72f6cb9c47",
                        "source_entry_id": "b7af2a37-6e5e-3677-94e4-17bfff6f098b",
                        "source_sense_id": "ad635d74-5078-32d0-8bda-3f09231e4f2a",
                        "source_sense_description": "umgangssprachlich: Chirurg, Arzt, Mediziner",
                        "target_lang_word": "Chirurg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chirurg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                        "entry_id": "35e7c20d-ba63-3572-ab1c-6160a1e5a67c",
                                        "glosses": [
                                            "Facharzt für operative Heilbehandlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f625755b-5880-4e65-805f-0b1a69f31559",
                                                "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                                "text": "Knochenbrüche sind eine Aufgabe für Chirurgen."
                                            },
                                            {
                                                "example_id": "9bd23140-e0a9-4b89-ad15-6b1381ad3ce6",
                                                "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                                "text": "„Valenti besaß jene Selbstsicherheit, die für berühmte Chirurgen charakteristisch ist, und er war ein vollendeter Showmann.“"
                                            },
                                            {
                                                "example_id": "895ad9c8-1cdc-465b-a472-53895e2ca577",
                                                "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                                "text": "„Bei stark übergewichtigen Menschen können Chirurgen den Magen verkleinern, damit weniger Nahrung hineinpasst.“"
                                            },
                                            {
                                                "example_id": "852bddf2-ffd4-4ed4-8273-fd93e5236b3f",
                                                "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                                "text": "„Keine zehn Minuten später streckt mir ein jüngerer Chirurg seine verschwitzte Hand entgegen.“"
                                            },
                                            {
                                                "example_id": "7353c05d-e07b-4846-bcfa-44bdf71193ab",
                                                "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                                "text": "„Nur wenige Patienten besitzen die edle Einfalt des Grafen Bobby, der soeben erfahren hat, daß sich ein berühmter Chirurg den Blinddarm eigenhändig herausnahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
