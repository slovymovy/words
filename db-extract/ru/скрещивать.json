                    },
                    {
                        "sense_id": "9f43c88c-cda4-32f9-b969-9c71f891039e",
                        "entry_id": "07ec9594-e88f-3d21-b4f5-96de3c188f9d",
                        "glosses": [
                            "получать гибрид растений или животных"
                        ],
                        "tags": [],
