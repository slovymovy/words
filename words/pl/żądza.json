    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c4b6035-e8ad-30ab-8478-7b422fd82198",
                    "sense_definition": "bardzo silne, niepohamowane pragnienie zdobycia lub osiągnięcia czegoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "silne_pragnienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego niepohamowana <w>żądza</w> władzy doprowadziła w końcu do upadku całego rządu.",
                            "target_lang_translations": {
                                "ru": "Его неукротимая <w>жажда</w> власти в конце концов привела к падению всего правительства."
                            }
                        },
                        {
                            "text": "Kierowała nim ślepa <w>żądza</w> zemsty na dawnych wrogach.",
                            "target_lang_translations": {
                                "ru": "Им руководила слепая <w>жажда</w> мести бывшим врагам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "żądza władzy",
                        "żądza pieniędzy",
                        "żądza zemsty",
                        "żądza krwi"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень сильное, неукротимое желание приобрести или достичь чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жажда",
                                "target_lang_sense_clarification": "сильное стремление к чему-либо (власти, мести, славе)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf327936-4fde-3645-bc2c-d3efaacaea89",
                    "sense_definition": "silny pociąg fizyczny i pragnienie zaspokojenia popędu seksualnego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pozadanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marcin nie mógł pohamować swojej <w>żądzy</w> na widok pięknej kobiety.",
                            "target_lang_translations": {
                                "ru": "Марцин не мог сдержать своего <w>вожделения</w> при виде красивой женщины."
                            }
                        },
                        {
                            "text": "Widział w jej oczach dziką <w>żądzę</w>, lecz nie zdobył się na żaden krok.",
                            "target_lang_translations": {
                                "ru": "Он видел в её глазах дикую <w>страсть</w>, но так и не решился сделать шаг навстречу."
                            }
                        }
                    ],
                    "synonyms": [
                        "chuć",
                        "pożądanie"
                    ],
                    "common_phrases": [
                        "pohamować żądzę",
                        "ślepa żądza"
                    ],
                    "target_lang_definitions": {
                        "ru": "сильное физическое влечение и стремление к удовлетворению сексуального желания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похоть",
                                "target_lang_sense_clarification": "чувственное, плотское вожделение"
                            },
                            {
                                "target_lang_word": "вожделение",
                                "target_lang_sense_clarification": "сильное сексуальное влечение, страсть"
                            },
                            {
                                "target_lang_word": "страсть",
                                "target_lang_sense_clarification": "бурное плотское или чувственное влечение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}