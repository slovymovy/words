                                "target_senses": [
                                    {
                                        "sense_id": "0c7891c9-11c5-314d-ba83-77c8d9747624",
                                        "entry_id": "137a6e40-d260-3638-86a8-eec527aa6188",
                                        "glosses": [
                                            "The state of being brutal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ea8b4ec-f524-3c78-812b-c126d822b5bb",
                                        "entry_id": "137a6e40-d260-3638-86a8-eec527aa6188",
                                        "glosses": [
                                            "A cruel or savage act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17f457f1-777e-4ca4-b479-9d618cd406d2",
                                                "sense_id": "6ea8b4ec-f524-3c78-812b-c126d822b5bb",
                                                "text": "‘Then the father has a great fight with his terrible conscience,’ said Munday with granite seriousness. ‘Should he make a row with the police[…]? Or should he say nothing about it and condone brutality for fear of appearing in the newspapers?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "576979dc-75de-3b9c-a1f1-9f781910867d",
                                        "entry_id": "137a6e40-d260-3638-86a8-eec527aa6188",
                                        "glosses": [
                                            "The use of excessive physical force, often in the form of violence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cadaa48-14c9-4374-ab6d-2a4bed77a631",
                                                "sense_id": "576979dc-75de-3b9c-a1f1-9f781910867d",
                                                "text": "police brutality"
                                            },
                                            {
                                                "example_id": "d7ec801d-3150-4b5f-971e-95ea3dea27d5",
                                                "sense_id": "576979dc-75de-3b9c-a1f1-9f781910867d",
                                                "text": "school brutality"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1466c46-7af4-44e9-8e62-e8630e06e48c",
                        "source_entry_id": "500d1933-f762-35b6-96f0-609fb1b5e70b",
                        "source_sense_id": "7c91d51a-64b2-340d-b413-d176e40f1cb4",
                        "target_lang_word": "rudeness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudeness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                                        "glosses": [
                                            "The property of being rude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42eb88f4-086a-4f56-b6fa-59ec8f692701",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "His rudeness was inexcusable."
                                            },
                                            {
                                                "example_id": "46cde39f-45b4-4e68-9e66-24bd843d8d29",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The rudeness of the cabin gave it a rustic charm but little comfort."
                                            },
                                            {
                                                "example_id": "e833ba91-26f7-4879-87c3-1d4c4a3e8e16",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The house was apparently very old; it had an almost prehistoric look about it, so rude and weatherbeaten was it, but the rudeness of the masonry and the lichening of the stones were no real indications of antiquity […]"
                                            },
                                            {
                                                "example_id": "e4afbf98-c900-4029-988c-7bdc0b17f05e",
                                                "sense_id": "c47621f3-2a64-354e-81a0-5b1d28200173",
                                                "text": "The woman who deliberately yelled out in the second set, when Henin was about to serve at 5-3 for the championship, was the epitome of the absolute self-centered rudeness that was exhibited at the Open, as well as in our society today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b803c9e7-fa71-326d-a3c5-b8686d5737eb",
                                        "entry_id": "f0e42476-f1ad-301d-bb2a-41a87e183248",
                                        "glosses": [
                                            "A rude remark or behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0c48072-9ab4-4cfb-884d-38226ad61fea",
                                                "sense_id": "b803c9e7-fa71-326d-a3c5-b8686d5737eb",
                                                "text": "I'm sick of his rudenesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11ed3390-7cef-4511-85f5-e97bf06e1cbe",
                        "source_entry_id": "500d1933-f762-35b6-96f0-609fb1b5e70b",
                        "source_sense_id": "7c91d51a-64b2-340d-b413-d176e40f1cb4",
                        "target_lang_word": "impudence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impudence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19dca327-c93c-381f-b746-a8222ba9361f",
                                        "entry_id": "45d950ca-1e28-3a8f-a71c-bf197f2f78d6",
                                        "glosses": [
                                            "The quality of being impudent, not showing due respect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc3cb01f-432b-3aee-95e3-05c32901c717",
                                        "entry_id": "45d950ca-1e28-3a8f-a71c-bf197f2f78d6",
                                        "glosses": [
                                            "Impudent language, conduct or behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f063f9f4-c4e0-453e-a1a1-73dd0a9f5015",
                                                "sense_id": "bc3cb01f-432b-3aee-95e3-05c32901c717",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired. And if the arts of humbleness failed him, he overcame you by sheer impudence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26ccc572-03b8-4aea-b0eb-ad8fea33cf1e",
                        "source_entry_id": "500d1933-f762-35b6-96f0-609fb1b5e70b",
                        "source_sense_id": "7c91d51a-64b2-340d-b413-d176e40f1cb4",
                        "target_lang_word": "impertinence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impertinence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cabae79e-b9ad-32d9-857c-6a52e7f9f563",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "Lack of pertinence; irrelevance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56d26c0d-475c-361e-9a74-9d436de8a1dc",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "An instance of this; a moment of being impertinent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a958ca5-1fbd-4ce6-a67f-036c21e3bce1",
                                                "sense_id": "56d26c0d-475c-361e-9a74-9d436de8a1dc",
                                                "text": "\"Enough, sir! \" he thundered with barely restrained fury. \"Enough, I say! Once and for all I must endeavour to rid myself of you and your impertinence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15643dfb-94ed-3a72-bd4d-90bd496fe180",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "The fact or character of being out of place; inappropriateness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "Insolence; impudence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "273eca85-0d82-41a7-b05c-11960ef88d0b",
                                                "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                                "text": "\"Because,\" interrupted the actress, \"I see things exactly as they are. I calculate my effects, but they do not deceive myself; you, on the contrary, live in a world of illusions, where every thing is called by such an exceedingly fine name, that it seems a downright impertinence to ascertain what it really is.\""
                                            },
                                            {
                                                "example_id": "06d0d651-ebae-430e-8466-3b5d770050b5",
                                                "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                                "text": "The musical has always had a lightness of touch, an impertinence that resembles gay humor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
