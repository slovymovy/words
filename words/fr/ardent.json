                    "frequency": "Low",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a représenté une jeune fille aux cheveux d'un roux <w>ardent</w>."
                        },
                        {
                            "text": "Ce renard possède un pelage d'un fauve <w>ardent</w> qui tranche avec la neige."
                        }
                    ],
                    "common_phrases": [
