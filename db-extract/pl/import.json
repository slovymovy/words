                                        "sense_id": "65f449d6-625f-37d7-9501-af68a5964756",
                                        "entry_id": "4a2d3e8a-a0a5-3ff3-8953-de100ff192ff",
                                        "glosses": [
                                            "To bring (something) in from a foreign country, especially for sale or trade."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02177014-ad38-4621-816b-f392458fd2d6",
                                                "sense_id": "65f449d6-625f-37d7-9501-af68a5964756",
                                                "text": "Nauru imports foods from Australia because phosphate mining destroyed land for farming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56028cb4-3e1f-34e6-8356-a24fcbb7b274",
                                        "entry_id": "4a2d3e8a-a0a5-3ff3-8953-de100ff192ff",
                                        "glosses": [
                                            "To load a file into a software application from another version or system."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a8792df-0da0-455a-a368-23b164b47305",
                                                "sense_id": "56028cb4-3e1f-34e6-8356-a24fcbb7b274",
                                                "text": "How can I import files from older versions of this application?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "import",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cac9a8ec-de86-3069-b621-2338d561de6a",
                                        "entry_id": "ff850420-ee4e-3fac-9270-cf57278722ca",
                                        "glosses": [
                                            "To be important; to be significant; to be of consequence."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a4633be-7bdd-47a5-95e3-23202a35fd2a",
                                                "sense_id": "cac9a8ec-de86-3069-b621-2338d561de6a",
                                                "text": "See how much it importeth to learn to take Time by the Fore-Top."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da816422-0d29-3aad-ac9c-978510770fab",
                                        "entry_id": "ff850420-ee4e-3fac-9270-cf57278722ca",
                                        "glosses": [
                                            "To be of importance to (someone or something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e0ebb6-aec8-4a06-8ede-93c7ca8af589",
                                                "sense_id": "da816422-0d29-3aad-ac9c-978510770fab",
                                                "text": "This Letter is mistooke: it importeth none here: It is writ to laquenetta."
                                            },
                                            {
                                                "example_id": "23e94820-539e-4afe-99a5-006cd4a4265a",
                                                "sense_id": "da816422-0d29-3aad-ac9c-978510770fab",
                                                "text": "If I endure it, what imports it you?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7589d1fd-a659-36b8-a41f-6d40b2a32a7b",
                                        "entry_id": "ff850420-ee4e-3fac-9270-cf57278722ca",
                                        "glosses": [
                                            "To be incumbent on (someone to do something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f8345a9-5f90-4346-93be-e7ce9f33a6c3",
                                                "sense_id": "7589d1fd-a659-36b8-a41f-6d40b2a32a7b",
                                                "text": "It imports us to get all the aid and assistance we can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55928440-59b5-3517-b9a5-2f676d4b1612",
                                        "entry_id": "ff850420-ee4e-3fac-9270-cf57278722ca",
                                        "glosses": [
                                            "To be important or crucial to (that something happen)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97703955-64cc-4d5f-b32c-2b759f3b9eb1",
                                                "sense_id": "55928440-59b5-3517-b9a5-2f676d4b1612",
                                                "text": "It much imports your house That all should be made clear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "856f9e6e-89bd-33dc-b402-526f8106118c",
                                        "entry_id": "ff850420-ee4e-3fac-9270-cf57278722ca",
                                        "glosses": [
                                            "To mean, signify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1add78ba-fa1c-4d7c-9f32-d8ecacc12e02",
                                                "sense_id": "856f9e6e-89bd-33dc-b402-526f8106118c",
                                                "text": "Every petition […] doth […] always import a multitude of speakers together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91b91a00-7a76-31b4-b8b4-b5e87cdb3436",
                                        "entry_id": "ff850420-ee4e-3fac-9270-cf57278722ca",
                                        "glosses": [
                                            "To express, to imply."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
