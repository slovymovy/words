                "senses": [
                    {
                        "sense_id": "235e5589-7d58-3307-9d9b-743e78ebf175",
                        "entry_id": "a337f9e8-89c7-356b-a322-d940d1f08358",
                        "glosses": [
                            "Réduire au néant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a501bf0a-7917-4784-96d4-280e8362575c",
                                "sense_id": "235e5589-7d58-3307-9d9b-743e78ebf175",
                                "text": "La mort qui ronge son propre concept va alors ronger les autres concepts, saper les points d’appui de l’intellect, renverser les vérités, nihiliser la conscience."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b33fb6b-3188-3b19-824b-875576b36ee8",
                        "entry_id": "a337f9e8-89c7-356b-a322-d940d1f08358",
                        "glosses": [
                            "Défendre le nihilisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81866de7-dd2a-41df-88fb-0cee4098f22f",
                                "sense_id": "1b33fb6b-3188-3b19-824b-875576b36ee8",
                                "text": "À ceux qui le sollicitent, il ne demande pas pourquoi ils ont quitté la Russie : Tourgueniev ne cherche pas à savoir s’ils sont à Paris pour étudier ou pour nihiliser."
                            }
                        ]
                    }
