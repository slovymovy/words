                "senses": [
                    {
                        "sense_id": "3180c925-aaa1-3b5b-a847-dbeb2b729f14",
                        "entry_id": "5adb8a69-3eb8-3859-905b-619ef67157b7",
                        "glosses": [
                            "Leiter eines Ministeriums, das für Fragen der Bildung und der Schulpolitik zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3734229f-cd8e-466f-972d-d2e6f88184b0",
                                "sense_id": "3180c925-aaa1-3b5b-a847-dbeb2b729f14",
                                "text": "Der Kultusminister hat die geplante Schulreform verteidigt."
                            },
                            {
                                "example_id": "811eb2bc-903b-4783-b26a-6d34f213b124",
                                "sense_id": "3180c925-aaa1-3b5b-a847-dbeb2b729f14",
                                "text": "„Ursprünglich war geplant, dass die Kultusminister aller Bundesländer gemeinsam mit der Bundesbildungsministerin anreisten.“"
                            },
                            {
                                "example_id": "16ba5a8c-82b3-48d2-b195-25d01dc22548",
                                "sense_id": "3180c925-aaa1-3b5b-a847-dbeb2b729f14",
                                "text": "„1998 bot Schröder ihm den Posten als niedersächsischer Kultusminister an, den Gabriel jedoch ablehnte.“"
                            },
                            {
                                "example_id": "4408f630-a94e-4d42-be13-4ee5f1b1ce69",
                                "sense_id": "3180c925-aaa1-3b5b-a847-dbeb2b729f14",
                                "text": "„Bei einer festlichen Veranstaltung erkundigt sich die Gattin des Kultusministers bei einem eingeladenen Psychiater, woran ein geistiger Defekt überhaupt zu erkennen sei."
                            },
                            {
                                "example_id": "a5de5307-a59e-495b-927e-9052aeab02df",
                                "sense_id": "3180c925-aaa1-3b5b-a847-dbeb2b729f14",
                                "text": "„Ein Bericht über die Vorführung dieser Dokumentarfilme und die Reaktion verschiedener deutscher Kultusminister findet sich ebenfalls in der Anlage zu diesem Bericht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
