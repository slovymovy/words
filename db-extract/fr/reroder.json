                "senses": [
                    {
                        "sense_id": "c0d32b79-368b-3664-be36-d811ee0563a9",
                        "entry_id": "8c22ca78-d889-3137-b1b3-f62fa904d85a",
                        "glosses": [
                            "Roder à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6466954-4c27-4929-aeb3-f075376a67a5",
                                "sense_id": "c0d32b79-368b-3664-be36-d811ee0563a9",
                                "text": "Par la même occasion, profites-en pour éventuellement décalaminer les soupapes, contrôler leur étanchéité (et reroder si nécessaire) et changer les joints de queue de soupape..."
                            },
                            {
                                "example_id": "1e313e12-4bc5-458f-9a5d-8107289ee58b",
                                "sense_id": "c0d32b79-368b-3664-be36-d811ee0563a9",
                                "text": "Trouvant, le bolide à papa bien encrassé et faisant 250 kms de grande route par jour, je m'applique à reroder ce moteur que je connais bien"
                            },
                            {
                                "example_id": "62064949-e08f-4979-8b64-fa77b40929fc",
                                "sense_id": "c0d32b79-368b-3664-be36-d811ee0563a9",
                                "text": "Et si jamais, ton moteur ne perd pas trop de puissance une fois débridée, 1-2 ch, c’est tout, bon va falloir la reroder une fois en libre."
                            }
                        ]
                    }
