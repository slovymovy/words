                        "examples": [
                            {
                                "example_id": "6632e1d6-5fa5-492b-b149-9ad0e1cb9436",
                                "sense_id": "d504f64a-77f5-363a-8107-d42536e5ef59",
                                "text": "Het beeld van de Hindoestaanse god met een olifantenhoofd is van lavasteen en weegt 50 kilo, aldus de politie. Gezien dat gewicht is het niet waarschijnlijk dat één dader het beeld heeft meegenomen."
                            },
                            {
                                "example_id": "5070b92e-14a9-4266-8bd8-7d28f67ec439",
                                "sense_id": "d504f64a-77f5-363a-8107-d42536e5ef59",
                                "text": "Hoe doen ze dat toch: in de lobby staan klassieke Egg Chairs van Arne Jacobsen (1958), hangen een Arco-booglamp (1962) en strakke kroonluchters van Jacco Maris, er zijn moderne zitbankjes van de Italiaanse firma Baxter, wanden van lavasteen en handgeknoopte tapijten uit Nederland. In de huiskleuren turquoise en chocobruin."
                            }
                        ]
                    }
