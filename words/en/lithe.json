                            {
                                "target_lang_word": "ammorbidire",
                                "target_lang_sense_clarification": "rendere soffice o flessibile"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8f63fcd-9c6f-378e-8a49-555d3e65a70b",
                    "sense_definition": "To listen or pay attention to; to hearken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old minstrel asked the gathered crowd to <w>lithe</w> to his tale of chivalry.",
                            "target_lang_translations": {
                                "it": "Il vecchio menestrello chiese alla folla radunata di <w>ascoltare</w> il suo racconto cavalleresco."
                            }
                        },
                        {
                            "text": "If you would only <w>lithe</w>, you might understand the wisdom of the elders.",
                            "target_lang_translations": {
                                "it": "Se solo volessi <w>dare ascolto</w>, potresti comprendere la saggezza degli anziani."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical usage"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer in general use"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Ascoltare o prestare attenzione (arcaico, obsoleto)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ascoltare",
                                "target_lang_sense_clarification": "prestare orecchio"
