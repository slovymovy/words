                "senses": [
                    {
                        "sense_id": "27b5f51c-cdef-38cb-be9c-9070e65d98af",
                        "entry_id": "4d2368b6-e8f0-3df0-a655-40d5a107cae0",
                        "glosses": [
                            "Variante orthographique de quésaco."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "15239649-6265-4cc3-89aa-965c43db8103",
                                "sense_id": "27b5f51c-cdef-38cb-be9c-9070e65d98af",
                                "text": "Le vieux cria de l’intérieur : « Quezaco ? » Elle mit la main à la hauteur de ses yeux et m’ayant reconnu cria, tournée vers la porte entrebâillée : « Lou Tchikoï de lou Prat ! » Le petit de lou Prat, c’était moi pour le vieux de Lassus."
                            },
                            {
                                "example_id": "7d1d0033-7b2d-4671-af49-778e8aa61a76",
                                "sense_id": "27b5f51c-cdef-38cb-be9c-9070e65d98af",
                                "text": "La mégalomanie, quezaco ? Elle consiste en une surestimation de ses capacités qui se traduit par un désir immodéré de puissance et un amour exclusif ou excessif de soi."
                            }
                        ]
                    }
                ],
