                            {
                                "target_lang_word": "пока́зывать",
                                "target_lang_sense_clarification": "себя во всей красе"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "serwować",
                                "target_lang_sense_clarification": "prezentować świetny wygląd"
                            },
                            {
                                "target_lang_word": "wyglądać",
                                "target_lang_sense_clarification": "prezentować się olśniewająco"
