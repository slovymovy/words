                                        "examples": [
                                            {
                                                "example_id": "dea6ce49-521f-4500-bf67-96244056fd79",
                                                "sense_id": "f836648e-a96e-343f-b8ac-dfcc2cb3f4bb",
                                                "text": "Initially it nestled among the dozens of Indian mounds that unevened the earth near the river until they were leveled to accommodate commerce."
                                            },
                                            {
                                                "example_id": "7d5d019e-3796-4eab-879d-340da40cf871",
                                                "sense_id": "f836648e-a96e-343f-b8ac-dfcc2cb3f4bb",
                                                "text": "First, of course, the war reduced the white male, mostly young adult, population by more than a quarter-million, unevening the sex ratio and connubial and other opportunities for women for perhaps a generation."
                                            }
