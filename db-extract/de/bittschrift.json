                                        "glosses": [
                                            "Requête qu’on présente pour demander quelque grâce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216c34e6-8de4-45a7-9439-4d9ac8c10ed8",
                                                "sense_id": "7f9f077f-f91a-3bfc-88e5-95c64045541c",
                                                "text": "Présenter sa supplique."
                                            },
                                            {
                                                "example_id": "5f0ecf65-43bb-454e-ad9b-8f857686096b",
                                                "sense_id": "7f9f077f-f91a-3bfc-88e5-95c64045541c",
                                                "text": "Une supplique tendante à…"
                                            },
                                            {
                                                "example_id": "ed194019-bdcc-4fbf-a792-b28e3decc48f",
                                                "sense_id": "7f9f077f-f91a-3bfc-88e5-95c64045541c",
                                                "text": "Ayez égard à ma supplique, ayez égard à ma prière, à ma demande."
                                            },
                                            {
                                                "example_id": "8544c272-eb0f-4e90-8de2-3edbe60745a7",
                                                "sense_id": "7f9f077f-f91a-3bfc-88e5-95c64045541c",
                                                "text": "Dans les églises, sur les pages de suppliques au pied des statues, il était écrit « faites que mon père trouve un travail »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1968a5-d07d-34d5-adc4-97c04593e69f",
                                        "entry_id": "35449e1c-cea3-3118-be8a-88902a5876df",
                                        "glosses": [
                                            "Demande adressée au pape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "961cbe0c-6288-41e4-bbf0-1aced0981ac1",
                                                "sense_id": "1a1968a5-d07d-34d5-adc4-97c04593e69f",
                                                "text": "Plus d'une trentaine de prêtres et de religieux et près de soixante laïcs viennent de signer une supplique à Paul VI concernant les travaux du synode."
                                            }
                                        ]
