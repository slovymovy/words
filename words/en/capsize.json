{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5fa229d2-bf20-3aab-bf44-cd99917cf274",
                    "sense_definition": "To turn over in the water",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overturn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat began to <w>capsize</w> when the heavy waves hit the side.",
                            "target_lang_translations": {
                                "de": "Das kleine Boot begann zu <w>kentern</w>, als die schweren Wellen die Seite trafen."
                            }
                        },
                        {
                            "text": "If you stand up in a canoe, it will likely <w>capsize</w> and throw you into the water.",
                            "target_lang_translations": {
                                "de": "Wenn man in einem Kanu aufsteht, wird es wahrscheinlich <w>kentern</w> und einen ins Wasser werfen."
                            }
                        }
                    ],
                    "synonyms": [
                        "upset",
                        "keel over",
                        "turn turtle"
                    ],
                    "common_phrases": [
                        "boat capsize"
                    ],
                    "target_lang_definitions": {
                        "de": "Im Wasser umkippen oder umstürzen (von Booten oder Schiffen)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "kentern",
                                "target_lang_sense_clarification": "Boot, Schiff"
                            },
                            {
                                "target_lang_word": "umschlagen",
                                "target_lang_sense_clarification": "umkippen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01cdc80e-8514-3580-a0ab-ca31b702a256",
                    "sense_definition": "To cause a vessel to turn over",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "overturn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strong winds can easily <w>capsize</w> a poorly balanced sailboat.",
                            "target_lang_translations": {
                                "de": "Starke Winde können ein schlecht ausbalanciertes Segelboot leicht <w>zum Kentern bringen</w>."
                            }
                        },
                        {
                            "text": "The captain tried to steer away from the storm to avoid letting the waves <w>capsize</w> the ship.",
                            "target_lang_translations": {
                                "de": "Der Kapitän versuchte, dem Sturm auszuweichen, um zu verhindern, dass die Wellen das Schiff <w>zum Kentern bringen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "upset"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Wasserfahrzeug zum Umkippen bringen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zum Kentern bringen",
                                "target_lang_sense_clarification": "ein Schiff oder Boot"
                            },
                            {
                                "target_lang_word": "umkippen",
                                "target_lang_sense_clarification": "umwerfen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccc3b608-60b4-3171-9b20-0bb5a81cb670",
                    "sense_definition": "To change shape or deform under pressure",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When you pull the wrong end of the knot, it will <w>capsize</w> into a different configuration.",
                            "target_lang_translations": {
                                "de": "Wenn man am falschen Ende des Knotens zieht, <w>klappt</w> er in eine andere Form <w>um</w>."
                            }
                        },
                        {
                            "text": "The structure of the knot may <w>capsize</w> if it is not tied correctly.",
                            "target_lang_translations": {
                                "de": "Die Struktur des Knotens kann <w>umklappen</w>, wenn er nicht richtig geknüpft wird."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Unter Belastung die Form verändern oder sich verformen (insbesondere bei Knoten)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "umklappen",
                                "target_lang_sense_clarification": "bei Knoten"
                            },
                            {
                                "target_lang_word": "umschlagen",
                                "target_lang_sense_clarification": "Struktur verändern"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "665cacf7-4995-3d7a-9b7c-9bfc5aa817a4",
                    "sense_definition": "The act of overturning",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "overturn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>capsize</w> of the vessel was caused by the sudden shift in cargo.",
                            "target_lang_translations": {
                                "de": "Das <w>Kentern</w> des Schiffes wurde durch das plötzliche Verrutschen der Ladung verursacht."
                            }
                        },
                        {
                            "text": "Safety training helps sailors prevent the <w>capsize</w> of their boats during storms.",
                            "target_lang_translations": {
                                "de": "Ein Sicherheitstraining hilft Seglern, die <w>Kenterung</w> ihrer Boote bei Stürmen zu verhindern."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Das Umkippen oder Umstürzen eines Schiffes oder Bootes"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kentern",
                                "target_lang_sense_clarification": "Vorgang des Umkippens"
                            },
                            {
                                "target_lang_word": "Kenterung",
                                "target_lang_sense_clarification": "Ereignis des Umkippens"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}