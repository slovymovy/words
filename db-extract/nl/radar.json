                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e11a7132-a8a0-441e-a313-70dcf30d94aa",
                                                "sense_id": "dc63e5d6-1e2d-3329-88a8-a8e6b2a4eea2",
                                                "text": "Un avión desapareció este lunes del control de los radares."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47056904-329c-3d0c-bdf6-860c46c87a50",
                                        "entry_id": "06ed0455-c424-31a6-b3a9-1fc2a73a5d26",
                                        "glosses": [
                                            "Sistema electrónico capaz de captar la presencia de objetos que se encuentran fuera del alcance de la vista, y que además, permite saber a que distancia se encuentran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e38bfab-ad4f-483c-8faf-802b81b5a7a8",
                                                "sense_id": "47056904-329c-3d0c-bdf6-860c46c87a50",
                                                "text": "Los avances en la tecnología de radar han permitido a los geocientíficos 'ver a través' de un glaciar en Groenlandia y construir mapas topográficos en tres dimensiones de su lecho."
