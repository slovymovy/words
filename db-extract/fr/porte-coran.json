                        "glosses": [
                            "Sorte d'aigle pour supporter le Coran."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c635a8c7-0af5-4fd1-ba35-86c942d29d58",
                                "sense_id": "c70cc7bd-c5f2-30df-a74a-716eda8b2b67",
                                "text": "Les mâllems de Salé leur apprennent à manipuler le bois d'arar et de citronnier dont ils font des colonnettes, de très jolis plateaux à thé (mokhes-si-nia) . Le porte-Coran est aussi supporté par des pieds ajourés."
                            },
                            {
                                "example_id": "5213a4c0-bffa-475d-9369-458c6ac8ac37",
                                "sense_id": "c70cc7bd-c5f2-30df-a74a-716eda8b2b67",
                                "text": "Les deux porte-Coran dont l'un se trouve au Musée archéologique d’Istanbul et l'autre dans celui de Bursa, sont des chefs-d'œuvre datant des Selçukides, et dont on ne peut rencontrer les pareils dans aucun Musée du Monde."
                            }
                        ]
                    }
