                },
                {
                    "sense_id": "c3bf7cdd-e913-3988-b61a-2b4fa10c9050",
                    "sense_definition": "A person who studies or writes about flowers from a botanical or horticultural perspective.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flower_professionals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The 18th-century <w>florist</w> documented hundreds of rare species in his journal.",
                            "target_lang_translations": {
                                "ru": "<w>Флорист</w> XVIII века задокументировал в своем дневнике сотни редких видов.",
                                "zh": "那位18世纪的<w>植物学家</w>在他的日记中记录了数百种稀有物种。"
                            }
                        },
                        {
                            "text": "In historical texts, the term <w>florist</w> often referred to a botanical scholar.",
                            "target_lang_translations": {
                                "ru": "В исторических текстах термин «<w>флорист</w>» часто относился к ученому-ботанику.",
                                "zh": "在历史文献中，“florist”一词通常指代<w>植物学家</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "botanist"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is primarily found in historical or specialized botanical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, изучающий или описывающий цветы с ботанической или садоводческой точки зрения.",
                        "zh": "从植物学或园艺学角度研究或记录花卉的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флорист",
