                    {
                        "translation_id": "1c0cff5e-7cb6-4d7c-9466-e1b851de7174",
                        "source_entry_id": "28fa510d-2ca7-3f80-b6f0-758bc26eb381",
                        "source_sense_id": "68f4e4d1-130f-395c-8650-cff9c6cdd299",
                        "source_sense_description": "Teilnahme an dem Gefühl, den Gefühlen eines Anderen",
                        "target_lang_word": "сочувствие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сочувствие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6009c6b0-0b74-397e-b454-3b9d47689d78",
                                        "entry_id": "ac762011-6714-33c9-be92-674b4e7bae7d",
                                        "glosses": [
                                            "отзывчивое отношение к чужому чувству, преимущественно горестному, сострадание"
                                        ],
                                        "tags": [
                                            "мн. нет"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48753821-7925-44c4-8b4e-5dbdbadf2ecd",
                                                "sense_id": "6009c6b0-0b74-397e-b454-3b9d47689d78",
                                                "text": "Его сочувствие было для меня великой отрадой."
                                            },
                                            {
                                                "example_id": "f6c6cf6b-1a1e-48a7-9430-52668324dd04",
                                                "sense_id": "6009c6b0-0b74-397e-b454-3b9d47689d78",
                                                "text": "Проявить сочувствие."
                                            },
                                            {
                                                "example_id": "acbb6c44-06e4-4d73-be39-58c4f4812148",
                                                "sense_id": "6009c6b0-0b74-397e-b454-3b9d47689d78",
                                                "text": "Искать сочувствия у друзей."
                                            },
                                            {
                                                "example_id": "019169eb-d82d-4e5b-8e9a-2756be78e537",
                                                "sense_id": "6009c6b0-0b74-397e-b454-3b9d47689d78",
                                                "text": "Сделать что-нибудь из сочувствия к кому или чему-нибудь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2520114d-8e65-3891-8c08-ea3208e938cc",
                                        "entry_id": "ac762011-6714-33c9-be92-674b4e7bae7d",
                                        "glosses": [
                                            "одобрительное отношение к чьему-нибудь начинанию, к чьим-нибудь мыслям и настроениям, признание и поддержка чего-нибудь, чувство солидарности с чем-нибудь"
                                        ],
                                        "tags": [
                                            "мн. нет"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2b08927-5181-4c52-a9eb-33471fd11caf",
                                                "sense_id": "2520114d-8e65-3891-8c08-ea3208e938cc",
                                                "text": "Проект его встретил общее сочувствие."
                                            },
                                            {
                                                "example_id": "d1bf1f99-3e98-4de3-896e-21c400c20b11",
                                                "sense_id": "2520114d-8e65-3891-8c08-ea3208e938cc",
                                                "text": "Нежданов искренно и горячо похвалил Маркелова и с особым сочувствием отозвался о Соломине."
                                            },
                                            {
                                                "example_id": "a16fe617-8958-44aa-917c-eea8d5650a0a",
                                                "sense_id": "2520114d-8e65-3891-8c08-ea3208e938cc",
                                                "text": "На место старого буржуазного парламента идёт всемирная Советская власть, которая завоевала сочувствие всех рабочих, потому что она есть власть трудящихся, власть миллионов, которые сами господствуют, сами управляют."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
