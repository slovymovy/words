                        ],
                        "examples": [
                            {
                                "example_id": "732182b8-adae-4012-8432-63ac2e76d981",
                                "sense_id": "90ac8d8c-2c4d-3566-92dd-987257fac168",
                                "text": "De kroegbaas had vandaag overleg met burgemeester Hans Beenakker van Tiel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f8e2932-63c6-419b-9fa7-4054657c69d6",
                        "source_entry_id": "b78b62f4-2693-362d-8841-888e7f39678b",
                        "source_sense_id": "90ac8d8c-2c4d-3566-92dd-987257fac168",
                        "source_sense_description": "iemand die een kroeg bedrijft",
                        "target_lang_word": "Wirt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wirt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fd3814c-48e3-3b1a-ba59-2298277ca6d2",
                                        "entry_id": "8ade8c51-a1b2-3bc5-8312-0324850cb0a3",
                                        "glosses": [
                                            "jemand, der gegebenenfalls in einer Person privat oder kommerziell Gäste bewirtet oder ein Gastgeber, der vermietet und/oder beherbergt; ein Lokalinhaber, ein Wirtshausbesitzer und/oder Ausschenker in einem Lokal"
                                        ],
                                        "tags": [
                                            "unscharf",
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da9ed023-4b8c-49ae-a5e7-47cbdde24c32",
                                                "sense_id": "7fd3814c-48e3-3b1a-ba59-2298277ca6d2",
                                                "text": "Heute spielt mein Mann den Wirt."
                                            },
                                            {
                                                "example_id": "fba89f89-b1f1-4d81-b0f0-018674e6430d",
                                                "sense_id": "7fd3814c-48e3-3b1a-ba59-2298277ca6d2",
                                                "text": "„Der Wirt kommt, wir zahlen, nachdem wir das Innere des Gasthauses besichtigt haben.“"
                                            },
                                            {
                                                "example_id": "615a8e82-6246-414d-8c4c-e4559667ee35",
                                                "sense_id": "7fd3814c-48e3-3b1a-ba59-2298277ca6d2",
                                                "text": "„Ihr freundlicher Wirt tischte indessen auf, was in seinen Kräften stand, um die müden Wanderer zu erquicken und zu stärken: wilden Truthahn und Honig, süße Kartoffeln, Kürbismus und Maisbrot, sowie einen Becher voll echten Monongahela-Whiskys, und beide ließen sich nicht lange nötigen, an dem freundlich gebotenen Mahle teilzunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "644083b1-3222-3cf0-a326-ea638ecae5e6",
                                        "entry_id": "8ade8c51-a1b2-3bc5-8312-0324850cb0a3",
                                        "glosses": [
                                            "eine Pflanze oder ein Tier mit Parasitenbefall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc815ec-8776-4bd6-acdb-00c780788515",
                                                "sense_id": "644083b1-3222-3cf0-a326-ea638ecae5e6",
                                                "text": "Pelzflöhe bleiben bei ihrem Wirt, während Nestflöhe ihre Wirte immer wieder aufsuchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3b6225b1-8e9c-3050-bb22-294f51924a84",
                                        "entry_id": "8ade8c51-a1b2-3bc5-8312-0324850cb0a3",
                                        "glosses": [
                                            "eine Person, die als Anbieter, Vermieter von Wohnraum auftritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9505a8a2-3a53-4a7f-a8e9-c9db1e95ed4f",
                                                "sense_id": "3b6225b1-8e9c-3050-bb22-294f51924a84",
                                                "text": "Der Wirt hat schon wieder die Miete erhöht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3a3aaccf-33e8-3caf-a5e4-d39ebcc676af",
                                        "entry_id": "8ade8c51-a1b2-3bc5-8312-0324850cb0a3",
                                        "glosses": [
                                            "ein Empfänger eines Transplantats"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
