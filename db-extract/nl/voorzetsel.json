                        "source_sense_id": "6522eec8-f8ef-31f2-b6de-a726a8151b83",
                        "source_sense_description": "een onverbuigbaar woord dat de aard van de relatie tussen verschillende elementen in de zin aangeeft",
                        "target_lang_word": "Präposition",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Präposition",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2df386e8-6a6b-346c-98d5-ff0d4b4a1499",
                                        "entry_id": "065953e2-d631-3623-bfce-d41e4d27744d",
                                        "glosses": [
                                            "unflektierbares Wort, das eine Ergänzung (in einem bestimmten Kasus) fordert"
                                        ],
                                        "tags": [
                                            "im weiteren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e04e946-573d-42f1-bd29-d20c5c8dfa1c",
                                                "sense_id": "2df386e8-6a6b-346c-98d5-ff0d4b4a1499",
                                                "text": "Die Präposition „auf“ fordert in einem vollständigen Satz eine Ergänzung im Dativ oder Akkusativ, z. B. „auf dem Berg“, „auf den Berg“."
                                            },
                                            {
                                                "example_id": "e692b827-8af2-4a2e-9c0e-4b72cfaed3c4",
                                                "sense_id": "2df386e8-6a6b-346c-98d5-ff0d4b4a1499",
                                                "text": "„Präpositionen wie Konjunktionen können eine Beziehung verallgemeinernd benennen.“"
                                            },
                                            {
                                                "example_id": "f9478349-0648-4ddb-8a99-9f9527d52bfb",
                                                "sense_id": "2df386e8-6a6b-346c-98d5-ff0d4b4a1499",
                                                "text": "„Die Präpositionen sind wichtige Bausteine im Satz.“"
                                            },
                                            {
                                                "example_id": "8167e50a-03ab-41a6-adce-b034c1c34415",
                                                "sense_id": "2df386e8-6a6b-346c-98d5-ff0d4b4a1499",
                                                "text": "„In einem Kapitel ging es um die Geheimnisse der Sprache, insbesondere um die Präpositionen im Koran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c458ad3-eddb-32dc-b14f-3a5dcfb99b28",
                                        "entry_id": "065953e2-d631-3623-bfce-d41e4d27744d",
                                        "glosses": [
                                            "unflektierbares Wort, das eine nachgestellte Ergänzung (in einem bestimmten Kasus, der von der Präposition „regiert“ wird) fordert"
                                        ],
                                        "tags": [
                                            "im engeren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57980ac0-bc69-4fc7-a9e0-691dbcf34ee1",
                                                "sense_id": "8c458ad3-eddb-32dc-b14f-3a5dcfb99b28",
                                                "text": "Die Präposition „auf“ fordert in einem vollständigen Satz eine Ergänzung im Dativ oder Akkusativ, z. B. „auf dem Berg“, „auf den Berg“."
                                            },
                                            {
                                                "example_id": "adca9235-a7c4-428c-8d64-23d8fb44d5b9",
                                                "sense_id": "8c458ad3-eddb-32dc-b14f-3a5dcfb99b28",
                                                "text": "„Präpositionen wie Konjunktionen können eine Beziehung verallgemeinernd benennen.“"
                                            },
                                            {
                                                "example_id": "c8c39887-1ea4-43de-b9bb-98767e4927d1",
                                                "sense_id": "8c458ad3-eddb-32dc-b14f-3a5dcfb99b28",
                                                "text": "„Die Präpositionen sind wichtige Bausteine im Satz.“"
                                            },
                                            {
                                                "example_id": "8c12aa3c-61aa-4d01-bb1c-f034d33d3125",
                                                "sense_id": "8c458ad3-eddb-32dc-b14f-3a5dcfb99b28",
                                                "text": "„In einem Kapitel ging es um die Geheimnisse der Sprache, insbesondere um die Präpositionen im Koran.“"
                                            }
                                        ],
