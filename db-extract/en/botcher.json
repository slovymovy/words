                "senses": [
                    {
                        "sense_id": "712e9775-731e-3037-9092-b4f9bf8b5e05",
                        "entry_id": "9bd79c92-7d95-3bf7-8cc0-1633f50bcc4c",
                        "glosses": [
                            "A person who mends things, especially such a cobbler or tailor."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0fda620f-e80f-4434-ab14-364b74ffe579",
                                "sense_id": "712e9775-731e-3037-9092-b4f9bf8b5e05",
                                "text": "Two faults, madonna, that drink and good counsel will amend: for give the dry fool drink, then is the fool not dry; bid the dishonest man mend himself: if he mend, he is no longer dishonest; if he cannot, let the botcher mend him."
                            }
                        ]
                    },
                    {
                        "sense_id": "44ab3d59-dfc5-30f5-aa06-6e3b190cb0e3",
                        "entry_id": "9bd79c92-7d95-3bf7-8cc0-1633f50bcc4c",
                        "glosses": [
                            "chairmaker"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "05c8d3d8-7b43-30f7-93e9-9212a9a8db28",
                        "entry_id": "9bd79c92-7d95-3bf7-8cc0-1633f50bcc4c",
                        "glosses": [
                            "A clumsy or incompetent worker; a bungler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "919479be-df1a-470d-b5f1-73ee562502bd",
                                "sense_id": "05c8d3d8-7b43-30f7-93e9-9212a9a8db28",
                                "text": "Dilettanteism presupposes art as botchwork does handicraft; and the Dilettante holds the same relation to the artist that the botcher does to the craftsman."
                            },
                            {
                                "example_id": "b84d4369-604f-431e-beee-170dad77fde6",
                                "sense_id": "05c8d3d8-7b43-30f7-93e9-9212a9a8db28",
                                "text": "\"What you mean, comparing me to them botchers and bunglers? There ain't anybody but me in the furniture restoring line.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "3cf29ed5-7664-3ffb-8502-6e1ff25fc22f",
                        "entry_id": "9bd79c92-7d95-3bf7-8cc0-1633f50bcc4c",
                        "glosses": [
                            "A young salmon; a grilse."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
