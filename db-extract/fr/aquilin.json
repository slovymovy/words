        "fr-extract.jsonl": [
            {
                "entry_id": "4155f8a0-807b-3c2b-917d-e4b12ce60786",
                "word": "aquilin",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "76b52805-f326-4328-91da-c467d486eac0",
                        "entry_id": "4155f8a0-807b-3c2b-917d-e4b12ce60786",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "aquilins"
                    },
                    {
                        "form_id": "c8084127-c1e2-47dc-94c5-e2b2a2cd3693",
                        "entry_id": "4155f8a0-807b-3c2b-917d-e4b12ce60786",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "aquiline"
                    },
                    {
                        "form_id": "1d452882-2f88-4b5c-be3e-e677d8e22e49",
                        "entry_id": "4155f8a0-807b-3c2b-917d-e4b12ce60786",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "aquilines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5d6935a-6357-39bd-a6ee-5b3ef4103f21",
                        "entry_id": "4155f8a0-807b-3c2b-917d-e4b12ce60786",
                        "glosses": [
                            "Qualifie un nez fin et courbé en bec d’aigle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1384d990-eae8-46c8-a08e-862449005e4c",
                                "sense_id": "d5d6935a-6357-39bd-a6ee-5b3ef4103f21",
                                "text": "Un nez légèrement aquilin complétait le charme de cette tête noble à la fois et cependant variant à chaque instant, comme les nuances de passion qui agitaient madame d’Hocquincourt."
                            },
                            {
                                "example_id": "3ac0c71b-eede-4e05-971c-bacf11bab105",
                                "sense_id": "d5d6935a-6357-39bd-a6ee-5b3ef4103f21",
                                "text": "Ce commandant, un homme fort, haut, […], le nez aquilin, les yeux immobiles et rapaces, et le crâne tout petit, nous reçut avec bonhomie et amabilité."
                            },
                            {
                                "example_id": "4b5152c3-e0ae-4675-aad0-da218b54824b",
                                "sense_id": "d5d6935a-6357-39bd-a6ee-5b3ef4103f21",
                                "text": "Cette touche lumineuse accusait une arcade sourcilière assez proéminente abritant un œil dur et scrutateur, un nez d’une courbure aquiline dont le bout se rabattait en bec crochu sur une moustache épaisse, une lèvre inférieure très-mince que rejoignait brusquement un menton ramassé et court comme si la matière eût manqué à la nature pour achever ce masque."
                            },
                            {
                                "example_id": "f89e52ae-dd15-43ed-8add-e01567f4cbec",
                                "sense_id": "d5d6935a-6357-39bd-a6ee-5b3ef4103f21",
                                "text": "Bien sûr, Barbara, c’est une voix, de plus en plus grave. Mais aussi un nez aquilin, un regard noir, concentré et toujours ailleurs, une main aux mille envolées."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e4a99cf-2210-3590-ad4b-813b37dfd1e9",
                        "entry_id": "4155f8a0-807b-3c2b-917d-e4b12ce60786",
                        "glosses": [
                            "Qualifie les traits du visage, d’un profil ou le visage lui-même."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0f3f2739-0150-47c0-b4c8-ddd825c94ee0",
                                "sense_id": "3e4a99cf-2210-3590-ad4b-813b37dfd1e9",
                                "text": "Sur les quatre heures, un tout jeune homme, de taille petite, mais élégante et svelte, aux cheveux soyeux divisés en huit nattes qui tombent de chaque côté de la tête, au trait aquilin, à peau d’un rouge brun […]"
                            },
                            {
                                "example_id": "3507189a-0ff9-4781-bab4-0d89abdd3270",
                                "sense_id": "3e4a99cf-2210-3590-ad4b-813b37dfd1e9",
                                "text": "Quand elles étaient jeunes, Saâdia, à la fine figure aquiline et bronzée, et Habiba, blanche et frêle, charmaient les loisirs des Bou-Saadi et des nomades."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "354313fb-6c66-4ff8-b85a-b9682f175b5c",
                        "source_entry_id": "4155f8a0-807b-3c2b-917d-e4b12ce60786",
                        "source_sense_id": "d5d6935a-6357-39bd-a6ee-5b3ef4103f21",
                        "source_sense_description": "Nez fin et courbé",
                        "target_lang_word": "aquiline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aquiline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20233823-2b82-3ac7-b23c-46699a1e93cf",
                                        "entry_id": "9c2a589e-084a-3a67-99ae-e3c2500f9bf4",
                                        "glosses": [
                                            "Of, pertaining to, or characteristic of eagles; resembling that of an eagle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10dee4ae-4835-4dd8-9cdb-98e0caea8a9c",
                                                "sense_id": "20233823-2b82-3ac7-b23c-46699a1e93cf",
                                                "text": "Frank's aquiline nose jutted out from underneath his glasses."
                                            },
                                            {
                                                "example_id": "147f7cdb-6955-42c7-873f-5c6a6f43d643",
                                                "sense_id": "20233823-2b82-3ac7-b23c-46699a1e93cf",
                                                "text": "He was about the age of two-and-twenty, among the tallest of the middle size; had chestnut-coloured hair, which he wore tied up in a ribbon; a high polished forehead, a nose inclining to the aquiline, lively blue eyes, red pouting lips, teeth as white as snow, and a certain openness of countenance—but why need I describe any more particulars of his person?"
                                            },
                                            {
                                                "example_id": "e94253d9-2871-4705-9d22-614eced17dbf",
                                                "sense_id": "20233823-2b82-3ac7-b23c-46699a1e93cf",
                                                "text": "Think of a genius not born in every country or every time: a man gifted by Nature with a penetrating, aquiline eye; with a judgment prepared with the most extensive erudition; with an herculean robustness of mind, and nerves not to be broken with labour; a man who could spend twenty years in one pursuit."
                                            },
                                            {
                                                "example_id": "9816f714-38f8-4eeb-9613-e70601264b4c",
                                                "sense_id": "20233823-2b82-3ac7-b23c-46699a1e93cf",
                                                "text": "Holmes looked even thinner and keener than of old, but there was a dead-white tinge in his aquiline face which told me that his life recently had not been a healthy one."
                                            },
                                            {
                                                "example_id": "0c3a5758-4517-4dd8-9048-5bf21d59dc25",
                                                "sense_id": "20233823-2b82-3ac7-b23c-46699a1e93cf",
                                                "text": "[…] Wani, whose smooth sleekness had been part of his charm, seemed to Nick to grow leaner and ever more aquiline."
                                            },
                                            {
                                                "example_id": "dfe4c9ce-280c-48bc-a0bd-e2f0c2a4aa63",
                                                "sense_id": "20233823-2b82-3ac7-b23c-46699a1e93cf",
                                                "text": "He once recalled, of the father who called him “dear old boy” and whose aquiline nose and rectilinear figure he inherited, “After having hugged me, which he did rarely, he sent me away after 15 minutes.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b84a7e1-0ed3-4a20-ab7d-23d75f71062c",
                        "source_entry_id": "4155f8a0-807b-3c2b-917d-e4b12ce60786",
                        "source_sense_id": "d5d6935a-6357-39bd-a6ee-5b3ef4103f21",
