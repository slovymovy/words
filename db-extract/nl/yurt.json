        "nl-extract.jsonl": [
            {
                "entry_id": "c4dbb235-27b4-39c3-bd9d-0710684bdb8a",
                "word": "yurt",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf5e511c-c96e-33d4-b9ed-1c0cd7d3391a",
                        "entry_id": "c4dbb235-27b4-39c3-bd9d-0710684bdb8a",
                        "glosses": [
                            "een ronde nomadentent"
                        ],
                        "tags": [],
