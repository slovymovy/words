                {
                    "sense_id": "2ef8c99a-60c0-3ba7-af80-110811ac5ea2",
                    "sense_definition": "Amener quelqu'un à reconnaître la vérité d'une proposition ou d'un fait au moyen de preuves ou de raisonnements.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a réussi à <w>convaincre</w> ses parents de la laisser voyager seule pendant les vacances."
                        },
                        {
                            "text": "Ses arguments solides ont fini par <w>convaincre</w> la majorité des membres du jury."
                        }
                    ],
                    "synonyms": [
