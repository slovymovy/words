                "senses": [
                    {
                        "sense_id": "6715e258-6652-3183-9dae-5f19dcdf5dcc",
                        "entry_id": "da897481-e1ba-3a84-8ad8-defd2ff60bfe",
                        "glosses": [
                            "Hafenort im Süden der Krim, der ein Stadtteil von Sewastopol ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43961dc3-3f11-40c7-a4e2-3cb4840992c7",
                                "sense_id": "6715e258-6652-3183-9dae-5f19dcdf5dcc",
                                "text": "„Obwohl ich noch immer ein bisschen unter dem Einfluss des Alkohols stand, fürchtete ich mich in diesem Augenblick wie nie in meinem späteren Leben - und wenn man wie ich bei Balaklawa gegen eine russische Batterie angeritten ist und fest gekettet in einem afghanischen Kerker auf die Folterknechte gewartet hat, dann weiß man, was Furcht ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f79cf0d-c128-4db9-af1e-e780f3481e7f",
                        "source_entry_id": "da897481-e1ba-3a84-8ad8-defd2ff60bfe",
                        "source_sense_id": "6715e258-6652-3183-9dae-5f19dcdf5dcc",
                        "source_sense_description": "Hafenort im Süden der Krim, der ein Stadtteil von Sewastopol ist",
                        "target_lang_word": "Balaklava",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Balaklava",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dc9a94a-07f9-3cb0-bf0e-3897eddd15de",
                                        "entry_id": "cb9b5f2c-6789-3b2c-a627-07e4ed056b98",
                                        "glosses": [
                                            "Quartier de Sébastopol, ancienne ville du raïon du même nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42aef22-f93f-4175-9027-33c93dce8c39",
                                                "sense_id": "1dc9a94a-07f9-3cb0-bf0e-3897eddd15de",
                                                "text": "Le touriste en Crimée qui n'a pas visité Balaklava (« nid de poissons » en turc) ne connaîtra jamais la beauté suave et pittoresque, le charme discret quasi « méditerranéen » qui émane du petit port de pêche et de plaisance lové au fond d'une anse enserrée par des collines déplumées par le soleil, la brise, le sel marin et les hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "117ecc1a-f102-3827-b4bc-9551bf990920",
                                        "entry_id": "cb9b5f2c-6789-3b2c-a627-07e4ed056b98",
                                        "glosses": [
                                            "Nom d’une bataille qui eut lieu non loin de Sébastopol pendant la guerre de Crimée en 1854, opposant les Français et leurs alliés sardes aux Russes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ddcb2f9-a537-4e46-aa63-d425b6c5f89f",
                                                "sense_id": "117ecc1a-f102-3827-b4bc-9551bf990920",
                                                "text": "— À Balaklava, j’ai vu faucher des régiments entiers de cavalerie. On les enterra si vite, que leurs bottes sortaient de terre. J’ai vu ça, moi, des champs entiers plantés de bottes !…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
