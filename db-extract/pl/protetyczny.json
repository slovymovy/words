                                "target_senses": [
                                    {
                                        "sense_id": "d8e35082-5adb-3df7-a478-cd5acd900002",
                                        "entry_id": "8e1baba5-2f61-302c-b578-c7687dc0eb64",
                                        "glosses": [
                                            "Artificial, acting as a substitute for part of the body; relating to prosthesis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efd6c44d-2944-484b-aaa3-0a32196c1d75",
                                                "sense_id": "d8e35082-5adb-3df7-a478-cd5acd900002",
                                                "text": "prosthetic leg/arm"
                                            },
                                            {
                                                "example_id": "bc0725f8-c62c-47f7-ac72-b4def08741e9",
                                                "sense_id": "d8e35082-5adb-3df7-a478-cd5acd900002",
                                                "text": "Opposite of natural monsters there are technological monsters such as terminators, cyborgs, and robocops—all of which undermine dichotomies between the artificial and the organic, the prosthetic and the natural."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "753f9da7-1a8b-3d8c-8df3-ef2a437f2252",
                                        "entry_id": "8e1baba5-2f61-302c-b578-c7687dc0eb64",
                                        "glosses": [
                                            "Prothetic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "prosthetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "126158c8-08c6-3e01-be62-86632a06b38b",
                                        "entry_id": "7a6c0d52-7f2f-3c67-97de-1617558e6886",
                                        "glosses": [
                                            "An artificial replacement for part of the body; a prosthesis, prosthetic device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5b978b8-d582-30ce-b746-e36c3eaf44a2",
                                        "entry_id": "7a6c0d52-7f2f-3c67-97de-1617558e6886",
                                        "glosses": [
                                            "An addition to an actor etc.'s body as part of a costume, intended to transform the person's appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3da63a4-4acc-4419-a7e4-43a5006f3c57",
                                                "sense_id": "c5b978b8-d582-30ce-b746-e36c3eaf44a2",
                                                "text": "The specialist makers of prosthetics are part chemist, part artist and part engineer. Each tends to specialise in a particular area, such as sculpting, mould making, foaming latex, knotting hair into the pieces, colouring or artworking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
