                        "source_entry_id": "053a7f0f-2d0e-31f1-b86c-2a3aadbf5fb9",
                        "source_sense_id": "d9f841b8-bbbf-37ee-ae64-2ae440f0cc6e",
                        "source_sense_description": "SI-Einheit der Radioaktivität",
