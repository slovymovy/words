                        "sense_id": "65c642e7-173a-32f8-87e0-33db6016438a",
                        "entry_id": "71d3a1e7-4602-3aaf-ba15-11012b636132",
                        "glosses": [
                            "stukje weefsel dat voor onderzoek is weggenomen uit een levend organisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c20c0d8-bedb-487a-b2c2-bdcf5c53a6c1",
                                "sense_id": "65c642e7-173a-32f8-87e0-33db6016438a",
                                "text": ",,Gisteren heb ik de uitslag gekregen van een biopt dat is genomen uit mijn linkerlong. De uitslag is niet goed. De onrustige cellen zijn ontstaan uit de tbc-plek die vorig jaar bij mij is vastgesteld. Alles wijst nu op een voorstadium van longkanker."
                            },
                            {
                                "example_id": "f96f450c-2dd6-4767-86f8-3b60424e1259",
                                "sense_id": "65c642e7-173a-32f8-87e0-33db6016438a",
                                "text": "\"Radiologen kunnen meteen een nieuwe mammografie doen, eventueel een aanvullende echo en een biopt nemen. Als er niets verdachts te zien is, wordt een vrouw vrijwel meteen gerustgesteld.\""
                            }
                        ]
                    }
