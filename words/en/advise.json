{
    "word_family": [
        "advice",
        "adviser",
        "advisor",
        "advisable",
        "advisory",
        "advisedly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a8537a2-3cda-38a2-b213-174d83b54944",
                    "sense_definition": "To give advice to someone; to offer an opinion about what should be done.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor <w>advised</w> him to stop smoking immediately for the sake of his health.",
                            "target_lang_translations": {
                                "ru": "Врач <w>посоветовал</w> ему немедленно бросить курить ради его здоровья.",
                                "zh": "医生为了他的健康，<w>劝告</w>他立即戒烟。",
                                "es": "El médico le <w>aconsejó</w> dejar de fumar inmediatamente por el bien de su salud."
                            }
                        },
                        {
                            "text": "I would strongly <w>advise</w> you to book your tickets well in advance.",
                            "target_lang_translations": {
                                "ru": "Я бы настоятельно <w>посоветовал</w> вам забронировать билеты заранее.",
                                "zh": "我强烈<w>建议</w>你提前预订票。",
                                "es": "Le <w>aconsejaría</w> encarecidamente que reserve sus billetes con mucha antelación."
                            }
                        }
                    ],
                    "synonyms": [
                        "counsel",
                        "recommend",
                        "urge",
                        "encourage",
                        "admonish",
                        "suggest"
                    ],
                    "common_phrases": [
                        "advise against",
                        "strongly advise",
                        "ill-advised"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать совет или высказывать мнение о том, как следует поступить.",
                        "zh": "给某人提供建议；就应该做什么提出意见。",
                        "es": "Dar un consejo a alguien; ofrecer una opinión sobre lo que se debe hacer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "советовать",
                                "target_lang_sense_clarification": "давать совет (несов. вид)"
                            },
                            {
                                "target_lang_word": "посоветовать",
                                "target_lang_sense_clarification": "дать совет (сов. вид)"
                            },
                            {
                                "target_lang_word": "рекомендовать",
                                "target_lang_sense_clarification": "предлагать как желательное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建议",
                                "target_lang_sense_clarification": "提出主张或意见"
                            },
                            {
                                "target_lang_word": "劝告",
                                "target_lang_sense_clarification": "规劝并告诫"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aconsejar",
                                "target_lang_sense_clarification": "dar un consejo o sugerencia a alguien"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "919cfe78-fc61-35f2-a5b6-7e98fa34b748",
                    "sense_definition": "To recommend or suggest a specific action or course of conduct.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Experts <w>advise</w> caution when driving on icy roads during the winter.",
                            "target_lang_translations": {
                                "ru": "Эксперты <w>рекомендуют</w> соблюдать осторожность при вождении на обледенелых дорогах зимой.",
                                "zh": "专家<w>建议</w>冬季在结冰路面上驾驶时要保持谨慎。",
                                "es": "Los expertos <w>recomiendan</w> tener precaución al conducir en carreteras heladas durante el invierno."
                            }
                        },
                        {
                            "text": "The committee <w>advised</w> a review of the current safety procedures.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>рекомендовал</w> пересмотреть текущие процедуры безопасности.",
                                "zh": "委员会<w>提议</w>对现行的安全程序进行审查。",
                                "es": "El comité <w>recomendó</w> una revisión de los procedimientos de seguridad actuales."
                            }
                        }
                    ],
                    "synonyms": [
                        "recommend",
                        "suggest",
                        "advocate"
                    ],
                    "common_phrases": [
                        "advise caution",
                        "advise patience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рекомендовать или предлагать определенный курс действий, часто в качестве эксперта.",
                        "zh": "推荐或提议采取某种特定的行动或行为方式。",
                        "es": "Recomendar o sugerir una acción específica o un curso de conducta, a menudo desde una posición de conocimiento."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекомендовать",
                                "target_lang_sense_clarification": "давать рекомендацию"
                            },
                            {
                                "target_lang_word": "советовать",
                                "target_lang_sense_clarification": "предлагать соблюдать осторожность или определенный порядок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推荐",
                                "target_lang_sense_clarification": "介绍好的人或事物"
                            },
                            {
                                "target_lang_word": "提议",
                                "target_lang_sense_clarification": "提出建议供讨论"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "recomendar",
                                "target_lang_sense_clarification": "sugerir algo como conveniente"
                            },
                            {
                                "target_lang_word": "asesorar",
                                "target_lang_sense_clarification": "dar consejo profesional o experto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d622c04d-af16-3278-a5e7-1148adb4a73c",
                    "sense_definition": "To formally give information or notice to someone about something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>advise</w> us immediately if you are unable to attend the scheduled meeting.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, немедленно <w>сообщите</w> нам, если вы не сможете присутствовать на запланированной встрече.",
                                "zh": "如果您无法参加预定的会议，请立即<w>通知</w>我们。",
                                "es": "Por favor, <w>infórmenos</w> inmediatamente si no puede asistir a la reunión programada."
                            }
                        },
                        {
                            "text": "The bank <w>advised</w> the customer of the changes to the interest rate policy.",
                            "target_lang_translations": {
                                "ru": "Банк <w>уведомил</w> клиента об изменениях в политике процентных ставок.",
                                "zh": "银行已将利率政策的变动<w>告知</w>了客户。",
                                "es": "El banco <w>notificó</w> al cliente sobre los cambios en la política de tipos de interés."
                            }
                        }
                    ],
                    "synonyms": [
                        "inform",
                        "notify",
                        "apprise",
                        "acquaint",
                        "keep informed"
                    ],
                    "common_phrases": [
                        "please be advised",
                        "advise of",
                        "keep advised"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально сообщать или уведомлять кого-либо о чем-либо.",
                        "zh": "正式地向某人提供信息或发出通知。",
                        "es": "Informar o notificar formalmente a alguien sobre algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уведомлять",
                                "target_lang_sense_clarification": "официально извещать"
                            },
                            {
                                "target_lang_word": "сообщать",
                                "target_lang_sense_clarification": "доводить до сведения"
                            },
                            {
                                "target_lang_word": "извещать",
                                "target_lang_sense_clarification": "информировать о событии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通知",
                                "target_lang_sense_clarification": "告知相关事项"
                            },
                            {
                                "target_lang_word": "告知",
                                "target_lang_sense_clarification": "正式通知"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "notificar",
                                "target_lang_sense_clarification": "dar aviso formal de algo"
                            },
                            {
                                "target_lang_word": "informar",
                                "target_lang_sense_clarification": "comunicar un hecho o noticia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
