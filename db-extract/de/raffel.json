                        "examples": [
                            {
                                "example_id": "d9448288-eac4-4e29-9537-3efa8088c06e",
                                "sense_id": "d9ae16f9-b274-33b6-a5ac-4de7d451f294",
                                "text": "Raffeln werden zum Beispiel bei der Herstellung von Rösti oder Gurkensalat genutzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "84777cc4-c1ee-388f-8187-1723bfd30852",
                        "entry_id": "c22eea52-806c-3298-b4fe-991c7eb6b3f6",
                        "glosses": [
                            "Hilfsgerät zur Ernte von Beerenfrüchten"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "233b8dc5-d384-4f33-abd7-5eeba0784976",
                                "sense_id": "84777cc4-c1ee-388f-8187-1723bfd30852",
                                "text": "Mit der Raffel kann man schnell viele Preisselbeeren abernten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "bae21c74-d4d6-3c3d-b167-f4b3db30fe58",
                        "entry_id": "c22eea52-806c-3298-b4fe-991c7eb6b3f6",
                        "glosses": [
                            "Gerät, das bei entsprechender Bewegung Schlaggeräusche erzeugt, indem ein beweglicher Teil auf einen anderen schlägt"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "348bafd9-90d1-4dec-a636-bd97ac46a89e",
                                "sense_id": "bae21c74-d4d6-3c3d-b167-f4b3db30fe58",
                                "text": "„Zum Karfreitagsgottesdienst wird an vielen Orten mit der Raffel gerufen.“"
                            },
                            {
                                "example_id": "0cf333e6-0b4e-4ab6-bf15-6dcb2daf4fd4",
                                "sense_id": "bae21c74-d4d6-3c3d-b167-f4b3db30fe58",
                                "text": "„Im Aargau haben zahlreiche Pfarreien ein solches Holzinstrument, das «Raffel», «Rätsche», «Klapper» oder ähnlich genannt wird.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
