                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5600c50-e30e-4af5-9cbb-15fe5ef80181",
                                                "sense_id": "8be29ea4-6018-3bed-8c71-39d1ac6c5d81",
                                                "text": "quel partito ha avuto una grande emorragia di voti"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1cce686-54fa-4768-b1b7-84a4161546c0",
                        "source_entry_id": "e3f438b9-7044-3ffc-a293-2b77c74391c4",
                        "source_sense_id": "9f3d8e14-a01b-3874-96a7-bb065a1b431f",
                        "target_lang_word": "Hämorrhagie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hämorrhagie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b2b337f-2039-314a-9efd-313c0b320e58",
                                        "entry_id": "3e430e2f-64ed-320f-a15c-1cf95d21b846",
                                        "glosses": [
                                            "Austreten von Blut aus einem beliebigen Bereich der Blutbahn beziehungsweise des Blutkreislaufs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44017ed-29b1-475e-8b40-d424ea6f0e63",
                                                "sense_id": "9b2b337f-2039-314a-9efd-313c0b320e58",
                                                "text": "„Patienten mit Metastasen des zentralen Nervensystems wurden von klinischen Studien zur Wirksamkeit von Bevacizumab ausgeschlossen, seit im Jahr 1997 bei einem Patienten mit hepatozellulärem Karzinom eine tödliche zerebrale Hämorrhagie auftrat.“"
                                            },
                                            {
                                                "example_id": "941ff7c7-6a19-4425-8207-01f7c569b546",
                                                "sense_id": "9b2b337f-2039-314a-9efd-313c0b320e58",
                                                "text": "„Fetomaternale Hämorrhagien von mehr als 30 ml treten bei 1–3 Promille aller Schwangerschaften auf und führen zu einer fetalen Anämie und wahrscheinlich öfter als angenommen zum intrauterinen Fruchttod.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65550c67-01bc-45cf-af7f-bca3311df549",
                        "source_entry_id": "e3f438b9-7044-3ffc-a293-2b77c74391c4",
                        "source_sense_id": "9f3d8e14-a01b-3874-96a7-bb065a1b431f",
                        "target_lang_word": "Blutung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "969a078a-14fe-3dff-8a2f-e108307e1b2f",
                                        "entry_id": "3960166a-a214-39a7-84bd-c0aa32d98d41",
                                        "glosses": [
                                            "Austritt von Blut aus dem Gefäßsystem (intrakorporal) in eine andere Körperhöhle (ein anderes Kompartiment) oder (extrakorporal) aus dem Körper heraus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3304ff0f-dc4a-47ed-bb05-0141b3bb034d",
                                                "sense_id": "969a078a-14fe-3dff-8a2f-e108307e1b2f",
                                                "text": "Die Blutungen konnten nur mit Mühe gestoppt werden."
                                            },
                                            {
                                                "example_id": "5c474ae9-a7ba-4d99-aa00-79dfb83726ee",
                                                "sense_id": "969a078a-14fe-3dff-8a2f-e108307e1b2f",
                                                "text": "„Da die großen Blutgefäße sich beim Schuß zusammengezogen haben, ist nicht mit Blutungen zu rechnen.“"
                                            },
                                            {
                                                "example_id": "cfd12527-ec59-4ce9-8a47-e32ae963689d",
                                                "sense_id": "969a078a-14fe-3dff-8a2f-e108307e1b2f",
                                                "text": "„Bei Blutungen soll man keinen Alaunstein, sondern Alaunwasser benutzen, weil das hygienischer ist.“"
                                            },
                                            {
                                                "example_id": "acafb285-a3fd-4d2d-9718-e9fc9a2f502a",
                                                "sense_id": "969a078a-14fe-3dff-8a2f-e108307e1b2f",
                                                "text": "„Zunächst verband ich meine Wunde, um die Blutung zu stoppen, und hatte dann Gelegenheit, mich umzusehen.“"
                                            },
                                            {
                                                "example_id": "7149a539-d42a-4094-84ef-064e6afc1ded",
                                                "sense_id": "969a078a-14fe-3dff-8a2f-e108307e1b2f",
                                                "text": "„In erster Linie hatte er dafür gesorgt, dass die starke Blutung aus dem Oberschenkel des Halbtoten zum Stillstand kam, und dann den gebrochenen rechten Unterarm stabilisiert.“"
                                            },
                                            {
                                                "example_id": "f4d1a5c5-d637-4c2b-8f0e-f967716a556b",
                                                "sense_id": "969a078a-14fe-3dff-8a2f-e108307e1b2f",
                                                "text": "„Etwa 24 Stunden nachdem die Schwangere die Abtreibungspille eingenommen hat, kann es zu Blutungen und zu Krämpfen kommen, die denen während der Menstruation ähneln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a6273b6-a534-3c0f-b3c8-c3c7415be809",
                                        "entry_id": "3960166a-a214-39a7-84bd-c0aa32d98d41",
                                        "glosses": [
                                            "physiologische Monatsblutung im Menstruationszyklus"
                                        ],
                                        "tags": [
                                            "spezieller"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df96312e-42eb-4f1c-82c9-ec06e7de2627",
                                                "sense_id": "7a6273b6-a534-3c0f-b3c8-c3c7415be809",
                                                "text": "Die Blutungen gehen bei ihr oft mit Beschwerden einher."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5529f5b-d96a-404c-a0f6-e2bc6f41a02b",
                        "source_entry_id": "e3f438b9-7044-3ffc-a293-2b77c74391c4",
                        "source_sense_id": "9f3d8e14-a01b-3874-96a7-bb065a1b431f",
                        "target_lang_word": "hémorragie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hémorragie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f5ac3f4-8676-33cf-b1bf-42b9228f534f",
                                        "entry_id": "d8e2b2a6-1d4e-380d-a197-373b2be5b9f7",
                                        "glosses": [
                                            "Écoulement de sang hors des vaisseaux sanguins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb2e8b8e-5903-43a6-9cfb-28ce959f37e9",
                                                "sense_id": "0f5ac3f4-8676-33cf-b1bf-42b9228f534f",
                                                "text": "Le sang perdu par la pauvre fille ne provenait que d’une blessure faite à sa main, mais peu grave. Madge comprima cette blessure avec son mouchoir, et arrêta ainsi l’hémorragie."
                                            },
                                            {
                                                "example_id": "33c790f6-e828-4fb0-a87b-0bcb1a27e663",
                                                "sense_id": "0f5ac3f4-8676-33cf-b1bf-42b9228f534f",
                                                "text": "La Sandaraque impure des marchés arabes provient du Thuya et de divers Juniperus. On l'emploie en poudre pour arrêter les petites hémorragies de l’épistaxis."
                                            },
                                            {
                                                "example_id": "523db754-a962-4761-aebb-1bb2559b16be",
                                                "sense_id": "0f5ac3f4-8676-33cf-b1bf-42b9228f534f",
                                                "text": "Elle venait de lire « Fécondité » de Zola, il y avait dans ce roman une histoire d’avortement avec hémorragie et mort qui la remplissait d’épouvante."
                                            },
                                            {
                                                "example_id": "db04b7a6-5eae-40c0-b95e-911abea74b39",
                                                "sense_id": "0f5ac3f4-8676-33cf-b1bf-42b9228f534f",
                                                "text": "L’hémorragie aiguë entraîne une perte brutale proportionnelle de plasma et d’éléments figurés du sang. Bien qu’ici le sang total perdu atteigne 2,5 l, soit environ la moitié de la volémie d’un adulte, l’hématocrite reste initialement stable (t1)."
                                            },
                                            {
                                                "example_id": "567e0142-7a0e-4097-bcf6-2ed4298fa53f",
                                                "sense_id": "0f5ac3f4-8676-33cf-b1bf-42b9228f534f",
                                                "text": "Plus tard, sans doute un autre jour, un flot de sang m’emplit la bouche, il y a du monde dans la chambre et elle crie qu’il faut m’étendre à plat, me mettre une clef dans le dos pour arrêter l’hémorragie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "278cc3e3-2816-39ba-8412-dc9e49a50fb0",
                                        "entry_id": "d8e2b2a6-1d4e-380d-a197-373b2be5b9f7",
                                        "glosses": [
                                            "Grande perte, par exemple d’argent ou de personnes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9623b0c4-cc23-465f-8115-c0698fda17c4",
                                                "sense_id": "278cc3e3-2816-39ba-8412-dc9e49a50fb0",
                                                "text": "Et l’hémorragie n’est peut-être pas terminée : les pertes potentielles pour les années à venir pourraient être deux fois pires, si les taux ne remontaient pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
