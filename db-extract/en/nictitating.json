                        "form": "more nictitating"
                    },
                    {
                        "form_id": "d6c5937e-01da-490a-9404-04bcdba2f7b7",
                        "entry_id": "39197264-a689-3721-8ac5-728aaabea2f8",
                        "tags": [
                            "superlative"
