                        "entry_id": "8c14ad45-033b-368c-b4e8-e08061328763",
                        "glosses": [
                            "Said to wish a final farewell; goodbye."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2485c77-732d-40cf-93ff-c9b704babdc4",
                                "sense_id": "92bf16e5-4f1a-3328-ae0a-c59846b4107b",
                                "text": "BEATRICE. What fire is in mine ears? Can this be true?\nStand I condemn'd for pride and scorn so much?\nContempt, farewell! and maiden pride, adieu!\nNo glory lives behind the back of such."
                            }
                        ]
                    }
