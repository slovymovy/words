        "fr-extract.jsonl": [
            {
                "entry_id": "3c8d4ed2-74b1-36bd-a1fe-887279e4a5a2",
                "word": "bavolet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "34fc85b2-1158-4810-b177-238cb9a37898",
                        "entry_id": "3c8d4ed2-74b1-36bd-a1fe-887279e4a5a2",
                        "tags": [
                            "plural"
                        ],
                        "form": "bavolets"
                    },
                    {
                        "form_id": "cdce197c-29dc-4d90-823e-5d4c8c693ddb",
                        "entry_id": "3c8d4ed2-74b1-36bd-a1fe-887279e4a5a2",
                        "tags": [],
                        "form": "bas-volet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "061483ff-5c5c-3bca-a0ca-e2ce5ebaf858",
                        "entry_id": "3c8d4ed2-74b1-36bd-a1fe-887279e4a5a2",
                        "glosses": [
                            "Coiffure villageoise prolongée à l'arrière par un volet destiné à protéger le cou."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ee269ebe-c46b-41e6-bc9d-408b797140a5",
                                "sense_id": "061483ff-5c5c-3bca-a0ca-e2ce5ebaf858",
                                "text": "Une femme de cinquante ans environ, vêtue d’une robe noire et d’un bavolet blanc comme la neige."
                            },
                            {
                                "example_id": "2db26639-3127-44bd-b3cf-1e33498c28f8",
                                "sense_id": "061483ff-5c5c-3bca-a0ca-e2ce5ebaf858",
                                "text": "Au XIXe siècle, on a donné le nom de bavolet à ce volant lui-même et, par extension, au rabat d'un manteau ou d'un trench-coat qui protège les épaules."
                            },
                            {
                                "example_id": "e1eedbe7-7dd7-446a-aeea-14fa9a55c203",
                                "sense_id": "061483ff-5c5c-3bca-a0ca-e2ce5ebaf858",
                                "text": "Le seul article pratique de leur garde-robe viticole est le bagnolet, connu aussi comme le bavolet ou la capote, sorte de capeline en cotonnade imprimée, à grands bords souples, avançant sur le devant de la tête et couvrant les épaules, offrant une excellente protection contre les intempéries ;…"
                            },
                            {
                                "example_id": "96e8a3af-d241-4675-b639-344de9dd7ce0",
                                "sense_id": "061483ff-5c5c-3bca-a0ca-e2ce5ebaf858",
                                "text": "Aussi, le dimanche suivant, sous prétexte d’aller à la messe, on vit descendre toute la montagne : hommes, femmes, enfants ; jeunes et vieux ; en tricorne, en bavolet, en bonnet de coton ; à pied, en charrette."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e2a874c-1f55-3251-bb00-47562269dd44",
                        "entry_id": "3c8d4ed2-74b1-36bd-a1fe-887279e4a5a2",
                        "glosses": [
                            "Morceau d’étoffe qui ornait un chapeau de femme par-derrière."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3d361e3d-388b-4aa2-8d5e-91595561434a",
                                "sense_id": "3e2a874c-1f55-3251-bb00-47562269dd44",
                                "text": "Il suffit d'un sourire entrevu là bas sous un chapeau de crêpe blanc à bavolet lilas, pour que l'âme entre dans le palais des rêves."
                            },
                            {
                                "example_id": "ec421e05-571d-49b4-baaa-e3431f238fdd",
                                "sense_id": "3e2a874c-1f55-3251-bb00-47562269dd44",
                                "text": "Sa figure de ce matin-là, encadrée dans son chapeau à grand bavolet, est encore absolument présente à mes yeux."
                            },
                            {
                                "example_id": "919c7a7d-a935-4f5f-baa7-dc743b3e9c1b",
                                "sense_id": "3e2a874c-1f55-3251-bb00-47562269dd44",
                                "text": "Elle était coiffée d’une quichenotte dont les bavolets protégeaient les côtés de la figure et le cou. Lorsqu’un peu de vent passait, les bavolets battaient comme des ailes, se soulevaient, laissant voir la nuque ronde et la ligne délicate du menton, laissant voir aussi un petit bout d’oreille qui demeurait encore très rose."
                            }
                        ]
                    },
                    {
                        "sense_id": "f55b3675-2b35-340d-8920-9cd7a0cc311e",
                        "entry_id": "3c8d4ed2-74b1-36bd-a1fe-887279e4a5a2",
                        "glosses": [
                            "Accessoire, de caoutchouc le plus souvent, prolongeant l'aile d'une voiture ou le garde-boue d'une motocyclette pour protéger des projections d'eau ou de boue."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8f2a6f9b-ecea-3420-a0f3-54ce917f814e",
                        "entry_id": "3c8d4ed2-74b1-36bd-a1fe-887279e4a5a2",
                        "glosses": [
                            "Partie supérieure oblique d'une clôture grillagée, supportant généralement un ensemble de fils barbelés tendus, renforçant le caractère anti-intrusif de la clôture."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8297c67f-fc86-44b1-ab53-d3e991936ae8",
                        "source_entry_id": "3c8d4ed2-74b1-36bd-a1fe-887279e4a5a2",
                        "target_lang_word": "flap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "Anything broad and flexible that hangs loose, or that is attached by one side or end and is easily moved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "529a474a-97a8-41ac-9ece-abc0de85f836",
                                                "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                                                "text": "a flap of a garment"
                                            },
                                            {
                                                "example_id": "74bdb455-6c4d-40b4-805a-05d5f9220da1",
                                                "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                                                "text": "The envelope flap seemed curiously wrinkled."
                                            },
                                            {
                                                "example_id": "44933e9e-d6f1-40ff-a9d6-e986d1e075fc",
                                                "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                                                "text": "Again, Beside these parts destin'd to divers offices, there is a peculiar provision for the wind-pipe, that is, a cartilagineous flap upon the opening of the Larynx or Throttle, which hath an open cavity for the admiffion of the air"
                                            },
                                            {
                                                "example_id": "587765cf-89af-4dbc-9c7d-26726dedeafa",
                                                "sense_id": "b2bf9a4b-d897-3179-ae14-b6f777f85933",
                                                "text": "The hairs guide the pollinating insect to the base of the petal, where there is a purplish nectary covered by a flap of tissue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "240ea877-5736-39a1-9959-f3ef3fb28514",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A hinged leaf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5436f686-c077-4f4c-af32-8f4b72fa1f51",
                                                "sense_id": "240ea877-5736-39a1-9959-f3ef3fb28514",
                                                "text": "the flaps of a table"
                                            },
                                            {
                                                "example_id": "3938b78f-f4a4-49e6-a1ee-07da4a95f3af",
                                                "sense_id": "240ea877-5736-39a1-9959-f3ef3fb28514",
                                                "text": "the flap of a shutter"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abb04fe9-c1af-3c3d-b007-dbc027c2fbb1",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A hinged surface on the trailing edge of the wings of an aeroplane, used to increase lift and drag."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4f9853a-6326-3aa6-be98-5884f3b5ecd8",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A side fin of a ray."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0e265c7-fefa-38ca-9c58-7c18cf0479c9",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "The motion of anything broad and loose, or a sound or stroke made with it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f2f7a59-d341-4d47-ac82-edecc1a659a4",
                                                "sense_id": "f0e265c7-fefa-38ca-9c58-7c18cf0479c9",
                                                "text": "the flap of a sail"
                                            },
                                            {
                                                "example_id": "c5ea2cb7-396c-4dff-bd95-8826807d3001",
                                                "sense_id": "f0e265c7-fefa-38ca-9c58-7c18cf0479c9",
                                                "text": "the flap of a wing"
                                            },
                                            {
                                                "example_id": "3a96cbde-a2af-4b2b-a102-2aa15b5526ec",
                                                "sense_id": "f0e265c7-fefa-38ca-9c58-7c18cf0479c9",
                                                "text": "Then he commenced to talk, really talk. and inside of two flaps of a herring's fin he had me mesmerized, like Eben Holt's boy at the town hall show. He talked about the ills of humanity, and the glories of health and Nature and service and land knows what all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a937db4a-eda3-3348-9e2c-6727e7191820",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A controversy, scandal, stir, or upset."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d74e05-ae6e-4f10-819b-a148d1968cb3",
                                                "sense_id": "a937db4a-eda3-3348-9e2c-6727e7191820",
                                                "text": "The comment caused quite a flap in the newspapers."
                                            },
                                            {
                                                "example_id": "ef5d3c0c-916a-480f-82a5-367aba1cf951",
                                                "sense_id": "a937db4a-eda3-3348-9e2c-6727e7191820",
                                                "text": "“[…] We saw him vanish right in front of the rest of us. He was there and then he wasn’t. We were to wait for a year for his return or for some message. We waited. Nothing.” / Calvin, his voice cracking: “Jeepers, sir. You must have been in sort of a flap.”"
                                            },
                                            {
                                                "example_id": "d85a9567-19bf-4dd8-ae95-f7d1e9b91246",
                                                "sense_id": "a937db4a-eda3-3348-9e2c-6727e7191820",
                                                "text": "The current Middlesex grand jury […] is once again on the case, partly as the result of the public flap created by Brill's death and, of course, by the series of articles written by Corsetti in the month after Brill's demise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84c3309-ef84-37f3-aa31-fe2cf7613eff",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
                                            "A consonant sound made by a single muscle contraction, such as the sound /ɾ/ in the standard American English pronunciation of body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "651d993b-77b0-3720-867a-a9c1728fae86",
                                        "entry_id": "20788088-3456-3528-a146-43a13395b12b",
                                        "glosses": [
