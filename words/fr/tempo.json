    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "319f8f14-4a5f-3eb9-935f-3d5cdef158f2",
                    "sense_definition": "Vitesse d'exécution d'un morceau ou d'une œuvre musicale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le batteur utilise ses cymbales pour donner le <w>tempo</w> aux autres musiciens."
                        },
                        {
                            "text": "Le chef d'orchestre a choisi d'accélérer le <w>tempo</w> pour la fin du concert."
                        }
                    ],
                    "synonyms": [
                        "mouvement",
                        "cadence"
                    ],
                    "common_phrases": [
                        "donner le tempo",
                        "accélérer le tempo",
                        "ralentir le tempo"
                    ]
                },
                {
                    "sense_id": "9b03108d-09fd-3ab0-b3d0-a1b435e7e306",
                    "sense_definition": "Rythme, cadence ou allure à laquelle se déroule une action ou une activité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rythme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe adverse a réussi à imposer son <w>tempo</w> dès le début de la rencontre."
                        },
                        {
                            "text": "Il est difficile de maintenir un tel <w>tempo</w> tout au long de la journée de travail."
                        }
                    ],
                    "synonyms": [
                        "rythme",
                        "cadence",
                        "allure"
                    ],
                    "common_phrases": [
                        "garder le tempo",
                        "imposer le tempo"
                    ]
                },
                {
                    "sense_id": "fc753c64-1ed6-32a5-9789-817ba452d262",
                    "sense_definition": "Aux échecs et dans les jeux de stratégie, unité de temps correspondant à un coup joué, permettant de mesurer une avance ou un retard dans le développement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En sacrifiant ce pion, le joueur espère gagner un <w>tempo</w> pour développer ses pièces."
                        },
                        {
                            "text": "Un coup inutile au début de la partie peut faire perdre un <w>tempo</w> précieux."
                        }
                    ],
                    "common_phrases": [
                        "gagner un tempo",
                        "perdre un tempo"
                    ]
                },
                {
                    "sense_id": "e6c98827-535b-32e0-a63a-64b6b8c3660d",
                    "sense_definition": "Abri d'automobile démontable et temporaire, fait de toile, utilisé durant l'hiver.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque automne, nous installons un abri <w>tempo</w> dans l'entrée pour protéger la voiture de la neige."
                        },
                        {
                            "text": "La tempête de vent a déchiré la toile de notre <w>tempo</w> hier soir."
                        }
                    ],
                    "common_phrases": [
                        "abri tempo"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Québec"
                        }
                    ]
                },
                {
                    "sense_id": "f0b2d475-27de-3115-8932-37d9b17000fd",
                    "sense_definition": "Temporisation ; délai programmé avant l'exécution d'une commande sur un automate ou un circuit électronique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le programmeur a ajouté une courte <w>tempo</w> avant le déclenchement de la prochaine action."
                        },
                        {
                            "text": "Il faut régler la <w>tempo</w> du relais pour éviter les coupures intempestives."
                        }
                    ],
                    "synonyms": [
                        "temporisation"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "abréviation familière de temporisation"
                        }
                    ]
                }
            ]
        }
    ]
}