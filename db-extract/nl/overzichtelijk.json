                "senses": [
                    {
                        "sense_id": "864a68dc-eeca-362c-93f5-b3f867e13149",
                        "entry_id": "4653a41c-79ce-3989-99d7-ac8f2d96d382",
                        "glosses": [
                            "goed te overzien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1078b077-d9c8-4792-aade-8ff4a58dfa8e",
                                "sense_id": "864a68dc-eeca-362c-93f5-b3f867e13149",
                                "text": "De lijn van Saelens is simpel en overzichtelijk: direct knallen. „Throw the bomb in the first day of the war!” („Laat de bom op de eerste dag van de oorlog vallen!”) Dan haal je als partij het initiatief naar je toe. En een winnende partij beheerst volgens Saelens de (sociale) media en is dan leidend."
                            },
                            {
                                "example_id": "df8f9c4c-f569-4e06-8588-010d8d78af53",
                                "sense_id": "864a68dc-eeca-362c-93f5-b3f867e13149",
                                "text": "Het was een hele bevrijding om met minder spullen de bergen in te gaan en het in- en uitpakken van mijn rugzak werd hierdoor een stuk overzichtelijker."
                            },
                            {
                                "example_id": "5fe12e6b-a23d-4d2d-b6de-104a2684dcc8",
                                "sense_id": "864a68dc-eeca-362c-93f5-b3f867e13149",
                                "text": "De kaart van de Londense metro is heel overzichtelijk."
                            },
                            {
                                "example_id": "90250a75-ba9a-472d-91b1-d86214d8ea15",
                                "sense_id": "864a68dc-eeca-362c-93f5-b3f867e13149",
                                "text": "Door het kappen van de bomen werd de weg een stuk overzichtelijker"
                            }
                        ]
                    }
                ],
