        "nl-extract.jsonl": [
            {
                "entry_id": "27ac0296-8413-3ee0-99d5-1473ca55d74a",
                "word": "elegantie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d7313595-73b8-4aca-9101-537e1832a2df",
                        "entry_id": "27ac0296-8413-3ee0-99d5-1473ca55d74a",
                        "tags": [
                            "plural"
                        ],
                        "form": "eleganties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f30da349-f26d-3b15-aded-5039a52b60b5",
                        "entry_id": "27ac0296-8413-3ee0-99d5-1473ca55d74a",
                        "glosses": [
                            "het elegant zijn, de bevalligheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "549bb5ca-d1ab-4703-9cef-cca347801991",
                                "sense_id": "f30da349-f26d-3b15-aded-5039a52b60b5",
                                "text": "De Franse levensstijl blijft een uiterst aantrekkelijk concept waaraan goed wordt verdiend, zoals Michel Houellebecq constateerde in zijn laatste roman De kaart en het gebied: luxe, elegantie, goed eten en drinken."
                            },
                            {
                                "example_id": "f5f0580f-62a0-448f-ab9b-0e261d0cfddb",
                                "sense_id": "f30da349-f26d-3b15-aded-5039a52b60b5",
                                "text": "Wat Boeijen zich herinnert aan List is haar immer aanwezige elegantie. \"Als we samen gingen eten, haalde ik haar op bij haar Amsterdamse grachtenpand. Ik kleedde me speciaal netjes aan, maar Liesbeth zag er altijd zo geweldig uit, met jurken van Frank Govers. Een elegantie die je nu niet meer ziet. Het is zo'n mooie vrouw.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90a8d62e-3790-4fb2-b798-b05ef30113b4",
                        "source_entry_id": "27ac0296-8413-3ee0-99d5-1473ca55d74a",
                        "source_sense_id": "f30da349-f26d-3b15-aded-5039a52b60b5",
                        "target_lang_word": "élégance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élégance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd82d29e-dadb-31e4-971b-7d98e28f6ac5",
                                        "entry_id": "154a5f10-f60c-3caf-b915-3c72c4d3eb2e",
                                        "glosses": [
                                            "Grâce des formes qui se manifeste dans les productions de la nature et de l’art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fcb64be-0e2e-4a15-bc11-e96472a40b5d",
                                                "sense_id": "fd82d29e-dadb-31e4-971b-7d98e28f6ac5",
                                                "text": "L’élégance des formes, des contours. — L’élégance de la taille. — Cet homme a beaucoup d’élégance."
                                            },
                                            {
                                                "example_id": "47b192a7-e657-45af-8664-74f0bacf5fe5",
                                                "sense_id": "fd82d29e-dadb-31e4-971b-7d98e28f6ac5",
                                                "text": "Parmi les animaux et les fleurs, il en est qui ont de l’élégance. — L’élégance d’une parure. — Il y a dans sa parure plus d’élégance que de richesse."
                                            },
                                            {
                                                "example_id": "473ae88f-5d80-465d-b8ee-9483ffe04501",
                                                "sense_id": "fd82d29e-dadb-31e4-971b-7d98e28f6ac5",
                                                "text": "L’élégance d’un meuble, d’un ameublement. — L’élégance est l’opposé de la lourdeur disgracieuse. — Les œuvres de ce sculpteur ont plus d’élégance que de force."
                                            },
                                            {
                                                "example_id": "04cbccb7-9960-47fd-a12e-37bee23ecc35",
                                                "sense_id": "fd82d29e-dadb-31e4-971b-7d98e28f6ac5",
                                                "text": "L’élégance du dessin plaît plus que la régularité. — La simplicité n’exclut pas l’élégance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f49cda3b-f47b-3142-a9aa-b37bfad3c5ec",
                                        "entry_id": "154a5f10-f60c-3caf-b915-3c72c4d3eb2e",
                                        "glosses": [
                                            "Certaine distinction dans l’habillement et dans les manières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0aaa3d-c518-474d-bbce-60d657efb874",
                                                "sense_id": "f49cda3b-f47b-3142-a9aa-b37bfad3c5ec",
                                                "text": "On n’eût point dit d’ailleurs, en le voyant, qu’il se passât quelque chose d’insolite par la ville, ni au Louvre ; il était vêtu avec son élégance ordinaire."
                                            },
                                            {
                                                "example_id": "8e82fa22-5481-4132-838a-bc6dca3a7b44",
                                                "sense_id": "f49cda3b-f47b-3142-a9aa-b37bfad3c5ec",
                                                "text": "Ses cheveux, étalés en frange sur le front, s’y déroulaient avec une élégance foraine du meilleur aloi."
                                            },
                                            {
                                                "example_id": "9b380ac9-7393-4302-9d7a-17b510b54b86",
                                                "sense_id": "f49cda3b-f47b-3142-a9aa-b37bfad3c5ec",
                                                "text": "Il s’était renippé soigneusement des pieds à la tête et, bénéficiant d’une incontestable élégance naturelle, il réussissait complétement à dépouiller le vieil homme."
                                            },
                                            {
                                                "example_id": "a57906a4-862d-4475-85f5-ae3ecc6913e2",
                                                "sense_id": "f49cda3b-f47b-3142-a9aa-b37bfad3c5ec",
                                                "text": "Ils remontaient au temps d’une certaine pègre pour qui la suprême élégance consistait à se pourvoir d’un couvre-chef de couleur tendre et de souliers vernis."
                                            },
                                            {
                                                "example_id": "6fe4bb9d-032f-4a54-a767-a651099d424c",
                                                "sense_id": "f49cda3b-f47b-3142-a9aa-b37bfad3c5ec",
                                                "text": "En vis-à-vis du bâtiment vétuste, l’établissement des jeunes élèves-maîtresses, guindées en leur costume sévère sous le chapeau de feutre sans élégance. Le plupart portent lorgnons."
                                            },
                                            {
                                                "example_id": "b41cc177-c3bd-4d36-8f86-e6a5c78aed39",
                                                "sense_id": "f49cda3b-f47b-3142-a9aa-b37bfad3c5ec",
                                                "text": "S'attendre à ce que les autres soient tous sensibles à notre élégance ou à celle de nos gestes est une erreur. L'élégance est une langue : pour la comprendre, il faut la parler un peu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05f2cc9f-37c7-394e-a03e-eda1b1506dbe",
                                        "entry_id": "154a5f10-f60c-3caf-b915-3c72c4d3eb2e",
                                        "glosses": [
                                            "Choix de mots et de tours, d’où résultent la grâce et la facilité du langage ou du style."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fa30a07-977a-4939-9c93-d803aeb75b80",
                                                "sense_id": "05f2cc9f-37c7-394e-a03e-eda1b1506dbe",
                                                "text": "Parler avec élégance, sans élégance. — Élégance sans affectation. — L’élégance du style."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7858db43-ea73-3e97-bd2a-52aaecdbd38a",
                                        "entry_id": "154a5f10-f60c-3caf-b915-3c72c4d3eb2e",
                                        "glosses": [
                                            "Simplicité, beauté, économie de moyens, en parlant de la solution d’un problème mathématique ou scientifique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c11c6c33-6b72-43d4-9ef6-52fa0921806a",
                                                "sense_id": "7858db43-ea73-3e97-bd2a-52aaecdbd38a",
                                                "text": "Les mathématiciens attachent une grande importance à l’élégance de leurs méthodes et de leurs résultats ; ce n’est pas par pur dilettantisme. Qu’est-ce-qui nous donne, en effet, dans une solution, dans une démonstration, le sentiment d’élégance ? C’est l’harmonie des diverses parties, leur symétrie, leur heureux balancement ; c’est, en un mot, tout ce qui leur donne de l’unité."
                                            },
                                            {
                                                "example_id": "91ea251a-ceed-4eeb-a47b-6a70f1f5638d",
                                                "sense_id": "7858db43-ea73-3e97-bd2a-52aaecdbd38a",
                                                "text": "L’idée majeure de quantité fait également une certaine place à l’« élégance » du raisonnement quantitatif, comme celui utilisé par Gauss dans l’exemple suivant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "891dcb8f-7114-3870-b1d1-057b1c900484",
                                        "entry_id": "154a5f10-f60c-3caf-b915-3c72c4d3eb2e",
                                        "glosses": [
                                            "Manifestations du bon goût en société."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e83da150-2169-4773-9d3a-546ee67d822a",
                                                "sense_id": "891dcb8f-7114-3870-b1d1-057b1c900484",
                                                "text": "Il eut surtout des amours retentissantes, des duels fameux, et jusqu’à des aventures louches de tripot et de femmes, qui laissent traîner derrière leurs héros une sorte de respect mystérieux, d’admiration inquiète, et les classent définitivement au premier rang des élégances incontestées."
                                            },
                                            {
                                                "example_id": "adaba548-5d6f-4953-8d74-7b90c57358db",
                                                "sense_id": "891dcb8f-7114-3870-b1d1-057b1c900484",
                                                "text": "— Tu as bien connu le marquis de Ré… À soixante-cinq ans, il avait gardé sa force, sa jeunesse. Il faisait la mode, décidait des élégances et était aimé. Les jeunes gens copiaient sa redingote, son monocle, ses gestes, son insolence exquise, ses manies amusantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26a92f0a-c85b-48df-828e-1538a403c22d",
                        "source_entry_id": "27ac0296-8413-3ee0-99d5-1473ca55d74a",
                        "source_sense_id": "f30da349-f26d-3b15-aded-5039a52b60b5",
                        "target_lang_word": "elegancia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elegancia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3584701e-db68-3b54-98c2-29d7b95a2bec",
                                        "entry_id": "52a95fdf-e991-3f22-9867-f88ae2e7545e",
                                        "glosses": [
                                            "Cualidad que consiste en unión de lo bello con lo grave y majestuoso."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "774d00e2-717f-4756-a0db-c53d3b47d303",
                                                "sense_id": "3584701e-db68-3b54-98c2-29d7b95a2bec",
                                                "text": "¿Quién eres tú, que\nriges la elegancia, y\nformas nuevo ser a\nla noticia, sin que el\nmérito falte a la justicia,\nni la razón admita repugnancia?\nEn chanza y en verdad\ntal consonancia, tan alta,\nque la ignora la malicia,\nhaciendo que en el infierno\ny su milicia pregone su fiereza\ny vigilancia."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89be4036-3aba-333f-8eed-4a031535e8c6",
