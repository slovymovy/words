                "senses": [
                    {
                        "sense_id": "bf73ee43-0f99-37e1-a9dd-9fbe39194876",
                        "entry_id": "bda804a4-0bb3-3431-b512-3ddcc40c8842",
                        "glosses": [
                            "зоол. небольшая, но устойчивая группа львов (6–12 особей), состоящая из нескольких родственных самок со своим потомством и самцами, которые живут и охотятся вместе"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95107b32-dce0-4d6e-a8d3-b4027c031aac",
                        "source_entry_id": "bda804a4-0bb3-3431-b512-3ddcc40c8842",
                        "source_sense_id": "bf73ee43-0f99-37e1-a9dd-9fbe39194876",
                        "target_lang_word": "pride",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f91a8a8e-fd53-304a-b84c-8906d98a8020",
                                        "entry_id": "1153958a-d426-32c7-9fe9-cf58eb6592b9",
                                        "glosses": [
                                            "The quality or state of being proud.",
                                            "A sense of one's own worth; reasonable self-esteem and satisfaction (in oneself, in one's work, one's family, etc)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb8458e1-bf08-42a0-911b-2ca8678042e6",
                                                "sense_id": "f91a8a8e-fd53-304a-b84c-8906d98a8020",
                                                "text": "He swelled with pride as he held the trophy. His family watched with pride from the bleachers."
                                            },
                                            {
                                                "example_id": "07fb429e-a268-4c7f-a207-84b9f720dbbc",
                                                "sense_id": "f91a8a8e-fd53-304a-b84c-8906d98a8020",
                                                "text": "He takes great pride in his work."
                                            },
                                            {
                                                "example_id": "5e21535b-27e8-4649-8e67-cecc067b2565",
                                                "sense_id": "f91a8a8e-fd53-304a-b84c-8906d98a8020",
                                                "text": "He had pride of ownership in his department."
                                            },
                                            {
                                                "example_id": "fb6202c9-b53d-43da-86f0-e56f8570920b",
                                                "sense_id": "f91a8a8e-fd53-304a-b84c-8906d98a8020",
                                                "text": "My chief attention therefore was now to bring down the pride of my family to their circumstances; for I well knew that aspiring beggary is wretchedness itself."
                                            },
                                            {
                                                "example_id": "7a16489e-28d0-4dd1-bbda-72a32b27c967",
                                                "sense_id": "f91a8a8e-fd53-304a-b84c-8906d98a8020",
                                                "text": "A people which takes no pride in the noble achievements of remote ancestors will never achieve anything worthy to be remembered with pride by remote descendants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b31c691c-eb51-3e1c-b589-1c27eae92825",
                                        "entry_id": "1153958a-d426-32c7-9fe9-cf58eb6592b9",
                                        "glosses": [
                                            "The quality or state of being proud.",
                                            "An unreasonable overestimation of one's own superiority in terms of talents, or looks, wealth, importance, etc., which comes across as being haughty, lofty, and often showing contempt of others; exaggerated self-worth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b93965b-5c29-3218-9699-b3595f253168",
                                        "entry_id": "1153958a-d426-32c7-9fe9-cf58eb6592b9",
                                        "glosses": [
                                            "Proud or disdainful behavior or treatment that reflects such an attitude (of haughtiness); arrogance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "346789d9-8f5b-4563-95a9-1dbe8876e5cb",
                                                "sense_id": "9b93965b-5c29-3218-9699-b3595f253168",
                                                "text": "Pride goeth before the fall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dedb223c-98ea-33e8-a3d0-072214b91dc3",
                                        "entry_id": "1153958a-d426-32c7-9fe9-cf58eb6592b9",
                                        "glosses": [
                                            "Something or someone of which one is proud; that which is the source of self-congratulation and self-esteem (whether reasonable or arrogant), for example"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38511e25-5ea8-429b-89b2-fd1a23048b39",
                                                "sense_id": "dedb223c-98ea-33e8-a3d0-072214b91dc3",
                                                "text": "Her long ginger hair is her pride."
                                            },
                                            {
                                                "example_id": "1b32497f-cf73-47ea-8452-5956452b4254",
                                                "sense_id": "dedb223c-98ea-33e8-a3d0-072214b91dc3",
                                                "text": "The 18th century table is the pride of Mark's house/"
                                            },
                                            {
                                                "example_id": "722615b1-8d06-4440-85f6-3e9219751993",
                                                "sense_id": "dedb223c-98ea-33e8-a3d0-072214b91dc3",
                                                "text": "My children's accomplishments are my pride."
                                            },
                                            {
                                                "example_id": "beaa68b3-4af0-4cb5-a7e1-d9a16f170504",
                                                "sense_id": "dedb223c-98ea-33e8-a3d0-072214b91dc3",
                                                "text": "And a bastard shall dwell in Ashdod, and I will cut off the pride of the Philistines."
                                            },
                                            {
                                                "example_id": "e361c983-9cd1-4aed-acc3-2895babbb7f3",
                                                "sense_id": "dedb223c-98ea-33e8-a3d0-072214b91dc3",
                                                "text": "a bold peasantry, their country's pride"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b6f1a57-1956-32f1-8703-4645ff94ed83",
                                        "entry_id": "1153958a-d426-32c7-9fe9-cf58eb6592b9",
                                        "glosses": [
                                            "Show; ostentation; glory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86038ac1-a8fb-4a1e-9716-3a493bc59829",
                                                "sense_id": "1b6f1a57-1956-32f1-8703-4645ff94ed83",
                                                "text": "lofty trees yclad with summer's pride"
                                            },
                                            {
                                                "example_id": "33390053-3a89-4fb6-a681-6737ecd65d67",
                                                "sense_id": "1b6f1a57-1956-32f1-8703-4645ff94ed83",
                                                "text": "Pride, pomp and circumstance of glorious war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f7e3995-94a2-3532-a48f-283bc524f222",
                                        "entry_id": "1153958a-d426-32c7-9fe9-cf58eb6592b9",
                                        "glosses": [
                                            "Highest level or rank; (figurative) elevation reached; loftiness or glory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f31304d-ad28-414b-86df-8adb978d8d90",
                                                "sense_id": "1f7e3995-94a2-3532-a48f-283bc524f222",
                                                "text": "a falcon, towering in her pride of place"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61ca03e0-94fd-3b87-ac63-145843a19c59",
                                        "entry_id": "1153958a-d426-32c7-9fe9-cf58eb6592b9",
                                        "glosses": [
                                            "Consciousness of power; fullness of animal spirits; mettle; wantonness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "191ec950-9f03-3924-ab90-a22ce149f238",
                                        "entry_id": "1153958a-d426-32c7-9fe9-cf58eb6592b9",
                                        "glosses": [
                                            "Lust or heat; sexual desire (especially in a female animal)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32f6c651-9165-3e10-83d2-6713bca4dfbe",
                                        "entry_id": "1153958a-d426-32c7-9fe9-cf58eb6592b9",
                                        "glosses": [
                                            "A company of lions or other large felines."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a2ed02b-c88b-4fab-90d9-bf2538fa26d3",
                                                "sense_id": "32f6c651-9165-3e10-83d2-6713bca4dfbe",
                                                "text": "A pride of lions often consists of a dominant male, his harem and their offspring, but young adult males 'leave home' to roam about as bachelors pride until able to seize/establish a family pride of their own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2154e3b7-6cc9-30bb-9326-2a2cfaeff95d",
                                        "entry_id": "1153958a-d426-32c7-9fe9-cf58eb6592b9",
                                        "glosses": [
                                            "Alternative letter-case form of Pride (“festival for LGBT people”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "261b36fd-7da1-4e01-ac87-761978f0a72b",
                                                "sense_id": "2154e3b7-6cc9-30bb-9326-2a2cfaeff95d",
                                                "text": "For quotations using this term, see Citations:pride."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da29c4db-a9b7-3212-86a6-ac8f811c9a49",
                                        "entry_id": "343025ad-8e1c-3b22-87c1-2679b1b84f34",
                                        "glosses": [
                                            "To take or experience pride in something; to be proud of it."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "641b1074-e763-4f7e-a699-b8dd3f0f2fb4",
                                                "sense_id": "da29c4db-a9b7-3212-86a6-ac8f811c9a49",
                                                "text": "I pride myself on being a good judge of character."
                                            },
                                            {
                                                "example_id": "84a99bf9-6fa8-4599-bd31-7fc57c175f17",
                                                "sense_id": "da29c4db-a9b7-3212-86a6-ac8f811c9a49",
                                                "text": "Ichabod prided himself upon his dancing as much as upon his vocal powers. Not a limb, not a fibre about him was idle; and to have seen his loosely hung frame in full motion and clattering about the room you would have thought Saint Vitus himself, that blessed patron of the dance, was figuring before you in person."
                                            },
                                            {
                                                "example_id": "590f12d1-3b6f-442a-bf95-40673d07b16b",
                                                "sense_id": "da29c4db-a9b7-3212-86a6-ac8f811c9a49",
                                                "text": "RAIB prides itself on being able to send any of its inspectors to site with sufficient investigative skills and technical knowledge to gather evidence for any type of accident."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83a53ba1-aa3a-34e6-b3b4-e859ebb9f7f5",
                                        "entry_id": "059815f8-2fe9-3575-a97a-9b2e5fb550b1",
                                        "glosses": [
                                            "The small European lamprey species Petromyzon branchialis."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1ae7611-d5b5-49d6-a662-8bee8c75d0d6",
                        "source_entry_id": "bda804a4-0bb3-3431-b512-3ddcc40c8842",
                        "source_sense_id": "bf73ee43-0f99-37e1-a9dd-9fbe39194876",
                        "target_lang_word": "troep",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troep",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5dcd5228-d769-3914-b3e9-a8b8fc20bf6d",
                                        "entry_id": "cf759df2-ad6e-3851-a70a-e7f47472d8d6",
                                        "glosses": [
                                            "vele waardeloze spullen door elkaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e5ea3c7-5f76-4efe-b11c-d9aba9ee0c3d",
                                                "sense_id": "5dcd5228-d769-3914-b3e9-a8b8fc20bf6d",
                                                "text": "Wat een troep is het hier!"
                                            },
                                            {
                                                "example_id": "4b76ce66-b9cf-45b0-a870-94769977b8c0",
                                                "sense_id": "5dcd5228-d769-3914-b3e9-a8b8fc20bf6d",
                                                "text": "Dan raapten we alle papiertjes en troep van de grond op om zo geen enkel spoor achter te laten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1c08121-323b-38a4-ac6d-6abcde9b18b5",
                                        "entry_id": "cf759df2-ad6e-3851-a70a-e7f47472d8d6",
                                        "glosses": [
                                            "groep levende wezens"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ab4a64b-0dc1-30db-94bf-32a222020ed8",
                                        "entry_id": "cf759df2-ad6e-3851-a70a-e7f47472d8d6",
                                        "glosses": [
                                            "groep levende wezens",
                                            "militairen, manschappen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c3fa0cd-6f63-4fd9-8a17-00a842eda66c",
                                                "sense_id": "5ab4a64b-0dc1-30db-94bf-32a222020ed8",
                                                "text": "Hij viel met een troep van zo'n honderd soldaten op paarden dorpen binnen."
                                            },
                                            {
                                                "example_id": "479f8c1c-923f-4ca6-9afe-c49bc331fe42",
                                                "sense_id": "5ab4a64b-0dc1-30db-94bf-32a222020ed8",
                                                "text": "De Spaanse troepen verschansten zich in de stad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a579b82-7b97-36ec-9d67-c4f342ffa472",
                                        "entry_id": "cf759df2-ad6e-3851-a70a-e7f47472d8d6",
                                        "glosses": [
                                            "groep levende wezens",
                                            "groep dieren"
                                        ],
                                        "tags": [
                                            "ongeordende"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7464e7ed-a6dd-46e1-a8d3-e99b0baedf45",
                                                "sense_id": "5a579b82-7b97-36ec-9d67-c4f342ffa472",
                                                "text": "Een troep verwilderde honden zwierf rond op straat."
                                            },
                                            {
                                                "example_id": "bd253955-2994-4859-8008-3fde47b18d74",
                                                "sense_id": "5a579b82-7b97-36ec-9d67-c4f342ffa472",
                                                "text": "In het bos is een troep van vijf of zes wolven waargenomen."
                                            },
                                            {
                                                "example_id": "2af72304-c499-417d-a88d-e152602ffd45",
                                                "sense_id": "5a579b82-7b97-36ec-9d67-c4f342ffa472",
                                                "text": "Grote troepen eenden en ganzen trokken over."
                                            },
                                            {
                                                "example_id": "b24dae4e-d16a-47b3-94e1-5826f4c4bf9f",
                                                "sense_id": "5a579b82-7b97-36ec-9d67-c4f342ffa472",
                                                "text": "Mensen vormen nog steeds een troep, net als apen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a1ac971-7595-3958-b068-dad6806b9c30",
                                        "entry_id": "cf759df2-ad6e-3851-a70a-e7f47472d8d6",
                                        "glosses": [
                                            "groep levende wezens",
                                            "ongeordende groep mensen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133bb0b5-ce36-4e92-a4f8-7f8d22c7ce88",
                                                "sense_id": "9a1ac971-7595-3958-b068-dad6806b9c30",
                                                "text": "Een troep gillende kinderen rende voorbij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
