                                        "glosses": [
                                            "mit der Absicht, ein zukünftiges Ereignis zu verhindern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da2c6ceb-18ff-4ce1-96bb-50f85aa2e6ae",
                                                "sense_id": "d49f098b-0e51-333d-80b6-87f2bb575a7a",
                                                "text": "Wir müssen vorbeugend handeln und vorbeugende Maßnahmen treffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "vorbeugend",
                                "target_lang_code": "de",
                                "target_senses": [
