                    {
                        "sense_id": "11d0f3fc-1eca-389c-af8b-93dd10aac309",
                        "entry_id": "e3183f83-3429-3c94-871c-67d8106acb94",
                        "glosses": [
                            "wrodzona zdolność nieracjonalnego, acz adekwatnego zachowywania się w danej sytuacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66629185-c964-49fb-83f2-51881289cad6",
                                "sense_id": "11d0f3fc-1eca-389c-af8b-93dd10aac309",
                                "text": "Instynkt mówi mi, że czeka nas śmierć."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "16c48fee-4e41-38c8-a79d-dedce933e7df",
                        "entry_id": "e3183f83-3429-3c94-871c-67d8106acb94",
                        "glosses": [
                            "wrodzona zdolność żywych organizmów do złożonych, celowych działań, swoistych dla danego gatunku i ważnych dla przetrwania"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52af1799-2d72-4efa-8bc1-2e9c5ede5101",
                        "source_entry_id": "e3183f83-3429-3c94-871c-67d8106acb94",
                        "source_sense_id": "11d0f3fc-1eca-389c-af8b-93dd10aac309",
                        "target_lang_word": "instinct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instinct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "366ebd0e-2058-3907-9148-8f4fe1165296",
                                        "entry_id": "3d5ff126-56ab-3ca1-8f2a-224f9dc4b077",
                                        "glosses": [
                                            "A natural or inherent impulse or behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b7b7b2-1d0d-4822-a2d9-144d0d88fd87",
                                                "sense_id": "366ebd0e-2058-3907-9148-8f4fe1165296",
                                                "text": "Many animals fear fire by instinct."
                                            },
                                            {
                                                "example_id": "04336567-7c94-4efb-942f-702c6b1e8992",
                                                "sense_id": "366ebd0e-2058-3907-9148-8f4fe1165296",
                                                "text": "By a divine instinct, men's minds mistrust / Ensuing dangers."
                                            },
                                            {
                                                "example_id": "88441421-de80-428a-8039-b25add58a1d3",
                                                "sense_id": "366ebd0e-2058-3907-9148-8f4fe1165296",
                                                "text": "In spite of these qualifications, the broad distinction between instinct and habit is undeniable. To take extreme cases, every animal at birth can take food by instinct, before it has had opportunity to learn; on the other hand, no one can ride a bicycle by instinct, though, after learning, the necessary movements become just as automatic as if they were instinctive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e5092b-0f6b-3b70-94af-1aa9c50aa093",
                                        "entry_id": "3d5ff126-56ab-3ca1-8f2a-224f9dc4b077",
                                        "glosses": [
                                            "An intuitive reaction not based on rational conscious thought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9377eff-492b-42ab-acb3-ad313710ab84",
                                                "sense_id": "62e5092b-0f6b-3b70-94af-1aa9c50aa093",
                                                "text": "an instinct for order; to be modest by instinct"
                                            },
                                            {
                                                "example_id": "4f5ef9c1-eb0e-4e8c-94a1-90cd3752a07f",
                                                "sense_id": "62e5092b-0f6b-3b70-94af-1aa9c50aa093",
                                                "text": "Debbie's instinct was to distrust John."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "instinct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c0a4103-e2a0-3dd5-8182-adf599e5b37e",
                                        "entry_id": "116b2c13-6b60-3f7a-b4b6-ed0c666049aa",
                                        "glosses": [
                                            "Imbued, charged (with something)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23abdf90-10cf-48a3-939d-afb608b85d9c",
                                                "sense_id": "0c0a4103-e2a0-3dd5-8182-adf599e5b37e",
                                                "text": "The chariot of paternal deity […] / Itself instinct with spirit, but convoyed / By four cherubic shapes."
                                            },
                                            {
                                                "example_id": "e7a19629-7834-4f65-8354-0715c6dafd73",
                                                "sense_id": "0c0a4103-e2a0-3dd5-8182-adf599e5b37e",
                                                "text": "a noble performance, instinct with sound principle"
                                            },
                                            {
                                                "example_id": "c9e434fc-073b-42fe-8238-cbcc7fe4e245",
                                                "sense_id": "0c0a4103-e2a0-3dd5-8182-adf599e5b37e",
                                                "text": "Her eyes, whose colour I had not at first known, so dim were they with repressed tears, so shadowed with ceaseless dejection, now, lit by a ray of the sunshine that cheered her heart, revealed irids of bright hazel – irids large and full, screened with long lashes; and pupils instinct with fire."
                                            },
                                            {
                                                "example_id": "f2ec340a-70e1-463e-a493-46d8c2b59d3c",
                                                "sense_id": "0c0a4103-e2a0-3dd5-8182-adf599e5b37e",
                                                "text": "It was a most Bedlamite catalogue of horrors, which, if true, made the wholesome moors a place instinct with tragedy."
                                            },
                                            {
                                                "example_id": "c543a225-7b9f-4fd9-8088-9e4d86f5a89b",
                                                "sense_id": "0c0a4103-e2a0-3dd5-8182-adf599e5b37e",
                                                "text": "This thing, which seemed instinct with a fearsome and unnatural malignancy, was of a somewhat bloated corpulence, and squatted evilly on a rectangular block or pedestal covered with undecipherable characters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c901ac8-3282-4213-acef-136d887de502",
                        "source_entry_id": "e3183f83-3429-3c94-871c-67d8106acb94",
                        "source_sense_id": "11d0f3fc-1eca-389c-af8b-93dd10aac309",
                        "target_lang_word": "instinct",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instinct",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cde60b6b-632f-37c0-b97d-68f778861aac",
                                        "entry_id": "8c8c9cd6-0984-36f3-9256-4005ea6e5005",
                                        "glosses": [
                                            "Mouvement intérieur qui est naturel aux animaux et qui les fait agir sans le secours de la réflexion pour accomplir des actes conformes à leur espèce et adaptés à leurs besoins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97edc926-c372-47b8-9d64-fe90d5e38fad",
                                                "sense_id": "cde60b6b-632f-37c0-b97d-68f778861aac",
                                                "text": "Négligés par les béhavioristes, l’instinct, la pensée, la perception, la complexité des motivations réinterfèrent dans l’étude des comportements et de l’apprentissage qui en dépend."
                                            },
                                            {
                                                "example_id": "be97aa9a-df94-4d9a-8b61-3523e4b50492",
                                                "sense_id": "cde60b6b-632f-37c0-b97d-68f778861aac",
                                                "text": "Mais aussi bien et, du moins jusqu’à ce jour, parfois mieux que l’homme, [le termite] a su tirer parti du seul avantage qu’une marâtre oublieuse, curieuse ou simplement indifférente ait bien voulu lui laisser : une petite force qu’on ne voit pas, que chez lui nous appelons l’instinct, et chez nous, sans qu’on sache pourquoi, l’intelligence."
                                            },
                                            {
                                                "example_id": "c6268e4c-17a7-4491-a84d-d4cbe31ede7b",
                                                "sense_id": "cde60b6b-632f-37c0-b97d-68f778861aac",
                                                "text": "Les bêtes se conduisent, se gouvernent par instinct, par pur instinct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68eee2c0-a5dc-368b-8bac-dce8cbd8ac44",
                                        "entry_id": "8c8c9cd6-0984-36f3-9256-4005ea6e5005",
                                        "glosses": [
                                            "Mouvement intérieur et involontaire auquel on attribue les actes non réfléchis, les sentiments indélibérés ou, par extension, une grande aptitude, une forte propension à quelque chose, en parlant de l’homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "302f65e4-b3b2-4759-adb4-58215e0869f2",
                                                "sense_id": "68eee2c0-a5dc-368b-8bac-dce8cbd8ac44",
                                                "text": "Or savez-vous quels sont ses deux instincts naturels, irrésistibles dans l’ordre psychique ? c’est l’amour et la liberté. Ces deux instincts naturels se sont socialement combattus jusqu’à présent ; il a fallu que l’homme immolât ou plutôt subordonnât l’un à l’autre."
                                            },
                                            {
                                                "example_id": "7f196729-933e-4370-a1a2-32e0e9449040",
                                                "sense_id": "68eee2c0-a5dc-368b-8bac-dce8cbd8ac44",
                                                "text": "Bert, avec l’obstination convulsive de l’instinct, s’étaya contre les parois, jusqu’à ce que le ballon piquât du nez."
                                            },
                                            {
                                                "example_id": "94038d4f-95d5-479e-a78a-1076d86b3d2a",
                                                "sense_id": "68eee2c0-a5dc-368b-8bac-dce8cbd8ac44",
                                                "text": "Le bon sens, c’est l’instinct des hommes ; or, avez-vous jamais vu des animaux renoncer par système à obéir à leur instinct ? Les bêtes ne sont pas si bêtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b45345e6-c2ca-303f-803e-7641408353c9",
                                        "entry_id": "8c8c9cd6-0984-36f3-9256-4005ea6e5005",
                                        "glosses": [
                                            "Penchant spontané."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46f132f2-0664-4713-9bf7-da4d30543e4f",
                                                "sense_id": "b45345e6-c2ca-303f-803e-7641408353c9",
                                                "text": "Cette gravité de l’œuvre poursuivie par le prolétariat ne saurait convenir à la clientèle jouisseuse de nos politiciens ; ceux-ci veulent rassurer la bourgeoisie et lui promettent de ne pas laisser le peuple s’abandonner à ses instincts anarchiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36c3ad7a-c1f6-44a1-9290-39f55a6d1076",
                        "source_entry_id": "e3183f83-3429-3c94-871c-67d8106acb94",
