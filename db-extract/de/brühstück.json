                ],
                "senses": [
                    {
                        "sense_id": "5cc687f2-4761-3ef0-9fbd-447b9f176eff",
                        "entry_id": "1c80a8a0-5618-39eb-a8df-02f8af1e5cd0",
                        "glosses": [
                            "Brotteig oder Zusatz zu einem Brotteig, der aus einer Mischung aus kochendem Wasser und Schrot, Mehl oder zerbröseltem geröstetem Altbrot besteht"
                        ],
                        "tags": [
                            "Bäckerhandwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "c09285e5-d5f1-4269-95c3-823695b77674",
                                "sense_id": "5cc687f2-4761-3ef0-9fbd-447b9f176eff",
                                "text": "„Ich fertige ein Brühstück mit 150g Vollkornmehl und 300ml kochendem Wasser an […].“"
                            },
                            {
                                "example_id": "59ba9125-ce5a-451d-90ac-6bb6fa7107e6",
                                "sense_id": "5cc687f2-4761-3ef0-9fbd-447b9f176eff",
                                "text": "„Für das Brühstück am Vortag des Backtages das Mehl in eine Schüssel geben, 190 g Wasser abwiegen, aufkochen und unter das Mehl rühren.“"
                            },
                            {
                                "example_id": "638e104b-b3ff-4a19-bad7-f80e48c2bd47",
                                "sense_id": "5cc687f2-4761-3ef0-9fbd-447b9f176eff",
                                "text": "„Für das Brühstück die trockenen Zutaten in einer Schüssel mischen, mit dem kochenden Wasser übergießen, vermischen und abkühlen lassen.“"
                            },
                            {
                                "example_id": "89b8fe25-cdec-414d-9390-8ed09d8390bf",
                                "sense_id": "5cc687f2-4761-3ef0-9fbd-447b9f176eff",
                                "text": "„Bei der Herstellung von Roggenschrotbrot wurde das Restbrot im Quell- bzw. Brühstück mitverarbeitet.“"
                            },
                            {
                                "example_id": "6498f14f-783c-4121-9b96-69b78dba2131",
                                "sense_id": "5cc687f2-4761-3ef0-9fbd-447b9f176eff",
                                "text": "„Vor allem das Brühstück sorgt dafür, dass bereits gebundenes Wasser in den Teig gelangt.“"
                            },
                            {
                                "example_id": "3c23253f-a4c5-4c70-95ed-ee17f210cb6c",
                                "sense_id": "5cc687f2-4761-3ef0-9fbd-447b9f176eff",
                                "text": "„Brühstück: Je wärmer das Wasser, desto mehr können die Festbestandteile Wasser binden. Deshalb beträgt das Verhältnis bei Brühstücken zwischen 1:2 und 1:3 (Festbestandteil:Wasser). Die Wassertemperatur beträgt hierbei ca. 80°C.“"
                            },
                            {
                                "example_id": "49122cd3-a65a-42b0-8d31-c44562a6bf1d",
                                "sense_id": "5cc687f2-4761-3ef0-9fbd-447b9f176eff",
                                "text": "„Es ist eine bekannte Erscheinung, daß die Krume des Weizenschrotes leicht krümelt bzw. leicht bröckelt. Diesen Brotfehler kann man dadurch beheben, daß man mit einem Teil des zu verarbeitenden Schrotes ein Brühstück herstellt. Erfahrungsgemäß kann man die günstigsten Auswirkungen mit einem 10 %igen Brühstück erwarten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
