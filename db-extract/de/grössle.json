                "senses": [
                    {
                        "sense_id": "dec13be6-85e4-3efd-84c7-3d0ebfcfd49f",
                        "entry_id": "932e93db-9e7f-31ce-83d4-c78192df010e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "559cc6ba-4baa-4560-ac0b-ed275a1e80c5",
                                "sense_id": "dec13be6-85e4-3efd-84c7-3d0ebfcfd49f",
                                "text": "Frau Grössle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4a3e3bbe-a448-4a9e-a726-197683b34607",
                                "sense_id": "dec13be6-85e4-3efd-84c7-3d0ebfcfd49f",
                                "text": "Herr Grössle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3d85bb6a-3d27-40e4-819d-caf36ff29612",
                                "sense_id": "dec13be6-85e4-3efd-84c7-3d0ebfcfd49f",
                                "text": "Die Grössles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "19d0ae20-6b31-4265-9062-f34bcb438049",
                                "sense_id": "dec13be6-85e4-3efd-84c7-3d0ebfcfd49f",
                                "text": "Der Grössle trägt nie die Schals, die die Grössle ihm strickt."
                            },
                            {
                                "example_id": "9996f0fb-756b-4dfd-af82-c0b420053686",
                                "sense_id": "dec13be6-85e4-3efd-84c7-3d0ebfcfd49f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Grössle kommt, geht der Herr Grössle.“"
                            },
                            {
                                "example_id": "cea443dd-10c7-48ab-8e74-f250111b8434",
                                "sense_id": "dec13be6-85e4-3efd-84c7-3d0ebfcfd49f",
                                "text": "Grössle kommt und geht."
                            },
                            {
                                "example_id": "b0f91bb4-b304-4338-b938-d61649e73497",
                                "sense_id": "dec13be6-85e4-3efd-84c7-3d0ebfcfd49f",
                                "text": "Grössles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
