                            }
                        },
                        {
                            "text": "If you force the instrument, you might <w>ledge</w> the narrow passage and block further access.",
                            "target_lang_translations": {
                                "ru": "Если вы будете с силой проталкивать инструмент, вы можете <w>заблокировать</w> узкий проход и закрыть дальнейший доступ."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ledge the canal"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in technical or medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить к образованию случайного уступа или препятствия (особенно при горных работах, строительстве каналов или лечении корневых каналов зубов)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "создавать уступ",
                                "target_lang_sense_clarification": "в канале зуба"
