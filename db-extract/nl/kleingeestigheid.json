                        "examples": [
                            {
                                "example_id": "2253cff5-445a-4b50-a435-d8009654f82f",
                                "sense_id": "bd5da3d3-a34f-3d19-acad-7cf95821c3c3",
                                "text": "Het is een parodie op de „verongelijkte types” in Nederland. „In het eerste deel hekel ik de kleingeestigheid in Nederland, maar daarna loopt het verhaal uit de hand.” Het was collega Micha Wertheim, haar ‘klankbord’, die haar stimuleerde om het theatertje te bouwen. „Hij wilde me aan het knutselen hebben. Het is ook een programma over maken en over bewaren: van de herinneringen aan mijn opa tot aan de spullen die we namens de mensheid in een Voyager de ruimte hebben ingestuurd.”"
                            }
                        ]
                    }
