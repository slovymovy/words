                                ]
                            },
                            {
                                "target_word": "summit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5300dacb-34f2-30d9-a141-c4771b96a27f",
                                        "entry_id": "c018d59a-b315-3972-b62f-20ec98e3ad00",
                                        "glosses": [
                                            "To reach the summit (noun sense 1.1) of (a mountain)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85455286-3348-475f-9edd-307a7c2b18fa",
                                                "sense_id": "5300dacb-34f2-30d9-a141-c4771b96a27f",
                                                "text": "Of the range's 12 peaks, Mount Saskatchewan is the only one that has yet to be summited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc4e123-f9a2-3a9e-bf0f-3313ef2d689c",
                                        "entry_id": "c018d59a-b315-3972-b62f-20ec98e3ad00",
                                        "glosses": [
                                            "To reach the summit of a mountain."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce874ebe-bd68-3ff4-8375-f704bb7ea254",
                                        "entry_id": "c018d59a-b315-3972-b62f-20ec98e3ad00",
                                        "glosses": [
                                            "To attend a summit (noun sense 2.2.2)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea37916d-7536-4822-bc90-555aea7d071e",
                                                "sense_id": "ce874ebe-bd68-3ff4-8375-f704bb7ea254",
                                                "text": "The young President [JFK], who is on the eve of summiting with Soviet Premier Nikita Khrushchev, is ensconced at Hyannis Port, Massachusetts, preparing to fly to Vienna with his wife, Mrs. Jacqueline Kennedy, to meet with Khrushchev to discuss Cold War issues."
                                            },
                                            {
                                                "example_id": "f4e7b953-14d8-4e22-87fc-564f13443375",
                                                "sense_id": "ce874ebe-bd68-3ff4-8375-f704bb7ea254",
                                                "text": "The President had been summiting with Soviet President Leonid Brezhnev in Vienna."
                                            },
                                            {
                                                "example_id": "3dc8141f-8a03-48b7-8f5f-c9ad0133ae87",
                                                "sense_id": "ce874ebe-bd68-3ff4-8375-f704bb7ea254",
                                                "text": "If the Soviet leaders could go on summiting with the US while bombs poured on North Vietnam and yet claim that they had nothing but the best interests of the Vietnamese revolution in mind, there seems precious little reason to cry wolf at Peking-Bonn relations."
                                            },
                                            {
                                                "example_id": "fd3212bd-b323-44a9-95b5-6c454b355538",
                                                "sense_id": "ce874ebe-bd68-3ff4-8375-f704bb7ea254",
                                                "text": "[…] what the North Vietnamese would do while Richard Nixon was summiting in Moscow. […]"
                                            },
                                            {
                                                "example_id": "fb0c1e1f-8a21-4a1a-a031-561629b1ca93",
                                                "sense_id": "ce874ebe-bd68-3ff4-8375-f704bb7ea254",
                                                "text": "From May 29 to June 3, 1988[,] Reagan and Gorbachev summited in Moscow. Expectations of the meeting were low, because Reagan's position as a \"lame duck\" president guaranteed that nothing new of historic import would occur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "summit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25f68256-9e50-362a-9ed3-9f0e4223c1da",
