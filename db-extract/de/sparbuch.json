                                        "entry_id": "36dae012-6b94-382c-b79a-929890bf92a0",
                                        "glosses": [
                                            "A book that passes between a trader and a customer, used to record credit purchases."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
