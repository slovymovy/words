                                "target_senses": [
                                    {
                                        "sense_id": "ab7b9824-7aef-3d0c-a7ba-6cdf2807cc81",
                                        "entry_id": "9bd8293c-a259-3b54-9734-5a42c4b3b90b",
                                        "glosses": [
                                            "The status or term of office of a pontiff or pontifex."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pontificate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a455ff1-dea8-319a-92e2-60b4f8b2f388",
                                        "entry_id": "bfc9e90e-9894-330c-858c-6128048eb9b3",
                                        "glosses": [
                                            "To preside as a bishop, especially at mass."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc1e5ff6-ba46-3fef-ba20-776435f28d64",
                                        "entry_id": "bfc9e90e-9894-330c-858c-6128048eb9b3",
                                        "glosses": [
                                            "To act like a pontiff; to express one's position or opinions dogmatically and pompously as if they were absolutely correct."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6b09b78-8213-37a0-a49e-70770a2e60d6",
                                        "entry_id": "bfc9e90e-9894-330c-858c-6128048eb9b3",
                                        "glosses": [
                                            "To speak in a patronizing, supercilious or pompous manner, especially at length."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b9ea7a-656f-474b-99a8-62a9ba54af32",
                                                "sense_id": "c6b09b78-8213-37a0-a49e-70770a2e60d6",
                                                "text": "During a policy discussion awhile^([sic]) back about New York issues, when Mr. Clinton began to pontificate, she told him that he did not exactly know what he was talking about and to hush up."
                                            },
                                            {
                                                "example_id": "54bf5589-0285-42f6-bc96-c721a285312b",
                                                "sense_id": "c6b09b78-8213-37a0-a49e-70770a2e60d6",
                                                "text": "\"Do you hear that, Ryan? Your mommy is being a pontificating windbag.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "040425a7-2df7-49a0-9277-33c041143087",
                        "source_entry_id": "e16e0556-2c6f-3d69-b82a-bae40c5715c5",
                        "source_sense_id": "c866b5dc-e9cb-3526-9908-9d1340bffd37",
                        "source_sense_description": "Amt, Amtszeit und Würde eines Pontifex",
                        "target_lang_word": "pontificat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pontificat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f337846-4982-3cea-a217-9b1524d95a4f",
                                        "entry_id": "7c775813-daa4-39a2-9c93-f725da31d211",
                                        "glosses": [
                                            "Dignité de grand pontife."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb98255c-841f-40a4-b8fe-111e12a40931",
                                                "sense_id": "2f337846-4982-3cea-a217-9b1524d95a4f",
                                                "text": "César brigua, obtint le pontificat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71427efa-a7e0-3713-9cd5-7bbe8c1d5f04",
                                        "entry_id": "7c775813-daa4-39a2-9c93-f725da31d211",
                                        "glosses": [
                                            "Dignité de pape de l'Église catholique romaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c17c03f-6c7e-4b26-a693-27e4d1e965b8",
                                                "sense_id": "71427efa-a7e0-3713-9cd5-7bbe8c1d5f04",
                                                "text": "Aspirer au pontificat."
                                            },
                                            {
                                                "example_id": "2abccc4c-cd63-4f9d-a97e-d090ab0e909b",
                                                "sense_id": "71427efa-a7e0-3713-9cd5-7bbe8c1d5f04",
                                                "text": "«C'est probablement la fin du pontificat tel qu'on l'a connu jusqu'ici» avec sa cadence effrénée riche d'audiences, de voyages à l'étranger et de multiples engagements, prévient Michel Kubler."
                                            },
                                            {
                                                "example_id": "05f0703f-03fa-4b5a-95be-71a1626d7b47",
                                                "sense_id": "71427efa-a7e0-3713-9cd5-7bbe8c1d5f04",
                                                "text": "Parvenir au souverain pontificat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b251b0f5-50cd-37dd-af3d-31fcdcbcad0a",
                                        "entry_id": "7c775813-daa4-39a2-9c93-f725da31d211",
                                        "glosses": [
                                            "Temps pendant lequel un pontife, un pape a exercé son autorité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67a699f0-6b3f-4658-9db2-d71cba8aefae",
                                                "sense_id": "b251b0f5-50cd-37dd-af3d-31fcdcbcad0a",
                                                "text": "Au début de son pontificat, il s'était, il est vrai, montré bienveillant, moins par générosité naturelle, que dans le dessein de favoriser la conversion des juifs."
                                            },
                                            {
                                                "example_id": "55c341d6-1be8-4ae2-a967-917e0b8e5669",
                                                "sense_id": "b251b0f5-50cd-37dd-af3d-31fcdcbcad0a",
                                                "text": "Quand Léon IV meurt, en 855, elle est élue pape par les cardinaux sous le nom de Jean VIII. Après deux ans de pontificat sans problème Jean VIII tombe cependant enceinte. La papesse cache par des vêtements amples son ventre proéminent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
