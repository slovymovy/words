                    {
                        "sense_id": "8a8a4d7a-0259-3df8-9b7a-38545ff6f0e8",
                        "entry_id": "a4d23acc-69ff-3d91-8391-44e2aa68bf74",
                        "glosses": [
                            "Qualité de ce qui est prolixe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ded152-e2ce-4edf-933f-0dcea05eddb1",
                                "sense_id": "8a8a4d7a-0259-3df8-9b7a-38545ff6f0e8",
                                "text": "Karl lui raconta tout avec la prolixité guerrière d’un vieux soldat."
                            },
                            {
                                "example_id": "5745d7cb-2ffe-47c9-9a63-b4641bb5d22c",
                                "sense_id": "8a8a4d7a-0259-3df8-9b7a-38545ff6f0e8",
                                "text": "Mais Mémé Gâté empoigna son verre d’une main ferme, et le porta à sa bouche sans en renverser la moindre goutte. Fabio afficha une moue admirative, et cette prouesse ranima la prolixité de Justin :"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b29f62e0-83d5-45c2-b226-09ef50a3dba3",
