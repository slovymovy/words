    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8959b16e-6675-3512-b546-2379a641e170",
                "word": "pronouncement",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5339b96b-f0c9-4b95-8f11-ae46c965d1b4",
                        "entry_id": "8959b16e-6675-3512-b546-2379a641e170",
