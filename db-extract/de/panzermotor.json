                "senses": [
                    {
                        "sense_id": "53f6efce-9e6d-321f-98b3-bbe642286e0b",
                        "entry_id": "825b64d8-d2dd-38f5-9460-3bfd485f050b",
                        "glosses": [
                            "Motor, der für den Antrieb eines Kampfpanzers verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "419da99e-4a99-41d0-a5e1-87ecc5a2ce8e",
                                "sense_id": "53f6efce-9e6d-321f-98b3-bbe642286e0b",
                                "text": "„Hastig schickte er einen Entwurf für das Memorandum nach Jerusalem, der eine Menge Forderungen enthielt: Flugzeugmotoren, Panzermotoren, gepanzerte Mannschaftswagen, Wirtschaftshilfe, politische Unterstützung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "743b0db6-665e-4a00-9cdc-467ea5fdf79c",
                        "source_entry_id": "825b64d8-d2dd-38f5-9460-3bfd485f050b",
                        "source_sense_id": "53f6efce-9e6d-321f-98b3-bbe642286e0b",
                        "source_sense_description": "Motor eines Panzers",
                        "target_lang_word": "tank engine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tank engine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7c10159-b7b7-3ca3-86bf-f0ddc494b604",
                                        "entry_id": "5cc0d384-a909-39dc-bec8-4642c16d69e0",
                                        "glosses": [
                                            "A steam locomotive that carries its fuel and water containers on the locomotive frames rather than in a separate tender."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2503c4d-0ec6-4a62-a205-8c8fc36b2ea0",
                                                "sense_id": "a7c10159-b7b7-3ca3-86bf-f0ddc494b604",
                                                "text": "Train journeys were not long in terms of distance, and having regard to these factors, the tank engine inevitably preponderated. [...] Among tank engines, the 0-6-2 wheel arrangement was by far the most numerous, there being nearly 450 of this arrangement, which offers the advantage of good power and adhesive weight, coupled with adequate tank and bunker capacity, within a limited compass."
                                            },
                                            {
                                                "example_id": "3f7c56e2-a8d0-4bde-bdfe-331fec802ea7",
                                                "sense_id": "a7c10159-b7b7-3ca3-86bf-f0ddc494b604",
                                                "text": "The 2-4-2 tank engines of the Great Eastern and the London and North Western were simply adaptations of 2-4-0 main-line engines; the 0-4-4 tank engine owed its parentage to the archaic 0-4-2 mixed traffic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
