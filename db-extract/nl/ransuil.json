                    {
                        "sense_id": "892ade72-bafe-3249-b9b8-51d8299a8a71",
                        "entry_id": "8983fde6-808e-357d-a3a0-838d5edc8764",
                        "glosses": [
                            "bepaald soort vogel, Asio otus, met lange oorpluimen en ronde ogen die recht naar voren staan"
                        ],
                        "tags": [
                            "uilen"
                        ],
                        "examples": [
                            {
                                "example_id": "b839e1da-75e8-4925-9f5a-52b13b4e48c0",
                                "sense_id": "892ade72-bafe-3249-b9b8-51d8299a8a71",
                                "text": "Het moet niet altijd een Charmander of een andere Pokémon zijn. Met apps als iNaturalist en Obsmapp kun je ook een ransuil of gestreepte strandloper spotten, en meteen de wetenschap helpen."
                            },
                            {
                                "example_id": "b80d23af-ffee-41ab-8047-f72a2b459d87",
                                "sense_id": "892ade72-bafe-3249-b9b8-51d8299a8a71",
                                "text": "Projectleider en ecoloog Mark Zekhuis: ,,De natuurakkers zitten vol met vogels. Het is één en al leven. Groenlingen, putters, rietgorzen, fazanten, holenduiven en vinken komen er massaal naartoe om zaden te eten. Op de muizen die er zitten, komen roofvogels af, zoals buizerds, torenvalken, blauwe kiekendieven en zelfs ransuilen. Dit laat zien hoe belangrijk natuurakkers zijn.”"
                            }
                        ]
                    }
