                        "sense_id": "8911c261-3f79-3b95-a134-85786f457e2e",
                        "entry_id": "ee827c8b-92c6-32dc-8b0e-a8a85fb72361",
                        "glosses": [
                            "Qui stimule, stimulant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c638638-0a74-42b8-8078-41799ca170a6",
                                "sense_id": "8911c261-3f79-3b95-a134-85786f457e2e",
                                "text": "L'air par son oxygène, le fluide électrique, le calorique, la lumière, sont les agents stimulateurs, les causes stimulatrices qui entretiennent la vie dans les corps organisés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13cfce94-d1ee-4542-97d2-ad82d6f64e3d",
