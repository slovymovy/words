                                        "glosses": [
                                            "The principles of Edward Bouverie Pusey (1800–1882), English churchman and one of the leaders of the Oxford Movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f36d35c7-cf4e-419f-afad-7b7407aad8c6",
                                                "sense_id": "d857394a-137a-348d-8935-0362e463f820",
                                                "text": "[Deacon Mushrat to Pogo:] The reason I'd never be a member of the public is because they are all heading for Daedalian Doom! Oh yes! They'd like me to back their puny Puseyism. Join the gum-feathered fancies of their flimsy flight – An Icarian end!"
                                            }
