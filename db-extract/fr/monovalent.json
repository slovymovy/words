                "senses": [
                    {
                        "sense_id": "c59b3b97-46f1-38b9-9cca-c7eefc2e17d6",
                        "entry_id": "5e299d1d-beec-3db9-be76-2c346e90fb21",
                        "glosses": [
                            "À valeur unique ; à fonction, effet, ou forme unique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "de5c508a-c73e-3970-afeb-6993c245d4ad",
                        "entry_id": "5e299d1d-beec-3db9-be76-2c346e90fb21",
                        "glosses": [
                            "Se dit d’un élément chimique ou d’un radical ayant soit un électron supplémentaire (comme l’ion chlorure : Cl⁻), soit un électron en moins (comme l’ion sodium : Na⁺)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f134ba21-6a30-31eb-932e-b23fc7eaf2f4",
                        "entry_id": "5e299d1d-beec-3db9-be76-2c346e90fb21",
                        "glosses": [
                            "Désigne un verbe qui demande un seul actant, exprimé ou sous-entendu."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7c4b56b4-624a-3829-9008-ecdd40cd5194",
                        "entry_id": "5e299d1d-beec-3db9-be76-2c346e90fb21",
                        "glosses": [
                            "Qui comprend un seul sérotype de l’agent infectieux, en parlant d’un vaccin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1410163-052c-4518-91e8-ce845f8463cb",
                                "sense_id": "7c4b56b4-624a-3829-9008-ecdd40cd5194",
                                "text": "Le groupe a déjà lancé de premiers essais pour un vaccin monovalent – avec une seule souche de virus – contre la grippe saisonnière. Il a annoncé mardi vouloir lancer l’an prochain des essais cliniques contre la grippe, cette fois-ci avec un vaccin quadrivalent."
                            }
                        ]
                    },
                    {
                        "sense_id": "90b689c6-0968-362d-81d2-9a7fe07c5ff9",
                        "entry_id": "5e299d1d-beec-3db9-be76-2c346e90fb21",
                        "glosses": [
                            "Se dit de chromosomes présents en une seule copie. Désigne l’arrangement des homologues chromosomaux lors de leur appariement méiotique."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "4a7543cf-edf4-48fb-b98f-ba2b5f8ef5b2",
                                "sense_id": "90b689c6-0968-362d-81d2-9a7fe07c5ff9",
                                "text": "Il existe trois possibilités différentes d’appariement lors de la méiose chez les tétraploïdes. Les quatre chromosomes homologues peuvent s’apparier sous la forme de deux bivalents ou d’un tétravalent ; les deux possibilités peuvent conduire à des gamètes fonctionnels. Ils peuvent aussi s’apparier en une combinaison monovalent-trivalent, qui conduit à des gamètes non fonctionnels."
                            }
                        ]
                    }
