                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d56a3c0a-760c-3c9c-ba4c-6c1aa30d74d9",
                                        "entry_id": "803c7c3f-ac64-39be-a6a5-946e1cb08205",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif présent de boire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be6d7538-27fc-4cf2-9d76-760c4ad821e4",
                                                "sense_id": "d56a3c0a-760c-3c9c-ba4c-6c1aa30d74d9",
                                                "text": "Vas-y, bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6be7a2a9-fb40-4bad-a3a0-2d6bfd3925e4",
                        "source_entry_id": "45dff4a5-7005-3cbf-a8e9-54563ff45816",
                        "source_sense_id": "0017006d-3667-315c-8cc9-9da9ce380bf5",
                        "source_sense_description": "musical instrument",
                        "target_lang_word": "Holzblasinstrument",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holzblasinstrument",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b914b7db-8b2d-3f33-98d0-7f78d1055494",
                                        "entry_id": "8ff5e812-05f9-3d48-8604-9138a53afa93",
                                        "glosses": [
                                            "ein Blasinstrument, das zumindest ursprünglich aus Holz gefertigt wurde und bei dem die Schwingung der Luftsäule mittels Luftblatt (flach geformter Luftstrom) oder über ein Rohrblatt erzeugt wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a487e89-fafe-462d-80d7-141f384d5c82",
                                                "sense_id": "b914b7db-8b2d-3f33-98d0-7f78d1055494",
                                                "text": "Es bürgerte sich ein, die Holzblasinstrumente im Orchester immer paarweise zu verwenden. Im klassischen Orchester wurden zwei Flöten, zwei Oboen, zwei Klarinetten und zwei Fagotte als Holzbläsergruppe zur Regel."
                                            },
                                            {
                                                "example_id": "0906e396-99ee-42bd-84ad-209b7437fd46",
                                                "sense_id": "b914b7db-8b2d-3f33-98d0-7f78d1055494",
                                                "text": "Die Holzblasinstrumente wurden ursprünglich alle aus Holz gefertigt. Heute werden einige von ihnen wie z.B. die Querflöte oder das Saxophon aus Metall gefertigt."
                                            },
                                            {
                                                "example_id": "c71d4fdb-b5f5-4ff6-aa33-50ed04b3cc38",
                                                "sense_id": "b914b7db-8b2d-3f33-98d0-7f78d1055494",
                                                "text": "„Wovon hängt es ab, ob ein Musikinstrument zu den Holz- oder Blechblasinstrumenten gehört?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42bc83d6-e793-49a5-ace5-60f32e007830",
                        "source_entry_id": "45dff4a5-7005-3cbf-a8e9-54563ff45816",
