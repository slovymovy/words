                "senses": [
                    {
                        "sense_id": "56f7d89d-8870-37a7-8486-61147d80b6ab",
                        "entry_id": "03fcd72e-ab16-3828-8b2e-4901b8089697",
                        "glosses": [
                            "een aanval met veel materieel en manschappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63dcfdac-c52e-44e9-ac72-20e4214a1ce6",
                                "sense_id": "56f7d89d-8870-37a7-8486-61147d80b6ab",
                                "text": "De stormloop kostte veel manschappen het leven, maar de vesting werd wel ingenomen."
                            },
                            {
                                "example_id": "e83eb8d6-dcef-409d-97a1-a7e38d3c00cf",
                                "sense_id": "56f7d89d-8870-37a7-8486-61147d80b6ab",
                                "text": "De eindstrijd, de laatste stormloop. Hierin zou het lot van volkeren in een bikkelharde strijd worden beslist. Het ging erom wie de wereld zou beheersen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad61f373-bda2-3f8e-8e71-108160af61d7",
                        "entry_id": "03fcd72e-ab16-3828-8b2e-4901b8089697",
                        "glosses": [
                            "plotselinge ongeordende grote groep mensen of dieren die ergens naartoe rent"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e8d52335-83c3-4bd1-b7a8-9e558af64302",
                                "sense_id": "ad61f373-bda2-3f8e-8e71-108160af61d7",
                                "text": "Tijdens de drie dolle dwaze dagen ontstond er een stormloop op de bakken met goedkope merkartikelen."
                            },
                            {
                                "example_id": "e53b0c29-ec15-4bd7-9e00-baf592db9ae4",
                                "sense_id": "ad61f373-bda2-3f8e-8e71-108160af61d7",
                                "text": "Russische centrale bank maant tot kalmte uit vrees voor stormloop"
                            }
                        ]
                    }
                ],
