                "senses": [
                    {
                        "sense_id": "1d151f52-3f5f-3e1a-85c1-076071586b97",
                        "entry_id": "49b69236-1dd4-39de-8398-ba7bd65eea10",
                        "glosses": [
                            "innerer Bereich eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4228372-509f-4c20-93a7-dfdb00d1939f",
                                "sense_id": "1d151f52-3f5f-3e1a-85c1-076071586b97",
                                "text": "„Drei Abzweigungen weiter in Richtung Gebäudeinneres spähte Jacky durch die Tür der Herrentoilette, in der gerade der Wachmann verschwunden war.“"
                            },
                            {
                                "example_id": "acc7e409-b962-4e74-b313-ff567824dd02",
                                "sense_id": "1d151f52-3f5f-3e1a-85c1-076071586b97",
                                "text": "„Das Bild 11 zeigt den für ein Gebäudeinneres idealisierten aber durchaus typischen Ablauf eines Brandes hinsichtlich Brandzeit und Temperaturhöhe.“"
                            },
                            {
                                "example_id": "45c8c9f8-1267-4f78-8e22-575a0b1f9546",
                                "sense_id": "1d151f52-3f5f-3e1a-85c1-076071586b97",
                                "text": "„Notwendige Treppenräume müssen in einer Ebene durchgehend sein und (im Gebäudeinneren) an einer Außenwand liegen.“"
                            },
                            {
                                "example_id": "9a96f650-915e-4873-a027-d425ef4dcfb3",
                                "sense_id": "1d151f52-3f5f-3e1a-85c1-076071586b97",
                                "text": "„Kurz darauf erscheint Koch schwer bewaffnet und setzt seinen Weg im Gebäudeinneren fort.“"
                            },
                            {
                                "example_id": "89b5a664-4003-40ac-9f3f-3d3ec99a32dc",
                                "sense_id": "1d151f52-3f5f-3e1a-85c1-076071586b97",
                                "text": "„Rauchschwalben bauen ihre Nester im Gebäudeinneren etwa in Ställen, Lagerhallen oder Garagen.“"
                            },
                            {
                                "example_id": "ca9cb5c5-de9d-4058-96e4-784f2a53ef61",
                                "sense_id": "1d151f52-3f5f-3e1a-85c1-076071586b97",
                                "text": "„Die Luft im Gebäudeinneren schmeckte abgestanden, aber ließ sich unbedenklich atmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
