                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727b49ec-1af1-468b-b83d-6e737897d48e",
                                                "sense_id": "dfc102bf-a185-325e-8311-f8e838a7d934",
                                                "text": "Idziemy w góry, więc weź kurtkę i nakrycie głowy."
                                            },
                                            {
                                                "example_id": "a42e6ef1-6e53-437c-983c-f515fe960171",
                                                "sense_id": "dfc102bf-a185-325e-8311-f8e838a7d934",
                                                "text": "Proszę nie wchodzić do czytelni w nakryciu głowy."
                                            },
                                            {
                                                "example_id": "08523814-a16e-416b-a458-438dad38085c",
                                                "sense_id": "dfc102bf-a185-325e-8311-f8e838a7d934",
                                                "text": "Tam jest stoisko z nakryciami głowy, pooglądaj sobie bereciki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
