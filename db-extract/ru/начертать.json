                "senses": [
                    {
                        "sense_id": "d0b2c2d4-a87b-3ca7-b069-60878028afdc",
                        "entry_id": "aa266a11-dc96-3d7a-b3d0-d0a899f0aa6c",
                        "glosses": [
                            "устар. написать, нарисовать"
