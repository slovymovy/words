                "senses": [
                    {
                        "sense_id": "1d05577e-19f8-3525-8f9e-fd08d978bbc1",
                        "entry_id": "140e56c1-2c47-3684-bc3c-8d11a392666d",
                        "glosses": [
                            "Amateurbiologe, der wissenschaftliche Methoden der modernen Biologie wie zum Beispiel Gentechnik und Molekularbiologie abseits der akademischen Forschung anwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df86a58e-8b59-4309-852f-b3493c6b653c",
                                "sense_id": "1d05577e-19f8-3525-8f9e-fd08d978bbc1",
                                "text": "„Es wird geschätzt, dass es weltweit etwa 4000 solcher Biohacker bzw. solcher Start-ups gibt. Für sie ist DNA eine Programmiersprache, mit der sich beliebige Objekte basteln lassen.“"
                            },
                            {
                                "example_id": "ddc6900a-24df-4260-be9f-e9a2467cabdc",
                                "sense_id": "1d05577e-19f8-3525-8f9e-fd08d978bbc1",
                                "text": "„‚Biohacker waren mir schon immer suspekt,‘ schimpfte Angela“"
                            },
                            {
                                "example_id": "25b0f73d-f0ce-41bd-98c7-bc0a31e19da1",
                                "sense_id": "1d05577e-19f8-3525-8f9e-fd08d978bbc1",
                                "text": "„Wenn tatsächlich Biohacker an der Entstehung von Invicta beteiligt gewesen wären, wäre dieses Gras kein natürliches Lebewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "571108f5-d821-4a6b-8730-ad5e25c8e7d6",
                        "source_entry_id": "140e56c1-2c47-3684-bc3c-8d11a392666d",
                        "source_sense_id": "1d05577e-19f8-3525-8f9e-fd08d978bbc1",
                        "source_sense_description": "Amateurbiologe",
                        "target_lang_word": "biohacker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biohacker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7100726e-dc48-3fd2-a7f9-5d322500683c",
                                        "entry_id": "313f828b-f111-30e8-9ab8-6a6bb3070826",
                                        "glosses": [
                                            "A person that engages in biohacking."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7119e77a-07f0-41c9-855c-5f7f4ddfddb4",
                                                "sense_id": "7100726e-dc48-3fd2-a7f9-5d322500683c",
                                                "text": "\"Perhaps in a few years there will be movies about biohackers creating Frankensteinian monsters\" [says] sociologist Everett Rogers."
                                            },
                                            {
                                                "example_id": "d1c64dcf-e2d8-419f-a1f7-652c7f084f08",
                                                "sense_id": "7100726e-dc48-3fd2-a7f9-5d322500683c",
                                                "text": "The bill — even though it is in just one state and has yet to pass — set off a storm of concern in the biohacker community because it seemed to be the first step in a crackdown we all fear is coming. […] I can’t think of many biohackers — or any citizens — who wouldn’t support a ban on involuntary microchipping (though at least for now, that’s a baseless fear)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84b0a613-bad1-467a-8513-0939a0893bfb",
                        "source_entry_id": "140e56c1-2c47-3684-bc3c-8d11a392666d",
                        "source_sense_id": "1d05577e-19f8-3525-8f9e-fd08d978bbc1",
                        "source_sense_description": "Amateurbiologe",
                        "target_lang_word": "biohacker",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biohacker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bfdf451-50cf-3e56-bf3e-c4780845cc01",
                                        "entry_id": "a57c7814-77ef-35b2-adf6-3ea01d8f4208",
                                        "glosses": [
                                            "Personnage qui s’adonne au biohacking."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83406b30-2c2b-45c1-8241-c56553de9e4a",
                                                "sense_id": "4bfdf451-50cf-3e56-bf3e-c4780845cc01",
                                                "text": "Eh bien, cette mégarencontre de manipulateurs d’ADN, la semaine dernière à Boston, a dépassé tout ce que j’imaginais. « Oufissime », comme dirait notre Arthur. Croyez-moi, les biohackers californiens sont loin d’être les seuls à jouer au Lego avec le génome des micro-organismes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
