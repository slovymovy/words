                                                "sense_id": "684c2ba2-af44-3535-82a9-96d7d2301bd2",
                                                "text": "The younger, a frank, bold, bright-eyed child, was mounted on a large Newfoundland dog, whose impatience the elder brother was trying to soothe."
                                            }
                                        ]
                                    }
