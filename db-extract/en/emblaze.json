                                "example_id": "617554fc-911d-4749-8507-019a0b8bac4e",
                                "sense_id": "5824d091-9f3b-3456-baf9-509dd6ce1939",
                                "text": "When a window screen is emblazed with a pretty design, one cannot look into the room beyond because of arrest of vision by the figure upon the screen."
                            },
                            {
                                "example_id": "d0f60558-38ad-40a3-bb66-184f43a36397",
                                "sense_id": "5824d091-9f3b-3456-baf9-509dd6ce1939",
                                "text": "This feeling emblazed inside. / Every nerve like a firefly."
                            }
                        ]
                    }
