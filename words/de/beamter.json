                        "höherer Beamter"
                    ]
                },
                {
                    "sense_id": "88b2c539-228a-3f64-8574-200f6d01da02",
                    "sense_definition": "Person, der Aufgaben der öffentlichen Verwaltung oder die Ausübung staatlicher Gewalt anvertraut sind",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im haftungsrechtlichen Sinne kann auch ein Angestellter der Stadt als <w>Beamter</w> gelten, wenn er hoheitliche Aufgaben erfüllt."
                        },
                        {
                            "text": "Wer Aufgaben der öffentlichen Verwaltung wahrnimmt, wird im Haftungsrecht als <w>Beamter</w> behandelt."
                        }
                    ],
                    "synonyms": [
                        "Amtsträger"
                    ]
                },
                {
                    "sense_id": "51d15680-fd12-322b-afa4-96c57c41ee0a",
                    "sense_definition": "Angestellter in leitender oder büromäßiger Stellung in der Privatwirtschaft, besonders bei Banken",
