                                        "entry_id": "20ec8eb3-5016-3369-940b-a8036c50e3d0",
                                        "glosses": [
                                            "de mate waarin iets respect en bewondering afdwingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0422be33-6779-441a-bb18-fc82cecdbe5a",
                                                "sense_id": "7080593c-4b43-3a55-a4cc-09d70000fd3c",
                                                "text": "Het was de kamer waarin niet werd gewoond, het heiligdom van respectabiliteit dat werd gereserveerd voor bezoekers, voor gesprekken met aspirant-huurders en soms, bij heel bijzondere gelegenheden, voor het theeuurtje op zondagmiddag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00385e81-900f-36e1-9ebd-d4af0693ade2",
                                        "entry_id": "20ec8eb3-5016-3369-940b-a8036c50e3d0",
                                        "glosses": [
                                            "iets dat bewondering afdwingt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96146a74-b930-4fca-a050-4e325f5f8da5",
                        "source_entry_id": "baee8848-de7c-30ac-a54c-459dfc499af1",
                        "source_sense_description": "quality of being respectable",
                        "target_lang_word": "eerbiedwaardigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eerbiedwaardigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8b499deb-7047-3736-a460-0dd43f80e9b3",
                                        "entry_id": "c3fccf49-47c4-36cd-8a59-2709416070d2",
                                        "glosses": [
                                            "het waard zijn om respect te ontvangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72d1680-f8d4-4c3f-8e73-1fd370b7e355",
                                                "sense_id": "8b499deb-7047-3736-a460-0dd43f80e9b3",
                                                "text": "Wie reëel is weet dat de Senaat de afgelopen jaren al veel van die eerbiedwaardigheid heeft verloren."
                                            },
                                            {
                                                "example_id": "f4e9457c-f517-4e2f-a554-753bab2d4fcc",
                                                "sense_id": "8b499deb-7047-3736-a460-0dd43f80e9b3",
                                                "text": "Een van de vele prachtige citaten in dit boek, dat vandaag een stuk overtuigender klinkt dan het door Freud ontworpen Oedipuscomplex, De notie dat het lot onontkoombaar is, had Freud van Nietzsche, schrijft Rijser, met dat verschil dat Freud die onontkoombaarheid ziet als een ziekte, waarvoor de psychoanalyse genezing biedt. Rijser meent dat Freuds these onder meer zoveel weerklank heeft gevonden omdat die op een antieke mythe gebaseerd was en daardoor iets van de eerbiedwaardigheid van de traditie overnam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f26d304-070e-3679-a964-261ae88c26f3",
                                        "entry_id": "c3fccf49-47c4-36cd-8a59-2709416070d2",
                                        "glosses": [
                                            "een voorstadium van de zalig- en heiligverklaring in de Rooms-Katholieke Kerk"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78735a51-892c-45e5-a3c0-e5c646a04d5a",
                        "source_entry_id": "baee8848-de7c-30ac-a54c-459dfc499af1",
