{
    "word_family": [
        "deviate",
        "deviant",
        "deviance",
        "deviative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b16d51fe-b79e-3c4b-ac48-7801ed16b533",
                    "sense_definition": "A departure or variation from the standard, expected, or correct way of acting or speaking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "departure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Any <w>deviation</w> from the company's safety protocols will result in a formal warning.",
                            "target_lang_translations": {
                                "ru": "Любое <w>отклонение</w> от протоколов безопасности компании приведет к официальному предупреждению."
                            }
                        },
                        {
                            "text": "The linguist studied the <w>deviation</w> from standard English found in local dialects.",
                            "target_lang_translations": {
                                "ru": "Лингвист изучал <w>отступление</w> от стандартного английского языка, встречающееся в местных диалектах."
                            }
                        }
                    ],
                    "synonyms": [
                        "divergence",
                        "variation",
                        "departure"
                    ],
                    "antonyms": [
                        "conformity",
                        "adherence"
                    ],
                    "common_phrases": [
                        "deviation from the norm",
                        "slight deviation",
                        "significant deviation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отход или отличие от стандарта, ожидаемого или правильного способа действий или речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "от нормы или правил"
                            },
                            {
                                "target_lang_word": "отступление",
                                "target_lang_sense_clarification": "от принятых стандартов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9da6a271-a75d-3d8b-ad8a-127102616e8f",
                    "sense_definition": "In statistics, the difference between an observed value and the mean or reference value of a data set.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist calculated the standard <w>deviation</w> to understand the spread of the experimental results.",
                            "target_lang_translations": {
                                "ru": "Ученый рассчитал стандартное <w>отклонение</w>, чтобы понять разброс результатов эксперимента."
                            }
                        },
                        {
                            "text": "A high <w>deviation</w> from the average indicates that the data points are spread out widely.",
                            "target_lang_translations": {
                                "ru": "Высокое <w>отклонение</w> от среднего значения указывает на то, что точки данных сильно разбросаны."
                            }
                        }
                    ],
                    "synonyms": [
                        "variance",
                        "difference"
                    ],
                    "common_phrases": [
                        "standard deviation",
                        "mean deviation",
                        "absolute deviation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В статистике — разница между наблюдаемым значением и средним или эталонным значением набора данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "статистический показатель"
                            },
                            {
                                "target_lang_word": "девиация",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1327be37-2de4-34e2-a8df-50eb0ca80f5d",
                    "sense_definition": "The act of wandering off or turning aside from a physical path, road, or planned route.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "departure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot requested a <w>deviation</w> to the left to avoid the approaching thunderstorm.",
                            "target_lang_translations": {
                                "ru": "Пилот запросил <w>отклонение</w> влево, чтобы избежать приближающейся грозы."
                            }
                        },
                        {
                            "text": "Due to the roadworks, we had to make a minor <w>deviation</w> from our original route.",
                            "target_lang_translations": {
                                "ru": "Из-за дорожных работ нам пришлось сделать небольшое <w>отклонение</w> от нашего первоначального маршрута."
                            }
                        }
                    ],
                    "synonyms": [
                        "detour",
                        "digression",
                        "divergence"
                    ],
                    "common_phrases": [
                        "route deviation",
                        "flight deviation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт ухода или поворота в сторону от физического пути, дороги или запланированного маршрута."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "от курса или маршрута"
                            },
                            {
                                "target_lang_word": "изменение курса",
                                "target_lang_sense_clarification": "в навигации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1c8361d-6aa1-34f9-9781-2b86d04ee4d1",
                    "sense_definition": "A transgression or error, often in a moral or religious context, representing a move away from what is considered right.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "departure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theologian discussed mankind's <w>deviation</w> from divine will throughout history.",
                            "target_lang_translations": {
                                "ru": "Теолог обсуждал <w>отступление</w> человечества от божественной воли на протяжении всей истории."
                            }
                        },
                        {
                            "text": "In some strict societies, any moral <w>deviation</w> is met with severe social consequences.",
                            "target_lang_translations": {
                                "ru": "В некоторых строгих обществах любое моральное <w>отклонение</w> влечет за собой суровые социальные последствия."
                            }
                        }
                    ],
                    "synonyms": [
                        "transgression",
                        "aberration",
                        "lapse"
                    ],
                    "antonyms": [
                        "rectitude",
                        "virtue"
                    ],
                    "common_phrases": [
                        "moral deviation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проступок или ошибка, часто в моральном или религиозном контексте, представляющая собой уход от того, что считается правильным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "от моральных норм"
                            },
                            {
                                "target_lang_word": "прегрешение",
                                "target_lang_sense_clarification": "в религиозном контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}