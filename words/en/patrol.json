{
    "word_family": [
        "patrolman",
        "patroller"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ed09e08-67eb-3869-a7ac-559ac7f5f9c8",
                    "sense_definition": "The act of moving around an area to check that it is safe or to look for trouble, often performed by police or soldiers.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_checking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two officers were on <w>patrol</w> in the downtown area last night.",
                            "target_lang_translations": {
                                "ru": "Двое офицеров были в <w>патруле</w> в центре города прошлой ночью.",
                                "zh": "昨晚有两名警官在市中心区域<w>巡逻</w>。"
                            }
                        },
                        {
                            "text": "The soldiers maintained a constant <w>patrol</w> along the border.",
                            "target_lang_translations": {
                                "ru": "Солдаты вели постоянное <w>патрулирование</w> вдоль границы.",
                                "zh": "士兵们在边境沿线保持着持续的<w>巡逻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "surveillance",
                        "watch",
                        "policing"
                    ],
                    "common_phrases": [
                        "on patrol",
                        "foot patrol",
                        "border patrol",
                        "night patrol"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по перемещению по территории для проверки безопасности или поиска нарушителей",
                        "zh": "在特定区域内巡视以检查安全或寻找异常情况的行为，通常由警察或士兵执行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патрулирование",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "патруль",
                                "target_lang_sense_clarification": "несение службы"
                            },
                            {
                                "target_lang_word": "обход",
                                "target_lang_sense_clarification": "осмотр территории"
                            },
                            {
                                "target_lang_word": "дозор",
                                "target_lang_sense_clarification": "военный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巡逻",
                                "target_lang_sense_clarification": "指巡视检查的动作或状态"
                            },
                            {
                                "target_lang_word": "巡查",
                                "target_lang_sense_clarification": "指巡视并检查"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0f9379f-13e0-3322-bd1b-97f13d478e31",
                    "sense_definition": "A group of people, such as soldiers or police officers, or a group of vehicles that go around an area to guard it.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sent a <w>patrol</w> to investigate the strange noise in the forest.",
                            "target_lang_translations": {
                                "ru": "Мы отправили <w>патруль</w> расследовать странный шум в лесу.",
                                "zh": "我们派出一支<w>巡逻队</w>去调查森林里的奇怪声响。"
                            }
                        },
                        {
                            "text": "The police <w>patrol</w> stopped the car for speeding.",
                            "target_lang_translations": {
                                "ru": "Полицейский <w>патруль</w> остановил машину за превышение скорости.",
                                "zh": "警察<w>巡逻车</w>因超速拦下了那辆车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "squad",
                        "detachment",
                        "unit",
                        "guard"
                    ],
                    "common_phrases": [
                        "patrol car",
                        "patrol boat",
                        "patrol wagon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей или транспортных средств, охраняющих территорию",
                        "zh": "负责巡视和守卫某区域的一组人员或车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патруль",
                                "target_lang_sense_clarification": "отряд"
                            },
                            {
                                "target_lang_word": "дозор",
                                "target_lang_sense_clarification": "разведывательная группа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巡逻队",
                                "target_lang_sense_clarification": "指执行巡逻任务的人员小组"
                            },
                            {
                                "target_lang_word": "巡逻车",
                                "target_lang_sense_clarification": "指执行巡逻任务的车辆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b761cba0-58f9-39b1-b48a-505726f12700",
                    "sense_definition": "A small unit of Scouts or Guides, usually consisting of six to eight members.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leader of the <w>patrol</w> taught the younger scouts how to tie knots.",
                            "target_lang_translations": {
                                "ru": "Лидер <w>патруля</w> учил младших скаутов вязать узлы.",
                                "zh": "<w>小队</w>队长教年幼的童子军如何打结。"
                            }
                        },
                        {
                            "text": "Our <w>patrol</w> set up camp near the river before sunset.",
                            "target_lang_translations": {
                                "ru": "Наш <w>патруль</w> разбил лагерь у реки до заката.",
                                "zh": "我们的<w>小队</w>在日落前在河边扎了营。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "patrol leader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое подразделение в организации скаутов",
                        "zh": "童子军或女童军中的小分队，通常由六到八人组成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патруль",
                                "target_lang_sense_clarification": "у скаутов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小队",
                                "target_lang_sense_clarification": "指童子军中的基层组织单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ce44a85-0aa8-3aa1-8750-27841051e79f",
                    "sense_definition": "To move regularly around an area or building to make sure that it is safe and that there is no trouble.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_checking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Security guards <w>patrol</w> the shopping mall every night.",
                            "target_lang_translations": {
                                "ru": "Охранники <w>патрулируют</w> торговый центр каждую ночь.",
                                "zh": "保安人员每晚都会在商场内<w>巡逻</w>。"
                            }
                        },
                        {
                            "text": "Ships <w>patrol</w> the coastline to prevent illegal fishing.",
                            "target_lang_translations": {
                                "ru": "Корабли <w>патрулируют</w> береговую линию для предотвращения незаконной рыбалки.",
                                "zh": "船只在海岸线<w>巡逻</w>以防止非法捕捞。"
                            }
                        }
                    ],
                    "synonyms": [
                        "guard",
                        "police",
                        "inspect",
                        "watch"
                    ],
                    "common_phrases": [
                        "patrol the streets",
                        "patrol the area",
                        "patrol the border"
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулярно обходить или объезжать территорию для обеспечения безопасности",
                        "zh": "定期在某区域或建筑物周围走动或移动，以确保安全并防止发生问题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патрулировать",
                                "target_lang_sense_clarification": "охранять территорию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巡逻",
                                "target_lang_sense_clarification": "指执行巡逻任务的动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}