                    {
                        "translation_id": "df5b7b69-b8d4-41fb-a20b-1e597ce855bf",
                        "source_entry_id": "1dff45a6-81d0-3148-ba59-78d5951792bd",
                        "source_sense_id": "0c99a18d-f5b6-36e5-9093-cdaab8eea408",
