                        "glosses": [
                            "Donner un caractère florentin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed6d1a2b-e435-4d89-9ac1-ba68efc2eba3",
                                "sense_id": "8775db0d-92bf-323b-9a9e-c33ecac610dd",
                                "text": "Seul le dialecte vénitien diffère... mais Venise a essayé de latiniser (et \"florentiniser\") le lombard qui se parlait originairement dans cette ville pour créer une langue noble et de culture, et une lingua franca (de commerce)..."
                            },
                            {
                                "example_id": "4838cf71-b1d2-409e-9c8f-ae6f6769cf24",
                                "sense_id": "8775db0d-92bf-323b-9a9e-c33ecac610dd",
                                "text": "La « novella 82 » fait partie des Cento Navette Antiche (entre 1281 et 1300), qui « florentinisent » (S. Thiolier-Méjean) les récits arthuriens."
                            },
                            {
                                "example_id": "a8fbb075-6b1a-4ed9-b6f8-e7d6fa2beeb0",
                                "sense_id": "8775db0d-92bf-323b-9a9e-c33ecac610dd",
                                "text": "L’accent de Savonarole s’est florentinisé, paraît-il."
                            }
                        ]
