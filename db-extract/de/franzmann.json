                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Frenchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83d0826e-d57e-3b44-b321-9a675b1b16d1",
                                        "entry_id": "659f1c1b-e641-37e3-9cb0-b8923bd28d59",
                                        "glosses": [
                                            "A native or resident of France, or a francophone, or a person of French lineage."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee9d3c69-5054-481a-8c53-aaee5353acf2",
                                                "sense_id": "83d0826e-d57e-3b44-b321-9a675b1b16d1",
                                                "text": "They seek him here, they seek him there, / Those Frenchies seek him everywhere. / Is he in heaven—is he in hell? / That damned elusive Pimpernel?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Frenchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fba7da8d-e521-36d1-8970-6951e0cf36f6",
                                        "entry_id": "637c0830-32a0-332f-a1d5-38aad36901c6",
                                        "glosses": [
                                            "A short form of various names: Francine, Franchelle, Francoise, etc., e.g. Franchelle \\\"Frenchie\\\" Davis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dfee727-ce7c-4fd8-90b4-d25379c942ad",
                        "source_entry_id": "8098b3f4-12fd-39ca-894e-dabe8ca895b1",
                        "source_sense_id": "8bd2987f-0396-3b69-8b42-da209d3f5ede",
                        "source_sense_description": "Ethnophaulismus, abwertend, veraltet: abfällige Bezeichnung für Franzose",
                        "target_lang_word": "Frenchie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frenchie",
