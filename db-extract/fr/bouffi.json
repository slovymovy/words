                                        "glosses": [
                                            "über das normale Maß vergrößert; durch Flüssigkeitsansammlung ausgedehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "844d5617-f1e4-4ef2-a144-df4c84ae820a",
                                                "sense_id": "ab38a8ed-7eed-35b5-a629-fec428a08e29",
                                                "text": "Sie legte ihre angeschwollenen Füsse hoch."
                                            }
