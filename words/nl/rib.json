            "senses": [
                {
                    "sense_id": "71148434-c5b2-377b-8330-d5d878528509",
                    "sense_definition": "elk van de platte, boogvormige beenderen die de borstkas omsluiten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>ribben</w> waren gebroken en hij was in levensgevaar.",
                            "target_lang_translations": {
                                "fr": "Ses <w>côtes</w> étaient cassées et il était en danger de mort."
                            }
                        },
                        {
                            "text": "Je kunt bij dat magere paard bijna alle <w>ribben</w> tellen.",
                            "target_lang_translations": {
                                "fr": "On peut presque compter toutes les <w>côtes</w> de ce cheval maigre."
                            }
                        }
                    ],
                    "synonyms": [
                        "ribbe"
                    ],
                    "common_phrases": [
                        "rib uit mijn lijf"
                    ],
                    "target_lang_definitions": {
                        "fr": "Chacun des os incurvés qui forment la cage thoracique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "côte",
                                "target_lang_sense_clarification": "os de la cage thoracique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1867b0e-f8e8-34e0-87db-5ac3f4757533",
                    "sense_definition": "een houten of metalen steunbalk in een constructie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "constructie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>rib</w> van het dak was door de storm beschadigd geraakt.",
                            "target_lang_translations": {
                                "fr": "La <w>côte</w> du toit avait été endommagée par la tempête."
                            }
                        },
                        {
                            "text": "De timmerman plaatste een nieuwe <w>rib</w> om de constructie te verstevigen.",
                            "target_lang_translations": {
                                "fr": "Le charpentier a posé une nouvelle <w>côte</w> pour renforcer la structure."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Pièce de charpente ou élément de structure en relief servant de support."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "côte",
                                "target_lang_sense_clarification": "élément de structure ou de charpente"
                            },
                            {
                                "target_lang_word": "nervure",
                                "target_lang_sense_clarification": "élément de renfort dans une construction"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3233d57c-b490-37e8-b42b-4fe5984191fc",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>ribben</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>rib</w> de stof om een patroon te maken.",
                            "target_lang_translations": {
                                "fr": "Je <w>cannelé</w> le tissu pour créer un motif."
                            }
                        },
                        {
                            "text": "Elke dag <w>rib</w> ik de randen van het hout glad.",
                            "target_lang_translations": {
                                "fr": "Chaque jour, je <w>strie</w> les bords du bois pour les lisser."
                            }
                        }
                    ],
                    "traits": [
