                    },
                    {
                        "translation_id": "f7eeb6d1-fd47-48ea-bd4e-98ae0987a206",
                        "source_entry_id": "082a70c7-f2f7-3689-bd75-67798f358b31",
                        "source_sense_description": "a person who works in a carnival",
                        "target_lang_word": "forain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ada20d9-de4f-3675-af70-9d69a3e3abe2",
                                        "entry_id": "8f86fb5c-baaa-3d17-b60b-e782ac1d2b89",
                                        "glosses": [
                                            "Qui n’est pas du lieu, étranger."
                                        ],
                                        "tags": [
                                            "Sens étymologique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d584137-fc02-40b9-89ba-02c01919d41c",
                                                "sense_id": "6ada20d9-de4f-3675-af70-9d69a3e3abe2",
                                                "text": "Le droit de faire la traite fut réservé aux domiciliés, à ceux qui avaient fait souche. … Cette décision marquait un premier écart envers la tutelle de la mère patrie. Elle peut être considérée comme le point de départ de la lutte épisodique, mais qui dura cent ans, entre les forains et les domiciliés."
                                            },
                                            {
                                                "example_id": "b330b85c-9310-43a1-bbae-5fdae02a2e38",
                                                "sense_id": "6ada20d9-de4f-3675-af70-9d69a3e3abe2",
                                                "text": "Saisie foraine, saisie des effets mobiliers d’un débiteur de passage, étranger à la commune."
                                            },
                                            {
                                                "example_id": "cc4b5cde-7e9c-492c-89e9-847ace58a943",
                                                "sense_id": "6ada20d9-de4f-3675-af70-9d69a3e3abe2",
                                                "text": "Audience foraine, audience tenue par le juge de paix, en dehors du chef-lieu de canton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c6fec6-678d-32e5-956f-5553fbfe92c0",
                                        "entry_id": "8f86fb5c-baaa-3d17-b60b-e782ac1d2b89",
                                        "glosses": [
                                            "Extérieur, qualifie un lieu de mouillage en dehors d’un port."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a9cf5ba-e2c2-418f-8f9f-2d46fac9350e",
                                                "sense_id": "b0c6fec6-678d-32e5-956f-5553fbfe92c0",
                                                "text": "Un mouillage forain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46496dcc-ef83-3ddc-8d04-692cdbb49326",
                                        "entry_id": "8f86fb5c-baaa-3d17-b60b-e782ac1d2b89",
                                        "glosses": [
                                            "Relatif à une foire, qui accompagne ; qui fréquente les foires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c1dd735-07cf-459a-bfdc-65006e6442ef",
                                                "sense_id": "46496dcc-ef83-3ddc-8d04-692cdbb49326",
                                                "text": "Ainsi s'affirme, incoercible, le besoin réflexe d'ajuster notre condition à ce qu'elle est et non de suivre l’exclamation superlative des vertiges forains et des boules à facettes des bals pour séduire les filles."
                                            },
                                            {
                                                "example_id": "c08ea17b-7b23-49d7-ac28-1010f63f9a5b",
                                                "sense_id": "46496dcc-ef83-3ddc-8d04-692cdbb49326",
                                                "text": "Willy Ronis (1910-2009) aimait photographier la foule, les moments de rassemblement populaire autour d’une cause comme les ambiances festives dans les guinguettes des bords de Marne ou les attractions foraines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccdcc992-87eb-30f8-bf30-71e03f07e357",
                                        "entry_id": "8f86fb5c-baaa-3d17-b60b-e782ac1d2b89",
                                        "glosses": [
                                            "Relatif aux marchands forains."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6769710a-9797-48b4-96a3-77387571fc86",
                                                "sense_id": "ccdcc992-87eb-30f8-bf30-71e03f07e357",
                                                "text": "Ses cheveux, étalés en frange sur le front, s’y déroulaient avec une élégance foraine du meilleur aloi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e6fafc-841f-37d3-bf9f-e3f9d94dcd08",
                                        "entry_id": "0d23c5d6-2b6a-3192-9e02-8f87e761c4eb",
                                        "glosses": [
                                            "Entrepreneur de spectacles et jeux divers sur les fêtes foraines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a954171-6b2e-4e67-b342-e5f70fb56752",
                                                "sense_id": "d5e6fafc-841f-37d3-bf9f-e3f9d94dcd08",
                                                "text": "Il prétend qu'il est forain ambulant et que son lion est un lutteur formidable!"
                                            },
                                            {
                                                "example_id": "976241d1-e6c5-4dd2-87a9-6763c976cb18",
                                                "sense_id": "d5e6fafc-841f-37d3-bf9f-e3f9d94dcd08",
                                                "text": "Le premier soir, les forains, déjà prêts, les riches, les industriels-forains, les gadjé à casquettes et à combinaisons de toile, commençaient à faire tourner leurs manèges et cogner leurs scooters.,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31f78143-2833-383f-84dd-96a81bc43c70",
                                        "entry_id": "2d5ad561-586e-306d-bb53-4dc3721ea827",
                                        "glosses": [
                                            "Utilisé pour qualifier les manières ou les agissements d’une personne de grossiers."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e92af83e-f27a-49d3-94c9-d095feeac8e5",
                                                "sense_id": "31f78143-2833-383f-84dd-96a81bc43c70",
                                                "text": "L’artisan qui a refait les murs a rayé tout le parquet, il y est allé comme un forain."
                                            },
                                            {
                                                "example_id": "ce4e7ce9-09e8-4cb8-a44b-d6c225961787",
                                                "sense_id": "31f78143-2833-383f-84dd-96a81bc43c70",
                                                "text": "Technique de forain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a292b264-7b55-4bab-b10f-9bc199422550",
