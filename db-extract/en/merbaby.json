                        "glosses": [
                            "A baby mermaid or merman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c7978d9-1737-4a14-ae2a-991d9c697d46",
                                "sense_id": "27e29dfa-0732-3d5e-9d87-2fc49ba6990c",
                                "text": "\"She should have stayed in the ocean where she belonged. She could have married some nice young merman and had some cute little merbabies and lived a long, happy life—\""
                            },
                            {
                                "example_id": "cf090bf5-dee6-4700-a497-7117cfd667c2",
                                "sense_id": "27e29dfa-0732-3d5e-9d87-2fc49ba6990c",
                                "text": "There were mermaids with gold chains around slinky long tails, swimming along with little merchildren. One had a merbaby on her back, the tiniest little pink tail sticking out from under its sling."
                            },
                            {
                                "example_id": "e23bbb31-b4c4-46f9-827a-aa61ff21c6b2",
                                "sense_id": "27e29dfa-0732-3d5e-9d87-2fc49ba6990c",
                                "text": "But Anna held the merbaby tight and carried her towards the sea."
                            }
                        ]
                    }
