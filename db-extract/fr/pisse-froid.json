                "senses": [
                    {
                        "sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                        "entry_id": "a8999d73-b437-3198-b021-c60dc5ede0f4",
                        "glosses": [
                            "Personne morose, revêche, sans chaleur humaine, sans humour."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1a060ba9-cd07-494e-aee4-b8c60ac1223d",
                                "sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                                "text": "'Pisse-froid dans la canicule. C’est la qualification que j’entendais un jour donner à son fils par une bonne mère. Il n’en a pas moins fait fortune dans l’épicerie, où il n’est pas nécessaire d’être un volcan."
                            },
                            {
                                "example_id": "d41aeaa7-3c81-4c77-9abf-b8de5156b322",
                                "sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                                "text": "Joigneau ne l’aime pas. Rien à dire contre lui, ni contre ses idées ; mais c’est un pisse-froid de l’Est."
                            },
                            {
                                "example_id": "c2e4fab8-59cb-4b10-bd9f-a552d8aeb567",
                                "sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                                "text": "— Et le comble, c’est qu’il n’a même pas remarqué la petite blonde, ce sacré pisse-froid !\n— C’est un avide.\n— Quoi ? dit Alexandre en levant ses gros sourcils, un avide ? Quel est le rapport ?\n— Tu n’as pas remarqué qu’en général les avides sont des pisse-froid ?\n— Continue, dit Alexandre. Tu ne sais pas comme ça m’instruit de t’écouter déconner."
                            },
                            {
                                "example_id": "997f7886-80c5-4d73-ba51-baac7b4797d5",
                                "sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                                "text": "On connaît des gens très spirituels qui font des à-peu-près : ils en usent de façon si vive et si joyeuse qu’il faudrait être un triste pisse-froid pour ne pas rire avec eux de bon cœur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d837ccb7-6024-40cc-898f-54e11eb1aeb1",
                        "source_entry_id": "a8999d73-b437-3198-b021-c60dc5ede0f4",
                        "source_sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                        "target_lang_word": "Griesgram",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Griesgram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f739d38-0985-3d33-a629-4bde966ec81f",
                                        "entry_id": "a9088b0e-1a7b-3faa-9b53-a0969047961d",
                                        "glosses": [
                                            "mürrische, übellaunige, abweisende Person"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0c5add0-21bf-4422-8c20-6facf6da7c5d",
                                                "sense_id": "2f739d38-0985-3d33-a629-4bde966ec81f",
                                                "text": "Sei bloß leise im Treppenhaus, sonst fährt dich dieser alte Griesgram aus der zweiten Etage wieder so an wie neulich."
                                            },
                                            {
                                                "example_id": "063ae2b0-a2de-4edc-ac4b-cea74dc1efd0",
                                                "sense_id": "2f739d38-0985-3d33-a629-4bde966ec81f",
                                                "text": "„Dennoch hat der Mann sich zu einem höllischen Griesgram entwickelt, der den lächerlichsten Spitznamen der Stadt mit sich herumschleppte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
