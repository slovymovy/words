                "senses": [
                    {
                        "sense_id": "94d0f6bf-f31d-38e8-9e02-79fe720476ef",
                        "entry_id": "6543d6e6-5192-3d34-a55c-68fb9a8d5e2b",
                        "glosses": [
                            "kobieta recytująca utwór literacki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fff1907-38e8-492b-ba7b-199e42eb6149",
                                "sense_id": "94d0f6bf-f31d-38e8-9e02-79fe720476ef",
                                "text": "Trzy deklamatorki wybrały utwory Norwida."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2219ed5-36c4-4e20-bde5-deb343413a5a",
                        "source_entry_id": "6543d6e6-5192-3d34-a55c-68fb9a8d5e2b",
                        "source_sense_id": "94d0f6bf-f31d-38e8-9e02-79fe720476ef",
                        "target_lang_word": "чтица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чтица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "76fde5b7-51bb-39f9-a4e0-25a942303d6b",
                                        "entry_id": "66b3fded-c4b2-3492-8bb1-5101d5f8b315",
                                        "glosses": [
                                            "женск. к чтец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f24bbdf-e258-481c-97f1-4872a9ca9576",
                                                "sense_id": "76fde5b7-51bb-39f9-a4e0-25a942303d6b",
                                                "text": "Приходит чтица и читает бабке нравоучительные истории по книге."
                                            },
                                            {
                                                "example_id": "2eed71e1-4e56-481f-9b71-ceb5789e8c61",
                                                "sense_id": "76fde5b7-51bb-39f9-a4e0-25a942303d6b",
                                                "text": "Звезда русской декламации, уже не первый год сияющая на провинциальной филармонической сцене, прима-чтица, случайно посетившая этот лучший из миров, хрупкая Нина Реут!"
                                            },
                                            {
                                                "example_id": "144552ab-e895-48a9-9c74-e1dfe3f9ec74",
                                                "sense_id": "76fde5b7-51bb-39f9-a4e0-25a942303d6b",
                                                "text": "Тем не менее он часто пользовался Нелей как чтицей, хотя его и раздражала её манера чтения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
