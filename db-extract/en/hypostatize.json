                "senses": [
                    {
                        "sense_id": "2d361edc-8645-38e6-ac12-cc0daf221fee",
                        "entry_id": "950d1909-8194-305e-a89d-b17f01f51bbe",
                        "glosses": [
                            "To render into, or regard as, a separate and distinct substance; to construe a contextually-subjective and complex abstraction, idea, or concept as a universal object without regard to nuance or change in character."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e49f8856-403d-46b4-91ab-6e5e53e5b8de",
                                "sense_id": "2d361edc-8645-38e6-ac12-cc0daf221fee",
                                "text": "On the other hand, there were a few who could see no objective reality in anything but individuals, and looked upon both species and genera as hypostatized universals."
                            },
                            {
                                "example_id": "d6a93356-c73c-443c-a5cb-cd2e0403b47d",
                                "sense_id": "2d361edc-8645-38e6-ac12-cc0daf221fee",
                                "text": "Positivism, restricted to a programme of investigating observable particulars, cannot grasp the ‘self-formative process of man as process’. It hypostatizes the abstract concept of fact or datum."
                            }
                        ]
                    },
                    {
                        "sense_id": "715b985e-61bd-3b92-b763-18f7822c35b5",
                        "entry_id": "950d1909-8194-305e-a89d-b17f01f51bbe",
                        "glosses": [
                            "To attribute actual or personal existence to."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "43edf813-d4d7-4c83-80a3-6cc873484bad",
                                "sense_id": "715b985e-61bd-3b92-b763-18f7822c35b5",
                                "text": "Progressives are wrong to hypostatize their belief in mankind's eternal advance, and to disavow anything that does not fit this preordained vision."
                            },
                            {
                                "example_id": "517a0aba-e113-413f-9dbb-d180978c1432",
                                "sense_id": "715b985e-61bd-3b92-b763-18f7822c35b5",
                                "text": "Roman Christianity is characterized by filial love and obedience expressed towards the fatherly authority hypostatized in the first Person of the Trinity […]"
                            }
                        ]
                    }
                ],
