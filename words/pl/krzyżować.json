{
    "word_family": [
        "krzyż",
        "krzyżowy",
        "skrzyżowanie",
        "krzyżówka"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7094e1a7-e8fe-3d67-8de5-f6e23a732d50",
                    "sense_definition": "układać części ciała w kształt krzyża",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "układanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz <w>krzyżować</w> ręce na piersiach podczas tego ćwiczenia.",
                            "target_lang_translations": {
                                "ru": "Во время этого упражнения ты должен <w>скрещивать</w> руки на груди."
                            }
                        },
                        {
                            "text": "Dziecko lubi <w>krzyżować</w> nogi, gdy siedzi na podłodze.",
                            "target_lang_translations": {
                                "ru": "Ребенок любит <w>скрещивать</w> ноги, когда сидит на полу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "krzyżować ręce",
                        "krzyżować nogi"
                    ],
                    "target_lang_definitions": {
                        "ru": "складывать части тела крест-накрест"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрещивать",
                                "target_lang_sense_clarification": "о положении рук или ног"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd2f2123-19bf-3410-991f-5646252001d6",
                    "sense_definition": "przecinać się w jednym punkcie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przecinanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym miejscu drogi <w>krzyżują</w> się pod kątem prostym.",
                            "target_lang_translations": {
                                "ru": "В этом месте дороги <w>пересекаются</w> под прямым углом."
                            }
                        },
                        {
                            "text": "Nasze ścieżki często <w>krzyżują</w> się w drodze do pracy.",
                            "target_lang_translations": {
                                "ru": "Наши пути часто <w>пересекаются</w> по дороге на работу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drogi krzyżują się"
                    ],
                    "target_lang_definitions": {
                        "ru": "пересекаться в одной точке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересекаться",
                                "target_lang_sense_clarification": "о дорогах, путях или линиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57e45fe1-10e4-35bb-b96c-d6bdb00d460b",
                    "sense_definition": "łączyć różne organizmy w celu uzyskania potomstwa o nowych cechach",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Naukowcy próbują <w>krzyżować</w> te gatunki roślin, aby zwiększyć ich odporność.",
                            "target_lang_translations": {
                                "ru": "Ученые пытаются <w>скрещивать</w> эти виды растений, чтобы повысить их устойчивость."
                            }
                        },
                        {
                            "text": "Hodowcy często <w>krzyżują</w> różne rasy psów.",
                            "target_lang_translations": {
                                "ru": "Заводчики часто <w>скрещивают</w> разные породы собак."
                            }
                        }
                    ],
                    "synonyms": [
                        "hybrydyzować"
                    ],
                    "target_lang_definitions": {
                        "ru": "соединять разные организмы для получения потомства с новыми признаками"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрещивать",
                                "target_lang_sense_clarification": "в биологии и селекции"
                            },
                            {
                                "target_lang_word": "гибридизировать",
                                "target_lang_sense_clarification": "научный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cf1250b-3b9c-3134-bf07-70c492057cd2",
                    "sense_definition": "powodować, że czyjeś plany nie zostaną zrealizowane",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przeszkadzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nagła choroba może <w>krzyżować</w> wszystkie nasze plany wakacyjne.",
                            "target_lang_translations": {
                                "ru": "Внезапная болезнь может <w>сорвать</w> все наши планы на отпуск."
                            }
                        },
                        {
                            "text": "Nie pozwól, aby drobne problemy <w>krzyżowały</w> twoje cele.",
                            "target_lang_translations": {
                                "ru": "Не позволяй мелким проблемам <w>мешать</w> твоим целям."
                            }
                        }
                    ],
                    "synonyms": [
                        "udaremniać",
                        "psuć"
                    ],
                    "common_phrases": [
                        "krzyżować plany"
                    ],
                    "target_lang_definitions": {
                        "ru": "мешать реализации чьих-либо планов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "о планах или намерениях"
                            },
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "препятствовать осуществлению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9718b8ff-86ac-33c8-b880-956d11389ea6",
                    "sense_definition": "karać śmiercią przez przybicie do krzyża",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starożytnym Rzymie skazańców często <w>krzyżowano</w> publicznie.",
                            "target_lang_translations": {
                                "ru": "В Древнем Риме преступников часто публично <w>распинали</w>."
                            }
                        },
                        {
                            "text": "To okrutne prawo pozwalało <w>krzyżować</w> nawet niewinnych ludzi.",
                            "target_lang_translations": {
                                "ru": "Этот жестокий закон позволял <w>распинать</w> даже невиновных людей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "казнить через прибивание к кресту"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распинать",
                                "target_lang_sense_clarification": "исторический вид казни"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}