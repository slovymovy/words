    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0bb02973-351f-3710-8270-6f643de44c7f",
                    "sense_definition": "Having a large physical distance from one side to the other.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_width",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river is too <w>wide</w> for us to swim across safely.",
                            "target_lang_translations": {
                                "ru": "Река слишком <w>широкая</w>, чтобы мы могли безопасно переплыть её.",
                                "nl": "De rivier is te <w>breed</w> voor ons om veilig naar de overkant te zwemmen.",
                                "tr": "Nehir güvenle karşıya yüzmemiz için çok <w>geniş</w>.",
                                "zh": "这条河太<w>宽</w>了，我们无法安全地游过去。"
                            }
                        },
                        {
                            "text": "She greeted us with a <w>wide</w> smile on her face.",
                            "target_lang_translations": {
                                "ru": "Она встретила нас с <w>широкой</w> улыбкой на лице.",
                                "nl": "Ze begroette ons met een <w>brede</w> glimlach op haar gezicht.",
                                "tr": "Bizi yüzünde <w>geniş</w> bir gülümsemeyle karşıladı.",
                                "zh": "她脸上带着<w>灿烂</w>的笑容迎接我们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "broad"
                    ],
                    "antonyms": [
                        "narrow"
                    ],
                    "common_phrases": [
                        "wide road",
                        "wide river",
                        "wide smile",
                        "wide variety"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий большое расстояние от одной стороны до другой; большой в поперечнике.",
                        "nl": "Met een grote fysieke afstand van de ene kant naar de andere.",
                        "tr": "Bir kenarından diğer kenarına kadar olan mesafesi büyük olan; enli.",
                        "zh": "指物体从一侧到另一侧的物理距离很大。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "о физическом размере"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "breed",
                                "target_lang_sense_clarification": "over fysieke afmeting"
                            },
                            {
                                "target_lang_word": "wijd",
                                "target_lang_sense_clarification": "over uitgestrektheid of opening"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geniş",
                                "target_lang_sense_clarification": "fiziksel boyut veya mesafe için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宽",
                                "target_lang_sense_clarification": "指物理尺寸"
                            },
                            {
                                "target_lang_word": "宽阔",
                                "target_lang_sense_clarification": "形容空间或面积大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dedd9942-efac-3e29-9f17-7d93e8a36d77",
                    "sense_definition": "Including a large number or variety of different people or things; large in scope.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company offers a <w>wide</w> range of products for different needs.",
                            "target_lang_translations": {
                                "ru": "Компания предлагает <w>широкий</w> ассортимент товаров для различных нужд.",
                                "nl": "Het bedrijf biedt een <w>breed</w> scala aan producten voor verschillende behoeften.",
                                "tr": "Şirket farklı ihtiyaçlar için <w>geniş</w> bir ürün yelpazesi sunuyor.",
                                "zh": "该公司为不同需求提供<w>广泛</w>的产品系列。"
                            }
                        },
                        {
                            "text": "Candidates need to have a <w>wide</w> knowledge of current affairs.",
                            "target_lang_translations": {
                                "ru": "Кандидаты должны обладать <w>обширными</w> знаниями о текущих событиях.",
                                "nl": "Kandidaten moeten een <w>uitgebreide</w> kennis van de actualiteit hebben.",
                                "tr": "Adayların güncel olaylar hakkında <w>kapsamlı</w> bir bilgiye sahip olmaları gerekiyor.",
                                "zh": "候选人需要具备<w>广博</w>的时事知识。"
                            }
                        }
                    ],
                    "synonyms": [
                        "broad",
                        "extensive",
                        "vast"
                    ],
                    "antonyms": [
                        "narrow"
                    ],
                    "common_phrases": [
                        "wide range",
                        "wide selection",
                        "wide experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охватывающий большое количество или разнообразие людей или вещей; обширный по охвату.",
                        "nl": "Inclusief een groot aantal of een grote variëteit aan verschillende mensen of dingen; groot in omvang.",
                        "tr": "Çeşitli insan veya nesnelerin büyük bir kısmını ya da çeşitliliğini kapsayan; kapsamı büyük.",
                        "zh": "包含大量或多种不同的人或事物；范围广。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "об ассортименте или знаниях"
                            },
                            {
                                "target_lang_word": "обширный",
                                "target_lang_sense_clarification": "большой по объему"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "breed",
                                "target_lang_sense_clarification": "over assortiment of publiek"
                            },
                            {
                                "target_lang_word": "uitgebreid",
                                "target_lang_sense_clarification": "over kennis of ervaring"
                            },
                            {
                                "target_lang_word": "ruim",
                                "target_lang_sense_clarification": "over keuze of selectie"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geniş",
                                "target_lang_sense_clarification": "ürün yelpazesi veya bilgi gibi durumlar için"
                            },
                            {
                                "target_lang_word": "kapsamlı",
                                "target_lang_sense_clarification": "içerik veya miktar bakımından zengin"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "广泛",
                                "target_lang_sense_clarification": "指范围或涉及面"
                            },
                            {
                                "target_lang_word": "广阔",
                                "target_lang_sense_clarification": "指领域或知识"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa967277-9438-3d00-b9fc-ab36273e084c",
                    "sense_definition": "At a considerable distance from the intended point or target; missing the mark.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "off_target",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His shot went <w>wide</w> of the goal and hit the fence.",
                            "target_lang_translations": {
                                "ru": "Его удар прошел <w>мимо</w> ворот и попал в забор.",
                                "nl": "Zijn schot ging <w>naast</w> het doel en raakte het hek.",
                                "tr": "Şutu kalenin <w>dışına</w> gitti ve çite çarptı.",
                                "zh": "他的射门<w>偏离</w>了球门，打在了围栏上。"
                            }
                        },
                        {
                            "text": "The initial estimates proved to be <w>wide</w> of the mark.",
                            "target_lang_translations": {
                                "ru": "Первоначальные оценки оказались <w>далеки</w> от истины.",
                                "nl": "De eerste schattingen bleken <w>ver</w> van de waarheid te liggen.",
                                "tr": "İlk tahminlerin gerçekten <w>uzak</w> olduğu ortaya çıktı.",
                                "zh": "最初的估计被证明与事实<w>相差甚远</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wide of the mark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся на значительном расстоянии от намеченной цели; неточный.",
                        "nl": "Op een aanzienlijke afstand van het beoogde punt of doel; het doel missend.",
                        "tr": "Hedeflenen noktadan uzakta olan; ıska geçen, hedefi tutturamayan.",
                        "zh": "距离预定目标或点有相当大的偏差；未击中目标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "далёкий",
                                "target_lang_sense_clarification": "от истины или цели"
                            },
                            {
                                "target_lang_word": "мимо",
                                "target_lang_sense_clarification": "в значении промаха"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ernaast",
                                "target_lang_sense_clarification": "het doel missend"
                            },
                            {
                                "target_lang_word": "ver",
                                "target_lang_sense_clarification": "ver van de waarheid of het doel"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uzak",
                                "target_lang_sense_clarification": "gerçekten veya hedeften uzak anlamında"
                            },
                            {
                                "target_lang_word": "dışarıda",
                                "target_lang_sense_clarification": "hedefin veya kulvarın dışında"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏离",
                                "target_lang_sense_clarification": "指偏离目标"
                            },
                            {
                                "target_lang_word": "不准确",
                                "target_lang_sense_clarification": "指估计或判断"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3f6f95ab-84a9-35a5-aa10-100bd4d6c702",
                    "sense_definition": "To the full extent so as to leave a large space or opening.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_width",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist asked the patient to open his mouth <w>wide</w>.",
                            "target_lang_translations": {
                                "ru": "Стоматолог попросил пациента <w>широко</w> открыть рот.",
                                "nl": "De tandarts vroeg de patiënt om zijn mond <w>wijd</w> open te doen.",
                                "tr": "Diş hekimi hastadan ağzını <w>iyice</w> açmasını istedi.",
                                "zh": "牙医让病人把嘴<w>张大</w>。"
                            }
                        },
                        {
                            "text": "He threw the doors <w>wide</w> to let the fresh air in.",
                            "target_lang_translations": {
                                "ru": "Он распахнул двери <w>настежь</w>, чтобы впустить свежий воздух.",
                                "nl": "Hij gooide de deuren <w>wagenwijd</w> open om de frisse lucht binnen te laten.",
                                "tr": "Taze havanın içeri girmesi için kapıları <w>sonuna kadar</w> açtı.",
                                "zh": "他把门<w>敞开</w>，让新鲜空气进来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "open wide"
                    ],
                    "target_lang_definitions": {
                        "ru": "В полной мере, оставляя большое пространство или проем.",
                        "nl": "Tot de volledige omvang om een grote ruimte of opening te laten.",
                        "tr": "Büyük bir açıklık veya alan bırakacak şekilde tamamen.",
                        "zh": "充分地打开，留出很大的空间或开口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широко",
                                "target_lang_sense_clarification": "о раскрытии (рот, глаза)"
                            },
                            {
                                "target_lang_word": "настежь",
                                "target_lang_sense_clarification": "о дверях или окнах"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "wijd",
                                "target_lang_sense_clarification": "over het openen van mond of ogen"
                            },
                            {
                                "target_lang_word": "wagenwijd",
                                "target_lang_sense_clarification": "over deuren of ramen"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "iyice",
                                "target_lang_sense_clarification": "ağız veya göz gibi organları açmak için"
                            },
                            {
                                "target_lang_word": "sonuna kadar",
                                "target_lang_sense_clarification": "kapı veya pencere açmak için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "张大",
                                "target_lang_sense_clarification": "指嘴巴或眼睛"
                            },
                            {
                                "target_lang_word": "敞开",
                                "target_lang_sense_clarification": "指门窗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8446c4de-c81f-36fb-85a1-767f8ec19a44",
                    "sense_definition": "Completely or fully; used as an intensifier.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>wide</w> awake long before the alarm went off.",
                            "target_lang_translations": {
                                "ru": "Я <w>совершенно</w> проснулся задолго до звонка будильника.",
                                "nl": "Ik was al <w>hazewijd</w> wakker lang voordat de wekker afging.",
                                "tr": "Alarm çalmadan çok önce <w>tamamen</w> uyanmıştım.",
                                "zh": "闹钟响之前，我就已经<w>完全</w>清醒了。"
                            }
                        },
                        {
                            "text": "They left the front gate <w>wide</w> open all day.",
                            "target_lang_translations": {
                                "ru": "Они оставили передние ворота <w>настежь</w> открытыми весь день.",
                                "nl": "Ze lieten het voorhek de hele dag <w>wagenwijd</w> openstaan.",
                                "tr": "Ön kapıyı bütün gün <w>ardına kadar</w> açık bıraktılar.",
                                "zh": "他们整天把大门<w>敞开</w>着。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wide awake",
                        "wide open"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью или совершенно; используется для усиления.",
                        "nl": "Volledig of geheel; gebruikt als versterker.",
                        "tr": "Tamamen, büsbütün; pekiştireç olarak kullanılır.",
                        "zh": "完全地；用作强调词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершенно",
                                "target_lang_sense_clarification": "полностью (о состоянии)"
                            },
                            {
                                "target_lang_word": "настежь",
                                "target_lang_sense_clarification": "полностью (открытый)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "hazewijd",
                                "target_lang_sense_clarification": "volledig (wakker)"
                            },
                            {
                                "target_lang_word": "wagenwijd",
                                "target_lang_sense_clarification": "volledig (open)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tamamen",
                                "target_lang_sense_clarification": "durumu vurgulamak için (ör. tamamen uyanık)"
                            },
                            {
                                "target_lang_word": "ardına kadar",
                                "target_lang_sense_clarification": "açık durumlar için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "强调状态"
                            },
                            {
                                "target_lang_word": "大开",
                                "target_lang_sense_clarification": "强调开启程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72fe5db3-f9d7-32ba-86d7-aa1a2b133d8a",
                    "sense_definition": "Away from the target or intended goal; to the side.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "off_target",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrow flew <w>wide</w> and landed in the grass.",
                            "target_lang_translations": {
                                "ru": "Стрела полетела <w>мимо</w> и упала в траву.",
                                "nl": "De pijl vloog <w>mis</w> en landde in het gras.",
                                "tr": "Ok <w>karavana</w> gitti ve çimlere düştü.",
                                "zh": "箭射<w>偏</w>了，掉进了草丛里。"
                            }
                        },
                        {
                            "text": "He fired <w>wide</w>, missing the target completely.",
                            "target_lang_translations": {
                                "ru": "Он выстрелил <w>мимо</w>, полностью не попав в цель.",
                                "nl": "Hij schoot <w>ernaast</w> en miste het doel volledig.",
                                "tr": "<w>Dışarıya</w> ateş etti ve hedefi tamamen ıskaladı.",
                                "zh": "他射<w>偏</w>了，完全没中目标。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoot wide",
                        "go wide"
