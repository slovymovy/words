                "senses": [
                    {
                        "sense_id": "b6c5ca53-d7ed-324f-8af6-0b526ff47f71",
                        "entry_id": "58c71932-e94e-32a6-81db-5d1002cd0c1d",
                        "glosses": [
                            "aanzienlijk, tamelijk veel, tamelijk groot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38190bc-f98f-4902-b7f6-640b1bb20f57",
                                "sense_id": "b6c5ca53-d7ed-324f-8af6-0b526ff47f71",
                                "text": "Hij had een aanmerkelijk belang in de firma."
                            },
                            {
                                "example_id": "2521dc8f-d9c0-4832-9e04-c1356f8ddb04",
                                "sense_id": "b6c5ca53-d7ed-324f-8af6-0b526ff47f71",
                                "text": "Auto's produceren een aanmerkelijk deel van de CO2 die mensen uitstoten."
                            },
                            {
                                "example_id": "d6961aa2-7916-4a8d-97d7-feff7e14a810",
                                "sense_id": "b6c5ca53-d7ed-324f-8af6-0b526ff47f71",
                                "text": "' De naderende wolkenbank was aanmerkelijk donkerder geworden, en op voorstel van Eva liepen ze op een drafje terug naar huis."
                            },
                            {
                                "example_id": "90e5f85a-724c-4c16-91ad-94ad88843f5e",
                                "sense_id": "b6c5ca53-d7ed-324f-8af6-0b526ff47f71",
                                "text": "En aangezien hij in haar ogen een held was, steeg ik aanmerkelijk in haar achting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "794be199-1f8c-4231-b6f0-d7ab6f56226e",
                        "source_entry_id": "58c71932-e94e-32a6-81db-5d1002cd0c1d",
                        "source_sense_id": "b6c5ca53-d7ed-324f-8af6-0b526ff47f71",
