                                        "sense_id": "b9c2dc0e-53fb-38d7-9d26-7a49159175df",
                                        "entry_id": "91952680-c80f-3df9-af5e-cc1ebf08080e",
                                        "glosses": [
                                            "sowohl silberfarbene als auch weiße Anteile enthaltend; hellglänzend weiß mit silbrigem Schimmer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12033273-28eb-44e4-8fcb-6eb73d8acf14",
                                                "sense_id": "b9c2dc0e-53fb-38d7-9d26-7a49159175df",
                                                "text": "Vor dem Altar kniete ein alter Mann mit silberweißem Haar in unscheinbarem Gewand: er hielt die Arme betend empor in der Haltung, in der man die Götter des Olympos angerufen hatte."
                                            },
                                            {
                                                "example_id": "e0253656-2f1a-4e7c-94fd-523f591ce574",
                                                "sense_id": "b9c2dc0e-53fb-38d7-9d26-7a49159175df",
                                                "text": "Rhodium ist ein silberweißes Metall mit einem hohen Oberflächenglanz, das härter als Platin, jedoch nicht ganz so hart wie Iridium ist."
                                            },
                                            {
                                                "example_id": "70d4bc41-ff46-49ad-bbd9-f25358048bf7",
                                                "sense_id": "b9c2dc0e-53fb-38d7-9d26-7a49159175df",
                                                "text": "Frische Mineralproben sind von metallisch glänzender, silberweißer Farbe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
