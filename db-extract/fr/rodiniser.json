                "senses": [
                    {
                        "sense_id": "eb1b2a2e-ab4e-3068-8df0-c73f557fc177",
                        "entry_id": "27507378-9706-36d9-a4f1-23264861a181",
                        "glosses": [
                            "Donner un caractère rappelant le sculpteur Auguste Rodin à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "485f24c0-a62e-4e87-9593-791730c94e87",
                                "sense_id": "eb1b2a2e-ab4e-3068-8df0-c73f557fc177",
                                "text": "[…] plier une trajectoire, s’amuser avec un point fixe, rodiniser un corps, tendre un envol."
                            },
                            {
                                "example_id": "3a3f8a7e-73e1-4168-9ec4-4b68a2d1b444",
                                "sense_id": "eb1b2a2e-ab4e-3068-8df0-c73f557fc177",
                                "text": "Les mains et les pieds sont difficiles à rendre avec « finesse » ;la main est une des parties les plus puissantes et les plus « parlantes » du corps ; il ne faut pas faire l’impasse sur son expressivité ni « Rodiniser » si je puis dire ; de manière aussi systématiquement les pieds !"
                            },
                            {
                                "example_id": "d6b2d7b5-a828-409e-911e-6d5d83b5ee81",
                                "sense_id": "eb1b2a2e-ab4e-3068-8df0-c73f557fc177",
                                "text": "« Évitez de vous « rodiniser »», lance le critique américain Bernard Berenson au jeune peintre."
                            }
                        ]
                    }
                ],
