{
    "word_family": [
        "take",
        "taker",
        "taking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19f1c1a2-3d79-3486-9887-7093a516a1a5",
                    "sense_definition": "To perform an action or test again",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students who fail the course are allowed to <w>retake</w> the final exam.",
                            "target_lang_translations": {
                                "ru": "Студентам, не сдавшим курс, разрешается <w>пересдать</w> итоговый экзамен."
                            }
                        },
                        {
                            "text": "I had to <w>retake</w> the driving test because I made a mistake.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>пересдавать</w> экзамен по вождению, потому что я совершил ошибку."
                            }
                        }
                    ],
                    "synonyms": [
                        "repeat"
                    ],
                    "common_phrases": [
                        "retake exam",
                        "retake test"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнить действие или пройти тест повторно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересдавать",
                                "target_lang_sense_clarification": "о повторной сдаче экзамена или теста"
                            },
                            {
                                "target_lang_word": "повторять",
                                "target_lang_sense_clarification": "о повторении действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ee634fd-ae11-3848-a169-2d384b38379c",
                    "sense_definition": "To get possession of something once more",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hopes to <w>retake</w> its position as the market leader.",
                            "target_lang_translations": {
                                "ru": "Компания надеется <w>вернуть</w> себе позицию лидера рынка."
                            }
                        },
                        {
                            "text": "She managed to <w>retake</w> control of the situation after the confusion.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>вернуть</w> контроль над ситуацией после возникшей путаницы."
                            }
                        }
                    ],
                    "synonyms": [
                        "recover",
                        "reclaim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуть себе контроль или владение чем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вернуть",
                                "target_lang_sense_clarification": "восстановить контроль или позицию"
                            },
                            {
                                "target_lang_word": "восстановить",
                                "target_lang_sense_clarification": "вернуть прежнее состояние или контроль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aa61d17-d7e7-33d3-9cbf-0e3161183645",
                    "sense_definition": "To capture or occupy a place again",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army fought hard to <w>retake</w> the city from the enemy forces.",
                            "target_lang_translations": {
                                "ru": "Армия упорно сражалась, чтобы <w>отбить</w> город у вражеских сил."
                            }
                        },
                        {
                            "text": "They planned a mission to <w>retake</w> the lost territory by dawn.",
                            "target_lang_translations": {
                                "ru": "Они спланировали миссию, чтобы к рассвету <w>отвоевать</w> потерянную территорию."
                            }
                        }
                    ],
                    "synonyms": [
                        "recapture",
                        "reoccupy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Захватить или занять место снова"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвоевать",
                                "target_lang_sense_clarification": "вернуть территорию в ходе борьбы"
                            },
                            {
                                "target_lang_word": "отбить",
                                "target_lang_sense_clarification": "вернуть силой, с боем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcf3be65-505c-3e8c-b649-1ff077e36d09",
                    "sense_definition": "To film or photograph a scene again",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "repeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director decided to <w>retake</w> the scene because the lighting was poor.",
                            "target_lang_translations": {
                                "ru": "Режиссер решил <w>переснять</w> сцену, потому что освещение было плохим."
                            }
                        },
                        {
                            "text": "We had to <w>retake</w> the group photo because someone had their eyes closed.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>переснять</w> групповое фото, потому что у кого-то были закрыты глаза."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снять или сфотографировать сцену снова"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переснимать",
                                "target_lang_sense_clarification": "о повторной съемке сцены или фото"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1cf7a9a-1a78-3308-923f-1e130ad21d7f",
                    "sense_definition": "An instance of sitting for an examination again",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>retake</w> of the math exam is scheduled for next Monday.",
                            "target_lang_translations": {
                                "ru": "<w>Пересдача</w> экзамена по математике назначена на следующий понедельник."
                            }
                        },
                        {
                            "text": "He studied hard for his chemistry <w>retake</w>.",
                            "target_lang_translations": {
                                "ru": "Он усердно готовился к <w>пересдаче</w> по химии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exam retake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай повторной сдачи экзамена"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересдача",
                                "target_lang_sense_clarification": "повторная попытка сдать экзамен"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1d69b8a-60de-3f6a-ae26-36eba939c55f",
                    "sense_definition": "A scene or photograph that is captured again",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "repeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final <w>retake</w> of the movie scene was perfect.",
                            "target_lang_translations": {
                                "ru": "Финальный <w>дубль</w> сцены из фильма был идеальным."
                            }
                        },
                        {
                            "text": "The photographer asked for one more <w>retake</w> to get the lighting right.",
                            "target_lang_translations": {
                                "ru": "Фотограф попросил сделать еще один <w>дубль</w>, чтобы правильно настроить освещение."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сцена или фотография, снятая повторно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубль",
                                "target_lang_sense_clarification": "повторная съемка сцены в кино"
                            },
                            {
                                "target_lang_word": "пересъемка",
                                "target_lang_sense_clarification": "процесс или результат повторной съемки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}