                                        "entry_id": "dfb64baa-5887-34b4-93b1-e9869c161b46",
                                        "glosses": [
                                            "Substancia utilizada para matar plantas, generalmente las perjudiciales."
                                        ],
                                        "tags": [
                                            "a pesar de terminar en -a",
                                            "es un sustantivo masculino"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81d6b284-5e69-4eab-962e-d24e44ef03b1",
                                                "sense_id": "c569218d-4e05-32fc-8ce1-037863102294",
                                                "text": "La atrazina es un herbicida barato y eficaz que próximamente no se podrá utilizar en la UE, pero muy probablemente sí en EE.UU"
                                            },
                                            {
                                                "example_id": "18f36bbd-f57f-4d1e-8b22-257de792c3e1",
                                                "sense_id": "c569218d-4e05-32fc-8ce1-037863102294",
                                                "text": "Científicos del Servicio de Investigación Agraria de EEUU (ARS) han demostrado que el vinagre puede ser un herbicida eficaz y barato"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
