                    {
                        "translation_id": "c6c7e123-16bb-4a4a-89bc-00168bfe9512",
                        "source_entry_id": "59ae7a26-0bc8-3640-afe3-0d23bfa359e7",
                        "source_sense_id": "7b7a8e46-a3b9-352a-9a8f-fdab65358839",
                        "source_sense_description": "an inclination to be partisan",
                        "target_lang_word": "partijdigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partijdigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0df25326-6f88-3437-9cad-9c1175cac9e5",
                                        "entry_id": "5b959df8-0760-380c-b4f0-6a22b9bfd423",
                                        "glosses": [
                                            "de mate waarin iemand kiest voor een van de partijen die strijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "784930c7-56cb-43ff-a6f2-5c122b275de6",
                                                "sense_id": "0df25326-6f88-3437-9cad-9c1175cac9e5",
                                                "text": "Zo iemand noemen wij een besmette getuige, omdat er mogelijk van partijdigheid sprake is."
                                            },
                                            {
                                                "example_id": "ce7e0c98-fbe5-406c-a9a3-17b4eb056ad7",
                                                "sense_id": "0df25326-6f88-3437-9cad-9c1175cac9e5",
                                                "text": "Het wrakingsverzoek werd door de rechter aanvankelijk afgewezen, maar uiteindelijk werd de rechter alsnog vervangen omdat hij onopzettelijk onjuiste informatie had verstrekt. Daardoor zou de schijn van partijdigheid gewekt kunnen worden volgens een tweede wrakingskamer. Hierdoor moest gezocht worden naar een nieuwe rechter, die zich vervolgens moest inlezen in het dossier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a937893e-c50e-401d-9a78-448796216da7",
                        "source_entry_id": "59ae7a26-0bc8-3640-afe3-0d23bfa359e7",
                        "source_sense_id": "7b7a8e46-a3b9-352a-9a8f-fdab65358839",
                        "source_sense_description": "an inclination to be partisan",
                        "target_lang_word": "partisanisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partisanisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e0d7c82-2350-398f-a6d9-f72f52e2b428",
                                        "entry_id": "e01f3c04-e6f5-335d-8c22-50330eda9afb",
                                        "glosses": [
                                            "État de ce qui est partisan, qui relève du parti pris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b575cfa7-25b3-44ca-afb2-af532aa815ca",
                                                "sense_id": "3e0d7c82-2350-398f-a6d9-f72f52e2b428",
                                                "text": "La méfiance face à la Loi est due au fait que la Loi est toujours la construction des hommes et, à ce titre, suspecte de partisanisme, de pression, d’instrumentalisation."
                                            },
                                            {
                                                "example_id": "5e0a8365-8d0c-4fdd-96e7-1ba662cbb0ad",
                                                "sense_id": "3e0d7c82-2350-398f-a6d9-f72f52e2b428",
                                                "text": "Jimmy Wales, à la tête de Wikipedia, critique ouvertement la nouvelle stratégie de certification payante de Twitter version Musk, celui-ci lui riant au nez dans un tweet, en tirant sur le journalisme, qu’il accuse de partisanisme permanent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b639e8ac-b24d-4126-a779-48a3ce09d646",
                        "source_entry_id": "59ae7a26-0bc8-3640-afe3-0d23bfa359e7",
                        "source_sense_id": "7b7a8e46-a3b9-352a-9a8f-fdab65358839",
                        "source_sense_description": "an inclination to be partisan",
                        "target_lang_word": "esprit de parti",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esprit de parti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa3b63ce-d63a-37c2-adc1-b4427d58deb7",
                                        "entry_id": "f10825ec-f8d3-314a-acb7-7f066b982c35",
                                        "glosses": [
                                            "Attachement partial voire sectaire à un parti politique."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d13895a-4fc5-4a61-aec1-505cd050462e",
                                                "sense_id": "aa3b63ce-d63a-37c2-adc1-b4427d58deb7",
                                                "text": "De tout le 27e de lanciers, il n’y eut d’invités que le colonel, Lucien et le petit Riquebourg. Mais, une fois dans les salons de la marquise, l’esprit de parti fit oublier les plus simples convenances à des gens d’ailleurs si polis, polis jusqu’à fatiguer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2a08592-4d9b-4c68-b54c-92c990d8f5a4",
                        "source_entry_id": "59ae7a26-0bc8-3640-afe3-0d23bfa359e7",
                        "source_sense_id": "7b7a8e46-a3b9-352a-9a8f-fdab65358839",
                        "source_sense_description": "an inclination to be partisan",
                        "target_lang_word": "partialité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partialité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fbf90cc-aaf0-34c7-aedb-d48f5dfa2df8",
                                        "entry_id": "91342deb-ad0b-31b1-a4d6-dd9e8d565f2b",
                                        "glosses": [
                                            "Disposition à favoriser une personne, une opinion plutôt qu’une autre, préférence marquée à son égard et contraire à la justice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2450e97f-0181-4746-8e48-5f432071f301",
                                                "sense_id": "7fbf90cc-aaf0-34c7-aedb-d48f5dfa2df8",
                                                "text": "Tous les souverains de la race normande avaient témoigné la partialité la plus marquée pour leurs sujets normands ; les lois […] avaient été fixées comme un joug sur le cou des habitants subjugués, surcroît féodal, des chaînes dont ils étaient chargés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3e34002-80d3-434c-a4f8-bb86585fc636",
                        "source_entry_id": "59ae7a26-0bc8-3640-afe3-0d23bfa359e7",
                        "source_sense_id": "7b7a8e46-a3b9-352a-9a8f-fdab65358839",
                        "source_sense_description": "an inclination to be partisan",
                        "target_lang_word": "Parteinahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
