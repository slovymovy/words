                "senses": [
                    {
                        "sense_id": "15c9bfd7-134a-3064-b17a-bf6965a55c5b",
                        "entry_id": "d630c543-235f-32ba-ad54-0bfb923cef9f",
                        "glosses": [
                            "Verschiebung von Sequenzen von Basentripletts bei der Kopie von Erbinformation"
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "7539527b-396c-4ac6-b3b4-e89be6a1f064",
                                "sense_id": "15c9bfd7-134a-3064-b17a-bf6965a55c5b",
                                "text": "„Um zu zeigen, dass mit 1-Methylpseudouracil veränderte mRNA häufiger unerwünschte Leserasterverschiebungen verursacht, stellte das Team um Willis eine künstliche mRNA her.“"
                            },
                            {
                                "example_id": "2db35650-7864-4993-b0d3-502403955c72",
                                "sense_id": "15c9bfd7-134a-3064-b17a-bf6965a55c5b",
                                "text": "„SARS-CoV-2 und andere Viren, deren Erbgut aus Ribonukleinsäuren (RNA) besteht, nutzen einen Vermehrungstrick, der als programmierte ribosomale Leserasterverschiebung bezeichnet wird.“"
                            },
                            {
                                "example_id": "eccb8380-8e18-4bbd-b3ae-bdb13e6751e3",
                                "sense_id": "15c9bfd7-134a-3064-b17a-bf6965a55c5b",
                                "text": "„Und tatsächlich: Eine der beiden, das Fluorchinolon Merafloxacin, behinderte die Leserasterverschiebung.“"
                            },
                            {
                                "example_id": "4e133061-85dc-43d0-b75b-953bde501013",
                                "sense_id": "15c9bfd7-134a-3064-b17a-bf6965a55c5b",
                                "text": "„Ein markantes Beispiel für die unterschiedliche Wirkung von Deletionen mit und ohne Leserasterverschiebung findet sich für das X-chromosomale Dystrophin-Gen …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e5687fd-8d0f-4740-93bf-bcb0f0f99514",
                        "source_entry_id": "d630c543-235f-32ba-ad54-0bfb923cef9f",
