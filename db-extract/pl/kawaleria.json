                    }
                ],
                "translations": [
                    {
                        "translation_id": "b532df77-1516-4e26-89ad-fe240a953db2",
                        "source_entry_id": "7e11be34-264b-33a2-8d34-f2886c977013",
                        "source_sense_id": "4f4d8a12-9c51-31d6-8c5f-5453b3f74c6c",
                        "target_lang_word": "cavalry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cavalry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41b64dbf-67d3-3447-a1b0-d5de41143717",
                                        "entry_id": "a8713a68-bd74-309a-ad7a-c5b638a1d8dc",
                                        "glosses": [
                                            "The military arm of service that fights while riding horses."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "303b8217-de9a-4521-a564-c74f9b3772c3",
                                                "sense_id": "41b64dbf-67d3-3447-a1b0-d5de41143717",
                                                "text": "Two hundred heavily-armed cavalry rode behind the Audley standard, while close at their heels came the Duke of Lancaster with a glittering train, heralds tabarded with the royal arms riding three deep upon cream-colored chargers in front of him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9290c470-9b0f-33b8-be8e-24dfdf5cf82e",
                                        "entry_id": "a8713a68-bd74-309a-ad7a-c5b638a1d8dc",
                                        "glosses": [
                                            "An individual unit of this arm of service."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "734744b5-846f-3b06-8022-069a18874778",
                                        "entry_id": "a8713a68-bd74-309a-ad7a-c5b638a1d8dc",
                                        "glosses": [
                                            "The branch of the military transported by fast light vehicles, also known as mechanized cavalry."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b398aa1e-ecc5-3628-890b-d7921763fbbd",
                                        "entry_id": "a8713a68-bd74-309a-ad7a-c5b638a1d8dc",
                                        "glosses": [
                                            "A source of rescue, especially in an emergency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7784feaa-f855-422e-94ad-b2ad6c3da04e",
                                                "sense_id": "b398aa1e-ecc5-3628-890b-d7921763fbbd",
                                                "text": "call in the cavalry"
                                            },
                                            {
                                                "example_id": "96fecb4a-ef5c-4c52-9be5-c8639e4ddcde",
                                                "sense_id": "b398aa1e-ecc5-3628-890b-d7921763fbbd",
                                                "text": "\"We landed in their killbox?\" \"We did. I am sor... No, belay that. Heads down! Cavalry incoming!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9d8cb94-2f6a-4046-b773-f216287429fb",
                        "source_entry_id": "7e11be34-264b-33a2-8d34-f2886c977013",
                        "source_sense_id": "4f4d8a12-9c51-31d6-8c5f-5453b3f74c6c",
                        "target_lang_word": "cavalerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cavalerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ce11134-a1ef-357f-ad92-c2c6ff93ccb2",
                                        "entry_id": "75312b91-a4c7-365b-9732-73da00f1500c",
                                        "glosses": [
                                            "Nom collectif qui désignait les différentes espèces de troupes servant à cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d390c9-8552-4931-a221-8f36702871dd",
                                                "sense_id": "8ce11134-a1ef-357f-ad92-c2c6ff93ccb2",
                                                "text": "Quand la guerre recommença, Charles Mignon obtint de passer dans la cavalerie et perdit alors de vue son camarade."
                                            },
                                            {
                                                "example_id": "99dc64bb-f3cb-4d15-9535-1e637409df1c",
                                                "sense_id": "8ce11134-a1ef-357f-ad92-c2c6ff93ccb2",
                                                "text": "Après Alexandre, on chargea la cavalerie d’armes défensives; on donna aux cavaliers de lourdes cuirasses en écailles, puis des cuissarts et des gantelets, et aux chevaux des frontaux et des garde-flancs."
                                            },
                                            {
                                                "example_id": "ef3415d2-787e-48d4-b974-2708129fe5a3",
                                                "sense_id": "8ce11134-a1ef-357f-ad92-c2c6ff93ccb2",
                                                "text": "On se bûchera ! reprit Soudry, c’est selon. Si le préfet et le général, qui sont ses amis, envoient un escadron de cavalerie, les paysans ne bûcheront rien…"
                                            },
                                            {
                                                "example_id": "615bc7bf-5c40-4715-b8e6-237611ec9975",
                                                "sense_id": "8ce11134-a1ef-357f-ad92-c2c6ff93ccb2",
                                                "text": "Dans leurs rangs éclata une furieuse colère : elles ne se sauvèrent pas, mais se jetèrent sur les cailloux et se mirent à bombarder les crânes de la cavalerie qui avait chargé."
                                            },
                                            {
                                                "example_id": "ecef1300-668c-4dda-aa65-87a7175020af",
                                                "sense_id": "8ce11134-a1ef-357f-ad92-c2c6ff93ccb2",
                                                "text": "– Y a qu’la cavalerie ! Ça, c’est quelque chose ! T’as un cheval à toi, c’est ton compagnon, et si tu l’soignes bien, si tu l’dresses comme il faut, sans brutalité, avec lui t’as que des contentements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63727fd2-b62f-31ec-961f-0d42793d30c9",
                                        "entry_id": "75312b91-a4c7-365b-9732-73da00f1500c",
                                        "glosses": [
                                            "Les troupes de blindés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cc6d573-2e2e-3a33-84b8-6edb04ec82e9",
                                        "entry_id": "75312b91-a4c7-365b-9732-73da00f1500c",
                                        "glosses": [
                                            "Ensemble des chevaux d’une entreprise de transports ou de spectacle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2961b60c-b3e2-45d9-a6ef-7db9b9093994",
                                                "sense_id": "6cc6d573-2e2e-3a33-84b8-6edb04ec82e9",
                                                "text": "Nous avions ajouté à notre cavalerie un âne qui portait l’eau et les provisions."
                                            },
                                            {
                                                "example_id": "ba234807-4bbe-481d-857f-4efe68aa6a3a",
                                                "sense_id": "6cc6d573-2e2e-3a33-84b8-6edb04ec82e9",
                                                "text": "Chaque cirque possède, en outre, un maître de manège, appelé chef de piste ou chef d'équitation, qui a la responsabilité de la cavalerie. Écuyer consommé, le dressage en liberté ou en haute école ne doit avoir pour lui aucun secret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8da997a3-13e8-353b-999b-687ab9598eab",
                                        "entry_id": "75312b91-a4c7-365b-9732-73da00f1500c",
                                        "glosses": [
                                            "Opération frauduleuse entre commerçants consistant à se vendre un bien fictif dans le but d’augmenter artificiellement leur chiffre d’affaires, le but étant de pouvoir emprunter auprès d’une banque ou lui escompter des traites issues de cette opération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b9df61f-02a4-423e-85f7-cd292442e88b",
                                                "sense_id": "8da997a3-13e8-353b-999b-687ab9598eab",
                                                "text": "C’était somme toute, ce que l’on a appelé en droit commercial le système des traites de cavalerie qui sont d’ailleurs réprimées par les législations de tous les grands pays."
                                            },
                                            {
                                                "example_id": "e9b2b7a3-420e-401b-8ae4-04fd7eeba41f",
                                                "sense_id": "8da997a3-13e8-353b-999b-687ab9598eab",
                                                "text": "Lors de son plaidoyer de culpabilité, Mario Lirette a reconnu avoir pris part, dès 2015, à un stratagème frauduleux de type cavalerie de chèques (kitting). Cela consiste à déposer un chèque sans provisions et à effectuer des retraits, avant que ledit chèque ne soit compensé par la banque."
                                            },
                                            {
                                                "example_id": "7847992a-7794-4795-bdb8-63309c1ab385",
                                                "sense_id": "8da997a3-13e8-353b-999b-687ab9598eab",
                                                "text": "La Compagnie des Omnibus avait une nombreuse cavalerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea097eb7-c8a3-3bb4-9735-d4cbcb0a6b16",
                                        "entry_id": "75312b91-a4c7-365b-9732-73da00f1500c",
                                        "glosses": [
                                            "Spéculation financière, dans laquelle l’on finance le remboursement des emprunts à échéance par de nouveaux emprunts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec33dba-7c4d-40a8-bda7-984c4423ef54",
                                                "sense_id": "ea097eb7-c8a3-3bb4-9735-d4cbcb0a6b16",
                                                "text": "Le 19 octobre 1929, au Stock Exchange, sur le ticker, cette bande lumineuse couleur vert d’eau, où courent des transactions financières, on vit soudain passer les ombres chiffrées d’une cavalerie en déroute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a448f1df-5d25-3b61-bba6-4144c7fa302c",
                                        "entry_id": "75312b91-a4c7-365b-9732-73da00f1500c",
                                        "glosses": [
                                            "Secours."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcc6d5bb-ef48-425a-a077-23d8cd515e9e",
                                                "sense_id": "a448f1df-5d25-3b61-bba6-4144c7fa302c",
                                                "text": "Tiens, v’là la cavalerie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
