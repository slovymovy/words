                    }
                ],
                "translations": [
                    {
                        "translation_id": "5759e2d2-6391-424c-8507-1633ca8c2530",
                        "source_entry_id": "bc186d9c-4907-393a-95c4-bf7140b1b937",
                        "source_sense_id": "a75436af-445f-38f4-864c-f3dc086ef8ee",
                        "source_sense_description": "zijn verstand niet gebruikend en daardoor ook grote risico's lopend",
                        "target_lang_word": "unvernünftig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unvernünftig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e65f925a-ea7b-3546-b633-e6bd7cdcabd0",
                                        "entry_id": "4fe79f1c-eaca-391c-9549-5f1dcf7a860a",
                                        "glosses": [
                                            "schwach an Vernunft, ohne Vernunft; nicht vernünftig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4269198-2e7a-48cf-bb58-05cecf43e55b",
                                                "sense_id": "e65f925a-ea7b-3546-b633-e6bd7cdcabd0",
                                                "text": "Es war unvernünftig von ihm, nicht für den Test zu lernen."
                                            },
                                            {
                                                "example_id": "4cf5105f-4569-42dc-a1e2-350c71e4e124",
                                                "sense_id": "e65f925a-ea7b-3546-b633-e6bd7cdcabd0",
                                                "text": "„Ich weiß selbst, dass mein Verhalten übertrieben und unvernünftig ist, aber ich kann es nicht ändern.“"
                                            },
                                            {
                                                "example_id": "ffff2203-d5eb-4fda-acbc-b7475afc5525",
                                                "sense_id": "e65f925a-ea7b-3546-b633-e6bd7cdcabd0",
                                                "text": "„Sie entlarven die antikapitalistische Haltung, die viele Menschen heutzutage prägt, als ökonomisch ungerechtfertigt und unvernünftig.“"
                                            },
                                            {
                                                "example_id": "797e7cdb-0425-40ab-a947-9f96cff34157",
                                                "sense_id": "e65f925a-ea7b-3546-b633-e6bd7cdcabd0",
                                                "text": "„Zum aktuellen Zeitpunkt gilt immer alles als unvernünftig und verrückt und verkehrt; zehn Jahre später sieht alles ganz anders aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfd4ee59-63bc-4e7a-a72e-a380fa4adf8e",
                        "source_entry_id": "bc186d9c-4907-393a-95c4-bf7140b1b937",
                        "source_sense_id": "a75436af-445f-38f4-864c-f3dc086ef8ee",
                        "source_sense_description": "zijn verstand niet gebruikend en daardoor ook grote risico's lopend",
                        "target_lang_word": "foolish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foolish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c57a9d9-7ba9-3bae-b5bb-ec800fd04948",
                                        "entry_id": "85cb121c-7b2f-362e-9c61-761af62bff9f",
                                        "glosses": [
                                            "Lacking good sense or judgement; unwise."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa92583-1629-4d3a-8923-8b0ed4b11828",
                                                "sense_id": "9c57a9d9-7ba9-3bae-b5bb-ec800fd04948",
                                                "text": "Next season will, as ever, be a different matter, another problem for Conte to solve as he looks to extend his personal record of four straight league titles in club football across England and Italy. Given his hunger for more – more time, more detail, more work – only the brave or the foolish would bet against him."
                                            },
                                            {
                                                "example_id": "d38ad60d-fa74-4e21-82fc-ccdbd69884ff",
                                                "sense_id": "9c57a9d9-7ba9-3bae-b5bb-ec800fd04948",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "547c5ada-dcce-37e8-b747-90d7baef0a2b",
                                        "entry_id": "85cb121c-7b2f-362e-9c61-761af62bff9f",
                                        "glosses": [
                                            "Resembling or characteristic of a fool."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
