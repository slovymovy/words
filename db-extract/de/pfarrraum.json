                "senses": [
                    {
                        "sense_id": "438282ab-298f-3ac2-9c8f-3c94cf9b1a35",
                        "entry_id": "a2bac067-c536-38f7-b5df-a544484ff017",
                        "glosses": [
                            "Raum zur Nutzung durch eine christliche Gemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83e24a1d-af9a-4b1f-85c3-5d7ecaa4c126",
                                "sense_id": "438282ab-298f-3ac2-9c8f-3c94cf9b1a35",
                                "text": "„Bisher fanden Treffen in einem Raum der Freiwilligen Feuerwehr Unterbiberg statt und in den Pfarrräumen in Perlach.“"
                            },
                            {
                                "example_id": "1e71fa27-f89b-4f18-aa06-1a0e6b4ffac8",
                                "sense_id": "438282ab-298f-3ac2-9c8f-3c94cf9b1a35",
                                "text": "„Im Eigentum der Marktgemeinde Lavamünd stehen die auf dem Grundstück Nr. 819/1 KG Ettendorf errichtete Leichenhalle Ettendorf, bestehend aus 1 Aufbahrungs- und Verabschiedungsraum, 1 Pfarrraum, 2 Vorräumen, 2 WC-Räumen getrennt für Männer und Frauen, 1 Leichenbeschau- bzw. Waschraum, 1 Abstellraum und 1 Garage, […]“"
                            },
                            {
                                "example_id": "068b9040-ece9-4a95-84b4-e4a9160c7d17",
                                "sense_id": "438282ab-298f-3ac2-9c8f-3c94cf9b1a35",
                                "text": "„Sie führte in den Pfarrraum, dort gab es einen Ausgang auf den Friedhof hinter der Kirche.“"
                            },
                            {
                                "example_id": "6f068371-5651-4c05-95db-695b3bf7d5d3",
                                "sense_id": "438282ab-298f-3ac2-9c8f-3c94cf9b1a35",
                                "text": "„Viggi sah in seinen Unterlagen nach. »Ja, sie treffen sich bereits übermorgen. 13 :30 Uhr im Pfarrraum in Habkirchen«, berichtete er.“"
                            },
                            {
                                "example_id": "820ea954-bfdb-4c41-9576-4ebfabff42f8",
                                "sense_id": "438282ab-298f-3ac2-9c8f-3c94cf9b1a35",
                                "text": "„Wir erhalten freundlicherweise die Erlaubnis, die Pfarrräume zu benutzen, und diesmal ist sogar eine Küche dabei.“"
                            },
                            {
                                "example_id": "1dc28df9-c1ea-473e-b1cc-9f368dfcc832",
                                "sense_id": "438282ab-298f-3ac2-9c8f-3c94cf9b1a35",
                                "text": "„Als ich mich an der Uni pro forma für BWL einschrieb, entdeckte ich am Schwarzen Brett einen Anschlag für einen Schauspielkurs, den ein farbiger Amerikaner in den Pfarrräumen von St. Paul an der Theresienwiese gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
