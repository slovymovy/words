                        "examples": [
                            {
                                "example_id": "10d41df4-c69b-49c1-95e6-2104bf1f736a",
                                "sense_id": "f12adace-5f45-3aa6-ac68-85f7c2e39f29",
                                "text": "Considérez aux eaux à Ax, à Bagnoles, ces vieillards qu’on roule, mitouflés rogatons uriques, arthritiques à béquilles, podagres si tellement croquevillés, noués, souffreurs tous sens, ahanants acrobates d’enfer, faces de gargouilles, hideux de supplices, calots hors… Saint Vincent de Paul survient, voit ça… « Allez, dégueulasses ! qu’il les secoue, à la Charité ! nom de Dieu ! foncez ! et que ça fume ! »)"
                            }
                        ]
                    }
