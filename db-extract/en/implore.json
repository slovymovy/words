                                                "sense_id": "5c5dd79e-a7bd-33ad-8d05-2a7171d37304",
                                                "text": "Es ist vergeblich, den Fürsten anzuflehen, er wird die Bittsteller nicht erhören."
                                            },
                                            {
                                                "example_id": "94648588-5b2e-4f8e-8d14-d4213b85fbb0",
                                                "sense_id": "5c5dd79e-a7bd-33ad-8d05-2a7171d37304",
                                                "text": "Sie flehte ihre Peiniger an, wenigstens das Kind in Ruhe zu lassen."
                                            },
                                            {
                                                "example_id": "5af0e321-f39b-485a-b53a-eeb8bd8b7038",
                                                "sense_id": "5c5dd79e-a7bd-33ad-8d05-2a7171d37304",
                                                "text": "Der Mann flehte den Richter auf Knien an, seinen Sohn freizulassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
