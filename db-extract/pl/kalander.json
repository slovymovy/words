                                "target_senses": [
                                    {
                                        "sense_id": "53ea4b8c-ee13-3918-92b3-3569b0718918",
                                        "entry_id": "415cc5ec-0ab4-3483-9095-7c7da3124659",
                                        "glosses": [
                                            "Machine dont on se sert pour presser et lustrer les draps, les toiles et autres étoffes et glacer les papiers."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95f7850c-e7c7-46fc-bdd8-0569ee757d3e",
                                                "sense_id": "53ea4b8c-ee13-3918-92b3-3569b0718918",
                                                "text": "On obtient une feuille mince de caoutchouc en laminant une feuille brute épaisse […] entre deux cylindres chauffés […] d'une calandre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b936d877-63aa-36d2-a8de-67f2d1ff356d",
                                        "entry_id": "415cc5ec-0ab4-3483-9095-7c7da3124659",
                                        "glosses": [
                                            "Entrée d’air située à l’avant d’une automobile permettant d’aérer le moteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "658d7252-c7f3-43ae-89d4-918428f34f14",
                                                "sense_id": "b936d877-63aa-36d2-a8de-67f2d1ff356d",
                                                "text": "La calandre du radiateur s’est graduellement fondue (dans les années 1939-1940) jusqu’à disparaître complètement. Seuls un emblème ou ornement et une grille rappellent son existence."
                                            },
                                            {
                                                "example_id": "09dd8eac-87cf-4d8b-a006-331ccc5dcf2a",
                                                "sense_id": "b936d877-63aa-36d2-a8de-67f2d1ff356d",
                                                "text": "Il compte fortement sur l'effet de surprise et sur la solidité du pare-buffles soudé sur la calandre du Mercedes par un Touareg prévoyant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calandre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1dc6df1-99e9-3ce6-899b-c2c82968b799",
                                        "entry_id": "148da873-f8d2-370b-8487-0794b92138bb",
                                        "glosses": [
                                            "Grande alouette de l’Ancien Monde, qui a une grande tache noire sur le haut de la poitrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba1389c-32b8-4d3b-b3e9-d516223519a3",
                                                "sense_id": "c1dc6df1-99e9-3ce6-899b-c2c82968b799",
                                                "text": "Bien assise était la demeure, et certe\nIl pendait des filigranes du perron ;\nEt le verger fut grand où hantait la calandre diserte."
                                            },
                                            {
                                                "example_id": "c91170da-06bb-413f-9d3d-6bc38942befc",
                                                "sense_id": "c1dc6df1-99e9-3ce6-899b-c2c82968b799",
                                                "text": "Quand les calandres commencèrent à chanter dans les champs en terrasse de l’adret, il quitta encore une fois sa maison et repassa la frontière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calandre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4aff7f82-55f2-3a35-991a-2104a3c6ce66",
                                        "entry_id": "987697de-5107-3af3-b1bf-e1ebbe7f7246",
                                        "glosses": [
                                            "Larve du charançon du blé (Sitophilus granarius (wikispecies))."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37bcaffe-31dd-4ce3-831f-0314d819ca91",
                                                "sense_id": "4aff7f82-55f2-3a35-991a-2104a3c6ce66",
                                                "text": "la calandre granaire est dite cusson dans le midi de la France, et appelée généralement charançon du blé ou simplement charançon."
                                            },
                                            {
                                                "example_id": "0695b4ea-e473-498f-bf05-a46b39055466",
                                                "sense_id": "4aff7f82-55f2-3a35-991a-2104a3c6ce66",
                                                "text": "La calandre des palmiers est nommée vulgairement ver palmiste."
                                            }
                                        ]
                                    }
                                ]
                            },
