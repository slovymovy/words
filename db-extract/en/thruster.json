                ],
                "senses": [
                    {
                        "sense_id": "ba101e65-c839-3589-a04a-a74eec81b43d",
                        "entry_id": "047e502b-2ac6-3135-a429-8d4e5df6a691",
                        "glosses": [
                            "One who thrusts, who pushes or stabs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa4ad1ce-d08a-4f49-8e43-43b4842ce0b4",
                                "sense_id": "ba101e65-c839-3589-a04a-a74eec81b43d",
                                "text": "Nevertheless osteopaths are coming to regard themselves not so much as thrusters, or even as repositioners, of bones, but as releasers of the patient's own recuperative forces."
                            }
                        ]
                    },
                    {
                        "sense_id": "1dc97368-5ca9-361d-8e1d-2c64945fc9df",
                        "entry_id": "047e502b-2ac6-3135-a429-8d4e5df6a691",
                        "glosses": [
                            "A device for propelling an object, especially a spacecraft or a ship (marine vessel)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e6e5a7c4-c5ba-3efb-8b8e-01b0300a5b56",
                        "entry_id": "047e502b-2ac6-3135-a429-8d4e5df6a691",
                        "glosses": [
                            "A bow thruster or a stern thruster."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "14a29676-fbd0-3ba7-85ce-8278fc2bdfc9",
                        "entry_id": "047e502b-2ac6-3135-a429-8d4e5df6a691",
                        "glosses": [
                            "A surfboard (usually a shortboard) with three fins of approximately equal size, one centred at the back, one on each side about 25cm forward and out near the rails."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "96bad942-92f6-354f-a91e-ae311de67f92",
                        "entry_id": "047e502b-2ac6-3135-a429-8d4e5df6a691",
                        "glosses": [
                            "An ambitious, driven person; a go-getter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bd749e0-46b3-4ede-80f5-b70fbe6f55ed",
                                "sense_id": "96bad942-92f6-354f-a91e-ae311de67f92",
                                "text": "The executive is a thruster with ideas to expand or improve the business and his superiors fail to react—for whatever reason—and do not give acceptable explanations."
                            },
                            {
                                "example_id": "9398626c-d63c-4457-95a7-d8f642a1a5aa",
                                "sense_id": "96bad942-92f6-354f-a91e-ae311de67f92",
                                "text": "His hi-spec gear suggests that he's a corporate high-flyer and he's definitely a bit of a thruster, very much in control, taking care of business."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
