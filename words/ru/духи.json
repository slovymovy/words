                },
                {
                    "sense_id": "b9381834-93f4-3325-bb95-752adb7a5577",
                    "sense_definition": "Форма множественного числа существительного <w>дух</w> (бестелесные сверхъестественные существа, призраки).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spirits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Древние люди верили, что добрые лесные <w>духи</w> охраняют природу от зла.",
                            "target_lang_translations": {
                                "en": "Ancient people believed that good forest <w>spirits</w> protected nature from evil."
                            }
                        },
                        {
                            "text": "По легенде, злые <w>духи</w> выходят из тёмной чащи только глубокой ночью.",
                            "target_lang_translations": {
                                "en": "According to the legend, evil <w>spirits</w> emerge from the dark thicket only late at night."
                            }
                        }
                    ],
                    "common_phrases": [
                        "злые духи",
                        "лесные духи"
                    ],
