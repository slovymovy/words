{
    "word_family": [
        "adornment",
        "adorner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad8e236c-bcf5-3a89-9cfd-5734859e1f55",
                    "sense_definition": "To make something more beautiful or attractive by adding decorations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fresh flowers <w>adorn</w> the table for the dinner party.",
                            "target_lang_translations": {
                                "ru": "Свежие цветы <w>украшают</w> стол к званому ужину."
                            }
                        },
                        {
                            "text": "Paintings <w>adorn</w> the walls of the grand hall.",
                            "target_lang_translations": {
                                "ru": "Картины <w>украшают</w> стены парадного зала."
                            }
                        }
                    ],
                    "synonyms": [
                        "decorate",
                        "ornament",
                        "embellish",
                        "beautify"
                    ],
                    "common_phrases": [
                        "adorn with flowers",
                        "adorn the walls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо более красивым или привлекательным, добавляя декоративные элементы или украшения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "украсить",
                                "target_lang_sense_clarification": "совершенный вид"
                            },
                            {
                                "target_lang_word": "убирать",
                                "target_lang_sense_clarification": "устаревшее или поэтическое: наряжать, украшать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f2b77a4-a209-3eab-a6d6-1c660c5fa928",
                    "sense_definition": "An archaic term for an adornment or decoration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient statue stood without any <w>adorne</w> of gold or jewels.",
                            "target_lang_translations": {
                                "ru": "Древняя статуя стояла без каких-либо золотых или драгоценных <w>украшений</w>."
                            }
                        },
                        {
                            "text": "The simple dress lacked any elaborate <w>adorne</w>.",
                            "target_lang_translations": {
                                "ru": "На простом платье не было никакой сложной <w>отделки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ornament"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun form is no longer in standard use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее обозначение украшения или декоративного элемента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшение",
                                "target_lang_sense_clarification": "декоративный элемент или наряд"
                            },
                            {
                                "target_lang_word": "убор",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "befcf677-4e65-3b0e-a6f9-962336dd09cd",
                    "sense_definition": "Describing something that is adorned or ornate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described the <w>adorn</w> beauty of the garden.",
                            "target_lang_translations": {
                                "ru": "Поэт описал <w>пышную</w> красоту сада."
                            }
                        },
                        {
                            "text": "Her <w>adorn</w> appearance caught everyone's attention at the ball.",
                            "target_lang_translations": {
                                "ru": "Её <w>богато украшенный</w> наряд привлёк всеобщее внимание на балу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This adjective form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее определение того, что украшено, нарядно или имеет пышный вид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшенный",
                                "target_lang_sense_clarification": "снабжённый украшениями"
                            },
                            {
                                "target_lang_word": "убранный",
                                "target_lang_sense_clarification": "нарядный, пышно украшенный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}