                        "glosses": [
                            "Leser mit durchschnittlichen („normalen“) (Lese-)Fähigkeiten und Interessen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae87082a-37f5-4c15-8258-104581de378d",
                                "sense_id": "969ba004-7347-3465-be6f-4962a89db615",
                                "text": "„Man sagt von alters her, dass das Leben eines jeden Menschen für den Durchschnittsleser interessant und lehrreich wäre, könnte man es gewissenhaft nacherzählen.“"
                            },
                            {
                                "example_id": "22d9ed33-b8e1-4c28-8ada-8a3555c2ca00",
                                "sense_id": "969ba004-7347-3465-be6f-4962a89db615",
                                "text": "„Die Kehrseite dieser Entwicklung besteht in der Entfernung vom pakistanischen Durchschnittsleser, dessen Englischkenntnisse häufig für literarische Werke nicht ausreichen.“"
                            }
                        ],
