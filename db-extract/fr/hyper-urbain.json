                    {
                        "sense_id": "45b54e1a-9fee-3fe0-9560-93e48a08e03f",
                        "entry_id": "da37ccf5-ee93-3b7f-825c-07ec4066424e",
                        "glosses": [
                            "Personne qui vit dans un milieu extrêmement urbain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a0de02a-e71b-40ab-b0d9-86f92af186e4",
                                "sense_id": "45b54e1a-9fee-3fe0-9560-93e48a08e03f",
                                "text": "Les hyper-urbains, les intro-urbains, les hétéro-urbains et les extro-urbains s’observent aussi bien en ville et en banlieue que dans le périurbain et les zones semi-urbaines."
                            },
                            {
                                "example_id": "8d166f66-d9ff-43de-ad83-ef1b1bcc0acc",
                                "sense_id": "45b54e1a-9fee-3fe0-9560-93e48a08e03f",
                                "text": "Au fil du temps, son discours ne pourra que sembler de plus en plus en décalage avec une France malmenée par des réformes calibrées par des hyper-urbains CSP + pour des hyper-urbains CSP +."
                            },
                            {
                                "example_id": "4fc0e85f-573d-4bec-9176-835b31c5a20c",
                                "sense_id": "45b54e1a-9fee-3fe0-9560-93e48a08e03f",
                                "text": "Les « hyper-urbains » qui sont en permanence au carrefour de temps et de lieux multiples, intégrés dans le mouvement d’un monde globalisé tout en habitant les espaces les plus protégés et les plus aisés."
                            }
                        ]
                    }
