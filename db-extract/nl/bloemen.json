            {
                "entry_id": "0e657c18-af3e-365a-923d-e7c71e986e67",
                "word": "bloemen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "42e2fc44-52b2-3c27-a9e0-e919b9e9447d",
                        "entry_id": "0e657c18-af3e-365a-923d-e7c71e986e67",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord bloem"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "38c9e6a9-7ebb-4021-ae8e-1243112c2eeb",
                                "sense_id": "42e2fc44-52b2-3c27-a9e0-e919b9e9447d",
                                "text": "Als ze de kist zonder enig ceremonieel in het graf laten zakken, loopt het meisje naar de rand om een tuiltje bloemen in het donkere gat te gooien."
                            },
                            {
                                "example_id": "78c2d2b0-84ad-433e-9ee3-ae85ce39e73d",
                                "sense_id": "42e2fc44-52b2-3c27-a9e0-e919b9e9447d",
                                "text": "Aan een nieuwe veiligheidswet voegden rechtse politici een amendement toe dat hennep de facto gelijkstelt aan cannabis. De plant mag nog wel geteeld worden voor de vezels en de bladeren, maar de bloemen mogen niet meer verkocht worden. \"Economisch onhoudbaar\", noemt de Calabrese ondernemer Mattia Cusani dat."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
