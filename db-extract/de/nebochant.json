                        "entry_id": "9381d62d-3346-30a9-9e82-8cd16faf5510",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nebochanten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c8df8ea-a7a6-3d96-ac67-86a928564d3b",
                        "entry_id": "9381d62d-3346-30a9-9e82-8cd16faf5510",
                        "glosses": [
                            "unwissender, unfähiger, unwichtiger Mensch"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "e10cde51-9cf5-47de-ac16-a33dfccb83a0",
                                "sense_id": "9c8df8ea-a7a6-3d96-ac67-86a928564d3b",
                                "text": "„[Hans Langreiter:] Es steht dem Kollegen Moser natürlich offen, über Nebochanten zu sprechen.“"
                            },
                            {
                                "example_id": "7d07a7fc-fc64-4d4f-b614-08e98af46b8f",
                                "sense_id": "9c8df8ea-a7a6-3d96-ac67-86a928564d3b",
                                "text": "„Über sieben Milliarden Menschen: Es gibt ja Nebochanten, die vorgeben, sich das nicht vorstellen zu können, bitte schön, die müssen halt herumkugeln samt ihrem Völlegefühl.“"
                            },
                            {
                                "example_id": "0ee4d6ac-5a0d-4d72-81fe-557c6b819a5c",
                                "sense_id": "9c8df8ea-a7a6-3d96-ac67-86a928564d3b",
                                "text": "„Ein Mitglied eines in Europa bekannten Streichquartetts hat mir begründet, warum er seine gut bezahlte und sichere Orchesterstelle zu Gunsten des unsicheren, am freien Musikmarkt agierenden Quartetts aufgegeben hatte: »Ich war es leid, immer das spielen zu müssen, was jener Nebochant da droben uns angewiesen hat.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "938bff26-0239-3885-b97e-8973f65288f7",
                        "entry_id": "9381d62d-3346-30a9-9e82-8cd16faf5510",
                        "glosses": [
                            "jemand, der Tatsachen oder Neuerungen ignoriert"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "8e0ed3c0-3c91-4d63-8125-02327bbad973",
                                "sense_id": "938bff26-0239-3885-b97e-8973f65288f7",
                                "text": "„Ja, du bist und bleibst ein Nebochant. Weil du eben nie ins Kino gehst …“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
