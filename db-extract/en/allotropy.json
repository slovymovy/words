                    {
                        "sense_id": "5fdb494b-d58e-3af3-86dc-8fc6a84fbcb5",
                        "entry_id": "d28d0a03-88fa-36e4-9626-96f965fea43c",
                        "glosses": [
                            "A property, exhibited by some elements, of existing in multiple forms with different atomic structures."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d7f2a83-6f28-49fe-88b2-a8202d56d7a1",
                        "source_entry_id": "d28d0a03-88fa-36e4-9626-96f965fea43c",
                        "source_sense_id": "5fdb494b-d58e-3af3-86dc-8fc6a84fbcb5",
                        "source_sense_description": "having multiple atomic structures",
                        "target_lang_word": "allotropie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allotropie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c08176d-b92f-31fb-ba4e-13409c70393e",
                                        "entry_id": "ed92a865-972a-3df6-8d51-1c678cad36fb",
                                        "glosses": [
                                            "Qualité de corps simples pouvant se présenter sous des états différents, et jouir de propriétés physiques et chimiques très distinctes."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00505bc5-ae9a-4da6-89c9-767b11307b56",
                                                "sense_id": "8c08176d-b92f-31fb-ba4e-13409c70393e",
                                                "text": "Le carbone, le soufre, le phosphore font preuve d’allotropie."
                                            },
                                            {
                                                "example_id": "162d6da8-2545-4b43-bd0e-4e35cb2ade67",
                                                "sense_id": "8c08176d-b92f-31fb-ba4e-13409c70393e",
                                                "text": "Ainsi l’allotropie impose l’idée d’arrangements divers, de constructions dissemblables avec le « même »."
                                            },
                                            {
                                                "example_id": "1eb82275-d13e-4065-a02c-ab9bab6065f9",
                                                "sense_id": "8c08176d-b92f-31fb-ba4e-13409c70393e",
                                                "text": "Le terme allotropie se réfère exclusivement aux éléments, pas aux composés. Le polymorphisme est un terme plus large pour tout composé, bien qu’il soit généralement appliqué à des matériaux solides tels que les cristaux. L’allotropie ne fait référence qu’aux formes multiples d’un élément qui existent dans la même phase physique (l’état de la matière, comme un solide, un liquide ou un gaz)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
