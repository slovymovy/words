                                        "glosses": [
                                            "Kopffüßer mit vier Kiemen und einer spiralförmigen Muschel, der in der Zeit vom Devon bis zur Kreide gelebt hat"
                                        ],
                                        "tags": [
                                            "Paläontologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "011ee58c-bd78-4dc0-a143-b2090cef5a0f",
                                                "sense_id": "4829ffe7-3f34-3ea6-96b5-b39f0d12e05e",
                                                "text": "Der Ammonit bewegte sich mit erstaunlicher Eleganz und schraubte sch mit der aufrechten Spirale durchs Wasser."
                                            },
                                            {
                                                "example_id": "6eacf1eb-35d7-4325-8006-204291ce59f5",
                                                "sense_id": "4829ffe7-3f34-3ea6-96b5-b39f0d12e05e",
                                                "text": "Der Ammonit fuhr einen massiven vogelartigen Schnabel aus und biss der Krabbe zwischen den Augen in die Schale."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35e70c25-efe5-3cbd-9393-fedb2ccce4fd",
                                        "entry_id": "5a63974a-2665-3d9a-9216-c7b47c086d2f",
                                        "glosses": [
                                            "versteinerte Muschel eines Ammoniten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeb551c5-dfa7-4344-8fd2-68eaf56f0726",
                                                "sense_id": "35e70c25-efe5-3cbd-9393-fedb2ccce4fd",
                                                "text": "Die Ammoniten zählen zu den bekanntesten Fossilien."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
