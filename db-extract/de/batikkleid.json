                        "examples": [
                            {
                                "example_id": "51740ae1-13ec-4d2c-9e35-d1f9e1826522",
                                "sense_id": "a6ad4892-9d66-39e3-bb01-7fc0bbe2ec2a",
                                "text": "„Schlampen in Batikkleidern und mit zentimeterdickem Make-up im Gesicht tragen das Herz auf der Zunge und bunte, aber billige Tätowierungen auf den Armen.“"
                            },
                            {
                                "example_id": "2bc0ad9a-3984-42ae-9943-0dad9bde8e49",
                                "sense_id": "a6ad4892-9d66-39e3-bb01-7fc0bbe2ec2a",
                                "text": "„Beide seid ihr barfuß und in Batikkleidern herumgelaufen, beide wart ihr jung genug, euch edelmütig vorzukommen, wenn ihr schmutzigen Obdachlosen, die zur kostenlosen Behandlung in eure Übungsklinik kamen, die Füße massiert habt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
