{
    "word_family": [
        "engrave",
        "engraver",
        "engraving"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "22655958-1510-3d8f-8c62-f768ba0d4ce2",
                    "sense_definition": "Decorated with cut or carved designs on a hard surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "engraved_decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore an <w>engraved</w> silver locket that contained a picture of her grandmother.",
                            "target_lang_translations": {
                                "ru": "Она носила <w>гравированный</w> серебряный медальон с фотографией своей бабушки."
                            }
                        },
                        {
                            "text": "The museum displayed an <w>engraved</w> metal plate from the sixteenth century.",
                            "target_lang_translations": {
                                "ru": "В музее была представлена <w>гравированная</w> металлическая пластина шестнадцатого века."
                            }
                        }
                    ],
                    "synonyms": [
                        "carved",
                        "etched",
                        "inscribed"
                    ],
                    "antonyms": [
                        "plain",
                        "unadorned"
                    ],
                    "common_phrases": [
                        "engraved silver locket",
                        "engraved metal plate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшенный вырезанными или высеченными узорами на твердой поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гравированный",
                                "target_lang_sense_clarification": "с нанесенным рисунком или надписью"
                            },
                            {
                                "target_lang_word": "выгравированный",
                                "target_lang_sense_clarification": "имеющий гравировку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd2470a9-694c-386c-a9e4-cc5a1fca8917",
                    "sense_definition": "Produced or printed from an engraved plate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "engraved_decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple sent out <w>engraved</w> invitations for their formal wedding ceremony.",
                            "target_lang_translations": {
                                "ru": "Пара разослала <w>гравированные</w> приглашения на свою официальную свадебную церемонию."
                            }
                        },
                        {
                            "text": "He collected rare books featuring beautiful <w>engraved</w> illustrations.",
                            "target_lang_translations": {
                                "ru": "Он коллекционировал редкие книги с красивыми <w>гравированными</w> иллюстрациями."
                            }
                        }
                    ],
                    "synonyms": [
                        "printed"
                    ],
                    "common_phrases": [
                        "engraved invitations",
                        "engraved illustrations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произведенный или напечатанный с гравированной пластины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гравированный",
                                "target_lang_sense_clarification": "напечатанный методом гравировки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b4e29729-54b5-38c5-bb54-027edf45a963",
                    "sense_definition": "Simple past tense and past participle of <w>engrave</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler <w>engraved</w> their initials onto the inside of the gold rings.",
                            "target_lang_translations": {
                                "ru": "Ювелир <w>выгравировал</w> их инициалы на внутренней стороне золотых колец."
                            }
                        },
                        {
                            "text": "The tragic event was forever <w>engraved</w> in his memory.",
                            "target_lang_translations": {
                                "ru": "Это трагическое событие навсегда <w>запечатлелось</w> в его памяти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "engraved in memory",
                        "engraved their initials"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола engrave."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгравировал",
                                "target_lang_sense_clarification": "прошедшее время глагола"
                            },
                            {
                                "target_lang_word": "запечатлелся",
                                "target_lang_sense_clarification": "в переносном смысле, в памяти"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}