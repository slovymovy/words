                    {
                        "translation_id": "83427c7e-15d1-4180-8534-a4350150bdc7",
                        "source_entry_id": "686af508-2860-37b7-a4d2-fdc1588c1eae",
                        "source_sense_id": "cf538719-146e-32c3-a925-39be97600a04",
                        "source_sense_description": "aanspreektitel voor een groep jongeren",
                        "target_lang_word": "jeunes gens",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jeunes gens",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b9e8411-e582-3aa7-870f-4437951d2a00",
                                        "entry_id": "88173aec-a597-364c-88e1-d893075e97f7",
                                        "glosses": [
                                            "Ensemble de jeunes hommes, de jeunes garçons ou de jeunes filles."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e648ae6d-49b6-48b6-853a-2dfcd7ea1b10",
                                                "sense_id": "3b9e8411-e582-3aa7-870f-4437951d2a00",
                                                "text": "Les deux jeunes gens s’élancèrent hors de la voiture."
                                            },
                                            {
                                                "example_id": "0537e260-7bbd-4831-b247-b1c717b8d45a",
                                                "sense_id": "3b9e8411-e582-3aa7-870f-4437951d2a00",
                                                "text": "Parmi ces jeunes gens et ces nobles dames, le plus beau jeune homme était Othon, et la plus belle châtelaine madame Emma."
                                            },
                                            {
                                                "example_id": "f3256c01-86fd-498b-8c6c-42048daa4c7c",
                                                "sense_id": "3b9e8411-e582-3aa7-870f-4437951d2a00",
                                                "text": "Ces attractions sont bien plus impérieuses lorsque les jeunes gens et les jeunes filles vivent chacun dans un monde à part, et ne connaissent que ce que leur apprennent les uns sur les autres les rêves de leur imagination."
                                            },
                                            {
                                                "example_id": "c82b5e64-0e8d-430b-8e19-5651d5324810",
                                                "sense_id": "3b9e8411-e582-3aa7-870f-4437951d2a00",
                                                "text": "Les jeunes gens, les jeunes filles surtout, une petite voilette sur le visage, s’adonnaient à la danse sans relâche, avec grâce et frénésie à la fois, au son de la ghaïta […] si répandue en Afrique du Nord."
                                            },
                                            {
                                                "example_id": "b202a1c7-36d8-4303-9233-4765e570bea5",
                                                "sense_id": "3b9e8411-e582-3aa7-870f-4437951d2a00",
                                                "text": "Chez beaucoup de jeunes gens, il arrive aussi que l’éjaculation a lieu presque aussitôt après, et quelquefois même avant l’introduction de la verge dans le vagin."
                                            },
                                            {
                                                "example_id": "62aac731-6e86-49bc-bf10-853e0675e252",
                                                "sense_id": "3b9e8411-e582-3aa7-870f-4437951d2a00",
                                                "text": "Une douzaine de jeunes gens entouraient une sorte de croquant endimanché, coiffé d’un chapeau melon qui roulait des yeux ahuris et s’efforçait d’éviter la bousculade systématique dont il se voyait l’objet."
                                            },
                                            {
                                                "example_id": "7fac9cc2-33e5-426c-a9f4-9229eca8c514",
                                                "sense_id": "3b9e8411-e582-3aa7-870f-4437951d2a00",
                                                "text": "Nous parlions plus haut de la familiarité patriarcale qui rapproche nécessairement les jeunes gens d’une même tribu."
                                            },
                                            {
                                                "example_id": "9df79b09-d91b-4b7a-b341-34a238bdce44",
                                                "sense_id": "3b9e8411-e582-3aa7-870f-4437951d2a00",
                                                "text": "C’est qu’on mesure mal l’état de divertissement où sont ravis tant de jeunes gens qui découvrent à la fois les livres et les femmes."
                                            },
                                            {
                                                "example_id": "7a9ddc0e-8cb9-4fd0-a03c-6a790a659ba4",
                                                "sense_id": "3b9e8411-e582-3aa7-870f-4437951d2a00",
                                                "text": "Dans cette foule de jeunes gens, hommes et femmes, partout le sérieux, la décence; pas le moindre soupçon de rigolade bête ou vulgaire, de gaudriole, de grivoiserie, ni même de flirt. On respire partout une sorte de ferveur joyeuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
