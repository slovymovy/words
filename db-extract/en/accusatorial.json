                                "target_word": "accusatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0203a303-2262-3b9a-8598-18892aafde6f",
                                        "entry_id": "6d13c700-037c-379b-9ea6-63f230372dc7",
                                        "glosses": [
                                            "Qualifie la procédure pénale appliquée dans les pays anglo-saxons, dans laquelle ce sont les parties et non les représentants de la société qui mènent le procès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37a109be-00de-4877-8bbc-bf882fca46b8",
                                                "sense_id": "0203a303-2262-3b9a-8598-18892aafde6f",
                                                "text": "Système, procédure accusatoire."
                                            },
                                            {
                                                "example_id": "99ae06e0-f7e6-41fc-ad2d-d55cf2f7c8fc",
                                                "sense_id": "0203a303-2262-3b9a-8598-18892aafde6f",
                                                "text": "On envisagera successivement les grands types procéduraux que l'histoire a consacrés : procédure accusatoire, procédure inquisitoire et procédure mixte."
                                            },
                                            {
                                                "example_id": "818f3bba-8fc5-48df-b893-43c3102d19a9",
                                                "sense_id": "0203a303-2262-3b9a-8598-18892aafde6f",
                                                "text": "On pense peut-être un peu trop que notre système est parfait et on tente de l'imposer aux autres (USAid a forcé les pays d'Amérique latine à remplacer le système inquisitoire par des systèmes accusatoires sans chercher à améliorer les systèmes en place) alors qu'il faudrait peut-être repenser ce qui pourrait mieux servir la justice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec6e2f59-bf56-3cb7-bed1-6e08fa80fc01",
                                        "entry_id": "6d13c700-037c-379b-9ea6-63f230372dc7",
                                        "glosses": [
                                            "Accusateur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bb3286f-c7e2-490b-8a7c-327bcdfa8af1",
                                                "sense_id": "ec6e2f59-bf56-3cb7-bed1-6e08fa80fc01",
                                                "text": "Chez les autorités tant politiques que sanitaires, le ton accusatoire a souvent été de mise: la faute aux vieux d’abord, aux jeunes ensuite."
                                            },
                                            {
                                                "example_id": "3b1cf56b-b0c9-4c2f-b20b-222ba70c38ec",
                                                "sense_id": "ec6e2f59-bf56-3cb7-bed1-6e08fa80fc01",
                                                "text": "Loin de porter un regard accusatoire, les journalistes racontent l'incompréhension qui règne entre les pêcheurs et le directeur du parc, chargé d'appliquer les décisions gouvernementales."
                                            },
                                            {
                                                "example_id": "a342e8ef-6a40-4524-a4bd-b9b1717b4472",
                                                "sense_id": "ec6e2f59-bf56-3cb7-bed1-6e08fa80fc01",
                                                "text": "D'Aubigné s'adresse souvent à son lecteur d'une manière accusatoire, tantôt pour lui faire ressentir les horreurs de la persécution religieuse, tantôt pour le rendre conscient de sa complicité dans cette persécution."
                                            },
                                            {
                                                "example_id": "703ecc8c-4841-4d76-8730-f78e4119bd55",
                                                "sense_id": "ec6e2f59-bf56-3cb7-bed1-6e08fa80fc01",
                                                "text": "S’il y avait un coupable, ce ne pouvait être que moi, mais en même temps, je ne voyais pas quel était mon crime ou le sien, ou le nôtre, en quoi une gentille promenade sur le Taedong justifiait pareille réunion aux allures accusatoires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
