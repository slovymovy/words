{
    "word_family": [
        "forward",
        "forwarding",
        "forwarder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3df89a5-b4e6-38c2-a62c-5e1999630292",
                    "sense_definition": "Abbreviation of <w>forward</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "email_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>fwd</w> the meeting invitation to the rest of the team.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>перешлите</w> приглашение на встречу остальным членам команды."
                            }
                        },
                        {
                            "text": "I will <w>fwd</w> this email to you as soon as I receive it.",
                            "target_lang_translations": {
                                "ru": "Я <w>перенаправлю</w> вам это письмо, как только получу его."
                            }
                        }
                    ],
                    "synonyms": [
                        "forward",
                        "resend"
                    ],
                    "common_phrases": [
                        "fwd an email",
                        "fwd to someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от forward; переслать полученное сообщение или письмо другому получателю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переслать",
                                "target_lang_sense_clarification": "электронное письмо"
                            },
                            {
                                "target_lang_word": "перенаправить",
                                "target_lang_sense_clarification": "сообщение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3cf212a9-a8eb-3c7b-bc07-261dcae0baad",
                    "sense_definition": "Initialism of front-wheel drive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "automotive_drive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most modern compact cars are designed with <w>FWD</w> for better fuel efficiency.",
                            "target_lang_translations": {
                                "ru": "Большинство современных компактных автомобилей проектируются с <w>передним приводом</w> для лучшей топливной экономичности."
                            }
                        },
                        {
                            "text": "The car handles well in the rain because it is a <w>FWD</w> model.",
                            "target_lang_translations": {
                                "ru": "Машина хорошо управляется в дождь, так как это модель с <w>передним приводом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "front-wheel drive"
                    ],
                    "antonyms": [
                        "RWD"
                    ],
                    "common_phrases": [
                        "fwd vehicle",
                        "standard fwd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для front-wheel drive; система привода автомобиля, при которой крутящий момент передается на передние колеса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передний привод",
                                "target_lang_sense_clarification": "тип трансмиссии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ee84fbe-0bee-3462-9986-8d5236663c99",
                    "sense_definition": "Initialism of four-wheel drive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "automotive_drive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You might need a <w>FWD</w> vehicle if you plan to drive through heavy snow.",
                            "target_lang_translations": {
                                "ru": "Вам может понадобиться автомобиль с <w>полным приводом</w>, если вы планируете ездить по глубокому снегу."
                            }
                        },
                        {
                            "text": "This rugged SUV features a powerful <w>FWD</w> system for off-road adventures.",
                            "target_lang_translations": {
                                "ru": "Этот надежный внедорожник оснащен мощной системой <w>полного привода</w> для поездок по бездорожью."
                            }
                        }
                    ],
                    "synonyms": [
                        "4WD",
                        "four-wheel drive"
                    ],
                    "common_phrases": [
                        "fwd truck",
                        "engage fwd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для four-wheel drive; система привода автомобиля на все четыре колеса (полный привод)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный привод",
                                "target_lang_sense_clarification": "4WD"
                            },
                            {
                                "target_lang_word": "4x4",
                                "target_lang_sense_clarification": "внедорожный привод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e015d3cd-f336-3e86-878e-106367f77c13",
                    "sense_definition": "Abbreviation of <w>forward</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_positions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team is looking for a new <w>FWD</w> to improve their scoring chances.",
                            "target_lang_translations": {
                                "ru": "Команда ищет нового <w>нападающего</w>, чтобы увеличить свои шансы на гол."
                            }
                        },
                        {
                            "text": "He played as a <w>FWD</w> during his entire professional soccer career.",
                            "target_lang_translations": {
                                "ru": "Он играл на позиции <w>форварда</w> на протяжении всей своей профессиональной футбольной карьеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "forward",
                        "striker"
                    ],
                    "common_phrases": [
                        "starting fwd",
                        "star fwd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от forward; игрок атакующей линии в командных видах спорта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападающий",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "форвард",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ecd9e887-fb19-3afa-82b7-3fc6f2a3306c",
                    "sense_definition": "Abbreviation of <w>forward</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructions said to move the lever <w>fwd</w> to start the machine.",
                            "target_lang_translations": {
                                "ru": "В инструкции сказано перевести рычаг <w>вперед</w>, чтобы запустить машину."
                            }
                        },
                        {
                            "text": "Please step <w>fwd</w> when your name is called by the officer.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, шагните <w>вперед</w>, когда офицер назовет ваше имя."
                            }
                        }
                    ],
                    "synonyms": [
                        "forward",
                        "onward"
                    ],
                    "common_phrases": [
                        "move fwd",
                        "step fwd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от forward; в направлении перед собой или к началу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вперед",
                                "target_lang_sense_clarification": "направление движения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "30f84e34-2d5c-3126-98c4-e49692f5506d",
                    "sense_definition": "Abbreviation of <w>forward</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fwd</w> motion of the ship was slowed by the heavy waves.",
                            "target_lang_translations": {
                                "ru": "Движение корабля <w>вперед</w> было замедлено сильными волнами."
                            }
                        },
                        {
                            "text": "Check the <w>fwd</w> cabin for any luggage that might have been left behind.",
                            "target_lang_translations": {
                                "ru": "Проверьте <w>переднюю</w> кабину на наличие оставленного багажа."
                            }
                        }
                    ],
                    "synonyms": [
                        "forward",
                        "front"
                    ],
                    "common_phrases": [
                        "fwd motion",
                        "fwd cabin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от forward; расположенный впереди или относящийся к передней части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передний",
                                "target_lang_sense_clarification": "расположение"
                            },
                            {
                                "target_lang_word": "носовой",
                                "target_lang_sense_clarification": "о части судна или самолета"
                            }
                        ]
                    }
                }
            ]
        }
    ]
