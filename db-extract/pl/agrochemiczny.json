                                                "example_id": "5c703f1f-72ab-4868-b22f-cb92d30f5980",
                                                "sense_id": "c91e44a7-2d13-33b6-8f21-538b84794ece",
                                                "text": "A review of Syngenta’s strategy shows that Dr. Cresswell’s experience fits in with practices used by American competitors like Monsanto and across the agrochemical industry."
                                            }
