    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dac13395-d4bc-3e83-8d3c-fee399f72521",
                    "sense_definition": "To take off one's clothing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "undressing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seeing that no one else was about, he <w>stripped</w> and dived into the river.",
                            "target_lang_translations": {
                                "ru": "Увидев, что никого нет рядом, он <w>разделся</w> и нырнул в реку."
                            }
                        },
                        {
                            "text": "The doctor asked the patient to <w>strip</w> to the waist for the examination.",
                            "target_lang_translations": {
                                "ru": "Врач попросил пациента <w>раздеться</w> до пояса для осмотра."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncover"
                    ],
                    "antonyms": [
                        "dress",
                        "clothe"
                    ],
                    "common_phrases": [
                        "strip naked",
                        "strip to the waist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снимать с себя одежду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздеваться",
                                "target_lang_sense_clarification": "снимать с себя одежду"
                            },
                            {
                                "target_lang_word": "раздеться",
                                "target_lang_sense_clarification": "завершить процесс снятия одежды"
                            },
                            {
                                "target_lang_word": "обнажаться",
                                "target_lang_sense_clarification": "становиться голым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ca84a9f-0ffe-37ef-a8c1-1dbdf9571aa8",
                    "sense_definition": "To remove a covering or layer from something, often in long pieces.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Norm will <w>strip</w> the old varnish before painting the chair.",
                            "target_lang_translations": {
                                "ru": "Норм <w>снимет</w> старый лак перед тем, как красить стул."
                            }
                        },
                        {
                            "text": "You need to <w>strip</w> paint from the door before applying a new coat.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>удалить</w> краску с двери перед нанесением нового слоя."
                            }
                        }
                    ],
                    "synonyms": [
                        "peel",
                        "uncover"
                    ],
                    "antonyms": [
                        "cover",
                        "coat"
                    ],
                    "common_phrases": [
                        "strip paint",
                        "strip wallpaper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять покрытие или слой с чего-либо, часто длинными кусками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "удалять слой или покрытие"
                            },
                            {
                                "target_lang_word": "обдирать",
                                "target_lang_sense_clarification": "с силой удалять верхний слой"
                            },
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "удалять старую краску или лак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e13cb4d-10bc-3acf-86f8-fdd9fbd8d4dc",
                    "sense_definition": "To take away property, honors, or titles from someone as a punishment or through force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deprivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was <w>stripped</w> of his medal after failing a drugs test.",
                            "target_lang_translations": {
                                "ru": "Атлета <w>лишили</w> медали после провала допинг-теста."
                            }
                        },
                        {
                            "text": "The general was <w>stripped</w> of his rank following the scandal.",
                            "target_lang_translations": {
                                "ru": "Генерала <w>лишили</w> звания после скандала."
                            }
                        }
                    ],
                    "synonyms": [
                        "deprive"
                    ],
                    "antonyms": [
                        "award",
                        "grant"
                    ],
                    "common_phrases": [
                        "stripped of his title",
                        "stripped of power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать кого-либо собственности, почестей или титулов в качестве наказания или силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишать",
                                "target_lang_sense_clarification": "отбирать права, титулы или награды"
                            },
                            {
                                "target_lang_word": "разжаловать",
                                "target_lang_sense_clarification": "лишать воинского звания или чина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47f085c8-b784-3b10-b13f-23ff06e8fe45",
                    "sense_definition": "To damage the thread of a screw or the teeth of a gear so they no longer grip.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't tighten that bolt any more or you'll <w>strip</w> the thread.",
                            "target_lang_translations": {
                                "ru": "Не затягивай этот болт сильнее, иначе ты <w>сорвёшь</w> резьбу."
                            }
                        },
                        {
                            "text": "He accidentally <w>stripped</w> the screw by using the wrong screwdriver.",
                            "target_lang_translations": {
                                "ru": "Он случайно <w>сорвал</w> винт, используя неподходящую отвёртку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strip the thread"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повреждать резьбу винта или зубья шестерни так, что они перестают цепляться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "повреждать резьбу или зубья"
                            },
                            {
                                "target_lang_word": "сорвать",
                                "target_lang_sense_clarification": "испортить резьбу окончательно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25eb4d2a-625d-3215-a241-695b44674df8",
                    "sense_definition": "To perform a striptease.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the seedy club, a group of drunken men were watching a woman <w>stripping</w>.",
                            "target_lang_translations": {
                                "ru": "В сомнительном клубе группа пьяных мужчин наблюдала за тем, как женщина <w>раздевается</w>."
                            }
                        },
                        {
                            "text": "She earned extra money by <w>stripping</w> at a local nightclub.",
                            "target_lang_translations": {
                                "ru": "Она подрабатывала, <w>танцуя стриптиз</w> в местном ночном клубе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять стриптиз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздеваться",
                                "target_lang_sense_clarification": "исполнять стриптиз"
                            },
                            {
                                "target_lang_word": "танцевать стриптиз",
                                "target_lang_sense_clarification": "профессионально раздеваться под музыку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a15c4ff-8ca4-3893-900e-27acbbbf256b",
                    "sense_definition": "A long, thin piece of any material.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Papier mache is made from <w>strips</w> of paper.",
                            "target_lang_translations": {
                                "ru": "Папье-маше делают из <w>полосок</w> бумаги."
                            }
                        },
                        {
                            "text": "Cut the tofu into <w>strips</w> about 1cm thick before frying.",
                            "target_lang_translations": {
                                "ru": "Перед жаркой нарежьте тофу <w>полосками</w> толщиной около 1 см."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strip of paper",
                        "strip of cloth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный тонкий кусок любого материала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоска",
                                "target_lang_sense_clarification": "узкий длинный кусок ткани или бумаги"
                            },
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "длинный и узкий участок поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f407416-cb8f-36d3-bf1c-5582542d57a8",
                    "sense_definition": "A long, thin piece of land or a specific narrow area.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The countries were in dispute over the ownership of a <w>strip</w> of desert about 100 metres wide.",
                            "target_lang_translations": {
                                "ru": "Страны спорили из-за права собственности на <w>полосу</w> пустыни шириной около 100 метров."
                            }
                        },
                        {
                            "text": "A narrow <w>strip</w> of land connects the peninsula to the mainland.",
                            "target_lang_translations": {
                                "ru": "Узкая <w>полоска</w> земли соединяет полуостров с материком."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strip of land",
                        "coastal strip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный узкий участок земли или определенная узкая территория."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "узкий участок земли"
                            },
                            {
                                "target_lang_word": "клочок",
                                "target_lang_sense_clarification": "маленький узкий участок земли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dc2535a-5cd3-3826-9993-d03e1355577e",
                    "sense_definition": "A sequence of drawings in a newspaper or magazine that tells a story.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always read the comic <w>strip</w> in the Sunday newspaper.",
                            "target_lang_translations": {
                                "ru": "Я всегда читаю <w>комикс</w> в воскресной газете."
                            }
                        },
                        {
                            "text": "The artist created a new <w>strip</w> featuring a talking cat.",
                            "target_lang_translations": {
                                "ru": "Художник создал новый <w>стрип</w> про говорящего кота."
                            }
                        }
                    ],
                    "common_phrases": [
                        "comic strip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательность рисунков в газете или журнале, рассказывающая историю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комикс",
                                "target_lang_sense_clarification": "серия рисунков с текстом"
                            },
                            {
                                "target_lang_word": "стрип",
                                "target_lang_sense_clarification": "короткий комикс в несколько кадров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de6292c4-78ce-324d-a722-ce896289bfc9",
                    "sense_definition": "A long, narrow area of ground used by aircraft for taking off and landing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small plane landed safely on the grass <w>strip</w>.",
                            "target_lang_translations": {
                                "ru": "Маленький самолет благополучно приземлился на травяную <w>полосу</w>."
                            }
                        },
                        {
                            "text": "The pilot approached the landing <w>strip</w> with caution.",
                            "target_lang_translations": {
                                "ru": "Пилот с осторожностью приближался к посадочной <w>полосе</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "landing strip",
                        "air strip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный узкий участок земли, используемый самолетами для взлета и посадки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "взлетно-посадочная дистанция"
                            },
                            {
                                "target_lang_word": "взлётка",
                                "target_lang_sense_clarification": "разговорное название взлетной полосы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa36dc36-3e0e-38f4-8d67-466e7962824e",
                    "sense_definition": "The uniform or kit worn by a sports team, especially in football.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team played in their traditional red and white <w>strip</w>.",
                            "target_lang_translations": {
                                "ru": "Команда играла в своей традиционной красно-белой <w>форме</w>."
                            }
                        },
                        {
                            "text": "Fans were wearing the new away <w>strip</w> to support the club.",
                            "target_lang_translations": {
                                "ru": "Болельщики надели новую выездную <w>форму</w>, чтобы поддержать клуб."
                            }
                        }
                    ],
                    "common_phrases": [
                        "football strip",
                        "away strip"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма или экипировка спортивной команды, особенно в футболе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "форма",
                                "target_lang_sense_clarification": "спортивная экипировка"
                            },
                            {
                                "target_lang_word": "цвета",
                                "target_lang_sense_clarification": "традиционная расцветка формы клуба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd5df966-4555-32a6-9baf-2f7694a254ab",
                    "sense_definition": "A street or road lined with many shops, restaurants, or entertainment venues.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "urban_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main <w>strip</w> of the town is full of neon lights and bars.",
                            "target_lang_translations": {
                                "ru": "Главная <w>улица</w> города полна неоновых огней и баров."
                            }
                        },
                        {
                            "text": "We walked down the shopping <w>strip</w> looking for a place to eat.",
                            "target_lang_translations": {
                                "ru": "Мы шли по торговой <w>улице</w> в поисках места, где можно поесть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the main strip",
                        "shopping strip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улица или дорога, вдоль которой расположено множество магазинов, ресторанов или развлекательных заведений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улица",
                                "target_lang_sense_clarification": "главная торговая или развлекательная улица"
                            },
                            {
                                "target_lang_word": "стрип",
                                "target_lang_sense_clarification": "оживленная торговая миля"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e887a005-421f-3c23-87cc-b62cda144475",
