{
    "word_family": [
        "aggravation",
        "aggravator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ee010dd-7dd8-3da5-87a2-9b4e45d7f3b3",
                    "sense_definition": "To make a bad situation or condition worse.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "worsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>aggravate</w> the injury by trying to walk on it too soon.",
                            "target_lang_translations": {
                                "ru": "Не <w>усугубляйте</w> травму, пытаясь наступать на ногу слишком рано."
                            }
                        },
                        {
                            "text": "The loud music only served to <w>aggravate</w> his already splitting headache.",
                            "target_lang_translations": {
                                "ru": "Громкая музыка лишь <w>обострила</w> его и без того раскалывающуюся головную боль."
                            }
                        }
                    ],
                    "synonyms": [
                        "exacerbate",
                        "worsen"
                    ],
                    "antonyms": [
                        "alleviate",
                        "mitigate",
                        "ameliorate",
                        "improve",
                        "repair",
                        "restore"
                    ],
                    "common_phrases": [
                        "aggravate the situation",
                        "aggravate the problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать плохую ситуацию или состояние еще хуже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усугублять",
                                "target_lang_sense_clarification": "усиливать что-то неприятное или плохое"
                            },
                            {
                                "target_lang_word": "обострять",
                                "target_lang_sense_clarification": "делать ситуацию более напряженной или конфликтной"
                            },
                            {
                                "target_lang_word": "ухудшать",
                                "target_lang_sense_clarification": "делать состояние чего-либо хуже"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81c9be14-9217-3a89-b1dd-1ca88d8a61a8",
                    "sense_definition": "To annoy or irritate someone.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "annoy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It really <w>aggravates</w> me when people talk loudly during a movie.",
                            "target_lang_translations": {
                                "ru": "Меня очень <w>раздражает</w>, когда люди громко разговаривают во время фильма."
                            }
                        },
                        {
                            "text": "She was <w>aggravated</w> by his constant interruptions during the meeting.",
                            "target_lang_translations": {
                                "ru": "Её <w>раздражали</w> его постоянные перебивания во время собрания."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "irritate",
                        "exasperate",
                        "bother"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражать или злить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать чувство досады или недовольства"
                            },
                            {
                                "target_lang_word": "злить",
                                "target_lang_sense_clarification": "вызывать гнев или сильное раздражение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4a53957-fa2b-336d-b29b-d8ab2f328f67",
                    "sense_definition": "To make an offense or crime more serious or severe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "worsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fact that he lied to the police only served to <w>aggravate</w> his legal situation.",
                            "target_lang_translations": {
                                "ru": "Тот факт, что он солгал полиции, лишь <w>усугубил</w> его правовое положение."
                            }
                        },
                        {
                            "text": "The judge noted that the defendant's previous record would <w>aggravate</w> the severity of the sentence.",
                            "target_lang_translations": {
                                "ru": "Судья отметил, что предыдущая судимость подсудимого <w>отягощает</w> тяжесть приговора."
                            }
                        }
                    ],
                    "synonyms": [
                        "exacerbate"
                    ],
                    "antonyms": [
                        "mitigate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать правонарушение или преступление более серьезным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отягощать",
                                "target_lang_sense_clarification": "делать вину или положение более тяжелым"
                            },
                            {
                                "target_lang_word": "усугублять",
                                "target_lang_sense_clarification": "делать положение дел более серьезным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}