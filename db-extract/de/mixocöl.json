                "senses": [
                    {
                        "sense_id": "923338da-1ce2-3546-865f-f5d30af8d246",
                        "entry_id": "a06a85d5-f6f8-3135-b847-1af46536b8b8",
                        "glosses": [
                            "ein flüssigkeitserfüllter Hohlraum im Tierkörper, der durch die Verschmelzung von primärer („Blastocöl“) und sekundärer Leibeshöhle („Cölom“) entstanden ist und in der Hauptsache bei den Arthropoden vorkommt"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "dd6fb57d-be5f-432b-8064-a4e301b892c9",
                                "sense_id": "923338da-1ce2-3546-865f-f5d30af8d246",
                                "text": "Bei der Arthropoden ist durch Verschmelzung von primärer und sekundärer Leibeshöhle ein Mixocöl, ein einheitliches Hämocöl oder offenes Blutgefäßsystem entstanden."
                            },
                            {
                                "example_id": "194b7b7f-1cfd-48c0-a27a-438ed33839c2",
                                "sense_id": "923338da-1ce2-3546-865f-f5d30af8d246",
                                "text": "Das Mixocöl der Insekten wird als ontogenetische Verschmelzung der primären und sekundären Leibeshöhle angesehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
