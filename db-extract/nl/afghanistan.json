                    },
                    {
                        "translation_id": "7eb7da5a-ef17-451b-bca0-24885dcffcac",
                        "source_entry_id": "4a2a5027-e183-3c75-afa1-9a2c207e615c",
                        "source_sense_id": "d0a1ec41-4edf-3caf-b72f-ff7c854ce117",
                        "source_sense_description": "een land gelegen in Centraal-Azië.",
                        "target_lang_word": "Afghanistan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afghanistan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b74d1813-6a6a-328f-9868-c25d511bd75f",
                                        "entry_id": "fd8f859e-f23d-3bb4-8b00-ea02b91fb8b3",
                                        "glosses": [
                                            "als Kurzform gebräuchlicher Ländername eines Staates in Zentralasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21e5a570-5393-4a19-b20f-f018522743be",
                                                "sense_id": "b74d1813-6a6a-328f-9868-c25d511bd75f",
                                                "text": "Kabul ist die Hauptstadt Afghanistans."
                                            },
                                            {
                                                "example_id": "d74e4df3-29f2-47c0-b28b-55b8a4630fd8",
                                                "sense_id": "b74d1813-6a6a-328f-9868-c25d511bd75f",
                                                "text": "„Sie folgen den Spuren jener Gotteskrieger, die noch vom pakistanischen oder US-Geheimdienst für den Krieg gegen die Sowjetunion in Afghanistan ausgebildet wurden, sich später aber terroristischen Gruppierungen in Algerien, Ägypten und anderswo anschlossen und am Ende bei al-Qaida landeten.“"
                                            },
                                            {
                                                "example_id": "75e76aac-964d-4851-8a25-c4185f01d569",
                                                "sense_id": "b74d1813-6a6a-328f-9868-c25d511bd75f",
                                                "text": "„Es kommt jetzt darauf an, erstens das Verhältnis zum Iran zu entspannen und zweitens eine regionale Koalition aufzubauen, die dazu beitragen kann, Afghanistan zu stabilisieren und dort die Präsenz von US- und Nato-Truppen auf längere Sicht überflüssig zu machen.“"
                                            },
                                            {
                                                "example_id": "1ab724f5-47e7-432a-9403-fb4b0226b699",
                                                "sense_id": "b74d1813-6a6a-328f-9868-c25d511bd75f",
                                                "text": "Auf einer alphabetischen Liste aller Länder der Welt würde Afghanistan an erster Stelle stehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1966ed08-9663-4a81-81b6-94e7b0544920",
                        "source_entry_id": "4a2a5027-e183-3c75-afa1-9a2c207e615c",
                        "source_sense_id": "d0a1ec41-4edf-3caf-b72f-ff7c854ce117",
                        "source_sense_description": "een land gelegen in Centraal-Azië.",
                        "target_lang_word": "Afghanistan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afghanistan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adf5e5e0-066f-3e44-a696-bfbf064193a3",
                                        "entry_id": "27656466-bc39-3d30-b449-67de5779aac8",
                                        "glosses": [
                                            "A landlocked country between Central Asia and South Asia. Official name: Islamic Emirate of Afghanistan. Capital and largest city: Kabul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8144100b-b2b6-4e48-b4a1-beb0030afed1",
                                                "sense_id": "adf5e5e0-066f-3e44-a696-bfbf064193a3",
                                                "text": "But Shahab ul dien Mahummud, brother to the Prince of Ghor, invaded the kingdom of Ghizni, which he conquered, and not ſatisfied with that, marched an army into Hindoſtan, overrunning Piſhawir, Afghaniſtan, Moultan and Sind."
                                            },
                                            {
                                                "example_id": "1d326363-ddb0-4106-b5d3-e2be21fe9057",
                                                "sense_id": "adf5e5e0-066f-3e44-a696-bfbf064193a3",
                                                "text": "This Timoor Shah is the ſon of the famous Ahmed Shah Abdalee, who was formerly in the ſervice of Nadir Shah, and upon the aſſaſſination of that monarch, ſeized the vaſl treaſures which had been depoſited in the Caſtle Herat, and carried them off into the mountains of Afghaniſtan, where his ſtandard was preſently joined by numbers of needy followers, and with this army he ſoon founded an independent kingdom to the eaſtward of Perſia."
                                            },
                                            {
                                                "example_id": "f2e8da1b-eb54-44db-887c-9b4bb619759f",
                                                "sense_id": "adf5e5e0-066f-3e44-a696-bfbf064193a3",
                                                "text": "I am now arranging, and endeavouring to render worthy of the notice of the public, a ſecond volume, which contains a relation of my journey from Kaſhmire to England, through Afghaniſtan, Perſia, and Ruſſia."
                                            },
                                            {
                                                "example_id": "8e3f87e4-1443-4b29-9963-103de5d3e56d",
                                                "sense_id": "adf5e5e0-066f-3e44-a696-bfbf064193a3",
                                                "text": "Described by witnesses as a keen cricketer and pubgoer until contacts with Islamic militants radicalized him on a trip to Pakistan, he was ordered to serve at least 14 years for the plot, and for supplying militants in Afghanistan with money and equipment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1dc76cb-eacd-44e6-8134-3b7d34ab9b0c",
                        "source_entry_id": "4a2a5027-e183-3c75-afa1-9a2c207e615c",
                        "source_sense_id": "d0a1ec41-4edf-3caf-b72f-ff7c854ce117",
                        "source_sense_description": "een land gelegen in Centraal-Azië.",
                        "target_lang_word": "Afghanistan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afghanistan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aaeaf6b8-5af3-369d-963d-67609c8a0dec",
                                        "entry_id": "a22ef290-56b6-35d6-b04c-e65f375e44d6",
                                        "glosses": [
                                            "Pays d’Asie centrale, entouré de l’Iran à l’ouest, du Pakistan au sud, de la Chine à l’est, du Tadjikistan, de l’Ouzbékistan et du Turkménistan au nord. Sa capitale est Kaboul."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43f9e137-8a97-4c91-aec5-e222c1658b2e",
                                                "sense_id": "aaeaf6b8-5af3-369d-963d-67609c8a0dec",
                                                "text": "On sait combien l’ethnologie de l’Afghanistan est complexe. Dans un récent travail, le Dr H. W. Bellew a essayé de déterminer l’import de la race grecque dans la population afghane.\nEn étudiant les Barakis du Caboul, M. Bellew constate que leurs traditions les distinguent nettement des Pathans, des Turcs et des Mogols; leur langue aussi constitue un dialecte particulier."
                                            },
                                            {
                                                "example_id": "aa2f2e37-f29d-4f8f-9ea1-513c096d17e6",
                                                "sense_id": "aaeaf6b8-5af3-369d-963d-67609c8a0dec",
                                                "text": "Au-delà du paysage d’astre mort, son regard intérieur découvrait des vallées enchantées, des villes tumultueuses, de brûlants déserts, des steppes immenses. Et c’était l’Afghanistan. Il en connaissait toutes les provinces et les pistes et les sentes. Il avait cheminé le long de toutes ses frontières : la persane et la russe, la tibétaine et l’hindoue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba9dc75c-7752-3ddb-8db6-63c186504167",
                                        "entry_id": "a22ef290-56b6-35d6-b04c-e65f375e44d6",
                                        "glosses": [
                                            "État qui a pour nom officiel République islamique d’Afghanistan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e2d5b8-69fc-433c-823b-a1f5426fcaf5",
                                                "sense_id": "ba9dc75c-7752-3ddb-8db6-63c186504167",
                                                "text": "Ce fut le 2 novembre 1841 que la révolte générale éclata dans la capitale de l’Afghanistan."
                                            },
                                            {
                                                "example_id": "916fa02e-a0d5-4405-b447-4631f908433e",
                                                "sense_id": "ba9dc75c-7752-3ddb-8db6-63c186504167",
                                                "text": "Un traité a été conclu au mois de mars 1905, entre l’Angleterre et l’Afghanistan, traité qui continue l’œuvre que la politique britannique poursuit en ce pays depuis près d’un siècle, œuvre de « défense de l’Inde » dont la formule a été amplifiée, mais non point inventée en ces dernières années."
                                            },
                                            {
                                                "example_id": "628be65a-2cfb-42ee-b291-ddc7af0b7e2b",
                                                "sense_id": "ba9dc75c-7752-3ddb-8db6-63c186504167",
                                                "text": "Tu sais combien de piges il m’a pris, le casse-pipe ? Cinq. Cinq longues années de chiennerie. Afghanistan de mes couilles ! Montagnes de mes couilles ! Putain de guerre…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
