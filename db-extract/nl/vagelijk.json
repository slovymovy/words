                                "target_senses": [
                                    {
                                        "sense_id": "56f375e5-0b34-38d2-acd9-ade9378c47db",
                                        "entry_id": "9b33fa01-c85b-3b7e-b4ae-b64e016ed938",
                                        "glosses": [
                                            "An acute fever."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cca799e-d869-3386-b62f-5e2f82f725ad",
                                        "entry_id": "9b33fa01-c85b-3b7e-b4ae-b64e016ed938",
                                        "glosses": [
                                            "An intermittent fever, attended by alternate cold and hot fits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ada7a407-c468-4bd0-b264-a49653500b3c",
                                                "sense_id": "7cca799e-d869-3386-b62f-5e2f82f725ad",
                                                "text": "He had to capture some character and get out of that rest room before his ague got so bad that the sergeant had to carry him to and from the booth every day."
                                            },
                                            {
                                                "example_id": "303209d4-2989-4a34-88b4-2f671eacf189",
                                                "sense_id": "7cca799e-d869-3386-b62f-5e2f82f725ad",
                                                "text": "He shivered all the while, so violently, that it was quite as much as he could do to keep the neck of the bottle between his teeth, without biting it off.\n “I think you have got the ague,” said I.\n “I’m much of your opinion, boy,” said he.\n“It’s bad about here,” I told him. “You’ve been lying out on the meshes, and they’re dreadful aguish. Rheumatic too.”"
                                            },
                                            {
                                                "example_id": "b5792653-d69a-40cc-b49e-fae84bfb0525",
                                                "sense_id": "7cca799e-d869-3386-b62f-5e2f82f725ad",
                                                "text": "Ague and lake fever had attacked our new settlement. The men in the shanty were all down with it, and my husband was confined to his bed on each alternate day, unable to raise hand or foot, and raving in the delirium of the fever."
                                            },
                                            {
                                                "example_id": "2af14eb3-e6ce-4f33-be20-b03e31cacf8a",
                                                "sense_id": "7cca799e-d869-3386-b62f-5e2f82f725ad",
                                                "text": "’Twere hard to say who fared the best:\n Sad mortals! thus the Gods still plague you!\n He lost his labour, I my jest:\nFor he was drowned, and I’ve the ague"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53b609a-7e3f-37c1-b343-adc34baee055",
                                        "entry_id": "9b33fa01-c85b-3b7e-b4ae-b64e016ed938",
                                        "glosses": [
                                            "The cold fit or rigor of an intermittent fever."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb83094f-cc3b-4735-b10e-114ffe1c8b39",
                                                "sense_id": "d53b609a-7e3f-37c1-b343-adc34baee055",
                                                "text": "fever and ague"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a466ccc-e00d-367f-8fd1-9563f5f768b1",
                                        "entry_id": "9b33fa01-c85b-3b7e-b4ae-b64e016ed938",
                                        "glosses": [
                                            "A chill, or state of shaking, as with cold."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0c863c8-cb63-4af9-94af-0362bda6a4b2",
                                                "sense_id": "3a466ccc-e00d-367f-8fd1-9563f5f768b1",
                                                "text": "November 23, 1698, John Dryden, letter to Mrs Stewart\nI ’scap’d with one cold fit of an ague"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6d1c1b5-2fb8-3956-8f5d-ae11ba1beeac",
                                        "entry_id": "9b33fa01-c85b-3b7e-b4ae-b64e016ed938",
                                        "glosses": [
                                            "Malaria."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "420b68cd-daa6-4c3d-8c2f-0bb56de35a8e",
                                                "sense_id": "b6d1c1b5-2fb8-3956-8f5d-ae11ba1beeac",
                                                "text": "Where I’m from, people have learned that mosquitoes carry ague."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
