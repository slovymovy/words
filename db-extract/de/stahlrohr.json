                ],
                "senses": [
                    {
                        "sense_id": "78f123b4-8172-3776-9de0-420c3c5719d7",
                        "entry_id": "4156c4e4-4e0e-380e-8717-1b716b99cf78",
                        "glosses": [
                            "aus Stahl hergestelltes Rohr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ecdbdd-90fc-4598-9cea-33aa2b7ec051",
                                "sense_id": "78f123b4-8172-3776-9de0-420c3c5719d7",
                                "text": "Stahlrohre sind sehr stabile Rohre."
                            },
                            {
                                "example_id": "07b32d7d-c558-4284-b121-e6a629988399",
                                "sense_id": "78f123b4-8172-3776-9de0-420c3c5719d7",
                                "text": "„Gefertigt hat diese Gelatin aus allem, was bei der Hand war, von Plexiglas über Gips und Stahlrohr bis zu Bugholzstühlen – womit wir wieder bei der Jahrhundertwende wären.“"
                            },
                            {
                                "example_id": "9dc542e7-b342-4800-85ee-6b02e431160a",
                                "sense_id": "78f123b4-8172-3776-9de0-420c3c5719d7",
                                "text": "„An einigen Stellen ist es grün. Andere Partien blass-weiß vom Flussmittel, das beim Löten eingesetzt wird, damit das Stahlrohr weder mit Sauerstoff reagiert noch rostet.“"
                            },
                            {
                                "example_id": "75d065fe-72a4-47a2-a891-e0610aa2bb19",
                                "sense_id": "78f123b4-8172-3776-9de0-420c3c5719d7",
                                "text": "„Er hatte einen Kartentisch ins Wohnzimmer gestellt, damit sie dort essen konnten, und dazu zwei Küchenstühle, der eine aus Holz mit steifer Rückenlehne, der andre aus Stahlrohr mit Formica-Sitz und -Lehne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
