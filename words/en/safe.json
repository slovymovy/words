{
    "word_family": [
        "safely",
        "safety",
        "safeguard",
        "safekeeping",
        "safeness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3995756e-ed9c-3aff-96d7-cb48cdad81df",
                    "sense_definition": "Not in danger or out of harm's reach.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will be <w>safe</w> from the storm here in the cabin.",
                            "target_lang_translations": {
                                "ru": "Здесь, в хижине, вы будете <w>в безопасности</w> от шторма."
                            }
                        },
                        {
                            "text": "The children are <w>safe</w> and sound at home after the long trip.",
                            "target_lang_translations": {
                                "ru": "Дети дома, <w>целы и невредимы</w> после долгой поездки."
                            }
                        }
                    ],
                    "synonyms": [
                        "protected",
                        "secure",
                        "out of harm's way",
                        "safe and sound"
                    ],
                    "antonyms": [
                        "dangerous",
                        "unsafe",
                        "hazardous"
                    ],
                    "common_phrases": [
                        "safe and sound",
                        "safe from harm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся вне опасности или вне пределов досягаемости вреда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в безопасности",
                                "target_lang_sense_clarification": "состояние защищенности"
                            },
                            {
                                "target_lang_word": "цел и невредим",
                                "target_lang_sense_clarification": "после опасного события"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c90092e-bf01-393c-ad5d-361c52c209c5",
                    "sense_definition": "Free from risk or not likely to cause harm.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "risk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>safe</w> to eat this berry because it is not poisonous.",
                            "target_lang_translations": {
                                "ru": "Эту ягоду <w>безопасно</w> есть, потому что она не ядовита."
                            }
                        },
                        {
                            "text": "Is it <w>safe</w> to travel alone in this part of the city at night?",
                            "target_lang_translations": {
                                "ru": "<w>Безопасно</w> ли путешествовать в одиночку в этой части города ночью?"
                            }
                        }
                    ],
                    "synonyms": [
                        "riskless",
                        "harmless"
                    ],
                    "antonyms": [
                        "dangerous",
                        "unsafe",
                        "harmful"
                    ],
                    "common_phrases": [
                        "safe to use",
                        "safe to eat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не сопряженный с риском или вряд ли способный причинить вред."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безопасный",
                                "target_lang_sense_clarification": "не представляющий угрозы"
                            },
                            {
                                "target_lang_word": "безвредный",
                                "target_lang_sense_clarification": "не причиняющий вреда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f601fdec-724f-318b-868c-4129fc19140f",
                    "sense_definition": "Providing protection from danger or providing shelter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have to find a <w>safe</w> spot where we can hide until this is over.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти <w>безопасное</w> место, где мы сможем спрятаться, пока всё не закончится."
                            }
                        },
                        {
                            "text": "The bank is a <w>safe</w> place to keep your money.",
                            "target_lang_translations": {
                                "ru": "Банк — это <w>надежное</w> место для хранения ваших денег."
                            }
                        }
                    ],
                    "synonyms": [
                        "secure",
                        "guarded"
                    ],
                    "antonyms": [
                        "dangerous",
                        "unsafe"
                    ],
                    "common_phrases": [
                        "safe place",
                        "safe haven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивающий защиту от опасности или предоставляющий убежище."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безопасный",
                                "target_lang_sense_clarification": "защищенный от угроз"
                            },
                            {
                                "target_lang_word": "надежный",
                                "target_lang_sense_clarification": "проверенный и крепкий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aded2c42-1c23-3631-b479-80d39cc252d0",
                    "sense_definition": "Properly secured or locked away.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "security",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The documents are <w>safe</w> inside the cabinet.",
                            "target_lang_translations": {
                                "ru": "Документы <w>в сохранности</w> внутри шкафа."
                            }
                        },
                        {
                            "text": "Keep your passport in a <w>safe</w> location while you are on vacation.",
                            "target_lang_translations": {
                                "ru": "Храните паспорт в <w>надежном</w> месте, пока вы в отпуске."
                            }
                        }
                    ],
                    "synonyms": [
                        "secure"
                    ],
                    "antonyms": [
                        "unsafe"
                    ],
                    "common_phrases": [
                        "safe and secure",
                        "keep it safe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надежно закрепленный или запертый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надежный",
                                "target_lang_sense_clarification": "хорошо защищенный"
                            },
                            {
                                "target_lang_word": "безопасный",
                                "target_lang_sense_clarification": "защищенный от кражи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "babe3897-0d36-30c0-804c-d49d218f8bd4",
                    "sense_definition": "Not susceptible to a specified source of harm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure the plates are dishwasher-<w>safe</w> before putting them in the machine.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что тарелки <w>подходят</w> для посудомоечной машины, прежде чем класть их туда."
                            }
                        },
                        {
                            "text": "This toy is child-<w>safe</w> and contains no small parts.",
                            "target_lang_translations": {
                                "ru": "Эта игрушка <w>безопасна</w> для детей и не содержит мелких деталей."
                            }
                        }
                    ],
                    "synonyms": [
                        "invulnerable"
                    ],
                    "common_phrases": [
                        "dishwasher safe",
                        "microwave safe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не подверженный воздействию определенного источника вреда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безопасный",
                                "target_lang_sense_clarification": "подходящий для использования"
                            },
                            {
                                "target_lang_word": "устойчивый",
                                "target_lang_sense_clarification": "выдерживающий воздействие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e14f9c6-e7c1-39f3-bd8a-1c16dd9e15da",
                    "sense_definition": "Reliable and trusty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reliability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>safe</w> pair of hands for this difficult project.",
                            "target_lang_translations": {
                                "ru": "Он — <w>надежный</w> человек для этого сложного проекта."
                            }
                        },
                        {
                            "text": "The investment is considered a <w>safe</w> bet for long-term growth.",
                            "target_lang_translations": {
                                "ru": "Эта инвестиция считается <w>верным</w> вариантом для долгосрочного роста."
                            }
                        }
                    ],
                    "synonyms": [
                        "trustworthy",
                        "reliable"
                    ],
                    "common_phrases": [
                        "safe pair of hands",
                        "safe bet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надежный и заслуживающий доверия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надежный",
                                "target_lang_sense_clarification": "тот, на кого можно положиться"
                            },
                            {
                                "target_lang_word": "верный",
                                "target_lang_sense_clarification": "гарантированный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f6f372f-051c-32d8-8b15-44e63d0851e9",
                    "sense_definition": "Supported by evidence and unlikely to be overturned.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyers argued that it was not a <w>safe</w> conviction due to new evidence.",
                            "target_lang_translations": {
                                "ru": "Адвокаты утверждали, что приговор не был <w>обоснованным</w> в связи с новыми доказательствами."
                            }
                        },
                        {
                            "text": "The judge ruled that the previous verdict was <w>safe</w> and would stand.",
                            "target_lang_translations": {
                                "ru": "Судья постановил, что предыдущий вердикт был <w>законным</w> и останется в силе."
                            }
                        }
                    ],
                    "antonyms": [
                        "unsafe"
                    ],
                    "common_phrases": [
                        "safe conviction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подкрепленный доказательствами и вряд ли подлежащий отмене (о приговоре)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обоснованный",
                                "target_lang_sense_clarification": "юридически законный"
                            },
                            {
                                "target_lang_word": "надежный",
                                "target_lang_sense_clarification": "неоспоримый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50fe17a9-bd8f-378e-93f1-4575903aa76b",
                    "sense_definition": "Great, cool, or respectable; used as a term of approval.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Yeah <w>safe</w> man, thanks for the help with my car.",
                            "target_lang_translations": {
                                "ru": "Да, <w>четко</w>, чувак, спасибо за помощь с машиной."
                            }
                        },
                        {
                            "text": "He is a <w>safe</w> mate who always looks out for his friends.",
                            "target_lang_translations": {
                                "ru": "Он <w>свой</w> парень, который всегда присматривает за друзьями."
                            }
                        }
                    ],
                    "synonyms": [
                        "cool",
                        "great",
                        "wicked",
                        "dope"
                    ],
                    "common_phrases": [
                        "yeah safe"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British slang"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, крутой или уважаемый; используется как выражение одобрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "четкий",
                                "target_lang_sense_clarification": "сленг: хороший, правильный"
                            },
                            {
                                "target_lang_word": "свой",
                                "target_lang_sense_clarification": "надежный человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01437d14-203a-34da-9f4a-9bdb07be6181",
                    "sense_definition": "In baseball, reaching a base successfully without being put out.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher attempted to pick off the runner, but he was <w>safe</w>.",
                            "target_lang_translations": {
                                "ru": "Питчер попытался выбить раннера, но тот остался <w>в игре</w>."
                            }
                        },
                        {
                            "text": "The umpire shouted that the runner was <w>safe</w> at home plate.",
                            "target_lang_translations": {
                                "ru": "Судья крикнул, что раннер <w>в безопасности</w> на домашней базе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "safe at first",
                        "called safe"
                    ],
                    "target_lang_definitions": {
                        "ru": "В бейсболе: успешное достижение базы без выбывания из игры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в игре",
                                "target_lang_sense_clarification": "не выбитый"
                            },
                            {
                                "target_lang_word": "сейф",
                                "target_lang_sense_clarification": "термин в бейсболе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65a21d30-4f95-3801-9b89-17b544878323",
                    "sense_definition": "Lenient or easy-going, especially regarding a teacher.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone wants to be in his class because he is a <w>safe</w> teacher.",
                            "target_lang_translations": {
                                "ru": "Все хотят попасть к нему в класс, потому что он <w>мировой</w> учитель."
                            }
                        },
                        {
                            "text": "She is quite <w>safe</w> and rarely gives students any detention.",
                            "target_lang_translations": {
                                "ru": "Она довольно <w>лояльна</w> и редко оставляет учеников после уроков."
                            }
                        }
                    ],
                    "synonyms": [
                        "lenient",
                        "easy-going",
                        "tolerant"
                    ],
                    "antonyms": [
                        "strict",
                        "harsh"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "school slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снисходительный или покладистый, особенно в отношении учителя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мировой",
                                "target_lang_sense_clarification": "сленг: очень добрый"
                            },
                            {
                                "target_lang_word": "лояльный",
                                "target_lang_sense_clarification": "нестрогий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7300fe6e-60d0-3a10-98a5-8af98f97a01d",
                    "sense_definition": "Of a programming language, offering well-defined behavior despite errors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rust is known for being a memory-<w>safe</w> programming language.",
                            "target_lang_translations": {
                                "ru": "Rust известен как язык программирования с <w>безопасной</w> работой с памятью."
                            }
                        },
                        {
                            "text": "The developer focused on writing <w>safe</w> code to prevent system crashes.",
                            "target_lang_translations": {
                                "ru": "Разработчик сосредоточился на написании <w>безопасного</w> кода для предотвращения сбоев системы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "type safe",
                        "memory safe"
                    ],
                    "target_lang_definitions": {
                        "ru": "О языке программирования: предлагающий четко определенное поведение, несмотря на ошибки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безопасный",
                                "target_lang_sense_clarification": "защищенный от ошибок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d64dde4d-b8ae-382b-b643-a97a338b177a",
                    "sense_definition": "A strong metal box in which valuables can be locked for safekeeping.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room has a small <w>safe</w> for your passport and jewelry.",
                            "target_lang_translations": {
                                "ru": "В гостиничном номере есть небольшой <w>сейф</w> для вашего паспорта и драгоценностей."
                            }
                        },
                        {
                            "text": "He kept his life savings in a heavy iron <w>safe</w> in the basement.",
                            "target_lang_translations": {
                                "ru": "Он хранил свои сбережения в тяжелом железном <w>сейфе</w> в подвале."
                            }
                        }
                    ],
                    "synonyms": [
                        "strongbox",
                        "lockbox",
                        "coffer"
                    ],
                    "common_phrases": [
                        "wall safe",
                        "crack a safe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочный металлический ящик, в котором ценности могут быть заперты на хранение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сейф",
                                "target_lang_sense_clarification": "несгораемый шкаф"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6aaca130-bdd7-38ec-9dde-f4e627b404f7",
                    "sense_definition": "A condom.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contraception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made sure he was carrying a <w>safe</w> in his back pocket.",
                            "target_lang_translations": {
                                "ru": "Он убедился, что у него в заднем кармане есть <w>резинка</w>."
                            }
                        },
                        {
                            "text": "The clinic provides free <w>safes</w> to encourage protected sex.",
                            "target_lang_translations": {
                                "ru": "Клиника предоставляет бесплатные <w>презервативы</w> для поощрения защищенного секса."
                            }
                        }
                    ],
                    "synonyms": [
                        "condom"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal term for condom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Презерватив."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резинка",
                                "target_lang_sense_clarification": "сленг: презерватив"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "159eade4-5875-3a97-a2ad-e841eb768319",
                    "sense_definition": "A ventilated chest or closet for securing food from animals or insects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen had a meat <w>safe</w> with a mesh screen to keep flies away.",
                            "target_lang_translations": {
                                "ru": "На кухне был <w>шкаф-ледник</w> для мяса с сетчатым экраном для защиты от мух."
                            }
                        },
                        {
                            "text": "In the old days, people used a <w>safe</w> to keep bread fresh.",
                            "target_lang_translations": {
                                "ru": "В прежние времена люди использовали специальный <w>шкаф</w>, чтобы хлеб оставался свежим."
                            }
                        }
                    ],
                    "common_phrases": [
                        "meat safe"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly replaced by refrigerators"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вентилируемый ящик или шкаф для защиты продуктов от животных или насекомых."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкаф-ледник",
                                "target_lang_sense_clarification": "для хранения продуктов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76943893-e0c4-3c51-9fb2-297e4462a7f6",
                    "sense_definition": "To make something safe or to deactivate a dangerous device.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
