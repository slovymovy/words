                            "Rechtsphilosophie"
                        ],
                        "examples": [
                            {
                                "example_id": "46d17db3-c345-4021-9c6c-b19ec68fe63b",
                                "sense_id": "431cc9f2-76bd-3a36-bdfe-0af6286ccb56",
                                "text": "„Der rechtsphilosophische Terminus Rechtsidee, der seinen begriffsgeschichtlich bedeutsamen Anstoß vom Kantianismus und Hegelianismus bekommt, hat es unmittelbar zu tun mit der Frage nach der Richtigkeit rechtlicher Anordnungen.“"
                            },
                            {
                                "example_id": "41ff0035-8271-493d-8952-fef2b1351fcb",
                                "sense_id": "431cc9f2-76bd-3a36-bdfe-0af6286ccb56",
                                "text": "Die Rechtsidee trägt den Entschluss zu ihrer eigenen Geschichtlichkeit in sich."
                            }
                        ],
