                    {
                        "translation_id": "0179da47-1384-452a-b573-56bc568075de",
                        "source_entry_id": "fd5cd576-d634-349e-aae2-e4a9d6730455",
                        "source_sense_id": "d1195904-0591-3ff1-8053-a78ee7ef3e63",
