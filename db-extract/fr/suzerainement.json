                        "glosses": [
                            "Comme un suzerain qui traite avec un vassal, avec des vassaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae3ac563-d17b-4e21-a8c4-b05b625315bb",
                                "sense_id": "e88c8bd5-3a43-33d2-b11d-3f561e7c86af",
                                "text": "Je lui céderai le Péloponèse, je donnerai d'autres provinces à ses frères, et je les protégerai suzerainement."
                            },
                            {
                                "example_id": "341900cc-b8ba-4165-bf46-7cb846d4d4b6",
                                "sense_id": "e88c8bd5-3a43-33d2-b11d-3f561e7c86af",
                                "text": "Avec sa chevelure de classique modèle italien, son monocle instable, son cigare dans l'œil et son col rabattu sur une éternelle cravate bleu pâle. il reçoit suzerainement la foule de ses lieutenants présumés."
                            }
                        ]
                    }
