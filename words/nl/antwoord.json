                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb94bcd-44b8-39a9-bc9a-9d374d8cab71",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>antwoorden</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>antwoord</w> je niet als ik je een vraag stel?",
                            "target_lang_translations": {
                                "en": "Why don't you <w>answer</w> when I ask you a question?",
                                "ru": "Почему ты не <w>отвечаешь</w>, когда я задаю тебе вопрос?"
                            }
                        },
                        {
                            "text": "Als je nu <w>antwoord</w>, kunnen we nog op tijd vertrekken.",
                            "target_lang_translations": {
                                "en": "If you <w>answer</w> now, we can still leave on time.",
                                "ru": "Если ты сейчас <w>ответишь</w>, мы еще сможем выехать вовремя."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present indicative (inverted)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second-person singular present tense of 'to answer' (used in questions or inverted word order)",
                        "ru": "форма второго лица единственного числа настоящего времени глагола 'отвечать' (используется при инверсии)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "you answer"
                            },
                            {
                                "target_lang_word": "reply",
                                "target_lang_sense_clarification": "you reply"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отвечаешь",
                                "target_lang_sense_clarification": "ты отвечаешь"
                            },
                            {
                                "target_lang_word": "отвечаешь ли",
                                "target_lang_sense_clarification": "в вопросительной форме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0faea85b-6f60-3c97-8f3e-aab853170302",
                    "sense_definition": "gebiedende wijs van <w>antwoorden</w>",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Antwoord</w> nu eindelijk eens op mijn dringende vraag!",
                            "target_lang_translations": {
                                "en": "<w>Answer</w> my urgent question at last!",
                                "ru": "<w>Ответь</w> же наконец на мой срочный вопрос!"
                            }
                        },
                        {
                            "text": "Geef niet op en <w>antwoord</w> eerlijk op wat er gevraagd wordt.",
                            "target_lang_translations": {
                                "en": "Don't give up and <w>answer</w> honestly to what is being asked.",
                                "ru": "Не сдавайся и честно <w>отвечай</w> на то, что тебя спрашивают."
                            }
                        }
                    ],
                    "traits": [
