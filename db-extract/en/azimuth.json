                        "entry_id": "2a4b5f35-f836-3dc1-881b-a31ffe70fccc",
                        "glosses": [
                            "An arc of the horizon intercepted between the meridian of the place and a vertical circle passing through the center of any object."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78b1ffbc-cb64-41c8-b135-3dcbd7581724",
                                "sense_id": "40504f27-f314-389a-9808-45808cd0a86e",
                                "text": "the azimuth of a star"
                            },
                            {
                                "example_id": "208c0c1e-e140-4834-a4db-8305ab160e80",
                                "sense_id": "40504f27-f314-389a-9808-45808cd0a86e",
                                "text": "the azimuth or bearing of a line surveying"
                            }
                        ]
                    },
                    {
                        "sense_id": "dfea26ac-a33c-3806-b3a2-9305519d8b53",
                        "entry_id": "2a4b5f35-f836-3dc1-881b-a31ffe70fccc",
                        "glosses": [
                            "The quadrant of an azimuth circle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9210d62-6715-4cc4-8c51-6b8b01348a4d",
                                "sense_id": "dfea26ac-a33c-3806-b3a2-9305519d8b53",
                                "text": "The dome, being constructed of wood, was light by comparison with the rest of the structure, and the wheels which allowed it horizontal, or, as Swithin expressed it, azimuth motion, denied it a firm hold upon the walls; so that it had been lifted off them like a cover from a pot."
                            }
                        ]
                    }
                ],
