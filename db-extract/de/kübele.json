                ],
                "senses": [
                    {
                        "sense_id": "bf5b3530-1698-3354-8f43-b4ecdf9b6b27",
                        "entry_id": "73805056-7d94-3c54-be2a-101251da8d4c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "407a1c7e-51cb-4bae-b9ba-6433353adbec",
                                "sense_id": "bf5b3530-1698-3354-8f43-b4ecdf9b6b27",
                                "text": "Frau Kübele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d3c2f0a5-ec84-4457-9d45-3aceebc05f9a",
                                "sense_id": "bf5b3530-1698-3354-8f43-b4ecdf9b6b27",
                                "text": "Herr Kübele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "539c841c-d796-4732-881b-7bf9cb476146",
                                "sense_id": "bf5b3530-1698-3354-8f43-b4ecdf9b6b27",
                                "text": "Die Kübeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0b984a1f-d941-40c1-a643-c91c27a78055",
                                "sense_id": "bf5b3530-1698-3354-8f43-b4ecdf9b6b27",
                                "text": "Der Kübele trägt nie die Schals, die die Kübele ihm strickt."
                            },
                            {
                                "example_id": "78a82285-dbfd-4e18-9697-724e9c1f401e",
                                "sense_id": "bf5b3530-1698-3354-8f43-b4ecdf9b6b27",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kübele kommt, geht der Herr Kübele.“"
                            },
                            {
                                "example_id": "1e213c04-0cca-485f-aa6f-fff894accdd2",
                                "sense_id": "bf5b3530-1698-3354-8f43-b4ecdf9b6b27",
                                "text": "Kübele kommt und geht."
                            },
                            {
                                "example_id": "c1856fa2-2391-4d05-b4a2-a19f4cf4c5ed",
                                "sense_id": "bf5b3530-1698-3354-8f43-b4ecdf9b6b27",
                                "text": "Kübeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
