                ],
                "senses": [
                    {
                        "sense_id": "291d6f85-85e7-3c3d-b236-10d6f6de98b4",
                        "entry_id": "62b0f7a2-0da3-3b8d-b7d8-bb540c2b089f",
                        "glosses": [
                            "A store primarily serving persons in an institution, most often soldiers or prisoners."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f2303cc-2b3e-4142-b21e-a28a3cc5f007",
                                "sense_id": "291d6f85-85e7-3c3d-b236-10d6f6de98b4",
                                "text": "The base [Fort Meade] has its own post offices, schools, police, and fire departments. Area children, military brats and civilians alike, would flock to the base daily to take golf, tennis, and swimming lessons. Though we lived off base, my mother still used its commissary as our grocery store, to stock up on items in bulk."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe896a4c-a991-322d-b682-22847be1d4a9",
                        "entry_id": "62b0f7a2-0da3-3b8d-b7d8-bb540c2b089f",
                        "glosses": [
                            "An account which a prisoner uses to buy provisions, or the balance of that account."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1550feaf-673e-48e1-8798-938e43e90f72",
                                "sense_id": "fe896a4c-a991-322d-b682-22847be1d4a9",
                                "text": "“We tried to provide for you while you were in there. We may not have put as much on your commissary as your in-laws, but what we gave was more to us.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "113101eb-57f9-3aed-8e9b-471d3f207c0c",
                        "entry_id": "62b0f7a2-0da3-3b8d-b7d8-bb540c2b089f",
                        "glosses": [
                            "A cafeteria at a television or movie studio."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d36114dc-d23a-35fb-80ec-85d3ead0a85b",
                        "entry_id": "62b0f7a2-0da3-3b8d-b7d8-bb540c2b089f",
                        "glosses": [
                            "One to whom is committed some charge, duty, or office, by a superior power; a commissioner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b0f94e-cfac-47b8-aa10-905847371ab0",
                                "sense_id": "d36114dc-d23a-35fb-80ec-85d3ead0a85b",
                                "text": "Great Deſtiny the Commiſſary of God;"
                            }
                        ]
                    },
                    {
                        "sense_id": "76a65772-bf5b-38f8-9f81-7d37cd0ebcb5",
                        "entry_id": "62b0f7a2-0da3-3b8d-b7d8-bb540c2b089f",
                        "glosses": [
                            "An officer of the bishop, who exercises ecclesiastical jurisdiction in parts of the diocese at a distance from the residence of the bishop."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "656cce3c-3c10-4e0c-ba08-26a0e5991e15",
                                "sense_id": "76a65772-bf5b-38f8-9f81-7d37cd0ebcb5",
                                "text": "It has been already hinted , that a Commissary, in Latin stiled Commisarius, is a Title of Ecclefiaftical Jurisdiction"
                            }
                        ]
                    },
                    {
                        "sense_id": "57817ef3-d898-38ea-adfe-c6cddd1cb883",
                        "entry_id": "62b0f7a2-0da3-3b8d-b7d8-bb540c2b089f",
                        "glosses": [
                            "An officer who supplies provisions to an army."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cb3620e7-fecd-3404-aa71-132b84f7d636",
                        "entry_id": "62b0f7a2-0da3-3b8d-b7d8-bb540c2b089f",
                        "glosses": [
                            "The judge in a commissary court."
                        ],
