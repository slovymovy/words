                "senses": [
                    {
                        "sense_id": "cf19e48e-a0b5-3560-bf7d-db96f29e1960",
                        "entry_id": "5da6c7cd-509b-3ddd-bbd4-310ac62f1613",
                        "glosses": [
                            "de manier waarop men in zedelijk opzicht leeft en heeft geleefd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2601b01f-52e4-4437-b7e7-e42085d8f62b",
                                "sense_id": "cf19e48e-a0b5-3560-bf7d-db96f29e1960",
                                "text": "Sinds december vorig jaar voert de politie in Padua onderzoek naar de levenswandel van de 48-jarige priester Andrea Contin. Die zou er een heus dubbelleven op na gehouden hebben. Uiterlijk een keurige priester in een klein kerkje. Maar daarachter ging een leven vol uitspattingen schuil."
                            },
                            {
                                "example_id": "15d8d072-d6d9-4cbf-a202-b08b157af133",
                                "sense_id": "cf19e48e-a0b5-3560-bf7d-db96f29e1960",
                                "text": "'Deze vragen leiden nergens toe en ze hebben geen enkele relevantie voor het bewijsthema, is mevrouw Curtholmen wel of niet ontrouw geweest? Daar gaat het om en niet om de eventueel bedenkelijke levenswandel van redacteur Levov."
                            }
                        ]
                    },
                    {
                        "sense_id": "8de8b9ce-44f8-327f-ad21-12f152bfbfd3",
                        "entry_id": "5da6c7cd-509b-3ddd-bbd4-310ac62f1613",
                        "glosses": [
                            "een beschrijving van iemands leven tot nu toe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed4f82ea-f7c2-4d0c-902e-fa99592d095a",
                                "sense_id": "8de8b9ce-44f8-327f-ad21-12f152bfbfd3",
                                "text": "Hij laat 1250 asielzoekers die in detentie zitten op twee eilandjes in het noorden van Australië naar de VS komen op voorwaarde dat hun levenswandel op de \"strengst mogelijke manier zal worden nagetrokken\"."
                            }
                        ]
                    }
                ],
