{
    "word_family": [
        "slimness",
        "slimly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c9890492-e978-39e8-bf2b-2f47f92a6d2f",
                    "sense_definition": "Attractively thin and slender in physical form.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "thinness_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most fashion models are tall and <w>slim</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство фотомоделей высокие и <w>стройные</w>.",
                                "zh": "大多数时装模特都很高，身材很<w>苗条</w>。"
                            }
                        },
                        {
                            "text": "She managed to stay <w>slim</w> by eating healthy food and running every day.",
                            "target_lang_translations": {
                                "ru": "Ей удавалось оставаться <w>стройной</w> благодаря здоровому питанию и ежедневному бегу.",
                                "zh": "她通过健康饮食和每天跑步，成功保持了<w>苗条</w>的身材。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slender",
                        "thin",
                        "svelte",
                        "lithe",
                        "willowy"
                    ],
                    "antonyms": [
                        "fat",
                        "chubby",
                        "overweight"
                    ],
                    "common_phrases": [
                        "slim figure",
                        "look slim",
                        "stay slim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекательно худой и изящный по телосложению.",
                        "zh": "形容人身材苗条、匀称，具有吸引力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стройный",
                                "target_lang_sense_clarification": "о фигуре"
                            },
                            {
                                "target_lang_word": "худой",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "изящный",
                                "target_lang_sense_clarification": "грациозный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苗条",
                                "target_lang_sense_clarification": "形容身材好"
                            },
                            {
                                "target_lang_word": "纤细",
                                "target_lang_sense_clarification": "形容体态优美"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8d7da46-7f0d-3b93-a951-51f07e27bf93",
                    "sense_definition": "Very small in amount, degree, or probability.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "small_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is only a <w>slim</w> chance that we will arrive on time.",
                            "target_lang_translations": {
                                "ru": "Есть лишь <w>ничтожный</w> шанс, что мы прибудем вовремя.",
                                "zh": "我们能准时到达的机会非常<w>渺茫</w>。"
                            }
                        },
                        {
                            "text": "The team won the championship by a <w>slim</w> margin.",
                            "target_lang_translations": {
                                "ru": "Команда выиграла чемпионат с <w>незначительным</w> перевесом.",
                                "zh": "该队以微弱的<w>优势</w>赢得了冠军。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marginal",
                        "tiny",
                        "infinitesimal"
                    ],
                    "antonyms": [
                        "strong",
                        "good"
                    ],
                    "common_phrases": [
                        "slim chance",
                        "slim margin",
                        "slim hope",
                        "slim majority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленький по количеству, степени или вероятности.",
                        "zh": "指数量、程度或可能性非常小。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ничтожный",
                                "target_lang_sense_clarification": "о шансе или вероятности"
                            },
                            {
                                "target_lang_word": "незначительный",
                                "target_lang_sense_clarification": "о разнице или перевесе"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "о надежде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微小",
                                "target_lang_sense_clarification": "指可能性或几率"
                            },
                            {
                                "target_lang_word": "渺茫",
                                "target_lang_sense_clarification": "指希望或机会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06e0277f-0d0f-3a08-870d-3c7c490d7857",
                    "sense_definition": "Thinner than usual or reduced in width or size.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "thinness_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a <w>slim</w> laptop that fits easily into his bag.",
                            "target_lang_translations": {
                                "ru": "Он купил <w>тонкий</w> ноутбук, который легко помещается в его сумку.",
                                "zh": "他买了一台<w>轻薄</w>的笔记本电脑，可以轻松放进包里。"
                            }
                        },
                        {
                            "text": "The book was a <w>slim</w> volume of poetry.",
                            "target_lang_translations": {
                                "ru": "Книга представляла собой <w>тонкий</w> томик стихов.",
                                "zh": "那本书是一本<w>薄</w>薄的诗集。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thin",
                        "slender",
                        "narrow"
                    ],
                    "antonyms": [
                        "thick",
                        "bulky"
                    ],
                    "common_phrases": [
                        "slim fit",
                        "slim design"
                    ],
                    "target_lang_definitions": {
                        "ru": "Более тонкий, чем обычно, или уменьшенный по ширине или размеру.",
                        "zh": "指物体比通常更薄，或在宽度和尺寸上有所减小。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о предметах"
                            },
                            {
                                "target_lang_word": "плоский",
                                "target_lang_sense_clarification": "о форме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "薄",
                                "target_lang_sense_clarification": "指厚度"
                            },
                            {
                                "target_lang_word": "轻薄",
                                "target_lang_sense_clarification": "指设计或体积"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c44cb55a-30d5-3103-96d1-4d953d564f3e",
                    "sense_definition": "Sly, crafty, or cunning in nature.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>slim</w> character who will trick you if he gets the chance.",
                            "target_lang_translations": {
                                "ru": "Он <w>хитрый</w> тип, который обманет вас при первой возможности.",
                                "zh": "他是个<w>狡猾</w>的家伙，一有机会就会骗你。"
                            }
                        },
                        {
                            "text": "The <w>slim</w> fox managed to steal the food without being seen.",
                            "target_lang_translations": {
                                "ru": "<w>Хитрой</w> лисе удалось украсть еду и остаться незамеченной.",
                                "zh": "那只<w>狡猾</w>的狐狸在没被发现的情况下偷走了食物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cunning",
                        "wily",
                        "shoddy"
                    ],
                    "antonyms": [
                        "honest"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South African"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хитрый, коварный или изворотливый по натуре.",
                        "zh": "指性格狡猾、奸诈或阴险。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитрый",
                                "target_lang_sense_clarification": "о характере"
                            },
                            {
                                "target_lang_word": "коварный",
                                "target_lang_sense_clarification": "злонамеренный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狡猾",
                                "target_lang_sense_clarification": "指性格"
                            },
                            {
                                "target_lang_word": "奸诈",
                                "target_lang_sense_clarification": "指行为阴险"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ba7df7c-0242-37b3-9824-a8f3fec14c1b",
                    "sense_definition": "To lose weight, often deliberately through diet and exercise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "thinness_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is trying to <w>slim</w> down before her summer vacation.",
                            "target_lang_translations": {
                                "ru": "Она пытается <w>похудеть</w> перед летним отпуском.",
                                "zh": "她正试图在暑假前<w>减肥</w>。"
                            }
                        },
                        {
                            "text": "He <w>slimmed</w> significantly after changing his diet.",
                            "target_lang_translations": {
                                "ru": "Он заметно <w>похудел</w> после смены диеты.",
                                "zh": "他在改变饮食习惯后明显<w>瘦</w>了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "gain weight"
                    ],
                    "common_phrases": [
                        "slim down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбрасывать вес, часто намеренно с помощью диеты и упражнений.",
                        "zh": "指通过节食或运动等方式减轻体重。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "худеть",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "похудеть",
                                "target_lang_sense_clarification": "результат"
                            },
                            {
                                "target_lang_word": "сбросить вес",
                                "target_lang_sense_clarification": "фраза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减肥",
                                "target_lang_sense_clarification": "指减轻体重"
                            },
                            {
                                "target_lang_word": "瘦身",
                                "target_lang_sense_clarification": "指塑造体型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e876d07-f3a9-3817-bed4-6551cde046eb",
                    "sense_definition": "To reduce the size, number, or extent of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "thinness_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company needs to <w>slim</w> its workforce to reduce costs.",
                            "target_lang_translations": {
                                "ru": "Компании необходимо <w>сократить</w> штат, чтобы снизить расходы.",
                                "zh": "公司需要<w>精简</w>员工队伍以降低成本。"
                            }
                        },
                        {
                            "text": "They decided to <w>slim</w> down the project requirements.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>урезать</w> требования к проекту.",
                                "zh": "他们决定<w>缩减</w>项目需求。"
                            }
                        }
                    ],
                    "antonyms": [
                        "expand"
                    ],
                    "common_phrases": [
                        "slim the workforce",
                        "slim operations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшать размер, количество или масштаб чего-либо.",
                        "zh": "指减少某事物的规模、数量或范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "уменьшать количество"
                            },
                            {
                                "target_lang_word": "урезать",
                                "target_lang_sense_clarification": "о бюджете или требованиях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精简",
                                "target_lang_sense_clarification": "指机构或人员"
                            },
                            {
                                "target_lang_word": "缩减",
                                "target_lang_sense_clarification": "指规模或预算"
                            }
                        ]
                    }
                }
            ]
        },
        {
