                    "frequency": "Middle",
                    "semantic_group_id": "rejet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette terrible dispute, le père en colère a menacé de <w>renier</w> son propre fils."
                        },
                        {
                            "text": "Même si ses parents l'ont <w>renié</w>, il a réussi à reconstruire sa vie avec fierté."
                        }
                    ],
                    "synonyms": [
                        "désavouer",
                        "rejeter"
                    ],
                    "antonyms": [
                        "adopter",
                        "reconnaître"
                    ],
                    "common_phrases": [
