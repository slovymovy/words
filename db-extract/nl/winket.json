                                        "sense_id": "52608aa0-b432-3c05-8d54-acd6d657ab89",
                                        "entry_id": "2d2504fb-4b6b-3d92-b581-d6fba92896da",
                                        "glosses": [
                                            "A shelter made from tree boughs, used by lumbermen."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff163838-940d-4b76-8805-02abe2e375e6",
                                                "sense_id": "52608aa0-b432-3c05-8d54-acd6d657ab89",
                                                "text": "make kindly welcome whatever forest wanderer happens to enter the wicket of the log hit"
                                            }
