                ],
                "senses": [
                    {
                        "sense_id": "066205ec-cc3a-3ff5-b5e3-dd600e496acc",
                        "entry_id": "3bf6eabd-a2a9-3a2c-94f5-f64e2726f351",
                        "glosses": [
                            "Modifikation des Kohlenstoffs mit zweidimensionaler Struktur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de45b5ad-1d4f-4304-a799-399a5154d363",
                                "sense_id": "066205ec-cc3a-3ff5-b5e3-dd600e496acc",
                                "text": "Der Nobelpreis für Physik 2010 wurde für die Arbeit mit Graphen vergeben."
                            },
                            {
                                "example_id": "06e3f594-e7ff-491e-8f35-5aa2828372e1",
                                "sense_id": "066205ec-cc3a-3ff5-b5e3-dd600e496acc",
                                "text": "„Zudem könnte das aus Grafit hergestellte Graphen, eine nur ein Atom dünne Grafitschicht, zu einem Industrierohstoff der Zukunft werden.“"
                            },
                            {
                                "example_id": "dbf53171-31b9-4693-b2f6-190c074d61e5",
                                "sense_id": "066205ec-cc3a-3ff5-b5e3-dd600e496acc",
                                "text": "„Wenn man zwei Schichten der Kohlenstoffvariante Graphen gegeneinander verdreht, fließt Strom verlustfrei hindurch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3f2ebc1-2726-4989-bad7-8f88da1bdb06",
                        "source_entry_id": "3bf6eabd-a2a9-3a2c-94f5-f64e2726f351",
                        "source_sense_id": "066205ec-cc3a-3ff5-b5e3-dd600e496acc",
                        "source_sense_description": "Chemie: Modifikation des Kohlenstoffs mit zweidimensionaler Struktur",
                        "target_lang_word": "graphene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graphene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f2fb67c-36a2-3655-8016-c83c97ea0a33",
                                        "entry_id": "1e758fe9-818d-3511-ae43-690b90339f51",
                                        "glosses": [
                                            "Any polycyclic aromatic hydrocarbon having the structure of part of a layer of graphite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "486a3f27-ce3c-3829-a065-3d05a72f23d0",
                                        "entry_id": "1e758fe9-818d-3511-ae43-690b90339f51",
                                        "glosses": [
                                            "An arbitrarily large-scale, one-atom-thick layer of graphite, an allotrope of carbon, that has remarkable electric characteristics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df07b458-d932-40aa-ac28-ce86aae74e72",
                                                "sense_id": "486a3f27-ce3c-3829-a065-3d05a72f23d0",
                                                "text": "Graphene is the strongest, thinnest material known to exist. A form of carbon, it can conduct electricity and heat better than anything else. And get ready for this: It is not only the hardest material in the world but also one of the most pliable. Only a single atom thick, it has been called the wonder material. Graphene could change the electronics industry, ushering in flexible devices, supercharged quantum computers, electronic clothing and computers that can interface with the cells in your body."
                                            },
                                            {
                                                "example_id": "40086039-7f7a-42d1-a913-c93cb99e7d34",
                                                "sense_id": "486a3f27-ce3c-3829-a065-3d05a72f23d0",
                                                "text": "As a microbullet impacts the graphene, the diameter of the cone it creates – determined by later examination of the petals – provides a way to measure how much energy the graphene absorbs before breaking."
                                            },
                                            {
                                                "example_id": "85be132b-41c7-48cd-b893-2a5e23e2808f",
                                                "sense_id": "486a3f27-ce3c-3829-a065-3d05a72f23d0",
                                                "text": "Graphene, which consists of monolayers of carbon atoms bonded in a repeating hexagonal pattern, is the thinnest known material. It was isolated in 2004 at the University of Manchester by Andre Geim and Konstantin Novoselov, who went on to win a Nobel prize for their discovery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8e0a28d-c285-4642-b558-41e9da13b1e2",
                        "source_entry_id": "3bf6eabd-a2a9-3a2c-94f5-f64e2726f351",
                        "source_sense_id": "066205ec-cc3a-3ff5-b5e3-dd600e496acc",
                        "source_sense_description": "Chemie: Modifikation des Kohlenstoffs mit zweidimensionaler Struktur",
                        "target_lang_word": "graphène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graphène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d1592b2-823e-301e-a949-7b001c24c6a4",
                                        "entry_id": "524121c7-91b8-38d7-aea8-905b8478e3e8",
                                        "glosses": [
                                            "Cristal bidimensionnel qui se présente sous la forme d’un feuillet constitué d’un pavage hexagonal régulier d’atomes de carbone et dont l’empilement constitue le graphite."
                                        ],
                                        "tags": [
                                            "Chimie des matériaux",
                                            "Physique des matériaux"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aebd917-9a45-4abf-983c-78446136af98",
                                                "sense_id": "0d1592b2-823e-301e-a949-7b001c24c6a4",
                                                "text": "Un nanotube de carbone, c'est aussi une usine. Des chercheurs finlandais (université Aalto) ont synthétisé des nanorubans de graphène - autre variété de carbone - à l'intérieur de nanotubes."
                                            },
                                            {
                                                "example_id": "e9772015-4685-463c-9975-ab1fcfa21e38",
                                                "sense_id": "0d1592b2-823e-301e-a949-7b001c24c6a4",
                                                "text": "Les masques FFP2 contenant du graphène, un matériau synthétique, doivent être évités par précaution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
