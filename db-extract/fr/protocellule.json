                        "sense_id": "9d7a2aaa-4b26-3075-9e61-cd6dffa4ad03",
                        "entry_id": "6f25fb1f-8e4e-340c-8125-7f9d6d8020b8",
                        "glosses": [
                            "Cellule primitive."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "1e543a13-c60d-4dea-b562-2f84ff21da6b",
                                "sense_id": "9d7a2aaa-4b26-3075-9e61-cd6dffa4ad03",
                                "text": "En somme la protocellule consistait en un ensemble dynamique et synergique de composantes organiques ayant la propriété d'émerger spontanément dans un milieu riche en énergie et en matière utilisables."
                            },
                            {
                                "example_id": "bf823f3a-0e54-497a-bd22-2ef92bd14443",
                                "sense_id": "9d7a2aaa-4b26-3075-9e61-cd6dffa4ad03",
                                "text": "Pour exister, ces protocellules devaient être constituées par de petits espaces confinés vraisemblablement formés par — ou tout au moins adossés à — des surfaces minérales."
                            }
                        ]
                    }
                ],
