                                        "sense_id": "a4c62434-4617-315c-88f6-9934f04494e4",
                                        "entry_id": "ed2736c6-7d98-3d25-affc-6665f17b91f8",
                                        "glosses": [
                                            "een voorraad aanleggen bij voedselschaarste"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb7fdf04-b003-482f-ab0f-617e9249456f",
                                                "sense_id": "a4c62434-4617-315c-88f6-9934f04494e4",
                                                "text": "Koffie hamsteren omdat de prijs gaat stijgen."
                                            },
                                            {
                                                "example_id": "dee1ba0e-f6fd-437a-95c3-455e48f7461e",
                                                "sense_id": "a4c62434-4617-315c-88f6-9934f04494e4",
                                                "text": "Er is nog geen bevestiging dat de man ook werkelijk ebola heeft, maar het nieuws heeft angst gezaaid in de hoofdstad. Mensen zijn aan het hamsteren geslagen en eten niet langer in de vele eetstalletjes langs de kanten van de weg uit angst voor besmetting, meldden ooggetuigen."
                                            },
                                            {
                                                "example_id": "a3f042f1-9232-411a-8d0b-ec4082f403d2",
                                                "sense_id": "a4c62434-4617-315c-88f6-9934f04494e4",
                                                "text": "Iedereen op Curaçao moet thuisblijven. De regering raadde de inwoners van het eiland aan om te hamsteren. De vervroegde avondklok heeft volgens de DMO-voorzitter niet tot grote ongeregeldheden geleid onder winkelend publiek."
                                            }
                                        ]
                                    }
