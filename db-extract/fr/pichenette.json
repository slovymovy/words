                    },
                    {
                        "translation_id": "92a3e3dc-64f7-4a1e-a7ec-61adfc742433",
                        "source_entry_id": "2b14835d-ffb8-323b-835e-7019081656ee",
                        "target_lang_word": "flick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
