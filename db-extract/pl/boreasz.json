                ],
                "senses": [
                    {
                        "sense_id": "3f7ec9dc-7abb-3d09-8939-d75c2c750934",
                        "entry_id": "4bd19364-e679-3d35-b77a-76879fb530bd",
                        "glosses": [
                            "bóg i uosobienie wiatru północnego, utożsamiany z rzymskim Akwilonem"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "19cb4944-fa83-494b-a2cc-1305cee119a7",
                                "sense_id": "3f7ec9dc-7abb-3d09-8939-d75c2c750934",
                                "text": "Boreasz uosabiał gwałtowny i zimny wiatr, wiejący z północy."
                            },
                            {
                                "example_id": "422065b6-7818-4769-b421-6943e997f8cf",
                                "sense_id": "3f7ec9dc-7abb-3d09-8939-d75c2c750934",
                                "text": "Kult Boreasza był rozpowszechniony wśród żeglarzy i rolników."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6dbf9de1-933d-3f5e-a811-506513fa5ee9",
                        "entry_id": "4bd19364-e679-3d35-b77a-76879fb530bd",
                        "glosses": [
                            "król Celtów, ojciec Kyparissy"
                        ],
                        "tags": [
