                ],
                "senses": [
                    {
                        "sense_id": "1373e8be-eded-3b25-9717-22a9cb26a840",
                        "entry_id": "4300498b-68db-31d9-a3bf-4a54cc3b5ddb",
                        "glosses": [
                            "Qui est extrêmement jeune, jeunot."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7e540097-a273-4fda-88ea-a3be920ef9e7",
                                "sense_id": "1373e8be-eded-3b25-9717-22a9cb26a840",
                                "text": "« Courageuse et de bon conseil, elle l’a été tant qu’elle a vécu, mais c’est surtout dans les commencements, juste après notre mariage, et un peu plus tard, quand ton frère et toi vous étiez encore jeunets qu’elle s’est montrée rare. »"
                            },
                            {
                                "example_id": "2a128e32-484d-4345-8827-407c490cfc90",
                                "sense_id": "1373e8be-eded-3b25-9717-22a9cb26a840",
                                "text": "Le dos tout courbé sous son châle brun, ne trouvant plus la force de se redresser, elle n’avait plus rien de jeunet dans la tournure et sentait bien toute l’accablante lourdeur de ses soixante-seize ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2515aef-d066-41c2-b899-20d64f8f496b",
                        "source_entry_id": "4300498b-68db-31d9-a3bf-4a54cc3b5ddb",
                        "source_sense_id": "1373e8be-eded-3b25-9717-22a9cb26a840",
                        "target_lang_word": "blutjung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
