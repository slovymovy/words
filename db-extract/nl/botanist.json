                                        "glosses": [
                                            "A person engaged in botany, the scientific study of plants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "634ff3db-3366-4cca-b1c5-f9fa3c3c075e",
                                                "sense_id": "3b85bd1e-9aa8-3b0f-ad9f-ee7c63774c52",
                                                "text": "A German botanist gave 'Gandoge' as the locality of an American plant; a package sent by express to 'Sevaber' (an English name), and a letter posted to the town of 'Scur E Quss, Nu Yourck,' arrived safely; and I have seen a handboard directing the traveller to the English-named town of 'Bintgrof'."
                                            },
                                            {
                                                "example_id": "e48afad3-5913-4370-a000-25079261d597",
                                                "sense_id": "3b85bd1e-9aa8-3b0f-ad9f-ee7c63774c52",
                                                "text": "It’s one of the world’s longest-running experiments, having already gone on for 142 years. And the botanists in East Lansing hope that it will last for at least another 80."
                                            }
                                        ]
                                    }
                                ]
                            }
