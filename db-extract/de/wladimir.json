                "senses": [
                    {
                        "sense_id": "4f42639c-f45c-3585-905f-ca3e9737b723",
                        "entry_id": "7f142eda-b269-3e5d-9201-687829f5493d",
                        "glosses": [
                            "am Fluss Kljasma gelegene Stadt im westlichen Russland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21fa4b64-37ef-4078-9e1c-5662d84c204b",
                                "sense_id": "4f42639c-f45c-3585-905f-ca3e9737b723",
                                "text": "„Das moderne Wladimir verspricht keine stimmungsvollen Stadtprospekte, sondern vielmehr kontrastreiche Perspektiven, die sich aus der widerstreitenden Fügung von prachtvollen Kathedralen und der kahlen Funktionalität sozialistischer Großbauten ergeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8fd7141-5807-48bc-bacf-0fd03d03b561",
                        "source_entry_id": "7f142eda-b269-3e5d-9201-687829f5493d",
                        "source_sense_id": "4f42639c-f45c-3585-905f-ca3e9737b723",
                        "source_sense_description": "am Fluss Kljasma gelegene Stadt im westlichen Russland",
                        "target_lang_word": "Владимир",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Владимир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a848f6fe-4894-3037-9aec-7b2f6e882af7",
                                        "entry_id": "bc5ad06e-0937-3a7b-8e33-853666515cf1",
                                        "glosses": [
                                            "мужское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4a39b5c-9cf8-4639-929c-b552e308936c",
                                                "sense_id": "a848f6fe-4894-3037-9aec-7b2f6e882af7",
                                                "text": "Владимир Андреевич вскочил с своего кресла и стал взволнованно ходить из угла в угол."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdad4e91-cf56-37a6-b3e4-8e1ce72fca2c",
                                        "entry_id": "bc5ad06e-0937-3a7b-8e33-853666515cf1",
                                        "glosses": [
                                            "русская фамилия"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Владимир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6f7f94f3-6e88-3f72-9b19-6fde6d53120c",
                                        "entry_id": "fd507dc0-e8f9-3507-8fa7-bb89f9644575",
                                        "glosses": [
                                            "город в России, центр Владимирской области"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f199db1c-42da-437b-a6ce-246cce3d77a1",
                                                "sense_id": "6f7f94f3-6e88-3f72-9b19-6fde6d53120c",
                                                "text": "Владимир расположен на левом берегу реки́ Клязьмы в 190 км к северо-востоку от Москвы."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Владимир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "10e8bb8a-3b82-3f5a-a8e8-6cee23119d3b",
                                        "entry_id": "831da29a-7a7d-37ee-8d0f-b3575a35403c",
                                        "glosses": [
                                            "истор. разг. орден Святого Владимира"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d64cdedc-9e2e-4d32-b1bd-dcddcc748d18",
                                                "sense_id": "10e8bb8a-3b82-3f5a-a8e8-6cee23119d3b",
                                                "text": "Под Красным французская сабля мне хотя прорезала на груди петлицу, да по крайней мере я вдел в нее Владимира с бантом, а эта упрямица отбоярилась от меня одним чугунным поцелуем."
                                            },
                                            {
                                                "example_id": "793491c2-c3b0-4271-8841-ef037fc827d4",
                                                "sense_id": "10e8bb8a-3b82-3f5a-a8e8-6cee23119d3b",
                                                "text": "И молод, и пригож (тут, разумеется, я усмехаюсь и охорашиваюсь), и в чинах, и в почестях: благодаря бога, уж надворный советник, имеешь Владимира в петличке…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
