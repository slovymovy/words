        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8f923b63-3e9d-37de-9f65-1977721d678b",
                    "sense_definition": "Bearing a stamped, impressed, or firmly fixed mark or pattern.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ran her fingers across the <w>imprinted</w> letters on the book cover.",
                            "target_lang_translations": {
                                "ru": "Она провела пальцами по <w>тиснёным</w> буквам на обложке книги."
                            }
                        },
                        {
                            "text": "The <w>imprinted</w> design was clear and sharp against the smooth fabric.",
                            "target_lang_translations": {
                                "ru": "<w>Отпечатанный</w> узор выглядел чётким и резким на гладкой ткани."
                            }
                        }
                    ],
                    "synonyms": [
                        "embossed",
                        "stamped",
                        "impressed"
                    ],
                    "common_phrases": [
                        "imprinted design",
                        "imprinted pattern"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий оттиск, выбитый знак, рисунок или прочно зафиксированный след"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпечатанный",
                                "target_lang_sense_clarification": "нанесенный печатью или тиснением"
                            },
                            {
                                "target_lang_word": "выбитый",
                                "target_lang_sense_clarification": "тисненый, рельефный"
                            },
                            {
                                "target_lang_word": "тиснёный",
                                "target_lang_sense_clarification": "с тиснением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7cb1cd6-c07a-323a-933f-634225553e0c",
                    "sense_definition": "Characterized by biological or genetic imprinting, expressing traits determined by parental origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers discovered an <w>imprinted</w> gene that affects embryonic growth.",
                            "target_lang_translations": {
                                "ru": "Исследователи обнаружили <w>импринтированный</w> ген, влияющий на развитие эмбриона."
                            }
                        },
                        {
                            "text": "The study analyzed how <w>imprinted</w> alleles are expressed in different tissues.",
                            "target_lang_translations": {
                                "ru": "В исследовании анализировалось, как <w>импринтированные</w> аллели экспрессируются в различных тканях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "imprinted gene",
                        "imprinted allele"
                    ],
                    "target_lang_definitions": {
                        "ru": "подвергшийся биологическому или генетическому импринтингу; экспрессирующий признаки в зависимости от родительского происхождения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "импринтированный",
                                "target_lang_sense_clarification": "в генетике"
                            }
                        ]
                    }
                }
            ]
        }
    ]
