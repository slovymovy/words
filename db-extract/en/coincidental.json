                        "entry_id": "e414517c-6e0b-351b-9d97-5dcc4ef0bfbd",
                        "glosses": [
                            "Happening or existing at the same time."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d880959-a2bd-4130-b2d7-ee95d70f1ce9",
                        "source_entry_id": "e414517c-6e0b-351b-9d97-5dcc4ef0bfbd",
                        "source_sense_description": "occurring as or resulting from coincidence",
                        "target_lang_word": "toevallig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toevallig",
