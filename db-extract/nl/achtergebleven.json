                        "examples": [
                            {
                                "example_id": "0dcc4f8a-b69c-40ff-ac38-dacb457fd0c5",
                                "sense_id": "5388c0aa-3e03-3900-8a21-662137eb86ff",
                                "text": "Teresa stond moeizaam op, Olive duwde de mannen opzij om haar arm beet te pakken. Deze keer hielden ze haar niet tegen. Teresa liet zich tegen Olive aan vallen, en de meisjes liepen wankelend het plein af, tussen de achtergebleven dorpelingen door, die ruim baan maakten voor dit kokhalzende, kale schepsel van wie de darmen het elk moment konden begeven, dankzij de inhoud van een hele fles wonderolie."
                            }
                        ]
                    }
