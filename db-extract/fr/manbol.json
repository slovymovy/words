                        "glosses": [
                            "Sport pratiqué sur un terrain rappelant le volley, et qui utilise deux ballons, d’une forme rappelant un ballon de rugby mais plus petit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b72d084-9bc8-44fc-b4b1-cde30d0a67a5",
                                "sense_id": "685ce300-6f8a-3c45-aa17-b237ed483d8d",
                                "text": "Elle a fait son chemin jusqu’à la célèbre plage de Copacabana, à Rio de Janeiro (Brésil) : le manbol, une discipline insolite qui consiste à jeter et rattraper des mangues avec un coéquipier."
                            },
                            {
                                "example_id": "2f0c0c00-ac24-435b-ab48-49b3d473293b",
                                "sense_id": "685ce300-6f8a-3c45-aa17-b237ed483d8d",
                                "text": "Qu’est-ce que le « manbol », ce lancer de mangue brésilien qui rêve de devenir un sport olympique ?"
                            },
                            {
                                "example_id": "51bb674d-c40e-450e-8936-c9ec44b06409",
                                "sense_id": "685ce300-6f8a-3c45-aa17-b237ed483d8d",
                                "text": "C’est d’un ennui fraternel qu’est né le « manbol »."
                            }
                        ]
