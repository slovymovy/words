            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30422ad5-482b-3da2-8ba5-60da898add72",
                    "sense_definition": "The act or process of determining the size, quantity, or degree of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Accurate <w>measurement</w> is crucial for building a safe bridge.",
                            "target_lang_translations": {
                                "ru": "Точное <w>измерение</w> имеет решающее значение для строительства безопасного моста.",
                                "zh": "精确的<w>测量</w>对于建造安全的桥梁至关重要。",
                                "es": "Una <w>medición</w> precisa es crucial para construir un puente seguro."
                            }
                        },
                        {
                            "text": "The system allows for the precise <w>measurement</w> of temperature changes.",
                            "target_lang_translations": {
                                "ru": "Система позволяет проводить точное <w>измерение</w> изменений температуры.",
                                "zh": "该系统可以精确<w>测量</w>温度的变化。",
                                "es": "El sistema permite la <w>medición</w> precisa de los cambios de temperatura."
                            }
                        }
                    ],
                    "synonyms": [
                        "measuring",
                        "mensuration",
                        "calculation",
                        "assessment"
                    ],
                    "common_phrases": [
                        "unit of measurement",
                        "take a measurement",
                        "accurate measurement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс определения размера, количества или степени чего-либо",
                        "zh": "测定某物的大小、数量或程度的行为或过程。",
                        "es": "El acto o proceso de determinar el tamaño, la cantidad o el grado de algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "измерение",
                                "target_lang_sense_clarification": "процесс"
                            },
