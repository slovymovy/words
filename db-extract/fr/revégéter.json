                "senses": [
                    {
                        "sense_id": "faf2fbab-69ef-3191-91d1-05b8b7cc3a5b",
                        "entry_id": "3782cc43-638f-3bb8-9aed-d2f8f1b93dee",
                        "glosses": [
                            "Végéter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb2c1fc8-945a-4374-91bc-4a97936439ad",
                                "sense_id": "faf2fbab-69ef-3191-91d1-05b8b7cc3a5b",
                                "text": "Bientôt je n’aurai plus de corps.\nDon Camille. — Mais votre religion dit que vous conservez avec vous tout ce qu’il faut pour le revégéter."
                            },
                            {
                                "example_id": "9648647b-2c17-414a-92c2-d5e48d82aeed",
                                "sense_id": "faf2fbab-69ef-3191-91d1-05b8b7cc3a5b",
                                "text": "Au fond de l’humiliation, sur les champs de Virginie, il restait à l’esclave de quoi, si l’on peut dire, revégéter son être et son histoire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9fff80e-61f8-4019-982c-c18a44aefb80",
                        "source_entry_id": "3782cc43-638f-3bb8-9aed-d2f8f1b93dee",
                        "source_sense_id": "faf2fbab-69ef-3191-91d1-05b8b7cc3a5b",
