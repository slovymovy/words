                ],
                "senses": [
                    {
                        "sense_id": "9b9eba95-49d6-3e3b-a809-9460d3f78c26",
                        "entry_id": "35a57676-2e76-33f0-b027-db735f5262c6",
                        "glosses": [
                            "gesetzlich oder tariflich festgelegter Urlaub für Arbeitnehmer und Beamte (in Deutschland mindestens 24 Tage)"
                        ],
                        "tags": [
                            "Arbeitsrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "e7f5a2f5-586e-4c42-adcd-2262bc9c7d8d",
                                "sense_id": "9b9eba95-49d6-3e3b-a809-9460d3f78c26",
                                "text": "Unsere Beschäftigten beantragen Erholungsurlaub online."
                            },
                            {
                                "example_id": "0aa3cd92-5651-47e3-8809-2b79ffd006f9",
                                "sense_id": "9b9eba95-49d6-3e3b-a809-9460d3f78c26",
                                "text": "Der Vorgesetzte muss den beantragten Erholungsurlaub genehmigen, wenn keine betrieblichen Erfordernisse entgegenstehen."
                            },
                            {
                                "example_id": "066d30ce-337f-442a-a7e6-bf1d75dee9b5",
                                "sense_id": "9b9eba95-49d6-3e3b-a809-9460d3f78c26",
                                "text": "Jeder Arbeitnehmer muss einmal jährlich zehn zusammenhängende Tage Erholungsurlaub nehmen."
                            },
                            {
                                "example_id": "56eaa6e0-3f9d-4a9a-a163-7e986378441b",
                                "sense_id": "9b9eba95-49d6-3e3b-a809-9460d3f78c26",
                                "text": "Der Erholungsurlaub des laufenden Jahres muss bis zum 31.3. des Folgejahres genommen worden sein."
                            },
                            {
                                "example_id": "dbddb449-16dc-45ff-b892-a302db6c6a5e",
                                "sense_id": "9b9eba95-49d6-3e3b-a809-9460d3f78c26",
                                "text": "„Nach § 1 BUrlG hat jeder Arbeitnehmer sowie die zu ihrer Berufsausbildung Beschäftigten in jedem Kalenderjahr Anspruch auf bezahlten Erholungsurlaub.“"
                            },
                            {
                                "example_id": "0be304bb-fe2c-4ac5-b5ca-8ea05fe53a2c",
                                "sense_id": "9b9eba95-49d6-3e3b-a809-9460d3f78c26",
                                "text": "„Weiterhin muss berücksichtigt werden, dass manche Arbeitnehmer durch Krankheit und Sonderurlaub über den eigentlichen Erholungsurlaub hinaus fehlen, während andere nicht alle Urlaubstage nutzen.“"
                            },
                            {
                                "example_id": "1929d6c7-06f2-4577-91ad-dcc4e498ea1c",
                                "sense_id": "9b9eba95-49d6-3e3b-a809-9460d3f78c26",
                                "text": "„In der Erholungsurlaubsverordnung für das Land Schleswig-Holstein gibt es keine Regelung über die Urlaubsgewährung bei Versetzung eines Beamten. Der Beamte hat jedoch je Kalenderjahr Anspruch auf Erholungsurlaub. Diesen Erholungsurlaub kann er bei dem alten oder neuen Dienstherrn beantragen. Es obliegt also den beiden Dienstherren, eine Regelung zu finden.“"
                            },
                            {
                                "example_id": "cee86a3e-8989-4370-a03a-efdca13ea2f4",
                                "sense_id": "9b9eba95-49d6-3e3b-a809-9460d3f78c26",
                                "text": "[§13 AVR Abs. (2):] „Der Erholungsurlaub dient der Erhaltung der Gesundheit. Der Mitarbeiter ist deshalb verpflichtet, den Erholungsurlaub tatsächlich zu nehmen und darf während des Erholungsurlaubs keine dem Urlaubszweck widersprechende Erwerbsarbeit leisten.“"
                            },
                            {
                                "example_id": "bdac6089-5a91-4621-954c-fe0ffb93544e",
                                "sense_id": "9b9eba95-49d6-3e3b-a809-9460d3f78c26",
                                "text": "„Während ihres 3-wöchigen Erholungsurlaubs erkrankt Frau Henkel an einer fiebrigen Grippe. Welche Aussage nach dem Bundesurlaubsgesetz trifft zu?“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5a10a4fa-86a6-370d-bc87-c0f8b6e849a4",
                        "entry_id": "35a57676-2e76-33f0-b027-db735f5262c6",
                        "glosses": [
                            "freie Zeit (= Urlaub), die der Regeneration oder Rekonvaleszenz dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045b4161-d5b7-40d9-844c-04db45cc1587",
                                "sense_id": "5a10a4fa-86a6-370d-bc87-c0f8b6e849a4",
                                "text": "„Baden in Ziegenmilch, Schlummern in Fango und ab und zu eine Akupunktur-Behandlung – wer träumt nicht vom Erholungsurlaub im Kurhotel.“"
                            },
                            {
                                "example_id": "17a7c292-908c-49e5-927f-882e997f2982",
                                "sense_id": "5a10a4fa-86a6-370d-bc87-c0f8b6e849a4",
                                "text": "[1. Weltkrieg:] „Generalstabschef Moltke weilt zur Kur in Karlsbad, auch sein Stellvertreter wird in die Ferien geschickt, Kriegsminister Falkenhayn macht ebenso Erholungsurlaub wie Reichskanzler Bethmann Hollweg.“"
                            },
                            {
                                "example_id": "43a13d04-9b0e-449c-90d3-ab413c3eef04",
                                "sense_id": "5a10a4fa-86a6-370d-bc87-c0f8b6e849a4",
                                "text": "[Buchbesprechung:] „Hauptprotagonist ist der 24-jährige deutsche Wehrmacht-Soldat Veit Kolbe, der, schwer verwundet durch Granatsplitter an der Front, zum Erholungsurlaub an den Mondsee im Salzburger Land geschickt wird.“"
                            },
                            {
                                "example_id": "47a27994-88d9-4432-a127-b175f4f6ceb6",
                                "sense_id": "5a10a4fa-86a6-370d-bc87-c0f8b6e849a4",
                                "text": "„Anfang des vorigen Jahrhunderts waren es vor allem Künstler, die das Tal für sich als unberührten Ort entdeckten. Um hier den Erholungsurlaub zu verbringen, zu studieren oder schöpferisch tätig zu sein.“"
                            },
                            {
                                "example_id": "c5cc11d7-707f-4662-a181-eaf052f5b2c0",
                                "sense_id": "5a10a4fa-86a6-370d-bc87-c0f8b6e849a4",
                                "text": "[Atomkatastrophe am 26.4.1986 in Tschernobyl:] „Mehr als 600.000 Kinder und Jugendliche aus den verstrahlten Gebieten haben inzwischen Erholungsurlaub im Ausland gemacht oder sind dort medizinisch behandelt worden. Mindestens ein Drittel von ihnen in Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
