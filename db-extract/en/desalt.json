                        "cross_references": [
                            {
                                "target_word": "dessaler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81ff0836-bd9a-39f7-95ef-7d5148d0c2a4",
                                        "entry_id": "95b2d39a-1e56-3f47-bf01-f21935cc391a",
                                        "glosses": [
                                            "Faire qu’une chose ne soit plus aussi salée qu’elle l’était, ou qu’elle ne le soit plus du tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ae9ecd-1582-487e-abce-3bfbf9b63519",
                                                "sense_id": "81ff0836-bd9a-39f7-95ef-7d5148d0c2a4",
                                                "text": "Lorsqu'on entreprend le dessalement d'une terre, il faut dessaler cette terre à fond; donner aux fossés la distance, la longueur et la pente convenables suivant la nature des terres à traiter, et enfin proportionner la surface à dessaler avec la quantité d'eau dont on peut disposer."
                                            },
                                            {
                                                "example_id": "1b3f482d-a636-4c9d-a418-f9f96fe7e74e",
                                                "sense_id": "81ff0836-bd9a-39f7-95ef-7d5148d0c2a4",
                                                "text": "Dessaler de la morue, des harengs. — Mettre du jambon à dessaler."
                                            },
                                            {
                                                "example_id": "50e537ef-bd50-4e97-926d-7573f9d8b15d",
                                                "sense_id": "81ff0836-bd9a-39f7-95ef-7d5148d0c2a4",
                                                "text": "Dessaler une sauce trop salée.— On dessale l’eau de mer en la distillant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f01c71b3-3b54-3e4f-bc4d-fac43574fcfa",
                                        "entry_id": "95b2d39a-1e56-3f47-bf01-f21935cc391a",
                                        "glosses": [
                                            "Faire perdre la naïveté à quelqu’un, dégourdir, affranchir."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d3e31cd-ff62-479c-8441-691bf3725496",
                                                "sense_id": "f01c71b3-3b54-3e4f-bc4d-fac43574fcfa",
                                                "text": "Population dégourdie, « dessalée » et qui, au point de vue des mœurs, diffère très peu des autres agglomérations ouvrières françaises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae1cc34-ac52-3593-a9d1-96412a97e97a",
                                        "entry_id": "95b2d39a-1e56-3f47-bf01-f21935cc391a",
                                        "glosses": [
                                            "En voile, chavirer avec un dériveur ou un catamaran du fait d'une gîte trop importante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b00306f-4220-4e1a-add9-5002aa773064",
                                                "sense_id": "1ae1cc34-ac52-3593-a9d1-96412a97e97a",
                                                "text": "Il venait de me faire essayer son nouveau voilier, nous avions dessalé sous la Dent-du-Chat et il fallait que je convoque le vendeur pour qu'il constate sur-le-champ le vice de fabrication dans le safran."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
