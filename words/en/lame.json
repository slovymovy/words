{
    "word_family": [
        "lamely",
        "lameness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1009265e-8852-3fae-878a-de9ebc793d9c",
                    "sense_definition": "Unconvincing, weak, or difficult to believe.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "metaphorical_weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a really <w>lame</w> excuse for missing the birthday party.",
                            "target_lang_translations": {
                                "ru": "Он придумал действительно <w>неубедительную</w> отговорку, чтобы пропустить вечеринку в честь дня рождения.",
                                "zh": "他为缺席生日派对找了个非常<w>蹩脚</w>的借口。"
                            }
                        },
                        {
                            "text": "The plot of the movie was <w>lame</w> and full of holes.",
                            "target_lang_translations": {
                                "ru": "Сюжет фильма был <w>слабым</w> и полным дыр.",
                                "zh": "这部电影的情节很<w>薄弱</w>，而且漏洞百出。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weak"
                    ],
                    "antonyms": [
                        "convincing",
                        "believable"
                    ],
                    "common_phrases": [
                        "lame excuse",
                        "lame attempt",
                        "lame argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неубедительный, слабый или вызывающий сомнения (об оправданиях, аргументах).",
                        "zh": "不令人信服的；很弱的；让人觉得站不住脚的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неубедительный",
                                "target_lang_sense_clarification": "вызывающий сомнения"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "недостаточно обоснованный"
                            },
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "очень плохой, неудачный (об оправдании)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蹩脚",
                                "target_lang_sense_clarification": "指借口、论点等站不住脚，难以令人信服"
                            },
                            {
                                "target_lang_word": "薄弱",
                                "target_lang_sense_clarification": "指内容、论证等很弱，不扎实"
                            },
                            {
                                "target_lang_word": "很烂",
                                "target_lang_sense_clarification": "口语，指很差、很烂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "577ce378-2ca2-3f59-8687-d2c936ea2776",
                    "sense_definition": "Uncool, uninteresting, or unfunny.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "slang_uncool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept telling these extremely <w>lame</w> jokes all night.",
                            "target_lang_translations": {
                                "ru": "Он весь вечер рассказывал эти ужасно <w>тупые</w> шутки.",
                                "zh": "他整晚都在讲这些特别<w>冷</w>的笑话。"
                            }
                        },
                        {
                            "text": "It would be <w>lame</w> to stay home when everyone else is going out.",
                            "target_lang_translations": {
                                "ru": "Было бы <w>отстойно</w> остаться дома, когда все остальные идут гулять.",
                                "zh": "大家都出去玩的时候，你还待在家里就太<w>逊</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lame joke",
                        "so lame"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe things that are boring or socially awkward"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скучный, неинтересный, немодный или несмешной (сленг).",
                        "zh": "（俚语）无聊的、没意思的、不酷的或不好笑的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстойный",
                                "target_lang_sense_clarification": "сленг: плохой, скучный"
                            },
                            {
                                "target_lang_word": "беспонтовый",
                                "target_lang_sense_clarification": "сленг: некрутой, бесполезный"
                            },
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "глупый, несмешной (о шутках)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逊",
                                "target_lang_sense_clarification": "口语，指不酷、很土、很没劲"
                            },
                            {
                                "target_lang_word": "很烂",
                                "target_lang_sense_clarification": "口语，指很无聊、很差劲"
                            },
                            {
                                "target_lang_word": "冷",
                                "target_lang_sense_clarification": "用于笑话时，指不好笑、尴尬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4481bc55-f54e-3772-bfa8-4f202099f757",
                    "sense_definition": "Unable to walk properly because of a problem with one's feet or legs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_disability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse went <w>lame</w> after running on the rocky ground.",
                            "target_lang_translations": {
                                "ru": "Лошадь <w>охромела</w> после бега по каменистой земле.",
                                "zh": "那匹马在石地上跑过之后就<w>瘸</w>了。"
                            }
                        },
                        {
                            "text": "He walks with a <w>lame</w> leg due to an injury from his childhood.",
                            "target_lang_translations": {
                                "ru": "Он ходит с <w>хромой</w> ногой из-за травмы, полученной в детстве.",
                                "zh": "由于童年时受过伤，他走路时一条腿是<w>瘸</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crippled",
                        "gammy",
                        "limping",
                        "injured"
                    ],
                    "common_phrases": [
                        "go lame",
                        "lame duck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспособный нормально ходить из-за повреждения ноги или ступни.",
                        "zh": "由于脚或腿有问题而无法正常行走的；瘸的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хромой",
                                "target_lang_sense_clarification": "имеющий физический недостаток ноги"
                            },
                            {
                                "target_lang_word": "увечный",
                                "target_lang_sense_clarification": "искалеченный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瘸的",
                                "target_lang_sense_clarification": "因腿脚有问题而走路不正常"
                            },
                            {
                                "target_lang_word": "跛的",
                                "target_lang_sense_clarification": "强调一瘸一拐地走"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97edc334-98e5-3f99-958f-cd03ab7e1971",
                    "sense_definition": "To cause a person or animal to become unable to walk properly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_disability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sharp stone in the hoof can <w>lame</w> a horse very quickly.",
                            "target_lang_translations": {
                                "ru": "Острый камень в копыте может очень быстро <w>искалечить</w> лошадь.",
                                "zh": "蹄子里卡一块尖石头，很快就能把马弄<w>瘸</w>。"
                            }
                        },
                        {
                            "text": "The accident <w>lamed</w> him permanently, making it hard to travel.",
                            "target_lang_translations": {
                                "ru": "Авария <w>искалечила</w> его навсегда, затруднив возможность путешествовать.",
                                "zh": "那场事故使他永久<w>致残</w>，出行变得很困难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cripple",
                        "disable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-либо хромым; лишить возможности нормально ходить.",
                        "zh": "使人或动物变得不能正常行走；使其瘸掉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "калечить",
                                "target_lang_sense_clarification": "наносить увечье"
                            },
                            {
                                "target_lang_word": "увечить",
                                "target_lang_sense_clarification": "наносить физический вред"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄瘸",
                                "target_lang_sense_clarification": "使人或动物变瘸，不能正常行走"
                            },
                            {
                                "target_lang_word": "致残",
                                "target_lang_sense_clarification": "较正式，指造成身体残疾"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "edbdb559-54a5-3dbf-82b8-ccfd4573e33d",
                    "sense_definition": "A stupid, uncool, or undesirable person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_uncool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't worry about what those <w>lames</w> think about your new style.",
                            "target_lang_translations": {
                                "ru": "Не беспокойся о том, что эти <w>лохи</w> думают о твоем новом стиле.",
                                "zh": "别在意那些<w>怂包</w>怎么看你的新风格。"
                            }
                        },
                        {
                            "text": "He is such a <w>lame</w> for not coming to the party with us.",
                            "target_lang_translations": {
                                "ru": "Он такой <w>зануда</w>, что не пошел с нами на вечеринку.",
                                "zh": "他不跟我们一起去参加派对，真是个<w>扫兴的人</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый, скучный или социально неадаптированный человек (сленг).",
                        "zh": "（俚语，贬义）愚蠢、很土、不中用或不招人喜欢的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лох",
                                "target_lang_sense_clarification": "сленг: неудачник, простак"
                            },
                            {
                                "target_lang_word": "зануда",
                                "target_lang_sense_clarification": "скучный человек"
                            },
                            {
                                "target_lang_word": "отстой",
                                "target_lang_sense_clarification": "сленг: неприятный или скучный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怂包",
                                "target_lang_sense_clarification": "俚语，指没劲、不中用、让人看不起的人"
                            },
                            {
                                "target_lang_word": "扫兴的人",
                                "target_lang_sense_clarification": "指让人觉得无聊或破坏气氛的人"
                            },
                            {
                                "target_lang_word": "逊咖",
                                "target_lang_sense_clarification": "口语，指又土又无趣的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d03b0b53-e17b-39f1-aa83-199c9f3b3ca4",
                    "sense_definition": "A thin layer or plate of material, especially one of the overlapping metal plates in armor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_plate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith repaired the broken <w>lame</w> on the knight's shoulder armor.",
                            "target_lang_translations": {
                                "ru": "Кузнец починил сломанную <w>пластину</w> на наплечнике рыцаря.",
                                "zh": "铁匠修好了骑士肩甲上那片破损的<w>甲片</w>。"
                            }
                        },
                        {
                            "text": "Each <w>lame</w> must slide over the other to allow the arm to move freely.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>пластина</w> должна скользить по другой, чтобы рука могла свободно двигаться.",
                                "zh": "每一片<w>甲片</w>都必须能互相滑动，这样手臂才能自由活动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lamella",
                        "lamina"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical context regarding armor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая металлическая пластина, являющаяся частью составного доспеха.",
                        "zh": "薄片；尤指盔甲上相互覆盖的一片金属甲片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пластина",
                                "target_lang_sense_clarification": "часть доспеха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甲片",
                                "target_lang_sense_clarification": "指盔甲上彼此重叠的薄金属片"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e36b2d0-0390-3613-ade3-1de30c67f776",
                    "sense_definition": "A kitchen tool with a blade used for scoring bread dough before baking.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker used a sharp <w>lame</w> to create a beautiful pattern on the loaf.",
                            "target_lang_translations": {
                                "ru": "Пекарь использовал острое <w>лезвие</w>, чтобы создать красивый узор на буханке.",
                                "zh": "面包师用锋利的<w>割包刀</w>在面包上划出了漂亮的花纹。"
                            }
                        },
                        {
                            "text": "You must hold the <w>lame</w> at a slight angle to get a good ear on the baguette.",
                            "target_lang_translations": {
                                "ru": "Нужно держать <w>лезвие</w> под небольшим углом, чтобы на багете получился хороший гребень.",
                                "zh": "你必须把<w>割包刀</w>稍微倾斜着拿，法棍才能割出漂亮的裂口。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "specialized baking terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальный нож или лезвие для нанесения надрезов на тесто перед выпечкой.",
                        "zh": "一种带刀片的厨房工具，用于烘烤前在面团表面划口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лезвие",
                                "target_lang_sense_clarification": "для надрезания хлеба"
                            },
                            {
                                "target_lang_word": "пекарский нож",
                                "target_lang_sense_clarification": "инструмент пекаря"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "割包刀",
                                "target_lang_sense_clarification": "烘焙用语，指给面团割口的小刀"
                            },
                            {
                                "target_lang_word": "面包割刀",
                                "target_lang_sense_clarification": "较直白的说明性说法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}