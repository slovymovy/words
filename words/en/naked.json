    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "de718050-7748-3773-b068-cca3070f1dd4",
                    "sense_definition": "Not wearing any clothes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_nudity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby ran around the house <naked> before bath time.",
                            "target_lang_translations": {
                                "ru": "Малыш бегал по дому <голым> перед купанием.",
                                "zh": "洗澡前，那个婴儿在屋子里<w>光着</w>身子跑来跑去。"
                            }
                        },
                        {
                            "text": "He was completely <naked> when the doctor examined him.",
                            "target_lang_translations": {
                                "ru": "Он был полностью <обнажён>, когда врач осматривал его.",
                                "zh": "医生检查时，他全身<w>赤裸</w>。"
                            }
