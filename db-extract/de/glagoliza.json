                "senses": [
                    {
                        "sense_id": "db1e64cf-4bee-3313-83a1-d3661c180e29",
                        "entry_id": "65579424-7c20-34e6-977e-48e9213ea1cf",
                        "glosses": [
                            "älteste Schrift für die slawischen Sprachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f2c4d7f-77ad-4006-8720-77525bf17476",
                                "sense_id": "db1e64cf-4bee-3313-83a1-d3661c180e29",
                                "text": "„Von Ohrid aus verkünden die Mönche Kyrillos und Methodios das Evangelium. Sie entwickelten die Glagoliza, den Vorläufer des kyrillischen Alphabets.“"
                            },
                            {
                                "example_id": "d6f26868-ca3f-49d6-84df-3f40bbb506fd",
                                "sense_id": "db1e64cf-4bee-3313-83a1-d3661c180e29",
                                "text": "„Das älteste einigermaßen vollständig erhaltene Denkmal der kroatischen Sprache wurde auf der Insel Krk entdeckt. Es ist die sogenannte Tafel von Baška (Bašćanska ploča) aus der Zeit um 1100. Sie ist in der eigentümlichen Glagoliza abgefasst, eine Sprache, die sich mit keiner anderen in Europa oder Asien vergleichen lässt.“"
                            },
                            {
                                "example_id": "a980d343-0a90-4a7e-80e4-94fac39a4a49",
                                "sense_id": "db1e64cf-4bee-3313-83a1-d3661c180e29",
                                "text": "„Die ältere bulgarische oder runde Glagoliza wurde bereits ab dem 10. Jh. durch die einfachere Kyrilliza verdrängt, während sich die kroatische oder eckige Glagoliza bis in die Neuzeit erhalten hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7adc483d-1f1a-421b-a8e8-fc92dba8af10",
                        "source_entry_id": "65579424-7c20-34e6-977e-48e9213ea1cf",
                        "source_sense_id": "db1e64cf-4bee-3313-83a1-d3661c180e29",
                        "source_sense_description": "älteste Schrift für die slawischen Sprachen",
                        "target_lang_word": "Glagolitic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glagolitic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5f23df6-3033-3c5f-91c9-4071f2503d6a",
                                        "entry_id": "356318e0-f6c3-3b79-8662-66e011f927a5",
                                        "glosses": [
                                            "Of or written with the Glagolitic alphabet."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "029ad2f3-e8df-4538-8c52-9d15674f3a63",
                                                "sense_id": "d5f23df6-3033-3c5f-91c9-4071f2503d6a",
                                                "text": "The Slavic, and Illyric language has two alphabets. The first is called Glagolitic…, and in our times, is only used in the sacred books."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6421fdca-5a3a-3284-8f93-48905d927151",
                                        "entry_id": "356318e0-f6c3-3b79-8662-66e011f927a5",
                                        "glosses": [
                                            "Denoting Slavic Roman Catholic rites in Dalmatia."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10f628fb-6b53-4203-9e66-cac9db36b8f0",
                                                "sense_id": "6421fdca-5a3a-3284-8f93-48905d927151",
                                                "text": "In the case of mixed marriages between a Glagolitic and Latin Catholic, the children follow the rite of the father; but there is an exception in favour of the eldest daughter of a Glagolitic family."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Glagolitic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3511741-a54f-3401-adbd-e177475833f8",
                                        "entry_id": "cc6b5b43-ed7d-3440-a960-8612db1142a0",
                                        "glosses": [
                                            "The oldest known Slavonic alphabet, designed around 862–863 by Saint Cyril in order to translate the Bible and other texts into Old Church Slavonic. Mostly replaced by Cyrillic alphabet in Orthodox Christian Slavic countries, but still in use in the Croatian Church along the Dalmatian coast, in Czech and Croatian recensions of Church Slavic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
