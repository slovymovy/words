                "senses": [
                    {
                        "sense_id": "9cb71d9c-6868-3c28-a5c5-3b1b97a500a9",
                        "entry_id": "965670f8-d07b-31f8-ab99-c357035c1938",
                        "glosses": [
                            "German Democratic Republic"
                        ],
                        "tags": [
                            "historical",
                            "not-comparable",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "034624c5-554b-4c93-9336-267edb34b71e",
                                "sense_id": "9cb71d9c-6868-3c28-a5c5-3b1b97a500a9",
                                "text": "Dziennikarze nie dowierzają, pamiętając, że enerdowski wywiad interesował się co drugim deputowanym do Bundestagu z kadencji 1969–1972 za czasów kanclerza Brandta.",
                                "translation": "The journalists are distrustful, remembering that the GDR recon was interesting in every other deputy to Bundestag from the 1969-1972 term back when Brandt was chancellor.",
                                "english": "The journalists are distrustful, remembering that the GDR recon was interesting in every other deputy to Bundestag from the 1969-1972 term back when Brandt was chancellor."
                            },
                            {
                                "example_id": "d1505ab3-7488-42d4-9bcf-98993ef90611",
                                "sense_id": "9cb71d9c-6868-3c28-a5c5-3b1b97a500a9",
                                "text": "[...] Uwe Troemer, były wicemistrz świata w kolarstwie torowym, przypłacił niemalże życiem narzucone przez enerdowski reżim przymusowe użycie środków dopingujących.",
                                "translation": "… uwe Troemer, the ex-runnerup in the world in track cycling nearly paid with his life when the NDR regime forced him to take performance enchancing drugs.",
                                "english": "… uwe Troemer, the ex-runnerup in the world in track cycling nearly paid with his life when the NDR regime forced him to take performance enchancing drugs."
                            }
                        ]
                    }
                ],
