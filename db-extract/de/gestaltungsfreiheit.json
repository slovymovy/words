                "senses": [
                    {
                        "sense_id": "6d3e5a51-c37a-3cea-b537-3da8da92437f",
                        "entry_id": "a02afd49-3a83-3086-84bd-56f13bc08238",
                        "glosses": [
                            "Möglichkeit, Recht, etwas (zum Beispiel einen Raum, die Zeit oder sein eigenes Leben) zu gestalten, zu formen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5770db9f-91bc-4cd3-b680-2f8829085604",
                                "sense_id": "6d3e5a51-c37a-3cea-b537-3da8da92437f",
                                "text": "„Jeder Mensch im Geltungsbereich des Gesetzes ist frei in der Gestaltung von Verträgen, sofern diese Gestaltungsfreiheit nicht gegen geltendes Recht, gesetzliche Vorgaben oder die gute Sitte verstößt.“"
                            },
                            {
                                "example_id": "b0d9cf2b-e948-4f5e-9fa5-d433c138787d",
                                "sense_id": "6d3e5a51-c37a-3cea-b537-3da8da92437f",
                                "text": "„Diese Zuverlässigkeit, Sicherheit und Gestaltungsfreiheit garantierende Ordnung ermöglicht dem Kind darüber hinaus auch ein psychisches Wohlbefinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
