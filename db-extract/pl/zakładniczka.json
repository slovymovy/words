                "senses": [
                    {
                        "sense_id": "47c4feb5-d0db-3413-9e63-d23357de0c60",
                        "entry_id": "867ea720-f7e6-398f-babc-401645f2db0b",
                        "glosses": [
                            "kobieta przetrzymywana w celu wymuszenia jakiś korzyści"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a2e7af1-10ea-4062-aea9-b6174d8d81d0",
                                "sense_id": "47c4feb5-d0db-3413-9e63-d23357de0c60",
                                "text": "Porywacze mieli dwie zakładniczki i grozili, że je zabiją."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0301f4b6-5fcd-3887-9573-bae16e6ad355",
                        "entry_id": "867ea720-f7e6-398f-babc-401645f2db0b",
                        "glosses": [
                            "ktoś zmuszony do czegoś pewnymi okolicznościami"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "0c9d27d9-bbb6-40e8-9f71-75387702bf16",
                                "sense_id": "0301f4b6-5fcd-3887-9573-bae16e6ad355",
                                "text": "Dyrekcja stała się zakładniczką swoich uprzednich obietnic."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dffeb2ba-43b2-424f-911c-7d291c7db1ee",
                        "source_entry_id": "867ea720-f7e6-398f-babc-401645f2db0b",
                        "source_sense_id": "47c4feb5-d0db-3413-9e63-d23357de0c60",
                        "target_lang_word": "Geisel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geisel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73021c8d-7500-34aa-8762-cc5ee6fbf136",
                                        "entry_id": "6cc8d3f5-51a9-3160-95a1-395eb8eba032",
                                        "glosses": [
                                            "Person, die von Verbrechern zum Schutz (z. B. vor der Polizei) oder zur Forderung eines Lösegeldes festgehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600b7ccf-e4fd-4e17-9f16-ba88161f8131",
                                                "sense_id": "73021c8d-7500-34aa-8762-cc5ee6fbf136",
                                                "text": "Nicht schießen, ich habe eine Geisel in meiner Gewalt!"
                                            },
                                            {
                                                "example_id": "255795a3-34bf-4a79-aeef-46ba8125afaa",
                                                "sense_id": "73021c8d-7500-34aa-8762-cc5ee6fbf136",
                                                "text": "„Dort hatte die SS in den letzten Kriegstagen tschechische Geiseln erschossen, auch einen Cousin von Josef.“"
                                            },
                                            {
                                                "example_id": "5c15ad57-3a02-49d5-b022-d135599af53f",
                                                "sense_id": "73021c8d-7500-34aa-8762-cc5ee6fbf136",
                                                "text": "„Der Lokomotivführer wird sofort erschossen, und in den dreizehn Tagen, die das Geiseldrama dauert, sterben zwei weitere Geiseln und werden aus dem Zug geworfen.“"
                                            },
                                            {
                                                "example_id": "f1f75168-b099-45fe-a5f9-7b42b22ef8fb",
                                                "sense_id": "73021c8d-7500-34aa-8762-cc5ee6fbf136",
                                                "text": "„Toller will Racheakten zuvorkommen, eilt zum Gefängnis und sieht, wie die Geiseln erschossen dort liegen.“"
                                            },
                                            {
                                                "example_id": "6d55c54a-aff0-48a5-9b18-428ff74be20a",
                                                "sense_id": "73021c8d-7500-34aa-8762-cc5ee6fbf136",
                                                "text": "„Geiseln versteckte man möglichst nicht in den eigenen Burgen, sondern in denen verbündeter Ritter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "edb6d42d-cddc-30e2-8591-5617a76caf22",
                                        "entry_id": "6cc8d3f5-51a9-3160-95a1-395eb8eba032",
                                        "glosses": [
                                            "Person, die unter vergleichsweise guten Bedingungen festgehalten wurde; meist sollte damit von einer Gegenpartei durch ein menschliches Pfand sichergestellt werden, dass sie, der diese Person nahestand, ein Versprechen oder einen Vertrag einhalten würde"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bb8c9fa-bee0-4675-bf12-ae95c9ba491a",
                                                "sense_id": "edb6d42d-cddc-30e2-8591-5617a76caf22",
                                                "text": "Rom forderte von verbündeten Häuptlingen oft, Geiseln zu stellen, etwa einen Sohn oder einen Neffen."
                                            },
                                            {
                                                "example_id": "d179dfeb-1918-4e9a-beb7-4613904a9f78",
                                                "sense_id": "edb6d42d-cddc-30e2-8591-5617a76caf22",
                                                "text": "„… in gewissem Sinne bin ich ein Geisel der kommunistischen Kerkerdiktatur …“"
                                            },
                                            {
                                                "example_id": "c5b46efd-bd4b-48c2-b038-b80173abf546",
                                                "sense_id": "edb6d42d-cddc-30e2-8591-5617a76caf22",
                                                "text": "„Nach der Meinung des Buchautors, war er ein Geisel der Politik.“"
                                            },
                                            {
                                                "example_id": "173ceaad-e702-4d9d-905c-7495d01f6607",
                                                "sense_id": "edb6d42d-cddc-30e2-8591-5617a76caf22",
                                                "text": "„Bei früheren Vorkommnissen dieser Art hatte Cook einen Häuptling als Geisel nehmen lassen, durchaus eine harte Vergeltungsmaßnahme.“"
                                            },
                                            {
                                                "example_id": "b375de43-a217-46f8-abca-746e8967ccef",
                                                "sense_id": "edb6d42d-cddc-30e2-8591-5617a76caf22",
                                                "text": "„Muazzam, der sich als Großmogul Bahadur Shah nannte, versuchte, Frieden mit den Marathen zu schließen, indem er Shahu, den Enkel Shivajis, der als Geisel am Hofe Aurangzebs aufgewachsen war, als Raja von Satara einsetzte, doch damit gab er dem Widerstand der Marathen ein neues Zentrum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d630cee2-dd41-4d45-9186-776e006a52f6",
                        "source_entry_id": "867ea720-f7e6-398f-babc-401645f2db0b",
