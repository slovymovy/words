            {
                "entry_id": "b33d1dfe-35c8-3cad-8369-7c5bb6fd19ab",
                "word": "bibliomane",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "890e5543-3838-45a8-91a8-68f57f224fd6",
                        "entry_id": "b33d1dfe-35c8-3cad-8369-7c5bb6fd19ab",
                        "tags": [
                            "plural",
