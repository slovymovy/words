                        "examples": [
                            {
                                "example_id": "3f79e631-b68a-400a-b175-b430da6c001e",
                                "sense_id": "59c0e2bd-44b8-3d5c-9b37-f9f88ae9fd22",
                                "text": "„Die Serie der misslungenen Aktionen eröffnete Oliver Staab, indem er zweimal in Folge am Einzelblock scheiterte.“"
                            },
                            {
                                "example_id": "0d7f1844-781f-4e2c-b33b-6c953390db7a",
                                "sense_id": "59c0e2bd-44b8-3d5c-9b37-f9f88ae9fd22",
                                "text": "„Ein toller Einzelblock von Tim Hembrock zum 24:18 und ein Sprungaufgaben-Ass von Patrik Robert besiegelten das Schicksal des SC Halle.“"
                            },
                            {
                                "example_id": "f0021965-3254-46e5-8a91-8a5f42735810",
                                "sense_id": "59c0e2bd-44b8-3d5c-9b37-f9f88ae9fd22",
                                "text": "„Ein Einzelblock von Max Meuter beschert sogar das 1:7.“"
                            },
                            {
                                "example_id": "82be23d6-b8a3-4fbf-9ecd-82634970acea",
                                "sense_id": "59c0e2bd-44b8-3d5c-9b37-f9f88ae9fd22",
                                "text": "„Ein Einzelblock des gleichen Akteurs brachte noch einmal einen spektakulären Punkt zum 13:16, mehr aber auch nicht.“"
                            }
                        ],
