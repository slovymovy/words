                                            {
                                                "example_id": "e04dd34d-c6b1-47aa-b495-a5dbc4f71045",
                                                "sense_id": "257a19fc-d580-3f21-8051-a4475a0182af",
                                                "text": "Dostał jakąś książkę o historii sztuki i studiuje te różne izmy."
