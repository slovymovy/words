    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4e87348-7397-36fe-88e3-c7fe2004ada6",
                    "sense_definition": "De vastgestelde tijd waarin een deskundige, zoals een arts of advocaat, beschikbaar is om mensen te spreken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "consultatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dokter heeft elke ochtend van negen tot elf <w>spreekuur</w> voor zijn patiënten.",
                            "target_lang_translations": {
                                "en": "The doctor has <w>consultation hours</w> for his patients every morning from nine to eleven."
                            }
                        },
                        {
                            "text": "Als je hier morgen nog last van hebt, kun je beter op het <w>spreekuur</w> van je huisarts langsgaan.",
                            "target_lang_translations": {
                                "en": "If you are still bothered by this tomorrow, you should go to your GP's <w>surgery hours</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "consultatie-uur"
                    ],
                    "common_phrases": [
                        "het spreekuur van de huisarts",
                        "op spreekuur komen",
                        "dagelijks spreekuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The fixed time during which an expert, such as a doctor or lawyer, is available to speak with people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consultation hours",
                                "target_lang_sense_clarification": "medical or professional"
                            },
                            {
                                "target_lang_word": "surgery hours",
                                "target_lang_sense_clarification": "British English, specifically for doctors"
                            },
                            {
                                "target_lang_word": "office hours",
                                "target_lang_sense_clarification": "general professional availability"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e664915b-9f98-3894-a4d9-0e5585ff0030",
                    "sense_definition": "Een specifieke tijd waarop men zonder voorafgaande afspraak bij een instantie of hulpverlener naar binnen kan lopen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consultatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemeente organiseert elke donderdag een <w>spreekuur</w> voor bewoners met vragen over de nieuwe weg.",
                            "target_lang_translations": {
                                "en": "The municipality organizes <w>drop-in hours</w> every Thursday for residents with questions about the new road."
                            }
                        },
                        {
                            "text": "Tijdens het wekelijkse <w>spreekuur</w> kun je zonder afspraak bij de juridisch adviseur terecht.",
                            "target_lang_translations": {
                                "en": "During the weekly <w>office hours</w>, you can see the legal advisor without an appointment."
                            }
                        }
                    ],
                    "synonyms": [
                        "inloopspreekuur"
                    ],
                    "common_phrases": [
                        "open spreekuur",
                        "wekelijks spreekuur"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific time when one can walk in to see an agency or counselor without a prior appointment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drop-in hours",
                                "target_lang_sense_clarification": "without appointment"
                            },
                            {
                                "target_lang_word": "walk-in hours",
                                "target_lang_sense_clarification": "no appointment needed"
                            },
                            {
                                "target_lang_word": "office hours",
                                "target_lang_sense_clarification": "academic or professional availability"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}