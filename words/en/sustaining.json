            "senses": [
                {
                    "sense_id": "8187661f-b13e-3a7a-88df-9ab971509fa8",
                    "sense_definition": "The act or process by which something is maintained, upheld, or kept going.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The continuous <w>sustaining</w> of ancient customs requires active participation from younger generations.",
                            "target_lang_translations": {
                                "nl": "De voortdurende <w>instandhouding</w> van oude gebruiken vereist actieve deelname van jongere generaties."
                            }
                        },
                        {
                            "text": "Successful reforms depend on the steady <w>sustaining</w> of public enthusiasm over many months.",
                            "target_lang_translations": {
                                "nl": "Succesvolle hervormingen zijn afhankelijk van het gestaag <w>vasthouden</w> van het enthousiasme onder het publiek gedurende vele maanden."
                            }
