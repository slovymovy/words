                "senses": [
                    {
                        "sense_id": "6ceb1bbc-7d9b-3d02-8b6e-ad52ec5eadfb",
                        "entry_id": "d028f90d-bb43-308a-a8c7-54819b4dde68",
                        "glosses": [
                            "Identifier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e042b4cd-f990-47e6-9e1b-1d4252dcaae2",
                                "sense_id": "6ceb1bbc-7d9b-3d02-8b6e-ad52ec5eadfb",
                                "text": "Pour garantir l’impossibilité de ré-identifier la donnée, il est possible de procéder à un double hachage."
                            },
                            {
                                "example_id": "1a21ef62-bd57-4607-86bb-496b5aefd4d6",
                                "sense_id": "6ceb1bbc-7d9b-3d02-8b6e-ad52ec5eadfb",
                                "text": "Le nié ou le dénié ne peuvent se ré-humaniser, se ré-individualiser, se ré-identifier qu’en opposant aux négateurs leurs ressources mobilisables à cette fin."
                            }
                        ]
                    }
