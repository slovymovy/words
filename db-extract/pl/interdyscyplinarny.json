                "senses": [
                    {
                        "sense_id": "88614e41-a345-3ae3-aadc-28b443f0d270",
                        "entry_id": "7e27fba0-a353-3e75-b608-425d7392bbda",
                        "glosses": [
                            "dotyczący kilku dyscyplin naukowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cfaa41d-22e3-47c5-a1da-0daf1c6c3e56",
                                "sense_id": "88614e41-a345-3ae3-aadc-28b443f0d270",
                                "text": "Ekoturystyka jest zjawiskiem interdyscyplinarnym, dlatego publikacja, którą Szanowni Czytelnicy trzymają w swoich rękach, jest pozycją korzystającą z dorobku różnych dziedzin nauki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b1cbaa61-7701-3241-86b8-c6c78e35dee4",
                        "entry_id": "7e27fba0-a353-3e75-b608-425d7392bbda",
                        "glosses": [
                            "korzystający z dorobku różnych dziedzin nauki"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "432801c8-fa39-3bbd-8f12-1aac08d49fcc",
                        "entry_id": "7e27fba0-a353-3e75-b608-425d7392bbda",
                        "glosses": [
                            "składający z przedstawicieli różnych nauk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1428e28e-46a0-4869-8aba-8565a5b746f6",
                                "sense_id": "432801c8-fa39-3bbd-8f12-1aac08d49fcc",
                                "text": "Gmina podejmuje działania na rzecz przeciwdziałania przemocy w rodzinie w szczególności w ramach pracy w zespole interdyscyplinarnym powoływanym przez burmistrza"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9574187d-1cf5-4636-bbb2-06e4b8ce2f99",
                        "source_entry_id": "7e27fba0-a353-3e75-b608-425d7392bbda",
                        "source_sense_id": "88614e41-a345-3ae3-aadc-28b443f0d270",
                        "target_lang_word": "interdisciplinary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interdisciplinary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6da5075-46b5-3eb8-901d-055244b97e53",
                                        "entry_id": "6d3b0769-6f75-3189-a1c0-cdd5703cccee",
                                        "glosses": [
                                            "Of or pertaining to multiple distinct academic disciplines or fields of study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "188363cb-a32b-464e-ad75-18185b230d43",
                                                "sense_id": "a6da5075-46b5-3eb8-901d-055244b97e53",
                                                "text": "Near-synonyms: crossdisciplinary, multidisciplinary, pluridisciplinary, transdisciplinary"
                                            },
                                            {
                                                "example_id": "f1cc4449-42bc-4c1b-b04a-b1d4f775c00a",
                                                "sense_id": "a6da5075-46b5-3eb8-901d-055244b97e53",
                                                "text": "This journal is interdisciplinary: it has articles on everything from biology to electrical engineering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0267817-dd6c-3a26-802b-e2b3b96b1401",
                                        "entry_id": "6d3b0769-6f75-3189-a1c0-cdd5703cccee",
                                        "glosses": [
                                            "Of or pertaining to a linkage between multiple distinct academic disciplines or fields of study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17599fa7-49c2-4c40-b51a-c7b756da07df",
                                                "sense_id": "d0267817-dd6c-3a26-802b-e2b3b96b1401",
                                                "text": "The interdisciplinary co-operation at this university is very impressive."
                                            },
                                            {
                                                "example_id": "7d386389-081a-464a-bece-920cd1793671",
                                                "sense_id": "d0267817-dd6c-3a26-802b-e2b3b96b1401",
                                                "text": "This was a very generous way of describing the swarm of cables, kit-bashed thaumatic cores, Noogenic foci and para-technological inverters, all surrounded by an astoundingly complex cognitohazardous sigil and multiple ontological anchors. This, simultaneously, simplified the interdisciplinary effort that had swelled in a miniscule amount of time, and undercut the sheer conceptual impact this could leave in all of their respective fields."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2764701d-0892-43ac-a9fd-11bae9dc0dd5",
                        "source_entry_id": "7e27fba0-a353-3e75-b608-425d7392bbda",
                        "source_sense_id": "88614e41-a345-3ae3-aadc-28b443f0d270",
                        "target_lang_word": "interdisciplinaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interdisciplinaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29dbc81d-d4a0-3f65-af58-1d309a6ea79d",
                                        "entry_id": "ac722b7d-a5b1-3118-ab33-bc09e4efb60b",
                                        "glosses": [
                                            "Qui met en relation plusieurs disciplines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eedd23d-ffd4-4719-9afd-43cb7bc5bd93",
                                                "sense_id": "29dbc81d-d4a0-3f65-af58-1d309a6ea79d",
                                                "text": "De fait, il est peu de domaines plus interdisciplinaires que les études de genre. C’est ainsi que l’Institut Émilie du Châtelet, fondé en 2006 sous l’impulsion du Conseil régional d’Île-de-France pour développer ce champ en finançant des thèses, a pu associer des chercheuses (et aussi des chercheurs) de toutes ces disciplines, et bien d’autres encore, y compris du côté des sciences de la nature (biologie cellulaire, paléoanthropologie, neurobiologie…)."
                                            },
                                            {
                                                "example_id": "af4d5256-4e5c-4176-b025-c31dddd2a253",
                                                "sense_id": "29dbc81d-d4a0-3f65-af58-1d309a6ea79d",
                                                "text": "Il faudrait aussi une représentation interdisciplinaire avec des spécialistes du développement de l'enfant, des accidentologues, des ingénieurs, des urbanistes, des cliniciens, des sociologues et d'autres encore."
                                            },
                                            {
                                                "example_id": "30f91e0f-5a50-4c08-a6ef-97665d4d5f38",
                                                "sense_id": "29dbc81d-d4a0-3f65-af58-1d309a6ea79d",
                                                "text": "Les commentaires … distinguent des thèmes pouvant se prêter à des ouvertures interdisciplinaires, en concertation avec les professeurs d'autres disciplines scientifiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c314917f-a1d0-4ccf-bc46-8f823dd3a9c4",
                        "source_entry_id": "7e27fba0-a353-3e75-b608-425d7392bbda",
                        "source_sense_id": "88614e41-a345-3ae3-aadc-28b443f0d270",
                        "target_lang_word": "interdisciplinar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "eecf0904-cfbe-47da-b584-f1fbef79c53e",
                        "source_entry_id": "7e27fba0-a353-3e75-b608-425d7392bbda",
                        "source_sense_id": "88614e41-a345-3ae3-aadc-28b443f0d270",
                        "target_lang_word": "interdisciplinario",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6d21b8c4-4bd7-4233-b568-3e10b086f17b",
                        "source_entry_id": "7e27fba0-a353-3e75-b608-425d7392bbda",
                        "source_sense_id": "88614e41-a345-3ae3-aadc-28b443f0d270",
                        "target_lang_word": "interdisziplinär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interdisziplinär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                        "entry_id": "e0a23ff8-1971-39b3-91ba-92e8251d1c37",
                                        "glosses": [
                                            "über die Grenzen einer (Wissenschafts-)Disziplin hinaus; mehrere Disziplinen einbeziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "174fa7b2-a389-468e-a000-19fca218512a",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "Viele Probleme müssen interdisziplinär betrachtet werden, um sie lösen zu können."
                                            },
                                            {
                                                "example_id": "7dd4d932-b096-43ed-a3bb-c13a53f5f24d",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "„Es kommt somit nicht überraschend, daß es alternative Vorschläge für interdisziplinäre Aktivitäten gibt.“"
                                            },
                                            {
                                                "example_id": "ff0a61ba-941d-4ddf-bbcf-0be1a5a703c4",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "„Interdisziplinäres Lernen und fächerübergreifende Projekte dürften dazu fast besser geeignet sein als ein zusätzliches Schulfach.“"
                                            },
                                            {
                                                "example_id": "d19554fb-b95e-435f-bb1e-399ab0c38953",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "„Lange Zeit haben fächerübergreifende Projekte den Sportunterricht eher selten einbezogen[…]. Dieser Umstand ist angesichts der bereits Mitte der 1970er Jahre präsentierten Grundlegungen zu einer interdisziplinären Sporterziehung von Siegbert A. Warwitz (1974) und der praxisorientierten Arbeiten seiner Arbeitsgruppe […] kaum nachvollziehbar.“"
                                            },
                                            {
                                                "example_id": "ef6e817c-0c56-445a-b5a7-079c8cdd5ca3",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "„Der Ausdruck interdisziplinäre Kooperation bezeichnet das die engen Fachgrenzen überwindende konstruktive Interagieren mehrerer Fachexperten im Sinne einer größeren Ökonomie, Effektivität, Lebens- und Sachnähe bei der Bewältigung komplizierterer Aufgaben.“"
                                            },
                                            {
                                                "example_id": "071daa8b-ac14-4996-9f86-70ba5d42499a",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "„Fachübergreifende Themen wie Finanzkrise, Fachkräftemangel, Migration oder ethisches Handeln erfordern interdisziplinäre Kenntnisse, um umfassend erforscht werden zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fd50d99-c11b-40e5-a71d-04c66250a1c6",
                        "source_entry_id": "7e27fba0-a353-3e75-b608-425d7392bbda",
