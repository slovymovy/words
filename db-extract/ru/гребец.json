                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90bb5291-b706-493c-a2aa-164c42767239",
                                                "sense_id": "a7bdeeda-cfaa-33cd-8dfe-0f2905473f41",
                                                "text": "J’ai reçu hier de notre jeune ami Maupassant une épître fort agréable et pleine du détail de ses lubricités canotières avec une grosse femme."
                                            }
