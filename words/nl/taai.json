{
    "word_family": [
        "taaiheid",
        "taaigaard",
        "taaitaai",
        "vertaaie"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "435c4d4d-1b0d-34dd-9c2d-dc7390b35602",
                    "sense_definition": "Moeilijk te kauwen of te snijden (met name van voedsel zoals vlees).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vlees in dit restaurant was erg <w>taai</w> en moeilijk door te slikken.",
                            "target_lang_translations": {
                                "en": "The meat in this restaurant was very <w>tough</w> and hard to swallow."
                            }
                        },
                        {
                            "text": "Als je de biefstuk te lang bakt, wordt het vlees <w>taai</w>.",
                            "target_lang_translations": {
                                "en": "If you cook the steak for too long, the meat becomes <w>tough</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lederachtig",
                        "hard"
                    ],
                    "antonyms": [
                        "mals"
                    ],
                    "common_phrases": [
                        "taai vlees"
                    ],
                    "target_lang_definitions": {
                        "en": "Difficult to chew or cut (especially of food such as meat)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tough",
                                "target_lang_sense_clarification": "of food, difficult to chew or cut"
                            },
                            {
                                "target_lang_word": "chewy",
                                "target_lang_sense_clarification": "requiring a lot of chewing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9c7e3a8-5fc3-3511-bcd8-6b049f1af5fd",
                    "sense_definition": "Vasthoudend, volhardend en moeilijk te breken of te overwinnen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wielrenner toonde zich een <w>taaie</w> strijder tijdens de zware bergetappe.",
                            "target_lang_translations": {
                                "en": "The cyclist proved to be a <w>tough</w> competitor during the grueling mountain stage."
                            }
                        },
                        {
                            "text": "De soldaten stuitten op <w>taai</w> verzet van de lokale bevolking.",
                            "target_lang_translations": {
                                "en": "The soldiers met with <w>stubborn</w> resistance from the local population."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardnekkig",
                        "volhardend",
                        "vasthoudend",
                        "resistent"
                    ],
                    "common_phrases": [
                        "taai verzet",
                        "een taaie strijd"
                    ],
                    "target_lang_definitions": {
                        "en": "Persistent, tenacious, and difficult to break or overcome."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tough",
                                "target_lang_sense_clarification": "stubborn, persistent, or physically hardy"
                            },
                            {
                                "target_lang_word": "tenacious",
                                "target_lang_sense_clarification": "holding fast, persistent"
                            },
                            {
                                "target_lang_word": "hardy",
                                "target_lang_sense_clarification": "robust, capable of enduring difficult conditions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6f09dd0-edbc-37c1-8ff6-ca11338ba2dc",
                    "sense_definition": "Saai, langdradig en moeilijk door te dringen of te begrijpen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moeilijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het lezen van die oude wetsteksten is echt <w>taaie</w> kost.",
                            "target_lang_translations": {
                                "en": "Reading those old legal texts is really <w>heavy</w> going."
                            }
                        },
                        {
                            "text": "De leraar probeerde de <w>taaie</w> stof met leuke voorbeelden interessanter te maken.",
                            "target_lang_translations": {
                                "en": "The teacher tried to make the <w>dry</w> subject matter more interesting with fun examples."
                            }
                        }
                    ],
                    "synonyms": [
                        "droog",
                        "saai",
                        "ingewikkeld"
                    ],
                    "common_phrases": [
                        "taaie kost",
                        "taaie stof"
                    ],
                    "target_lang_definitions": {
                        "en": "Dull, dry, and difficult to get through or understand."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dry",
                                "target_lang_sense_clarification": "boring, dull, or matter-of-fact"
                            },
                            {
                                "target_lang_word": "heavy going",
                                "target_lang_sense_clarification": "difficult or tedious to read or understand"
                            },
                            {
                                "target_lang_word": "tough",
                                "target_lang_sense_clarification": "difficult or demanding to process"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed6788b5-7482-3906-b4ec-74c54f483440",
                    "sense_definition": "Moeizaam en plastisch vervormend onder mechanische belasting; niet makkelijk breekbaar maar buigzaam en rekbaar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gesmolten suiker vormde een steeds <w>taaiere</w> massa die moeilijk te roeren was.",
                            "target_lang_translations": {
                                "en": "The melted sugar formed an increasingly <w>viscous</w> mass that was difficult to stir."
                            }
                        },
                        {
                            "text": "Dit metaal is zeer <w>taai</w> en breekt niet snel onder hoge druk.",
                            "target_lang_translations": {
                                "en": "This metal is very <w>tough</w> and does not break easily under high pressure."
                            }
                        }
                    ],
                    "synonyms": [
                        "viskeus",
                        "rekbaar",
                        "elastisch"
                    ],
                    "antonyms": [
                        "mals"
                    ],
                    "common_phrases": [
                        "taaie massa"
                    ],
                    "target_lang_definitions": {
                        "en": "Deforming plastically under mechanical stress without breaking easily; flexible and stretchable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tough",
                                "target_lang_sense_clarification": "of a material, undergoing plastic deformation before breaking"
                            },
                            {
                                "target_lang_word": "viscous",
                                "target_lang_sense_clarification": "thick and sticky, semi-fluid"
                            },
                            {
                                "target_lang_word": "ductile",
                                "target_lang_sense_clarification": "able to be deformed without losing toughness"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}