                "senses": [
                    {
                        "sense_id": "1b9038cf-913a-3fa9-8f56-a7225cd48cc6",
                        "entry_id": "5f2adf7e-debc-34ea-bfa8-53740f036bb7",
                        "glosses": [
                            "Person, in die große Hoffnungen gesetzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60503bdd-71c0-4b4f-a6cc-2d6c217ded3f",
                                "sense_id": "1b9038cf-913a-3fa9-8f56-a7225cd48cc6",
                                "text": "Der neue Ministerpräsident gilt als Hoffnungsträger der Oppositionsparteien."
                            },
                            {
                                "example_id": "60f02651-e2a0-4a1f-b99f-dca4416545db",
                                "sense_id": "1b9038cf-913a-3fa9-8f56-a7225cd48cc6",
                                "text": "„Das hat allen Hoffnung gemacht und mich zu einem unfreiwilligen Hoffnungsträger.“"
                            },
                            {
                                "example_id": "4d3ccb00-40a6-4f0f-8add-295a16ceca67",
                                "sense_id": "1b9038cf-913a-3fa9-8f56-a7225cd48cc6",
                                "text": "„Aber nicht allein die Jugend der Städte betrachtet Imran Khan als neuen politischen Hoffnungsträger.“"
                            },
                            {
                                "example_id": "158d383d-eb40-4330-abff-a2c6ab2bfab5",
                                "sense_id": "1b9038cf-913a-3fa9-8f56-a7225cd48cc6",
                                "text": "„Der neue Optimismus steckte an, auch im Westen wurde der dämonisierte Terrorist zum Hoffnungsträger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
