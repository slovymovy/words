                                "target_senses": [
                                    {
                                        "sense_id": "187e1ef2-0b51-3f44-adf8-09e7d245446f",
                                        "entry_id": "c2f6a604-2390-3e24-871a-e39b4f32919e",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "389cb69b-8c81-4d38-a15b-f022c3ba1300",
                                                "sense_id": "187e1ef2-0b51-3f44-adf8-09e7d245446f",
                                                "text": "Frau Stettin ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "00049656-86eb-45d2-b584-91e962aa258b",
                                                "sense_id": "187e1ef2-0b51-3f44-adf8-09e7d245446f",
                                                "text": "Herr Stettin wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "578ae198-9936-4aa7-b1fc-b0709e3ba601",
                                                "sense_id": "187e1ef2-0b51-3f44-adf8-09e7d245446f",
                                                "text": "Die Stettins fahren heute nach Szczecin."
                                            },
                                            {
                                                "example_id": "c874371e-922b-4bc1-acb1-22b1e926891c",
                                                "sense_id": "187e1ef2-0b51-3f44-adf8-09e7d245446f",
                                                "text": "Der Stettin trägt nie die Pullover, die die Stettin ihm strickt."
                                            },
                                            {
                                                "example_id": "f0eb9c77-c8e3-490f-9e13-d4c4cdaff060",
                                                "sense_id": "187e1ef2-0b51-3f44-adf8-09e7d245446f",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stettin kommt, geht der Herr Stettin.“"
                                            },
                                            {
                                                "example_id": "b21e6108-0833-4b91-a4b0-0ca159f92aa7",
                                                "sense_id": "187e1ef2-0b51-3f44-adf8-09e7d245446f",
                                                "text": "Stettin kommt und geht."
                                            },
                                            {
                                                "example_id": "35f3bbcd-499c-4de2-b0e6-58cdd41d384c",
                                                "sense_id": "187e1ef2-0b51-3f44-adf8-09e7d245446f",
                                                "text": "Stettins kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0be24e47-9e80-4fa4-94a8-f91ada6e44c0",
                        "source_entry_id": "4e2be5cf-f3c3-39ca-b01b-d558431b682c",
                        "source_sense_id": "76a6b135-c7b3-3e33-ad80-de55b8890b77",
                        "target_lang_word": "Щецин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Щецин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6541d3ef-535b-32bb-a57c-737854397d3b",
                                        "entry_id": "4aa976ce-ed61-3a8e-b7ea-10c77b8fd1b9",
                                        "glosses": [
                                            "геогр. город на северо-западе Польши, центр Западно-Поморского воеводства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b886f839-4b05-44fb-8772-129d248726fe",
                                                "sense_id": "6541d3ef-535b-32bb-a57c-737854397d3b",
                                                "text": "В результате восстановления исторически определённых государственных границ Польша получила широкий доступ в морю. Непрерывно растёт значение Щецина, который в недалёком будущем станет крупнейшим портом Европы."
                                            },
                                            {
                                                "example_id": "b12ade1e-8609-4f4e-92de-ece85c4f8e37",
                                                "sense_id": "6541d3ef-535b-32bb-a57c-737854397d3b",
                                                "text": "Весной 1968 года, вскоре после тех тревожных мартовских событий в Народной Польше, .. я побывала в Варшаве и Щецине."
                                            },
                                            {
                                                "example_id": "30831501-0cd0-41de-8a9e-36707f3618df",
                                                "sense_id": "6541d3ef-535b-32bb-a57c-737854397d3b",
                                                "text": "Рассказывал о волнениях польских рабочих, забастовавших в Гданьске, Щецине и других городах, вызванных нищенским положением рабочих, угнетением и «демократическим» бесправием."
                                            },
                                            {
                                                "example_id": "2605045a-0a8b-4452-8b41-7a87208af3fe",
                                                "sense_id": "6541d3ef-535b-32bb-a57c-737854397d3b",
                                                "text": "Я увидел и Гданьск, и Щецин — города с одинаковой судьбой. Некогда немецкие, затем ставшие польскими."
                                            },
                                            {
                                                "example_id": "c224a434-0e4e-46f5-92da-d55f1cfe2007",
                                                "sense_id": "6541d3ef-535b-32bb-a57c-737854397d3b",
                                                "text": "Демобилизовавшись из десантных войск, купил туристическую путёвку в Варшаву и в районе города Щецина перешёл польско-немецкую границу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
