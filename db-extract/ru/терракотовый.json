                                        "entry_id": "b605f34b-7e2d-3294-9c24-07c307ede358",
                                        "glosses": [
                                            "Alternative form of terracotta."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad4766c1-8565-427a-9e9b-bc954adbc9c2",
                                                "sense_id": "d6eae0e4-ebe8-3189-a59c-954cfd5ce7fe",
                                                "text": "We began the trip at the ancient capital of Xi'an, where the Chinese put on an elaborate and beautiful welcoming ceremony. The next day we had the opportunity to walk among the rows of the famous terra-cotta warriors, and to have a roundtable discussion with Chinese citizens in the small village of Xiahe."
                                            }
                                        ]
                                    }
                                ]
                            }
