                "senses": [
                    {
                        "sense_id": "2d8f3e82-2288-36c7-8295-49176757dd8f",
                        "entry_id": "005e9d6a-3632-321f-a883-215ea043b5b9",
                        "glosses": [
                            "hardwarenahe Computersprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13ae321d-4276-4f66-a6d8-764c5927b2c7",
                                "sense_id": "2d8f3e82-2288-36c7-8295-49176757dd8f",
                                "text": "„Der Übergang von Assemblersprachen zu den höheren algorithmischen Sprachen war ein überwältigender Erfolg.“"
                            },
                            {
                                "example_id": "0456fbf6-b463-4e95-9470-bd55991f088e",
                                "sense_id": "2d8f3e82-2288-36c7-8295-49176757dd8f",
                                "text": "„Assemblersprachen bezeichnet man […] als Programmiersprachen der zweiten Generation. Ihre Befehle werden mit einer Übersetzungssoftware (Assembler) direkt und in der Regel 1:1 in Maschinenbefehle übersetzt, in höheren Programmiersprachen (Hochsprache, dritte Generation) hingegen übersetzt ein Compiler komplexere Programmanweisungen in mehrere Maschinenbefehle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
