                    {
                        "translation_id": "c84f6af7-0e9a-478b-a216-d3f48b9ee6de",
                        "source_entry_id": "08dbb013-d8db-3cf5-bdc5-f92ef75b00c8",
                        "source_sense_description": "титул",
                        "target_lang_word": "roi des rois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roi des rois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a07a8d05-443e-3245-b53c-a78c7084a1e1",
                                        "entry_id": "6a961994-5f3f-339f-8730-aadbbf9e02d2",
                                        "glosses": [
                                            "Titre de souverain de plusieurs empires composés de royaumes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1758158-1dab-3ccb-b3ac-a62b4b8861ae",
                                        "entry_id": "6a961994-5f3f-339f-8730-aadbbf9e02d2",
                                        "glosses": [
                                            "Souverain de la Perse antique."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f59b86e3-ecf9-45a2-95d9-a39b13511702",
                                                "sense_id": "f1758158-1dab-3ccb-b3ac-a62b4b8861ae",
                                                "text": "Le Roi des Rois est enfin revenu dans sa capitale. Il a conquis le monde jusqu’aux rives de la mer Rouge, jusqu’aux monts arides du Caucase, jusqu’aux terres inviolées où la neige tombe même en été."
                                            },
                                            {
                                                "example_id": "b538c219-af68-4dda-a430-3952dfb5f8a7",
                                                "sense_id": "f1758158-1dab-3ccb-b3ac-a62b4b8861ae",
                                                "text": "Le roi des rois demeura trois jours gisant au fond de sa tente. D’heure en heure, il recevait un courrier avec les vœux de sa royale maîtresse. Il songeait : C’est dans cet état que Dalila livra Samson aux Philistins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b5d023-38ef-35da-9338-b9d87f929142",
                                        "entry_id": "6a961994-5f3f-339f-8730-aadbbf9e02d2",
                                        "glosses": [
                                            "Roi de l’Éthiopie ; négus."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c34e5fe-3487-41b5-b498-498f0b3938b0",
                                                "sense_id": "03b5d023-38ef-35da-9338-b9d87f929142",
                                                "text": "Puis un frémissement courut. L’ex-Roi des Rois, une cape noire sur sa tunique blanche, gagnait la tribune. A peine allait-il parler qu’une bordée de sifflets et de cris l’accueillit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
