                                "target_senses": [
                                    {
                                        "sense_id": "9996792e-4ace-3334-86fe-8745fd719147",
                                        "entry_id": "27f30aab-dcf7-33c7-aa75-0223e85561e8",
                                        "glosses": [
                                            "In the manner of religion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdbd4d30-ccef-3ca3-9542-623c73340f9e",
                                        "entry_id": "27f30aab-dcf7-33c7-aa75-0223e85561e8",
                                        "glosses": [
                                            "Passionately or diligently; faithfully; conscientiously."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffdab53e-83c5-4448-a48b-db6c04f4d20b",
                                                "sense_id": "bdbd4d30-ccef-3ca3-9542-623c73340f9e",
                                                "text": "It is odd he gets so many cavities since he brushes his teeth religiously, every night, rain or shine."
                                            },
                                            {
                                                "example_id": "2cb7806c-4973-41fa-8a84-620a73a0de49",
                                                "sense_id": "bdbd4d30-ccef-3ca3-9542-623c73340f9e",
                                                "text": "“My wife and I use Notion religiously to manage our day-to-day life,” he wrote on X. “I turned this into a template, let me know if you’d like to see it!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b35a7f7-d75c-4cbc-9aaf-42e67f8ad647",
                        "source_entry_id": "e45b1bc7-f8dd-3a5f-90bd-a7cfc4a4f419",
                        "source_sense_id": "54e0fb4e-a3a1-3849-a43b-083fdf423173",
                        "target_lang_word": "conscientiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conscientiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9566393-cc53-32a9-b9b5-bd0f848cdbca",
                                        "entry_id": "c53ebd2c-04a1-3560-96af-82034376735c",
                                        "glosses": [
                                            "In a conscientious manner; attentively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf2bec2-ea31-4cf0-99c6-250e9a589276",
                                                "sense_id": "e9566393-cc53-32a9-b9b5-bd0f848cdbca",
                                                "text": "STORES and tobacco were running out; it was time for a trip to the township. Also for a conscientiously taken holiday."
                                            },
                                            {
                                                "example_id": "5bb68747-9f17-4eb4-b9d6-26f9bc6eb7a3",
                                                "sense_id": "e9566393-cc53-32a9-b9b5-bd0f848cdbca",
                                                "text": "Others who conscientiously attended the Technical College at night often drooped over their desks in a doze, and one does not wonder at it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
