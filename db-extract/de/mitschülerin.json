                        "sense_id": "e9fa5fcd-260f-39e2-88aa-ede9bc9fb1f2",
                        "entry_id": "b9d77b9d-f604-3e8c-9591-963dce36e228",
                        "glosses": [
                            "weibliche Person, die mit anderen zusammen zur gleichen Schule geht"
