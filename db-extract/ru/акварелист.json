                    },
                    {
                        "translation_id": "3860121d-3e16-43b0-80eb-674bc29fc31e",
                        "source_entry_id": "87fcff93-52c5-3edf-98e5-887476f487a6",
                        "source_sense_id": "69cdf8bb-474d-34fe-a330-9b0d50ae14e4",
                        "target_lang_word": "амер.",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b83c2490-881c-4aa9-bd49-7c0262cea5b2",
                        "source_entry_id": "87fcff93-52c5-3edf-98e5-887476f487a6",
                        "source_sense_id": "69cdf8bb-474d-34fe-a330-9b0d50ae14e4",
                        "target_lang_word": "Aquarellmaler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aquarellmaler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ef7be52-d302-349b-841c-d5adf5b450b1",
                                        "entry_id": "11b9a55c-3e2c-3632-9f40-23dd8e223665",
                                        "glosses": [
                                            "ein Maler, der Aquarelle malt"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53b346ce-6286-4ce4-89e6-e17d0bcc12c5",
                                                "sense_id": "2ef7be52-d302-349b-841c-d5adf5b450b1",
                                                "text": "Auf der Kunstmesse zeigten einige Aquarellmaler ihr Können."
                                            },
                                            {
                                                "example_id": "63ab7846-ad1d-4db1-8336-70b3244a98d9",
                                                "sense_id": "2ef7be52-d302-349b-841c-d5adf5b450b1",
                                                "text": "„Ich war jetzt bereit, ein nicht anerkannter Aquarellmaler zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3ee7eee-d13c-429f-bff5-6aec969dc211",
                        "source_entry_id": "87fcff93-52c5-3edf-98e5-887476f487a6",
                        "source_sense_id": "69cdf8bb-474d-34fe-a330-9b0d50ae14e4",
                        "target_lang_word": "Aquarellist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aquarellist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e141d7-86b5-3463-9089-18e728e64d99",
                                        "entry_id": "e41fd93d-cd46-3069-93f5-eff1e39a569f",
                                        "glosses": [
                                            "Person, die Aquarelle malt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0194da6-77a1-4cf2-adfe-1c751eac02db",
                                                "sense_id": "a3e141d7-86b5-3463-9089-18e728e64d99",
                                                "text": "Ein berühmter Aquarellist war Emil Nolde."
                                            },
                                            {
                                                "example_id": "defeeb2c-8258-4f45-9b3f-937961711cce",
                                                "sense_id": "a3e141d7-86b5-3463-9089-18e728e64d99",
                                                "text": "„Ausgangspunkt für die Untersuchungen waren Karten von John White. Der war Landvermesser und Aquarellist gewesen, bevor er sich 1587 der Expedition anschloss, die Sir Walter Raleigh im Auftrag der englischen Krone nach Amerika unternahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aae57376-b205-4631-bb48-dbfdc328bc45",
                        "source_entry_id": "87fcff93-52c5-3edf-98e5-887476f487a6",
                        "source_sense_id": "69cdf8bb-474d-34fe-a330-9b0d50ae14e4",
                        "target_lang_word": "aquarelliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aquarelliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31e51a43-5a27-3986-87cc-f763d72ff0f5",
                                        "entry_id": "4f14c9de-37c1-3580-bec4-d2fe345763b9",
                                        "glosses": [
                                            "Personne qui peint à l’aquarelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a717911-55ed-4f45-b950-33604ccadf1b",
                                                "sense_id": "31e51a43-5a27-3986-87cc-f763d72ff0f5",
                                                "text": "Et un beau matin me voilà parti avec mon attirail d’aquarelliste. Je n’avais oublié qu’une chose, mon pauvre ami : de l’eau."
                                            },
                                            {
                                                "example_id": "687fd7ee-2a7c-4b47-9ff5-4a1efa8c702d",
                                                "sense_id": "31e51a43-5a27-3986-87cc-f763d72ff0f5",
                                                "text": "Dora Simpson, après avoir mis au monde un fils qui ne vécut pas, est venue habiter Paris. Elle y mène une existence très retirée, se consacrant entièrement à son art. Amalla n’a pas voulu la quitter ; tout à fait francisée, c’est maintenant une aquarelliste habile."
                                            },
                                            {
                                                "example_id": "7c86e833-6485-46a3-9b9a-0712af54eb96",
                                                "sense_id": "31e51a43-5a27-3986-87cc-f763d72ff0f5",
                                                "text": "Monique Peyroux, aquarelliste confirmée, lancera la saison du vendredi 16 juin au samedi 15 juillet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40502cbc-2b9f-4d18-88fb-3ab0e162b76a",
                        "source_entry_id": "87fcff93-52c5-3edf-98e5-887476f487a6",
