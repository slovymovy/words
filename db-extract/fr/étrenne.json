                        "sense_id": "29004df3-19c1-34eb-b72d-8596ebfabbed",
                        "entry_id": "e66df6b1-601a-389d-b357-78725a7a6a57",
                        "glosses": [
                            "New Year's gift; Christmas present (especially when talking to a child)"
                        ],
