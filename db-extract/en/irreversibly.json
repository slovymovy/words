                "senses": [
                    {
                        "sense_id": "bf8b4b75-f96e-3a90-aeb8-00693bc8145e",
                        "entry_id": "51efac20-f606-39e0-8f07-8ebe2a0fb49d",
                        "glosses": [
                            "In an irreversible manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4657c5b8-8c52-4d95-b57e-d256bc7e4e93",
                                "sense_id": "bf8b4b75-f96e-3a90-aeb8-00693bc8145e",
                                "text": "But almost always such words are irreversibly established before the objectors learn of their existence, and the objections are hardly more than academic exercises."
                            },
                            {
                                "example_id": "d540abbf-60b2-4b4d-a27d-787423f1262f",
                                "sense_id": "bf8b4b75-f96e-3a90-aeb8-00693bc8145e",
                                "text": "We also perform IR-VIS absorbance measurements and find that the results suggest that during irradiation some of the dye molecules form dimers and trimers and that the polymer host is irreversibly damaged by photooxidation and Norrish type I photocleavage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21355ff5-d6ab-41d7-b335-5d67cc96ca94",
                        "source_entry_id": "51efac20-f606-39e0-8f07-8ebe2a0fb49d",
