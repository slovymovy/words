{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "261624f3-9dbe-3f24-aca8-3a09c4ebc3ee",
                    "sense_definition": "Formule de salutation employée en fin de journée ou en soirée lorsqu'on rencontre quelqu'un ou qu'on le quitte.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bonsoir</w>, j'espère que vous avez passé une très bonne journée."
                        },
                        {
                            "text": "Il entra dans le restaurant et dit : « <w>Bonsoir</w> à tous ! »"
                        }
                    ],
                    "synonyms": [
                        "salut"
                    ],
                    "antonyms": [
                        "bonjour"
                    ],
                    "common_phrases": [
                        "bonsoir à tous",
                        "bonsoir madame",
                        "bonsoir monsieur"
                    ]
                },
                {
                    "sense_id": "a1d1df74-ac32-3942-bf0f-316bc8c83f6f",
                    "sense_definition": "Exclamation signifiant qu'une affaire est définitivement réglée ou qu'une situation est close, sans retour possible.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cloture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si le train part avant notre arrivée, <w>bonsoir</w>, nous devrons attendre demain matin."
                        },
                        {
                            "text": "Tu lui donnes les clés et puis <w>bonsoir</w>, on n'en parle plus."
                        }
                    ],
                    "synonyms": [
                        "basta",
                        "terminé"
                    ],
                    "common_phrases": [
                        "et puis bonsoir"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "langage familier"
                        }
                    ]
                },
                {
                    "sense_id": "5442e285-0bea-3e6b-aa33-8584fc8cc37f",
                    "sense_definition": "Exclamation marquant le découragement, le dépit ou la perspective d'une corvée pénible.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dépit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bonsoir</w>, il va falloir porter tous ces paquets lourds jusqu'au sommet de la colline."
                        },
                        {
                            "text": "S'il recommence à neiger abondamment, <w>bonsoir</w> pour rentrer chez nous ce soir."
                        }
                    ],
                    "synonyms": [
                        "zut",
                        "mince"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "langage familier"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42db92ab-5942-3230-bc45-09fe859e18c5",
                    "sense_definition": "Salutation ou souhait poli formulé à l'adresse de quelqu'un en soirée.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant embrassa chaleureusement ses parents pour leur souhaiter le <w>bonsoir</w>."
                        },
                        {
                            "text": "Avant de sortir, elle nous adressa un dernier <w>bonsoir</w> de la main."
                        }
                    ],
                    "antonyms": [
                        "bonjour"
                    ],
                    "common_phrases": [
                        "dire bonsoir",
                        "souhaiter le bonsoir"
                    ]
                }
            ]
        }
    ]
}