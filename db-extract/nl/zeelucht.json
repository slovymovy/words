                                "target_word": "Meeresluft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "866fca5d-1ee7-309e-b3eb-d4ee62896edf",
                                        "entry_id": "ad29edc8-b694-34ec-a524-b184cf25d8a7",
                                        "glosses": [
                                            "die Luft an/über dem Meer"
                                        ],
