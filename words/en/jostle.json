{
    "word_family": [
        "jostler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7803bd3-1f8c-38c8-832f-7685a71ca4f0",
                    "sense_definition": "To bump into or brush against someone or something while moving.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd was so dense that people began to <w>jostle</w> each other as they walked.",
                            "target_lang_translations": {
                                "zh": "人群太密集了，人们走动时开始互相<w>挤碰</w>。",
                                "cs": "Dav byl tak hustý, že lidé do sebe při chůzi začali <w>strkat</w>."
                            }
                        },
                        {
                            "text": "I felt someone <w>jostle</w> my shoulder while I was waiting for the bus.",
                            "target_lang_translations": {
                                "zh": "等公交车时，我感觉到有人<w>碰撞</w>了我的肩膀。",
                                "cs": "Když jsem čekal na autobus, cítil jsem, jak do mě někdo <w>strčil</w> ramenem."
                            }
                        }
                    ],
                    "synonyms": [
                        "bump",
                        "shove",
                        "push"
                    ],
                    "common_phrases": [
                        "jostle against"
                    ],
                    "target_lang_definitions": {
                        "zh": "在移动时碰撞或擦碰到某人或某物。",
                        "cs": "Narážet do někoho nebo se otírat o někoho či něco při pohybu."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "碰撞",
                                "target_lang_sense_clarification": "指身体上的接触或碰撞。"
                            },
                            {
                                "target_lang_word": "挤碰",
                                "target_lang_sense_clarification": "指在拥挤环境中发生的推挤和碰撞。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "strkat",
                                "target_lang_sense_clarification": "opakované narážení nebo postrkování"
                            },
                            {
                                "target_lang_word": "vrážet",
                                "target_lang_sense_clarification": "prudší náraz do někoho nebo něčeho"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bef84116-5a22-3e27-b88b-eae79cb6c196",
                    "sense_definition": "To move through a crowd by pushing and shoving.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>jostle</w> through the busy market to reach the exit.",
                            "target_lang_translations": {
                                "zh": "我们不得不<w>挤过</w>繁忙的市场才能到达出口。",
                                "cs": "Museli jsme se <w>prodírat</w> rušným tržištěm, abychom se dostali k východu."
                            }
                        },
                        {
                            "text": "It is rude to <w>jostle</w> past people when you are in a hurry.",
                            "target_lang_translations": {
                                "zh": "匆忙时<w>挤过</w>人群是很没礼貌的。",
                                "cs": "Je neslušné se <w>tlačit</w> kolem lidí, když spěcháte."
                            }
                        }
                    ],
                    "synonyms": [
                        "push",
                        "shove"
                    ],
                    "common_phrases": [
                        "jostle through"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过推挤在人群中穿行。",
                        "cs": "Prodírat se davem pomocí strkání a tlačení."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挤过",
                                "target_lang_sense_clarification": "指在人群中用力穿行。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "tlačit se",
                                "target_lang_sense_clarification": "prodírání se v davu"
                            },
                            {
                                "target_lang_word": "drát se",
                                "target_lang_sense_clarification": "asertivní nebo silové prodírání se vpřed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53880102-8be7-30ca-a762-330d929cbf53",
                    "sense_definition": "To compete or struggle with others to gain something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many companies <w>jostle</w> for position in the global technology market.",
                            "target_lang_translations": {
                                "zh": "许多公司都在全球科技市场中<w>争夺</w>地位。",
                                "cs": "Mnoho společností se <w>pere</w> o pozici na globálním technologickém trhu."
                            }
                        },
                        {
                            "text": "The candidates <w>jostle</w> for attention during the televised debate.",
                            "target_lang_translations": {
                                "zh": "候选人在电视辩论中<w>争夺</w>关注度。",
                                "cs": "Kandidáti se během televizní debaty <w>přetahují</w> o pozornost."
                            }
                        }
                    ],
                    "synonyms": [
                        "compete",
                        "vie",
                        "contend"
                    ],
                    "common_phrases": [
                        "jostle for"
                    ],
                    "target_lang_definitions": {
                        "zh": "为了获得某物而与他人竞争或争夺。",
                        "cs": "Soutěžit nebo se přetahovat s ostatními o získání něčeho."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "争夺",
                                "target_lang_sense_clarification": "指为了某种地位或利益而竞争。"
                            },
                            {
                                "target_lang_word": "竞争",
                                "target_lang_sense_clarification": "指在市场或领域中争取优势。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "tahat se",
                                "target_lang_sense_clarification": "neformální vyjádření soupeření o něco"
                            },
                            {
                                "target_lang_word": "prát se",
                                "target_lang_sense_clarification": "přeneseně o urputný boj o pozici či výhodu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a66db61b-64aa-3621-8a6d-42e87d693f21",
                    "sense_definition": "To be positioned very close to or in physical contact with something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small houses <w>jostle</w> each other along the narrow cliffside.",
                            "target_lang_translations": {
                                "zh": "狭窄的悬崖边上，小房子一间挨着一间<w>挤在一起</w>。",
                                "cs": "Malé domky se <w>tlačí</w> jeden vedle druhého podél úzkého útesu."
                            }
                        },
                        {
                            "text": "Old cottages and modern flats <w>jostle</w> together along the narrow riverbank.",
                            "target_lang_translations": {
                                "cs": "Staré chalupy a moderní byty se <w>tlačí</w> vedle sebe podél úzkého břehu řeky.",
                                "zh": "在狭窄的河岸边，老式小屋和现代公寓<w>挤在一起</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crowd"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体紧密排列或相互挤在一起。",
                        "cs": "Být umístěn velmi blízko něčeho nebo být ve fyzickém kontaktu s něčím."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挤满",
                                "target_lang_sense_clarification": "指空间被填满，物体紧挨着。"
                            },
                            {
                                "target_lang_word": "挤在一起",
                                "target_lang_sense_clarification": "紧紧挨在一起"
                            },
                            {
                                "target_lang_word": "挤作一团",
                                "target_lang_sense_clarification": "挤成一团"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "tlačit se",
                                "target_lang_sense_clarification": "být nahuštěn na malém prostoru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "189ee3d1-060f-3350-87d0-8ec934fae675",
                    "sense_definition": "To attempt to steal from someone's pockets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pickpocket tried to <w>jostle</w> the tourist in the subway station.",
                            "target_lang_translations": {
                                "zh": "扒手试图在地铁站里<w>扒窃</w>那位游客。",
                                "cs": "Kapsář se pokusil v metru do turisty strčit a <w>okrást</w> ho."
                            }
                        },
                        {
                            "text": "Be careful in crowded areas where thieves might <w>jostle</w> you to steal your wallet.",
                            "target_lang_translations": {
                                "zh": "在拥挤的地方要小心，小偷可能会挤到你身上<w>扒窃</w>你的钱包。",
                                "cs": "Buďte opatrní v přeplněných místech, kde vás zloději mohou <w>okrádat</w> tak, že do vás strkají."
                            }
                        }
                    ],
                    "synonyms": [
                        "pickpocket"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Refers to criminal activity."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "试图从某人的口袋里偷东西。",
                        "cs": "Pokusit se někoho okrást z kapes."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扒窃",
                                "target_lang_sense_clarification": "指通过身体接触进行偷窃。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "okrádat",
                                "target_lang_sense_clarification": "kapsářská činnost v davu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69547aae-6498-3b4b-a175-9a3f6fb95a6f",
                    "sense_definition": "The act of pushing or shoving someone.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt a sudden <w>jostle</w> as the train came to a quick stop.",
                            "target_lang_translations": {
                                "zh": "火车急停时，我感觉到一阵突然的<w>推挤</w>。",
                                "cs": "Cítil jsem náhlé <w>strčení</w>, když vlak prudce zastavil."
                            }
                        },
                        {
                            "text": "The <w>jostle</w> in the crowd made it difficult to keep my balance.",
                            "target_lang_translations": {
                                "zh": "人群中的<w>推挤</w>让我很难保持平衡。",
                                "cs": "Kvůli <w>strkanici</w> v davu bylo těžké udržet rovnováhu."
                            }
                        }
                    ],
                    "synonyms": [
                        "push",
                        "shove"
                    ],
                    "target_lang_definitions": {
                        "zh": "推或挤某人的动作。",
                        "cs": "Akt strkání nebo tlačení někoho."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "推挤",
                                "target_lang_sense_clarification": "指身体上的推搡动作。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "strčení",
                                "target_lang_sense_clarification": "jednorázový akt"
                            },
                            {
                                "target_lang_word": "šťouchnutí",
                                "target_lang_sense_clarification": "lehčí nebo cílený náraz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6983a7f6-556f-3017-8062-7fcaba27bc52",
                    "sense_definition": "The chaotic movement of a large, crowded group of people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled to find peace within the constant <w>jostle</w> of city life.",
                            "target_lang_translations": {
                                "zh": "她在城市生活不断的<w>喧闹</w>中努力寻找平静。",
                                "cs": "Snažila se najít klid uprostřed neustálého <w>shonu</w> městského života."
                            }
                        },
                        {
                            "text": "The <w>jostle</w> of the commuters at rush hour is overwhelming.",
                            "target_lang_translations": {
                                "zh": "高峰时段通勤者的<w>拥挤</w>让人难以承受。",
                                "cs": "Ta <w>tlačenice</w> dojíždějících v dopravní špičce je zdrcující."
                            }
                        }
                    ],
                    "synonyms": [
                        "commotion",
                        "bustle"
                    ],
                    "target_lang_definitions": {
                        "zh": "一大群人拥挤时的混乱状态。",
                        "cs": "Chaotický pohyb velké, nahuštěné skupiny lidí."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拥挤",
                                "target_lang_sense_clarification": "指人群聚集造成的混乱状态。"
                            },
                            {
                                "target_lang_word": "喧闹",
                                "target_lang_sense_clarification": "指城市生活中的嘈杂与混乱。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "strkanice",
                                "target_lang_sense_clarification": "zmatek a tlačenice v davu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}