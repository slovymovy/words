                    {
                        "sense_id": "fc0741d4-3d21-3110-a101-63dc135c50b3",
                        "entry_id": "e187edd2-583f-3093-a5b1-72111d0fa617",
                        "glosses": [
                            "de bruin verkleurde bladeren van bomen en planten in de herfst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85baf7c9-7ce3-4a01-8b9a-48eafab649b0",
                                "sense_id": "fc0741d4-3d21-3110-a101-63dc135c50b3",
                                "text": "Voordat een blad afvalt wordt het bladgroen afgebroken en naar de plant teruggevoerd, wat overblijft is het geel-bruine herfstblad."
                            },
                            {
                                "example_id": "172320b3-a486-4161-942b-fe295930afae",
                                "sense_id": "fc0741d4-3d21-3110-a101-63dc135c50b3",
                                "text": "Ondertussen was de herfst in Washington overal zichtbaar om me heen en op de heuvels zag je een lappendeken aan kleuren: rode herfstbladeren, weelderige okergele weiden, mosgroene bossen, turquoise meren en verse witte bergpieken."
                            }
                        ]
                    }
