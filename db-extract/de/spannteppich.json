                "senses": [
                    {
                        "sense_id": "bc44deec-1ee0-32b7-aba4-1684fb91ca03",
                        "entry_id": "425dd35e-5cb3-3426-b33d-16835aaa16b8",
                        "glosses": [
                            "vollflächig verlegter Teppichbodenbelag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600fd08e-59c7-4c8c-8be5-9ac5384bb610",
                                "sense_id": "bc44deec-1ee0-32b7-aba4-1684fb91ca03",
                                "text": "„Soweit der Spannteppich verklebt sei, wäre er nicht Verfahrensgegenstand, weil vereinbart worden sei, daß die Beklagten für den Fall der Entfernung dieser Teppiche die Kosten der Wiederherstellung des Parketts zu tragen hätten.“"
                            },
                            {
                                "example_id": "3b32d627-a109-47d0-9900-987ec0d87838",
                                "sense_id": "bc44deec-1ee0-32b7-aba4-1684fb91ca03",
                                "text": "„Offenbar haben sie in allen Zimmern hier den gleichen Spannteppich.“"
                            },
                            {
                                "example_id": "77bb3292-911d-4024-bbb9-ea186bdbc0ca",
                                "sense_id": "bc44deec-1ee0-32b7-aba4-1684fb91ca03",
                                "text": "„Ich wollte Parkettböden, meine Mutter wollte einen Spannteppich, einen weißen Spannteppich.“"
                            },
                            {
                                "example_id": "b48181b2-3374-40ff-b9f1-6a2e591f4b2e",
                                "sense_id": "bc44deec-1ee0-32b7-aba4-1684fb91ca03",
                                "text": "„Ich erzählte ihm von den Löchern im Spannteppich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
