                        "glosses": [
                            "État d’une personne engoncée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73ed0356-ab0f-49c0-b04b-657cfb07ead7",
                                "sense_id": "0b2913cb-f667-315b-a98a-44d1d9e4da96",
                                "text": "Son propre corps, au gros bonhomme, lui faisait une camisole, un engoncement sans recours. Il se sentait terriblement isolé, dans sa graisse et dans sa laideur malgré lui."
                            },
                            {
                                "example_id": "c0e3ae17-36b5-4834-808b-1e9b8fb01627",
                                "sense_id": "0b2913cb-f667-315b-a98a-44d1d9e4da96",
                                "text": "Un duel où l’on se dispute âprement les rôles à distribuer car chacun peut devenir le spectateur de la maladie de l’autre, de son naufrage face à la maladie, de son engoncement en des états de déréliction, de son impuissance à inverser le cours des évènements."
                            }
                        ]
