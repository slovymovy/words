                    },
                    {
                        "sense_id": "db8d6788-6f00-3aef-8a16-ac32e4d4e381",
                        "entry_id": "3b9a7f3e-09d4-3fdf-a7cd-fe14a7dde282",
                        "glosses": [
                            "A city, the administrative center of Voronezh Oblast, Russia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec3e6a9-21de-45e0-81fc-c7169012915d",
                                "sense_id": "db8d6788-6f00-3aef-8a16-ac32e4d4e381",
                                "text": "Residents of the city of Voronezh insisted today that lanky, three-eyed extraterrestrial creatures had indeed landed in a local park and gone for a stroll and that a seemingly fantastic report about the event carried Monday by the official press agency Tass was absolutely true."
                            }
                        ]
                    },
                    {
                        "sense_id": "81db6fee-fae8-3a10-8358-5e1b6c8030a5",
                        "entry_id": "3b9a7f3e-09d4-3fdf-a7cd-fe14a7dde282",
                        "glosses": [
                            "A left tributary of the Don in Tambov, Lipetsk and Voronezh Oblasts, Russia."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
