                ],
                "senses": [
                    {
                        "sense_id": "8bbd6633-4a76-3bb4-ac1f-e16d48971126",
                        "entry_id": "30bda758-03cf-30b0-b926-6b92cf08430b",
                        "glosses": [
                            "Umstand, dass das Eis eines Gletschers, das eigentlich dauerhaft vorhanden sein sollte, wegtaut und verschwindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6b7b470-3923-416f-9866-1c09c298195c",
                                "sense_id": "8bbd6633-4a76-3bb4-ac1f-e16d48971126",
                                "text": "„Russpartikel und Feinstaub färben das Eis dunkler und lassen es schneller schmelzen. Denn das Rückstrahlvermögen, Albedo genannt, ist ausschlaggebend für die Gletscherschmelze. Je dunkler die Oberfläche der Gletscher, desto weniger können Sonnenstrahlen zurückgeworfen werden. Das Eis erwärmt sich stärker, es schmilzt.“"
                            },
                            {
                                "example_id": "1b521c5f-25a9-4486-a946-d71a5c76801a",
                                "sense_id": "8bbd6633-4a76-3bb4-ac1f-e16d48971126",
                                "text": "„Der Klimawandel ist Realität und dieser macht sich auch in Österreich sowie weltweit deutlich bemerkbar. Im letzten Jahrhundert ist die durchschnittliche Temperatur bereits gestiegen. Das führt zu Gletscherschmelzen in den Alpen, zur Eisschmelze in der Arktis und zu vielen weiteren globalen Umweltfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
