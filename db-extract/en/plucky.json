                        "translation_id": "69288504-853c-477a-bbee-ee46a926dcef",
                        "source_entry_id": "a91de9e3-67c2-391d-8d89-1da2b324c659",
                        "source_sense_id": "575a0bb7-1ef9-3635-9df6-bc79ebcaee4b",
                        "source_sense_description": "having or showing pluck",
                        "target_lang_word": "courageux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courageux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76667b4e-3d82-3a32-a422-fb2be669e5a5",
                                        "entry_id": "0b5bca78-3d86-37a0-8cde-0d8bf9745a57",
                                        "glosses": [
                                            "Qui fait preuve de courage face au danger ou à l’adversité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe6d3f3a-be55-4754-99cc-b1c96296a8f2",
                                                "sense_id": "76667b4e-3d82-3a32-a422-fb2be669e5a5",
                                                "text": "Pendant cinq siècles, sous la direction de ses capitouls et de ses consuls, Montauban fut une courageuse petite démocratie autonome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3d46379-279b-3275-91dc-2b550700d27f",
                                        "entry_id": "0b5bca78-3d86-37a0-8cde-0d8bf9745a57",
                                        "glosses": [
                                            "Qui démontre le courage d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ef607d9-dfaa-4bab-8bc3-0612fbe8311c",
                                                "sense_id": "a3d46379-279b-3275-91dc-2b550700d27f",
                                                "text": "Donner un rein est vraiment un acte courageux."
                                            },
                                            {
                                                "example_id": "289c97f0-25af-4fb8-a3e8-f6e2a3d71457",
                                                "sense_id": "a3d46379-279b-3275-91dc-2b550700d27f",
                                                "text": "Ton acte courageux, est-il nécessaire de le rappeler, se tient bien droit entre ce qui aurait pu être une démission, voire une lâcheté, et ce qui, à l'inverse, aurait pu être une imprudence ou même de la témérité."
                                            },
                                            {
                                                "example_id": "55fcb00c-76f8-4acc-93c1-94fcd4120d76",
                                                "sense_id": "a3d46379-279b-3275-91dc-2b550700d27f",
                                                "text": "Une démarche courageuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "364c5fdc-a889-31cb-80bc-45c6af1ff4fe",
                                        "entry_id": "0b5bca78-3d86-37a0-8cde-0d8bf9745a57",
                                        "glosses": [
                                            "Qui montre de l’ardeur au travail. Dans sa forme négative, qui est peu enthousiaste face à une tâche, qui fait preuve de peu de volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4145bc78-973e-4313-81e1-2bbd56a8e9d7",
                                                "sense_id": "364c5fdc-a889-31cb-80bc-45c6af1ff4fe",
                                                "text": "Dès qu’il s’agit de réviser, Jean-Paul n’est plus très courageux."
                                            },
                                            {
                                                "example_id": "f9853cc8-5140-43c8-bd09-42ccd8f10b7f",
                                                "sense_id": "364c5fdc-a889-31cb-80bc-45c6af1ff4fe",
                                                "text": "Mon grand-père était un fermier courageux; sept jours sur sept il partait aux champs, qu’il vente ou qu’il pleuve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
