                                "target_senses": [
                                    {
                                        "sense_id": "63e06f9d-bc9e-34d3-9f76-83dc78aa7601",
                                        "entry_id": "813525dd-99a8-34bb-b6b6-7bd1a8927148",
                                        "glosses": [
                                            "Very cheery and peppy; extremely cheerful, energetic and enthusiastic."
                                        ],
                                        "tags": [
                                            "of people"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8574e61-c19c-43f1-b8ba-01408f677d9c",
                                                "sense_id": "63e06f9d-bc9e-34d3-9f76-83dc78aa7601",
                                                "text": "exuberant feeling"
                                            },
                                            {
                                                "example_id": "44183011-918d-4742-bd26-213c73a5a65e",
                                                "sense_id": "63e06f9d-bc9e-34d3-9f76-83dc78aa7601",
                                                "text": "He was a man of exuberant fancy, and, withal of an authority so irresistible that, at his will, he turned his varied fancies into facts."
                                            },
                                            {
                                                "example_id": "af41e16f-75fb-4816-96f3-05dee7b61f59",
                                                "sense_id": "63e06f9d-bc9e-34d3-9f76-83dc78aa7601",
                                                "text": "She was a tall, earthy, exuberant girl with long hair and a pretty face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22bcdd3f-78e6-3c67-bea6-d92215942d15",
                                        "entry_id": "813525dd-99a8-34bb-b6b6-7bd1a8927148",
                                        "glosses": [
                                            "Abundant, luxuriant."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31813a49-4e33-45c5-bf73-7be3a0719caf",
                                                "sense_id": "22bcdd3f-78e6-3c67-bea6-d92215942d15",
                                                "text": "exuberant foliage"
                                            },
                                            {
                                                "example_id": "432aee2e-968f-4a76-953b-14a6f8b5d4f7",
                                                "sense_id": "22bcdd3f-78e6-3c67-bea6-d92215942d15",
                                                "text": "It pencilled each flower with rich and variegated hues, and threw over its exuberant foliage a vesture of emerald green."
                                            },
                                            {
                                                "example_id": "36e70e93-aae0-455c-ad96-eb5a28b35d1b",
                                                "sense_id": "22bcdd3f-78e6-3c67-bea6-d92215942d15",
                                                "text": "The County Architect's Department is starting to pleach trees to open up these vistas, now almost hidden by the exuberant growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "195ae598-f0cd-3708-84e4-1ea39cc7646c",
                                        "entry_id": "813525dd-99a8-34bb-b6b6-7bd1a8927148",
                                        "glosses": [
                                            "Unusually proliferative, widespread or extreme, particularly in relation to a disease, immune reaction, or tissue"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
