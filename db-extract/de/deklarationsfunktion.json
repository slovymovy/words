                ],
                "senses": [
                    {
                        "sense_id": "b5a4c266-44c5-3347-822b-a52d43907ad8",
                        "entry_id": "579c8195-80ef-33c0-b920-f9f079a9c340",
                        "glosses": [
                            "Intention der Texte, deren dominierende Textfunktion darin besteht, dass eine neue Wirklichkeit entsteht."
                        ],
                        "tags": [
                            "Textlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "03aa64dd-1bc3-447e-a270-d411eb35ced6",
                                "sense_id": "b5a4c266-44c5-3347-822b-a52d43907ad8",
                                "text": "Die Deklarationsfunktion ist die dominierende Textfunktion in Textklassen wie Ernennungsurkunden, Kriegserklärungen, Taufen, die dann, wenn die situativen Bedingungen zutreffen, für den Empfänger eine neue Wirklichkeit begründen."
                            },
                            {
                                "example_id": "be3df13e-8d2e-40d0-9fa8-84347c8db15f",
                                "sense_id": "b5a4c266-44c5-3347-822b-a52d43907ad8",
                                "text": "„Neben den expliziten sprachlichen Formen sind es vor allem auch bestimmte Textüberschriften (wie Testament, Urkunde, Bescheinigung, Vollmacht usw.), die auf die Deklarationsfunktion verweisen.“"
                            },
                            {
                                "example_id": "24bb0856-afc7-4dd0-a4b1-0571ecf70b81",
                                "sense_id": "b5a4c266-44c5-3347-822b-a52d43907ad8",
                                "text": "„Neben dieser sprachlichen Form sind es vor allem auch signifikante Textüberschriften (z.B. Testament, Urkunde), die auf die Deklarationsfunktion verweisen.“"
                            },
                            {
                                "example_id": "1c3b85a0-e9d7-41d4-a96b-bec6aa9f670d",
                                "sense_id": "b5a4c266-44c5-3347-822b-a52d43907ad8",
                                "text": "„Poetische, Obligations- und Deklarationsfunktion werden dagegen sehr knapp und nur der Vollständigkeit halber abgehandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
