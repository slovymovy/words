                    }
                ],
                "senses": [
                    {
                        "sense_id": "361ce3bd-10b7-3c45-bfc2-a893707d743c",
                        "entry_id": "c7346417-8b8b-300b-b2d5-2210bf738d77",
                        "glosses": [
                            "螢火蟲"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8430b545-0e67-4240-9e9f-9ffab348e0b6",
                                "sense_id": "361ce3bd-10b7-3c45-bfc2-a893707d743c",
                                "text": "That lookt to neere haue of that light no signe."
                            },
                            {
                                "example_id": "3d23f18b-ca0a-4291-833e-ddd31d07f8d9",
                                "sense_id": "361ce3bd-10b7-3c45-bfc2-a893707d743c",
                                "text": "Glories (like glowe-wormes) a farre off, shine bright,\nBut look’d to neere, haue neither heate, nor light."
                            },
                            {
                                "example_id": "b150f14e-0f52-4553-a687-a073b0239e4f",
                                "sense_id": "361ce3bd-10b7-3c45-bfc2-a893707d743c",
                                "text": "Ye Glo-worms, whose officious Flame\nTo wandring Mowers shows the way,\nThat in the Night have lost their aim,\nAnd after foolish Fires do stray;"
                            },
                            {
                                "example_id": "b58a92f1-bb20-47b3-8cd2-1d677a932b22",
                                "sense_id": "361ce3bd-10b7-3c45-bfc2-a893707d743c",
                                "text": "Propitious to your earth-born light!"
                            },
                            {
                                "example_id": "609f10e5-c796-4a1d-baed-8fe91c571420",
                                "sense_id": "361ce3bd-10b7-3c45-bfc2-a893707d743c",
                                "text": "Young girls lie bedded soft or glide in their dreams, with rings and trousseaux, bridesmaided by glowworms down the aisles of the organplaying wood."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c0b2e0c-803a-3871-a746-6d43811c4c15",
