                        "tracić"
                    ],
                    "common_phrases": [
                        "odnajdywać zgubę"
                    ],
                    "target_lang_definitions": {
                        "en": "to find something that was lost, hidden, or forgotten"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "find",
                                "target_lang_sense_clarification": "to discover something lost or hidden"
                            },
                            {
                                "target_lang_word": "recover",
                                "target_lang_sense_clarification": "to regain possession of missing items"
                            },
                            {
                                "target_lang_word": "retrieve",
                                "target_lang_sense_clarification": "to find and bring back"
                            }
                        ]
