                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdee40b3-f315-4686-8ab0-e22aba9b6161",
                                "sense_id": "2095edd9-7638-3805-a281-b1e6e8fce95d",
                                "text": "поторопи́ть кого́-либо",
                                "translation": "to hurry someone",
                                "english": "to hurry someone"
                            },
                            {
                                "example_id": "2d48ff79-0240-45a9-9ea6-7c918028d83f",
                                "sense_id": "2095edd9-7638-3805-a281-b1e6e8fce95d",
                                "text": "он поторопи́л меня́ с оконча́нием рабо́ты",
                                "translation": "he hurried me to finish my work",
                                "english": "he hurried me to finish my work"
                            },
                            {
                                "example_id": "8b5479d2-0872-4b7c-a112-b6ab8d01ead7",
                                "sense_id": "2095edd9-7638-3805-a281-b1e6e8fce95d",
                                "text": "он поторопи́л меня́ с отве́том",
                                "translation": "he hurried/pressed me for an answer",
                                "english": "he hurried/pressed me for an answer"
                            },
                            {
                                "example_id": "4237f10f-ec6a-4dca-9411-4a36174f7116",
                                "sense_id": "2095edd9-7638-3805-a281-b1e6e8fce95d",
                                "text": "поторопи́ть собы́тия",
                                "translation": "to rush things",
                                "english": "to rush things"
                            }
                        ]
                    }
