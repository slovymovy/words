                                "sense_id": "d8f494ac-16a3-3f93-a83d-331d32ca9fd8",
                                "text": "Les centristes ne sont pas des ramasse-miettes. — (http://www.lepoint.fr/content/confidentiels/list_commentary?idDoc=178925&url=/content/915/article.html?id=178925&submitForm=0)"
                            }
