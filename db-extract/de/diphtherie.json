                        "source_sense_id": "002bff04-3f7b-35ed-9052-016d3720801d",
                        "source_sense_description": "Infektionskrankheit der oberen Atemorgane",
                        "target_lang_word": "diphtheria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diphtheria",
