                "senses": [
                    {
                        "sense_id": "073a82fa-699d-3f84-83a1-056572fb7a22",
                        "entry_id": "5ad3d7bc-72ea-3690-af87-8d534af2d9c5",
                        "glosses": [
                            "устройство для записи и воспроизведения видеоматериалов на магнитной плёнке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7034e93-7276-4243-82ae-22950fe5c82d",
                                "sense_id": "073a82fa-699d-3f84-83a1-056572fb7a22",
                                "text": "Применение видеомагнитофона в кино принесёт огромную материальную выгоду."
                            },
                            {
                                "example_id": "2499e076-8e3d-4c44-bbc9-79119457f295",
                                "sense_id": "073a82fa-699d-3f84-83a1-056572fb7a22",
                                "text": "Первые видеомагнитофоны занимали несколько шкафов. Теперь же выпускают видеомагнитофоны на полупроводниках для домашней записи прямо с телевизора и совсем миниатюрные репортёрские модели."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
