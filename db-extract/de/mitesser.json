                                "target_senses": [
                                    {
                                        "sense_id": "c752f5cc-2afc-3f2e-b683-09479e6e6bd5",
                                        "entry_id": "ad9675a5-469a-3611-8f77-b817283979fe",
                                        "glosses": [
                                            "kožní onemocnění — zánět mazového váčku projevující se vznikem tzv. komedonů, čili uhrů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2545b7e-4444-45ed-ae57-b3f9f60d0038",
                                                "sense_id": "c752f5cc-2afc-3f2e-b683-09479e6e6bd5",
                                                "text": "Mnohé z nás akné v pubertě pěkně potrápilo, někdo musí tento problém řešit dodnes."
                                            },
                                            {
                                                "example_id": "9c314f3b-d7bc-4ec7-a005-62a713bbf01e",
                                                "sense_id": "c752f5cc-2afc-3f2e-b683-09479e6e6bd5",
                                                "text": "Akné sužuje devět z deseti dospívajících. Za problémy s pletí mohou v pubertě hlavně hormonální bouře, kterými tělo dospívajících prochází."
                                            },
                                            {
                                                "example_id": "3ac3c8f8-d704-41d9-92b0-83038c9886a8",
                                                "sense_id": "c752f5cc-2afc-3f2e-b683-09479e6e6bd5",
                                                "text": "Máte prosím nějaký osvědčený přípravek, který můžete doporučit pro zmírnění tvorby akné? Dcera je v pubertě, na obličeji i po ramenou se jí tvoří akné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
