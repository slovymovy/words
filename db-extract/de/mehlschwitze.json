                    {
                        "sense_id": "f1fcc6c2-eec7-3dfe-b65e-ef01ac325c49",
                        "entry_id": "e7c8fcda-c608-3e35-b931-427de1d4b961",
                        "glosses": [
                            "erhitzte Mischung aus Weizenmehl und Fett, die zum Binden von Suppen und Soßen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41eb90ae-c3f4-4434-92c2-d57a5470026e",
                                "sense_id": "f1fcc6c2-eec7-3dfe-b65e-ef01ac325c49",
                                "text": "„Die Ernsthaftigkeit dieser Geständnisse schien die Luft regelrecht zu verdicken wie Brühe, die zu Mehlschwitze wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81482dc7-0b76-4cfc-af7f-3002f1eabe88",
                        "source_entry_id": "e7c8fcda-c608-3e35-b931-427de1d4b961",
                        "source_sense_id": "f1fcc6c2-eec7-3dfe-b65e-ef01ac325c49",
                        "source_sense_description": "erhitzte Mischung aus Weizenmehl und Fett, die zum Binden von Suppen und Soßen dient",
                        "target_lang_word": "roux",
