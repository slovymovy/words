        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d98cd47-6a2b-376b-b0ff-d0616754d69f",
                    "sense_definition": "druga osoba liczby pojedynczej trybu rozkazującego od czasownika <w>strzępić</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "czasownik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Strzęp</w> te brzegi materiału, żeby wyglądały na starsze.",
                            "target_lang_translations": {
                                "ru": "<w>Трепли</w> края ткани, чтобы они выглядели старыми."
                            }
                        },
                        {
                            "text": "Nie <w>strzęp</w> tak nerwów, wszystko będzie dobrze.",
                            "target_lang_translations": {
                                "ru": "Не <w>трепли</w> себе нервы, все будет хорошо."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma czasownika"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "повелительное наклонение глагола 'strzępić' (трепать, делать бахрому)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепли",
                                "target_lang_sense_clarification": "повелительное наклонение от 'трепать'"
                            }
                        ]
                    }
                }
            ]
        }
