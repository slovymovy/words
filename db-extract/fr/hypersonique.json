                                        "glosses": [
                                            "Equal to, or greater than, or capable of achieving, five times the speed of sound."
                                        ],
                                        "tags": [
                                            "of a speed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ada4d2b-d393-46a7-abc1-162b96da9e19",
                                                "sense_id": "98ea25d6-a2f8-3105-a10c-da88f27442f4",
                                                "text": "He said there was worry among intelligence and military officials that China or Russia could be experimenting with hypersonic technology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5d5b263-3491-317a-bab2-00772aadeae9",
