                "senses": [
                    {
                        "sense_id": "822a375b-8af2-345a-a07d-5bcb93abd24c",
                        "entry_id": "0e8f3108-d2ce-32a2-989e-31a1254a762e",
                        "glosses": [
                            "прост. безнадёжный, плохой, никуда не годный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35b25387-3959-4dd9-8090-9f21c8b2b319",
                                "sense_id": "822a375b-8af2-345a-a07d-5bcb93abd24c",
                                "text": "\"Гнилой овраг, ― думал я. ― Гиблый. Уж если ему нападать ― здесь."
                            },
                            {
                                "example_id": "bf6ea213-5ed8-4a75-aeaf-077d92af0609",
                                "sense_id": "822a375b-8af2-345a-a07d-5bcb93abd24c",
                                "text": "Ржавый, порыжевший от затхлости пакетик прилепился эдакой слизью к полу, он только казался ничейным; как и ветерок этот гиблый, легкий ― только казалось, что таился в нем, в невзрачном пакетике под плитой, а гулял теперь одинешенек посреди ночи в гулких стенах хозблока."
                            }
                        ]
                    }
