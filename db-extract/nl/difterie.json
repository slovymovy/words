                                "target_senses": [
                                    {
                                        "sense_id": "99dc2ff1-58a7-3ee7-aad0-5b79f3a8d8c4",
                                        "entry_id": "b55a5519-887e-384c-8524-58d00117f1c7",
                                        "glosses": [
                                            "A serious infectious disease leading to inflammation of mucous membranes of the upper respiratory tract, caused by Corynebacterium diphtheriae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f22d0380-1a57-4d12-b3cc-d85e5e339d68",
                                                "sense_id": "99dc2ff1-58a7-3ee7-aad0-5b79f3a8d8c4",
                                                "text": "Today diphtheria has become so rare — just five cases in the United States in the most recent decade measured — that many doctors would struggle to recognize it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24591312-b8c8-4553-a88e-b14b27127d3f",
                        "source_entry_id": "b898f4fe-b02c-35b2-a5d8-4daafc57939f",
                        "source_sense_id": "5992c869-04ec-3f09-93ba-7e37b48ae6cd",
                        "source_sense_description": "infectieziekte",
                        "target_lang_word": "diphtérie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diphtérie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                                        "entry_id": "ef7ca2dd-f756-360a-b336-ce806b98bef4",
                                        "glosses": [
                                            "Maladie infectieuse et contagieuse caractérisée par la formation de fausses membranes dans la gorge."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313f147b-0585-4626-a7f6-84e68f37bf26",
                                                "sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                                                "text": "Tout mon bras droit de l’épaule au poignet est enflé, dur, brûlant, couvert de pustules, j’ai une grosse fièvre… cela provient de la piqûre qu’a faite à Lili et à moi le médecin d’ici, pour nous empêcher d’attraper la diphtérie. Lili n’a rien, mais moi… j’entends dire qu’il a dû me piquer avec une aiguille pas assez propre…"
                                            },
                                            {
                                                "example_id": "7d2e3650-0695-4c16-9edd-9fd70cdea724",
                                                "sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                                                "text": "La fièvre ne baissait pas, c’était la diphtérie."
                                            },
                                            {
                                                "example_id": "6b44fe74-023b-4613-acef-269f567df4e9",
                                                "sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                                                "text": "Elle raconte qu'ils ont eu une autre fille que moi et qu'elle est morte de la diphtérie à six ans, avant la guerre, à Lillebonne. Elle décrit les peaux dans la gorge, l'étouffement."
                                            },
                                            {
                                                "example_id": "b02f15b6-7d9d-4914-86be-cec6a65fb623",
                                                "sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                                                "text": "Nul n'a oublié … le maréchal Edme Patrice de Mac Mahon, autre dirigeant de la iiiᵉ République qui nous gratifia du plus mémorable des aphorismes politiques : « La diphtérie, on en meurt ou on en reste idiot; je le sais, je l'ai eue. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
