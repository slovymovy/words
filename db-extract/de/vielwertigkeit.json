                ],
                "senses": [
                    {
                        "sense_id": "6d4548f1-2f44-3266-8d0b-351d12c749d9",
                        "entry_id": "33daa844-6a3d-3654-8677-65baa24b37b0",
                        "glosses": [
                            "Eigenschaft, eine Vielzahl von Lösungen, Bedeutungen, Funktionen oder Ähnliches zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7080255-1a8b-434b-a20e-66b9fdd26abd",
                                "sense_id": "6d4548f1-2f44-3266-8d0b-351d12c749d9",
                                "text": "„Aufgrund solcher Vielwertigkeit kann nun dieser Begriff auch in ganz anderen Kontexten und Schreibweisen verwendet werden.“"
                            },
                            {
                                "example_id": "723ed711-19f9-4f5a-bd6e-43193ffe21b3",
                                "sense_id": "6d4548f1-2f44-3266-8d0b-351d12c749d9",
                                "text": "„Bist Du bereit, die ungeheure Spannung zu ertragen, die in der Vielwertigkeit (Polyvalenz) von Energie liegt?“"
                            },
                            {
                                "example_id": "923ffedc-2ac9-46e1-9476-b543311afb10",
                                "sense_id": "6d4548f1-2f44-3266-8d0b-351d12c749d9",
                                "text": "„Künstlerisches, dichterisches Empfinden in der Literatur besteht darin, die Vielwertigkeit jeden Wortes und Ausdrucks zu gewahren und sich versuchsweise zunutze zu machen.“"
                            },
                            {
                                "example_id": "9754c39d-46a2-441f-873f-89ea7a485b0a",
                                "sense_id": "6d4548f1-2f44-3266-8d0b-351d12c749d9",
                                "text": "„In noch drastischerer Weise ist die Vielwertigkeit hoch komplizierter Protozoenzellen in andern Fällen erwiesen worden.“"
                            },
                            {
                                "example_id": "0dab0f6b-5592-416e-9b45-d6e992522429",
                                "sense_id": "6d4548f1-2f44-3266-8d0b-351d12c749d9",
                                "text": "„Dies ist die Voraussetzung für opportune Anpassung als Camouflage wie für die produktive Steigerung von Vieldeutigkeit und Vielwertigkeit, von Ambivalenz und Ambiguität.\"“"
                            },
                            {
                                "example_id": "c5420832-3b64-43d8-b395-341a34ac7525",
                                "sense_id": "6d4548f1-2f44-3266-8d0b-351d12c749d9",
                                "text": "„ Im Gegensatz zur bivalenten Anschauung betont Fuzzy-Logik die Polyvalenz ( Vielwertigkeit ) der Weltbetrachtung, wie es in vielen östlichen Glaubenssystemen verankert ist.“"
                            },
                            {
                                "example_id": "668ee99b-e510-4040-84f1-51d755d298b8",
                                "sense_id": "6d4548f1-2f44-3266-8d0b-351d12c749d9",
                                "text": "„Es stellt sich das Problem der Zurechenbarkeit von Weiterbildungserfolgen, denn die Vielwertigkeit der messbaren Leistungen steht einer Zurechnung zu einer bestimmten Bildungsmaßnahme im Wege.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
