                "senses": [
                    {
                        "sense_id": "8b8365ba-614a-38c0-b953-723e27d07701",
                        "entry_id": "35276b56-e643-3588-b8f1-4ef465ec60fd",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße aufbauendes, positiv gesteuertes (konstruktives) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2cb569e-08d8-415f-bbba-ad6663eff040",
                                "sense_id": "8b8365ba-614a-38c0-b953-723e27d07701",
                                "text": "Die Zusammenarbeit ist auf Konstruktivität, Dialog und Kooperation angelegt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "322934eb-ca48-35e9-9c37-955937aea1e3",
                        "entry_id": "35276b56-e643-3588-b8f1-4ef465ec60fd",
                        "glosses": [
                            "Erschaffung (Konstruktion) von Neuem"
                        ],
                        "tags": [
                            "Wissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "2555450e-4890-4bf1-84e2-74d34e78c065",
                                "sense_id": "322934eb-ca48-35e9-9c37-955937aea1e3",
                                "text": "„Wenn innerhalb des theoretischen Rahmens dieser Arbeit von Konstruktivität die Rede sein soll, so soll damit zum einen die innovative Absicht zum Ausdruck gebracht werden und zum anderen eine Abgrenzung zum Rekonstruktivismus erreicht werden.“"
                            },
                            {
                                "example_id": "43220ced-c02d-4d74-bbc6-dd93d40cb784",
                                "sense_id": "322934eb-ca48-35e9-9c37-955937aea1e3",
                                "text": "„Als eine Ursache der Veränderung, benennt er die zunehmende Pluralität von Wirklichkeitsmodellen. Die Zunahme von Konstruktivität der Wirklichkeit wird so allgemein erfahrbar und damit einhergehend auch zum zentralen Thema vieler Medientheorien.“"
                            },
                            {
                                "example_id": "6c3aea75-8a8c-4204-8b05-cf014cae2c49",
                                "sense_id": "322934eb-ca48-35e9-9c37-955937aea1e3",
                                "text": "„Der Konstruktivismus schließlich wäre als Theorie zur Beobachtung (mutmaßlich) steigender Konstruktivität im Journalismus zu verstehen. Auch Konstruktivität sollte empirisch-graduell verstanden werden.“"
                            },
                            {
                                "example_id": "8d97092b-5733-4eef-bf20-c528fa9d6cd4",
                                "sense_id": "322934eb-ca48-35e9-9c37-955937aea1e3",
                                "text": "„Exemplarität, sokratisches Suchen, Konstruktivität und Vielperspektivität sind die aufeinander bezogenen grundlegenden Merkmale einer genetischen Konzeption des Sachunterrichts.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
