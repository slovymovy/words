                        "sense_id": "868db749-ddb9-3fe7-8cae-6410ea3901ec",
                        "entry_id": "46cad562-79e3-3d9c-8df3-b47168d0f6ad",
                        "glosses": [
                            "A hinge."
                        ],
                        "tags": [
                            "UK",
