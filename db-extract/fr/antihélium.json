                ],
                "senses": [
                    {
                        "sense_id": "200a2847-0616-3379-a1a2-743c6cef97cd",
                        "entry_id": "3e4b790d-d842-3536-a127-55ba4cf149e8",
                        "glosses": [
                            "Équivalent de l’hélium mais constitué d’antimatière, c’est-à-dire composé de deux antiprotons et d’antineutrons."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "78fab8c4-fcc3-485b-9da8-01d5539ee48a",
                                "sense_id": "200a2847-0616-3379-a1a2-743c6cef97cd",
                                "text": "Ces particules se sont alors attirées en raison des forces nucléaires fortes pour former des antinoyaux et c’est ainsi que 18 noyaux d’antihélium ont été observés.."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df1a2813-31bd-44b2-9bcb-187461deb082",
                        "source_entry_id": "3e4b790d-d842-3536-a127-55ba4cf149e8",
                        "source_sense_id": "200a2847-0616-3379-a1a2-743c6cef97cd",
                        "target_lang_word": "Antihelium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antihelium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "174be211-4a08-3f98-84fe-33c671877a79",
                                        "entry_id": "cdc7bfec-f310-3c4d-8f4f-58e3e96587e6",
                                        "glosses": [
                                            "theoretisch vorkommendes/erzeugbares Element, das aus Antiteilchen des Heliums besteht"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbcaf8d5-ed7e-414a-bd2c-415f64d4924c",
                                                "sense_id": "174be211-4a08-3f98-84fe-33c671877a79",
                                                "text": "„Helium, das zuerst mittels Spektralanalyse auf der Sonne entdeckt worden war, bevor man es auch auf der Erde aufgespürt hatte, besaß sicher ebenfalls seine Entsprechung in Antihelium.“"
                                            },
                                            {
                                                "example_id": "521c8e68-b6b4-4e44-be45-208f06779b48",
                                                "sense_id": "174be211-4a08-3f98-84fe-33c671877a79",
                                                "text": "„1970 und 1973 gelang im russischen Protvino der Nachweis von Antihelium 3- und Antitritium-Kernen. Das Bild 2.15 zeigt verschiedene Antimaterieteilchen. p n n Antideuterium- Kern (Antideuteron) Antihelium 3Kern p p Antitritium- Kern […]“"
                                            },
                                            {
                                                "example_id": "67280efb-ccf5-4bc4-8257-683ecb3f0ac3",
                                                "sense_id": "174be211-4a08-3f98-84fe-33c671877a79",
                                                "text": "„Ich spreche vom Antihelium. […] Wie wurde nun das Antihelium erkannt ? […] Die Entdeckung der Kerne des Antiheliums, eines Elements, das im Periodensystem dem Wasserstoff folgt, hat große prinzipielle Bedeutung.“"
                                            },
                                            {
                                                "example_id": "db139107-f3b5-4761-b0a3-2e9717d68d58",
                                                "sense_id": "174be211-4a08-3f98-84fe-33c671877a79",
                                                "text": "„In dieser Beschreibung des Standardmodelles des Universums scheint die Antimaterie keinen Platz zu finden von Wasserstoff und Helium, aber nicht von Antiwasserstoff und Antihelium war die Rede.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65ebda71-737a-4220-9da5-22861d7ebad9",
                        "source_entry_id": "3e4b790d-d842-3536-a127-55ba4cf149e8",
                        "source_sense_id": "200a2847-0616-3379-a1a2-743c6cef97cd",
                        "target_lang_word": "antihelium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antihelium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b376c0d4-8018-34f8-b3b0-501cc5a0893c",
                                        "entry_id": "2148a2c9-3c53-326a-9aee-b7c0618b1a26",
                                        "glosses": [
                                            "The antiatom form of helium"
                                        ],
                                        "tags": [
                                            "countable",
                                            "particle",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8dcc795-5960-43c9-9799-9a28b7f986e9",
                                                "sense_id": "b376c0d4-8018-34f8-b3b0-501cc5a0893c",
                                                "text": "In 1970, a more complex antinucleus, antihelium-3 (iHe), was discovered in the USSR."
                                            },
                                            {
                                                "example_id": "103c9a2e-0c0c-4f3d-965a-9bdf2332988c",
                                                "sense_id": "b376c0d4-8018-34f8-b3b0-501cc5a0893c",
                                                "text": "In principle the energy should have been enough for the production of even heavier antinuclei. However, the probability for production of heavier masses is very tiny, and antihelium-3 is still the heaviest known antielement."
                                            },
                                            {
                                                "example_id": "78e1873a-edc8-4674-bb8e-94c61ee8f865",
                                                "sense_id": "b376c0d4-8018-34f8-b3b0-501cc5a0893c",
                                                "text": "After several launches of their balloon, the scientists registered more than 40 million nuclei of helium in the cosmic rays, but not a single nucleon of antihelium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
