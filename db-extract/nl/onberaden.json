                "senses": [
                    {
                        "sense_id": "829d2c77-1347-3481-8fab-88bb06aed992",
                        "entry_id": "251ba63e-d3f9-3dd7-9c71-cd3e923b26e9",
                        "glosses": [
                            "zonder vooraf goed nagedacht te hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e1063b1-0a6a-4f3e-bb2a-a1b1da8d0da9",
                                "sense_id": "829d2c77-1347-3481-8fab-88bb06aed992",
                                "text": "Volgens de nieuwssite Axios van 30 juni staat de Amerikaanse president Donald Trump op het punt een handelsoorlog te beginnen, hierin slechts gesteund door een handjevol America-firsters onder zijn adviseurs en in weerwil van bijna zijn hele kabinet. De formele aankondiging is tot dusver uitgebleven. Dit kan te maken hebben met het feit dat de showman Trump het G-20-overleg in Hamburg als podium wil gebruiken of met grote diplomatieke inspanningen van de EU en Japan om hem van deze onberaden plannen af te houden."
                            },
                            {
                                "example_id": "14f39b13-662b-4855-ba93-eb4a828de1f4",
                                "sense_id": "829d2c77-1347-3481-8fab-88bb06aed992",
                                "text": "We voelen allen onbehagen en onmacht over het vreselijke geweld in Syrië, maar laat dat geen reden zijn voor onberaden en onverantwoorde stappen."
                            },
                            {
                                "example_id": "2728465f-c22b-41f4-9570-33daf3c58d0a",
                                "sense_id": "829d2c77-1347-3481-8fab-88bb06aed992",
                                "text": "Zo komen sommigen ten val door hun overdaad, anderen door hun eerzucht, en weer anderen door onberaden winstbejag, omdat de vermanende stem der wijsheid hun ontbreekt.”"
                            }
                        ]
                    }
                ],
