                ],
                "translations": [
                    {
                        "translation_id": "7b3be47c-ba46-4a6a-91a9-633ea69fb374",
                        "source_entry_id": "d2e771a2-8627-3a06-9c53-bd945545b850",
                        "source_sense_id": "95642591-53b9-30a3-be37-0d8e4a5e2c6e",
                        "target_lang_word": "formalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59aa4724-1b3b-350c-b66e-4fba7b7d742f",
                                        "entry_id": "2d395fca-de7e-35a7-a739-44579a45a6ff",
                                        "glosses": [
                                            "An overly formal person, especially one who adheres to current forms; a stickler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "154d9d5a-2288-469e-919a-7f1dbbdcd84e",
                                                "sense_id": "59aa4724-1b3b-350c-b66e-4fba7b7d742f",
                                                "text": "The Besht preached that the simple man, imbued with native faith and able to pray fervently and wholeheartedly with a sense of joy in his heart, was nearer and dearer to God than the learned but joyless formalist spending his whole life in the study of Talmud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5ed5a9f-2ce7-3a0e-95e3-d17ebf39962f",
                                        "entry_id": "2d395fca-de7e-35a7-a739-44579a45a6ff",
                                        "glosses": [
                                            "An advocate of formalism"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "formalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83b6350a-48c9-385c-b57b-844bc22adce6",
                                        "entry_id": "931dc694-a884-308f-bd5e-471fdb5131a9",
                                        "glosses": [
                                            "Of or pertaining to formalism; formalistic"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59ec043f-41aa-4f65-b364-e93ae571f4a7",
                        "source_entry_id": "d2e771a2-8627-3a06-9c53-bd945545b850",
                        "source_sense_id": "95642591-53b9-30a3-be37-0d8e4a5e2c6e",
                        "target_lang_word": "formaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "317deee4-670d-3c02-b066-0cc0b9c2884e",
                                        "entry_id": "3cabbb6b-a485-326d-89e6-15bf3f9076d6",
                                        "glosses": [
                                            "Qui s’attache scrupuleusement aux formes, aux formalités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dfd862b-a3cf-4353-8f20-30b3f5210a4a",
                                                "sense_id": "317deee4-670d-3c02-b066-0cc0b9c2884e",
                                                "text": "Les théories élevées et absolues de la philosophie parisienne venaient échouer contre le bons sens fortement carré de l'esprit comtois et les habitudes formalistes de l'esprit parlementaire."
                                            },
                                            {
                                                "example_id": "79ece6d8-d2b3-46dd-810f-415924e1c589",
                                                "sense_id": "317deee4-670d-3c02-b066-0cc0b9c2884e",
                                                "text": "La loi salique en son titre XLVI nous décrit minutieusement les rites formalistes de l'institution, rites antérieurs aux invasions, semble-t-il."
                                            },
                                            {
                                                "example_id": "b25abef3-9b95-4952-aa08-caee39d4afe8",
                                                "sense_id": "317deee4-670d-3c02-b066-0cc0b9c2884e",
                                                "text": "À ce titre, il était de l'intérêt de l'« establishment » religieux de promouvoir et de défendre l'orthodoxie religieuse, l'éducation formaliste et un traditionalisme rigide sous prétexte de sauvegarder le caractère islamique de la communauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ac33399-01e1-3fbe-ab57-8a1a4969dc7f",
                                        "entry_id": "3cabbb6b-a485-326d-89e6-15bf3f9076d6",
                                        "glosses": [
                                            "Contraire aux canons du réalisme socialiste soviétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c59d2d9-2315-4108-ad66-ad202be9f1fa",
                                                "sense_id": "1ac33399-01e1-3fbe-ab57-8a1a4969dc7f",
                                                "text": "L'œuvre d'art sera jugée formaliste, dès que pas inclinée du tout et n'ayant par conséquent plus de «sens» (et je joue ici sur le mot). Je ne puis, je l'avoue, écrire ces mots «forme» et «fond» sans sourire. Mais il sied plutôt de pleurer lorsqu'on voit que cette absurde distinction va déterminer la critique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ae595ac-cec5-3bc6-85c5-9cfcd4aade09",
                                        "entry_id": "3cabbb6b-a485-326d-89e6-15bf3f9076d6",
                                        "glosses": [
                                            "Qui est vétilleux dans les moindres choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ff82f6a-03d6-47d3-930c-5adee613f030",
                                                "sense_id": "4ae595ac-cec5-3bc6-85c5-9cfcd4aade09",
                                                "text": "On ne peut vivre avec lui, il est trop formaliste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "formaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f04a1e46-f0e6-3a8e-8089-498bdadc07ba",
                                        "entry_id": "94f96ef5-7e8b-30a5-afee-f711917b0866",
                                        "glosses": [
                                            "Celui, celle qui s’attache scrupuleusement aux formes, aux formalités."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f03cbbea-d017-3434-9d0b-420d6b11c4e2",
                                        "entry_id": "94f96ef5-7e8b-30a5-afee-f711917b0866",
                                        "glosses": [
                                            "Artiste dont l'œuvre n'était pas conforme aux canons du réalisme soviétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec76ef7f-5210-4db7-8898-59c8e20cc118",
                                                "sense_id": "f03cbbea-d017-3434-9d0b-420d6b11c4e2",
                                                "text": "J'ai pu voir à Tiflis une exposition de peintures modernes, dont il serait peut-être charitable de ne point parler. […]. Ah! certes, ceux-là n'étaient pas des «formalistes»! Le malheur, c'est qu'ils n'étaient pas des peintres non plus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
