                "senses": [
                    {
                        "sense_id": "027c4651-a94f-38d0-a8b0-a7d4caaff296",
                        "entry_id": "653da9d8-a7d3-3fa1-b64d-19f87c510c30",
                        "glosses": [
                            "wie of wat als eerste voorkomt in een opsomming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7de04b4-6b1d-4d09-b882-10e26e2d52bd",
                                "sense_id": "027c4651-a94f-38d0-a8b0-a7d4caaff296",
                                "text": "Eerstgenoemd ministerie wordt geleid door minister Jens Spahn van de CDU, het tweede door ‘partijvriend’ Horst Seehofer en het derde ook door iemand van de CSU."
                            },
                            {
                                "example_id": "c4ba8fd7-169b-4a40-94c3-9b73df0120e8",
                                "sense_id": "027c4651-a94f-38d0-a8b0-a7d4caaff296",
                                "text": "Het percentage volledig gevaccineerden dat zeker een extra prik wil halen, is het grootst in Limburg en Drenthe. Vooral in de eerstgenoemde provincie kan lang niet iedereen een extra prik halen zodra hun leeftijdsgroep aan de beurt is. In november zijn namelijk relatief veel Limburgers positief getest op het virus, 1 op de 23 mensen. Zij mogen pas zes maanden na besmetting een boosterprik halen."
                            }
                        ]
                    }
