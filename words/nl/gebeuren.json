                                "es": "Todo el <w>acontecimiento</w> en torno a la boda estuvo bellamente organizado.",
                                "pl": "Całe <w>wydarzenie</w> wokół wesela było wspaniale zorganizowane.",
                                "de": "Das ganze <w>Geschehen</w> rund um die Hochzeit war wunderschön organisiert.",
                                "fr": "Tout l'<w>événement</w> autour du mariage était magnifiquement organisé.",
                                "it": "L'intero <w>evento</w> intorno al matrimonio era organizzato magnificamente.",
                                "cs": "Celé to <w>dění</w> kolem svatby bylo krásně zorganizované.",
                                "tr": "Düğünle ilgili tüm <w>organizasyon</w> harika bir şekilde düzenlenmişti."
                            }
                        },
                        {
                            "text": "Zij keek met verbazing naar het vreemde <w>gebeuren</w> op straat.",
                            "target_lang_translations": {
                                "en": "She watched the strange <w>goings-on</w> on the street with amazement.",
                                "ru": "Она с удивлением наблюдала за странным <w>происходящим</w> на улице.",
                                "es": "Ella miraba con asombro los extraños <w>sucesos</w> de la calle.",
                                "pl": "Z ze zdziwieniem przyglądała się temu dziwnemu <w>zajściu</w> na ulicy.",
                                "de": "Sie beobachtete mit Erstaunen das seltsame <w>Treiben</w> auf der Straße.",
                                "fr": "Elle regardait avec étonnement les étranges <w>événements</w> dans la rue.",
                                "it": "Lei guardava con stupore lo strano <w>accadimento</w> per strada.",
                                "cs": "S údivem sledovala to zvláštní <w>dění</w> na ulici.",
                                "tr": "Sokaktaki garip <w>olayları</w> şaşkınlıkla izledi."
                            }
