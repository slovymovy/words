                                        "glosses": [
                                            "On a boat, the vertical side of above-deck structures, such as the coach roof, hatch, and cockpit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bb56d22-d266-33d1-b0b2-e103b8a9663c",
                                        "entry_id": "cbef05c7-8daf-3a1f-adc3-be8761fd74bb",
                                        "glosses": [
                                            "A raised frame, designed to deflect or prevent entry of water, around an opening (e.g., a hatch or skylight) in a flat surface, such as a roof or deck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ec718a-903a-404e-b4bb-1ec0a647ca4e",
                                                "sense_id": "6bb56d22-d266-33d1-b0b2-e103b8a9663c",
                                                "text": "Creepers threaded the wrecked windows of the coaches, ancient and chalky brown with their riveted seams and welted coamings like something proofed for descents into the sea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
