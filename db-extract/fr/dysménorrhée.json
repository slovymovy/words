                    {
                        "sense_id": "30f4f08c-999b-3b2c-bd9c-33e3710995f0",
                        "entry_id": "40a15cff-6768-3122-968d-8a96fed95093",
                        "glosses": [
                            "Difficulté de l’écoulement des règles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f44eeaf-c3de-4674-97e6-290790c43a87",
                                "sense_id": "30f4f08c-999b-3b2c-bd9c-33e3710995f0",
                                "text": "Les plus fréquents symptômes sont les douleurs. Des douleurs (dysménorrhée) qui viennent pendant et après les règles, douleurs pendant les rapports sexuels (dyspareunie), douleurs pelviennes fréquentes, défécation douloureuse, difficulté pour uriner (dysurie), abdominales (ombilicales), douleurs pelviennes pouvant irradier jusque dans la jambe (cruralgie), etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4bd7042-37d8-368d-be58-6c38ddfc0346",
                        "entry_id": "40a15cff-6768-3122-968d-8a96fed95093",
                        "glosses": [
                            "Règles douloureuses ou algoménorrhée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c93f7ef2-56c7-4d02-a6c4-675cdf83f8cc",
                                "sense_id": "a4bd7042-37d8-368d-be58-6c38ddfc0346",
                                "text": "La dysménorrhée est l’ensemble des douleurs pelviennes précédant ou accompagnant les règles."
                            }
                        ]
                    }
                ],
                "translations": [
