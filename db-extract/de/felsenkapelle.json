                ],
                "senses": [
                    {
                        "sense_id": "cea23a1d-cbb0-30ed-9c39-c77642d5364b",
                        "entry_id": "db17d9b9-debb-38dd-8bd0-615744f07098",
                        "glosses": [
                            "in den Fels geschlagene Kapelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e20406-7f6d-4efd-bb34-c0b2d3e3ee18",
                                "sense_id": "cea23a1d-cbb0-30ed-9c39-c77642d5364b",
                                "text": "„Zahlreiche Wissenschaftler, Forschungseinrichtungen und Restauratoren waren an der aufwändigen Konservierung der sogenannten Ölbergszene in der oberen Salvator-Felsenkapelle beteiligt.“"
                            },
                            {
                                "example_id": "982390b6-95e2-426e-afc9-5befbb5b5cfe",
                                "sense_id": "cea23a1d-cbb0-30ed-9c39-c77642d5364b",
                                "text": "„Gradonna - wie das Gebiet um die Felsenkapelle auch genannt wird - soll in der Zeit von 9.000 bis 5.300 vor Christus eine Kultstätte gewesen sein.“"
                            },
                            {
                                "example_id": "3ab77cf9-1cc3-4bf6-9692-e1747e39496d",
                                "sense_id": "cea23a1d-cbb0-30ed-9c39-c77642d5364b",
                                "text": "„Einige in die dort anstehende Burgsandsteinwand eingeschlagene Nischen, Reste einer Steintreppe und die durch ein altes Holztor verschlossene Felsenkapelle sind die heute noch sichtbaren Rudimente der mittelalterlichen Heiligenverehrung.“"
                            },
                            {
                                "example_id": "05a64a40-f522-4698-9d28-ff55d8e6daca",
                                "sense_id": "cea23a1d-cbb0-30ed-9c39-c77642d5364b",
                                "text": "„Über den unteren Kirchenvorplatz gelangt man in die unter der Pfarrkirche gelegene Felsenkapelle.“"
                            },
                            {
                                "example_id": "7b1d7188-1ebe-455d-a5c9-d510d82fdb17",
                                "sense_id": "cea23a1d-cbb0-30ed-9c39-c77642d5364b",
                                "text": "„Die Felsenkapelle in Artenara (Zentrales Bergland) solltet Ihr in jedem Fall besichtigen, denn die Marienfigur in der kleinen Kapelle soll schon im 14. Jahrhundert durch Missionare aus Mallorca hierhin gekommen sein.“"
                            },
                            {
                                "example_id": "e6fab60f-44d4-4bb1-b229-9d7f6e9b7fa7",
                                "sense_id": "cea23a1d-cbb0-30ed-9c39-c77642d5364b",
                                "text": "„Aus dem Dokument vom 18. Oktober 1707 erfahren wir, dass Anton d’Alt, Generalvikar des Bistums Lausanne und Propst von St. Nikolaus Freiburg in der Morgenfrüh zwei Felsenkapellen feierlich geweiht hat.“"
                            },
                            {
                                "example_id": "f3c0cd23-8b4d-4e49-ac4b-6db25705e691",
                                "sense_id": "cea23a1d-cbb0-30ed-9c39-c77642d5364b",
                                "text": "„Die Felsenkapelle ist aus dem Felsen gehauen, neugotisch mit gemauertem Reiter unverputztem Steinmauerwerk spitzbogigen Fenstern und Naturgewölbe mit einem sehr netten Rokoko-Altärchen mit dem Bild des heiligen Michael.“"
                            },
                            {
                                "example_id": "ee3e53f2-80ae-4153-97c0-0b600c7f53bf",
                                "sense_id": "cea23a1d-cbb0-30ed-9c39-c77642d5364b",
                                "text": "„Die Felsenkapelle befindet sich im Innergschlöß, dem schönsten Talschluß der Alpen.“"
                            },
                            {
                                "example_id": "7e0bdd69-5581-4a31-b982-2549f152f01e",
                                "sense_id": "cea23a1d-cbb0-30ed-9c39-c77642d5364b",
                                "text": "„Schon lange wollte ich mir diese Felsenkapelle am Isteiner Klotz im Markgräflerland im Südwesten von Deutschland mal genauer ansehen, aber irgendwie geriet es immer wieder hintenan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a053389d-ce64-3725-870c-8f54a47c78ba",
                        "entry_id": "db17d9b9-debb-38dd-8bd0-615744f07098",
                        "glosses": [
                            "auf oder zwischen den Felsen errichtete Kapelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34358b5-1e19-4089-8bee-eac6c12c2b76",
                                "sense_id": "a053389d-ce64-3725-870c-8f54a47c78ba",
                                "text": "„Die Felsenkapelle ist aus dem Felsen gehauen, neugotisch mit gemauertem Reiter unverputztem Steinmauerwerk spitzbogigen Fenstern und Naturgewölbe mit einem sehr netten Rokoko-Altärchen mit dem Bild des heiligen Michael.“"
                            },
                            {
                                "example_id": "95f0283e-7fe6-4e12-a305-b0ab89ee654d",
                                "sense_id": "a053389d-ce64-3725-870c-8f54a47c78ba",
                                "text": "„Die Felsenkapelle befindet sich im Innergschlöß, dem schönsten Talschluß der Alpen.“"
                            },
                            {
                                "example_id": "29402edc-32a0-4799-99e4-b573bfacc9f9",
                                "sense_id": "a053389d-ce64-3725-870c-8f54a47c78ba",
                                "text": "„Schon lange wollte ich mir diese Felsenkapelle am Isteiner Klotz im Markgräflerland im Südwesten von Deutschland mal genauer ansehen, aber irgendwie geriet es immer wieder hintenan.“"
                            },
                            {
                                "example_id": "23e66057-e883-4b4e-b56f-c1049b71670a",
                                "sense_id": "a053389d-ce64-3725-870c-8f54a47c78ba",
                                "text": "„Bischof Felix Gmür weihte am Sonntag die sagenumwobene Felsenkapelle auf der Rigi ein.“"
                            },
                            {
                                "example_id": "a7fb5926-db8f-47eb-9498-872f2cfd7a2d",
                                "sense_id": "a053389d-ce64-3725-870c-8f54a47c78ba",
                                "text": "„Der Name Felsenkapelle weist auf die zwischen Felsen gelegene Kapelle.“"
                            },
                            {
                                "example_id": "573fdbe1-9aeb-4a2c-86d6-38e65810b43d",
                                "sense_id": "a053389d-ce64-3725-870c-8f54a47c78ba",
                                "text": "„Einen knappen Kilometer weiter kommt man dann an der genannten Felsenkapelle vorbei, hinter der sich ein anmutiges Tal öffnet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
