                        "source_sense_id": "bb83e984-295c-3dbb-a0e4-4044e74cefb9",
                        "target_lang_word": "mercerisage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mercerisage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "347d7d70-473b-3a85-ae52-2566aa16a7f0",
                                        "entry_id": "1b64ff73-c3ad-314f-bcd1-18a14996764b",
                                        "glosses": [
                                            "Opération consistant à donner aux fils et étoffes de coton un aspect brillant et soyeux, par trempage dans une solution d'hydroxyde de sodium (soude caustique) à 30° Baumé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698e0331-ad4d-4891-91fb-40e3e735d81c",
                                                "sense_id": "347d7d70-473b-3a85-ae52-2566aa16a7f0",
                                                "text": "Pour obtenir une attaque rapide de la cellulose, il est nécessaire de la transformer en hydrocellulose par un mercerisage préalable dans la soude caustique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d0690af-6e2f-4fd2-9a73-afeaa68aa20c",
                        "source_entry_id": "51be3a7e-174d-33a1-a8e6-cff80dd99be6",
                        "source_sense_id": "bb83e984-295c-3dbb-a0e4-4044e74cefb9",
                        "target_lang_word": "trempage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trempage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1b33d74-c195-321e-b812-43481bdf4de9",
                                        "entry_id": "6e354d1f-c306-3616-87be-c06bc32b1417",
                                        "glosses": [
                                            "Action de tremper, d’humecter d’eau ou d'une solution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608a7ccc-ff04-40ef-8fde-e4bab846cf04",
                                                "sense_id": "b1b33d74-c195-321e-b812-43481bdf4de9",
                                                "text": "Le trempage doit être fait jusqu'à complète imbibition et avec le moins de manipulation possible …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f24ae87-9637-351a-a5da-04cc8e4e09e9",
                                        "entry_id": "6e354d1f-c306-3616-87be-c06bc32b1417",
                                        "glosses": [
                                            "Technique d’émaillage."
                                        ],
                                        "tags": [
                                            "Céramique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b88e925b-057f-3892-8b87-f8d4e68e7095",
                                        "entry_id": "6e354d1f-c306-3616-87be-c06bc32b1417",
                                        "glosses": [
                                            "Alourdissement des noix de Saint-Jacques par immersion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c79a8db-3228-4d88-978c-49cb4e33bf3b",
                                                "sense_id": "b88e925b-057f-3892-8b87-f8d4e68e7095",
                                                "text": "D’où la contrebande et la fameuse pratique du trempage, qui consiste à plonger les noix dans un bain d’eau assaisonnée de polyphosphates, histoire de les gorger de flotte pour qu’elles pèsent plus lourd."
                                            },
                                            {
                                                "example_id": "f4d49f0e-c6a3-4437-8b85-a0a3689e27ae",
                                                "sense_id": "b88e925b-057f-3892-8b87-f8d4e68e7095",
                                                "text": "Si l’on s’en tient à la réglementation française, le trempage et l’emploi de polyphosphates sur la noix fraîche sont interdits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4392cf9b-65e6-3619-8aee-cac2e1116c04",
                                        "entry_id": "6e354d1f-c306-3616-87be-c06bc32b1417",
                                        "glosses": [
                                            "Forme d’activité sexuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a410dc-e589-4479-9ead-0770545c1df1",
                                                "sense_id": "4392cf9b-65e6-3619-8aee-cac2e1116c04",
                                                "text": "L’homme s’introduit dans sa partenaire, mais il n’y a aucun mouvement de va-et-vient. Les deux restent ainsi, d’où l’idée de « trempage »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
