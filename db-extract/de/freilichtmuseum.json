                    {
                        "sense_id": "6eacdb86-4142-336f-95e1-fc0d7b10aeec",
                        "entry_id": "e5898090-2041-3000-8064-44957de18734",
                        "glosses": [
                            "Institution, die eine Sammlung interessanter Bauten beziehungsweise Gegenstände für die Öffentlichkeit begehbar macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7fd1c1e-b048-4115-a2fd-550cb216e8ea",
                                "sense_id": "6eacdb86-4142-336f-95e1-fc0d7b10aeec",
                                "text": "„Aus der alten Walfangstation soll in den kommenden Jahren ein maritimes Freilichtmuseum werden.“"
                            },
                            {
                                "example_id": "a5ac156c-678b-4d39-9f21-92effd9d3906",
                                "sense_id": "6eacdb86-4142-336f-95e1-fc0d7b10aeec",
                                "text": "„Die Kleinstadt erscheint mir wie ein monumentales Freilichtmuseum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
