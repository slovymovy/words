                "senses": [
                    {
                        "sense_id": "d73ff445-bbcd-348d-a696-87e6cc0f3381",
                        "entry_id": "287cd331-ec8f-3704-bf29-895e412e8fe7",
                        "glosses": [
                            "Ausnutzung von Preisunterschieden für ein und dasselbe Gut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19db11d4-c524-4fca-a267-7e4c1a3232b8",
                                "sense_id": "d73ff445-bbcd-348d-a696-87e6cc0f3381",
                                "text": "Man kann bei Geschäften mit der Arbitrage oft nur mit einer ausgesprochen geringen Gewinnspanne rechnen."
                            },
                            {
                                "example_id": "b711663f-2e3b-4144-872d-da7bd5f1dc3e",
                                "sense_id": "d73ff445-bbcd-348d-a696-87e6cc0f3381",
                                "text": "„Die Arbitrage ist des Händlers Liebling: ein Gut billig irgendwo erwerben, es teuer woanders weiterverkaufen - so machen Profis Millionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55deea8b-d3cc-4b87-aae4-10d2d16a731b",
                        "source_entry_id": "287cd331-ec8f-3704-bf29-895e412e8fe7",
                        "source_sense_id": "d73ff445-bbcd-348d-a696-87e6cc0f3381",
                        "source_sense_description": "Wirtschaft: Ausnutzung von Preisunterschieden für ein und dasselbe Gut",
                        "target_lang_word": "arbitrage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arbitrage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f180575-92c6-3287-981a-ac81102c6881",
                                        "entry_id": "8b00754e-f86e-3626-aea2-aa3441f6dc83",
                                        "glosses": [
                                            "A market activity in which a security, commodity, currency or other tradable item is bought in one market and sold simultaneously in another, in order to profit from price differences between the markets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c17d52b-ceb0-4d32-a129-faf094e447e1",
                                                "sense_id": "8f180575-92c6-3287-981a-ac81102c6881",
                                                "text": "But in recent years, for reasons we shall develop later, the field of \"arbitrages and workouts\" became riskier and less profitable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bbd460a-392a-34a6-9dbf-ff40e5181594",
                                        "entry_id": "8b00754e-f86e-3626-aea2-aa3441f6dc83",
                                        "glosses": [
                                            "Arbitration."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arbitrage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79686348-b233-307b-8dc0-0f058501189a",
                                        "entry_id": "e6333be8-6ba4-3ab0-8d6d-9e3c15cbc571",
                                        "glosses": [
                                            "To employ arbitrage"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a4a010-a86c-4220-bf19-547cf9129bfd",
                                                "sense_id": "79686348-b233-307b-8dc0-0f058501189a",
                                                "text": "He has arbitraged by purchasing in one market and simultaneously selling the same or similar merchandise in another market."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44defe97-78ca-322a-a91d-43c1d14cbb64",
                                        "entry_id": "e6333be8-6ba4-3ab0-8d6d-9e3c15cbc571",
                                        "glosses": [
                                            "To engage in arbitrage in, between, or among"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff53781-3d95-4368-9640-56cb501cee11",
                                                "sense_id": "44defe97-78ca-322a-a91d-43c1d14cbb64",
                                                "text": "Indeed, as banks become more adept at internal risk classifications, their incentives to arbitrage economic and regulatory capital can only increase"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb9b5dee-64e6-4ccf-9770-2d49e9967c55",
