                ],
                "senses": [
                    {
                        "sense_id": "6811fe11-d615-30d8-8a96-8d3d4a6d6187",
                        "entry_id": "219651dd-9f70-38cd-b89c-18eaa815b133",
                        "glosses": [
                            "Vêtement pour bébé qui est porté pour dormir, et qui ne laisse découverts que la tête et parfois les bras."
                        ],
                        "tags": [
                            "Puériculture"
                        ],
                        "examples": [
                            {
                                "example_id": "6d0955f1-ad88-4192-b120-e22bd1505997",
                                "sense_id": "6811fe11-d615-30d8-8a96-8d3d4a6d6187",
                                "text": "Au bout de quelques semaines, vous pouvez mettre votre bébé dans un nid d’ange – une gigoteuse qui s'adapte parfaitement sur les épaules et qu'il ne peut retirer la nuit, ce qui risquerait de le faire pleurer parce qu'il aurait trop froid."
                            },
                            {
                                "example_id": "7513c9bb-8444-44ad-9541-9a6263a92a60",
                                "sense_id": "6811fe11-d615-30d8-8a96-8d3d4a6d6187",
                                "text": "Il était étendu sur le dos, sage, dans sa gigoteuse, semblant dormir. Sauf qu'à proximité, sur la housse de couette, il y avait une trace de régurgitation. C'était effectivement du vomi, le vomi dû à la pression de la mère qui l'a tué."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8a0078b-bd27-3360-85d3-efdebc7ea096",
                        "entry_id": "219651dd-9f70-38cd-b89c-18eaa815b133",
                        "glosses": [
                            "Celle qui gigote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab6e24f-fb59-4e40-b67b-a8808f75c7c1",
                                "sense_id": "a8a0078b-bd27-3360-85d3-efdebc7ea096",
                                "text": "Devant la force de la gigoteuse de flamenco et craignant les conséquences d'une descente de police, la faiseuse d'intrigues continua son chemin sans protester."
                            }
                        ]
                    }
                ],
