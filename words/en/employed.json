                {
                    "sense_id": "59b00976-492d-382a-8bca-d9d37a8fede3",
                    "sense_definition": "Kept in use or service; utilized for a specific purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The methods <w>employed</w> in this study are quite innovative.",
                            "target_lang_translations": {
                                "ru": "Методы, <w>использованные</w> в этом исследовании, довольно инновационны.",
                                "de": "Die in dieser Studie <w>angewandten</w> Methoden sind recht innovativ.",
                                "pl": "Metody <w>zastosowane</w> w tym badaniu są dość innowacyjne.",
                                "tr": "Bu çalışmada <w>kullanılan</w> yöntemler oldukça yenilikçidir.",
                                "zh": "这项研究中<w>采用</w>的方法相当创新。"
                            }
                        },
                        {
                            "text": "Several different strategies were <w>employed</w> to solve the complex problem.",
                            "target_lang_translations": {
                                "ru": "Для решения этой сложной задачи были <w>применены</w> несколько различных стратегий.",
                                "de": "Es wurden verschiedene Strategien <w>eingesetzt</w>, um das komplexe Problem zu lösen.",
                                "pl": "Do rozwiązania tego złożonego problemu <w>wykorzystano</w> kilka różnych strategii.",
                                "tr": "Karmaşık sorunu çözmek için birkaç farklı stratejiye <w>başvuruldu</w>.",
                                "zh": "为了解决这个复杂的问题，人们<w>运用</w>了几种不同的策略。"
                            }
                        }
                    ],
                    "synonyms": [
                        "used",
                        "utilized",
                        "applied"
                    ],
                    "antonyms": [
                        "unused",
                        "discarded"
                    ],
                    "common_phrases": [
                        "widely employed",
                        "commonly employed",
                        "rarely employed",
                        "strategies employed"
                    ],
                    "target_lang_definitions": {
