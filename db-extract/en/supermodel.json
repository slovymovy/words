                        "entry_id": "9820726f-e66e-3d0b-a21f-21a06222eb72",
                        "glosses": [
                            "A highly paid, famous fashion model."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a781800-27d3-4ad1-a556-7cefc1e49501",
                                "sense_id": "9840eed6-3350-3259-a04d-be2df2056f79",
                                "text": "Kendall Jenner first earned the title of the \"world's highest paid supermodel\" in 2018 when Forbes released an article asserting that she had raked in $22.5 million that year."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf2296cd-2bc9-3ebe-aa5a-1b59ec91c862",
