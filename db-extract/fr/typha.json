                "senses": [
                    {
                        "sense_id": "2bd06df1-6fc8-3f59-90e4-7329ce45b71e",
                        "entry_id": "59a6826e-b439-35ce-803b-4b846a941fb3",
                        "glosses": [
                            "Massette d’eau ^([1]), plante monocotylédone poussant dans les milieux humides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd4be335-23cd-4068-b057-f4fe516b4bbb",
                                "sense_id": "2bd06df1-6fc8-3f59-90e4-7329ce45b71e",
                                "text": "Les racines ou, pour mieux dire, les rhizomes des typha se ramifient beaucoup, s’étendent en tous sens."
                            },
                            {
                                "example_id": "0570db93-7627-4f60-9450-76a16fa9593f",
                                "sense_id": "2bd06df1-6fc8-3f59-90e4-7329ce45b71e",
                                "text": "Les feuilles de typhas contiennent des fibres assez grossières, mais qui peuvent néanmoins être substituées au jute dans la sacherie, la corderie, la grosse ficellerie."
                            },
                            {
                                "example_id": "f8f12642-a4f6-4977-a75e-c1fe83f37fa0",
                                "sense_id": "2bd06df1-6fc8-3f59-90e4-7329ce45b71e",
                                "text": "Est ainsi détaillé tout ce qui procède de la protection, de l’exploitation et de la gestion du lac, de la lutte contre l’expansion des plantes envahissantes, le typha australis en particulier, de la lutte contre la prolifération de la bilharziose et des autres maladies liées à l’eau."
                            }
                        ]
                    }
                ],
