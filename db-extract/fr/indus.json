                                        "entry_id": "b329962a-eba8-320a-bf9d-6d22068fe5f3",
                                        "glosses": [
                                            "A major river in China, India and Pakistan, rising in Tibet and flowing into the Arabian Sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddbc1ac0-e775-4a42-a143-6df840fb3be1",
                                                "sense_id": "8b4a7eda-ce3c-39ae-98e1-4f2afbef3ce7",
                                                "text": "The mighty Indus River that courses through Pakistan's second-most populous region is fed by dozens of mountain tributaries to the north, but many have burst their banks following record rains and glacier melt."
                                            },
                                            {
                                                "example_id": "813785b3-a612-4b6a-8546-60b3df9eeb25",
                                                "sense_id": "8b4a7eda-ce3c-39ae-98e1-4f2afbef3ce7",
                                                "text": "Floods in the river Sutlej – which originates in Tibet and crosses India before merging into the Indus river – has completely cut off several villages and areas in Pakistan, submerging hundreds of hectares of farmland."
                                            }
                                        ]
                                    }
                                ]
                            },
