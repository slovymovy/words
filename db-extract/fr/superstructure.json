        "fr-extract.jsonl": [
            {
                "entry_id": "eea4836d-b1bb-3d9c-a59c-d8bbdebaad56",
                "word": "superstructure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bd192791-bd07-40ed-9199-717af371013f",
                        "entry_id": "eea4836d-b1bb-3d9c-a59c-d8bbdebaad56",
                        "tags": [
                            "plural"
                        ],
                        "form": "superstructures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ca383c7-d790-3b63-a1c9-e7878d588961",
                        "entry_id": "eea4836d-b1bb-3d9c-a59c-d8bbdebaad56",
                        "glosses": [
                            "Ouvrage fait au-dessus d’un certain niveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643c2294-aaea-4f78-94a5-a75b8516ef70",
                                "sense_id": "1ca383c7-d790-3b63-a1c9-e7878d588961",
                                "text": "Mais pour l’anarchisme, l’appareil d’État n’est pas seulement une superstructure ; il est une structure autonome, dont la logique est de s’autoreproduire en engendrant une technocratie privilégiée."
                            }
                        ]
                    },
                    {
                        "sense_id": "0cec4f3b-140c-3fb5-94cc-ae228d659c3e",
                        "entry_id": "eea4836d-b1bb-3d9c-a59c-d8bbdebaad56",
                        "glosses": [
                            "Se dit des travaux exécutés par-dessus les terrassements et les ouvrages d’art."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "66a7ad75-1f94-38fb-8603-d068dea493ad",
                        "entry_id": "eea4836d-b1bb-3d9c-a59c-d8bbdebaad56",
                        "glosses": [
                            "Ce qui est construit au-dessus du pont d’un bateau."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "e071165d-cf36-4f99-88da-7206385a73b7",
                                "sense_id": "66a7ad75-1f94-38fb-8603-d068dea493ad",
                                "text": "Dialectiquement parlant, c'est l'impérialisme et ses valets qui ont écrit notre histoire, nous devons renverser les choses car la superstructure ne devrait pas l'emporter sur l'infrastructure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ced8282-3fb6-4b58-afa5-580c16475f15",
                        "source_entry_id": "eea4836d-b1bb-3d9c-a59c-d8bbdebaad56",
                        "source_sense_id": "1ca383c7-d790-3b63-a1c9-e7878d588961",
                        "source_sense_description": "Ouvrage fait au-dessus d’un certain niveau.",
                        "target_lang_word": "superstructure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
