{
    "word_family": [
        "nervous",
        "nervously",
        "nervousness",
        "nervy",
        "unnerve",
        "innervate",
        "innervation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ed80430-c80c-3c6d-8b95-963a24a314e5",
                    "sense_definition": "One's mental state, patience, or tolerance, primarily used in idioms referring to irritation or annoyance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise from the construction site is really getting on my <w>nerves</w>.",
                            "target_lang_translations": {
                                "ru": "Постоянный шум со стройки действительно действует мне на <w>нервы</w>.",
                                "zh": "工地持续不断的噪音真让我<w>神经</w>衰弱。"
                            }
                        },
                        {
                            "text": "His habit of interrupting people gets on everyone's <w>nerves</w> eventually.",
                            "target_lang_translations": {
                                "ru": "Его привычка перебивать людей в конце концов начинает действовать всем на <w>нервы</w>.",
                                "zh": "他打断别人说话的习惯最终会让所有人的<w>神经</w>感到烦躁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get on someone's nerves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Психическое состояние, терпение или самообладание; часто используется в идиомах, обозначающих раздражение.",
                        "zh": "指人的精神状态、耐心或忍耐力，常用于表示烦躁或恼火的习语中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нервы",
                                "target_lang_sense_clarification": "раздражительность, психическое состояние"
                            },
                            {
                                "target_lang_word": "терпение",
                                "target_lang_sense_clarification": "способность сохранять спокойствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "神经",
                                "target_lang_sense_clarification": "指精神状态或易受刺激的状态"
                            },
                            {
                                "target_lang_word": "耐心",
                                "target_lang_sense_clarification": "指保持冷静的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5d0d7cb-f711-30f5-a634-4cf440046b4e",
                    "sense_definition": "A bundle of fibers in the body that transmits impulses of sensation to the brain or spinal cord, and impulses from these to the muscles and organs.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The optic <w>nerve</w> carries visual information from the eye to the brain.",
                            "target_lang_translations": {
                                "ru": "Зрительный <w>нерв</w> передает визуальную информацию от глаза к мозгу.",
                                "zh": "视<w>神经</w>将视觉信息从眼睛传导至大脑。"
                            }
                        },
                        {
                            "text": "Damage to a <w>nerve</w> in his leg caused him to walk with a limp.",
                            "target_lang_translations": {
                                "ru": "Повреждение <w>нерва</w> в ноге заставило его хромать.",
                                "zh": "他腿部的一根<w>神经</w>受损，导致他走路一瘸一拐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "optic nerve",
                        "sciatic nerve",
                        "pinch a nerve",
                        "nerve damage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пучок волокон в организме, передающий импульсы ощущений в мозг или спинной мозг и от них к мышцам и органам.",
                        "zh": "人体内传递感觉冲动至大脑或脊髓，并将冲动从这些部位传导至肌肉和器官的纤维束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нерв",
                                "target_lang_sense_clarification": "анатомический орган"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "神经",
                                "target_lang_sense_clarification": "解剖学器官"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a73f7e78-4677-3525-8496-b9e8f450c674",
                    "sense_definition": "A state of mental agitation, anxiety, or fear caused by stress or anticipation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was a bundle of <w>nerves</w> before her driving test.",
                            "target_lang_translations": {
                                "ru": "Она была как комок <w>нервов</w> перед экзаменом по вождению.",
                                "zh": "驾照考试前，她紧张得像一团乱麻，满脑子都是<w>神经</w>质的念头。"
                            }
                        },
                        {
                            "text": "He drank some herbal tea to help calm his <w>nerves</w> before the speech.",
                            "target_lang_translations": {
                                "ru": "Он выпил травяного чая, чтобы успокоить <w>нервы</w> перед выступлением.",
                                "zh": "演讲前，他喝了些花草茶来平复<w>神经</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bundle of nerves",
                        "calm one's nerves",
                        "bad case of nerves"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние душевного волнения, тревоги или страха, вызванное стрессом или ожиданием.",
                        "zh": "由压力或预期引起的精神激动、焦虑或恐惧状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нервы",
                                "target_lang_sense_clarification": "волнение, переживания"
                            },
                            {
                                "target_lang_word": "волнение",
                                "target_lang_sense_clarification": "беспокойство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "神经",
                                "target_lang_sense_clarification": "指紧张、焦虑的情绪"
                            },
                            {
                                "target_lang_word": "紧张",
                                "target_lang_sense_clarification": "指不安或焦虑的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b54c19e-689e-349d-975f-75b06f8796a3",
                    "sense_definition": "Courage, boldness, or the ability to remain calm and controlled in a difficult or dangerous situation; also, impudence or audacity.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes a lot of <w>nerve</w> to stand up to a bully like that.",
                            "target_lang_translations": {
                                "ru": "Нужно иметь большую <w>смелость</w>, чтобы дать отпор такому хулигану.",
                                "zh": "要反抗那种恶霸，需要极大的<w>勇气</w>。"
                            }
                        },
                        {
                            "text": "I cannot believe he had the <w>nerve</w> to ask for a raise after missing so much work.",
                            "target_lang_translations": {
                                "ru": "Я не могу поверить, что у него хватило <w>наглости</w> просить о повышении после стольких пропусков работы.",
                                "zh": "真不敢相信，他旷工那么多天，竟然还<w>有脸</w>要求加薪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "courage",
                        "boldness",
                        "audacity",
                        "guts",
                        "pluck",
                        "spunk",
                        "bravery",
                        "daring"
                    ],
                    "common_phrases": [
                        "lose one's nerve",
                        "hold one's nerve",
                        "have the nerve",
                        "nerve of steel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смелость, дерзость или способность сохранять спокойствие в сложной ситуации; также наглость или бесцеремонность.",
                        "zh": "勇气、胆量，或在困难、危险情况下保持冷静和自控的能力；也指厚颜无耻或胆大妄为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наглость",
                                "target_lang_sense_clarification": "дерзость, бесцеремонность"
                            },
                            {
                                "target_lang_word": "смелость",
                                "target_lang_sense_clarification": "храбрость"
                            },
                            {
                                "target_lang_word": "выдержка",
                                "target_lang_sense_clarification": "самообладание"
                            },
                            {
                                "target_lang_word": "мужество",
                                "target_lang_sense_clarification": "стойкость духа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勇气",
                                "target_lang_sense_clarification": "胆量或胆识"
                            },
                            {
                                "target_lang_word": "厚脸皮",
                                "target_lang_sense_clarification": "指胆大妄为或无耻"
                            },
                            {
                                "target_lang_word": "定力",
                                "target_lang_sense_clarification": "指在压力下保持冷静的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "353752c1-9fd1-3e3d-be42-1c99b6ccf943",
                    "sense_definition": "A prominent vein in a leaf or a grain in wood.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The central <w>nerve</w> of the leaf is thick and clearly visible.",
                            "target_lang_translations": {
                                "ru": "Центральная <w>жилка</w> листа толстая и отчетливо видна.",
                                "zh": "叶片中央的<w>叶脉</w>很粗，清晰可见。"
                            }
                        },
                        {
                            "text": "Botanists study the pattern of the <w>nerves</w> to identify the plant species.",
                            "target_lang_translations": {
                                "ru": "Ботаники изучают рисунок <w>жилок</w> для идентификации видов растений.",
                                "zh": "植物学家通过研究<w>叶脉</w>的纹路来鉴定植物种类。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "botany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающая прожилка на листе или волокно в древесине.",
                        "zh": "叶片上突出的脉络或木材中的纹理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жилка",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叶脉",
                                "target_lang_sense_clarification": "植物学名词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ba166f43-b27a-3f87-9a34-a7088467fedc",
                    "sense_definition": "To give courage, strength, or steadiness to oneself or others, often in preparation for something difficult.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>nerve</w> herself before walking onto the stage.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>собраться с духом</w>, прежде чем выйти на сцену.",
                                "zh": "走上舞台前，她必须<w>鼓起勇气</w>。"
                            }
                        },
                        {
                            "text": "The soldiers <w>nerved</w> themselves for the approaching battle.",
                            "target_lang_translations": {
                                "ru": "Солдаты <w>собирали волю в кулак</w> перед предстоящей битвой.",
                                "zh": "士兵们为即将到来的战斗<w>振作</w>精神。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steel",
                        "brace",
                        "fortify",
                        "strengthen",
                        "invigorate"
                    ],
                    "common_phrases": [
                        "nerve oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать себе смелости, силы или стойкости, часто готовясь к чему-то трудному.",
                        "zh": "使自己或他人获得勇气、力量或坚定感，通常是为了应对困难的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собираться с духом",
                                "target_lang_sense_clarification": "набраться смелости"
                            },
                            {
                                "target_lang_word": "набраться храбрости",
                                "target_lang_sense_clarification": "подготовиться к действию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鼓起勇气",
                                "target_lang_sense_clarification": "为行动做心理准备"
                            },
                            {
                                "target_lang_word": "振作",
                                "target_lang_sense_clarification": "增强信心或力量"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}