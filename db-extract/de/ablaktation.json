                    {
                        "translation_id": "007419ab-89a3-472b-b0fd-7f7b826bacb2",
                        "source_entry_id": "e60621fb-51c2-318d-8ba7-4b204fa4cda2",
                        "source_sense_id": "fc606dc5-8e54-30e6-9bd2-4975eabfceeb",
