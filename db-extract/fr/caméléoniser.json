                "senses": [
                    {
                        "sense_id": "8444f670-e322-38b5-aebe-0f1af95ee88a",
                        "entry_id": "1c962a52-2ba4-3441-b4dc-1d80390518cb",
                        "glosses": [
                            "Se comporter comme un caméléon, par mimétisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cd5a246-7d60-43da-b5fc-8b28645dc5b5",
                                "sense_id": "8444f670-e322-38b5-aebe-0f1af95ee88a",
                                "text": "J'employai cet intervalle à assouplir mes idées et mon maintien, à me caméléoniser, et à l'heure indiquée je me rendis au collége romain, un des plus beaux palais de Rome, où les jésuites, sont établis."
                            },
                            {
                                "example_id": "575bcbfa-9b54-4f53-9c20-f12bdb923d10",
                                "sense_id": "8444f670-e322-38b5-aebe-0f1af95ee88a",
                                "text": "Comment fait-elle pour se caméléoniser ainsi?"
                            },
                            {
                                "example_id": "21942719-9bb9-43f5-b54a-e5cae0180a2b",
                                "sense_id": "8444f670-e322-38b5-aebe-0f1af95ee88a",
                                "text": "Elle a fini de caméléoniser, non ?"
                            }
                        ]
                    }
