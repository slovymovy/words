        "zh-extract.jsonl": [
            {
                "entry_id": "b278cf73-8544-3c0d-b9b9-bac8a5ac126c",
                "word": "dereliction",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b85ffd1b-f5fb-4450-a0d7-2b8b890b0240",
                        "entry_id": "b278cf73-8544-3c0d-b9b9-bac8a5ac126c",
                        "tags": [
