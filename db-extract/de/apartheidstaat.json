                "senses": [
                    {
                        "sense_id": "712b3008-a3a9-3fd9-b786-717902ec8109",
                        "entry_id": "98ef452a-4e18-3eb0-a429-49a183105f34",
                        "glosses": [
                            "Staat, der gegenüber seiner Bevölkerung eine Politik der Apartheid betreibt, der also bestimmte Bevölkerungsgruppen wegen ihrer ethnischen Zugehörigkeit diskriminiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4f3fa47-dd53-4f75-84dc-727a82e94810",
                                "sense_id": "712b3008-a3a9-3fd9-b786-717902ec8109",
                                "text": "„Denn auch wenn es keine Rassengesetze gibt wie in Südafrika: Der Kongo unter belgischer Herrschaft funktioniert wie ein Apartheidstaat.“"
                            },
                            {
                                "example_id": "33dfd97c-18ca-455b-bac5-ed7ce4e1f2c4",
                                "sense_id": "712b3008-a3a9-3fd9-b786-717902ec8109",
                                "text": "„Vorster wollte durch direkte Verhandlungen mit afrikanischen Nachbarn, die vielleicht sogar zur Aufnahme diplomatischer Beziehungen führen könnten, internationale Anerkennung für den Apartheidstaat gewinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
