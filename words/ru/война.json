                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A state of hostility, quarrel, or acute rivalry between people.",
                        "zh": "人与人之间敌对、争吵或激烈竞争的状态。"
                    },
                    "translations": {
