                "senses": [
                    {
                        "sense_id": "0118f1ee-09af-30fe-9c50-b236829b3e28",
                        "entry_id": "2b5882d1-5ec9-3d79-a6bf-d854dd13e7bf",
                        "glosses": [
                            "System, das bei ausgeglichenem Luftdruck arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19901297-90d6-4993-9892-3a82e248cc5f",
                                "sense_id": "0118f1ee-09af-30fe-9c50-b236829b3e28",
                                "text": "Der Gleichdruck im und am Gebäude bei Windstille verhindert eine Zirkulation der Raumluft."
                            },
                            {
                                "example_id": "3171cd09-846e-4f9e-8e3b-fa6641cb8c37",
                                "sense_id": "0118f1ee-09af-30fe-9c50-b236829b3e28",
                                "text": "„Gleichdruck - Gasmischanlagen besitzen ein Mischerventil, das die Gaskomponenten unter gleichem Druck zusammenströmen lässt, wobei die Höhe des Druckes wählbar ist.“"
                            },
                            {
                                "example_id": "53982573-2b03-433e-a2be-8e667d13b311",
                                "sense_id": "0118f1ee-09af-30fe-9c50-b236829b3e28",
                                "text": "„Dabei sollte unterschieden werden in Gleichdruck und Überdruckturbinen, teil und vollbeaufschlagte Turbinen und in Hochdruck (1) in Mitteldruck (2) und (4) und Niederdruckturbinen (3) und (5).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
