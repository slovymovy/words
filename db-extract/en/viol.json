                                        "glosses": [
                                            "knie- of beenviool, een voorloper van de cello"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8c8c95-8f7f-48d9-beae-393c6a708138",
                                                "sense_id": "5131ed23-448f-356f-a5e2-eaeed9c3c031",
                                                "text": "De viola da gamba heeft net als bij de gitaar, fretten op de toets van de hals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "093e8085-a945-4dcf-ab09-1546f132ef97",
                        "source_entry_id": "00a64630-7f27-30d2-b0ec-068409028ce2",
                        "source_sense_description": "stringed instrument",
                        "target_lang_word": "viole de gambe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viole de gambe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6da90766-906a-3807-aad4-2dcea841b67d",
                                        "entry_id": "c3730e70-857d-361d-8646-d5e9fd949b0c",
                                        "glosses": [
                                            "Luth à cordes frottées, tenu verticalement entre les jambes à la manière du violoncelle, mais à la touche garnie de frettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8998c3c8-0326-475d-95c2-fd3b85838408",
                                                "sense_id": "6da90766-906a-3807-aad4-2dcea841b67d",
                                                "text": "Des chansons à boire de l’époque baroque ont été interprétées par le jeune ensemble Le Mystère, invité du Petit festival 2022 et composé de Marie Poupardin, dessus ; Quentin Fondecave, basson baroque et flûtes à bec ; Lætitia Schneider, théorbe et guitare ; Julie Dutoit, viole de gambe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b55f0ef-14f1-4d21-80b0-da132f1ae476",
                        "source_entry_id": "00a64630-7f27-30d2-b0ec-068409028ce2",
                        "source_sense_description": "stringed instrument",
                        "target_lang_word": "Gambe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gambe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86c6d794-ad14-37da-b446-952d1d62d8e6",
                                        "entry_id": "774d3e6e-25b8-3cdd-b059-d03c116d3afd",
                                        "glosses": [
                                            "historisches Streichinstrument des 16. bis 18. Jahrhunderts, dessen Charakteristikum das Halten des Instruments zwischen den Beinen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a82033-3770-407d-943d-da3c01ddf5a9",
                                                "sense_id": "86c6d794-ad14-37da-b446-952d1d62d8e6",
                                                "text": "„Als um 1500 die Familien der Violinen und Gamben ausentwickelt waren, war die Trennung in zwei grundlegend verschiedene Klanggruppen vollzogen.“"
                                            },
                                            {
                                                "example_id": "5fe30407-4039-49dd-a93c-3be6014ed11c",
                                                "sense_id": "86c6d794-ad14-37da-b446-952d1d62d8e6",
                                                "text": "„Daß der Fürst in Christian Ferdinand Abel einen bedeutenden Virtuosen auf dem Violoncello und der Gambe engagiert hat, würde sich fast von selbst verstehen, wenn er, wie gelegentlich vermutet, selbst Gambe gespielt haben sollte.“"
                                            },
                                            {
                                                "example_id": "3a72d85a-d252-4cb7-8afd-171d717a6f92",
                                                "sense_id": "86c6d794-ad14-37da-b446-952d1d62d8e6",
                                                "text": "„Der war ein umjubelter Meister auf der Gambe und ein Freund Bachs seit Kindertagen, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3f020e3-fff5-4b2b-831d-5ab878df78ad",
                        "source_entry_id": "00a64630-7f27-30d2-b0ec-068409028ce2",
                        "source_sense_description": "stringed instrument",
                        "target_lang_word": "Viola da Gamba",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viola da Gamba",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41eca06c-649f-34e1-8cda-ac32a7078fab",
                                        "entry_id": "c478aed2-da52-3e44-a01c-3795f9f95a80",
                                        "glosses": [
                                            "historisches Streichinstrument mit fünf bis sieben Saiten, das beim Spielen zwischen den Beinen gehalten wird; kleinere Instrumente werden auf den Schoß gestellt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ebd0a1a-e66f-4631-83b8-82fa6539b27c",
                                                "sense_id": "41eca06c-649f-34e1-8cda-ac32a7078fab",
                                                "text": "„In der Konzertankündigung heißt es: Erst als die Barockzeit ausgeklungen war, haben die Franzosen ihr königliches Instrument – die Viola da Gamba – zugunsten des lauteren Violoncellos aufgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
