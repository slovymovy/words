                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6724e63-d807-4933-a0cd-f90bb711f0ec",
                                "sense_id": "87438055-0fe6-3485-96a5-b2b6cba04173",
                                "text": "Après chaque représentation, il faut nettoyer, laver, repasser, retuyauter ces légions d'alvéoles, ces ruches fragiles, dont des mains de femmes me font valoir en l'air la légèreté, la transparence, l'élégance."
                            },
                            {
                                "example_id": "84307430-0d76-4245-9c6c-853868491504",
                                "sense_id": "87438055-0fe6-3485-96a5-b2b6cba04173",
                                "text": "Si tu pouvais me retuyauter ce serait sympa."
                            }
                        ]
                    }
