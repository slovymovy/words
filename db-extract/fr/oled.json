                                "sense_id": "ce091dd2-ea3d-3962-9d7f-e279b49ff6c1",
                                "text": "Les téléviseurs LCD remplacés par les OLED ?"
                            },
                            {
                                "example_id": "de0caa08-f111-436b-9d66-523c88eda90f",
                                "sense_id": "ce091dd2-ea3d-3962-9d7f-e279b49ff6c1",
                                "text": "Les OLEDs et les LEDs fonctionnent sur le même principe : la recombinaison d’un électron et d’un trou."
                            },
                            {
                                "example_id": "252fe0a6-93c6-40cf-9d6c-8e05b3cea907",
                                "sense_id": "ce091dd2-ea3d-3962-9d7f-e279b49ff6c1",
                                "text": "Pour l’instant, les OLEDs ne sont utilisées que dans les écrans équipant les appareils nomades (appareils photos, téléphones cellulaires, montres…)"
                            }
                        ]
