                    },
                    {
                        "translation_id": "4af78dc8-4dd9-4e32-8544-d9a010472efc",
                        "source_entry_id": "8b7b599f-9e85-370b-bd3a-32dd29c4ed0a",
                        "source_sense_id": "30b85eb2-4fe2-35d9-a944-be180f86a188",
                        "target_lang_word": "independence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "independence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11e9b95c-0875-3e81-955b-217746cd8715",
                                        "entry_id": "2bb25789-7500-3d06-bef3-0f525e1df21f",
                                        "glosses": [
                                            "The quality or state of being independent; lack of dependence; the state of not being reliant on, or controlled by, others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "805f617e-c0d6-40ec-9bd6-8db60a98472c",
                                                "sense_id": "11e9b95c-0875-3e81-955b-217746cd8715",
                                                "text": "In 1947, India gained independence from the British Empire."
                                            },
                                            {
                                                "example_id": "a060a286-f8e3-4ffa-bd8d-d77185f8d714",
                                                "sense_id": "11e9b95c-0875-3e81-955b-217746cd8715",
                                                "text": "Bob the aforesaid, and his present chances of deriving a competent independence from the honourable profession to which he had devoted himself."
                                            },
                                            {
                                                "example_id": "82afc4d4-a9ee-4a45-bf45-e110901aa493",
                                                "sense_id": "11e9b95c-0875-3e81-955b-217746cd8715",
                                                "text": "[…] I had achieved my own living, preserved my independence, and become indebted to no one."
                                            },
                                            {
                                                "example_id": "7414c5a6-bb4c-44a6-8d28-af5e4217c0a4",
                                                "sense_id": "11e9b95c-0875-3e81-955b-217746cd8715",
                                                "text": "And this year, some of the granite facades have a new addition - the blue and yellow of the flag of Ukraine. It's hardly surprising to see the Scots, a nation more attuned to independence than some, showing solidarity with a country brutally invaded by Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d158f20c-b5eb-3cad-b5c6-a428e5e64893",
                                        "entry_id": "2bb25789-7500-3d06-bef3-0f525e1df21f",
                                        "glosses": [
                                            "The state of having sufficient means for a comfortable livelihood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1bd4bd1-3c01-40bf-b78c-fa1bf72396f1",
                        "source_entry_id": "8b7b599f-9e85-370b-bd3a-32dd29c4ed0a",
                        "source_sense_id": "30b85eb2-4fe2-35d9-a944-be180f86a188",
                        "target_lang_word": "незави́симость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "незави́симость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b038353d-ae7e-3108-88ad-c0eccbd0873a",
                                        "entry_id": "5cfd5165-3781-31e6-b2a0-f6ec5162f4d9",
                                        "glosses": [
                                            "свойство по значению прилагательного независимый; отсутствие зависимости от кого-либо или подчинения кому-либо; самостоятельность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb8836cb-6f30-4eb6-b73a-33442e0bef20",
                                                "sense_id": "b038353d-ae7e-3108-88ad-c0eccbd0873a",
                                                "text": "Являясь, таким образом, авангардом в борьбе китайского народа за независимость, кантонское правительство служит образцом для будущего революционно-демократического строительства в стране»."
                                            },
                                            {
                                                "example_id": "df820597-0f27-4546-a9b8-963489730239",
                                                "sense_id": "b038353d-ae7e-3108-88ad-c0eccbd0873a",
                                                "text": "Катастрофический сценарий кажется маловероятным, потому что Путину чрезвычайно важно сохранить то самое равновесие сил во власти, которое обеспечивает ему независимость от всех основных участников политического процесса."
                                            },
                                            {
                                                "example_id": "460c2867-8789-4130-a8f4-13534d5c6c3b",
                                                "sense_id": "b038353d-ae7e-3108-88ad-c0eccbd0873a",
                                                "text": "В то же время бизнес-слой наименее стабилен. Он постоянно \"выбрасывает\" из себя обанкротившихся и рекрутирует новых людей, стремящихся обрести финансовую независимость."
                                            },
                                            {
                                                "example_id": "72fc3a2d-3345-4451-915c-cbe10175491b",
                                                "sense_id": "b038353d-ae7e-3108-88ad-c0eccbd0873a",
                                                "text": "Что же такое, по мнению создателей лиги, независимость эксперта? Оказывается, под этим понимается его независимость в каждом конкретном проекте, поэтому в лигу могут войти сотрудники ИТ-компаний."
                                            },
                                            {
                                                "example_id": "e2446320-b79c-4cf9-9867-fe941e342ebf",
                                                "sense_id": "b038353d-ae7e-3108-88ad-c0eccbd0873a",
                                                "text": "Я бы сказал ещё и так: интеллигентность в России ― это прежде всего независимость мысли при европейском образовании. (Почему европейском ― скажу ниже.) А независимость эта должна быть от всего того, что её ограничивает, будь то, повторяю, партийность, деспотически властвующая над поведением человека и его совестью, экономические и карьерные соображения и даже интересы специальности, если они выходят за пределы допустимого совестью."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
