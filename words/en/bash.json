                },
                {
                    "sense_id": "9c6c2a6b-ca84-3c9b-adba-c9a4d4ecfb39",
                    "sense_definition": "A short form of the name Sebastian.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone calls him <w>Bash</w> instead of his full name.",
                            "target_lang_translations": {
                                "cs": "Všichni mu říkají <w>Bash</w> místo jeho celého jména."
                            }
                        },
                        {
                            "text": "I met a guy named <w>Bash</w> at the conference yesterday.",
                            "target_lang_translations": {
