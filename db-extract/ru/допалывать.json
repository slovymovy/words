                            {
                                "example_id": "e94eefef-f8e8-44a4-aa28-6f9b8df75337",
                                "sense_id": "1576b7b0-407c-3aee-82b5-af9f1a14915d",
                                "text": "Вот шамилёвские бабы, припоздав, допалывают картофельную делянку; согнутые, в розовых рубахах спины, короткие взлёты мотыг, падающих на серую пахоту."
                            },
                            {
                                "example_id": "b2be208e-d0b3-4a62-9d3d-24a929e68906",
                                "sense_id": "1576b7b0-407c-3aee-82b5-af9f1a14915d",
                                "text": "1-я и 4-я бригады — допалывать морковь в 1-й бригаде."
                            }
                        ]
                    }
