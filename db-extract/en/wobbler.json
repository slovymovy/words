                    },
                    {
                        "sense_id": "1738fdec-2523-3a56-bbc5-e72b5772c05b",
                        "entry_id": "8e534fd5-b2f2-32b8-b260-2e26f6104384",
                        "glosses": [
                            "A person who is undecided, and might go to either side."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4090774b-f954-46ec-b056-987facb220e5",
                                "sense_id": "1738fdec-2523-3a56-bbc5-e72b5772c05b",
                                "text": "Towns fell to him like so many houses of cards; and the fall of each town represented not only an accession to the prestige of the Royalist commander but a physical accession of strength as the wobblers flocked to the successful army."
                            }
                        ]
                    },
                    {
                        "sense_id": "684b4b2f-5c55-3c50-81f4-c2321db7c493",
                        "entry_id": "8e534fd5-b2f2-32b8-b260-2e26f6104384",
                        "glosses": [
                            "A stone that rocks from side to side as it travels because it is not resting on its running surface."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0cbc8c26-71a9-3c1a-996f-286dcb105f82",
                        "entry_id": "8e534fd5-b2f2-32b8-b260-2e26f6104384",
                        "glosses": [
                            "A case that could go either way depending on factors that cannot be controlled."
