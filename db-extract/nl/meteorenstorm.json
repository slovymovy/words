                                "example_id": "699ae7a0-1197-4b9f-9280-785aa99e8c50",
                                "sense_id": "b6e47916-cbb2-354c-86b9-5eeae7cc1829",
                                "text": "Een meteorenstorm is een meteorenregen die meer dan 1.000 meteoren per uur oplevert."
                            },
