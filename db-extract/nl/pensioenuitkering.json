                "senses": [
                    {
                        "sense_id": "85bce0a3-c0a3-3378-9463-097e392a214c",
                        "entry_id": "a8591cf6-52b5-3b56-bdb7-047e3aa2507d",
                        "glosses": [
                            "hoeveelheid geld die iemand iemand periodiek ontvangt die gespaard heeft voor een pensioen en de pensioengerechtigde leeftijd heeft bereikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e273e386-61d3-469d-a0f2-d72c259a537c",
                                "sense_id": "85bce0a3-c0a3-3378-9463-097e392a214c",
                                "text": "Spaarders en pensioenfondsen merken dagelijks de negatieve gevolgen van de lage rente. En in Groot-Brittannië hebben ze net als bij ons grote pensioenfondsen. Veel werkenden en gepensioneerden zien daardoor hun pensioenuitkering verschralen. Gepensioneerden kunnen minder uitgeven en werkenden gaan wellicht meer sparen als aanvulling op het pensioen. Door de lage rente moeten ze juist extra veel sparen."
                            },
                            {
                                "example_id": "7c83b7b4-6ac4-4b50-b9cf-7ca7ac865c6b",
                                "sense_id": "85bce0a3-c0a3-3378-9463-097e392a214c",
                                "text": "Als de garantie vervalt, hoeven de fondsen geen grote financiële buffers meer aan te houden. Dat geld kan dan worden gebruikt voor een hogere pensioenuitkering."
                            },
                            {
                                "example_id": "03f28f00-8bf2-41cb-bd9c-855d7258e190",
                                "sense_id": "85bce0a3-c0a3-3378-9463-097e392a214c",
                                "text": ",,Particulieren en bedrijven kunnen bij ons beleggen voor hun oude dag. Maar spaarproducten voor pensioen mag je alleen als bank aanbieden. Dankzij onze bankvergunning kunnen we ook een pensioenuitkering op basis van sparen aanbieden.”"
                            }
                        ]
                    }
