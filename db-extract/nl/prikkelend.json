                "senses": [
                    {
                        "sense_id": "4907780b-6dcb-307e-ac85-d46e644f2b52",
                        "entry_id": "ca7108d8-3a9f-3f8a-9d7b-8b05954a3ad8",
                        "glosses": [
                            "van iets dat het de aandacht trekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83d1347-bec9-4d90-87b0-b1648a0770ab",
                                "sense_id": "4907780b-6dcb-307e-ac85-d46e644f2b52",
                                "text": "Een vrouw in de ruimte laten bevallen. Dat was de prikkelende ambitie waarmee het Eindhovense bedrijf SpaceLife Origin een aantal maanden geleden nationale en internationale aandacht kreeg. Inmiddels zijn de twee bedenkers van het plan alweer uit elkaar. De bevalling is met vier jaar uitgesteld."
                            },
                            {
                                "example_id": "b8ca0db9-433f-4279-9c3e-9941e815be06",
                                "sense_id": "4907780b-6dcb-307e-ac85-d46e644f2b52",
                                "text": "De start-up Thorb zegt luxueus te kunnen bouwen met een prikkelende missie: 100 procent woongeluk, 50 procent betalen."
                            }
                        ]
                    },
                    {
