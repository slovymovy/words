                    "sense_id": "6e700f14-cd36-3c41-913c-24cd04af00d5",
                    "sense_definition": "A hemoglobin-containing cell found in the blood of vertebrates that transports oxygen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "blood_cell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>erythrocyte</w> is responsible for carrying oxygen from the lungs to the rest of the body.",
                            "target_lang_translations": {
                                "zh": "<w>红细胞</w>负责将氧气从肺部输送到身体的其他部位。"
                            }
                        },
                        {
                            "text": "A low count of <w>erythrocytes</w> in the blood can lead to a condition known as anemia.",
                            "target_lang_translations": {
                                "zh": "血液中<w>红细胞</w>计数过低会导致贫血。"
                            }
                        }
                    ],
                    "synonyms": [
                        "red blood cell",
                        "RBC"
                    ],
                    "common_phrases": [
                        "erythrocyte count"
                    ],
                    "target_lang_definitions": {
                        "zh": "脊椎动物血液中含有血红蛋白、负责输送氧气的细胞。"
                    },
