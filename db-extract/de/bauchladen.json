                ],
                "senses": [
                    {
                        "sense_id": "3a07d456-34ea-3d11-b5bb-9d6d9cc7e34f",
                        "entry_id": "29a2c10f-254a-3f08-a510-e0f318acbd5f",
                        "glosses": [
                            "Kasten, der als mobile Verkaufsfläche umgehängt und vor dem Bauch getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f47e890-ffdc-4cf9-bd15-45fc91ef2c47",
                                "sense_id": "3a07d456-34ea-3d11-b5bb-9d6d9cc7e34f",
                                "text": "„Sitze werden zurückgedreht, Decken ausgepackt und Chips aus dem Bauchladen gekauft.“"
                            },
                            {
                                "example_id": "66072c11-e012-4d80-8dd1-62f7ce28f741",
                                "sense_id": "3a07d456-34ea-3d11-b5bb-9d6d9cc7e34f",
                                "text": "„Ein Junge mit einem Bauchladen kam ihnen entgegen.“"
                            },
                            {
                                "example_id": "ba6de67a-ac8c-43f3-a006-ec8d702dcd53",
                                "sense_id": "3a07d456-34ea-3d11-b5bb-9d6d9cc7e34f",
                                "text": "„Beinah jeden Tag hatten wir in dem Café beim Pantheon unseren Espresso getrunken und dort einen Händler mit seinem Bauchladen kennengelernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86c0e5bc-6770-4c40-a349-9b485436cf9b",
                        "source_entry_id": "29a2c10f-254a-3f08-a510-e0f318acbd5f",
                        "source_sense_id": "3a07d456-34ea-3d11-b5bb-9d6d9cc7e34f",
                        "source_sense_description": "Kasten, der als mobile Verkaufsfläche umgehängt und vor dem Bauch getragen wird",
                        "target_lang_word": "éventaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éventaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54784ddc-4b82-3a1b-ad5a-aec58da9dc94",
                                        "entry_id": "6b46e9d2-eef8-32e2-9b78-9f7c1de2be3c",
                                        "glosses": [
                                            "Plateau, généralement en osier, que portent devant eux les marchands de fleurs, de fruits, de légumes, de poisson, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "337f44ce-4d4e-4425-98c7-37a1ba2437d2",
                                                "sense_id": "54784ddc-4b82-3a1b-ad5a-aec58da9dc94",
                                                "text": "La borgnesse me passait mon petit éventaire de sucre d’orge au cou, et elle me plantait sur le Pont-Neuf."
                                            },
                                            {
                                                "example_id": "5ca5ecca-8e47-437b-9e9c-cb809576d5de",
                                                "sense_id": "54784ddc-4b82-3a1b-ad5a-aec58da9dc94",
                                                "text": "Il y a des engueulades qui rougissent les yeux, bleuissent les joues, crispent les poings, arrachent les cheveux, cassent les œufs, renversent les éventaires, dépoitraillent les matrones, et me remplissent d'une joie pure."
                                            },
                                            {
                                                "example_id": "c4cd71c4-ed22-4ef1-8ed3-d4763b398636",
                                                "sense_id": "54784ddc-4b82-3a1b-ad5a-aec58da9dc94",
                                                "text": "Ils ne portaient pas de paquets, d’éventaires, ne poussaient pas de petites voitures; cette nuit, il semblait que leur activité n’eût aucun but."
                                            },
                                            {
                                                "example_id": "35faa89a-9b11-4692-a8d4-0a618aa8ea73",
                                                "sense_id": "54784ddc-4b82-3a1b-ad5a-aec58da9dc94",
                                                "text": "D’autres fois, il s’était présenté comme colporteur, ouvrant son éventaire et offrant des rubans de soie sur lesquels étaient inscrits des vers et des récits de vieux souvenirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f98b4082-6b6a-3816-8a62-6e1b1decb574",
                                        "entry_id": "6b46e9d2-eef8-32e2-9b78-9f7c1de2be3c",
                                        "glosses": [
                                            "Étalage à l’extérieur d’une boutique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de1d3d4a-00cf-4ea0-9136-01bba691abe5",
                                                "sense_id": "f98b4082-6b6a-3816-8a62-6e1b1decb574",
                                                "text": "Son éventaire est toujours rempli de bêtes !"
                                            },
                                            {
                                                "example_id": "4ead2c4a-0b72-4645-bdf7-ea7d52c12633",
                                                "sense_id": "f98b4082-6b6a-3816-8a62-6e1b1decb574",
                                                "text": "Un jour dans Fez, le Capitaine de Lattre s'arrête à l’éventaire d'un marchand de sucreries arabes."
                                            },
                                            {
                                                "example_id": "2692a69d-7655-4056-adc2-5dc6ea708ba7",
                                                "sense_id": "f98b4082-6b6a-3816-8a62-6e1b1decb574",
                                                "text": "Enfin Maman Jenny souleva la toile de sa boutique et vint devant l’éventaire."
                                            },
                                            {
                                                "example_id": "72303260-1679-4bb2-954b-c9a5cf6e6562",
                                                "sense_id": "f98b4082-6b6a-3816-8a62-6e1b1decb574",
                                                "text": "— La boîte de Nine, c'est une matière d’éventaire où s'étalent et resplendissent tous les échantillons de notre douce et vermineuse humanité : barbots […] ; tribades aux traits durs, nymphes expertes en maquillage, mondaines en balade, tapettes aux professionnelles ondulations de hanches […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48169e98-e49d-31a8-b9c4-5587e3d4a3cd",
                                        "entry_id": "6b46e9d2-eef8-32e2-9b78-9f7c1de2be3c",
                                        "glosses": [
                                            "Présentoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b810115c-95c2-46b8-a015-ff1421b83da6",
                                                "sense_id": "48169e98-e49d-31a8-b9c4-5587e3d4a3cd",
                                                "text": "Simon, chargé du cabas plein de provisions, referma la porte au ralenti, puis, comme s’il cherchait à reculer l’épreuve qu’on lui réservait, s’arrêta devant l’éventaire de publications et d’illustrés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
