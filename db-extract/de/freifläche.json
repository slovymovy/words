                                    {
                                        "sense_id": "e4347ebb-8fb5-3b96-bd31-266ba5291a44",
                                        "entry_id": "30f92120-5e69-3e79-b064-9c5f6ef940a8",
                                        "glosses": [
                                            "An open-air area, such as a park or public garden with no (or very few) buildings, often in an urban area and designated by a local authority or government as such."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8581c8a0-ea13-4b16-8cff-94214f1f5ba1",
                        "source_entry_id": "2fa17e14-f048-3df0-a7e8-03abab69c768",
                        "source_sense_id": "0e281bf9-7083-33c5-91e2-605718e596b1",
                        "source_sense_description": "nicht bebautes Areal (Fläche) innerhalb eines Gebietes, in dem Gebäude stehen",
                        "target_lang_word": "terrain vague",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terrain vague",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c1675ac-50fe-3930-9fbe-fdfb9ce1f19e",
                                        "entry_id": "10ee62b8-8e05-387b-a161-d8d3ad0e4ec9",
                                        "glosses": [
                                            "Terrain qui, dans une ville, n’est ni construit, ni cultivé, ni occupé."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8e741d5-e5ff-4946-a2dd-c6c2b3df04b0",
                                                "sense_id": "6c1675ac-50fe-3930-9fbe-fdfb9ce1f19e",
                                                "text": "Au milieu du terrain vague et aride qui touche d'un côté à la muraille grise de la ville et à la Porte de Lambèse, et de l'autre aux premières pentes de la montagne, la mosquée s'élevait solitaire."
                                            },
                                            {
                                                "example_id": "0552b3aa-ed7d-4da7-b58e-219f5f7770fb",
                                                "sense_id": "6c1675ac-50fe-3930-9fbe-fdfb9ce1f19e",
                                                "text": "À quatre mètres de hauteur sur le second siège, une dame a jeté les yeux dans un entresol sans défiance, paisiblement ouvert en face d'un terrain vague, et elle t'a vue ma chère."
                                            },
                                            {
                                                "example_id": "220626bb-f30b-4c50-8fcc-57ada8f3856e",
                                                "sense_id": "6c1675ac-50fe-3930-9fbe-fdfb9ce1f19e",
                                                "text": "Dans les vergers ou les terrains vagues, où l'on ne compte pas sur la récolte du sol, on plante en général 200 pommiers ou poiriers par hectare."
                                            },
                                            {
                                                "example_id": "6662a557-9f45-4c8d-ac8e-9ac022aacc3e",
                                                "sense_id": "6c1675ac-50fe-3930-9fbe-fdfb9ce1f19e",
                                                "text": "Un terrain vague est donc un lieu vide de cultures et de constructions dans un espace urbanisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdd617b2-e412-3695-a94a-ece6a4f3abf7",
                                        "entry_id": "10ee62b8-8e05-387b-a161-d8d3ad0e4ec9",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68692f34-4edb-494d-8096-cc1d986f17d6",
                                                "sense_id": "fdd617b2-e412-3695-a94a-ece6a4f3abf7",
                                                "text": "« L’équivalence agronomique d’une femme n’est pas codifiée avec précision. Il y a tant de créatures dont le cœur est un terrain vague et dont le giron exigerait d’être bien phosphaté. En ce qui vous concerne, la Beauce et tous ses blés, le Bordelais et tous ses vignobles ne paieraient pas assez la saveur de vos baisers. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
