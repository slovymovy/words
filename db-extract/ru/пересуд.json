                        "examples": [
                            {
                                "example_id": "2d489ffa-7125-4e50-81c6-32d954ff390f",
                                "sense_id": "bc3518c0-2fdf-37b9-af8f-54b3ed404e63",
                                "text": "Людских пересудов не переслушаешь."
                            },
                            {
                                "example_id": "3f625ad5-0914-4fe5-9cee-0c3ca576551b",
                                "sense_id": "bc3518c0-2fdf-37b9-af8f-54b3ed404e63",
                                "text": "Оно дальше-то лучше: и земли побольше, и не так шумно, да и разговору меньше, пересуду."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf0eced8-b7f7-32aa-a43b-3c1a2f46ebb5",
                        "entry_id": "bcd7130f-e927-301a-a7d0-11bba4309fe2",
                        "glosses": [
                            "старин., прост. новое, вторичное судебное разбирательство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0307cb4-b6a5-41d5-9ee8-b6b9a1be478c",
                                "sense_id": "bf0eced8-b7f7-32aa-a43b-3c1a2f46ebb5",
                                "text": "Дело пошло на пересуд."
                            }
                        ]
