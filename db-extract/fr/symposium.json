                "senses": [
                    {
                        "sense_id": "ca387960-0bc0-3d00-97c5-d97e3514ad15",
                        "entry_id": "5ba22c89-10f8-3d6b-8ead-cba7cfdd58d4",
                        "glosses": [
                            "симпозиум"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3c6a8db-f065-4893-bd37-5e18ace9d3ab",
                                "sense_id": "ca387960-0bc0-3d00-97c5-d97e3514ad15",
                                "text": "Le ministère du Tourisme vous convie au Symposium international sur le développement durable du tourisme."
                            },
                            {
                                "example_id": "66fde2eb-03d8-4fcd-ad2e-cd3f96903ef2",
                                "sense_id": "ca387960-0bc0-3d00-97c5-d97e3514ad15",
                                "text": "Organisé à l’initiative de Christine Albanel, ce symposium est placé sous la présidence de Jean Clottes, président de la Fédération internationale des organisations d’art rupestre (IFRAO). Il sera l’occasion d’un débat international et pluridisciplinaire autour de la grotte de Lascaux (site inscrit sur la liste du patrimoine mondial de l’UNESCO) et de la conservation en milieu souterrain."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
