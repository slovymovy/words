                            {
                                "example_id": "fd1e9e45-4a12-4ad8-9c89-b2aacd7fe781",
                                "sense_id": "2cfc5590-551f-3aca-8a13-8429cd46d867",
                                "text": "John was so bullheaded that he kept driving and refused to stop for directions, even after getting hopelessly lost."
                            },
                            {
                                "example_id": "8376c103-2f05-46d3-be70-236a03b3ff5f",
                                "sense_id": "2cfc5590-551f-3aca-8a13-8429cd46d867",
                                "text": "“I know, my dear. I’ve lived with these bullheaded Sartorises for eighty years, and I’ll never give a single ghost of ’em the satisfaction of shedding a tear over him. What did Horace’s message say?”"
                            }
                        ]
                    }
