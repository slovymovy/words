                "senses": [
                    {
                        "sense_id": "2c785e93-c476-3dd7-9bfa-3cea24e690e4",
                        "entry_id": "b453cb3a-0c85-3f8b-8974-5c74a42a07d4",
                        "glosses": [
                            "Dépression d’origine volcanique de forme circulaire ou elliptique, issue de la vidange de la chambre magmatique sous-jacente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a404fb86-a613-4317-a47c-b085159e51d1",
                                "sense_id": "2c785e93-c476-3dd7-9bfa-3cea24e690e4",
                                "text": "Une caldera est classiquement liée à une éruption volcanique : la chambre magmatique située à quelques kilomètres de profondeur peut, à l’occasion de grandes éruptions, se vider partiellement ou en totalité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51d70cc1-f91b-4433-81f5-c741ec4f72af",
                        "source_entry_id": "b453cb3a-0c85-3f8b-8974-5c74a42a07d4",
                        "source_sense_id": "2c785e93-c476-3dd7-9bfa-3cea24e690e4",
                        "target_lang_word": "Caldera",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Caldera",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff908aeb-df89-3542-b3c5-b58bdd156ac2",
                                        "entry_id": "9aca72f3-7c54-344f-846a-add08bf1325f",
                                        "glosses": [
                                            "kesselförmige Struktur vulkanischen Ursprungs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bffbd1c-339b-43e4-a339-74d265e30dd6",
                                                "sense_id": "ff908aeb-df89-3542-b3c5-b58bdd156ac2",
                                                "text": "Zu den bedeutendsten Calderen gehören die des Teide (Teneriffa), der Tobasee (Sumatra), die Yellowstone-Caldera (USA) und die Caldera der Inselgruppe Santorin."
                                            },
                                            {
                                                "example_id": "707b5e6c-f9a9-4ee7-8550-cd39eeee61fc",
                                                "sense_id": "ff908aeb-df89-3542-b3c5-b58bdd156ac2",
                                                "text": "„Die kreisrunde Bucht ist eine überflutete Caldera mit nur einer natürlichen Einfahrt, weshalb sie den sichersten Hafen der Region bietet.“"
                                            },
                                            {
                                                "example_id": "ad6181a8-b831-4d79-85fd-aa673ea8c78e",
                                                "sense_id": "ff908aeb-df89-3542-b3c5-b58bdd156ac2",
                                                "text": "„Wann genau es dann zum Einbruch der Caldera kam, ist noch unklar.“"
                                            },
                                            {
                                                "example_id": "0c0aca2e-5e63-4b28-8990-0fabbb675dcd",
                                                "sense_id": "ff908aeb-df89-3542-b3c5-b58bdd156ac2",
                                                "text": "„Sie ritten über das obere Ende der Caldera zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ed8af49-5760-4340-942e-3f68a393d76c",
                        "source_entry_id": "b453cb3a-0c85-3f8b-8974-5c74a42a07d4",
