                "senses": [
                    {
                        "sense_id": "24f2b0fa-e474-3353-a0b1-aa6d742f020e",
                        "entry_id": "c121ac08-2a3e-3095-b129-3cbd19167742",
                        "glosses": [
                            "junge Person mit noch wenig Erfahrung"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "82911897-2639-4b51-8fa1-1f268f729818",
                                "sense_id": "24f2b0fa-e474-3353-a0b1-aa6d742f020e",
                                "text": "„Ich bin ein kindischer und schwacher Fant, […]“"
                            },
                            {
                                "example_id": "66dc1d34-00a0-4407-a458-837df88b6c80",
                                "sense_id": "24f2b0fa-e474-3353-a0b1-aa6d742f020e",
                                "text": "„Den Straßburger Münster sah ich nur von fern; er wackelte mit dem Kopfe, wie der alte getreue Eckart, wenn er einen jungen Fant erblickt, der nach dem Venusberge zieht.“"
                            },
                            {
                                "example_id": "167235e7-2cfe-4612-9dd0-c59e5b2ee746",
                                "sense_id": "24f2b0fa-e474-3353-a0b1-aa6d742f020e",
                                "text": "„Friedrich August ist ebenso ehrgeizig wie eitel; schon der Gedanke, von solch einem Fant abhängig zu sein, bringt ihn zum Rasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
