                "senses": [
                    {
                        "sense_id": "61ae171a-cf83-3b84-a274-769f77c542e1",
                        "entry_id": "d6fbca5f-7b83-3d7b-9571-3713a1846426",
                        "glosses": [
                            "beim Reiten getragene Kopfbedeckung, die den Kopf bei Stürzen schützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38067ee7-d9d3-4131-b941-40d4f70c7d63",
                                "sense_id": "61ae171a-cf83-3b84-a274-769f77c542e1",
                                "text": "„Wie bereits erwähnt, setzte ich mir immer pflichtbewusst den Reithelm auf, bevor ich aufs Pferd stieg.“"
                            },
                            {
                                "example_id": "05c466b8-5268-4566-8a32-2b2c788d0dad",
                                "sense_id": "61ae171a-cf83-3b84-a274-769f77c542e1",
                                "text": "„Dann rückte sie ihren Haarknödel so zurecht, dass sie den Reithelm problemlos aufsetzen konnte.“"
                            },
                            {
                                "example_id": "e6b17458-24d4-47df-acd7-c07c9fbe1da1",
                                "sense_id": "61ae171a-cf83-3b84-a274-769f77c542e1",
                                "text": "„Da sie in Bagdad keinen Reithelm kaufen konnte, bat Helma ihre Mutter , einen mitzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
