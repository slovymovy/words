                        ],
                        "examples": [
                            {
                                "example_id": "08d00f38-4526-46cb-8c7e-ae33cd9d3c16",
                                "sense_id": "8a5a1dbb-87aa-3240-8f18-712bbf585911",
                                "text": "The ward masters, one of whom was in charge of nursing and cleaning in each ward, were for the most part merely convalescent soldiers, subject to withcall, at any time, back to their regiments."
                            }
                        ]
                    }
                ],
