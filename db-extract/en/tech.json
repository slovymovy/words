    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dbaddfb6-d67a-3639-93c9-fd23251e9e2c",
                "word": "tech",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "30eb0ef6-f284-453c-ac3e-4ca7ddd8e81a",
                        "entry_id": "dbaddfb6-d67a-3639-93c9-fd23251e9e2c",
                        "tags": [
                            "plural"
                        ],
                        "form": "techs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43157081-3c4a-3a9f-ad04-d47adbaef2df",
                        "entry_id": "dbaddfb6-d67a-3639-93c9-fd23251e9e2c",
                        "glosses": [
                            "Technology."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f8577fb5-1dd1-4aed-9f01-434a82e7154a",
                                "sense_id": "43157081-3c4a-3a9f-ad04-d47adbaef2df",
                                "text": "I can't understand all this new tech."
                            },
                            {
                                "example_id": "8486e1b1-b827-4a14-a235-4b618237ca5a",
                                "sense_id": "43157081-3c4a-3a9f-ad04-d47adbaef2df",
                                "text": "Remember, something that seems straightforward to you can be very scary to people who don't have enough info or tech knowledge to provide a context or meaning on their own."
                            },
                            {
                                "example_id": "8835ae90-39f8-49c1-a6ff-64e7c5f926cf",
                                "sense_id": "43157081-3c4a-3a9f-ad04-d47adbaef2df",
                                "text": "\"The tech on this is really good. But in essence, it's still a train any competent driver should be able to learn easily."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ae01eb4-9ebc-31c1-bd06-098c8c981c49",
                        "entry_id": "dbaddfb6-d67a-3639-93c9-fd23251e9e2c",
                        "glosses": [
                            "Technology.",
                            "Denotes technology businesses or the technology industry, especially in the field of computing and the Internet."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2d863877-d544-41cc-bcbb-64f6829f8a3d",
                                "sense_id": "1ae01eb4-9ebc-31c1-bd06-098c8c981c49",
                                "text": "Tech giants such as Google and Facebook have too much power."
                            },
                            {
                                "example_id": "554e2bec-1e33-4e7e-aa0d-c699c48f6042",
                                "sense_id": "1ae01eb4-9ebc-31c1-bd06-098c8c981c49",
                                "text": "Tech stocks are down on Nasdaq."
                            },
                            {
                                "example_id": "1f442cc4-e3bb-456c-909a-73ce1586b288",
                                "sense_id": "1ae01eb4-9ebc-31c1-bd06-098c8c981c49",
                                "text": "Tech workers can earn big money."
                            },
                            {
                                "example_id": "94acd1f4-bec1-4fae-a327-b91b1c56938d",
                                "sense_id": "1ae01eb4-9ebc-31c1-bd06-098c8c981c49",
                                "text": "In particular, Kumamoto prefecture in southwestern Japan is quickly becoming a hotbed for tech investment from companies including TSMC and Fujifilm Holdings Corp (FUJIF)."
                            }
                        ]
                    },
                    {
                        "sense_id": "593f3282-57cf-34e4-ac04-5084fed1ccee",
                        "entry_id": "dbaddfb6-d67a-3639-93c9-fd23251e9e2c",
                        "glosses": [
                            "Technician; technologist."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b5705647-da2c-41a6-8e7d-9a3d08397e2f",
                                "sense_id": "593f3282-57cf-34e4-ac04-5084fed1ccee",
                                "text": "The service writers collaborate with the techs and communicate with the customers."
                            },
                            {
                                "example_id": "b3e0d6e3-95b8-48e4-ad8c-0a2e9c6a233d",
                                "sense_id": "593f3282-57cf-34e4-ac04-5084fed1ccee",
                                "text": "A man dressed as a lab tech, his blue scrubs startlingly pale against the vivid red and black chaos, moved into sight from behind the SUV. He carried an assault rifle."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3ed1a1f-9127-3fb8-bdd0-6857e7f140bd",
                        "entry_id": "dbaddfb6-d67a-3639-93c9-fd23251e9e2c",
                        "glosses": [
                            "Technique."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "aafd5a0c-ac9a-39d9-ad1d-84bd7e3f383d",
                        "entry_id": "dbaddfb6-d67a-3639-93c9-fd23251e9e2c",
                        "glosses": [
                            "Technical college; technical school."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "934f7b6f-6a7b-40f6-a2d3-2af47354d7c4",
                                "sense_id": "aafd5a0c-ac9a-39d9-ad1d-84bd7e3f383d",
                                "text": "Greenville Technical College is informally known as Greenville Tech."
                            },
                            {
                                "example_id": "e12054f6-99f8-4575-a2e9-5fa49ba94e06",
                                "sense_id": "aafd5a0c-ac9a-39d9-ad1d-84bd7e3f383d",
                                "text": "In high school, he attended the tech program, studying construction trades."
                            }
                        ]
                    },
                    {
                        "sense_id": "400edab4-4d12-3b51-bd23-231d457c1f96",
                        "entry_id": "dbaddfb6-d67a-3639-93c9-fd23251e9e2c",
                        "glosses": [
                            "Clipping of technical rehearsal."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping",
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9815c8c9-8596-45ce-8db0-25f7044af6c1",
                                "sense_id": "400edab4-4d12-3b51-bd23-231d457c1f96",
                                "text": "Despite his early preparation, the three-week tech period is Nigrini’s only opportunity to make his vision come to fruition."
                            },
                            {
                                "example_id": "9bcaa823-5306-4fa9-8233-e1e980d7c29e",
                                "sense_id": "400edab4-4d12-3b51-bd23-231d457c1f96",
                                "text": "Typically when you’re developing a musical you have hours of rehearsal and hours of tech, […] and everyone’s tired of the show by the end."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebc3ef3f-1e58-3987-a883-956d32d0ffcc",
                        "entry_id": "dbaddfb6-d67a-3639-93c9-fd23251e9e2c",
