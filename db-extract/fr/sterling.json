                "entry_id": "79879ea5-77f7-3455-8625-91d16f00cdf7",
                "word": "sterling",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4173f3bf-422b-301b-9937-eeb630ecd6df",
                        "entry_id": "79879ea5-77f7-3455-8625-91d16f00cdf7",
                        "glosses": [
                            "Qualifie la livre anglaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d04ea2-5e0e-4572-b453-3e210deadd1a",
                                "sense_id": "4173f3bf-422b-301b-9937-eeb630ecd6df",
                                "text": "Cinquante livres sterling."
                            }
                        ]
                    },
                    {
                        "sense_id": "338d789c-f7d9-3638-8d1d-338929219e80",
                        "entry_id": "79879ea5-77f7-3455-8625-91d16f00cdf7",
                        "glosses": [
                            "Relatif à la livre anglaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3449e37-22ca-48b7-9bea-faaa9813dae0",
                                "sense_id": "338d789c-f7d9-3638-8d1d-338929219e80",
                                "text": "Zone sterling, zone monétaire où la livre sterling sert d'étalon, et qui comprend la plupart des pays du Commonwealth."
                            },
                            {
                                "example_id": "0660d31b-77ca-4e08-9c00-6581f63a0ec6",
                                "sense_id": "338d789c-f7d9-3638-8d1d-338929219e80",
                                "text": "L'histoire de la zone sterling tantôt officieuse, tantôt armée d'institutions officielles et autoritaires, montre bien les interférences des plans d'organisation monétaire avec les pouvoirs propres d'attraction d'une place financière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "913d9df5-90d6-4f8a-abff-f324a3dd5a6b",
                        "source_entry_id": "79879ea5-77f7-3455-8625-91d16f00cdf7",
                        "target_lang_word": "sterling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sterling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "922503ff-03fd-3ef1-9359-1456120a48e7",
                                        "entry_id": "b21d0651-65ac-3b33-8557-2677f0daf8c6",
                                        "glosses": [
                                            "A silver penny."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f0123c-f63c-43b1-8788-ef6b49bd5d0a",
                                                "sense_id": "922503ff-03fd-3ef1-9359-1456120a48e7",
                                                "text": "In England sterlings and nobles were struck, both of them often counterfeited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a30eecc-ed12-3f92-82c1-614efee072ce",
                                        "entry_id": "b21d0651-65ac-3b33-8557-2677f0daf8c6",
                                        "glosses": [
                                            "The currency of the United Kingdom, based on the pound sterling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "662d2558-5976-4eec-80c9-9aa49350071f",
                                                "sense_id": "0a30eecc-ed12-3f92-82c1-614efee072ce",
                                                "text": "“… among the objects stolen was the famous parure of Black Diamonds, for which a bid of half a million sterling had just been made and accepted.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d63be31-cd70-3259-945e-3a1dcf43139f",
                                        "entry_id": "b21d0651-65ac-3b33-8557-2677f0daf8c6",
                                        "glosses": [
                                            "Former British gold or silver coinage of a standard fineness: for gold 0.91666 and for silver 0.925."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cb61e08-619b-4202-acc5-b221b291ce67",
                                                "sense_id": "9d63be31-cd70-3259-945e-3a1dcf43139f",
                                                "text": "Sterling was the known and approved standard in England, in all probability, from the beginning of King Henry the Second's reign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a547df3a-63bf-3550-bcb0-dc72e5319087",
                                        "entry_id": "b21d0651-65ac-3b33-8557-2677f0daf8c6",
                                        "glosses": [
                                            "Sterling silver, or articles made from this material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sterling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dfbdf5f-3de4-3905-bbf7-9c298f5f0832",
                                        "entry_id": "ea32867a-ff3a-3598-86c8-ed673e108edd",
                                        "glosses": [
                                            "Of, or relating to British currency, or the former British coinage."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fe5ca74-f038-3259-9e43-c07148d33852",
                                        "entry_id": "ea32867a-ff3a-3598-86c8-ed673e108edd",
                                        "glosses": [
                                            "Of, relating to, or made from sterling silver."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "972a0e9d-3886-3410-95a8-390bcc6409a3",
                                        "entry_id": "ea32867a-ff3a-3598-86c8-ed673e108edd",
                                        "glosses": [
                                            "Of acknowledged worth or influence; high quality; authoritative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77d1e003-2e94-4a64-afef-96741397e142",
                                                "sense_id": "972a0e9d-3886-3410-95a8-390bcc6409a3",
                                                "text": "Then the world seemed none so bad / And I myself a sterling lad"
                                            },
                                            {
                                                "example_id": "8cff72f7-2c89-4d6e-9e3d-08d9afdf9ba4",
                                                "sense_id": "972a0e9d-3886-3410-95a8-390bcc6409a3",
                                                "text": "Southampton had been hoping to get back to winning ways to prove to their critics there was substance to their sterling start to the season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95c28e35-b7b0-3c95-83f1-de5f0c316b39",
                                        "entry_id": "ea32867a-ff3a-3598-86c8-ed673e108edd",
                                        "glosses": [
                                            "Genuine; true; pure; of great value or excellence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c43a13-3adc-4060-a9b5-0d4b056ac1fd",
                                                "sense_id": "95c28e35-b7b0-3c95-83f1-de5f0c316b39",
                                                "text": "I have said that Mr. Crawley was a stern, unpleasant man; and it certainly was so. The man must be made of very sterling stuff, whom continued and undeserved misfortune does not make unpleasant."
                                            },
                                            {
                                                "example_id": "4397f5b5-9c7f-43f7-9c4a-c2a1fcc0cbf2",
                                                "sense_id": "95c28e35-b7b0-3c95-83f1-de5f0c316b39",
                                                "text": "But Rodríguez says, “Neither the law nor the facts support Senator Grassley’s baseless allegations and extrapolated conclusions. It is disappointing that the senator and his staff continue to focus a politically motivated campaign on Ms. Abedin, who has been known her entire professional life for hard work, integrity, and her sterling reputation. It is people like Ms. Abedin whom we should all want in public service.”"
                                            },
                                            {
                                                "example_id": "c5fb7bfd-56bb-4f70-9f2f-b29e43a756a4",
                                                "sense_id": "95c28e35-b7b0-3c95-83f1-de5f0c316b39",
                                                "text": "HSTs continued to provide sterling service during these years, so much so that when Virgin and Midland Mainline brought their new wave of high-speed diesel electric multiple units [...] on stream, many preferred the ride and comfort of the vanquished to the ride and comfort of the vanquisher."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sterling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "165acccb-c7a3-3be5-830d-180c32998fe2",
                                        "entry_id": "72014981-be33-3a91-868f-8881bdf829a6",
                                        "glosses": [
                                            "A structure of pilings that protects the piers of a bridge; a starling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886894ef-96c8-415d-9169-d2c8d9649f08",
                                                "sense_id": "165acccb-c7a3-3be5-830d-180c32998fe2",
                                                "text": "The bubbles ended in another swirl by a weed-fringed sterling, and a delicate swift water-arrow shot away between the two piers of the middle arch […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "a9da1333-4d06-37ff-aafb-2bf8b89e43d1",
                "word": "sterling",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
