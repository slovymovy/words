                "senses": [
                    {
                        "sense_id": "c2ea3210-6bed-3947-9666-787413cb6dae",
                        "entry_id": "02ecbf48-e522-3285-83ab-5f5f20bd18bf",
                        "glosses": [
                            "Zustand, bei dem eine Person, Organisation oder Nation als Beobachter Teil einer Organisation ist und über deren Vorgehen informiert ist, ohne Mitglied zu sein oder ein Mitbestimmungsrecht zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaa3d721-00c0-474d-ae5e-702916dc5402",
                                "sense_id": "c2ea3210-6bed-3947-9666-787413cb6dae",
                                "text": "„Die UN erkannten daraufhin das Selbstbestimmungsrecht der Palästinenser an, die PLO erhielt Beobachterstatus.“"
                            },
                            {
                                "example_id": "19296cd2-6a6f-4137-b70f-5d647d39c04e",
                                "sense_id": "c2ea3210-6bed-3947-9666-787413cb6dae",
                                "text": "„Die PLO nutzte nun ihren seit November 1974 bestehenden Beobachterstatus bei den Vereinten Nationen, um die ‹Entweihung› der islamischen Heiligtümer in Jerusalem zum Gegenstand einer Beschwerde beim UN-Sicherheitsrat zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
