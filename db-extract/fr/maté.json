                                        "glosses": [
                                            "The container used to prepare this drink, traditionally a small calabash."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93980cf4-0b82-4ec0-a752-10dd2902612d",
                                                "sense_id": "8eceae1e-1439-32a8-b8f7-124bb6c759f4",
                                                "text": "The maté is then filled with yerva, after the bombilla has been placed in position."
                                            }
