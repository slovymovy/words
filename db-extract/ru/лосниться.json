                                "target_senses": [
                                    {
                                        "sense_id": "002364a8-48a7-3a61-a436-399ddc2ca9cd",
                                        "entry_id": "cc68236d-ffec-37f2-a1ae-545b69a4201e",
                                        "glosses": [
                                            "Briller, jeter des éclats par intermittence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6f52fc3-3e39-4cc8-a737-e584aa9d8b6c",
                                                "sense_id": "002364a8-48a7-3a61-a436-399ddc2ca9cd",
                                                "text": "Cette partie, appelée passementerie d’or et d’argent, comprenait les épaulettes, les dragonnes, les aiguillettes, enfin cette immense quantité de choses brillantes qui scintillaient sur les riches uniformes de l’armée française et sur les habits civils."
                                            },
                                            {
                                                "example_id": "8f9a1493-4a2e-4bae-9a68-8658ddb02f34",
                                                "sense_id": "002364a8-48a7-3a61-a436-399ddc2ca9cd",
                                                "text": "Une sphère lumineuse, tournant au plafond, scintillait de ses mille petites facettes dont les lueurs éclairaient curieusement les visages."
                                            },
                                            {
                                                "example_id": "4c169d78-ae70-4f8f-85cc-6d9cf1f50730",
                                                "sense_id": "002364a8-48a7-3a61-a436-399ddc2ca9cd",
                                                "text": "Des feux tantôt roses, tantôt d'un bleu acide qui tournait au vert pomme, scintillaient à l'extérieur des Folies."
                                            },
                                            {
                                                "example_id": "0e137451-f738-42b6-a476-293b155adc17",
                                                "sense_id": "002364a8-48a7-3a61-a436-399ddc2ca9cd",
                                                "text": "On nous a conduits à un petit box tranquille, qui baigne dans une lueur solaire ceinte d’ombres scintillantes. Comment l’ombre peut-elle scintiller ? Elle scintille, un point c’est tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee9e372-d3d1-3541-a6ee-f6cfbc697f84",
                                        "entry_id": "cc68236d-ffec-37f2-a1ae-545b69a4201e",
                                        "glosses": [
                                            "Avoir un mouvement de scintillation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1daf3ffa-a00d-437d-8a0e-4d298ac84514",
                                                "sense_id": "aee9e372-d3d1-3541-a6ee-f6cfbc697f84",
                                                "text": "Les étoiles scintillent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
