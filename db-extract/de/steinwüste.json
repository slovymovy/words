                        "glosses": [
                            "Wüste, deren Oberfläche überwiegend aus Gestein besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c72c7323-9e01-4c12-887a-8dadb27a42ee",
                                "sense_id": "78fee836-f54f-3b60-9dc3-65fe1229b05c",
                                "text": "„Richtung Westen stieg die Landschaft zu einer Steinwüste an, die erst an den weiter südlich in den Himmel ragenden Bergen ein Ende fand.“"
                            },
                            {
                                "example_id": "80fb630c-ea64-40d5-b078-9cd5d124759a",
                                "sense_id": "78fee836-f54f-3b60-9dc3-65fe1229b05c",
                                "text": "„Wir befanden uns hoch oben über einer völligen Steinwüste.“"
                            }
