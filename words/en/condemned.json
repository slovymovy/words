                    "common_phrases": [
                        "widely condemned",
                        "universally condemned"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергшийся резкой критике или неодобрению.",
                        "de": "Scharf kritisiert oder missbilligt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осуждаемый",
                                "target_lang_sense_clarification": "подвергающийся критике"
                            },
                            {
                                "target_lang_word": "порицаемый",
                                "target_lang_sense_clarification": "вызывающий неодобрение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verurteilt",
                                "target_lang_sense_clarification": "öffentlich scharf kritisiert"
                            },
                            {
                                "target_lang_word": "missbilligt",
                                "target_lang_sense_clarification": "auf Ablehnung stoßend"
                            }
                        ]
