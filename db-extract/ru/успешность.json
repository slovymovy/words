                "translations": [
                    {
                        "translation_id": "70e93f14-a508-4f53-98f7-76c35bf0346a",
                        "source_entry_id": "27d11a70-ff0c-32a6-a8fa-9df8939b4069",
                        "source_sense_id": "5b909e4f-c4bc-3c28-81df-b8946e4af939",
                        "target_lang_word": "success",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "success",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b624a378-70f3-3bfd-8ac9-d3bdc814b410",
                                        "entry_id": "e3c230ce-19b5-3f79-ae05-d80e69507853",
                                        "glosses": [
                                            "The achievement of one's aim or goal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ee56571-8b5f-4b7a-af79-d0b369b2ce89",
                                                "sense_id": "b624a378-70f3-3bfd-8ac9-d3bdc814b410",
                                                "text": "His third attempt to pass the entrance exam was a success."
                                            },
                                            {
                                                "example_id": "779a67fe-9e24-436e-a7ca-543d4812f351",
                                                "sense_id": "b624a378-70f3-3bfd-8ac9-d3bdc814b410",
                                                "text": "a glowing success"
                                            },
                                            {
                                                "example_id": "6e57364a-0eb5-4461-89de-c32b59a2b630",
                                                "sense_id": "b624a378-70f3-3bfd-8ac9-d3bdc814b410",
                                                "text": "Actually there was recently a talented young female bassoonist who gave up a promising career on that sturdy instrument, not to do something more feminine but to take up bullfighting. This is Patricia Hayes of San Angelo, Texas, who has had spectacular success in the arenas of Mexico and Portugal. Unfortunately she is not America's only matadoress."
                                            },
                                            {
                                                "example_id": "1a4e4a90-3798-4ef5-89f6-e52d6e756cec",
                                                "sense_id": "b624a378-70f3-3bfd-8ac9-d3bdc814b410",
                                                "text": "Republicans are launching a new nonprofit group to highlight the legislative successes of its vulnerable incumbents with a $2 million advertising blitz touting the work of five vulnerable GOP senators to protect Medicare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94a05b89-b2ce-383f-bdd3-a4e314b1c376",
                                        "entry_id": "e3c230ce-19b5-3f79-ae05-d80e69507853",
                                        "glosses": [
                                            "Financial profitability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a69993b-3d9f-46dc-b7e9-d8ac3fb63ab7",
                                                "sense_id": "94a05b89-b2ce-383f-bdd3-a4e314b1c376",
                                                "text": "Don't let success go to your head."
                                            },
                                            {
                                                "example_id": "16545c20-bf16-4cb7-8050-fae5772f75aa",
                                                "sense_id": "94a05b89-b2ce-383f-bdd3-a4e314b1c376",
                                                "text": "Instead Nokia decided better to stick with what they knew worked - good, solid, reliable mobile phones of the kind that had brought them success until then."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e60ae71-98c4-359a-bb5f-13f5e358fe4a",
                                        "entry_id": "e3c230ce-19b5-3f79-ae05-d80e69507853",
                                        "glosses": [
                                            "One who, or that which, achieves assumed goals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b324ad10-608b-42aa-8331-825a23260d80",
                                                "sense_id": "0e60ae71-98c4-359a-bb5f-13f5e358fe4a",
                                                "text": "Scholastically, he was a success."
                                            },
                                            {
                                                "example_id": "aa4e2a9e-b621-4446-b443-8db246a1395a",
                                                "sense_id": "0e60ae71-98c4-359a-bb5f-13f5e358fe4a",
                                                "text": "The new range of toys has been a resounding success."
                                            },
                                            {
                                                "example_id": "706a1899-4ce6-4588-b2ca-7d3db14227d0",
                                                "sense_id": "0e60ae71-98c4-359a-bb5f-13f5e358fe4a",
                                                "text": "There have been other drugs since reticulose that I became aware of the successes of, some even able to claim \"cure,\" even turning people from HIV-positive to negative."
                                            },
                                            {
                                                "example_id": "33270327-fbab-42c5-9926-97839545a3f3",
                                                "sense_id": "0e60ae71-98c4-359a-bb5f-13f5e358fe4a",
                                                "text": "There have been some surprising successes, though - the LTM's [London Transport Museum's] online gift shop is currently selling 75% more products during lockdown than it was in the same period last year."
                                            },
                                            {
                                                "example_id": "b40919ea-3c3e-4b76-aa5b-35d14cd8764f",
                                                "sense_id": "0e60ae71-98c4-359a-bb5f-13f5e358fe4a",
                                                "text": "Freightliner says trials with a new lower-emission fuel for its diesel fleet have been a success, raising its credentials as a supporter of reducing greenhouse gases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c410763-d524-3b08-8b15-1e2f1e3a8501",
                                        "entry_id": "e3c230ce-19b5-3f79-ae05-d80e69507853",
                                        "glosses": [
                                            "The fact of getting or achieving wealth, respect, or fame."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0187d65-abec-4d17-a47a-f96525b6ca70",
                                                "sense_id": "6c410763-d524-3b08-8b15-1e2f1e3a8501",
                                                "text": "She is country music's most recent success."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c782cc7f-66e8-3934-9ee3-73de9ed0cd2f",
                                        "entry_id": "e3c230ce-19b5-3f79-ae05-d80e69507853",
                                        "glosses": [
                                            "Something which happens as a consequence; the outcome or result."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "205f0b24-fdaf-4a9e-ac80-6433f510ee7a",
                                                "sense_id": "c782cc7f-66e8-3934-9ee3-73de9ed0cd2f",
                                                "text": "I suppose them as at the beginning of no meane endeavour, not a little alter'd and mov'd inwardly in their mindes: Some with doubt of what will be the successe, others with fear of what will be the censure; some with hope, others with confidence of what they have to speake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
