                    },
                    {
                        "form_id": "d9941476-acc5-4f02-986a-6e2a97d875c3",
                        "entry_id": "eab759c0-18bc-3747-a4d4-bd4873187a3d",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most capacious"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                        "entry_id": "eab759c0-18bc-3747-a4d4-bd4873187a3d",
                        "glosses": [
                            "Having a lot of space inside; roomy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c57f2fe-3448-47e2-a306-5ca7660c6eb0",
                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                "text": "I turnd my thoughts, and with capacious mind / Conſiderd all things viſible in Heav'n"
                            },
                            {
                                "example_id": "a5c7ee5c-c085-4157-809c-f7648332defb",
                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                "text": "‘There’s rummer things than women in this world though, mind you,’ said the man with the black eye, slowly filling a large Dutch pipe, with a most capacious bowl."
                            },
                            {
                                "example_id": "a3517ebd-004d-4cba-9a31-01a23f11b449",
                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                "text": "The Malabar, that huge sea monster, in whose capacious belly so many human creatures lived and suffered, had dwindled to a walnut-shell, and yet beside her bulk how infinitely small had their own frail cockboat appeared as they shot out from under her towering stern!"
                            },
                            {
                                "example_id": "73bb62ba-688d-4018-902b-8c956050c229",
                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                "text": "There comes an end to all things; the most capacious measure is filled at last; and this brief condescension to my evil finally destroyed the balance of my soul."
                            },
                            {
                                "example_id": "142b28b0-0b67-42d5-87df-d5bead8bdc50",
                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                "text": "“Do I fidget you ?” he asked apologetically, whilst his long bony fingers buried themselves, string, knots, and all, into the capacious pockets of his magnificent tweed ulster."
                            },
                            {
                                "example_id": "a71d2ecd-dc4e-4b47-b61b-eea61f303991",
                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                "text": "Profitable operation is being made possible by the widespread introduction of capacious diesel railcars, which for their comfort and speed are very popular with the travelling public."
                            },
                            {
                                "example_id": "2cb0342e-4583-47ec-acec-29d2fd535311",
                                "sense_id": "7b223840-d169-38d4-9110-c6a8874f7189",
                                "text": "The only outfit I could conjure up was a capacious linen shift and a saggy cotton-wool cardigan."
                            }
                        ]
                    },
                    {
                        "sense_id": "c91b79c8-ecec-3f66-9215-e0517a361a04",
                        "entry_id": "eab759c0-18bc-3747-a4d4-bd4873187a3d",
                        "glosses": [
                            "Capable, able."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e13ee416-f6ab-4071-b3eb-834fd7a7dc4e",
                                "sense_id": "c91b79c8-ecec-3f66-9215-e0517a361a04",
                                "text": "[T]he fresh brave school-life, so full of games, adventures, and good fellowship, so ready at forgetting, so capacious at enjoying, so bright at forecasting, outweighed a thousandfold their troubles with the master of their form, and the occasional ill-usage of the big boys in the house."
                            },
                            {
                                "example_id": "dfaa175a-436a-4e79-b7c1-0014a9d9241a",
                                "sense_id": "c91b79c8-ecec-3f66-9215-e0517a361a04",
                                "text": "As you will read, Trump himself has a capacious understanding of his power."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c9e24c7-9764-4eda-bbf5-fb0afdfea8c9",
                        "source_entry_id": "eab759c0-18bc-3747-a4d4-bd4873187a3d",
                        "source_sense_description": "having a lot of space inside",
                        "target_lang_word": "ruim",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruim",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "eb8b7bbc-b9bf-37a2-bf38-5f9884dc7fa2",
                                        "entry_id": "9eed6bad-35bb-34d8-ae9a-eebe507208aa",
                                        "glosses": [
                                            "van grote omvang of uitgestrektheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aaea8b3-4610-40d6-9ee9-d5939e1069b2",
                                                "sense_id": "eb8b7bbc-b9bf-37a2-bf38-5f9884dc7fa2",
                                                "text": "Je hebt een ruimere broek nodig."
                                            },
                                            {
                                                "example_id": "4a730b7c-e5e9-4417-ba54-23110fb77939",
                                                "sense_id": "eb8b7bbc-b9bf-37a2-bf38-5f9884dc7fa2",
                                                "text": "De chique, ruime schrijftafel van ebbenhout, die stijlvol was ingelegd met lichtere houtsoorten, die voor het raam was geplaatst naast de openslaande deuren naar het terras en die gepaard was aan een sobere maar degelijke en comfortabele houten bureaustoel uit de jaren dertig, had ik al meteen bij binnenkomst opgemerkt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruim",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ef92815-9bae-3a88-a0ef-ce2df621feab",
                                        "entry_id": "2a456416-59c3-30cc-a8f7-cf9b14c291da",
                                        "glosses": [
                                            "meer dan ongeveer; meer dan genoeg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6971438-e587-4f2f-8087-5571a4547497",
                                                "sense_id": "8ef92815-9bae-3a88-a0ef-ce2df621feab",
                                                "text": "Dat is ruim een pond kaas."
                                            },
                                            {
                                                "example_id": "1afb64a0-a964-4444-b757-02caf7e1e0e8",
                                                "sense_id": "8ef92815-9bae-3a88-a0ef-ce2df621feab",
                                                "text": "Het was in totaal ruim voldoende om Italië, Rusland, Zwitserland en Noorwegen voor te blijven. Zweden werd uiteindelijk pas zesde door een tegenvallende score bij de publieksstemmen."
                                            },
                                            {
                                                "example_id": "be98b17b-f7a5-49b2-a685-f39467be297e",
                                                "sense_id": "8ef92815-9bae-3a88-a0ef-ce2df621feab",
                                                "text": "Wij vonden 25 kilometer per dag al prima, terwijl jullie nu ruim 40 kilometer per dag doorjakkeren. Neem toch de tijd, zoiets maak je maar een keer in je leven mee. Het heeft me nooit losgelaten na al die jaren.’"
                                            },
                                            {
                                                "example_id": "166fb3d4-01c4-46b2-8cfb-5725cce7eca2",
                                                "sense_id": "8ef92815-9bae-3a88-a0ef-ce2df621feab",
                                                "text": "Vanaf dat bedrijventerrein waren de ruim 200 bussen met supporters eerder die avond vertrokken. Go Ahead Eagles had aanhangers al gewaarschuwd dat het \"uitstappen in Deventer enige tijd in beslag kan nemen\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruim",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "16708a31-464a-3b54-a31e-f0504223643e",
                                        "entry_id": "593ba64d-39d4-36ef-932c-b09067b2be8d",
                                        "glosses": [
                                            "de laadruimte van een schip"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6631e7-b476-4c9e-96d3-28ba9b735781",
                                                "sense_id": "16708a31-464a-3b54-a31e-f0504223643e",
                                                "text": "Er ontstond brand in het ruim."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruim",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1f28f858-7bbe-3633-86bb-14834512e967",
                                        "entry_id": "35af8731-8b7e-3ce1-9982-fed9862f2acd",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van ruimen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
