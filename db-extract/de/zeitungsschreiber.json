                        "glosses": [
                            "Person, die für eine Zeitung/Zeitungen schriftliche Beiträge verfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b926886-7986-4389-99f6-7a3b955b2e06",
                                "sense_id": "d2156301-b65b-3de4-9602-75dae0a9afe5",
                                "text": "„Sollten die Zeitungsschreiber doch lieber mal über die Schulen am Prenzlauer Berg berichten, dachte sie, und nicht über Kinderwägen und Milchkaffee und die Luxuswohnungen einer Handvoll Kinder reicher Eltern aus Düsseldorf.“"
                            },
                            {
                                "example_id": "29cf54ca-8588-42f1-b3c0-79e6594d571b",
                                "sense_id": "d2156301-b65b-3de4-9602-75dae0a9afe5",
                                "text": "„Sogar der Zeitungsschreiber ließ sich willig dabei anstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
