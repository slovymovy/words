                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques tentent de <w>trouver</w> une solution efficace contre cette maladie."
                        },
                        {
                            "text": "Il a mis plusieurs jours à <w>trouver</w> une bonne idée pour son projet."
                        }
                    ],
                    "synonyms": [
                        "découvrir",
                        "imaginer",
                        "inventer"
                    ],
                    "common_phrases": [
