                ],
                "senses": [
                    {
                        "sense_id": "fefd66d5-0ef4-3d97-af5a-82ee29b542cc",
                        "entry_id": "3eadde56-0f87-3884-8183-d19d129f93c8",
                        "glosses": [
                            "Stadt, in der reichlich Industrie ansässig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a8b08fb-130e-473e-9f02-e7b02dc676ad",
                                "sense_id": "fefd66d5-0ef4-3d97-af5a-82ee29b542cc",
                                "text": "„Berlin ist in den zwanziger Jahren die größte Industriestadt Deutschlands, Zentrum des Maschinenbaus und der Elektroindustrie, der Vernügungsindustrie und der Warenhäuser.“"
                            },
                            {
                                "example_id": "ee923cf3-d272-4719-84d1-7e936ba532fd",
                                "sense_id": "fefd66d5-0ef4-3d97-af5a-82ee29b542cc",
                                "text": "„Nach El Oued hielten wir ein flottes Tempo und passierten die schmuddeligen Industriestädte Nordalgeriens.“"
                            },
                            {
                                "example_id": "f517e50e-fca8-4423-ae5e-7ef5b0723287",
                                "sense_id": "fefd66d5-0ef4-3d97-af5a-82ee29b542cc",
                                "text": "„Was bei der Mutter ein beinahe zartes Aquarell ergibt, wird beim Sohn zur monumentalen Klage über den Niedergang einer Industriestadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
