                        "translation_id": "b1a27e9a-7f44-4941-ab99-04e155590d8e",
                        "source_entry_id": "005424fe-b9b8-39cd-aa9a-8c4083a2941f",
                        "source_sense_id": "340c07b3-5d16-365d-be79-3123e4ca1e8a",
                        "target_lang_word": "maca",
