                            {
                                "target_lang_word": "Даунсайд",
                                "target_lang_sense_clarification": "топоним в Англии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "096f31ac-7a1d-3896-88b5-4f9240f2d50f",
                    "sense_definition": "A rural community of the City of Wagga Wagga, New South Wales, Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The agricultural region of <w>Downside</w> is situated within the City of Wagga Wagga.",
                            "target_lang_translations": {
                                "ru": "Сельскохозяйственный регион <w>Даунсайд</w> расположен в пределах города Уогга-Уогга."
                            }
                        },
                        {
                            "text": "Many farmers in <w>Downside</w> rely on the seasonal rains for their wheat crops.",
                            "target_lang_translations": {
                                "ru": "Многие фермеры в <w>Даунсайде</w> полагаются на сезонные дожди для урожая пшеницы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specifically Australian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сельская община в городе Уогга-Уогга, Новый Южный Уэльс, Австралия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Даунсайд",
                                "target_lang_sense_clarification": "топоним в Австралии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
