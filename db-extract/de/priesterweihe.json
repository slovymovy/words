                ],
                "senses": [
                    {
                        "sense_id": "db80d96e-c3dc-3dbf-bac2-772ae30db3e8",
                        "entry_id": "a7b9c68a-93aa-3b91-9d89-45345dfa8f98",
                        "glosses": [
                            "die Weihe zum Priester"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41620d77-f782-4fc6-a336-699c17b83ef1",
                                "sense_id": "db80d96e-c3dc-3dbf-bac2-772ae30db3e8",
                                "text": "Die Priesterweihe ist Voraussetzung, als Pfarrer berufen zu werden."
                            },
                            {
                                "example_id": "937ea10c-8fb4-4bf4-aea7-27c1a24038d7",
                                "sense_id": "db80d96e-c3dc-3dbf-bac2-772ae30db3e8",
                                "text": "Die Priesterweihe ermöglicht die Spendung der Sakramente mit Ausnahme des Weihesakraments und ist daher gleichzeitig Fähigkeit und Auftrag zum besonderen, sakramentalen und seelsorglichen Dienst an der Kirche."
                            },
                            {
                                "example_id": "815a2199-d365-4dac-8732-b316582f7ba2",
                                "sense_id": "db80d96e-c3dc-3dbf-bac2-772ae30db3e8",
                                "text": "„Da wurde ich zurückgeholt. Und sitze im Wohnwagen, zusammen mit meinem geheimnisvollen Begleiter, dem Buschauffeur mit Priesterweihe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa0f55ac-053e-4f33-9f1f-c2b182b50c15",
                        "source_entry_id": "a7b9c68a-93aa-3b91-9d89-45345dfa8f98",
                        "source_sense_id": "db80d96e-c3dc-3dbf-bac2-772ae30db3e8",
                        "source_sense_description": "Religion: die Weihe zum Priester",
                        "target_lang_word": "ordination to the priesthood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "efb373cf-bc80-4fa2-9dee-fcc9f1f3289e",
                        "source_entry_id": "a7b9c68a-93aa-3b91-9d89-45345dfa8f98",
                        "source_sense_id": "db80d96e-c3dc-3dbf-bac2-772ae30db3e8",
                        "source_sense_description": "Religion: die Weihe zum Priester",
                        "target_lang_word": "prêtrise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prêtrise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "406416d5-147c-3296-a94c-b787c3ef44c2",
                                        "entry_id": "bc7f3584-39dd-38ac-9d83-a53d4830e122",
                                        "glosses": [
                                            "Sacerdoce, ordre sacré par lequel une personne est prêtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c8005d5-c5fc-4f63-8c09-ff638db09ac2",
                                                "sense_id": "406416d5-147c-3296-a94c-b787c3ef44c2",
                                                "text": "Ce goût-là, ce goût de l’exotique, il l’avait dans le sang comme on a celui de la chasse, de la médecine ou de la prêtrise."
                                            },
                                            {
                                                "example_id": "14c5436d-cc9d-47bd-80c0-be35e1c470d5",
                                                "sense_id": "406416d5-147c-3296-a94c-b787c3ef44c2",
                                                "text": "Jamais encore il n’avait senti à ce point le dégoût de son mensonge, cette prêtrise qui était devenue pour lui un vain geste, cette soutane qu’il s’était résigné à porter comme un déguisement."
                                            },
                                            {
                                                "example_id": "0b80fd17-113e-4291-84d8-5da9483483ad",
                                                "sense_id": "406416d5-147c-3296-a94c-b787c3ef44c2",
                                                "text": "Né au sein d'une famille catholique d'origine sicilienne, élevé dans le quartier de Little Italy à New-York, attiré par la prêtrise à l'adolescence […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb91ecb5-4f9b-4bdf-81bd-f50abdc8f8cb",
                        "source_entry_id": "a7b9c68a-93aa-3b91-9d89-45345dfa8f98",
                        "source_sense_id": "db80d96e-c3dc-3dbf-bac2-772ae30db3e8",
                        "source_sense_description": "Religion: die Weihe zum Priester",
                        "target_lang_word": "ordination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3634a4b-dfb8-33d3-8d67-c6f53f5338c5",
                                        "entry_id": "d7064462-d607-31a4-b2c8-9a2261b63963",
                                        "glosses": [
                                            "Action de conférer ou de recevoir les ordres de l’Église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "942eed99-6692-4664-8c62-446396c9b953",
                                                "sense_id": "e3634a4b-dfb8-33d3-8d67-c6f53f5338c5",
                                                "text": "L’ordination ne peut être donnée que par un évêque."
                                            },
                                            {
                                                "example_id": "9e68300b-9c11-449c-9466-e0c6223a79fc",
                                                "sense_id": "e3634a4b-dfb8-33d3-8d67-c6f53f5338c5",
                                                "text": "Il a reçu l’ordination sacerdotale."
                                            },
                                            {
                                                "example_id": "e081a54f-45db-4a9c-b8b1-020a73b33d16",
                                                "sense_id": "e3634a4b-dfb8-33d3-8d67-c6f53f5338c5",
                                                "text": "Dans tous les pays catholiques [dans les années 1960], les églises se vident, l'ordination des prêtres ne cesse de décliner et bon nombre de clercs retournent à la vie civile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d803c5ff-9550-3106-8bfd-412f38ea4195",
                                        "entry_id": "d7064462-d607-31a4-b2c8-9a2261b63963",
                                        "glosses": [
                                            "Cérémonie au cours de laquelle l’évêque confère les ordres sacrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e458a9a7-9457-4182-9362-e9797290e003",
                                                "sense_id": "d803c5ff-9550-3106-8bfd-412f38ea4195",
                                                "text": "Ma mémoire du calendrier, mon exactitude à souhaiter les anniversaires d’ordination, par exemple, est célèbre."
                                            },
                                            {
                                                "example_id": "964719ec-9236-4976-8eef-bc821e8a33a8",
                                                "sense_id": "d803c5ff-9550-3106-8bfd-412f38ea4195",
                                                "text": "Les ordinations se font le jour de la Pierre, la veille de la Pentecôte, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fee4ffa-a592-32c9-afa9-fb7c042375d3",
                                        "entry_id": "d7064462-d607-31a4-b2c8-9a2261b63963",
                                        "glosses": [
                                            "Mise en ordre, arrangement, organisation."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9393675c-1d57-41e3-8e82-5bd79e869e26",
                                                "sense_id": "2fee4ffa-a592-32c9-afa9-fb7c042375d3",
                                                "text": "Avant que de s’occuper de l’ordination générale des choses, il prit une forme matérielle ; car l’esprit n’a aucun rapport avec le corps & pour agir sur le corps il faut que l’esprit s’en revétisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0de8433-c4fc-340e-bd79-3c7cc55a53e5",
                                        "entry_id": "d7064462-d607-31a4-b2c8-9a2261b63963",
                                        "glosses": [
                                            "Mise en ordre, organisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ff4a2a-9ffc-4091-a385-4d5b889dd978",
                                                "sense_id": "a0de8433-c4fc-340e-bd79-3c7cc55a53e5",
                                                "text": "Nous pensons ainsi que l’interprétation détermine et, dans ce sens, précède logiquement l’acquisition, la description et l’ordination des données de la fouille, ou, du moins, la forme définitive sous laquelle ces diverses étapes devraient être présentées au lecteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "019e4dad-eb52-3869-afe9-a075353c5e48",
                                        "entry_id": "d7064462-d607-31a4-b2c8-9a2261b63963",
                                        "glosses": [
                                            "Mise en ordre, organisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12570c8-6a15-40b9-a16e-387b519416a8",
                                                "sense_id": "019e4dad-eb52-3869-afe9-a075353c5e48",
                                                "text": "La méthode présente des points communs avec Twinspan, en ce sens qu’elle débute par une ordination des données suivie d’un partitionnement des relevés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eea8458-bab6-419b-aa84-05aa96ab974b",
                        "source_entry_id": "a7b9c68a-93aa-3b91-9d89-45345dfa8f98",
