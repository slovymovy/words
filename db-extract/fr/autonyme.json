                "senses": [
                    {
                        "sense_id": "a5810b7b-f3f2-35c9-be47-f3b21bc9df3f",
                        "entry_id": "7827f7a1-f6cd-3f95-afa8-49f03d267fb3",
                        "glosses": [
                            "Qui se désigne lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49d101cd-c327-4033-ad9e-16898606b704",
                                "sense_id": "a5810b7b-f3f2-35c9-be47-f3b21bc9df3f",
                                "text": "Un écrivain qui se cite dans un roman est autonyme."
                            }
                        ]
                    },
                    {
                        "sense_id": "667282e6-38f6-3394-b535-6ffba990c554",
                        "entry_id": "7827f7a1-f6cd-3f95-afa8-49f03d267fb3",
                        "glosses": [
                            "Qui se désigne lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec4b2bb-c7e5-4712-90b2-2afbdf83fb60",
                                "sense_id": "667282e6-38f6-3394-b535-6ffba990c554",
                                "text": "Le mot voiture est autonyme dans l’énoncé « Voiture est féminin. »."
                            }
                        ]
                    },
                    {
                        "sense_id": "64c66e50-ff9a-3da0-8860-9b248b5be76d",
                        "entry_id": "7827f7a1-f6cd-3f95-afa8-49f03d267fb3",
                        "glosses": [
                            "Dont le signifié s’applique à son propre signifiant."
                        ],
                        "tags": [],
                        "note": "Rare en ce sens",
                        "examples": [
                            {
                                "example_id": "3ad816b0-c370-41af-a18d-0ccdf82d311a",
                                "sense_id": "64c66e50-ff9a-3da0-8860-9b248b5be76d",
                                "text": "Le mot qui s’applique à lui-même est autologique (autonyme)."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a41fee0-fd57-34a9-b68d-e8d87ff1be95",
                        "entry_id": "7827f7a1-f6cd-3f95-afa8-49f03d267fb3",
                        "glosses": [
                            "Tautonyme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c62d2d69-a6e6-4e2b-b5e2-e033a0c62882",
                                "sense_id": "7a41fee0-fd57-34a9-b68d-e8d87ff1be95",
                                "text": "Les flores anciennes signalaient Caleopsis ladanum au sens large (d’ailleurs « très commun »). Or si la sous-espèce angustifolia est bien présente dans notre région, la sous-espèce autonyme n’y est pas, et il est peu probable qu’elle y ait été."
                            }
                        ]
                    }
