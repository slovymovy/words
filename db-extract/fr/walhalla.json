                                        "sense_id": "4f449836-e6a5-3d41-8268-fa77b71bc098",
                                        "entry_id": "79d92e85-eae5-3a54-a821-26b32f53258a",
                                        "glosses": [
                                            "Ort, an den in der Schlacht gefallene Krieger kommen"
