                        "sense_id": "dd456966-f7bb-380c-a9f2-e7ec792dd6dd",
                        "entry_id": "8cb239ae-e22e-3f77-aca3-5566d537991b",
                        "glosses": [
                            "horntragendes Tier der höheren Gebirge Europas und Kleinasiens: Rupicapra rupicapra"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e11bc878-2659-40a4-928f-9c7c12a0af71",
                                "sense_id": "dd456966-f7bb-380c-a9f2-e7ec792dd6dd",
                                "text": "„‚Von den Zahlen her ist die Gams sicher nicht gefährdet‘, sagt Kinser.“"
                            },
                            {
                                "example_id": "8d9af718-fcb9-4582-a01f-737e147cc9b9",
                                "sense_id": "dd456966-f7bb-380c-a9f2-e7ec792dd6dd",
                                "text": "„Gut, dachte ich, wo es den Gamsen wild genug ist, kann sich theoretisch auch ein Bär aufhalten.“"
                            },
                            {
                                "example_id": "a3a365f8-c873-40cd-a9a6-0683552e7d42",
                                "sense_id": "dd456966-f7bb-380c-a9f2-e7ec792dd6dd",
                                "text": "„Der beste Theil von seiner Kraft und seinen Gedanken ist anderswo und fliegt wahrscheinlich in der weiten Welt um einander … vermuthlich bei dem Gamsen am Gewand und bei den Hirschen im Wald!“"
                            }
                        ],
