                            {
                                "example_id": "66f45a3e-61a6-4c7c-8f3c-c3b4a279f868",
                                "sense_id": "c89fb7cd-1a90-33ea-9cf5-0c6cd9f017ab",
                                "text": "Отлогость берега."
                            }
                        ]
                    },
                    {
                        "sense_id": "d19ffa70-8cb0-30bd-9d6e-c0c925513b93",
                        "entry_id": "47d61091-71dd-3359-a960-08b38fc8c574",
                        "glosses": [
                            "слегка наклонное место, отлогая поверхность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be6014e0-70ee-46c4-aa85-7c32110241e0",
                                "sense_id": "d19ffa70-8cb0-30bd-9d6e-c0c925513b93",
                                "text": "Все тропинки сада, покрывавшего отлогость против наших домов, были мне известны."
                            },
                            {
                                "example_id": "8954fb10-26e4-4672-9cc9-c30be6b42a73",
                                "sense_id": "d19ffa70-8cb0-30bd-9d6e-c0c925513b93",
                                "text": "Налево была гора Гринберг, зелёная не по одному названию. Она очень красива, с большими отлогостями, живописными холмами и оврагами."
                            }
                        ]
                    }
