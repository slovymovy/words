                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bdfb0ed-1813-3490-b5cf-1d292b60da64",
                        "entry_id": "28dfad72-3c1b-3a8f-b61e-90174a800fb6",
                        "glosses": [
                            "устар. то же, что дальний"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6573a79-1ac9-4993-a4df-cace1b3c1a67",
                                "sense_id": "6bdfb0ed-1813-3490-b5cf-1d292b60da64",
                                "text": "Начну на флейте стихи печальны, // Зря на Россию чрез страны дальны:"
                            },
                            {
                                "example_id": "88b94eb5-d6b1-41c2-a44c-628326aceb90",
                                "sense_id": "6bdfb0ed-1813-3490-b5cf-1d292b60da64",
                                "text": "В сем расположении духа, он лёг в приготовленную для него походную кровать, и тогда привычное сновидение перенесло его в дальный Париж в объятия милой графини."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77f4c638-1031-4088-b04d-4d7faa2f80b1",
                        "source_entry_id": "28dfad72-3c1b-3a8f-b61e-90174a800fb6",
                        "source_sense_id": "6bdfb0ed-1813-3490-b5cf-1d292b60da64",
                        "target_lang_word": "distant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "480309b0-a78c-3691-82b2-873478753d27",
                                        "entry_id": "6226afc4-7c8e-3a7a-ab88-0c1e8b6a28e6",
                                        "glosses": [
                                            "Far off (physically, logically or mentally)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c55943a9-c058-498c-b1eb-037c4117dec2",
                                                "sense_id": "480309b0-a78c-3691-82b2-873478753d27",
                                                "text": "We heard a distant rumbling but didn't pay any more attention to it. She was surprised to find that her fiancé was a distant relative of hers. His distant look showed that he was not listening to me."
                                            },
                                            {
                                                "example_id": "67bb4652-017e-4710-a80a-8380c9c3e734",
                                                "sense_id": "480309b0-a78c-3691-82b2-873478753d27",
                                                "text": "Judge Short had gone to town, and Farrar was off for a three days' cruise up the lake. I was bitterly regretting I had not gone with him when the distant notes of a coach horn reached my ear, and I descried a four-in-hand winding its way up the inn road from the direction of Mohair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4dd26d9-18eb-3b96-995c-4552659ead05",
                                        "entry_id": "6226afc4-7c8e-3a7a-ab88-0c1e8b6a28e6",
                                        "glosses": [
                                            "Emotionally unresponsive or unwilling to express genuine feelings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8194b4b-b9bc-4a06-b31e-165a7eacbb62",
                                                "sense_id": "e4dd26d9-18eb-3b96-995c-4552659ead05",
                                                "text": "Ever since our argument, she has been totally distant toward me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3895f29-d287-3303-911d-f8da3d95b3c1",
                                        "entry_id": "6226afc4-7c8e-3a7a-ab88-0c1e8b6a28e6",
                                        "glosses": [
                                            "Imported into a cable television system from a different market (and thus possibly incurring a copyright royalty)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1b04063-8a84-427b-a862-5efc20e297f6",
                                                "sense_id": "d3895f29-d287-3303-911d-f8da3d95b3c1",
                                                "text": "Any determination that a particular television signal is \"distant\" must, of course, be made with respect to its proximity to a specific local area, which we have termed the CATV community, […]"
                                            },
                                            {
                                                "example_id": "31f41927-d9c7-46aa-ae24-883eb4473da4",
                                                "sense_id": "d3895f29-d287-3303-911d-f8da3d95b3c1",
                                                "text": "Finally, there will be those unusual situations where a signal is distant to part of a CATV system and local to the rest of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01b6d6c7-c1a3-4339-9175-e645c49aeb64",
                        "source_entry_id": "28dfad72-3c1b-3a8f-b61e-90174a800fb6",
                        "source_sense_id": "6bdfb0ed-1813-3490-b5cf-1d292b60da64",
                        "target_lang_word": "far",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "far",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08122f3a-5bd9-3c9a-860d-38fb1047f686",
                                        "entry_id": "86dc8d3b-f2cb-3870-97dd-c498cf1648be",
                                        "glosses": [
                                            "Distant; remote in space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd710c5f-8f35-4792-937d-fd174055b9dd",
                                                "sense_id": "08122f3a-5bd9-3c9a-860d-38fb1047f686",
                                                "text": "He went to a far land."
                                            },
                                            {
                                                "example_id": "cf6b51ff-f3da-4528-a532-8e2baf85b645",
                                                "sense_id": "08122f3a-5bd9-3c9a-860d-38fb1047f686",
                                                "text": "And they went to Ioshua vnto the campe at Gilgal, and said vnto him, and to the men of Israel, Wee be come from a farre countrey: Now therefore make ye a league with vs."
                                            },
                                            {
                                                "example_id": "fe48c424-5c1f-424d-ac3f-c84a1fde5160",
                                                "sense_id": "08122f3a-5bd9-3c9a-860d-38fb1047f686",
                                                "text": "Tsiolkas's Europe, as voraciously predatory as his own undead protagonist, is a far cry from the fount of idealistic humanism dreamed up by generations of both pre- and post-Enlightenment politicians and philosophers, a Europe defined by its durable capacity for civility in an otherwise barbarous world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa2a5cbe-f9e6-3cae-a0de-33aec6a1d50c",
                                        "entry_id": "86dc8d3b-f2cb-3870-97dd-c498cf1648be",
                                        "glosses": [
                                            "Remote in time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "535673c6-2f61-4692-83a3-2b79a14b68d8",
                                                "sense_id": "fa2a5cbe-f9e6-3cae-a0de-33aec6a1d50c",
                                                "text": "the far far future"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc1ee395-e22c-3995-a6f6-26d43eb76749",
                                        "entry_id": "86dc8d3b-f2cb-3870-97dd-c498cf1648be",
                                        "glosses": [
                                            "Long."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78b6b2b3-063f-4668-a893-c0e72025255a",
                                                "sense_id": "cc1ee395-e22c-3995-a6f6-26d43eb76749",
                                                "text": "I have such a long way to go but yet I have come such a far piece already"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b0f52d0-09c1-30ff-8d0d-fd12010c4f54",
                                        "entry_id": "86dc8d3b-f2cb-3870-97dd-c498cf1648be",
                                        "glosses": [
                                            "More remote of two."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9e3c3d-4efe-4b9f-8e65-50874ad51950",
                                                "sense_id": "5b0f52d0-09c1-30ff-8d0d-fd12010c4f54",
                                                "text": "At the far end of the houses the head gardener stood waiting for his mistress, and he gave her strips of bass to tie up her nosegay. This she did slowly and laboriously, with knuckly old fingers that shook."
                                            },
                                            {
                                                "example_id": "4681d6af-96d9-4c30-8dbe-357ef50cc545",
                                                "sense_id": "5b0f52d0-09c1-30ff-8d0d-fd12010c4f54",
                                                "text": "See those two mountains? The ogre lives on the far one."
                                            },
                                            {
                                                "example_id": "4d327aa3-9aa0-4c15-9089-0299be9a279b",
                                                "sense_id": "5b0f52d0-09c1-30ff-8d0d-fd12010c4f54",
                                                "text": "He moved to the far end of the state. She remained at this end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12170426-3a6c-33d2-8fdd-849a329e8052",
                                        "entry_id": "86dc8d3b-f2cb-3870-97dd-c498cf1648be",
                                        "glosses": [
                                            "Extreme, as measured from some central or neutral position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33a98afd-e35f-46de-8ec2-f48e8a5076ac",
                                                "sense_id": "12170426-3a6c-33d2-8fdd-849a329e8052",
                                                "text": "They are on the far right on this issue."
                                            },
                                            {
                                                "example_id": "637e48ef-ea80-4559-aff5-0a6e01e9fd1d",
                                                "sense_id": "12170426-3a6c-33d2-8fdd-849a329e8052",
                                                "text": "He was withdrawn to such a far degree that it required of Piers and Jude a good deal of occasional conferencing between the two of them, in private."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cc0f7e0-f9ac-3ca6-aaeb-9b2deb2faa06",
                                        "entry_id": "86dc8d3b-f2cb-3870-97dd-c498cf1648be",
                                        "glosses": [
                                            "Extreme, as a difference in nature or quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367b0c4a-b198-4242-be15-30b6d75d657e",
                                                "sense_id": "9cc0f7e0-f9ac-3ca6-aaeb-9b2deb2faa06",
                                                "text": "As sensible maketh a man differ from a stone, in a far difference; for other Species, as Beasts, have the same difference, but reasonable is the nearest, whereby he differeth from a stone, beasts, and all other things."
                                            },
                                            {
                                                "example_id": "aa04a288-cc06-4ec1-932f-72007b692bad",
                                                "sense_id": "9cc0f7e0-f9ac-3ca6-aaeb-9b2deb2faa06",
                                                "text": "Is there not a far difference between asking it up and urging it, Mr. Secretary?"
                                            },
                                            {
                                                "example_id": "a2e59cbc-5161-45bb-818d-3d9fa0f97b30",
                                                "sense_id": "9cc0f7e0-f9ac-3ca6-aaeb-9b2deb2faa06",
                                                "text": "The pressbook identifies the film as a 'picturization of Jane Austen's widely read novel' and starring Greer Garson and Laurence Olivier (based on the theatrical adaptation by Helen Jerome), it is a far remove from adaptations that follow."
                                            },
                                            {
                                                "example_id": "06c44e40-27bf-425c-91f7-4adfc76ebb86",
                                                "sense_id": "9cc0f7e0-f9ac-3ca6-aaeb-9b2deb2faa06",
                                                "text": "This may not be at such a far remove from the endlessly recursive textual inventions of Kafka, Beckett, and Bernhard as it may seem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2af289a9-4239-3dc2-b9c0-dee5b3c4cd7b",
                                        "entry_id": "86dc8d3b-f2cb-3870-97dd-c498cf1648be",
                                        "glosses": [
                                            "Outside the currently selected segment in a segmented memory architecture."
                                        ],
