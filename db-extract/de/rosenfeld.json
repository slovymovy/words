                ],
                "senses": [
                    {
                        "sense_id": "499bcfa4-f952-3215-b463-71a32da05a03",
                        "entry_id": "7460a712-20ab-37c9-b23b-0287c7aaa1b8",
                        "glosses": [
                            "größere Fläche, auf der Rosen kultiviert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8d80291-3479-411c-a42a-b12ad1cd409f",
                                "sense_id": "499bcfa4-f952-3215-b463-71a32da05a03",
                                "text": "„Exklusiv zur Landesgartenschau haben sechs Rosenbetriebe aus Steinfurth gemeinsam ein Rosenfeld angelegt, das an der Steinfurther Straße bewundert werden kann.“"
                            },
                            {
                                "example_id": "a6cab172-ad31-4e74-b01e-39ddde7dc2e9",
                                "sense_id": "499bcfa4-f952-3215-b463-71a32da05a03",
                                "text": "„Duftenden Rosenfeldern begegnet man auch in der Süd-, Ost- und Weststeiermark.“"
                            },
                            {
                                "example_id": "a2c62b2e-7782-4a55-b8fb-33298c055ea4",
                                "sense_id": "499bcfa4-f952-3215-b463-71a32da05a03",
                                "text": "„Er mochte Henni, und sie ging ihm gerne auf dem Rosenfeld zur Hand, wo er ihr das richtige Beschneiden und Veredeln der Pflanzen beibrachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
