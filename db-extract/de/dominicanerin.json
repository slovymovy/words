                                        "entry_id": "43478b9f-a21b-3b46-939b-c4d3b810a43f",
                                        "glosses": [
                                            "A person from the Dominican Republic or of its descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c58da43f-150a-473e-bcf1-211df2a16033",
                                                "sense_id": "46d738d0-9961-3715-a52e-4189babb4387",
                                                "text": "More than 40% of Dominicans are economically vulnerable and are at risk of falling into poverty due to climate-related impacts and economic crises, according to the World Bank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9278933c-c157-3907-84cf-5273458072af",
                                        "entry_id": "43478b9f-a21b-3b46-939b-c4d3b810a43f",
                                        "glosses": [
                                            "A person from the Commonwealth of Dominica or of its descent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e77fe0d-eb2c-32fc-afa4-af5508b80cfa",
                                        "entry_id": "43478b9f-a21b-3b46-939b-c4d3b810a43f",
                                        "glosses": [
                                            "A member of the religious order founded by St. Dominic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Dominican",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79a5f340-fd90-38a3-8938-a2e73167d6aa",
                                        "entry_id": "c5d88cda-ae90-3e8f-a9e3-89b468587170",
                                        "glosses": [
                                            "Of, from, or pertaining to the Dominican Republic, or its people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61711d13-6850-4e81-ba21-ae479613ffdc",
                                                "sense_id": "79a5f340-fd90-38a3-8938-a2e73167d6aa",
                                                "text": "And while the Dominican economy grew by 4.9% last year, high inflation rates in both 2022 (8.8%) and 2023 (4.8%) have taken a toll on the population’s quality of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffae2fb2-e6e8-336d-93d1-bc95fbfb3f44",
                                        "entry_id": "c5d88cda-ae90-3e8f-a9e3-89b468587170",
                                        "glosses": [
                                            "Of, from, or pertaining to Dominica, or its people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a97fc1fc-b0de-3c5d-ba25-3654be39d31f",
                                        "entry_id": "c5d88cda-ae90-3e8f-a9e3-89b468587170",
                                        "glosses": [
                                            "Of or belonging to the Dominican religious order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5b0c00e-07f7-4148-8500-a55bf8979f65",
                                                "sense_id": "a97fc1fc-b0de-3c5d-ba25-3654be39d31f",
                                                "text": "The first night, I did nothing more than have a glass of wine at Faust Wine Cellar, located under the Dominican cloister that houses the Hilton Budapest Hotel in the Buda Castle complex."
                                            }
                                        ]
                                    }
                                ]
                            }
