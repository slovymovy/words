                                        "examples": [
                                            {
                                                "example_id": "8ff44510-e711-4eb1-b4be-2c3b2936ae47",
                                                "sense_id": "74e1249a-51f9-3c1a-9250-51d292d1540c",
                                                "text": "Stack all new and fresh, composed of the fast-selling standard books only — no old plugs or unsalable books whatever."
                                            },
                                            {
                                                "example_id": "12d2c89f-028f-4bf0-ba73-6deae2697df6",
                                                "sense_id": "74e1249a-51f9-3c1a-9250-51d292d1540c",
                                                "text": "Many New York booksellers promoted the impression that Quaritch had sent only 'plugs' (i.e. unsaleable books)."
