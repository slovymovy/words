{
    "word_family": [
        "рано",
        "ранний",
        "рань"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a3476189-eb7c-3a1a-b52b-ab09ff0fce1c",
                    "sense_definition": "В прошлом; в прежнее время (обычно в противопоставлении настоящему).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Раньше> здесь был красивый парк, а теперь построили магазин.",
                            "target_lang_translations": {
                                "en": "<Previously> there was a beautiful park here, but now they have built a shop.",
                                "de": "<Früher> gab es hier einen schönen Park, aber jetzt haben sie ein Geschäft gebaut.",
                                "zh": "<w>以前</w>这里有个漂亮的公园，现在盖了家商店。"
                            }
                        },
                        {
                            "text": "Мы никогда <раньше> не встречались, но я много о вас слышал.",
                            "target_lang_translations": {
                                "en": "We have never met <before>, but I have heard a lot about you.",
                                "de": "Wir haben uns noch nie <zuvor> getroffen, aber ich habe viel von Ihnen gehört.",
                                "zh": "我们<w>以前</w>从没见过面，但我听说过很多关于您的事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "прежде"
                    ],
                    "antonyms": [
                        "потом",
                        "позже"
                    ],
                    "common_phrases": [
                        "как раньше",
                        "намного раньше",
                        "раньше или позже"
                    ],
                    "target_lang_definitions": {
                        "en": "In the past; in former times (usually contrasting with the present).",
                        "de": "In der Vergangenheit; in früheren Zeiten (meist im Gegensatz zur Gegenwart).",
                        "zh": "在过去；在从前（通常与现在形成对比）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "before",
                                "target_lang_sense_clarification": "at an earlier time; in the past"
                            },
                            {
                                "target_lang_word": "formerly",
                                "target_lang_sense_clarification": "in the past; previously"
                            },
                            {
                                "target_lang_word": "previously",
                                "target_lang_sense_clarification": "before the present time"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "früher",
                                "target_lang_sense_clarification": "in der Vergangenheit"
                            },
                            {
                                "target_lang_word": "vorher",
                                "target_lang_sense_clarification": "vor einem bestimmten Zeitpunkt"
                            },
                            {
                                "target_lang_word": "damals",
                                "target_lang_sense_clarification": "in jener Zeit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "以前",
                                "target_lang_sense_clarification": "指过去的时间"
                            },
                            {
                                "target_lang_word": "从前",
                                "target_lang_sense_clarification": "指很久以前"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1186f16b-385c-3f38-bf67-8f8791616ed6",
                    "sense_definition": "Сравнительная степень наречия <w>рано</w>; в более раннее время, до определенного срока.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_comp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Постарайся прийти домой <раньше> обычного.",
                            "target_lang_translations": {
                                "en": "Try to come home <earlier> than usual.",
                                "de": "Versuche, <früher> als sonst nach Hause zu kommen.",
                                "zh": "尽量比平时<w>早</w>点回家。"
                            }
                        },
                        {
                            "text": "В этом году снег выпал <раньше>, чем в прошлом.",
                            "target_lang_translations": {
                                "en": "This year snow fell <earlier> than last year.",
                                "de": "In diesem Jahr ist der Schnee <früher> gefallen als im letzten.",
                                "zh": "今年下雪比去年<w>早</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "позже",
                        "позднее"
                    ],
                    "common_phrases": [
                        "раньше времени",
                        "раньше всех",
                        "как можно раньше",
                        "днём раньше"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative degree"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative degree of 'early'; at an earlier time.",
                        "de": "Komparativ des Adverbs 'früh'; zu einem früheren Zeitpunkt, vor einer bestimmten Frist.",
                        "zh": "“早”的比较级；在更早的时间，在某个期限之前。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "earlier",
                                "target_lang_sense_clarification": "comparative of early"
                            },
                            {
                                "target_lang_word": "sooner",
                                "target_lang_sense_clarification": "before the expected time"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "früher",
                                "target_lang_sense_clarification": "Komparativ von früh"
                            },
                            {
                                "target_lang_word": "eher",
                                "target_lang_sense_clarification": "zeitlich früher"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "早",
                                "target_lang_sense_clarification": "时间靠前"
                            },
                            {
                                "target_lang_word": "提前",
                                "target_lang_sense_clarification": "比预定时间早"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d59a5cf-0047-3a99-a151-ad96d1a5b0a4",
                    "sense_definition": "Сначала; в первую очередь; до того, как сделать что-то другое.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нужно было думать об этом <раньше>, когда ещё было время всё исправить.",
                            "target_lang_translations": {
                                "en": "You should have thought about this <sooner>, when there was still time to fix everything.",
                                "de": "Man hätte <eher> darüber nachdenken sollen, als noch Zeit war, alles zu korrigieren.",
                                "zh": "你应该<w>早</w>点考虑这件事，那时还有时间补救。"
                            }
                        },
                        {
                            "text": "Не знаешь, за что <раньше> браться: за уборку или за готовку.",
                            "target_lang_translations": {
                                "en": "You don't know what to take up <first>: cleaning or cooking.",
                                "de": "Man weiß nicht, was man <zuerst> anpacken soll: das Putzen oder das Kochen.",
                                "zh": "不知道该<w>先</w>做什么：打扫卫生还是做饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сперва",
                        "сначала",
                        "поначалу"
                    ],
                    "antonyms": [
                        "потом",
                        "затем"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "implied context of priority"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First; in the first place; before doing something else.",
                        "de": "Zuerst; an erster Stelle; bevor man etwas anderes tut.",
                        "zh": "首先；在做其他事情之前。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "first",
                                "target_lang_sense_clarification": "before anything else in sequence"
                            },
                            {
                                "target_lang_word": "sooner",
                                "target_lang_sense_clarification": "earlier than something else"
                            },
                            {
                                "target_lang_word": "beforehand",
                                "target_lang_sense_clarification": "in advance"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zuerst",
                                "target_lang_sense_clarification": "an erster Stelle"
                            },
                            {
                                "target_lang_word": "eher",
                                "target_lang_sense_clarification": "bevorzugt oder früher"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先",
                                "target_lang_sense_clarification": "在其他动作之前"
                            },
                            {
                                "target_lang_word": "首先",
                                "target_lang_sense_clarification": "第一步"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}