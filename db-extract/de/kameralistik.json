                        "entry_id": "775528b7-e7cd-3e53-91e9-706e269fce52",
                        "glosses": [
                            "Verfahren der Buchführung, bei der die Zahlungsströme im Mittelpunkt stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b66bea35-d408-4d59-9c07-1864cbb569e5",
                                "sense_id": "a0fd66a8-c6c6-3a1e-90a2-269a6873a7fd",
                                "text": "„Die Kameralistik erfasst im Gegensatz zur Doppik nur den Geldverbrauch und nicht den Werteverzehr, sodass lediglich die Einnahmen und Ausgaben eines Jahres erfasst werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
