                    {
                        "translation_id": "b66aab96-408f-4cc0-80bf-a09676c4501f",
                        "source_entry_id": "e7411e32-3967-3187-a0a2-17b8d5f0f4ab",
                        "source_sense_id": "0ecf6b21-f5ba-3c2d-b005-b133fdfebfd5",
                        "target_lang_word": "fausset",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fausset",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e32b891b-ae46-3a3b-99d9-6b41b79f740d",
                                        "entry_id": "1a227317-0679-3451-b50b-178e280009cb",
                                        "glosses": [
                                            "Petite cheville de bois servant à boucher le trou que l’on fait à un tonneau pour en goûter le contenu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "132325fc-708f-481b-9600-c7dcf36c6b34",
                                                "sense_id": "e32b891b-ae46-3a3b-99d9-6b41b79f740d",
                                                "text": "Mettre un fausset."
                                            },
                                            {
                                                "example_id": "dd1206f1-6de4-4f66-b7f5-4252c1c305c5",
                                                "sense_id": "e32b891b-ae46-3a3b-99d9-6b41b79f740d",
                                                "text": "Enfoncer le fausset."
                                            },
                                            {
                                                "example_id": "9dba3c44-660f-4fab-853a-a54912c57b2d",
                                                "sense_id": "e32b891b-ae46-3a3b-99d9-6b41b79f740d",
                                                "text": "Tirer du vin au fausset."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fausset",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edca573a-7d43-3357-91e3-c3488691ff5b",
                                        "entry_id": "7742cb32-a653-3c55-80b8-4ca14afb8e4a",
                                        "glosses": [
                                            "Technique vocale utilisant le registre le plus aigu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d51dcc8f-34dd-42c2-a56a-91cff8c8c44e",
                                                "sense_id": "edca573a-7d43-3357-91e3-c3488691ff5b",
                                                "text": "Chanter en fausset."
                                            },
                                            {
                                                "example_id": "a1648b83-356a-41d5-adb7-228a8dd46c18",
                                                "sense_id": "edca573a-7d43-3357-91e3-c3488691ff5b",
                                                "text": "Prendre le fausset."
                                            },
                                            {
                                                "example_id": "ece59a57-eebb-4c1c-8881-f5258cf67406",
                                                "sense_id": "edca573a-7d43-3357-91e3-c3488691ff5b",
                                                "text": "Et quand je le reçus de leurs mains, vers midi, dans le vestibule de la maison de mon oncle, toujours fermé dans la journée à cause de la lourde chaleur du dehors, on entendait, à la cantonade, mon grand cousin qui chantait, d’une voix atténuée en fausset plaintif de montagnard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad2153bc-1cff-39ea-abf0-cfeca3f17cb0",
                                        "entry_id": "7742cb32-a653-3c55-80b8-4ca14afb8e4a",
                                        "glosses": [
                                            "Voix très aiguë."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7772818-ff37-47a4-91dd-b4f318f99443",
                                                "sense_id": "ad2153bc-1cff-39ea-abf0-cfeca3f17cb0",
                                                "text": "Il prononçait chaque mot clairement ; son accent était pur, et il s’exprimait en bon castillan, que le condamné n’entendait peut-être que très imparfaitement. Il commençait chaque phrase d’un ton de voix glapissant, et s’élevait au fausset, mais il finissait sur un ton grave et bas."
                                            },
                                            {
                                                "example_id": "974a346d-4f80-4ad9-b61e-ea14b888de22",
                                                "sense_id": "ad2153bc-1cff-39ea-abf0-cfeca3f17cb0",
                                                "text": "Oui, des menteries ! hurla-t-il dans son fausset le plus aigu."
                                            },
                                            {
                                                "example_id": "71d8ffb2-5db3-41a0-ab81-9c9d0a617daa",
                                                "sense_id": "ad2153bc-1cff-39ea-abf0-cfeca3f17cb0",
                                                "text": "Pas possible de parler, faisait-il d’une comique voix de fausset. J’ai tellement soif que mes paroles tombent en poussière !…"
                                            },
                                            {
                                                "example_id": "d1efe715-6aae-4fc3-9e07-a0443c8f0fc3",
                                                "sense_id": "ad2153bc-1cff-39ea-abf0-cfeca3f17cb0",
                                                "text": "Thérèse, moins par lassitude que pour échapper à ces paroles dont on l'étourdissait depuis des semaines, ralentit en vain sa marche ; impossible de ne pas entendre le fausset de son père."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79f7ee69-4d88-379a-8b46-5d97d10f4290",
                                        "entry_id": "7742cb32-a653-3c55-80b8-4ca14afb8e4a",
                                        "glosses": [
                                            "Chanteur doté d’une telle voix."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a76a04a0-b89b-4b56-a5d2-0741f6c8d0ec",
                                                "sense_id": "79f7ee69-4d88-379a-8b46-5d97d10f4290",
                                                "text": "En l’espace de quelques années, il fit évacuer tous les falsettistes restants pour les remplacer par des castrats sopranos, les parties d’alto demeurant encore assez longtemps confiées à des faussets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a66bac8-190d-49d5-8870-3e97ec942d2a",
                        "source_entry_id": "e7411e32-3967-3187-a0a2-17b8d5f0f4ab",
                        "source_sense_id": "0ecf6b21-f5ba-3c2d-b005-b133fdfebfd5",
                        "target_lang_word": "Falsett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falsett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7dc985f-acdc-3fa6-a04e-9c129b90a01b",
                                        "entry_id": "0c3419c4-b596-39b8-8eec-bbcee6a16b90",
                                        "glosses": [
                                            "um eine Oktave erhöhte Männerstimme, was durch eine besondere Gesangstechnik erreicht wird, bei der nur die Stimmlippenränder in Schwingungen versetzt werden"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Gesang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a3ec8af-20d3-4a82-bc5e-a918ac035adc",
                                                "sense_id": "d7dc985f-acdc-3fa6-a04e-9c129b90a01b",
                                                "text": "Die Bee Gees sangen viele ihrer Lieder im Falsett."
                                            },
                                            {
                                                "example_id": "d3e5162b-75b4-40ce-b4fa-8801f2084ab3",
                                                "sense_id": "d7dc985f-acdc-3fa6-a04e-9c129b90a01b",
                                                "text": "„Er sang sie in einem ganz hohen Falsett, es klang klar und fromm, und sogar Otto Quangel fühlte sich in seine Kindertage zurückversetzt, als solche Lieder ihm noch etwas bedeutet hatten, da er schlicht gläubig gewesen war.“"
                                            },
                                            {
                                                "example_id": "cbcb66cb-c21d-4fa7-92bf-393c56b412e8",
                                                "sense_id": "d7dc985f-acdc-3fa6-a04e-9c129b90a01b",
                                                "text": "„»Tag, Mr. Belane!« sagte er in einem hohen Falsett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82ed0760-e2ea-49ad-b668-1dc52c38f4ff",
                        "source_entry_id": "e7411e32-3967-3187-a0a2-17b8d5f0f4ab",
