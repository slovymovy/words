                "senses": [
                    {
                        "sense_id": "bd09364d-eb65-3c14-bb8d-889e729b7df8",
                        "entry_id": "ed6ccdc6-1ff4-3871-a831-c54fe26ec447",
                        "glosses": [
                            "поэт., устар. то же, что молот"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0270ceb-fd61-4ac4-a307-e7c09309c6ff",
                                "sense_id": "bd09364d-eb65-3c14-bb8d-889e729b7df8",
                                "text": "Так тяжкой млат, // Дробя стекло, куёт булат."
                            },
                            {
                                "example_id": "83b544d6-0421-4d65-a6ed-cb48560e325e",
                                "sense_id": "bd09364d-eb65-3c14-bb8d-889e729b7df8",
                                "text": "Амфион ударил в лиру ― // И составилась стена; // Он отторг млаты, секиру, // И бряцала лишь струна."
                            }
                        ]
                    }
