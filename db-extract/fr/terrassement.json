                ],
                "senses": [
                    {
                        "sense_id": "05753e28-80d7-3779-bb66-16b54242b3fe",
                        "entry_id": "4cd0ca0b-5d6c-3ac1-978a-34f62b226f41",
                        "glosses": [
                            "Action de terrasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a2e77f6-5af8-4d47-814b-61fe8bb90c65",
                                "sense_id": "05753e28-80d7-3779-bb66-16b54242b3fe",
                                "text": "Suivront les travaux de gros œuvre : reprise en sous-œuvre, modification des murs porteurs, démolitions de planchers, terrassements, etc."
                            },
                            {
                                "example_id": "4202a438-e478-49b4-8912-3c718e2b4773",
                                "sense_id": "05753e28-80d7-3779-bb66-16b54242b3fe",
                                "text": "Le boulevard Malesherbes, qui abattait des hôtels superbes, dans les rues d’Anjou et de la Ville-l’Évêque, et qui nécessitait des travaux de terrassement considérables, devait être troué un des premiers."
                            },
                            {
                                "example_id": "32e83a3a-53d2-4dc6-b3fd-d3a69c4ffacf",
                                "sense_id": "05753e28-80d7-3779-bb66-16b54242b3fe",
                                "text": "Les thèmes de prédilection sont l’arpentage, les constructions en briques, les travaux de terrassement, le creusement des canaux, la répartition du travail et des salaires entre travailleurs, les taux d’intérêt et les problèmes d’héritage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49dc681b-0bb3-41d8-8d1d-80cd1dbd2323",
                        "source_entry_id": "4cd0ca0b-5d6c-3ac1-978a-34f62b226f41",
                        "source_sense_id": "05753e28-80d7-3779-bb66-16b54242b3fe",
                        "target_lang_word": "Erdarbeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdarbeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40cc5ef5-cd79-3bcf-ac39-cbc19460dd05",
                                        "entry_id": "b84773f9-e8bb-3b03-88d0-3ea41782f011",
                                        "glosses": [
                                            "Gestaltung/Umgestaltung des Erdbodens oder seines Untergrunds"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72c04579-0b5c-43ea-b9d0-bb8243d7252c",
                                                "sense_id": "40cc5ef5-cd79-3bcf-ac39-cbc19460dd05",
                                                "text": "„Gerade wird er im großen Stil saniert: ein Glücksfall für die Archäologen, die bei Erdarbeiten nicht nur auf Azelins Grundmauern, sondern auch auf alte Fußböden, Gräber und Reste der ersten Kapelle stießen, die hier um 815 nach Christus stand.“"
                                            },
                                            {
                                                "example_id": "7440d2e5-768e-45dc-89fd-ab5c65923735",
                                                "sense_id": "40cc5ef5-cd79-3bcf-ac39-cbc19460dd05",
                                                "text": "„Die Stadtwerke selbst teilten gestern mit, dass ein beauftragtes Unternehmen in der kommenden Woche mit den Erdarbeiten beginnen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
