                "senses": [
                    {
                        "sense_id": "9289adad-addb-3a5f-92b4-bb533e4a3780",
                        "entry_id": "f16c1654-cdf3-318a-8245-94ca6fe2d554",
                        "glosses": [
                            "Gliedsatz, speziell Adverbialsatz, der angibt, auf welche Art und Weise etwas geschieht"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "e9c824ae-e488-4ff5-a050-7f2bca4eba91",
                                "sense_id": "9289adad-addb-3a5f-92b4-bb533e4a3780",
                                "text": "In dem Satz „Er hilft mir, indem er mir Geld leiht“ ist der Gliedsatz „indem er mir Geld leiht“ ein Modalsatz; er gibt Art und Weise des Helfens an. Viele Modalsätze werden mit „indem“ oder „wie“ eingeleitet."
                            },
                            {
                                "example_id": "b511ff3f-2252-4904-8993-b34612972e6b",
                                "sense_id": "9289adad-addb-3a5f-92b4-bb533e4a3780",
                                "text": "Modalsatz mit „wie“: „Es ist gut so, wie er es macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
