                    {
                        "translation_id": "8a70a9cf-f531-4451-89a7-107e098e69dc",
                        "source_entry_id": "72923fe5-a9d6-3e05-be9e-c3cd13601b26",
                        "source_sense_id": "00fe099a-a149-3fe4-8398-3400a7a63071",
                        "source_sense_description": "benaming voor insecten uit de orde Mantodea",
                        "target_lang_word": "mante religieuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mante religieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f3ee324-e889-31c0-a037-bd2da2484ba2",
                                        "entry_id": "c8a04b39-ba1e-3bb6-bfe7-4eb5e51ed4d8",
                                        "glosses": [
                                            "Espèce d’insectes de l’ordre des mantoptères, actuellement la seule du genre Mantis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb92a6bf-2fcb-4714-9895-4857afcf2416",
                                                "sense_id": "9f3ee324-e889-31c0-a037-bd2da2484ba2",
                                                "text": "Nous fûmes assez vite consolés de cet insuccès par la capture de trois grands « pregadious », c'est-à-dire de trois mantes religieuses, qui se promenaient, toutes vertes, sur les branches vertes d'une verveine : beaux sujets pour l'observation scientifique.\nPapa nous avait dit (avec une certaine joie laïque) que la mante dite « religieuse » était un animal féroce et sans pitié ; qu'on pouvait la considérer comme le « tigre des insectes », et que l'étude de ses mœurs était des plus intéressantes."
                                            },
                                            {
                                                "example_id": "5c965d2b-9c79-466e-ae3d-be78df9c0b77",
                                                "sense_id": "9f3ee324-e889-31c0-a037-bd2da2484ba2",
                                                "text": "Le quatuor a prouvé l’existence d’une espèce de mante religieuse du Labrador maintenant éteinte qui était inconnue jusqu’à aujourd'hui. Ils l'ont baptisée Labradormantis guilbaulti."
                                            },
                                            {
                                                "example_id": "c5a67e49-6066-45b7-a472-cfa9ac77e878",
                                                "sense_id": "9f3ee324-e889-31c0-a037-bd2da2484ba2",
                                                "text": "La mante religieuse est un prédateur mimétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d465d63-5ff3-36fb-95ae-8574caf781cd",
                                        "entry_id": "c8a04b39-ba1e-3bb6-bfe7-4eb5e51ed4d8",
                                        "glosses": [
                                            "Femme cruelle et dangereuse (parce que la femelle de l’insecte dévore le mâle après l’accouplement)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffccdbd1-363f-4632-9cb6-00ccdf8f35b0",
                                                "sense_id": "3d465d63-5ff3-36fb-95ae-8574caf781cd",
                                                "text": "Il s’en est débarrassé quand le mal était fait, pour se remarier avec une mante religieuse, dont il y a tout lieu de penser qu’elle le tua."
                                            },
                                            {
                                                "example_id": "22580423-afd2-49ff-b606-2cccbd850f6f",
                                                "sense_id": "3d465d63-5ff3-36fb-95ae-8574caf781cd",
                                                "text": "Selon son expérience, elle relevait moins de la nymphomane que de la mante religieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b84904fc-cce5-3b0c-a595-39fcd39d2fd2",
                                        "entry_id": "c8a04b39-ba1e-3bb6-bfe7-4eb5e51ed4d8",
                                        "glosses": [
                                            "Style de boxe chinoise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c98b5bd3-8867-3afd-bc7f-b2ec8fd36b80",
                                        "entry_id": "c8a04b39-ba1e-3bb6-bfe7-4eb5e51ed4d8",
                                        "glosses": [
                                            "Tao utilisant ce style de boxe."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
