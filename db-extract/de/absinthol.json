                "senses": [
                    {
                        "sense_id": "67767597-bff0-3d95-b054-e2be696acd23",
                        "entry_id": "c289c20f-5178-35c9-8f37-68da4385b3c0",
                        "glosses": [
                            "chemische Verbindung aus der Gruppe der bicyclischen Monoterpen-Ketone, die in verschiedenen ätherischen Ölen vorkommt und im Echten Salbei enthalten ist"
                        ],
                        "tags": [
                            "Pharmakologie"
                        ],
                        "examples": [
                            {
                                "example_id": "8d82667c-317b-4aa3-a6c2-66251dbfddcb",
                                "sense_id": "67767597-bff0-3d95-b054-e2be696acd23",
                                "text": "„Beim Schmelzen von Absinthol mit Aetzkali bildet sich viel Harz, aber keine Säure.“"
                            },
                            {
                                "example_id": "d95e61ca-b9df-402d-910a-83c7bfc892fc",
                                "sense_id": "67767597-bff0-3d95-b054-e2be696acd23",
                                "text": "„Das Absinthol unterscheidet sich wie erwähnt von dem Myristicol durch einen Minderbetrag in der Molekularbrechung, der gerade einer Aethylenbindung gleich kommt.“"
                            },
                            {
                                "example_id": "a4ce6aa5-c0c8-4d4b-aec7-79edd2c3d2ee",
                                "sense_id": "67767597-bff0-3d95-b054-e2be696acd23",
                                "text": "„Der sauerstoffhaltige Bestandtheil von Wurmholzöl, das Absinthol, soll ebenfalls die Zusammensetzung C₁₀H₁₆O haben, aber seine physikalischen Eigenschaften sind sehr verschieden, wie nachfolgende Zusammenstellung zeigt: […]“"
                            },
                            {
                                "example_id": "a7d05d80-999d-44a4-9dfb-d44db69d944d",
                                "sense_id": "67767597-bff0-3d95-b054-e2be696acd23",
                                "text": "„Dieses besteht hauptsächlich aus einem dem Campher isomeren Bestandtheile (Absinthol) und einem dem Coeruleïn des Kamillenöls verwandten blauen Oele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
