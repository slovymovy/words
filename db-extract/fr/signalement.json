        "fr-extract.jsonl": [
            {
                "entry_id": "acba738d-9da6-3c26-8dbe-47ffa3787856",
                "word": "signalement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c2070aab-e4fa-4443-b51c-a62b5e7c9d1a",
                        "entry_id": "acba738d-9da6-3c26-8dbe-47ffa3787856",
                        "tags": [
                            "plural"
                        ],
                        "form": "signalements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3b8f486-b9dc-3561-a1df-30cbd5ade487",
                        "entry_id": "acba738d-9da6-3c26-8dbe-47ffa3787856",
                        "glosses": [
                            "Description d’une personne par les signes extérieurs qui peuvent la faire reconnaître."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e60cc0ee-f0f2-408b-a6b8-c22a783f20af",
                                "sense_id": "a3b8f486-b9dc-3561-a1df-30cbd5ade487",
                                "text": "Comment la police ne le découvre-t-elle pas ? Est-ce qu’on n’a pas son signalement ?"
                            },
                            {
                                "example_id": "5f1e462c-f500-48bc-ae63-1fa8774cb30d",
                                "sense_id": "a3b8f486-b9dc-3561-a1df-30cbd5ade487",
                                "text": "Un dimanche après-midi, alors que j'étais de semaine, occupé au bureau des brigades à copier des signalements, un télégramme arriva de Lothiers, grosse agglomération située sur la route nationale, à mi-chemin entre Châteauroux et Argenton."
                            },
                            {
                                "example_id": "40f87c6a-3699-445a-9f02-a726080cc969",
                                "sense_id": "a3b8f486-b9dc-3561-a1df-30cbd5ade487",
                                "text": "Vous devez aussi identifier une femme, probablement une michetonneuse, qui vient de temps en temps désengorger notre client. Tâchez d'obtenir un signalement précis."
                            },
                            {
                                "example_id": "3236bcdf-6fef-4ceb-8aca-962c8514790c",
                                "sense_id": "a3b8f486-b9dc-3561-a1df-30cbd5ade487",
                                "text": "Il ne faut pas oublier l'Italien C. Émery, grand classificateur qui s'est consacré au travail ingrat, aride, mais nécessaire qui consiste à établir le signalement détaillé et technique, la fiche myrmécologique, si l'on peut dire, de la plupart des fourmis afin qu'on puisse les identifier sans erreur."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad667ec9-4b2b-3807-b4e0-1b640ce78840",
                        "entry_id": "acba738d-9da6-3c26-8dbe-47ffa3787856",
                        "glosses": [
                            "Action de signaler un fait."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "f28c6c9c-2eaf-472a-8cc7-6dc78b416d19",
                                "sense_id": "ad667ec9-4b2b-3807-b4e0-1b640ce78840",
                                "text": "Dans le cadre de la protection de l'enfance en France, le signalement des maltraitances sur mineurs de 15 ans est une obligation légale (article 434-3 du code pénal), l’auteur du signalement n'est pas tenu d'apporter la preuve des faits."
                            },
                            {
                                "example_id": "b74d6b7f-e4f4-4e98-b239-295f957a4ede",
                                "sense_id": "ad667ec9-4b2b-3807-b4e0-1b640ce78840",
                                "text": "Les déclarations de patrimoine de Jean-Marie Le Pen sont entre les mains des investigateurs de la brigade financière. D'après des informations obtenues par Mediapart, le parquet de Paris a ouvert une enquête préliminaire après un signalement en novembre dernier de la Commission pour la transparence financière de la vie politique."
                            },
                            {
                                "example_id": "0624da36-f8f7-4824-aae8-03700c472049",
                                "sense_id": "ad667ec9-4b2b-3807-b4e0-1b640ce78840",
                                "text": "La même année, Tracfin, le service de lutte contre la fraude fiscale, sociale et douanière, émet des signalements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "530b2b3d-4e26-40ea-8701-79e2a0777c12",
                        "source_entry_id": "acba738d-9da6-3c26-8dbe-47ffa3787856",
                        "source_sense_description": "Description",
                        "target_lang_word": "Personenbeschreibung",
                        "target_lang_code": "de",
