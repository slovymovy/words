{
    "word_family": [
        "captivate",
        "captivation",
        "captivator",
        "captivatingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d74b1f52-ec7a-3e96-9753-06df8277d9e1",
                    "sense_definition": "Holding one's interest or attention completely; fascinating and charming.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attractive_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker delivered a <w>captivating</w> presentation that kept the entire room engaged.",
                            "target_lang_translations": {
                                "ru": "Спикер выступил с <w>захватывающей</w> презентацией, которая удерживала внимание всего зала."
                            }
                        },
                        {
                            "text": "Her latest novel is a <w>captivating</w> story full of unexpected twists and mystery.",
                            "target_lang_translations": {
                                "ru": "Её последний роман — это <w>увлекательная</w> история, полная неожиданных поворотов и тайн."
                            }
                        }
                    ],
                    "synonyms": [
                        "fascinating",
                        "enthralling",
                        "mesmerizing",
                        "spellbinding"
                    ],
                    "antonyms": [
                        "boring",
                        "dull",
                        "uninteresting"
                    ],
                    "common_phrases": [
                        "captivating story",
                        "captivating performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью захватывающий внимание или интерес; увлекательный и притягательный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватывающий",
                                "target_lang_sense_clarification": "полностью удерживающий внимание, увлекательный"
                            },
                            {
                                "target_lang_word": "увлекательный",
                                "target_lang_sense_clarification": "вызывающий глубокий интерес"
                            },
                            {
                                "target_lang_word": "пленительный",
                                "target_lang_sense_clarification": "покоряющий воображение, чарующий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a226cc5d-0574-3372-b7f1-42ca4f7cb1d2",
                    "sense_definition": "Visually very attractive, charming, or beautiful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attractive_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked directly into the camera with a <w>captivating</w> smile.",
                            "target_lang_translations": {
                                "ru": "Она посмотрела прямо в камеру с <w>очаровательной</w> улыбкой."
                            }
                        },
                        {
                            "text": "The hotel room offered a <w>captivating</w> view of the distant mountains at sunset.",
                            "target_lang_translations": {
                                "ru": "Из номера отеля открывался <w>пленительный</w> вид на далекие горы на закате."
                            }
                        }
                    ],
                    "synonyms": [
                        "alluring",
                        "enchanting",
                        "ravishing"
                    ],
                    "antonyms": [
                        "repulsive",
                        "unattractive"
                    ],
                    "common_phrases": [
                        "captivating smile",
                        "captivating beauty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Визуально очень привлекательный, чарующий или красивый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровательный",
                                "target_lang_sense_clarification": "прелестный, очень красивый внешне"
                            },
                            {
                                "target_lang_word": "пленительный",
                                "target_lang_sense_clarification": "обладающий пленительной красотой"
                            },
                            {
                                "target_lang_word": "обворожительный",
                                "target_lang_sense_clarification": "манящий, чарующий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe0313bf-0886-3946-8ddc-67287109a5ea",
                    "sense_definition": "present participle and gerund of <w>captivate</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician spent the evening <w>captivating</w> the young children with clever tricks.",
                            "target_lang_translations": {
                                "ru": "Иллюзионист провел вечер, <w>очаровывая</w> маленьких детей ловкими фокусами."
                            }
                        },
                        {
                            "text": "She succeeded in <w>captivating</w> the entire audience within minutes of taking the stage.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>пленить</w> всю публику всего через несколько минут после выхода на сцену."
                            }
                        }
                    ],
                    "synonyms": [
                        "charming",
                        "fascinating",
                        "enchanting"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола «captivate» (очаровывать, пленять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровывающий",
                                "target_lang_sense_clarification": "причастие от «очаровывать»"
                            },
                            {
                                "target_lang_word": "пленяющий",
                                "target_lang_sense_clarification": "причастие от «пленять»"
                            },
                            {
                                "target_lang_word": "очаровывая",
                                "target_lang_sense_clarification": "деепричастие от «очаровывать»"
                            }
                        ]
                    }
                }
            ]
        }
    ]
