                "translations": [
                    {
                        "translation_id": "816062be-d6b5-4b86-b5fe-8c5732658ec8",
                        "source_entry_id": "e9ab1530-9b6e-3335-9237-cf6723b26b4c",
                        "source_sense_id": "06e55340-59bd-3105-9c08-3a9505d2945f",
                        "source_sense_description": "bauchige Weinflasche, Flasche",
                        "target_lang_word": "Weinflasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weinflasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                        "entry_id": "782bddb0-62e5-3185-9a3f-60b8d75fb319",
                                        "glosses": [
                                            "eine Flasche, in der Wein aufbewahrt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e46047-491c-4e4a-9f91-a2de98b9fc3f",
                                                "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                                "text": "Beim nächtlichen Einbruch im Nachbarhaus verrieten sich die Eindringlinge dadurch, dass zahllose Weinflaschen zu Bruch gingen."
                                            },
                                            {
                                                "example_id": "df41a152-b62d-4c92-8fa5-ef0efcdb4cc3",
                                                "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                                "text": "„An einer der Wände der kleinen Trattoria sind die Weinflaschen bis unter die Decke gestapelt.“"
                                            },
                                            {
                                                "example_id": "b0a24120-8c1b-4bfd-b14d-bcbcf805e980",
                                                "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                                "text": "„Im kühlen Weinkeller zeigte er uns als Zeichen seines Vertrauens sehr alte und überaus wertvolle Weinflaschen, die nur bei Hochzeiten oder Taufen angeboten wurden.“"
                                            },
                                            {
                                                "example_id": "61fe9f0e-f2ae-4e75-b605-47e98b78fdc7",
                                                "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                                "text": "„Im Keller roch es nach Kartoffeln und ausgetrunkenen Weinflaschen.“"
                                            },
                                            {
                                                "example_id": "41f69971-47ec-4a7a-ae93-48eb80e76558",
                                                "sense_id": "d07c6822-7bac-3562-ab82-c3b51b08fc08",
                                                "text": "„Vor mir stehen vier Weinflaschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47c5b799-df60-4422-982b-144e4f766f34",
                        "source_entry_id": "e9ab1530-9b6e-3335-9237-cf6723b26b4c",
                        "source_sense_id": "06e55340-59bd-3105-9c08-3a9505d2945f",
                        "source_sense_description": "bauchige Weinflasche, Flasche",
                        "target_lang_word": "Flasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6215189-b6a0-31d2-a0b4-481e4c833f25",
                                        "entry_id": "0b6e842b-e910-34a0-af63-68de54389b16",
                                        "glosses": [
                                            "ein Gefäß zur Aufbewahrung und zum Transport von Flüssigkeiten oder auch Gasen mit charakteristischer bauchiger, zylindrischer, quaderförmiger oder ähnlicher Form (mit Hals) aus verschiedenem Material wie Glas, Plastik, Metall, Keramik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a1e693-e11f-41a8-9738-aa28e5401a99",
                                                "sense_id": "a6215189-b6a0-31d2-a0b4-481e4c833f25",
                                                "text": "Ich habe heute eine Flasche Rum gekauft."
                                            },
                                            {
                                                "example_id": "9a8555d6-7983-4924-a12f-6a1cf490c4cf",
                                                "sense_id": "a6215189-b6a0-31d2-a0b4-481e4c833f25",
                                                "text": "„Ich setzte die Flasche an und genoß das gute Gefühl.“"
                                            },
                                            {
                                                "example_id": "b9bb2d1e-1030-432a-b8d9-44904264e504",
                                                "sense_id": "a6215189-b6a0-31d2-a0b4-481e4c833f25",
                                                "text": "„Man leerte noch die angebrochene Flasche Rotwein, und gegen Mitternacht verabschiedeten sich Tom und Fabiola, um sich auf den Heimweg zu machen.“"
                                            },
                                            {
                                                "example_id": "b6549dc7-5c44-40e8-bc6c-4324bac8540c",
                                                "sense_id": "a6215189-b6a0-31d2-a0b4-481e4c833f25",
                                                "text": "„Sobald er, seine zwei Flaschen Margaux im Leibe, sich auf seinem angestammten Diwanplatze herumrekelte, bildete sich ein Kreis von Klubmitgliedern um ihn, es wurde geplaudert, gestritten, gescherzt.“"
                                            },
                                            {
                                                "example_id": "ad43be71-b43e-410f-91b5-faa9c53fc95f",
                                                "sense_id": "a6215189-b6a0-31d2-a0b4-481e4c833f25",
                                                "text": "„Eine halbgeleerte Flasche Wein stand noch auf dem Tisch.“"
                                            },
                                            {
                                                "example_id": "30d20850-8fcc-4f37-bc02-d38f9a395363",
                                                "sense_id": "a6215189-b6a0-31d2-a0b4-481e4c833f25",
                                                "text": "„Auch ich stimmte herzlich in das Lachen des dicken Pascha ein, als er die fest versperrten Schränke öffnete und ich an Stelle der Bücher Flaschen mit allen möglichen Weinsorten entdeckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34bf86b8-4c3c-30f7-90c1-1aec24b9952f",
                                        "entry_id": "0b6e842b-e910-34a0-af63-68de54389b16",
                                        "glosses": [
                                            "für Versager oder Versagerin"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16caa76c-2ec5-4c07-b3ff-0b4666f7d3ac",
                                                "sense_id": "34bf86b8-4c3c-30f7-90c1-1aec24b9952f",
                                                "text": "Du bist vielleicht ’ne Flasche, hast dich nicht einmal gewehrt!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f66cf33c-f5a5-3cd5-98fd-a69f7c84b0be",
                                        "entry_id": "0b6e842b-e910-34a0-af63-68de54389b16",
                                        "glosses": [
                                            "ein härterer Schlag mit der flachen Hand ins Gesicht; im Singular wird teilweise noch ein „n“ angehängt: die Flasche(n), der Flasche(n), etc."
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edc7bfa5-b1e7-4880-93a3-ea98ca6c172e",
                                                "sense_id": "f66cf33c-f5a5-3cd5-98fd-a69f7c84b0be",
                                                "text": "Der hat vielleicht ’ne Flaschen von seinem Vater gekriegt, wie er nach Haus gekommen ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "49a90294-9f4e-3c2f-b072-3bb5a2cbb5ae",
                                        "entry_id": "0b6e842b-e910-34a0-af63-68de54389b16",
                                        "glosses": [
                                            "Teil eines Flaschenzugs"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fa28ab0-5fcd-4d4c-9dd0-c6f9903e3f77",
                        "source_entry_id": "e9ab1530-9b6e-3335-9237-cf6723b26b4c",
                        "source_sense_id": "98c68947-2150-3c9f-9c37-e81591586725",
                        "source_sense_description": "Krug, Deckelkrug",
                        "target_lang_word": "Krug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                        "entry_id": "786c9497-2d79-34ff-8c62-04d8b81436f1",
                                        "glosses": [
                                            "zylindrisches Gefäß für Getränke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f31e798-72b5-4919-ad15-31a87689bbc1",
                                                "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                                "text": "Er holt einen Krug Most aus dem Keller."
                                            },
                                            {
                                                "example_id": "2cf4b080-b1de-41de-aec6-09fc844f8af6",
                                                "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                                "text": "„Ein sympathisch wirkender Mann begrüßte sie in verständlichem Deutsch und reichte ihnen einen Krug mit Quellwasser.“"
                                            },
                                            {
                                                "example_id": "96ed7d59-24a9-427d-ba40-9aa14ab565d8",
                                                "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                                "text": "„In Room 33 häuften sich Schüsseln und Krüge, Türkis- und Muschelperlen, Papageien, Flöten und Zeremionialstäbe.“"
                                            },
                                            {
                                                "example_id": "380bb1a4-1254-4650-9fe4-116116bea596",
                                                "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                                "text": "„Darob hatte der Branntweinschmuggler Erbarmen mit dem Manne, er gab seinem Herzen einen Ruck, lud ihn in eine Scheune, woselbst er ihm einen Krug mit Branntwein bot und mit seinem Sackmesser ein Stück Haifischfleisch abschnitt.“"
                                            },
                                            {
                                                "example_id": "fd92e747-fb34-4d2b-aca6-5b7f9a840bce",
                                                "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                                "text": "„Ein kleines Mädchen, das barfuß in Holzpantinen lief und dessen Körper man durch das zerlumpte Kleidchen hindurch sehen konnte, brachte den Frauen zu trinken und goß ihnen Apfelmost aus einem Krug ein, den es gegen die Hüfte stützte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9bc093d2-e267-3052-97bf-5c820725846f",
                                        "entry_id": "786c9497-2d79-34ff-8c62-04d8b81436f1",
                                        "glosses": [
                                            "ländliche Gaststätte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce39d21-e3a9-478f-9ae8-9b9318b3d24e",
                                                "sense_id": "9bc093d2-e267-3052-97bf-5c820725846f",
                                                "text": "Sie saßen die ganze Nacht im Krug."
                                            },
                                            {
                                                "example_id": "0025bca6-46c5-4dcb-9362-c207c1596497",
                                                "sense_id": "9bc093d2-e267-3052-97bf-5c820725846f",
                                                "text": "„Eine Stunde später fuhr der Gendarm aus Krusenhagen an dem neuen Kruge vorüber, und bald darauf hörte Lemke, daß der Gendarm in Begleitung des Försters bei Kordes Haussuchung gehalten und den Bock beschlagnahmt hätte.“"
                                            },
                                            {
                                                "example_id": "d3d5e542-9b01-46dd-b84b-2787263811d3",
                                                "sense_id": "9bc093d2-e267-3052-97bf-5c820725846f",
                                                "text": "„An eben dieser Stelle findet sich denn auch die ganze Herrlichkeit von Dorf Stechlin zusammen; das Pfarrhaus, die Schule, das Schulzenamt, der Krug, dieser letztere zugleich ein Eck- und Kramladen mit einem kleinen Mohren und einer Guirlande von Schwefelfäden in seinem Schaufenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91fff6b8-4768-4ead-8c10-2e84e2573eff",
                        "source_entry_id": "e9ab1530-9b6e-3335-9237-cf6723b26b4c",
                        "source_sense_id": "98c68947-2150-3c9f-9c37-e81591586725",
                        "source_sense_description": "Krug, Deckelkrug",
                        "target_lang_word": "Deckelkrug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deckelkrug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02e6e1b2-5d9c-3fd9-91d1-c685e5c83246",
                                        "entry_id": "99ba312b-052d-3190-85bb-10235afce9bd",
                                        "glosses": [
                                            "Krug mit Deckel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e093f7b-04cc-49f9-8d09-ab339b7eb16d",
                                                "sense_id": "02e6e1b2-5d9c-3fd9-91d1-c685e5c83246",
                                                "text": "„So scherzte man weiter, bis man schließlich auf des Präzeptors Vorschlag sich für ein einfaches Blankenburger Bier entschied, das denn auch in Deckelkrügen aufgetragen wurde, jeder Krug mit einer blauen Glasurinschrift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
