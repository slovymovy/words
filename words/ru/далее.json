        "отдаление",
        "удаление"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e0171f92-dc9e-3197-923d-477e8a6167c2",
                    "sense_definition": "Наречие времени, указывающее на то, что происходит после чего-либо; затем, потом.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temporal_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сначала мы обсудим план, а <далее> приступим к работе.",
                            "target_lang_translations": {
                                "en": "First we will discuss the plan, and <w>then</w> we will start work.",
                                "zh": "我们先讨论计划，<w>然后</w>开始工作。"
                            }
                        },
                        {
                            "text": "Вам нужно читать <далее>, чтобы понять смысл истории.",
                            "target_lang_translations": {
                                "en": "You need to read <w>further</w> to understand the meaning of the story.",
                                "zh": "你需要<w>继续</w>读下去，才能理解故事的含义。"
                            }
                        }
                    ],
                    "synonyms": [
                        "затем",
                        "потом",
                        "в дальнейшем"
                    ],
                    "antonyms": [
                        "прежде"
                    ],
                    "common_phrases": [
                        "и так далее",
                        "как указано далее",
                        "что было далее"
                    ],
                    "target_lang_definitions": {
                        "en": "Adverb of time indicating what happens after something; then, afterwards.",
                        "zh": "表示在某事之后发生的时间副词；然后，接下来。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "indicating a sequence in time"
                            },
                            {
                                "target_lang_word": "next",
                                "target_lang_sense_clarification": "following immediately in order"
                            },
                            {
                                "target_lang_word": "further",
                                "target_lang_sense_clarification": "continuing forward in time or text"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "然后",
                                "target_lang_sense_clarification": "表示时间上的先后顺序"
                            },
                            {
                                "target_lang_word": "接下来",
                                "target_lang_sense_clarification": "表示紧接着的后续动作"
                            },
                            {
                                "target_lang_word": "继续",
                                "target_lang_sense_clarification": "表示在文本或叙述中向后延伸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f973f0ae-37f5-3bed-956a-dd097e23d850",
                    "sense_definition": "Сравнительная степень наречия <w>далеко</w>; на большем расстоянии в пространстве.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тропинка вела нас <далее> в глубь густого леса.",
                            "target_lang_translations": {
                                "en": "The path led us <w>further</w> into the depths of the dense forest.",
                                "zh": "小路引导我们向森林深处<w>更远</w>的地方走去。"
                            }
                        },
                        {
                            "text": "Мы не могли пройти <далее> из-за сильного ветра.",
                            "target_lang_translations": {
                                "en": "We could not go <w>further</w> because of the strong wind.",
                                "zh": "因为风太大，我们无法再向<w>更远</w>处前行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "не далее как",
                        "пройти далее"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative degree"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative degree of the adverb 'far'; at a greater distance in space.",
                        "zh": "副词“远”的比较级；在空间上更远的距离。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "further",
                                "target_lang_sense_clarification": "at a greater distance"
                            },
                            {
                                "target_lang_word": "farther",
                                "target_lang_sense_clarification": "specifically regarding physical distance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更远",
                                "target_lang_sense_clarification": "指物理空间上的距离增加"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}