                                            {
                                                "example_id": "30acbc2a-bd9d-48c8-8045-e7362a84c77c",
                                                "sense_id": "8226a4a3-30b5-3e8e-86a5-c3c2fd86db23",
                                                "text": "De samenzweerders hadden een aanslag beraamd op de beroemde politicus."
