                "senses": [
                    {
                        "sense_id": "2842d1f6-337b-34fd-a390-61511db2ff38",
                        "entry_id": "4b4d8f66-cfe9-3524-ac22-38955a1646a6",
                        "glosses": [
                            "Accompagner un salarié qui va quitter une entreprise pour favoriser sa recherche d’emploi, grâce au financement au moins partiel de l’entreprise quittée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31e45f41-522a-4988-bb8a-cebeb33706a9",
                                "sense_id": "2842d1f6-337b-34fd-a390-61511db2ff38",
                                "text": "« J'étais fragilisé et dans une situation inconfortable. J'avais envie de me remettre en piste tout de suite », renchérit Yves Cahen, qui dirige un cabinet d'outplacement après avoir été lui-même outplacé."
                            },
                            {
                                "example_id": "1ac0ba73-9925-42ce-ab3d-5dd874839d7b",
                                "sense_id": "2842d1f6-337b-34fd-a390-61511db2ff38",
                                "text": "Reclassement : faut-il accepter d'être \"outplacé\" par son entreprise ?"
                            },
                            {
                                "example_id": "1291a8fc-2553-43e3-8ca6-6c2b3113de48",
                                "sense_id": "2842d1f6-337b-34fd-a390-61511db2ff38",
                                "text": "Le Florian Mantione Institut a recruté, formé ou outplacé plus de 10 000 personnes depuis 1976, en évaluant, formant ou coachant plus de 100 000 personnes."
                            }
                        ]
                    }
                ],
