                                        "examples": [
                                            {
                                                "example_id": "b19de964-e362-4a73-8e5e-f10abf614c9e",
                                                "sense_id": "94519c3a-4703-3701-b3b4-b00f3b23dbce",
                                                "text": "Wie heißt das auf Kongo?"
                                            },
                                            {
                                                "example_id": "81bda651-33bd-40e2-9861-21de169e7868",
                                                "sense_id": "94519c3a-4703-3701-b3b4-b00f3b23dbce",
                                                "text": "Sprechen Sie Kongo?"
                                            },
                                            {
                                                "example_id": "f0b05d1d-d766-42bf-a098-95d35baac0b8",
                                                "sense_id": "94519c3a-4703-3701-b3b4-b00f3b23dbce",
                                                "text": "Wie kann ich mein Kongo verbessern?"
                                            },
                                            {
                                                "example_id": "b684a598-af0a-467e-a2dc-1502af3d20f9",
                                                "sense_id": "94519c3a-4703-3701-b3b4-b00f3b23dbce",
