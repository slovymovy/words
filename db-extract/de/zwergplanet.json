                    {
                        "form_id": "bee30517-ae85-44ee-ab2f-2e15048560d4",
                        "entry_id": "7ea08db9-c368-3378-9f69-8e8d073cc093",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zwergplaneten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3c29b17-e713-3b09-b993-d50aa98eadb4",
                        "entry_id": "7ea08db9-c368-3378-9f69-8e8d073cc093",
                        "glosses": [
                            "Himmelskörper, der sich in einer Umlaufbahn um die Sonne befindet, durch seine Schwerkraft annähernd rund ist, jedoch seine Bahn von anderen Objekten nicht freigeräumt hat und kein Mond ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46663d1c-ea5d-4508-b29b-2dfc9b4f94c0",
                                "sense_id": "e3c29b17-e713-3b09-b993-d50aa98eadb4",
                                "text": "„Der Pluto hat seinen Status als neunter Planet des Sonnensystems verloren. Die Internationale Astronomische Union entschied, den 1930 entdeckten Himmelskörper in die neue Kategorie der „Zwergplaneten“ einzuordnen.“"
                            },
                            {
                                "example_id": "ac12ef8c-e2b1-4586-854a-005e26baaee8",
                                "sense_id": "e3c29b17-e713-3b09-b993-d50aa98eadb4",
                                "text": "Zu der voraussichtlich rasch wachsenden Gruppe der Zwergplaneten gehören auch Ceres aus dem Asteroidengürtel zwischen Mars und Jupiter sowie das Objekt 2003 UB313 jenseits der Plutobahn, das von seinen Entdeckern vorläufig Xena getauft worden war."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5eedafec-04b7-47da-8dd9-d6a5151659f7",
                        "source_entry_id": "7ea08db9-c368-3378-9f69-8e8d073cc093",
                        "source_sense_id": "e3c29b17-e713-3b09-b993-d50aa98eadb4",
                        "target_lang_word": "dwarf planet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwarf planet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8551dd20-32f7-32ce-9968-89ba1c013d21",
                                        "entry_id": "052e7985-c79a-3d1c-86a4-9106028cafa7",
                                        "glosses": [
                                            "A planetary (world-like) body of the Solar system, that directly orbits the Sun like the classical planets but does not gravitationally dominate other bodies in the region of its orbit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31610be0-7f62-439a-8072-104ef1eb4387",
                                                "sense_id": "8551dd20-32f7-32ce-9968-89ba1c013d21",
                                                "text": "A member of the Fomor Belt, Bres is a dwarf planet with no atmosphere."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3d19f33-b167-410b-9a25-ffc0d08939fd",
                        "source_entry_id": "7ea08db9-c368-3378-9f69-8e8d073cc093",
                        "source_sense_id": "e3c29b17-e713-3b09-b993-d50aa98eadb4",
                        "target_lang_word": "planète naine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planète naine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff6c03f7-8123-3298-b0c2-4e8e028f43db",
                                        "entry_id": "b500608a-9ae3-3db7-8fa5-e0c167215a02",
                                        "glosses": [
                                            "Corps céleste en orbite autour du Soleil, assez massif pour que sa gravité lui confère une enveloppe sphérique (équilibre isostatique) et qui n’a pas dégagé son orbite des autres corps célestes (contrairement aux planètes)."
                                        ],
                                        "tags": [
                                            "Planétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d69dc1c-99e9-4192-b929-fdbc8784c041",
                                                "sense_id": "ff6c03f7-8123-3298-b0c2-4e8e028f43db",
                                                "text": "La résolution votée à Prague prive désormais Pluton de son statut de planète pour la reléguer parmi les planètes naines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
