                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d7fe36f-0ca2-4c25-8b1b-6c201f2f9825",
                                "sense_id": "44027f71-70d5-3118-b2e6-dbebf442e2d2",
                                "text": "Nick observes the whale both with her calfling, and with Marty, but he does not communicate with her."
                            },
                            {
                                "example_id": "7fc24057-b565-4f85-8805-d13ed024fa47",
                                "sense_id": "44027f71-70d5-3118-b2e6-dbebf442e2d2",
                                "text": "It was beautiful—the silver moon shone on the calfling while Dark- Eye licked her and I rubbed her with grass, and everything was shiny."
                            },
                            {
                                "example_id": "81405578-9123-4113-9461-e636185be60c",
                                "sense_id": "44027f71-70d5-3118-b2e6-dbebf442e2d2",
                                "text": "His enemy. And if the man had hated his family before, this was going to make things worse. She looked over. Caught his gaze and smiled. 'It tastes lovely.' Hellfire and brimstone, he'd been staring like some besotted calfling."
                            }
                        ]
                    }
