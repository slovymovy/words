                "senses": [
                    {
                        "sense_id": "d9d1506a-3f23-3a8c-9c3f-8070546283ca",
                        "entry_id": "b328ee7c-4cdc-3106-9241-95524706ed66",
                        "glosses": [
                            "книжн., поэт. падать вниз; свешиваться, спускаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4192db31-fa8a-4e8a-afc9-f9fdbb65ef78",
                                "sense_id": "d9d1506a-3f23-3a8c-9c3f-8070546283ca",
                                "text": "От лиры искры побежали // И вседробящею струей, // Как пламень Божий, ниспадали // На чела бедные царей."
                            },
                            {
                                "example_id": "c56869b3-16a3-4512-883c-551a11c672aa",
                                "sense_id": "d9d1506a-3f23-3a8c-9c3f-8070546283ca",
                                "text": "Локоны ниспадали на плечи."
                            },
                            {
                                "example_id": "acec35ce-ef90-4d8e-b5b2-0ecd8cf64002",
                                "sense_id": "d9d1506a-3f23-3a8c-9c3f-8070546283ca",
                                "text": "Я расскажу тебе, как ниспадает туман // На молодые деревья, на старые пни."
                            }
                        ]
                    }
