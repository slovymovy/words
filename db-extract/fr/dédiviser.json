                "senses": [
                    {
                        "sense_id": "66534f29-9016-3f6a-9080-a37d5b12dd26",
                        "entry_id": "3ea278da-10a7-399a-8a0b-8a5b9e760181",
                        "glosses": [
                            "Faire revenir en arrière après une division."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56dcf9f2-cbcd-4e83-9eec-054c1b4d8519",
                                "sense_id": "66534f29-9016-3f6a-9080-a37d5b12dd26",
                                "text": "Est-il possible de dédiviser une ligne."
                            },
                            {
                                "example_id": "0c57f05f-b9af-47a4-9afe-d36ab1cf4100",
                                "sense_id": "66534f29-9016-3f6a-9080-a37d5b12dd26",
                                "text": "Cette liaison entre cycle cellulaire, expression des gènes et différenciation rend le processus irréversible pour la raison que, pour reprendre l’expression de Duboule, les cellules ne se dédivisent pas. Il n'y a pas de marche arrière dans la morphogénèse."
                            },
                            {
                                "example_id": "4e1230a7-6f27-4dc6-9ffa-15c73ffa4fdd",
                                "sense_id": "66534f29-9016-3f6a-9080-a37d5b12dd26",
                                "text": "Il faudra bien se dédiviser pour accéder à la vraie démocratie."
                            }
                        ]
                    }
