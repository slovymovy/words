                                                "sense_id": "b52e33d7-cd9b-370b-8409-c9a8f4f68b4c",
                                                "text": "The inflation of the balloon took five hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a0e4b75-4531-36b7-bc92-51c0b13d562a",
                                        "entry_id": "5eabfe3e-a74b-35aa-b848-919b5ae56272",
                                        "glosses": [
                                            "An increase in the quantity of money, leading to a devaluation of existing money, adjusted for by way of higher nominal values."
                                        ],
                                        "tags": [
