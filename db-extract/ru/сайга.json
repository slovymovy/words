                                                "example_id": "923bc4b4-b13a-4f64-89bf-429e154ab17c",
                                                "sense_id": "439ca745-6f12-3f75-bcbf-36836e588b07",
                                                "text": "Sumak to kwaskowata przyprawa o pięknym kolorze, popularna w kuchni arabskiej (zwłaszcza libańskiej) i tureckiej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9442f04c-505e-4d29-b78e-a94545b0b87a",
                        "source_entry_id": "a15344ff-02b1-3531-b648-b671b6772bd7",
                        "source_sense_id": "acd7aba4-90b5-3610-8f80-d587d94976ad",
                        "target_lang_word": "sayga",
