        "nl-extract.jsonl": [
            {
                "entry_id": "13bdfff2-4c94-3060-95a1-8c856357f6b0",
                "word": "zevenklapper",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "09af2b7a-7741-4c85-8bdd-5a94afa6cfff",
                        "entry_id": "13bdfff2-4c94-3060-95a1-8c856357f6b0",
                        "tags": [
                            "plural"
                        ],
                        "form": "zevenklappers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b1d291a-dc1e-37e2-96d7-d87bd8824780",
                        "entry_id": "13bdfff2-4c94-3060-95a1-8c856357f6b0",
                        "glosses": [
                            "knalvuurwerk dat zeven knallen veroorzaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "442fb427-25c0-4d7e-92a0-9992de7c9327",
                                "sense_id": "7b1d291a-dc1e-37e2-96d7-d87bd8824780",
                                "text": "Elf kilometer verderop, in Hilversum, helpt Arlers zus Catie met het lossen van de vrachtwagen. Ook hier bij De Zevenklapper, de feestwinkel die vader Cor in 1959 oprichtte, moeten de klanten geduld hebben. 'Hij begon met zevenklappers, strijkers, kanonslagen en grondbloemen', weet Evelien Arler nog. Glimlachend: Ér lag toen veel meer knalvuurwerk dan nu."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cb68749-2a2b-351c-90df-34060ce34c8f",
                        "entry_id": "13bdfff2-4c94-3060-95a1-8c856357f6b0",
                        "glosses": [
                            "iets (vaak een wedstrijd) waarin één partij 7x scoort."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7fdd9692-816c-433b-8557-f800acb7a199",
                                "sense_id": "5cb68749-2a2b-351c-90df-34060ce34c8f",
                                "text": "Van een spannend restant van de tweede helft zou echter absoluut geen sprake zijn. City herstelde zich razendsnel en walste in een moordend tempo over Stoke heen. Jesus, Fernandinho (prachtig afstandsschot), Leroy Sané en Bernardo Silva gaven de zevenklapper gestalte: 7-2. City heeft nu twee punten meer dan United en is koploper."
                            },
                            {
                                "example_id": "bc624b00-7cb3-4402-9d25-3704350c3d58",
                                "sense_id": "5cb68749-2a2b-351c-90df-34060ce34c8f",
                                "text": "\"We moeten ons doorontwikkelen als we balbezit hebben op de helft van de tegenstander. Daar moeten we meer uithalen. Het wordt een ander soort wedstrijd dan vorige week. Willem II speelt defensiever, de ruimtes zijn kleiner\", aldus Cocu refererend aan de zevenklapper van PSV bij FC Utrecht: 7-1 zege."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b568dd7-9273-4e95-beb1-c6a3fe6cb027",
                        "source_entry_id": "13bdfff2-4c94-3060-95a1-8c856357f6b0",
                        "source_sense_id": "7b1d291a-dc1e-37e2-96d7-d87bd8824780",
                        "target_lang_word": "serpent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serpent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d4dd96f-2895-3d81-a26c-47661a31818c",
                                        "entry_id": "22130883-52fd-35c4-ae95-89ecb04d608a",
                                        "glosses": [
                                            "A snake, especially a large or dangerous one."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85bd4789-6d14-4a23-a54c-07c88b398199",
                                                "sense_id": "4d4dd96f-2895-3d81-a26c-47661a31818c",
                                                "text": "He falls into it, who has digg'd a Pit.\nWho breaks a Hedge is with a Serpent bit."
                                            },
                                            {
                                                "example_id": "d87ae805-4a56-4f76-a67b-00be9c765c99",
                                                "sense_id": "4d4dd96f-2895-3d81-a26c-47661a31818c",
                                                "text": "Coiled up behind the shrub, […] was a green imamba, the most dreaded of all South African serpents."
                                            },
                                            {
                                                "example_id": "9b7de2b5-7085-4ace-ada6-e71746b9974b",
                                                "sense_id": "4d4dd96f-2895-3d81-a26c-47661a31818c",
                                                "text": "Any serpent six feet long looks formidable; and over that length, one takes on the aspect of a chimera."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7749357-50e7-3ca8-be15-086bd0f70d80",
                                        "entry_id": "22130883-52fd-35c4-ae95-89ecb04d608a",
                                        "glosses": [
                                            "A subtle, treacherous, malicious person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "648c33ee-6960-4836-9895-b9affbd70744",
                                                "sense_id": "e7749357-50e7-3ca8-be15-086bd0f70d80",
                                                "text": "He is a very serpent in my way."
                                            },
                                            {
                                                "example_id": "1b168208-d902-44ce-b8f4-c7268552978d",
                                                "sense_id": "e7749357-50e7-3ca8-be15-086bd0f70d80",
                                                "text": "'Dogs and serpents,' She began in a low voice that gradually gathered power as she went on, till the place rang with it. Eaters of human flesh, two things have ye done. First, ye have attacked these strangers, being white men, and would have slain their servant, and for that alone death is your reward.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0fe9527-b054-3e29-8f67-d8c49281b74e",
                                        "entry_id": "22130883-52fd-35c4-ae95-89ecb04d608a",
                                        "glosses": [
                                            "An obsolete wind instrument in the brass family, whose shape is suggestive of a snake (Wikipedia article)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bd84c6f-d866-3bb6-8d3f-35d3d8f892c7",
                                        "entry_id": "22130883-52fd-35c4-ae95-89ecb04d608a",
                                        "glosses": [
                                            "A kind of firework with a serpentine motion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f08459bc-7442-324e-8766-9a9038b6c7b4",
                                        "entry_id": "22130883-52fd-35c4-ae95-89ecb04d608a",
                                        "glosses": [
                                            "A snake-like monster, such as a dragon or sea serpent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4b640eb-b05b-47e2-ab34-85f2a1d9e273",
                                                "sense_id": "f08459bc-7442-324e-8766-9a9038b6c7b4",
                                                "text": "Then Beowulf too rallied. With his whetted dagger he slit a gash in the serpent's middle."
                                            }
                                        ]
                                    }
                                ]
                            },
