                "senses": [
                    {
                        "sense_id": "5b97dbf6-3830-321e-8652-f6a5f477e957",
                        "entry_id": "9e8b79bc-b14a-373c-ba6c-a7221bfa606c",
                        "glosses": [
                            "used to mark the premise of a syllogistic argument"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "08b04534-37c2-4ebc-854f-9effd69c995f",
                                "sense_id": "5b97dbf6-3830-321e-8652-f6a5f477e957",
                                "text": "Granted that he has done nothing wrong, he should be set free."
                            },
                            {
                                "example_id": "7252c290-b882-4478-ad39-9e9da44bb8c6",
                                "sense_id": "5b97dbf6-3830-321e-8652-f6a5f477e957",
                                "text": "Granted the lack of evidence, we can make no such conclusion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fa9ff13-5697-4d40-bf84-cf0dad85722a",
                        "source_entry_id": "9e8b79bc-b14a-373c-ba6c-a7221bfa606c",
