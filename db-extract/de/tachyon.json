                    },
                    {
                        "translation_id": "ecebe5d5-438a-422b-ba0f-d5669a401139",
                        "source_entry_id": "37db617a-fd34-3514-971d-3d4694c4c224",
                        "source_sense_id": "cf009474-6917-3441-97b2-ee3a3cb2dcae",
                        "source_sense_description": "Physik: hypothetisches Elementarteilchen, das sich schneller als Licht fortbewegt",
                        "target_lang_word": "тахион",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тахион",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ade95cab-e4be-3490-bb00-41d58e819f62",
                                        "entry_id": "6f3c8c4f-234c-3d3b-938b-d5d5adf53021",
                                        "glosses": [
                                            "физ. гипотетическая частица, движущаяся со скоростью, превышающей скорость света в вакууме"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1f821c4-cb36-4f3f-ad34-1b2a0a2dd9ec",
                                                "sense_id": "ade95cab-e4be-3490-bb00-41d58e819f62",
                                                "text": "Все эти свойства тахионов венчает их способность перемещаться «из будущего в прошлое»: наблюдатель, движущийся со скоростью в 90% от скорости света, увидит, что тахион, вылетевший из А в Б со скоростью в две световые, сначала появится в Б, а потом вылетит из А; наблюдатель, движущийся со скоростью в 50% от скорости света, увидит, что такой тахион появляется в А и Б одновременно."
                                            },
                                            {
                                                "example_id": "0a3a1f5a-ee00-488b-b2e5-f7163d31aba5",
                                                "sense_id": "ade95cab-e4be-3490-bb00-41d58e819f62",
                                                "text": "Ведь даже нейтрино ― это ещё наполовину загадка, а тахионы, частицы, летящие быстрее света, ― это и вовсе фантастика…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90bef213-484c-46f9-b0a7-ba94fada7859",
                        "source_entry_id": "37db617a-fd34-3514-971d-3d4694c4c224",
                        "source_sense_id": "cf009474-6917-3441-97b2-ee3a3cb2dcae",
                        "source_sense_description": "Physik: hypothetisches Elementarteilchen, das sich schneller als Licht fortbewegt",
                        "target_lang_word": "tachyon",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tachyon",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "b2fcdb4a-cf9e-30ef-b248-fc59f406f216",
                                        "entry_id": "bd6fbbe4-3f41-30e6-99aa-a1e55f554231",
                                        "glosses": [
                                            "hypotetická částice pohybující se nadsvětelnou rychlostí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bccbe08-9588-4a3d-a590-8ee7e09c3cb5",
                                                "sense_id": "b2fcdb4a-cf9e-30ef-b248-fc59f406f216",
                                                "text": "Únos tachyonu z teoretické fyziky do obchodní esoteriky má neodolatelnou absurdně pikantní příchuť. Fyzikální tachyon je totiž pouze abstraktní pojem pro částice pohybující se nadsvětelnou rychlostí, které podle velmi dobře prověřené teorie relativity nesmějí existovat, neboť ta považuje rychlost světla za mezní."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
