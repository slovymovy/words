                "senses": [
                    {
                        "sense_id": "67c72d11-f677-31ee-9b71-cfa3afa3a798",
                        "entry_id": "9d40f398-0d22-3b72-98e5-1e19f49c379b",
                        "glosses": [
                            "umgangssprachlich jemand, der viel in Büchern liest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e21969ba-9113-443f-a050-31f3596f9cf2",
                                "sense_id": "67c72d11-f677-31ee-9b71-cfa3afa3a798",
                                "text": "He, Du Bücherwurm! Mach' das Licht aus, ich möchte schlafen!"
                            },
                            {
                                "example_id": "28907ce4-fd60-46cc-b628-1936919a4174",
                                "sense_id": "67c72d11-f677-31ee-9b71-cfa3afa3a798",
                                "text": "„Doch als Bücherwurm wollte Tymek nicht dastehen, deshalb sagte er schnell, dass er am liebsten Witze erzähle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
