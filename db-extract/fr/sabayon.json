                    {
                        "translation_id": "89fe15be-3cfd-4146-b868-b9da3469d61f",
                        "source_entry_id": "e160a249-e17b-3c74-a1e8-f8d0b245f0a8",
                        "source_sense_id": "7850c968-8a21-33d9-b4e8-10e0222f8b3e",
