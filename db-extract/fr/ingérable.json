                        "translation_id": "ad46f057-e9fd-4819-8fbb-63fcae0dea16",
                        "source_entry_id": "2ba27bfb-d090-37e3-bf82-9d43b0ecb612",
                        "source_sense_id": "57fc9bea-3ded-3198-befa-d416b39aa408",
                        "target_lang_word": "unmanageable",
