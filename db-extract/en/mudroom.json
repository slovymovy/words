                        "entry_id": "6c1f3ade-7eec-326b-a688-897ae16529c1",
                        "glosses": [
                            "A room used as a barrier between indoors and outdoors."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "f45d59dd-98df-4ff2-bf91-7e55c8da6a01",
                                "sense_id": "4d942d5f-d551-35eb-83d3-54edf23768e1",
                                "text": "We made sure to hang our wet clothes on the hook in the mudroom when we came in from the snow."
                            },
                            {
                                "example_id": "d124415d-93e2-49c9-9b88-d7f09d3b2788",
                                "sense_id": "4d942d5f-d551-35eb-83d3-54edf23768e1",
                                "text": "In the mud room, I grabbed my wool-lined jacket and headed back out."
                            }
                        ]
                    }
                ],
