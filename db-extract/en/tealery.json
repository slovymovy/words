                        "glosses": [
                            "An enclosure for housing teal before they are killed and eaten."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d4fd944-57f1-420f-ab37-38bd718780a3",
                                "sense_id": "04892384-28d5-35f6-83f7-6918606552e4",
                                "text": "Here are the fowl-house and the sheep-house, and the goat-house, and the cow-house, and the tealery, and the quailery, and the columbarie, and the extensive godowns, and all the other adjuncts of a large Anglo-Indian establishment of the olden time."
                            },
                            {
                                "example_id": "abdec104-631a-4d95-84ef-7e6f0544bd29",
                                "sense_id": "04892384-28d5-35f6-83f7-6918606552e4",
                                "text": "In Behar every prudent English resident keeps a quailery, as well as a tealery, on his premises, and a dish of fat quail is a very agreeable and wholesome change of diet when the weather is hot."
                            },
                            {
                                "example_id": "893350f2-5d3c-439a-8fe6-23d0a85ca517",
                                "sense_id": "04892384-28d5-35f6-83f7-6918606552e4",
                                "text": "We have already mentioned that wild Common Teal were caught and kept in Indian tealeries before being killed and eaten, and archaeological remains suggest that ancient Egyptians may have bred Common Teal in captivity (though this speculation is based on indirect evidence)."
                            }
                        ]
                    }
