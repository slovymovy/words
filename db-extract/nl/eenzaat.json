                            {
                                "example_id": "03dbd4e2-e4a0-4a03-a807-35fcdf52d17a",
                                "sense_id": "83a50f42-3215-33e5-ad09-3afbff03335a",
                                "text": "De angstige eenzaat leefde verscholen in het bos."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7150c05-0c48-398c-a61e-44eaefd74ad7",
                        "entry_id": "709e9d97-fd5e-3cf9-b6a4-0036dba5592a",
                        "glosses": [
                            "eenling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a09bdba0-8efe-433e-9cea-0188b837408b",
                                "sense_id": "c7150c05-0c48-398c-a61e-44eaefd74ad7",
                                "text": "Hij is een echte eenzaat die het prettig vindt om alleen achter zijn computertje te werken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f72405a5-2b49-4d31-9564-0098185e1771",
                        "source_entry_id": "709e9d97-fd5e-3cf9-b6a4-0036dba5592a",
                        "source_sense_id": "c7150c05-0c48-398c-a61e-44eaefd74ad7",
                        "source_sense_description": "eenling",
                        "target_lang_word": "Einzelgänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einzelgänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f2cebe6-d7fd-3f99-b5e4-d93ffd9f94c5",
                                        "entry_id": "25ab6fdf-2f01-351f-bd02-f31aaace93eb",
                                        "glosses": [
                                            "Person, die dazu neigt, sich von anderen Personen fernzuhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1379c87b-b228-41a0-97b6-611117b2b961",
                                                "sense_id": "6f2cebe6-d7fd-3f99-b5e4-d93ffd9f94c5",
                                                "text": "Er führte sich schon immer als Einzelgänger auf."
                                            },
                                            {
                                                "example_id": "fbb11512-5043-4bc6-b987-3cca6a4f689c",
                                                "sense_id": "6f2cebe6-d7fd-3f99-b5e4-d93ffd9f94c5",
                                                "text": "„Außerdem war Richard ein Einzelgänger, und Einzelgänger waren den meisten Inselbewohnern unheimlich.“"
                                            },
                                            {
                                                "example_id": "0505cc06-d753-4d87-b7d5-a87345be56a9",
                                                "sense_id": "6f2cebe6-d7fd-3f99-b5e4-d93ffd9f94c5",
                                                "text": "„Seinen Schilderungen nach mußte es sich bei Schefold um einen Sonderling handeln, einen seltsam wirklichkeitsfremden und dabei leichtsinnigen Einzelgänger.“"
                                            },
                                            {
                                                "example_id": "07f66877-3bcb-4a33-9927-b80d3317dbbc",
                                                "sense_id": "6f2cebe6-d7fd-3f99-b5e4-d93ffd9f94c5",
                                                "text": "„Nur war Renner kein großer Einzelgänger, sondern Mitglied der von Adler zusammengeführten Sozialdemokratie, die bis ins 20. Jahrhundert hinein eine gesamtösterreichische Partei blieb.“"
                                            },
                                            {
                                                "example_id": "61ccc1ef-abb0-4102-815c-a1d36818ca6f",
                                                "sense_id": "6f2cebe6-d7fd-3f99-b5e4-d93ffd9f94c5",
                                                "text": "„Der Amokläufer sei ein unauffälliger Einzelgänger, der selbst in seinem Schützenverein keine großen Freundschaften pflegte, aber immer sehr nett gegrüßt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9b2efbc-f7e2-3f5f-8fb8-7e943fe0d0ef",
                                        "entry_id": "25ab6fdf-2f01-351f-bd02-f31aaace93eb",
                                        "glosses": [
                                            "Tier, das überwiegend einzeln und nicht im Rudel lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5c0575-bb57-4b78-a29f-b12a76dcb0a9",
                                                "sense_id": "f9b2efbc-f7e2-3f5f-8fb8-7e943fe0d0ef",
                                                "text": "Erwachsene männliche Bären leben als Einzelgänger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14470720-1f39-4889-8b89-92f71dd98202",
                        "source_entry_id": "709e9d97-fd5e-3cf9-b6a4-0036dba5592a",
                        "source_sense_id": "c7150c05-0c48-398c-a61e-44eaefd74ad7",
                        "source_sense_description": "eenling",
                        "target_lang_word": "loner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                        "entry_id": "250d9019-1170-33ad-a60d-87db8ce134da",
                                        "glosses": [
                                            "One who is alone, lacking or avoiding the company of others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375be8ce-68db-4825-946a-8635e7f18b1e",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "I actually enjoy being a loner."
                                            },
                                            {
                                                "example_id": "3b0c1299-eb28-437c-91b4-47c998d2ab6a",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "For one thing, he wanted to see if anyone was following Ricketts. The Cockney had been thrown out of SAS because he was a loner and a canteen cowboy."
                                            },
                                            {
                                                "example_id": "7e7d9617-bff3-4fac-9c81-9fab24c7de85",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "I remember reading an article that described three personality types – socializers, loners, and aloners."
                                            },
                                            {
                                                "example_id": "95295597-8540-4f6f-9cde-e59fc0f15759",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "An unaspected planet bides its time and then emerges, often explosively and seemingly out of character. These potent loners are a hidden influence within the chart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
