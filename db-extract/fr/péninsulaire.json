                                        "glosses": [
                                            "Of, pertaining to, resembling, or connected with a peninsula or peninsulas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6905f2f-f1a2-4812-b3bb-35f1d6436211",
                                                "sense_id": "89f48952-d010-3158-9c6a-c88dd42913c4",
                                                "text": "The lakeside cottage was on a peninsular spit of land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70f6074c-1bf3-3e34-ac67-4909e098cc95",
