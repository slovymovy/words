                "senses": [
                    {
                        "sense_id": "48e280f1-b493-3ae9-8e85-6f4586f12efa",
                        "entry_id": "c247bd8a-d21e-37b5-9ecc-0140ee36712b",
                        "glosses": [
                            "Variante orthographique de surcuire (trop cuire)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327a7d78-5817-482f-8a4b-351d713106a3",
                                "sense_id": "48e280f1-b493-3ae9-8e85-6f4586f12efa",
                                "text": "L’agneau cuit relativement vite alors surveillez la cuisson de près pour ne pas sur-cuire la viande !"
                            },
                            {
                                "example_id": "a4c1ce43-c159-4df0-a200-da56a6c73248",
                                "sense_id": "48e280f1-b493-3ae9-8e85-6f4586f12efa",
                                "text": "Passer au four environ 8 minutes (la feuille de riz doit être croustillante). Ne pas sur-cuire, la pâte deviendrait dure."
                            },
                            {
                                "example_id": "91981c6e-8048-4f07-a0b7-ab1526d5b40f",
                                "sense_id": "48e280f1-b493-3ae9-8e85-6f4586f12efa",
                                "text": "Oubliez également les poissons pour toute cuisson anticipée : leur chair fragile cuit rapidement, et les faire réchauffer risquerait de les sur-cuire !"
                            }
                        ]
                    }
