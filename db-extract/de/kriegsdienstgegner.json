                "senses": [
                    {
                        "sense_id": "c649905c-52be-38ae-b397-cb0d23f4cda1",
                        "entry_id": "cca3562a-a424-3356-a3ad-b6b5edc7c92e",
                        "glosses": [
                            "eine Person, die Kriegsdienst ablehnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b69b986c-a8db-4acc-a4e4-a83ada389066",
                                "sense_id": "c649905c-52be-38ae-b397-cb0d23f4cda1",
                                "text": "„Kriegsdienstgegner demonstrierten am 16. Juni 2003 gegen das erste öffentliche Gelöbnis und den Großen Zapfenstreich der Bundeswehr seit mehr als 25 Jahren in Hamburg. Die Polizei setzte mehrere Hundertschaften aus mehreren Bundesländern ein.“"
                            },
                            {
                                "example_id": "04b3bc30-796b-48d2-b50c-2efd77358737",
                                "sense_id": "c649905c-52be-38ae-b397-cb0d23f4cda1",
                                "text": "„Zu den Kriegsdienstgegnern gesellte sich der Ire James Joyce.“"
                            },
                            {
                                "example_id": "e3d12532-a37f-4ff3-8127-3f8e0d243f28",
                                "sense_id": "c649905c-52be-38ae-b397-cb0d23f4cda1",
                                "text": "„Hardekopf, der Enkel eines Schmieds, ging 1916 ins Exil, in die Schweiz, wo sich die Kriegsdienstgegner sammelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
