{
    "word_family": [
        "heiress",
        "heirloom",
        "heirship",
        "heirless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9f9aa98-bda6-3c67-a141-a9e7651b250b",
                    "sense_definition": "Someone who inherits, or is designated to inherit, the property of another.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother is the <w>heir</w> to our childhood house and yet has no interest in it.",
                            "target_lang_translations": {
                                "ru": "Мой брат — <w>наследник</w> дома нашего детства, но он совершенно им не интересуется.",
                                "pl": "Mój brat jest <w>spadkobiercą</w> naszego rodzinnego domu, a mimo to nie interesuje się nim."
                            }
                        },
                        {
                            "text": "The wealthy merchant named his nephew as the sole <w>heir</w> to his vast fortune.",
                            "target_lang_translations": {
                                "ru": "Богатый купец назначил своего племянника единственным <w>наследником</w> своего огромного состояния.",
                                "pl": "Bogaty kupiec wyznaczył swojego siostrzeńca na jedynego <w>spadkobiercę</w> swojego ogromnego majątku."
                            }
                        }
                    ],
                    "synonyms": [
                        "inheritor",
                        "beneficiary"
                    ],
                    "common_phrases": [
                        "sole heir",
                        "legal heir",
                        "heir to the estate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто получает наследство или имущество после смерти другого человека.",
                        "pl": "Osoba, która nabywa spadek lub majątek po kimś innym."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследник",
                                "target_lang_sense_clarification": "имущества"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "spadkobierca",
                                "target_lang_sense_clarification": "osoba dziedzicząca majątek"
                            },
                            {
                                "target_lang_word": "dziedzic",
                                "target_lang_sense_clarification": "osoba przejmująca dobra po kimś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe4890ae-0f43-3229-a4da-a7db9335ab9f",
                    "sense_definition": "One who inherits, or has been designated to inherit, a hereditary title or office.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the <w>heir</w> to the British throne, the Prince of Wales is a very public figure.",
                            "target_lang_translations": {
                                "ru": "Как <w>наследник</w> британского престола, принц Уэльский является очень публичной фигурой.",
                                "pl": "Jako <w>następca</w> brytyjskiego tronu, książę Walii jest osobą bardzo publiczną."
                            }
                        },
                        {
                            "text": "The king presented his newborn son as the rightful <w>heir</w> to the kingdom.",
                            "target_lang_translations": {
                                "ru": "Король представил своего новорожденного сына как законного <w>наследника</w> королевства.",
                                "pl": "Król przedstawił swojego nowo narodzonego syna jako prawowitego <w>następcę</w> królestwa."
                            }
                        }
                    ],
                    "synonyms": [
                        "successor"
                    ],
                    "common_phrases": [
                        "heir to the throne",
                        "heir apparent",
                        "rightful heir"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто наследует титул, престол или высокую должность.",
                        "pl": "Osoba, która dziedziczy tytuł szlachecki, tron lub urząd."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследник",
                                "target_lang_sense_clarification": "престола или титула"
                            },
                            {
                                "target_lang_word": "преемник",
                                "target_lang_sense_clarification": "должности"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "następca",
                                "target_lang_sense_clarification": "osoba obejmująca urząd lub funkcję"
                            },
                            {
                                "target_lang_word": "sukcesor",
                                "target_lang_sense_clarification": "osoba dziedzicząca tron lub stanowisko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ca7e90e-0c85-319c-b8f7-4448604e61fb",
                    "sense_definition": "A successor in a role, representing continuity with the predecessor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is widely considered the intellectual <w>heir</w> to the famous philosopher.",
                            "target_lang_translations": {
                                "ru": "Его многие считают интеллектуальным <w>наследником</w> знаменитого философа.",
                                "pl": "Jest powszechnie uważany za intelektualnego <w>spadkobiercę</w> słynnego filozofa."
                            }
                        },
                        {
                            "text": "The modern scientist is the <w>heir</w> to centuries of discovery and innovation.",
                            "target_lang_translations": {
                                "ru": "Современный ученый — <w>наследник</w> веков открытий и инноваций.",
                                "pl": "Współczesny naukowiec jest <w>spadkobiercą</w> wieków odkryć i innowacji."
                            }
                        }
                    ],
                    "synonyms": [
                        "successor"
                    ],
                    "common_phrases": [
                        "spiritual heir",
                        "intellectual heir"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжатель чьей-либо деятельности, идей или традиций.",
                        "pl": "Osoba kontynuująca czyjąś działalność, idee lub tradycje."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преемник",
                                "target_lang_sense_clarification": "продолжатель дела"
                            },
                            {
                                "target_lang_word": "наследник",
                                "target_lang_sense_clarification": "идей или традиций"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "następca",
                                "target_lang_sense_clarification": "kontynuator czyjejś pracy"
                            },
                            {
                                "target_lang_word": "spadkobierca",
                                "target_lang_sense_clarification": "metaforycznie: kontynuator idei lub tradycji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e8f4e3e-f43a-3ca7-a1b8-0025bf4df344",
                    "sense_definition": "To inherit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man decided that his youngest son should <w>heir</w> the family farm.",
                            "target_lang_translations": {
                                "ru": "Старик решил, что его младший сын должен <w>унаследовать</w> семейную ферму.",
                                "pl": "Starzec zdecydował, że jego najmłodszy syn powinien <w>odziedziczyć</w> rodzinną farmę."
                            }
                        },
                        {
                            "text": "In this region, it is common for the eldest daughter to <w>heir</w> the property.",
                            "target_lang_translations": {
                                "ru": "В этом регионе принято, чтобы старшая дочь <w>наследовала</w> имущество.",
                                "pl": "W tym regionie powszechne jest, że najstarsza córka <w>dziedziczy</w> majątek."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "used in some regional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать что-либо в наследство.",
                        "pl": "Otrzymywać coś w spadku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследовать",
                                "target_lang_sense_clarification": "получать в наследство"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dziedziczyć",
                                "target_lang_sense_clarification": "otrzymywać majątek w spadku"
                            },
                            {
                                "target_lang_word": "odziedziczyć",
                                "target_lang_sense_clarification": "dokonane: otrzymać w spadku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}