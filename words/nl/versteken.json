                            }
                        },
                        {
                            "text": "De dief <w>verstak</w> zich in de schaduw van het gebouw.",
                            "target_lang_translations": {
                                "fr": "Le voleur <w>s'est dissimulé</w> dans l'ombre du bâtiment."
                            }
