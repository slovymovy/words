                "senses": [
                    {
                        "sense_id": "5d74132e-19ef-3a6e-ab48-0f1480fffc62",
                        "entry_id": "c08ec2ef-e713-3534-bd6e-06fdf4e491c2",
                        "glosses": [
                            "Anzahl zusammenstehender Büsche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3e62868-56a4-4947-b725-682664bd64ec",
                                "sense_id": "5d74132e-19ef-3a6e-ab48-0f1480fffc62",
                                "text": "„Sie kannte die Plätze der knorrigen Moorbirken und die Buschgruppen aus Weiden und Ebereschen, wo Birkhühner und Wiesenpieper nisteten.“"
                            },
                            {
                                "example_id": "328ca2e4-6b10-4bd0-8dfe-d8ea716cf3b3",
                                "sense_id": "5d74132e-19ef-3a6e-ab48-0f1480fffc62",
                                "text": "„Während der Äonen, die ich dort lebte, wandelte ich glückselig durch die Gärten, wo malerische Pagoden aus anmutigen Buschgruppen hervorspähen und die weißen Pfade von zarten Blüten gesäumt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
