        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "4db590b9-2766-39de-9f7b-0faeeb27eeea",
                    "sense_definition": "В то время как; в течение времени, когда происходит другое действие.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_conjunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Пока</w> я спал, на улице пошёл сильный дождь.",
                            "target_lang_translations": {
                                "en": "<w>While</w> I was sleeping, it started raining heavily outside.",
                                "tr": "Ben uyurken (<w>iken</w>), dışarıda şiddetli yağmur başladı.",
                                "zh": "<w>在</w>我睡觉的时候，外面下起了大雨。",
                                "nl": "<w>Terwijl</w> ik sliep, begon het buiten hard te regenen.",
                                "pl": "<w>Podczas gdy</w> spałem, na zewnątrz zaczął padać ulewny deszcz.",
                                "de": "<w>Während</w> ich schlief, fing es draußen stark an zu regnen.",
                                "fr": "<w>Pendant que</w> je dormais, il s'est mis à pleuvoir fort dehors.",
                                "it": "<w>Mentre</w> dormivo, fuori ha iniziato a piovere forte.",
                                "cs": "<w>Zatímco</w> jsem spal, venku začalo silně pršet.",
                                "es": "<w>Mientras</w> dormía, empezó a llover fuerte afuera."
                            }
                        },
                        {
                            "text": "Сиди тихо и читай книгу, <w>пока</w> я работаю.",
                            "target_lang_translations": {
                                "en": "Sit quietly and read a book <w>while</w> I work.",
                                "tr": "Ben çalışırken (<w>iken</w>) sessizce otur ve kitap oku.",
                                "zh": "<w>在</w>我工作的时候，你安静地坐着看书。",
                                "nl": "Zit stil en lees een boek <w>terwijl</w> ik werk.",
                                "pl": "Siedź cicho i czytaj książkę, <w>podczas gdy</w> ja pracuję.",
                                "de": "Sitz ruhig da und lies ein Buch, <w>während</w> ich arbeite.",
                                "fr": "Reste tranquille et lis un livre <w>pendant que</w> je travaille.",
                                "it": "Stai seduto in silenzio a leggere un libro <w>mentre</w> lavoro.",
                                "cs": "Seď tiše a čti si knihu, <w>zatímco</w> pracuji.",
                                "es": "Siéntate tranquilo y lee un libro <w>mientras</w> trabajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "покуда",
                        "в то время как"
                    ],
                    "common_phrases": [
                        "пока я",
                        "пока мы"
                    ],
                    "target_lang_definitions": {
                        "en": "While; during the time when another action is taking place.",
                        "tr": "Esnasında; başka bir eylemin gerçekleştiği süre boyunca.",
                        "zh": "当……的时候；在另一个动作发生的过程中。",
                        "nl": "Terwijl; gedurende de tijd dat een andere actie plaatsvindt.",
                        "pl": "Podczas gdy; w czasie, gdy ma miejsce inne działanie.",
                        "de": "Während; in der Zeit, in der eine andere Handlung stattfindet.",
                        "fr": "Pendant que ; durant le temps où une autre action se déroule.",
                        "it": "Mentre; durante il tempo in cui si svolge un'altra azione.",
                        "cs": "Zatímco; během doby, kdy probíhá jiný děj.",
                        "es": "Mientras; durante el tiempo en que ocurre otra acción."
                    },
                    "translations": {
