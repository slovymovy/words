                    {
                        "translation_id": "3ee3d210-521b-41c7-bc48-be4e8ecefac7",
                        "source_entry_id": "5a8180e2-4422-3549-a253-5cf498cd7511",
                        "source_sense_description": "of, relating to, or practicing polygamy",
                        "target_lang_word": "polygame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
