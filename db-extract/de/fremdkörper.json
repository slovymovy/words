                        ],
                        "form": "die Fremdkörper"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce501427-344c-3e11-9a62-5c71db1393ef",
                        "entry_id": "b0dc8af8-9118-3e48-bfa3-6d80ec239f9b",
                        "glosses": [
                            "ein Teil, der nicht Bestandteil eines Ganzen ist (der normalerweise nicht dazu gehört)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae599560-8168-4191-afd7-7b7217292d95",
                                "sense_id": "ce501427-344c-3e11-9a62-5c71db1393ef",
                                "text": "Bei dem Unfall sind kleine Fremdkörper in die Wunde eingedrungen, die nun chirurgisch entfernt werden müssen."
                            },
                            {
                                "example_id": "b6fa384d-c379-4f92-8fcf-5b70b3f7cac6",
                                "sense_id": "ce501427-344c-3e11-9a62-5c71db1393ef",
                                "text": "Der Körper könnte die neue Niere als Fremdkörper betrachten und abstoßen."
                            },
                            {
                                "example_id": "8e584d8b-5b58-4adf-abb0-46d6353eeda4",
                                "sense_id": "ce501427-344c-3e11-9a62-5c71db1393ef",
                                "text": "Auf dem Röntgenbild werden die metallischen Fremdkörper gut zu sehen sein."
                            },
                            {
                                "example_id": "e100caed-40f3-4111-9fa3-ba494a235cba",
                                "sense_id": "ce501427-344c-3e11-9a62-5c71db1393ef",
                                "text": "„Andernfalls bleibt man immer ein Fremdkörper in der Gesellschaft.“"
                            },
                            {
                                "example_id": "7dcf3bf6-100b-44c4-af24-832255fa928f",
                                "sense_id": "ce501427-344c-3e11-9a62-5c71db1393ef",
                                "text": "„Das zeigt, dass die Witzeseite, die der Fundus dieser Sammlung ist, ein Fremdkörper war, der bald darauf eingestellt wurde.“"
                            },
                            {
                                "example_id": "2a27f155-5309-4279-865d-046a2731fab1",
                                "sense_id": "ce501427-344c-3e11-9a62-5c71db1393ef",
                                "text": "„Wie ein Fremdkörper rollt dir das Wort im Ohr herum.“"
                            },
                            {
                                "example_id": "74e1672d-48e5-4643-96cb-7012c0e7631b",
                                "sense_id": "ce501427-344c-3e11-9a62-5c71db1393ef",
                                "text": "„Und doch fühlte sich dieses Haus mit seinen vielen Zimmern, Kammern, Räumen und dem Dachboden voller Möbel, Truhen und Antiquitäten nun an wie ein Fremdkörper unter der Haut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6f91c78-aec9-4e07-8f00-a5f61a8eae73",
                        "source_entry_id": "b0dc8af8-9118-3e48-bfa3-6d80ec239f9b",
                        "source_sense_id": "ce501427-344c-3e11-9a62-5c71db1393ef",
