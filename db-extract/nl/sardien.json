                "translations": [
                    {
                        "translation_id": "eff0c13e-99bd-4c8a-9067-9871f1b8f146",
                        "source_entry_id": "77a407e0-a23a-33d7-95cf-3cfdd756b8e1",
                        "source_sense_id": "92ed9bb2-d394-3c4f-80e1-f4e1152519f0",
                        "source_sense_description": "klein zilverkleurig haringachtig visje, Sardina pilchardus",
                        "target_lang_word": "Sardine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sardine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26744713-2f45-3459-8137-db300546fcd9",
                                        "entry_id": "5667098e-1c0e-38b4-bd45-3c4876073f20",
                                        "glosses": [
                                            "ein Meeresfisch (Sardina pilchardus), verwandt mit dem Hering"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acfca031-8e41-4f9b-8a9a-c4f2e61787e3",
                                                "sense_id": "26744713-2f45-3459-8137-db300546fcd9",
                                                "text": "Das ist eine Sardine."
                                            },
                                            {
                                                "example_id": "fe1a672a-0934-4329-887e-f241921a23c2",
                                                "sense_id": "26744713-2f45-3459-8137-db300546fcd9",
                                                "text": "„Sardinen bevölkern in riesigen Schwärmen nahezu alle Weltmeere.“"
                                            },
                                            {
                                                "example_id": "9eff6a3f-aad6-4bfc-8bce-58232e3a57ae",
                                                "sense_id": "26744713-2f45-3459-8137-db300546fcd9",
                                                "text": "„Studien belegen zudem, dass Fisch in Blech kaum Nährstoffe einbüßt und gerade klassische Dosenfische wie Makrele, Sardinen und Hering sind gute Lieferanten von Omega3-Fettsäure, die auf jedem Ernährungsplan mit Ausrufezeichen steht.“"
                                            },
                                            {
                                                "example_id": "2d9af4c9-677c-477d-9c2e-1080cbf7bd08",
                                                "sense_id": "26744713-2f45-3459-8137-db300546fcd9",
                                                "text": "„Ich drehte mich schnell um und beruhigte sie, nur ich sei es, der um Sardinen anstünde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20263436-7721-4284-8591-c3598689e73c",
                        "source_entry_id": "77a407e0-a23a-33d7-95cf-3cfdd756b8e1",
                        "source_sense_id": "92ed9bb2-d394-3c4f-80e1-f4e1152519f0",
                        "source_sense_description": "klein zilverkleurig haringachtig visje, Sardina pilchardus",
                        "target_lang_word": "sardine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sardine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50b7296e-10c7-3ec0-873a-e7654ca633fc",
                                        "entry_id": "7710d7a8-fd3b-3355-b80f-c4b5ee3b373b",
                                        "glosses": [
                                            "Any one of several species of small herring which are commonly preserved in olive oil or in tins for food, especially the pilchard, or European sardine (Sardina pilchardus, syn. Clupea pilchardus). The American sardines of the Atlantic coast are mostly the young of the Atlantic herring and of the menhaden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb5d68c1-caa7-41e7-acba-061d033213a1",
                                                "sense_id": "50b7296e-10c7-3ec0-873a-e7654ca633fc",
                                                "text": "They feasted on premium sardines packed in olive oil, as did their hunting dogs, who insisted on joining the meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23b901b2-70f9-36aa-9d2a-d66b796ed9fb",
                                        "entry_id": "7710d7a8-fd3b-3355-b80f-c4b5ee3b373b",
                                        "glosses": [
                                            "Someone packed or crammed into a small space."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c27a9d4-4895-4588-abfb-0241b743ddcd",
                                                "sense_id": "23b901b2-70f9-36aa-9d2a-d66b796ed9fb",
                                                "text": "They watched bemused as countless sardines disgorged from a railway car that was never designed to hold so many passengers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sardine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d195d3-06f2-3b39-8bc7-18f348635b95",
                                        "entry_id": "d8a4185a-8257-3abb-8e7a-15df418de841",
                                        "glosses": [
                                            "to fish for sardines"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ac319c-af6e-4171-b9ef-3e1a99e42f8f",
                                                "sense_id": "c9d195d3-06f2-3b39-8bc7-18f348635b95",
                                                "text": "No one on Monhegan says they saw them, but a man sardining says he saw it headed there, or at least some boat with people atop it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "618e9478-c030-3921-9c44-ed482f3d9c8f",
                                        "entry_id": "d8a4185a-8257-3abb-8e7a-15df418de841",
                                        "glosses": [
                                            "to pack or cram together tightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61424ff3-0085-42de-8f2e-c9007bbe939c",
                                                "sense_id": "618e9478-c030-3921-9c44-ed482f3d9c8f",
                                                "text": "Six-foot- four McMichael (a past master at the art of sardining) not only crammed enough clothes for the trip into the mighty midget, but carried a full set of golf clubs and a banjo, as well!"
                                            },
                                            {
                                                "example_id": "13392c3b-38f8-402d-a05c-a8b7d921d8e4",
                                                "sense_id": "618e9478-c030-3921-9c44-ed482f3d9c8f",
                                                "text": "Would it be unbearably elitist to suggest that they would be more enjoyable still if the director removed a row or two of chairs, instead of sardining as many listeners as possible into the intimate music room?"
                                            },
                                            {
                                                "example_id": "28cd5c2a-1087-4d74-a8f5-d6ecc55e3ca6",
                                                "sense_id": "618e9478-c030-3921-9c44-ed482f3d9c8f",
                                                "text": "There were already six members of the Nureyev family living in a room sixteen meters square, the children sardined on one mattress on the floor, their parents separated by only a curtain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sardine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "407937df-b752-3d64-84eb-a8993c7ca200",
                                        "entry_id": "00242709-04c4-3153-b324-6d222c99141c",
                                        "glosses": [
                                            "carnelian."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "664f72fc-c91a-33be-a1ed-209b42d2b54d",
                                        "entry_id": "00242709-04c4-3153-b324-6d222c99141c",
                                        "glosses": [
                                            "Dark-brown sard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sardine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dac331cf-fdda-37db-8a53-a95d6b22cb9f",
                                        "entry_id": "793989a6-984c-3d1d-b573-8691455b73a7",
                                        "glosses": [
                                            "Characteristic of a sardius."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03579552-27fb-45d6-9026-4139c10ff020",
                                                "sense_id": "dac331cf-fdda-37db-8a53-a95d6b22cb9f",
                                                "text": "And he that sat was to look upon like a jasper and a sardine stone: and there was a rainbow round about the throne, in sight like unto an emerald."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fc2d45b-e41f-4d20-8cb6-c1af0a97f4e8",
                        "source_entry_id": "77a407e0-a23a-33d7-95cf-3cfdd756b8e1",
                        "source_sense_id": "92ed9bb2-d394-3c4f-80e1-f4e1152519f0",
                        "source_sense_description": "klein zilverkleurig haringachtig visje, Sardina pilchardus",
                        "target_lang_word": "sardine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sardine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73516380-14e2-39de-9415-08d5583a5345",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Poisson de mer au corps fuselé d'une vingtaine de centimètres de long, au dos bleuté et au ventre argenté, apparenté au hareng."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2f1c43f-c615-414f-b2ef-17caae2d8ad5",
                                                "sense_id": "73516380-14e2-39de-9415-08d5583a5345",
                                                "text": "Les poissons qu’on y pêche sont d’un goût excellent ; ceux qu’on estime le plus et qu’on rencontre le plus fréquemment, sont : le rouget, le maquereau, le loup, la sole, deux espèces de sardines enfin et sur-tout le mulet (vulgairement muge), dont nos pêcheurs distinguent aussi deux variétés."
                                            },
                                            {
                                                "example_id": "147fa019-062f-41e3-b6d2-c5b86273f0c2",
                                                "sense_id": "73516380-14e2-39de-9415-08d5583a5345",
                                                "text": "C'était la saison où les gens de Concarneau pêchent la sardine et des centaines de barques forçaient de voiles pour rentrer au port avant que la tempête éclatât."
                                            },
                                            {
                                                "example_id": "76da15a5-8f74-415a-a25b-e72ea207a26d",
                                                "sense_id": "73516380-14e2-39de-9415-08d5583a5345",
                                                "text": "Cette transformation est indispensable pour assurer une bonne tenue de la sardine dans les opérations de « friterie » proprement dites, menées immédiatement après par les friteuses."
                                            },
                                            {
                                                "example_id": "6fa44e3c-0026-4408-bdb6-0b2b4e7e4c02",
                                                "sense_id": "73516380-14e2-39de-9415-08d5583a5345",
                                                "text": "À l'instar de ces menus de restaurant gastronomique où une sardine se transforme en « perle de l'océan », où une compote de pommes devient d'office un « coulis de fruits défendus » et où une nouille se métamorphose en « ruban de semoule enfarinée », vous pouvez aussi rebaptiser votre profession d'une nouvelle étiquette qui fera rêver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0566fdcb-aaf7-3f9f-a85f-0534f29bdd3c",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Broche métallique servant à fixer une tente de camping au sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1431c53b-92bc-4628-8a7a-e911b278fa1b",
                                                "sense_id": "0566fdcb-aaf7-3f9f-a85f-0534f29bdd3c",
                                                "text": "Il y a aussi ce piquet de tente, une grande pointe en fer percée d’un trou, ce que les campeurs d’aujourd’hui appelleraient une « sardine »."
                                            },
                                            {
                                                "example_id": "ae733870-b1bb-4fb9-ba85-8c9ca074fc4b",
                                                "sense_id": "0566fdcb-aaf7-3f9f-a85f-0534f29bdd3c",
                                                "text": "Même devant la tente, concentrée sur des préparatifs ou la plantation des sardines, elle est bien mise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b306095-4b89-391d-8ce3-f873835fdce9",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Barrette indiquant le grade sur les épaulettes ou sur les manches d’un uniforme."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b75805a4-3e11-4b24-8933-ec542a4a8938",
                                                "sense_id": "0b306095-4b89-391d-8ce3-f873835fdce9",
                                                "text": "Point satisfait cependant, il épiait le sergent-fourrier Menoux, élite en toutes choses, qui revêtait une nouvelle fois sa veste pour mieux juger du bel effet de ses sardines obliques cousues sur les deux manches, à hauteur du biceps."
                                            },
                                            {
                                                "example_id": "5b1daf23-b602-416e-a6cc-63122b1a949d",
                                                "sense_id": "0b306095-4b89-391d-8ce3-f873835fdce9",
                                                "text": "— Te frappe pas, disait Lepage à Chalumot. On te l’filera, ton galon d’première classe. Il arrive… Toi qui peux pas blairer les gradés, t’auras l’air fin avec ta sardine…"
                                            },
                                            {
                                                "example_id": "27f60add-21e6-4661-ab1f-f43eb1ef20fc",
                                                "sense_id": "0b306095-4b89-391d-8ce3-f873835fdce9",
                                                "text": "Au bout de trois ans, Gwen débarque un matin de l’autocar de Brest, quartier-maître, avec de belles sardines rouges sur la manche."
                                            },
                                            {
                                                "example_id": "c611f37c-8269-406b-94db-a7ce34229357",
                                                "sense_id": "0b306095-4b89-391d-8ce3-f873835fdce9",
                                                "text": "Depuis qu’il a gagné ses sardines il se prend au sérieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3512840e-21c4-346e-8d06-0be91a5fabd1",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Traces semi-circulaires laissées par le bord d'une taloche, d'une lisseuse sur un enduit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0561133d-b18c-35b7-b09f-baa4ae112b73",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Jeu dans lequel un joueur se cache et tous les autres le cherchent et le rejoignent lorsqu’ils le trouvent, jusqu’à ce que tous les joueurs aient trouvé la sardine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1056c78-3f06-3435-8019-98d35899d9c9",
                                        "entry_id": "e3f84182-ad24-3dfd-a7bd-fd7f6554e09e",
                                        "glosses": [
                                            "Personne qui se cache dans ce même jeu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
