                        "source_entry_id": "f2e11eb0-4c1d-3283-a6ba-061eca13ea4b",
                        "source_sense_id": "5768a02c-e963-3c65-b1b5-63371afd1e66",
                        "source_sense_description": "Anatomie: ein winkelförmiger Knochen und Teil des Beckens",
                        "target_lang_word": "pubis",
