                "senses": [
                    {
                        "sense_id": "cd2bbc1f-37af-35f3-9265-d7be2592d0bc",
                        "entry_id": "ad8a7f18-7f91-3351-bee9-0f96a67a58cb",
                        "glosses": [
                            "Reise, beispielsweise zur Erholung, nach Griechenland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b60b72d5-f738-41d9-bfe8-4291ea50a0de",
                                "sense_id": "cd2bbc1f-37af-35f3-9265-d7be2592d0bc",
                                "text": "Mit einem Griechenlandurlaub verbinden die meisten Sonne, Strand und blaues Wasser."
                            },
                            {
                                "example_id": "66e1b8e7-4aad-4b6c-b087-4a0770cd23c7",
                                "sense_id": "cd2bbc1f-37af-35f3-9265-d7be2592d0bc",
                                "text": "Lass uns zum Flughafen fahren, einfach einen Griechenlandurlaub buchen und eine Woche ausspannen."
                            },
                            {
                                "example_id": "c2ea72ac-a8e0-4517-aa6a-9c0a380036da",
                                "sense_id": "cd2bbc1f-37af-35f3-9265-d7be2592d0bc",
                                "text": "In Zeiten des menschengemachten Klimawandels kann man sich einen Griechenlandurlaub einfach nicht mehr leisten."
                            },
                            {
                                "example_id": "14c05eb9-f3d6-431f-9abb-744433643aed",
                                "sense_id": "cd2bbc1f-37af-35f3-9265-d7be2592d0bc",
                                "text": "Für manche Deutsche ist ein jährlicher Griechenlandurlaub Normalität."
                            },
                            {
                                "example_id": "5b6fe888-ce86-4175-8b5c-3768094bac78",
                                "sense_id": "cd2bbc1f-37af-35f3-9265-d7be2592d0bc",
                                "text": "„Mittlerweile kommen kaum noch Flüchtlingsboote nach Griechenland. Doch viele Touristen scheinen vor einem Griechenlandurlaub immer noch zurückzuschrecken.“"
                            },
                            {
                                "example_id": "b1d5448f-d3ca-4487-b524-d49a0b14c940",
                                "sense_id": "cd2bbc1f-37af-35f3-9265-d7be2592d0bc",
                                "text": "„»Da kam ein Pärchen, was einen Griechenlandurlaub gemacht hatte auf dem Chalkidiki, zurück nach Minden, ganz normale Touristen.«“"
                            },
                            {
                                "example_id": "157dd189-126d-457e-938b-2d1c40901c77",
                                "sense_id": "cd2bbc1f-37af-35f3-9265-d7be2592d0bc",
                                "text": "„Während Richard Pitterle seinen Griechenlandurlaub noch vor sich hat, ist Friedlinde Gurr-Hirsch gerade aus Hellas zurückgekehrt.“"
                            },
                            {
                                "example_id": "ab5d5306-f31e-442c-9ebc-25b02b5cb46b",
                                "sense_id": "cd2bbc1f-37af-35f3-9265-d7be2592d0bc",
                                "text": "„Auf einer Party erzählt Mike lang, breit und ausführlich von seinem Griechenlandurlaub.“"
                            },
                            {
                                "example_id": "7fbfc79b-090a-48f1-bb0d-b69d84af4f41",
                                "sense_id": "cd2bbc1f-37af-35f3-9265-d7be2592d0bc",
                                "text": "„Immerhin hatte der Unternehmensberater in diesem Frühjahr bereits in einen Griechenlandurlaub investiert. Auf der Insel Pathmos habe er viel weniger von der Krise bemerkt als in Athen. »Es war toll. […]«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
