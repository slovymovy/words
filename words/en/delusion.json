{
    "word_family": [
        "delude",
        "delusional",
        "delusive",
        "delusively"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b65c5f67-0aad-3119-891c-416703c18f47",
                    "sense_definition": "A false belief or opinion that is firmly held despite evidence to the contrary.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "belief_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is laboring under the <w>delusion</w> that he can finish the project in one day.",
                            "target_lang_translations": {
                                "ru": "Он пребывает в глубоком <w>заблуждении</w>, полагая, что сможет закончить проект за один день.",
                                "zh": "他心存<w>妄想</w>，以为自己一天之内就能完成这个项目。"
                            }
                        },
                        {
                            "text": "She suffered from <w>delusions</w> of grandeur and expected everyone to treat her like royalty.",
                            "target_lang_translations": {
                                "ru": "Она страдала <w>манией</w> величия и ожидала, что все будут относиться к ней как к королеве.",
                                "zh": "她患有夸大<w>妄想</w>，指望每个人都像对待皇室一样对待她。"
                            }
                        }
                    ],
                    "synonyms": [
                        "misconception",
                        "fallacy",
                        "fantasy",
                        "illusion",
                        "misbelief"
                    ],
                    "antonyms": [
                        "fact",
                        "reality",
                        "truth"
                    ],
                    "common_phrases": [
                        "delusions of grandeur",
                        "under the delusion",
                        "paranoid delusions",
                        "suffer from delusions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ложное убеждение или мнение, которое твердо отстаивается вопреки доказательствам обратного.",
                        "zh": "尽管有相反的事实证据仍坚信不疑的错误信念或观点；妄想或错觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заблуждение",
                                "target_lang_sense_clarification": "ошибочное мнение"
                            },
                            {
                                "target_lang_word": "иллюзия",
                                "target_lang_sense_clarification": "нечто кажущееся, ложная надежда"
                            },
                            {
                                "target_lang_word": "бред",
                                "target_lang_sense_clarification": "в медицинском контексте или как полная бессмыслица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "妄想",
                                "target_lang_sense_clarification": "医学或心理学上的不切实际想法或虚妄信念"
                            },
                            {
                                "target_lang_word": "错觉",
                                "target_lang_sense_clarification": "不符合客观事实的错误认知或假象"
                            },
                            {
                                "target_lang_word": "幻觉",
                                "target_lang_sense_clarification": "不切实际的幻想或空想"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b48afde-fd00-3bab-a31a-8ebc35a3c155",
                    "sense_definition": "The state of being deluded, misled, or deceiving oneself.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "belief_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is better to face the harsh truth than to persist in <w>delusion</w>.",
                            "target_lang_translations": {
                                "ru": "Лучше взглянуть в лицо суровой правде, чем упорствовать в <w>заблуждении</w>.",
                                "zh": "面对残酷的真相总好过继续<w>自欺欺人</w>。"
                            }
                        },
                        {
                            "text": "The leader's power relied on the mass <w>delusion</w> of his followers.",
                            "target_lang_translations": {
                                "ru": "Власть лидера держалась на массовом <w>заблуждении</w> его последователей.",
                                "zh": "这位领导人的权力建立在其追随者的群体性<w>受蒙蔽</w>之上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "self-deception",
                        "misapprehension",
                        "deception"
                    ],
                    "antonyms": [
                        "clarity",
                        "enlightenment",
                        "reality"
                    ],
                    "common_phrases": [
                        "mass delusion",
                        "capacity for delusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором человек введен в заблуждение или обманывает сам себя.",
                        "zh": "受蒙骗、被误导或自欺欺人的状态或情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самообман",
                                "target_lang_sense_clarification": "обман самого себя"
                            },
                            {
                                "target_lang_word": "заблуждение",
                                "target_lang_sense_clarification": "состояние ошибки"
                            },
                            {
                                "target_lang_word": "обман",
                                "target_lang_sense_clarification": "ложное представление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受蒙蔽",
                                "target_lang_sense_clarification": "处于被欺骗或误导的状态"
                            },
                            {
                                "target_lang_word": "自欺欺人",
                                "target_lang_sense_clarification": "自我欺骗的状态"
                            },
                            {
                                "target_lang_word": "执迷不悟",
                                "target_lang_sense_clarification": "坚持错误认识的状态"
                            },
                            {
                                "target_lang_word": "盲信",
                                "target_lang_sense_clarification": "盲目相信错误观点的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}