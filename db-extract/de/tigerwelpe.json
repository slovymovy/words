                "senses": [
                    {
                        "sense_id": "215b79d9-1da3-3712-9f3b-8bdffb668939",
                        "entry_id": "1ed55fd1-eb36-3e24-9db2-0201f3d0a82d",
                        "glosses": [
                            "Jungtier eines Tigers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d90df808-68d9-4f96-b36d-46e30a3a5e85",
                                "sense_id": "215b79d9-1da3-3712-9f3b-8bdffb668939",
                                "text": "„Man kann plötzlich auf Tigerwelpen stoßen und auf große Pardelkatzen oder Ozelote mit samtenem Fell.“"
                            },
                            {
                                "example_id": "6152d3ba-da22-44f6-9a6b-6151ee53948d",
                                "sense_id": "215b79d9-1da3-3712-9f3b-8bdffb668939",
                                "text": "„Die Frau spielte mit einem Tigerwelpen.“"
                            },
                            {
                                "example_id": "0e228f15-e484-4686-8c86-7932fc91b5f9",
                                "sense_id": "215b79d9-1da3-3712-9f3b-8bdffb668939",
                                "text": "„In der Fernsehsendung Living with Tigers gab es eine fantastische Szene mit zwei Tigerwelpen, die vom Menschen aufgezogen und dann in freier Wildbahn ausgesetzt wurden.“"
                            },
                            {
                                "example_id": "0f0268df-ffe6-4920-8ead-d4849316a2de",
                                "sense_id": "215b79d9-1da3-3712-9f3b-8bdffb668939",
                                "text": "„Mal angenommen, im Schlafzimmer sind noch ein paar Tigerwelpen versteckt oder so was.“"
                            },
                            {
                                "example_id": "fdb9e601-4eaf-4f47-babb-834e4d6e0456",
                                "sense_id": "215b79d9-1da3-3712-9f3b-8bdffb668939",
                                "text": "„»Zu unserem großen Bedauern hat es auch der zweite Tigerwelpe nicht geschafft«, sagt Tierärztin Adriane Prahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
