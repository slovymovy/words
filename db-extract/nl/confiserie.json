                        "sense_id": "321debae-5275-309a-9ed1-f7fc63ef456d",
                        "entry_id": "e81bb962-e3dd-34d0-a458-6e55ff0aee90",
                        "glosses": [
                            "bedrijf dat snoepgoed maakt"
