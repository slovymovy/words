                ],
                "senses": [
                    {
                        "sense_id": "ff113883-eaf4-3af7-9d0e-379f44c30860",
                        "entry_id": "90794f05-e6aa-36ed-9d14-e89c98b2b937",
                        "glosses": [
                            "Faire des cuicuis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42b2a19f-aded-4ee8-8c16-af7606e4c4ce",
                                "sense_id": "ff113883-eaf4-3af7-9d0e-379f44c30860",
                                "text": "Les oiseaux du parc eux-mêmes ont renoncé à cuicuiter."
                            },
                            {
                                "example_id": "f781db9b-b316-44b4-bfd8-bc0ffa869833",
                                "sense_id": "ff113883-eaf4-3af7-9d0e-379f44c30860",
                                "text": "Elle nous a ramené un « super » cadeau qui la fait bien rire... une espèce de merle chanteur qui n'arrête pas de cuicuiter et recuicuiter.. hum hum!"
                            },
                            {
                                "example_id": "bbaed8cb-58aa-4997-92da-a0d3e3dac8c5",
                                "sense_id": "ff113883-eaf4-3af7-9d0e-379f44c30860",
                                "text": "Bizarrement fardée et accoutrée, elle se pointait devant les consommateurs en éreintant un petit accordéon à bout de souffle, sans cesser de couiner : Cui Cui, Cui Cui, Cui cui! Excédés par la cacophonie, les clients lui filaient la pièce pour qu'elle aille cuicuiter plus loin."
                            }
                        ]
                    }
                ],
