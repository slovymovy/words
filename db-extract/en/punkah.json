        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3dab1f30-8715-38e3-99d8-b05216ef9c6e",
                "word": "punkah",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "98a561b0-2bba-42bc-88d2-2f46f3efa0d1",
                        "entry_id": "3dab1f30-8715-38e3-99d8-b05216ef9c6e",
                        "tags": [
                            "plural"
                        ],
                        "form": "punkahs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72b95689-215d-3fb9-aacc-82ce5039b686",
                        "entry_id": "3dab1f30-8715-38e3-99d8-b05216ef9c6e",
                        "glosses": [
                            "A fan, particularly a large fan made of leaf or cloth and hung from the ceiling, (historical) formerly often operated by a servant."
                        ],
                        "tags": [
                            "Myanmar",
                            "South-Asia"
                        ],
                        "examples": [
                            {
                                "example_id": "3fe3037c-a465-45ff-a68c-80a2c89452db",
                                "sense_id": "72b95689-215d-3fb9-aacc-82ce5039b686",
                                "text": "A punkah is, by some, used instead of a chattah, (or umbrella); but it is very inferior as a defence against either sun, wind, or rain."
                            },
                            {
                                "example_id": "f9c856e7-ef32-4b18-9d6c-1c37deac8c9c",
                                "sense_id": "72b95689-215d-3fb9-aacc-82ce5039b686",
                                "text": "Outside the court the sun blazed—within was the wind of great punkahs that made you shiver …"
                            },
                            {
                                "example_id": "06241093-d4a8-4b0a-b4f3-49493db9177a",
                                "sense_id": "72b95689-215d-3fb9-aacc-82ce5039b686",
                                "text": "In the refreshment room a few would-be passengers were cooled by the punkah, worked by a string tied to the big toe of a sleepy Burmese boy."
                            },
                            {
                                "example_id": "ab8c2524-b712-42e1-b896-6c7e7b5a252f",
                                "sense_id": "72b95689-215d-3fb9-aacc-82ce5039b686",
                                "text": "Perhaps it was a mistake to invite Mr Stanhope; the day was intolerably hot and humid; all he wanted to do was to lie on his bed with a punkah sighing over him, at least moving the unbreathable air."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aa9289a-1165-440b-8afe-ad7b7bb1b43d",
                        "source_entry_id": "3dab1f30-8715-38e3-99d8-b05216ef9c6e",
                        "source_sense_id": "72b95689-215d-3fb9-aacc-82ce5039b686",
                        "source_sense_description": "fan",
                        "target_lang_word": "panka",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cb1cb3d-eceb-36ec-b7b2-b53167b31d71",
                                        "entry_id": "90c133f1-1269-335f-a3a3-06c0883574a7",
                                        "glosses": [
                                            "En Inde, grand éventail suspendu au plafond par un côté, et que l'on fait se baisser et se lever au moyen d'un système de poulies et de cordages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f09a38ea-715f-4193-8570-43deada7b0af",
                                                "sense_id": "2cb1cb3d-eceb-36ec-b7b2-b53167b31d71",
                                                "text": "Le panka est indispensable, autant pour aérer que pour chasser les moustiques."
                                            },
                                            {
                                                "example_id": "355d4a84-b93a-45b8-9ea7-0e3774d9b8a4",
                                                "sense_id": "2cb1cb3d-eceb-36ec-b7b2-b53167b31d71",
                                                "text": "Les appartements personnels du prince [de Galles, sur le Sérapis] sont séparés de ceux de ses officiers par un salon qui sera vraiment splendide ; il sera ventilé par six pankas, immenses éventails qui seront mis en mouvement au moyen d'un engrenage."
                                            },
                                            {
                                                "example_id": "d739c924-8798-4c04-a5a0-af31ba5cb0e3",
                                                "sense_id": "2cb1cb3d-eceb-36ec-b7b2-b53167b31d71",
                                                "text": "Il m'affirma qu'il n'y aurait pas un de ces porteurs qui ne trouvât naturel que je demande, un soir, à l'un des deux pages, de venir faire pankas sous ma moustiquaire."
                                            },
                                            {
                                                "example_id": "d4d10d9c-3203-44b6-a9e4-19a97e8058b3",
                                                "sense_id": "2cb1cb3d-eceb-36ec-b7b2-b53167b31d71",
                                                "text": "Après, à Tombouctou, il a eu la vie belle, en effet… Dix boys à ses genoux… Un pour la grosse cuisine, un pour le dessert, un pour agiter le « panka », un pour lui laver les orteils… Alors que le dernier de ces indigènes valait mieux que lui…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
