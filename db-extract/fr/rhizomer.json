                "senses": [
                    {
                        "sense_id": "bd097e00-7423-3d15-8816-2e57022f3675",
                        "entry_id": "90ae478d-c874-3d2f-b198-4add2e37ac82",
                        "glosses": [
                            "Produire des rhizomes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dad17811-0db2-4d98-9c0a-6366c37d7392",
                                "sense_id": "bd097e00-7423-3d15-8816-2e57022f3675",
                                "text": "Nous sommes en Finistère, et de ce bout du bout du monde cherchons à résonner, raisonner et rhizomer avec d’autres acteurs de bouts du monde."
                            },
                            {
                                "example_id": "a7a6c195-3c2b-4bf8-b7fa-d2bf16346356",
                                "sense_id": "bd097e00-7423-3d15-8816-2e57022f3675",
                                "text": "Dans les années 2000, le festival a pris la route pour rhizomer dans les communes alentours ^([sic : alentour])."
                            },
                            {
                                "example_id": "18bf21d5-c298-44b4-969b-d1e88e0e75fa",
                                "sense_id": "bd097e00-7423-3d15-8816-2e57022f3675",
                                "text": "Il faut non plus réseauter mais rhizomer !"
                            },
                            {
                                "example_id": "8042d575-8b66-4246-92b8-a118ee9494db",
                                "sense_id": "bd097e00-7423-3d15-8816-2e57022f3675",
                                "text": "Ça germe, ça fleurit, ça se mélange et ça s’hybride, ça ce ^([sic : se]) réseaute, se rhizome, s’écosystémise, se glisse un peu partout."
                            }
                        ]
                    }
                ],
