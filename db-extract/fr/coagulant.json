                            {
                                "example_id": "dfc68a58-e9a5-4eac-936f-d61e1bbdeeb0",
                                "sense_id": "efee835b-03e5-3817-85f3-b76f0e4a0d1a",
                                "text": "Le tanin est utilisé comme coagulant lors de la fabrication du caoutchouc."
                            },
                            {
                                "example_id": "f6074294-de0d-4b00-b472-8a54faa610a5",
                                "sense_id": "efee835b-03e5-3817-85f3-b76f0e4a0d1a",
                                "text": "Le second accessoire est le récipient dans lequel on ajoute à l’eau le coagulant chimique, presque toujours le sulfate d’alumine."
                            }
                        ]
                    }
