                "senses": [
                    {
                        "sense_id": "22fa3914-24d0-390d-95cc-d2056118e404",
                        "entry_id": "76f952f8-8d8c-3170-8a7c-0191a609b03f",
                        "glosses": [
                            "A form of rented accommodation consisting of a single room for use as both sitting room and bedroom; there may also be a small kitchen area and washing and toilet facilities, but these amenities are more commonly outside the room and shared by several tenants."
                        ],
                        "tags": [
                            "British",
                            "Ireland"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17526981-25cb-4d2f-be30-790290d5e363",
                        "source_entry_id": "76f952f8-8d8c-3170-8a7c-0191a609b03f",
                        "source_sense_id": "22fa3914-24d0-390d-95cc-d2056118e404",
                        "source_sense_description": "rented room",
                        "target_lang_word": "studio",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "studio",
