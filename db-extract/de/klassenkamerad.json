                "senses": [
                    {
                        "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                        "entry_id": "cf1b8e2c-fbe9-34da-9dbc-4a7580988e65",
                        "glosses": [
                            "Person, mit der man in dieselbe Schulklasse geht oder ging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28833d01-cf52-4110-bacd-376762b5f09f",
                                "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                "text": "Morgen ist Klassentreffen. Ich bin ja so gespannt, was aus meinen Klassenkameraden geworden ist."
                            },
                            {
                                "example_id": "5e97dbf9-7bdc-40ef-92f1-7c03bb7d2121",
                                "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                "text": "„Meine neuen Klassenkameraden waren ausnahmsweise mal wirklich nett.“"
                            },
                            {
                                "example_id": "749639c2-d838-4474-b627-45cd0b746999",
                                "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                "text": "„Weil sie in Bad Schandau aus der Jugendherberge ausgebüxt waren, haben Floris alte Klassenkameraden Strafarbeiten bekommen.“"
                            },
                            {
                                "example_id": "9ba8499f-66fe-4268-a767-7f246a6a4dd5",
                                "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                "text": "„Eines Abends aber, als der Junge und zwei Klassenkameraden bei ihm in seinem Internatszimmer zum Tee eingeladen waren, erzählte er Näheres darüber.“"
                            },
                            {
                                "example_id": "0a76bfa1-702f-46a2-8852-9e6d26e2cb49",
                                "sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                                "text": "„Das alles wussten meine Klassenkameraden nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a50b628-faa2-4ad8-8b35-f8930ccf285e",
                        "source_entry_id": "cf1b8e2c-fbe9-34da-9dbc-4a7580988e65",
                        "source_sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                        "source_sense_description": "Person, mit der man in dieselbe Schulklasse geht oder ging",
                        "target_lang_word": "classmate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "classmate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7ec0007-39a8-3c33-8853-859f688650c3",
                                        "entry_id": "94684286-9992-3ccd-b86c-4a7e28c8133d",
                                        "glosses": [
                                            "A student who is in the same class at school."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50df9526-b9ac-4dfd-9bea-b905bcc02d9d",
                                                "sense_id": "c7ec0007-39a8-3c33-8853-859f688650c3",
                                                "text": "She was your classmate at the village school from first grade."
                                            },
                                            {
                                                "example_id": "31e0c9a0-b5c7-4f1a-812c-5109b100b6f6",
                                                "sense_id": "c7ec0007-39a8-3c33-8853-859f688650c3",
                                                "text": "Danny and I have been classmates for five years, but I've never spoken to him outside of lessons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa9025b2-4186-35ba-abd4-45e2750b5893",
                                        "entry_id": "94684286-9992-3ccd-b86c-4a7e28c8133d",
                                        "glosses": [
                                            "A member of a different sort of class, such as locomotives etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87374be0-ccde-42a0-90b1-e8ea3b317ca5",
                                                "sense_id": "fa9025b2-4186-35ba-abd4-45e2750b5893",
                                                "text": "The Class 87 is the only main line-certified member of the fleet left in the UK, although there are 21 classmates in use overseas [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f05aa9cb-b6f1-444c-b711-ad191a145dfc",
                        "source_entry_id": "cf1b8e2c-fbe9-34da-9dbc-4a7580988e65",
                        "source_sense_id": "e889d2eb-31c6-3645-8b70-f4058bd56589",
                        "source_sense_description": "Person, mit der man in dieselbe Schulklasse geht oder ging",
                        "target_lang_word": "camarade de classe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camarade de classe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94f86d43-8249-3d25-ba91-21101abd6ef9",
                                        "entry_id": "81117bbb-1305-3cac-8f35-d3e2a48aa9a4",
                                        "glosses": [
                                            "Personne issue de la même classe scolaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f43c1c31-1335-43e3-8804-9852859b4510",
                                                "sense_id": "94f86d43-8249-3d25-ba91-21101abd6ef9",
                                                "text": "Emmanuel Macron : \"Il était…\", une ancienne camarade de classe balance sur le président"
                                            },
                                            {
                                                "example_id": "88bcc320-def8-4d43-919a-8497c54d4af4",
                                                "sense_id": "94f86d43-8249-3d25-ba91-21101abd6ef9",
                                                "text": "Âgée de 11 ans, elle sauve héroïquement son camarade de classe de l'étouffement"
                                            },
                                            {
                                                "example_id": "03ab6567-0d40-4e72-9e7b-9f7635590635",
                                                "sense_id": "94f86d43-8249-3d25-ba91-21101abd6ef9",
                                                "text": "Une amie et camarade de classe d'Anne Frank décède à 96 ans"
                                            },
                                            {
                                                "example_id": "959dc7bd-fb94-4f77-a980-e48ed9a9b007",
                                                "sense_id": "94f86d43-8249-3d25-ba91-21101abd6ef9",
                                                "text": "Grâce à la manœuvre de Heimlich, un Américain de 9 ans sauve la vie de son camarade de classe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eebaf35-b825-3334-827b-96da86e01b96",
                                        "entry_id": "81117bbb-1305-3cac-8f35-d3e2a48aa9a4",
                                        "glosses": [
                                            "Personne issue de la même classe sociale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7801fcfa-4eb1-4427-a7d5-14dee79eb955",
                                                "sense_id": "9eebaf35-b825-3334-827b-96da86e01b96",
                                                "text": "Mais Isa peut compter sur un camarade de classe (dans tous les sens du terme) : son valet Jean-François et sa tête à porter des badges « Les jeunes avec Juppé » avant même que ce soit tendance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
