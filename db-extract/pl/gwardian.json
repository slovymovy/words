                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a91529-a452-4efc-b061-63989fdaac4c",
                                "sense_id": "ca5f7f57-f114-3a9f-8435-d1091f6c7acd",
                                "text": "Donośny głos księcia wojewody i ojca gwardiana nad naszymi wszystkimi się unosiły."
                            },
                            {
                                "example_id": "83a69d48-6a91-4028-baa4-136f434366e6",
                                "sense_id": "ca5f7f57-f114-3a9f-8435-d1091f6c7acd",
                                "text": "Zwyczaj mianowania gwardianów przez ministrów prowincjalnych wykształcił się we franciszkańskich prowincjach zaalpejskich."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
