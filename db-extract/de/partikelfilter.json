                "senses": [
                    {
                        "sense_id": "a7b88053-3b16-3e07-805d-5a8e3614ee38",
                        "entry_id": "80d16f14-a990-3667-94dc-bfcfdaaa632c",
                        "glosses": [
                            "eine Vorrichtung, die sehr kleine, feste Teilchen aus einem Gas- oder Flüssigkeitsgemisch zurückhält"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "dd0564c0-1fb9-4d0c-99da-ad97b5acdbaf",
                                "sense_id": "a7b88053-3b16-3e07-805d-5a8e3614ee38",
                                "text": "Partikelfilter kommen unter anderem in Dieselmotoren, Atemschutzmasken und bei der Schutzraumbelüftung zum Einsatz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d30fb5d7-5591-3dd4-a674-ad9c837f9817",
                        "entry_id": "80d16f14-a990-3667-94dc-bfcfdaaa632c",
                        "glosses": [
                            "eine Anlage, Einrichtung, Vorrichtung zur Reduzierung von Partikeln in Abgasen bei Dieselmotoren"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "3a039a0b-4e8b-45c4-9023-eaa9772ea895",
                                "sense_id": "d30fb5d7-5591-3dd4-a674-ad9c837f9817",
                                "text": "Potenzielle Käufer sollten unbedingt darauf achten, dass der Wagen mit dem Partikelfilter ausgestattet ist."
                            },
                            {
                                "example_id": "bdc3194e-80a7-4d19-8f71-676ac759f8c8",
                                "sense_id": "d30fb5d7-5591-3dd4-a674-ad9c837f9817",
                                "text": "Ich möchte daran erinnern, dass es uns vor 13 Jahren auch gelungen war, 2004/2005, die Autoindustrie davon zu überzeugen, vorzeitig die Partikelfilter in alle Neufahrzeuge einzubauen. Das war damals die Kampagne \"Kein Diesel ohne Filter\"."
                            },
                            {
                                "example_id": "96241ef6-fb85-4a6a-b402-041d81cc6c03",
                                "sense_id": "d30fb5d7-5591-3dd4-a674-ad9c837f9817",
                                "text": "„Die neuen GAT-Partikelfilter-Systeme,“ (…) „basieren auf einer völlig neuen Technik und haben die ersten internen Prüfungen bereits mit Erfolg absolviert.“"
                            }
                        ],
