                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "df38ce96-f6d5-404d-acb9-afcc069fa910",
                                "sense_id": "45cfcb1d-3696-3b3e-96c7-c0f05b3e0c1e",
                                "text": "Faraji, my husband, had been elected co-president of P.S. 307’s P.T.A. along with Benjamin Greene, another black middle-class parent from Bed-Stuy, who also serves on the community education council."
                            }
                        ]
                    },
                    {
                        "sense_id": "2018ebf3-ed3f-320c-9370-ad3cfe33e02e",
                        "entry_id": "9c8a905c-a123-37cd-a125-e4739bc281bc",
                        "glosses": [
                            "Initialism of phosphotungstic acid."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "countable",
