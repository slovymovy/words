                "senses": [
                    {
                        "sense_id": "5eaf8f83-3dcb-3efc-9ca0-2b0d1644ba21",
                        "entry_id": "0ca8e228-1f10-3d27-bef4-73ab5606caab",
                        "glosses": [
                            "Rendre obligatoire."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d617d94d-440d-4fcd-a630-b3cfa3c0899c",
                                "sense_id": "5eaf8f83-3dcb-3efc-9ca0-2b0d1644ba21",
                                "text": "L’idée de généraliser et « obligatoiriser » l’orientation professionnelle officielle est une pure sottise, je pense qu’il n’est pas besoin de le démontrer."
                            },
                            {
                                "example_id": "f20a3ba5-a833-4eb5-a5e6-2d4eccd3ac52",
                                "sense_id": "5eaf8f83-3dcb-3efc-9ca0-2b0d1644ba21",
                                "text": "Mon opinion depuis toujours est qu’il faut favoriser, dynamiser, \"obligatoiriser\""
                            },
                            {
                                "example_id": "2de886c3-8ef1-447e-8a63-4089021ea9db",
                                "sense_id": "5eaf8f83-3dcb-3efc-9ca0-2b0d1644ba21",
                                "text": "Dès qu’on aura inventé/réglementé/obligatoirisé la plaque d’immatriculation pour les piétons..."
                            }
                        ]
                    }
                ],
