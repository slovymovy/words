                "translations": [
                    {
                        "translation_id": "b976771e-776a-43c9-890d-b12502a8ae20",
                        "source_entry_id": "3f8b56c5-cf4c-3dd8-8bef-09d82b1ded94",
                        "source_sense_id": "607fc76a-fda9-3f04-aa83-e1b125cf0d9d",
                        "source_sense_description": "jugendsprachlich: was",
                        "target_lang_word": "was",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "was",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d248cdfe-d3a9-3265-97f8-9a056435bc88",
                                        "entry_id": "91645779-ab66-3040-96af-e2b6d382d883",
                                        "glosses": [
                                            "sächliches Fragewort"
                                        ],
                                        "tags": [
                                            "Interrogativpronomen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10dc8773-02e1-4bac-87a6-147bf9b9637d",
                                                "sense_id": "d248cdfe-d3a9-3265-97f8-9a056435bc88",
                                                "text": "Was ist denn das da?"
                                            },
                                            {
                                                "example_id": "3ecfd4aa-7065-400c-ad7d-60fbc54987c7",
                                                "sense_id": "d248cdfe-d3a9-3265-97f8-9a056435bc88",
                                                "text": "Das magst du, was?"
                                            },
                                            {
                                                "example_id": "9ba65323-51f5-4a3a-91b4-41c65a9f1e09",
                                                "sense_id": "d248cdfe-d3a9-3265-97f8-9a056435bc88",
                                                "text": "„Dann wieder kommt es vor, dass sie plötzlich nicht wissen, was reden – […].“"
                                            },
                                            {
                                                "example_id": "7e3c13fc-7519-4e30-a87a-aa48ac53e5bf",
                                                "sense_id": "d248cdfe-d3a9-3265-97f8-9a056435bc88",
                                                "text": "„Ich wußte nicht, was tun.“"
                                            },
                                            {
                                                "example_id": "1dc90867-2666-46f2-afd8-5bd3a7ee13ad",
                                                "sense_id": "d248cdfe-d3a9-3265-97f8-9a056435bc88",
                                                "text": "„Ida wagte nicht, sich zu bewegen, wusste nicht, was sagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "27b9678f-88c4-36a0-862c-7a72b3a7be1e",
                                        "entry_id": "91645779-ab66-3040-96af-e2b6d382d883",
                                        "glosses": [
                                            "etwas"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66b0fac6-c731-4e7e-8390-ded566f9a055",
                                                "sense_id": "27b9678f-88c4-36a0-862c-7a72b3a7be1e",
                                                "text": "An dieser Tatsache ist was dran."
                                            },
                                            {
                                                "example_id": "542c1db1-dcf9-4719-a3e8-72c4f27cf814",
                                                "sense_id": "27b9678f-88c4-36a0-862c-7a72b3a7be1e",
                                                "text": "Er hat endlich wieder was, worüber er sich ärgern kann."
                                            },
                                            {
                                                "example_id": "5c187d82-dd17-4905-b20a-f67ee328ce5a",
                                                "sense_id": "27b9678f-88c4-36a0-862c-7a72b3a7be1e",
                                                "text": "Das Kinderspiel heißt »Ich sehe was, was du nicht siehst.«"
                                            },
                                            {
                                                "example_id": "b05cfb04-80b3-43a5-b48e-761e4bcaea20",
                                                "sense_id": "27b9678f-88c4-36a0-862c-7a72b3a7be1e",
                                                "text": "„»Ist was?« fragt der Soldat. »Nein.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f256a4b1-66f1-3326-a52b-fce3bc75547e",
                                        "entry_id": "91645779-ab66-3040-96af-e2b6d382d883",
                                        "glosses": [
                                            "das sich auf ein Wort oder einen ganzen Satz beziehen kann"
                                        ],
                                        "tags": [
                                            "Relativpronomen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d14dbfa2-7220-4c4c-ab6d-854def399ce5",
                                                "sense_id": "f256a4b1-66f1-3326-a52b-fce3bc75547e",
                                                "text": "Ich sehe was, was du nicht siehst."
                                            },
                                            {
                                                "example_id": "0cce9beb-6098-484d-9603-943ab64329d4",
                                                "sense_id": "f256a4b1-66f1-3326-a52b-fce3bc75547e",
                                                "text": "Alles, was ich habe, ist meine Küchenschabe. (Reinhard Mey)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
