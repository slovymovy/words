                    {
                        "sense_id": "8d8a4bc6-f4d3-37c6-bb55-ea8286e7c61b",
                        "entry_id": "2e028101-372b-32be-b1ab-5da31ff22459",
                        "glosses": [
                            "weiterführende, persönliche Ausbildung und Qualifizierung"
                        ],
                        "tags": [
                            "fachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "6922f577-5f75-47ce-b1b3-eac5f9f36758",
                                "sense_id": "8d8a4bc6-f4d3-37c6-bb55-ea8286e7c61b",
                                "text": "Das Wissen der Menschheit verzehnfacht sich jedes Jahr, und bei diesem Tempo bleibt jedem heute Wissenden, nur die persönliche Weiterbildung für morgen."
                            },
                            {
                                "example_id": "1caceec0-ffac-4129-82d5-c6d34f9bb939",
                                "sense_id": "8d8a4bc6-f4d3-37c6-bb55-ea8286e7c61b",
                                "text": "Weiterbildung geht über das eigene Fach hinaus oder führt davon fort, Fortbildung führt im eigenen Fach weiter – die Bezeichnungen vertauschen die Inhalte der Begriffe."
                            }
                        ],
                        "sense_index_json": "\"1\""
