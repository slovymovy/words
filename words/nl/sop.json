{
    "word_family": [
        "soppen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22a12852-5c4f-38d6-b642-b7309faccb77",
                    "sense_definition": "Warm water met een schoonmaakmiddel om mee te poetsen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "schoonmaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik maak een <w>sop</w> om de vloer grondig te reinigen.",
                            "target_lang_translations": {
                                "en": "I am making <w>soapy water</w> to clean the floor thoroughly."
                            }
                        },
                        {
                            "text": "Zij gebruikt een warm <w>sop</w> om de ramen streeploos schoon te krijgen.",
                            "target_lang_translations": {
                                "en": "She uses warm <w>soapy water</w> to get the windows clean and streak-free."
                            }
                        }
                    ],
                    "synonyms": [
                        "zeepsop"
                    ],
                    "common_phrases": [
                        "een sopje maken"
                    ],
                    "target_lang_definitions": {
                        "en": "Warm water mixed with cleaning agent used for scrubbing or washing surfaces."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "soapy water",
                                "target_lang_sense_clarification": "General term for water mixed with soap for cleaning."
                            },
                            {
                                "target_lang_word": "suds",
                                "target_lang_sense_clarification": "Refers to the soapy water or the foam created by soap."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "262f1d95-9338-309e-b478-0aedbe769d48",
                    "sense_definition": "Het zeewater, vaak gebruikt in de context van varen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kapitein besloot eindelijk het ruime <w>sop</w> te kiezen.",
                            "target_lang_translations": {
                                "en": "The captain finally decided to set sail for <w>the open sea</w>."
                            }
                        },
                        {
                            "text": "Na jaren op het land verlangde hij weer naar het ruime <w>sop</w>.",
                            "target_lang_translations": {
                                "en": "After years on land, he longed for <w>the open sea</w> again."
                            }
                        }
                    ],
                    "synonyms": [
                        "zee"
                    ],
                    "common_phrases": [
                        "het ruime sop"
                    ],
                    "target_lang_definitions": {
                        "en": "The open sea, often used in the context of sailing or setting out on a voyage."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the open sea",
                                "target_lang_sense_clarification": "Used in the idiomatic expression 'het ruime sop'."
                            },
                            {
                                "target_lang_word": "the high seas",
                                "target_lang_sense_clarification": "Refers to the vast, open ocean."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c588aef7-69fa-3f17-97b6-ef71dc92ef5a",
                    "sense_definition": "Het vocht dat overblijft na het koken van voedsel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "voeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gebruik het <w>sop</w> van de groenten als basis voor een lekkere saus.",
                            "target_lang_translations": {
                                "en": "Use the <w>cooking liquid</w> from the vegetables as a base for a tasty sauce."
                            }
                        },
                        {
                            "text": "Het vlees kookte langzaam in zijn eigen <w>sop</w>.",
                            "target_lang_translations": {
                                "en": "The meat cooked slowly in its own <w>juices</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kooknat"
                    ],
                    "target_lang_definitions": {
                        "en": "The liquid or juices remaining after cooking food."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cooking liquid",
                                "target_lang_sense_clarification": "The water or broth left after boiling vegetables or meat."
                            },
                            {
                                "target_lang_word": "juices",
                                "target_lang_sense_clarification": "The natural fluids released by meat during cooking."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba182f61-dfb3-392d-b924-3bab77a7a92d",
                    "sense_definition": "Een verouderde vorm van <w>soep</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "voeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten leest men soms over een kom heet <w>sop</w>.",
                            "target_lang_translations": {
                                "en": "In old texts, one sometimes reads about a bowl of hot <w>soup</w>."
                            }
                        },
                        {
                            "text": "Het woord <w>sop</w> werd vroeger gebruikt voor wat wij nu soep noemen.",
                            "target_lang_translations": {
                                "en": "The word <w>sop</w> was formerly used for what we now call soup."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Verouderde spelling of woordgebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An archaic term for soup."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "soup",
                                "target_lang_sense_clarification": "Archaic usage."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23624a08-dd56-3c80-8aaf-ab083121aa2a",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>soppen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "schoonmaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>sop</w> de hele keuken grondig voordat de gasten komen.",
                            "target_lang_translations": {
                                "en": "I <w>scrub</w> the whole kitchen thoroughly before the guests arrive."
                            }
                        },
                        {
                            "text": "Elke zaterdag <w>sop</w> ik de tegels in de badkamer.",
                            "target_lang_translations": {
                                "en": "Every Saturday I <w>scrub</w> the tiles in the bathroom."
                            }
                        }
                    ],
                    "target_lang_definitions": {
