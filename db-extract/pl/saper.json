                    },
                    {
                        "translation_id": "ab558436-6c5d-4867-a138-892753939999",
                        "source_entry_id": "b8d8be6a-f5a0-30b2-8601-54316b2e7ce6",
                        "source_sense_id": "1ae4ff02-b4f2-350c-81bd-accc8e848a5d",
                        "target_lang_word": "сапёр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сапёр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11af4f93-b3d1-3886-ab8e-24d3d71343c6",
                                        "entry_id": "b8cf5e8b-be6d-338c-8326-01ea5536726b",
                                        "glosses": [
                                            "воен. лицо, находящееся на службе в военных инженерно-строительных войсках"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0b50910-878c-4ef4-9230-f5f1988027cf",
                                                "sense_id": "11af4f93-b3d1-3886-ab8e-24d3d71343c6",
                                                "text": "Между тем сапёры начали рубить палисады и устроивать переправу через ров для перевоза орудий."
                                            },
                                            {
                                                "example_id": "0e46dc83-d94e-4310-86eb-9cf11dad3137",
                                                "sense_id": "11af4f93-b3d1-3886-ab8e-24d3d71343c6",
                                                "text": "Для прохода артиллерии, сапёры предварительно должны расширить дорогу в нескольких местах; но это не трудно."
                                            },
                                            {
                                                "example_id": "68d9291c-c966-420f-bdc8-775910f96568",
                                                "sense_id": "11af4f93-b3d1-3886-ab8e-24d3d71343c6",
                                                "text": "Корпусный командир прислал роту сапёров для исправления дорог и отделки фанз."
                                            },
                                            {
                                                "example_id": "785d04b0-9a01-4046-8175-957f2dc64fdf",
                                                "sense_id": "11af4f93-b3d1-3886-ab8e-24d3d71343c6",
                                                "text": "Работали сапёры, обезвреживали и увозили тысяч мин, фугасов, неразорвавшихся бомб и снарядов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
