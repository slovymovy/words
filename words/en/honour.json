                            "comment": "British, Canadian, Commonwealth, and Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокое уважение, почтение, добрая репутация или привилегия.",
                        "tr": "Yüksek saygı, itibar, şeref veya bir ayrıcalık durumu."
                    },
                    "translations": {
