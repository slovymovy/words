                        "source_entry_id": "a2cfad62-8f62-3ddd-9272-7f7f0d3a735a",
                        "source_sense_id": "dac01d2c-d7dd-310c-9616-e99ee4eb589b",
                        "source_sense_description": "jemand, der über eine umfassende Vollmacht für alle rechtlichen Stellvertretungen verfügt",
                        "target_lang_word": "plenipotentiary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plenipotentiary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "621f75be-9025-30bc-b545-fcb31ceefb7d",
                                        "entry_id": "4f421ce5-db5f-3886-a1e0-1448e6be6bb8",
                                        "glosses": [
                                            "A person invested with full powers, especially as the diplomatic agent of a sovereign state, (originally) charged with handling a certain matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f3f4a21-4b33-49da-a8a0-99148b85b49f",
                                                "sense_id": "621f75be-9025-30bc-b545-fcb31ceefb7d",
                                                "text": "None but the like-minded can come plenipotentiary to our court."
                                            },
                                            {
                                                "example_id": "15cb6909-1c17-4e9b-9e5a-f60ff02f6fe5",
                                                "sense_id": "621f75be-9025-30bc-b545-fcb31ceefb7d",
                                                "text": "1937, P. G. Wodehouse, 'Lord Emsworth and Others', Overlook, Woodstock: 2002, p 232.\nMeeting him in the street and ignoring the foul bowler hat he wore on his walks abroad, you would have put him down as a Bishop in mufti or, at the least, a plenipotentiary at one of the better courts."
                                            },
                                            {
                                                "example_id": "130d479d-bff8-4392-8840-928af373db53",
                                                "sense_id": "621f75be-9025-30bc-b545-fcb31ceefb7d",
                                                "text": "Two of them are hanging up there on Golgotha, and that ought to be enough to show the authority of Rome’s ah plenipotentiary."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plenipotentiary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79a959e3-043d-3013-81f5-b2dc972ab1dc",
                                        "entry_id": "f3f22a7c-d65d-3f8c-9c81-d9ed705ff617",
                                        "glosses": [
                                            "Invested with full power."
                                        ],
