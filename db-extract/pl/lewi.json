                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc89fd46-9810-4c39-a75a-f2305256621e",
                                                "sense_id": "1ccf85d2-5e37-3b64-8063-236edef191a3",
                                                "text": "Frau Levi ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "b3579d13-0f62-429e-b30d-e4c5ed3d078b",
                                                "sense_id": "1ccf85d2-5e37-3b64-8063-236edef191a3",
                                                "text": "Herr Levi wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "6ae8ade8-f313-4643-8526-3e29f35d411f",
                                                "sense_id": "1ccf85d2-5e37-3b64-8063-236edef191a3",
                                                "text": "Die Levis fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "5b05fd1d-370b-4180-8fb6-2565c35238e5",
                                                "sense_id": "1ccf85d2-5e37-3b64-8063-236edef191a3",
                                                "text": "Der Levi trägt nie die Schals, die die Levi ihm strickt."
                                            },
                                            {
                                                "example_id": "168ec6dd-2e18-46a4-94bd-a0b43bd484e1",
                                                "sense_id": "1ccf85d2-5e37-3b64-8063-236edef191a3",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Levi kommt, geht der Herr Levi.“"
                                            },
                                            {
                                                "example_id": "5e864e8e-4e22-4fef-a51c-2b83dbf6158e",
                                                "sense_id": "1ccf85d2-5e37-3b64-8063-236edef191a3",
                                                "text": "Levi kommt und geht."
                                            },
                                            {
                                                "example_id": "9caf7ada-2f31-4e4c-8158-f8b1476d71f1",
                                                "sense_id": "1ccf85d2-5e37-3b64-8063-236edef191a3",
                                                "text": "Levis kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
