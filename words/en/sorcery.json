{
    "word_family": [
        "sorcerer",
        "sorceress"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55ff9e00-9502-3dbb-b646-321e2e5a1539",
                    "sense_definition": "The use of magical powers or witchcraft.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old legend tells of a king who gained his throne through dark <w>sorcery</w>.",
                            "target_lang_translations": {
                                "ru": "Старая легенда рассказывает о короле, который получил свой трон с помощью темного <w>колдовства</w>.",
                                "de": "Die alte Legende erzählt von einem König, der seinen Thron durch dunkle <w>Zauberei</w> erlangte."
                            }
                        },
                        {
                            "text": "Many ancient cultures believed that <w>sorcery</w> could influence the weather and harvest.",
                            "target_lang_translations": {
                                "ru": "Многие древние культуры верили, что <w>магия</w> может влиять на погоду и урожай.",
                                "de": "Viele alte Kulturen glaubten, dass <w>Hexerei</w> das Wetter und die Ernte beeinflussen könne."
                            }
                        }
                    ],
                    "synonyms": [
                        "magic",
                        "witchcraft",
                        "wizardry"
                    ],
                    "common_phrases": [
                        "practice sorcery",
                        "dark sorcery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование магических сил или колдовство.",
                        "de": "Der Einsatz magischer Kräfte oder Hexerei."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колдовство",
                                "target_lang_sense_clarification": "общее понятие магических действий и обрядов"
                            },
                            {
                                "target_lang_word": "магия",
                                "target_lang_sense_clarification": "совокупность обрядов и действий, основанных на вере в сверхъестественные силы"
                            },
                            {
                                "target_lang_word": "волшебство",
                                "target_lang_sense_clarification": "магическое воздействие, часто в сказочном контексте"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zauberei",
                                "target_lang_sense_clarification": "die Ausübung magischer Handlungen"
                            },
                            {
                                "target_lang_word": "Hexerei",
                                "target_lang_sense_clarification": "das Wirken magischer Kräfte, oft im volkstümlichen oder abergläubischen Kontext"
                            },
                            {
                                "target_lang_word": "Magie",
                                "target_lang_sense_clarification": "allgemeiner Begriff für übernatürliche Praktiken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6661dbb-b9ec-3f45-b576-7579814d6b69",
                    "sense_definition": "The practice of black magic.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain was feared for his mastery of <w>sorcery</w> and forbidden rituals.",
                            "target_lang_translations": {
                                "ru": "Злодея боялись из-за его мастерства в <w>чернокнижии</w> и запретных ритуалах.",
                                "de": "Der Schurke wurde für seine Beherrschung der <w>schwarzen Magie</w> und verbotener Rituale gefürchtet."
                            }
                        },
                        {
                            "text": "She studied ancient texts to protect her village from the effects of <w>sorcery</w>.",
                            "target_lang_translations": {
                                "ru": "Она изучала древние тексты, чтобы защитить свою деревню от последствий <w>чародейства</w>.",
                                "de": "Sie studierte alte Texte, um ihr Dorf vor den Auswirkungen von <w>Zauberei</w> zu schützen."
                            }
                        }
                    ],
                    "synonyms": [
                        "black magic",
                        "hexcraft"
                    ],
                    "common_phrases": [
                        "evil sorcery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика черной магии.",
                        "de": "Die Ausübung schwarzer Magie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернокнижие",
                                "target_lang_sense_clarification": "занятие черной магией, колдовство с использованием запретных знаний"
                            },
                            {
                                "target_lang_word": "ворожба",
                                "target_lang_sense_clarification": "устаревшее обозначение колдовства или гадания"
                            },
                            {
                                "target_lang_word": "чародейство",
                                "target_lang_sense_clarification": "книжный термин для обозначения магических практик"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schwarze Magie",
                                "target_lang_sense_clarification": "Praktiken, die auf böse oder schädliche übernatürliche Mächte abzielen"
                            },
                            {
                                "target_lang_word": "Zauberei",
                                "target_lang_sense_clarification": "dunkle oder verbotene magische Künste"
                            },
                            {
                                "target_lang_word": "Hexerei",
                                "target_lang_sense_clarification": "schadenszauberische Handlungen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}