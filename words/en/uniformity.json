{
    "word_family": [
        "uniform",
        "uniformly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8d8389f-fb0b-31c5-aedc-6d77d8e6651f",
                    "sense_definition": "The state of having the same characteristics or form throughout, showing consistency or regularity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>uniformity</w> of the decor makes the room feel very calm and organized.",
                            "target_lang_translations": {
                                "zh": "装饰的<w>一致性</w>让房间显得非常宁静且井然有序。"
                            }
                        },
                        {
                            "text": "The company aims for <w>uniformity</w> in its products to ensure quality across all stores.",
                            "target_lang_translations": {
                                "zh": "公司追求产品<w>一致性</w>，以确保所有门店的质量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "regularity",
                        "uniformity"
                    ],
                    "antonyms": [
                        "variety"
                    ],
                    "common_phrases": [
                        "maintain uniformity",
                        "lack of uniformity"
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物在形式、特征或性质上保持一致或规律的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "一致性",
                                "target_lang_sense_clarification": "强调事物在标准或特征上的统一。"
                            },
                            {
                                "target_lang_word": "均匀性",
                                "target_lang_sense_clarification": "强调分布或结构上的平稳、无差异。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "813e6e54-d4a6-33a0-b2b8-bd0b51516f4e",
                    "sense_definition": "A lack of variety that results in a tedious or boring sameness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "monotony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew tired of the <w>uniformity</w> of his daily routine and decided to travel.",
                            "target_lang_translations": {
                                "zh": "他厌倦了日常生活中<w>单调</w>的重复，决定去旅行。"
                            }
                        },
                        {
                            "text": "The endless <w>uniformity</w> of the desert landscape eventually became quite depressing.",
                            "target_lang_translations": {
                                "zh": "沙漠景观无尽的<w>单调</w>最终让人感到十分压抑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sameness"
                    ],
                    "antonyms": [
                        "variety"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因缺乏变化而导致的单调或乏味。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "单调",
                                "target_lang_sense_clarification": "指因缺乏变化而显得枯燥。"
                            },
                            {
                                "target_lang_word": "千篇一律",
                                "target_lang_sense_clarification": "形容事物完全相同，毫无新意。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab107eb9-2858-31f0-b01a-e32dba78a199",
                    "sense_definition": "The requirement or practice of following the same rules, beliefs, or viewpoints as others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "conformity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization demanded strict <w>uniformity</w> of opinion from all its members.",
                            "target_lang_translations": {
                                "zh": "该组织要求所有成员在观点上保持严格的<w>统一性</w>。"
                            }
                        },
                        {
                            "text": "The new policy was designed to enforce <w>uniformity</w> in how the staff handles complaints.",
                            "target_lang_translations": {
                                "zh": "新政策旨在强制要求员工在处理投诉时保持<w>统一性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conformity"
                    ],
                    "antonyms": [
                        "variation"
                    ],
                    "common_phrases": [
                        "enforce uniformity"
                    ],
                    "target_lang_definitions": {
                        "zh": "指要求或实践中遵循与他人相同的规则、信仰或观点。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "统一性",
                                "target_lang_sense_clarification": "指在行动或思想上保持步调一致。"
                            },
                            {
                                "target_lang_word": "一致",
                                "target_lang_sense_clarification": "指在意见或行为上没有分歧。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}