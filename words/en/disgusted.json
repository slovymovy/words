{
    "word_family": [
        "disgust",
        "disgusting",
        "disgustingly",
        "disgustfulness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "83bc6986-61ae-39ef-9e27-1c48c50875a9",
                    "sense_definition": "Feeling or showing strong aversion, distaste, or repulsion towards something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sight of the squirming mass of maggots left me completely <w>disgusted</w>. \n",
                            "target_lang_translations": {
                                "ru": "Вид извивающейся массы личинок вызвал у меня полное <w>отвращение</w>."
                            }
                        },
                        {
                            "text": "I was <w>disgusted</w> by her behaviour and walked out of the room immediately.",
                            "target_lang_translations": {
                                "ru": "Я был <w>возмущен</w> ее проведением и сразу же вышел из комнаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "repulsed",
                        "revolted",
                        "sickened"
                    ],
                    "antonyms": [
                        "delighted",
                        "pleased"
                    ],
                    "common_phrases": [
                        "disgusted by her behaviour",
                        "look disgusted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий или выражающий сильное отвращение, неприязнь или брезгливость к чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувствующий отвращение",
                                "target_lang_sense_clarification": "испытывающий брезгливость или неприязнь"
                            },
                            {
                                "target_lang_word": "возмущенный",
                                "target_lang_sense_clarification": "испытывающий сильное неприятие чьего-то поведения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "209024ae-38f0-39cf-992d-1e0805d59c74",
                    "sense_definition": "Simple past tense and past participle of <w>disgust</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The terrible smell <w>disgusted</w> everyone who entered the old building.",
                            "target_lang_translations": {
                                "ru": "Ужасный запах <w>вызвал отвращение</w> у всех, кто входил в старое здание."
                            }
                        },
                        {
                            "text": "His dishonest behavior thoroughly <w>disgusted</w> at least a few of his close friends.",
                            "target_lang_translations": {
                                "ru": "Его нечестное поведение глубоко <w>возмутило</w> как минимум нескольких его близких друзей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола disgust (вызывать отвращение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызвал отвращение",
                                "target_lang_sense_clarification": "о качестве, запахе или поступке"
                            },
                            {
                                "target_lang_word": "вызвал возмущение",
                                "target_lang_sense_clarification": "о поведении или поступках"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}