                                    {
                                        "sense_id": "a4878ce1-c984-3ab0-8d06-41c3ac263651",
                                        "entry_id": "d02d22e5-4569-3e62-812c-fbec6f0349d6",
                                        "glosses": [
                                            "To make or become indistinguishable."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01e6cf4d-39ad-47ad-aeb6-37945b111bf6",
                                                "sense_id": "a4878ce1-c984-3ab0-8d06-41c3ac263651",
                                                "text": "When the signal frequency reaches half the sampling frequency, there are only two samples per cycle, which is the absolute minimum needed to record a waveform. A higher frequency would cause the digitization system to alias."
                                            },
                                            {
                                                "example_id": "b8479a5b-40f5-4a3e-9045-da53943b259b",
                                                "sense_id": "a4878ce1-c984-3ab0-8d06-41c3ac263651",
                                                "text": "Finally, as it is a frequency detection technique, color Doppler US has the potential to alias"
                                            },
                                            {
                                                "example_id": "fad1911b-b88c-4c48-b1bf-07a565fd3302",
                                                "sense_id": "a4878ce1-c984-3ab0-8d06-41c3ac263651",
                                                "text": "This technique can be used to alias the L1 and L2 bands of the GPS into the baseband"
                                            }
