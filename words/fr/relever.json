                },
                {
                    "sense_id": "516c8bc7-723a-3c24-8305-2bea09b5d6c5",
                    "sense_definition": "Donner un goût plus prononcé, piquant ou savoureux à un mets au moyen d'épices ou d'aromates.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
