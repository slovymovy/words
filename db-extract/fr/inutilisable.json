        "fr-extract.jsonl": [
            {
                "entry_id": "bbe02a22-4653-38dc-b14b-818640859e4d",
                "word": "inutilisable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c00d09b3-7368-4549-a4bf-e1e1eacd156f",
                        "entry_id": "bbe02a22-4653-38dc-b14b-818640859e4d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "inutilisables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "868f7d34-5182-3fe8-abc1-12c1c437b764",
                        "entry_id": "bbe02a22-4653-38dc-b14b-818640859e4d",
                        "glosses": [
                            "Qui ne peut être utilisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ff472c-8ef8-46f3-b5fe-0838aeffcdfc",
                                "sense_id": "868f7d34-5182-3fe8-abc1-12c1c437b764",
                                "text": "… nous serions certainement amenés à jeter par-dessus bord le concept général d’« ethnie » parce que c’est un terme fourre-tout inutilisable pour une recherche véritablement exacte."
                            },
                            {
                                "example_id": "2076e5f0-bc70-466b-9232-42c46c8a4a95",
                                "sense_id": "868f7d34-5182-3fe8-abc1-12c1c437b764",
                                "text": "Que donc le ravitaillement en essence soit coupé ou qu’un saboteur ait fourré un morceau de sucre dans le réservoir, et on se trouve devant un tas de ferraille inutilisable."
                            },
                            {
                                "example_id": "b7a0d806-295e-486c-840c-1fcb6d005746",
                                "sense_id": "868f7d34-5182-3fe8-abc1-12c1c437b764",
                                "text": "À peine remis sur pied, Poulidor constate que le vélo de rechange est maintenant inutilisable et qu’il doit donc reprendre sa monture d’origine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f9a486e-78dd-4e6f-8eac-fdec29bfcedc",
                        "source_entry_id": "bbe02a22-4653-38dc-b14b-818640859e4d",
                        "source_sense_id": "868f7d34-5182-3fe8-abc1-12c1c437b764",
                        "target_lang_word": "unbenutzbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbenutzbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa48d23-71e1-3b2d-9e5e-55d4a8819771",
                                        "entry_id": "7def92a4-dc95-3ac9-9985-6a3b62ca6571",
                                        "glosses": [
                                            "nicht benutzbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed2d2e87-b1e3-4e53-a71b-79df220c6f3e",
                                                "sense_id": "8aa48d23-71e1-3b2d-9e5e-55d4a8819771",
                                                "text": "„Der Bürgersteig ist auffallend schmal, man ist mit dem Boden ebenso geizig als verschwenderisch mit dem Luftraum. Dazu liegt an der Häuserkante das Eis so dicht, daß ein Teil von dem Trottoir unbenutzbar bleibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89d37bba-405f-4d2b-bb87-71c1ff727520",
                        "source_entry_id": "bbe02a22-4653-38dc-b14b-818640859e4d",
                        "source_sense_id": "868f7d34-5182-3fe8-abc1-12c1c437b764",
                        "target_lang_word": "unusable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unusable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8be17767-1319-3640-848c-717809cd011e",
                                        "entry_id": "a0de4d94-15fc-31a6-82cb-25b5af640505",
                                        "glosses": [
                                            "Not usable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e27f02c6-3677-439a-ba75-380c851d9965",
                                                "sense_id": "8be17767-1319-3640-848c-717809cd011e",
                                                "text": "The toilet was unusable because it was blocked."
                                            },
                                            {
                                                "example_id": "20ec650e-df93-4cfb-ae89-e983f7055882",
                                                "sense_id": "8be17767-1319-3640-848c-717809cd011e",
                                                "text": "From that night until mid-morning on Sunday, November 6, the station was unusable by any electric trains and the Brighton-Eastbourne service was maintained by steam traction, assisted by two Hastings six-car diesel muliple-units—[...]."
                                            },
                                            {
                                                "example_id": "6cce8a57-afae-4641-be63-27730dd1c28b",
                                                "sense_id": "8be17767-1319-3640-848c-717809cd011e",
                                                "text": "This service has suffered badly from Department for Transport-inspired cuts which reduced it from hourly to two-hourly. This, coupled with regular cancellations, has rendered the train service between the area's two biggest towns almost unusable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unusable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7de78b09-faf7-3b10-9ca0-1add6aff9d5c",
                                        "entry_id": "410869fc-bff7-3d82-b673-d1486920c0b6",
                                        "glosses": [
                                            "Something that is not fit for use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723d1399-9c41-49a2-af17-82946a19a09b",
                                                "sense_id": "7de78b09-faf7-3b10-9ca0-1add6aff9d5c",
                                                "text": "All the fat, skin, bones and unusables from the slaughter house went to the soap factory, and got diverted to feed a company of soldiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "201b179a-28d3-4278-a1fd-b3c5553317e0",
                        "source_entry_id": "bbe02a22-4653-38dc-b14b-818640859e4d",
                        "source_sense_id": "868f7d34-5182-3fe8-abc1-12c1c437b764",
                        "target_lang_word": "useless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "useless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Without use or possibility to be used."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d175fa6f-2a60-45fc-a2e8-111de79cbdaa",
                                                "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                                "text": "This fork's prongs are bent. It's useless now."
                                            },
                                            {
                                                "example_id": "a4286ea4-9aa2-4365-8c8a-bc30181c9c71",
                                                "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                                "text": "I'm all for opening new stations (Transport Scotland is planning another at East Linton, about halfway between Drem and Dunbar), but they are useless without a decent service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Unhelpful, not useful; pointless (of an action)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f20054cb-dfff-4314-a444-ed39adc34f8c",
                                                "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                                "text": "I think it's useless to keep this discussion going. It's like talking to a brick wall."
                                            },
                                            {
                                                "example_id": "4c91d144-b3f0-4d4b-9751-fd698afdb7c4",
                                                "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                                "text": "I tried my best to make him quit smoking, but my efforts were useless. He now smokes six packs a day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45a58518-0798-312f-9a82-5601ff931b9c",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Good-for-nothing; not dependable."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e7ffd5-78c9-4edf-8e3d-b659f4630d37",
                                                "sense_id": "45a58518-0798-312f-9a82-5601ff931b9c",
                                                "text": "Bill never mows the lawn, takes out the trash or anything. He's useless, but I love him anyways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Unable to do well at a particular task or thing. Useless is mildly insulting."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd42613c-721a-4d51-8927-6d02a9d9ff19",
                                                "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                                "text": "My brother is useless at most computer games, but he is an awesome PS2 player."
                                            },
                                            {
                                                "example_id": "4c07a921-0837-4a35-adbf-28318b15deba",
                                                "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                                "text": "Why do you keep trying? You're obviously useless at it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
