                                "target_senses": [
                                    {
                                        "sense_id": "c5b51245-bea5-3c13-8aa4-f252702a1cf3",
                                        "entry_id": "e9bd395e-7c66-3f63-ad9d-bf41b68d7dfa",
                                        "glosses": [
                                            "Qui multiplie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afdf1868-6106-4823-92ea-a27f6d28a394",
                                                "sense_id": "c5b51245-bea5-3c13-8aa4-f252702a1cf3",
                                                "text": "Dans le cas du « modèle multiplicatif », les amplitudes de variation d’une période (année, mois ou trimestre) ont des conséquences sur les amplitudes de variation des périodes qui suivent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88fc0b67-83e5-3187-9170-652064c4cbbf",
                                        "entry_id": "e9bd395e-7c66-3f63-ad9d-bf41b68d7dfa",
                                        "glosses": [
                                            "Relatif à la multiplication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e16ef9f-bbd6-45d0-80e5-bbcdaec9a56e",
                                                "sense_id": "88fc0b67-83e5-3187-9170-652064c4cbbf",
                                                "text": "Il s’ensuit que le groupe multiplicatif des éléments inversibles de KK s’identifie (avec sa topologie) au groupe — (Roger Godement, Introduction à la théorie des groupes de Lie, Springer Science & Business Media, 2003, page 32)"
                                            },
                                            {
                                                "example_id": "8354fe33-5b8d-4584-bdec-48034e7bf5fb",
                                                "sense_id": "88fc0b67-83e5-3187-9170-652064c4cbbf",
                                                "text": "Dans tout anneau, les éléments réversibles (pour la multiplication) forment un groupe multiplicatif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
