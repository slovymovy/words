                                        "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                        "entry_id": "97a9ed98-cef2-35b9-aa28-5fb85d3195c0",
                                        "glosses": [
                                            "das Erkennen und Verstehen eines Sachverhaltes, das zielgerichtetes Verhalten ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bc0f2a3-9b86-44c4-ae69-03afb68f4c33",
                                                "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                                "text": "Durch Einsicht können Menschen lernen, vieles besser zu verstehen."
                                            },
                                            {
                                                "example_id": "bbf3b809-a17b-40d4-ae49-ca0b03633680",
                                                "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                                "text": "„Trotz der Einsicht der Juristen in die Verbesserungswürdigkeit von Gesetzestexten sei noch viel zu tun.“"
                                            },
                                            {
                                                "example_id": "a361b07a-a780-4518-832d-56914e6700e6",
                                                "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                                "text": "„Aus Einsicht kann Wissenschaft Heilung schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                        "entry_id": "97a9ed98-cef2-35b9-aa28-5fb85d3195c0",
                                        "glosses": [
                                            "Möglichkeit, etwas Konkretes mit den Augen zu sehen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb17377f-712a-42ab-bef0-b9bd8b4d950d",
                                                "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                                "text": "Auf Anfrage erhielten Sie Einsicht in die Akten."
                                            },
                                            {
                                                "example_id": "a0701a4b-c7e4-42fc-9d95-a4656b38c4c8",
                                                "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                                "text": "Der Kapitän hatte bereits Einsicht in die Hafeneinfahrt, als er den Lotsen an Bord nahm."
                                            },
                                            {
                                                "example_id": "e1f11fea-e414-42b2-aa61-704867e28a1d",
                                                "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                                "text": "„Kluge Kapitalanleger lassen sich nicht nur bisherige Mietverträge zur Prüfung aushändigen, sondern lassen sich auch den regelmäßigen Mieteingang bescheinigen, indem sie z.B. Einsicht in die Kontoauszüge des Vorbesitzers bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
