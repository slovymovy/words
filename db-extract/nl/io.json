                                        "glosses": [
                                            "A moon of Jupiter, known for its volcanic activity, peppered with about 400 active volcanoes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe33f085-58dd-4e69-b14a-c65a68f727ff",
                                                "sense_id": "df6a5683-8167-3eb9-88d9-3e68f139e52f",
                                                "text": "Another whisper, sir, near Io. We have probes en route."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94af2cec-d284-35a8-81d6-fd0561a39719",
