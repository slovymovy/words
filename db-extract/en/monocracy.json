                                "example_id": "e0568def-40a0-4300-b3dc-6b3ce4015e6c",
                                "sense_id": "d297accd-3302-3e96-ad24-875e4232febb",
                                "text": "The question here arises: Shall it be transferred to one or to many; or shall the state, in regard to the persons who constitute its government, be a monocracy or an aristocracy?"
                            },
                            {
                                "example_id": "99059b16-360e-428a-a2d4-afbf23eff99c",
                                "sense_id": "d297accd-3302-3e96-ad24-875e4232febb",
                                "text": "A monocracy, as traditionalists called it, also seemed dangerous."
                            },
                            {
                                "example_id": "71255a05-8ef0-415d-942c-e1fc36a4ff36",
                                "sense_id": "d297accd-3302-3e96-ad24-875e4232febb",
                                "text": "In monocracies, the extent of closure is still greater."
                            }
                        ]
                    }
