                        "target_lang_word": "subsidy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subsidy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c9509c1-aa82-3758-aa71-5d2507f9eb44",
                                        "entry_id": "c6c64fcc-512c-38de-bf96-9e60bf6bb3e7",
                                        "glosses": [
                                            "Financial support or assistance, such as a grant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54963a44-2909-41a2-a086-0ecfdba03d79",
                                                "sense_id": "6c9509c1-aa82-3758-aa71-5d2507f9eb44",
                                                "text": "Manufacturing firms are supported by government subsidies in some countries."
                                            },
                                            {
                                                "example_id": "fbeb67b3-9e79-424f-ade2-80a627d17cb8",
                                                "sense_id": "6c9509c1-aa82-3758-aa71-5d2507f9eb44",
                                                "text": "British journalists shun complete respectability, feeling a duty to be ready to savage the mighty, or rummage through their bins. Elsewhere in Europe, government contracts and subsidies ensure that press barons will only defy the mighty so far."
                                            },
                                            {
                                                "example_id": "91473007-fa41-465a-9128-cf0a4a22f63e",
                                                "sense_id": "6c9509c1-aa82-3758-aa71-5d2507f9eb44",
                                                "text": "You don't have to be Einstein to work out that this level of government subsidy is unsustainable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b1bd342-53c9-32f0-bb4a-1828b58e9488",
                                        "entry_id": "c6c64fcc-512c-38de-bf96-9e60bf6bb3e7",
                                        "glosses": [
                                            "Money granted by parliament to the British Crown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a25caa77-e4ec-41d5-9eed-4eba5b72f208",
                        "source_entry_id": "60288dc6-2f1d-3469-be90-b026760cbabf",
                        "source_sense_id": "7cbc668b-20eb-3619-ba21-3d5c07779434",
                        "target_lang_word": "subvention",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subvention",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a17b110e-ed4a-3072-8302-134953b845bb",
                                        "entry_id": "03f3538e-b8ba-3652-9e84-d5ce398018e9",
                                        "glosses": [
                                            "Secours d’argent, subside exigé ou accordé pour subvenir dans un cas pressant à une dépense imprévue de l’État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4f165bb-2bbb-45e5-93fd-a910074e9ee7",
                                                "sense_id": "a17b110e-ed4a-3072-8302-134953b845bb",
                                                "text": "Subvention de guerre."
                                            },
                                            {
                                                "example_id": "c911f2cb-82c2-4280-a878-581ae532030c",
                                                "sense_id": "a17b110e-ed4a-3072-8302-134953b845bb",
                                                "text": "La subvention demandée à cette province fut accordée sur-le-champ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d93f6d30-da90-3280-b857-8e2047124b63",
                                        "entry_id": "03f3538e-b8ba-3652-9e84-d5ce398018e9",
                                        "glosses": [
                                            "Fonds que l’État, une société ou un mécène accorde à une entreprise pour la soutenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b43df35-bc3a-4b59-83de-45857280ffed",
                                                "sense_id": "d93f6d30-da90-3280-b857-8e2047124b63",
                                                "text": "La Caisse des Recherches scientifiques m'a honoré d'une subvention qui m'a permis, grâce à l'obligeant concours de M. SYLVESTRE, d'illustrer le présent travail."
                                            },
                                            {
                                                "example_id": "68865f89-6e78-4fc4-9b02-306cd8fb211d",
                                                "sense_id": "d93f6d30-da90-3280-b857-8e2047124b63",
                                                "text": "Il lut à très haute voix : « Je ne puis qu’approuver, monsieur, le titre de votre futur journal et je souhaite longue vie à L’indépendant. L’indépendance est l’affranchissement vis-à-vis des autres, c’est-à-dire la vraie liberté, liberté qu’une subvention du ministère de l’intérieur risquerait de compromettre… mmm… mmm… »\n— Le reste est sans importance, grommela M. de Rocheflamme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
