                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "versieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Verschillende medailles <w>tooiden</w> de borst van de oude generaal.",
                            "target_lang_translations": {
