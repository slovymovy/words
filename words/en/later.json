    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "71d057ca-a51b-3e18-9351-da624f6df269",
                    "sense_definition": "At some unspecified time in the future.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "future_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am busy right now, but I will call you <w>later</w>.",
                            "target_lang_translations": {
                                "ru": "Я сейчас занят, но позвоню тебе <w>позже</w>.",
                                "es": "Estoy ocupado ahora mismo, pero te llamaré <w>más tarde</w>.",
                                "zh": "我现在很忙，但<w>以后</w>会给你打电话。"
                            }
                        },
                        {
                            "text": "We can discuss the details of the project <w>later</w>.",
                            "target_lang_translations": {
                                "ru": "Мы можем обсудить детали проекта <w>потом</w>.",
                                "es": "Podemos discutir los detalles del proyecto <w>luego</w>.",
                                "zh": "我们可以<w>待会儿</w>再讨论项目的细节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "later on"
                    ],
                    "antonyms": [
                        "earlier"
                    ],
                    "common_phrases": [
                        "see you later",
                        "sooner or later",
                        "for later",
                        "catch you later"
                    ],
                    "target_lang_definitions": {
                        "ru": "В какое-то неопределенное время в будущем.",
                        "es": "En algún momento indeterminado del futuro.",
                        "zh": "在未来的某个不确定的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́зже",
                                "target_lang_sense_clarification": "в более позднее время"
                            },
                            {
                                "target_lang_word": "пото́м",
                                "target_lang_sense_clarification": "спустя время, не сейчас"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "más tarde",
                                "target_lang_sense_clarification": "en un momento posterior"
                            },
