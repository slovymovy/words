                ],
                "senses": [
                    {
                        "sense_id": "d1450d6d-9420-36ce-b364-d62bef6f488c",
                        "entry_id": "7a6d92b6-6e2b-38e7-89af-5070d7db68d4",
                        "glosses": [
                            "Wunsch, dessen Erfüllung sich jemand selbst oder seinen Mitmenschen für das neue Jahr wünscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "313e53cb-29a7-444a-8842-d2efc4a04f4e",
                                "sense_id": "d1450d6d-9420-36ce-b364-d62bef6f488c",
                                "text": "„Aus dem Namen Rosch Haschana für das Neujahrsfest ist im Laufe der Zeit aus dem jüdischen Neujahrsglückwunsch ‚guten Rosch‘ die heutige Floskel ‚guten Rutsch‘ geworden.“"
                            },
                            {
                                "example_id": "5a5b6c50-9954-4528-98b8-7a0ec029ebf6",
                                "sense_id": "d1450d6d-9420-36ce-b364-d62bef6f488c",
                                "text": "„Dann sprach der Meister den Neujahrsglückwunsch und endlich wurde die Tanzfläche zum fröhlichen Tanz freigegeben.“"
                            },
                            {
                                "example_id": "092abe65-c3a1-4f23-89ac-e2c609f55d37",
                                "sense_id": "d1450d6d-9420-36ce-b364-d62bef6f488c",
                                "text": "„Jack wollte die Lehrerin bitten, einen Neujahrsglückwunsch zu wählen, den sie dann in der Klasse schreiben würden.“"
                            },
                            {
                                "example_id": "50e0a484-713e-4423-b9d7-48b00d3bbb4a",
                                "sense_id": "d1450d6d-9420-36ce-b364-d62bef6f488c",
                                "text": "„Während seines Aufenthalts in Frankfurt im September und Oktober 1814 wohnte Goethe in ihrem Hause; am Schlusse des Jahres verbindet er seinen Dank mit dem Neujahrsglückwunsch.“"
                            },
                            {
                                "example_id": "950a80ed-1503-4d2d-9da3-b28fe45bd97c",
                                "sense_id": "d1450d6d-9420-36ce-b364-d62bef6f488c",
                                "text": "„Und so ist noch jeder Neujahrsglückwunsch ein – oft unerkannter – Segenswunsch und ein Akt des Segnens.“"
                            },
                            {
                                "example_id": "371f9c1b-0426-413e-a0af-1b644946c246",
                                "sense_id": "d1450d6d-9420-36ce-b364-d62bef6f488c",
                                "text": "„Ich danke auch Mon Coeur ergebenst für ihren allerhuldvollsten Neujahrsglückwunsch.“"
                            },
                            {
                                "example_id": "ef095bb5-76b4-45a3-bf88-e6a4c38f0f38",
                                "sense_id": "d1450d6d-9420-36ce-b364-d62bef6f488c",
                                "text": "„In dem ‚Neujahrsglückwunsch‘ an den König giebt er seiner Freude und seinem Danke breiten Ausdruck: ‚Was ich bin und was ich habe, verdanke ich allein dem Könige, meinem Herrn!‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
