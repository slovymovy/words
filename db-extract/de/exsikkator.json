                        "entry_id": "650d181b-8943-3e31-843d-3dbe1e3884cc",
                        "glosses": [
                            "Trocknungsgerät, das aus Glasgefäß mit Deckel und Belüftungshahn besteht, in dem im unteren Teil ein Trockenmedium, z.B. Blaugel, Gelbgel, enthalten ist, darüber befindet sich eine gelöcherte Scheibe aus Porzellan, auf der das Trockengut gelagert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c441772f-2f6e-4a02-8046-918a2f9e7212",
                                "sense_id": "acdffe2d-d1b2-3a72-86a8-42c6b5b89fef",
                                "text": "„Das sattgelbe Reaktionsprodukt wurde im Wasserbad und dann im Exsikkator getrocknet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
