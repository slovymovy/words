                            "prepositional"
                        ],
                        "form": "томи́тельных"
                    },
                    {
                        "form_id": "b6c35359-b2f7-4670-8680-cacb117d5324",
                        "entry_id": "6ed9174f-8d1f-31c9-881c-42fe339dd267",
                        "tags": [
                            "singular",
                            "masculine",
                            "short-form"
                        ],
                        "form": "томи́телен"
                    },
                    {
                        "form_id": "4c3399d1-d295-40f2-b84b-87705d85f33f",
                        "entry_id": "6ed9174f-8d1f-31c9-881c-42fe339dd267",
                        "tags": [
                            "singular",
                            "neuter",
                            "short-form"
                        ],
                        "form": "томи́тельно"
                    },
                    {
                        "form_id": "a38c95a4-150e-4fa9-9d36-c5d175d91591",
                        "entry_id": "6ed9174f-8d1f-31c9-881c-42fe339dd267",
                        "tags": [
                            "singular",
                            "feminine",
                            "short-form"
                        ],
                        "form": "томи́тельна"
                    },
                    {
                        "form_id": "b75eae4e-1a24-462a-b99b-b50ce58fcb0d",
                        "entry_id": "6ed9174f-8d1f-31c9-881c-42fe339dd267",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "томи́тельны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87faae3f-98e3-327f-a343-25a6ded1ad07",
                        "entry_id": "6ed9174f-8d1f-31c9-881c-42fe339dd267",
                        "glosses": [
                            "заставляющий томиться, страдать, причиняющий физические страдания; изнуряющий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7cb83d5-f595-4992-9a16-ebc859d0a11a",
                                "sense_id": "87faae3f-98e3-327f-a343-25a6ded1ad07",
                                "text": "День был жаркий, томительный; мы были измучены совершенно и даже в отчаянии от сих наглецов."
                            },
                            {
                                "example_id": "46daebbb-b1bb-4e15-b6a7-8cb8b05e7d7c",
                                "sense_id": "87faae3f-98e3-327f-a343-25a6ded1ad07",
                                "text": "И, махнув своей маленькой рукой, Потаня снова закашлялась тем томительным кашлем, который готов был на части разорвать её сухую, узенькую грудь."
                            },
                            {
                                "example_id": "4d4decda-58d5-4a59-82de-68746817a63a",
                                "sense_id": "87faae3f-98e3-327f-a343-25a6ded1ad07",
                                "text": "Горные хребты, томительные перевалы, однообразный путь, ночлеги, каких никогда не представляло воображение, длинная цепь верблюдов, непонятная и неодолимая сонливость при лёгком, здоровом дыхании, спуск, подъём и опять ― спуск, подъём, <...>"
                            }
                        ]
                    },
                    {
                        "sense_id": "fe4f3bc9-6d01-3a88-a442-18749a27357d",
                        "entry_id": "6ed9174f-8d1f-31c9-881c-42fe339dd267",
                        "glosses": [
                            "тягостный, гнетущий, причиняющий нравственные страдания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "380dc117-7f98-4339-8ce5-9bc28d07b2a8",
                                "sense_id": "fe4f3bc9-6d01-3a88-a442-18749a27357d",
                                "text": "Он снова покорился, затаив в душе горькое чувство обиды и томительную гражданскую скорбь."
                            },
                            {
                                "example_id": "79f209df-3837-47c7-9b0f-f67787cdf95b",
                                "sense_id": "fe4f3bc9-6d01-3a88-a442-18749a27357d",
                                "text": "Не страшно, не тоскливо, ― а скучно огромной, тягучей, томительной скукой, от которой хочется куда-то уйти, лечь, закрыть крепко глаза."
                            },
                            {
                                "example_id": "d7a14430-32a7-4c6b-9563-f212de467171",
                                "sense_id": "fe4f3bc9-6d01-3a88-a442-18749a27357d",
                                "text": "С той самой минуты, как Шахов переступил порог этой комнаты, он почувствовал томительную неловкость, подобную той, которую испытывал он иногда на любительских спектаклях, следя за плохой игрой знакомых актёров, когда эти знакомые актёры сами не сознавали, как плохо они играют."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f2cd8d0-0077-3116-b798-d9f35a7c1728",
                        "entry_id": "6ed9174f-8d1f-31c9-881c-42fe339dd267",
                        "glosses": [
                            "кажущийся бесконечно долгим из-за неприятных, тягостных ощущений, переживаний"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0750938-9691-4214-81f5-e005b3cc8859",
                                "sense_id": "9f2cd8d0-0077-3116-b798-d9f35a7c1728",
                                "text": "Хозяева, с своей стороны, вероятно также по сочувствию, были как-то особенно неразговорчивы, и вследствие того между собеседниками длилось томительное молчание, в продолжение которого Порфирий Петрович в десятый раз отбарабанил пальцами по ручке дивана любимую свою песню о чижике."
                            },
                            {
                                "example_id": "83582335-1bef-4dc5-887e-d1a194e5ab10",
                                "sense_id": "9f2cd8d0-0077-3116-b798-d9f35a7c1728",
                                "text": "Остаток дня прошёл в томительном ожидании, только грек не скрывал своей радости: у него не только завтракали, у него и обедали."
                            }
                        ]
                    },
                    {
                        "sense_id": "e24ddef4-01ea-3ce4-9d56-15a67121badf",
                        "entry_id": "6ed9174f-8d1f-31c9-881c-42fe339dd267",
                        "glosses": [
                            "вызывающий истому, чувство приятной расслабленности, приятного изнеможения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5526a2d2-7ff0-43ad-b113-c09ee0971436",
                                "sense_id": "e24ddef4-01ea-3ce4-9d56-15a67121badf",
                                "text": "Фет удивительно передает свежесть и томительное обаяние весенних ощущений, то чувство духовного опьянения, которое весною струится во всей природе и бессознательно охватывает нас:"
                            },
                            {
                                "example_id": "c2a0b804-a5a9-4cc6-9b63-c04c93ee9906",
                                "sense_id": "e24ddef4-01ea-3ce4-9d56-15a67121badf",
                                "text": "Томительная сторона желания есть в свою очередь источник страсти, выражающейся лишь отлично от наслаждения."
                            },
                            {
                                "example_id": "81a4d4b2-ebfc-4a9a-a30a-6946e8ea4b40",
                                "sense_id": "e24ddef4-01ea-3ce4-9d56-15a67121badf",
                                "text": "А потом ― и опять Шопен, и опять слезы, томительные, сладкие слезы…"
                            },
                            {
                                "example_id": "c7c1812d-dd53-4af9-bd36-d79b71d9ecab",
                                "sense_id": "e24ddef4-01ea-3ce4-9d56-15a67121badf",
                                "text": "Я глядел, ― поезд, становясь все меньше, все короче, черточкой пропадал на исчезавшем за далеким поворотом полотне, и только рельсы дружно парой бежали бесконечно. Сладко томительная грусть сжимала сердце. Высшим счастьем для меня было бы уноситься с этим поездом."
                            },
                            {
                                "example_id": "a680ca33-3ccc-4280-ba55-53353abc04d4",
                                "sense_id": "e24ddef4-01ea-3ce4-9d56-15a67121badf",
                                "text": "Тень кончилась, блеснул свет; прямо из сверкающих груд темной листвы забелели осыпанные душистым снегом апельсинные и персиковые деревья; глухой, томительный аромат их наполнял лёгкие сладким оцепенением."
                            }
                        ]
                    }
                ],
