    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "61e94cd6-4a64-3120-8c9d-216dfeeb8d39",
                "word": "Guilin",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f93f3c56-300c-3ca2-b775-9a5b167a17be",
                        "entry_id": "61e94cd6-4a64-3120-8c9d-216dfeeb8d39",
                        "glosses": [
                            "A city in the Guangxi autonomous region, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa0c7c9-93c1-456c-bab8-4a28e8ff34d4",
                                "sense_id": "f93f3c56-300c-3ca2-b775-9a5b167a17be",
                                "text": "In early May, advance elements of Li Zong-ren’s Seventh Army of the Northern Expeditionary Force advanced from Guilin, securing Tang’s flanks and boosting his soldiers’ morale."
                            },
                            {
                                "example_id": "05e91c17-b198-401f-8726-092f80b2c319",
                                "sense_id": "f93f3c56-300c-3ca2-b775-9a5b167a17be",
                                "text": "In 1945, Tom was sent into remote Kueilin, Kwangsi Province where primitive conditions necessitated bathing in a small round bamboo tub just big enough to hold him."
                            },
                            {
                                "example_id": "6238a26b-1986-4292-b3e2-76e44252fd04",
                                "sense_id": "f93f3c56-300c-3ca2-b775-9a5b167a17be",
                                "text": "Before going home, we flew to Guilin for a meeting with environmentalists concerned about the destruction of forests and the loss of unique wildlife, and a leisurely boat trip down the Li River, which flows through a stunning landscape marked by large limestone formations that looked as if they had burst up through the landscape of the gentle countryside. After Guilin, we made a stop in Hong Kong to see Tung Chee-hwa, the chief executive chosen by the Chinese after the British left."
                            },
                            {
                                "example_id": "2c98df4b-e0da-42ea-aef6-cba76843d55d",
                                "sense_id": "f93f3c56-300c-3ca2-b775-9a5b167a17be",
                                "text": "The West River was formed by the confluence of two rivers: the Hsun, which led further west to Kuanghsi’s new provincial capital of Nanning, and the Lichiang (or Kueichiang), which led north to the province’s old capital of Kueilin. Summer rains lifted the level of both rivers by as much as twenty meters, and summer was the only time of the year that Kueilin could be reached by boat.",
                                "translation": "梧州",
                                "english": "梧州"
                            }
                        ]
                    }
                ],
