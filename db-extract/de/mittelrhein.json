                    {
                        "form_id": "3a152982-2a97-4012-83a6-28ffc6279e57",
                        "entry_id": "d7030417-b3b0-3d95-a610-4791d44dbd63",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Mittelrhein"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99355aca-a0f5-368d-9060-2e9ae79fc76c",
                        "entry_id": "d7030417-b3b0-3d95-a610-4791d44dbd63",
                        "glosses": [
                            "der Abschnitt des Rheins von Bingen bis Bonn (Rheinkilometer 530-660)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "024a0e68-d36e-45bb-a656-f2ea45a57ffe",
                                "sense_id": "99355aca-a0f5-368d-9060-2e9ae79fc76c",
                                "text": "Ich bin ein Kind vom Mittelrhein."
                            },
                            {
                                "example_id": "8b3c3110-5e19-43c7-a982-f5db3eb748bc",
                                "sense_id": "99355aca-a0f5-368d-9060-2e9ae79fc76c",
                                "text": "Die Loreley ist ein steil aufragender Felsen am Mittelrhein."
                            },
                            {
                                "example_id": "edb51c88-c1d3-4740-980a-b59cf064ceda",
                                "sense_id": "99355aca-a0f5-368d-9060-2e9ae79fc76c",
                                "text": "„Noch schwieriger waren die Verhältnisse bei der Weiterfahrt auf dem schnell strömenden Mittelrhein; nach Mainz brauchte man wiederum Wochen und manchmal sogar Monate.“"
                            },
                            {
                                "example_id": "cd6f06bc-0442-4e4f-ade0-281f06249d73",
                                "sense_id": "99355aca-a0f5-368d-9060-2e9ae79fc76c",
                                "text": "„In vielen Ländern der Erde bestimmen der Mittelrhein und die Rheinromantik das Bild und die Vorstellung der Menschen von Deutschland.“"
                            },
                            {
                                "example_id": "7e50c014-4b75-43cb-add1-6087c7a6ce18",
                                "sense_id": "99355aca-a0f5-368d-9060-2e9ae79fc76c",
                                "text": "„Vom 29. August bis zum 1. November 1840 ist er mit seiner Geliebten Juliette am Mittelrhein und in Süddeutschland unterwegs.“"
                            },
                            {
                                "example_id": "b09789c3-3973-418d-b2d2-5532c87a04de",
                                "sense_id": "99355aca-a0f5-368d-9060-2e9ae79fc76c",
                                "text": "„Am Mittelrhein liegt das malerische Oberwesel, das wohl auf dem Gebiet eines längst verschwundenen Oppidums stand, von dem der Name Vosavia belegt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
