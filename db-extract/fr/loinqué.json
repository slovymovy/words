                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "40dc6b45-35e3-48f9-a564-d4915539e6a2",
                                "sense_id": "5294b829-2fae-3871-b2ae-81c4c6fd7a2e",
                                "text": "Catherine alla dans le loinqué et prit une rouille de blanco qu’elle déboucha."
                            },
                            {
                                "example_id": "eaaca00e-9173-498a-b214-0303e8ccd556",
                                "sense_id": "5294b829-2fae-3871-b2ae-81c4c6fd7a2e",
                                "text": "Dans un loinqué, des marins vidaient des rouilles et faisaient leurs adieux à des jolies limandes tout en leur flattant l’écureuil."
                            }
                        ]
                    },
                    {
                        "sense_id": "59700fd7-6e37-31e5-a469-67ad59924bb1",
                        "entry_id": "0d5bde40-39f7-39d8-b724-3918b5082cea",
                        "glosses": [
                            "Coin, endroit, quartier."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a0d1e5c6-5629-4517-a6f4-4d2b199dd7ff",
                                "sense_id": "59700fd7-6e37-31e5-a469-67ad59924bb1",
                                "text": "Les charrettes emmenant le trèpe au spectacle animaient seules la chaussée, et sur les trottoirs les piétons s’étaient raréfiés : encore attablés devant l’apéro ou déjà en place pour la jaffe dans les restaurants du loinqué, pour la plupart réputés nourrir finement."
                            },
                            {
                                "example_id": "388fd657-60e3-4477-8a78-0204d9a2737d",
                                "sense_id": "59700fd7-6e37-31e5-a469-67ad59924bb1",
                                "text": "Sans attiger, si tes chocottes\nSont kif-kif avec ta bouillotte,\nTu es le plus giron des mectons du loinqué..."
                            }
                        ]
                    }
