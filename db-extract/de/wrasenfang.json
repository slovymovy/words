                        "examples": [
                            {
                                "example_id": "4cccddc7-774a-4efd-aed7-df7b995d5367",
                                "sense_id": "a0307ae2-0c3d-3ea3-ba23-c4645d587b83",
                                "text": "„Wir bemerken noch, dass über den Apparaten d und e sich ein Wrasenfang befinden könnte.“"
                            },
                            {
                                "example_id": "9a66c048-e135-4fd8-b516-15d028cc3f1b",
                                "sense_id": "a0307ae2-0c3d-3ea3-ba23-c4645d587b83",
                                "text": "„Der Rauchfang über dem Herd dient nur noch als Wrasenfang.“"
                            },
                            {
                                "example_id": "eab92c48-a2ba-4d90-8824-80b038951e55",
                                "sense_id": "a0307ae2-0c3d-3ea3-ba23-c4645d587b83",
                                "text": "„Der Wrasenfang über den Neutralisationsbottichen ist ganz von Holz.“"
                            },
                            {
                                "example_id": "bbcbe92f-9b3a-4688-9e9c-aa97b8e3de70",
                                "sense_id": "a0307ae2-0c3d-3ea3-ba23-c4645d587b83",
                                "text": "„Über dem Herd kann ein Wrasenfang angeordnet werden.“"
                            }
                        ],
