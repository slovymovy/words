                    {
                        "sense_id": "a25cec5a-25c0-389b-a5f7-5ab2552f830d",
                        "entry_id": "ac5478e1-6b5d-37eb-bbaf-0dfd378d9816",
                        "glosses": [
                            "ograniczona bryła geometryczna, której powierzchnia jest złożona wyłącznie z wielokątów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a936c3a1-1bd2-4b14-88f2-f39cec6fce85",
                                "sense_id": "a25cec5a-25c0-389b-a5f7-5ab2552f830d",
                                "text": "Istnieje pięć wielościanów foremnych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0b36b36-cbab-418a-9464-bf1c3f57a140",
                        "source_entry_id": "ac5478e1-6b5d-37eb-bbaf-0dfd378d9816",
                        "source_sense_id": "a25cec5a-25c0-389b-a5f7-5ab2552f830d",
                        "target_lang_word": "polyhedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyhedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8066f4d-61e6-312b-8094-5d6d72ea30d4",
                                        "entry_id": "31ef4db4-cc6c-37dd-846e-1c2c1f8da489",
                                        "glosses": [
                                            "A solid figure with many flat faces and straight edges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ea92d42-fe01-4e8c-9363-faac0c309397",
                                                "sense_id": "c8066f4d-61e6-312b-8094-5d6d72ea30d4",
                                                "text": "Of the convex polyhedra with regular faces, the only ones that have tetrahedral, octahedral, or icosahedral symmetry are the Platonic and Archimedean solids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caf2e3e4-bb2e-37d8-aab3-92df60f90dfa",
                                        "entry_id": "31ef4db4-cc6c-37dd-846e-1c2c1f8da489",
                                        "glosses": [
                                            "A polyscope, or multiplying glass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6dcfe51-c5dd-3aff-8ef1-8128aa4a380b",
                                        "entry_id": "31ef4db4-cc6c-37dd-846e-1c2c1f8da489",
                                        "glosses": [
                                            "A stage in the growth of Hydrodictyon, when the resting spore breaks up into several megazoospores that put out horn-like appendages; these polyhedra break up into zoospores."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cda2ce3-c801-47c6-b141-5546c074d276",
                        "source_entry_id": "ac5478e1-6b5d-37eb-bbaf-0dfd378d9816",
                        "source_sense_id": "a25cec5a-25c0-389b-a5f7-5ab2552f830d",
                        "target_lang_word": "mnohostěn",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "28caa523-5f0f-4bcc-bf56-fda271390dd0",
                        "source_entry_id": "ac5478e1-6b5d-37eb-bbaf-0dfd378d9816",
                        "source_sense_id": "a25cec5a-25c0-389b-a5f7-5ab2552f830d",
                        "target_lang_word": "polyèdre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyèdre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bc803db-1e9b-3278-bf86-1ac811eb6a3e",
                                        "entry_id": "0179e08d-8219-3d5b-9a14-e1c6b0b67b12",
                                        "glosses": [
                                            "Corps solide à plusieurs faces planes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dea1ddfb-8deb-48f5-923b-3be07b79ab1b",
                                                "sense_id": "8bc803db-1e9b-3278-bf86-1ac811eb6a3e",
                                                "text": "En effet, en dehors de l’icosaèdre d'où dérivent les dômes géodésiques, on connaît un grand nombre de polyèdres : platoniques, archimédiens, duals, composites, etc. et il n'y a aucune raison de se restreindre à l'utilisation d'un seul spécimen, […]."
                                            },
                                            {
                                                "example_id": "cf24e0f7-622a-49a4-93f0-f0fb05718ad9",
                                                "sense_id": "8bc803db-1e9b-3278-bf86-1ac811eb6a3e",
                                                "text": "Dans le dépôt qui sentait le café, nous jouions aux cartes sur un tonneau d’épices comme sur un bateau-corsaire ; nous fumions témérairement des pipes en terre ; le jour qui tombait du hublot découpait dans le clair-obscur un grand polyèdre glauque ; sur les caisses blanches, les renseignements en diagonale étaient inscrits en anglais."
                                            },
                                            {
                                                "example_id": "8a8d6bb4-cabb-4460-8eab-612a4774ebd6",
                                                "sense_id": "8bc803db-1e9b-3278-bf86-1ac811eb6a3e",
                                                "text": "Les chimistes organiciens, conscient de l’aspect ludique propre aux synthèses chimiques -[…]- se sont attelés par défi à la création d’hydrocarbures dont le squelette carboné correspond aux polyèdres réguliers que sont les solides platoniques."
                                            },
                                            {
                                                "example_id": "5a37e823-94b9-4c88-b89c-2ec156a55edf",
                                                "sense_id": "8bc803db-1e9b-3278-bf86-1ac811eb6a3e",
                                                "text": "Parmi les diatomées radiolaires, de très nombreuses espèces possèdent une enveloppe adoptant la forme d'un polyèdre platonicien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "925c43b2-33ec-4b54-9298-d4398199ff1f",
                        "source_entry_id": "ac5478e1-6b5d-37eb-bbaf-0dfd378d9816",
                        "source_sense_id": "a25cec5a-25c0-389b-a5f7-5ab2552f830d",
                        "target_lang_word": "poliedro",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poliedro",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "07b59674-d39b-3e3c-8a31-f459f3505677",
                                        "entry_id": "dd6f389c-cf2c-3ce3-b6e5-0c6013cff833",
                                        "glosses": [
                                            "Cuerpo geométrico de tres dimensiones compuesto por un número finito de caras o lados que son polígonos planos, que encierran un volumen finito y no nulo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b09ebd5f-3f8b-4dcf-973d-acacdec39ae8",
                        "source_entry_id": "ac5478e1-6b5d-37eb-bbaf-0dfd378d9816",
                        "source_sense_id": "a25cec5a-25c0-389b-a5f7-5ab2552f830d",
                        "target_lang_word": "Polyeder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polyeder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee5125f1-345e-3029-8d10-2507ea28e374",
                                        "entry_id": "d8d456b9-795e-36ab-92dd-c5b4b9c8ec71",
                                        "glosses": [
                                            "Körper, der von ebenen Flächen (Vielecke, Polygone) begrenzt wird, die nicht alle die gleiche Form haben müssen"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0944d28b-51d7-41e9-9cfe-4886fa8675f5",
                                                "sense_id": "ee5125f1-345e-3029-8d10-2507ea28e374",
                                                "text": "Die konvexen Polyeder, die durch regelmäßige Vielecke begrenzt sind und nicht in eine der vorherigen Kategorien fallen, sind die 92 Johnson-Körper."
                                            },
                                            {
                                                "example_id": "d18cbadf-9892-4676-8be0-df81d0ece997",
                                                "sense_id": "ee5125f1-345e-3029-8d10-2507ea28e374",
                                                "text": "„Wir haben eine Fläche entfernt, den Polyeder an dem entstandenen Loch auseinander gezogen und dann flach gedrückt.“"
                                            },
                                            {
                                                "example_id": "b6e37d63-1a24-4bd8-943b-2d1de3fde7ad",
                                                "sense_id": "ee5125f1-345e-3029-8d10-2507ea28e374",
                                                "text": "„Der Benutzer sieht bei der Flächenauswahl den Polyeder in 3d Ansicht sowie die ausgewählte Fläche in einer Draufsicht.“"
                                            },
                                            {
                                                "example_id": "47d28f79-0857-4077-8c37-a88120608b5e",
                                                "sense_id": "ee5125f1-345e-3029-8d10-2507ea28e374",
                                                "text": "„Eine wichtige Charakteristik von nicht-konvexen Polyedern ist die Existenz von Kanten, die eine Vertiefung (Einkerbung, notch) in den Polyeder bilden.“"
                                            },
                                            {
                                                "example_id": "e7508974-90a2-45ef-ba9a-f3134a45a119",
                                                "sense_id": "ee5125f1-345e-3029-8d10-2507ea28e374",
                                                "text": "„Dann müssen die den Polyeder umschließenden Flächen angegeben werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "938af98b-8d15-4afb-8e1a-8e3c4b7bde47",
                        "source_entry_id": "ac5478e1-6b5d-37eb-bbaf-0dfd378d9816",
