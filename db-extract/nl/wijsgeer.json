                        ],
                        "examples": [
                            {
                                "example_id": "4ec8e584-96a7-4a3f-b88c-65ea712e2fe9",
                                "sense_id": "58dbc25f-da52-37c8-a2aa-2c9fc05c67b1",
                                "text": "De oude Griekse denker Plato was een bekende wijsgeer.",
                                "translation": "The ancient Greek thinker Plato was a well-known philosopher.",
                                "english": "The ancient Greek thinker Plato was a well-known philosopher."
                            },
                            {
                                "example_id": "05f99eb2-d8e0-40c6-87a1-4ad17ef3f5fb",
                                "sense_id": "58dbc25f-da52-37c8-a2aa-2c9fc05c67b1",
                                "text": "Veel beroemde wijsgeren hebben bijgedragen aan de ontwikkeling van de westerse filosofie.",
                                "translation": "Many famous philosophers have contributed to the development of Western philosophy.",
                                "english": "Many famous philosophers have contributed to the development of Western philosophy."
                            }
                        ]
                    }
