                            {
                                "example_id": "7a0afd2e-0c3d-482f-b51a-282c42b3d632",
                                "sense_id": "ddaaa8a4-763d-3972-a119-84529fcc4717",
                                "text": "„In der Zeit vor der Aufklärung stand das Markusevangelium an Bedeutung hinter dem Matthäusevangelium weit zurück, denn 1. Es galt als Werk eines Apostelschülers, nicht eines Apostels; 2. Es erschien gegenüber dem Matthäusevangelium unvollständig und von geringerem sachlichen Gewicht.“"
                            }
                        ],
