                        "examples": [
                            {
                                "example_id": "c590e3ef-1468-46a7-8ffa-1d00f6c11d1b",
                                "sense_id": "bb83f029-c64c-3171-a4fd-457d0c57b4be",
                                "text": "Door blessures bij het Manchester City-duo John Stones en Fabian Delph en Ruben Loftus-Cheek van Chelsea moest Southgate op zoek naar vervangers. Eerder voegde hij al de 24-jarige James Ward-Prowse toe aan zijn selectie. De middenvelder van Southampton heeft één interland achter zijn naam."
                            },
                            {
                                "example_id": "812ebc06-5bc7-4b36-b078-8f52bad5efc8",
                                "sense_id": "bb83f029-c64c-3171-a4fd-457d0c57b4be",
                                "text": "Blesseren,wonden, kwetsen. Blessuur, wonde, kwetsuur."
                            }
                        ]
                    }
