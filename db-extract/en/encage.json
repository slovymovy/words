                "senses": [
                    {
                        "sense_id": "84ae6e05-e63b-3d0f-8657-74626a584473",
                        "entry_id": "cec90166-8800-351d-9487-056b69a25e2f",
                        "glosses": [
                            "To lock inside a cage; to imprison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f353e911-dccf-4316-9a17-eb5337212263",
                                "sense_id": "84ae6e05-e63b-3d0f-8657-74626a584473",
                                "text": "Bruce's daughter, Marjory, and his sister Mary, were likewise to be encaged, the former in the Tower of London, the latter in Roxburghe Castle."
                            },
                            {
                                "example_id": "2fb19381-3996-4e71-ab4a-4cc6c15ce37c",
                                "sense_id": "84ae6e05-e63b-3d0f-8657-74626a584473",
                                "text": "I feared the sight of encaged animals would be unbearably sad."
                            },
                            {
                                "example_id": "77ff09a8-9f44-4c30-9ab1-2e83f956138e",
                                "sense_id": "84ae6e05-e63b-3d0f-8657-74626a584473",
                                "text": "To rattle the rats to the point where their stress response remained demonstrably hyperactive, the researchers exposed the animals to four weeks of varying stressors: moderate electric shocks, being encaged with dominant rats, prolonged dunks in water."
                            }
                        ]
                    }
                ],
