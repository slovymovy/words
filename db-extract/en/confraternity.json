                            }
                        ]
                    },
                    {
                        "translation_id": "69f8b3eb-171b-482e-b08e-24c4972038a6",
                        "source_entry_id": "4b0baea2-7652-33d9-8994-dfd081e02201",
                        "source_sense_id": "08808b62-5655-38f5-a56d-b197b0708677",
                        "source_sense_description": "Gemeinschaft, Genossenschaft",
                        "target_lang_word": "Gemeinschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemeinschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abd954df-2e56-3be1-bd48-1128874708af",
                                        "entry_id": "d3db9771-d13b-3ae7-8cdc-79393cfc0ff1",
                                        "glosses": [
                                            "Gruppe von Personen, die sich einander verbunden fühlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "619c1b58-ef42-49a1-87bc-8c80b8be1f0f",
                                                "sense_id": "abd954df-2e56-3be1-bd48-1128874708af",
                                                "text": "Sie war ein nützliches Mitglied unserer Gemeinschaft."
                                            },
                                            {
                                                "example_id": "c46b3735-6779-4f52-b694-6ebda22005ae",
                                                "sense_id": "abd954df-2e56-3be1-bd48-1128874708af",
                                                "text": "„In solchen Fällen wird »Gemeinschaft« gegen »Gesellschaft« ausgespielt - Gemeinschaft als eine ursprüngliche, nicht durch Organisation und Zwecksetzungen entstehende Verbindung.“"
                                            },
                                            {
                                                "example_id": "41f10fde-8299-482c-9908-200593f86349",
                                                "sense_id": "abd954df-2e56-3be1-bd48-1128874708af",
                                                "text": "„Da sich eine Gemeinschaft durch den Außenseiter immer herausgefordert, bedroht oder unterwandert fühlt, widmet sie ihm ihr ganzes Interesse, ihren Argwohn, und schließlich verfolgt sie ihn mit ihrem Haß.“"
                                            },
                                            {
                                                "example_id": "2ac7fcb9-6a5a-4b8b-9048-1af463533e0b",
                                                "sense_id": "abd954df-2e56-3be1-bd48-1128874708af",
                                                "text": "„Die gesellschaftlichen Rahmenbedingungen, die ethische Substanz einer Gemeinschaft und die Existenz oder Nichtexistenz einer Wagniserziehung tragen einen wesentlichen Verantwortungsanteil daran, in welche Wertrichtung sich die Wagnistendenzen bewegen.“"
                                            },
                                            {
                                                "example_id": "adab5200-56db-4888-83b5-246d1fc0de1d",
                                                "sense_id": "abd954df-2e56-3be1-bd48-1128874708af",
                                                "text": "„Weihnachten ist das Fest der Familie. An keinem anderen Tag im Jahr wird Gemeinschaft und Zusammensein so zelebriert wie in der Zeit um Heiligabend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "575a2d18-2010-37c8-8825-d76487b88921",
                                        "entry_id": "d3db9771-d13b-3ae7-8cdc-79393cfc0ff1",
                                        "glosses": [
                                            "Organisation, die sich zu bestimmten Zwecken gebildet hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa199a8-0452-4012-afde-26833b825b61",
                                                "sense_id": "575a2d18-2010-37c8-8825-d76487b88921",
                                                "text": "Die Europäische Gemeinschaft versucht, sich in der globalisierten Welt zu behaupten."
                                            },
                                            {
                                                "example_id": "0e44c993-4521-4730-bf8c-40aa46fea922",
                                                "sense_id": "575a2d18-2010-37c8-8825-d76487b88921",
                                                "text": "„Er setzte die Verfassung außer Kraft, doch die meisten Kubaner und die internationale Gemeinschaft erkannten seine Regierung an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2327d64-a9d1-4c2d-a3aa-1c527c555e80",
                        "source_entry_id": "4b0baea2-7652-33d9-8994-dfd081e02201",
                        "source_sense_id": "08808b62-5655-38f5-a56d-b197b0708677",
                        "source_sense_description": "Gemeinschaft, Genossenschaft",
                        "target_lang_word": "Genossenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genossenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b484fe9-d369-3cef-98a0-ef236f206468",
                                        "entry_id": "e7dff131-2bac-3a0e-abab-844aa54bc547",
                                        "glosses": [
                                            "Zusammenschluss von natürlichen oder juristischen Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b933e55-a7e0-41f1-b5d3-4812f3f8835b",
                                                "sense_id": "3b484fe9-d369-3cef-98a0-ef236f206468",
                                                "text": "„Empfänger von Arbeitslosengeld II, die eine Wohnung in einer Genossenschaft nutzen, erhalten die Kosten für Miete und Heizung.“"
                                            },
                                            {
                                                "example_id": "d250f6b9-0e34-4bcc-bb75-4a3779c136bf",
                                                "sense_id": "3b484fe9-d369-3cef-98a0-ef236f206468",
                                                "text": "„Der Redner hätte \"Genossen und Genossinnen! Genießen sie den Genuss der Genossenschaften, denn es kann vorkommen, dass ihre Nachkommen, mit ihrem Einkommen nicht auskommen und daher umkommen\" gesagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
