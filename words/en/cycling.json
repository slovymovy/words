                {
                    "sense_id": "1787993a-69b7-3cfe-b32a-4badb5afa93c",
                    "sense_definition": "The activity of riding bicycles for transport, exercise, or recreation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bicycle_riding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went <w>cycling</w> through the park on Sunday morning.",
                            "target_lang_translations": {
                                "ru": "В воскресенье утром мы отправились <w>кататься на велосипедах</w> по парку.",
                                "zh": "周日上午我们去公园<w>骑行</w>了。"
                            }
                        },
                        {
                            "text": "She wears a helmet whenever she goes <w>cycling</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Она надевает шлем всякий раз, когда <w>едет на велосипеде</w> по городу.",
                                "zh": "她每次在城里<w>骑自行车</w>时都会戴上头盔。"
                            }
                        }
                    ],
                    "synonyms": [
                        "biking"
                    ],
                    "common_phrases": [
                        "go cycling",
                        "cycling shorts",
                        "cycling trip",
                        "cycling helmet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность, заключающаяся в езде на велосипеде для транспорта, физических упражнений или отдыха",
                        "zh": "指为了交通、锻炼或娱乐而骑自行车的活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "езда на велосипеде",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "катание на велосипеде",
                                "target_lang_sense_clarification": "для отдыха или развлечения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骑自行车",
                                "target_lang_sense_clarification": "通用活动"
                            },
                            {
                                "target_lang_word": "骑行",
                                "target_lang_sense_clarification": "常用于休闲或运动语境"
                            }
                        ]
