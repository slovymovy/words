                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f4b7c3-ece6-4716-bdaf-6c73f675bba5",
                                                "sense_id": "f43ab0a0-ccd0-3877-afd1-123038c01c81",
                                                "text": "Les chasseurs alpins ne prononcent jamais le mot rouge. Ça date de l'époque de Napoléon III qui voulait que les soldats portent le pantalon garance. Rouge si vous préférez. Vous imaginez les bidasses en rouge sur la neige ?"
                                            }
