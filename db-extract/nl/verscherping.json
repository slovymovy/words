                                    {
                                        "sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
                                        "entry_id": "9d6fde05-06b9-3e2b-88a0-4e8d0c310db1",
                                        "glosses": [
                                            "The act or process of intensifying, or of making more intense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3936244-1442-4812-845f-c8df42585f6e",
                                                "sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
                                                "text": "With the intensification of air raids on London last September, these tube platforms began to be used as an air raid shelter, and shelterers travelled by train (specially stopped there) from other stations in order to gain access."
                                            },
                                            {
                                                "example_id": "6d1fbc23-6541-4610-9ff0-488dcb463702",
                                                "sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
                                                "text": "[...] moreover, the layout fortunately allows for the likely intensification of the suburban service."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e64107b-cd93-44e3-8bc6-4c092c556c13",
                        "source_entry_id": "b097211c-f9ac-3ae4-9278-1405fc42788a",
                        "source_sense_id": "3496f152-6c0e-352a-a9bb-22fd8397c140",
                        "target_lang_word": "escalation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escalation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52f5f447-fdea-3947-906a-04c71e72a009",
                                        "entry_id": "5c2b8566-f5e3-3e00-9fac-bba08a6a61da",
                                        "glosses": [
                                            "The act of escalating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b669310c-e6d5-383a-a0e3-ad34a6289e26",
                                        "entry_id": "5c2b8566-f5e3-3e00-9fac-bba08a6a61da",
                                        "glosses": [
                                            "An increase or rise, especially to counteract a perceived discrepancy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab023f27-a035-4549-83d7-085b55a56f21",
                                                "sense_id": "b669310c-e6d5-383a-a0e3-ad34a6289e26",
                                                "text": "Thousands of violent videos are still available on the internet, according to Alexander, who claims they lead to an escalation in offline tensions between rival gangs. \"I believe some young people are losing their lives as result of this material on the internet,\" she said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a747efc-1ae7-3a6f-b875-4e2b1135733f",
                                        "entry_id": "5c2b8566-f5e3-3e00-9fac-bba08a6a61da",
                                        "glosses": [
                                            "A deliberate or premeditated increase in the violence or geographic scope of a conflict."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9b418ad-6ebc-444d-8efc-05faca629c20",
                                                "sense_id": "4a747efc-1ae7-3a6f-b875-4e2b1135733f",
                                                "text": "The 1840s saw a further escalation, with new laws treating most slave ships captured as pirates, and a number of military expeditions being mounted to destroy slaving centres on the African coast and depose, or even kill, remaining local kings and chiefs who had refused to end slavery in their territory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "720de9d9-aaf4-323c-b79e-681d5e8922c2",
                                        "entry_id": "5c2b8566-f5e3-3e00-9fac-bba08a6a61da",
                                        "glosses": [
                                            "The reassignment of a difficult problem to someone whose job is dedicated to handling such cases."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04199cac-6c78-4e20-8320-7a2d636c23f7",
                                                "sense_id": "720de9d9-aaf4-323c-b79e-681d5e8922c2",
                                                "text": "The manager ensures that the escalation team generates a continuous stream of root cause analysis exercises and the subsequent corrective actions."
                                            },
                                            {
                                                "example_id": "af426967-3269-4ee9-a3ad-ef1540387637",
                                                "sense_id": "720de9d9-aaf4-323c-b79e-681d5e8922c2",
                                                "text": "Resolving escalations tends to require large amounts of time and energy from the support engineer working on an escalation and from the manager driving it. If those individuals are also required to attend to other issues, they will either neglect other customers (not good) or do a poor job of driving the escalation (very bad)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c81bfb9-5751-450c-a43b-2c94e61b311e",
                        "source_entry_id": "b097211c-f9ac-3ae4-9278-1405fc42788a",
                        "source_sense_id": "65a690b1-95e2-3e19-8144-66d9d9567e26",
                        "source_sense_description": "verstemlozing van obstruenten in eindpositie",
                        "target_lang_word": "Auslautverhärtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auslautverhärtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d04520ef-6e45-352f-a165-2ed0a910040c",
                                        "entry_id": "dfe25d1c-f939-30ff-a669-14388bd0e714",
                                        "glosses": [
                                            "An sich stimmhafte Plosive und Frikative sind im Deutschen stimmlos, wenn sie im Wortauslaut stehen. Das gilt auch für Gruppen dieser Konsonanten. Innerhalb des Wortes gilt das im Silbenauslaut nur, wenn auf das Ende der Silbe ein neuer Stimmeinsatz folgt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84282060-11ab-4ed5-8ce3-0a42f040ccc6",
                                                "sense_id": "d04520ef-6e45-352f-a165-2ed0a910040c",
                                                "text": "Die Auslautverhärtung bedeutet zum Beispiel, dass das in dem Wort „Gold“ stimmlos gesprochen wird ([gɔlt]), in „Goldes“ aber stimmhaft (['gɔldəs]). In „biegst“ ist die Auslautgruppe stimmlos: [biːkst]."
                                            },
                                            {
                                                "example_id": "375807bd-2447-4164-bd20-8d0cb36addc4",
                                                "sense_id": "d04520ef-6e45-352f-a165-2ed0a910040c",
                                                "text": "Grundlage der Auslautverhärtung ist eine Neutralisation der phonologischen Opposition zwischen stimmhaften und stimmlosen Verschluss- und Reibelauten im Deutschen."
                                            },
                                            {
                                                "example_id": "4612b2c2-d87f-4e19-a9d2-2b86cf8e8280",
                                                "sense_id": "d04520ef-6e45-352f-a165-2ed0a910040c",
                                                "text": "„Diese Auslautverhärtung ist in früh- und klassisch-mittelhochdeutscher Zeit die Regel.“"
                                            },
                                            {
                                                "example_id": "11f374bf-db15-49c9-a493-6be83dffbd34",
                                                "sense_id": "d04520ef-6e45-352f-a165-2ed0a910040c",
                                                "text": "„Denken Sie nur noch einmal an die Auslautverhärtung, des Phonologen liebste Regel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
