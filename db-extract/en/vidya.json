                        "examples": [
                            {
                                "example_id": "c3b9d793-0c6b-453b-bbb8-d3bb6787733a",
                                "sense_id": "fb406045-377d-3daa-9e4c-cee25ba588b2",
                                "text": "There are a hundred angles to this issue and the criticism has been noted since video games first saw the light of day. However, I've never really examined the question: is \"the vidya\" bad for you?"
                            },
                            {
                                "example_id": "5c7f3b3c-d43c-4dac-9b30-56d0925f3839",
                                "sense_id": "fb406045-377d-3daa-9e4c-cee25ba588b2",
                                "text": "Quinnae Moongazer, a pizza loving feminist sociologist and amateur slug herder, spends her time writing about feminism, transgender politics, and the vidya."
                            },
                            {
                                "example_id": "60e32b8e-6071-435d-9e2b-1bfc0660bffd",
                                "sense_id": "fb406045-377d-3daa-9e4c-cee25ba588b2",
                                "text": "The site We Hunted The Mammoth scoured the full transcript released by 4chan, turning up gems from some anons like, \"i couldnt care less about vidya, i just want to see zoe receive her comeuppance.\""
                            }
                        ]
                    }
