                "senses": [
                    {
                        "sense_id": "97f53ef8-18de-31c3-9aaf-8dcf3baea8e2",
                        "entry_id": "5fea06e7-c3b4-32c5-af83-d8c903340fbc",
                        "glosses": [
                            "Donner la forme d’une tulipe à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cab7f506-a9a6-4ea9-a1fc-586a52c4de1a",
                                "sense_id": "97f53ef8-18de-31c3-9aaf-8dcf3baea8e2",
                                "text": "Sica a développé un système combiné spécial pour tuliper des tubes en PP en employant 2 Everbell3 160."
                            },
                            {
                                "example_id": "b1f76d83-a626-44db-8ce0-c64cfd23b51b",
                                "sense_id": "97f53ef8-18de-31c3-9aaf-8dcf3baea8e2",
                                "text": "Ces éléments de la garniture lui permettent d'être placée de manière plus fiable sur le mandrin de travail utilisé pour tuliper un embout de tuyau thermoplastique femelle."
                            },
                            {
                                "example_id": "d444c2e4-43d7-4833-91d7-ef9b1ea832ee",
                                "sense_id": "97f53ef8-18de-31c3-9aaf-8dcf3baea8e2",
                                "text": "Les murailles peuvent être verticales, ou évasées vers l’extérieur (on dit aussi « tulipées » …), ou plus rarement rentrantes au niveau du pont, on dit dans ce cas que la coque est frégatée."
                            }
                        ]
                    }
