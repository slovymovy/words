                "senses": [
                    {
                        "sense_id": "02ad5b74-b7b8-338d-b7f3-dbb27044f7aa",
                        "entry_id": "85b02542-2303-3786-b7a2-c851d67d82dc",
                        "glosses": [
                            "het in de gaten houden, het letten op"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9750845d-38a3-4f55-9bb6-d9b70b3631da",
                                "sense_id": "02ad5b74-b7b8-338d-b7f3-dbb27044f7aa",
                                "text": "Rijkswaterstaat heeft de Ketheltunnel in de A4 bij Schiedam vanochtend rond 06.45 uur in beide richtingen afgesloten. Door ziektegevallen waren er geen mensen om toezicht op de tunnel te houden."
                            },
                            {
                                "example_id": "a98ad500-24bc-4231-9639-817d7958a362",
                                "sense_id": "02ad5b74-b7b8-338d-b7f3-dbb27044f7aa",
                                "text": "De deelnemers - die van vrije afkomst moesten zijn - werden geacht minstens een maand van tevoren in Elis te verschijnen, waar zij onder toezicht van de juryleden (hellanodikai, letterlijk: scheidsrechters der Grieken) trainden."
                            },
                            {
                                "example_id": "93a3bd49-f5e0-496a-80ed-e94561bf2d9b",
                                "sense_id": "02ad5b74-b7b8-338d-b7f3-dbb27044f7aa",
                                "text": "De deelnemers - die van vrije afkomst moesten zijn - werden geacht minstens een maand van tevoren in Elis te verschijnen, waar zij onder toezicht van de juryleden (hellanodikai, letterlijk: scheidsrechters der Grieken) trainden."
                            }
                        ]
                    }
                ],
