                ],
                "senses": [
                    {
                        "sense_id": "9491a7dd-07ad-3c92-a7a5-bccd3b5d7f1a",
                        "entry_id": "ee46a9d7-69b4-3dbf-ba77-160a2c943d0c",
                        "glosses": [
                            "Ordnungsbegriff für eine Spielrichtung, Gattungsbezeichnung für eine Gruppe strukturell oder inhaltlich ähnlich ausgerichteter Spiele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e0b1db-5bea-4e7d-80d5-8d4109a29af2",
                                "sense_id": "9491a7dd-07ad-3c92-a7a5-bccd3b5d7f1a",
                                "text": "„Die schon sehr alte Tradition dieses Spielgenres· und das Interesse auch Erwachsener an ihm vermittelt die Puppenküche im Nationalmuseum Nürnberg aus dem 19. Jahrhundert mit ihren liebevollen Details.“"
                            },
                            {
                                "example_id": "b3fe33d5-5cff-4b4b-829d-f6487b769e97",
                                "sense_id": "9491a7dd-07ad-3c92-a7a5-bccd3b5d7f1a",
                                "text": "„Wenn allerdings, wie bei ‚Photon’, dem Prototyp des letztgenannten Spielgenres, Laserkampfszenen dem Vorbild ‚Star Wars’ nachgespielt werden, ist durchaus Skepsis hinsichtlich einer sinnvollen Weiterentwicklung der Inhalte angebracht.“"
                            },
                            {
                                "example_id": "324bd102-77ad-451b-9aaf-5619ee7e2ff9",
                                "sense_id": "9491a7dd-07ad-3c92-a7a5-bccd3b5d7f1a",
                                "text": "„Das Spielgenre spielt eine entscheidende Rolle für die Entwicklungsfähigkeit eines weiblichen Charakters.“"
                            },
                            {
                                "example_id": "4ae74e6c-1bf1-4bde-9ab6-b9e330ac03e6",
                                "sense_id": "9491a7dd-07ad-3c92-a7a5-bccd3b5d7f1a",
                                "text": "„Wo in der Realität die Infrastruktur zur Quantifizierung erst noch geschaffen werden muss, ist sie in diesen Spielgenres schon immer fest integriert.“"
                            },
                            {
                                "example_id": "022384db-cda2-4269-ae61-8b1829cd3697",
                                "sense_id": "9491a7dd-07ad-3c92-a7a5-bccd3b5d7f1a",
                                "text": "„Sie rutschen dabei leicht in ein Spielgenre, wohin sie nicht gehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
