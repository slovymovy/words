                ],
                "senses": [
                    {
                        "sense_id": "da696c05-9ca7-3b10-809b-c60057f2c05e",
                        "entry_id": "9a4f233c-ea05-38d8-9b82-868492a68a0f",
                        "glosses": [
                            "приверженец социал-демократии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c8ce29-7aa6-4ca5-a13e-220c937c9c23",
                                "sense_id": "da696c05-9ca7-3b10-809b-c60057f2c05e",
                                "text": "Они скорее левые, чем правые. Даже не социал-демократы, скорее левые народники."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fef935d-1477-3ac5-b204-959ad2dfca29",
                        "entry_id": "9a4f233c-ea05-38d8-9b82-868492a68a0f",
                        "glosses": [
                            "член социал-демократической партии"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bab9d31-9ee8-4cff-ab6d-ea187713c516",
                        "source_entry_id": "9a4f233c-ea05-38d8-9b82-868492a68a0f",
                        "target_lang_word": "Sozialdemokrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sozialdemokrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa8de262-f09e-33c9-90b9-3cb60eea9317",
                                        "entry_id": "9fa52261-be54-3da4-967d-51014967c2da",
                                        "glosses": [
                                            "Anhänger der Sozialdemokratie, Anhänger oder Mitglied einer sozialdemokratischen Partei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa0a410-9a5d-4b70-bc56-ddf68e4b93b8",
                                                "sense_id": "fa8de262-f09e-33c9-90b9-3cb60eea9317",
                                                "text": "„Auch wenn das Staatsbild der Sozialdemokraten erheblichen Veränderungen unterlag und unterliegt, so lässt sich heute sagen, dass die Sozialdemokraten den Staat in der sozialen Hauptverantwortung sehen.“"
                                            },
                                            {
                                                "example_id": "0cb8756b-0db6-4037-b7d9-96fa7f0f9b93",
                                                "sense_id": "fa8de262-f09e-33c9-90b9-3cb60eea9317",
                                                "text": "„Aber im Zweifel sollte für Sozialdemokraten heute die Annahme gelten, dass die Verbesserung oder auch nur die Bewahrung des Erreichten ohne fortschreitende Veränderung undenkbar ist.“"
                                            },
                                            {
                                                "example_id": "e4bcb16f-0f23-46eb-89b8-cc3330ea788a",
                                                "sense_id": "fa8de262-f09e-33c9-90b9-3cb60eea9317",
                                                "text": "„Sogar unter Sozialdemokraten gab es Verfechter eines Krieges gegen das zaristische Russland.“"
                                            },
                                            {
                                                "example_id": "04fa5419-8d4f-4066-b2cc-ff01bbd13426",
                                                "sense_id": "fa8de262-f09e-33c9-90b9-3cb60eea9317",
                                                "text": "„So gut standen die Sozialdemokraten schon lange nicht mehr da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
