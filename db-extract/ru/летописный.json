                    }
                ],
                "translations": [
                    {
                        "translation_id": "faf2463b-1fcc-4cb0-a822-47da630b178f",
                        "source_entry_id": "586d1371-2a91-3850-8a1d-ced8326a039b",
                        "source_sense_id": "88b6ab4d-7e99-3e50-82f3-2ee88c2bb0a6",
                        "target_lang_word": "chronicle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronicle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a163cad-6e50-37e7-9220-f71876df4624",
                                        "entry_id": "e4042414-d2c3-3b93-81e2-ec216acc92f9",
                                        "glosses": [
                                            "A written account of events and when they happened, ordered by time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f41897b-1fab-4c44-a895-3bfc1f48c982",
                                                "sense_id": "6a163cad-6e50-37e7-9220-f71876df4624",
                                                "text": "Also a choice cachinatory chronicle, entitled \"How to Laugh, and what to Laugh at.\""
                                            },
                                            {
                                                "example_id": "63f5e5bc-7474-4f4a-b113-93168b2e998e",
                                                "sense_id": "6a163cad-6e50-37e7-9220-f71876df4624",
                                                "text": "Little disappointed, then, she turned attention to \"Chat of the Social World,\" gossip which exercised potent fascination upon the girl's intelligence. She devoured with more avidity than she had her food those pretentiously phrased chronicles of the snobocracy—[…]—distilling therefrom an acid envy that robbed her napoleon of all its flavor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chronicle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "399dd5e7-53bc-3490-99d3-c687d6820c60",
                                        "entry_id": "495c6459-6fdf-33fd-a823-03ff22c3284f",
                                        "glosses": [
                                            "To record in or as in a chronicle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8aafef8-daee-474c-a2ca-c6e48708df9f",
                                                "sense_id": "399dd5e7-53bc-3490-99d3-c687d6820c60",
                                                "text": "The posterists of Austin chronicled the changing social landscape and graphically redefined Texas for the rest of the country and the world […]"
                                            },
                                            {
                                                "example_id": "184635c2-4405-4d74-8013-c10524694230",
                                                "sense_id": "399dd5e7-53bc-3490-99d3-c687d6820c60",
                                                "text": "As the board’s director, Ms. Jankowicz, 33, bore the brunt of the attacks, a subject she knows well. Her most recent book, called “How to Be a Woman Online,” chronicles abuses she and other women face from trolls and other malign actors on the internet."
                                            },
                                            {
                                                "example_id": "06ce35ef-cfbe-47e8-a9ba-a23bcbb81f88",
                                                "sense_id": "399dd5e7-53bc-3490-99d3-c687d6820c60",
                                                "text": "The stars also worked on a Disney+ docuseries chronicling the purchase and stewardship of the club, who currently play in the National League, which was being filmed when the King and Queen Consort visited."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67f94d91-dd9e-4a8e-99e1-c4b35ae8a41d",
                        "source_entry_id": "586d1371-2a91-3850-8a1d-ced8326a039b",
                        "source_sense_id": "88b6ab4d-7e99-3e50-82f3-2ee88c2bb0a6",
                        "target_lang_word": "chronological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f220adc-7922-3faa-8850-27a4d6ffd290",
                                        "entry_id": "83df61e0-3c3e-30d0-a689-4f68572d72bb",
                                        "glosses": [
                                            "Relating to time, or units of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d44cee-902c-4f5d-bdd9-8634d682ef4e",
                                                "sense_id": "5f220adc-7922-3faa-8850-27a4d6ffd290",
                                                "text": "He is 67 in chronological age, but has the mind and body of someone 55."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "270ad794-9522-39fc-a0b5-497fb300a698",
                                        "entry_id": "83df61e0-3c3e-30d0-a689-4f68572d72bb",
                                        "glosses": [
                                            "In order of time from the earliest to the latest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfafc0f1-8183-4c2f-8af1-47d699f27e17",
                                                "sense_id": "270ad794-9522-39fc-a0b5-497fb300a698",
                                                "text": "The live report lists all the events in chronological order."
                                            },
                                            {
                                                "example_id": "87722076-04f8-4795-aee9-e13697a782f9",
                                                "sense_id": "270ad794-9522-39fc-a0b5-497fb300a698",
                                                "text": "A Book of Death and Fish is about one Peter MacAulay, an unremarkable individual who has the sea and its promises always with him, experiencing the usual strains of growing up and growing old – the death of a friend, his parents, marriage and children – all set out in chronological order and divided into two books, Migration and Turbulence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f0fc064-a4e1-3b34-8c11-82a0a3db95aa",
                                        "entry_id": "83df61e0-3c3e-30d0-a689-4f68572d72bb",
                                        "glosses": [
                                            "In order of time from the earliest to the latest.",
                                            "Relating to the arrangement of events in the order in which they occur within a story, rather than the order in which they are released."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
