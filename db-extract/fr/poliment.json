        "fr-extract.jsonl": [
            {
                "entry_id": "9784fdba-93ae-3e4c-805c-0c4072a72800",
                "word": "poliment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "74927e4e-f01e-34dd-bab9-f93fbcd628f0",
                        "entry_id": "9784fdba-93ae-3e4c-805c-0c4072a72800",
                        "glosses": [
                            "D’une manière polie , en parlant de la manière d’agir, d’écrire, de s’exprimer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc6d06c-35af-450c-9ce1-791ca1bb0c03",
                                "sense_id": "74927e4e-f01e-34dd-bab9-f93fbcd628f0",
                                "text": "Nous eûmes dans la matinée une audience publique du vice-roi. […]. Il nous reçut poliment , accorda au capitaine la relâche , et aux passagers la permission de se promener en ville."
                            },
                            {
                                "example_id": "fbdfd74a-490b-45a8-8326-656f973d55de",
                                "sense_id": "74927e4e-f01e-34dd-bab9-f93fbcd628f0",
                                "text": "Il avait des manières courtoises et prévenantes, saluant poliment tout le monde, mais particulièrement les dames et les demoiselles, […]."
                            },
                            {
                                "example_id": "d9b9b181-8c68-432a-b141-23a0d7463534",
                                "sense_id": "74927e4e-f01e-34dd-bab9-f93fbcd628f0",
                                "text": "Chacun doit écouter avec courtoisie l'adversaire, […] ! Exprimons-nous poliment. Rétorquons de même, sans nous départir de sang-froid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "661165bc-d8ca-4a6d-88af-6ecd78e2c581",
                        "source_entry_id": "9784fdba-93ae-3e4c-805c-0c4072a72800",
                        "source_sense_id": "74927e4e-f01e-34dd-bab9-f93fbcd628f0",
                        "target_lang_word": "höflich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "höflich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d9939cd-2ebc-3f54-ba53-2c47fb7e56ea",
                                        "entry_id": "02802b25-e1da-3049-8a04-fcd2ef7d5a3e",
                                        "glosses": [
                                            "formell respektvoll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ab2d4d-d14c-4ae3-8313-bbabc279162f",
                                                "sense_id": "3d9939cd-2ebc-3f54-ba53-2c47fb7e56ea",
                                                "text": "Es ist höflich, „bitte“ und „danke“ zu sagen."
                                            },
                                            {
                                                "example_id": "21db6d45-c3cf-429b-804d-bf151214d5e7",
                                                "sense_id": "3d9939cd-2ebc-3f54-ba53-2c47fb7e56ea",
                                                "text": "Eigentlich liegt mir „Sie Arsch!“ auf der Zunge, was ich mir aber höflich verkneife."
                                            },
                                            {
                                                "example_id": "ab46ab86-4eb1-4c9b-9f98-ed6c062796e0",
                                                "sense_id": "3d9939cd-2ebc-3f54-ba53-2c47fb7e56ea",
                                                "text": "„… wenn Sie höflich sind, ist das Gegenüber unwillkürlich auch höflicher.“"
                                            },
                                            {
                                                "example_id": "e05e531f-303f-4f70-a119-93056d482ed2",
                                                "sense_id": "3d9939cd-2ebc-3f54-ba53-2c47fb7e56ea",
                                                "text": "Die Tür aufhalten, für ältere Menschen im Bus aufstehen: Solche Rituale gelten gemeinhin als höflich …"
                                            },
                                            {
                                                "example_id": "97a9c1e1-80b1-4fb9-bd59-ae160412ee00",
                                                "sense_id": "3d9939cd-2ebc-3f54-ba53-2c47fb7e56ea",
                                                "text": "Und darum ersuche ich Sie höflichst, Ljubowj Grigorjewna, mein Schicksal unter Ihrer gefälligen Mitwirkung betreiben zu wollen."
                                            },
                                            {
                                                "example_id": "c98cad56-1978-4fab-ad49-58529509dbc2",
                                                "sense_id": "3d9939cd-2ebc-3f54-ba53-2c47fb7e56ea",
                                                "text": "Bartel war aber ein höflicher Mann; gleich bei dem ersten Wirtshaus bot er Kordelchen ein Gläschen Branntwein an."
                                            },
                                            {
                                                "example_id": "6c05d583-54c9-4fe5-98f7-6685d0c6365b",
                                                "sense_id": "3d9939cd-2ebc-3f54-ba53-2c47fb7e56ea",
                                                "text": "Das Essen war ekelhaft. Trotzdem sagte ich: „Das hat mal wieder großartig geschmeckt“. Eigentlich war das höflich, aber eine Lüge."
                                            },
                                            {
                                                "example_id": "3f080fe7-d660-49ba-9cfa-a4c29f60a1e9",
                                                "sense_id": "3d9939cd-2ebc-3f54-ba53-2c47fb7e56ea",
                                                "text": "„Bleib höflich und sag nichts - das ärgert sie am meisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1c6e223-7831-49e5-b22b-7142350f1d33",
                        "source_entry_id": "9784fdba-93ae-3e4c-805c-0c4072a72800",
                        "source_sense_id": "74927e4e-f01e-34dd-bab9-f93fbcd628f0",
                        "target_lang_word": "politely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e68c249-9e85-3ff4-88f8-7cfa48ecf743",
                                        "entry_id": "734fc948-234b-35ef-8430-7d1013013b5d",
                                        "glosses": [
                                            "in a polite manner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c52fb8b-7166-4ff0-a313-7adb11718c3a",
                                                "sense_id": "2e68c249-9e85-3ff4-88f8-7cfa48ecf743",
                                                "text": "If pressed about a serious accusation like rape, you can politely reply that you can’t answer questions pertaining to such an allegation without legal representation and wish to remain silent."
                                            },
                                            {
                                                "example_id": "5148b910-1d48-4c7e-a82b-988edb0f59d9",
                                                "sense_id": "2e68c249-9e85-3ff4-88f8-7cfa48ecf743",
                                                "text": "It was night once more and Mary had got through another day without throwing herself politely from a top floor window or scrawling filthy words on the dining room walls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f49288f6-607f-4ac9-8bce-824dddcd49af",
                        "source_entry_id": "9784fdba-93ae-3e4c-805c-0c4072a72800",
                        "source_sense_id": "74927e4e-f01e-34dd-bab9-f93fbcd628f0",
