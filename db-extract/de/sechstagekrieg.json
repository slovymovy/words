                "senses": [
                    {
                        "sense_id": "48668189-451a-335c-9a9a-82191dca52b8",
                        "entry_id": "3d8243e6-4d34-3eec-877a-c81e7cfe9ac3",
                        "glosses": [
                            "bewaffnete Auseinandersetzung zwischen Israel und den arabischen Staaten Ägypten, Jordanien und Syrien, die vom 5. bis zum 10. Juni 1967 dauerte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef45e3f6-044a-40d5-b70a-ab0f73762020",
                                "sense_id": "48668189-451a-335c-9a9a-82191dca52b8",
                                "text": "„Die israelische Armee hatte das Westjordanland und Ost-Jerusalem im Sechstagekrieg 1967 besetzt.“"
                            },
                            {
                                "example_id": "b6af5b15-5cf2-4c17-99a2-d496c19dd65c",
                                "sense_id": "48668189-451a-335c-9a9a-82191dca52b8",
                                "text": "„Das Los der früheren arabischen Bewohner der Golanhöhen ist umstritten. Gemäss dem in Israel vorherrschenden Geschichtsbild sind sie im Sechstagekrieg nach Syrien geflohen.“"
                            },
                            {
                                "example_id": "6ec4165f-f8a3-44f5-96b7-341de4914333",
                                "sense_id": "48668189-451a-335c-9a9a-82191dca52b8",
                                "text": "„Nach dem Sechstagekrieg verschwand der Sand, der unser Viertel von der Welt trennte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
