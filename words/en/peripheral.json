                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to ignore <w>peripheral</w> issues and focus on the main budget.",
                            "target_lang_translations": {
                                "ru": "Комитет решил игнорировать <w>второстепенные</w> вопросы и сосредоточиться на основном бюджете."
                            }
