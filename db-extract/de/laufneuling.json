                ],
                "senses": [
                    {
                        "sense_id": "5c50016a-4718-3921-ba52-52d85fc34463",
                        "entry_id": "d2737bf5-abf6-3a3c-b1fe-3c6d68d59d50",
                        "glosses": [
                            "Person, die neu beim Laufen ist und wenig bis keine Erfahrung damit hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "925392ee-6db1-4a3f-98c1-4ee6d5bce3a1",
                                "sense_id": "5c50016a-4718-3921-ba52-52d85fc34463",
                                "text": "„Auch komplette Laufneulinge werden durch die neu angebotenen Programme von Münster-Marathon e.V. von 0 auf 6,2 oder 10 km gebracht – ganz nach Wunsch.“"
                            },
                            {
                                "example_id": "be50dc0a-0000-47eb-b912-92160951da4f",
                                "sense_id": "5c50016a-4718-3921-ba52-52d85fc34463",
                                "text": "„So traten geübte Läufer und Laufneulinge gemeinsam an und alle konnten trotz der Hitze eine tolle Zeit abliefern.“"
                            },
                            {
                                "example_id": "57414056-e225-47a8-a9bc-205e4e6d11ca",
                                "sense_id": "5c50016a-4718-3921-ba52-52d85fc34463",
                                "text": "„Laufneuling Inge Grimmer startete im Einsteigerlauf über 4,5 km, bei dem es keine Altersklassenwertung gab.“"
                            },
                            {
                                "example_id": "24edb530-a61c-4d2a-a820-e1a1ad0ba195",
                                "sense_id": "5c50016a-4718-3921-ba52-52d85fc34463",
                                "text": "„Besonders Laufneulinge profitieren gerne von der Routine anderer und das Gruppengefühl gibt einen weiteren Motivationsschub, um den inneren Schweinehund zu überwinden.“"
                            },
                            {
                                "example_id": "f7087901-82b6-4582-8eb3-e95af1a76a4f",
                                "sense_id": "5c50016a-4718-3921-ba52-52d85fc34463",
                                "text": "„Dabei ist es egal, ob man Profi-Läufer oder Laufneuling ist: Jeder gelaufene Meter macht einen Unterschied, denn alle Startgelder und Spenden gehen zu 100 Prozent in die Rückenmarksforschung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
