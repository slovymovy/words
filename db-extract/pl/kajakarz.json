                "senses": [
                    {
                        "sense_id": "be8d7750-db85-3081-ba3c-5f1bf8e2060f",
                        "entry_id": "fcc4b6d0-fad4-3194-a74e-1dfad1a6e284",
                        "glosses": [
                            "zawodnik uprawiający kajakarstwo lub osoba, która pływa kajakiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c22b1c70-c050-4d5a-b9cd-ab28e66bef60",
                                "sense_id": "be8d7750-db85-3081-ba3c-5f1bf8e2060f",
                                "text": "Lubię sporty wodne – kiedyś byłem kajakarzem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf4aaac7-20c4-42bc-a412-85c140cd05f3",
                        "source_entry_id": "fcc4b6d0-fad4-3194-a74e-1dfad1a6e284",
                        "source_sense_id": "be8d7750-db85-3081-ba3c-5f1bf8e2060f",
                        "target_lang_word": "canoeist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canoeist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68797484-3046-36ad-8e99-3b13388da37d",
                                        "entry_id": "56e19fcd-adc6-3e9b-bdb8-62c0193841f9",
                                        "glosses": [
                                            "A person who travels by canoe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ea4b74-5a41-4a67-8e9d-080a12ec28cd",
                                                "sense_id": "68797484-3046-36ad-8e99-3b13388da37d",
                                                "text": "Though Hambleden's parish register records the death, in 1753, of a bargeman 'Kill'd by accident, shooting ye lock', the turbulent waters of Mill End weir on the River Thames, about a mile from the village, still attract canoeists."
                                            },
                                            {
                                                "example_id": "fde35e45-3815-44f1-8870-253e956ad9ed",
                                                "sense_id": "68797484-3046-36ad-8e99-3b13388da37d",
                                                "text": "Those people who have a meaningful relation to that body of water — whether it be a fisherman, a canoeist, a zoologist, or a logger — must be able to speak for the values which the river represents . . ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53861654-376c-4095-ae63-1a6bd298ba2b",
                        "source_entry_id": "fcc4b6d0-fad4-3194-a74e-1dfad1a6e284",
                        "source_sense_id": "be8d7750-db85-3081-ba3c-5f1bf8e2060f",
                        "target_lang_word": "kayaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kayaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44d6649a-8c93-333d-bdb1-db5ea8563af1",
                                        "entry_id": "b6d9bd25-74e7-3c7f-ad02-7af1069d0741",
                                        "glosses": [
                                            "One who kayaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5012cd2e-23e8-40ff-ae17-b112f56a98c0",
                                                "sense_id": "44d6649a-8c93-333d-bdb1-db5ea8563af1",
                                                "text": "A kayaker who was thrown from his boat and was being swept towards Teddington Weir was saved from a possible \"fatal injury\" by a brave rescue lifeboat team."
                                            },
                                            {
                                                "example_id": "01e496aa-9bf9-405e-9fc0-b3d7dd3a2ef2",
                                                "sense_id": "44d6649a-8c93-333d-bdb1-db5ea8563af1",
                                                "text": "Kayaking out in pre-dawn darkness to catch the sunrise behind Turnip Rock is a special treat for experienced kayakers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f839feb5-385a-4815-973a-f9c93618d7b5",
                        "source_entry_id": "fcc4b6d0-fad4-3194-a74e-1dfad1a6e284",
                        "source_sense_id": "be8d7750-db85-3081-ba3c-5f1bf8e2060f",
                        "target_lang_word": "байдарочник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "байдарочник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "af3a4737-9cab-3d6e-8ee3-74b25c0f0801",
                                        "entry_id": "a45440d3-b989-3c60-bf16-3310fac186a5",
                                        "glosses": [
                                            "тот, кто имеет байдару, байдарку, плавает на ней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcffbad2-c019-444d-820c-2b458c9dd341",
                                                "sense_id": "af3a4737-9cab-3d6e-8ee3-74b25c0f0801",
                                                "text": "Человек, который разговаривал с гиляками, был байдарочник алеут Михаил Иванович."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14435fc7-16b5-3150-801c-4be80a5b84b4",
                                        "entry_id": "a45440d3-b989-3c60-bf16-3310fac186a5",
                                        "glosses": [
                                            "спорт. тот, кто профессионально занимается или увлекается греблей на байдарке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b5ce812-17fc-4047-bc74-7e764cea8856",
                                                "sense_id": "14435fc7-16b5-3150-801c-4be80a5b84b4",
                                                "text": "В поселке Чуш в тот вечер вообще было неспокойно ― плач, визг, бегал с ружьем по улицам Командор, отыскивая погубителя дочери; на другом конце селения крушил домашний скарб Грохотало, на Енисее тонули какие-то байдарочники."
                                            },
                                            {
                                                "example_id": "2e9ac611-14b8-4712-a023-57d9d84f8ffa",
                                                "sense_id": "14435fc7-16b5-3150-801c-4be80a5b84b4",
                                                "text": "Пройдя пролив, байдарочники сразу же меняют курс и идут на юго-восток, в небольшой залив, где на стоянке, благоустроенной ранее туристами и местными рыбаками, разбивают лагерь и останавливаются на ночёвку и днёвку."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
