        "fr-extract.jsonl": [
            {
                "entry_id": "06266c0b-ca9c-328c-806d-a6a4760a97f1",
                "word": "Clic-Clac",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "af3624b6-22e8-3461-b103-165eced61de2",
                        "entry_id": "06266c0b-ca9c-328c-806d-a6a4760a97f1",
                        "glosses": [
                            "Canapé articulé, comme un livre, entre l’assise et le dossier et transformable en lit par un mouvement en deux temps dont le bruit fait clic-clac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f890285-831b-49ec-b684-fb3a1d380223",
                                "sense_id": "af3624b6-22e8-3461-b103-165eced61de2",
                                "text": "Elle se contente du Clic-Clac du salon, qu’elle ne déplie que lorsqu’elle s’est assurée que son petit est bien endormi avec son Toto dans ses bras frêles."
                            },
                            {
                                "example_id": "425697d3-faf6-4a77-91ea-59f6342af7d3",
                                "sense_id": "af3624b6-22e8-3461-b103-165eced61de2",
                                "text": "On peut être en smoking et dormir sur la moquette d’un studio, au pied d’un Clic-Clac triplement occupé."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b183e8d3-ed30-3164-95f1-92359a5572ba",
                "word": "clic-clac",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4491c6e6-2c0e-4426-aab6-0851137fbfb3",
                        "entry_id": "b183e8d3-ed30-3164-95f1-92359a5572ba",
                        "tags": [
                            "plural"
                        ],
                        "form": "clic-clacs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "441f29a0-18b3-35d8-83d0-065084b623bb",
                        "entry_id": "b183e8d3-ed30-3164-95f1-92359a5572ba",
                        "glosses": [
                            "Bruit de claquements répétés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c02be308-ec29-4dee-8bd0-8523a015d5a4",
                                "sense_id": "441f29a0-18b3-35d8-83d0-065084b623bb",
                                "text": "Le père Thomas est prêt, une mèche neuve a été lestement ajoutée à son fouet de malle ; il part faisant à son tour résonner l’air de ses clics-clacs les plus harmonieux."
                            },
                            {
                                "example_id": "80d42223-7f74-4b0a-9b14-24ac6f21574b",
                                "sense_id": "441f29a0-18b3-35d8-83d0-065084b623bb",
                                "text": "Fouquerolle s’était tranquillement mis à écrire un feuilleton de roman dans sa chambre ; mais , au bout de dix minutes à peine, il entendit les clic-clacs effrénés du cocher serbe, un grand bruit de voiture qui s’en allait, […]."
                            },
                            {
                                "example_id": "842d1e1d-f532-41eb-b6ed-ed4b2272d46a",
                                "sense_id": "441f29a0-18b3-35d8-83d0-065084b623bb",
                                "text": "[…], troussant son tablier, rattachant les brides flottantes de son bonnet, elle courut, à grands clic-clacs de sabots, colporter la nouvelle chez les voisines:"
                            },
                            {
                                "example_id": "6216b4a0-30ff-40db-ae10-db2933dc466d",
                                "sense_id": "441f29a0-18b3-35d8-83d0-065084b623bb",
                                "text": "Jolie petite déesse, soigneusement recouverte de tissu, elle se balançait au-dessus du clic-clac impérieux de ses hauts talons."
                            }
                        ]
                    },
                    {
                        "sense_id": "22a0c7a4-f6ef-36ed-9a60-b19ba6307dd6",
                        "entry_id": "b183e8d3-ed30-3164-95f1-92359a5572ba",
                        "glosses": [
                            "Tong."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2473109c-a7d2-4d6f-8600-dd9ce0487204",
                                "sense_id": "22a0c7a4-f6ef-36ed-9a60-b19ba6307dd6",
                                "text": "Ils ont dit que voilà maintenant ils ne portent pas les vraies chaussures, ils portent les clic-clac là parce que c’est pour l’eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "f66e8485-302b-3a20-a9d5-764407913079",
                        "entry_id": "b183e8d3-ed30-3164-95f1-92359a5572ba",
                        "glosses": [
                            "Canapé articulé, comme un livre, entre l’assise et le dossier et transformable en lit par un mouvement en deux temps dont le bruit fait clic-clac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f5ae629-a769-4e69-b55a-0879fc4bf2ea",
                                "sense_id": "f66e8485-302b-3a20-a9d5-764407913079",
                                "text": "Mon sourire te glace\nComme un clic-clac qui grince\nLe v’là qui r’vient, mince\nTous les mardis pour te serrer la pince […]"
                            },
                            {
                                "example_id": "856ade57-76de-4bdc-91a4-6fafaf5584ca",
                                "sense_id": "f66e8485-302b-3a20-a9d5-764407913079",
                                "text": "Qu'est-ce qu’on dort mal sur ces clic-clacs ! Surtout pas dépliés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3d7c47b-9f7f-492c-a514-7e6820e10d26",
                        "source_entry_id": "b183e8d3-ed30-3164-95f1-92359a5572ba",
                        "target_lang_word": "futon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "futon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c35048f-1bf2-33c1-b21f-7769cc1646b4",
                                        "entry_id": "f7ca1fb1-75fe-3a1e-8da4-e5af2db5eccf",
                                        "glosses": [
                                            "A thin mattress of tufted cotton or similar material, placed on a floor or on a raised, foldable frame as a bed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aac900d4-2f8d-40cb-a4d3-80e68e925618",
                                                "sense_id": "0c35048f-1bf2-33c1-b21f-7769cc1646b4",
                                                "text": "The Japanese bed is the floor, with a wooden box under the neck for a pillow and a futon for a covering. To the foreigner the Japanese landlord allows five or six futons, or cotton-wadded comforters, and they make a tolerable mattress, although not springy, and rather apt to be damp and musty."
                                            },
                                            {
                                                "example_id": "c93833bb-b42b-4be3-bca5-6a627020d64e",
                                                "sense_id": "0c35048f-1bf2-33c1-b21f-7769cc1646b4",
                                                "text": "The futon are easily aired, and may be carried about readily when moving."
                                            },
                                            {
                                                "example_id": "191ad47f-a83f-46ca-9d5f-083ce112af52",
                                                "sense_id": "0c35048f-1bf2-33c1-b21f-7769cc1646b4",
                                                "text": "Normally one or two futon are laid on tatami, several inches of straw matting recessed into the floor, providing a firm but extremely comfortable night’s rest."
                                            },
                                            {
                                                "example_id": "ac37eb33-14fd-417f-87ee-bcbc97f301e9",
                                                "sense_id": "0c35048f-1bf2-33c1-b21f-7769cc1646b4",
                                                "text": "Some futon (cotton-filled comforters and mattresses) were piled in one corner and few clothing belonging to father hung on some nails on the wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6a8c4e3-ac60-36c7-b9a1-d972538934d3",
                                        "entry_id": "f7ca1fb1-75fe-3a1e-8da4-e5af2db5eccf",
                                        "glosses": [
                                            "A round cushion used for Zen meditation, traditionally made of woven bulrush leaves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0316beb6-ed92-399f-81dd-e3b804bcfa01",
                                        "entry_id": "f7ca1fb1-75fe-3a1e-8da4-e5af2db5eccf",
                                        "glosses": [
                                            "A specific kind of sofa-bed, with a fixed cushion that forms a mattress when folded down and a sofa when folded up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1d51d8a-9723-4631-99a3-17e8bdc1a4b4",
                                                "sense_id": "0316beb6-ed92-399f-81dd-e3b804bcfa01",
                                                "text": "I was 18 years old, sleeping on a futon, cooking on a George Foreman grill and showering at a friend's house every few days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
