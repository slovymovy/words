    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "59665f01-2ffb-3578-8583-fd86bc243bfb",
                    "sense_definition": "Gefotografeerd door een snelheidscamera vanwege een verkeersovertreding.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verkeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>geflitste</w> automobilist kreeg twee weken later een flinke boete in de brievenbus.",
                            "target_lang_translations": {
                                "en": "The <w>flashed</w> motorist received a hefty fine in the mailbox two weeks later."
                            }
                        },
                        {
                            "text": "Een <w>geflitste</w> hardrijder reageerde zijn woede af door de camera langs de weg te vernielen.",
                            "target_lang_translations": {
                                "en": "A <w>caught</w> speeder took out his anger by destroying the camera along the road."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geflitste automobilist",
                        "geflitste hardrijder"
                    ],
                    "target_lang_definitions": {
                        "en": "Photographed by a speed camera due to a traffic violation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "caught on camera",
                                "target_lang_sense_clarification": "by a speed trap"
                            },
                            {
                                "target_lang_word": "flashed",
                                "target_lang_sense_clarification": "by a speed camera"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1a360ca-2437-3414-a9c7-c1f1681c2d52",
                    "sense_definition": "Gemaakt met behulp van een kunstmatige lichtflits bij het fotograferen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fotografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fotograaf gaf de voorkeur aan natuurlijk licht boven <w>geflitste</w> beelden.",
                            "target_lang_translations": {
                                "en": "The photographer preferred natural light over <w>flash</w> images."
                            }
                        },
                        {
                            "text": "Veel van zijn zwart-witportretten zijn nooit <w>geflitst</w> om de sfeer te behouden.",
                            "target_lang_translations": {
                                "en": "Many of his black-and-white portraits were never <w>taken with flash</w> to preserve the atmosphere."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nooit geflitst"
                    ],
                    "target_lang_definitions": {
                        "en": "Taken using an artificial flash during photography."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flash",
                                "target_lang_sense_clarification": "referring to a photo taken with flash"
                            },
                            {
                                "target_lang_word": "with flash",
                                "target_lang_sense_clarification": "using artificial light"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef009f10-7639-306f-890d-ec5d4ebac154",
                    "sense_definition": "voltooid deelwoord van <w>flitsen</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto is gisteren op de snelweg <w>geflitst</w> omdat hij te hard reed.",
                            "target_lang_translations": {
                                "en": "The car was <w>caught on camera</w> on the highway yesterday because it was speeding."
                            }
                        },
                        {
                            "text": "Er is tijdens het onweer regelmatig een felle lichtstraal door de kamer <w>geflitst</w>.",
                            "target_lang_translations": {
