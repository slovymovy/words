                                "target_lang_word": "разливное",
                                "target_lang_sense_clarification": "о напитках"
                            },
                            {
                                "target_lang_word": "бочковое",
                                "target_lang_sense_clarification": "о пиве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23413334-79ae-3cff-81cf-81873eca5da5",
