                {
                    "sense_id": "f2b19693-33ef-397b-a64b-f70434bc4c2b",
                    "sense_definition": "Akustisches Warngerät, das einen weithin hörbaren Ton zur Alarmierung aussendet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "akustisches_signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Nacht heulte plötzlich die <w>Sirene</w> und weckte die ganze Stadt."
                        },
                        {
                            "text": "Sobald die <w>Sirenen</w> ertönten, suchten alle Menschen sofort Schutz in den Gebäuden."
                        }
                    ],
                    "common_phrases": [
                        "die Sirene heult",
                        "eine Sirene ertönt"
                    ]
                },
                {
                    "sense_id": "e1b8897c-fa80-3dd3-9d47-6203e836e3fe",
                    "sense_definition": "Weibliches Fabelwesen der antiken Mythologie, das Seefahrer mit betörendem Gesang anlockt und ins Verderben stürzt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der griechischen Sage ließ sich Odysseus an den Mast binden, um den Gesang der <w>Sirenen</w> zu hören."
                        },
                        {
                            "text": "Die Seeleute fürchteten die gefährlichen <w>Sirenen</w>, weil ihre Stimmen Schiffe auf Felsen lockten."
                        }
                    ],
                    "common_phrases": [
                        "der Gesang der Sirenen"
                    ]
                },
                {
                    "sense_id": "35af422a-fa6f-3f58-ac07-94343141ae84",
                    "sense_definition": "Angehöriger einer Familie aalförmiger, im Wasser lebender Schwanzlurche mit Vorderbeinen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Zoologie bezeichnet man diese seltenen nordamerikanischen Armmolche als <w>Sirenen</w>."
                        },
                        {
                            "text": "Biologen untersuchten die Lebensweise der großen <w>Sirene</w> in schlammigen Gewässern."
                        }
                    ]
                },
                {
                    "sense_id": "913363cd-78bf-3022-893a-84da2a700d30",
                    "sense_definition": "Veraltete Nebenform von <w>Syringe</w> (Flieder).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In einem alten Gartenbuch wurde der Fliederstrauch noch als weiße <w>Sirene</w> bezeichnet."
                        },
                        {
                            "text": "Der historische Text beschreibt ausführlich den lieblichen Duft einer blühenden <w>Sirene</w>."
                        }
                    ],
                    "traits": [
                        {
