                "senses": [
                    {
                        "sense_id": "9239dad1-8ba8-3cb9-964f-09c605fc20fe",
                        "entry_id": "5d91c661-9138-37ac-a607-c1da279e164d",
                        "glosses": [
                            "Lokomotivführerin"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "41914c91-666b-48e6-a09d-107c432ddff4",
                                "sense_id": "9239dad1-8ba8-3cb9-964f-09c605fc20fe",
                                "text": "„Die 18-jährige Tirolerin Marina Knabl, die kürzlich die Lokführerprüfung bestanden hat, ist eine von 33 Lokführerinnen und zudem die Jüngste unter den 4.300 Berufskollegen bei den ÖBB, gab das Unternehmen am Donnerstag bekannt.“"
                            },
                            {
                                "example_id": "4dbe7d53-7d03-485d-af69-9baec72aeed2",
                                "sense_id": "9239dad1-8ba8-3cb9-964f-09c605fc20fe",
                                "text": "„Vielleicht würde sie Kampfpilotin werden. Lokführerin brachte nichts, denn die mussten ja gar nicht darüber nachdenken, wohin sie fuhren, ein Zug konnte sich schließlich nicht verfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
