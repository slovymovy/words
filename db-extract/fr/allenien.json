                        "glosses": [
                            "Variante de allénien : relatif à Woody Allen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df96a11-8c87-464f-a981-8d8efad081d2",
                                "sense_id": "3b26b258-6137-347d-b89e-ef2efb3ae657",
                                "text": "Gil Pender (Owen Wilson, plus «allenien» que jamais) va se marier avec une jolie bourgeoise new-yorkaise, passe quelques jours à Paris, invités par les riches parents de la donzelle sur le point de conclure une importante affaire financière."
                            },
                            {
                                "example_id": "a94c0ba2-a784-4051-958f-2cff486681dd",
                                "sense_id": "3b26b258-6137-347d-b89e-ef2efb3ae657",
                                "text": "Sous le signe, à la fois, de Shakespeare et d’Ingmar Bergman, cette comédie où l’érotisme est fort discret est, pourtant, délicieuse d’esprit très allenien."
                            }
                        ]
                    }
