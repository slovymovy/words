                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc95b6da-4552-4c71-baa1-2cc8ab78aaff",
                                "sense_id": "56c7725e-6d2e-330f-9d62-73a3a73bffdd",
                                "text": "Cette description correspond très bien à celle des amphibolo-pyroxénites que l'on rencontre, au sein des migmatites, dans la partie Ouest du panneau de Dabakala (carte hors-texte I), y compris pour le diopside qui a également tendance à s'y rétromorphoser."
                            },
                            {
                                "example_id": "63fd3619-2e6d-4332-9742-15bc203d06ca",
                                "sense_id": "56c7725e-6d2e-330f-9d62-73a3a73bffdd",
                                "text": "Cette tectonique a été assez forte pour replisser partiellement certaines formations et les rétromorphoser (micaschistes d'Aouinat et Mis)."
                            }
                        ]
                    }
