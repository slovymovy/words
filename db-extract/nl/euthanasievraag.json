                        "sense_id": "13c670bb-6d69-371c-ae9e-a04549a757a7",
                        "entry_id": "917f1728-4d5b-3cd0-abcb-fe31cc4db866",
                        "glosses": [
                            "verzoek van een patiënt voor actieve levensbeëindiging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15130338-9658-45cc-a586-14934fb52a0b",
                                "sense_id": "13c670bb-6d69-371c-ae9e-a04549a757a7",
                                "text": "Frank Van den Bleeken heeft aan zijn advocaat gezegd dat hij zich belazerd voelt en dat zijn euthanasievraag weer zeer actueel wordt. \"Dat is het onvermijdelijke gevolg van wat hij gisteren te horen heeft gekregen\", zei de advocaat, Jos Vander Velpen tegen het Belgische persbureau Belga."
                            },
                            {
                                "example_id": "7026e3f6-ad03-4058-b1b9-0e329368f06d",
                                "sense_id": "13c670bb-6d69-371c-ae9e-a04549a757a7",
                                "text": "\"Ik vermoed dat hij alsnog zal meewerken om naar Nederland te gaan, maar hij zal zijn euthanasievraag niet opgeven\", zegt Van Der Velpen."
                            },
                            {
                                "example_id": "09ecb9cc-0022-41fc-b06d-6e76d895b496",
                                "sense_id": "13c670bb-6d69-371c-ae9e-a04549a757a7",
                                "text": "De mobiele teams van de levenseindekliniek beoordelen volgens de KNMG de euthanasievraag zonder naar de ziektegeschiedenis van de patiënt te kijken. In het ergste geval zouden daardoor mensen euthanasie kunnen krijgen terwijl zij op andere wijze hadden kunnen worden geholpen."
                            }
                        ]
                    }
