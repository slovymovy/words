                                        "sense_id": "b5aa798b-6e66-347e-8b64-f6b6b1f0fa25",
                                        "entry_id": "f2300e7a-a3c0-36ea-8f83-bea6a016991c",
                                        "glosses": [
                                            "An act of bluffing; a false expression of the strength of one’s position in order to intimidate or deceive; braggadocio."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
