                "senses": [
                    {
                        "sense_id": "9bf8fd0b-a7a4-3785-9381-99dad2543162",
                        "entry_id": "f98bbac4-2b80-32c5-9fa2-1c994bc5831a",
                        "glosses": [
                            "Rendre pathétique, présenter de façon à ce que ça paraisse pathétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee52538b-fbc2-4054-8892-3461924d82b0",
                                "sense_id": "9bf8fd0b-a7a4-3785-9381-99dad2543162",
                                "text": "Quant à l'accusation que vous lui portez de pathétiser le cas du condamné en en faisant un type sympathique, je ne suis pas du tout d'accord."
                            },
                            {
                                "example_id": "a161105b-b84e-4638-86d4-96116af02002",
                                "sense_id": "9bf8fd0b-a7a4-3785-9381-99dad2543162",
                                "text": "II a besoin, lui, de pathétiser."
                            },
                            {
                                "example_id": "d99b82ae-a692-4936-bd82-4f96bb5f7154",
                                "sense_id": "9bf8fd0b-a7a4-3785-9381-99dad2543162",
                                "text": "Puis les Russes sont au pouvoir : en duo de violoncelle (Alexander Kniazev) et piano (Nikolaï Lugansky ) pour Chopin, les Fantasiestücke de Schumann et la Sonate de Franck, en glorieux finale avec le Philharmonique de Russie (Dmitri Liss) qui \"pathétise\" dans la 6ᵉ de Tchaikovsky et néo-romantise avec Mikhaïl Rudy dans le 1ᵉʳ de Tchaikovski et le 2ᵉ de Rachmaninov."
                            }
                        ]
                    }
