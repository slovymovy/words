                "senses": [
                    {
                        "sense_id": "cd0025f9-5f27-3ac8-b44a-b321db042d35",
                        "entry_id": "3880706a-772a-3545-af69-ebead764ec28",
                        "glosses": [
                            "violetter Likör mit Veilchenaroma (gewonnen aus mazerierten Veilchenblüten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d70465dd-a6e4-415a-9e51-69f5c037dc2a",
                                "sense_id": "cd0025f9-5f27-3ac8-b44a-b321db042d35",
                                "text": "„Sogar Veilchenliköre wie ‚Crème Yvette‘, ‚Crème de Violette‘ oder ‚Parfait Amour‘ erleben in jüngster Zeit eine Renaissance.“"
                            },
                            {
                                "example_id": "de8a4989-d59d-4fb3-bc2c-e227f089f39f",
                                "sense_id": "cd0025f9-5f27-3ac8-b44a-b321db042d35",
                                "text": "„Doch auch bei der neuen Generation geht es weniger um Geschmackserlebnisse als um den optischen Reiz – oder glaubt jemand, dass ein ‚Baseball‘ aus Himbeergeist, Crème de Cassis, rotem Curaçao, gelbem und grünem Chartreuse, Veilchenlikör, Kümmel und Cognac etwas anderes verspricht als Kopfschmerzen?“"
                            },
                            {
                                "example_id": "2772dc7c-d84f-4c59-a4d0-4d762fbd1484",
                                "sense_id": "cd0025f9-5f27-3ac8-b44a-b321db042d35",
                                "text": "„Der Aviation ist ein ganz besonderer Drink für Gin-Liebhaber. […] Dieses Abstimmen von Veilchenlikör, Maraschino und Zitrone mit dem richtigen Gin hat schon so manchen Bartender zur Verzweifelung gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
