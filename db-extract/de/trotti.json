                        "examples": [
                            {
                                "example_id": "53d7e161-d4c7-4b9b-af2f-2c37e94f864d",
                                "sense_id": "fe251dc6-dd48-30bc-864c-d2dfefc7d31d",
                                "text": "Mangold bog um eine Kurve. 20 Meter vor ihr lag ein Trotti auf der Straße, daneben Rieder, der sich aufgesetzt hatte und sein rechtes Knie hielt. Knapp vor ihm brachte sie ihr Gefährt zum Stillstand, Zollinger hinter ihr gelang es ebenfalls."
                            },
                            {
                                "example_id": "b68e0cbc-1345-468b-b38a-c129447b2574",
                                "sense_id": "fe251dc6-dd48-30bc-864c-d2dfefc7d31d",
                                "text": "Wir mieteten während dieser Zeit das Trottinett, das uns so gefiel. Hannes probierte es ohne Probleme aus. Er war begeistert und schrieb in sein Tagebuch: „Neues Trotti gefahren! Doch es ist viel anders als mein früheres: bessere Räder, Lenkstange und Arretierung!“"
                            }
                        ]
                    }
