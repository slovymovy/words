                        "translation_id": "81b7366e-54c6-4bdc-a3c0-a204be47bde4",
                        "source_entry_id": "297e7de3-e2d2-3c78-b32c-c4a90be1ee31",
                        "source_sense_id": "a46fd954-1062-33c9-ac10-89f278ef834e",
                        "source_sense_description": "artificial cloud from jet aircraft",
                        "target_lang_word": "Kondensstreifen",
