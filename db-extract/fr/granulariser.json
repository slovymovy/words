                "senses": [
                    {
                        "sense_id": "faa4f32b-ecbe-3505-bb19-80b022f3e0f0",
                        "entry_id": "80c94813-877c-3ae6-81ad-d65d1fa59230",
                        "glosses": [
                            "Découper en grains autonomes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19ae60cf-318c-449e-be8a-ad427c7e3cc7",
                                "sense_id": "faa4f32b-ecbe-3505-bb19-80b022f3e0f0",
                                "text": "Granulariser les savoirs consiste à découper les apprentissages en grains pédagogiques autonomes."
                            },
                            {
                                "example_id": "1bea8e96-09a9-42af-9916-6a39a83d7049",
                                "sense_id": "faa4f32b-ecbe-3505-bb19-80b022f3e0f0",
                                "text": "Granulariser la formation, c'est découper le contenu d'une matière en de nombreux items afin de pouvoir les combiner dans des parcours pédagogiques différents en fonction du niveau et des attentes de chaque apprenant."
                            },
                            {
                                "example_id": "33759041-2913-417b-8686-3c6973c41637",
                                "sense_id": "faa4f32b-ecbe-3505-bb19-80b022f3e0f0",
                                "text": "Mais attention, granulariser la formation ne consiste pas en une simple opération technique visant à découper les contenus existants."
                            }
                        ]
                    }
