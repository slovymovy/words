                            {
                                "example_id": "71ed1405-2432-4399-9283-43e8f8340f98",
                                "sense_id": "dae10c1d-1998-3ab7-92e7-a792ee3c987e",
                                "text": "La composition des recrûs est un bon indicateur du dosage de lumière et de la pression du gibier."
                            },
                            {
                                "example_id": "c897c323-458e-46b2-ab9a-c0fcae1ffe12",
                                "sense_id": "dae10c1d-1998-3ab7-92e7-a792ee3c987e",
                                "text": "L'essouchage, qui serait au demeurant très laborieux, n’est pas pratiqué, de façon à permettre un recrû rapide de la forêt après une ou quelques années de culture."
                            },
                            {
                                "example_id": "7f5a3e61-2d42-4900-87a2-a4ef96cf49d7",
                                "sense_id": "dae10c1d-1998-3ab7-92e7-a792ee3c987e",
                                "text": "Ce principe doit être étendu aux plantations de chêne éduquées en présence d’un recrû ligneux."
                            }
                        ]
                    }
                ],
