                "senses": [
                    {
                        "sense_id": "1e1d58e4-45f1-38e3-b298-ba023c0a9966",
                        "entry_id": "c86045a0-f4d6-3d04-9268-6ed5efb9e251",
                        "glosses": [
                            "Liste, die alle Lehrveranstaltungen einer Hochschule, einer Fakultät oder eines Institutes in einem Semester enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d80c1aa9-93d4-45fa-b8bd-a0c108664fa4",
                                "sense_id": "1e1d58e4-45f1-38e3-b298-ba023c0a9966",
                                "text": "Die Veranstaltung war nicht im Vorlesungsverzeichnis enthalten, daher kam nur eine Handvoll Studenten."
                            },
                            {
                                "example_id": "224e8ce9-e422-468e-9690-aa61f27e12bb",
                                "sense_id": "1e1d58e4-45f1-38e3-b298-ba023c0a9966",
                                "text": "„Die Hochschule ist außerdem verpflichtet, die Lehrveranstaltung in den Lehrplan aufzunehmen und im Vorlesungsverzeichnis anzukündigen.“"
                            },
                            {
                                "example_id": "b44e99e6-4004-48e2-8f22-08fa58a07f10",
                                "sense_id": "1e1d58e4-45f1-38e3-b298-ba023c0a9966",
                                "text": "„Wird ein Universitäts(Hochschul)assistent zur Mitwirkung an Lehrveranstaltungen eines Universitäts(Hochschul)professors oder eines Universitäts(Hochschul)dozenten herangezogen, ist er im Vorlesungsverzeichnis namentlich anzuführen.“"
                            },
                            {
                                "example_id": "ca43288e-af08-4479-94d5-5807164cf604",
                                "sense_id": "1e1d58e4-45f1-38e3-b298-ba023c0a9966",
                                "text": "„Im Vorlesungsverzeichnis für Schüler werden Veranstaltungen aufgeführt, die einen guten Einblick in das jeweilige Fach bieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
