                            {
                                "example_id": "72ffb787-9cbe-4a6f-893f-468d83a872c8",
                                "sense_id": "170e1f03-b563-3ac0-b6f7-7c2ea85ebc8f",
                                "text": "гонял на велике и неслабо навернулся"
