                "senses": [
                    {
                        "sense_id": "b55a3cc4-8425-3ee3-9cf0-9676265895e5",
                        "entry_id": "543d15c8-a88e-3145-98c7-6ec195bbd1ca",
                        "glosses": [
                            "bepaald soort zoetwaterroofvis, Sander lucioperca"
