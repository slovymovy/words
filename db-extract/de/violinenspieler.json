                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3382523e-a409-4d01-baad-3208dd84aa07",
                                "sense_id": "9a73951a-fd8e-3347-9a3f-426fc3202694",
                                "text": "„Er erzählte mir, die Musik stamme von einem alten deutschen Violinenspieler, einem merkwürdigen stummen Mann, der mit dem Namen Erich Zann unterschrieb und des Abends in einem billigen Theaterorchester geigte; er fügte hinzu, dass Zanns Wunsch, nachts nach seiner Rückkehr aus dem Theater zu spielen, der Grund dafür sei, dass er dieses hoch gelegene und abgeschiedene Mansardenzimmer für sich gewählt habe, dessen Giebelfenster die einzige Stelle in der Straße sei, von der aus man über die Mauer hinweg auf den Abhang und das Panorama dahinter blicken könne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
