            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f463a789-4f67-3811-9d92-8545fdb535db",
                    "sense_definition": "Qui fait preuve d'une grande sévérité, d'une grande rigueur dans ses exigences ou son comportement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce professeur est très <w>strict</w> avec ses élèves sur la ponctualité."
                        },
                        {
                            "text": "Ses parents sont particulièrement <w>stricts</w> concernant les sorties en soirée."
                        }
                    ],
                    "synonyms": [
                        "sévère",
                        "exigeant",
                        "intransigeant",
                        "rigide"
                    ],
                    "antonyms": [
                        "indulgent",
                        "tolérant",
                        "permissif",
                        "souple"
                    ],
                    "common_phrases": [
                        "parents stricts",
                        "professeur strict"
                    ]
                },
                {
                    "sense_id": "463c4de7-05c9-352b-8ed5-d156704e121b",
                    "sense_definition": "Qui doit être respecté sans exception ; rigoureux ou étroitement délimité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "regle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur exige le <w>strict</w> respect des consignes de sécurité."
                        },
                        {
                            "text": "Au sens <w>strict</w>, cette mesure ne s'applique qu'aux adultes."
                        }
                    ],
                    "synonyms": [
                        "rigoureux",
                        "draconien",
                        "étroit"
                    ],
                    "antonyms": [
                        "large",
                        "approximatif",
                        "souple"
                    ],
                    "common_phrases": [
                        "au sens strict",
                        "strict respect",
                        "stricte vérité",
                        "stricte surveillance"
                    ]
                },
                {
                    "sense_id": "9cfeb312-36b6-34a0-ba0a-3aa8a8bf98a1",
                    "sense_definition": "En mathématiques, qui exclut formellement le cas d'égalité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a rappelé la définition d'une inégalité <w>stricte</w> en cours d'algèbre."
