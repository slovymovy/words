                                        "sense_id": "484ff1cc-6a2c-3b07-8d99-435c98d1f526",
                                        "entry_id": "eeb25dc6-7f91-37ce-8d0b-38d105d3874e",
                                        "glosses": [
                                            "Acting to combat or prevent racism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1a9f940-3bf8-45ff-9627-6a34da3a4063",
                                                "sense_id": "484ff1cc-6a2c-3b07-8d99-435c98d1f526",
                                                "text": "Switzerland’s antiracism legislation has previously been applied to Holocaust denial."
                                            }
