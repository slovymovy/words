                ],
                "senses": [
                    {
                        "sense_id": "ac2c258a-6d03-3990-bd8d-051eac76190b",
                        "entry_id": "5cd083eb-4461-37b5-91ea-0dcf526ed485",
                        "glosses": [
                            "Se soigner complètement, guérir."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f6ae5cf7-f070-4349-b519-df94f5af067c",
                                "sense_id": "ac2c258a-6d03-3990-bd8d-051eac76190b",
                                "text": "Ça pouvait durer cinq piges, même avec les grâces, les remises et tout ! J’allais, fatal, me remouiller pendant ce temps, requimper à mon tour, peut-être ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "de2863c8-c272-3613-8c58-90b453e664a6",
                        "entry_id": "5cd083eb-4461-37b5-91ea-0dcf526ed485",
                        "glosses": [
                            "Soigner quelqu’un."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7e8d2217-7ce8-4894-bec0-d6731a8a4de0",
                                "sense_id": "de2863c8-c272-3613-8c58-90b453e664a6",
                                "text": "Vous devez le requimper avant que ça n’empire ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f2203ef5-88d7-38c1-b8fb-bffd041805f0",
                        "entry_id": "5cd083eb-4461-37b5-91ea-0dcf526ed485",
                        "glosses": [
                            "Se rétablir après une maladie."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "175bfca4-82b6-45ec-a996-87f0f8e75f96",
                                "sense_id": "f2203ef5-88d7-38c1-b8fb-bffd041805f0",
                                "text": "Je me requimperais beaucoup mieux si j’étais chez moi plutôt qu’à l’hôpital."
                            }
                        ]
                    }
