                        "examples": [
                            {
                                "example_id": "80e1ad4e-7a59-4044-b0ff-be5370fcde55",
                                "sense_id": "8e54315f-b179-3398-864f-81935fb370c0",
                                "text": "Hoewel algemeen wordt erkend dat er veel vaardigheid nodig is om een succesvolle schaker te worden, realiseren veel mensen zich niet dat deelname aan competities ook een potentieel lucratieve bezigheid is."
                            }
                        ]
                    },
