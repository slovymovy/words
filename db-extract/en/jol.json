                ],
                "senses": [
                    {
                        "sense_id": "035051ae-914a-3a6d-8e1d-0465486f8437",
                        "entry_id": "4b7304ec-b365-3ed6-87c4-cc48b0d375da",
                        "glosses": [
                            "A barren limestone plateau on the southern Arabian peninsula."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "8228235c-5554-40f2-aa17-51a647c5b61e",
                                "sense_id": "035051ae-914a-3a6d-8e1d-0465486f8437",
                                "text": "The old crystalline hills of the ‘Asir and Yemen, which to the west drop in a series of steps to the Tihamah or coastal plain, are to the east overlain by near horizontal strata of sedimentary rocks of which the oldest are probably the sandstones forming the Kaukab plateau and the newest, excluding recent deposits, are the Eocene limestones of the jol, the succession seeming more complete in the north."
                            },
                            {
                                "example_id": "c640ec25-b2e7-432c-b05f-f6fec42ad08d",
                                "sense_id": "035051ae-914a-3a6d-8e1d-0465486f8437",
                                "text": "An extensive, barren desert plateau, around 1,000-1,200 m in elevation, the jol, extends eastwards from Shabwa, dropping away northwards to the sands of the Rub al Khali."
                            }
                        ]
                    }
                ],
