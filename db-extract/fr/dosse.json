                                    }
                                ]
                            },
                            {
                                "target_word": "slab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54be452e-99e9-3dd5-ab03-a1ea50bb8848",
                                        "entry_id": "a5778fde-bf23-3750-b24c-10982141199d",
                                        "glosses": [
                                            "Mud, sludge, or other viscous matter."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dee7ff37-f1ab-4e98-bfb3-38b236f0faf5",
                                                "sense_id": "54be452e-99e9-3dd5-ab03-a1ea50bb8848",
                                                "text": "Some do also plant oziers in their eights, like quick-sets, thick, and (near the water) keep them not more than half a foot above ground; but then they must be diligently cleansed from moss, slab, and ouze, and frequently prun'd (especially the smaller spires) to form single shoots;[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
