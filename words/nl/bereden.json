                    "frequency": "Middle",
                    "semantic_group_id": "berijden_vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het jonge paard werd voor het eerst door een ervaren ruiter <w>bereden</w>.",
                            "target_lang_translations": {
                                "de": "Das junge Pferd wurde zum ersten Mal von einem erfahrenen Reiter <w>geritten</w>."
                            }
                        },
                        {
                            "text": "De paden in dit bos zijn al eeuwenlang door ruiters <w>bereden</w>.",
                            "target_lang_translations": {
                                "de": "Die Wege in diesem Wald werden seit Jahrhunderten von Reitern <w>bereist</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
