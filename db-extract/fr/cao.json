                    {
                        "sense_id": "0f1dbbf1-254f-3f95-8f02-9f8da17bdd12",
                        "entry_id": "8479ad54-d99f-34d5-a583-c902bffd6c8d",
                        "glosses": [
                            "Commission d’appel d’offres, instance impliqué dans l’attribution des marchés publics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f7b9eae-3f83-4c62-9d51-049a57ba69ee",
                                "sense_id": "0f1dbbf1-254f-3f95-8f02-9f8da17bdd12",
                                "text": "Première interprétation : pour une consultation unique allotie, le rôle de la CAO est déterminé par le montant global des lots (attribution par la CAO si le montant global des lots est supérieur ou égal aux seuils européens\nDeuxième interprétation : pour une consultation unique allotie, le rôle de la CAO est déterminé en fonction de chaque lot. Dans ce cas pour les lots d’un montant supérieur ou égal aux seuils européens, la CAO est compétente ; pour les lots d’un montant inférieur, soit la CAO délivre un simple avis ; soit elle n’intervient pas."
                            }
                        ]
                    }
