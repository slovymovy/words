                ],
                "senses": [
                    {
                        "sense_id": "a3bb6654-a9a5-33b8-9b81-dce30ae8352c",
                        "entry_id": "1d045799-da7c-34d2-96c3-45387a4612d6",
                        "glosses": [
                            "die Sonne in der Art, wie sie im Sommer scheint"
                        ],
                        "tags": [
                            "Wetter"
                        ],
                        "examples": [
                            {
                                "example_id": "3d52f5f2-623a-47e3-9d47-76c6f4a454fe",
                                "sense_id": "a3bb6654-a9a5-33b8-9b81-dce30ae8352c",
                                "text": "„Der Nebel wird währenddessen dünner, und schließlich erstrahlt Islands Sommersonne.“"
                            },
                            {
                                "example_id": "75f32fef-08d5-44be-a319-d58df6ebd089",
                                "sense_id": "a3bb6654-a9a5-33b8-9b81-dce30ae8352c",
                                "text": "„Als sie aus dem kühlen Schatten des Kiefernwäldchens treten, trifft sie das grelle Licht und die Hitze der Sommersonne wie ein Keulenhieb.“"
                            },
                            {
                                "example_id": "c7588c80-3e3b-444e-90f4-ee17fa2eb93e",
                                "sense_id": "a3bb6654-a9a5-33b8-9b81-dce30ae8352c",
                                "text": "„Die warmen Strahlen der Sommersonne warfen ein Muster auf den orientalischen Teppich im Flur, als ich am nächsten Morgen die Treppe herunterkam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
