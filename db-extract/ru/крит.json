                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b126bad-d558-471b-a555-458a918ad782",
                        "source_entry_id": "540fd135-59ed-3052-b471-0b70228adf32",
                        "source_sense_id": "340d1e4a-58f1-3515-8374-976207216659",
                        "target_lang_word": "Kreta",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreta",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4ac4ab2-04bd-3ce2-8341-078be1a9c1ff",
                                        "entry_id": "f2275ebd-b2a4-310a-b5f8-d0a6b90aa0f8",
                                        "glosses": [
                                            "griechische Insel im östlichen Mittelmeer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b55170c-06bf-4e2b-ae44-218ef8d09bab",
                                                "sense_id": "e4ac4ab2-04bd-3ce2-8341-078be1a9c1ff",
                                                "text": "Wer Muße für Geschichte hat, findet auf Kreta Hinterlassenschaften der Byzantiner, Venezianer, Osmanen."
                                            },
                                            {
                                                "example_id": "61baca4a-3e19-43ed-be5c-af06cb70da85",
                                                "sense_id": "e4ac4ab2-04bd-3ce2-8341-078be1a9c1ff",
                                                "text": "Die Saison ist kürzer, als sie sein könnte, was umgekehrt bedeutet, dass Kreta, das ganze Jahr über besuchbar, wieder einer der Geheimtipps Europas geworden ist."
                                            },
                                            {
                                                "example_id": "13bef030-3f5c-4c38-a38c-46f870ea37cf",
                                                "sense_id": "e4ac4ab2-04bd-3ce2-8341-078be1a9c1ff",
                                                "text": "Dann wären da noch die zahllosen Inseln und Inselgruppen: Hervorzuheben sind Korsika und Sizilien mit eher herbem Charme, Zypern und Kreta mit malerischem Ambiente und natürlich die Balearen mit ihrer Hauptinsel Mallorca."
                                            },
                                            {
                                                "example_id": "6e28a308-1fe7-4d13-b92b-f9796612893e",
                                                "sense_id": "e4ac4ab2-04bd-3ce2-8341-078be1a9c1ff",
                                                "text": "„Die schon in der Antike bekannten, vor allem aus Kreta überlieferten Stierspiele […] hatten ursprünglich rituelle Bedeutung.“"
                                            },
                                            {
                                                "example_id": "53a6b34c-ea13-443c-b002-80269453e043",
                                                "sense_id": "e4ac4ab2-04bd-3ce2-8341-078be1a9c1ff",
                                                "text": "„Schon im alten Kreta gab es Stierspiele, und spanische Kampfstiere wurden bereits im Kolosseum im späten Rom bevorzugt.“"
                                            },
                                            {
                                                "example_id": "9a951162-bab6-4698-9742-3d0c57fd9efe",
                                                "sense_id": "e4ac4ab2-04bd-3ce2-8341-078be1a9c1ff",
                                                "text": "Erstmals seien dabei auch jeweils zwei von Katar und Frankreich auf Kreta stationierte Mirage-Jets zum Einsatz gekommen."
                                            },
                                            {
                                                "example_id": "546a60b0-acfe-4d7b-9599-a314b7d4949a",
                                                "sense_id": "e4ac4ab2-04bd-3ce2-8341-078be1a9c1ff",
                                                "text": "Zwei Fähren erreichten am Donnerstag die Hafenstadt Iraklion auf der griechischen Insel Kreta – an Bord: 4600 Chinesen, 30 Thailänder und 30 EU-Bürger."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "029cfcaa-c347-4e42-a2a8-43cfc49905c4",
                        "source_entry_id": "540fd135-59ed-3052-b471-0b70228adf32",
                        "source_sense_id": "340d1e4a-58f1-3515-8374-976207216659",
                        "target_lang_word": "Kreta",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreta",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f38ccb5-b49e-31d4-9462-99e33cbe8cdd",
                                        "entry_id": "5f2ce504-4a21-364b-b1fc-517c7a377755",
                                        "glosses": [
                                            "grecka wyspa na Morzu Śródziemnym"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b6cf373-4773-4391-9377-079d8e119b58",
                                                "sense_id": "6f38ccb5-b49e-31d4-9462-99e33cbe8cdd",
                                                "text": "Zeszłoroczne wakacje spędziliśmy z ciocią Heleną i wujkiem Achillesem na Krecie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "f5473491-87b9-3489-9e98-c92d1e1a3d30",
                                        "entry_id": "5f2ce504-4a21-364b-b1fc-517c7a377755",
                                        "glosses": [
                                            "region administracyjny w Grecji ze stolicą w Heraklionie, obejmujący wyspę Kretę (1.1) i pobliskie wysepki"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "837520c8-ee3d-4ac1-9e5c-08142fdeb11d",
                        "source_entry_id": "540fd135-59ed-3052-b471-0b70228adf32",
                        "source_sense_id": "340d1e4a-58f1-3515-8374-976207216659",
                        "target_lang_word": "Crète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Crète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42ef46fd-e7e7-36d8-a61f-1b615fcc86c7",
                                        "entry_id": "989c599d-7d13-31f0-a28d-3d96e34a6c30",
                                        "glosses": [
                                            "Île de la mer Méditerranée et région de Grèce."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4faf8b83-ecad-4eb5-8d21-2d796c2a71fa",
                                                "sense_id": "42ef46fd-e7e7-36d8-a61f-1b615fcc86c7",
                                                "text": "La première supposition est conforme à l’ancienne tradition des Grecs, qui croyaient que l’embrasement d’une forêt décela le fer au sommet du mont Ida, en Crète."
                                            },
                                            {
                                                "example_id": "cc3615c3-cef3-44f2-9a4d-f87b7b849b06",
                                                "sense_id": "42ef46fd-e7e7-36d8-a61f-1b615fcc86c7",
                                                "text": "L’hypothèse la plus prometteuse repose sur une analyse de la politique menée par l’archè athénienne. Elle consiste à envisager un embargo athénien sur le commerce péloponnésien, suffisamment efficace pour interrompre le flux Péloponnèse/Crète/Afrique du Nord au cours d’une période de 60 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "362315d9-7b8a-386e-8979-e49bdf3dc823",
                                        "entry_id": "989c599d-7d13-31f0-a28d-3d96e34a6c30",
                                        "glosses": [
                                            "Région de Grèce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
