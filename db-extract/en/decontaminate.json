                                        "examples": [
                                            {
                                                "example_id": "b53d4c44-1ef0-48a6-968c-2fc5b9a104d0",
                                                "sense_id": "30c49552-6439-30d2-8d35-813c319db647",
                                                "text": "Une fois que les eaux souterraines sont polluées, il est difficile et coûteux de les décontaminer."
                                            },
                                            {
                                                "example_id": "765324ad-b963-4d21-9468-8d5d90062bdf",
                                                "sense_id": "30c49552-6439-30d2-8d35-813c319db647",
                                                "text": "Cependant, à cette liste des lieux à décontaminer, il n’est fait aucune mention de la décontamination des végétaux et des animaux."
                                            },
                                            {
                                                "example_id": "00262b0d-2a22-45ba-91bd-f49eed065e35",
                                                "sense_id": "30c49552-6439-30d2-8d35-813c319db647",
                                                "text": "Décontaminer l’enfant le cas échéant."
                                            },
                                            {
                                                "example_id": "1225bca7-cfe2-42fe-9eba-d4eba0317dab",
                                                "sense_id": "30c49552-6439-30d2-8d35-813c319db647",
                                                "text": "Depuis, 11 millions de pieds carrés de terrains répartis entre Anjou et Montréal-Est ont été décontaminés puis achetés en 2017 par le Groupe C. Laganière."
                                            }
                                        ]
