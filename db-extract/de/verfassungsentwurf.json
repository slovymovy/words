                        "examples": [
                            {
                                "example_id": "211e0e2f-07bc-41f0-92b4-b7151ad99fb7",
                                "sense_id": "623f3856-9b46-30c6-9b48-13af7192d6c4",
                                "text": "„Takawira, der von London aus die Vorgänge verfolgt hatte, setzte eine regelrechte Kampagne gegen Nkomo in Gang, der sich erst viele Monate später, am Ende des Jahres 1961, zu einer eindeutigen Ablehnung des Verfassungsentwurfs durchringen konnte.“"
                            },
                            {
                                "example_id": "0da6f740-1b02-44a8-847c-ddcb12f50727",
                                "sense_id": "623f3856-9b46-30c6-9b48-13af7192d6c4",
                                "text": "„Natürlich stieß der Verfassungsentwurf auf Unverständnis.“"
                            },
                            {
                                "example_id": "125aaa5e-c077-4a30-85ee-1ea42b5827fc",
                                "sense_id": "623f3856-9b46-30c6-9b48-13af7192d6c4",
                                "text": "„Im Gegensatz zu den meisten Verfassungsentwürfen, die in der israelisch-jüdischen Bevölkerung diskutiert wurden, wird Israel hier nicht als jüdischer Staat, sondern als Staat aller seiner Bürger aufgefasst.“"
                            }
                        ],
