                "senses": [
                    {
                        "sense_id": "9ab6fb2b-4083-3649-bc8c-aa775865a7c2",
                        "entry_id": "506a1b68-6345-3050-89a6-fb57c5a82097",
                        "glosses": [
                            "płaski pszenny placek z przaśnego (niekwaszonego) ciasta, jadany przez Żydów podczas święta Paschy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e2893e6-b29f-4893-8310-d70997556e82",
                                "sense_id": "9ab6fb2b-4083-3649-bc8c-aa775865a7c2",
                                "text": "Macę przyrządza się wyłącznie z mąki i wody, bez użycia zakwasu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2dd226a-c6b6-4914-9ff4-273c4b62695b",
                        "source_entry_id": "506a1b68-6345-3050-89a6-fb57c5a82097",
                        "source_sense_id": "9ab6fb2b-4083-3649-bc8c-aa775865a7c2",
                        "target_lang_word": "matzo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matzo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                                        "entry_id": "6ff0013e-87ce-3627-968e-bc53d43f6502",
                                        "glosses": [
                                            "Thin, unleavened bread in Jewish cuisine."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b25585ed-bb65-4b3c-9f47-498177ca2aa1",
                                                "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                                                "text": "Matzo is eaten by Jews on Passover."
                                            },
                                            {
                                                "example_id": "3b9d667e-9da5-4e6f-bd96-208552279f76",
                                                "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                                                "text": "Like the Kopelmans, they have a Christmas tree with dreidel ornaments and a menorah, which they light each night. Pham learned to cook matzo ball soup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9966bc04-b6a8-350b-a8ae-e238d3847118",
                                        "entry_id": "6ff0013e-87ce-3627-968e-bc53d43f6502",
                                        "glosses": [
                                            "A piece of the above bread."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc165574-3cd1-4756-af2a-dec201783dc8",
                                                "sense_id": "9966bc04-b6a8-350b-a8ae-e238d3847118",
                                                "text": "[W]hen a Hamas spokesman recently stood by his statement that Jews used the blood of non-Jewish children for their matzos – one of the oldest anti-Semitic canards around – European elites were largely silent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c83159a-78f0-493a-8b2b-6e1b12476a87",
                        "source_entry_id": "506a1b68-6345-3050-89a6-fb57c5a82097",
                        "source_sense_id": "9ab6fb2b-4083-3649-bc8c-aa775865a7c2",
                        "target_lang_word": "maces",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maces",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c180b9ab-64e2-3623-a161-1898573b9870",
                                        "entry_id": "e888fb19-dbf2-346f-bf7c-984cfa902f4b",
                                        "glosses": [
                                            "druh nekvašeného pečiva"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb3c6191-32d6-4819-8ddc-48309058a8c7",
                                                "sense_id": "c180b9ab-64e2-3623-a161-1898573b9870",
                                                "text": "Že totiž každé jiné noci jíme jak kvašený, tak nekvašený chléb, a tuto noc jenom macesy?"
                                            },
                                            {
                                                "example_id": "53e3efe4-c12b-438d-874c-9831f27941c1",
                                                "sense_id": "c180b9ab-64e2-3623-a161-1898573b9870",
                                                "text": "Na stole v stříbrných svícnech planuly svíce a ležely tři macesy, sněhobílým ubrouskem přikryté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d395ef5d-a6d6-46ad-93d2-c9337007cba3",
