                                "example_id": "b38ebb48-7028-4daf-8595-11c55563a32c",
                                "sense_id": "6d533b3f-4b24-384e-a0bd-64cc2d172dba",
                                "text": "„Als ich sie dieser Tage der Herstellerfirma zur Reparatur überbrachte, stand Verachtung im Gesicht des zuständigen Herrn.“"
                            },
                            {
                                "example_id": "d53b9fa3-0006-45eb-bc5c-4bca26d98d6b",
                                "sense_id": "6d533b3f-4b24-384e-a0bd-64cc2d172dba",
                                "text": "„Einerseits muss es die Herstellerfirma freuen, dass ihr Produkt derart bekannt geworden ist, dass es die ganze Gattung benennt.“"
                            }
                        ],
