                        ],
                        "form": "den Schriftzug"
                    },
                    {
                        "form_id": "0c6f2d5c-380d-4e88-bcd4-8b8d96701bb5",
                        "entry_id": "03fc571d-fdbf-3d94-9a59-2ac76231f85c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schriftzüge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2532c9ed-db0b-3339-a759-133a1371b06b",
                        "entry_id": "03fc571d-fdbf-3d94-9a59-2ac76231f85c",
                        "glosses": [
                            "besonderes, persönlich geprägtes Schriftbild eines handschriftliches Textes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e869a12-08ae-4ca7-9d5c-63e1dc15ae71",
                                "sense_id": "2532c9ed-db0b-3339-a759-133a1371b06b",
                                "text": "„Im vorliegenden Fall lässt der nach rechts offene Rundbogen am Beginn des Schriftzuges ohne Weiteres den Buchstaben “C” des Familiennamens der Urheberin (C) erkennen. Aber auch der Rest des Schriftzuges, der mit einer flach ansteigenden, langgezogenen Welle beginnt und mit einem Aufstrich nach links oben endet, ist individuell geprägt und auch nicht von einer derartigen Kürze, dass er nur als Handzeichen oder Paraphe gewertet werden könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0ab7a77b-20e0-3196-9188-168f6cd4ef9d",
                        "entry_id": "03fc571d-fdbf-3d94-9a59-2ac76231f85c",
                        "glosses": [
                            "kurzes, besonders gestaltetes Schriftbild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d1e0f0-b9a2-48d6-a42d-2364bc37db52",
                                "sense_id": "0ab7a77b-20e0-3196-9188-168f6cd4ef9d",
                                "text": "„Der in drei Teile zerlegte fünf Meter lange und 30 Kilogramm schwere Schriftzug war wenige Tage nach der Tat in einem Wald im Norden Polens wiedergefunden worden.“"
                            },
                            {
                                "example_id": "b5f2827c-a70c-4c00-a59e-6921d52b58d0",
                                "sense_id": "0ab7a77b-20e0-3196-9188-168f6cd4ef9d",
                                "text": "„Am Portal des gründerzeitlichen Eckhauses beißt sich ein blauer Schriftzug sehr schön mit dem giftigen Grün der Eingangstür.“"
                            },
                            {
                                "example_id": "84069e79-11f1-4abe-97b5-934091b3af67",
                                "sense_id": "0ab7a77b-20e0-3196-9188-168f6cd4ef9d",
                                "text": "„Aber eigentlich sollte ich den Schriftzug gar nicht lesen können, das Ding sollte eingeklappt sein.“"
                            },
                            {
                                "example_id": "99904ecd-ad8a-4e09-911a-3a36551becfe",
                                "sense_id": "0ab7a77b-20e0-3196-9188-168f6cd4ef9d",
                                "text": "„Im Winter kann man über den Eingängen noch die Schriftzüge erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b89479ca-e7cb-4355-8a55-e4e855079904",
                        "source_entry_id": "03fc571d-fdbf-3d94-9a59-2ac76231f85c",
                        "source_sense_id": "2532c9ed-db0b-3339-a759-133a1371b06b",
                        "source_sense_description": "besonderes, persönlich geprägtes Schriftbild eines handschriftliches Textes",
                        "target_lang_word": "handwriting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handwriting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2c46857-7ee9-36f0-a32a-19b98af6e442",
                                        "entry_id": "9df6fd64-6290-3220-a6a8-528a30191851",
                                        "glosses": [
                                            "The act or process of writing done with the hand, rather than typed or word-processed."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8c73206-74e4-3e11-8e76-dcd0f2ef7f20",
                                        "entry_id": "9df6fd64-6290-3220-a6a8-528a30191851",
                                        "glosses": [
                                            "Text that was written by hand."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f410d292-00f0-38f4-95d6-05b0cdc41ae9",
                                        "entry_id": "9df6fd64-6290-3220-a6a8-528a30191851",
                                        "glosses": [
                                            "The characteristic writing of a particular person."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83981863-a479-49c1-9349-766b296e8e77",
                                                "sense_id": "f410d292-00f0-38f4-95d6-05b0cdc41ae9",
                                                "text": "He took up the letter: well did he know the delicate and graceful handwriting; but he saw that the characters were tremulous, and it had obviously been written at different times."
                                            },
                                            {
                                                "example_id": "42f8fff9-4a88-4227-95b6-2cbd7823e524",
                                                "sense_id": "f410d292-00f0-38f4-95d6-05b0cdc41ae9",
                                                "text": "It was still early in the morning when Elettra brought her a letter, bearing the postmark of the city, and addressed in one of those small, clear handwritings which seem naturally to belong to scholars and students."
                                            },
                                            {
                                                "example_id": "3645517f-65aa-41a8-81fb-d6e57e490e25",
                                                "sense_id": "f410d292-00f0-38f4-95d6-05b0cdc41ae9",
                                                "text": "In some handwritings of the seventh or eighth century, where the letters have a round form, the substitution of OT for EG would be far from difficult."
                                            },
                                            {
                                                "example_id": "8d331cc3-b08d-4356-9503-ab67f636c9c8",
                                                "sense_id": "f410d292-00f0-38f4-95d6-05b0cdc41ae9",
                                                "text": "Great libraries are only just beginning to gather up the manuscript minutiae which their books contain; to identify handwritings; to decipher monograms; to collect facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b255de53-0ca2-30d2-859e-4ea755f0dd1a",
                                        "entry_id": "9df6fd64-6290-3220-a6a8-528a30191851",
                                        "glosses": [
                                            "A characteristic trait or hallmark by which somebody may be recognised."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f218ca6-51ef-4aac-92fc-4f0e35935e17",
                                                "sense_id": "b255de53-0ca2-30d2-859e-4ea755f0dd1a",
                                                "text": "And, my friend believes, Armedov is getting paid by...? Yes, our friends at Langley! CIA handwriting all over it, he reckons!"
                                            },
                                            {
                                                "example_id": "3c7da428-b789-466f-8306-a0bec1f5f2ae",
                                                "sense_id": "b255de53-0ca2-30d2-859e-4ea755f0dd1a",
                                                "text": "The show needs to portray the designer's handwriting but it should also be innovative too."
                                            }
                                        ]
                                    }
                                ]
                            },
