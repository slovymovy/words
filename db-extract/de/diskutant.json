                ],
                "senses": [
                    {
                        "sense_id": "bf00ea83-1d5e-33a4-b5db-bea8276fca64",
                        "entry_id": "315cfa44-38cd-39c3-8736-765656e8c9c7",
                        "glosses": [
                            "Person, die sich an einer Diskussion beteiligt"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "4127587b-b060-41fe-a093-0a9bc874d765",
                                "sense_id": "bf00ea83-1d5e-33a4-b5db-bea8276fca64",
                                "text": "[Der Ex-Fußballer Mehmet Scholl war] das, was die Engländer einen ‚Pundit‘ nennen – ein Diskutant im Fernsehen, der Teil der Unterhaltungsrunde ist, und auch nicht immer bierernst genommen werden muss."
                            },
                            {
                                "example_id": "81b7db21-770e-46fd-82d2-1f5d08c7064b",
                                "sense_id": "bf00ea83-1d5e-33a4-b5db-bea8276fca64",
                                "text": "„Donald Trump beherrscht ihn perfekt und auch viele Diskutanten in den sozialen Medien: Mit ‚Und was ist mit…?‘ kann man jede Debatte torpedieren und als Sieger hervorgehen. Doch die Strategie des Whataboutism lässt sich auch entlarven.“"
                            },
                            {
                                "example_id": "b3f313da-57f1-4803-a31c-20c52cac5e62",
                                "sense_id": "bf00ea83-1d5e-33a4-b5db-bea8276fca64",
                                "text": "„Denn als nimmermüder Rat- und großzügiger Ideengeber war Schildt im weiten Feld der wissenschaftlichen Gremienarbeit, als Diskutant auf Konferenzen und als Kooperationspartner gefragt und beliebt wie kein zweiter.“"
                            },
                            {
                                "example_id": "6fea3b18-5c68-432f-8886-6702b95ff772",
                                "sense_id": "bf00ea83-1d5e-33a4-b5db-bea8276fca64",
                                "text": "„Er saß in der Mitte, die Diskutanten standen an den Enden der Brücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
