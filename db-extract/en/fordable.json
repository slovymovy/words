                    },
                    {
                        "translation_id": "3f686b84-84c8-4610-b8c5-abe0320119a3",
                        "source_entry_id": "bb411ac2-5ba3-364c-8c89-464d7f011889",
                        "source_sense_id": "fa6bc22e-45ce-36b3-b230-867a0a6aa5ff",
                        "source_sense_description": "able to be forded",
