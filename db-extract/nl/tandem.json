                    {
                        "translation_id": "ec7d53cc-b624-4dec-bc2f-1c7043afde04",
                        "source_entry_id": "2e97b92a-65a4-3d0e-917a-37428a23439d",
                        "source_sense_id": "9b642602-a124-30f6-8311-dd6b77d42c0c",
