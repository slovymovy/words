{
    "word_family": [
        "pilny",
        "pilność",
        "pilnować"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b23e636f-cb55-3cea-b7bb-a602ce191548",
                    "sense_definition": "W sposób wymagający natychmiastowego działania ze względu na upływający czas lub ważność sprawy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz jest <pilnie> potrzebny na oddziale ratunkowym.",
                            "target_lang_translations": {
                                "ru": "В отделении неотложной помощи <w>срочно</w> нужен врач.",
                                "en": "A doctor is <w>urgently</w> needed in the emergency room."
                            }
                        },
                        {
                            "text": "Muszę <pilnie> skontaktować się z rodzicami w bardzo ważnej sprawie.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>срочно</w> связаться с родителями по очень важному делу.",
                                "en": "I need to <w>urgently</w> contact my parents about a very important matter."
                            }
                        }
                    ],
                    "synonyms": [
                        "jak najszybciej",
                        "natychmiast",
                        "niezwłocznie",
                        "bezzwłocznie",
                        "bez zwłoki"
                    ],
                    "common_phrases": [
                        "pilnie potrzebny",
                        "pilnie poszukiwany",
                        "pilnie sprzedam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образом, требующим немедленных действий из-за нехватки времени или важности дела.",
                        "en": "In a manner requiring immediate action due to passing time or importance."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срочно",
                                "target_lang_sense_clarification": "безотлагательно"
                            },
                            {
                                "target_lang_word": "неотложно",
                                "target_lang_sense_clarification": "без промедления"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "urgently",
                                "target_lang_sense_clarification": "requiring immediate attention or action"
                            },
                            {
                                "target_lang_word": "pressing",
                                "target_lang_sense_clarification": "requiring quick action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5075c71b-ccfb-3ce4-9780-fdfd3830dce1",
                    "sense_definition": "Z dużym zaangażowaniem, starannością i pracowitością.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marta <pilnie> przygotowywała się do egzaminu końcowego przez cały tydzień.",
                            "target_lang_translations": {
                                "ru": "Марта всю неделю <w>усердно</w> готовилась к выпускному экзамену.",
                                "en": "Marta was preparing <w>diligently</w> for the final exam all week."
                            }
                        },
                        {
                            "text": "Wszyscy pracownicy <pilnie> wykonywali swoje zadania, aby zadowolić klienta.",
                            "target_lang_translations": {
                                "ru": "Все сотрудники <w>старательно</w> выполняли свои задачи, чтобы удовлетворить клиента.",
                                "en": "All employees carried out their tasks <w>diligently</w> to satisfy the client."
                            }
                        }
                    ],
                    "synonyms": [
                        "pracowicie",
                        "gorliwie",
                        "niestrudzenie"
                    ],
                    "common_phrases": [
                        "pilnie się uczyć",
                        "pilnie pracować",
                        "pilnie notować"
                    ],
                    "target_lang_definitions": {
                        "ru": "С большим усердием, старанием и трудолюбием.",
                        "en": "With great commitment, thoroughness, and industriousness."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усердно",
                                "target_lang_sense_clarification": "с большим старанием"
                            },
                            {
                                "target_lang_word": "прилежно",
                                "target_lang_sense_clarification": "добросовестно, старательно (часто об учебе)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "diligently",
                                "target_lang_sense_clarification": "with careful, persistent effort"
                            },
                            {
                                "target_lang_word": "assiduously",
                                "target_lang_sense_clarification": "with great care and perseverance"
                            },
                            {
                                "target_lang_word": "hard",
                                "target_lang_sense_clarification": "with great energy and effort, e.g., studying or working hard"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1971258-3210-35eb-bcab-aab377d2ae33",
                    "sense_definition": "Z wielkim skupieniem, uwagą i czujnością.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ochroniarz <pilnie> obserwował tłum wchodzący na stadion sportowy.",
                            "target_lang_translations": {
                                "ru": "Охранник <w>пристально</w> наблюдал за толпой, входящей на спортивный стадион.",
                                "en": "The security guard <w>closely</w> watched the crowd entering the sports stadium."
                            }
                        },
                        {
                            "text": "Dzieci <pilnie> słuchały opowieści dziadka o dawnych czasach.",
                            "target_lang_translations": {
                                "ru": "Дети <w>внимательно</w> слушали рассказы дедушки о былых временах.",
                                "en": "The children listened <w>attentively</w> to their grandfather's stories about the old days."
                            }
                        }
                    ],
                    "synonyms": [
                        "uważnie",
                        "bacznie",
                        "czujnie"
                    ],
                    "common_phrases": [
                        "pilnie obserwować",
                        "pilnie śledzić",
                        "pilnie słuchać"
                    ],
                    "target_lang_definitions": {
                        "ru": "С большой сосредоточенностью, вниманием и бдительностью.",
                        "en": "With great concentration, attention, and vigilance."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внимательно",
                                "target_lang_sense_clarification": "сосредоточенно"
                            },
                            {
                                "target_lang_word": "пристально",
                                "target_lang_sense_clarification": "не отрывая глаз, бдительно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "attentively",
                                "target_lang_sense_clarification": "listening or watching with close attention"
                            },
                            {
                                "target_lang_word": "closely",
                                "target_lang_sense_clarification": "observing or monitoring with careful scrutiny"
                            },
                            {
                                "target_lang_word": "carefully",
                                "target_lang_sense_clarification": "paying close attention"
                            }
                        ]
                    }
                }
            ]
        }
    ]
