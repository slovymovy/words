            {
                "entry_id": "7c60b717-40db-37b2-a267-4ddf5e83ca40",
                "word": "stenen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "68213ae0-895e-4af8-a35a-6f999ec2c997",
                        "entry_id": "7c60b717-40db-37b2-a267-4ddf5e83ca40",
                        "tags": [
                            "canonical"
                        ],
                        "form": "[B] stenen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d751e8e8-8d02-3e76-86bd-df8fc4580370",
                        "entry_id": "7c60b717-40db-37b2-a267-4ddf5e83ca40",
                        "glosses": [
                            "uitgeput en klagend (laten) klinken"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a6f3fbd2-ac3c-4802-80d2-9464edece922",
                                "sense_id": "d751e8e8-8d02-3e76-86bd-df8fc4580370",
                                "text": "“Laat mij sterven,” steende hij, “gij weet hoe ik sterf. Vertrek, Winfried, en breng mijn vader het schild!”"
                            },
                            {
                                "example_id": "4c56d1d7-096c-40f6-af75-d90e47ff0fa2",
                                "sense_id": "d751e8e8-8d02-3e76-86bd-df8fc4580370",
                                "text": "Opvallend is eveneens het veelvuldig opwellen uit het voorwerk van vroegere vertalingen van de verzuchtingen over de zware en de moeilijke taak van de vertaler. Inderdaad, de regelmaat waarmede dit zuchten en dit stenen over het lange moeizame werk - dat vertaalwerk ook is - zich voordoen, moet wie ook zelfs slechts enkele van deze voorwoorden of opdrachten of andere liminaria doorbladert, treffen."
                            },
                            {
                                "example_id": "ee88c6d9-1ff8-4b7d-97c3-c72670d7dffb",
                                "sense_id": "d751e8e8-8d02-3e76-86bd-df8fc4580370",
                                "text": "Ergens, verder op, zet Peter de kampeertent in elkaar. (…) Hij lijkt ook wel te stenen. Soms komt het me voor, dat Peter met de kampeertent vecht."
                            }
                        ]
                    }
                ],
