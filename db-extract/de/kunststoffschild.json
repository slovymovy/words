                ],
                "senses": [
                    {
                        "sense_id": "371c983e-b1b4-3427-a421-c0bddc4db50a",
                        "entry_id": "e6355411-2823-3504-8e04-3407d37e79c7",
                        "glosses": [
                            "Räumgerät, Schaufelblatt aus Polymer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40de1cbe-7a00-4d50-a721-9aabff91850c",
                                "sense_id": "371c983e-b1b4-3427-a421-c0bddc4db50a",
                                "text": "„Zum Abrütteln eine Rüttelplatte mit Kunststoffschild verwenden, um Beschädigungen an der Steinoberfläche zu vermeiden.“"
                            },
                            {
                                "example_id": "8a6cfd54-1ff6-4a82-9394-ef8af1dea4e2",
                                "sense_id": "371c983e-b1b4-3427-a421-c0bddc4db50a",
                                "text": "„Schneeschieber mit einem tiefgezogenen, dünnen Kunststoffschild : Sie sind in den meisten Fällen ebenfalls leicht und preiswert.“"
                            },
                            {
                                "example_id": "27c1a960-addd-4cd1-93ea-8f4eba5de44e",
                                "sense_id": "371c983e-b1b4-3427-a421-c0bddc4db50a",
                                "text": "„Der Schneepflug ist in drei Positionen seitlich schwenkbar und besteht aus einem hochwertigen Kunststoffschild mit Stahlschiene.“"
                            },
                            {
                                "example_id": "15a96dce-dd3c-458c-9955-76fa6ac87d9a",
                                "sense_id": "371c983e-b1b4-3427-a421-c0bddc4db50a",
                                "text": "Schneeschaufel, Kunststoffschild mit stabiler Metallkante, Breite: 46 cm, Stiellänge: 131 cm."
                            },
                            {
                                "example_id": "50b68ae1-ee19-4f65-9f8a-b5122ea36121",
                                "sense_id": "371c983e-b1b4-3427-a421-c0bddc4db50a",
                                "text": "Schneeräumschild für alle großen rolly toys Traktoren für den Bauernhof und Unimog. Material: Kunststoff Ausstattungsmerkmale: mit eigener Hubvorrichtung passend an die Frontkupplung oder an den Maxi bzw. rollyTrac Lader in 3 Positionen seitlich verschwenkbar Kunststoffschild mit Stahlschiene Geeignet für Kinder ab ca. 3 Jahren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d3fc8682-c085-3e2c-b711-333b8e4b9aa2",
                        "entry_id": "e6355411-2823-3504-8e04-3407d37e79c7",
                        "glosses": [
                            "Schutzplatte, die man vor den Körper hält, um sich vor Angriffen zu schützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca3634f5-95d5-440f-8540-cd36b7d8d1f7",
                                "sense_id": "d3fc8682-c085-3e2c-b711-333b8e4b9aa2",
                                "text": "Die Dabeistehenden beschimpften die Polizisten, die unter ihren Gasmasken unverständliches zurückbrüllten und in die Masse hineinprügelten. Ein paar Männer traten gegen die Kunststoffschilde."
                            },
                            {
                                "example_id": "68682a83-ff2f-459e-b21f-7e9d94c3314b",
                                "sense_id": "d3fc8682-c085-3e2c-b711-333b8e4b9aa2",
                                "text": "Diese Polizisten aber tragen alle Helme mit Gesichtsschutz und haben vor sich Kunststoffschilde."
                            },
                            {
                                "example_id": "f65ef42b-94dc-4995-843a-b324887a2a88",
                                "sense_id": "d3fc8682-c085-3e2c-b711-333b8e4b9aa2",
                                "text": "Ein gesonderter Gesichtsschutz, Kunststoffschilde und lange Schlagstöcke versetzten die Polizisten in die Lage, die Angriffe der Radikalen besser abzuwehren."
                            },
                            {
                                "example_id": "358b1d1c-e410-4f48-a8c3-d0f741e2af81",
                                "sense_id": "d3fc8682-c085-3e2c-b711-333b8e4b9aa2",
                                "text": "Pflastersteine fliegen, krachen gegen Kunststoffschilde, Polizeiwannen rasen über den Platz, wildes Getümmel, Schlagstock frei! und Tränengas und Husten und Wir kriegen Euch! und plötzlich hat Hermann einen Knüppel im Kreuz."
                            },
                            {
                                "example_id": "473cc2b1-b17b-46fc-96bd-ad2224d5d38c",
                                "sense_id": "d3fc8682-c085-3e2c-b711-333b8e4b9aa2",
                                "text": "Gegen den „Terror“ werden 3000 Kunststoffschilde angeschafft (ca. 300.000 DM). Für 130.000 DM werden extrem lange Schlagstöcke eingekauft."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
