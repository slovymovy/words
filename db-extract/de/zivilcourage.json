                        ],
                        "form": "die Zivilcourage"
                    },
                    {
                        "form_id": "82fbd4e5-9808-4597-aeac-01dff9a619b9",
                        "entry_id": "edb147ba-90dd-3c6a-b3f4-0bbcc6801f7b",
