                    "frequency": "Middle",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son visage reflétait tout le <w>malheur</w> qu'elle ressentait au fond de son cœur."
                        },
                        {
                            "text": "Cette décision injuste a fait le <w>malheur</w> de milliers de personnes."
