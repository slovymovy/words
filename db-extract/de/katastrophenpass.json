                "senses": [
                    {
                        "sense_id": "0c8d8a77-d3af-3ea0-9065-605d48a562e8",
                        "entry_id": "ee8eb433-dbab-3be1-8aad-597a5d6cb9c7",
                        "glosses": [
                            "besonders schlechtes Zuspiel, das gegebenenfalls mit negativen Folgen verbunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f13a0ad-daeb-43b7-b6e8-f24220f7304e",
                                "sense_id": "0c8d8a77-d3af-3ea0-9065-605d48a562e8",
                                "text": "„Nur sieben Minuten später spielte Mehmedi einen Katastrophenpass genau in die Füße von Liberec-Stürmer Rabusic.“"
                            },
                            {
                                "example_id": "8a6ba00c-106e-4fbc-97f3-b324e26d4bbd",
                                "sense_id": "0c8d8a77-d3af-3ea0-9065-605d48a562e8",
                                "text": "„Bei Gefahr sollte der Ball aus dem eigenen Strafraum kompromisslos nach vorn geschlagen werden. Dies war aber ab der 3. Minute vergessen. Da spielte Abwehrrecke Danny Becker am eigenen Strafraum einen Katastrophenpass in die Beine von Björn Stuhlmacher, in dessen Folge Konstantin Gäde das 1:0 erzielte.“"
                            },
                            {
                                "example_id": "6989b86b-615d-4467-9556-2280f921e1d2",
                                "sense_id": "0c8d8a77-d3af-3ea0-9065-605d48a562e8",
                                "text": "„Mit einem Katastrophenpass schenkte Kroos den Schweden den Ball.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
