                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na deser podano truskawki w <w>śmietanie</w>.",
                            "target_lang_translations": {
                                "en": "Strawberries with <w>cream</w> were served for dessert.",
                                "ru": "На десерт подали клубнику со <w>сметаной</w>.",
                                "nl": "Als toetje werden aardbeien met <w>room</w> geserveerd.",
                                "de": "Zum Dessert wurden Erdbeeren in <w>Sahne</w> serviert.",
                                "fr": "Au dessert, on a servi des fraises à la <w>crème</w>.",
                                "it": "Per dessert hanno servito fragole con la <w>panna</w>.",
                                "cs": "Jako dezert se podávaly jahody se <w>smetanou</w>.",
                                "tr": "Tatlı olarak <w>kremalı</w> çilek servis edildi.",
                                "es": "De postre se sirvieron fresas con <w>nata</w>.",
                                "zh": "甜点上的是裹着<w>奶油</w>的草莓。"
                            }
                        },
                        {
                            "text": "Do zupy warto dodać łyżkę kwaśnej <w>śmietany</w>.",
                            "target_lang_translations": {
                                "en": "It is worth adding a tablespoon of sour <w>cream</w> to the soup.",
                                "ru": "В суп стоит добавить ложку кислой <w>сметаны</w>.",
                                "nl": "Het is de moeite waard om een lepel <w>zure room</w> aan de soep toe te voegen.",
                                "de": "Es lohnt sich, der Suppe einen Löffel saure <w>Sahne</w> hinzuzufügen.",
                                "fr": "Il vaut la peine d'ajouter une cuillère de <w>crème fraîche</w> à la soupe.",
                                "it": "Vale la pena aggiungere alla zuppa un cucchiaio di <w>panna acida</w>.",
                                "cs": "Do polévky je dobré přidat lžíci kysané <w>smetany</w>.",
                                "tr": "Çorbaya bir kaşık <w>ekşi krema</w> eklemek iyi olur.",
                                "es": "Vale la pena añadir una cucharada de <w>nata agria</w> a la sopa.",
                                "zh": "在汤里加一勺<w>酸奶油</w>会更好喝。"
                            }
                        }
                    ],
