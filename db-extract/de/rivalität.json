                    {
                        "sense_id": "8b70f6d6-0320-384c-8936-a3050aee8cca",
                        "entry_id": "3463e472-5298-3296-8f6a-4154c5ad1b7b",
                        "glosses": [
                            "das Verhältnis von Rivalen zueinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa448787-e730-498d-9d6f-5a66ddaad6cf",
                                "sense_id": "8b70f6d6-0320-384c-8936-a3050aee8cca",
                                "text": "Es kam zu Rivalitäten in den Grenzbereichen der Straßengangs."
                            },
                            {
                                "example_id": "7ec848d9-a087-4664-8792-ec0f46f3e15c",
                                "sense_id": "8b70f6d6-0320-384c-8936-a3050aee8cca",
                                "text": "„Hinzu kommen die alten Rivalitäten der einheimischen Ethnien.“"
                            },
                            {
                                "example_id": "ade3b196-59c3-46de-a132-e820655e5071",
                                "sense_id": "8b70f6d6-0320-384c-8936-a3050aee8cca",
                                "text": "„In neuer Besetzung und veränderter Inszenierung ging die Rivalität der Mächte weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "daf2f2eb-9c8b-4fe9-b658-31273f2bf609",
                        "source_entry_id": "3463e472-5298-3296-8f6a-4154c5ad1b7b",
                        "source_sense_id": "8b70f6d6-0320-384c-8936-a3050aee8cca",
                        "source_sense_description": "das Verhältnis von Rivalen zueinander",
                        "target_lang_word": "rivalry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rivalry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3137b23f-d895-3081-b499-a56e5d1eb469",
                                        "entry_id": "b60668a8-f631-3024-8a95-97362b4c07fd",
                                        "glosses": [
                                            "An ongoing relationship between (usually two) rivals who compete for superiority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f20a866-438a-4fd9-ab30-353fc20da423",
                                                "sense_id": "3137b23f-d895-3081-b499-a56e5d1eb469",
                                                "text": "The Boston Bruins have a longstanding rivalry with the Montreal Canadiens."
                                            },
                                            {
                                                "example_id": "0c564da6-fb01-4b34-b138-5c07225e9449",
                                                "sense_id": "3137b23f-d895-3081-b499-a56e5d1eb469",
                                                "text": "James and Polly have a bitter rivalry due to the latter's inclusion in the Tea Time Teaser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afbe3e54-2a9a-3a4c-8093-0e7280c6ef2a",
                                        "entry_id": "b60668a8-f631-3024-8a95-97362b4c07fd",
                                        "glosses": [
                                            "The characteristic of being a rivalrous good, such that it can be consumed or used by only one person at a time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8375f248-3633-4e60-9ab9-12d577f975e5",
                                                "sense_id": "afbe3e54-2a9a-3a4c-8093-0e7280c6ef2a",
                                                "text": "Common goods are those which are rivalrous in consumption but non-excludable"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a494a167-4104-3717-8eec-c2ee1201c8af",
                                        "entry_id": "b60668a8-f631-3024-8a95-97362b4c07fd",
                                        "glosses": [
                                            "Any competition between two or more things or factors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fee7c768-4c36-419a-911a-115fc2c4dd27",
                                                "sense_id": "a494a167-4104-3717-8eec-c2ee1201c8af",
                                                "text": "Binocular rivalry is a visual phenomenon in which perception alternates between different images presented to each eye."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d052dd6e-0369-42d7-8a12-57d69f33d2b9",
