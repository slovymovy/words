                        "examples": [
                            {
                                "example_id": "aa7ebe12-133b-4988-8ddf-bdac17d29f2e",
                                "sense_id": "ad419b1d-50c7-3f76-a785-9e0d7502b5a3",
                                "text": "S’il n’y a pas répulsion, il y a au moins inattraction."
                            },
                            {
                                "example_id": "d0968058-9b3d-45f0-9773-72f64b5c83a1",
                                "sense_id": "ad419b1d-50c7-3f76-a785-9e0d7502b5a3",
                                "text": "L’inattraction et la répulsion dont je parle sont de pures généralités, que beaucoup de circonstances peuvent modifier et détruire, telles entre autres, d’une part, l’ardeur du tempérament et l’exaltation du sentiment de la socialité, et, de l’autre, la perfection des formes ou bien de hautes qualités morales ou d’amabilité."
                            }
