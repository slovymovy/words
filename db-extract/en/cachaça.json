                                "sense_id": "db13447d-435d-39e5-8450-511cdeafd510",
                                "text": "A line of ants heads across the table, detouring around the bottle of cachaça that is now empty."
                            },
                            {
                                "example_id": "6113ea32-3308-4c87-aa76-45d19c09acc8",
                                "sense_id": "db13447d-435d-39e5-8450-511cdeafd510",
                                "text": "Neat cachaça put fire in your belly and stilled the pangs of hunger."
                            }
                        ]
