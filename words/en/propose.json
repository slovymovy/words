{
    "word_family": [
        "proposal",
        "proposition",
        "proposer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f8d9237-0d23-3263-8d85-8c02eb4ab633",
                    "sense_definition": "To suggest a plan, course of action, or idea for consideration.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>propose</w> that we take a short break before continuing the meeting.",
                            "target_lang_translations": {
                                "ru": "Я <w>предлагаю</w> сделать небольшой перерыв, прежде чем продолжить собрание.",
                                "tr": "Toplantıya devam etmeden önce kısa bir ara vermeyi <w>öneriyorum</w>."
                            }
                        },
                        {
                            "text": "The committee will <w>propose</w> a new budget plan next week.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>предложит</w> новый план бюджета на следующей неделе.",
                                "tr": "Komite önümüzdeki hafta yeni bir bütçe planı <w>teklif edecek</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "suggest",
                        "put forth",
                        "recommend",
                        "offer"
                    ],
                    "common_phrases": [
                        "propose a plan",
                        "propose a solution",
                        "propose a change",
                        "propose a toast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предлагать план, порядок действий или идею на рассмотрение.",
                        "tr": "Değerlendirilmek üzere bir plan, eylem planı veya fikir öne sürmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предлагать",
                                "target_lang_sense_clarification": "suggest"
                            },
                            {
                                "target_lang_word": "выдвигать",
                                "target_lang_sense_clarification": "put forth an idea"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "teklif etmek",
                                "target_lang_sense_clarification": "plan veya fikir sunmak"
                            },
                            {
                                "target_lang_word": "önermek",
                                "target_lang_sense_clarification": "tavsiye etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6b50a67-9f00-3fd6-90fd-84e06793ff24",
                    "sense_definition": "To ask for a person's hand in marriage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>proposed</w> to her last night and she accepted him immediately.",
                            "target_lang_translations": {
                                "ru": "Он <w>сделал</w> ей <w>предложение</w> вчера вечером, и она сразу же согласилась.",
                                "tr": "Dün gece ona <w>evlenme teklif etti</w> ve o da hemen kabul etti."
                            }
                        },
                        {
                            "text": "He plans to <w>propose</w> to his girlfriend on Valentine's Day.",
                            "target_lang_translations": {
                                "ru": "Он планирует <w>сделать предложение</w> своей девушке в День святого Валентина.",
                                "tr": "Sevgililer Günü'nde kız arkadaşına <w>evlenme teklif etmeyi</w> planlıyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "propose to someone",
                        "propose marriage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Просить чьей-либо руки, предлагать вступить в брак.",
                        "tr": "Birine evlenme teklif etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать предложение",
                                "target_lang_sense_clarification": "marriage"
                            },
                            {
                                "target_lang_word": "просить руки",
                                "target_lang_sense_clarification": "ask for hand"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "evlenme teklif etmek",
                                "target_lang_sense_clarification": "evlilik teklifinde bulunmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5c0a785-f71e-316b-a2a7-4e4f7863326c",
                    "sense_definition": "To intend or plan to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "How do you <w>propose</w> to solve this difficult problem without more resources?",
                            "target_lang_translations": {
                                "ru": "Как вы <w>намереваетесь</w> решить эту сложную проблему без дополнительных ресурсов?",
                                "tr": "Daha fazla kaynak olmadan bu zor sorunu nasıl çözmeyi <w>düşünüyorsunuz</w>?"
                            }
                        },
                        {
                            "text": "The government <w>proposes</w> to cut taxes for small businesses next year.",
                            "target_lang_translations": {
                                "ru": "Правительство <w>намеревается</w> снизить налоги для малого бизнеса в следующем году.",
                                "tr": "Hükümet önümüzdeki yıl küçük işletmeler için vergileri düşürmeyi <w>planlıyor</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "propose to do"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намереваться или планировать сделать что-либо.",
                        "tr": "Bir şeyi yapmayı niyet etmek veya planlamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намереваться",
                                "target_lang_sense_clarification": "intend"
                            },
                            {
                                "target_lang_word": "планировать",
                                "target_lang_sense_clarification": "plan"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "niyet etmek",
                                "target_lang_sense_clarification": "düşünmek, niyetlenmek"
                            },
                            {
                                "target_lang_word": "planlamak",
                                "target_lang_sense_clarification": "tasarlamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c475369d-526a-3d5b-902a-24483ca654f7",
                    "sense_definition": "To talk or converse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests sat in the parlor <w>proposing</w> with one another until late in the evening.",
                            "target_lang_translations": {
                                "ru": "Гости сидели в гостиной, <w>беседуя</w> друг с другом до позднего вечера.",
                                "tr": "Misafirler akşam geç saatlere kadar salonda birbiriyle <w>sohbet ederek</w> oturdular."
                            }
                        },
                        {
                            "text": "She found them <w>proposing</w> quietly in the corner of the room.",
                            "target_lang_translations": {
                                "ru": "Она нашла их тихо <w>беседующими</w> в углу комнаты.",
                                "tr": "Onları odanın köşesinde sessizce <w>konuşurken</w> buldu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Used in older texts like Shakespeare."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговаривать или беседовать.",
                        "tr": "Konuşmak veya sohbet etmek (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беседовать",
                                "target_lang_sense_clarification": "archaic"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sohbet etmek",
                                "target_lang_sense_clarification": "eski dilde konuşmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acc09534-e01a-3f09-bd62-66b298beca4b",
                    "sense_definition": "To set forth or present.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "presentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy cup was <w>proposed</w> brimful of wine for the celebration.",
                            "target_lang_translations": {
                                "ru": "Тяжелый кубок был <w>выставлен</w> полным вина для празднования.",
                                "tr": "Ağır kadeh, kutlama için tepeleme şarapla doldurularak <w>sunuldu</w>."
                            }
                        },
                        {
                            "text": "He <w>proposed</w> his arguments with great vigor and determination.",
                            "target_lang_translations": {
                                "ru": "Он <w>излагал</w> свои аргументы с большой энергией и решимостью.",
                                "tr": "Argümanlarını büyük bir güç ve kararlılıkla <w>ortaya koydu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "put forth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Излагать или представлять.",
                        "tr": "Ortaya koymak veya sunmak (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "излагать",
                                "target_lang_sense_clarification": "set forth"
                            },
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "present"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ortaya koymak",
                                "target_lang_sense_clarification": "sunmak, dile getirmek"
                            },
                            {
                                "target_lang_word": "sunmak",
                                "target_lang_sense_clarification": "arz etmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1b07ea7-57ce-319d-acb6-22b583a86fd7",
                    "sense_definition": "An objective, aim, or purpose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her sole <w>propose</w> in life was to acquire wisdom and understanding.",
                            "target_lang_translations": {
                                "ru": "Её единственной <w>целью</w> в жизни было обретение мудрости и понимания.",
                                "tr": "Hayattaki tek <w>amacı</w> bilgelik ve anlayış edinmekti."
                            }
                        },
                        {
                            "text": "They worked tirelessly to achieve their noble <w>propose</w>.",
                            "target_lang_translations": {
                                "ru": "Они неустанно трудились ради достижения своей благородной <w>цели</w>.",
                                "tr": "Yüce <w>gayelerine</w> ulaşmak için yorulmadan çalıştılar."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Modern English uses 'purpose' or 'proposal'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цель, задача или намерение.",
                        "tr": "Hedef, amaç veya gaye (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "purpose"
                            },
                            {
                                "target_lang_word": "намерение",
                                "target_lang_sense_clarification": "intention"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "amaç",
                                "target_lang_sense_clarification": "hedef, gaye"
                            },
                            {
                                "target_lang_word": "gaye",
                                "target_lang_sense_clarification": "hedef"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}