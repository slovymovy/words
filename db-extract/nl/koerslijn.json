                    },
                    {
                        "translation_id": "bbec0f7e-cb10-48b0-80d2-c86096f1adb4",
                        "source_entry_id": "e36c69d4-652f-3eeb-86ac-d060f2e8b19e",
                        "source_sense_id": "a9ec9382-3851-3130-8021-05c40029d4a1",
                        "source_sense_description": "de uitgezette koers die een vliegtuig / vaartuig zou moeten volgen",
                        "target_lang_word": "vêtement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vêtement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1169bfe6-5ed3-3da5-816d-be40639bd960",
                                        "entry_id": "3eedae8d-fdf8-3b42-8662-003626fe309b",
                                        "glosses": [
                                            "Ce qui sert à se vêtir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccfc7419-77ae-4b12-a937-ba5803ded7dc",
                                                "sense_id": "1169bfe6-5ed3-3da5-816d-be40639bd960",
                                                "text": "Mes tempes battent ; toute ma chair va à cette femme presque nue et charmante dans le matin et dans le transparent vêtement qui enferme la douce odeur d’elle…"
                                            },
                                            {
                                                "example_id": "a3e9dc61-f04f-493b-b095-d4e0cfb97095",
                                                "sense_id": "1169bfe6-5ed3-3da5-816d-be40639bd960",
                                                "text": "Pourquoi porter des chapeaux et des vêtements, quand la pigmentation de la peau est la meilleure défense contre le soleil des tropiques ?"
                                            },
                                            {
                                                "example_id": "e74f9344-8afc-4e8b-a383-240ffa03fe5f",
                                                "sense_id": "1169bfe6-5ed3-3da5-816d-be40639bd960",
                                                "text": "Bernard sourit, hocha la tête et, glorieux de son vêtement coupé dans une étoffe cannelle de mauvais goût, m’offrit une cigarette."
                                            },
                                            {
                                                "example_id": "84226887-012f-44db-bfef-8d5557282acf",
                                                "sense_id": "1169bfe6-5ed3-3da5-816d-be40639bd960",
                                                "text": "Déjà, autour du cadavre, les voisins s’affairaient pour sa dernière toilette. À terre, une bassine d’eau rougie, ses vêtements maculés."
                                            },
                                            {
                                                "example_id": "7b21c548-bcfe-45f7-b68f-7017825d9bba",
                                                "sense_id": "1169bfe6-5ed3-3da5-816d-be40639bd960",
                                                "text": "Entre le travail en usine, le ramendage des filets, l’entretien des vêtements de pêche, la tenue du foyer et les maternités, les femmes de Douarnenez sont des battantes avant la lettre !"
                                            },
                                            {
                                                "example_id": "f604a700-1160-4289-b1df-5ba4789eb0e6",
                                                "sense_id": "1169bfe6-5ed3-3da5-816d-be40639bd960",
                                                "text": "À l’obsolescence technique s’adjoint donc une obsolescence psychologique : un téléphone de deux ans est ringard, un vêtement de six mois est démodé, un écran plat est déjà bien triste face à une télévision 3D."
                                            },
                                            {
                                                "example_id": "f52e5655-3ecc-4c8a-8d61-5b541a777449",
                                                "sense_id": "1169bfe6-5ed3-3da5-816d-be40639bd960",
                                                "text": "Elle était plus que nue. Elle n’avait plus de chapeau, plus de vêtements et plus aucune pudeur. Plutôt que de filer se rhabiller dans la remise située derrière la petite scénette, elle a commencé à avancer en direction du bar…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f65009b-158a-387a-87d1-bfd5f1c6c185",
                                        "entry_id": "3eedae8d-fdf8-3b42-8662-003626fe309b",
                                        "glosses": [
                                            "Pièce formée par quatre triangles, qui couvrent les quatre angles de l'écu, de manière à ne laisser voir du champ que la forme d'une grande losange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cffb16b-d84f-4f59-a21c-f4f94e27c756",
                                                "sense_id": "2f65009b-158a-387a-87d1-bfd5f1c6c185",
                                                "text": "Vêtement émaillé."
                                            },
                                            {
                                                "example_id": "9e02b68a-6d1b-4905-919f-f1cdff2f9eed",
                                                "sense_id": "2f65009b-158a-387a-87d1-bfd5f1c6c185",
                                                "text": "La chape est un vêtement de deux triangles rectangles, formés par les bords de l’écu et par deux lignes menées du milieu du chef à chacun des angles de la pointe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
