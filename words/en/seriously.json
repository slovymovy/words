{
    "word_family": [
        "serious",
        "seriousness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                    "sense_definition": "In a serious or literal manner; not jokingly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was hoping that we would take him <w>seriously</w> and listen to his ideas.",
                            "target_lang_translations": {
                                "ru": "Он надеялся, что мы воспримем его <w>всерьёз</w> и выслушаем его идеи.",
                                "tr": "Onu <w>ciddiye</w> almamızı ve fikirlerini dinlememizi umuyordu.",
                                "zh": "他希望我们能把他<w>当真</w>，并听听他的想法。"
                            }
                        },
                        {
                            "text": "She looked <w>seriously</w> at the map to find the right way home.",
                            "target_lang_translations": {
                                "ru": "Она <w>серьёзно</w> посмотрела на карту, чтобы найти правильный путь домой.",
                                "tr": "Eve giden doğru yolu bulmak için haritaya <w>ciddi bir şekilde</w> baktı.",
                                "zh": "她<w>认真地</w>看着地图，想找到回家的路。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take seriously",
                        "take it seriously"
                    ],
                    "target_lang_definitions": {
                        "ru": "В серьёзной или буквальной манере; не в шутку.",
                        "tr": "Ciddi bir şekilde, şaka yapmadan.",
                        "zh": "以严肃或认真的态度；非开玩笑地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьёзно",
                                "target_lang_sense_clarification": "наречие образа действия"
                            },
                            {
                                "target_lang_word": "всерьёз",
                                "target_lang_sense_clarification": "часто используется с глаголом «принимать»"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cidden",
                                "target_lang_sense_clarification": "ciddi bir biçimde, şaka yapmadan"
                            },
                            {
                                "target_lang_word": "ciddi olarak",
                                "target_lang_sense_clarification": "ciddiyetle"
                            },
                            {
                                "target_lang_word": "ciddiye",
                                "target_lang_sense_clarification": "genellikle \"almak\" fiili ile kullanılır"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "认真地",
                                "target_lang_sense_clarification": "表示态度端正、不马虎"
                            },
                            {
                                "target_lang_word": "严肃地",
                                "target_lang_sense_clarification": "表示神情或语气庄重"
                            },
                            {
                                "target_lang_word": "当真",
                                "target_lang_sense_clarification": "常用于“把……当真”结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfc7795f-2ac5-3971-8615-1eec4f26aa43",
                    "sense_definition": "To a very great degree or extent; gravely or extremely.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver was <w>seriously</w> injured in the car accident yesterday.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>серьёзно</w> пострадал во вчерашней автокатастрофе.",
                                "tr": "Sürücü dünkü trafik kazasında <w>ağır</w> yaralandı.",
                                "zh": "司机在昨天的车祸中<w>严重</w>受伤。"
                            }
                        },
                        {
                            "text": "That was a <w>seriously</w> unpleasant thing to say to your friend.",
                            "target_lang_translations": {
                                "ru": "Это была <w>крайне</w> неприятная вещь, чтобы сказать её другу.",
                                "tr": "Bu, arkadaşına söylenecek <w>son derece</w> nahoş bir şeydi.",
                                "zh": "对你的朋友说那样的话真是<w>极其</w>不妥。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "seriously ill",
                        "seriously injured",
                        "seriously damaged"
                    ],
                    "target_lang_definitions": {
                        "ru": "В очень сильной степени; тяжело или крайне.",
                        "tr": "Çok büyük bir derecede; ciddi veya son derece.",
                        "zh": "在很大程度上；严重地或极度地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьёзно",
                                "target_lang_sense_clarification": "о значительной степени, например, о травмах"
                            },
                            {
                                "target_lang_word": "тяжело",
                                "target_lang_sense_clarification": "о болезни или ранении"
                            },
                            {
                                "target_lang_word": "крайне",
                                "target_lang_sense_clarification": "чрезвычайно"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ciddi şekilde",
                                "target_lang_sense_clarification": "ağır yaralanma veya hasar durumlarında"
                            },
                            {
                                "target_lang_word": "ağır",
                                "target_lang_sense_clarification": "hastalık veya yaralanma için"
                            },
                            {
                                "target_lang_word": "son derece",
                                "target_lang_sense_clarification": "aşırı derecede"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严重地",
                                "target_lang_sense_clarification": "用于伤势、病情或后果"
                            },
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "表示程度极高"
                            },
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "表示程度达到顶点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb1a2961-8e78-32b5-bb7d-24f545967377",
                    "sense_definition": "Used to emphasize the truth of a statement, introduce a serious point, or express disbelief.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "But <w>seriously</w>, we need to finish this work before we can leave.",
                            "target_lang_translations": {
                                "ru": "Но <w>серьёзно</w>, нам нужно закончить эту работу, прежде чем мы сможем уйти.",
                                "tr": "Ama <w>şaka bir yana</w>, gitmeden önce bu işi bitirmemiz gerekiyor.",
                                "zh": "但<w>说真的</w>，我们得在离开前把工作做完。"
                            }
                        },
                        {
                            "text": "<w>Seriously</w>, why did you decide to paint the room that color?",
                            "target_lang_translations": {
                                "ru": "<w>Серьёзно</w>, почему ты решил покрасить комнату в этот цвет?",
                                "tr": "<w>Cidden</w>, odayı neden o renge boyamaya karar verdin?",
                                "zh": "<w>说真的</w>，你为什么决定把房间漆成那个颜色？"
                            }
                        }
                    ],
                    "synonyms": [
                        "no really",
                        "no kidding",
                        "real talk",
                        "honestly",
                        "for real"
                    ],
                    "common_phrases": [
                        "but seriously",
                        "no seriously"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in conversation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для подчеркивания правдивости утверждения, перехода к серьезной теме или выражения недоверия.",
                        "tr": "Bir gerçeği vurgulamak, ciddi bir konuya geçmek veya şaşkınlık belirtmek için kullanılır.",
                        "zh": "用于强调陈述的真实性、引出严肃话题或表达怀疑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьёзно",
