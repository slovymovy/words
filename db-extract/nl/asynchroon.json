                                        "entry_id": "9700873e-2a83-300d-b554-e5475011e4b3",
                                        "glosses": [
                                            "Not synchronous; occurring at different times."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f5ea2dc-cc0a-4c8e-aa27-18e9b3f5dd30",
                                                "sense_id": "79a5545c-67de-394b-a731-7919060c371c",
                                                "text": "These cyberforums are asynchronous; that is, contributors post (i.e., publish a text message) without the need for fellow communicants to be online at the same time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b325ae6d-8098-3224-840c-d0c86a5f10ef",
                                        "entry_id": "9700873e-2a83-300d-b554-e5475011e4b3",
                                        "glosses": [
                                            "Allowing the client to continue during processing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a50cf054-d9b8-3ee2-8d29-8d6e6b7444af",
                                        "entry_id": "9700873e-2a83-300d-b554-e5475011e4b3",
                                        "glosses": [
                                            "Having many actions occurring at a time, in any order, without waiting for each other."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f8c7407-584a-4189-9ff3-5bc290f6937a",
                                                "sense_id": "a50cf054-d9b8-3ee2-8d29-8d6e6b7444af",
                                                "text": "Near-synonym: in parallel"
                                            }
                                        ]
                                    }
