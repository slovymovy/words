                "senses": [
                    {
                        "sense_id": "63fb9f8c-09c4-3f19-9bb3-5cda04542770",
                        "entry_id": "6e41010a-25e4-3f76-a647-0e797e9e6314",
                        "glosses": [
                            "Faire perdre son caractère de cliché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38239cd8-2c65-4e16-8a6e-0c6bb5bbc0b1",
                                "sense_id": "63fb9f8c-09c4-3f19-9bb3-5cda04542770",
                                "text": "Deguy ne se contente pas de réemployer une expression toute faite pour la « déclicher » comme il le dit de Breton qualifié « d’Orphée de stéréotypes» : à la faveur d’une simple permutation consonantique, la question de la présentation dans l’espace cède la place à la question de la présentation dans le temps."
                            },
                            {
                                "example_id": "538e283f-62df-4827-ae64-c237e5b69162",
                                "sense_id": "63fb9f8c-09c4-3f19-9bb3-5cda04542770",
                                "text": "Comment déclicher un cliché ?"
                            },
                            {
                                "example_id": "61b36c31-1619-4c78-8b7d-58ea42bdbde7",
                                "sense_id": "63fb9f8c-09c4-3f19-9bb3-5cda04542770",
                                "text": "Ils ne tiennent pas longtemps. Ne peuvent être que tactiques. Créent un brouillard. Peuvent introduire le doute chez le clicheur. Peuvent aider à se déclicher soi-même."
                            }
                        ]
                    }
                ],
