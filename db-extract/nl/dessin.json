                        "glosses": [
                            "combinatie van kleur en patroon die bepalend is voor het uiterlijk van een ontwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dcf8f3d-0275-459e-bc1e-803a4580a1b3",
                                "sense_id": "ea964c19-a9f6-331e-9236-59de7d95384a",
                                "text": "Een uitstapje voor De Lucchi zijn kennelijk altijd de kleine gebruiksvoorwerpen geweest, die hij vooral onder de vlag van Memphis produceerde. Vazen, meubelaccessoires, kastjes, vaak gestoken in een bacterie-achtig dessin."
                            },
                            {
                                "example_id": "7b78c73e-175d-4514-8e2e-49847d1f8153",
                                "sense_id": "ea964c19-a9f6-331e-9236-59de7d95384a",
                                "text": "Benetton strekt zijn bemoeienis zelfs uit tot de luiers, en ontwierp onlangs een papieren weggooi-luierbroek met een voor dit merk zo kenmerkend kleurrijk dessin."
                            }
                        ]
                    }
