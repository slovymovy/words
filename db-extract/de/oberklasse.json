                ],
                "senses": [
                    {
                        "sense_id": "677884f0-35a9-3962-b30f-33a371edd8eb",
                        "entry_id": "d8935060-fb5c-3943-ab7d-03dc437939f3",
                        "glosses": [
                            "höhere/hohe Schulklasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a4d06f6-41a1-4918-86b8-fb75bf899353",
                                "sense_id": "677884f0-35a9-3962-b30f-33a371edd8eb",
                                "text": "Wer die Oberklasse erreicht, schafft in der Regel auch den Schulabschluss."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "703a2cfb-cbb7-35fa-a689-9da41dc7d342",
                        "entry_id": "d8935060-fb5c-3943-ab7d-03dc437939f3",
                        "glosses": [
                            "obere Gesellschaftsschicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "050060dc-d34c-42a2-bc61-844d2236aa1b",
                                "sense_id": "703a2cfb-cbb7-35fa-a689-9da41dc7d342",
                                "text": "„Während die vermögende Oberklasse an ihrem bewährten und vertrauenswürdigen Personal überwiegend festhielt und höchstens die Hilfskräfte reduzierte, traf es in den viel zahlreicheren bürgerlichen und kleinbürgerlichen Haushalten Zehntausende Dienstmädchen, Zugehfrauen, Köchinnen und Wäscherinnen.“"
                            },
                            {
                                "example_id": "2cda1503-4bf3-4902-b3d5-82f6c0da09fb",
                                "sense_id": "703a2cfb-cbb7-35fa-a689-9da41dc7d342",
                                "text": "„Jetzt hatte eine neue Oberklasse die Gewohnheiten und das Machtgebaren der Engländer übernommen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6c20d2df-066a-32ee-a4dd-ffe3a7eba0b0",
                        "entry_id": "d8935060-fb5c-3943-ab7d-03dc437939f3",
                        "glosses": [
                            "Menge der Typen besonders teurer Fahrzeuge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcf638b7-11c9-4484-871a-34bb3edc9507",
                                "sense_id": "6c20d2df-066a-32ee-a4dd-ffe3a7eba0b0",
                                "text": "Fahrzeuge der Oberklasse kann sich nicht jeder leisten."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
