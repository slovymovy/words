                "senses": [
                    {
                        "sense_id": "df69bc63-5419-3637-99d2-4d5b840d26bf",
                        "entry_id": "c3e4aa35-09ee-3a38-9802-013f4493ba8e",
                        "glosses": [
                            "der sechste Tag der Woche, Samstag"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "26d205aa-f7f1-4df7-a949-0544136b10c4",
                                "sense_id": "df69bc63-5419-3637-99d2-4d5b840d26bf",
                                "text": "„Da ist sie augenblicklich wieder verschwunden und hat sich nie wieder sehen lassen, nur jeden Satertag haben drei reine Hemden für ihn und seine Kinder dagelegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f19c514-9ca1-44e6-998d-4acc30ae2e28",
                        "source_entry_id": "c3e4aa35-09ee-3a38-9802-013f4493ba8e",
                        "source_sense_id": "df69bc63-5419-3637-99d2-4d5b840d26bf",
                        "source_sense_description": "norddeutsch, vorwiegend in Ostfriesland und Westfalen: der sechste Tag der Woche, Samstag",
                        "target_lang_word": "Saturday",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saturday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa6d2c13-f093-33c8-bf6b-48589ed83d57",
                                        "entry_id": "e45773bf-5fed-30ed-a8a2-552b2c1da303",
                                        "glosses": [
                                            "The seventh day of the week in many religious traditions, and the sixth day of the week in systems using the ISO 8601 norm; the Jewish Sabbath; it follows Friday and precedes Sunday."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ccf3b6-00c6-4864-91d8-ae6cb6a8e4fc",
                                                "sense_id": "fa6d2c13-f093-33c8-bf6b-48589ed83d57",
                                                "text": "The Beijing-based firm — one of four funds created by the Chinese government in 1999 to process the bad loans of state-owned banks — announced Saturday that it would send a group of 50 experts to the province to help it “prevent and defuse risks” and “bail out” the real estate industry."
                                            },
                                            {
                                                "example_id": "caed5acd-6625-451f-8ed4-d6afbf49e17c",
                                                "sense_id": "fa6d2c13-f093-33c8-bf6b-48589ed83d57",
                                                "text": "Saturday’s tariffs are unlikely to be Trump’s last. The president said himself said in the Oval Office that additional tariffs could come by mid-February on chips, pharmaceuticals, steel, aluminum, copper, oil and gas imports – along with tariffs on the European Union – all threats that few would discount given his willingness to follow through on the North American and China tariffs on Saturday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Saturday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49af639e-ec67-38fe-aed3-f77aa9b08cea",
                                        "entry_id": "924b425e-351e-3f92-aa0f-fdf8c4f86e6b",
                                        "glosses": [
                                            "On Saturday."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Saturday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4541a8b-8098-36f7-bb6b-c31868b28605",
                                        "entry_id": "6225147a-d72b-38ef-b847-f8c80208caf3",
                                        "glosses": [
                                            "To spend Saturday (at a place or doing an activity)."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d931679c-9b96-4ff7-a9a9-3cbe78a46c1b",
                                                "sense_id": "a4541a8b-8098-36f7-bb6b-c31868b28605",
                                                "text": "Mr. Angus Hibbard, of New York, Fridayed and Saturdayed in Chicago, for the show and banquet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "745619c6-28c6-496c-9816-36b215ddd6f6",
                        "source_entry_id": "c3e4aa35-09ee-3a38-9802-013f4493ba8e",
                        "source_sense_id": "df69bc63-5419-3637-99d2-4d5b840d26bf",
                        "source_sense_description": "norddeutsch, vorwiegend in Ostfriesland und Westfalen: der sechste Tag der Woche, Samstag",
                        "target_lang_word": "samedi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samedi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76d43ce4-ccf3-3229-92cf-42d8aa549df9",
                                        "entry_id": "c35d70e0-c16f-3921-be18-67fc19f60fb9",
                                        "glosses": [
                                            "Sixième jour de la semaine, qui suit le vendredi et précède le dimanche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce4a89d3-5f2c-4e1e-858c-eab2d6827aac",
                                                "sense_id": "76d43ce4-ccf3-3229-92cf-42d8aa549df9",
                                                "text": "Cette avance du déjeuner donnait d’ailleurs au samedi, pour nous tous, une figure particulière, indulgente, et assez sympathique."
                                            },
                                            {
                                                "example_id": "d2ccf31a-3ead-408b-84f0-a8398cbc1f40",
                                                "sense_id": "76d43ce4-ccf3-3229-92cf-42d8aa549df9",
                                                "text": "Le 19 septembre de l’an 1846, la Vierge s’était montrée à deux enfants sur une montagne, un samedi, le jour qui lui était consacré et qui était, cette année, un jour de pénitence, à cause des Quatre-Temps."
                                            },
                                            {
                                                "example_id": "9917f006-58af-4522-9505-ae3886c4a0a0",
                                                "sense_id": "76d43ce4-ccf3-3229-92cf-42d8aa549df9",
                                                "text": "On ne fait plus d’enfants, chez nous, sauf dans les coins pouilleux, dans les milieux de misère, certains samedis de paye, après stations devant les comptoirs des bistrots."
                                            },
                                            {
                                                "example_id": "9e4893d0-2975-421c-9ac0-5dc1dd6ab97e",
                                                "sense_id": "76d43ce4-ccf3-3229-92cf-42d8aa549df9",
                                                "text": "Il faut, pour chaque mois, tenir compte du nombre de samedis, jour où les mariages sont, de très loin, les plus nombreux, de celui des lundis, où la nuptialité est, aussi, supérieure à la moyenne, enfin, des dimanches, où aucun mariage n'est, bien-sûr, célébré."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "samedi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08b278ae-b044-3957-a3b9-7b1c6bb99d02",
                                        "entry_id": "186da2ed-1c71-397e-b9f0-eb6a33cce05b",
                                        "glosses": [
                                            "Le jour du samedi. Note d’usage : Peut être suivi de matin, soir ou une date sans article."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb3b2b58-8432-450f-8b72-8fae07a63319",
                                                "sense_id": "08b278ae-b044-3957-a3b9-7b1c6bb99d02",
                                                "text": "Je pars samedi."
                                            }
                                        ]
                                    }
                                ]
                            }
