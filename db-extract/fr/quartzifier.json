                        "tags": [],
                        "examples": [
                            {
                                "example_id": "076d32b0-c486-4692-ae6e-ad329a003d7e",
                                "sense_id": "d43aae52-6911-31cf-b9fd-204e0e5bee27",
                                "text": "À 3 m environ au-dessus du sill, le grès resté horizontal a été quartzifié et se débite en prismes verticaux donnant des redans, comparables à ceux que montrent les falaises doléritiques."
                            },
                            {
                                "example_id": "e252073a-7ae5-4ed7-9c62-28f8f49e7835",
                                "sense_id": "d43aae52-6911-31cf-b9fd-204e0e5bee27",
                                "text": "C’est un plan de glissement croiseur, quartzifié et stérile."
                            }
                        ]
