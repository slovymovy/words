                "senses": [
                    {
                        "sense_id": "6f200dfd-4f40-3793-a620-5b8becc5f9ca",
                        "entry_id": "d384ffdb-5fcc-3924-af27-d2d8fb8e2165",
                        "glosses": [
                            "(surtout au Sénégal, Cameroun et en Côte d’Ivoire) Concourir, compétitionner, entrer en compétition."
                        ],
                        "tags": [
                            "Afrique"
                        ],
                        "examples": [
                            {
                                "example_id": "d0887bf9-4cbc-4101-b77d-0173130bd241",
                                "sense_id": "6f200dfd-4f40-3793-a620-5b8becc5f9ca",
                                "text": "Cela permettra au Cameroun de conquérir des nouveaux marchés ou de compétir plus énergiquement sur son marché traditionnel en cas d'ouverture de celui-ci à la banane latino-américaine."
                            },
                            {
                                "example_id": "33772b95-a538-43be-90fb-566c4131f23d",
                                "sense_id": "6f200dfd-4f40-3793-a620-5b8becc5f9ca",
                                "text": "Le critère de l’assise territoriale du parti et de sa légitimité à compétir dans une circonscription n’est pas l’égalité numérique ou arithmétique dans la liste des diverses et principales composantes, mais seulement cette présence."
                            }
                        ]
                    }
                ],
