                        "glosses": [
                            "gebruikersnaam die samen met het wachtwoord toegang geeft en zorgt voor de identificatie van een gebruiker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8faaf20-aab9-485d-8c53-68b4068ef9d2",
                                "sense_id": "0ee127ac-7607-33c7-8888-49d6141d2d1c",
                                "text": "Siri spreekt de gebruiker van de iPhone aan met de naam die in de instellingen is ingegeven. Volgens het personeel moet een grapjas de scheldtirade als username ingegeven hebben,."
                            },
                            {
                                "example_id": "55a81315-50f3-4b09-85f7-7801886ddcce",
                                "sense_id": "0ee127ac-7607-33c7-8888-49d6141d2d1c",
                                "text": "Ook die kreeg hetzelfde antwoord te horen, waarna het personeel van Tesco concludeerde dat iemand met de instellingen van de iPhone moest hebben geknoeid. Siri spreekt de gebruiker van de iPhone aan met de naam die in de instellingen is ingegeven. Volgens het personeel moet een grapjas de scheldtirade als username ingegeven hebben,."
                            },
                            {
                                "example_id": "e4482900-0b4b-4527-9b5e-56a879c424a5",
                                "sense_id": "0ee127ac-7607-33c7-8888-49d6141d2d1c",
                                "text": "We hebben nog wanhopig een username aagevraagd, maar ook dat hielp niet. De Belgen zonden het wel live uit met mooi commentaar, maar daar kwamen we te laat achter. Misschien was het wel zo SPORTIEF geweest van de NOS om naar hen te verwijzen."
                            }
                        ]
                    }
