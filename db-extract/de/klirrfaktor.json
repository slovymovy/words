                        "sense_id": "7d1cd86d-68f7-31ca-8429-412328e91ac6",
                        "entry_id": "790e1ee3-5294-3598-9e00-90df645e4d65",
                        "glosses": [
                            "Maß für die Verzerrung bei akustischen Übertragungen"
                        ],
                        "tags": [
                            "Elektroakustik"
                        ],
                        "examples": [
                            {
                                "example_id": "c9284cbd-9f60-47fe-b428-67eaf26ce86f",
                                "sense_id": "7d1cd86d-68f7-31ca-8429-412328e91ac6",
                                "text": "Der Klirrfaktor k gibt an, wie stark die Oberschwingungen, die bei der Verzerrung eines sinusförmigen Signals entstehen, im Vergleich zum Gesamtsignal sind."
                            },
                            {
                                "example_id": "c5718879-e475-406d-9caf-0fe674c4c9d1",
                                "sense_id": "7d1cd86d-68f7-31ca-8429-412328e91ac6",
                                "text": "„Beide besitzen einen Frequenzgang von 20 Hz bis 20 kHz und einen Klirrfaktor von weniger als 0,01 Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
