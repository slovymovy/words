                ],
                "senses": [
                    {
                        "sense_id": "69729ac2-2c4b-3a5c-916f-fd8479e35372",
                        "entry_id": "31c89a2f-4ddc-3d92-9e7e-be16e6e83979",
                        "glosses": [
                            "in einem an Limetten erinnernden Grünton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edd587e5-5c4f-446f-a380-e6f0e2881e85",
                                "sense_id": "69729ac2-2c4b-3a5c-916f-fd8479e35372",
                                "text": "„Aber die beiden Vans, die Ihnen hierher in die Altstadt gefolgt sind, und die drei Schläger in dem limettengrünen Viertürer draußen vor dem Café - die gehören zu einem Menschenschlag, der neugierige Leute wie Sie überhaupt nicht leiden kann.“"
                            },
                            {
                                "example_id": "9e2ae949-c901-434d-8392-70575ef0738a",
                                "sense_id": "69729ac2-2c4b-3a5c-916f-fd8479e35372",
                                "text": "„Schwester Hina Alvi zieht ein limettengrünes Taschentuch aus ihrem Beutel, wischt sich sacht über die Lippen und inspiziert es dann nach Spuren.“"
                            }
                        ],
