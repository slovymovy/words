                        "sense_id": "0e99628c-8eb1-39f5-9660-42d8f6d3db60",
                        "entry_id": "6e2cc219-b460-3370-b059-4d5e3891b37f",
                        "glosses": [
                            "route via welke een misdadiger kan ontsnappen aan de politie of de overheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e99dda95-3808-490d-a721-ec3b01517ddd",
                                "sense_id": "0e99628c-8eb1-39f5-9660-42d8f6d3db60",
                                "text": "Maar dat valt tegen. Onderzoekers van de Politieacademie testten dit voorspellend politiewerk recentelijk maandenlang op vier plaatsen in Nederland, waaronder Enschede. Aan de hand van gegevens over woonwijken, ontsnappingswegen, bewoners en inbraken uit het verleden kreeg de politie kaarten met zogenaamde hotspots. Plekken waar op een bepaald tijdstip een inbraak kon worden verwacht. Door deze in te passen in de plaatselijke werkwijze zouden het aantal woninginbraken snel moeten doen dalen."
                            }
                        ]
                    },
