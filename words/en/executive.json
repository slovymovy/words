{
    "word_family": [
        "execute",
        "execution",
        "executor",
        "executable",
        "executioner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f5787db-9b34-313b-a787-1fb9b990b9b6",
                    "sense_definition": "A chief officer or administrator, especially one who can make significant decisions on their own authority.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "person_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hired a new <w>executive</w> to improve sales strategies.",
                            "target_lang_translations": {
                                "ru": "Компания наняла нового <w>руководителя</w> для улучшения стратегии продаж.",
                                "zh": "公司聘请了一位新的<w>高管</w>来改善销售策略。"
                            }
                        },
                        {
                            "text": "As a senior <w>executive</w>, she is responsible for the entire marketing department.",
                            "target_lang_translations": {
                                "ru": "Как старший <w>управляющий</w>, она отвечает за весь отдел маркетинга.",
                                "zh": "作为一名高级<w>行政主管</w>，她负责整个市场部。"
                            }
                        }
                    ],
                    "synonyms": [
                        "administrator",
                        "director",
                        "manager",
                        "official",
                        "chief"
                    ],
                    "antonyms": [
                        "subordinate",
                        "employee",
                        "worker"
                    ],
                    "common_phrases": [
                        "chief executive",
                        "senior executive",
                        "business executive",
                        "account executive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Руководитель высшего звена или администратор, обладающий полномочиями принимать важные решения.",
                        "zh": "指在组织中拥有决策权的高级管理人员或行政人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководи́тель",
                                "target_lang_sense_clarification": "должностное лицо, управляющее коллективом или организацией"
                            },
                            {
                                "target_lang_word": "управля́ющий",
                                "target_lang_sense_clarification": "лицо, заведующее административной деятельностью"
                            },
                            {
                                "target_lang_word": "администра́тор",
                                "target_lang_sense_clarification": "распорядитель, ответственный за управление"
                            },
                            {
                                "target_lang_word": "исполни́тельный дире́ктор",
                                "target_lang_sense_clarification": "название конкретной должности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高管",
                                "target_lang_sense_clarification": "高级管理人员的简称"
                            },
                            {
                                "target_lang_word": "行政主管",
                                "target_lang_sense_clarification": "负责行政事务的管理人员"
                            },
                            {
                                "target_lang_word": "执行官",
                                "target_lang_sense_clarification": "负责执行决策的官员或经理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b50ee9c-d7d1-3d92-a20a-52005b6fa4eb",
                    "sense_definition": "The branch of government that is responsible for enforcing laws and judicial decisions, and for the day-to-day administration of the state.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "government",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>executive</w> has the power to veto legislation passed by congress.",
                            "target_lang_translations": {
                                "ru": "<w>Исполнительная власть</w> имеет право наложить вето на законы, принятые конгрессом.",
                                "zh": "<w>行政机关</w>有权否决国会通过的立法。"
                            }
                        },
                        {
                            "text": "In many democracies, power is separated between the legislature, the judiciary, and the <w>executive</w>.",
                            "target_lang_translations": {
                                "ru": "Во многих демократиях власть разделена между законодательной, судебной и <w>исполнительной властью</w>.",
                                "zh": "在许多民主国家，权力在立法、司法和<w>行政</w>部门之间进行分配。"
                            }
                        }
                    ],
                    "synonyms": [
                        "administration"
                    ],
                    "antonyms": [
                        "legislature",
                        "judiciary"
                    ],
                    "common_phrases": [
                        "the executive",
                        "executive branch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ветвь власти, отвечающая за исполнение законов и повседневное управление государством.",
                        "zh": "政府中负责执行法律、司法裁决及国家日常行政事务的部门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполни́тельная власть",
                                "target_lang_sense_clarification": "ветвь государственной власти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行政机关",
                                "target_lang_sense_clarification": "政府的执行部门"
                            },
                            {
                                "target_lang_word": "行政部门",
                                "target_lang_sense_clarification": "负责行政管理的机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c967f5f0-e855-300c-84d2-5cd965893e65",
                    "sense_definition": "A process that coordinates and governs the action of other processes or threads in computing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system <w>executive</w> manages memory allocation for all running programs.",
                            "target_lang_translations": {
                                "ru": "Системный <w>диспетчер</w> управляет распределением памяти для всех запущенных программ.",
                                "zh": "系统<w>执行程序</w>负责管理所有运行程序的内存分配。"
                            }
                        },
                        {
                            "text": "A real-time <w>executive</w> ensures that critical tasks are completed within strict time limits.",
                            "target_lang_translations": {
                                "ru": "<w>Управляющая программа</w> реального времени гарантирует выполнение критических задач в строгие сроки.",
                                "zh": "实时<w>调度程序</w>确保关键任务在严格的时间限制内完成。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kernel",
                        "supervisor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или программа, управляющая выполнением других процессов или задач в вычислительной системе.",
                        "zh": "在计算机系统中负责协调和管理其他进程或任务执行的程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диспе́тчер",
                                "target_lang_sense_clarification": "программа, координирующая ресурсы"
                            },
                            {
                                "target_lang_word": "управля́ющая програ́мма",
                                "target_lang_sense_clarification": "основной управляющий модуль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "执行程序",
                                "target_lang_sense_clarification": "负责调度和管理的系统程序"
                            },
                            {
                                "target_lang_word": "调度程序",
                                "target_lang_sense_clarification": "负责分配系统资源的程序"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d87b7383-f1b7-31c2-8065-add82c32fab1",
                    "sense_definition": "Of, pertaining to, or having responsibility for the day-to-day running of an organisation, business, or country.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "managerial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president issued an <w>executive</w> order to address the crisis immediately.",
                            "target_lang_translations": {
                                "ru": "Президент издал <w>исполнительный</w> указ для немедленного разрешения кризиса.",
                                "zh": "总统发布了一项<w>行政</w>命令以立即应对危机。"
                            }
                        },
                        {
                            "text": "She holds an <w>executive</w> position at a major international bank.",
                            "target_lang_translations": {
                                "ru": "Она занимает <w>руководящую</w> должность в крупном международном банке.",
                                "zh": "她在一家大型国际银行担任<w>管理层</w>职位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "administrative",
                        "managerial",
                        "supervisory",
                        "governing"
                    ],
                    "common_phrases": [
                        "executive decision",
                        "executive power",
                        "executive committee",
                        "executive order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к управлению организацией, бизнесом или государством; наделенный полномочиями.",
                        "zh": "与组织、企业或国家的日常管理和决策相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполни́тельный",
                                "target_lang_sense_clarification": "относящийся к исполнению решений или власти"
                            },
                            {
                                "target_lang_word": "руководя́щий",
                                "target_lang_sense_clarification": "относящийся к руководству, начальствующий"
                            },
                            {
                                "target_lang_word": "администрати́вный",
                                "target_lang_sense_clarification": "относящийся к администрированию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行政的",
                                "target_lang_sense_clarification": "与行政管理相关的"
                            },
                            {
                                "target_lang_word": "执行的",
                                "target_lang_sense_clarification": "具有执行权力的"
                            },
                            {
                                "target_lang_word": "管理层的",
                                "target_lang_sense_clarification": "属于管理层级的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e2a6995-85eb-360c-9412-1590582ce0b2",
                    "sense_definition": "Exclusive or expensive; designed for people with high status or wealth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "luxury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Guests staying in the <w>executive</w> suite have access to a private lounge.",
                            "target_lang_translations": {
                                "ru": "Гости, проживающие в <w>представительском</w> люксе, имеют доступ в частную зону отдыха.",
                                "zh": "入住<w>行政</w>套房的客人可以使用私人休息室。"
                            }
                        },
                        {
                            "text": "The hotel offers <w>executive</w> rooms with better views and extra amenities.",
                            "target_lang_translations": {
                                "ru": "Отель предлагает <w>представительские</w> номера с лучшим видом и дополнительными удобствами.",
                                "zh": "酒店提供视野更好且设施更齐全的<w>行政</w>客房。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exclusive",
                        "premium",
                        "luxury",
                        "upscale"
                    ],
                    "antonyms": [
                        "standard",
                        "economy"
                    ],
                    "common_phrases": [
                        "executive suite",
                        "executive lounge",
                        "executive class"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эксклюзивный, дорогостоящий; предназначенный для людей с высоким статусом или достатком.",
                        "zh": "指专为高地位或高收入人群设计的，通常价格昂贵且服务高端。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представи́тельский",
                                "target_lang_sense_clarification": "высокого класса (о номерах, автомобилях)"
                            },
                            {
                                "target_lang_word": "эли́тный",
                                "target_lang_sense_clarification": "предназначенный для избранных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行政的",
                                "target_lang_sense_clarification": "指酒店中高档的房型或服务"
                            },
                            {
                                "target_lang_word": "高端的",
                                "target_lang_sense_clarification": "指品质优良且昂贵的"
                            },
                            {
                                "target_lang_word": "豪华的",
                                "target_lang_sense_clarification": "指设施奢华的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}