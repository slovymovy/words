                ],
                "senses": [
                    {
                        "sense_id": "44690788-94e4-35b5-926c-c183df67b686",
                        "entry_id": "8fa96a0e-4367-3935-a08c-9e90f5f38b10",
                        "glosses": [
                            "verknüpfter Faden (Knoten), der an einer buddhistischen/hinduistischen Gebetskette, der Mala, sitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2ccf490-cce5-4ba2-80b5-d44f96e61fac",
                                "sense_id": "44690788-94e4-35b5-926c-c183df67b686",
                                "text": "„Diese Knochen-Handmala ist mit elastischem Gummiband aufgezogen. Sie hat eine Guruperle und einen Stupa. Den Abschluss bildet ein schöner Schützerknoten mit Bommel.“"
                            },
                            {
                                "example_id": "7dc3f630-410e-4738-8885-f7f7ddb5f94e",
                                "sense_id": "44690788-94e4-35b5-926c-c183df67b686",
                                "text": "„Ein Ghau (Gau, Gao) ist ein kleiner Reisealtar, befüllt mit besonderen Gaben wie etwa Schützerknoten, Segenbändern, gesegnetem Reis, kleinen Schutztexten (Mantras), zuweilen mit einer kleinen Statue oder einem Bildnis und von einem Lama gesegnet.“"
                            },
                            {
                                "example_id": "59edf586-f44d-4b77-ae64-da4cf1390ffa",
                                "sense_id": "44690788-94e4-35b5-926c-c183df67b686",
                                "text": "„So segnete Geshe-la noch Süßigkeiten für alle und natürlich auch die Schützerknoten, die ich in der letzten Zeit angefertigt habe.“"
                            },
                            {
                                "example_id": "40496b25-fff9-4783-bbc5-09c0bed3dc4d",
                                "sense_id": "44690788-94e4-35b5-926c-c183df67b686",
                                "text": "„Die goldene und weinrote Schnur des Schützerknotens ist aus Taiwan.“"
                            },
                            {
                                "example_id": "aec74d47-29ea-468c-9aa7-fc046caa10cf",
                                "sense_id": "44690788-94e4-35b5-926c-c183df67b686",
                                "text": "„Die von uns gefertigten Malas haben alle eine 3-Loch-Guruperle mit Stupa und einen tibetischen Schützerknoten, welcher aus selbiger Schnur geknüpft ist, mit welcher die 108/111 Perlen aufgefädelt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
