                "senses": [
                    {
                        "sense_id": "f8b976d6-0b81-321f-b85b-3b2a0f6af6d3",
                        "entry_id": "f1de22e8-263e-3827-b0b7-c0f710ab7bb0",
                        "glosses": [
                            "feuerfester Behälter, der zum Schmoren verwendet wird (meist aus Ton oder Glas)"
                        ],
                        "tags": [
                            "Küchengerät"
                        ],
                        "examples": [
                            {
                                "example_id": "37aa654b-0d66-47d3-b811-6ad7b027ab63",
                                "sense_id": "f8b976d6-0b81-321f-b85b-3b2a0f6af6d3",
                                "text": "In Restaurants werden Kokotten auf einen Platzteller serviert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dca9f683-a061-3ead-aaf3-f96bf263a14c",
                        "entry_id": "f1de22e8-263e-3827-b0b7-c0f710ab7bb0",
                        "glosses": [
                            "vornehme Prostituierte, Halbweltdame"
                        ],
                        "tags": [
                            "formal",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "0bc08a78-4789-4262-8bab-71686f275635",
                                "sense_id": "dca9f683-a061-3ead-aaf3-f96bf263a14c",
                                "text": "„Verderbte Bürgermädchen kopierten die Berber, jede bessere Kokotte wollte möglichst genau wie sie aussehen.“"
                            },
                            {
                                "example_id": "c1fcad24-9799-4cef-a580-ec4bdab6b1f3",
                                "sense_id": "dca9f683-a061-3ead-aaf3-f96bf263a14c",
                                "text": "„Die Zivilisten sahen feindlich an ihnen vorbei oder spotteten hinter ihrem Rücken, nur die Hunderte von Kokotten warfen pazifistische Blicke.“"
                            },
                            {
                                "example_id": "796cd7ba-c408-4aa3-8975-0deacf9f1542",
                                "sense_id": "dca9f683-a061-3ead-aaf3-f96bf263a14c",
                                "text": "„Leopolds Vorliebe für überaus junge Frauen war seit langem bekannt, aber seinen Kopf wegen einer 16jährigen Kokotte zu verlieren, das war nun wirklich etwas ganz anderes.“"
                            },
                            {
                                "example_id": "951375c1-f6de-4fff-b498-8fc80641c15a",
                                "sense_id": "dca9f683-a061-3ead-aaf3-f96bf263a14c",
                                "text": "„Die Herren diskutieren über den Unterschied zwischen einer Pariser Kokotte und einer Berliner Schneppe.“"
                            },
                            {
                                "example_id": "37429d3d-3433-47e1-ab80-7f7b3d430db4",
                                "sense_id": "dca9f683-a061-3ead-aaf3-f96bf263a14c",
                                "text": "„Kokotten sind da, einige aus Budapest, die meisten aber waren bereits in Belgrad tätig und sind rechtzeitig zurückgenommen worden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
