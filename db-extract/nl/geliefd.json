                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8eb3d85-9fab-3783-8df3-aedb1fda99b7",
                        "entry_id": "b6749bfa-562d-3dd3-ba48-52f5ce71e1b8",
                        "glosses": [
                            "van wie of waarvan gehouden wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6685e208-c1d8-49a3-acb1-42392bad3bbd",
                                "sense_id": "b8eb3d85-9fab-3783-8df3-aedb1fda99b7",
                                "text": "Hij is een van de geliefdste auteurs van het land."
                            },
                            {
                                "example_id": "53744db7-84eb-40f2-8bcc-6af0b7f8658d",
                                "sense_id": "b8eb3d85-9fab-3783-8df3-aedb1fda99b7",
                                "text": "De koninklijke familie is nu geliefder dan een aantal jaren terug."
                            },
                            {
                                "example_id": "3fb81a3a-889d-4a13-981c-e4e9a5b68056",
                                "sense_id": "b8eb3d85-9fab-3783-8df3-aedb1fda99b7",
                                "text": "Hij werkte graag in zijn geliefde tuin."
                            },
                            {
                                "example_id": "6e8ccf68-0e76-4268-90cd-3b8f738bdfa3",
                                "sense_id": "b8eb3d85-9fab-3783-8df3-aedb1fda99b7",
                                "text": "Ik had al 12 dagen niet gedoucht en kwam moe maar voldaan aan in de stad South Lake Tahoe om eindelijk weer eens uit te rusten. Een geliefde vakantiestad voor skiërs in de winter en watersportliefhebbers in de zomer."
                            },
                            {
                                "example_id": "32be316d-5137-454e-a842-24814300569f",
                                "sense_id": "b8eb3d85-9fab-3783-8df3-aedb1fda99b7",
                                "text": "Nee, Harald was zestien jaar, zijn neef, Lauritz'en Ingeborgs geliefde oudste zoon, een jongen die ze aan zijn zorg en bescherming hadden toevertrouwd."
                            }
                        ]
                    }
