                "senses": [
                    {
                        "sense_id": "fb57ecaa-78e6-37d4-ad61-6cda73c01494",
                        "entry_id": "f4620e15-43a2-3676-8c40-995e15c01ff4",
                        "glosses": [
                            "To assign a quantity to."
