                    }
                ],
                "senses": [
                    {
                        "sense_id": "970d1078-2800-3f30-8b79-21563b51f598",
                        "entry_id": "88f09c78-1d36-329e-be23-5d64e82a810a",
                        "glosses": [
                            "ohne Knochen, keine Knochen habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139a9778-898a-429f-a3a8-c3a1c1042190",
                                "sense_id": "970d1078-2800-3f30-8b79-21563b51f598",
                                "text": "„Wie bereits erwähnt, war die Gegend von Wilburs Körper, die bei einem normalen Menschen dem Thorax beziehungsweise der Brust und dem Oberbauch entsprach, mit 20 knochenlosen Anhängseln bewachsen.“"
                            },
                            {
                                "example_id": "f97b17be-48c2-4590-a921-d0faa4eda27c",
                                "sense_id": "970d1078-2800-3f30-8b79-21563b51f598",
                                "text": "„Als die Dunstschleier die Säule erneut verbargen, sah ich, wie sich eine riesige, ledrige Hand mit langen, knochenlosen Fingern aus dem Wasser streckte, gefolgt von einem Arm mit unzähligen Gelenken.“"
                            },
                            {
                                "example_id": "cba7f835-a36c-4bd6-8714-d42159fc24fc",
                                "sense_id": "970d1078-2800-3f30-8b79-21563b51f598",
                                "text": "„Bläuliches Licht lag auf seinem Antlitz. Und bläuliches Licht glänzte auf einer knochenlosen Gliedmaße, ähnlich einem Kabel, das von seinem Hinterkopf, über den Boden und außer Sichtweite führte.“"
                            },
                            {
                                "example_id": "3acaeeb0-e774-4163-92d4-f505f40bcff5",
                                "sense_id": "970d1078-2800-3f30-8b79-21563b51f598",
                                "text": "„Hoch hielt sie die knochenlose Trophäe über ihren Kopf und schüttelte sie wie ein Polaroidfoto.“"
                            },
                            {
                                "example_id": "baa7b130-c6bf-42f5-b495-b45e09ecdcd9",
                                "sense_id": "970d1078-2800-3f30-8b79-21563b51f598",
                                "text": "„Als Opojollac den Gang erreichte, lösten sich riesige, ungleiche Hände aus den Schultern und reckten sich ihm an knochenlosen Armen durch den Schacht entgegen.“"
                            },
                            {
                                "example_id": "16437a70-9822-4c44-a29b-c07d3965c19b",
                                "sense_id": "970d1078-2800-3f30-8b79-21563b51f598",
                                "text": "„Sie quietschen und kichern und wedeln mit ihren knochenlosen Armen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a17a55c5-d66a-46d7-8a8b-d20ff2490e44",
