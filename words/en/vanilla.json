                                "target_lang_sense_clarification": "烹饪配料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "525d769a-7ea8-38ff-a901-3af3270a4103",
                    "sense_definition": "Any tropical climbing orchid of the genus Vanilla, especially Vanilla planifolia, bearing podlike fruit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers in Madagascar grow high-quality <w>vanilla</w> for export.",
                            "target_lang_translations": {
                                "ru": "Фермеры на Мадагаскаре выращивают высококачественную <w>ваниль</w> на экспорт.",
                                "zh": "马达加斯加的农民种植高质量的<w>香草</w>用于出口。"
                            }
                        },
                        {
                            "text": "The <w>vanilla</w> requires careful pollination to produce beans.",
                            "target_lang_translations": {
                                "ru": "<w>Ваниль</w> требует тщательного опыления, чтобы дать стручки.",
                                "zh": "<w>香草</w>需要精心的授粉才能结出豆荚。"
                            }
