                    {
                        "sense_id": "5a044a05-2cbf-3401-9e92-bc7ab919469c",
                        "entry_id": "37ce1cd8-678a-3044-937f-5de91120fd68",
                        "glosses": [
                            "воен. западный фронт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b139afa-fa39-454d-9b4c-1c2522405d79",
                                "sense_id": "5a044a05-2cbf-3401-9e92-bc7ab919469c",
                                "text": "An der Westfront sahen die Kriegsplanungen der Westmächte, ähnlich wie im Ersten Weltkrieg, im Wesentlichen eine Abnutzung des deutschen Heeres vor.",
                                "translation": "На Западном фронте военные планы западных держав, как и в Первую мировую войну, по сути, предусматривали истощение немецкой армии."
                            }
                        ]
                    }
