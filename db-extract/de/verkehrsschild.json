                "senses": [
                    {
                        "sense_id": "4fdc3fbe-a69f-37b3-9a83-3cd7b3a0eb67",
                        "entry_id": "e2485986-3cc4-3df0-8e8c-a4542698dc15",
                        "glosses": [
                            "Schild, auf dem ein Verkehrszeichen abgebildet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62bf1347-fcf8-4fa9-9108-41115afe7f3c",
                                "sense_id": "4fdc3fbe-a69f-37b3-9a83-3cd7b3a0eb67",
                                "text": "Auf Verkehrsschildern wird beispielsweise angegeben, wer Vorfahrt hat oder welche Geschwindigkeit maximal gefahren werden darf."
                            },
                            {
                                "example_id": "bb19aeeb-ebb9-4716-ac22-87b58d2656e5",
                                "sense_id": "4fdc3fbe-a69f-37b3-9a83-3cd7b3a0eb67",
                                "text": "„Wenn man sich die Verkehrsschilder genau anschaut und sie analysiert, kann einem einiges auffallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36d9cab0-6d66-4205-9f19-848b882a91d7",
                        "source_entry_id": "e2485986-3cc4-3df0-8e8c-a4542698dc15",
                        "source_sense_id": "4fdc3fbe-a69f-37b3-9a83-3cd7b3a0eb67",
                        "source_sense_description": "Schild, auf dem ein Verkehrszeichen abgebildet ist",
                        "target_lang_word": "traffic sign",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traffic sign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f203b0-c2d7-3aa8-981a-21e7a83d6566",
                                        "entry_id": "b0659940-e53c-3b60-8a85-75c569e9f073",
                                        "glosses": [
                                            "A sign for the control of traffic or the information of drivers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c05dae2-a22a-4772-a4c5-315d035a5fe8",
                                                "sense_id": "e8f203b0-c2d7-3aa8-981a-21e7a83d6566",
                                                "text": "The traffic signs on motorways are particularly clear and well lit at night."
                                            },
                                            {
                                                "example_id": "5d48cb60-765b-4aee-a4b1-97e9ad1488dc",
                                                "sense_id": "e8f203b0-c2d7-3aa8-981a-21e7a83d6566",
                                                "text": "2021, \"New rules on major EU roads should improve infrastructure safety\", ETSC\nOne omission is any language on getting roads ready for automated systems in transport. ETSC had called for provisions on ensuring that road markings, signs and infrastructure take into account the specific needs of e.g. traffic sign recognition and automated lane keeping systems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77fabffd-d6f4-473a-ad41-ec6f94041c68",
                        "source_entry_id": "e2485986-3cc4-3df0-8e8c-a4542698dc15",
                        "source_sense_id": "4fdc3fbe-a69f-37b3-9a83-3cd7b3a0eb67",
                        "source_sense_description": "Schild, auf dem ein Verkehrszeichen abgebildet ist",
                        "target_lang_word": "road sign",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "road sign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dde820f-c8ee-34e3-8f43-4d0dffbb0c14",
                                        "entry_id": "b934d70c-cbc9-3473-a586-55d6f4ae68c0",
                                        "glosses": [
                                            "A sign for the control of traffic or the information of drivers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87959307-c16b-47be-b0f7-60637392f812",
                                                "sense_id": "8dde820f-c8ee-34e3-8f43-4d0dffbb0c14",
                                                "text": "The road signs on motorways are particularly clear and well lit at night."
                                            },
                                            {
                                                "example_id": "0b09186d-fdfc-4582-89ee-2079b7dad8f3",
                                                "sense_id": "8dde820f-c8ee-34e3-8f43-4d0dffbb0c14",
                                                "text": "The organization pointed out that for speed assistance systems to work accurately, there must be clear and visible road signs placed at regular intervals.",
                                                "translation": "This changes everything – the mandatory device in your car that won’t let you exceed the speed limit, Unión Rayo US, 24/09/2024",
                                                "english": "This changes everything – the mandatory device in your car that won’t let you exceed the speed limit, Unión Rayo US, 24/09/2024"
                                            }
                                        ]
