                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She hid her sadness behind a <w>painted</w> smile.",
                            "target_lang_translations": {
                                "ru": "Она скрывала свою грусть за <w>притворной</w> улыбкой.",
                                "zh": "她用一个<w>虚伪</w>的微笑掩盖了自己的悲伤。"
                            }
                        },
                        {
                            "text": "His <w>painted</w> enthusiasm did not fool anyone in the room.",
                            "target_lang_translations": {
                                "ru": "Его <w>деланный</w> энтузиазм никого в комнате не обманул.",
                                "zh": "他那<w>做作</w>的热情没能骗过屋里的任何人。"
                            }
                        }
