{
    "word_family": [
        "gateway",
        "gatekeeper",
        "gatehouse",
        "gatepost",
        "gated",
        "gating"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54aa1cb4-8dd0-3003-ac7e-789df09d3f6d",
                    "sense_definition": "A doorlike structure outside a house, typically in a fence or wall.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "barrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please make sure to close the <w>gate</w> so the dog doesn't run into the street.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не забудь закрыть <w>калитку</w>, чтобы собака не выбежала на улицу."
                            }
                        },
                        {
                            "text": "The wooden <w>garden</w> <w>gate</w> was painted bright blue to match the flowers.",
                            "target_lang_translations": {
                                "ru": "Деревянная садовая <w>калитка</w> была выкрашена в ярко-синий цвет под стать цветам."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorway",
                        "entrance"
                    ],
                    "common_phrases": [
                        "garden gate",
                        "front gate",
                        "open the gate",
                        "lock the gate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дверная конструкция снаружи дома, обычно в заборе или стене."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворота",
                                "target_lang_sense_clarification": "широкий проезд в ограде"
                            },
                            {
                                "target_lang_word": "калитка",
                                "target_lang_sense_clarification": "небольшая дверь в заборе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9750c05d-3ea3-3058-b03b-aabb6fbb7c48",
                    "sense_definition": "A movable barrier used to control passage, such as at a railroad crossing or entrance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "barrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gate</w> in front of the railroad crossing went up after the train had passed.",
                            "target_lang_translations": {
                                "ru": "<w>Шлагбаум</w> перед железнодорожным переездом поднялся после того, как поезд проехал."
                            }
                        },
                        {
                            "text": "The security <w>gate</w> will only open if you have a valid ID card.",
                            "target_lang_translations": {
                                "ru": "Защитные <w>ворота</w> откроются только при наличии действующего удостоверения личности."
                            }
                        }
                    ],
                    "synonyms": [
                        "barrier"
                    ],
                    "common_phrases": [
                        "security gate",
                        "crossing gate",
                        "main gate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвижный барьер, используемый для контроля проезда или прохода, например, на железнодорожном переезде или входе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлагбаум",
                                "target_lang_sense_clarification": "на переезде или парковке"
                            },
                            {
                                "target_lang_word": "ворота",
                                "target_lang_sense_clarification": "защитный барьер"
                            },
                            {
                                "target_lang_word": "заграждение",
                                "target_lang_sense_clarification": "препятствие для прохода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "336d55c0-e9a5-34da-b68f-e9112ffbe6d2",
                    "sense_definition": "A passageway in an airport terminal where passengers board or exit an aircraft.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passengers for the flight to London should proceed to <w>gate</w> number twelve immediately.",
                            "target_lang_translations": {
                                "ru": "Пассажирам рейса в Лондон следует немедленно пройти к <w>выходу</w> номер двенадцать."
                            }
                        },
                        {
                            "text": "We waited at the <w>boarding</w> <w>gate</w> for two hours because the flight was delayed.",
                            "target_lang_translations": {
                                "ru": "Мы прождали у <w>выхода на посадку</w> два часа из-за задержки рейса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boarding gate",
                        "departure gate",
                        "arrival gate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проход в терминале аэропорта, через который пассажиры садятся в самолет или выходят из него."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выход на посадку",
                                "target_lang_sense_clarification": "в аэропорту"
                            },
                            {
                                "target_lang_word": "гейт",
                                "target_lang_sense_clarification": "термин в авиации"
                            },
                            {
                                "target_lang_word": "выход",
                                "target_lang_sense_clarification": "номер выхода в терминале"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc011099-061a-37f2-9f61-95277e23b8df",
                    "sense_definition": "The total amount of money collected or the number of people attending a sporting event or concert.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity football match had a record <w>gate</w> of over fifty thousand fans.",
                            "target_lang_translations": {
                                "ru": "Благотворительный футбольный матч собрал рекордное <w>число зрителей</w> — более пятидесяти тысяч болельщиков."
                            }
                        },
                        {
                            "text": "The <w>gate</w> <w>receipts</w> from the concert were donated to the local hospital.",
                            "target_lang_translations": {
                                "ru": "Кассовые <w>сборы</w> от концерта были переданы местной больнице."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gate receipts",
                        "total gate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общая сумма собранных денег или количество людей, посетивших спортивное мероприятие или концерт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "денежные поступления от билетов"
                            },
                            {
                                "target_lang_word": "число зрителей",
                                "target_lang_sense_clarification": "посещаемость мероприятия"
                            },
                            {
                                "target_lang_word": "выручка",
                                "target_lang_sense_clarification": "от продажи билетов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36ae455b-df17-307e-b587-b3b4e3f0c42e",
                    "sense_definition": "A logical pathway in a computer or circuit made of switches that turn on or off.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A basic <w>logic</w> <w>gate</w> can perform operations like AND, OR, and NOT.",
                            "target_lang_translations": {
                                "ru": "Базовый логический <w>вентиль</w> может выполнять такие операции, как И, ИЛИ и НЕ."
                            }
                        },
                        {
                            "text": "The processor contains millions of tiny transistors acting as a <w>gate</w> for electrical signals.",
                            "target_lang_translations": {
                                "ru": "Процессор содержит миллионы крошечных транзисторов, действующих как <w>затвор</w> для электрических сигналов."
                            }
                        }
                    ],
                    "synonyms": [
                        "logic gate"
                    ],
                    "common_phrases": [
                        "and gate",
                        "or gate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Логический путь в компьютере или схеме, состоящий из переключателей, которые включаются или выключаются."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вентиль",
                                "target_lang_sense_clarification": "логический элемент"
                            },
                            {
                                "target_lang_word": "логический элемент",
                                "target_lang_sense_clarification": "в электронике"
                            },
                            {
                                "target_lang_word": "затвор",
                                "target_lang_sense_clarification": "в транзисторах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b7e2c13-a5dc-3b0b-85da-858481f2eac6",
                    "sense_definition": "A slang term for a man or a male person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old jazz musician looked at his friend and asked, \"Whatcha gonna say there, <w>gate</w>?\"",
                            "target_lang_translations": {
                                "ru": "Старый джазмен посмотрел на друга и спросил: «Ну, что скажешь, <w>чувак</w>?»"
                            }
                        },
                        {
                            "text": "He was a cool <w>gate</w> who knew all the best spots in the city.",
                            "target_lang_translations": {
                                "ru": "Он был классным <w>типом</w> и знал все лучшие места в городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "dude",
                        "guy",
                        "chap",
                        "fella"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение мужчины или парня (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувак",
                                "target_lang_sense_clarification": "обращение к мужчине"
                            },
                            {
                                "target_lang_word": "тип",
                                "target_lang_sense_clarification": "о человеке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5daae7ae-1503-3ba7-b655-708395e2de8d",
                    "sense_definition": "To punish someone, especially a student, by restricting them to a particular place or not allowing them to go out.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The headmaster decided to <w>gate</w> the students for a week after they broke the curfew.",
                            "target_lang_translations": {
                                "ru": "Директор решил <w>оставить</w> студентов <w>под арестом</w> на неделю после того, как они нарушили комендантский час."
                            }
                        },
                        {
                            "text": "If you fail your exams, your parents might <w>gate</w> you for the entire summer.",
                            "target_lang_translations": {
                                "ru": "Если ты провалишь экзамены, родители могут <w>запереть</w> тебя дома на все лето."
                            }
                        }
                    ],
                    "synonyms": [
                        "ground"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наказать кого-либо, особенно студента, ограничив его пребывание в определенном месте или запретив выходить на улицу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставить под арестом",
                                "target_lang_sense_clarification": "в учебном заведении"
                            },
                            {
                                "target_lang_word": "запереть",
                                "target_lang_sense_clarification": "в качестве наказания"
                            },
                            {
                                "target_lang_word": "посадить под замок",
                                "target_lang_sense_clarification": "ограничить свободу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d30875b7-918c-3373-9934-0097daa91bf1",
                    "sense_definition": "To selectively regulate, restrict, or control access to something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The website will <w>gate</w> <w>access</w> to premium content until the user pays a subscription fee.",
                            "target_lang_translations": {
                                "ru": "Сайт будет <w>ограничивать</w> доступ к премиум-контенту, пока пользователь не оплатит подписку."
                            }
                        },
                        {
                            "text": "The software is designed to <w>gate</w> certain features based on the user's permission level.",
                            "target_lang_translations": {
                                "ru": "Программа разработана так, чтобы <w>фильтровать</w> доступ к определенным функциям в зависимости от уровня прав пользователя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gate access"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выборочно регулировать, ограничивать или контролировать доступ к чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничивать",
                                "target_lang_sense_clarification": "доступ к ресурсу"
                            },
                            {
                                "target_lang_word": "фильтровать",
                                "target_lang_sense_clarification": "входящий поток или доступ"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "09edaed4-7186-30b5-95ae-d38e60b4fd11",
                    "sense_definition": "A small town or community in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small town of <w>Gate</w>, Oklahoma, is located in Beaver County.",
                            "target_lang_translations": {
                                "ru": "Маленький городок <w>Гейт</w>, штат Оклахома, расположен в округе Бивер."
                            }
                        },
                        {
                            "text": "They drove through <w>Gate</w> while traveling across the state of Washington.",
                            "target_lang_translations": {
                                "ru": "Они проезжали через <w>Гейт</w>, путешествуя по штату Вашингтон."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой город или община в Соединенных Штатах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гейт",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}