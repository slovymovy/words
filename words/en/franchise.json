        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "765ad44e-7010-33ba-bf06-c43a9da34d71",
                    "sense_definition": "To grant an individual or group the right to sell goods or services under a brand's name and system.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The owners decided to <w>franchise</w> their restaurant concept to expand rapidly.",
                            "target_lang_translations": {
                                "ru": "Владельцы решили <w>продавать франшизу</w> на концепцию своего ресторана для быстрого расширения.",
                                "zh": "店主们决定将他们的餐厅理念<w>开放特许经营</w>，以实现快速扩张。"
                            }
                        },
                        {
                            "text": "They plan to <w>franchise</w> the business across the entire country.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>развивать</w> бизнес <w>по франшизе</w> по всей стране.",
                                "zh": "他们计划在全国范围内<w>开放特许经营</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "franchise a business",
                        "franchise out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять физическому лицу или группе право продавать товары или услуги под именем и системой бренда.",
                        "zh": "授予个人或团体以品牌名称和系统销售商品或服务的权利。"
                    },
                    "translations": {
                        "ru": [
