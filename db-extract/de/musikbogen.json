                "senses": [
                    {
                        "sense_id": "b7dc57b8-9d70-33ed-ad0c-1254baa51928",
                        "entry_id": "cd3a2124-3df0-3e3b-aca9-6683d201deb3",
                        "glosses": [
                            "ein sehr ursprüngliches Musikinstrument, das aus einem kleinen Bogen besteht, dessen straff gespannte Seite durch Zupfen oder Streichen zum Tönen gebracht wird. An den Bogen kann ein Resonanzkörper, z.B. eine Kalebasse angehängt sein"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "ed07bf5f-bd0b-4267-9186-f35f55c3d9ca",
                                "sense_id": "b7dc57b8-9d70-33ed-ad0c-1254baa51928",
                                "text": "„Man rechnet zu den primitiven Harfen-Formen mehrsaitige Chordophone, von denen man annimmt, daß sie irgendwie vom Musikbogen abstammen und durch Verschmelzung des ehemals nur angehängten Schallgefäßes … mit dem Stock entstanden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
