                                        "sense_id": "44f7fb03-e85c-356c-b6c4-dc00528c8bb4",
                                        "entry_id": "470f1fce-1abd-32e0-87f5-d67d6c278e43",
                                        "glosses": [
                                            "A native, or inhabitant of Samaria; especially one practising certain ethnoreligious traditions indigenous to that region."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5b5a3fc-a31b-4a02-b5cf-5b5a0a611ae6",
                                                "sense_id": "44f7fb03-e85c-356c-b6c4-dc00528c8bb4",
                                                "text": "Many of these despised people built a rival temple on Mount Gerizim in the central Palestinian territory known as Samaria, and hence they were called Samaritans (a word of contempt to Jews); in very reduced numbers, they still live round their sacred mountain now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37c79faa-3b33-3d6f-a7a8-ca542732d265",
                                        "entry_id": "470f1fce-1abd-32e0-87f5-d67d6c278e43",
                                        "glosses": [
                                            "A charitable person, one who helps others (from the Bible story in Luke 10:30–37)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdeef755-9ab5-3ebf-bd6a-e17a6b0816f8",
                                        "entry_id": "470f1fce-1abd-32e0-87f5-d67d6c278e43",
                                        "glosses": [
                                            "A person who works for the Samaritans telephone helpline, taking calls from suicidal members of the public."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
