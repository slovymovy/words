                ],
                "senses": [
                    {
                        "sense_id": "92b08e7b-9b7b-3dd1-998d-894e79941664",
                        "entry_id": "c5e469a0-8ba5-3f06-9cfb-49ed0bba25fa",
                        "glosses": [
                            "Donner un caractère corinthien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77543499-9eec-4c8b-97ee-1547d05cff16",
                                "sense_id": "92b08e7b-9b7b-3dd1-998d-894e79941664",
                                "text": "Les découvertes d’Aï Khanoum incitent à proposer une autre hypothèse quant au lieu d’origine de ces chapiteaux orientaux corinthianisés."
                            }
                        ]
                    },
                    {
                        "sense_id": "630fc9c9-de3f-3da6-aa86-e96a40808887",
                        "entry_id": "c5e469a0-8ba5-3f06-9cfb-49ed0bba25fa",
                        "glosses": [
                            "Amener à se livrer à la débauche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71816b6c-a727-4087-a0ef-1f109ddecc94",
                                "sense_id": "630fc9c9-de3f-3da6-aa86-e96a40808887",
                                "text": "Une fois de plus, Ils ont corinthianisé mon Peuple, et dans cinq ans ils remonteront leur braguette avec un sourire aux coins des lèvres, satisfaits de l'avoir malhonnêtement bien niqué."
                            }
                        ]
                    },
                    {
                        "sense_id": "7771a95d-70b3-32ab-bdd0-f7b5e4a8395b",
                        "entry_id": "c5e469a0-8ba5-3f06-9cfb-49ed0bba25fa",
                        "glosses": [
                            "Se livrer à la débauche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bef421e-be7c-42f8-8028-2384f143839f",
                                "sense_id": "7771a95d-70b3-32ab-bdd0-f7b5e4a8395b",
                                "text": "Nous nous rappelons bien que la réputation de cette métropole marchande avait atteint un point si dégradant que si l’on voulait dire de quelqu’un qu’il était débauché dans sa vie, on disait, « il ne fait que corinthianiser. »."
                            }
                        ]
                    }
                ],
