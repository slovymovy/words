                "senses": [
                    {
                        "sense_id": "c3ba7799-9dab-3149-b1cf-d33127dbc56c",
                        "entry_id": "e9de6d5f-0165-3307-9e91-4ad809704bc3",
                        "glosses": [
                            "apparaat waarmee men geluid kan vastleggen op magnetische tape"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5c7c4a7-053f-47f5-84e3-5d06960beb7d",
                                "sense_id": "c3ba7799-9dab-3149-b1cf-d33127dbc56c",
                                "text": "Onderzoekers van Philips beginnen met de ontwikkeling van een compacte batterijrecorder die de bandopnemer met losse, grote spoelen moet vervangen."
                            },
                            {
                                "example_id": "04e34acc-d3fc-433c-bc52-3610c125ae46",
                                "sense_id": "c3ba7799-9dab-3149-b1cf-d33127dbc56c",
                                "text": "Bandopnemer in bed: DON’T. Iets opnemen om tijdens je slaap af te spelen, helpt niet volgens Verbraecken. ‘Dat is een studentenmythe.’ Tijdens je slaap kun je geen informatie opnemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1efa5a72-2481-40e0-9d57-22013a9b2da5",
                        "source_entry_id": "e9de6d5f-0165-3307-9e91-4ad809704bc3",
                        "source_sense_id": "c3ba7799-9dab-3149-b1cf-d33127dbc56c",
                        "source_sense_description": "apparaat waarmee men geluid kan vastleggen op magnetische tape",
                        "target_lang_word": "Tonbandgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tonbandgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                        "entry_id": "ff79a021-a166-341e-a42e-a0e3350321e7",
                                        "glosses": [
                                            "ein Gerät, mit dem man Geräusch-, Sprach- oder Musikaufnahmen auf sogenannten Tonbändern herstellen und abhören kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c99856a-8946-4aa8-b98e-a78c9c7be1c6",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„In der fünften Klasse kam der Schuldirektor meiner sowjetischen Schule mitten im Unterricht mit einem großen Tonbandgerät und einem Mikrofon zu uns in die Klasse.“"
                                            },
                                            {
                                                "example_id": "7c74d3bd-624a-4a6e-b461-7a56c8eb7f74",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„Neben ihr saß Miss Carey vor einem Klapptischchen, auf dem das Tonbandgerät stand.“."
                                            },
                                            {
                                                "example_id": "802ab761-fcda-41e6-9344-c6dcf216ad07",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„Inzwischen hatte sich der Tombolatisch bis auf ein paar Plüschtiere, eine LP und das Tonbandgerät geleert.“"
                                            },
                                            {
                                                "example_id": "bb06f586-840b-4957-8f5a-c045381d131d",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„Im Schrank erwarteten mich, gut verpackt, ein Tonbandgerät und ein Fotoapparat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00af6c15-aaca-45dc-b848-27857205daa7",
                        "source_entry_id": "e9de6d5f-0165-3307-9e91-4ad809704bc3",
                        "source_sense_id": "c3ba7799-9dab-3149-b1cf-d33127dbc56c",
                        "source_sense_description": "apparaat waarmee men geluid kan vastleggen op magnetische tape",
                        "target_lang_word": "tape recorder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tape recorder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c32521a2-64ae-33a1-af19-cee712e9f921",
                                        "entry_id": "703cff50-e9da-369e-aedc-6a48a1274c30",
                                        "glosses": [
                                            "An electromechanical device use to record and play back sound, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a077b096-52fb-46f6-a570-b094fd5e3a2c",
                                                "sense_id": "c32521a2-64ae-33a1-af19-cee712e9f921",
                                                "text": "A cabled despatch is better than nothing, but a voicecast of tolerable quality is preferable, and in certain types of story a voicecast with live or recorded actuality is best of all. Correspondents all have portable tape recorders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "747f082d-7873-4102-8410-51aee130f54e",
                        "source_entry_id": "e9de6d5f-0165-3307-9e91-4ad809704bc3",
                        "source_sense_id": "c3ba7799-9dab-3149-b1cf-d33127dbc56c",
                        "source_sense_description": "apparaat waarmee men geluid kan vastleggen op magnetische tape",
                        "target_lang_word": "magnétophone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnétophone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
                                        "entry_id": "45de375e-f65b-303e-ad82-b397da457da2",
                                        "glosses": [
                                            "Outil permettant d’enregistrer des sons sur un support magnétique amovible."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "965933e4-4d37-4f08-96ea-cc9a706b6565",
                                                "sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
                                                "text": "Le premier magnétophone de Poulsen utilisait un fil magnétique."
                                            },
                                            {
                                                "example_id": "decc026e-7358-4721-bb1d-5ca0e860289d",
                                                "sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
                                                "text": "Le magnétophone a été remplacé dans le grand public par des lecteurs/enregistreurs à mémoire flash-eprom"
                                            },
                                            {
                                                "example_id": "64b5a675-3d3e-40a7-ba7c-4a8ba3f75704",
                                                "sense_id": "9ea7f868-fc62-3d75-9585-a2c70a7703cc",
                                                "text": "Un après-midi, le docteur Baramian, que le bruit n’avait pas encore chassé, avait invité Lucile et Lisbeth dans son cabinet pour leur montrer son magnétophone. Elles ignoraient l’une et l’autre qu’un tel engin existât."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
