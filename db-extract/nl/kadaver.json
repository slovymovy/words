                                                "sense_id": "7f9dde51-a0cc-3ae1-ba04-ee246f9ec410",
                                                "text": "Powiedział, że po raz pierwszy w życiu zdarzyło mu się, że patrząc na mięso na swoim talerzu, ujrzał czyjeś zwłoki"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
