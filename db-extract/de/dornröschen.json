                    {
                        "sense_id": "fddf6462-adfe-3373-abcd-cfcdfc2375a4",
                        "entry_id": "95afb073-bce3-3ce9-8771-8632d947bc92",
                        "glosses": [
                            "weibliche Märchenfigur des deutschsprachigen Kulturkreises nach dem gleichnamigen Märchen der Gebrüder Grimm"
                        ],
                        "tags": [
                            "Märchen"
                        ],
                        "examples": [
                            {
                                "example_id": "8c15dc19-b866-4320-b0ab-c1178380f183",
                                "sense_id": "fddf6462-adfe-3373-abcd-cfcdfc2375a4",
                                "text": "Dornröschen braucht mehr Schlaf, als es für junge Frauen dieses Alters üblich ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15e0157f-98dd-46a4-a666-e7dd43996765",
                        "source_entry_id": "95afb073-bce3-3ce9-8771-8632d947bc92",
                        "source_sense_id": "fddf6462-adfe-3373-abcd-cfcdfc2375a4",
                        "source_sense_description": "weibliche Märchenfigur des deutschsprachigen Kulturkreises nach dem Märchen der Gebrüder Grimm",
                        "target_lang_word": "Sleeping Beauty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sleeping Beauty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16f7cd6b-53b3-3ee7-b2db-0955daa51341",
                                        "entry_id": "34bf2bc0-90aa-3fc1-9cfb-58dc0634d070",
                                        "glosses": [
                                            "A fairy tale originally titled La Belle au bois dormant by Charles Perrault."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4500414b-a893-31c0-a5be-bc88c9311487",
                                        "entry_id": "34bf2bc0-90aa-3fc1-9cfb-58dc0634d070",
                                        "glosses": [
                                            "The main character in this story, who is in unbroken slumber under a magical spell, awaiting the kiss of a prince."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aa56a04-6de8-4c6f-b6d8-6f93ed861ffc",
                                                "sense_id": "4500414b-a893-31c0-a5be-bc88c9311487",
                                                "text": "How far have we come since the days of our favorite childhood fairy tales if women still need a rescuer like the Cinderellas, Sleeping Beauties, and other helpless maidens of the past?"
                                            },
                                            {
                                                "example_id": "0d0eb809-4b1a-4724-afd7-35714ed1b3cc",
                                                "sense_id": "4500414b-a893-31c0-a5be-bc88c9311487",
                                                "text": "Womanly duties, as Joan thought of them, were fine for girls who imagined themselves as Cinderellas or Sleeping Beauties, good girls rewarded for menial housework and, in the case of Sleeping Beauty, a passivity so profound it was deaf, dumb, blind, and comatose."
                                            },
                                            {
                                                "example_id": "7f907a13-d1df-43ca-91c1-8c1189f3439f",
                                                "sense_id": "4500414b-a893-31c0-a5be-bc88c9311487",
                                                "text": "They emote and are long-winded about it; they express affection and passion and have sex and revel in it; they are cruel and vengeful; they whine and complain, gossip, browbeat, and nag—in short, everything that we have always suspected is behind the refractive exteriors of the more famous Cinderellas and Sleeping Beauties. […] It features a storyteller who, tired of telling the same old Cinderellas and Sleeping Beauties, meets up with some fairies in a wood as he is searching for new material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b314ca40-1d75-31d3-972a-fbf22b7d508a",
                                        "entry_id": "34bf2bc0-90aa-3fc1-9cfb-58dc0634d070",
                                        "glosses": [
                                            "A transposon used in genetic engineering."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fc89af8-151c-3cd7-960c-90208304bc69",
                                        "entry_id": "34bf2bc0-90aa-3fc1-9cfb-58dc0634d070",
                                        "glosses": [
                                            "One who is asleep at an inappropriate time."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf44c6e-58b7-453f-83c8-e924dfcf4e06",
                                                "sense_id": "6fc89af8-151c-3cd7-960c-90208304bc69",
                                                "text": "Wake up Sleeping Beauty, school starts in 10 minutes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Sleeping Beauty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f546d413-a29e-3bc4-bd91-b0ba5763f186",
                                        "entry_id": "91e25db1-53dd-3114-a4d7-180c5c3ac458",
