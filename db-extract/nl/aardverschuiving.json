                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landslide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db886f06-e8ed-3d1f-b159-24d6790ae16f",
                                        "entry_id": "fbe831b1-5c8e-3449-b795-0554da01f247",
                                        "glosses": [
                                            "A natural disaster that involves the breakup and downhill flow of rock, mud, water and anything caught in the path."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e6698e6-5f6d-4fd6-9637-40c71622771f",
                                                "sense_id": "db886f06-e8ed-3d1f-b159-24d6790ae16f",
                                                "text": "Near-synonym: mudflow"
                                            },
                                            {
                                                "example_id": "5be8a3a5-5e10-4b06-93c1-56b30c9e210e",
                                                "sense_id": "db886f06-e8ed-3d1f-b159-24d6790ae16f",
                                                "text": "The landslides Wednesday in Zhejiang province, south of the financial hub of Shanghai, followed Typhoon Megi, which brought heavy rains and high winds to China and Taiwan this past week.[…]\nThe second landslide in Wencheng county killed five people, with one person still missing, an official at the county’s flood control office said Saturday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c87f5e32-ca26-368d-b97b-5144b6868e32",
                                        "entry_id": "fbe831b1-5c8e-3449-b795-0554da01f247",
                                        "glosses": [
                                            "A vote won by a wide or overwhelming majority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0da3486-790d-4a1a-9957-a435f0f7a8cf",
                                                "sense_id": "c87f5e32-ca26-368d-b97b-5144b6868e32",
                                                "text": "The candidate won at 61% to 39%, which most people are calling a landslide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "landslide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f16dd6ac-3d87-36e5-8bd1-961ef83ad1ec",
                                        "entry_id": "92fca644-dc92-3422-95a2-d0d0e5fa5603",
                                        "glosses": [
                                            "To undergo a landslide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e7989d-16f4-4589-8060-3de88f142fa0",
                                                "sense_id": "f16dd6ac-3d87-36e5-8bd1-961ef83ad1ec",
                                                "text": "So it landslid mightily, carrying off greens and fairways and all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "591b2d6c-c7e1-45d5-9bf5-a1a70f8fb9fc",
                        "source_entry_id": "f278b743-6975-36aa-9c77-357aadde53d6",
                        "source_sense_id": "0e21c2ab-c661-3ca1-b8cc-b01eab750db6",
                        "source_sense_description": "het naar beneden schuiven van een grote massa grond",
                        "target_lang_word": "éboulement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éboulement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                        "entry_id": "1e3e2288-87aa-34ad-803e-e4c9c07fbad0",
                                        "glosses": [
                                            "Chute d’une chose qui s’éboule ou état d’une chose éboulée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a5c1eb-fd44-4679-addb-9d83837b0600",
                                                "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                                "text": "Le village de Vouvray se trouve comme niché dans les gorges et les éboulements de ces roches, …."
                                            },
                                            {
                                                "example_id": "f8f3adb1-6a92-470f-93eb-4e3e77926ea6",
                                                "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                                "text": "Après un tel paroxysme, l’éboulement des côtés du cratère obstrue encore plus l’orifice du volcan, et l’oblitère entièrement. On peut alors procéder à des observations […]."
                                            },
                                            {
                                                "example_id": "cb911c3e-5c38-43b4-a810-bb070cdc685e",
                                                "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                                "text": "Cette berge, […], émergeait d’une dizaine de pieds. Elle était absolument accore, sans talus, et quelques portions, quelques tranches plus fraîches, attestaient des éboulements récents."
                                            },
                                            {
                                                "example_id": "422a7825-2f04-4986-a106-264a23508cbd",
                                                "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                                "text": "Au mois de février suivant, on entendit fréquemment des bruits sourds provenant d’éboulements et de mouvements intérieurs dans le sol; un fondis, remblayé autrefois, se manifesta de nouveau, au haut de la montagne ; […]."
                                            },
                                            {
                                                "example_id": "63e259f1-1f70-4d68-a616-a1a1db5bb8b8",
                                                "sense_id": "70e7a35c-6a76-3b3d-861f-0224d717d88b",
                                                "text": "Il m’est dit à chaque instant que l’un des grands soucis des autorités départementales, c’est l’entretien des routes, souvent emportées par des torrents, par les coulées de boue, par les éboulements, par des chutes de blocs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
