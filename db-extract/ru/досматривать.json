                            "future"
                        ],
                        "form": "буду/будешь… досма́тривать"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d4c887f-652c-3311-ab50-2c4fce5b8c6b",
                        "entry_id": "7f76e1f5-cb0a-3139-be87-25c3ab7a8985",
                        "glosses": [
                            "заканчивать смотреть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bac0ac82-b99b-48cd-b414-6654963af1ef",
                                "sense_id": "3d4c887f-652c-3311-ab50-2c4fce5b8c6b",
                                "text": "Через пару минут официантка принесла мужчинам заказ — они были единственными посетителями в кафе — и снова скрылась за прилавком досматривать очередную серию какого-то сериала."
                            }
                        ]
                    },
                    {
                        "sense_id": "94478fc7-0d02-3dcd-b8e0-b314fc949868",
                        "entry_id": "7f76e1f5-cb0a-3139-be87-25c3ab7a8985",
                        "glosses": [
                            "смотреть до конца, до какого-либо предела"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65c8606a-ba45-40c5-8547-e8355bf1961a",
                                "sense_id": "94478fc7-0d02-3dcd-b8e0-b314fc949868",
                                "text": "Это был очень страшный сон, я не стала досматривать его до конца и проснулась."
                            }
                        ]
                    },
                    {
                        "sense_id": "4810051f-2ad9-3746-a561-b6859daeb9ba",
                        "entry_id": "7f76e1f5-cb0a-3139-be87-25c3ab7a8985",
                        "glosses": [
                            "разг. следить за кем-либо, чем-либо, ухаживая, заботясь и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5787d45a-9f2e-4873-8da6-67f742415f98",
                                "sense_id": "4810051f-2ad9-3746-a561-b6859daeb9ba",
                                "text": "Велено мне досматривать за государевым преступником."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e162f2a-d8c9-34ac-83de-37ac6961fa18",
                        "entry_id": "7f76e1f5-cb0a-3139-be87-25c3ab7a8985",
                        "glosses": [
                            "спец. производить проверочный осмотр"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9a47a1a-670b-46ee-829f-380092ad0b88",
                                "sense_id": "9e162f2a-d8c9-34ac-83de-37ac6961fa18",
                                "text": "В приказе указывается, что начальники таможен должны досматривать ежедневно не менее одного грузового и одного легкового автомобиля в смену — «исходя из результатов анализа рисков» либо по информации «государственных контролирующих и правоохранительных органов»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bee0246d-f64c-4c83-9a85-e943f710e91a",
                        "source_entry_id": "7f76e1f5-cb0a-3139-be87-25c3ab7a8985",
