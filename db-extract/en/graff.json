                    {
                        "sense_id": "82aea64b-fe24-3edd-955b-b9161dfeba7f",
                        "entry_id": "2012f1e7-7385-3a8d-8366-e0afd439d368",
                        "glosses": [
                            "Clipping of graffiti"
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1279557c-70d4-4a27-954d-606af237b6b9",
                                "sense_id": "82aea64b-fe24-3edd-955b-b9161dfeba7f",
                                "text": "Just two days ago, I had graffed a piece with my crew and went to Sunrise High School."
                            },
                            {
                                "example_id": "9bd1f87a-71b3-48ef-b7ff-04426baab785",
                                "sense_id": "82aea64b-fe24-3edd-955b-b9161dfeba7f",
                                "text": "There’s nothing like heat in this light. There’s only what I’m graffing—the swirls and orbs and flecks and tags, the pictures I’m making for Stefan."
                            },
                            {
                                "example_id": "10a367af-7637-46c8-9e0d-031c08d7582a",
                                "sense_id": "82aea64b-fe24-3edd-955b-b9161dfeba7f",
                                "text": "Whilst living in Squatopolis, I remember returning home with a bag of sweaty skip, and finding him graffing a huge piece on to one wall: the squat logo being smashed with a fist surrounded by the words “Better Let Homes Rot Than Squat”."
                            }
                        ]
                    }
