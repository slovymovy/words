                "senses": [
                    {
                        "sense_id": "8bd98348-0f4b-392c-aa37-4766cc5de461",
                        "entry_id": "99cf8a10-aca4-39c3-873e-728696e39892",
                        "glosses": [
                            "A female given name from English."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e44f148-92bc-4ad4-9653-62481867081c",
                                "sense_id": "8bd98348-0f4b-392c-aa37-4766cc5de461",
                                "text": "Grandma said, \"I used to know a little girl called Holly - she always had her dresses trimmed with red or green.\" Milly-Molly-Mandy thought that was quite a nice name."
                            },
                            {
                                "example_id": "690b9b6a-a084-4c20-b650-183c3263953c",
                                "sense_id": "8bd98348-0f4b-392c-aa37-4766cc5de461",
                                "text": "\"Holly, would you mind if I named my little girl 'Holly'? I mean, it's right around Christmas time, and I always think of holly with Christmas."
                            },
                            {
                                "example_id": "fa9cce87-1093-41ec-9928-8f9021935ffa",
                                "sense_id": "8bd98348-0f4b-392c-aa37-4766cc5de461",
                                "text": "The bodies of 19-year-old best friends Holly Bowles and Bianca Jones were returned to Australia on Tuesday night."
                            }
                        ]
                    },
