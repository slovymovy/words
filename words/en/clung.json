            "senses": [
                {
                    "sense_id": "3b9e5fb3-1741-3cbf-a971-5414507b622f",
                    "sense_definition": "simple past and past participle of <w>cling</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child <w>clung</w> to his mother because he was afraid of the dark.",
                            "target_lang_translations": {
                                "cs": "Dítě se <w>drželo</w> své matky, protože se bálo tmy."
                            }
                        },
                        {
                            "text": "She <w>clung</w> to the hope that her lost dog would eventually return home.",
                            "target_lang_translations": {
                                "cs": "Stále <w>lpěla</w> na naději, že se její ztracený pes nakonec vrátí domů."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clung to"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle of cling"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa cling (držet se, lpět)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "držel se",
                                "target_lang_sense_clarification": "fyzické sevření nebo lpění na někom"
                            },
                            {
                                "target_lang_word": "lpěl",
                                "target_lang_sense_clarification": "metaforické lpění na naději nebo myšlence"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "55132616-79e1-34d8-9341-a64acbcabe70",
                    "sense_definition": "Shrunken or wasted away",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>clung</w> fabric of the old shirt showed how much weight he had lost.",
                            "target_lang_translations": {
                                "cs": "<w>Scvrklá</w> látka staré košile ukazovala, kolik váhy ztratil."
                            }
                        },
                        {
                            "text": "After the long illness, his <w>clung</w> frame looked very fragile.",
                            "target_lang_translations": {
                                "cs": "Po dlouhé nemoci vypadala jeho <w>vyhublá</w> postava velmi křehce."
                            }
                        }
                    ],
                    "synonyms": [
                        "shrunken",
                        "wasted"
                    ],
                    "antonyms": [
                        "plump",
                        "robust"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zmenšený, scvrklý nebo vyhublý v důsledku nemoci či úbytku hmotnosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "scvrklý",
                                "target_lang_sense_clarification": "o látce nebo materiálu, který ztratil objem"
                            },
                            {
                                "target_lang_word": "vyhublý",
                                "target_lang_sense_clarification": "o postavě, která ztratila tělesnou hmotnost"
                            }
                        ]
                    }
                }
            ]
        }
    ]
