                                        "sense_id": "094cc99a-19be-3a3c-9f91-5a56da91c188",
                                        "entry_id": "9d7ed82b-a229-3021-9eaf-8ec69f1694b6",
                                        "glosses": [
                                            "действие или состояние по значению гл. оцепенеть"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d965e47-a238-4619-a1c3-888a5794559a",
                                                "sense_id": "094cc99a-19be-3a3c-9f91-5a56da91c188",
                                                "text": "Он долго слушал отдалённые крики и стоны утопающего и приходил от них в оцепенение."
                                            }
                                        ]
