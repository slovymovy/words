                ],
                "senses": [
                    {
                        "sense_id": "d5249d3e-adf5-361c-8d2c-5d69caf74e5e",
                        "entry_id": "e99a9d8e-9ad3-3297-95b2-e94d31739baa",
                        "glosses": [
                            "einfach behauener, säulenförmiger Stein, der die Stundenangaben vom/zum Ort angibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "660b5f73-8fd8-417f-b0ee-aed594b8c3c5",
                                "sense_id": "d5249d3e-adf5-361c-8d2c-5d69caf74e5e",
                                "text": "Beim nächsten Stundenstein sind wir weit genug weg von zu Hause."
                            },
                            {
                                "example_id": "4a67e2bf-2c0e-4e87-bf9e-6a3ffa3832a4",
                                "sense_id": "d5249d3e-adf5-361c-8d2c-5d69caf74e5e",
                                "text": "„Unterkategorie Stundensteine: Meist einfach behauene, aufrecht stehende Steine mit Inschrift und/oder Ziffernangabe“"
                            },
                            {
                                "example_id": "e2fa37dc-2bdc-470c-8542-a6aead190bab",
                                "sense_id": "d5249d3e-adf5-361c-8d2c-5d69caf74e5e",
                                "text": "„Die dreieckigen Stundensteine in Form von Obelisken liess der letzte Kurt[r]ierische Bischof an der alten Poststrecke Koblenz-Frankfurt im Jahr der französischen Revolution 1789 aufgestellen [sic!].“"
                            },
                            {
                                "example_id": "85527058-830f-4019-8d2e-14517aab0625",
                                "sense_id": "d5249d3e-adf5-361c-8d2c-5d69caf74e5e",
                                "text": "„Gleich hinter der das Amt Ehrenbreitstein vom Amt Montabaur trennenden Grenze (das Amt Montabaur fanget an der gränz des Koblenzer Waldes an) begegnet einem der bereits eingangs erwähnte Stundenstein, der zweite im Westerwaldkreis entlang der KFS und der dritte von Koblenz (III Stunden von Coblenz 1789 XVIII Stunden von Franckfurt 1789)“"
                            },
                            {
                                "example_id": "010dc2e5-8f49-40fe-bce1-e5243821fc76",
                                "sense_id": "d5249d3e-adf5-361c-8d2c-5d69caf74e5e",
                                "text": "„Ein Kilometer westlich von Eckersdorf, links der B 22, neben der abzweigenden Straße steht dieser Stundenstein, der anzeigt, wie lange man im 18. Jahrhundert von Erlangen nach Bayreuth - nämlich 17 Stunden - und von Bayreuth nach Bamberg - 10 Stunden - unterwegs war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
