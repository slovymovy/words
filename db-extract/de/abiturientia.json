                "senses": [
                    {
                        "sense_id": "ac89b7e2-e9ff-330f-82da-55be5159f84c",
                        "entry_id": "356ca9bb-e7f6-35fb-b753-7acbf89631d0",
                        "glosses": [
                            "die Gesamtheit der Abiturientinnen und Abiturienten eines Jahrgangs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa14f71-3e25-4827-a1f9-6f2153829a78",
                                "sense_id": "ac89b7e2-e9ff-330f-82da-55be5159f84c",
                                "text": "Die Abiturientia 2012 lädt Sie herzlich ein zum Abiball am 15. Juni in der Stadthalle."
                            },
                            {
                                "example_id": "adbccb2e-c05d-4802-a773-de766223e2df",
                                "sense_id": "ac89b7e2-e9ff-330f-82da-55be5159f84c",
                                "text": "„Beim Abitur 1833 muß er einer der Besten, wenn nicht der Beste gewesen sein; denn er hielt die Abschiedsrede für die Abiturientia.“"
                            },
                            {
                                "example_id": "1d4342a9-d976-4d4b-93ba-46ab8f478e62",
                                "sense_id": "ac89b7e2-e9ff-330f-82da-55be5159f84c",
                                "text": "„Beide gehörten zu den fünf Besten der Abiturientia 1968 des Dreikönigsgymnasiums.“"
                            },
                            {
                                "example_id": "b1bd8bd4-59f5-4d8d-a9d3-8d1a0660354a",
                                "sense_id": "ac89b7e2-e9ff-330f-82da-55be5159f84c",
                                "text": "„Es ist heuer bereits die vierte Abiturientia, die den Tag verflucht, an dem Studienrat Dr. Paul Fleig auf goldenen Brücken der CDU vom Klassenkatheder in den Amtssessel gelangte."
                            },
                            {
                                "example_id": "95c6cb14-aa40-4e4c-b916-89a95f19f4f3",
                                "sense_id": "ac89b7e2-e9ff-330f-82da-55be5159f84c",
                                "text": "„Der Lebensweg des Bocholter Abiturienten Erich Kosthorst ist sicher kein zu verallgemeinerndes Beispiel für das Schicksal der Abiturientia 1939.“"
                            },
                            {
                                "example_id": "e5e1745d-43ce-458f-a72e-4fb9c7481296",
                                "sense_id": "ac89b7e2-e9ff-330f-82da-55be5159f84c",
                                "text": "„Wie es Tradition war, hatte die Abiturientia dieses Gymnasiums einen der Ihren ausgewählt, der bei der Abschiedsfeier nach dem bestandenen Abitur im Anschluss an die Abschiedsworte des Direktors eine Antwort- und Dankesrede halten sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
