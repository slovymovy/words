                                "example_id": "55eab592-4b15-429b-9bbc-3865893131a1",
                                "sense_id": "14afb30d-3dad-3cb3-9eb6-16de3a9b7906",
                                "text": "Thans is het percentage orthodoxe joden weer groeiende: behoort slechts 11% van de Amerikaanse joden tot de orthodoxie, onder de jongeren bedraagt dat percentage reeds 16%."
                            }
                        ]
                    },
                    {
                        "sense_id": "6750d8ee-2717-3751-98c5-21e581528dda",
                        "entry_id": "968258d8-2422-3d7a-8e6f-c56f2de469fc",
                        "glosses": [
                            "een van de drie varianten van het christendom, met volgelingen voornamelijk in de Balkan, Oost-Europa en Rusland"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
