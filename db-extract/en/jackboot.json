                "senses": [
                    {
                        "sense_id": "2e95376b-ba83-3b08-aca5-426d4e47f4c7",
                        "entry_id": "d538ac12-3b3b-3bc3-97df-961f77b06d90",
                        "glosses": [
                            "To stamp on with a jackboot."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "56d4f104-c14a-4eb2-9203-707c483d493d",
                                "sense_id": "2e95376b-ba83-3b08-aca5-426d4e47f4c7",
                                "text": "The two porters leapt into action, steamed up to the front of the room and started jackbooting the burning paper."
                            }
                        ]
                    },
                    {
                        "sense_id": "f611bc95-28ee-3cc1-b690-3303597462f9",
                        "entry_id": "d538ac12-3b3b-3bc3-97df-961f77b06d90",
                        "glosses": [
                            "To march in jackboots."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6fc0726c-ea94-4472-acb3-5891e888d54d",
                                "sense_id": "f611bc95-28ee-3cc1-b690-3303597462f9",
                                "text": "All his childhood they had stormed through the cinema newsreels, jackbooting triumphantly through Vienna, Prague, Warsaw, Paris. Now they would jackboot through Garmouth. Followed by the Gestapo."
                            }
                        ]
                    }
