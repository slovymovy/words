{
    "word_family": [
        "immense",
        "immensely"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b6ea319-1247-3425-9084-de1db97677c6",
                    "sense_definition": "The state or quality of being extremely large in size, degree, or extent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>immensity</w> of the ocean makes humans feel very small.",
                            "target_lang_translations": {
                                "ru": "<w>Необъятность</w> океана заставляет людей чувствовать себя очень маленькими."
                            }
                        },
                        {
                            "text": "She was overwhelmed by the <w>immensity</w> of the task ahead.",
                            "target_lang_translations": {
                                "ru": "Её подавила <w>огромность</w> предстоящей задачи."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastness",
                        "enormity",
                        "hugeness"
                    ],
                    "antonyms": [
                        "smallness",
                        "littleness"
                    ],
                    "common_phrases": [
                        "immensity of space",
                        "sheer immensity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или качество чего-либо чрезвычайно большого по размеру, степени или протяженности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "необъятность",
                                "target_lang_sense_clarification": "подчеркивает огромный масштаб или пространство"
                            },
                            {
                                "target_lang_word": "огромность",
                                "target_lang_sense_clarification": "общий термин для обозначения очень большого размера"
                            },
                            {
                                "target_lang_word": "безбрежность",
                                "target_lang_sense_clarification": "часто используется для описания водных пространств или неба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "014aa837-4273-30fe-afb4-1afbdb9eadc0",
                    "sense_definition": "An object or entity that is extremely large.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain stood as an <w>immensity</w> against the clear blue sky.",
                            "target_lang_translations": {
                                "ru": "Гора возвышалась как <w>громада</w> на фоне чистого синего неба."
                            }
                        },
                        {
                            "text": "They gazed up at the dark <w>immensity</w> of the ancient castle walls.",
                            "target_lang_translations": {
                                "ru": "Они смотрели вверх на тёмную <w>громаду</w> стен древнего замка."
                            }
                        }
                    ],
                    "synonyms": [
                        "giant",
                        "colossus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект или сущность, обладающая чрезвычайно большими размерами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громада",
                                "target_lang_sense_clarification": "крупный, массивный объект"
                            },
                            {
                                "target_lang_word": "гигант",
                                "target_lang_sense_clarification": "нечто очень большое, возвышающееся над остальным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}