    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6aa1cb9c-dfe3-362c-8c33-50a321e53ee8",
                    "sense_definition": "dwutaktowy, umiarkowanie szybki chód konia (i innych zwierząt czworonożnych), szybszy od stępa, lecz wolniejszy od galopu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chód",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeździec delikatnie pociągnął za wodze i przeszedł z galopu w spokojny <w>kłus</w>.",
                            "target_lang_translations": {
                                "ru": "Всадник мягко натянул поводья и перешёл с галопа на спокойную <w>рысь</w>."
                            }
                        },
                        {
                            "text": "Klacz ma problemy z kopytem, dlatego o żadnym szybszym <w>kłusie</w> nie może być teraz mowy.",
                            "target_lang_translations": {
                                "ru": "У кобылы проблемы с копытом, поэтому ни о какой более быстрой <w>рыси</w> сейчас не может быть и речи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przejść w kłus",
                        "kłus wyciągnięty"
                    ],
                    "target_lang_definitions": {
                        "ru": "двухтактный, умеренно быстрый аллюр лошади (и других четвероногих животных), более быстрый, чем шаг, но медленнее галопа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рысь",
                                "target_lang_sense_clarification": "аллюр лошади"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "780a932d-f3e5-3281-b76b-e7fc11664f80",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Kłus</w> przyszedł dzisiaj punktualnie na zebranie zarządu naszej firmy.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Клус</w> пришёл сегодня вовремя на заседание правления нашей компании."
                            }
                        },
                        {
                            "text": "Wczoraj rozmawiałem z doktorem Piotrem <w>Kłusem</w> o wynikach moich ostatnich badań.",
                            "target_lang_translations": {
                                "ru": "Вчера я разговаривал с доктором Петром <w>Клусом</w> о результатах моих последних анализов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko męskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская мужская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Клус",
                                "target_lang_sense_clarification": "мужская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1171067c-b7d5-3dcf-8f51-e00b2e4ce7fb",
                    "sense_definition": "polskie nazwisko żeńskie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani Anna <w>Kłus</w> została wybrana na nową przewodniczącą komisji rewizyjnej.",
                            "target_lang_translations": {
                                "ru": "Госпожа Анна <w>Клус</w> была избрана новым председателем ревизионной комиссии."
                            }
                        },
                        {
                            "text": "W sekretariacie czeka ważny dokument przygotowany przez mecenas <w>Kłus</w>.",
                            "target_lang_translations": {
                                "ru": "В секретариате ожидает важный документ, подготовленный адвокатом <w>Клус</w>."
                            }
                        }
                    ],
