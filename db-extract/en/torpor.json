                                "target_senses": [
                                    {
                                        "sense_id": "9906af25-cdb5-3dba-b5f0-dfa84bf6cb82",
                                        "entry_id": "7ad49567-853c-3b3e-a338-6dbe93111ade",
                                        "glosses": [
                                            "Vorgang, bei dem etwas starr wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f997fe49-e0c6-4a9c-9962-8b47aac3caf8",
                                                "sense_id": "9906af25-cdb5-3dba-b5f0-dfa84bf6cb82",
                                                "text": "„Mittels spezieller Betonzusatzmittel kann bei Bedarf die Erstarrung beschleunigt oder verzögert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0ad361a7-d076-3214-8c03-b81faca12d67",
                                        "entry_id": "7ad49567-853c-3b3e-a338-6dbe93111ade",
                                        "glosses": [
                                            "Zustand, nachdem etwas erstarrt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7afc0030-b574-4617-9aef-45e74c65f568",
                                                "sense_id": "0ad361a7-d076-3214-8c03-b81faca12d67",
                                                "text": "Nur langsam löste sich Karl aus seiner Erstarrung."
                                            },
                                            {
                                                "example_id": "c9814885-65ef-451d-8cb0-01f573edd62c",
                                                "sense_id": "0ad361a7-d076-3214-8c03-b81faca12d67",
                                                "text": "„Das erste, was sie wahrgenommen hatte, nachdem sie sich aus ihrer eigenen Erstarrung gelöst hatte, war sein Äußeres.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a5582b4-e342-4538-9018-08d852ef2dd5",
                        "source_entry_id": "90c659f5-9bc5-3e80-ba8f-fe3defa591e5",
