{
    "word_family": [
        "dialer",
        "redial",
        "sundial"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "94e5f2ee-cdad-3214-8df1-6f6341230605",
                    "sense_definition": "To enter a telephone number to make a call, either by pressing buttons or turning a rotary disk.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "telephony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In case of an emergency, you should <w>dial</w> the police immediately.",
                            "target_lang_translations": {
                                "ru": "В случае чрезвычайной ситуации вам следует немедленно <w>набрать</w> полицию.",
                                "de": "Im Notfall sollten Sie sofort die Polizei <w>anrufen</w>.",
                                "zh": "遇到紧急情况，你应该立即<w>拨打</w>报警电话。"
                            }
                        },
                        {
                            "text": "She picked up the receiver to <w>dial</w> her friend's number.",
                            "target_lang_translations": {
                                "ru": "Она сняла трубку, чтобы <w>набрать</w> номер подруги.",
                                "de": "Sie nahm den Hörer ab, um die Nummer ihrer Freundin zu <w>wählen</w>.",
                                "zh": "她拿起听筒，准备<w>拨</w>朋友的号码。"
                            }
                        }
                    ],
                    "synonyms": [
                        "call",
                        "phone",
                        "ring"
                    ],
                    "common_phrases": [
                        "dial a number",
                        "dial direct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить номер телефона для совершения звонка, нажимая кнопки или вращая диск.",
                        "de": "Eine Telefonnummer eingeben, um einen Anruf zu tätigen.",
                        "zh": "通过按键或旋转拨号盘输入电话号码以进行通话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набира́ть",
                                "target_lang_sense_clarification": "номер телефона"
                            },
                            {
                                "target_lang_word": "звони́ть",
                                "target_lang_sense_clarification": "по телефону"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wählen",
                                "target_lang_sense_clarification": "eine Telefonnummer eingeben"
                            },
                            {
                                "target_lang_word": "anrufen",
                                "target_lang_sense_clarification": "jemanden telefonisch kontaktieren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拨打",
                                "target_lang_sense_clarification": "拨号或打电话"
                            },
                            {
                                "target_lang_word": "拨",
                                "target_lang_sense_clarification": "拨号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5ffd7b1-3d40-381d-9093-88c6484da6b0",
                    "sense_definition": "To adjust, control, or select a setting or level, often used figuratively to mean increasing or decreasing intensity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate had to <w>dial</w> down his aggressive language during the debate.",
                            "target_lang_translations": {
                                "ru": "Кандидату пришлось <w>сбавить</w> агрессивный тон во время дебатов.",
                                "de": "Der Kandidat musste seine aggressive Ausdrucksweise während der Debatte <w>herunterschrauben</w>.",
                                "zh": "候选人在辩论中不得不<w>调节</w>一下他那咄咄逼人的语气。"
                            }
                        },
                        {
                            "text": "He <w>dialed</w> the volume up to hear the news report more clearly.",
                            "target_lang_translations": {
                                "ru": "Он <w>прибавил</w> громкость, чтобы лучше слышать новости.",
                                "de": "Er <w>drehte</w> die Lautstärke höher, um den Nachrichtenbericht besser hören zu können.",
                                "zh": "他把音量<w>调</w>大，以便更清楚地听新闻报道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adjust",
                        "regulate",
                        "tune"
                    ],
                    "common_phrases": [
                        "dial down",
                        "dial up",
                        "dial in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулировать, управлять или выбирать настройку; часто используется в переносном смысле для обозначения изменения интенсивности.",
                        "de": "Eine Einstellung oder Intensität anpassen oder regulieren.",
                        "zh": "调整、控制或选择设置或级别，常用于比喻增加或减少强度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регули́ровать",
                                "target_lang_sense_clarification": "настройки"
                            },
                            {
                                "target_lang_word": "изменя́ть",
                                "target_lang_sense_clarification": "уровень"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "regulieren",
                                "target_lang_sense_clarification": "Einstellungen anpassen"
                            },
                            {
                                "target_lang_word": "einstellen",
                                "target_lang_sense_clarification": "einen Wert festlegen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调节",
                                "target_lang_sense_clarification": "调整设置"
                            },
                            {
                                "target_lang_word": "调整",
                                "target_lang_sense_clarification": "改变水平或强度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b527ebb3-4965-3a55-a912-0419b04cbf05",
                    "sense_definition": "A device with a circular face and a needle or numbers that shows a measurement, such as speed, pressure, or time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dial</w> on the dashboard indicated that the car was running out of fuel.",
                            "target_lang_translations": {
                                "ru": "<w>Шкала</w> на приборной панели показывала, что топливо заканчивается.",
                                "de": "Die <w>Anzeige</w> auf dem Armaturenbrett zeigte an, dass das Auto keinen Kraftstoff mehr hatte.",
                                "zh": "仪表盘上的<w>刻度盘</w>显示车快没油了。"
                            }
                        },
                        {
                            "text": "Check the pressure <w>dial</w> to ensure the machine is safe to operate.",
                            "target_lang_translations": {
                                "ru": "Проверьте <w>датчик</w> давления, чтобы убедиться в безопасности работы машины.",
                                "de": "Überprüfen Sie die <w>Druckanzeige</w>, um sicherzustellen, dass die Maschine sicher zu bedienen ist.",
                                "zh": "检查压力<w>刻度盘</w>，确保机器运行安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gauge",
                        "meter",
                        "indicator",
                        "face"
                    ],
                    "common_phrases": [
                        "pressure dial",
                        "speed dial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прибор или часть прибора с круглой шкалой и стрелкой, показывающий измерения (скорость, давление и т.д.).",
                        "de": "Ein Messinstrument mit einer Skala und einem Zeiger zur Anzeige von Werten wie Geschwindigkeit oder Druck.",
                        "zh": "一种带有圆形面板和指针或数字的装置，用于显示测量结果，如速度、压力或时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цифербла́т",
                                "target_lang_sense_clarification": "прибора"
                            },
                            {
                                "target_lang_word": "шкала́",
                                "target_lang_sense_clarification": "измерительная"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Anzeige",
                                "target_lang_sense_clarification": "Messinstrument"
                            },
                            {
                                "target_lang_word": "Skala",
                                "target_lang_sense_clarification": "Messbereich"
                            },
                            {
                                "target_lang_word": "Zifferblatt",
                                "target_lang_sense_clarification": "bei Uhren oder Messgeräten"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刻度盘",
                                "target_lang_sense_clarification": "显示测量值的盘面"
                            },
                            {
                                "target_lang_word": "仪表盘",
                                "target_lang_sense_clarification": "显示数据的面板"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "608325eb-72ed-3993-8841-9f906f762b1f",
                    "sense_definition": "A rotatable knob or button on a machine used to change settings like volume, frequency, or temperature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She turned the <w>dial</w> to find a radio station with better reception.",
                            "target_lang_translations": {
                                "ru": "Она повернула <w>ручку</w> настройки, чтобы найти радиостанцию с лучшим приемом.",
                                "de": "Sie drehte am <w>Drehknopf</w>, um einen Radiosender mit besserem Empfang zu finden.",
                                "zh": "她转动<w>旋钮</w>，寻找信号更好的电台。"
                            }
                        },
                        {
                            "text": "Use the temperature <w>dial</w> to set the oven to the correct heat.",
                            "target_lang_translations": {
                                "ru": "Используйте <w>регулятор</w> температуры, чтобы установить духовку на нужный режим.",
                                "de": "Verwenden Sie den <w>Temperaturregler</w>, um den Ofen auf die richtige Hitze einzustellen.",
                                "zh": "使用温度<w>旋钮</w>将烤箱设置到合适的温度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "knob",
                        "control",
                        "regulator"
                    ],
                    "common_phrases": [
                        "turn the dial",
                        "volume dial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращающаяся ручка или кнопка на устройстве для изменения настроек (громкости, температуры).",
                        "de": "Ein drehbarer Knopf oder Regler an einem Gerät zur Änderung von Einstellungen.",
                        "zh": "机器上用于改变音量、频率或温度等设置的旋转旋钮或按钮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регуля́тор",
                                "target_lang_sense_clarification": "ручка управления"
                            },
                            {
                                "target_lang_word": "ру́чка",
                                "target_lang_sense_clarification": "настройки"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Drehknopf",
                                "target_lang_sense_clarification": "manuelles Bedienelement"
                            },
                            {
                                "target_lang_word": "Regler",
                                "target_lang_sense_clarification": "zur Einstellung von Werten"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旋钮",
                                "target_lang_sense_clarification": "旋转式调节器"
                            },
                            {
                                "target_lang_word": "调节器",
                                "target_lang_sense_clarification": "控制装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47f1d030-fe2c-3943-8b2a-613fa8daf8e5",
                    "sense_definition": "A rotating disk with finger holes on older telephones used to input a phone number.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "telephony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique telephone had a heavy rotary <w>dial</w> that made a clicking sound.",
                            "target_lang_translations": {
                                "ru": "У старинного телефона был тяжелый вращающийся <w>диск</w>, издававший щелкающий звук.",
                                "de": "Das antike Telefon hatte eine schwere <w>Wählscheibe</w>, die ein klickendes Geräusch machte.",
                                "zh": "那部古董电话有一个沉重的、会发出咔哒声的<w>拨号盘</w>。"
                            }
                        },
                        {
                            "text": "It takes much longer to use a <w>dial</w> than to press buttons on a keypad.",
                            "target_lang_translations": {
                                "ru": "Пользоваться <w>диском</w> гораздо дольше, чем нажимать кнопки на клавиатуре.",
                                "de": "Es dauert viel länger, eine <w>Wählscheibe</w> zu benutzen, als Tasten auf einem Tastenfeld zu drücken.",
                                "zh": "使用<w>拨号盘</w>比按键盘上的按钮要慢得多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rotary dial"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to the mechanical component of older phones"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращающийся диск с отверстиями для пальцев на старых телефонах для набора номера.",
                        "de": "Eine drehbare Scheibe mit Löchern an alten Telefonen zur Nummerneingabe.",
                        "zh": "旧式电话上带有指孔的旋转圆盘，用于输入电话号码。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диск",
                                "target_lang_sense_clarification": "телефонный"
                            },
                            {
                                "target_lang_word": "набо́рный диск",
                                "target_lang_sense_clarification": "телефона"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Wählscheibe",
                                "target_lang_sense_clarification": "bei alten Telefonen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拨号盘",
                                "target_lang_sense_clarification": "旧式电话的旋转盘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d9365e1-e980-3199-b589-67c3176baba0",
                    "sense_definition": "A person's face.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a huge smile on his <w>dial</w> when he heard the good news.",
                            "target_lang_translations": {
                                "ru": "Когда он услышал хорошие новости, на его <w>физиономии</w> засияла широкая улыбка.",
                                "de": "Er hatte ein breites Grinsen auf seiner <w>Visage</w>, als er die guten Nachrichten hörte.",
                                "zh": "听到好消息时，他的<w>脸</w>上露出了灿烂的笑容。"
                            }
                        },
                        {
                            "text": "Wipe that grumpy look off your <w>dial</w> and come join the party.",
                            "target_lang_translations": {
                                "ru": "Сотри это недовольное выражение со своей <w>физиономии</w> и присоединяйся к вечеринке.",
                                "de": "Wisch diesen mürrischen Ausdruck von deiner <w>Visage</w> und komm zur Party.",
                                "zh": "把你那副臭<w>脸</w>收起来，过来参加派对吧。"
                            }
                        }
