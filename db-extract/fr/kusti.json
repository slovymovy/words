                "senses": [
                    {
                        "sense_id": "acaa13fb-ecc2-318c-acb0-da19451e8c2b",
                        "entry_id": "607c0d57-150f-35ce-90fd-aba2016ffd2b",
                        "glosses": [
                            "Fine cordelette portée autour de la taille par les Parsis, adeptes du zoroastrisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d0a7410-cf1e-468b-9c4d-761733282e8c",
                                "sense_id": "acaa13fb-ecc2-318c-acb0-da19451e8c2b",
                                "text": "Le kusti est une corde ou ceinture de laine composée de soixante-douze fils …. Le kusti est passé trois fois autour de la taille, et on y fait quatre nœuds en chantant un hymne."
                            },
                            {
                                "example_id": "58d3a553-69a8-491c-aa23-4d8e2f39454c",
                                "sense_id": "acaa13fb-ecc2-318c-acb0-da19451e8c2b",
                                "text": "… le Parsi, tenant de la main gauche le bout du kusti, le secoue vers la droite, une fois, deux fois, trois fois, pour symboliser l’expulsion des démons."
                            },
                            {
                                "example_id": "12b5c8f7-41d5-41d1-9659-f5c14ee81e1e",
                                "sense_id": "acaa13fb-ecc2-318c-acb0-da19451e8c2b",
                                "text": "Le kusti protège les Parsis en les empêchant de s’engager dans la mauvaise voie. Cela me rappelle que quels que soient les obstacles, je dois dire la vérité et faire ce qui est bon."
                            }
                        ]
                    }
                ],
