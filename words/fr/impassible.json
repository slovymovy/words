    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46961324-ccc3-38ae-bd20-ea6376caccf9",
                    "sense_definition": "Qui ne laisse paraître aucune émotion, aucun trouble ou sentiment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les provocations répétées de son adversaire, l'avocat est resté totalement <w>impassible</w> pendant l'audience."
                        },
                        {
                            "text": "Le détective observait la scène avec un visage <w>impassible</w>, sans trahir la moindre émotion."
                        }
                    ],
                    "synonyms": [
                        "imperturbable",
                        "stoïque",
                        "froid"
                    ],
                    "antonyms": [
                        "émotif",
                        "expressif"
                    ],
                    "common_phrases": [
                        "rester impassible",
                        "visage impassible",
                        "air impassible"
                    ]
                },
                {
                    "sense_id": "6e5852db-bf78-3168-9293-a759f2aa63b4",
                    "sense_definition": "Qui est incapable d'éprouver de la souffrance physique ou morale.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "état",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon la théologie classique, la nature divine est absolument <w>impassible</w> face aux souffrances terrestres."
                        },
                        {
                            "text": "Ces sages cherchaient à rendre leur esprit entièrement <w>impassible</w> face aux misères de l'existence."
                        }
                    ],
                    "synonyms": [
                        "insensible",
                        "invulnérable"
                    ],
                    "antonyms": [
                        "vulnérable",
                        "sensible"
                    ]
                }
            ]
        }
    ]
