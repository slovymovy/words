                                                "sense_id": "c502d82d-4f7d-3a56-94dc-cfdc4765ce52",
                                                "text": "It's only a theory, admittedly, but it might work."
                                            },
                                            {
                                                "example_id": "866caba6-fa0e-4d25-8121-d177e8f14277",
                                                "sense_id": "c502d82d-4f7d-3a56-94dc-cfdc4765ce52",
                                                "text": "Admittedly he can't swim, but he still loves going to the seaside anyway."
                                            }
                                        ]
