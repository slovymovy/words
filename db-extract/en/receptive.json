                                "target_senses": [
                                    {
                                        "sense_id": "b1d88804-5039-3a67-9df0-3074a0c573df",
                                        "entry_id": "1f03a65c-5416-3480-8d20-f777bce8ef73",
                                        "glosses": [
                                            "Qui reçoit, qui peut recevoir des impressions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc0c2f73-0d85-481c-8b05-6184450997f3",
                                                "sense_id": "b1d88804-5039-3a67-9df0-3074a0c573df",
                                                "text": "Une plaque réceptive."
                                            },
                                            {
                                                "example_id": "598f42d5-2aed-4045-9867-a406e4b4e64c",
                                                "sense_id": "b1d88804-5039-3a67-9df0-3074a0c573df",
                                                "text": "Un esprit réceptif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ddba777-587f-33f2-8631-99143cf80f27",
                                        "entry_id": "1f03a65c-5416-3480-8d20-f777bce8ef73",
                                        "glosses": [
                                            "Qui est sensible à un agent externe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a139c6e-1d0f-4ba8-a63b-f51481d124ea",
                                                "sense_id": "4ddba777-587f-33f2-8631-99143cf80f27",
                                                "text": "L’efficacité parasitaire des adultes peut se trouver limitée par la rupture de la coïncidence spatio-temporelle entre le stade réceptif des hôtes (œufs en cours d’embryogenèse) et le stade agressif du parasitoïde (Nenon, 1974)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c0f6ba7-88d3-3a7b-851e-d3a3b0df03b0",
                                        "entry_id": "1f03a65c-5416-3480-8d20-f777bce8ef73",
                                        "glosses": [
                                            "Qui reçoit le pénis ; passif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f900cadd-8a19-443a-8ae0-d79c0f020f33",
                                                "sense_id": "3c0f6ba7-88d3-3a7b-851e-d3a3b0df03b0",
                                                "text": "Ces catégories socio-sexuelles sont à leur tour « cadrées » par des rôles sexuels (insertif ou réceptif) respectifs."
                                            },
                                            {
                                                "example_id": "b180dd7c-1245-4528-9e19-e3c617f2cfd6",
                                                "sense_id": "3c0f6ba7-88d3-3a7b-851e-d3a3b0df03b0",
                                                "text": "Ce sont ceux qui ont les moyens financiers, donc le pouvoir, qui vont jouer dans les relations sexuelles qu’ils pourraient avoir le rôle insertif ou encore connu sous le nom de rôle actif. Ceux qui sont délaissés joueront le rôle réceptif connu également sous le nom de rôle passif, en se laissant pénétrer par la voie anale ou […] par la voie buccale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81b7aa90-a5a0-4fa0-b565-6b50055c0a53",
                        "source_entry_id": "b3e57e4d-91ad-3598-b99d-a4a2ef8a4128",
                        "source_sense_description": "ready to receive something, especially new concepts or ideas",
                        "target_lang_word": "aufnahmefähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufnahmefähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c9a0331-0522-3904-86d2-7f5c69699801",
                                        "entry_id": "5260adbe-28c0-38ab-9732-1f8c54a0df6b",
                                        "glosses": [
                                            "in der Lage, materielle oder geldwerte Inhalte zu integrieren (…, seiend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25e0dea1-99b5-4b59-959d-981f87d12247",
                                                "sense_id": "9c9a0331-0522-3904-86d2-7f5c69699801",
                                                "text": "„In Fällen, in denen der Boden zT nachts und am Morgen oberflächlich gefroren ist, die dünne oberflächliche Gefrierschicht tagsüber bei Sonneneinstrahlung jedoch wieder auftaut und der Boden daher aufnahmefähig ist, kann nicht von einem durchgefrorenen Boden gesprochen werden.“"
                                            },
                                            {
                                                "example_id": "876916a9-3f64-490f-b0ca-d7f0aeedb4a0",
                                                "sense_id": "9c9a0331-0522-3904-86d2-7f5c69699801",
                                                "text": "„Nach dem Zweiten Weltkrieg suchte man sich die US-amerikanischen Großserienhersteller als Zielgruppe, da der eigene Markt für kostspielige Studien nicht aufnahmefähig genug war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "991e5d6c-3266-3040-95b7-e592f954c441",
                                        "entry_id": "5260adbe-28c0-38ab-9732-1f8c54a0df6b",
                                        "glosses": [
                                            "in der Lage, geistige Inhalte zu integrieren (…, seiend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0eb7ae6-fd92-4c75-95b8-39e77b526a05",
                                                "sense_id": "991e5d6c-3266-3040-95b7-e592f954c441",
                                                "text": "„Der Körper ist in einem trancegleichen Zustand, das Bewusstsein jedoch voll aufnahmefähig für die glückselige Erfahrung im Inneren.“"
                                            },
                                            {
                                                "example_id": "3f029aac-898f-4c70-9756-22ca57ab503c",
                                                "sense_id": "991e5d6c-3266-3040-95b7-e592f954c441",
                                                "text": "„Verschiedene interessante Motive kommen ihm in den Sinn, alles, wofür er während seines mühevollen Tagwerkes nicht aufnahmefähig war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
