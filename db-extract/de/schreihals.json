                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5072b175-41dc-48a0-be83-d55768eba34d",
                                "sense_id": "c0bc141f-c97b-37e3-9b6a-3ab59d15972e",
                                "text": "Der kleine Max ist ein richtiger Schreihals."
                            },
                            {
                                "example_id": "2a64017c-6e47-4da7-b67b-bd0610bc8a8a",
                                "sense_id": "c0bc141f-c97b-37e3-9b6a-3ab59d15972e",
                                "text": "„Das ! lässt uns aufschreien – so sehr, dass man es als Schreihals, als Lärmstange, Macho oder Brüller bezeichnet hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
