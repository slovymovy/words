                "senses": [
                    {
                        "sense_id": "b567f2eb-d410-3510-9531-be1f38af1201",
                        "entry_id": "edcca341-c11a-3641-944a-c46945462547",
                        "glosses": [
                            "ein aus Aufwärmübungen bestehendes Training, das darauf abzielt, den Körper schrittweise auf intensivere sportliche Aktivitäten vorzubereiten, indem es Muskulatur, Gelenke und Kreislaufsystem aktiviert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b966ec-4219-4393-89e9-ad705c834c91",
                                "sense_id": "b567f2eb-d410-3510-9531-be1f38af1201",
                                "text": "„Nachdem das Aufwärmtraining beendet war, verabschiedete sich Tim Rieder mit Fitnesscoach Jörg Mikoleit auf einen Nebenplatz – zum Individualtraining.“"
                            },
                            {
                                "example_id": "c7ee7aa3-ff99-42de-bdb0-e970a7596c7a",
                                "sense_id": "b567f2eb-d410-3510-9531-be1f38af1201",
                                "text": "„Diese Übung eignet sich sehr gut für das Aufwärmtraining in der Halle.“"
                            },
                            {
                                "example_id": "030bda03-18b0-41c9-acbd-9e0871a0d976",
                                "sense_id": "b567f2eb-d410-3510-9531-be1f38af1201",
                                "text": "„Allein oder in der Gruppe, als Aufwärmtraining oder Workout, Seilspringen ist nicht ohne Grund zum Fitnesstrend geworden.“"
                            },
                            {
                                "example_id": "609858ae-b781-4ca5-8a9c-8cb94b15b7c0",
                                "sense_id": "b567f2eb-d410-3510-9531-be1f38af1201",
                                "text": "„Das richtige Aufwärmtraining ist das A und O“"
                            },
                            {
                                "example_id": "ada1d26e-d73b-4a5b-a91f-212d5d5263c2",
                                "sense_id": "b567f2eb-d410-3510-9531-be1f38af1201",
                                "text": "„Ohne ein richtiges Aufwärmtraining zu Beginn können deine Gelenke erheblich beeinträchtigt werden, da sich der Knorpel unbemerkt allmählich abnutzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "198027c2-9354-3593-a3c3-c7df6af99d0f",
                        "entry_id": "edcca341-c11a-3641-944a-c46945462547",
                        "glosses": [
                            "letzte Testfahrt vor einem Rennen, bei der das Fahrzeug überprüft wird, um sicherzustellen, dass es optimal auf die Rennbedingungen vorbereitet ist"
                        ],
                        "tags": [
                            "Motorsport"
                        ],
                        "examples": [
                            {
                                "example_id": "29b9f82c-c9b4-464c-b70f-e7549ca223df",
                                "sense_id": "198027c2-9354-3593-a3c3-c7df6af99d0f",
                                "text": "„Das Auto war rechtzeitig zum Aufwärmtraining am Morgen einsatzbereit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "eb50bccf-3072-3a10-bb4a-a6265f49a9d5",
                        "entry_id": "edcca341-c11a-3641-944a-c46945462547",
                        "glosses": [
