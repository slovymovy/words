                "senses": [
                    {
                        "sense_id": "c3fea86b-af03-3197-b4d2-fb7d2ebf128e",
                        "entry_id": "905a1538-302d-3c63-8a65-5756b7add551",
                        "glosses": [
                            "zur Panzerbehinderung aufgestelltes Hindernis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a1ca7e8-ecee-44a9-928d-7c38897c4771",
                                "sense_id": "c3fea86b-af03-3197-b4d2-fb7d2ebf128e",
                                "text": "„Nachts werden die Panzersperren weggeräumt, die man am Tag gebaut hat.“"
                            },
                            {
                                "example_id": "62f9a3af-0b65-40d4-bf4e-7ca155b96e91",
                                "sense_id": "c3fea86b-af03-3197-b4d2-fb7d2ebf128e",
                                "text": "„Am 28. April 1945 wurden dort fünf Männer aus Peilstein erschossen, die eine Panzersperre entfernt hatten, um ihren Ort kampflos den Amerikanern zu übergeben, die sich nur noch wenig entfernt befanden.“"
                            },
                            {
                                "example_id": "499f844f-a9a7-42d4-9743-2dcdc289b45e",
                                "sense_id": "c3fea86b-af03-3197-b4d2-fb7d2ebf128e",
                                "text": "„Ganz zufällig fällt sein Blick auf eine Abteilung Soldaten, die mit dem Bau einer Panzersperre beschäftigt ist.“"
                            },
                            {
                                "example_id": "065ebdac-7fa7-4531-b80f-3d1167500349",
                                "sense_id": "c3fea86b-af03-3197-b4d2-fb7d2ebf128e",
                                "text": "„An Straßen und Eisenbahnbrücken wurden Panzersperren errichtet und Sprengladungen angebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
