                    {
                        "sense_id": "ba6d5553-2075-3dac-8b71-0591263120c9",
                        "entry_id": "de2d82af-d710-33a6-a5d5-ce8bfca91fe2",
                        "glosses": [
                            "Qui est caractérisé par des ondulations."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "085219a7-d327-436f-816c-64f0e7e76e52",
                                "sense_id": "ba6d5553-2075-3dac-8b71-0591263120c9",
                                "text": "Je cherchai donc à me représenter la dualité onde-corpuscule par une image spatiale où le corpuscule serait le centre d’un phénomène ondulatoire étendu."
                            },
                            {
                                "example_id": "dc7ef269-da32-41ac-b4e8-71c43e6b3575",
                                "sense_id": "ba6d5553-2075-3dac-8b71-0591263120c9",
                                "text": "La balle sort du canon à deux cents kilomètres-heure et, fait particulier, elle adopte dans la partie prolongée du canon un mouvement ondulatoire qui provoque des dégâts considérables en ne laissant presque aucune trace apparente."
                            }
                        ]
                    }
                ],
