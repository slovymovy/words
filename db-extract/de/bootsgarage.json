                "senses": [
                    {
                        "sense_id": "6eb6146e-4805-32f5-8bf4-eb829a93e85a",
                        "entry_id": "aea307ac-7c8a-3738-9d7d-601786fe1ce6",
                        "glosses": [
                            "Garage, die als Stellplatz für ein oder mehrere Boote im Wasser genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da5c9f65-ffc9-4baf-98a5-456c54803297",
                                "sense_id": "6eb6146e-4805-32f5-8bf4-eb829a93e85a",
                                "text": "Das Parken des Bootes in der Bootsgarage ist nur in der eisfreien Zeit möglich."
                            },
                            {
                                "example_id": "3fdcf676-baa9-454d-8773-b58994ec4f47",
                                "sense_id": "6eb6146e-4805-32f5-8bf4-eb829a93e85a",
                                "text": "„Jetzt ist also auch noch eine riesige weiße Plane über die nicht genehmigte „Bootsgarage“ an einem Privatsteg im Rüdesheimer Hafen gespannt und nimmt nicht nur benachbarten Bootsbesitzern Sonne und Ausblick.“"
                            },
                            {
                                "example_id": "5e2faa21-1ef4-44a1-b764-e70160132aae",
                                "sense_id": "6eb6146e-4805-32f5-8bf4-eb829a93e85a",
                                "text": "„Die Bootsgarage dient zum Schutz eines beliebigen Wasserfahrzeuges gegen äußere Einflüsse.“"
                            },
                            {
                                "example_id": "3e333e40-c473-40c0-8ed6-3a9f446407a6",
                                "sense_id": "6eb6146e-4805-32f5-8bf4-eb829a93e85a",
                                "text": "„Im Anschluss der Sanierung wurde die Bootsgarage mittels Autokran wieder zu Wasser gelassen“"
                            },
                            {
                                "example_id": "379d038d-c911-4dc9-8bd2-2f9d6468b464",
                                "sense_id": "6eb6146e-4805-32f5-8bf4-eb829a93e85a",
                                "text": "„Die Bootsgarage wird am oberen Ende des Rheinhafens Birsfelden verankert, auf der Höhe des Rheinkilometers 161,3, unmittelbar unterhalb der Anlegestelle des Personenschiffsteigers Waldhaus und oberhalb des Containerterminals Birsfelden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
