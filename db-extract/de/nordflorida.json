                        "examples": [
                            {
                                "example_id": "25b4c0b6-23ab-4472-a655-2900079a52fe",
                                "sense_id": "fde610c1-c451-39c3-9c94-3450c9f4e073",
                                "text": "„Shaw sah sie nun vor sich, wie sie höchstwahrscheinlich – wie so oft – auf ihrer Veranda saßen und hinaus auf den vierzig Hektar großen See in Nordflorida schauten.“"
                            },
                            {
                                "example_id": "d9db4390-9424-466b-97a7-431ae3155b75",
                                "sense_id": "fde610c1-c451-39c3-9c94-3450c9f4e073",
                                "text": "„Court hatte sich eine Jeansjacke übergestreift und eine der typischen grünen Caterpillar-Kappen aufgesetzt; abgesehen von seinen Virginia-Nummernschildern wirkte er wie jeder andere Farmer oder Fabrikarbeiter hier in den Ortschaften Carolinas oder auch Nordfloridas, wo er letztlich hinwollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
