                ],
                "senses": [
                    {
                        "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                        "entry_id": "edae30ce-e41a-3b04-8ab7-6e0734b7c783",
                        "glosses": [
                            "die Worte, die der Priester in der Eucharistiefeier zur Vergegenwärtigung des Opfers Jesu Christi beim Letzten Abendmahl zur Wandlung (Transsubstantiation) spricht"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "5d661a5a-da65-4476-88bd-a3aa0434cba1",
                                "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                                "text": "Der Priester spricht die Wandlungsworte ›in persona Christi‹."
                            },
                            {
                                "example_id": "3903abe0-bf24-4c30-94bf-f29854476490",
                                "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                                "text": "Die Wandlungsworte beginnen mit »Nehmet und esset« bzw. »Nehmet und trinket«."
                            },
                            {
                                "example_id": "444eaccc-f462-4819-8ef3-f0669f3bc8ee",
                                "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                                "text": "„Die Transsubstantiationslehre beschreibt die dauerhafte Wandlung von Brot und Wein in der priesterlichen Vergegenwärtigung des einen Opfers Christi während der Wandlungsworte.“"
                            },
                            {
                                "example_id": "ec9f88ae-0cdf-4e82-a2c0-51296af57446",
                                "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                                "text": "„Diese Auffassung wird heute allgemein kritisiert, und die verbreitete Auffassung der orthodoxen Theologie geht dahin, dass Wandlungsworte und Anrufung des Heiligen Geistes beide zum Vollzug der Eucharistie nötig sind, und zudem die Wandlung im Kontext der gesamten Liturgie zu sehen ist und nicht vom Menschen willkürlich auf einen bestimmten Zeitpunkt fixiert werden kann.“"
                            },
                            {
                                "example_id": "af2a3f47-e750-48f9-a449-d6f09a903b91",
                                "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                                "text": "„Allerdings wurde 2001 von der römisch-katholischen Kirche die Gültigkeit der „Anaphora der Apostel Addai und Mari“, die bei den nicht-unierten Assyrern keine expliziten Wandlungsworte enthält, anerkannt.“"
                            },
                            {
                                "example_id": "89346092-2da7-4f2e-aaea-a2a51f6efe29",
                                "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                                "text": "„Paul VI. redigierte überdies die Wandlungsworte, die einheitlich für jede gültige Messfeier vorgeschrieben sind.“"
                            },
                            {
                                "example_id": "652938a1-417e-491b-930a-198da7f9e3aa",
                                "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                                "text": "„Papst Benedikt XVI. hat die Deutsche Bischofskonferenz angewiesen, die deutsche Übersetzung der Messworte in einem theologisch zentralen Punkt zu ändern. So soll es in den Wandlungsworten der Eucharistie nicht mehr heißen, dass Jesus ›für alle‹ Menschen gestorben ist, sondern ›für viele‹.“"
                            },
                            {
                                "example_id": "9dd86181-f257-41f1-97c6-972538903f0c",
                                "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                                "text": "„Papst Benedikt XVI. entschied sich für die deutsche Muttersprache, damit seine Botschaft zur Wiederherstellung der Wandlungsworte alle Bischöfe, nicht nur die im deutschen Sprachraum erreicht. […] Im Mittelpunkt der Frage stehen die Wandlungsworte im Hochgebet, mit denen der Wein zum Blut Christi wird.“"
                            },
                            {
                                "example_id": "c16354fa-40e4-4360-9be0-f383736aeb72",
                                "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                                "text": "„Der Römische Kanon hat in den Wandlungsworten die beiden biblischen Lesarten miteinander verbunden und sagt demgemäß: „Für euch und für viele“.“"
                            },
                            {
                                "example_id": "94193d27-297e-41d3-a237-b5073930f695",
                                "sense_id": "8c39c6bd-a535-34ce-840d-50b5aa022160",
                                "text": "„Im Rahmen dieser Thematik kommt natürlich auch die Problematik der Gültigkeit der verfälschten Wandlungsworte zur Sprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
