                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21e5e8db-a3d4-4132-a485-8c109e6ef4e7",
                                "sense_id": "07a28568-294b-3f6c-b77a-0f43d2455d9e",
                                "text": "Les tumeurs trophoblastiques sont rares et comprennent la môle hydatiforme, la môle invasive et le choriocarcinome placentaire."
                            },
                            {
                                "example_id": "d6d88996-0dda-46f4-8666-50b2b1e138d5",
                                "sense_id": "07a28568-294b-3f6c-b77a-0f43d2455d9e",
                                "text": "Le choriocarcinome est une tumeur épithéliale agressive avec présence de cytotrophoblaste avec syncitiotrophoblaste sans chorion villositaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "c06a2660-1531-3eb9-b768-b99dc54603e0",
                        "entry_id": "2e91b820-2e0b-3018-9561-873311ac491c",
                        "glosses": [
                            "Nom de certains cancers des testicules chez l’homme."
