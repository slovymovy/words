                                                "sense_id": "03319190-b4c6-3fbe-a5bc-568889afb393",
                                                "text": "We got all our food for free, it was included in the contract."
                                            },
                                            {
                                                "example_id": "b9aa2220-3ce2-4392-99cd-133e9e1e2fd2",
                                                "sense_id": "03319190-b4c6-3fbe-a5bc-568889afb393",
                                                "text": "Now John at the bar is a friend of mine\nHe gets me my drinks for free"
                                            }
                                        ]
                                    },
