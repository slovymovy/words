    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "57e78067-506b-3079-a72f-7fe5c60b56d9",
                    "sense_definition": "In strijd met het gezonde verstand; absurd of onzinnig.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "absurd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is volkomen <w>ongerijmd</w> om te denken dat we dit project zonder budget kunnen voltooien.",
                            "target_lang_translations": {
                                "en": "It is completely <w>absurd</w> to think that we can complete this project without a budget."
                            }
                        },
                        {
                            "text": "Zijn bewering was zo <w>ongerijmd</w> dat niemand in de zaal hem serieus nam.",
                            "target_lang_translations": {
                                "en": "His claim was so <w>preposterous</w> that no one in the room took him seriously."
                            }
                        }
                    ],
                    "synonyms": [
                        "absurd",
                        "onzinnig",
                        "onlogisch",
                        "irrationeel"
                    ],
                    "antonyms": [
                        "zinnig",
                        "gerijmd"
                    ],
                    "common_phrases": [
                        "volkomen ongerijmd",
                        "een ongerijmd idee"
                    ],
                    "target_lang_definitions": {
                        "en": "Contrary to common sense; absurd, nonsensical, or irrational."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "absurd",
                                "target_lang_sense_clarification": "contrary to reason or common sense"
                            },
                            {
                                "target_lang_word": "preposterous",
                                "target_lang_sense_clarification": "utterly absurd or ridiculous"
                            },
                            {
                                "target_lang_word": "incongruous",
                                "target_lang_sense_clarification": "not in harmony or keeping with surroundings or logic"
                            },
                            {
                                "target_lang_word": "nonsensical",
                                "target_lang_sense_clarification": "having no meaning; making no sense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54fba498-539a-3c2d-93b0-6a425c216946",
                    "sense_definition": "Zonder rijm; niet rijmend.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rijmloos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dichter koos bewust voor een <w>ongerijmd</w> vers om een modernere sfeer te creëren.",
                            "target_lang_translations": {
                                "en": "The poet deliberately chose an <w>unrhymed</w> verse to create a more modern atmosphere."
                            }
                        },
                        {
                            "text": "Dit is een <w>ongerijmd</w> gedicht waarin het ritme belangrijker is dan de klankovereenkomst.",
                            "target_lang_translations": {
                                "en": "This is a <w>rhymeless</w> poem in which the rhythm is more important than the sound correspondence."
                            }
                        }
                    ],
                    "synonyms": [
                        "rijmloos"
                    ],
                    "antonyms": [
                        "gerijmd"
                    ],
                    "common_phrases": [
