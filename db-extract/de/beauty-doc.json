                "senses": [
                    {
                        "sense_id": "a8d46ae5-1777-3764-a8ee-e9727b19f638",
                        "entry_id": "462f9ee8-0ba9-3f17-addc-15ce30bcddc0",
                        "glosses": [
                            "Arzt (Doc), der Behandlungen und Operationen (ästhetische Chirurgie) durchführt, die der Schönheit (Beauty) dienen und nicht medizinisch indiziert/zu begründen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85f6ec88-0620-497c-ae58-7387171fa84e",
                                "sense_id": "a8d46ae5-1777-3764-a8ee-e9727b19f638",
                                "text": "„Als ‚Beauty-Doc‘ habe ich seit dem Beginn meiner Ausbildung 1997 viele Trends kommen und gehen sehen.“"
                            },
                            {
                                "example_id": "c0cac753-66b0-48bf-8511-561a63f52225",
                                "sense_id": "a8d46ae5-1777-3764-a8ee-e9727b19f638",
                                "text": "„Die Brutal-Erotikerin zeigt gerne, was sie hat, und trennte sich coram publico von jenem Mann, der ihr die Schönheit gab: Beauty-Doc Artur Worseg.“"
                            },
                            {
                                "example_id": "ff452708-e6db-4661-9ba8-8b5f078c9973",
                                "sense_id": "a8d46ae5-1777-3764-a8ee-e9727b19f638",
                                "text": "„Ich hatte meinen ersten und, wie sich herausstellen sollte, nicht meinen letzten Termin beim Beauty-Doc Rosas Vertrauens, Dr. Filler.“"
                            },
                            {
                                "example_id": "a05f67b5-e5c3-4ccd-88d9-da6d050e7e11",
                                "sense_id": "a8d46ae5-1777-3764-a8ee-e9727b19f638",
                                "text": "„Mit seinen mittellangen, gewellten Haaren und der braun gebrannten Haut wirkte er wie einer dieser neureichen Beauty-Docs.“"
                            },
                            {
                                "example_id": "abd6601f-3290-4727-83eb-60e274c7c078",
                                "sense_id": "a8d46ae5-1777-3764-a8ee-e9727b19f638",
                                "text": "„Mausi Lugner ganz im Trend, als sie NEWS in die Ordination des Beauty-Docs mitnimmt: Ich hab mir Augenbrauen, Lid und Lippe tätowieren und die Stirnfalte mit Botox wegspritzen lassen. Leider hat es nicht genützt, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
