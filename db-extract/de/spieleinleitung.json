                "senses": [
                    {
                        "sense_id": "3bbda80c-0917-3bfb-820f-99a324258b3d",
                        "entry_id": "38d0ec33-88f6-3890-b498-4d6cae719691",
                        "glosses": [
                            "Handlung zum Beginn eines Spiels, etwa beim Kartenspiel oder beim Sportspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b824b64a-7ffa-4dba-982a-e7bf56c09846",
                                "sense_id": "3bbda80c-0917-3bfb-820f-99a324258b3d",
                                "text": "„Er ist überragend mit Toni Kroos in der Spieleinleitung und Ballsicherheit, spielt gute Pässe zwischen den Räumen, lobte Löw.“"
                            },
                            {
                                "example_id": "b0b1020a-a0be-4295-aa94-8759f4d5a556",
                                "sense_id": "3bbda80c-0917-3bfb-820f-99a324258b3d",
                                "text": "„Der Torwart ist der erste Angreifer. Diese Aussage der modernen Spielauffassung verdeutlicht die Wichtigkeit der Spieleröffnung durch den Torhüter. Dabei sollte der Torwart alle Techniken zur Spieleinleitung (Abschlag Volley + Dropkick, Abstoß, Abwurf, Abrollen) beherrschen, um sie je nach Spielsituation anzuwenden.“"
                            },
                            {
                                "example_id": "ee5037a4-08fa-4dab-872c-e9526b2f094d",
                                "sense_id": "3bbda80c-0917-3bfb-820f-99a324258b3d",
                                "text": "„Ein einziger Fantasie-Laut oder die Nachahmung einer piepsenden Maus oder miauenden Katze kann den Hund in einer Sekunde in Spiellaune versetzen. Akustik eignet sich daher auch zur Spieleinleitung.“"
                            },
                            {
                                "example_id": "1a4caeb6-aa5d-4791-ba4b-1cbd15f72c5d",
                                "sense_id": "3bbda80c-0917-3bfb-820f-99a324258b3d",
                                "text": "„Oft wurde in unseren Gruppen die einführende Spieleinleitung nur belächelt, der Spielablauf als esoterischer Quatsch bezeichnet. Doch wenn sich trotz allem darauf eingelassen wurde, wurde zumeist erstaunt wahrgenommen, dass es tatsächlich funktioniert.“"
                            },
                            {
                                "example_id": "5eaf493e-2e72-436c-9bc9-afc530b277f2",
                                "sense_id": "3bbda80c-0917-3bfb-820f-99a324258b3d",
                                "text": "„Die Abstöße der Argentinier kommen meist weit und flach, das dient der Spieleinleitung, verkündet also Réthy.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
