                                        "sense_id": "d652bcff-26e4-3f8c-996d-dcaa66d6a2ca",
                                        "entry_id": "6e9c4b58-5694-31be-8679-e8a1fcd6e375",
                                        "glosses": [
                                            "A grammatical construct that casts a peripheral noun phrase as direct object."
