                                        "sense_id": "905aeadc-f146-3333-8b93-5dca06084ba4",
                                        "entry_id": "28d215a2-f135-397f-8ab5-3699dfb9b3bc",
                                        "glosses": [
                                            "mężczyzna, chłopiec grający na akordeonie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb96a91-bd75-4cae-90b3-6b98aeedad90",
                                                "sense_id": "905aeadc-f146-3333-8b93-5dca06084ba4",
                                                "text": "Kupiłam naszemu synowi akordeon, to może zechce zrezygnować ze studiów psychologicznych i zostanie akordeonistą?"
                                            }
