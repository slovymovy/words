                            {
                                "example_id": "bc3151cf-44af-4776-8bc5-17bb80cc1ee6",
                                "sense_id": "b2acfd86-6918-3542-8254-02f6adfb2ecd",
                                "text": "An die CSU gerichtet sagte die FDP-Politikerin Miriam Gruß: \"Sie sehen doch Frauen immer noch lieber am Laufstall als am Laptop.\""
                            },
                            {
                                "example_id": "fc0412c0-f972-4285-95f4-1376d82128af",
                                "sense_id": "b2acfd86-6918-3542-8254-02f6adfb2ecd",
                                "text": "„Heute laufen Männer den Jakobsweg und Brad Pitt hat die Kampfarena durch den Laufstall ersetzt.“"
                            }
                        ],
