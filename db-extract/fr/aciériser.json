                        "glosses": [
                            "Donner le caractère de l’acier à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f859f723-9472-4c38-bc3e-17ac120e80b2",
                                "sense_id": "b2430192-e9cc-374e-889b-1e4fafa80cd3",
                                "text": "Débarrassé de ses impuretés, le métal brut de la loupe, métal mou ou légèrement chargé de carbone (carburation accidentelle) pouvait être rendu plus dur, «aciérisé» en quelque sorte par refonte ou réchauffage et martelage,"
                            },
                            {
                                "example_id": "57384da9-6696-4747-98a9-6d81671acec6",
                                "sense_id": "b2430192-e9cc-374e-889b-1e4fafa80cd3",
                                "text": "A ce niveau, les mécanismes de contrôle prennent le pas sur la souplesse de projet et aciérisent la marge de flexibilité."
                            }
                        ]
                    }
