                "senses": [
                    {
                        "sense_id": "3dd4dd31-a327-3745-a40b-f9254dc965dd",
                        "entry_id": "eb17d5d6-2eef-362d-af05-3826fbefb8c1",
                        "glosses": [
                            "Schachtel aus Pappe, die zum Aufbewahren zusammengelegt ist und zum Benutzen aufgestellt/aufgefaltet werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "016516b6-5877-42f6-a855-3a1f6a38a9f1",
                                "sense_id": "3dd4dd31-a327-3745-a40b-f9254dc965dd",
                                "text": "Wenn ich ein Paket mit der Post verschicken will, besorge ich mir einen Faltkarton."
                            },
                            {
                                "example_id": "4c0bb62e-3c4d-42f1-abe1-240da9292126",
                                "sense_id": "3dd4dd31-a327-3745-a40b-f9254dc965dd",
                                "text": "Faltkartons kann man gut mit zugfesten Klebeband verschließen."
                            },
                            {
                                "example_id": "37ca602b-5515-4201-ae20-11a4291c4098",
                                "sense_id": "3dd4dd31-a327-3745-a40b-f9254dc965dd",
                                "text": "[Vinylschallplatte:] „Ihr Debüt kommt in einem aufwändig gestalteten Faltkarton daher, der sich gut anfühlt.“"
                            },
                            {
                                "example_id": "79a05c70-788d-4780-8e8b-c0124dd0bf01",
                                "sense_id": "3dd4dd31-a327-3745-a40b-f9254dc965dd",
                                "text": "[Apfelsaft:] „Der Saft wird in einem Beutel von fünf oder zehn Liter mit einem integrierten Entnahmeventil abgefüllt und in einer Umverpackung aus einem Faltkarton aufbewahrt.“"
                            },
                            {
                                "example_id": "c4fff952-9944-44d2-a843-85e383b38926",
                                "sense_id": "3dd4dd31-a327-3745-a40b-f9254dc965dd",
                                "text": "„Nach dem Verbrauch des Obstsaftes kann der Faltkarton zusammengelegt und in der nächsten Saison, mit einem neuen Beutel versehen, erneut verwendet werden.“"
                            },
                            {
                                "example_id": "bdb9f3c4-c2b2-4c9c-ad97-b30016b0a423",
                                "sense_id": "3dd4dd31-a327-3745-a40b-f9254dc965dd",
                                "text": "„Bettina stand auf und nahm aus dem Schrank hinter ihr ein Faltkarton.“"
                            },
                            {
                                "example_id": "02f9a263-b1e1-4d3f-8caf-995275acabe4",
                                "sense_id": "3dd4dd31-a327-3745-a40b-f9254dc965dd",
                                "text": "„Blieb noch der Dachboden. Dort wurde er fündig. In einer Ecke stand ein verwaister Faltkarton.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
