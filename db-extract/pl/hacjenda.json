                "translations": [
                    {
                        "translation_id": "d441d67e-89c7-49fe-948d-6c56df806469",
                        "source_entry_id": "b2057b57-e4e0-3fa2-af63-212d06e1956b",
                        "source_sense_id": "df7500d8-a7b6-39b5-82f0-dc701ee68bac",
                        "target_lang_word": "hacienda",
                        "target_lang_code": "en",
