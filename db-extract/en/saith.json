            {
                "entry_id": "cdccf039-e3a6-306c-bfb7-a5f0d63dfe06",
                "word": "saith",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "60ad095b-64f1-3ad8-b412-60112881aaca",
                        "entry_id": "cdccf039-e3a6-306c-bfb7-a5f0d63dfe06",
                        "glosses": [
                            "third-person singular simple present indicative of say"
                        ],
                        "tags": [
                            "archaic",
                            "form-of",
                            "indicative",
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "examples": [
                            {
                                "example_id": "107fbdb9-699e-4bdc-a284-eae5d1caf231",
                                "sense_id": "60ad095b-64f1-3ad8-b412-60112881aaca",
                                "text": "And the Lord spake unto Moses, Go unto Pharaoh, and say unto him, Thus saith the LORD, Let my people go, that they may serve me."
                            },
                            {
                                "example_id": "24461c1a-ca31-4b20-8100-cd032242171b",
                                "sense_id": "60ad095b-64f1-3ad8-b412-60112881aaca",
                                "text": "And they shall be mine, saith the Lord of hosts, in that day when I make up my jewels; and I will spare them, as a man spareth his own son that serveth him."
                            },
                            {
                                "example_id": "de990ad3-089f-4320-935d-5421b0c0cb5e",
                                "sense_id": "60ad095b-64f1-3ad8-b412-60112881aaca",
                                "text": "In this life we have but a glimpse of this beauty and happiness; we shall hereafter, as John saith, see him as he is."
                            },
                            {
                                "example_id": "608a290e-dc43-4c56-8e0f-d7927ce8a9af",
                                "sense_id": "60ad095b-64f1-3ad8-b412-60112881aaca",
                                "text": "While every leaf that His plumes touch / Saith His Name audibly."
                            },
                            {
                                "example_id": "83dc281a-d294-4b2b-a0a1-0185ac817062",
                                "sense_id": "60ad095b-64f1-3ad8-b412-60112881aaca",
                                "text": "[…] (\"since all is o'er,\" he saith, / \"And the blow fallen no grieving can amend;\")"
                            },
                            {
                                "example_id": "52f2200e-4e4c-4726-b677-3d92bd8ce289",
                                "sense_id": "60ad095b-64f1-3ad8-b412-60112881aaca",
                                "text": "Penn: I don't want to invest in the conversation, not that I don't have it privately, about my feelings about what direct action should happen to a leader who does that, but if there is a God, there will be vengeance beyond all possible comprehension.\nHannity: \"Vengeance is mine saith the Lord\", quoted in a very famous book."
                            }
                        ]
                    }
                ],
