                ],
                "senses": [
                    {
                        "sense_id": "19d39d70-1047-34a4-ba8f-42491f876a19",
                        "entry_id": "9ef92cb7-d49b-31b6-b28b-8d1c1ece8159",
                        "glosses": [
                            "vol persoonlijke energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "889175d4-6c9e-4c4b-837c-2c3c7237263a",
                                "sense_id": "19d39d70-1047-34a4-ba8f-42491f876a19",
                                "text": "Hij was duidelijk het energiekste lid van het groepje."
                            },
                            {
                                "example_id": "33691d74-ce2b-416d-a7f9-addd5032e0ee",
                                "sense_id": "19d39d70-1047-34a4-ba8f-42491f876a19",
                                "text": "Het was de 18-jarige Goldie uit Oostenrijk, een energieke stuiterbal met een opvallend harde stem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "312c7ce0-f30c-44e5-b7b5-d0eccd04f01f",
                        "source_entry_id": "9ef92cb7-d49b-31b6-b28b-8d1c1ece8159",
                        "source_sense_id": "19d39d70-1047-34a4-ba8f-42491f876a19",
                        "target_lang_word": "energetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "energetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec0c42e7-b9ef-3872-ae07-1fd2d2aa65a9",
                                        "entry_id": "e0852e9f-453d-358e-9b7c-7200bfcb7f1b",
                                        "glosses": [
                                            "Possessing or pertaining to energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b2a8c26-65d2-488e-b21b-987c80a78fc9",
                                                "sense_id": "ec0c42e7-b9ef-3872-ae07-1fd2d2aa65a9",
                                                "text": "Cosmic rays are energetic particles from outer space."
                                            },
                                            {
                                                "example_id": "a211959d-a0d0-4d82-b8b8-3298ac823e29",
                                                "sense_id": "ec0c42e7-b9ef-3872-ae07-1fd2d2aa65a9",
                                                "text": "energetic laws"
                                            },
                                            {
                                                "example_id": "a68aa9ea-9a3d-473a-9bde-fa8665de63ce",
                                                "sense_id": "ec0c42e7-b9ef-3872-ae07-1fd2d2aa65a9",
                                                "text": "Now lift the inverted jar so that the air can get at the outside of the “porous cup” and instantly the energetic illuminating gas which is now inside the “porous cup” begins to come out, and the water rises in the glass tube to take its place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8114133-f844-3bc0-8ed2-592dd659f680",
                                        "entry_id": "e0852e9f-453d-358e-9b7c-7200bfcb7f1b",
                                        "glosses": [
                                            "Characterised by force or vigour; full of energy; lively, vigorous, furious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a516c58-f938-45d0-99ec-891435714b20",
                                                "sense_id": "e8114133-f844-3bc0-8ed2-592dd659f680",
                                                "text": "Those kids are so energetic: they want to run around playing all day."
                                            },
                                            {
                                                "example_id": "875842c6-cd50-4097-a90c-e2a3103c3640",
                                                "sense_id": "e8114133-f844-3bc0-8ed2-592dd659f680",
                                                "text": "They are even now insulted with all the arguments which have been used in favor of energetic governments, ever since the days of Pharaoh: but every one knew, long before our revolution, that an energetic government could be supported […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d6524d0-bfb4-3761-95d1-6d3a1b642f61",
                                        "entry_id": "e0852e9f-453d-358e-9b7c-7200bfcb7f1b",
                                        "glosses": [
                                            "Having powerful effects; efficacious, potent."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dcb41b3-5776-447c-9617-3daa6b4c2eda",
                                                "sense_id": "2d6524d0-bfb4-3761-95d1-6d3a1b642f61",
                                                "text": "At these energetic sounds, the sun hid himself beneath a gloomy cloud; and the waters of two little lakes, that were naturally clearer than crystal, became of a colour like blood."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "energetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f796cd19-5048-34a4-8908-d167bda657d0",
                                        "entry_id": "f9588cd4-3660-3cad-a4ab-d5db695b52da",
                                        "glosses": [
                                            "Any material used for its release of energy, either as an explosive, propellant, or for pyrotechnic effects."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49d1831a-fa54-4908-8fb3-70ccd8809bcc",
                                                "sense_id": "f796cd19-5048-34a4-8908-d167bda657d0",
                                                "text": "Unfortunately, conventional nanoporous energetics can have poor long-term storage stability, and can be dangerously unstable, severely limiting their usefulness."
                                            },
                                            {
                                                "example_id": "bd6c2916-e4e1-48f7-bc74-2e57f816260d",
                                                "sense_id": "f796cd19-5048-34a4-8908-d167bda657d0",
                                                "text": "Improved energetics can help the Department of Defense build smaller munitions that still pack a punch."
                                            },
                                            {
                                                "example_id": "3e38cd56-902e-4cda-9807-3f6adb588ed4",
                                                "sense_id": "f796cd19-5048-34a4-8908-d167bda657d0",
                                                "text": "Where I will say there is something that we all have to watch is the underlying suppliers, the suppliers of solid rockets motors, of batteries, of energetics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
