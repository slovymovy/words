                    {
                        "translation_id": "c3d90b33-f205-4686-a93b-2e54624561c0",
                        "source_entry_id": "4937bfbc-9638-3017-80e1-3aa251b64f7c",
                        "source_sense_id": "4fa00350-f7db-3e2e-b35d-e6193c6d8e26",
                        "source_sense_description": "concerning the sense of smell",
                        "target_lang_word": "čichový",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "čichový",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b4a0c5-2b06-3a0c-ad2f-699ff427643a",
                                        "entry_id": "9674c91e-fa13-36ae-89bd-b9c05e781a33",
                                        "glosses": [
                                            "vztahující se k čichu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3175568b-e334-4cae-977e-d83dd2b6cda9",
                                                "sense_id": "f1b4a0c5-2b06-3a0c-ad2f-699ff427643a",
                                                "text": "A když si teď sečtu španělské umění; když si vzpomenu na voskové Kristy a polychrómní sochy s veškerými náležitostmi umučeného a zrasovaného těla; na náhrobky, jež vyvolávají skoro čichový dojem rozkladu; na portréty nestvůrné a neúprosné: pane na nebi, jaké je to panoptikum!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ede4c3d8-667f-48d6-a701-75d0b8ea4b18",
                        "source_entry_id": "4937bfbc-9638-3017-80e1-3aa251b64f7c",
                        "source_sense_id": "4fa00350-f7db-3e2e-b35d-e6193c6d8e26",
                        "source_sense_description": "concerning the sense of smell",
                        "target_lang_word": "olfactorisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olfactorisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "693af87e-3401-3fe1-a88c-ffac0a04a2dd",
                                        "entry_id": "c83ced54-3718-3182-bba9-f9a08947da28",
                                        "glosses": [
                                            "betrekking hebbend op het reukzintuig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e219d14-b986-4a3b-bda7-6cee6ad1879b",
                                                "sense_id": "693af87e-3401-3fe1-a88c-ffac0a04a2dd",
                                                "text": "In de loop van de jaren negentig verschenen er in vakbladen echter hoopvolle berichten over de zogenaamde olfactorische gliacellen, die er tijdens de embryonale ontwikkeling voor zorgen dat onze reukzenuw tot in de hersenen kan groeien."
                                            },
                                            {
                                                "example_id": "695a9910-8e92-4f25-a8ec-66d27715d1fc",
                                                "sense_id": "693af87e-3401-3fe1-a88c-ffac0a04a2dd",
                                                "text": "Het is opmerkelijk hoe ingrijpend de gevestigde opvatting over de geur van rookwaren is veranderd. Binnen dertig jaar sloeg die om van een neutrale, min of meer vanzelfsprekende olfactorische begeleiding van het dagelijkse leven naar een walging opwekkende stankbron."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98a761b1-e9a0-4467-ad5c-19f04ba936cf",
                        "source_entry_id": "4937bfbc-9638-3017-80e1-3aa251b64f7c",
                        "source_sense_id": "4fa00350-f7db-3e2e-b35d-e6193c6d8e26",
                        "source_sense_description": "concerning the sense of smell",
                        "target_lang_word": "olfactif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olfactif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0325cdd6-7df9-3432-8b15-eafda4258bd5",
                                        "entry_id": "17cdaf98-130a-323e-ab45-bec667a81c71",
                                        "glosses": [
                                            "Relatif à l’odorat, au flair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f925da5-ad62-4076-ba70-7850ad687ccc",
                                                "sense_id": "0325cdd6-7df9-3432-8b15-eafda4258bd5",
                                                "text": "L'odorat, qui a pour siège les poils olfactifs est, chez lui, rudimentaire, et partiellement inhibé par la vision."
                                            },
                                            {
                                                "example_id": "f6a3e235-c087-47ac-9673-c4723be79f1e",
                                                "sense_id": "0325cdd6-7df9-3432-8b15-eafda4258bd5",
                                                "text": "Entre juillet et octobre, quand les futurs manteaux de fourrure s’accouplent, le cauchemar olfactif atteint son paroxysme."
                                            },
                                            {
                                                "example_id": "afcc17bf-e7e0-4f30-bfe7-939a0693a921",
                                                "sense_id": "0325cdd6-7df9-3432-8b15-eafda4258bd5",
                                                "text": "Partons de l'exemple de Proust, avec sa madeleine. Dès lors qu'il mange une madeleine, il est plongé dans un contexte de plaisir par rapport à des souvenirs. Le système olfactif dans le cerveau a une relation avec le système dit \"limbique\" des émotions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d84ad080-de46-4567-bcf6-a26e6359a590",
                        "source_entry_id": "4937bfbc-9638-3017-80e1-3aa251b64f7c",
                        "source_sense_id": "4fa00350-f7db-3e2e-b35d-e6193c6d8e26",
                        "source_sense_description": "concerning the sense of smell",
                        "target_lang_word": "geruchlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geruchlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c2da308-c1f9-3c49-82bd-bb8b9ff433e1",
                                        "entry_id": "f3c46a36-bda4-3e12-985f-178349429d18",
                                        "glosses": [
                                            "auf den Geruch bezogene Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "578e0e2e-ac55-406d-87fb-7e1cb36e189c",
                                                "sense_id": "8c2da308-c1f9-3c49-82bd-bb8b9ff433e1",
                                                "text": "Die geruchliche Wahrnehmung von Stadtgas ist ein Warnsignal und der Hinweis auf eine undichte Stelle im Rohrsystem."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0bb77ba-a8cc-4a7c-9df2-6576d78aafd4",
                        "source_entry_id": "4937bfbc-9638-3017-80e1-3aa251b64f7c",
                        "source_sense_id": "4fa00350-f7db-3e2e-b35d-e6193c6d8e26",
                        "source_sense_description": "concerning the sense of smell",
                        "target_lang_word": "olfaktorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olfaktorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0af770dd-6c36-3648-980d-2c036aef5c30",
                                        "entry_id": "0cd61b78-001e-3701-b1c9-8fa8308872e9",
                                        "glosses": [
                                            "den Geruchssinn betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0c6cad2-ad1f-4ce8-bbdc-c5bd71cd0bb8",
                                                "sense_id": "0af770dd-6c36-3648-980d-2c036aef5c30",
                                                "text": "„Olfaktorische Signale sind Geruchsstoffe, die über den Geruchssinn wahrgenommen werden.“"
                                            },
                                            {
                                                "example_id": "d456c589-7be9-4d63-a32b-590a09067301",
                                                "sense_id": "0af770dd-6c36-3648-980d-2c036aef5c30",
                                                "text": "„Wahrscheinlich wäre Helmut Schmidt unter olfaktorischen Gesichtspunkten ein erbärmlicher Staatsmann gewesen, und er kann froh sein, dass es darauf nie ankam.“"
                                            },
                                            {
                                                "example_id": "f0f3e8c9-3ab5-4e89-9e88-1577116cee19",
                                                "sense_id": "0af770dd-6c36-3648-980d-2c036aef5c30",
                                                "text": "„Das olfaktorische und lautmalerische Moment hat sich lange Zeit in Männergesellschaften mit einer berühmt-berüchtigten lutherischen Gebrauchsanweisung und Verhaltensregel zu rechtfertigen gesucht, wobei ein grobianisches, gargantuahaftes Moment dazukam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
