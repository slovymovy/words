                                    {
                                        "sense_id": "8927035d-76d2-3a4d-a6a8-637c0347cfe5",
                                        "entry_id": "cfcef75f-3133-3920-8369-bf8da8840c04",
                                        "glosses": [
                                            "Habitant ou natif de la ville de Toulouse dans la région Midi-Pyrénées, en France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1475acb4-28ff-4106-aa8f-00a4a380add5",
                                                "sense_id": "8927035d-76d2-3a4d-a6a8-637c0347cfe5",
                                                "text": "Grosse ombre au tableau pour les Toulousains et le XV de France, la blessure de Romain Ntamack, sorti en première période."
                                            },
                                            {
                                                "example_id": "eaa2a0a8-2853-405d-8549-fd4130574b75",
                                                "sense_id": "8927035d-76d2-3a4d-a6a8-637c0347cfe5",
                                                "text": "Le Toulousain Benjamin Borg vient de créer la Cape."
                                            },
                                            {
                                                "example_id": "47b3d4a5-a89a-4474-a0cf-5289855551c3",
                                                "sense_id": "8927035d-76d2-3a4d-a6a8-637c0347cfe5",
                                                "text": "Lorsque ces maîtres franco-parisiens commenceront d’enseigner en déclamant pédantesquement leurs démonstrations scolastiques, les Toulousains cultivés, venus les écouter, éclateront de rire."
                                            }
                                        ]
                                    }
