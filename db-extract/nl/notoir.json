                    {
                        "sense_id": "d77ce484-9225-337a-ad6c-becc0eb04bda",
                        "entry_id": "0f0315bc-ad9b-3bd2-880a-4d6747052de2",
                        "glosses": [
                            "berucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c323e32-a4f7-40ed-ac7e-b0a878006ef2",
                                "sense_id": "d77ce484-9225-337a-ad6c-becc0eb04bda",
                                "text": "Luister niet naar hem, hij is een notoire leugenaar!"
                            }
                        ]
                    },
                    {
                        "sense_id": "095d84a0-1aa6-39ee-8e36-b216248c470b",
                        "entry_id": "0f0315bc-ad9b-3bd2-880a-4d6747052de2",
                        "glosses": [
                            "algemeen bekend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45cf7fae-7b13-452d-a1fb-3def44cf3751",
                                "sense_id": "095d84a0-1aa6-39ee-8e36-b216248c470b",
                                "text": "Dat is toch wel een notoir feitje."
                            },
                            {
                                "example_id": "ece67d2d-66b3-431e-8f9b-1ed3d9db0cae",
                                "sense_id": "095d84a0-1aa6-39ee-8e36-b216248c470b",
                                "text": "De cliënten stroomden Henning Sjôstrands advocatenbureau dus binnen. Niet alleen omdat hij de bekendste van alle advocaten was, zij het notoir berucht volgens boze tongen, maar ook omdat hij in de pers door middel van advertenties naar cliënten zocht."
                            }
                        ]
                    }
