                "senses": [
                    {
                        "sense_id": "9f1763ae-e438-37bb-b842-0fe14993aeca",
                        "entry_id": "6b8d26f4-333c-33e9-ba8c-1aa85a4d0205",
                        "glosses": [
                            "Landstrich im Grenzgebiet von Baden-Württemberg und Bayern zwischen Bauland, Odenwald und Taubertal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e0db74-46c2-4580-bb75-2e1f89d98878",
                                "sense_id": "9f1763ae-e438-37bb-b842-0fe14993aeca",
                                "text": "„Das Madonnenland erstreckt sich grob vom Neckar bis zum Main, genauer vom Altkreis Buchen bis hin zum Altkreis Tauberbischofsheim, wobei das Zentrum rund um Buchen liegt.“"
                            },
                            {
                                "example_id": "c35822e4-c307-4a8a-ac70-fec7fffa4baf",
                                "sense_id": "9f1763ae-e438-37bb-b842-0fe14993aeca",
                                "text": "„Am Wochenende trieben Vandalen ihr Unheil in verschiedenen Gotteshäusern der Seelsorgeeinheit Hardheim-Höpfingen im Madonnenland.“"
                            },
                            {
                                "example_id": "8616b2ec-ca1e-44f0-8ae4-ddc65b0db587",
                                "sense_id": "9f1763ae-e438-37bb-b842-0fe14993aeca",
                                "text": "„Die Ausstellung dokumentiert die religiösen Kleindenkmale des Madonnenlandes im Spiegel ihrer Genese und Geltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
