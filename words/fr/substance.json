    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08303e1d-c9eb-3b67-a14d-1e1d334895c6",
                    "sense_definition": "Matière dont une chose est faite, ou corps chimique aux propriétés physiques ou biologiques définies.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chimiste manipule chaque <w>substance</w> avec précaution dans le laboratoire."
                        },
                        {
                            "text": "Ce produit contient une <w>substance</w> toxique dangereuse pour la santé."
                        }
                    ],
                    "synonyms": [
                        "matière",
                        "produit"
                    ],
                    "common_phrases": [
                        "substance chimique",
                        "substance toxique",
                        "substance active"
                    ]
                },
                {
                    "sense_id": "3622c1b4-3f34-3e77-8d9f-6b2dd2fefa63",
                    "sense_definition": "Partie essentielle, profonde et fondamentale d'une idée, d'un discours, d'un écrit ou d'une affaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "essence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a résumé en <w>substance</w> les déclarations du président lors de la conférence."
                        },
                        {
                            "text": "Son long discours était élégant mais manquait cruellement de <w>substance</w>."
                        }
                    ],
                    "synonyms": [
                        "essence",
                        "fond",
                        "quintessence"
                    ],
                    "antonyms": [
                        "forme",
                        "apparence"
                    ],
                    "common_phrases": [
                        "en substance",
                        "manquer de substance"
                    ]
                },
                {
                    "sense_id": "b079f31f-a7ab-3bfe-9c12-521ef00a53c9",
                    "sense_definition": "Partie la plus nutritive, bienfaisante et essentielle d'un aliment ou de la terre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nutrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les racines des arbres puisent toute leur <w>substance</w> dans le sol fertile de la forêt."
                        },
                        {
                            "text": "Une cuisson trop longue enlève une grande partie de la <w>substance</w> des légumes frais."
                        }
                    ],
                    "synonyms": [
                        "suc"
                    ],
                    "common_phrases": [
                        "tirer la substance"
                    ]
                },
                {
                    "sense_id": "2696e456-fab2-3ea6-a88d-d1c45f443c35",
                    "sense_definition": "Ce qui subsiste par soi-même de façon permanente, constituant le support des propriétés ou des accidents.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "D'après Spinoza, il n'existe qu'une seule <w>substance</w> infinie dont tous les êtres sont les modes."
                        },
                        {
                            "text": "Les philosophes débattent depuis l'Antiquité sur la distinction fondamentale entre la <w>substance</w> et les accidents."
                        }
                    ],
                    "antonyms": [
                        "accident"
                    ]
                }
            ]
        }
    ]
}