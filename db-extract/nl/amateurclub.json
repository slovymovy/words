                        "examples": [
                            {
                                "example_id": "7008426d-b5dd-49ed-a80e-7ce7a4fe526a",
                                "sense_id": "24ee0e6f-69ce-305d-8b76-f48fe339b549",
                                "text": "Van Veen: \"We moeten eerlijk zijn. De cijfers liegen niet. Er is gewoon weinig talent doorgebroken. Er is niet zo veel geïnvesteerd als in het begin het doel was. Het was lange tijd gewoon een amateurclub. En twee jaar geleden is Ajax Cape Town gedegradeerd. Ik dacht echt: hoe is dit toch mogelijk?\""
                            },
                            {
                                "example_id": "8c866185-d646-479c-b9a5-2cf2f9978d5f",
                                "sense_id": "24ee0e6f-69ce-305d-8b76-f48fe339b549",
                                "text": "Voor Silva is San Sebastián ook geen onbekende stad. Als 18-jarig jochie werd hij door zijn toenmalige club Valencia uitgeleend aan het nietige Eibar, op vijftig kilometer van de Baskische stad. Eibar speelde op dat moment in de tweede divisie en had veel weg van een amateurclub."
                            }
                        ]
