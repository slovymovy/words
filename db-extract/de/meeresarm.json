                ],
                "senses": [
                    {
                        "sense_id": "a17f52d6-16a0-36d1-960b-87c3fd6dbc84",
                        "entry_id": "6a51d7aa-cddf-361a-8c89-e3cb4fdc66cc",
                        "glosses": [
                            "Bucht in einem Meer, die weit ins Land reicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffbf59e4-f01f-4451-a08b-c5adae4ba4ba",
                                "sense_id": "a17f52d6-16a0-36d1-960b-87c3fd6dbc84",
                                "text": "„Nach drei Stunden lag der sandige Boden des Meeresarms frei, in der Mitte floß noch Wasser in einem Priel, das sich aber ohne weiteres durchwaten lassen mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12f56968-b470-4d1d-bda8-88c102b11dd0",
                        "source_entry_id": "6a51d7aa-cddf-361a-8c89-e3cb4fdc66cc",
                        "source_sense_id": "a17f52d6-16a0-36d1-960b-87c3fd6dbc84",
                        "source_sense_description": "Bucht in einem Meer, die weit ins Land reicht",
                        "target_lang_word": "bras de mer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bras de mer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef1ea8cc-cc3a-3053-a228-d197b0059b35",
                                        "entry_id": "8cf9bf99-d15a-3ff8-ac8e-e7fdc18d5d1c",
                                        "glosses": [
                                            "Étroite et profonde pénétration de la mer entre deux bandes de terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3339746c-f051-4ae5-b608-a1be88735038",
                                                "sense_id": "ef1ea8cc-cc3a-3053-a228-d197b0059b35",
                                                "text": "Au bout d'une demi-heure de galop le long de l'Eyafjord, nous arrivons à l'extrémité méridionale de ce noble bras de mer qui dégénère ici en un marais fangeux."
                                            },
                                            {
                                                "example_id": "3b3f1e39-47a0-433f-b497-df740a5223f8",
                                                "sense_id": "ef1ea8cc-cc3a-3053-a228-d197b0059b35",
                                                "text": "Vatelin.– Il y a des choses qu’on peut faire d’un côté du détroit et qu’on ne peut pas faire de l’autre !… J’avais un bras de mer entre ma femme et moi, ici je ne l’ai plus…"
                                            },
                                            {
                                                "example_id": "e89a4718-e008-4b71-94db-15e9fdbd9e4e",
                                                "sense_id": "ef1ea8cc-cc3a-3053-a228-d197b0059b35",
                                                "text": "Une simple tartane, servant sans doute de vivandière au Saint-Jean-Baptiste, […], parcourut tous les petits bras de mer qui précèdent le détroit de Magellan. Cette tartane fit plusieurs découvertes au large de la Terre de Feu ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
