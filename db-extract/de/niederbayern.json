                "senses": [
                    {
                        "sense_id": "79b57171-2de9-3d33-bc46-39ed9260314d",
                        "entry_id": "f164cfe0-d0c7-3ea0-8ba5-166e28e9b073",
                        "glosses": [
                            "Regierungsbezirk im Bundesland Bayern, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1edd9a5a-ef25-4521-b9cd-9bc7d6b6433d",
                                "sense_id": "79b57171-2de9-3d33-bc46-39ed9260314d",
                                "text": "Landshut ist die größte Stadt Niederbayerns."
                            },
                            {
                                "example_id": "d6b830ce-f4fb-43ef-aead-afd135e70577",
                                "sense_id": "79b57171-2de9-3d33-bc46-39ed9260314d",
                                "text": "In Niederbayern gibt es viele touristische Attraktionen."
                            },
                            {
                                "example_id": "2e3cba34-e5ce-4465-a4b6-1965e9b12e07",
                                "sense_id": "79b57171-2de9-3d33-bc46-39ed9260314d",
                                "text": "„Der Kirchenmaler und Restaurator Christian Goller aus Niederbayern soll seit Jahrzehnten den internationalen Kunstmarkt mit selbstgemalten Bildern speisen, die er über Freunde als Werke \"aus der Werkstatt / dem Umfeld von Lucas Cranach dem Älteren\" oder seinem Sohn Lucas Cranach dem Jüngeren bei Auktionshäusern einbringen lasse.“"
                            },
                            {
                                "example_id": "62e9a8ef-ac49-4220-8fca-36f38cc58b41",
                                "sense_id": "79b57171-2de9-3d33-bc46-39ed9260314d",
                                "text": "„Er hatte die Tochter eines Bauern aus Niederbayern 1915 in München geheiratet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
