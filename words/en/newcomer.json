    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e95bf882-c189-3b0d-b750-d69f880c9de3",
                    "sense_definition": "A person who has recently arrived in a place, community, or country.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arrival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>newcomer</w> to the neighborhood, she was eager to make friends and join local clubs.",
                            "target_lang_translations": {
                                "ru": "Как <w>новичок</w> в этом районе, она очень хотела завести друзей и вступить в местные клубы."
                            }
                        },
                        {
                            "text": "The local community center organized a special welcome event for every <w>newcomer</w> in town.",
                            "target_lang_translations": {
                                "ru": "Местный общественный центр организовал специальное приветственное мероприятие для каждого <w>новоприбывшего</w> в городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "incomer",
                        "stranger"
                    ],
                    "antonyms": [
                        "resident",
                        "native",
                        "inhabitant",
                        "dweller"
                    ],
                    "common_phrases": [
                        "welcome newcomer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который недавно прибыл в какое-либо место, сообщество или страну."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "тот, кто недавно поселился где-либо или присоединился к группе"
                            },
                            {
                                "target_lang_word": "новенький",
                                "target_lang_sense_clarification": "разговорное обозначение недавно прибывшего человека"
                            },
                            {
                                "target_lang_word": "приезжий",
                                "target_lang_sense_clarification": "человек, недавно прибывший в город или местность"
                            },
                            {
                                "target_lang_word": "новоприбывший",
                                "target_lang_sense_clarification": "официальное или книжное обозначение недавно приехавшего человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1fe83e4-e914-32fe-b066-398a61b19be7",
                    "sense_definition": "A person who has recently started a new activity, job, or hobby; a beginner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beginner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although he was a <w>newcomer</w> to the tech industry, his innovative ideas quickly gained attention.",
                            "target_lang_translations": {
                                "ru": "Хотя он был <w>новичком</w> в технологической индустрии, его инновационные идеи быстро привлекли к себе внимание."
                            }
                        },
                        {
                            "text": "The online tutorial is designed specifically for any <w>newcomer</w> to programming.",
                            "target_lang_translations": {
                                "ru": "Это онлайн-руководство разработано специально для любого <w>начинающего</w> в программировании."
                            }
                        }
                    ],
                    "synonyms": [
                        "newbie",
                        "beginner",
                        "entrant"
                    ],
                    "antonyms": [
                        "oldtimer"
                    ],
                    "common_phrases": [
                        "newcomer to the industry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который недавно начал заниматься новой деятельностью, работой или хобби; начинающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "тот, кто недавно начал заниматься чем-либо и еще не освоился"
                            },
                            {
                                "target_lang_word": "начинающий",
                                "target_lang_sense_clarification": "человек, делающий первые шаги в какой-либо сфере"
                            },
                            {
                                "target_lang_word": "неофит",
                                "target_lang_sense_clarification": "книжное или ироничное обозначение новичка в каком-либо деле"
                            }
                        ]
                    }
                }
            ]
        },
