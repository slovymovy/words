                        "form": "es ist unfestlegbar"
                    },
                    {
                        "form_id": "a9a98a03-23c5-447d-aadc-21c6ed1c3095",
                        "entry_id": "254fd9a0-5c65-32eb-8ea6-8932a0b487d1",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unfestlegbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "059c9476-0017-32c8-ab03-7b1493c2fc6e",
                        "entry_id": "254fd9a0-5c65-32eb-8ea6-8932a0b487d1",
                        "glosses": [
                            "so, dass es nicht festgelegt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a0ea646-ead7-4ac1-9cba-b5d8d7353ff3",
                                "sense_id": "059c9476-0017-32c8-ab03-7b1493c2fc6e",
                                "text": "„Mit der Strömung meint er ja ziemlich wahrscheinlich die unfestlegbar fließende Bewegung in den sinnlichen Dingen.“"
                            },
                            {
                                "example_id": "52a15391-6a35-4cf6-b5f1-1624d355e5c9",
                                "sense_id": "059c9476-0017-32c8-ab03-7b1493c2fc6e",
                                "text": "„Wie sind diese Figuren konstituiert, dass sie so unstet, unfestlegbar und projektionsflächenbietend einander gegenübertreten?“"
                            },
                            {
                                "example_id": "cc52470c-ba5e-4677-80b1-8874025a9215",
                                "sense_id": "059c9476-0017-32c8-ab03-7b1493c2fc6e",
                                "text": "„Der Ansatz in einem Verfahren, dass eine solche Reduktion verhindert, konnte am §32 gezeigt werden, indem beide Seiten, Gott und Mensch verfremdet und je neu, unfestlegbar, rekonstruiert werden.“"
                            },
                            {
                                "example_id": "a5acfab3-1fee-4f65-8552-899bb0a0a052",
                                "sense_id": "059c9476-0017-32c8-ab03-7b1493c2fc6e",
                                "text": "„Ähnlich unfestlegbar ist das Wetter: Matscheschnee, immer um den Gefrierpunkt rum“"
                            },
                            {
                                "example_id": "60312acd-14ba-4829-8308-8c90ac912576",
