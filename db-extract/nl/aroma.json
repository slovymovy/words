                                "target_senses": [
                                    {
                                        "sense_id": "c3b8e58e-9161-3e69-ac9b-55e918f68a16",
                                        "entry_id": "c6ccba26-6e28-3199-bf7a-be7faba08d19",
                                        "glosses": [
                                            "A smell; especially a pleasant spicy or fragrant one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ff16c8-b0cd-4145-8f3d-672b407249f5",
                                                "sense_id": "c3b8e58e-9161-3e69-ac9b-55e918f68a16",
                                                "text": "I love the aroma of cinnamon."
                                            },
                                            {
                                                "example_id": "0072da89-3b31-4943-a58b-1eac0755529c",
                                                "sense_id": "c3b8e58e-9161-3e69-ac9b-55e918f68a16",
                                                "text": "David Mason, Beverage and Bar Manager at St. Regis, describes the complex aromas and layered palate of the cognac thus: “It’s kind of autumn flavors. Really nutty, almondy – kind of fig, plum, dried fruits. But it finishes off really smoothly but with a little bit of tobacco leaf.”"
                                            },
                                            {
                                                "example_id": "f1feb310-d8bf-4a20-a926-ed295f8a54f5",
                                                "sense_id": "c3b8e58e-9161-3e69-ac9b-55e918f68a16",
                                                "text": "The smell of fresh asphalt hangs heavy in the air at Dore & Totley station. It's even powerful enough to overcome the usual delightful aromas emanating from the well-known curry house which occupies the original platform building."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dda995f8-a627-40c9-8fab-5b346dc5c47a",
                        "source_entry_id": "ddbc7fdf-cea8-32f6-856e-eedaf00b8365",
                        "source_sense_id": "5af36a3b-f63c-39f7-a2c5-5602f1e63c06",
                        "source_sense_description": "(aangename) geur van spijzen, dranken, genotmiddelen enz",
                        "target_lang_word": "flavour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flavour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                        "entry_id": "4b532781-ac5c-38f2-bb9c-7e78860b89aa",
                                        "glosses": [
                                            "British standard spelling of flavor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89a998c2-51cb-4ac8-a0a9-ca8fa9625c3e",
                                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                                "text": "The flavour of this apple pie is delicious."
                                            },
                                            {
                                                "example_id": "ae1776e3-d255-4316-b3d3-cba5ce64f4e9",
                                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                                "text": "Flavour was added to the pudding."
                                            },
                                            {
                                                "example_id": "71aa7a5c-d984-4fa3-9a9c-77369bd18681",
                                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                                "text": "What flavour of bubble gum do you enjoy?"
                                            },
                                            {
                                                "example_id": "bc6969ac-5b3a-4666-be0e-7859326645e2",
                                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                                "text": "The flavour of an experience."
                                            },
                                            {
                                                "example_id": "1fa2fbc9-b6fd-4133-9c59-99dd0409504a",
                                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                                "text": "Debian is one flavour of the Linux operating system."
                                            },
                                            {
                                                "example_id": "12562c00-f9c5-4dc7-b551-b76bf79a196c",
                                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                                "text": "Ciaotou Sugar Factory\n(橋頭糖廠, Qiáotóu Tángchǎng) Ciaotou consists of a defunct factory (which you can walk into, and explore the old mechanisms and vats) and an old village that retains most of its early-20th-century flavour."
                                            },
                                            {
                                                "example_id": "a04b98f4-dbe9-44eb-8b27-cd08d10bab6d",
                                                "sense_id": "391b2151-e94c-3c5a-9bd6-7d3c12095d39",
                                                "text": "The journey is worth an article in itself, but all I can give is a flavour of a railway which traverses a bleak but dramatic coastline that's regularly battered by the elements - especially around Parton, where the line is constantly threatened by the sea."
                                            }
                                        ]
                                    }
                                ]
                            },
