                                "example_id": "4108c49c-4c4d-4b3b-b685-d94367054e55",
                                "sense_id": "da94111f-6295-3380-9464-a44c0b29cef0",
                                "text": "Wunsch und Versuchung, sich niederzulegen und zu ruhen, beschlichen in der Gestalt seinen Sinn, daß er sich sagte, es sei wie bei einem Sandsturm in der Wüste, der die Araber veranlasse, sich aufs Gesicht zu werfen und den Burnus über den Kopf zu ziehen.",
                                "translation": "The Magic Mountain",
                                "english": "The Magic Mountain"
                            },
                            {
                                "example_id": "1d50e757-a225-47da-af45-55313c0b59c5",
                                "sense_id": "da94111f-6295-3380-9464-a44c0b29cef0",
                                "text": "[…] ein wallender weißer Burnus hätte ihn ebenso natürlich gekleidet wie sein sorgfältig geschnittener, sichtlich nach Pariser Muster gehaltener schwarzer Cutaway.",
                                "translation": "The World of Yesterday",
                                "english": "The World of Yesterday"
                            }
                        ]
                    }
