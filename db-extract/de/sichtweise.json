                ],
                "senses": [
                    {
                        "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                        "entry_id": "f6634594-63ca-368d-97b5-3061422dec3a",
                        "glosses": [
                            "Betrachtung oder Bewertung aus einer speziellen Richtung heraus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60084d0c-9a58-406c-8139-be535bd0954f",
                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                "text": "Wir haben auf die Planungen vor allem eine ingenieurwissenschaftliche Sichtweise."
                            },
                            {
                                "example_id": "03c7beaa-44c8-4709-aeb3-972856bb0c08",
                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                "text": "Die Systembiologie ist die biochemische Sichtweise der Welt."
                            },
                            {
                                "example_id": "c3e3c303-9636-4a39-9aac-6322b4ecbad4",
                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                "text": "„Forster stand mit seiner Sichtweise in Deutschland nicht allein.“"
                            },
                            {
                                "example_id": "4d260d0a-1d03-4e62-a292-39f8b2453e86",
                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                "text": "„Eine ähnliche Sichtweise vertrat Kurt Riezler, der Sekretär und politische Berater von Reichskanzler Theobald von Bethmann Hollweg.“"
                            },
                            {
                                "example_id": "6b4decdd-7a41-4461-8af6-3eceafc90f06",
                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                "text": "„Durch den Witz und in dem Witz wird eine Korrektur der Sichtweise vorgenommen, die in der offiziellen Sprache vorgegeben ist, es wird ihr eine andere Sichtweise gegenübergestellt.“"
                            },
                            {
                                "example_id": "1b006e41-cf38-490f-ba50-dea203358223",
                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                "text": "„Thomas macht gestisch deutlich, dass er diese pessimistische Sichtweise keineswegs teilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c01aaa8-bbe9-4b76-ad1d-389c0e6639cc",
                        "source_entry_id": "f6634594-63ca-368d-97b5-3061422dec3a",
                        "source_sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                        "source_sense_description": "Betrachtung oder Bewertung aus einer speziellen Richtung heraus",
                        "target_lang_word": "standpoint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "standpoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcfb07df-e4af-31b0-94a5-9c3280af6cfd",
                                        "entry_id": "326c5239-0dd0-3a0e-bd1e-92bf876ccd11",
                                        "glosses": [
                                            "A point of view; a perspective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3963972-9853-459e-95eb-0cbbd52f65eb",
                                                "sense_id": "dcfb07df-e4af-31b0-94a5-9c3280af6cfd",
                                                "text": "Bathing once a month may save time, but from a cleanliness standpoint, it's not effective."
                                            },
                                            {
                                                "example_id": "98577171-c9ff-4bd8-a39e-c8ad0160e91d",
                                                "sense_id": "dcfb07df-e4af-31b0-94a5-9c3280af6cfd",
                                                "text": "Plus, early in a career, bands are typically winging it from a creative standpoint; after awhile, acts figure out what they’re doing right (or wrong), and are more deliberate about songcraft and execution."
                                            },
                                            {
                                                "example_id": "16166a2d-c76a-466e-b199-98040444175c",
                                                "sense_id": "dcfb07df-e4af-31b0-94a5-9c3280af6cfd",
                                                "text": "From the standpoint of traditional Chinese culture, it is believed that mind and body are the same and diseases stem from wicked thoughts or energy, while kind thoughts and positive energy will bring blessings and healing to a person."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
