                "senses": [
                    {
                        "sense_id": "7ee57dce-4004-34db-88c0-b8cc23dea559",
                        "entry_id": "6a21bd01-d9c7-3a36-8df3-fe29d5cf2b4b",
                        "glosses": [
                            "Gewichtsklasse für Sportler im Boxen und Gewichtheben, eine Klasse über Fliegengewicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91daee9e-5a36-4293-b736-d23fc484cfad",
                                "sense_id": "7ee57dce-4004-34db-88c0-b8cc23dea559",
                                "text": "Bantamgewicht ist zurzeit seine Gewichtsklasse."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d3546e60-444f-3fb0-9934-a41c48bb0ddc",
                        "entry_id": "6a21bd01-d9c7-3a36-8df3-fe29d5cf2b4b",
                        "glosses": [
                            "Boxer mit einem Gewicht zwischen 51 und 53,5 kg"
                        ],
                        "tags": [
                            "Boxen"
                        ],
                        "examples": [
                            {
                                "example_id": "7513fce0-b31a-418d-acf6-471b77d1b8d5",
                                "sense_id": "d3546e60-444f-3fb0-9934-a41c48bb0ddc",
                                "text": "„Mein übles Gefühl, dass am Boxen einfach etwas falsch ist, dass es ein Fehler, eine Ungesetzlichkeit ist, die aus irgendeinem Grund vom Gesetz nicht verboten wird, war vermutlich noch berechtigter, als ich vor einigen Wochen, im März 1986, inmitten einer unvermittelt sehr still gewordenen Zuschauermenge saß, die der Fernsehübertragung eines Boxkampfs zusah, und Zeugin wurde, wie das Bantamgewicht Richie Sandoval plötzlich flach und unbeweglich auf dem Rücken lag.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
