                        "translation_id": "c4a022e8-3215-4ab3-bb34-3e8b176f839c",
                        "source_entry_id": "0733f913-c7e1-3d17-8460-9abb9496d0c4",
                        "source_sense_id": "b391dcd2-3ae3-3ae4-9d06-efac43699490",
                        "source_sense_description": "als vee gehouden runderen",
                        "target_lang_word": "Rindvieh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rindvieh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a69ac41a-c02e-3603-bc0a-b744334f8738",
                                        "entry_id": "f5964f46-552c-3626-be01-e6245717f8e3",
                                        "glosses": [
                                            "Gesamtheit der Rinder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7572dc-7f30-4da9-97bc-95a0ac88d66d",
                                                "sense_id": "a69ac41a-c02e-3603-bc0a-b744334f8738",
                                                "text": "„Wirklich und wahrhaftig, Leute, und man denkt, in dem Frost ist für Rindvieh keine Nahrung.“"
                                            },
                                            {
                                                "example_id": "ecaa234f-3f2c-4fca-b7b9-dccd31ac93cd",
                                                "sense_id": "a69ac41a-c02e-3603-bc0a-b744334f8738",
                                                "text": "„Man brüllt lauter als das Rindvieh unten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7a93e1b-9e2f-38ae-a4fb-25163e5be754",
                                        "entry_id": "f5964f46-552c-3626-be01-e6245717f8e3",
                                        "glosses": [
                                            "einzelnes Rind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9251d62a-1f13-4325-8836-4436997de7dd",
                                                "sense_id": "d7a93e1b-9e2f-38ae-a4fb-25163e5be754",
                                                "text": "Auf der Weide stand ein einzelnes Rindvieh und kaute gemächlich vor sich hin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "91f29b68-697e-3b0d-9b72-4ecef6abc8cc",
                                        "entry_id": "f5964f46-552c-3626-be01-e6245717f8e3",
                                        "glosses": [
                                            "dumme, ungeschickte Person, über die man sich ärgert"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e436bd-aeb3-4c8c-85d2-f1d6910cf39a",
                                                "sense_id": "91f29b68-697e-3b0d-9b72-4ecef6abc8cc",
                                                "text": "Du dummes Rindvieh! Du hast mir einen Kratzer an die Autotür gemacht!"
                                            },
                                            {
                                                "example_id": "e8153027-355b-4f0a-8707-54d4449a9108",
                                                "sense_id": "91f29b68-697e-3b0d-9b72-4ecef6abc8cc",
                                                "text": "„Die Landesgerichtsdirektoren und Räte, diese traurigen Fachsimpel, diese blühenden Rindviecher, wie armselig ihre Gaudi war.“"
                                            },
                                            {
                                                "example_id": "7a429730-033d-402e-8edd-787458887beb",
                                                "sense_id": "91f29b68-697e-3b0d-9b72-4ecef6abc8cc",
                                                "text": "„Doch selbst wenn wir die Rindviecher durchschauen, wirklich abwählen können wir sie eigentlich nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
