                    },
                    {
                        "form_id": "90868ad3-a7af-4036-8551-94a911e473b4",
                        "entry_id": "836e4490-95b8-321b-a81a-b3ac56a612a1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Däumlinge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bea59dc2-7679-3f86-bbe1-ffc4a27e3a38",
                        "entry_id": "836e4490-95b8-321b-a81a-b3ac56a612a1",
                        "glosses": [
                            "Daumenschutzüberzug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56ffd65e-8d46-43d7-a4d3-5ea32aaa08bc",
                                "sense_id": "bea59dc2-7679-3f86-bbe1-ffc4a27e3a38",
                                "text": "„Beiläufig sei bemerkt, dass nach der Meinung einiger Forscher Thors Aufenthalt im Däumling des Handschuhs die Entstehung des gemein-germanischen Märchens vom Däumling, seinen Kämpfen und Wanderfahrten veranlasst hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8dbdb648-c614-3c67-9228-191cfe9ccdb5",
                        "entry_id": "836e4490-95b8-321b-a81a-b3ac56a612a1",
                        "glosses": [
                            "fiktives (menschliches) Wesen von der Größe eines menschlichen Daumens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70cb5885-7d45-4c2a-96db-bad1b936f0a9",
                                "sense_id": "8dbdb648-c614-3c67-9228-191cfe9ccdb5",
                                "text": "„Er hatte seinen Söhnen und dann seinem Enkel, mir erzählt, dass wir nämlich als Däumling in seinem Ohr mit ihm an der Front gewesen seien.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "390b59e1-af81-3b69-958a-fd51b75ad976",
                        "entry_id": "836e4490-95b8-321b-a81a-b3ac56a612a1",
                        "glosses": [
                            "Vorsprung, gegen den ein Hebeling stößt, der einen Stempel anhebt"
                        ],
                        "tags": [
                            "Pochwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "d9d31f54-dcee-4d7a-8c4e-866adca595e2",
                                "sense_id": "390b59e1-af81-3b69-958a-fd51b75ad976",
                                "text": "„Durch die Pferde- oder Dampfkraft wird das Auf- und Niederfallen der Stempel bewirkt, indem die am Schafte derselben befestigten Däumlinge durch die Heblinge der Pochwelle in die Höhe gehoben und bei weiterm Umdrehen der Welle auch wieder fallen gelassen werden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
