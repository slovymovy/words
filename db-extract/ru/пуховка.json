                ],
                "senses": [
                    {
                        "sense_id": "f4c29bff-aceb-3533-823c-f51e2c05763a",
                        "entry_id": "590fad17-23ec-3f0d-bd19-145344d971b3",
                        "glosses": [
                            "приспособление для пудрения в виде пучка пушистых волокон"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10dc4da3-832e-4887-b795-6c8f51b7fddd",
                                "sense_id": "f4c29bff-aceb-3533-823c-f51e2c05763a",
                                "text": "В одной руке у меня деревянное с позолотой венецианское зеркало, в другой ― огромная пуховка розовой пудры."
                            }
                        ]
                    },
                    {
                        "sense_id": "4294ee93-d805-3c5f-b0a7-7786ef83b2af",
                        "entry_id": "590fad17-23ec-3f0d-bd19-145344d971b3",
                        "glosses": [
                            "разг. куртка или пальто на пуховой прокладке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e9e2359-7a1a-4863-bf22-174f13c6e073",
                                "sense_id": "4294ee93-d805-3c5f-b0a7-7786ef83b2af",
                                "text": "Пуховка, рюкзак, джинсы, сапоги ― всё было мокрое ― и даже на свернутой шкуре поблескивали капельки измороси."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01a96274-9ba2-41a7-aa52-c0ebb48615c0",
                        "source_entry_id": "590fad17-23ec-3f0d-bd19-145344d971b3",
                        "source_sense_description": "приспособление для пудрения",
                        "target_lang_word": "powder puff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "powder puff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0059e55-ee27-3411-88e7-e94fc0a2a8ab",
                                        "entry_id": "2e1ca47b-64c3-37cd-8f83-e378e033a9e6",
                                        "glosses": [
                                            "A ball or pad of soft material used for the application of cosmetic powder to the face."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d30289f1-8ee7-4bc9-867e-281d4522df55",
                                                "sense_id": "a0059e55-ee27-3411-88e7-e94fc0a2a8ab",
                                                "text": "The little bag, with its shiny, silvery jaws open, lay on her lap. He could see her powder-puff, her rouge stick, a bundle of letters, a phial of tiny black pills like seeds, a broken cigarette, a mirror, white ivory tablets with lists on them that had been heavily scored through. He thought: “In Egypt she would be buried with those things.”"
                                            },
                                            {
                                                "example_id": "04dcda04-885d-4cdb-aa49-a9e3fecc1d13",
                                                "sense_id": "a0059e55-ee27-3411-88e7-e94fc0a2a8ab",
                                                "text": "Both the lipstick and the rouge are waterproof and frictionproof. They won't come off on your handkerchief or powder puff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79170181-2181-3dbd-9f3b-833fc6094c31",
                                        "entry_id": "2e1ca47b-64c3-37cd-8f83-e378e033a9e6",
                                        "glosses": [
                                            "Any of certain species of genus Calliandra."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c15a3246-5cf3-4bd6-9359-7ac24805fd7a",
                        "source_entry_id": "590fad17-23ec-3f0d-bd19-145344d971b3",
                        "source_sense_description": "верхняя одежда",
                        "target_lang_word": "duck-down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4d7ec1ee-9973-4bb6-bf45-55bca6d24868",
                        "source_entry_id": "590fad17-23ec-3f0d-bd19-145344d971b3",
                        "source_sense_description": "верхняя одежда",
                        "target_lang_word": "Daunenjacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Daunenjacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e80588dc-a638-311b-a1a1-3821768e29c9",
                                        "entry_id": "71a6285f-594f-3cf5-b44a-6234fe1efc27",
                                        "glosses": [
                                            "Jacke, die mit Daunen von Enten oder Gänsen gefüttert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8199b61-933c-46c7-8ab5-7ddf866bcc57",
                                                "sense_id": "e80588dc-a638-311b-a1a1-3821768e29c9",
                                                "text": "„Als er mich sah, rannte er los, warf sich, dick eingepackt in seine blaue Daunenjacke, in meine Arme.“"
                                            },
                                            {
                                                "example_id": "e9756db0-6b2d-47a7-b63e-1e0e2318b49f",
                                                "sense_id": "e80588dc-a638-311b-a1a1-3821768e29c9",
                                                "text": "„Außerdem waren noch zwei Sanitäter vor Ort, und etwas abseits stand ein Mann zwischen dreißig und vierzig, in einer Daunenjacke, mit Vollbart und Mütze auf dem Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c48bba7d-b7e0-4b13-872b-50576f5148ca",
                        "source_entry_id": "590fad17-23ec-3f0d-bd19-145344d971b3",
                        "source_sense_description": "верхняя одежда",
                        "target_lang_word": "doudoune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doudoune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ef9d29a-79b9-37ab-9a9d-5832bf9de2da",
                                        "entry_id": "1783c0f7-3138-3dd2-8311-c46fcec63358",
                                        "glosses": [
                                            "Veste matelassée pour protéger du froid, généralement garnie de duvet."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a58dc5dc-6260-47c2-913c-38707ee5139a",
                                                "sense_id": "6ef9d29a-79b9-37ab-9a9d-5832bf9de2da",
                                                "text": "Seul Nabil la suivit des yeux et la vit faire demi-tour, dégager sa main de sous la doudoune de la petite, armée d’un Sig Sauer automatique."
                                            },
                                            {
                                                "example_id": "cc7bb2db-63fe-4193-8cde-91dc302c29f3",
                                                "sense_id": "6ef9d29a-79b9-37ab-9a9d-5832bf9de2da",
                                                "text": "Moi, ce jour-là, je portais une doudoune noire en coton ouaté, comme celle des détenus dans les camps ou des soldats dans un bataillon de construction, la troupe la moins prestigieuse de l'armée."
                                            },
                                            {
                                                "example_id": "e0263acb-b673-425f-9b41-1110cc787064",
                                                "sense_id": "6ef9d29a-79b9-37ab-9a9d-5832bf9de2da",
                                                "text": "Il y a quelque chose de profondément jouissif dans le fait d'imaginer les millions de gens en doudoune qui se caillent les miches en France à l'heure où je barbote dans cette eau à trente degrés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9017e8f-345f-3408-af12-5d0d8275ce33",
                                        "entry_id": "1783c0f7-3138-3dd2-8311-c46fcec63358",
                                        "glosses": [
                                            "Sein. — Note d’usage : Dans cet emploi, s’utilise principalement au pluriel."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aed2359-1986-4282-b891-70fe89b4d75f",
                                                "sense_id": "b9017e8f-345f-3408-af12-5d0d8275ce33",
                                                "text": "Elle s'approcha de lui et, de son peignoir entrouvert, laissa ses doudounes caresser son visage, sa bouche, son nez. Mouss les mordillait doucement comme une tétine pleine de miel."
                                            },
                                            {
                                                "example_id": "3fceac6d-ec13-4824-aca3-a9dcee499cd6",
                                                "sense_id": "b9017e8f-345f-3408-af12-5d0d8275ce33",
                                                "text": "Oui, mes doudounes ! Bien qu'elles soient moins belles qu'autrefois, elles sont encore un morceau de roi. Leur seule vue suffit à mettre en émoi tous ces messieurs du Jockey Club."
                                            },
                                            {
                                                "example_id": "405608fa-de32-42ab-b243-7696720a2374",
                                                "sense_id": "b9017e8f-345f-3408-af12-5d0d8275ce33",
                                                "text": "Jo — Oh, c'est aux doudounes qu'elle est sensible.\nMarcel — Aux doudounes ? Mais qu’est-ce que c’est que ça les doudounes ?\nJo — Les gaillards, les roberts, les nénés quoi. Il faut tout lui expliquer à ce mec-là, il entrave rien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48f5eb4d-2d71-33b5-9297-2d20e0dd1fe8",
                                        "entry_id": "1783c0f7-3138-3dd2-8311-c46fcec63358",
                                        "glosses": [
                                            "Chiffon, couverture, peluche dont un jeune enfant ne se sépare pas, qu’il suce, qui lui sert de protection ou de substitut affectif."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "605219fb-9380-4b42-a2b4-60397dd1407d",
                                                "sense_id": "48f5eb4d-2d71-33b5-9297-2d20e0dd1fe8",
                                                "text": "Tout ce que les Occidentaux veulent, maintenant, c’est qu’on les laisse tranquilles.\nAvec leur écran, leur connexion internet et leur doudoune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
