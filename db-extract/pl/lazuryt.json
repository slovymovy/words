                "senses": [
                    {
                        "sense_id": "6eb4e3e0-d193-3b8d-a5b8-a28f9e782064",
                        "entry_id": "8024d32f-64ec-342d-99a5-fc6f506ab1a6",
                        "glosses": [
                            "minerał z gromady krzemianów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00377f65-55ee-43c3-8309-df716d7d4f80",
                                "sense_id": "6eb4e3e0-d193-3b8d-a5b8-a28f9e782064",
                                "text": "Lazuryt wzbudzał swoim kolorem i twardością zainteresowanie w wielu kulturach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02518b54-479b-476c-b52e-d604dc804755",
                        "source_entry_id": "8024d32f-64ec-342d-99a5-fc6f506ab1a6",
                        "source_sense_id": "6eb4e3e0-d193-3b8d-a5b8-a28f9e782064",
                        "target_lang_word": "lapis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6b79036-7f6d-3d70-a94d-9fe96a29c81d",
                                        "entry_id": "462f0e0e-8e03-36d9-ae4c-9db386e2593b",
                                        "glosses": [
                                            "Ellipsis of lapis lazuli."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "392037d9-6144-4842-bcd8-5a5ef98ae99e",
                                                "sense_id": "f6b79036-7f6d-3d70-a94d-9fe96a29c81d",
                                                "text": "Lapis, opal, &c. are poliſh'd on a wooden wheel. To faſhion and Engrave vaſes of agate, cryſtal, lapis, or the like, they make uſe of a kind of lathe like that us'd by pewterers, excepting that as the pewterers lathe holds the veſſels, which are to be wrought with proper tools; that of the Engraver generally holds the tools which are turn'd by a wheel, and the veſſels held to them to be cut and engraven either in relievo or otherwiſe; [...]"
                                            },
                                            {
                                                "example_id": "49374b0d-01f0-4fe7-8ed2-c90afb05707e",
                                                "sense_id": "f6b79036-7f6d-3d70-a94d-9fe96a29c81d",
                                                "text": "French Bead Necklace of lapis or carnelian color, with crystal rondelles between each bead, graduated, 32 inches long."
                                            },
                                            {
                                                "example_id": "6c362798-2d71-43c1-aa89-ef0b57e95d08",
                                                "sense_id": "f6b79036-7f6d-3d70-a94d-9fe96a29c81d",
                                                "text": "That lapis lazuli in particular among the precious and semi-precious stones known from Mesopotamia was accorded considerable value in antiquity may be inferred from the archaeological record through association with high-status locii and goods. [...] deities receive votive gifts and booty of lapis, consisting of items of personal adornment and cult objects, while their temples are described as decorated with lapis or shining like lapis. [...] For example, the contents of the graves in the Royal Cemetery of Ur: [...] various objects employing inlay that include lapis among the insets, [...] Mari sent an emissary to acquire lapis from Lars."
                                            },
                                            {
                                                "example_id": "83ffa0d2-8212-4a86-8dd4-12047a2cd670",
                                                "sense_id": "f6b79036-7f6d-3d70-a94d-9fe96a29c81d",
                                                "text": "The buddha lands described in the Lotus share certain generic features: the ground is made of lapis or crystal; they are perfectly level, without mountains or valleys; they are free from all manner of filth, including the stench of latrines [...] The ground was made of lapis lazuli, [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3dadd94-0cc3-465e-b9e5-fa54a6a14833",
                        "source_entry_id": "8024d32f-64ec-342d-99a5-fc6f506ab1a6",
                        "source_sense_id": "6eb4e3e0-d193-3b8d-a5b8-a28f9e782064",
                        "target_lang_word": "lazurite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lazurite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb85001-baee-3819-89e6-dedfa5ed333c",
                                        "entry_id": "a7fdaf1c-d6b9-3fb1-a4e0-13d2625d49d2",
                                        "glosses": [
                                            "A mineral of metamorphosed limestones. Lazurite forms the gemstone lapis lazuli, and crushed lazurite provided the ultramarine color in artists' paint of the Old Masters. Sodalite and lazurite form the sodalite group of silicate minerals. Chemical composition: Sodium aluminum silicate with sulphur, Na₄₋₅Al₃Si₃O₁₂S."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "460a632d-6056-47eb-a8bb-156587a95b7c",
                                                "sense_id": "bcb85001-baee-3819-89e6-dedfa5ed333c",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are […] . (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1052d38-9354-49e9-9bae-9983b92a1bb1",
                        "source_entry_id": "8024d32f-64ec-342d-99a5-fc6f506ab1a6",
                        "source_sense_id": "6eb4e3e0-d193-3b8d-a5b8-a28f9e782064",
                        "target_lang_word": "lazurit",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5d7c05de-9579-45ee-9293-ba8acc0c8940",
                        "source_entry_id": "8024d32f-64ec-342d-99a5-fc6f506ab1a6",
                        "source_sense_id": "6eb4e3e0-d193-3b8d-a5b8-a28f9e782064",
                        "target_lang_word": "lapis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8dbbe7cf-222a-3a46-83c5-b2a90737c0af",
                                        "entry_id": "8804fed5-e85a-3565-9ce0-a2a6b7e14a50",
                                        "glosses": [
                                            "Synonyme de Lapis-lazuli."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe5fbf2-93bd-4002-9bdb-65d435aacea3",
                                                "sense_id": "8dbbe7cf-222a-3a46-83c5-b2a90737c0af",
                                                "text": "― Ô ma chère Laura, lui dis-je avec effort en appuyant mes lèvres sur sa main, comment peux-tu appliquer le mot de travail ingrat à l’admirable voyage que nous avons fait ensemble dans le cristal ? Rends-moi cette resplendissante vision des océans d’opale et des îles de lapis ! Retournons aux verts bosquets de la chrysoprase et aux sublimes rivages de l’euclase et de la spinelle, ou aux fantastiques stalagmites des grottes d’albâtre qui nous invitaient à un si doux repos ! Pourquoi as-tu voulu me faire franchir les limites du monde sidéral et me faire voir des choses que l’œil humain ne peut supporter ?"
                                            },
                                            {
                                                "example_id": "8eb41829-5067-4bff-9e6a-ea4868249762",
                                                "sense_id": "8dbbe7cf-222a-3a46-83c5-b2a90737c0af",
                                                "text": "Ainsi, lorsque Jean Colombe reprend Les Très Riches Heures entre 1485 et 1489, « on n’a pas les mêmes pigments que chez les Limbourg, qui utilisaient beaucoup le lapis, très cher pour leur bleu », note Élisabeth Ravaud."
                                            },
                                            {
                                                "example_id": "018571ac-176b-43e5-a41f-a4c1bc2c77e0",
                                                "sense_id": "8dbbe7cf-222a-3a46-83c5-b2a90737c0af",
                                                "text": "On fait avec le lapis mis en poudre un bleu qui s’appelle outremer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae710205-7ddc-3ffc-863e-edb519cb6662",
                                        "entry_id": "8804fed5-e85a-3565-9ce0-a2a6b7e14a50",
                                        "glosses": [
                                            "Nom donné à une variété d'indienne dont la couleur dominante est le bleu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85a44665-25d2-46c5-8175-af1e341490aa",
                                                "sense_id": "ae710205-7ddc-3ffc-863e-edb519cb6662",
                                                "text": "Ses lapis, quoique remarquables sur divers points, pèchent cependant par l'absence d'harmonie dans l'organisation des dessins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lapis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e01b7d38-b9c7-3525-bf43-503d4c28c450",
                                        "entry_id": "a25b11dd-2332-3026-b02a-46f1ac6f6b00",
                                        "glosses": [
                                            "Couleur bleu azur profond de la pierre du même nom. #26619C"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cfc55e0-8a68-491f-a607-fa4a4c7e6ced",
                                                "sense_id": "e01b7d38-b9c7-3525-bf43-503d4c28c450",
                                                "text": "Une étoffe lapis."
                                            },
                                            {
                                                "example_id": "803fc036-669a-4497-9757-7a219356ebcd",
                                                "sense_id": "e01b7d38-b9c7-3525-bf43-503d4c28c450",
                                                "text": "Une crête neigeuse (sierra nevada), que les montagnes trop rapprochées nous avaient voilée jusque-là, apparut tout à coup, se détachant sur un ciel d’un bleu lapis si foncé qu’il était presque noir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
