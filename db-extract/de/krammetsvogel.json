                                        "sense_id": "9d702877-bf64-3062-8d29-3e072cd57428",
                                        "entry_id": "2ad7b5e6-47d8-38ca-a6f9-ddebdabbdff2",
                                        "glosses": [
                                            "A large thrush, Turdus pilaris, a bird of Eurasia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "224de940-a894-42e5-af0a-e9690c58324f",
                                                "sense_id": "9d702877-bf64-3062-8d29-3e072cd57428",
                                                "text": "Paul seemed relaxed, scanning the fields on either side of the muddy lane for fieldfares"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e360fa0-58cb-4bba-8d38-85e70112d5ec",
                        "source_entry_id": "e7d0f33c-ec42-3a05-a705-2631b6f6b605",
                        "source_sense_id": "2890a843-6623-3bb2-8da5-5e3b634caba7",
                        "source_sense_description": "alter Name für die Wacholderdrossel (Turdus pilaris)",
                        "target_lang_word": "grive",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grive",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c03cae5f-a601-3c46-8d73-e80c7affa87b",
                                        "entry_id": "48ca8604-1fb6-37d3-ac9a-f52bf1fc1dd4",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau dont le plumage est mêlé de blanc et de brun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "514b0fc0-e2bc-488b-8b73-07904bdc45b3",
                                                "sense_id": "c03cae5f-a601-3c46-8d73-e80c7affa87b",
                                                "text": "L’abondance des grives est telle alors sur la côte méridionale de la Baltique, que, selon le calcul de M. Klein, la seule ville de Dantzick en consomme chaque année quatre-vingt-dix mille paires."
                                            },
                                            {
                                                "example_id": "5b8c2b14-ebc4-446e-b917-c8ca0bec35aa",
                                                "sense_id": "c03cae5f-a601-3c46-8d73-e80c7affa87b",
                                                "text": "Pendant la convalescence qui suivit une longue maladie, le médecin ordonna à Pompée de manger une grive ; mais ce volatile était alors fort rare."
                                            },
                                            {
                                                "example_id": "36f218ba-09c5-4e93-9e42-5e7c6a1296d6",
                                                "sense_id": "c03cae5f-a601-3c46-8d73-e80c7affa87b",
                                                "text": "Unique aromate de la cuisson des grives, la sauge avait son petit buisson au jardin. Elle sortait du domaine culinaire pour entrer dans la pharmacopée domestique – au même titre que de nombreuses plantes aromatiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ca13c0a-b2ea-350b-8d67-2258125b9dfc",
                                        "entry_id": "48ca8604-1fb6-37d3-ac9a-f52bf1fc1dd4",
                                        "glosses": [
                                            "La guerre, l'armée."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9737a692-978b-4e76-938b-52f0e11a914c",
                                                "sense_id": "9ca13c0a-b2ea-350b-8d67-2258125b9dfc",
                                                "text": "Même à la grive, en 40, le Tatave fallait pas lui gonfler le sac... galons pas galons, \"suce ma bite et bien !\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
