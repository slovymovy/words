                    },
                    {
                        "translation_id": "76b965aa-1e9e-497a-8f2f-a44997c36db1",
                        "source_entry_id": "f5ce36a9-477d-3faf-961c-49b9bdc2bc28",
                        "source_sense_id": "a37e5f57-fd39-308a-86de-1a8ab7731957",
                        "source_sense_description": "pertaining to the church",
                        "target_lang_word": "kerkelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kerkelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "eac425d7-c001-3efe-bd0e-38aa0f912774",
                                        "entry_id": "855c53b9-6572-31b6-b779-992769351925",
                                        "glosses": [
                                            "verband hebbend met de kerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b04038df-5e17-49c9-b29c-15676e7954cc",
                                                "sense_id": "eac425d7-c001-3efe-bd0e-38aa0f912774",
                                                "text": "Ben je kerkelijk?"
                                            },
                                            {
                                                "example_id": "2ce90236-0adc-4f80-ac60-dd1bb0d9a031",
                                                "sense_id": "eac425d7-c001-3efe-bd0e-38aa0f912774",
                                                "text": "De feministen hadden ook moeite met een andere wet uit 1924. Kerkelijke partijen hadden toen bepaald dat vrouwen op de dag van hun huwelijk werden ontslagen uit overheidsfuncties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ff681a3-6b5f-42e1-8bc4-faac504a83e5",
                        "source_entry_id": "f5ce36a9-477d-3faf-961c-49b9bdc2bc28",
                        "source_sense_id": "a37e5f57-fd39-308a-86de-1a8ab7731957",
                        "source_sense_description": "pertaining to the church",
                        "target_lang_word": "ecclésiastique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecclésiastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf89a615-5154-3c61-ae07-459b727f479d",
                                        "entry_id": "7068113f-8ec8-32fa-9cb0-75794b758372",
                                        "glosses": [
                                            "Qui a rapport à l’Église, au clergé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57289879-85b8-40ba-b21e-d2e2e12b998f",
                                                "sense_id": "cf89a615-5154-3c61-ae07-459b727f479d",
                                                "text": "Enfin, au mois d’octobre 1827, le gouvernement de Mexico décréta l’expulsion du clergé espagnol du territoire de la république, et ordonna que les biens ecclésiastiques dont il était détenteur fussent appropriés aux besoins des prêtres mexicains."
                                            },
                                            {
                                                "example_id": "314a5f0e-f194-4b43-ba06-5e4040234e51",
                                                "sense_id": "cf89a615-5154-3c61-ae07-459b727f479d",
                                                "text": "Là se trouvaient des idées sur la structure du monde, sur la disposition des êtres, qui étaient empruntées soit à l’antiquité, soit aux Arabes, soit même aux Juifs, et qui ne s’accordaient pas avec la science ecclésiastique."
                                            },
                                            {
                                                "example_id": "d41c5467-ac6b-481a-a678-9454fbdb8218",
                                                "sense_id": "cf89a615-5154-3c61-ae07-459b727f479d",
                                                "text": "Il n'y a pas de corporation ecclésiastique qui ait plus asservi aux circonstances ses doctrines et sa conduite que le haut clergé anglican."
                                            },
                                            {
                                                "example_id": "227f42cc-b10e-4ab5-ad72-4ff55c15a429",
                                                "sense_id": "cf89a615-5154-3c61-ae07-459b727f479d",
                                                "text": "[…] ; et, quand M. de Bonald est venu réclamer à la Chambre, en 1816, au nom de la religion catholique redevenue religion de l’État, le rétablissement de l’indissolubilité du mariage, il s’est bien gardé de réclamer en même temps et au même titre le rétablissement de l’éternité des vœux ecclésiastiques."
                                            },
                                            {
                                                "example_id": "e04a48a0-054c-4de4-8a27-c688f0b7e169",
                                                "sense_id": "cf89a615-5154-3c61-ae07-459b727f479d",
                                                "text": "On peut dire que, depuis plus de trente ans, le pouvoir ecclésiastique a exploité le Concordat au profit de ses intérêts avec une hardiesse croissante."
                                            },
                                            {
                                                "example_id": "089dc860-9833-4f5c-b095-5885a33e8b34",
                                                "sense_id": "cf89a615-5154-3c61-ae07-459b727f479d",
                                                "text": "Il se trouva, cependant, des seigneurs ecclésiastiques, tels l’abbesse de Saintes (1272) qui, ne pouvant tolérer la vue des mécréants, prièrent le roi de les débarrasser de leurs juifs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ecclésiastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce46bf22-7045-3222-bfb2-70bc97250980",
                                        "entry_id": "53769ae8-fae1-3523-8743-ffdd23ccc0b2",
                                        "glosses": [
                                            "Membre du clergé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72d9629-9d64-43c7-a9af-d17672d16922",
                                                "sense_id": "ce46bf22-7045-3222-bfb2-70bc97250980",
                                                "text": "C’était évidemment un ecclésiastique du premier rang ; son costume était celui d’un moine de l’Ordre de Cîteaux, composé d’étoffes beaucoup plus belles que celles que son ordre n’en admettait ordinairement."
                                            },
                                            {
                                                "example_id": "188ba1ab-38f3-47f5-8b4b-71d21ac8bca1",
                                                "sense_id": "ce46bf22-7045-3222-bfb2-70bc97250980",
                                                "text": "Toute la journée, au fur et à mesure que les toues amenaient les inondés à la Croix-Verte, les ecclésiastiques de la ville et les sœurs de charité leur distribuaient, au nom de l'autorité, tous les secours possibles en pain, viande et vin."
                                            },
                                            {
                                                "example_id": "904d58bd-0fa6-477d-a42c-58bdc406f7d2",
                                                "sense_id": "ce46bf22-7045-3222-bfb2-70bc97250980",
                                                "text": "Et fermant la marche, quelques ecclésiastiques en retard se hâtaient, saisissant d’une main leurs robes qui s’enflaient comme des ballons, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42d27bb9-04f9-42c8-8cb7-ed1e1a332325",
                        "source_entry_id": "f5ce36a9-477d-3faf-961c-49b9bdc2bc28",
