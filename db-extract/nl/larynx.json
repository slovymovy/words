                    {
                        "translation_id": "1e57f29a-3861-46a9-a006-8a63fe34b51f",
                        "source_entry_id": "cb833693-aab1-3843-bf92-9636cf7f7f1d",
                        "source_sense_id": "af08f54a-4074-371c-ae0a-98058adfa6b1",
                        "source_sense_description": "Bovenste deel van de luchtpijp",
