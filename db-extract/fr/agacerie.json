        "fr-extract.jsonl": [
            {
                "entry_id": "9ef27ac2-8a08-314c-8fce-87b9685f5bbf",
                "word": "agacerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c9d67753-2239-46cc-85cf-77ce6ee7c287",
                        "entry_id": "9ef27ac2-8a08-314c-8fce-87b9685f5bbf",
                        "tags": [
                            "plural"
                        ],
                        "form": "agaceries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eee4689b-4340-3d9d-bedb-4b37da8791b4",
                        "entry_id": "9ef27ac2-8a08-314c-8fce-87b9685f5bbf",
                        "glosses": [
                            "Manières ou paroles par lesquelles on cherche à attirer l’attention de quelqu’un. — Note d’usage : Il s’emploie surtout en parlant des femmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37041a9f-b3db-4e1c-80ac-6b34ba4840ab",
                                "sense_id": "eee4689b-4340-3d9d-bedb-4b37da8791b4",
                                "text": "[…] les témoignages que nous venons d’entendre pourraient nous porter à croire que, dans cette malheureuse affaire, notre frère a été entraîné par des agaceries et des illusions infernales ?"
                            },
                            {
                                "example_id": "e2a6d96c-9af3-48e1-b2a8-17ceb6668e95",
                                "sense_id": "eee4689b-4340-3d9d-bedb-4b37da8791b4",
                                "text": "Presque toujours le condamné, soit qu’il ait le bon ou le mauvais poignard, est obligé d’aller faire des agaceries au tigre, pour le contraindre à sortir de sa cage, et l’exciter au combat."
                            },
                            {
                                "example_id": "c6737106-77eb-4251-83ee-5c8ca4f4df74",
                                "sense_id": "eee4689b-4340-3d9d-bedb-4b37da8791b4",
                                "text": "La petite Moïna, son aînée de deux ans, provoquait par des agaceries déjà féminines d’interminables rires, qui partaient comme des fusées […]."
                            },
                            {
                                "example_id": "ff724849-d94c-4f3e-ac4d-b1fd0590da18",
                                "sense_id": "eee4689b-4340-3d9d-bedb-4b37da8791b4",
                                "text": "On ne pouvait rien voir de plus gracieux que cette svelte blondine, jeune, gaie, folâtre ; pas un homme qui eût résisté à ses agaceries."
                            },
                            {
                                "example_id": "ca5bd4bd-792b-4f8b-ac36-0daea084cfd1",
                                "sense_id": "eee4689b-4340-3d9d-bedb-4b37da8791b4",
                                "text": "Après avoir fait gambades sur gambades, exécuté des voltiges hardies autour de sœur Rose très émue, fait niches sur niches et mille agaceries aux militaires qui jouaient à la drogue et dont les pinces en bois posées sur le nez des perdants me faisaient toujours rire, j’étais, on le pense, très animé, très emporté ; […]."
                            },
                            {
                                "example_id": "32084ed8-6c58-4909-9bbe-7916a7042904",
                                "sense_id": "eee4689b-4340-3d9d-bedb-4b37da8791b4",
                                "text": "Les ridicules agaceries qui avaient autrefois un caractère de niaiserie, d’insouciance, semblent trahir maintenant une certaine application volontaire qui ne me permet pas de les mettre tout à fait au compte d’une curiosité maladive commune à beaucoup de ses pareilles."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
