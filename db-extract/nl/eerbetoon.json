                ],
                "senses": [
                    {
                        "sense_id": "292e5afc-38ee-33b1-b984-d1ff0c1352bc",
                        "entry_id": "bb0af551-be93-31c4-ba10-1a8dc8d58a3c",
                        "glosses": [
                            "blijk van verering dat aan iemand wordt getoond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e5a8439-75ae-44a0-809a-ed9396ca4d95",
                                "sense_id": "292e5afc-38ee-33b1-b984-d1ff0c1352bc",
                                "text": "Er werden saluutschoten afgevuurd als eerbetoon aan de nieuwe koning."
                            },
                            {
                                "example_id": "8428f264-589f-45e0-8a8a-1fce97dc8c14",
                                "sense_id": "292e5afc-38ee-33b1-b984-d1ff0c1352bc",
                                "text": "In Horn is afscheid genomen van Tweede Wereldoorlog-veteraan Leo Hendrikx. Als eerbetoon aan de Engelandvaarder vloog tijdens het binnendragen van de kist een Spitfire boven het Limburgse dorp, meldt 1Limburg."
                            },
                            {
                                "example_id": "082ee080-c7e3-4527-b209-8700e95e0fac",
                                "sense_id": "292e5afc-38ee-33b1-b984-d1ff0c1352bc",
                                "text": "De Franse president Macron prijst de paus ook voor zijn inzet voor armen en kwetsbaren. Hij noemt hem een bescheiden man die \"altijd aan de zijde van de meest kwetsbaren stond\". De Notre-Dame in Parijs luidt de klokken 88 keer als eerbetoon aan de paus, die 88 jaar is geworden."
                            }
                        ]
                    }
                ],
