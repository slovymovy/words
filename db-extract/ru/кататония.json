                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catatonia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd99b0be-5a53-3dc2-9aba-d7fc3d4b92e9",
                                        "entry_id": "771b9290-4cfa-32ec-986d-5a8b7a5165b4",
                                        "glosses": [
                                            "A severe psychiatric condition, often associated with schizophrenia, characterized by a tendency to remain in a rigid state of stupor for long periods which give way to short periods of extreme agitation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09f5c6c0-3b66-33ad-9fad-ffa1ac6f3a40",
                                        "entry_id": "771b9290-4cfa-32ec-986d-5a8b7a5165b4",
                                        "glosses": [
                                            "A frozen, unresponsive state, as of electronic equipment."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fee64eb1-c95f-4295-bcc2-4ca6193b8fb6",
                                                "sense_id": "09f5c6c0-3b66-33ad-9fad-ffa1ac6f3a40",
                                                "text": "“Relay that!” Thwaite shouted. Somewhere on the bridge a hand closed over a relay and dropped the AIDs into an electronic catatonia."
                                            }
                                        ]
                                    }
                                ]
                            }
