                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c588907c-3a7f-364f-93b9-d862b19187d7",
                        "entry_id": "f6fdb141-0f16-3800-9f32-2976a21b8dd0",
                        "glosses": [
                            "истор. недопустимо правилами цензуры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "182c3d63-3f2e-403a-ba7b-3b310753223a",
                                "sense_id": "c588907c-3a7f-364f-93b9-d862b19187d7",
                                "text": "Можно бы указать и ещё на некоторые угрозы новому строю, но говорить об этом преждевременно да, пожалуй, и нецензурно."
                            },
                            {
                                "example_id": "4dc91de8-a3ce-4689-8e27-b8d75337544a",
                                "sense_id": "c588907c-3a7f-364f-93b9-d862b19187d7",
                                "text": "Послал рукопись какому-то профессору в Москву; тот ему ответил зелёными чернилами на первом листе рукописи: «Ересь и нецензурно»."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3c2f911-76e7-3d03-8f3f-741f0956c905",
                        "entry_id": "f6fdb141-0f16-3800-9f32-2976a21b8dd0",
                        "glosses": [
                            "неприлично, непристойно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d58c9acb-14ed-42b4-8217-d999343f9c26",
                                "sense_id": "c3c2f911-76e7-3d03-8f3f-741f0956c905",
                                "text": "Все молчали, лишь иногда, на заносах и хлябах, минуя опасность, Слава нецензурно выражался сквозь стиснутые зубы."
                            }
                        ]
                    }
