                "senses": [
                    {
                        "sense_id": "cb6ceace-8f76-3ed2-a7e9-8eb67811b8db",
                        "entry_id": "a8ef1827-1a72-3a85-ad96-139b205d88af",
                        "glosses": [
                            "der Verlust von Druck durch Reibung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d2dde9-f69f-452a-a1d4-ca0e3e143416",
                                "sense_id": "cb6ceace-8f76-3ed2-a7e9-8eb67811b8db",
                                "text": "„Ein Druckverlust ∆p tritt auf wenn Medien durch Kanäle oder Rohren strömen.“"
                            },
                            {
                                "example_id": "d08acf8c-7283-4910-859e-4beaa475c6ba",
                                "sense_id": "cb6ceace-8f76-3ed2-a7e9-8eb67811b8db",
                                "text": "„Zur überschlägigen Ermittlung der Druckverluste durch Rohrleitungen und Rohreinbauten, wie Krümmer, Übergangsstücke, Ventile usw. dient das umseitige Diagramm.“"
                            },
                            {
                                "example_id": "74c0f5d8-f28b-4b60-83c7-9e7cc9e842a8",
                                "sense_id": "cb6ceace-8f76-3ed2-a7e9-8eb67811b8db",
                                "text": "„Der Druckverlust (pv) ist eine Druckdifferenz, die durch Wandreibung (in Rohrleitungen) und Widerstände (in Armaturen, Formstücken usw.) verursacht wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
