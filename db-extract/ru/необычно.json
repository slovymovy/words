                                "target_senses": [
                                    {
                                        "sense_id": "e6512a5b-8b34-35e9-bda1-aab37bf23042",
                                        "entry_id": "965f5e2b-8fa3-3ded-80fa-7d7b73b47b72",
                                        "glosses": [
                                            "In an unusual manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bf95042-1536-4b7d-a503-8a906ffc86f5",
                                                "sense_id": "e6512a5b-8b34-35e9-bda1-aab37bf23042",
                                                "text": "She's unusually happy for someone who's just broken her leg."
                                            },
                                            {
                                                "example_id": "32ebf142-f48a-403f-82b5-ae3511bc5df0",
                                                "sense_id": "e6512a5b-8b34-35e9-bda1-aab37bf23042",
                                                "text": "My convention diary is unusually disjointed, since I was mingily commuting from Berkshire rather than pay £65 per night for a single room."
                                            },
                                            {
                                                "example_id": "2bde567d-bc4c-4287-8a5d-ba34265a3059",
                                                "sense_id": "e6512a5b-8b34-35e9-bda1-aab37bf23042",
                                                "text": "These first English migrants to Jamestown endured terrible disease and arrived during a period of drought and colder-than-normal winters. The migrants to Roanoke on the outer banks of Carolina, where the English had gone in the 1580s, disappeared. And a brief effort to settle the coast of Maine in 1607 and 1608 failed because of an unusually bitter winter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2ad5465-270b-4fba-b0f3-af0412c2e3a3",
                        "source_entry_id": "6e766bc5-cc23-3551-afa1-1f11a62764bb",
                        "source_sense_id": "cd957c57-0328-34cd-8bf6-6d1e413aca57",
                        "target_lang_word": "ungewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                        "entry_id": "d558a056-9765-32fb-abcf-008daa80df73",
                                        "glosses": [
                                            "nicht gewöhnlich, nicht der Gewohnheit entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ddf01c-63b6-4531-acc4-ab87866ab722",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Ungewöhnliche Zeiten erfordern ungewöhnliches Handeln."
                                            },
                                            {
                                                "example_id": "8ee19457-0104-4db1-ba7b-f1bf4d5cf5ad",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            },
                                            {
                                                "example_id": "94b0dd82-a208-4b55-91a6-beb7480c5d26",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Am ungewöhnlichsten jedoch war ihre Art zu laufen."
                                            },
                                            {
                                                "example_id": "6b05cb6a-5499-45eb-9df7-7e1b876bc456",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Wie reagiert die Psyche des Straßenbahnkondukteurs auf ein Douceur von ungewöhnlichem Ausmaße, das zum Beispiel mehr als dreimal so groß ist als der Fahrpreis und siebenmal so groß als das Normaltrinkgeld!“"
                                            },
                                            {
                                                "example_id": "74dbb13f-c556-49ce-a05a-1667ff695ef4",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Auf einer Pressekonferenz erklärte der US-Präsident [Donald Trump], dass er ein Treffen mit dem kanadischen Premierminister Justin Trudeau […] ausgeschlagen habe. Ungewöhnlich ist, dass ein amtierender Präsident dies öffentlich sagt. Besonders ungewöhnlich ist, dass Kanada gar nicht um das Treffen gebeten hatte. Dies teilte Trudeaus Sprecherin im Anschluss mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
