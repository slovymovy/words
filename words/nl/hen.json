{
    "word_family": [
        "hoen",
        "hoender",
        "hennetje"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "fad50662-620c-33e8-8f86-79e990f72bd3",
                    "sense_definition": "Persoonlijk voornaamwoord van de derde persoon meervoud, gebruikt als lijdend voorwerp of na een voorzetsel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "persoonlijk-voornaamwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb <w>hen</w> gisteren in de stad gezien.",
                            "target_lang_translations": {
                                "en": "I saw <w>them</w> in town yesterday.",
                                "ru": "Я видел <w>их</w> вчера в городе."
                            }
                        },
                        {
                            "text": "Ik ga morgen samen met <w>hen</w> naar de bioscoop.",
                            "target_lang_translations": {
                                "en": "I am going to the cinema together with <w>them</w> tomorrow.",
                                "ru": "Завтра я пойду в кино вместе с <w>ними</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "met hen",
                        "voor hen",
                        "tegen hen"
                    ],
                    "target_lang_definitions": {
                        "en": "Third-person plural personal pronoun used as a direct object or after a preposition.",
                        "ru": "Личное местоимение третьего лица множественного числа, используемое в качестве прямого дополнения или после предлога."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "them",
                                "target_lang_sense_clarification": "object pronoun for a group of people"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "их",
                                "target_lang_sense_clarification": "винительный падеж местоимения 'они'"
                            },
                            {
                                "target_lang_word": "ними",
                                "target_lang_sense_clarification": "творительный падеж после предлога 'с'"
                            },
                            {
                                "target_lang_word": "них",
                                "target_lang_sense_clarification": "родительный/предложный падеж после предлогов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a249205f-4d01-3532-bdde-ef4443f34fe7",
                    "sense_definition": "Genderneutraal persoonlijk voornaamwoord voor de derde persoon enkelvoud, gebruikt voor non-binaire personen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persoonlijk-voornaamwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is mijn vriend en <w>hen</w> werkt als ontwerper.",
                            "target_lang_translations": {
                                "en": "This is my friend and <w>they</w> work as a designer.",
                                "ru": "Это мой друг, и <w>они</w> работают дизайнером."
                            }
                        },
                        {
                            "text": "Ik heb gisteren met <w>hen</w> gesproken over de nieuwe plannen.",
                            "target_lang_translations": {
                                "en": "I spoke with <w>them</w> yesterday about the new plans.",
                                "ru": "Вчера я поговорил с <w>ними</w> о новых планах."
                            }
                        }
                    ],
                    "synonyms": [
                        "die"
                    ],
                    "target_lang_definitions": {
                        "en": "Gender-neutral third-person singular personal pronoun used for non-binary individuals.",
                        "ru": "Гендерно-нейтральное личное местоимение третьего лица единственного числа, используемое для небинарных персон."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "them",
                                "target_lang_sense_clarification": "singular gender-neutral object pronoun"
                            },
                            {
                                "target_lang_word": "they",
                                "target_lang_sense_clarification": "singular gender-neutral subject pronoun"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "они",
                                "target_lang_sense_clarification": "используется как гендерно-нейтральное местоимение в ед. ч."
                            },
                            {
                                "target_lang_word": "их",
                                "target_lang_sense_clarification": "объектная форма гендерно-нейтрального местоимения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8709a5bf-fdbb-397a-aca8-220d298f0496",
                    "sense_definition": "Een vrouwelijk exemplaar van een kip of een andere hoenderachtige vogel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vogels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>hen</w> legt elke ochtend een vers ei in het nest.",
                            "target_lang_translations": {
                                "en": "The <w>hen</w> lays a fresh egg in the nest every morning.",
                                "ru": "<w>Курица</w> каждое утро кладет в гнездо свежее яйцо."
                            }
                        },
                        {
                            "text": "In de ren loopt een bruine <w>hen</w> met haar kuikens.",
                            "target_lang_translations": {
                                "en": "A brown <w>hen</w> is walking in the run with her chicks.",
                                "ru": "В загоне гуляет коричневая <w>курица</w> со своими цыплятами."
                            }
                        }
                    ],
                    "synonyms": [
                        "kip",
                        "kieken",
                        "kloek"
                    ],
                    "common_phrases": [
                        "een hen legt eieren"
                    ],
                    "target_lang_definitions": {
                        "en": "A female chicken or other gallinaceous bird.",
                        "ru": "Самка курицы или другой птицы отряда курообразных."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hen",
                                "target_lang_sense_clarification": "female bird, especially a chicken"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "курица",
                                "target_lang_sense_clarification": "домашняя птица"
                            },
                            {
                                "target_lang_word": "наседка",
                                "target_lang_sense_clarification": "курица, высиживающая цыплят"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a6d82d2-ba54-3c90-94f9-08ac7543015c",
                    "sense_definition": "Een informele of spottende term voor een vrouw.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mensen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat is dat voor een vreemde <w>hen</w> die daar loopt?",
                            "target_lang_translations": {
                                "en": "What kind of strange <w>hen</w> is that walking there?",
                                "ru": "Что это за странная <w>курица</w> там идет?"
                            }
                        },
                        {
                            "text": "Zij is echt een eigenwijze <w>hen</w> als het om haar werk gaat.",
                            "target_lang_translations": {
                                "en": "She is a real stubborn <w>hen</w> when it comes to her work.",
                                "ru": "Она настоящая упрямая <w>курица</w>, когда дело касается её работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "kippetje"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en soms licht denigrerend"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal or mocking term for a woman.",
                        "ru": "Разговорное или насмешливое обозначение женщины."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hen",
                                "target_lang_sense_clarification": "informal term for a woman, often Scottish or derogatory"
                            },
                            {
                                "target_lang_word": "old biddy",
                                "target_lang_sense_clarification": "mocking term for a woman"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "курица",
                                "target_lang_sense_clarification": "бранное или ироничное о глупой женщине"
                            },
                            {
                                "target_lang_word": "клуша",
                                "target_lang_sense_clarification": "о неповоротливой или чрезмерно заботливой женщине"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}