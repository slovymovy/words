                "senses": [
                    {
                        "sense_id": "6201b741-a9bb-3f31-80fa-fc4e47ba82e4",
                        "entry_id": "f43c1d80-1d4f-3e67-ae58-6961a58d64e9",
                        "glosses": [
                            "das weitere Geben von Geld an einen Arbeitnehmer (Entlohnen), wenn dieser nicht arbeitet (zum Beispiel, weil er krank ist)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "209bfef2-77e3-4952-92e5-beb4d45b6c7b",
                                "sense_id": "6201b741-a9bb-3f31-80fa-fc4e47ba82e4",
                                "text": "„Zur Entgeltfortzahlung ist er nur verpflichtet, soweit sich eine solche Verpflichtung aus anderen gesetzlichen Vorschriften (wie beispielsweise aus § 616 Bürgerliches Gesetzbuch) ergibt.“"
                            },
                            {
                                "example_id": "312a46ce-ee7c-4163-9946-9427770a89e3",
                                "sense_id": "6201b741-a9bb-3f31-80fa-fc4e47ba82e4",
                                "text": "„Nach Berechnungen der Arbeitgeberverbände kostet die Entgeltfortzahlung im Krankheitsfall die Unternehmen mehr als 30 Milliarden Euro im Jahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
