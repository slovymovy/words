                ],
                "senses": [
                    {
                        "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                        "entry_id": "03ebf290-940e-3efc-b9eb-2466cb40b727",
                        "glosses": [
                            "Person, die protestiert (zum Ausdruck bringt, dass sie mit etwas nicht einverstanden ist); an einem Protest teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9db8baae-f220-43d7-8a07-40cbee6fb71b",
                                "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                "text": "„In Coburg kommt es bei Demonstrationen gegen die Ermordung Matthias Erzbergers zu blutigen Zusammenstößen zwischen der bayerischen Landespolizei und den Protestierenden.“"
                            },
                            {
                                "example_id": "f2204d77-402f-4460-b5f8-8139eead674b",
                                "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                "text": "„Die Abschiedsvorlesung des Wirtschaftswissenschaftlers Bert Rürup an der Technischen Universität (TU) Darmstadt ist am Donnerstag wegen eines anhaltenden Pfeifkonzerts Protestierender abgebrochen worden.“"
                            },
                            {
                                "example_id": "919fb0e9-6ad8-4d26-8762-a578e132052d",
                                "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                "text": "„Mehr als hunderttausend Protestierende haben am Samstag eine 120 Kilometer lange Menschenkette zwischen den AKW Krümmel und Brunsbüttel gebildet.“"
                            },
                            {
                                "example_id": "62d172b3-9672-4dd5-9afc-fb81acc231d4",
                                "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                "text": "„Hunderte Demonstranten waren den schon seit Wochen vor dem Kabinettsgebäude Protestierenden zu Hilfe geeilt, als diese sich mit der Militärpolizei Straßenkämpfe lieferten.“"
                            },
                            {
                                "example_id": "d45b4a47-e102-4799-8147-fcbf0faf5d43",
                                "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                "text": "„Manche der Protestierenden sind zu langsam oder haben keine Gasmasken, eine Frau liegt röchelnd auf dem nassen Pflaster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
