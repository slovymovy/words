{
    "word_family": [
        "sneezing",
        "sneezed",
        "sneeziness",
        "sneezer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bd73396-e523-3104-a961-9aeb16270f4b",
                    "sense_definition": "To suddenly and uncontrollably expel air through the nose and mouth due to irritation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bodily_functions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dust in the old attic made me <w>sneeze</w> several times while I was cleaning.",
                            "target_lang_translations": {
                                "ru": "Пыль на старом чердаке заставила меня несколько раз <w>чихнуть</w> во время уборки."
                            }
                        },
                        {
                            "text": "To avoid passing on your illness, you should <w>sneeze</w> into your sleeve or a tissue.",
                            "target_lang_translations": {
                                "ru": "Чтобы не передать болезнь другим, следует <w>чихать</w> в рукав или в салфетку."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "sneeze into your sleeve",
                        "make someone sneeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно и непроизвольно выдыхать воздух через нос и рот из-за раздражения слизистой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чихать",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "чихнуть",
                                "target_lang_sense_clarification": "однократное действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5866b6c-8baf-30e1-87bd-8330a7a9bd81",
                    "sense_definition": "To expel something, such as mucus or a foreign object, from the nose or mouth by sneezing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bodily_functions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat <w>sneezed</w> a small blade of grass out of its nose after playing in the garden.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>вычихала</w> маленькую травинку из носа после игры в саду."
                            }
                        },
                        {
                            "text": "Toothless <w>sneezed</w> a large amount of dragon snot right in the boy's face.",
                            "target_lang_translations": {
                                "ru": "Беззубик <w>чихнул</w> огромным количеством драконьих соплей прямо в лицо мальчику."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sneeze out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выталкивать что-либо (например, слизь или инородное тело) из носа или рта при чихании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычихать",
                                "target_lang_sense_clarification": "удалить что-то из носа чиханием"
                            },
                            {
                                "target_lang_word": "чихнуть",
                                "target_lang_sense_clarification": "в контексте выбрасывания чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5904bf2c-9f4c-3974-b188-26d4c07ef267",
                    "sense_definition": "A single act or the sound of expelling air through the nose and mouth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bodily_functions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jared's hay fever gives him terrible <w>sneezes</w> every time he goes outside in the spring.",
                            "target_lang_translations": {
                                "ru": "Из-за сенной лихорадки у Джареда начинается ужасное <w>чихание</w> каждый раз, когда он выходит на улицу весной."
                            }
                        },
                        {
                            "text": "A loud <w>sneeze</w> echoed through the quiet library, making everyone look up from their books.",
                            "target_lang_translations": {
                                "ru": "Громкий <w>чих</w> эхом разнесся по тихой библиотеке, заставив всех оторваться от книг."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "stifle a sneeze",
                        "loud sneeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Однократный акт или звук резкого выдоха через нос и рот."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чихание",
                                "target_lang_sense_clarification": "процесс или звук"
                            },
                            {
                                "target_lang_word": "чих",
                                "target_lang_sense_clarification": "разговорное, один акт"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}