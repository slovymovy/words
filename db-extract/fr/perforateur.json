                    }
                ],
                "senses": [
                    {
                        "sense_id": "54e9923c-12d7-3ccd-b908-ead520b5fba3",
                        "entry_id": "1bcc1a7b-00c7-3012-883b-1fb6056ce6ab",
                        "glosses": [
                            "Machine électroportative qui sert à percer des trous dans les matériaux durs tels que le béton ou la pierre en utilisant la technique de la percussion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f61fea-933a-4eaa-9a51-35831daff6da",
                                "sense_id": "54e9923c-12d7-3ccd-b908-ead520b5fba3",
                                "text": "Utilisez un perforateur équipé d’une mèche à béton pour réaliser le perçage des trous de fixation du faux limon appelé à supporter les marches de l’escalier."
                            }
                        ]
                    },
                    {
                        "sense_id": "8184a58b-02c9-3b90-b6b2-26e769a3ebfc",
                        "entry_id": "1bcc1a7b-00c7-3012-883b-1fb6056ce6ab",
                        "glosses": [
                            "Ouvrier préposé au maniement d’un outil ou d’une machine qui perfore."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad9c6f4f-b740-4dc0-9786-d9b68b192c6d",
                        "source_entry_id": "1bcc1a7b-00c7-3012-883b-1fb6056ce6ab",
                        "source_sense_id": "54e9923c-12d7-3ccd-b908-ead520b5fba3",
                        "source_sense_description": "Machine",
                        "target_lang_word": "Bohrhammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bohrhammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36eeee7f-b572-308c-a68a-374777c4cb29",
                                        "entry_id": "18c6eafa-e739-33d7-a314-dd789a476da4",
                                        "glosses": [
                                            "Elektrowerkzeug zum Setzen von Bohrlöchern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739afe61-081b-4df6-95a9-10be90208b62",
                                                "sense_id": "36eeee7f-b572-308c-a68a-374777c4cb29",
                                                "text": "Im Vergleich zur Schlagbohrmaschine hat der Bohrhammer eine niedrigere Schlagzahl bei wesentlich höherer Schlagenergie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92439eed-6417-4815-833f-d23f4426e28d",
                        "source_entry_id": "1bcc1a7b-00c7-3012-883b-1fb6056ce6ab",
                        "source_sense_id": "54e9923c-12d7-3ccd-b908-ead520b5fba3",
                        "source_sense_description": "Machine",
                        "target_lang_word": "перфоратор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "перфоратор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "82868373-4722-3c15-b88d-3021bb768d0d",
                                        "entry_id": "f25eaebf-de3f-3a59-b508-91f41c6b2a99",
                                        "glosses": [
                                            "спец. строит., горн. инструмент для сверления, в котором вращение сверла обеспечивается ударным воздействием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c61ec5-4312-4375-99d8-78f5fd35a3ae",
                                                "sense_id": "82868373-4722-3c15-b88d-3021bb768d0d",
                                                "text": "В течение первых двух часов все эти груды исчезали, поднятые лебедкой наверх, дно шахты становилось более или менее ровным, и на нем устанавливались перфораторы, которые в течение остального времени выбуривали необходимое количество шпуров, пока остальные рабочие доканчивали уборку обломков и выравнивание стен."
                                            },
                                            {
                                                "example_id": "51e58fd0-096f-432c-9005-b9b50237ab11",
                                                "sense_id": "82868373-4722-3c15-b88d-3021bb768d0d",
                                                "text": "Затем перфораторы поднимались на платформу, шпуры заряжались динамитом, и рабочие, закончив свою смену, выходили из шахты."
                                            },
                                            {
                                                "example_id": "894cdd63-85b9-4d11-ab2b-f23018f4c22f",
                                                "sense_id": "82868373-4722-3c15-b88d-3021bb768d0d",
                                                "text": "Не только перевела свою бригаду с кайлы на перфораторы, но съездила в Москву и добилась там угольного комбайна."
                                            },
                                            {
                                                "example_id": "7448db80-d495-4f0d-88b3-de0269be9721",
                                                "sense_id": "82868373-4722-3c15-b88d-3021bb768d0d",
                                                "text": "Для производства разведки и разминирования городов инженерные части должны иметь следующее оснащение: миноискатели обычные и высокой чувствительности, стетоскопы, щупы, комплекты для бурения скважин на глубину до 8 м; электрофонари (аккумуляторные), электроосветительные станции 1.5-3 квт; мотопомпы, диафрагмовые насосы, веревки, лопаты, ломы, шлямбуры, перфораторы, электросверла по камню и дереву, автоген, лебедки 1.5 т."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2593512-3ea8-3553-bcb8-41d217384c7f",
                                        "entry_id": "f25eaebf-de3f-3a59-b508-91f41c6b2a99",
                                        "glosses": [
                                            "устар. комп., информ. устройство для записи информации в виде отверстий на бумажной ленте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ad6820-8f1c-4fe8-aed7-03b0fb39579f",
                                                "sense_id": "e2593512-3ea8-3553-bcb8-41d217384c7f",
                                                "text": "В частности, он разработал удобный клавишный перфоратор и автоматизировал процедуры подачи и сортировки перфокарт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe518bd5-4cb3-3d4b-9d9d-e86043f4c49c",
                                        "entry_id": "f25eaebf-de3f-3a59-b508-91f41c6b2a99",
                                        "glosses": [
                                            "устар. устройство для формирования вспышки света в кинопроекторе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79f8d22d-f61b-425e-989f-688145b6eec3",
                                                "sense_id": "fe518bd5-4cb3-3d4b-9d9d-e86043f4c49c",
                                                "text": "Нельзя не заметить, что введение ◆ перфорации (прерывания) света имеет один существенный недочет: уменьшается общая экспозиция передачи изображения, уменьшается время действия света ровно вдвое ― половина света проходит к изображению через окошечки перфоратора, а половина задерживается, так как расстояния между окошечками диска-прерывателя равны в точности ширине самих окошечек."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6395936d-218f-31c2-8de4-0f4b8fc00de8",
                                        "entry_id": "f25eaebf-de3f-3a59-b508-91f41c6b2a99",
                                        "glosses": [
                                            "горн. устройство для разрушения каменной породы, формирования каналов в породе, прочистки каналов скважин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "540c7dea-4eec-4ab2-a66d-651a72623429",
                                                "sense_id": "6395936d-218f-31c2-8de4-0f4b8fc00de8",
                                                "text": "Вскрытие угольных пластов производилось кумулятивными перфораторами типа ПР-54 с плотностью отверстий 30 отв."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a4e765f-1b98-3ee2-8449-a13f287887e3",
                                        "entry_id": "f25eaebf-de3f-3a59-b508-91f41c6b2a99",
                                        "glosses": [
                                            "то же, что туннельный проходчик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d76b31cb-9d2c-4edf-a833-200cfd06adca",
                                                "sense_id": "8a4e765f-1b98-3ee2-8449-a13f287887e3",
                                                "text": "Работа заспорилась, когда был использован перфоратор, сконструированный английским полковником Фредериком Бьюмонтом."
                                            },
                                            {
                                                "example_id": "f0256206-8d1a-4fe2-a64c-3a804c7ae3f5",
                                                "sense_id": "8a4e765f-1b98-3ee2-8449-a13f287887e3",
                                                "text": "(Этот перфоратор теперь известен как первый в мире туннельный проходчик."
                                            },
                                            {
                                                "example_id": "6d3b57cf-c543-4f44-af53-85f35772b0fb",
                                                "sense_id": "8a4e765f-1b98-3ee2-8449-a13f287887e3",
                                                "text": "Усовершенствованный перфоратор Уайтекра, подобно «машине Бьюмонта», был покинут в пласте мела."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
