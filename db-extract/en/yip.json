                    },
                    {
                        "translation_id": "91eb7c96-4f3a-48a2-a39f-9256fcbbdde2",
                        "source_entry_id": "5f4c2f07-19eb-3e37-96ed-bf0927917458",
                        "source_sense_id": "fa03bc21-7dfd-3db9-8b8a-935f57806d3f",
                        "source_sense_description": "sound a small dog makes",
                        "target_lang_word": "Bellen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bellen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ec22fe-6819-3bf3-adf9-31d2d1cdfbcb",
                                        "entry_id": "36572543-66b4-3f11-bbb6-c6e34f54535c",
                                        "glosses": [
                                            "bellendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7be39343-4590-46e5-b71d-285fbe09927d",
                                                "sense_id": "e3ec22fe-6819-3bf3-adf9-31d2d1cdfbcb",
                                                "text": "„Über dem unablässigen Bellen der eingesperrten Pitbulls waren die murmelnden Stimmen der Hundebesitzer zu hören.“"
                                            },
                                            {
                                                "example_id": "f5474ce8-ec45-4056-b11d-6bca7be8f89b",
                                                "sense_id": "e3ec22fe-6819-3bf3-adf9-31d2d1cdfbcb",
                                                "text": "„Er verdrehte die Augen, dorthin, wo das Bellen war, die Hunde, und ich sagte mir, er will mich beschützen.“"
                                            },
                                            {
                                                "example_id": "a05c1535-21f5-4ba2-bb5f-35732f53b1ab",
                                                "sense_id": "e3ec22fe-6819-3bf3-adf9-31d2d1cdfbcb",
                                                "text": "„Völlig ohne Vorwarnung - kein Bellen von Mutt, kein Knarren der Tür - ragt sie plötzlich über mir auf, wie ein Riese mit Lippenstift.“"
                                            },
                                            {
                                                "example_id": "b1efb285-bbae-4c92-b515-53bbb06b4738",
                                                "sense_id": "e3ec22fe-6819-3bf3-adf9-31d2d1cdfbcb",
                                                "text": "„Er lacht erneut. Es klingt wie das Bellen eines Hundes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
