                        "glosses": [
                            "Rendre élémentaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d698cc9-c47c-4e2a-8717-9de40add8644",
                                "sense_id": "175e666e-4629-3649-a612-a04694401246",
                                "text": "Ce type de société a en conséquence choisi, pour rendre plus productives les opérations de la production, de les diviser toujours davantage, de les élémentariser."
                            },
                            {
                                "example_id": "58ec67f9-80c0-4d88-816c-8a144a08275f",
                                "sense_id": "175e666e-4629-3649-a612-a04694401246",
                                "text": "Plus précisément, deux malentendus possibles sur ce souci d’élémentariser, dans un premier temps, le questionnement éthique doivent être d’emblée écartés."
                            }
                        ]
