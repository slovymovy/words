                            {
                                "example_id": "21d4396c-b276-4cd0-91d6-3d8f9e443f81",
                                "sense_id": "67a954f8-c267-395a-86b0-a0b18de3b151",
                                "text": "„Am Kontrollposten stand ein Mann, ein älterer Zivilist, und hielt die israelische Fahne hoch.“"
                            },
                            {
                                "example_id": "3178e772-7ca5-4246-8a1e-f160cf73d80a",
                                "sense_id": "67a954f8-c267-395a-86b0-a0b18de3b151",
                                "text": "„Wir durften uns nun bis zum 500 Meter entfernten Kontrollposten bewegen – aber nur in einem Auto.“"
                            }
                        ],
