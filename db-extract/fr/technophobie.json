                "senses": [
                    {
                        "sense_id": "5ad289c6-9ad8-365c-92c4-db323fa284ce",
                        "entry_id": "029ac7b8-456e-3a44-a056-5ac0a163dc68",
                        "glosses": [
                            "Phobie de la technologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66a2f76a-8402-49c7-8b5a-249185c443bc",
                                "sense_id": "5ad289c6-9ad8-365c-92c4-db323fa284ce",
                                "text": "Rien n’est plus éloigné de l’idéal républicain que la technophobie ambiante."
                            },
                            {
                                "example_id": "731a36ca-5ab3-4d01-8160-71b241967ee4",
                                "sense_id": "5ad289c6-9ad8-365c-92c4-db323fa284ce",
                                "text": "Autrement dit, il faut décoloniser l’école des écrans. Non par bête technophobie. Nous ne sommes pas des luddites."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac7bf980-52b8-4c02-ba06-011077fe84ff",
                        "source_entry_id": "029ac7b8-456e-3a44-a056-5ac0a163dc68",
                        "source_sense_id": "5ad289c6-9ad8-365c-92c4-db323fa284ce",
                        "target_lang_word": "technophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b5fd5c9-73bf-362d-a100-10f3a4bd3d7a",
                                        "entry_id": "2dd654a0-fa82-3401-9c5e-2f2cca9450d8",
                                        "glosses": [
                                            "A fear of new technologies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2e35c0b-d07c-40d3-972c-132b6bfcaa6d",
                                                "sense_id": "9b5fd5c9-73bf-362d-a100-10f3a4bd3d7a",
                                                "text": "Near-synonym: cyberphobia"
                                            },
                                            {
                                                "example_id": "6e83dccf-e764-426d-a20c-6f45a5d6c7cb",
                                                "sense_id": "9b5fd5c9-73bf-362d-a100-10f3a4bd3d7a",
                                                "text": "But on one major point, neo-Luddites agree: They would loathe computerization even if hordes of unwitting neo-Luddites hadn't suddenly made technophobia so trendy."
                                            },
                                            {
                                                "example_id": "6d8f2335-fab0-49df-8bb9-536b60b1f33f",
                                                "sense_id": "9b5fd5c9-73bf-362d-a100-10f3a4bd3d7a",
                                                "text": "I learned that, as Jane approached discharge, I would attend pump class, to learn how to program pumps in our apartment and infuse Jane with water, food, and drugs. My technophobia covered its eyes."
                                            }
                                        ]
                                    }
                                ]
                            }
