                "senses": [
                    {
                        "sense_id": "ff5c2062-51c6-320b-be51-4e4e4b76c347",
                        "entry_id": "1084e57c-1f64-3f97-9aac-67cab76bc01c",
                        "glosses": [
                            "Qui utilise des arguments brutaux et expéditifs, sans prêter à la discussion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e9694b-d518-4296-a516-dee2a6856b31",
                                "sense_id": "ff5c2062-51c6-320b-be51-4e4e4b76c347",
                                "text": "Piaffant et empanaché, il décochait des traits ironiques au vétérinaire, se montrait galant avec sa belle-sœur, jouait avec les enfants, donnait de la voix, riait et redonnait, avec des airs sabreurs de proclamer un gouvernement provisoire de vin et de racaille."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a0171058-02bb-350a-aa6b-4f7358e5fe7d",
