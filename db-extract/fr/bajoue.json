                    {
                        "translation_id": "75333773-ac4b-453c-a54a-53e5ee8e66e3",
                        "source_entry_id": "4a8b8124-0d6a-32bd-b17a-5406e3d9e73b",
                        "source_sense_description": "Grosse joue",
