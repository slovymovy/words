                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "748926e9-3224-3b46-8513-805e45a02656",
                                        "entry_id": "910f0945-0e06-3a8a-9a5d-100e466d303e",
                                        "glosses": [
                                            "Capitale de l’Arabie saoudite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ab055a-a48b-47bb-8993-e74a20a69095",
                                                "sense_id": "748926e9-3224-3b46-8513-805e45a02656",
                                                "text": "Samedi, les forces de défense aériennes ont déjoué une attaque au missile contre la capitale de l’Arabie saoudite, Riyad, et intercepté des drones lancés par les Houthis contre le sud du royaume, ont indiqué les autorités."
                                            },
                                            {
                                                "example_id": "0c99308f-fed4-409d-81dd-97809cbbcfa5",
                                                "sense_id": "748926e9-3224-3b46-8513-805e45a02656",
                                                "text": "On peut désormais obtenir un e-visa en moins de 24h, et s’y rendre facilement grâce aux vols directs Paris-Riyad, Paris-Djeddah ou Marseille-Djeddah."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad5f788a-07e5-3541-bd08-4cf21ce8fe6d",
                                        "entry_id": "910f0945-0e06-3a8a-9a5d-100e466d303e",
                                        "glosses": [
                                            "Le gouvernement saoudien."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9717965e-080d-44e2-942d-a0c7c56e3692",
                                                "sense_id": "ad5f788a-07e5-3541-bd08-4cf21ce8fe6d",
                                                "text": "Briller à Paris pour emmouscailler Riyad et Le Caire, ce n’est plus foot, c’est du billard !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
