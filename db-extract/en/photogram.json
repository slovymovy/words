                ],
                "translations": [
                    {
                        "translation_id": "fcd00fb1-4c83-4b82-85dd-1e189da26c5a",
                        "source_entry_id": "aef5a4b8-b360-3a17-ab07-ce117964be89",
                        "source_sense_id": "17403295-fd5e-3eb1-99ee-ca01a87e003a",
                        "source_sense_description": "a photograph made without using a camera",
                        "target_lang_word": "photogramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "236cc772-5fc5-3211-ae17-a1d32f53f480",
                                        "entry_id": "e5390349-80c9-3bbf-b822-acc7efcbd5ee",
                                        "glosses": [
                                            "Chacune des images d’un film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fad486e-2b17-42e4-b448-2aa7df070d90",
                                                "sense_id": "236cc772-5fc5-3211-ae17-a1d32f53f480",
                                                "text": "Un film déroule généralement 24 photogrammes par seconde, moins pour les dessins animés, davantage pour les ShowScan."
                                            },
                                            {
                                                "example_id": "75d4b7ef-2377-48a3-890e-e0e0aff5a3fe",
                                                "sense_id": "236cc772-5fc5-3211-ae17-a1d32f53f480",
                                                "text": "Gonzalo avait scruté chaque photogramme, en effet, obsédé par l’idée de retrouver l’ordinateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b90b776-e303-3e38-ac99-a919925e479c",
                                        "entry_id": "e5390349-80c9-3bbf-b822-acc7efcbd5ee",
                                        "glosses": [
                                            "Image photographique obtenue sans emploi d’objectif en plaçant un objet devant ou sur un papier photographique sensible et en éclairant l’ensemble d’une lumière orientée ou modulée → voir photocalque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f30b2d-7af7-45a4-8106-6c2485586d4d",
                                                "sense_id": "9b90b776-e303-3e38-ac99-a919925e479c",
                                                "text": "Les photogrammes de Moholy Nagy et de Man Ray."
                                            },
                                            {
                                                "example_id": "16bd67c7-59ff-4246-8d86-14dc99cbe2ea",
                                                "sense_id": "9b90b776-e303-3e38-ac99-a919925e479c",
                                                "text": "En 1803, Wedgwood […] obtint la silhouette de feuilles d’arbre et de dentelles après les avoir placées sur un papier sensibilisé ; il aurait même réussi à copier une gravure par transparence. Cependant ces images étaient fugitives : une forte lumière les effaçait. On peut aujourd’hui fixer ces images que l’on nomme communément des photogrammes (le peintre photographe Man Ray en fit de nombreuses)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f0b0110-3412-34a1-9802-282b720aa07d",
                                        "entry_id": "e5390349-80c9-3bbf-b822-acc7efcbd5ee",
                                        "glosses": [
                                            "Photographie produite par une chambre métrique, permettant d’effectuer des mesures précises."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7a6946d-7508-4709-a86d-73df6423bee6",
                                                "sense_id": "5f0b0110-3412-34a1-9802-282b720aa07d",
                                                "text": "Sur la détermination, d’après un photogramme, du point principal et de la distance de l’image."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
