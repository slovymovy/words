                        "glosses": [
                            "Eau-de-vie obtenue après une longue fermentation (jusqu’à huit jours) du jus de canne à sucre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f9b5ce8-9136-4157-b1ef-91a20aecd99d",
                                "sense_id": "6d7876e4-aeaf-364c-b807-94312545cee1",
                                "text": "Le clairin est un rhum peu raffiné, très fort, d’usage dans les campagnes haïtiennes, et appelé « sans réduit » dans les autres Antilles françaises."
                            },
                            {
                                "example_id": "5305ff06-57b1-4612-8c1c-f76c1311f879",
                                "sense_id": "6d7876e4-aeaf-364c-b807-94312545cee1",
                                "text": "Parfois, nous regagnons l’intérieur de la maison, assistons aux allées et venues d’Armelle, de Fréda et des adultes, à la visite des clients qui achètent du clairin et qui le boivent d’un coup sec."
                            }
                        ]
