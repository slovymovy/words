                                        "glosses": [
                                            "One who ideates; one who holds or generates an idea, or synthesizes a concept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7332a3e9-0983-4747-8fe4-d60cab4b2655",
                                                "sense_id": "ed71f0fb-5ef6-35a1-9788-01a8ecf9826c",
                                                "text": "The fact that in the lowly forms of life the function greatly exceeds the form in complexity shows conclusively that there is an inner entity synthesizing these functions, and that evolution in all its phases is but the outer response to the inner idea, and, as ideas necessitate an ideator, an inner entity is therefore necessitated."
                                            },
                                            {
                                                "example_id": "19da9d48-1387-4a01-814f-28ceeea287d6",
                                                "sense_id": "ed71f0fb-5ef6-35a1-9788-01a8ecf9826c",
                                                "text": "Active suicidal ideators were defined as people who were seriously thinking, planning, or wishing to commit suicide."
                                            }
