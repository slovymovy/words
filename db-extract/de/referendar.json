                        "entry_id": "bae6bd34-c911-3c7e-83ca-caff8dafdd55",
                        "glosses": [
                            "Beamtenanwärter, jemand, der in Deutschland das 1. Staatsexamen bestanden hat (für eine Laufbahn im höheren Dienst)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80117d2f-9d12-403e-9cd3-a4dc58100190",
                                "sense_id": "4498eb9f-1c9e-36cd-b70b-26208df47465",
                                "text": "„Dauerte es früher ein halbes Jahr, bis Referendare allein vor der Klasse standen, blieb ihr nur eine Einführungsphase von drei Monaten.“"
                            },
                            {
                                "example_id": "15420d58-bf0a-46f4-ae63-3bda18254ba3",
                                "sense_id": "4498eb9f-1c9e-36cd-b70b-26208df47465",
                                "text": "Das Lehrbuch richtet sich an Referendare, die sich auf das zweite juristische Staatsexamen vorbereiten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
