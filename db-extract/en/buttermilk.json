                        "translation_id": "88578d88-67b1-4aa2-9acb-8450c119b0ea",
                        "source_entry_id": "55bf682f-38a7-3091-81b0-a0857aeb142c",
                        "source_sense_description": "traditional buttermilk",
                        "target_lang_word": "podmáslí",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "podmáslí",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3cd90dae-9516-3d15-ae9d-c4119c3701df",
                                        "entry_id": "61f91092-7ea1-311c-b616-4df967767b55",
                                        "glosses": [
                                            "nakyslý mléčný produkt zbylý ze smetany po stloukání másla"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a8e0af-b8a5-471b-bf70-4f7e3a6b6814",
                                                "sense_id": "3cd90dae-9516-3d15-ae9d-c4119c3701df",
                                                "text": "Pravé podmáslí je bílá, lahodná, velmi výživná, osvěžující tekutina zbylá ze sladké nebo kyselé smetany po stloukání másla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "405a8dd9-5c91-381d-bd1b-bc382bea1464",
                                        "entry_id": "61f91092-7ea1-311c-b616-4df967767b55",
                                        "glosses": [
                                            "(též šlehané či kysané) nakyslý mléčný produkt vyráběný kvašením mléka příp. smíchaného s pravým podmáslím [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65bcf404-3e52-4b7d-bfb4-19ff189e3ae3",
                                                "sense_id": "405a8dd9-5c91-381d-bd1b-bc382bea1464",
                                                "text": "Šlehané podmáslí se vyrábí z pasterizovaného mléka, které se zakyše kvasinkami smetanového zákysu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
