                "senses": [
                    {
                        "sense_id": "f55611a6-6249-36a1-b9dd-ab926fc42cca",
                        "entry_id": "dd91af03-ab80-3e36-97d4-713ebe0a07dd",
                        "glosses": [
                            "Enlever le badigeon qui couvre une surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a75a1057-cf07-4cc8-aaf2-15703c09d709",
                                "sense_id": "f55611a6-6249-36a1-b9dd-ab926fc42cca",
                                "text": "En principe, lorsqu’on attaquera une voûte pour la débadigeonner et qu’on trouvera des peintures sous le badigeon, il faudra continuer l’opération, parce que l’on ne rencontrera pas les inconvéniens qui se sont présentés à Notre-Dame de Paris."
                            },
                            {
                                "example_id": "26fa325e-5a4e-4df1-a1c4-1cd0e556b89a",
                                "sense_id": "f55611a6-6249-36a1-b9dd-ab926fc42cca",
                                "text": "Il serait bon que MM. les marguilliers fissent débadigeonner le sanctuaire et les chapiteaux des nefs."
                            }
                        ]
                    }
                ],
