                        "source_sense_id": "db60caea-804f-3259-b7c6-34855a816910",
                        "target_lang_word": "maplewashing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maplewashing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49b97afc-f28f-3cf1-8bd2-c0701bf0a0ed",
                                        "entry_id": "b08d46ff-7467-33ea-88b8-e00e3d5c5947",
                                        "glosses": [
                                            "The tendency for Canada and its history, culture, and politics to be idealized or sanitized, especially in relation to its neighbour the United States."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3caa4556-7663-4e86-aba0-c1b69a33b828",
                                                "sense_id": "49b97afc-f28f-3cf1-8bd2-c0701bf0a0ed",
                                                "text": "Luke Savage is a Toronto writer and producer with the Broadbent Institute. He says \"maple washing\" needs to end."
                                            },
                                            {
                                                "example_id": "94abded5-a23f-48bd-b4b6-61d7157d80d1",
                                                "sense_id": "49b97afc-f28f-3cf1-8bd2-c0701bf0a0ed",
                                                "text": "The 2016 election provided an especially becoming foil for Canada, whose history of \"maple-washing\"–sweeping unsavory aspects of its history and culture, like settler colonialism and genocide against Indigenous peoples, under the rug–was widespread even before such a handy distraction."
                                            },
                                            {
                                                "example_id": "9f6be75d-19a0-4a8e-97ce-c8bfc6ed1642",
                                                "sense_id": "49b97afc-f28f-3cf1-8bd2-c0701bf0a0ed",
                                                "text": "New stories are told to highlight the gaps, now visible, in settler narratives concerning photography’s extractive tendency and the role tourism plays in perpetuating what is increasingly called ‘maplewashing’, attempts to whitewash the settler history of what is now Canada."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
