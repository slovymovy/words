                    {
                        "translation_id": "21a9c602-a1fd-4506-8557-c366fc4b53aa",
                        "source_entry_id": "c1e9394c-d2ea-3c67-beb8-b12a864737b2",
                        "source_sense_description": "pertaining to a symbol",
                        "target_lang_word": "symbolique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symbolique",
