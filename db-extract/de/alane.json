                        "examples": [
                            {
                                "example_id": "a2e3bc6e-8e9e-4960-8f8d-2766ca1647ed",
                                "sense_id": "6aa7cf70-30ea-3b62-af70-4604eff465e6",
                                "text": "Die Alanen waren ein Reitervolk, das ursprünglich halbnomadisch als Viehhirten in den südrussischen Steppen lebte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
