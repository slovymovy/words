                                        "sense_id": "e709ccf8-5347-39bc-8518-58b3b68de768",
                                        "entry_id": "426e106a-2478-3f5a-8a08-a40f1fd5f955",
                                        "glosses": [
                                            "Extreme aversion or detestation; the feeling of utter dislike or loathing."
                                        ],
                                        "tags": [
