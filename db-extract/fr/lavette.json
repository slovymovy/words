                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a70c9dd0-5393-497d-9972-de7836cb4241",
                                                "sense_id": "7c3f3f8a-4b8e-3355-b17a-aa7ae7c9653f",
                                                "text": "Vezmi si hadr a utři prach."
                                            },
                                            {
                                                "example_id": "4f5ef7e6-d00f-45e8-bf16-3dc45b303142",
                                                "sense_id": "7c3f3f8a-4b8e-3355-b17a-aa7ae7c9653f",
                                                "text": "Mop už pomalu nahrazuje klasické hadry na podlahu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e0d2bfc-6867-37e6-ae85-a96045fa05d9",
                                        "entry_id": "f831321a-25cf-3bd3-bfd9-26f5661215e6",
                                        "glosses": [
                                            "(v jednotném čísle neobvyklé) oblečení"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "103ce464-8f5f-4ec8-aba7-111312ad1450",
                                                "sense_id": "4e0d2bfc-6867-37e6-ae85-a96045fa05d9",
                                                "text": "Jela si koupit nějaké hadry na sebe."
                                            },
                                            {
                                                "example_id": "0c1050ac-bd88-425c-81d7-a945420e86a2",
                                                "sense_id": "4e0d2bfc-6867-37e6-ae85-a96045fa05d9",
                                                "text": "Za živý svět nechtěl se do „panského hadru“ obléci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c9727e6-f501-3418-8a8a-0e75f3bcac19",
                                        "entry_id": "f831321a-25cf-3bd3-bfd9-26f5661215e6",
                                        "glosses": [
                                            "pevný disk"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a79d85c-e8a7-4bb1-a460-38ede3e40c40",
                                                "sense_id": "2c9727e6-f501-3418-8a8a-0e75f3bcac19",
                                                "text": "Spadl mi notebook ze stolu na podlahu a odešel mi kvůli tomu hadr."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be270c58-508c-34d8-98d2-e304d14eec68",
                                        "entry_id": "f831321a-25cf-3bd3-bfd9-26f5661215e6",
                                        "glosses": [
                                            "(zastarávajícně, zpravidla v množném čísle) tisíc korun"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17d5d48f-7a15-44b7-8dfc-5d5dab371cc6",
                                                "sense_id": "be270c58-508c-34d8-98d2-e304d14eec68",
                                                "text": "Co Ty na ty boty? ty přímo žadonily o koupi! – To teda, kdo by si je za tři hadry nekoupil, tak ten by prohloupil! – Přesně!"
                                            },
                                            {
                                                "example_id": "5b7881ab-7903-467d-b03b-00cec13409b3",
                                                "sense_id": "be270c58-508c-34d8-98d2-e304d14eec68",
                                                "text": "Pořídím si boty za čtyři hadry a pak budu taky dobrej skinhead!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9442437e-9dd8-38ea-b336-a50f1ece0acb",
                                        "entry_id": "f831321a-25cf-3bd3-bfd9-26f5661215e6",
                                        "glosses": [
                                            "srovnání, že něco je téměř nic oproti jiné věci"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b28c8f0-bfef-4d7d-822d-ce048052eca6",
                                                "sense_id": "9442437e-9dd8-38ea-b336-a50f1ece0acb",
                                                "text": "Teda ty tu máš ale binec. Hirošima hadr."
                                            }
                                        ]
                                    }
                                ]
