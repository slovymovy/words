                                "sense_id": "b9e9f622-2d8c-32d1-bd52-2d1f5be2e72b",
                                "text": "De cameraploeg was druk bezig met het filmen van de scène.",
                                "translation": "The film crew was busy filming the scene.",
                                "english": "The film crew was busy filming the scene."
                            },
                            {
                                "example_id": "3b6c0877-39d7-4c78-91e5-b9b95f2ea5b3",
                                "sense_id": "b9e9f622-2d8c-32d1-bd52-2d1f5be2e72b",
                                "text": "De regisseur gaf instructies aan de cameraploeg voor de volgende opname.",
                                "translation": "The director gave instructions to the film crew for the next shot.",
                                "english": "The director gave instructions to the film crew for the next shot."
                            },
                            {
