                    {
                        "sense_id": "234334d7-630a-332f-87a3-8afdf56c78c9",
                        "entry_id": "6447aeac-57c0-3497-bb86-b0251c81c70e",
                        "glosses": [
                            "To remove a checkmark."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "e00abe36-d741-490d-b847-84d0079b3c95",
                                "sense_id": "234334d7-630a-332f-87a3-8afdf56c78c9",
                                "text": "Uncheck the “save my password” box."
                            },
                            {
                                "example_id": "55bce321-d553-4f71-a3ab-eeba2fd64aa5",
                                "sense_id": "234334d7-630a-332f-87a3-8afdf56c78c9",
                                "text": "If you uncheck either of these check boxes, [Microsoft] Expression Web 2 will create all new Web pages with uppercase tag names and/or attributes. Current Web standards require that HTML tag names and attributes be lowercase. Therefore, pages created with either of these boxes unchecked will not be compatible with existing standards."
                            }
                        ]
                    },
                    {
                        "sense_id": "42dfafc2-d400-39e0-aec5-250102dcdf93",
                        "entry_id": "6447aeac-57c0-3497-bb86-b0251c81c70e",
                        "glosses": [
                            "To remove a previously checked-in passenger from the check-in system, allowing changes to the ticket."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9de3eab8-e236-4c29-b159-d1d0a8881422",
