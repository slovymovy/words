{
    "word_family": [
        "haat",
        "hater",
        "haatdragend",
        "haatzaaien",
        "verafschuwen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "392c611f-2098-3e6e-b657-3574bf12d3f3",
                    "sense_definition": "een diepe vijandigheid of kwade gevoelens jegens iemand koesteren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was gemakkelijk om de vijand te <w>haten</w> na alles wat er was gebeurd.",
                            "target_lang_translations": {
                                "en": "It was easy to <w>hate</w> the enemy after everything that had happened.",
                                "ru": "Было легко <w>ненавидеть</w> врага после всего, что произошло."
                            }
                        },
                        {
                            "text": "Zij <w>haat</w> haar ex-man nog steeds om wat hij haar heeft aangedaan.",
                            "target_lang_translations": {
                                "en": "She still <w>hates</w> her ex-husband for what he did to her.",
                                "ru": "Она до сих пор <w>ненавидит</w> своего бывшего мужа за то, что он с ней сделал."
                            }
                        }
                    ],
                    "synonyms": [
                        "verafschuwen",
                        "verachten"
                    ],
                    "antonyms": [
                        "beminnen",
                        "liefhebben",
                        "houden van"
                    ],
                    "common_phrases": [
                        "iemand hartstochtelijk haten",
                        "elkaar haten"
                    ],
                    "target_lang_definitions": {
                        "en": "To harbor deep hostility or evil feelings toward someone",
                        "ru": "испытывать глубокую враждебность или злые чувства по отношению к кому-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hate",
                                "target_lang_sense_clarification": "to feel intense hostility"
                            },
                            {
                                "target_lang_word": "detest",
                                "target_lang_sense_clarification": "to dislike someone intensely"
                            },
                            {
                                "target_lang_word": "loathe",
                                "target_lang_sense_clarification": "to feel extreme disgust or hatred"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ненавидеть",
                                "target_lang_sense_clarification": "испытывать сильную вражду"
                            },
                            {
                                "target_lang_word": "питать ненависть",
                                "target_lang_sense_clarification": "чувствовать глубокую неприязнь"
                            },
                            {
                                "target_lang_word": "презирать",
                                "target_lang_sense_clarification": "относиться с пренебрежением и ненавистью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08d2cb96-6eff-3d8b-a8d5-fc3b7cbf7302",
                    "sense_definition": "een sterke afkeer van iets hebben of ergens een grote hekel aan hebben",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voorkeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>haatte</w> dit soort geklauter en was dolblij toen de rotswand weer overging in sneeuw.",
                            "target_lang_translations": {
                                "en": "I <w>hated</w> this kind of scrambling and was overjoyed when the rock face turned back into snow.",
                                "ru": "Я <w>ненавидел</w> такое карабканье и был вне себя от радости, когда скала снова сменилась снегом."
                            }
                        },
                        {
                            "text": "Veel studenten <w>haten</w> vroege lessen omdat ze liever uitslapen.",
                            "target_lang_translations": {
                                "en": "Many students <w>hate</w> early classes because they prefer to sleep in.",
                                "ru": "Многие студенты <w>ненавидят</w> ранние занятия, потому что предпочитают поспать подольше."
                            }
                        }
                    ],
                    "synonyms": [
                        "verafschuwen",
                        "misgunnen"
                    ],
                    "antonyms": [
                        "waarderen",
                        "genieten van"
                    ],
                    "common_phrases": [
                        "vroege ochtenden haten",
                        "onrecht haten"
                    ],
                    "target_lang_definitions": {
                        "en": "To have a strong aversion to something or to dislike something very much",
                        "ru": "иметь сильное отвращение к чему-либо или очень сильно что-то не любить"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hate",
                                "target_lang_sense_clarification": "to dislike something intensely"
                            },
                            {
                                "target_lang_word": "detest",
                                "target_lang_sense_clarification": "to strongly dislike an activity or thing"
                            },
                            {
                                "target_lang_word": "abhor",
                                "target_lang_sense_clarification": "to find something morally or physically repugnant"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ненавидеть",
                                "target_lang_sense_clarification": "очень сильно не любить что-то"
                            },
                            {
                                "target_lang_word": "терпеть не мочь",
                                "target_lang_sense_clarification": "испытывать крайнее раздражение или неприязнь"
                            },
                            {
                                "target_lang_word": "питать отвращение",
                                "target_lang_sense_clarification": "чувствовать сильную неприязнь к занятию или вещи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
