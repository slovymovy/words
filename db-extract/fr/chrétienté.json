                                    {
                                        "sense_id": "5c816765-83c6-3127-a22c-091d9743feeb",
                                        "entry_id": "d16fbbd1-2d41-3b58-9cd7-480e1cb96ce0",
                                        "glosses": [
                                            "comunidade de cristãos; também indicando a comunidade de todos os cristãos"
                                        ],
                                        "tags": [],
