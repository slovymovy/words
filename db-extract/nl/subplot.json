                "senses": [
                    {
                        "sense_id": "0c3cc9e3-e07f-3cad-8309-e4a5845280b9",
                        "entry_id": "8c9cdc1a-e7be-3fae-90c0-f27ffa647a63",
                        "glosses": [
                            "een ondergeschikte verhaallijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d53f6c1f-d9f0-46be-a5c5-9fe84762cfd1",
                                "sense_id": "0c3cc9e3-e07f-3cad-8309-e4a5845280b9",
                                "text": ",,Bovendien wilde ik slavernij niet als een subplot in mijn film opvoeren. Dat getuigt mijns inziens niet van respect voor een dergelijk belangrijk en beladen onderwerp."
                            },
                            {
                                "example_id": "0f0fd4cf-dd4d-4ffa-91d5-43296c3c8ea7",
                                "sense_id": "0c3cc9e3-e07f-3cad-8309-e4a5845280b9",
                                "text": "De uitgebreide verhaallijn tussen de gevechten door, compleet met subplots en verhaaldraaiingen, zorgen ervoor dat je met alle figuren (en dat zijn er uiteindelijk nogal wat) een band opbouwt. Je hebt enigszins invloed op de loop van sommige, kleinere, verhaallijntjes."
                            },
                            {
                                "example_id": "d1d1c12e-aea2-4746-8e5e-a51acdd56863",
                                "sense_id": "0c3cc9e3-e07f-3cad-8309-e4a5845280b9",
                                "text": "Het romantisch subplotje rond Mortimer en de vrijgevochten Charlotte Dalrymple (Maggie Gyllenhaal) werkt in dit licht slechts als schaamlap voor de smaakvolle onderbroekenlol in Tanya Wexlers gekostumeerde komedie."
                            }
                        ]
                    }
