                    {
                        "sense_id": "6b64d696-ce75-363d-997f-6d189bfd5f57",
                        "entry_id": "cdcf289d-e1e9-3628-a9d0-24146971614a",
                        "glosses": [
                            "Champignon se développant de façon ramifiée, souvent réputés non-comestibles ou comestibles médiocres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79a7a5db-f0fd-4e80-bd0b-86a2a4976036",
                                "sense_id": "6b64d696-ce75-363d-997f-6d189bfd5f57",
                                "text": "En outre, certains champignons d’une même famille peuvent être, selon leur espèce, comestibles ou non : bolets ou amanites, cortinaires, clavaires, etc."
                            },
                            {
                                "example_id": "f6413f24-a0a0-4b4c-89f7-95e0921f4564",
                                "sense_id": "6b64d696-ce75-363d-997f-6d189bfd5f57",
                                "text": "Les clavaires simples sont peu appréciées, bien qu’en général comestibles."
                            },
                            {
                                "example_id": "13157ed7-ddb1-423d-8b65-608ecd2e2f35",
                                "sense_id": "6b64d696-ce75-363d-997f-6d189bfd5f57",
                                "text": "La forêt de Sénart, où j’ai passé une partie de ma jeunesse, à chercher des cèpes et des clavaires, en compagnie de mon père et de Nadar, s’est transformée en une sorte de guinguette semée de « bouchons » sans intérêt."
                            }
                        ]
                    }
                ],
