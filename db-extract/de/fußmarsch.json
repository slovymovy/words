                ],
                "senses": [
                    {
                        "sense_id": "907cf99c-796f-328f-8008-4f56ef5c3fd4",
                        "entry_id": "e199ed5e-7146-3cb6-a943-386c9a08d80d",
                        "glosses": [
                            "Fortbewegung zu Fuß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46bdd22f-d2ff-4b2e-b59a-449ff786df75",
                                "sense_id": "907cf99c-796f-328f-8008-4f56ef5c3fd4",
                                "text": "„Die Felsmalereien lagen etwas abseits, ungefähr zwei Stunden Fußmarsch von Ihiri entfernt in einer wunderschönen, palmenbestandenen Schlucht.“"
                            },
                            {
                                "example_id": "1e8b48df-30b0-4c13-b8db-0fbcd5b29d89",
                                "sense_id": "907cf99c-796f-328f-8008-4f56ef5c3fd4",
                                "text": "„Die einzige Abwechslung bestand in dem längeren Fußmarsch, den man machen musste, um die Einkäufe zu erledigen.“"
                            },
                            {
                                "example_id": "67e800cc-49ff-4406-9e14-018b4b7ef09c",
                                "sense_id": "907cf99c-796f-328f-8008-4f56ef5c3fd4",
                                "text": "„Nach dreistündigem Fußmarsch ließ ich mich zur Erde fallen, weil ich einfach nicht mehr konnte.“"
                            },
                            {
                                "example_id": "aa8a184c-472b-4143-8987-9f5cbcfec1ee",
                                "sense_id": "907cf99c-796f-328f-8008-4f56ef5c3fd4",
                                "text": "„Schließlich gelang dem Rikschafahrer nach mehreren Tagen Fußmarsch die Flucht aus seinem Dorf im Westen seines Heimatlands Myanmar und über die Grenze ins benachbarte Bangladesch.“"
                            },
                            {
                                "example_id": "ed1d5599-617d-4fcb-8b79-4c2274b75a7e",
                                "sense_id": "907cf99c-796f-328f-8008-4f56ef5c3fd4",
                                "text": "„In nächtlichen Fußmärschen erreichten die Flüchtlinge Schweizer Staatsgebiet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
