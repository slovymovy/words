{
    "word_family": [
        "kiedyś",
        "niekiedy"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "737bfeb5-c704-32b2-9036-8cc34870cc19",
                    "sense_definition": "Słowo pytające używane do tworzenia pytań o czas zdarzenia lub sytuacji.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kiedy</w> masz urodziny?",
                            "target_lang_translations": {
                                "ru": "<w>Когда</w> у тебя день рождения?",
                                "de": "<w>Wann</w> hast du Geburtstag?"
                            }
                        },
                        {
                            "text": "Nie wiem, <w>kiedy</w> pociąg przyjedzie na stację.",
                            "target_lang_translations": {
                                "ru": "Я не знаю, <w>когда</w> поезд прибудет на станцию.",
                                "de": "Ich weiß nicht, <w>wann</w> der Zug am Bahnhof ankommt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "od kiedy",
                        "do kiedy",
                        "na kiedy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопросительное слово, используемое для вопросов о времени события или ситуации.",
                        "de": "Fragewort, das verwendet wird, um nach dem Zeitpunkt eines Ereignisses oder einer Situation zu fragen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когда",
                                "target_lang_sense_clarification": "вопросительное наречие"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wann",
                                "target_lang_sense_clarification": "Interrogativadverb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c860f28-39fa-32a0-a4cb-7caabd93b5ca",
                    "sense_definition": "W jakimś nieokreślonym czasie; dawniej lub w przyszłości.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time_indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy widziałeś <w>kiedy</w> tak piękny zachód słońca?",
                            "target_lang_translations": {
                                "ru": "Ты видел <w>когда-нибудь</w> такой красивый закат?",
                                "de": "Hast du <w>jemals</w> einen so schönen Sonnenuntergang gesehen?"
                            }
                        },
                        {
                            "text": "Jeśli <w>kiedy</w> będziesz w pobliżu, koniecznie nas odwiedź.",
                            "target_lang_translations": {
                                "ru": "Если <w>когда-нибудь</w> будешь поблизости, обязательно навести нас.",
                                "de": "Wenn du <w>irgendwann</w> in der Nähe bist, besuche uns unbedingt."
                            }
                        }
                    ],
                    "synonyms": [
                        "kiedyś"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "współcześnie częściej używa się słowa 'kiedyś'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В какое-то неопределенное время; в прошлом или будущем.",
                        "de": "Zu einem unbestimmten Zeitpunkt; früher einmal oder in der Zukunft."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когда-нибудь",
                                "target_lang_sense_clarification": "неопределенное время"
                            },
                            {
                                "target_lang_word": "когда-либо",
                                "target_lang_sense_clarification": "в любой момент времени"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "jemals",
                                "target_lang_sense_clarification": "zu irgendeinem Zeitpunkt"
                            },
                            {
                                "target_lang_word": "irgendwann",
                                "target_lang_sense_clarification": "zu einer unbestimmten Zeit"
                            },
                            {
                                "target_lang_word": "einmal",
                                "target_lang_sense_clarification": "in der Vergangenheit oder Zukunft"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "1cad623d-80d3-399c-aea8-e0297f7b94aa",
                    "sense_definition": "Spójnik łączący zdanie podrzędne, określający czas, w którym odbywa się czynność.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_relative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zadzwoń do mnie, <w>kiedy</w> wrócisz do domu.",
                            "target_lang_translations": {
                                "ru": "Позвони мне, <w>когда</w> вернешься домой.",
                                "de": "Ruf mich an, <w>wenn</w> du nach Hause kommst."
                            }
                        },
                        {
                            "text": "Było już ciemno, <w>kiedy</w> wyszliśmy z kina.",
                            "target_lang_translations": {
                                "ru": "Было уже темно, <w>когда</w> мы вышли из кино.",
                                "de": "Es war schon dunkel, <w>als</w> wir aus dem Kino kamen."
                            }
                        }
                    ],
                    "synonyms": [
                        "gdy",
                        "jak"
                    ],
                    "common_phrases": [
                        "wtedy kiedy",
                        "dopiero kiedy",
                        "zawsze kiedy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Союз, соединяющий придаточное предложение и определяющий время, в которое происходит действие.",
                        "de": "Konjunktion, die einen Nebensatz einleitet und die Zeit angibt, zu der eine Handlung stattfindet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когда",
                                "target_lang_sense_clarification": "союз времени"
                            },
                            {
                                "target_lang_word": "в то время как",
                                "target_lang_sense_clarification": "одновременность действия"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wenn",
                                "target_lang_sense_clarification": "temporale Konjunktion bei Gegenwart/Zukunft oder wiederholter Vergangenheit"
                            },
                            {
                                "target_lang_word": "als",
                                "target_lang_sense_clarification": "temporale Konjunktion bei einmaligen Ereignissen in der Vergangenheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8f21bde-b6ea-37a7-83ce-32fe5a754aaa",
                    "sense_definition": "Spójnik wprowadzający przyczynę lub warunek zaistnienia jakiejś sytuacji.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "condition_cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kiedy</w> jesteś tak mądry, to radź sobie sam.",
                            "target_lang_translations": {
                                "ru": "<w>Раз</w> ты такой умный, то справляйся сам.",
                                "de": "<w>Wenn</w> du so schlau bist, dann komm alleine zurecht."
                            }
                        },
                        {
                            "text": "Nie kupię tego samochodu, <w>kiedy</w> jest taki drogi.",
                            "target_lang_translations": {
                                "ru": "Я не куплю эту машину, <w>раз</w> она такая дорогая.",
                                "de": "Ich kaufe dieses Auto nicht, <w>da</w> es so teuer ist."
                            }
                        }
                    ],
                    "synonyms": [
                        "skoro",
                        "jeśli",
                        "jeżeli"
                    ],
                    "target_lang_definitions": {
                        "ru": "Союз, вводящий причину или условие возникновения ситуации.",
                        "de": "Konjunktion, die den Grund oder die Bedingung für das Eintreten einer Situation einleitet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раз",
                                "target_lang_sense_clarification": "разговорное, в значении 'поскольку' или 'если'"
                            },
                            {
                                "target_lang_word": "если",
                                "target_lang_sense_clarification": "условие"
                            },
                            {
                                "target_lang_word": "поскольку",
                                "target_lang_sense_clarification": "причина"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wenn",
                                "target_lang_sense_clarification": "konditionale Konjunktion"
                            },
                            {
                                "target_lang_word": "da",
                                "target_lang_sense_clarification": "kausale Konjunktion"
                            },
                            {
                                "target_lang_word": "wo",
                                "target_lang_sense_clarification": "umgangssprachlich kausal, im Sinne von 'da ja'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d338565-a44a-3754-8cc7-b2b0a9818735",
                    "sense_definition": "Spójnik łączący zdania o treści przeciwstawnej; mimo że.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mógłbyś być najlepszym uczniem, <w>kiedy</w> nie chcesz się uczyć.",
                            "target_lang_translations": {
                                "ru": "Ты мог бы быть лучшим учеником, <w>хотя</w> не хочешь учиться.",
                                "de": "Du könntest der beste Schüler sein, <w>wo</w> du doch gar nicht lernen willst."
                            }
                        },
                        {
                            "text": "Obiecał pomóc, <w>kiedy</w> wcale tego nie zrobił.",
                            "target_lang_translations": {
                                "ru": "Он обещал помочь, <w>хотя</w> вовсе этого не сделал.",
                                "de": "Er hat versprochen zu helfen, <w>während</w> er es überhaupt nicht getan hat."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Союз, соединяющий предложения с противоположным смыслом; хотя.",
                        "de": "Konjunktion, die Sätze mit gegensätzlichem Inhalt verbindet; obwohl."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хотя",
                                "target_lang_sense_clarification": "уступка"
                            },
                            {
                                "target_lang_word": "тогда как",
                                "target_lang_sense_clarification": "противопоставление"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wo",
                                "target_lang_sense_clarification": "adversative Konjunktion, im Sinne von 'wohingegen' oder 'obwohl'"
                            },
                            {
                                "target_lang_word": "während",
                                "target_lang_sense_clarification": "adversative Konjunktion, drückt einen Gegensatz aus"
                            },
                            {
                                "target_lang_word": "obwohl",
                                "target_lang_sense_clarification": "konzessive Konjunktion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}