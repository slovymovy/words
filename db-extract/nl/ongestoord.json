                ],
                "senses": [
                    {
                        "sense_id": "998e6e23-5cc7-3ea7-a19c-bf466ed74f03",
                        "entry_id": "bfc0bb75-b92d-3aba-931d-7b20ea32a30f",
                        "glosses": [
                            "niet onderbroken (door iets vervelends) dus lekker rustig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faebd990-340c-41fe-aea1-8428ac1dda15",
                                "sense_id": "998e6e23-5cc7-3ea7-a19c-bf466ed74f03",
                                "text": "Hij kon ongestoord werken en maakte dus geen fouten."
                            },
                            {
                                "example_id": "d1218732-c3f5-4a53-9089-44b76bcb424d",
                                "sense_id": "998e6e23-5cc7-3ea7-a19c-bf466ed74f03",
                                "text": "Boven alles deed het me beseffen hoe veel geluk ik heb dat ik in een vrij land leef, waar mijn dochters kunnen doen wat ze willen en ongestoord naar school kunnen gaan."
                            },
                            {
                                "example_id": "0d3da3db-a18d-40cf-beed-47a571953aa1",
                                "sense_id": "998e6e23-5cc7-3ea7-a19c-bf466ed74f03",
                                "text": "Maar Duitsland spaarde hen en liet hen ongestoord naar hun eiland vliegen om hun wonden te likken."
                            }
                        ]
                    }
                ],
