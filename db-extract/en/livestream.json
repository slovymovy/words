                        "entry_id": "5cfaa32d-4c10-3d32-bd1c-aa1b655d2a24",
                        "glosses": [
                            "To broadcast as a live stream."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "331df996-594c-4b04-b24a-e94989fbc3bf",
                                "sense_id": "68b01763-fd67-3aa1-a63e-6ba462678314",
                                "text": "Post Malone raised more than $500,000 for coronavirus relief by livestreaming a Nirvana tribute concert on YouTube."
                            },
                            {
                                "example_id": "02fed4a1-cbcc-413f-b4da-c03569f6aa16",
                                "sense_id": "68b01763-fd67-3aa1-a63e-6ba462678314",
                                "text": "The plot revolves around an aimless and unemployed young man, M, whose sole ambition is to livestream his online games."
                            },
                            {
                                "example_id": "1b91161d-584a-4910-81b9-ae38cabdba9a",
                                "sense_id": "68b01763-fd67-3aa1-a63e-6ba462678314",
                                "text": "One Terrorgram user livestreamed himself stabbing five people outside of a mosque in Turkey, she said, and a 19-year-old Slovakian man praised the group in a manifesto before killing two people at an LGBTQ bar in Bratislava, the capital of Slovakia."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b62677c-184b-3d73-a64b-45d58357056a",
                        "entry_id": "5cfaa32d-4c10-3d32-bd1c-aa1b655d2a24",
                        "glosses": [
                            "To receive and watch as a live stream."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "00210b33-0f99-480e-98e5-8236ed8309c7",
                                "sense_id": "7b62677c-184b-3d73-a64b-45d58357056a",
                                "text": "I'm planning to livestream the football game this weekend."
                            }
                        ]
                    }
