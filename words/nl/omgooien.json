{
    "word_family": [
        "gooien",
        "omgooi"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e32e5dc-caff-33ba-bab1-d8b9919027ef",
                    "sense_definition": "Iets van een verticale naar een horizontale positie duwen of werpen; omverwerpen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "omverwerpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jongen <w>gooide</w> de vaas met bloemen per ongeluk <w>om</w>.",
                            "target_lang_translations": {
                                "en": "The boy accidentally <w>knocked over</w> the vase of flowers."
                            }
                        },
                        {
                            "text": "Pas op dat je die glazen op tafel niet per ongeluk <w>omgooit</w>.",
                            "target_lang_translations": {
                                "en": "Be careful not to accidentally <w>knock over</w> those glasses on the table."
                            }
                        }
                    ],
                    "synonyms": [
                        "omverwerpen",
                        "omduwen",
                        "omstoten"
                    ],
                    "antonyms": [
                        "rechtopzetten"
                    ],
                    "common_phrases": [
                        "een vaas omgooien",
                        "een glas omgooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To push or throw something from a vertical to a horizontal position; to knock over."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knock over",
                                "target_lang_sense_clarification": "to accidentally push something down"
                            },
                            {
                                "target_lang_word": "knock down",
                                "target_lang_sense_clarification": "to cause something to fall"
                            },
                            {
                                "target_lang_word": "tip over",
                                "target_lang_sense_clarification": "to cause to tilt and fall"
                            },
                            {
                                "target_lang_word": "overturn",
                                "target_lang_sense_clarification": "to turn over on its side or upside down"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "107ac23c-4076-3164-9198-d8febab18129",
                    "sense_definition": "Plannen, een volgorde of een systeem plotseling en ingrijpend veranderen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "veranderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de grote ramp werd het uitzendprogramma helemaal <w>omgegooid</w>.",
                            "target_lang_translations": {
                                "en": "Due to the major disaster, the broadcast schedule was completely <w>shaken up</w>."
                            }
                        },
                        {
                            "text": "We moeten onze hele planning <w>omgooien</w> omdat de levering vertraagd is.",
                            "target_lang_translations": {
                                "en": "We have to <w>overhaul</w> our entire schedule because the delivery is delayed."
                            }
                        }
                    ],
                    "synonyms": [
                        "omwentelen",
                        "wijzigen",
                        "veranderen"
                    ],
                    "antonyms": [
                        "behouden",
                        "handhaven"
                    ],
                    "common_phrases": [
                        "het roer omgooien",
                        "de planning omgooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly and drastically change plans, an order, or a system."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shake up",
                                "target_lang_sense_clarification": "to make major changes to a system or plan"
                            },
                            {
                                "target_lang_word": "overhaul",
                                "target_lang_sense_clarification": "to completely change or renovate a system or schedule"
                            },
                            {
                                "target_lang_word": "change completely",
                                "target_lang_sense_clarification": "to alter plans or schedules drastically"
                            },
                            {
                                "target_lang_word": "reorganize",
                                "target_lang_sense_clarification": "to change the structure or order of something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}