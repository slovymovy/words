                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b6c23a-9f5d-4869-a4a4-4a73f846dfd3",
                                "sense_id": "442e0b3b-11c2-34fd-890d-ba01347003cc",
                                "text": "Le 108e Congrès des Sociétés Savantes (Grenoble, avril 1983) devait nous permettre d’aborder aux Iles d’Or (Lis Isclo) du domaine provençal, celui de Frédéric Mistral qui, pas plus que les Félibres, n’avait oublié “Esclarmonde, l’astre de Montségur”, comme il se plaisait homériquement à l’épithéter."
                            },
                            {
                                "example_id": "044d467b-6efc-485b-9148-5d716522631b",
                                "sense_id": "442e0b3b-11c2-34fd-890d-ba01347003cc",
                                "text": "Il me vint alors une idée… que je ne sais comment épithéter."
                            }
                        ]
                    }
