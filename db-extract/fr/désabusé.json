                        "entry_id": "1621583a-5682-36aa-bdce-6e02838ba551",
                        "glosses": [
                            "Qui a perdu ses illusions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "905407f5-74dc-41c0-b5ab-772c749eec6b",
                                "sense_id": "9e595f4b-85ed-3bf3-8b92-ec1a6c21f002",
                                "text": "Me voici éclairé, me voici désabusé de toutes choses ; me voici vieux et plein d’expérience."
                            },
                            {
                                "example_id": "a97b13b0-f641-4d74-9249-d6aefaf40bfc",
                                "sense_id": "9e595f4b-85ed-3bf3-8b92-ec1a6c21f002",
                                "text": "Ted Neuville est un « crâne d'œuf » typique, chauve, imberbe et affublé de lunettes, du genre qui, en d'autres temps, aurait servi de modèle à une pub pour un antivirus. Il hausse son absence de sourcils avec une moue désabusée."
                            }
                        ]
                    }
