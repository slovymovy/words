                        "entry_id": "80349113-27d9-3bbb-9332-108e71b90f41",
                        "glosses": [
                            "metalen strook dwars over de rijbaan als beschermingsrand van een brugdek waarover wagens de brug op kunnen rijden"
                        ],
                        "tags": [],
