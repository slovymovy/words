                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company policy grants employees five days of paid <w>bereavement</w> leave.",
                            "target_lang_translations": {
                                "ru": "Политика компании предоставляет сотрудникам пять дней оплачиваемого отпуска в связи с <w>утратой</w> близкого человека.",
