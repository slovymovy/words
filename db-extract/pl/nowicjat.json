                                    },
                                    {
                                        "sense_id": "8845103c-95db-3993-a375-4d3a17f89982",
                                        "entry_id": "9642ca91-5da6-3c54-825b-84b670403aa8",
                                        "glosses": [
                                            "The period during which a novice of a religious order undergoes training."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5858144b-f09b-4cd6-aad9-ad59b8f02a5e",
                                                "sense_id": "8845103c-95db-3993-a375-4d3a17f89982",
                                                "text": "Three weeks after the departure of the Mandevilles, all Naples flocked to witness the profession of a young Englishwoman, a dispensation having been obtained for the novitiate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eebeedc-3b29-31ee-b94e-7ba26dc69a7e",
                                        "entry_id": "9642ca91-5da6-3c54-825b-84b670403aa8",
