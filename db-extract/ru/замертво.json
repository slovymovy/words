        "ru-extract.jsonl": [
            {
                "entry_id": "e53a41d6-3e8e-335b-9077-eda8882fe2fe",
                "word": "замертво",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c85acaaf-412a-3ba2-9358-916535fe49f9",
                        "entry_id": "e53a41d6-3e8e-335b-9077-eda8882fe2fe",
                        "glosses": [
                            "будучи уже мёртвым; без признаков жизни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf8dc200-9c0d-4b1f-a8c4-a87a80ebee70",
                                "sense_id": "c85acaaf-412a-3ba2-9358-916535fe49f9",
                                "text": "И опричник молодой застонал слегка, // Закачался, упал замертво."
                            },
                            {
                                "example_id": "5706887c-ae60-437b-9a7a-0b430f936612",
                                "sense_id": "c85acaaf-412a-3ba2-9358-916535fe49f9",
                                "text": "Наконец многие удары по голове кинжалом оглушили его; он упал замертво."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1abefa4-ed1b-398f-b5ee-72aa54ca1665",
                        "entry_id": "e53a41d6-3e8e-335b-9077-eda8882fe2fe",
                        "glosses": [
                            "перен. пребывая в бесчувственном состоянии (обмороке, опьянении, усталости и т. п.); без сознания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7350fa1c-851a-4dc1-b2ec-e6f3b2f963b2",
                                "sense_id": "f1abefa4-ed1b-398f-b5ee-72aa54ca1665",
                                "text": "Мальчик спутал, за что хозяин ударил его ногою в бок, так что бедняк повалился замертво и долгое время потом был болен."
                            },
                            {
                                "example_id": "57afce1d-ee1b-4896-8cdf-042ba691f48a",
                                "sense_id": "f1abefa4-ed1b-398f-b5ee-72aa54ca1665",
                                "text": "Княжна несколько раз в церкви лишалась чувств и наконец была замертво унесена с кладбища, так как в момент опускания гроба с телом её матери в склеп с нею сделался истерический припадок."
                            }
                        ]
                    }
                ],
