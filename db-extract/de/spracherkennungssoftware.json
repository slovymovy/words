                    {
                        "sense_id": "425892ec-7654-33f9-98cd-ed49b0df69ce",
                        "entry_id": "cef39a57-3d9e-39e0-86a4-88600d47be13",
                        "glosses": [
                            "Computerprogramm zur Erfassung sprachlicher Äußerungen einschließlich ihrer semantischen (bedeutungsmäßigen) und syntaktischen Strukturen"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "fe7cf63c-755b-4f90-b087-4a8444eb8ace",
                                "sense_id": "425892ec-7654-33f9-98cd-ed49b0df69ce",
                                "text": "„Spracherkennungssoftware gibt es seit 40Jahren, aber erst Apple hat es geschafft, den Massenmarkt dafür zu begeistern.“"
                            },
                            {
                                "example_id": "56c3ce47-b1fb-40b5-972f-3b80dfbd2e10",
                                "sense_id": "425892ec-7654-33f9-98cd-ed49b0df69ce",
                                "text": "„Drei gescheiterte Versuche, mit Apples Spracherkennungssoftware Siri auf Österreichisch ins Gespräch zu kommen.“"
                            },
                            {
                                "example_id": "cfc7d349-2b65-4728-978c-de5aa8414c76",
                                "sense_id": "425892ec-7654-33f9-98cd-ed49b0df69ce",
                                "text": "„PwC beispielsweise entwickelt derzeit laut eigenen Angaben einen Sprachassistenten für die Rechnungslegung, in Anlehnung an die von Apple eingesetzte Spracherkennungssoftware Siri.“"
                            },
                            {
                                "example_id": "b66f546c-6baf-4a52-b724-f474dcf9e534",
                                "sense_id": "425892ec-7654-33f9-98cd-ed49b0df69ce",
                                "text": "„Ob wütend, fröhlich oder ironisch: Spracherkennungssoftware versteht mittlerweile Emotionen und Untertöne.“"
                            },
                            {
                                "example_id": "982a0765-befe-4c5a-abd6-be2f54a8e5d9",
                                "sense_id": "425892ec-7654-33f9-98cd-ed49b0df69ce",
                                "text": "„Noch meistert keine Spracherkennungssoftware diese Herausforderung.“"
                            }
                        ],
