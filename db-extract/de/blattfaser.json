                "senses": [
                    {
                        "sense_id": "4a6dc55a-1f50-32b0-bbe3-3a289cb3ea0c",
                        "entry_id": "0d91039b-1fcf-38ae-9d0f-1d1f57a7e88b",
                        "glosses": [
                            "Faser aus dem Bast der Blätter eines Gewächses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d408f80a-00eb-4895-87eb-48d527716439",
                                "sense_id": "4a6dc55a-1f50-32b0-bbe3-3a289cb3ea0c",
                                "text": "„Bis in die jüngste Vergangenheit gab es im Ort viele Seilmacher, die aus den Blattfasern Stricke flochten und verkauften.“"
                            },
                            {
                                "example_id": "4df807a7-f7e8-42ec-bbaf-5f73a97acd28",
                                "sense_id": "4a6dc55a-1f50-32b0-bbe3-3a289cb3ea0c",
                                "text": "„Im Gegensatz zum europäischen Hanf (Cannabis sativa L.), der eine Stengelfaser ist, ist Sisal eine Blattfaser und Manilahanf eine Stammfaser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
