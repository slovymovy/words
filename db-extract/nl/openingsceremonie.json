                "senses": [
                    {
                        "sense_id": "22b5f0f4-7784-3148-a10c-ebff002576ed",
                        "entry_id": "6ec4912d-0299-3871-8920-6fd9da734a72",
                        "glosses": [
                            "plechtigheid als opening van een evenement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a570aa80-3aeb-41a4-85d4-58f3bc220ca7",
                                "sense_id": "22b5f0f4-7784-3148-a10c-ebff002576ed",
                                "text": "De openingsceremonie van de Olympische Spelen werd live uitgezonden."
                            },
                            {
                                "example_id": "5e8347a0-bf9b-4a77-9064-3d8aa7be4ed8",
                                "sense_id": "22b5f0f4-7784-3148-a10c-ebff002576ed",
                                "text": "Jeroen Bijl, chef de mission bij de Winterspelen in Pyeongchang, vertelt waarom de keuze op Jan Smeekens is gevallen. De sprinter zal vrijdag 9 februari bij de openingsceremonie de Nederlandse vlag het stadion binnendragen."
                            },
                            {
                                "example_id": "08ce1e53-8bb8-4641-b0c4-66a72edf4cf1",
                                "sense_id": "22b5f0f4-7784-3148-a10c-ebff002576ed",
                                "text": "Als dat verdomde coronavirus niet was uitgebroken, dan had afgelopen vrijdag de openingsceremonie van de Olympische Spelen in Tokio plaatsgevonden. Leonie Everts had daar bij kunnen zijn en van dichtbij alle pracht en praal kunnen meemaken. In plaats daarvan zit de 31-jarige vrouw nu in een klein, claustrofobisch hokje bij de ingang van Natuurlijk Glamping waar ze de receptie bestiert."
                            }
                        ]
                    }
