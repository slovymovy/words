                                        "entry_id": "1657c59e-3413-313e-8ef8-648daf2f1361",
                                        "glosses": [
                                            "With heft; heavy, strong, vigorous, mighty, impressive"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8479564-8f60-4a40-b3cd-d3a1f81b12b0",
                                                "sense_id": "cf1e59d8-0238-30f6-9995-1ca734bd5429",
                                                "text": "He can throw a hefty punch."
                                            },
                                            {
                                                "example_id": "306d36c7-0612-48b1-b17a-2f7e7832891a",
                                                "sense_id": "cf1e59d8-0238-30f6-9995-1ca734bd5429",
                                                "text": "The Remove dormitory echoed to the old, familiar sound of Bunter's hefty snore."
                                            },
                                            {
                                                "example_id": "68f3e02b-74a7-4a96-bf3c-ca4bff8732a2",
                                                "sense_id": "cf1e59d8-0238-30f6-9995-1ca734bd5429",
                                                "text": "Fill up on some of the heftiest burritos in captivity, fashioned around grilled beef, chicken, greasy and indulgent barbecued pork al pastor, carnitas and the more exotic [things]."
                                            },
                                            {
                                                "example_id": "521c1007-06b6-49ab-85d4-03ed4417f778",
                                                "sense_id": "cf1e59d8-0238-30f6-9995-1ca734bd5429",
                                                "text": "[…] on Sunday four more violinists, a second violist and a harpsichordist were added to give the ripieno sections of the fast movements a heftier punch than the smaller group delivered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b69662b3-048d-30c8-bb6c-4a655edfe5c8",
                                        "entry_id": "1657c59e-3413-313e-8ef8-648daf2f1361",
                                        "glosses": [
                                            "Strong; bulky."
