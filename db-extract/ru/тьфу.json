                                "target_senses": [
                                    {
                                        "sense_id": "77f6ba3b-c007-3d21-a53f-60ecc7f42d9a",
                                        "entry_id": "afb311eb-bfa8-38a9-850f-c38f16c85013",
                                        "glosses": [
                                            "Used to express distaste, disgust or outrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "389a0473-eb15-4be0-a5df-ae0a5eaec12f",
                                                "sense_id": "77f6ba3b-c007-3d21-a53f-60ecc7f42d9a",
                                                "text": "Fie! fie! fie! pah! pah! Give me an ounce of civet, good apothecary, to sweeten my imagination."
                                            },
                                            {
                                                "example_id": "2b1701e9-b960-400f-8268-0e454f22624c",
                                                "sense_id": "77f6ba3b-c007-3d21-a53f-60ecc7f42d9a",
                                                "text": "She was rarely suffered out of their sight; never went beyond the domains of the castle, unless well attended, or, rather, well watched; had continual lectures read to her about strict decorum and implicit obedience; and, as to the men—pah! she was taught to hold them at such distance and distrust that, unless properly authorized, she would not have cast a glance upon the handsomest cavalier in the world—no, not if he were even dying at her feet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pah",
                                "target_lang_code": "en",
