                    {
                        "sense_id": "626c17ef-e70c-3568-b4e7-f8678c05240a",
                        "entry_id": "ee714a37-e18e-3727-8b56-accfedb55bd3",
                        "glosses": [
                            "onschendbaarheid, eerlijkheid, oprechtheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf24acb-b6ce-48ca-b876-6f5a9a1da9b9",
                                "sense_id": "626c17ef-e70c-3568-b4e7-f8678c05240a",
                                "text": "Iemands integriteit in twijfel trekken."
                            },
                            {
                                "example_id": "fbfda2d0-bc9f-43a9-a641-cdecddee83df",
                                "sense_id": "626c17ef-e70c-3568-b4e7-f8678c05240a",
                                "text": "De douane kon op zowel ondemocratische als iemands integriteit schendende wijze naar smokkelgeld zoeken."
                            }
                        ]
                    },
                    {
                        "sense_id": "e70ce032-cbc1-3bcb-a37d-289e1854f644",
                        "entry_id": "ee714a37-e18e-3727-8b56-accfedb55bd3",
                        "glosses": [
                            "betrouwbaarheid van gegevens in het kader van informatiebeveiliging"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67a6f248-7abc-4058-a44d-5ae452dd995e",
                        "source_entry_id": "ee714a37-e18e-3727-8b56-accfedb55bd3",
                        "source_sense_id": "626c17ef-e70c-3568-b4e7-f8678c05240a",
                        "source_sense_description": "onschendbaarheid, eerlijkheid, oprechtheid",
                        "target_lang_word": "Integrität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Integrität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1c47f3c-3639-3406-95dd-aa663ccd1bd8",
                                        "entry_id": "0459f4e8-86ca-3fbb-abfd-3777c9cfd68c",
                                        "glosses": [
                                            "die charakterliche Unbescholtenheit, Unversehrtheit oder Unverletzlichkeit von jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "127a722e-cd10-4578-be9b-7abcd7897554",
                                                "sense_id": "a1c47f3c-3639-3406-95dd-aa663ccd1bd8",
                                                "text": "Ich glaube an seine Integrität!"
                                            },
                                            {
                                                "example_id": "bf6904cf-133d-4366-867c-f191541b56f2",
                                                "sense_id": "a1c47f3c-3639-3406-95dd-aa663ccd1bd8",
                                                "text": "„Da Brecht und Neruda ihre poetische Integrität wahrten, ließ sich ihre Literatur nicht desavouieren.“"
                                            },
                                            {
                                                "example_id": "1ce7d4e7-65c0-401b-9a10-5298f2986e40",
                                                "sense_id": "a1c47f3c-3639-3406-95dd-aa663ccd1bd8",
                                                "text": "„In ihren Augen hatte er jegliche Integrität verloren.“"
                                            },
                                            {
                                                "example_id": "1fa9f6f1-df8e-4bd9-be33-71a8aaf87229",
                                                "sense_id": "a1c47f3c-3639-3406-95dd-aa663ccd1bd8",
                                                "text": "„Wer als Führungskraft zu viel Schleimerei zulässt oder gar belohnt, schadet seiner eigenen Integrität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3bd608f-f0f2-3e50-941b-24c7110116c4",
                                        "entry_id": "0459f4e8-86ca-3fbb-abfd-3777c9cfd68c",
                                        "glosses": [
                                            "die Fehlerfreiheit, Widerspruchsfreiheit oder Vollständigkeit von Daten (zum Beispiel auf einem PC)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7901b889-8dc8-41eb-a111-13bb9fcfe5a9",
                                                "sense_id": "b3bd608f-f0f2-3e50-941b-24c7110116c4",
                                                "text": "Die Integrität der gespeicherten Daten ist zweifelhaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f022e0d-cd84-4cbf-a282-ddf7ef28de82",
                        "source_entry_id": "ee714a37-e18e-3727-8b56-accfedb55bd3",
                        "source_sense_id": "626c17ef-e70c-3568-b4e7-f8678c05240a",
                        "source_sense_description": "onschendbaarheid, eerlijkheid, oprechtheid",
                        "target_lang_word": "integrity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "integrity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "860e4f5a-a6e0-309e-9816-95420a407483",
                                        "entry_id": "0b9ef19c-261f-39f9-ac42-c6346f71d449",
                                        "glosses": [
                                            "Steadfast adherence to a strict moral or ethical code."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa77af4f-0763-4607-8a79-5dcf58c2ebed",
                                                "sense_id": "860e4f5a-a6e0-309e-9816-95420a407483",
                                                "text": "Stand up, good Canterbury: Thy truth and thy integrity is rooted […]"
                                            },
                                            {
                                                "example_id": "e00ab04b-a1f4-4dc7-ac40-cf43c350f3ec",
                                                "sense_id": "860e4f5a-a6e0-309e-9816-95420a407483",
                                                "text": "Living a lie saps us of integrity and moral cohesion to the point that we can no longer distinguish between the artifice being propped up and the real world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e46980-1b66-3ea4-b9f4-e44ba7520cf4",
                                        "entry_id": "0b9ef19c-261f-39f9-ac42-c6346f71d449",
                                        "glosses": [
                                            "The state of being wholesome; unimpaired"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc1b4e56-8283-3fd4-9a87-5ddd4c96cad4",
                                        "entry_id": "0b9ef19c-261f-39f9-ac42-c6346f71d449",
                                        "glosses": [
                                            "The quality or condition of being complete; pure"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76dc06e7-0a01-3e19-9f8c-854930ee033a",
                                        "entry_id": "0b9ef19c-261f-39f9-ac42-c6346f71d449",
                                        "glosses": [
