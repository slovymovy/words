                "senses": [
                    {
                        "sense_id": "261e1a6f-59b5-38ad-bdb8-2d6b3948400a",
                        "entry_id": "ac05c641-5744-34b4-aef7-f527eb293c02",
                        "glosses": [
                            "Händler, der Waren aus dem Ausland einführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a188ed3d-b0cd-481d-be81-f8efe5d73228",
                                "sense_id": "261e1a6f-59b5-38ad-bdb8-2d6b3948400a",
                                "text": "Der Importeur hatte falsch kalkuliert und wurde deswegen entlassen."
                            },
                            {
                                "example_id": "38d25150-26d9-4b8f-9557-bcd0939e8c6f",
                                "sense_id": "261e1a6f-59b5-38ad-bdb8-2d6b3948400a",
                                "text": "„Nun sitzt Aggarwal in seinem Eckbüro im Langenthaler Gewerbegebiet, an dem die Züge zwischen Bern und Zürich vorbeirauschen, und erzählt, wie er zu einem der grössten Importeure indischer Lebensmittel in der Schweiz wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db87beb0-043e-4d86-bfa3-df126d0c0ee3",
                        "source_entry_id": "ac05c641-5744-34b4-aef7-f527eb293c02",
                        "source_sense_id": "261e1a6f-59b5-38ad-bdb8-2d6b3948400a",
                        "source_sense_description": "Händler, der Waren aus dem Ausland einführt",
                        "target_lang_word": "importer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "importer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "529bb7ff-4b71-3e76-9770-eab548bd01c4",
                                        "entry_id": "db1c5d3f-c257-3541-8de5-2c54126b5b9e",
                                        "glosses": [
                                            "One who, or that which, imports: especially a person or company importing goods into a country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d95846e-9391-4312-a74f-8ea8f35376eb",
                                                "sense_id": "529bb7ff-4b71-3e76-9770-eab548bd01c4",
                                                "text": "India is the world's biggest importer of gold."
                                            },
                                            {
                                                "example_id": "db4f306e-fa36-40d4-aa0a-0db931f819d2",
                                                "sense_id": "529bb7ff-4b71-3e76-9770-eab548bd01c4",
                                                "text": "The data importer has crashed. Did we receive a corrupted file?"
                                            },
                                            {
                                                "example_id": "b2d92fcc-4f5f-4086-8723-2001aeb2f10d",
                                                "sense_id": "529bb7ff-4b71-3e76-9770-eab548bd01c4",
                                                "text": "Tobacco, for instance, shrinks materially by frequent reshippings, and as all goods are warehoused as a convenience to importers, duties should be paid on what the importer receives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
