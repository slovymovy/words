        "fr-extract.jsonl": [
            {
                "entry_id": "fbf93f6a-c07e-3c5b-b625-ba914f4a6a29",
                "word": "d’aventure",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "00fdbc6f-2581-32be-862a-747569a6b4bd",
                        "entry_id": "fbf93f6a-c07e-3c5b-b625-ba914f4a6a29",
                        "glosses": [
                            "Par hasard, fortuitement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50283f68-2ad0-4037-8b18-e007ff9ebbdc",
                                "sense_id": "00fdbc6f-2581-32be-862a-747569a6b4bd",
                                "text": "Après avoir marché assez longtemps, je rencontrai un vieil homme qui faisait des fagots. Je lui demandai s’il n’avait pas vu, d’aventure, mon régiment que j’avais perdu."
                            },
                            {
                                "example_id": "3bb71358-3a76-4638-9690-8f2d87c4a25f",
                                "sense_id": "00fdbc6f-2581-32be-862a-747569a6b4bd",
                                "text": "Si d’aventure il a manqué son coup, il a un petit mouvement de recul."
                            },
                            {
                                "example_id": "ef8b39b4-b1d9-4553-8464-d852ffa09474",
                                "sense_id": "00fdbc6f-2581-32be-862a-747569a6b4bd",
                                "text": "Si, d’aventure, il restait sur place, attendant une vacance à l'usine, il travaillait à la mine et était payé par pipe de minerai extraite."
                            },
                            {
                                "example_id": "e5f36ffb-11da-490f-bed9-781d5f6d6ec4",
                                "sense_id": "00fdbc6f-2581-32be-862a-747569a6b4bd",
                                "text": "[…] ; mais leur savoir ils l'ont acquis d’aventure, à la diable, en dehors des règles traditionnelles édictées à propos, méditées par des compétences."
                            },
                            {
                                "example_id": "9f626fd0-741a-48d1-bfaa-aae129b11905",
                                "sense_id": "00fdbc6f-2581-32be-862a-747569a6b4bd",
                                "text": "Quand, d’aventure, Ouroz tournait la tête vers lui, il se surprenait à envier la sécurité, l’aisance, la finesse de ce pas."
                            },
                            {
                                "example_id": "3536973d-cbc9-41f1-a403-24ed02dd0334",
                                "sense_id": "00fdbc6f-2581-32be-862a-747569a6b4bd",
                                "text": "Si d’aventure le petit Jean-Claude voulait vivre comme eux, il ne tenait qu’à lui, qu’à ses parents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f53c9be7-b5f1-4745-b585-927845ffb207",
                        "source_entry_id": "fbf93f6a-c07e-3c5b-b625-ba914f4a6a29",
                        "source_sense_id": "00fdbc6f-2581-32be-862a-747569a6b4bd",
                        "target_lang_word": "by chance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by chance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cef8240d-0402-3a45-8856-c0a40d63b44e",
                                        "entry_id": "2d6a64a2-982a-3e4f-99d0-592d81a4abe0",
                                        "glosses": [
                                            "Unexpectedly, accidentally; without foreplanning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "282dcf68-d656-467a-b518-f66fe3d0d941",
                                                "sense_id": "cef8240d-0402-3a45-8856-c0a40d63b44e",
                                                "text": "I stumbled across the exit by chance."
                                            },
                                            {
                                                "example_id": "8692c1a3-03a4-4654-952f-905d0e23d1c5",
                                                "sense_id": "cef8240d-0402-3a45-8856-c0a40d63b44e",
                                                "text": "[...] Yojo had told him two or three times over, and strongly insisted upon it everyway, that instead of our going together among the whaling-fleet in harbor, and in concert selecting our craft; instead of this, I say, Yojo earnestly enjoined that the selection of the ship should rest wholly with me, inasmuch as Yojo purposed befriending us; and, in order to do so, had already pitched upon a vessel, which, if left to myself, I, Ishmael, should infallibly light upon, for all the world as though it had turned out by chance; and in that vessel I must immediately ship myself, for the present irrespective of Queequeg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63dd9b9e-3f8a-3fb3-bc8f-7e02a67581d3",
                                        "entry_id": "2d6a64a2-982a-3e4f-99d0-592d81a4abe0",
                                        "glosses": [
                                            "Possibly; perhaps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df29180-41a9-44d2-a31c-6ccfc7b1b98b",
                                                "sense_id": "63dd9b9e-3f8a-3fb3-bc8f-7e02a67581d3",
                                                "text": "Are you by chance looking for the exit?"
                                            },
                                            {
                                                "example_id": "ab5b02a5-4c88-47cb-8c84-2932fb4b7680",
                                                "sense_id": "63dd9b9e-3f8a-3fb3-bc8f-7e02a67581d3",
                                                "text": "If by chance you notice the fine, almost sweet maltiness of the aroma, and the brisk, dry, mineral quality of the flavors, even better."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
