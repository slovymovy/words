                ],
                "senses": [
                    {
                        "sense_id": "99dc4d03-43d3-37d7-a551-6a529bc8951a",
                        "entry_id": "9f9dc429-1879-3f2c-94d6-f5acdebbaeb9",
                        "glosses": [
                            "sportmedizinischer Belastungstest, bei dem unter zunehmender körperlicher Anstrengung die Laktatkonzentration im Blut gemessen wird, um Rückschlüsse auf Fitness, Ausdauerleistungsfähigkeit und den aktuellen Trainingszustand zu ziehen"
                        ],
                        "tags": [
                            "Sportmedizin",
                            "Leistungsdiagnostik"
                        ],
                        "examples": [
                            {
                                "example_id": "34026478-e62f-48c1-9693-62492c528e52",
                                "sense_id": "99dc4d03-43d3-37d7-a551-6a529bc8951a",
                                "text": "„Der Laktattest sei ursprünglich für 10000-Meter-Läufer konzipiert worden – also eher für mittlere Distanzen.“"
                            },
                            {
                                "example_id": "bb0b7310-5ce2-4e5a-9fbd-a3f3e6ae5cb8",
                                "sense_id": "99dc4d03-43d3-37d7-a551-6a529bc8951a",
                                "text": "„Für den reinen Freizeitsportler, der am Wochenende nur zum Spaß ein paar Runden durch den Wald joggt, macht es aber meist wenig Sinn, einen Laktattest zu machen.“"
                            },
                            {
                                "example_id": "39eaa6f6-8fa5-4d1d-9698-49155ab0c5b9",
                                "sense_id": "99dc4d03-43d3-37d7-a551-6a529bc8951a",
                                "text": "„Am 19. Juni treffen sich die Löwen erstmals nach dem Urlaub wieder, um mit dem Laktattest in ihre vierte Drittliga-Saison zu starten.“"
                            },
                            {
                                "example_id": "c0006764-c1b2-44ca-a7cb-fa78c25edae8",
                                "sense_id": "99dc4d03-43d3-37d7-a551-6a529bc8951a",
                                "text": "„Dass er nur über diesen kurzen Zeitraum auf dem Platz stand, lag daran, dass der gebürtige Münchner vor dem Anpfiff einen Laktattest absolviert hat.“"
                            },
                            {
                                "example_id": "8bc4fc10-0ed7-492f-8100-284ebdb87b1e",
                                "sense_id": "99dc4d03-43d3-37d7-a551-6a529bc8951a",
                                "text": "„Der holländische Stürmer soll demnächst einen Laktattest machen, damit die sportliche Kommandobrücke weiß, ob der Fitnesszustand Zwarts ausreicht, ihn möglichst bald wieder ins Mannschaftstraining zu integrieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
