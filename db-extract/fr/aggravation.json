        "fr-extract.jsonl": [
            {
                "entry_id": "a538ce66-da43-379a-a855-ac5bac30a317",
                "word": "aggravation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5f993eca-2d18-462f-bcb6-3bfdb013fa2c",
                        "entry_id": "a538ce66-da43-379a-a855-ac5bac30a317",
                        "tags": [
                            "plural"
                        ],
                        "form": "aggravations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                        "entry_id": "a538ce66-da43-379a-a855-ac5bac30a317",
                        "glosses": [
                            "Action d’aggraver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0a0462-507e-461c-85a9-3228b6a201d3",
                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                "text": "Aggravation de peine. Ce qu’on ajoute à une condamnation, à un châtiment."
                            },
                            {
                                "example_id": "f11c8891-9b2c-4380-a8bb-266a19dac42a",
                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                "text": "— En vérité, ce serait peut-être un bonheur pour moi, répondait Lucien ; ou, pour parler avec l’exactitude mathématique que nous aimons, rien ne peut être pour moi aggravation de peine ; je crois, sans trop présumer, être parvenu au comble de l’ennui."
                            },
                            {
                                "example_id": "37310b61-e222-4463-a7e8-408d6b56de32",
                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                "text": ". L’aggravation du mal."
                            },
                            {
                                "example_id": "7b35d838-33a7-4f0d-803e-52bb74e3df76",
                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                "text": "Sur vingt schizophrènes, on comptabilisa dix améliorations dont quatre sorties et dix échecs dont une aggravation."
                            }
                        ]
                    },
                    {
                        "sense_id": "727f7af5-20dd-39e3-ad03-052a6a5bffb0",
                        "entry_id": "a538ce66-da43-379a-a855-ac5bac30a317",
                        "glosses": [
                            "Dommage corporel supplémentaire survenu depuis la consolidation. Imputable au fait générateur du dommage et témoignant de l’évolution des séquelles traumatiques temporaires ou définitifs."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "af3c5124-3942-3aa1-a68e-9c1cab911bf7",
                        "entry_id": "a538ce66-da43-379a-a855-ac5bac30a317",
                        "glosses": [
                            "Seconde fulmination solennelle d’un monitoire."
