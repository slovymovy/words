                "senses": [
                    {
                        "sense_id": "3b6fb1d6-2abf-3d2d-a270-758b5d777ca9",
                        "entry_id": "c16ce4b5-5e07-38c8-8ca9-aa8f2a26d141",
                        "glosses": [
                            "Frousse."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b9a304d4-792b-459b-8d43-614e63e50ff3",
                                "sense_id": "3b6fb1d6-2abf-3d2d-a270-758b5d777ca9",
                                "text": "Turpin n’avait tout bêtement voulu que flanquer la traquette aux gones malins et emmiellants, mais rester patriote avant tout."
                            },
                            {
                                "example_id": "eb07ea75-3b13-45ff-9caf-f9703e13ba0d",
                                "sense_id": "3b6fb1d6-2abf-3d2d-a270-758b5d777ca9",
                                "text": "Habitué au succès, le moindre obstace lui fait dresser le cheveu sur la tête et la moindre goutte de pluie, une veille de courses, agite son sommeil. « C’est le père La Traquette », disait de lui un de ses collègues défunts !"
                            },
                            {
                                "example_id": "8fa9f97e-e0b1-4126-a16a-e67ff9e57faa",
                                "sense_id": "3b6fb1d6-2abf-3d2d-a270-758b5d777ca9",
                                "text": "Pour lui filer la traquette, je lui montre ma carte. Si vous pouviez jeter un coup d’œil sur la physionomie du mec vous rigoleriez tellement qu’on serait obligé de vous amener votre belle-mère ou votre percepteur pour vous faire passer le fou rire."
                            },
                            {
                                "example_id": "94ca691e-e9c8-401a-8f39-a93fd1bb298a",
                                "sense_id": "3b6fb1d6-2abf-3d2d-a270-758b5d777ca9",
                                "text": "Il n’a jamais les flubes, les jetons, les foies, les copeaux, les grolles, les grelots, les chocottes, la grelotte, le taffe, le trac, le tracsir, la traquette."
                            },
                            {
                                "example_id": "1941dd9e-fc85-4aa2-9231-90100afbbb44",
                                "sense_id": "3b6fb1d6-2abf-3d2d-a270-758b5d777ca9",
                                "text": "Mohammed prend la traquette\nIl se mélange les pinceaux\nLes flics lui sautent à la tête\nEt le laissent sur le carreau\nLe crâne éclaté — pas beau !\nQuand il dit « traquette »\nSes genoux s'’entrechoquent."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
