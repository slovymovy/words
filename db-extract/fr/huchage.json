                        "glosses": [
                            "Son produit quand on huche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55024a1a-1f63-48ad-8851-2325fed5f633",
                                "sense_id": "cb1b74df-6483-33a2-b1f9-a0b5ba9b0041",
                                "text": "Le huchage, suite de sons de tête, sans cadence, servait également à exciter le chien auquel était confié la garde du troupeau, à rappeler les bêtes qui s’écartaient, ou à les rassembler au moment du retour à l’étable."
                            },
                            {
                                "example_id": "fcb55a2d-992a-445c-ac71-3c7b92f3108c",
                                "sense_id": "cb1b74df-6483-33a2-b1f9-a0b5ba9b0041",
                                "text": "En même temps, la campagne, jusqu’alors tristement muette, retrouva ses huchages de bergers, ses terlassages de bouviers et ses brusques houppées de joie, en cascade."
                            }
                        ]
                    }
