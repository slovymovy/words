                "forms": [],
                "senses": [
                    {
                        "sense_id": "6946e1b7-88b9-330e-b2c2-d5c4ab747c4d",
                        "entry_id": "4b196b39-85f7-3eb1-b04a-d275071f346f",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e943d8cc-a7f0-43e3-8233-787cd99cb24f",
                                "sense_id": "6946e1b7-88b9-330e-b2c2-d5c4ab747c4d",
                                "text": "Lors de la deuxième partie de la soirée, des médailles du travail ont été remises par le chef d’agence et Bernard Pourpoint, maire de la commune : celle des quinze ans à Julien Mercier, chef de carrière depuis 2019, et celle des trente ans à Jean-Yves Mayo."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b8f5c603-89cd-3b6c-a32a-2036046b26e9",
                "word": "pourpoint",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "09e90d2a-441f-4885-964d-62be0bfe34ad",
                        "entry_id": "b8f5c603-89cd-3b6c-a32a-2036046b26e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "pourpoints"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d624ac15-055a-3bd2-85c6-e6e5185a41b8",
                        "entry_id": "b8f5c603-89cd-3b6c-a32a-2036046b26e9",
                        "glosses": [
                            "Justaucorps, chemise ou habit d’étoffe piquée qui couvrait le corps du cou jusqu’à la ceinture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4982f518-0a55-4a96-a619-dccc1972750c",
                                "sense_id": "d624ac15-055a-3bd2-85c6-e6e5185a41b8",
                                "text": "\"Philandre : Ce blasphème à tout autre aurait coûté la vie.\n - Tircis : Nous tomberons d’accord sans nous mettre en pourpoint. C’est-à-dire sans nous mettre en chemise pour nous battre"
                            },
                            {
                                "example_id": "814afe9b-0580-4621-bdfc-e12ddc9fb5a9",
                                "sense_id": "d624ac15-055a-3bd2-85c6-e6e5185a41b8",
                                "text": "Il portait un élégant pourpoint garni de zibeline, un haut-de-chausses très-ample et des souliers fendus dans toute leur longueur."
                            },
                            {
                                "example_id": "9e1938ab-43cd-4bdb-8035-3adc7c0616d8",
                                "sense_id": "d624ac15-055a-3bd2-85c6-e6e5185a41b8",
                                "text": "Mon pourpoint n’est pas plus vieux que les tapisseries de la couronne."
                            },
                            {
                                "example_id": "91085d55-75d9-487d-a3f0-28c1054783c5",
                                "sense_id": "d624ac15-055a-3bd2-85c6-e6e5185a41b8",
                                "text": "Il était simplement mis, mais élégamment vêtu d'un pourpoint de drap violet foncé avec de légères broderies de soie de même couleur."
                            },
                            {
                                "example_id": "302b7135-2163-4c20-93ed-a8b46cb5f8d7",
                                "sense_id": "d624ac15-055a-3bd2-85c6-e6e5185a41b8",
                                "text": "Puis il passa par-dessus son jacques des chausses et un pourpoint gris et argent, qui étaient ses couleurs favorites."
                            },
                            {
                                "example_id": "62839bcd-3666-43e6-a2ee-29dd3a72893c",
                                "sense_id": "d624ac15-055a-3bd2-85c6-e6e5185a41b8",
                                "text": "Ce furent les Croisades qui firent pénétrer en France l’usage des parfums : on introduisait ceux-ci sous forme de peaux odoriférantes destinées à faire des pourpoints, des ceintures, des gants."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcd03ce2-6e25-3972-ad71-97811c1ba506",
                        "entry_id": "b8f5c603-89cd-3b6c-a32a-2036046b26e9",
                        "glosses": [
                            "Justaucorps, chemise ou habit d’étoffe piquée qui couvrait le corps du cou jusqu’à la ceinture.",
                            "Camisole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a600caa-57d7-46d7-ab7e-6e466ccdbff6",
                                "sense_id": "fcd03ce2-6e25-3972-ad71-97811c1ba506",
                                "text": "pourpoint de pierre, prison."
                            },
                            {
                                "example_id": "6fabdade-e073-4935-8478-460943f41a37",
                                "sense_id": "fcd03ce2-6e25-3972-ad71-97811c1ba506",
                                "text": "Il ne sera pas bien à Lyon, de peur d’un pourpoint de pierre de taille en Pierre-Ancise."
                            }
                        ]
                    },
                    {
                        "sense_id": "af5a79bd-8a07-303b-98e2-8527e06c15a5",
                        "entry_id": "b8f5c603-89cd-3b6c-a32a-2036046b26e9",
                        "glosses": [
                            "Justaucorps, chemise ou habit d’étoffe piquée qui couvrait le corps du cou jusqu’à la ceinture.",
                            "Cotte d’armes en taffetas, rembourrée, qui se portait sous l’armure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff6a570-0f94-4072-8ad4-20c6ec6b5a07",
                                "sense_id": "af5a79bd-8a07-303b-98e2-8527e06c15a5",
                                "text": "pourpoint de sental."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd64afdb-5f6c-329f-be28-96e4ba487df4",
                        "entry_id": "b8f5c603-89cd-3b6c-a32a-2036046b26e9",
                        "glosses": [
                            "Morceau d’un lapin, d’un lièvre."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1ec1189e-9693-42fe-a57e-1779b0bc512a",
                                "sense_id": "fd64afdb-5f6c-329f-be28-96e4ba487df4",
                                "text": "M. de Chevreuse se hâtait de manger quelque pourpoint de lapin, quelque grillade, enfin ce qui avait le moins de suc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d8c70b4-960d-49d5-8a36-b31854000b63",
                        "source_entry_id": "b8f5c603-89cd-3b6c-a32a-2036046b26e9",
                        "target_lang_word": "Wams",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wams",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f520efe-3aa7-3705-9822-d4c5de79d823",
                                        "entry_id": "7b407501-0e63-34df-936a-3dc6325c14cc",
                                        "glosses": [
                                            "Kleidungsstück, das die Ritter unter ihrer Rüstung (Harnisch) oder ihrem Lentner trugen und das bis über die Hüften reichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f0d4280-abbf-49f4-adfa-0c0b48c5f0f0",
                                                "sense_id": "5f520efe-3aa7-3705-9822-d4c5de79d823",
                                                "text": "„Unter der Rüstung aus Metall und dem wattierten Wams konnte es im Sommer sehr heiß werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0cf01e86-abd9-3eb3-97a7-b8459946f5a7",
                                        "entry_id": "7b407501-0e63-34df-936a-3dc6325c14cc",
                                        "glosses": [
                                            "für die Männerbekleidung in der Zeit des 16.–17. Jahrhunderts charakteristische Jacke, die oftmals wattiert und gesteppt war"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9340bc8f-01ef-4691-9358-4e073016d7f6",
                                                "sense_id": "0cf01e86-abd9-3eb3-97a7-b8459946f5a7",
                                                "text": "„Sein Umhang aus schwarzem Moiré war mit einer von Diamantnadeln gehaltenen Spitze bedeckt. Darunter wurde ein mit erlesenster schwarzer Spitze verziertes Wams aus Silberbrokat sichtbar.“"
                                            },
                                            {
                                                "example_id": "c964dedf-7a36-42a2-93f5-4e4e505581fa",
                                                "sense_id": "0cf01e86-abd9-3eb3-97a7-b8459946f5a7",
                                                "text": "„Sein Wams war ihm zu weit geworden und nur die angenestelte Schamkapsel hielt die Beinkleider noch oben.“"
                                            },
                                            {
                                                "example_id": "d542000c-bdc1-41d9-9972-f6c1ea5dc0e3",
                                                "sense_id": "0cf01e86-abd9-3eb3-97a7-b8459946f5a7",
                                                "text": "„Der deutsche Quartierwirt guckte in Wams und Zipfelmütze, in der Hand die Mistgabel, mit der er den Kuhstall ausgemistet hatte, aus der Stalltür.“"
                                            },
                                            {
                                                "example_id": "c26b68c3-bf89-40a7-8f62-2405ff427dc4",
                                                "sense_id": "0cf01e86-abd9-3eb3-97a7-b8459946f5a7",
                                                "text": "„Dann erhielt er von ihnen Unterzeug, eine Frieshose, ein Wams und Holzschuhe, jedoch keine Strümpfe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d093ab51-8b5f-3dcb-aae0-dbe90575aad9",
                                        "entry_id": "7b407501-0e63-34df-936a-3dc6325c14cc",
                                        "glosses": [
                                            "(insbesondere zu bestimmten Trachten gehöriges) zumeist hochgeschlossenes, eng anliegendes Kleidungsstück für Männer, das den Oberkörper bis zur Taille bedeckt"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c17a9275-d209-4ea3-b345-d581052be4f8",
                                                "sense_id": "d093ab51-8b5f-3dcb-aae0-dbe90575aad9",
                                                "text": "Die traditionelle Tracht unserer Gegend besteht aus einem groben Filzhut, kunstvoll bestickten Beinkleidern und einem roten Wams."
                                            },
                                            {
                                                "example_id": "326105f0-6e2b-425a-9ca5-c0a22dc691d6",
                                                "sense_id": "d093ab51-8b5f-3dcb-aae0-dbe90575aad9",
                                                "text": "„Er trug ein weißes Hemd mit Schlips unter dem Wams, und in Magnus á Gerdunums Kleidergeschäft hatte er sich eine dänische Hose mit Bügelfalten gekauft.“"
                                            },
                                            {
                                                "example_id": "edd1e578-4d32-43ad-ad72-27578bde7535",
                                                "sense_id": "d093ab51-8b5f-3dcb-aae0-dbe90575aad9",
                                                "text": "„Ein blauäugiger Mann in schwarzseidenem Wams steht hinter dem Ladentisch, er guckt auf den Preiszettel und antwortet: Achtzehn Rubel.“"
                                            },
                                            {
                                                "example_id": "8fdcf36c-675b-4832-8433-6e41676b4eea",
                                                "sense_id": "d093ab51-8b5f-3dcb-aae0-dbe90575aad9",
                                                "text": "„Kant schiebt seine linke Hand in das Wams, schaut Lampe – ein wenig selbstzufrieden – an und läßt ihn abtreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
