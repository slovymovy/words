                                "example_id": "1606bf96-77d8-4f8c-b437-e88605abcec1",
                                "sense_id": "cacbdd99-ad25-36df-b541-9dbe53990bed",
                                "text": "„Eines Wintermorgens, als das Paar vor der Hütte saß, tauchte plötzlich ein Kamelreiter auf und ritt geradewegs zum Fort.“"
                            }
