                        "glosses": [
                            "Of or pertaining to school; scholastic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92e147a8-524d-40d1-b9f2-d4f785638326",
                                "sense_id": "0f811192-8a2f-3ec1-a865-c164189c35eb",
                                "text": "[...] it has studied the trend of the school, but not the trend of business, its leadership has been scholastic, not commercial. Today, commercial education finds itself of the school, schoolish, and not of the business house, business-like."
                            },
                            {
                                "example_id": "ce09c59b-f0ce-4b03-b62d-6759639e619c",
                                "sense_id": "0f811192-8a2f-3ec1-a865-c164189c35eb",
                                "text": "By assessing this situation we have come to consider the dimensions of pedagogical–didactic interaction and communication that we, together with Antonio Viñao Frago (1996) and others, consider to be just as essential for examining the particular nature of schoolish institutions."
                            },
                            {
                                "example_id": "5fdce885-5d05-4288-8449-f2f54713ec7e",
                                "sense_id": "0f811192-8a2f-3ec1-a865-c164189c35eb",
                                "text": "As a struggling student, Lo was fed up with “schoolish practices” and refused to perform for the sake of pleasing her teachers."
                            }
                        ]
                    },
                    {
                        "sense_id": "16f21782-8ee4-32ed-9b74-1e277cc90d91",
                        "entry_id": "6b3a5315-b41b-3172-b01f-b1c9bd7e2850",
                        "glosses": [
                            "Characteristic of school rather than real life; pedantic, pedagogical, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96f46563-1f76-4f97-ba2a-02a4a1ea1ec0",
                                "sense_id": "16f21782-8ee4-32ed-9b74-1e277cc90d91",
                                "text": "Its structure, which could strike one as derived from an arithmetic or geometry lesson, is schoolish, as is its content..."
                            },
                            {
                                "example_id": "dbd2d6fc-e1a9-4b10-b2ca-e58758c7ae45",
                                "sense_id": "16f21782-8ee4-32ed-9b74-1e277cc90d91",
                                "text": "When we reflect on it, many of the things we teachers do are artificial and schoolish. They look very different from how real readers, writers, and speakers operate."
                            }
                        ]
                    }
