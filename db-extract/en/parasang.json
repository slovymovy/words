                "senses": [
                    {
                        "sense_id": "3d9ada79-44b8-3209-99d7-fee58f64503c",
                        "entry_id": "fd82c8f2-2e32-3399-aaa5-9cb119d51330",
                        "glosses": [
                            "A historical Iranian unit of itinerant distance used throughout the Western Mediterranean and the Middle East in antiquity, originally the distance travelled in one hour, and generally assumed to be equivalent to about six kilometres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6c04936-a254-41ad-82cc-a7a1df3eed60",
                                "sense_id": "3d9ada79-44b8-3209-99d7-fee58f64503c",
                                "text": "To see so much difference betwixt words and deeds, so many parasangs betwixt tongue and heart […]."
                            },
                            {
                                "example_id": "71d8fbd7-5d74-40d9-9a5a-f0217ddd6d97",
                                "sense_id": "3d9ada79-44b8-3209-99d7-fee58f64503c",
                                "text": "We were told that we still had to drive six or sixty parasang."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58b279e2-e762-4b67-837c-0781962c9f6d",
                        "source_entry_id": "fd82c8f2-2e32-3399-aaa5-9cb119d51330",
                        "source_sense_id": "3d9ada79-44b8-3209-99d7-fee58f64503c",
                        "source_sense_description": "historical Iranian unit of distance",
                        "target_lang_word": "parasange",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parasange",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03914c07-2202-3663-a0a9-6186d55cba38",
                                        "entry_id": "ac379beb-0791-3b12-a639-9fa324648c44",
                                        "glosses": [
                                            "Mesure de distance chez les anciens Perses."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16b9b05f-5079-45ad-88eb-2bf263f78c5d",
                                                "sense_id": "03914c07-2202-3663-a0a9-6186d55cba38",
                                                "text": "La parasange primitive des Chaldéens est de 10000 coudées royales égyptiennes, et sa valeur de 5250 mètres."
                                            },
                                            {
                                                "example_id": "52fe4909-5602-4905-afab-faf2381bf398",
                                                "sense_id": "03914c07-2202-3663-a0a9-6186d55cba38",
                                                "text": "Au temps de Khayyam, elle [la ville d’Ispahan] n’existe pas encore, mais une muraille a été construite, longue de trois parasanges, soit une douzaine de milles, destinée à protéger l’ensemble de l’oasis."
                                            },
                                            {
                                                "example_id": "c4a7e511-1e1e-4d50-ac19-02fffe91cded",
                                                "sense_id": "03914c07-2202-3663-a0a9-6186d55cba38",
                                                "text": "Le marché aux livres du Khark, au sud de la Ville ronde, était incontestablement le plus étendu du monde : plus d’un parasange de long !"
                                            },
                                            {
                                                "example_id": "09bea333-a0a9-4adf-81db-60c1bf097105",
                                                "sense_id": "03914c07-2202-3663-a0a9-6186d55cba38",
                                                "text": "La parasange répond à environ cinq mille mètres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
