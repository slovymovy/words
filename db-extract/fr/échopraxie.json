                    {
                        "sense_id": "521c4f08-e262-34dc-91b9-1e88ab7658b1",
                        "entry_id": "0a82652d-f8fc-3d06-bb37-5d073a6e3c5a",
                        "glosses": [
                            "Trouble psychologique où le sujet reproduit les gestes de l’examinateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a87fdf4a-0f21-4874-b08a-2d48cafd7a6c",
                                "sense_id": "521c4f08-e262-34dc-91b9-1e88ab7658b1",
                                "text": "On constatait la lenteur de ses mouvements, sans maladresse appréciable, de l’écholalie et de l’échopraxie, ce qui la gênait beaucoup dans son travail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a2c77c3-4a7c-4f81-a69d-c31dc684cb85",
                        "source_entry_id": "0a82652d-f8fc-3d06-bb37-5d073a6e3c5a",
                        "source_sense_id": "521c4f08-e262-34dc-91b9-1e88ab7658b1",
                        "target_lang_word": "Echopraxie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Echopraxie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdebc9c6-4b11-3d2e-8e92-442bb1a30382",
                                        "entry_id": "e93c38ed-cb13-34f6-8aa6-1b601920e9c5",
                                        "glosses": [
                                            "zwanghafte Wiederholung oder Nachahmung oder beobachteten Bewegungen einer anderen Person"
                                        ],
                                        "tags": [
                                            "Psychiatrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "120f5de1-83f1-4c3b-99c8-33d66e454f74",
                                                "sense_id": "cdebc9c6-4b11-3d2e-8e92-442bb1a30382",
                                                "text": "Zu den möglichen Symptomen des Tourette-Syndroms gehört neben der Koprolalie, der Kopropraxie und der Echolalie auch die Echopraxie."
                                            },
                                            {
                                                "example_id": "3f511c8b-3018-45e0-8536-4ee5f4a81880",
                                                "sense_id": "cdebc9c6-4b11-3d2e-8e92-442bb1a30382",
                                                "text": "Die Spiegelneurone können jedoch gebremst werden, so dass nicht jede vorgemachte Handlung aus ausgeführt wird. Bei Echopraxien scheint dieser Hemmmechanismus nicht zu funktionieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d6d1ef3-7696-49f7-8611-d0987796f989",
                        "source_entry_id": "0a82652d-f8fc-3d06-bb37-5d073a6e3c5a",
                        "source_sense_id": "521c4f08-e262-34dc-91b9-1e88ab7658b1",
