                        "translation_id": "f6f752bf-6d47-43e1-b9ad-2460e5fcd3f1",
                        "source_entry_id": "383d871e-4866-339f-8ade-d25d16fd45fd",
                        "source_sense_id": "942e74a1-4192-35f5-bcdf-3ea64ce8a16c",
                        "target_lang_word": "styrofoam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "styrofoam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba01ea3a-4de9-3c27-ad5c-af6c51733ebb",
                                        "entry_id": "7517037c-6565-38b5-b648-77e42d28deed",
                                        "glosses": [
                                            "Expanded polystyrene foam, such as is used in cups and packaging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b3287a9-b96a-4e30-a9f7-49c8ad358cb6",
                                                "sense_id": "ba01ea3a-4de9-3c27-ad5c-af6c51733ebb",
                                                "text": "A while ago I read your column concerning the effects of hot tea on styrofoam cups."
                                            },
                                            {
                                                "example_id": "0a7988d4-419b-4649-a97f-49a853f6d758",
                                                "sense_id": "ba01ea3a-4de9-3c27-ad5c-af6c51733ebb",
                                                "text": "In the past two years, NASA’s Kepler Space Telescope has located nearly 3,000 exoplanet candidates ranging from sub-Earth-sized minions to gas giants that dwarf our own Jupiter. Their densities range from that of styrofoam to iron."
                                            },
                                            {
                                                "example_id": "322cd530-eecf-4dd2-9a85-c7845026fe2b",
                                                "sense_id": "ba01ea3a-4de9-3c27-ad5c-af6c51733ebb",
                                                "text": "Expanded polystyrene foam—commonly, although incorrectly, called Styrofoam—has been the subject of a protracted battle between New York City officials and large industry players, particularly Dart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e6f3566-41b5-4396-8dac-7586ba4af1e1",
                        "source_entry_id": "383d871e-4866-339f-8ade-d25d16fd45fd",
                        "source_sense_id": "942e74a1-4192-35f5-bcdf-3ea64ce8a16c",
                        "target_lang_word": "polystyrène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polystyrène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a366cad-9fb2-34e8-ae71-091a1acc5abf",
                                        "entry_id": "bb761718-3859-3c40-b676-aba2c50343cb",
                                        "glosses": [
                                            "Thermoplastique obtenu par la polymérisation des monomères de styrène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edcd2237-8599-42dc-b75f-6b7e20ba7f40",
                                                "sense_id": "4a366cad-9fb2-34e8-ae71-091a1acc5abf",
                                                "text": "Dans les marchés, les emballages en feuilles de bananier ont laissé place au plastique et parmi les stands, il en est souvent un qui vend aux commerçants les sacs en plastique et boîtes en polystyrène dont ils font un usage abondant."
                                            },
                                            {
                                                "example_id": "aeda07a0-4e9c-4efa-be4f-aa7493a84b32",
                                                "sense_id": "4a366cad-9fb2-34e8-ae71-091a1acc5abf",
                                                "text": "Le gaillard l’ouvrit, en ahanant sous l’effort que représentait l’introduction d’une machine à laver engrossée de parements en polystyrène, dans un lieu où tout avait été calculé pour décourager l’accès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aac7eac-4bd3-30a7-80c0-0442e0d66ab9",
                                        "entry_id": "bb761718-3859-3c40-b676-aba2c50343cb",
                                        "glosses": [
                                            "Polystyrène expansé, mousse blanche et compacte, constituée de ce thermoplastique, utilisée le plus souvent comme isolant thermique et comme emballage."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df69abdf-a280-4b05-847e-29056e811052",
                                                "sense_id": "6aac7eac-4bd3-30a7-80c0-0442e0d66ab9",
                                                "text": "À mes pieds, les reliefs d'un kebab gisaient dans une boîte en polystyrène jaune. Avec les remugles de sauce samouraï, un souvenir remonta à la surface : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
