                                    {
                                        "sense_id": "498d965b-e5cc-3632-88a7-c22b8854c7ee",
                                        "entry_id": "ea9a1789-aeb1-3f18-bdaa-a39544753e8b",
                                        "glosses": [
                                            "Closeness; the state of being near as in space, time, or relationship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
