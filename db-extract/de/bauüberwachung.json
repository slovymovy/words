                        "examples": [
                            {
                                "example_id": "a18d0364-3f08-4173-b9ab-91d6ee2a2dae",
                                "sense_id": "f73f8538-3842-3025-a054-6e939f066d40",
                                "text": "„Die Bauüberwachung ist Aufgabe von zwei unterschiedlichen Verantwortlichen.“"
                            },
                            {
                                "example_id": "ebfe627f-f563-481f-bec2-17878455614b",
                                "sense_id": "f73f8538-3842-3025-a054-6e939f066d40",
                                "text": "„Das Honorar für die örtliche Bauüberwachung kann mit 2,1 bis 3,2 v. H. der anrechenbaren Kosten nach § 52 Abs.2, 3, 6 und 7 vereinbart werden.“"
                            },
                            {
                                "example_id": "a08769d1-3c3c-4eae-b60f-bc3a49b56938",
                                "sense_id": "f73f8538-3842-3025-a054-6e939f066d40",
                                "text": "„Ein Bauherr verlangt von den mit den Leistungsphasen 1 bis 8 beauftragten Architekten Schadensersatz in Höhe von € 1,55 Mio. mit der Begründung, sie seien infolge fehlerhafter Bauüberwachung dafür verantwortlich, dass … statt raumbeständigem Recyclingmaterial zum Teil nicht raumbeständige Schlacke eingebaut wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
