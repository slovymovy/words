                        "cross_references": []
                    },
                    {
                        "translation_id": "ca9cb49d-600a-409e-8f14-6e7a9b753f0c",
                        "source_entry_id": "584a1abf-8198-3b8e-bace-cfa3e24d4a10",
                        "target_lang_word": "vector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6255d5-445b-37ca-bc67-a92ee98657df",
                                        "entry_id": "5cef92bd-dad1-348c-b302-6609d8235f6e",
                                        "glosses": [
                                            "A directed quantity, one with both magnitude and direction; the signed difference between two points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f29a5eef-4729-415d-b685-3118da725abe",
                                                "sense_id": "7d6255d5-445b-37ca-bc67-a92ee98657df",
                                                "text": "Velocity is a vector defined by the speed of an object and its direction."
                                            },
                                            {
                                                "example_id": "ffa2ea49-dbfa-4b74-962c-7cd607c0f69c",
                                                "sense_id": "7d6255d5-445b-37ca-bc67-a92ee98657df",
                                                "text": "As examples of vector quantities may be mentioned the distance between any two given points, a velocity, a force, an acceleration, angular velocity, intensity of magnetization flux of heat."
                                            },
                                            {
                                                "example_id": "262d6414-44d2-44e9-9439-07e655d7c506",
                                                "sense_id": "7d6255d5-445b-37ca-bc67-a92ee98657df",
                                                "text": "I was told to fly out on a vector of 100 degrees to meet a strong plot of aircraft 30 miles from the coast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cacc661b-a1d8-3b12-a0ed-bb1d723e7aef",
                                        "entry_id": "5cef92bd-dad1-348c-b302-6609d8235f6e",
                                        "glosses": [
                                            "A directed quantity, one with both magnitude and direction; the signed difference between two points.",
                                            "Any member of a (generalized) vector space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a781580-c036-4ed6-be1c-bd54f59ddf07",
                                                "sense_id": "cacc661b-a1d8-3b12-a0ed-bb1d723e7aef",
                                                "text": "The vectors in #123;#92;mathbbQ#125;#91;X#93; are the single-variable polynomials with rational coefficients: one is #92;textstylex#123;42#125;#43;#92;frac1#123;137#125;x-1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a838d16-4117-3cc3-8c66-ce8d7270c8a7",
                                        "entry_id": "5cef92bd-dad1-348c-b302-6609d8235f6e",
                                        "glosses": [
                                            "A directed quantity, one with both magnitude and direction; the signed difference between two points.",
                                            "An ordered tuple, originally one representing a directed quantity, but by extension any one-dimensional matrix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba38ad87-151d-4727-9a03-43e706d76305",
                                                "sense_id": "7a838d16-4117-3cc3-8c66-ce8d7270c8a7",
                                                "text": "Computers store many types of data as vectors for ease of processing."
                                            },
                                            {
                                                "example_id": "03af3227-a0cb-4c77-88bc-95511fab342f",
                                                "sense_id": "7a838d16-4117-3cc3-8c66-ce8d7270c8a7",
                                                "text": "A row vector is a matrix whose M dimension is 1. In fact, a row vector is a matrix consisting of a single row, and a column vector a matrix consisting of a single column."
                                            },
                                            {
                                                "example_id": "60303e36-a3cc-4a8b-a874-3d4ef0a520d8",
                                                "sense_id": "7a838d16-4117-3cc3-8c66-ce8d7270c8a7",
                                                "text": "Color is stored as a vector attribute (R, G, B)."
                                            },
                                            {
                                                "example_id": "26b28d4c-eb14-44cd-b5fa-fdc87a696141",
                                                "sense_id": "7a838d16-4117-3cc3-8c66-ce8d7270c8a7",
                                                "text": "GPU cores are essentially vector-processing units, capable of applying the same instruction on a large collection of operands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "142cc336-0904-37ba-9248-e3c330685dc1",
                                        "entry_id": "5cef92bd-dad1-348c-b302-6609d8235f6e",
                                        "glosses": [
                                            "A directed quantity, one with both magnitude and direction; the signed difference between two points.",
                                            "A chosen course or direction for motion, as of an aircraft."
                                        ],
                                        "tags": [],
