                        "examples": [
                            {
                                "example_id": "7f78cf82-7b1a-4a6c-b3d4-af93e6f783de",
                                "sense_id": "9efae0d1-4fdb-36de-9791-9ea2b5183c9d",
                                "text": "Un vent de correctitude politique souffle sur l'Amérique. Toutefois, l’autre est généralement absent de la table de discussion, occupé qu'il est à se battre sur le terrain contre la discrimination."
                            },
                            {
                                "example_id": "c72f37ed-a1d6-4c2a-8094-379290672edd",
                                "sense_id": "9efae0d1-4fdb-36de-9791-9ea2b5183c9d",
                                "text": "Disant non à la correctitude politique d'une certaine gauche, je hurle aussi un non tonitruant aux correctitudes de droite et profondément réactionnaires et régressives, basées sur le mépris de ceux qui sont les plus mal pris."
                            }
