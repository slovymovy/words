                                        "sense_id": "d2688adc-2a83-342a-8a8c-ba79080e2e45",
                                        "entry_id": "e77afc5c-a2c5-365a-b6bc-9054ee21d382",
                                        "glosses": [
                                            "Personne qui est affectée de misonéisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d52cee5-6c8a-4e80-8354-1f44de6f9b70",
                                                "sense_id": "d2688adc-2a83-342a-8a8c-ba79080e2e45",
                                                "text": "Au risque de passer pour un misonéiste, je préférerais pour ma part qu’elles restent dans leur isolement séculaire, partageant ici l’aversion de Wilfred Thesiger pour le progrès inconsidéré."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "misonéiste",
