                "senses": [
                    {
                        "sense_id": "9c9b59f0-3ece-3dd9-ba6c-614bb81194a9",
                        "entry_id": "0d6d62c3-af61-3869-b9be-7d648a2f927b",
                        "glosses": [
                            "Partie de la zoologie qui traite des reptiles et des amphibiens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d052564-f217-47cf-80ca-ef756480db80",
                                "sense_id": "9c9b59f0-3ece-3dd9-ba6c-614bb81194a9",
                                "text": "Le 17ᵉ congrès européen d’herpétologie s’est tenu du 22 au 27 août 2013 à Veszprém en Hongrie."
                            },
                            {
                                "example_id": "e8165af3-7d27-461c-b068-11b57bf7b58c",
                                "sense_id": "9c9b59f0-3ece-3dd9-ba6c-614bb81194a9",
                                "text": "Le Cameroun est sans doute le pays d’Afrique Centrale qui a suscité le plus de travaux en herpétologie."
                            },
                            {
                                "example_id": "bb3a49d8-3cd4-4b02-9790-5a8be7231ed5",
                                "sense_id": "9c9b59f0-3ece-3dd9-ba6c-614bb81194a9",
                                "text": "Maud Berroneau et son collègue Xavier Gautron, service civique déjà bien rodé à l’herpétologie, la libèrent de cette prison provisoire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46557c60-a217-4794-96df-3c0e26e886da",
                        "source_entry_id": "0d6d62c3-af61-3869-b9be-7d648a2f927b",
                        "source_sense_id": "9c9b59f0-3ece-3dd9-ba6c-614bb81194a9",
                        "target_lang_word": "Herpetologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herpetologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f34a97ed-7260-365e-a1ef-f199c79a9120",
                                        "entry_id": "6cc4dce8-6e3a-3b45-941c-661542c66a1a",
                                        "glosses": [
                                            "Teilgebiet der Zoologie, das sich mit der Erforschung der Lurche und Kriechtiere befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fa440c5-61ca-4312-924f-571572b8dc08",
                                                "sense_id": "f34a97ed-7260-365e-a1ef-f199c79a9120",
                                                "text": "„Die Herpetologie umfasste alle Amphibien, Schlangen, Saurier, Krokodile und Schildkröten.“"
                                            },
                                            {
                                                "example_id": "95053aac-de25-498f-981e-3a3532a7193d",
                                                "sense_id": "f34a97ed-7260-365e-a1ef-f199c79a9120",
                                                "text": "„Als ich meine Doktorarbeit in Herpetologie schrieb, hatte ich einen Zimmergenossen, der so eifersüchtig auf mich war, weil ich eine neue Kröte entdeckt hatte, dass er sie mir stahl und sie aufaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
