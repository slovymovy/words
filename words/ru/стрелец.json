                            {
                                "target_lang_word": "Sagittarian",
                                "target_lang_sense_clarification": "person born under the sign of Sagittarius"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c6940ce-749e-350c-9ca5-39f95e6dacd9",
                    "sense_definition": "Тот, кто стреляет из лука, самострела или иного оружия; стрелок.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старый <w>стрелец</w> натянул тугую тетиву и точно поразил цель в центре поля.",
                            "target_lang_translations": {
                                "en": "The old <w>archer</w> pulled the tight bowstring and hit the target dead center in the middle of the field."
                            }
                        },
                        {
                            "text": "Искусный <w>стрелец</w> без промаха поражал врагов на значительном расстоянии.",
                            "target_lang_translations": {
                                "en": "The skilled <w>marksman</w> struck enemies from a considerable distance without missing."
                            }
