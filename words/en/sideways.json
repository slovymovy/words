{
    "word_family": [
        "sideway",
        "sideward",
        "sidewise"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1a112fa3-9461-3c15-a541-bec182593d4e",
                    "sense_definition": "Towards one side or to the side.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crab walked <w>sideways</w> across the sandy beach.",
                            "target_lang_translations": {
                                "it": "Il granchio camminava <w>di lato</w> sulla spiaggia sabbiosa."
                            }
                        },
                        {
                            "text": "She took a step <w>sideways</w> to let the cyclists pass.",
                            "target_lang_translations": {
                                "it": "Fece un passo <w>di lato</w> per far passare i ciclisti."
                            }
                        }
                    ],
                    "synonyms": [
                        "laterally",
                        "sideward",
                        "sidewise"
                    ],
                    "antonyms": [
                        "backwards",
                        "forwards"
                    ],
                    "common_phrases": [
                        "step sideways",
                        "glance sideways"
                    ],
                    "target_lang_definitions": {
                        "it": "Verso un lato o lateralmente."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "lateralmente",
                                "target_lang_sense_clarification": "di lato, verso il lato"
                            },
                            {
                                "target_lang_word": "di lato",
                                "target_lang_sense_clarification": "verso un fianco o direzione laterale"
                            },
                            {
                                "target_lang_word": "di traverso",
                                "target_lang_sense_clarification": "in obliquo o lateralmente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93364948-ef21-3023-97c5-f431b0a8db05",
                    "sense_definition": "With a side facing forward or in a particular direction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Turn the sofa <w>sideways</w> so that it fits through the narrow doorway.",
                            "target_lang_translations": {
                                "it": "Gira il divano <w>di fianco</w> in modo che passi attraverso la porta stretta."
                            }
                        },
                        {
                            "text": "He parked his car <w>sideways</w> across two parking spaces.",
                            "target_lang_translations": {
                                "it": "Ha parcheggiato la macchina <w>di traverso</w> occupando due posti auto."
                            }
                        }
                    ],
                    "synonyms": [
                        "broadside",
                        "sidewise"
                    ],
                    "common_phrases": [
                        "turn sideways"
                    ],
                    "target_lang_definitions": {
                        "it": "Con il fianco o il lato rivolto in avanti o in una determinata direzione."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "di fianco",
                                "target_lang_sense_clarification": "orientato con il fianco"
                            },
                            {
                                "target_lang_word": "di traverso",
                                "target_lang_sense_clarification": "in posizione trasversale"
                            },
                            {
                                "target_lang_word": "per il largo",
                                "target_lang_sense_clarification": "in senso orizzontale o trasversale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35ad8d67-df73-3a06-81e0-ec4b55031564",
                    "sense_definition": "Wrongly, unexpectedly, or towards an unfavorable outcome.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meeting could go <w>sideways</w> if we bring up the budget issues.",
                            "target_lang_translations": {
                                "it": "La riunione potrebbe mettersi <w>male</w> se solleviamo le questioni di bilancio."
                            }
                        },
                        {
                            "text": "Everything seemed fine until the entire plan started going <w>sideways</w>.",
                            "target_lang_translations": {
                                "it": "Sembrava andare tutto bene finché l'intero piano non ha iniziato ad andare <w>a rotoli</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go sideways"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe situations that go wrong"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Male, in modo storto o con un esito sfavorevole."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "storto",
                                "target_lang_sense_clarification": "andare male o per il verso sbagliato"
                            },
                            {
                                "target_lang_word": "a rotoli",
                                "target_lang_sense_clarification": "finire male, andare in rovina"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecf97bcf-1d45-3925-81d1-12aef99ea545",
                    "sense_definition": "With suspicion, disapproval, or indirect glance; askance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked <w>sideways</w> at his colleague when the strange story was told.",
                            "target_lang_translations": {
                                "it": "Ha guardato il collega <w>di sbieco</w> quando è stata raccontata quella strana storia."
                            }
                        },
                        {
                            "text": "The detective peered <w>sideways</w> at the suspect to gauge his honest reaction.",
                            "target_lang_translations": {
                                "it": "Il detective ha sbirciato il sospettato <w>con la coda dell'occhio</w> per valutare la sua reazione spontanea."
                            }
                        }
                    ],
                    "synonyms": [
                        "askance",
                        "askant",
                        "sidelong"
                    ],
                    "antonyms": [
                        "directly"
                    ],
                    "common_phrases": [
                        "look sideways"
                    ],
                    "target_lang_definitions": {
                        "it": "Con sospetto, disapprovazione o con lo sguardo di sottecchi."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "di sbieco",
                                "target_lang_sense_clarification": "guardare con la coda dell'occhio o con diffidenza"
                            },
                            {
                                "target_lang_word": "in cagnesco",
                                "target_lang_sense_clarification": "con disapprovazione o sospetto"
                            },
                            {
                                "target_lang_word": "di traverso",
                                "target_lang_sense_clarification": "guardare male qualcuno"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf9503e0-eb7e-32cf-b451-fbb513f6c049",
                    "sense_definition": "Without significant upward or downward progress; remaining flat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stock market traded <w>sideways</w> for most of the summer.",
                            "target_lang_translations": {
                                "it": "Il mercato azionario si è mosso <w>in laterale</w> per gran parte dell'estate."
                            }
                        },
                        {
                            "text": "Company profits have been drifting <w>sideways</w> instead of growing as anticipated.",
                            "target_lang_translations": {
                                "it": "I profitti aziendali sono rimasti <w>stazionari</w> invece di crescere come previsto."
                            }
                        }
                    ],
                    "common_phrases": [
                        "move sideways",
                        "trade sideways"
                    ],
                    "target_lang_definitions": {
                        "it": "Senza significativi rialzi o ribassi; in modo stabile o orizzontale."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "in laterale",
                                "target_lang_sense_clarification": "senza variazioni di rilievo nei mercati"
                            },
                            {
                                "target_lang_word": "lateralmente",
                                "target_lang_sense_clarification": "senza salire né scendere"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "28b2c431-134a-3ed8-96df-819a561ebd97",
                    "sense_definition": "Moving or directed toward one side.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She cast a <w>sideways</w> glance at her watch during the boring lecture.",
                            "target_lang_translations": {
                                "it": "Ha lanciato un'occhiata <w>furtiva</w> al suo orologio durante la noiosa lezione."
                            }
                        },
                        {
                            "text": "A sudden gust of wind gave the light plane a sharp <w>sideways</w> jolt.",
                            "target_lang_translations": {
                                "it": "Un'improvvisa raffica di vento ha dato all'ultraleggero una brusca scossa <w>laterale</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sidelong",
                        "sideward"
                    ],
                    "common_phrases": [
                        "sideways glance",
                        "sideways look"
                    ],
                    "target_lang_definitions": {
                        "it": "Che si muove o è orientato verso un lato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "laterale",
                                "target_lang_sense_clarification": "rivolto o diretto di lato"
                            },
                            {
                                "target_lang_word": "di sbieco",
                                "target_lang_sense_clarification": "obliquo, furtivo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21ec94cb-f9b3-36d8-92f9-bf39ec7033d4",
                    "sense_definition": "Turned or placed with one of the sides facing the front.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book sat in a <w>sideways</w> position on the narrow shelf.",
                            "target_lang_translations": {
                                "it": "Il libro era posizionato <w>di costa</w> sulla mensola stretta."
                            }
                        },
                        {
                            "text": "She noticed that the portrait on the wall had a strange, <w>sideways</w> tilt.",
                            "target_lang_translations": {
                                "it": "Notò che il ritratto sul muro aveva una strana inclinazione <w>laterale</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Girato o posizionato con uno dei lati rivolto in avanti; inclinato di lato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "inclinato",
                                "target_lang_sense_clarification": "piegato di lato"
                            },
                            {
                                "target_lang_word": "girato di lato",
                                "target_lang_sense_clarification": "posto sul fianco"
                            },
                            {
                                "target_lang_word": "obliquo",
                                "target_lang_sense_clarification": "non dritto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f4e570f-e4d0-399d-9d1c-03283351792e",
                    "sense_definition": "Showing little or no movement upward or downward; flat or horizontal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Analysts predict that the company will remain in a <w>sideways</w> trend for months.",
                            "target_lang_translations": {
                                "it": "Gli analisti prevedono che l'azienda rimarrà in un trend <w>laterale</w> per mesi."
                            }
                        },
                        {
                            "text": "Investors struggled to make returns during the long <w>sideways</w> market.",
                            "target_lang_translations": {
                                "it": "Gli investitori hanno faticato a ottenere rendimenti durante il lungo mercato <w>stazionario</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sideways trend",
                        "sideways market"
                    ],
                    "target_lang_definitions": {
                        "it": "Che mostra variazioni minime o nulle in salita o discesa; orizzontale o stazionario."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "laterale",
                                "target_lang_sense_clarification": "riferito a mercato o andamento piatto"
                            },
                            {
                                "target_lang_word": "piatto",
                                "target_lang_sense_clarification": "senza crescita né cali"
                            },
                            {
                                "target_lang_word": "stazionario",
                                "target_lang_sense_clarification": "fermo, senza oscillazioni rilevanti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2545b57-5d15-36fa-b6d7-13c0a526b51d",
                    "sense_definition": "In disagreement, opposition, or conflict with someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He found himself getting <w>sideways</w> with the manager over the new office policies.",
                            "target_lang_translations": {
                                "it": "Si è ritrovato a entrare <w>in rotta</w> con il responsabile a causa delle nuove regole d'ufficio."
                            }
                        },
                        {
                            "text": "Try not to get <w>sideways</w> with the local authorities during your trip.",
                            "target_lang_translations": {
                                "it": "Cerca di non entrare <w>in contrasto</w> con le autorità locali durante il viaggio."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get sideways with"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe interpersonal conflict"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "In disaccordo, rottura o conflitto con qualcuno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "in rotta",
                                "target_lang_sense_clarification": "in cattivi rapporti con qualcuno"
                            },
                            {
                                "target_lang_word": "in contrasto",
                                "target_lang_sense_clarification": "in conflitto o disaccordo"
                            },
                            {
                                "target_lang_word": "ai ferri corti",
                                "target_lang_sense_clarification": "in forte contrasto o lite"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b87618d-d97b-381a-9b8a-9961b6e036e8",
                    "sense_definition": "Plural of <w>sideway</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers wandered through remote alleys and deserted <w>sideways</w> of the old town.",
                            "target_lang_translations": {
                                "it": "I viaggiatori vagavano per vicoli remoti e <w>stradine secondarie</w> deserte del centro storico."
                            }
                        },
                        {
                            "text": "Heavy traffic on the main avenues pushed commuters into the lesser-known <w>sideways</w>.",
                            "target_lang_translations": {
                                "it": "Il traffico intenso sui viali principali ha spinto i pendolari verso le <w>vie laterali</w> meno conosciute."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Plurale di sideway; viuzze secondarie o stradine laterali."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "stradine secondarie",
                                "target_lang_sense_clarification": "vie laterali o secondarie"
                            },
                            {
                                "target_lang_word": "vicoli",
                                "target_lang_sense_clarification": "viuzze laterali"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}