                ],
                "senses": [
                    {
                        "sense_id": "7e8ab526-6fbd-3dc2-9423-7384ab05e12e",
                        "entry_id": "d03baf0b-4999-3ec5-a77c-bcb74eb8edb0",
                        "glosses": [
                            "Geruch, der von Staub ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4513198-658c-420f-a539-ca07b4bef889",
                                "sense_id": "7e8ab526-6fbd-3dc2-9423-7384ab05e12e",
                                "text": "„Beim Einatmen drang mir nun ein durchdringender Staubgeruch in die Nase - ein Gestank, wie ich ihn nie zuvor gespürt hatte.“"
                            },
                            {
                                "example_id": "2adb6508-d82d-4125-a877-89fee75074bc",
                                "sense_id": "7e8ab526-6fbd-3dc2-9423-7384ab05e12e",
                                "text": "„Die Frauen trugen Sonntagskleidung, die Hauben griffbereit für die Fahrt, erneut außer der Greisin: Immer noch war sie eingemummt in ihre weite Tracht, weder Kleid noch Kittel, sondern irgendein undefinierbares Gewand, worin sie sich formlos und ungehindert bewegte, in einer Dunstglocke aus zartem Moschus, dem Staubgeruch alten Weiberfleisches, immun gegen Schmutz, wie Stein oder Lehm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
