                "senses": [
                    {
                        "sense_id": "30e06f0b-b8a2-3e4f-9619-9403513ef5d9",
                        "entry_id": "2c82b16d-52c9-3c77-92d3-1381946d8541",
                        "glosses": [
                            "aus Silber hergestellte Kette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0c5b5c2-b9c1-49dc-b1a7-1418d24bf809",
                                "sense_id": "30e06f0b-b8a2-3e4f-9619-9403513ef5d9",
                                "text": "Sie wünscht sich eine Silberkette zum Geburtstag."
                            },
                            {
                                "example_id": "fba2cd7c-a0ad-4228-8517-297d07f02196",
                                "sense_id": "30e06f0b-b8a2-3e4f-9619-9403513ef5d9",
                                "text": "„Ohne Skrupel trägt die Zigeunerin die Silberkette seiner Mutter, die er ebenfalls versteckt hatte, in ihrem Haar.“"
                            },
                            {
                                "example_id": "7e14e544-b4e8-43cf-952f-b1577fff6dc4",
                                "sense_id": "30e06f0b-b8a2-3e4f-9619-9403513ef5d9",
                                "text": "„Nach dem Gefecht von Ostrawa hatte Albrecht einem toten Kosaken eine Silberkette abgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
