                    {
                        "sense_id": "83b32c91-2ddf-34a9-adf4-ab9490904212",
                        "entry_id": "5c93842f-7b56-31b6-a370-74f037d3a194",
                        "glosses": [
                            "examen dat gedaan moet worden om tot een bepaalde school te worden toegelaten vóór het begin van de studie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a2b7642-2d89-4f5c-9247-9eecc17162b2",
                                "sense_id": "83b32c91-2ddf-34a9-adf4-ab9490904212",
                                "text": "„Mijn ouders moedigden me aan. Je kunt worden wat je wil, zeiden ze. Maar mijn wereld was klein; ik kende niemand die iets creatiefs deed. Voor het toelatingsexamen van de academie moest je werk overleggen. Ik had geen portfolio. Wisten mijn ouders veel. Ik heb, hoe heet dat tegenwoordig, een gap year genomen. Een jaar lang zat ik thuis gedisciplineerd te schetsen. Ik wilde zo graag.”"
                            }
                        ]
                    }
                ],
