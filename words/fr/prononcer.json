    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "02b3171e-9127-37bb-8890-d37ae3bee568",
                    "sense_definition": "Articuler des sons, des syllabes ou des mots à voix haute.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "articulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comment doit-on <w>prononcer</w> ce mot étranger ?"
                        },
                        {
                            "text": "L'enfant commence à bien <w>prononcer</w> toutes les lettres de l'alphabet."
                        }
                    ],
                    "synonyms": [
                        "articuler"
                    ],
                    "common_phrases": [
                        "prononcer un mot",
                        "prononcer distinctement"
                    ]
                },
                {
                    "sense_id": "4cf64afb-bdb6-3de9-9c4c-083164cfd9c9",
                    "sense_definition": "Débiter solennellement un texte ou des paroles devant un auditoire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur va <w>prononcer</w> un discours important devant toute l'assemblée."
                        },
                        {
                            "text": "Elle a <w>prononcé</w> quelques mots chaleureux lors de la cérémonie de départ."
                        }
                    ],
                    "common_phrases": [
                        "prononcer un discours"
                    ]
                },
                {
                    "sense_id": "2bfd20bf-0141-33af-b354-3714c0f81ef6",
                    "sense_definition": "Dire ou mentionner verbalement quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a refusé de <w>prononcer</w> son nom devant les enquêteurs."
                        },
                        {
                            "text": "Ne <w>prononcez</w> jamais ce terme blessant en présence des enfants."
                        }
                    ],
                    "synonyms": [
                        "dire"
                    ],
                    "common_phrases": [
                        "prononcer le nom"
                    ]
                },
                {
                    "sense_id": "44420fa0-dc0b-388c-a85d-856a1ffead85",
                    "sense_definition": "Manifester son avis ou prendre position formellement sur un sujet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comité refuse de se <w>prononcer</w> avant de recevoir les résultats complets."
                        },
                        {
                            "text": "Les électeurs devront se <w>prononcer</w> sur cette proposition lors du vote de dimanche."
                        }
                    ],
                    "common_phrases": [
                        "se prononcer sur",
                        "se prononcer pour"
                    ]
                },
                {
                    "sense_id": "163f6a98-94c3-39e5-a5ec-bf8add1e0533",
                    "sense_definition": "Déclarer officiellement et avec autorité une décision judiciaire ou un décret.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge doit <w>prononcer</w> le verdict avant la fin de la séance."
                        },
                        {
                            "text": "Le tribunal a <w>prononcé</w> une peine de travail d'intérêt général."
                        }
                    ],
                    "common_phrases": [
                        "prononcer un jugement",
                        "prononcer un verdict",
                        "prononcer une sentence"
                    ]
                }
            ]
        }
    ]
