    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23d7ac90-a1af-361b-abab-146276ccf15c",
                    "sense_definition": "To become worse in quality, condition, or value over time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather began to <w>deteriorate</w> rapidly as the storm clouds gathered over the mountains.",
                            "target_lang_translations": {
                                "ru": "Погода начала стремительно <w>ухудшаться</w>, когда над горами сгустились грозовые тучи."
                            }
                        },
                        {
                            "text": "Doctors are concerned that the patient's health might <w>deteriorate</w> further without immediate surgery.",
                            "target_lang_translations": {
                                "ru": "Врачи обеспокоены тем, что состояние здоровья пациента может еще больше <w>ухудшиться</w> без немедленной операции."
                            }
                        }
                    ],
                    "synonyms": [
                        "worsen",
                        "degenerate",
                        "weaken"
                    ],
                    "antonyms": [
                        "improve",
                        "better"
                    ],
                    "common_phrases": [
                        "deteriorate rapidly",
                        "health began to deteriorate",
                        "conditions deteriorate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться хуже по качеству, состоянию или стоимости с течением времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухудшаться",
                                "target_lang_sense_clarification": "становиться хуже"
                            },
                            {
                                "target_lang_word": "ухудшиться",
                                "target_lang_sense_clarification": "стать хуже (завершенное действие)"
                            },
                            {
                                "target_lang_word": "портиться",
                                "target_lang_sense_clarification": "о качестве или состоянии"
                            },
                            {
                                "target_lang_word": "разрушаться",
                                "target_lang_sense_clarification": "о физическом состоянии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccfeec79-1020-3ee7-9327-86911d42f4e0",
                    "sense_definition": "To make something worse or to impair its quality or value.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of neglect can <w>deteriorate</w> the structural integrity of even the strongest buildings.",
                            "target_lang_translations": {
                                "ru": "Годы пренебрежения могут <w>разрушить</w> структурную целостность даже самых прочных зданий."
                            }
                        },
                        {
                            "text": "Exposure to direct sunlight will <w>deteriorate</w> the fabric of the curtains over time.",
                            "target_lang_translations": {
                                "ru": "Воздействие прямых солнечных лучей со временем будет <w>портить</w> ткань штор."
                            }
                        }
                    ],
                    "synonyms": [
                        "worsen"
                    ],
                    "antonyms": [
                        "improve",
                        "revamp"
                    ],
                    "common_phrases": [
                        "deteriorate the mind",
                        "deteriorate the quality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо хуже или наносить ущерб качеству или ценности чего-либо."
                    },
