                "senses": [
                    {
                        "sense_id": "e981f762-2ff1-3373-84fa-737b9a6fd483",
                        "entry_id": "fdd6cbfc-df7d-3214-a3ff-7413347de2d8",
                        "glosses": [
                            "Either of two folded sheets of paper used to connect the front and back covers of a book to the first and last pages; one side of each endpaper is glued to the cover board, and the other side forms a flyleaf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0f0b346-a8a9-472c-a352-671133490e7f",
                                "sense_id": "e981f762-2ff1-3373-84fa-737b9a6fd483",
                                "text": "Meronyms: flyleaf, pastedown"
                            },
                            {
                                "example_id": "dcab95fc-11c1-4a5d-9d5c-f0bcde8d90c5",
                                "sense_id": "e981f762-2ff1-3373-84fa-737b9a6fd483",
                                "text": "Lay the folded endpaper flat, fold facing left, and apply spray adhesive to the paper on the exposed half. Lay the endpaper on the inside front cover, smoothing it to adhere the paper against the cover and the inner spine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c0108ed-064d-486e-941d-a5e748ff07dd",
                        "source_entry_id": "fdd6cbfc-df7d-3214-a3ff-7413347de2d8",
                        "source_sense_id": "e981f762-2ff1-3373-84fa-737b9a6fd483",
                        "source_sense_description": "either of two folded sheets of paper used to connect the front and back covers of a book to the first and last pages",
                        "target_lang_word": "page de garde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "page de garde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5dcec60f-8bd9-3218-8814-8f944fbd86ef",
                                        "entry_id": "1bf46a1f-3ab8-3689-b9d6-25da00e4fb14",
                                        "glosses": [
                                            "Feuille vierge, souvent blanche ajoutée par le relieur ou le brocheur en tête du volume, entre la couverture et la page de titre."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5bbf1c1-01eb-419a-812d-dc48135b0a67",
                                                "sense_id": "5dcec60f-8bd9-3218-8814-8f944fbd86ef",
                                                "text": "Je pénétrai dans le salon. Et m’amusai, en attendant mon amphitryon, à lire les dédicaces dont se fleurissent les pages de garde des nombreux ouvrages que, chaque jour, reçoit le poète."
                                            },
                                            {
                                                "example_id": "66cf5561-691e-49a1-bea9-fba24981b659",
                                                "sense_id": "5dcec60f-8bd9-3218-8814-8f944fbd86ef",
                                                "text": "Comment résister aux délices du bortsch, la soupe nationale, sorte de pot-au-feu, additionné de chou rouge et de crème fraîche, dont les marbrures glacées de rose et de blanc rappellent la page de garde d’un vieux bouquin."
                                            },
                                            {
                                                "example_id": "0bc597fd-054a-4a62-ad51-9220fa885c65",
                                                "sense_id": "5dcec60f-8bd9-3218-8814-8f944fbd86ef",
                                                "text": "Par défaut la numérotation n’apparait jamais dans la page de garde mais Word tient cependant compte de cette page lors de la numérotation des pages : la page qui suit la numérotation des pages est numérotée 2."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e58c32-b0b6-3a8c-80b3-90ddc7404e78",
                                        "entry_id": "1bf46a1f-3ab8-3689-b9d6-25da00e4fb14",
                                        "glosses": [
                                            "Première page d’une télécopie, sur laquelle apparaissent les identifiants de l’envoyeur et du récipiendaire. Synonyme de « bordereau de télécopie »."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3c63105-69d4-4e93-ba72-27fe88ceec35",
                        "source_entry_id": "fdd6cbfc-df7d-3214-a3ff-7413347de2d8",
                        "source_sense_id": "e981f762-2ff1-3373-84fa-737b9a6fd483",
                        "source_sense_description": "either of two folded sheets of paper used to connect the front and back covers of a book to the first and last pages",
                        "target_lang_word": "Vorsatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorsatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98a3e751-313c-3f2b-83aa-19d8170a631e",
                                        "entry_id": "d53df22a-9eea-39d5-bd4a-2984120c671e",
                                        "glosses": [
                                            "willentliche und wissentliche Herbeiführung einer Rechtsgutsverletzung oder billigende Inkaufnahme einer Rechtsgutsverletzung"
                                        ],
                                        "tags": [
                                            "Rechtssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54fb71f4-b2a0-4688-821c-dcf8655c92f2",
                                                "sense_id": "98a3e751-313c-3f2b-83aa-19d8170a631e",
                                                "text": "Fahrlässigkeit oder Vorsatz, das ist hier die Frage."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c4c148d-1b4d-3853-99ee-ad95c8a3c92e",
                                        "entry_id": "d53df22a-9eea-39d5-bd4a-2984120c671e",
                                        "glosses": [
                                            "etwas, das man sich vorgenommen hat"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0414d4ee-afad-41ee-bda1-696bdea4547c",
                                                "sense_id": "2c4c148d-1b4d-3853-99ee-ad95c8a3c92e",
                                                "text": "Er warf alle seine guten Vorsätze fürs neue Jahr über Bord."
                                            },
                                            {
                                                "example_id": "61672ef6-fd92-4cbe-b970-43c2f16697e1",
                                                "sense_id": "2c4c148d-1b4d-3853-99ee-ad95c8a3c92e",
                                                "text": "„Im Dezember letzten Jahres war er mit dem Vorsatz nach Berlin gereist, sein Büro aufzulösen, um anschließend an der französischen Riviera das Hotel seines Schwiegervaters zu übernehmen.“"
                                            },
                                            {
                                                "example_id": "c1b8b00f-1bea-4108-8d2b-f22670679dcd",
                                                "sense_id": "2c4c148d-1b4d-3853-99ee-ad95c8a3c92e",
                                                "text": "„Im Gegensatz zum gewöhnlichen, unschuldigen Flirten, das oft einfach so passiert, geschieht Cushioning zielgerichtet und mit Vorsatz.“"
                                            },
                                            {
                                                "example_id": "9d936d23-44a3-449c-b4c4-ddd29ebe68fc",
                                                "sense_id": "2c4c148d-1b4d-3853-99ee-ad95c8a3c92e",
                                                "text": "„Eine Verfassung, die aus guten Vorsätzen und (letztlich nich einklagbaren) Selbstbindungsklauseln des Monarchen besteht, wird im Einzelnen ausgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9964224b-757a-317f-8cd3-e0905faedbaf",
                                        "entry_id": "d53df22a-9eea-39d5-bd4a-2984120c671e",
                                        "glosses": [
                                            "etwas vor einer Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b40d993-e737-4968-a3bc-b64cf6a531b2",
                                                "sense_id": "9964224b-757a-317f-8cd3-e0905faedbaf",
                                                "text": "Am bekanntesten sind die Vorsätze der Maßeinheiten bei den Einheiten Meter, Byte und Hertz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a2abc396-0587-3c1a-9ba6-d49244a81a96",
                                        "entry_id": "d53df22a-9eea-39d5-bd4a-2984120c671e",
                                        "glosses": [
                                            "der vorherige Satz"
                                        ],
                                        "tags": [
                                            "in Texten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f2cf195-5f3c-4228-953a-e74deb80b16f",
                                                "sense_id": "a2abc396-0587-3c1a-9ba6-d49244a81a96",
                                                "text": "Das Thema wurde bereits im Vorsatz erwähnt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Vorsatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d861a00-a00d-39ff-89b8-9b7b076facee",
                                        "entry_id": "6eba6f6e-63a8-3aca-b4b6-0fd2a1097bf3",
                                        "glosses": [
                                            "Blatt Papier, das den Buchblock mit dem Einband verbindet"
                                        ],
                                        "tags": [
                                            "Buchbinderei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b268e83-7187-4806-967b-9bd757896536",
                                                "sense_id": "4d861a00-a00d-39ff-89b8-9b7b076facee",
                                                "text": "Bei der Benutzung eines Buches wird das Vorsatz im Falzbereich besonders belastet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
