                ],
                "senses": [
                    {
                        "sense_id": "fa41e773-c123-3d90-9f9c-2a69c150e721",
                        "entry_id": "d16bc5ee-3c46-3506-b828-89e4e0a787f5",
                        "glosses": [
                            "Zahlenangabe, die keine gesicherte Quelle hat oder nicht mit einer anerkannten Methode gewonnenen wurde, die aber gleichwohl in der öffentlichen Diskussion verwendet wird"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b77875a1-01a3-4ce5-9757-a4eb9e9e00da",
                                "sense_id": "fa41e773-c123-3d90-9f9c-2a69c150e721",
                                "text": "Die 24 ist zur Modezahl verkommen."
                            },
                            {
                                "example_id": "f9b9e9d0-c4ae-4d64-88ff-e95b5de812dd",
                                "sense_id": "fa41e773-c123-3d90-9f9c-2a69c150e721",
                                "text": "„Die Zahl 42 hat auch einen überraschenden Eingang in die Moderne gefunden, sie ist zu einer Modezahl geworden.“"
                            },
                            {
                                "example_id": "917ddce2-c485-4976-ad19-01f9fa361c4a",
                                "sense_id": "fa41e773-c123-3d90-9f9c-2a69c150e721",
                                "text": "„Die Gewerkschaften hatten ursprünglich sechs Prozent mehr gefordert und haben sich nach Aigners Angaben zuletzt auf die 'Modezahl' 3,8 Prozent eingeschossen.“"
                            },
                            {
                                "example_id": "6bf416ef-857d-4339-8f77-3e76df93b259",
                                "sense_id": "fa41e773-c123-3d90-9f9c-2a69c150e721",
                                "text": "„Vierhundert Millionen, die heute gewöhnlich genannt werden, ist eine Modezahl, die gar keine Bedeutung hat.“"
                            },
                            {
                                "example_id": "b74eca07-1611-4fd4-bbf9-7d8475935b3a",
                                "sense_id": "fa41e773-c123-3d90-9f9c-2a69c150e721",
                                "text": "„Die magische Dimensionszahl ist lange nicht mehr 3; 4 oder 5-dimensional, nicht einmal mehr einstellig, und auch die von mir aufgeschnappte Zahl 26 dürfte eine Modezahl sein (inzwischen überholt durch 52).“"
                            },
                            {
                                "example_id": "d7222a08-8c31-40c3-8201-dbacc44c97f2",
                                "sense_id": "fa41e773-c123-3d90-9f9c-2a69c150e721",
                                "text": "„Sieben war wohl die Modezahl der Achtelfinalpartie des DFB-Pokals der Frauen zwischen dem SC 07 Bad Neuenahr und dem 1. FC Saarbrücken.“"
                            },
                            {
                                "example_id": "eee35e85-fe0b-49de-a34b-bbf809f3dc43",
                                "sense_id": "fa41e773-c123-3d90-9f9c-2a69c150e721",
                                "text": "„Den Kranken ist überhaupt, wie auch Gerson richtig ausspricht, dringend zur Pflicht zu machen, sich nicht an eine bestimmte Modezahl von Bädern, wie sie vorgeschrieben zu werden pflegen, zu halten, sondern genau auf die an ihrem Körper beobachteten Reactionen zu achten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
