                {
                    "sense_id": "f32a8055-4b7d-303e-a04f-ecf0dcf67d06",
                    "sense_definition": "położyć się na spoczynek lub do snu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "odpoczynek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zmęczony całodzienną wędrówką wędrowiec <w>legł</w> na miękkiej trawie pod rozłożystym dębem.",
                            "target_lang_translations": {
                                "ru": "Уставший от целого дня странствий путник <w>лёг</w> на мягкую траву под раскидистым дубом."
                            }
                        },
                        {
                            "text": "Kiedy słońce zaszło, cała wieś wcześnie <w>legła</w> do snu.",
                            "target_lang_translations": {
                                "ru": "Когда солнце зашло, вся деревня рано <w>отошла ко сну</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "położyć się",
                        "spocząć",
                        "legnąć"
                    ],
                    "common_phrases": [
                        "lec do snu"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "spotykane w języku literackim i dawnym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "лечь отдохнуть или уснуть"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лечь",
                                "target_lang_sense_clarification": "на отдых, спать"
                            },
                            {
                                "target_lang_word": "прилечь",
                                "target_lang_sense_clarification": "отдохнуть"
                            },
                            {
                                "target_lang_word": "отойти ко сну",
                                "target_lang_sense_clarification": "устаревшее или книжное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e74ad930-2f07-382b-8328-e114fc68812d",
                    "sense_definition": "opaść i pokryć jakąś powierzchnię warstwą",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pokrycie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gęsta mgła <w>legła</w> nad całą doliną i utrudniała widoczność o świcie.",
                            "target_lang_translations": {
                                "ru": "Густой туман <w>лёг</w> на всю долину и затруднял видимость на рассвете."
                            }
                        },
                        {
                            "text": "Biały puch śniegu <w>legł</w> grubą powłoką na zamarzniętej ziemi.",
                            "target_lang_translations": {
                                "ru": "Белый снежный пух <w>лёг</w> толстым слоем на замёрзшую землю."
                            }
                        }
                    ],
                    "synonyms": [
                        "upaść"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "używane głównie w poezji i opisach przyrody"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "опуститься слоем и покрыть поверхность (о снеге, тумане и т. п.)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лечь",
