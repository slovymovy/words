                ],
                "senses": [
                    {
                        "sense_id": "3418644f-db72-3cb4-9687-72d796a161bb",
                        "entry_id": "e8662893-4664-33d7-940b-a59f9cbeecc8",
                        "glosses": [
                            "Branntwein"
                        ],
                        "tags": [
                            "andere Bezeichnung für"
                        ],
                        "examples": [
                            {
                                "example_id": "0766b9fd-c1cb-4507-8d33-6ae17a72402a",
                                "sense_id": "3418644f-db72-3cb4-9687-72d796a161bb",
                                "text": "„Er setzte sich und nahm wieder seinen Brandy, völlig niedergeschmettert von der Enttäuschung.“"
                            },
                            {
                                "example_id": "66880d25-8c32-40de-a57c-1694ade07d1c",
                                "sense_id": "3418644f-db72-3cb4-9687-72d796a161bb",
                                "text": "„Und so hatten sie und Adrienne und Sylvia und Cyprian, die Taschen voll Lakritz und Brandy, im dunklen Kino gesessen und sich zunehmend beschwipster in das Melodram gestürzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bb830a6-ffa2-4fbb-a00c-6cb382d9a049",
                        "source_entry_id": "e8662893-4664-33d7-940b-a59f9cbeecc8",
                        "source_sense_id": "3418644f-db72-3cb4-9687-72d796a161bb",
                        "source_sense_description": "andere Bezeichnung für: Branntwein",
                        "target_lang_word": "brandy",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brandy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb50161c-0d74-31c7-9487-2f32f0988029",
                                        "entry_id": "79badbfc-1c44-35aa-b71b-3f506c12bb64",
                                        "glosses": [
                                            "Eau-de-vie de vin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f31af05-8fd8-46d9-8d28-84de2f80161c",
                                                "sense_id": "cb50161c-0d74-31c7-9487-2f32f0988029",
                                                "text": "La bière est de côté et l’on prend du brandy."
                                            },
                                            {
                                                "example_id": "cc64974d-0ee6-44a0-9606-56641102f9cb",
                                                "sense_id": "cb50161c-0d74-31c7-9487-2f32f0988029",
                                                "text": "Qu’il passât tout son temps dans sa cabine, nul n’y eût trouvé à redire, si le grossier master ne se fût pas grisé chaque jour de gin ou de brandy."
                                            },
                                            {
                                                "example_id": "b37b4fc9-f6cf-4aa8-803f-0de291ba5060",
                                                "sense_id": "cb50161c-0d74-31c7-9487-2f32f0988029",
                                                "text": "Je me retrouvai enfin dans un bureau un peu mieux aménagé, où il y avait quand même un ventilateur, des rocking-chairs en rotin et, sur une table basse, quelques fioles carrées de whisky et de brandy."
                                            },
                                            {
                                                "example_id": "df656595-2c4d-4b00-a0cd-b08bed3dc707",
                                                "sense_id": "cb50161c-0d74-31c7-9487-2f32f0988029",
                                                "text": "En contrepartie, l’affiche taurine se trouvera quelques sponsors, une marque de cigares, des brandys et quelques banques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e5d1e67-6960-4098-bf10-005989cbf009",
                        "source_entry_id": "e8662893-4664-33d7-940b-a59f9cbeecc8",
                        "source_sense_id": "3418644f-db72-3cb4-9687-72d796a161bb",
                        "source_sense_description": "andere Bezeichnung für: Branntwein",
                        "target_lang_word": "cognac",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cognac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                        "entry_id": "e7c415d7-6dbc-3403-b21b-cd3a105a33f4",
                                        "glosses": [
                                            "Eau-de-vie qui a son centre de production dans la région de Cognac, en France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7b45add-1698-4420-9416-b6c63938735a",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Alors il chercha l’oubli tour à tour dans le cidre normand, le poiré manceau, l’hydromel gaulois, le cognac français, le genièvre hollandais, le gin anglais, le wiskey écossais, le kirsch germain."
                                            },
                                            {
                                                "example_id": "074cf231-ec1b-4345-9287-4b3316c1a8ed",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Oui… reprit Jacques, un duel… au cognac… Tu prétends qu’il y a autant de danger à se mettre devant une bouteille d’eau-de-vie que devant la gueule d’un pistolet… Prenons chacun une bouteille pleine, l’on verra qui de nous deux reculera."
                                            },
                                            {
                                                "example_id": "5555307c-ce9c-4b5b-bfc1-ef6064f0f7cf",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "COGNAC. Très funeste. – Excellent dans plusieurs maladies. – Un bon verre de cognac ne fait jamais de mal. Pris à jeun, tue le ver de l’estomac."
                                            },
                                            {
                                                "example_id": "cc7ee09a-b348-463a-aef5-57c9b4262da6",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Les gourmands et curieux se sont pressés pour déguster pineaux, cognacs et les préparations proposées."
                                            },
                                            {
                                                "example_id": "2ac1005f-9b8c-423c-ab81-aac087345fb9",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Tout en parlant ainsi, il a versé deux petits verres de cognac du service à liqueurs laissé au premier acte."
                                            },
                                            {
                                                "example_id": "cfe8f533-1818-46bc-974e-d9658bfa8ba4",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Et monsieur Quesnay sortait de la poche de sa robe de chambre à carreaux verts une bouteille de vieux cognac, et un verre : « Faudra pas le dire à Germaine ! », qu’il me recommandait… Et je buvais la goutte !… Ah ! le bon cognac !… Ah ! le bon homme !…"
                                            },
                                            {
                                                "example_id": "6bb07025-8997-4ab7-834d-fd91a7d72ece",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Ils aiment bien vivre après avoir bien travaillé ; un verre de vin ou de cognac ne leur fait pas peur, et ils se paient assez souvent le café, le pousse-café et le reste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3b07fcd-702f-4985-a6b8-276b089e3c04",
                        "source_entry_id": "e8662893-4664-33d7-940b-a59f9cbeecc8",
                        "source_sense_id": "3418644f-db72-3cb4-9687-72d796a161bb",
