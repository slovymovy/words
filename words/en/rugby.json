                {
                    "sense_id": "a849fa0a-8b51-32da-9af0-3301ae15f85f",
                    "sense_definition": "A town in Warwickshire, England, where the sport of rugby is believed to have originated.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The sport was named after the town of <w>Rugby</w> in England.",
                            "target_lang_translations": {
