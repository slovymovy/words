                                "it": "Hai <w>altre</w> domande sulla presentazione?",
                                "cs": "Máš k prezentaci <w>ještě</w> nějaké další otázky?",
                                "tr": "Sunumla ilgili <w>başka</w> sorunuz var mı?",
                                "es": "¿Tienes <w>más</w> preguntas sobre la presentación?"
                            }
