                            {
                                "example_id": "a372fd32-cca4-4cdf-a0ab-50d46326a597",
                                "sense_id": "e06003b6-75f2-3507-afc5-9ebc0b88db77",
                                "text": "Ongetwijfeld geeft Cressida's verschijning op We Day royaltywatchers nieuwe hoop op een verlovingsaankondiging."
                            },
                            {
                                "example_id": "8544acaf-d818-40d6-8fa3-852c68382df2",
                                "sense_id": "e06003b6-75f2-3507-afc5-9ebc0b88db77",
                                "text": "Was er iets aan het licht gekomen? Er was ongetwijfeld druk gespeculeerd toen ik, zo kort na mijn verlovingsaankondiging, Harper's Green had verlaten."
                            },
                            {
                                "example_id": "b84f4600-ea27-40b1-adc5-abda29cf7331",
                                "sense_id": "e06003b6-75f2-3507-afc5-9ebc0b88db77",
                                "text": "Máxima verschijnt voor het eerst 'officieel' als vriendin van Willem-Alexander op 31 januari 2001, bij het 63ste verjaardagsfeest van koningin Beatrix in het Stedelijk Museum in Amsterdam. De verlovingsaankondiging is op 30 maart 2001. Máxima geniet zichtbaar van de toejuichingen buiten."
                            }
