{
    "word_family": [
        "loomheid",
        "loomen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec494c87-52e9-37ea-aa2c-c89b5368d3b5",
                    "sense_definition": "traag en zonder energie, vaak door warmte of vermoeidheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "traagheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op deze <w>lome</w> zomermiddag hebben we helemaal geen zin om te werken.",
                            "target_lang_translations": {
                                "en": "On this <w>languid</w> summer afternoon, we don't feel like working at all."
                            }
                        },
                        {
                            "text": "Na de zware maaltijd voelde hij zich een beetje <w>loom</w> en slaperig.",
                            "target_lang_translations": {
                                "en": "After the heavy meal, he felt a bit <w>lethargic</w> and sleepy."
                            }
                        }
                    ],
                    "synonyms": [
                        "lusteloos",
                        "slaperig",
                        "traag",
                        "mat"
                    ],
                    "antonyms": [
                        "actief",
                        "energiek",
                        "levendig"
                    ],
                    "common_phrases": [
                        "lome zomermiddag",
                        "lome bewegingen"
                    ],
                    "target_lang_definitions": {
                        "en": "Slow and lacking energy, often due to heat or fatigue."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "languid",
                                "target_lang_sense_clarification": "relaxed and slow in a pleasant or tired way"
                            },
                            {
                                "target_lang_word": "lethargic",
                                "target_lang_sense_clarification": "lacking energy or enthusiasm"
                            },
                            {
                                "target_lang_word": "sluggish",
                                "target_lang_sense_clarification": "moving or reacting more slowly than normal"
                            },
                            {
                                "target_lang_word": "listless",
                                "target_lang_sense_clarification": "having no energy or spirit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa1f91f3-95a6-3c8d-b14d-bb08d2bb5070",
                    "sense_definition": "weinig bereidheid tonend tot handelen of handel, vaak gebruikt in een zakelijke context",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "traagheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De aandelenkoersen bleven nagenoeg gelijk tijdens een <w>lome</w> handelsdag op de beurs.",
                            "target_lang_translations": {
                                "en": "Stock prices remained virtually unchanged during a <w>sluggish</w> trading day on the exchange."
                            }
                        },
                        {
                            "text": "Imtech ging onderuit op een <w>loom</w> Damrak waar weinig werd belegd.",
                            "target_lang_translations": {
                                "en": "Imtech went down on a <w>quiet</w> Damrak where there was little investment."
                            }
                        }
                    ],
                    "synonyms": [
                        "stagnant",
                        "kalm",
                        "lusteloos"
                    ],
                    "antonyms": [
                        "bedrijvig",
                        "druk"
                    ],
                    "common_phrases": [
                        "lome beurs",
                        "loom Damrak"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Showing little willingness to act or trade, often used in a business or stock market context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sluggish",
                                "target_lang_sense_clarification": "referring to a slow-moving market"
                            },
                            {
                                "target_lang_word": "stagnant",
                                "target_lang_sense_clarification": "showing no activity or growth"
                            },
                            {
                                "target_lang_word": "quiet",
                                "target_lang_sense_clarification": "referring to low trading volume"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "18f86d9a-c23f-311f-8f6f-0af440c414a9",
                    "sense_definition": "op een trage, energieke wijze zonder haast",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "traagheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat liep <w>loom</w> door de tuin terwijl de zon fel scheen.",
                            "target_lang_translations": {
                                "en": "The cat walked <w>languidly</w> through the garden while the sun shone brightly."
                            }
