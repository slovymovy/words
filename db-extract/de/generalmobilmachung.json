                "senses": [
                    {
                        "sense_id": "ff00f4ab-ab56-356c-be86-eec97ab77707",
                        "entry_id": "82294c63-09b4-3064-b6f9-5ae99b223e31",
                        "glosses": [
                            "Vorbereitung/Mobilisierung aller Streitkräfte eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1142a9a6-54cd-46e7-a728-9806eed4d091",
                                "sense_id": "ff00f4ab-ab56-356c-be86-eec97ab77707",
                                "text": "„Zwar gelang es ihm in der Tat, die Generale solange hinzuhalten, bis Rußland durch die Ausrufung der Generalmobilmachung den nötigen Vorwand lieferte. Doch durch sein prinzipielles Eingehen auf die Wünsche der Armee hatte der Kanzler bereits vorher jede Chance zur Umkehr verloren.“"
                            },
                            {
                                "example_id": "66d66556-a480-4898-9d02-e6c3c25d464f",
                                "sense_id": "ff00f4ab-ab56-356c-be86-eec97ab77707",
                                "text": "„Nachdem am 1. August 1914 um 17 Uhr die Generalmobilmachung in Deutschland verkündet wurde, bekam Onkel August umgehend den Einberufungsbefehl.“"
                            },
                            {
                                "example_id": "0b920f25-b76e-45be-9123-2d36192e876b",
                                "sense_id": "ff00f4ab-ab56-356c-be86-eec97ab77707",
                                "text": "„Am 30. August verkündete Polen die Generalmobilmachung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
