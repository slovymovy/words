                        "examples": [
                            {
                                "example_id": "3a6ea975-3340-4add-a83c-1e3d9187cdc8",
                                "sense_id": "70b35f9f-f2e7-38ea-8879-d75976887f7d",
                                "text": "„Gebt ihnen viel Gemüse und Fisch zu essen. Dazu Buchweizensuppe und Obst.“"
                            },
                            {
                                "example_id": "9f20c951-6fa8-4a24-8885-a840725d881b",
                                "sense_id": "70b35f9f-f2e7-38ea-8879-d75976887f7d",
                                "text": "„Wir hielten am Rand der Grube an. Die braune, faltige Oberfläche verströmte einen unsäglichen Gestank und sah aus wie die schreckliche Haut auf der Oberfläche einer Tasse heißer Buchweizensuppe.“"
                            }
                        ],
