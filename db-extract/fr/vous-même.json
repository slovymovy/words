        "fr-extract.jsonl": [
            {
                "entry_id": "8e3ef75c-9bc7-38f5-b5f9-784d02710735",
                "word": "vous-même",
                "pos": "pron",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "04e60014-47ef-3a23-b66a-956c17c0951e",
                        "entry_id": "8e3ef75c-9bc7-38f5-b5f9-784d02710735",
                        "glosses": [
                            "Toi-même. Note d’usage : Utilisé avec le vous de politesse du singulier."
                        ],
                        "tags": [
                            "polite"
                        ],
                        "examples": [
                            {
                                "example_id": "417f4686-62f7-4c7a-825e-68d60d6feb59",
                                "sense_id": "04e60014-47ef-3a23-b66a-956c17c0951e",
                                "text": "En dehors de vous-même, il y a si je ne m’abuse, une infirmière major, une Surveillante Générale, un ancien jockey servant de factotum, une centraliste, un maître d’hôtel, un cuisinier et son aide, deux femmes de chambre, trois serveurs, trois filles de salle et un jardinier…"
                            },
                            {
                                "example_id": "bd512a0b-a2dc-40a4-8d35-66c8fb52e9d9",
                                "sense_id": "04e60014-47ef-3a23-b66a-956c17c0951e",
                                "text": "N’écoutez que vous-même en affaires."
                            },
                            {
                                "example_id": "54f144e3-574b-44a8-b334-969872a5da2c",
                                "sense_id": "04e60014-47ef-3a23-b66a-956c17c0951e",
                                "text": "– Il vaudrait mieux que vous le voyiez vous-même."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9be186d4-09f4-4c97-ac5f-b4c4462ae963",
                        "source_entry_id": "8e3ef75c-9bc7-38f5-b5f9-784d02710735",
                        "source_sense_id": "04e60014-47ef-3a23-b66a-956c17c0951e",
                        "target_lang_word": "yourself",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yourself",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5313cddb-c0e8-3989-ad41-9c0cb313d720",
                                        "entry_id": "ec981b62-ebe2-3d5e-9938-48f23a7fae7c",
                                        "glosses": [
                                            "Your own self (singular)."
                                        ],
                                        "tags": [
                                            "pronoun",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c787f8ff-fc41-4594-bb29-55f6c1285bd7",
                                                "sense_id": "5313cddb-c0e8-3989-ad41-9c0cb313d720",
                                                "text": "Be careful with that fire or you'll burn yourself."
                                            },
                                            {
                                                "example_id": "41c00eb1-bc79-43aa-afa6-d6db33b3421a",
                                                "sense_id": "5313cddb-c0e8-3989-ad41-9c0cb313d720",
                                                "text": "After a good night's sleep you'll feel like yourself again."
                                            },
                                            {
                                                "example_id": "1d9aee55-93a1-4238-b498-a13e624697f1",
                                                "sense_id": "5313cddb-c0e8-3989-ad41-9c0cb313d720",
                                                "text": "As an adult, you would find yourself being a people pleaser with the men in your life –– afraid to be rejected and emotionally abandoned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7541cc1-572d-37d9-8fe7-2bd70be03373",
                                        "entry_id": "ec981b62-ebe2-3d5e-9938-48f23a7fae7c",
                                        "glosses": [
                                            "You (singular); used emphatically, especially to indicate exclusiveness of the referent's participation in the predicate, i.e., that no one else is involved."
                                        ],
                                        "tags": [
                                            "emphatic",
                                            "pronoun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f00f413-03f9-467a-89a0-63482de6d8e3",
                                                "sense_id": "a7541cc1-572d-37d9-8fe7-2bd70be03373",
                                                "text": "You yourself know that what you wrote was wrong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7222cb72-edaa-3955-bf3f-31841fcbf863",
                                        "entry_id": "ec981b62-ebe2-3d5e-9938-48f23a7fae7c",
                                        "glosses": [
                                            "You (singular); even when \\\"you\\\" has not been used previously; see usage notes."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "especially",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7481ef82-a0e2-48b8-ac11-2a6447eb551d",
                                                "sense_id": "7222cb72-edaa-3955-bf3f-31841fcbf863",
                                                "text": "I spoke with yourself last in February."
                                            },
                                            {
                                                "example_id": "b1926751-57ac-4f8b-8541-849398e2e9f2",
                                                "sense_id": "7222cb72-edaa-3955-bf3f-31841fcbf863",
                                                "text": "No one understands me like yourself."
                                            },
                                            {
                                                "example_id": "97e07701-765d-4445-ac2a-bc4f8906fb16",
                                                "sense_id": "7222cb72-edaa-3955-bf3f-31841fcbf863",
                                                "text": "My colleague and yourself are invited to the conference."
                                            },
                                            {
                                                "example_id": "4b1cb4fc-07ad-4be6-b845-b49fff1c7af0",
                                                "sense_id": "7222cb72-edaa-3955-bf3f-31841fcbf863",
                                                "text": "I only spoke to my lawyer and yourself about the issue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
