                    },
                    {
                        "translation_id": "9ad2e97a-2e20-4d1d-8e9b-ee53aa2266c9",
                        "source_entry_id": "fcab8a06-f7b8-3979-9248-c0cf0396be52",
                        "source_sense_id": "eef10769-a00c-35ef-be4a-9c58db0e67d9",
                        "source_sense_description": "neutralization",
