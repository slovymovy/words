                "forms": [],
                "senses": [
                    {
                        "sense_id": "6c2d006c-5aec-3b49-b48c-8bf338b88d0a",
                        "entry_id": "ff0e494c-208e-3333-9937-bc1c287d921c",
                        "glosses": [
                            "ongemak, wrevel veroorzakend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd113413-bd11-4df9-9fdf-cb8f904ff483",
                                "sense_id": "6c2d006c-5aec-3b49-b48c-8bf338b88d0a",
                                "text": "Volgens de directeur klaagden verschillende leraren en leerlingen over maagpijn en hadden sommigen moeite met ademen. Vijf mensen werden ter observatie in het ziekenhuis opgenomen. Na een aantal testen werd het gebouw veilig bevonden en werd de irriterende geur gelokaliseerd als elektronische luchtverfrisser die een geur van pompoenkruiden afscheidde."
                            },
                            {
                                "example_id": "ebac01fe-3848-4d53-92cd-a0731da90102",
                                "sense_id": "6c2d006c-5aec-3b49-b48c-8bf338b88d0a",
                                "text": "Waarom tranen onze ogen eigenlijk wanneer we uien snijden? Uien bevatten vluchtige bestanddelen die inwerken op het natuurlijke water in onze ogen en zo zwavelzuur vormen. Onze ogen produceren vervolgens tranen om die irriterende stof te verdunnen. Dat het probleem ons écht bezighoudt, blijkt uit de lange lijst zoekresultaten die Google geeft voor de vraag 'Hoe snij ik een ui zonder te huilen?'"
                            }
                        ]
                    }
                ],
