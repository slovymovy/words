            {
                "entry_id": "33223bff-7b04-3bcb-a365-a0c09919f9e0",
                "word": "sumérien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "00981cda-08e5-393f-a77c-132575b76705",
                        "entry_id": "33223bff-7b04-3bcb-a365-a0c09919f9e0",
                        "glosses": [
                            "Langue morte autrefois parlée à Sumer, un isolat linguistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e931d845-edb1-4e23-8258-bfe78843054c",
                                "sense_id": "00981cda-08e5-393f-a77c-132575b76705",
                                "text": "Le sumérien étant majoritairement monosyllabique, il en aurait résulté des homophones nombreux (des mots différents se prononçant de la même façon, comme en français vers, verre, vert, ver) si la langue n’avait pas utilisé un autre moyen de distinguer entre les différents sens de ces « homophones »."
                            },
                            {
                                "example_id": "2f0ea753-111f-4a46-ac2a-03704fa46472",
                                "sense_id": "00981cda-08e5-393f-a77c-132575b76705",
                                "text": "Le sumérien comptait en base 60 (il nous en reste une trace, notre manière de compter les secondes et les minutes) …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86f0b7ea-d66d-43ae-ab34-3906bc013f1c",
                        "source_entry_id": "33223bff-7b04-3bcb-a365-a0c09919f9e0",
                        "source_sense_id": "00981cda-08e5-393f-a77c-132575b76705",
                        "target_lang_word": "Sumerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sumerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f988fefe-5bd6-3001-a856-1f2a334ae0f9",
                                        "entry_id": "378d7d2c-2e8d-31de-8ae3-e17cd35a16eb",
                                        "glosses": [
                                            "isolierte, agglutinierende Sprache, die bis etwa 1800 v. Chr. im Süden Mesopotamiens gesprochen wurde, niedergeschrieben in Keilschrift"
                                        ],
                                        "tags": [
                                            "Sprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "255d185c-988b-4c19-a2b3-60e1e13cf630",
                                                "sense_id": "f988fefe-5bd6-3001-a856-1f2a334ae0f9",
                                                "text": "Sumerisch ist eine ausgestorbene Sprache."
                                            },
                                            {
                                                "example_id": "da54a5cc-55a8-422f-bdda-442962f956f5",
                                                "sense_id": "f988fefe-5bd6-3001-a856-1f2a334ae0f9",
                                                "text": "Das Sumerische verfügt über eine reichhaltige Morphologie."
                                            },
                                            {
                                                "example_id": "a9e14a87-29ef-4a1f-b2f9-8fc622f2b542",
                                                "sense_id": "f988fefe-5bd6-3001-a856-1f2a334ae0f9",
                                                "text": "„Primäres Ziel der Schreiberausbildung war das Erlernen der Keilschrift und zugleich, mindestens in begrenztem Rahmen, das Erlernen des zum Verstehen vieler nicht-archivalischer Textkategorien unentbehrlichen Sumerischen.“"
                                            },
                                            {
                                                "example_id": "2b7782db-ad1d-40cd-8ac9-37d82a6d0d13",
                                                "sense_id": "f988fefe-5bd6-3001-a856-1f2a334ae0f9",
                                                "text": "„Inzwischen hat Ammondt sein Repertoire ums Sumerische erweitert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
