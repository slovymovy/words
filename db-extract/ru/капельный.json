                                                "sense_id": "fdd60452-8186-386a-82ba-678b814e67db",
                                                "text": "He's not doing so well. The doctors have put him on a drip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "365f99bd-ebd8-3330-9bea-1958d5bf5a7d",
                                        "entry_id": "b3333aca-991a-36c4-b2a3-7bcf837db476",
                                        "glosses": [
                                            "A limp, ineffectual, or uninteresting person."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3de90b92-23bc-42b7-b42d-4f9f6d8d0814",
                                                "sense_id": "365f99bd-ebd8-3330-9bea-1958d5bf5a7d",
                                                "text": "He couldn't even summon up the courage to ask her name... what a drip!"
                                            },
                                            {
                                                "example_id": "fc71de75-f09b-4aa2-b2b2-bab845cc8200",
                                                "sense_id": "365f99bd-ebd8-3330-9bea-1958d5bf5a7d",
                                                "text": "Because most of the blokes I fancy think l'm stupid and pointless—and, so, they just bonk me and then leave me. And the kind of blokes that do fancy me, I think are drips. I can't even be bothered to bonk them. Which does sort of leave me a bit nowhere."
                                            }
                                        ]
                                    },
