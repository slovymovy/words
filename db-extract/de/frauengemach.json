                        ],
                        "examples": [
                            {
                                "example_id": "7f04e2cc-5f65-4b5a-84b6-6d85a983b2af",
                                "sense_id": "4aefdc1e-4565-3da6-a120-82ca1b9d0c8f",
                                "text": "„Am nächsten Morgen ging er gewaschen und gekämmt statt an die Büroarbeit in die hinten gelegenen Frauengemächer zu Frau Mondtraut.“"
                            },
                            {
                                "example_id": "26006e16-10d3-46b3-9dd7-077c945402e3",
                                "sense_id": "4aefdc1e-4565-3da6-a120-82ca1b9d0c8f",
                                "text": "„Bei einem Bankett, das der schon ergraute ruhmreiche Feldherr und Herzog Yang Su zu Ehren des vornehmen, schönen Jünglings Li Tsing aus der mächtigen, nach dem Thron strebenden Sippe der Li in seinem Palast gab, durfte sie neben den anderen Damen der Frauengemächer mit dabei sein.“"
                            }
                        ],
