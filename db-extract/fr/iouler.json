                "senses": [
                    {
                        "sense_id": "91cec5fe-dd55-3782-b9df-968d82b2d5f7",
                        "entry_id": "d89e11de-35c2-334d-86c7-89e7d08b49ee",
                        "glosses": [
                            "Chanter en vocalises comme les Tyroliens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa218ce-92c7-4895-8131-35227d6029e1",
                                "sense_id": "91cec5fe-dd55-3782-b9df-968d82b2d5f7",
                                "text": "– Enfin, quoi, ils ioulent les Suisses, non ? Je ne veux pas d’un gendre qui ioule ! Qu’est-ce qu’on penserait de nous à Cracovie ?"
                            },
                            {
                                "example_id": "a96fd36a-979c-49e6-8a2d-3d71fc90a8fb",
                                "sense_id": "91cec5fe-dd55-3782-b9df-968d82b2d5f7",
                                "text": "TYROLIENNE : chant montagnard à trois temps originaire du Tyrol (Autriche), caractérisé par le passage rapide de la voix de poitrine à la voix de tête et inversement. Ainsi le chanteur «ioule»."
                            },
                            {
                                "example_id": "3f1a8ec8-d794-4283-b769-5d2d4f4d577b",
                                "sense_id": "91cec5fe-dd55-3782-b9df-968d82b2d5f7",
                                "text": "Quand on reçoit un coup dans les claouis, on ioule comme n'importe quel Tyrolien !"
                            }
                        ]
                    }
                ],
