                "senses": [
                    {
                        "sense_id": "5733f2cc-8436-369e-a620-6515842587ec",
                        "entry_id": "1611f986-b023-3b0c-a0a5-ee7c14fc5764",
                        "glosses": [
                            "To cut into collops (thin slices)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4d3aff-fa41-4596-aa5a-435bb918a550",
                                "sense_id": "5733f2cc-8436-369e-a620-6515842587ec",
                                "text": "This induced me to make a further trial, and to get some of them colloped as we do oysters in shells, I swallowed them up myself."
                            },
                            {
                                "example_id": "04127d44-c178-4677-8808-324dedd31a77",
                                "sense_id": "5733f2cc-8436-369e-a620-6515842587ec",
                                "text": "They colloped it, and spitted skilfully, Then roasted carefully and slipped them off."
                            },
                            {
                                "example_id": "b4479363-bf15-430f-9ae3-607490a12380",
                                "sense_id": "5733f2cc-8436-369e-a620-6515842587ec",
                                "text": "I neither egged thee nor colloped thee. If I had egged thee, though mights yet chese."
                            },
                            {
                                "example_id": "2daf0bd4-924b-49a3-99d7-f1991f120c82",
                                "sense_id": "5733f2cc-8436-369e-a620-6515842587ec",
                                "text": "There was one fine bullock already butchered and being colloped by the cooking fires of the Burns and several sheep on the way to the same fate."
                            }
                        ]
                    }
                ],
