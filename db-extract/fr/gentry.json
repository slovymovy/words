                        "glosses": [
                            "Nom par lequel on désigne en Angleterre la petite noblesse non titrée, par opposition à nobility, la haute noblesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59bb6bd1-73b2-48a7-96a6-999a2b86e244",
                                "sense_id": "c5667c0a-bbe8-3cc2-ad9b-f90ec7c9a80b",
                                "text": "Et, en effet, à partir d’Arklow, la route côtière dessert nombre de stations de bains de mer, déjà fréquentées par les familles de la gentry dublinoise."
                            },
                            {
                                "example_id": "4ab432f8-def0-468a-9bd1-cd095f8b8f9d",
                                "sense_id": "c5667c0a-bbe8-3cc2-ad9b-f90ec7c9a80b",
                                "text": "J’affronterai, sans voiles, l’hydre aux mille faces-à-main de la gentry britannique et malheur à vous si des réflexions désobligeantes me font regretter d’avoir offert mes appas aux sarcasmes des philanthropes ! »"
                            }
                        ]
                    }
