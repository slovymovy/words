                ],
                "senses": [
                    {
                        "sense_id": "1a17995a-fdc1-3dce-9426-544e6d26dc7a",
                        "entry_id": "bbebc98d-9f4b-3eb6-81e0-638716632716",
                        "glosses": [
                            "(automatisch ablaufende) Bewegung einer technischen Einrichtung zur Justierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e99f6811-3b7d-4dc2-8ead-c852609b0ce2",
                                "sense_id": "1a17995a-fdc1-3dce-9426-544e6d26dc7a",
                                "text": "„Bei einem Ausfall der Spannungsversorgung muss bei diesem eingesetzten System die Kabine eine Lernfahrt durchführen.“"
                            },
                            {
                                "example_id": "c3d49bc9-e7aa-4752-899c-64fd5ac0e677",
                                "sense_id": "1a17995a-fdc1-3dce-9426-544e6d26dc7a",
                                "text": "„Bei der Lernfahrt fährt die Kabine den kompletten Schacht ab und ‚lernt‘ sozusagen, wo sich die Haltestellen befinden.“"
                            },
                            {
                                "example_id": "631b0bbe-b450-4075-9905-4f6042c83cf2",
                                "sense_id": "1a17995a-fdc1-3dce-9426-544e6d26dc7a",
                                "text": "„Sollte sich danach der Fahrkorb eigenständig in Bewegung setzen, ist der Fehler vermutlich durch einen Reset der Steuerung verschwunden und der Aufzug initialisiert sich durch eine Lernfahrt selbst.“"
                            },
                            {
                                "example_id": "b09beb9d-654c-45df-bb45-14db165ad822",
                                "sense_id": "1a17995a-fdc1-3dce-9426-544e6d26dc7a",
                                "text": "„Eine zweite Möglichkeit besteht darin, eine von einem Fahrer gesteuerte Lernfahrt durchzuführen oder beide Methoden zu kombinieren.“"
                            },
                            {
                                "example_id": "e41da59b-adf0-4c20-a3cb-84d489c310f2",
                                "sense_id": "1a17995a-fdc1-3dce-9426-544e6d26dc7a",
                                "text": "„Neben einem Safety- Bumper und seitlichen Kontaktleisten werden berührungslos arbeitende Ultraschallsensoren eingesetzt, die auch Hindernisse erfassen, die auf der Lernfahrt nicht vorhanden waren.“"
                            },
                            {
                                "example_id": "796d8edb-f5e5-4fc9-8459-a64c96fb78fb",
                                "sense_id": "1a17995a-fdc1-3dce-9426-544e6d26dc7a",
                                "text": "„In einer Lernfahrt muß die Funktionsfähigkeit dieser Sensoren für jeden Bauhöhenbereich verifiziert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e55201b0-c3d3-352a-beda-e53beec2cfed",
                        "entry_id": "bbebc98d-9f4b-3eb6-81e0-638716632716",
                        "glosses": [
                            "begleitetes Bewegen eines Fahrzeuges zur Erlernung dessen Handhabung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d5da4a3-3a13-474b-8df5-18b88de7122e",
                                "sense_id": "e55201b0-c3d3-352a-beda-e53beec2cfed",
                                "text": "„Der Begleiter hat dafür zu sorgen, daß die Lernfahrt gefahrlos durchgeführt wird und der Fahrschüler die Verkehrsvorschriften nicht verletzt.“"
                            },
                            {
                                "example_id": "c9fd44aa-8d33-4f6c-bb67-0d81cdd1bf7c",
                                "sense_id": "e55201b0-c3d3-352a-beda-e53beec2cfed",
                                "text": "„Dann gibt er Gas zur letzten Lernfahrt vor der Prüfung.“"
                            },
                            {
                                "example_id": "77dc0c8a-d01d-42b8-9a7c-2a0c58ce0570",
                                "sense_id": "e55201b0-c3d3-352a-beda-e53beec2cfed",
                                "text": "„Die theoretischen Teile des Fahrunterrichts werden in der Berufsschule vermittelt, die praktische Fahrausbildung erfolgt in den Betrieben, in denen Fahrlehrer oder erfahrene Betriebsangehörige mit einer entsprechenden Ausbildungsbewilligung den Lehrling bis zur Erlangung des Führerscheins auf Lernfahrten schulen.“"
                            },
                            {
                                "example_id": "b7489038-e370-4033-97b0-ed0e4d04a099",
                                "sense_id": "e55201b0-c3d3-352a-beda-e53beec2cfed",
                                "text": "„In vielen Ländern Europas können Lernfahrten auf privater Basis durchgeführt werden.“"
                            },
                            {
                                "example_id": "7b5bc8f1-8798-4179-b50d-081d0783a144",
                                "sense_id": "e55201b0-c3d3-352a-beda-e53beec2cfed",
                                "text": "„Natürlich steht bei einer Lernfahrt die Sicherheit an vorderster Stelle.“"
                            },
                            {
                                "example_id": "35012b75-c23e-4b7c-9eb3-728686f71e49",
                                "sense_id": "e55201b0-c3d3-352a-beda-e53beec2cfed",
                                "text": "„Wenn Daniel einmal in Basel wohnt, kannst du mit ihm keine Lernfahrten mehr machen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "39feee5b-4376-31ca-8a8d-2b986653031b",
                        "entry_id": "bbebc98d-9f4b-3eb6-81e0-638716632716",
                        "glosses": [
                            "Aufsuchen eines entfernteren Ortes zum Erkenntnisgewinn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c3e93ee-5f69-4941-9483-f9b116b368b5",
                                "sense_id": "39feee5b-4376-31ca-8a8d-2b986653031b",
                                "text": "„Freiarbeit, Werkstattarbeit, Stationenbetrieb, Planarbeit, Hausarbeit, Computerarbeit, Außerschulische Arbeit und Lehr- und Lernfahrten werden von Paradies/Linser als Variationen des individualisierenden Unterrichts bezeichnet […].“"
                            },
                            {
                                "example_id": "0b681d70-493d-49b0-8ee6-f97387fef58c",
                                "sense_id": "39feee5b-4376-31ca-8a8d-2b986653031b",
                                "text": "„Dies korrespondiert wiederum mit dem Versuch Dietrichs, seine Reise wie oben bereits erwähnt, als âventiure-Lernfahrt zu inszenieren.“"
                            },
                            {
                                "example_id": "623ef98d-b2bd-4c33-94b0-e2437340e9f3",
                                "sense_id": "39feee5b-4376-31ca-8a8d-2b986653031b",
                                "text": "„Hinsichtlich der Frage nach einer diesbezüglichen Strukturierung der Mentalität künftiger Religionslehrerinnen und Religionslehrer ist an der Katholischen Universität Eichstätt über zwei Jahre hin ein Studienprojekt durchgeführt worden, als dessen erlebnismäßiges Herzstück eine Lernfahrt von Studierenden nach Senegal gelten kann.“"
                            },
                            {
                                "example_id": "11fc7236-eccc-4cc7-aa0a-99dfc61f53f1",
                                "sense_id": "39feee5b-4376-31ca-8a8d-2b986653031b",
                                "text": "übertragen: „Ernst Bloch wollte in den Stationen des Dramas, wie bereits viele spekulierende Interpreten vor ihm, eine ‚Lernfahrt des Subjekts‘ erkennen: Wo Hegel mit den Siebenmeilenstiefeln des Begriffs anlange, komme Faust mit Mephistos Zaubermantel hin.“"
                            },
                            {
                                "example_id": "3f145a05-4897-46b5-9b07-89382aa6c9a2",
                                "sense_id": "39feee5b-4376-31ca-8a8d-2b986653031b",
                                "text": "„Wo unsere gemeinsamen Fortschritte anfangs eher einem blinden Dahintaumeln glichen, gewann unsere Lernfahrt ab einem bestimmten Punkt deutlich an Tempo und führte zu exponentiellen Leistungen.“"
                            },
                            {
                                "example_id": "228d19e5-21f6-4c8d-9114-2dcedbee1256",
                                "sense_id": "39feee5b-4376-31ca-8a8d-2b986653031b",
                                "text": "„Maltes Lernfahrten durch zerstörte Idyllen und Bildräume zeigen: »Ich lerne sehen. […]«“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
