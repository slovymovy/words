                ],
                "translations": [
                    {
                        "translation_id": "393bf4d9-9557-40a4-804c-75f8d9a5e331",
                        "source_entry_id": "5f92ff09-cd57-3ec2-9704-f9fe2dfcd61a",
                        "source_sense_id": "4b79db3d-e30c-30d4-bd7c-618b36e823e2",
                        "target_lang_word": "pelta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pelta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6df9208-e6ec-3f72-b811-532a26934a66",
                                        "entry_id": "6281276c-3ba0-3b9d-baf3-81c5722d1b8c",
                                        "glosses": [
                                            "A small shield, especially one of an approximately elliptical form, or crescent-shaped."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b790ec2e-458d-4138-afeb-cd5f03a3f78c",
                                                "sense_id": "e6df9208-e6ec-3f72-b811-532a26934a66",
                                                "text": "Xenophon also mentions bronze peltae, but probably (like hoplite shields) they were only faced with a thin covering of bronze."
                                            },
                                            {
                                                "example_id": "660d9cf7-d51f-41ee-a4c8-fc263b07d962",
                                                "sense_id": "e6df9208-e6ec-3f72-b811-532a26934a66",
                                                "text": "The other subject illustrated in these scenes of silens carrying peltas appears to be a battle."
                                            },
                                            {
                                                "example_id": "b87cabf1-e4cf-48b3-95b4-52b371db95fe",
                                                "sense_id": "e6df9208-e6ec-3f72-b811-532a26934a66",
                                                "text": "After the Celtic invasion of Greece and the subsequent removal of some Celts (the Galatians) to Asia Minor in the 270s, Greek light troops seem to have stopped using the pelta, and adopted instead the large, oval Celtic shield with a central spine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b963aabb-a5b8-3112-a15a-f6e1cf22bf8f",
                                        "entry_id": "6281276c-3ba0-3b9d-baf3-81c5722d1b8c",
                                        "glosses": [
                                            "A crescent-shaped design used in mosaics."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b81b2eb8-5955-4903-bcae-557047e74ca9",
                                                "sense_id": "b963aabb-a5b8-3112-a15a-f6e1cf22bf8f",
                                                "text": "A pattern of red and blue peltae on a white ground, arranged in groups of four with two peltae placed back to back and one at each end facing inward, forms the outer border on the east side of the mosaic."
                                            },
                                            {
                                                "example_id": "8046495b-20d2-4a5e-8313-6e18e688e317",
                                                "sense_id": "b963aabb-a5b8-3112-a15a-f6e1cf22bf8f",
                                                "text": "Evidently it was a deliberate choice to select from the repertory of opus sectile, often extremely figurative, only those decorative motifs that were amenable to sixteenth-century architectural classicism, like the peltae on the Farnese tables, which were still used for the seventeenth-century pavement of the Confessio of St Peter's."
                                            },
                                            {
                                                "example_id": "85a9b2ee-1528-4aa3-bd7e-7e74a163ee8c",
                                                "sense_id": "b963aabb-a5b8-3112-a15a-f6e1cf22bf8f",
                                                "text": "Surrounding the square frame of round-tongued double guilloche is a broad white band with large lozenges (two on each side), outlined dark grey, with their acute angles terminating in voluted peltae with undulating spurs on their roundels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fbf56c7-f8bd-38fb-b36e-5846c3b5b749",
                                        "entry_id": "6281276c-3ba0-3b9d-baf3-81c5722d1b8c",
                                        "glosses": [
                                            "A flat apothecium with no rim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11471a8d-c38e-4a32-903f-2aba0344cae4",
                                                "sense_id": "5fbf56c7-f8bd-38fb-b36e-5846c3b5b749",
                                                "text": "The calyx is composed of five linear spreading sepals J inch long and attached to the sides of the inferior ovary are four bracts, two of which, the anterior and posterior, remain abortive, whilst the two lateral ones develop into large rounded flattened discs (peltae) attached at the centre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "266c0952-86ba-35e0-b721-a776ee467200",
                                        "entry_id": "6281276c-3ba0-3b9d-baf3-81c5722d1b8c",
                                        "glosses": [
                                            "A crescent-shaped sheet of microtubules that encircles the base of the flagella of a protozoan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa51203-dcb8-4343-834f-24f732e7efb7",
                                                "sense_id": "266c0952-86ba-35e0-b721-a776ee467200",
                                                "text": "The anterior semi-circular pelta surrounds the basal body area and the axostyle forms the longitudinal axis of the cell."
                                            },
                                            {
                                                "example_id": "3ba872ca-acc6-4994-9915-79c0930283c4",
                                                "sense_id": "266c0952-86ba-35e0-b721-a776ee467200",
                                                "text": "A striated parabasal fibre is closely associated with a large parabasal golgi system; a dense pre-axostylar fibre connects to the axostyle, which is a curved sheet of microtubules that encloses the nucleus and extends to (or protrudes from) the posterior end of the cell; the same pre-axostylar fibre links to the pelta, which is a sheet of microtubules that curves around within a sort of collar that encloses the flagellar bases before turning back to meet the axostyle […]"
                                            },
                                            {
                                                "example_id": "66418f93-818b-4240-ab18-83d0c445ffbd",
                                                "sense_id": "266c0952-86ba-35e0-b721-a776ee467200",
                                                "text": "The pelta is a crescent-shaped sheet also formed by microtubules, and it overlaps with the axostyle in the anterior region of the cell. The pelta supports the wall of the anterior region of the cell and the flagellar canal from which the flagella emerges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
