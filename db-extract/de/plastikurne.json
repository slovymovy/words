                                "example_id": "1c5fc8c9-8448-4224-8ecd-34ec4588cccf",
                                "sense_id": "bc12b598-cde1-326c-a3b4-a39145817a2e",
                                "text": "„In der zweiten Schule war im ersten besuchten Wahlzimmer eine leere und nicht versiegelte Plastikurne an der Wand des Zimmers zu sehen.“"
                            },
                            {
                                "example_id": "f2a0e380-6b93-46b7-b82b-cbd7f83eb711",
                                "sense_id": "bc12b598-cde1-326c-a3b4-a39145817a2e",
                                "text": "„›Einen Scheiß verstehst du‹, rief Too Much hinter ihm her. ›Sonst würdest du tote Leute nicht in Plastikurnen zustellen.‹“"
                            }
