                                "target_senses": [
                                    {
                                        "sense_id": "647b5bad-8f67-33b7-9487-4192f7a9383b",
                                        "entry_id": "57b1b507-a0bd-39b3-8cbb-a13fc70177ca",
                                        "glosses": [
                                            "A statement attributed to a person; a quotation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "059c04f4-f1e4-4c93-97d5-df694504bb12",
                                                "sense_id": "647b5bad-8f67-33b7-9487-4192f7a9383b",
                                                "text": "She loved reading quotes of famous people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "956645d1-02f3-3200-b548-34522b82f3fd",
                                        "entry_id": "57b1b507-a0bd-39b3-8cbb-a13fc70177ca",
                                        "glosses": [
                                            "A quotation mark."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f2a2c02-5c0a-3cc1-a134-7148c376fb86",
                                        "entry_id": "57b1b507-a0bd-39b3-8cbb-a13fc70177ca",
                                        "glosses": [
                                            "A summary of work to be done with a set price; a quotation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0413156-53f4-4b2a-9d20-90df33b7b46b",
                                                "sense_id": "5f2a2c02-5c0a-3cc1-a134-7148c376fb86",
                                                "text": "After going over the hefty quotes, the board decided it was cheaper to have the project executed by its own staff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d52400-c170-3954-b66d-6a600e176498",
                                        "entry_id": "57b1b507-a0bd-39b3-8cbb-a13fc70177ca",
                                        "glosses": [
                                            "A price set and offered (by the potential seller) for a financial security or commodity; a quotation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "quote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2163d757-1e45-3c07-8295-38d524f39093",
                                        "entry_id": "07508891-7d44-357e-8703-52b35a819b82",
                                        "glosses": [
                                            "To repeat (the exact words of a person)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "020187c4-17c4-440b-9cac-0fabb32928e5",
                                                "sense_id": "2163d757-1e45-3c07-8295-38d524f39093",
                                                "text": "The writer quoted the president's speech."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbfee7c4-1379-3891-81f9-aca71ef944b9",
                                        "entry_id": "07508891-7d44-357e-8703-52b35a819b82",
                                        "glosses": [
                                            "To prepare a summary of work to be done and set a price; to estimate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d59ebb5b-d38c-4ddd-baf3-2ef097a49fba",
                                                "sense_id": "fbfee7c4-1379-3891-81f9-aca71ef944b9",
                                                "text": "Can you believe they quoted me $5,000?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca1f4454-79fb-31f0-a396-344c9bd66083",
                                        "entry_id": "07508891-7d44-357e-8703-52b35a819b82",
                                        "glosses": [
                                            "To name the current price, notably of a financial security."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a22bcd43-20fe-3b58-bf92-ca7d2aefcfca",
                                        "entry_id": "07508891-7d44-357e-8703-52b35a819b82",
                                        "glosses": [
                                            "To indicate verbally or by equivalent means the start of a quotation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d185d1e9-558c-310e-bb7e-a8568b4017c9",
                                        "entry_id": "07508891-7d44-357e-8703-52b35a819b82",
                                        "glosses": [
                                            "To observe, to take account of."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b3b5c2-3477-4a04-848c-c8953ad7533c",
                                                "sense_id": "d185d1e9-558c-310e-bb7e-a8568b4017c9",
                                                "text": "But must our moderne Critticks envious eye\nSeeme thus to quote some grosse deformity?"
                                            },
                                            {
                                                "example_id": "1eb2187c-d84b-40e5-b768-da693482de67",
                                                "sense_id": "d185d1e9-558c-310e-bb7e-a8568b4017c9",
                                                "text": "That hath made him mad.\nI am sorry that with better heed and judgment\nI had not quoted him. I fear'd he did but trifle …"
                                            },
                                            {
                                                "example_id": "0d8935cd-d962-4d51-8328-0a88f1833752",
                                                "sense_id": "d185d1e9-558c-310e-bb7e-a8568b4017c9",
                                                "text": "I prethe doe, twill be a sceane of mirth\nFor me to quote his passions and his smiles,\nHis amorous haviour, …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quote",
                                "target_lang_code": "en",
                                "target_senses": [
