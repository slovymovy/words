                "word": "blocking",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a9856621-af3d-45c2-ba91-86a5464da2c2",
                        "entry_id": "45aa5a9f-8a63-356f-af9e-e7f0a86fc8a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "blockings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ecc12050-2642-301b-b677-87dbca91dca4",
                        "entry_id": "45aa5a9f-8a63-356f-af9e-e7f0a86fc8a8",
                        "glosses": [
                            "The act by which something is blocked; an obstruction."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "84090252-b8af-4200-ae49-61d1813abddd",
                                "sense_id": "ecc12050-2642-301b-b677-87dbca91dca4",
                                "text": "blocking of major opposition sites"
                            },
                            {
                                "example_id": "cc007ef6-0f4e-4ad8-a2ae-956a62a2e916",
                                "sense_id": "ecc12050-2642-301b-b677-87dbca91dca4",
                                "text": "Miss H.'s voice was clear and intelligible, although it alternated between vocal blockings and extreme vocal hurry, every clause being jetted out suddenly, and rapidly decaying into aphonia."
                            }
                        ]
                    },
                    {
                        "sense_id": "8dd6310a-8010-32cb-88ad-b868456b8b6f",
                        "entry_id": "45aa5a9f-8a63-356f-af9e-e7f0a86fc8a8",
                        "glosses": [
                            "The precise movement and positioning of actors in order to facilitate a performance (originally planned using miniature blocks)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ce2852ce-f04f-3c2d-9f09-b3a3cbf26e58",
                        "entry_id": "45aa5a9f-8a63-356f-af9e-e7f0a86fc8a8",
                        "glosses": [
                            "Blocks used to support (a building, etc.) temporarily."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c166993a-0468-3445-b59c-2ef5f1f29375",
                        "entry_id": "45aa5a9f-8a63-356f-af9e-e7f0a86fc8a8",
                        "glosses": [
                            "A feature that prevents a keyboard from registering multiple simultaneous keypresses that would cause ghosting."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9c9136fd-4154-48a0-849e-fe94dbdb8a87",
                                "sense_id": "c166993a-0468-3445-b59c-2ef5f1f29375",
                                "text": "Examine your matrix map, and make sure that no three keystrokes form a rectangle with a fourth keystroke that will cause you problems. This prevents both ghosting and blocking."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9ff41c6-48e8-3b45-80a8-b3f56192a405",
                        "entry_id": "45aa5a9f-8a63-356f-af9e-e7f0a86fc8a8",
                        "glosses": [
                            "A rectangular discontinuity as an artifact of separating a discrete signal into blocks that are processed individually."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6337eacc-19b4-436f-9b8b-f5537acd441a",
                                "sense_id": "e9ff41c6-48e8-3b45-80a8-b3f56192a405",
                                "text": "Blocking is an annoying effect in image compression using JPEG especially at low bit-rates."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4107fdd2-94b0-42bc-9c04-f2df54a8c50d",
                        "source_entry_id": "45aa5a9f-8a63-356f-af9e-e7f0a86fc8a8",
