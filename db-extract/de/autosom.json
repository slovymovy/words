                        "entry_id": "41c8897e-45d4-31fc-a5e9-de0488e67061",
                        "glosses": [
                            "Chromosom, das bei diploiden Zellen beider Geschlechter paarweise auftritt und somit nicht geschlechtsgebunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c572ed7-21d9-4d85-8c25-cb9fc88177d6",
                                "sense_id": "750d1d73-e0c3-3a88-9995-b219dea6343f",
                                "text": "„Das einzige X-Chromosom fusioniert mit einem Autosom.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d848c3e7-93ad-4622-a896-ef5ced8dbf99",
