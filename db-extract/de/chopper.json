                        "entry_id": "05d3c0ed-0d42-3140-aa16-9646114dd4e4",
                        "glosses": [
                            "eine allgemeine Bezeichnung für einen mechanisch, elektrisch oder elektronisch arbeitenden Unterbrecher"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "afef285c-781f-3e93-9687-3efcbf319c79",
                        "entry_id": "05d3c0ed-0d42-3140-aa16-9646114dd4e4",
                        "glosses": [
                            "ein aus einem Geröllstück gefertigtes Werkzeug der Altsteinzeit mit einer einflächig behauenen Arbeitsfläche, die zum Knacken von Nüssen, Schalentieren oder Markknochen gedient hat."
                        ],
                        "tags": [
                            "Vorgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "5e0e0dde-a196-4cc5-b541-1824e9578f0f",
                                "sense_id": "afef285c-781f-3e93-9687-3efcbf319c79",
                                "text": "„Ein Chopper ist ein prähistorisches Steinwerkzeug zum Aufschlagen von Nüssen, Schalentieren oder Markknochen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "299cde4c-c51d-3590-935a-ef3f2ac8752f",
                        "entry_id": "05d3c0ed-0d42-3140-aa16-9646114dd4e4",
                        "glosses": [
                            "Motorrad, welches mit einer flach angestellten Vorderradgabel ausgestattet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2485c76-c4b3-41de-92ea-04443b4219f7",
                                "sense_id": "299cde4c-c51d-3590-935a-ef3f2ac8752f",
                                "text": "\"Vielleicht hat der Ungar Istvan Puskas das Wort Chopper etwas zu wörtlich genommen.\""
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
