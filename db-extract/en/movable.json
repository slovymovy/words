                    {
                        "translation_id": "9ba7eca4-7cf3-4c01-91c0-f8e791260e8c",
                        "source_entry_id": "6d4d7d73-097a-36f5-93d1-4d1f19815415",
                        "source_sense_description": "capable of being moved",
                        "target_lang_word": "beweglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beweglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb807e1f-ee65-3971-bc43-006346b2bd5b",
                                        "entry_id": "d0a51cfe-c1ca-3aef-b2da-47e8e27c0a31",
                                        "glosses": [
                                            "in der Lage, sich zu bewegen oder bewegt zu werden"
                                        ],
                                        "tags": [
                                            "körperlich",
                                            "real"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9613591-226f-485f-b39e-f4a702186f96",
                                                "sense_id": "eb807e1f-ee65-3971-bc43-006346b2bd5b",
                                                "text": "Das Rad ist frei beweglich."
                                            },
                                            {
                                                "example_id": "6d530923-918e-4afc-b742-cb59d63d248b",
                                                "sense_id": "eb807e1f-ee65-3971-bc43-006346b2bd5b",
                                                "text": "Opa ist noch sehr beweglich."
                                            },
                                            {
                                                "example_id": "d8db935d-7e7e-4b45-9f5f-ce3395eff2b4",
                                                "sense_id": "eb807e1f-ee65-3971-bc43-006346b2bd5b",
                                                "text": "Die beweglichen Teile der Nähmaschine müssen regelmäßig geölt werden."
                                            },
                                            {
                                                "example_id": "0b4a6244-3621-4d01-a14b-7c6c6685e8f4",
                                                "sense_id": "eb807e1f-ee65-3971-bc43-006346b2bd5b",
                                                "text": "Dieser Kaspar ist eine Marionette mit beweglichem Mund."
                                            },
                                            {
                                                "example_id": "84dd558e-9848-4675-8032-6a6cccdfba14",
                                                "sense_id": "eb807e1f-ee65-3971-bc43-006346b2bd5b",
                                                "text": "„Er betrieb Krafttraining, warf schwere Medizinbälle und erfand allerlei Übungen, um seine Finger beweglicher zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0586a271-3028-3f15-b501-39ef8fd51f7a",
                                        "entry_id": "d0a51cfe-c1ca-3aef-b2da-47e8e27c0a31",
                                        "glosses": [
                                            "in der Lage, die Geisteshaltung zu verändern"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab9197a2-5264-4bc6-a789-e744a8b83e88",
                                                "sense_id": "0586a271-3028-3f15-b501-39ef8fd51f7a",
                                                "text": "Als Politiker sollte man sich in Sachfragen schon beweglich zeigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7466ce2d-ebb7-3b9e-90bd-6f04181ec318",
                                        "entry_id": "d0a51cfe-c1ca-3aef-b2da-47e8e27c0a31",
                                        "glosses": [
                                            "in der Lage, fortbewegt zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef393291-29d5-456e-89a2-aaf0129e5a4b",
                                                "sense_id": "7466ce2d-ebb7-3b9e-90bd-6f04181ec318",
                                                "text": "Ihnen blieb nur das Wenige, was sie von ihrer beweglichen Habe retten konnten."
                                            },
                                            {
                                                "example_id": "614fd33e-6fce-422a-a7da-2c90dc683be4",
                                                "sense_id": "7466ce2d-ebb7-3b9e-90bd-6f04181ec318",
                                                "text": "„Die sechsmonatige Frist zur Geltendmachung von Gewährleistungsansprüchen gilt für die Lieferung beweglicher Sachen auch dann, wenn diese dazu bestimmt sind, durch nicht mehr dem Lieferanten obliegende Tätigkeiten Bestandteile einer unbeweglichen Sache zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
