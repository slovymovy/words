                                        "sense_id": "4d4546be-6f6e-3fd9-87f6-6be8e8132ec0",
                                        "entry_id": "476028f9-6b29-334e-80a7-87577ac64e85",
                                        "glosses": [
                                            "The characteristic of being indispensable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7359a651-e44a-46f9-9904-10a285097648",
                                                "sense_id": "4d4546be-6f6e-3fd9-87f6-6be8e8132ec0",
                                                "text": "In thinly-peopled spots, I have known brick-layers on tramp, coming up with bricklayers at work, to be so sensible of the indispensability of lookers-on, that they themselves have sat up in that capacity, and have been unable to subside into the acceptance of a proffered share in the job, for two or three days together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e15b5a8-eee2-32bf-87dc-51973ff27975",
                                        "entry_id": "476028f9-6b29-334e-80a7-87577ac64e85",
                                        "glosses": [
                                            "Something indispensable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef410ce1-4a47-4819-ba26-d8ad3048bdae",
                                                "sense_id": "8e15b5a8-eee2-32bf-87dc-51973ff27975",
                                                "text": "Beetle: Yes, I am certain I can be helpful. Indispensable!\nMonkey: In what way?\n[Beetle displays his ability with bow and arrow, firing multiple arrows on the same spot]\n[…]\nBeetle: Just tell me of our quest, and I will immediately demonstrate my numerous indispensabilities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
