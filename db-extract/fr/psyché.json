                                        "entry_id": "1dd8315f-cde5-307f-80cb-f4893987ce73",
                                        "glosses": [
                                            "Gesamtheit der bewussten und unterbewussten Vorgänge des Gehirns; des Denkens und des Fühlens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5068265e-3924-4bbe-9804-3f56fffa9396",
                                                "sense_id": "2a5bb76a-d08e-3305-903c-7e00a4b67310",
                                                "text": "„Wie reagiert die Psyche des Straßenbahnkondukteurs auf ein Douceur von ungewöhnlichem Ausmaße, das zum Beispiel mehr als dreimal so groß ist als der Fahrpreis und siebenmal so groß als das Normaltrinkgeld!“"
                                            },
                                            {
                                                "example_id": "4d11c214-22c6-4500-be33-fb2142b83ad2",
                                                "sense_id": "2a5bb76a-d08e-3305-903c-7e00a4b67310",
                                                "text": "„Epel und Blackburn konnten auch den Einfluss der Psyche belegen.“"
                                            },
                                            {
                                                "example_id": "89a57135-cbf9-4a47-89a2-a6c5df805815",
                                                "sense_id": "2a5bb76a-d08e-3305-903c-7e00a4b67310",
                                                "text": "„Bereitwillig wendet sich Jünger den von Hoffmanns Werk eingehend behandelten Nacht-Seiten der Psyche und Kunst zu, das sind: Traum, Wahnsinn, Maskenspiel, sexuelle Devianz, Persönlichkeitsspaltung, das Groteske.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
