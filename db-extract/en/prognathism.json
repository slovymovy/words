                                    {
                                        "sense_id": "c306ebef-6b28-39a0-ba3f-819f334027fa",
                                        "entry_id": "32197707-4455-3c90-b618-1d2bd4ed806d",
                                        "glosses": [
                                            "Disposition allongée de la face, qui porte la mâchoire en avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6440eaef-9bf6-451e-acae-19aad90dfb02",
                                                "sense_id": "c306ebef-6b28-39a0-ba3f-819f334027fa",
                                                "text": "Je souffre d’un léger prognathisme car ma mâchoire inférieure passe devant ma mâchoire supérieure."
                                            },
                                            {
                                                "example_id": "4444b679-3598-4afa-9560-9deb945864d8",
                                                "sense_id": "c306ebef-6b28-39a0-ba3f-819f334027fa",
                                                "text": "Un prognathisme de la mâchoire inférieure l’empêchait d’articuler, il [Chris Marker] parlait dents serrées et compensait la rareté de sa parole par un port de tête orgueilleux et ironique, qui changeait en énigmatique maxime chacune de ses proférations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e39bb26-e38c-3823-ba63-c54a9b32558e",
                                        "entry_id": "32197707-4455-3c90-b618-1d2bd4ed806d",
                                        "glosses": [
                                            "Configuration faciale selon laquelle une des deux mâchoires est plus longue que l’autre (particulièrement chez le chien)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc0fe5c-c92e-4147-903b-30764b6c7a59",
                                                "sense_id": "5e39bb26-e38c-3823-ba63-c54a9b32558e",
                                                "text": "Un chien possédant un prognathisme supérieur est dit bégu."
                                            },
                                            {
                                                "example_id": "8c2a5fce-ecad-44fc-86f6-bc6a9c6c3004",
                                                "sense_id": "5e39bb26-e38c-3823-ba63-c54a9b32558e",
                                                "text": "Un chien possédant un prognathisme inférieur excessif est dit grignard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
