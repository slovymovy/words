                    },
                    {
                        "translation_id": "8dbefe14-e779-47c9-9ee7-78122acb8104",
                        "source_entry_id": "30a2563a-b88f-3f96-acdb-a525438f6cb7",
                        "source_sense_id": "349cd386-0ece-3c81-aae9-26e94a685a60",
                        "target_lang_word": "Zimmes",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zimmes",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebc3ec45-82d6-36d3-9e93-3b4b978bf072",
                                        "entry_id": "a9b41826-7d7b-3e43-b477-2ebe65bd0ba1",
                                        "glosses": [
                                            "aus Möhren zubereitetes Gericht der jüdischen Küche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db0d1ea8-bd4e-4e50-aa65-a4a947374c9c",
                                                "sense_id": "ebc3ec45-82d6-36d3-9e93-3b4b978bf072",
                                                "text": "„Sein kleiner Enkelsohn machte ihm viel Freude; er war in seinen Briefen der wichtigste Protagonist: ›A ganzer Mensch‹, schrieb er auf Jiddisch, weil der Junge schon mit allen anderen am Tisch sitzen und das Gleiche essen konnte wie die Erwachsenen: Mutters Fisch und ein bisschen Zimmes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c8aabf8-cada-4fb6-b6e7-ac8ac7a53ad2",
                        "source_entry_id": "30a2563a-b88f-3f96-acdb-a525438f6cb7",
                        "source_sense_id": "349cd386-0ece-3c81-aae9-26e94a685a60",
                        "target_lang_word": "ци́мес",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ци́мес",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "88e6ee12-c26d-3458-99df-a097e831c66d",
                                        "entry_id": "8e159701-b69c-30b3-8467-f5f20319f473",
                                        "glosses": [
                                            "кулин. десертное блюдо еврейской кухни, сладкое овощное рагу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "402f6f6d-f922-45d4-a4e5-ef5ae5d0870d",
                                                "sense_id": "88e6ee12-c26d-3458-99df-a097e831c66d",
                                                "text": "В доме были радость и веселье, и Рифка, к другому дню, который был шабаш, испекла пирогов с медом и маком и кугель, изжарила гуся, сварила локшину* и цимес** и даже попотчевала меня кошерным виноградным вином. ❬…❭ (**) Морковь с мёдом, жиром и пряными кореньями"
                                            },
                                            {
                                                "example_id": "ff711abf-0268-4a87-ac19-819ffb34d5a3",
                                                "sense_id": "88e6ee12-c26d-3458-99df-a097e831c66d",
                                                "text": "Василий Иванович с необычайной сердечностью рассказывал об этом пиршестве с фаршированными щуками, цимесом и пейсаховкой, где были исключительно «все свои»…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f7dea2d-e830-3f74-9b5e-cf75d46770e7",
                                        "entry_id": "8e159701-b69c-30b3-8467-f5f20319f473",
                                        "glosses": [
                                            "перен., жарг. нечто очень хорошее, высококачественное, приятное"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf25518-a8a0-44e7-b60f-0f8d75f076b0",
                                                "sense_id": "2f7dea2d-e830-3f74-9b5e-cf75d46770e7",
                                                "text": "Девка просто цимес (компот). Лучшей и желать нельзя."
                                            },
                                            {
                                                "example_id": "9f069d2d-ce52-49c5-bd04-33d0640cf557",
                                                "sense_id": "2f7dea2d-e830-3f74-9b5e-cf75d46770e7",
                                                "text": "Так я вам это тоже скажу, ― продолжал он, взяв скверненький тон интимной конфиденции, ― ко мне пришла «девочка»… Ну, знаете, это не «девочка», а прямо «цимес». Ой, какая!.. Ну, вот я и был занят с ней… «гонял любовь»…"
                                            },
                                            {
                                                "example_id": "d9acac6a-6d49-4bb2-a71b-055fff726d60",
                                                "sense_id": "2f7dea2d-e830-3f74-9b5e-cf75d46770e7",
                                                "text": "За нею выступил картавящий брюнет, что‑то вроде партинструктора, и приветствовал труппу в таком же изысканном стиле: «В вашем театре наши товарищи находили того кое-чего, чего они не находили в других театрах», причем сложенные щепоткой пальцы правой руки давали понять, что в этом кое-чего и был «самый цимес» ценимого пролетариатом искусства."
                                            },
                                            {
                                                "example_id": "2cd11bf7-bf63-43d9-9d64-db1eb23e8a41",
                                                "sense_id": "2f7dea2d-e830-3f74-9b5e-cf75d46770e7",
                                                "text": "Я смотрю, замерев от восторга, а Митя мне шепчет, что надо умыться, чтоб не украл упырь, он на красоту падкий, хорошенькие девочки ― это ему самый цимес. «Цимес» я понимаю. Поднеся деревянную ложку ко рту с борщевой жижей, бабушка причмокивает и говорит: \"Цимес!"
                                            },
                                            {
                                                "example_id": "8edbfd6f-d45a-4d35-9af6-ed7fd168eb60",
                                                "sense_id": "2f7dea2d-e830-3f74-9b5e-cf75d46770e7",
                                                "text": "В чём цимес Вермахта ― в танковых и мотопехотных дивизиях, собранных в кулак."
                                            }
                                        ]
                                    },
