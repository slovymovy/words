                    {
                        "translation_id": "21736c69-683c-4b56-95bf-109d87d80120",
                        "source_entry_id": "da2cfda5-63a2-3af8-86f1-1a43210a81c6",
                        "source_sense_id": "9751c5b1-4061-3dea-9d09-835dad9fe64c",
                        "source_sense_description": "een schepping, iets totaal nieuw",
                        "target_lang_word": "Schöpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schöpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f24836b6-5fe5-3b34-a0e1-7c9d1098f891",
                                        "entry_id": "86f05b5d-38e1-32ce-9702-99423e156282",
                                        "glosses": [
                                            "das Schaffen / Erschaffen der Welt aus dem Nichts durch ein höheres Wesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2aae177-b83a-42a9-92f2-94b95c9cf22f",
                                                "sense_id": "f24836b6-5fe5-3b34-a0e1-7c9d1098f891",
                                                "text": "Nach dem Schöpfungsbericht des Pentateuch hat die Schöpfung der Erde sieben Tage gedauert."
                                            },
                                            {
                                                "example_id": "29a2a06e-5155-4df7-8f1e-1b6c9e5ab7e6",
                                                "sense_id": "f24836b6-5fe5-3b34-a0e1-7c9d1098f891",
                                                "text": "„… Andererseits stellt jede Schöpfung, da sie ein göttliches Werk ist, auch einen Einbruch schöpferischer Energie in die Welt dar. Jede Schöpfung ist Ausfluß einer Fülle. Die Götter, die Demiurgen, die mystischen Ahnen erschaffen aus einem Übermaß von Macht, aus einer Überfülle von Energie. Die Schöpfung ist Folge eines ontologischen Überflusses. …“"
                                            },
                                            {
                                                "example_id": "185afcc9-f74e-4832-93ff-ab11966a0c2e",
                                                "sense_id": "f24836b6-5fe5-3b34-a0e1-7c9d1098f891",
                                                "text": "\"… Es kann nicht bestritten werden, daß die Traditionen, die von der Erschaffung des Himmels und der Erde, der Pflanzen und der Tiere, des Mannes und der Frau sprachen, damit wirkliches Geschehen meinten. Die Kategorie des Symbolischen ist diesem Reden fremd. Aber auch die Betonung des rein religiösen Charakters des Redens von Schöpfer und Schöpfung ist dem Text nicht gemäß; denn gerade dieses Reden kennt die Sonderung eines religiösen Bereiches noch nicht, es steht noch jenseits der Scheidung von Religion, Philosophie und Wissenschaft. Auch die in der protestantischen Exegese heilsgeschichtliche Deutung der Schöpfung … ist den Texten selbst fremd. …\""
                                            },
                                            {
                                                "example_id": "b5de137c-7064-4394-81d7-c6141552ac55",
                                                "sense_id": "f24836b6-5fe5-3b34-a0e1-7c9d1098f891",
                                                "text": "„Der Schöpfung lag in anderes Gesetz zugrunde, und ihre Achtung vor dem großen Mann nahm ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "65b382d7-b2be-3116-9413-2b2e4b4c09de",
                                        "entry_id": "86f05b5d-38e1-32ce-9702-99423e156282",
                                        "glosses": [
                                            "das Schaffen / Erschaffen eines bedeutenden Werkes durch eine menschliche Person"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92393ff2-8936-4ed4-82db-39e28911ea06",
                                                "sense_id": "65b382d7-b2be-3116-9413-2b2e4b4c09de",
                                                "text": "Für die Schöpfung dieses Kunstwerkes hat er Jahre gebraucht."
                                            },
                                            {
                                                "example_id": "b784feea-d807-4c81-8b79-0eba1bcff468",
                                                "sense_id": "65b382d7-b2be-3116-9413-2b2e4b4c09de",
                                                "text": "Mit der Schöpfung des Requiems hat der Komponist sein Meisterwerk vollbracht."
                                            },
                                            {
                                                "example_id": "9de6f34e-a889-4009-bd15-3d3f949323a4",
                                                "sense_id": "65b382d7-b2be-3116-9413-2b2e4b4c09de",
                                                "text": "Die Schöpfung des modernen Menschen ist ein Werk der Renaissance."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "a93460f4-19b8-32f9-8aa7-9671d7aa6d4d",
                                        "entry_id": "86f05b5d-38e1-32ce-9702-99423e156282",
                                        "glosses": [
                                            "das Schaffen / Erschaffen der Welt aus dem Nichts durch die Natur"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "1929165f-4d24-3e03-8493-5c061be79515",
                                        "entry_id": "86f05b5d-38e1-32ce-9702-99423e156282",
                                        "glosses": [
                                            "das von diesem höheren Wesen^([1a]) freigesetzte Geschaffene selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b27aea74-1674-4b94-95f7-eac6a5719abe",
                                                "sense_id": "1929165f-4d24-3e03-8493-5c061be79515",
                                                "text": "Wir sind alle Teil von Gottes Schöpfung."
                                            },
                                            {
                                                "example_id": "bce87fb9-ba65-4d6b-bf22-b5817568b45e",
                                                "sense_id": "1929165f-4d24-3e03-8493-5c061be79515",
                                                "text": "„Jene, die durch Wesen und Wirken das Feuer der Schöpfung lebendig erhielten und es weitergaben, sie, die großen Unbekannten, waren die Wächter der Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "4ab064f3-3a09-39f9-bcdf-f4e7d5f1ec92",
                                        "entry_id": "86f05b5d-38e1-32ce-9702-99423e156282",
                                        "glosses": [
                                            "im übertragenen Sinne: ein bedeutendes (künstlerisches) Werk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25bb961f-dc92-4ae1-b699-43588406e168",
                                                "sense_id": "4ab064f3-3a09-39f9-bcdf-f4e7d5f1ec92",
                                                "text": "Gestern sind die jüngsten Schöpfungen des großen Modemachers vorgestellt worden."
                                            },
                                            {
                                                "example_id": "23b5dbef-5c8b-4b47-a12e-629042a9b5b6",
                                                "sense_id": "4ab064f3-3a09-39f9-bcdf-f4e7d5f1ec92",
                                                "text": "Voltaires Dramen werden heutzutage als mindere Schöpfungen des Autors angesehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af257352-73a4-4649-a116-cfdc65458746",
                        "source_entry_id": "da2cfda5-63a2-3af8-86f1-1a43210a81c6",
