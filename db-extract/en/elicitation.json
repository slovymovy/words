                    {
                        "translation_id": "014c8768-2360-4a95-8b71-4486b374870a",
                        "source_entry_id": "8fd12a1a-c32d-351d-a13c-e9eedf042921",
                        "source_sense_description": "act of eliciting",
                        "target_lang_word": "Erhebung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erhebung",
