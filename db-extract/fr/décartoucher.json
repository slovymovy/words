                "senses": [
                    {
                        "sense_id": "52fd2c88-dd3a-34e6-85c8-4a2bd918ffe9",
                        "entry_id": "4974c5dd-0665-3b65-96ee-f26579045de3",
                        "glosses": [
                            "Défaire les cartouches de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44388d51-3337-4316-a335-7743a9f6c41f",
                                "sense_id": "52fd2c88-dd3a-34e6-85c8-4a2bd918ffe9",
                                "text": "Dans les manipulations, quand pour charger une torpille, par exemple, on sera forcé de la décartoucher, opération qui ne peut guère être faite qu’avec les mains, il faudra, aussitôt le travail terminé, se laver avec soin et faire disparaître de la peau et surtout des ongles toute trace de nitroglycérine."
                            },
                            {
                                "example_id": "cf47ac52-a075-485c-9b50-7b69873b66a0",
                                "sense_id": "52fd2c88-dd3a-34e6-85c8-4a2bd918ffe9",
                                "text": "Le 18 décembre 1882, 23 ouvrières travaillent dans les bâtiments de la cartoucherie, des baraques de bois. Elles ont pour mission de « décartoucher » les munitions pour en récupérer le salpêtre."
                            }
                        ]
                    }
