{
    "word_family": [
        "przepaść",
        "przepadły"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f28a1de-59f6-3aa6-91e6-e8fd5c464e5a",
                    "sense_definition": "bardzo lubić coś lub kogoś",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lubienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Maciek nie <w>przepada</w> za filmami krótkometrażowymi.",
                            "target_lang_translations": {
                                "ru": "Мацек не <w>особо жалует</w> короткометражные фильмы."
                            }
                        },
                        {
                            "text": "Moja siostra <w>przepada</w> za słodyczami, dlatego zawsze kupuję jej czekoladę.",
                            "target_lang_translations": {
                                "ru": "Моя сестра <w>обожает</w> сладости, поэтому я всегда покупаю ей шоколад."
                            }
                        }
                    ],
                    "synonyms": [
                        "uwielbiać"
                    ],
                    "common_phrases": [
                        "przepadać za czymś"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень сильно любить что-то или кого-то, быть без ума от чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обожать",
                                "target_lang_sense_clarification": "сильно любить, испытывать восторг"
                            },
                            {
                                "target_lang_word": "души не чаять",
                                "target_lang_sense_clarification": "очень сильно любить (обычно о людях)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "451d9bce-524d-3cd3-92ec-95063922a27b",
                    "sense_definition": "stawać się niełatwym do odnalezienia lub niewidocznym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "znikanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Klucze do mieszkania nagle <w>przepadły</w> w całym tym bałaganie.",
                            "target_lang_translations": {
                                "ru": "Ключи от квартиры внезапно <w>пропали</w> во всём этом беспорядке."
                            }
                        },
                        {
                            "text": "Wszystkie moje notatki <w>przepadły</w> bez śladu podczas awarii komputera.",
                            "target_lang_translations": {
                                "ru": "Все мои заметки <w>исчезли</w> без следа во время сбоя компьютера."
                            }
                        }
                    ],
                    "synonyms": [
                        "znikać",
                        "gubić się"
                    ],
                    "common_phrases": [
                        "przepaść bez śladu"
                    ],
                    "target_lang_definitions": {
                        "ru": "становиться невидимым, теряться, исчезать из поля зрения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропадать",
                                "target_lang_sense_clarification": "исчезать, теряться"
                            },
                            {
                                "target_lang_word": "исчезать",
                                "target_lang_sense_clarification": "становиться невидимым, пропадать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a75fe2c5-9d30-3aca-8cbc-91919b8cab69",
                    "sense_definition": "nie osiągać zamierzonego celu lub przegrywać w rywalizacji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "niepowodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kandydat <w>przepadł</w> w wyborach już w pierwszej turze głosowania.",
                            "target_lang_translations": {
                                "ru": "Кандидат <w>провалился</w> на выборах уже в первом туре голосования."
                            }
                        },
                        {
                            "text": "Projekt <w>przepadł</w> w głosowaniu, ponieważ nie uzyskał wystarczającego poparcia.",
                            "target_lang_translations": {
                                "ru": "Проект <w>провалился</w> при голосовании, так как не получил достаточной поддержки."
                            }
                        }
                    ],
                    "synonyms": [
                        "przegrywać",
                        "nie udawać się"
                    ],
                    "target_lang_definitions": {
                        "ru": "не достигать цели, проигрывать в соревновании или голосовании"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провалиться",
                                "target_lang_sense_clarification": "потерпеть неудачу, не пройти (на выборах)"
                            },
                            {
                                "target_lang_word": "проиграть",
                                "target_lang_sense_clarification": "потерпеть поражение в соревновании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b2b40ec-652f-30de-a1a5-4f9542ceeda3",
                    "sense_definition": "ulegać marnowaniu lub bezpowrotnej utracie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marnowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszystkie pieniądze zainwestowane w ten ryzykowny biznes <w>przepadły</w>.",
                            "target_lang_translations": {
                                "ru": "Все деньги, вложенные в этот рискованный бизнес, <w>пропали</w>."
                            }
                        },
                        {
                            "text": "Jeśli nie wykorzystasz urlopu do końca roku, dni wolne <w>przepadną</w>.",
                            "target_lang_translations": {
                                "ru": "Если ты не используешь отпуск до конца года, выходные дни <w>сгорят</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "marnować się"
                    ],
                    "target_lang_definitions": {
                        "ru": "безвозвратно теряться, пропадать из-за неиспользования или неудачи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропадать",
                                "target_lang_sense_clarification": "теряться, приходить в негодность"
                            },
                            {
                                "target_lang_word": "сгорать",
                                "target_lang_sense_clarification": "теряться, аннулироваться (о деньгах, отпуске)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}