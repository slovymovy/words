                    }
                ],
                "senses": [
                    {
                        "sense_id": "3dcfb967-b867-38e7-af87-86e982543c8e",
                        "entry_id": "05ccde40-f940-3433-847f-217d90ece234",
                        "glosses": [
                            "A linear arrangement of condensed DNA and associated proteins (such as chaperone proteins) which contains the genetic material (genome) of an organism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "270c086a-44b1-408d-970c-6eb6d9f98cae",
                                "sense_id": "3dcfb967-b867-38e7-af87-86e982543c8e",
                                "text": "Chromosomes store genetic information."
                            },
                            {
                                "example_id": "b53f52fa-632e-4f4f-a6aa-0e6e15966a02",
                                "sense_id": "3dcfb967-b867-38e7-af87-86e982543c8e",
                                "text": "A length of DNA is divided into segments called chromosomes and shorter individual units called genes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2436c369-d620-4390-8d7f-6061fe57cfaf",
                        "source_entry_id": "05ccde40-f940-3433-847f-217d90ece234",
                        "source_sense_id": "3dcfb967-b867-38e7-af87-86e982543c8e",
