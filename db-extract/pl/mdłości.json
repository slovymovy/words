                                    {
                                        "sense_id": "94a9426d-31b1-3685-92b1-ab98e9d3320e",
                                        "entry_id": "0230a9f5-10d4-3cc2-b53b-dcec0318c41c",
                                        "glosses": [
                                            "A feeling of illness or discomfort in the digestive system, usually characterized by a strong urge to vomit."
                                        ],
                                        "tags": [
                                            "countable",
