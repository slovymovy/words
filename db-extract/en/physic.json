                "senses": [
                    {
                        "sense_id": "5c4c9d69-7cc7-399e-b877-6c2558d8e935",
                        "entry_id": "c8212d7b-5c68-3542-937f-e3b470af3f47",
                        "glosses": [
                            "To cure or heal."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a5e35e79-1bc5-4aad-b1ef-7047f3f6c3f4",
                                "sense_id": "5c4c9d69-7cc7-399e-b877-6c2558d8e935",
                                "text": "Wouldſt thou not haue ſome Bulchin from the herd / To phyſicke thee of this venereall itch?"
                            }
                        ]
                    },
                    {
                        "sense_id": "35b741c6-36f7-3417-a0ea-29652001e999",
                        "entry_id": "c8212d7b-5c68-3542-937f-e3b470af3f47",
                        "glosses": [
                            "To administer medicine to, especially a purgative."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3f3ff2b4-ab27-4a45-b68f-617cc3bc4fcc",
                                "sense_id": "35b741c6-36f7-3417-a0ea-29652001e999",
                                "text": "I will physic your rankness […]"
                            },
                            {
                                "example_id": "31979890-fbe6-4adf-bbd0-0192310ea09c",
                                "sense_id": "35b741c6-36f7-3417-a0ea-29652001e999",
                                "text": "When she had been a little girl - a very little girl - her mother had once cried at Anne in utter exasperation, \"You're so contrary cheese'd physic ya!\""
                            }
                        ]
                    }
