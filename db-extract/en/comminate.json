                "senses": [
                    {
                        "sense_id": "98cf193f-55c3-3c58-bc46-9e398b5324f4",
                        "entry_id": "65015f93-4817-3f05-81f6-c6e3527c12df",
                        "glosses": [
                            "jemanden (öffentlich) anprangern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2736c3be-43f7-4499-844e-21bb19914dbe",
                                "sense_id": "98cf193f-55c3-3c58-bc46-9e398b5324f4",
                                "text": "„Then Mr. Morris comminated war and Colonial Federation (a device to keep up profit-mongering), and avowed that the working classes are not Jingoes.“",
                                "translation": "Dann prangerte Herr Morris den Krieg und die koloniale Föderation an (ein Mittel um das Profitstreben zu bewahren), und erklärte, dass die Arbeiterklassen keine Jingos wären."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ffaae61-3391-4d0d-85f8-ca960fc1315d",
                        "source_entry_id": "65015f93-4817-3f05-81f6-c6e3527c12df",
                        "source_sense_id": "98cf193f-55c3-3c58-bc46-9e398b5324f4",
                        "source_sense_description": "jemanden (öffentlich) anprangern",
                        "target_lang_word": "anprangern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anprangern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "447b9822-301a-3ce0-a335-993b60f2563b",
                                        "entry_id": "d7312727-da5f-36bf-8239-fb92714e61b3",
                                        "glosses": [
                                            "öffentlich anklagen, denunzieren, bloßstellen; an den Pranger stellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e694c4d4-50c4-4932-b19e-4e2b29469a63",
                                                "sense_id": "447b9822-301a-3ce0-a335-993b60f2563b",
                                                "text": "„Das Journalistenkonsortium ICIJ, das im Frühjahr auf Briefkastenfirmen in Panama aufmerksam gemacht hatte, hat am Mittwoch Informationen über finanzielle Aktivitäten Prominenter auf den Bahamas veröffentlicht. Insbesondere wird die frühere EU-Wettbewerbskommissarin Neelie Kroes angeprangert.“"
                                            },
                                            {
                                                "example_id": "d6621c4f-bb4f-415c-81b5-2899b5746770",
                                                "sense_id": "447b9822-301a-3ce0-a335-993b60f2563b",
                                                "text": "„Vor allem die mutigen Predigten des Bischofs von Münster, Clemens August Graf von Galen, der ausgehend vom fünften Gebot – ‚Du sollst nicht töten‘ – diese Morde anprangert, führen dazu, dass Hitler am 24. August 1941 die Einstellung der Euthanasieaktion befiehlt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
