                "senses": [
                    {
                        "sense_id": "5e59007f-2cf1-3325-bd8a-0dbf5abe890b",
                        "entry_id": "48759fd8-65f4-3328-b599-c06d87d04bed",
                        "glosses": [
                            "geronnenes Blut, das ein Blutgefäß im Körper verstopfen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b917ce8-addf-4254-8ab1-1df2e338dcf1",
                                "sense_id": "5e59007f-2cf1-3325-bd8a-0dbf5abe890b",
                                "text": "Durch Blutgerinnsel kann eine Lungenembolie ausgelöst werden."
                            },
                            {
                                "example_id": "ba46d09e-2270-4f59-8549-d419ad693d5c",
                                "sense_id": "5e59007f-2cf1-3325-bd8a-0dbf5abe890b",
                                "text": "Noch ist unklar, warum sich die Blutgerinnsel bei Covid-19 bilden können."
                            },
                            {
                                "example_id": "c8657db5-915a-45d6-ba23-3a1d2a6d383a",
                                "sense_id": "5e59007f-2cf1-3325-bd8a-0dbf5abe890b",
                                "text": "Blutgerinnsel sind nicht nur für die Gliedmaßen gefährlich, sondern können ihren Weg auch in die Lunge, das Herz oder das Gehirn finden und so Lungenembolien, Herzinfarkte und Schlaganfälle verursachen."
                            },
                            {
                                "example_id": "25a7b1d1-fea0-40d5-b306-2424e96b3e9c",
                                "sense_id": "5e59007f-2cf1-3325-bd8a-0dbf5abe890b",
                                "text": "„Schließlich stellte ein Arzt fest, dass sich Blutgerinnsel an den Segeln seiner neuen Klappe gebildet hatten, die eine ordnungsgemäße Funktion verhinderten, und so erhielt er den starken Blutverdünner Coumadin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
