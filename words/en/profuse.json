                    "frequency": "VeryLow",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy heir would continually <w>profuse</w> gifts upon anyone who flattered him.",
                            "target_lang_translations": {
                                "ru": "Богатый наследник постоянно <w>осыпал</w> подарками любого, кто ему льстил."
                            }
                        },
                        {
                            "text": "He chose to <w>profuse</w> his inherited wealth on lavish feasts and parties.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>расточать</w> унаследованное богатство на пышные пиры и вечеринки."
                            }
