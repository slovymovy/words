                        "examples": [
                            {
                                "example_id": "1069f813-358a-4da2-b5d4-9d314be88e9c",
                                "sense_id": "0e000312-1023-38fb-bdc9-031c73a8b38c",
                                "text": "De handel in slavinnen was een tragisch en donker hoofdstuk in de geschiedenis.",
                                "translation": "The trade of female slaves was a tragic and dark chapter in history.",
                                "english": "The trade of female slaves was a tragic and dark chapter in history."
                            },
                            {
                                "example_id": "9d11fd92-d53f-44f5-b7b7-a57d08aac1d0",
                                "sense_id": "0e000312-1023-38fb-bdc9-031c73a8b38c",
                                "text": "De slavinnetjes werden gedwongen om hard te werken onder zware omstandigheden.",
                                "translation": "The female slaves were forced to work hard under harsh conditions.",
                                "english": "The female slaves were forced to work hard under harsh conditions."
                            },
                            {
                                "example_id": "58b8f6d7-ec20-4e88-83aa-67b2613d2225",
                                "sense_id": "0e000312-1023-38fb-bdc9-031c73a8b38c",
                                "text": "De slavin wist te ontsnappen en vond uiteindelijk haar vrijheid.",
                                "translation": "The female slave managed to escape and eventually found her freedom.",
                                "english": "The female slave managed to escape and eventually found her freedom."
                            }
                        ]
                    }
