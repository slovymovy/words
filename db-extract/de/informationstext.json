                        "glosses": [
                            "Text, dessen hauptsächliche Textfunktion darin besteht, dem Hörer / Leser eine Information zu übermitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "653a4810-364c-410e-b34c-86062772c7d9",
                                "sense_id": "740686e3-3143-3333-8586-268e92a915f0",
                                "text": "Nachrichten sind Informationstexte, da ihre Hauptfunktion darin besteht, den Leser/ Hörer über einen Sachverhalt zu informieren."
                            },
                            {
                                "example_id": "e5a344ca-523e-479f-ade4-d87e4c0661cb",
                                "sense_id": "740686e3-3143-3333-8586-268e92a915f0",
                                "text": "Brinker nennt Informationstexte als eine von fünf Textklassen, die nach dem Kriterium der Textfunktion unterschieden werden."
                            }
                        ],
