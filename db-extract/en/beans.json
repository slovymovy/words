                        "examples": [
                            {
                                "example_id": "15766498-7718-49d3-805f-240c46eef4a3",
                                "sense_id": "da2a3f3d-8959-37c3-b325-f8475930909e",
                                "text": "I left home and school at 16, and worked as a janitor, a printer, a salesperson, a busboy, and hustled briefly when I was 19 to make ends meet. I live with a lover now who is a well paid academic, but I make beans as a writer."
                            },
                            {
                                "example_id": "2ee0435f-020c-419d-ba22-259d8fb73b3f",
                                "sense_id": "da2a3f3d-8959-37c3-b325-f8475930909e",
                                "text": "In a fast changing interest rate environment – particularly when rates rise fast – your verbal agreement isn’t worth beans."
                            },
                            {
                                "example_id": "1bc8278c-9cba-4872-9759-cba3ec3c8495",
                                "sense_id": "da2a3f3d-8959-37c3-b325-f8475930909e",
                                "text": "But social confirmation doesn’t amount to beans when it comes to knowing the truth."
                            }
                        ]
                    },
                    {
