                "senses": [
                    {
                        "sense_id": "ba5354df-cc9c-3062-82dc-eaa71d21c5e4",
                        "entry_id": "567598fa-2588-359f-a808-42755dc99ed3",
                        "glosses": [
                            "Écrire de la mauvaise qualité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc6d1b70-125c-470f-96e8-60428d9f09ba",
                                "sense_id": "ba5354df-cc9c-3062-82dc-eaa71d21c5e4",
                                "text": "Marianne Alphant m'a dit ces jours-ci qu’on lui avait demandé, à Libération, de « sous-écrire » ses articles. C’est-à- dire : d’écrire « moins bien » pour les lecteurs."
                            },
                            {
                                "example_id": "8bfc8223-e706-4eea-b3c7-bbd7c2c5cc5e",
                                "sense_id": "ba5354df-cc9c-3062-82dc-eaa71d21c5e4",
                                "text": "Et puis, j’ai essayé d'écrire, mais je ne faisais que récrire et sous-écrire; c’était décourageant."
                            }
                        ]
                    }
