                                                "sense_id": "b5aa798b-6e66-347e-8b64-f6b6b1f0fa25",
                                                "text": "That is only bluff, or That is only a bluff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1efa08f4-c3ab-3fca-aa0b-b9f6ea87d7ee",
                                        "entry_id": "f2300e7a-a3c0-36ea-8f83-bea6a016991c",
                                        "glosses": [
                                            "An attempt to represent oneself as holding a stronger hand than one actually does."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
