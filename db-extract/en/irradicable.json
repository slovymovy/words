                        ],
                        "examples": [
                            {
                                "example_id": "a2b396b4-6262-4d3c-aa64-0791288bfd93",
                                "sense_id": "729e01ae-e130-3ae9-80ed-c6e604629134",
                                "text": "Of course, the young people flirted, for that diversion is apparently irradicable even in the \"best society\"."
                            },
                            {
                                "example_id": "bee5040b-c49b-445d-81f5-9423d9bab6e7",
                                "sense_id": "729e01ae-e130-3ae9-80ed-c6e604629134",
                                "text": "Faces at the Bottom of the Well, by Derrick Bell. (Basic Books, $20.) A law professor argues that racism is an integral, permanent and irradicable component of our society."
                            },
                            {
                                "example_id": "9909545b-75dc-4292-afc5-e47e21bb3405",
                                "sense_id": "729e01ae-e130-3ae9-80ed-c6e604629134",
                                "text": "Vatican II, the modernizing church council of the 1960s, emboldened that lay assertiveness among U.S. Catholics as never before; the pedophile tragedy has made the laity's self-reliant spirit irradicable."
                            }
                        ]
                    }
