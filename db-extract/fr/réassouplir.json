                "senses": [
                    {
                        "sense_id": "e181e3f6-184c-32c2-87d0-15395cbf710b",
                        "entry_id": "88539696-6169-346e-a06e-e4fa7e2c9c31",
                        "glosses": [
                            "Assouplir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4faf3d4c-16aa-4ee6-8163-c335851f74c3",
                                "sense_id": "e181e3f6-184c-32c2-87d0-15395cbf710b",
                                "text": "II faut entraîner la voix, réassouplir les cordes vocales, retrouver le rythme de la respiration."
                            },
                            {
                                "example_id": "ace62ef9-82ae-4e01-aa2b-0bdd3195588f",
                                "sense_id": "e181e3f6-184c-32c2-87d0-15395cbf710b",
                                "text": "Il frissonna et ses muscles se réassouplirent."
                            },
                            {
                                "example_id": "6636e4ac-37bc-4335-a726-93e2a0d2ab8e",
                                "sense_id": "e181e3f6-184c-32c2-87d0-15395cbf710b",
                                "text": "On procède alors à la dessiccation du limbe, en chauffant à 45-50 °C. Quand il est brisant, on éteint les feux pour laisser le tabac se réassouplir."
                            }
                        ]
                    }
