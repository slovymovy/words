                        "glosses": [
                            "een belangrijk of heel goed kunstwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eaa11a5-cb26-45ee-8349-703c3cb37ef3",
                                "sense_id": "2daf16b3-427b-373e-9e98-0237645c83d2",
                                "text": "Vlak om de hoek op de Groenplaats, stap je één van de mooiste gotische kathedralen van Europa binnen. De kerk werd voltooid in 1521 na een bouwperiode van 170 jaar en de 123 meter hoge toren beheerst nadrukkelijk de skyline van de stad. In de kerk vind je vier topwerken van de wereldberoemde schilder Pieter Paul Rubens."
                            },
                            {
                                "example_id": "c083a709-cff6-474e-9465-be83d86aa108",
                                "sense_id": "2daf16b3-427b-373e-9e98-0237645c83d2",
                                "text": "Voor de openingstentoonstelling 'Scherp kijken' zijn ruim tweehonderd topwerken uit de collectie geselecteerd van kunstenaars als Carel Willink, Pyke Koch, Jan Mankes en Charley Toorop."
                            },
                            {
                                "example_id": "d296feb6-910f-4760-8e43-ef2aa3733c55",
                                "sense_id": "2daf16b3-427b-373e-9e98-0237645c83d2",
                                "text": "Bekijk topwerken als het Appel Circus en een gigantische stalen vis gemaakt door Karel Appel. Voor meer informatie over dit museum en het gebouw, kun je op deze website terecht."
                            }
                        ]
                    }
