                        "examples": [
                            {
                                "example_id": "c350be3e-85a9-4979-96ce-f91b563ab365",
                                "sense_id": "53cd431e-9579-3459-b574-6f01c9b2ee53",
                                "text": "A melancholy boddy is not the kindest nurse for a chearely minde, (the joviall complexion is soverainly beholding to nature,) but I know not a finer transformation in Ovid then the Metamorphosis of dudgen earnest into sport; of harsh sower into sweet; of losse into gaine; or reproch into credit; of whatsoever badd occurrence into some good."
                            },
                            {
                                "example_id": "e363fb97-5699-4f15-95c4-a9cc63495565",
                                "sense_id": "53cd431e-9579-3459-b574-6f01c9b2ee53",
                                "text": "Gentlemen (according to the laudable custome) I am to court you with a few premisses considered: but a number of you there bee, who consider neigher premisses nor conclusion, but piteouslie torment Title Pages on euerie poast: neuer readidng farther of anie Booke, than Imprinted by Simeon such a signe, and yet with your dudgen iudgement will desperatelie presume to run up to the hard hilts through the whole bulke of it."
                            },
                            {
                                "example_id": "7e4de871-cb97-48db-96e4-8d94e56a604f",
                                "sense_id": "53cd431e-9579-3459-b574-6f01c9b2ee53",
                                "text": "Think' st thou, my Wit shall keepe the pack- Horse Way , That ev'ry Dudgen low Invention goes?"
                            }
                        ]
                    }
