                "senses": [
                    {
                        "sense_id": "85099d6e-6a5c-34f0-95f6-c193d8d13dda",
                        "entry_id": "2971c268-a23d-30cd-858b-3932b301f578",
                        "glosses": [
                            "To spank with a hairbrush."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c39b4227-3ad7-41e8-9da4-f738759d0d33",
                                "sense_id": "85099d6e-6a5c-34f0-95f6-c193d8d13dda",
                                "text": "Bad feeding, adolescence—always a dangerous period for the male—and the brutality and bestiality in the dormitories made life a hell on earth. An apathy settled on me. I withered. I learned nothing; I did nothing. I was kicked, hounded, caned, flogged, hairbrushed, morning, noon, and night."
                            },
                            {
                                "example_id": "6323b9ed-ebc0-44af-bdde-f01624cb0204",
                                "sense_id": "85099d6e-6a5c-34f0-95f6-c193d8d13dda",
                                "text": "Do you know what it’s like, Brannan, to be flogged and hairbrushed, kicked and cursed every day of your school life? I’m treated worse than a dog and nobody gives a damn—least of all the masters."
                            }
                        ]
                    }
                ],
