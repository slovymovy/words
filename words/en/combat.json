{
    "word_family": [
        "combatant",
        "combative",
        "noncombatant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "32c6641d-fccf-3f92-8b2e-e23d4065679d",
                    "sense_definition": "A fight or battle between individuals or groups, especially in a war.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "noun_conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were well trained for armed <w>combat</w>.",
                            "target_lang_translations": {
                                "ru": "Солдаты были хорошо подготовлены к вооруженному <w>бою</w>.",
                                "zh": "士兵们受过良好的武装<w>战斗</w>训练。"
                            }
                        },
                        {
                            "text": "He was injured during <w>combat</w> in the war zone.",
                            "target_lang_translations": {
                                "ru": "Он был ранен во время <w>боя</w> в зоне военных действий.",
                                "zh": "他在战区的<w>交战</w>中受了伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "battle",
                        "conflict",
                        "fight",
                        "warfare",
                        "engagement"
                    ],
                    "antonyms": [
                        "peace"
                    ],
                    "common_phrases": [
                        "armed combat",
                        "hand-to-hand combat",
                        "in combat",
                        "combat zone",
                        "close combat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бой или сражение между отдельными лицами или группами, особенно во время войны.",
                        "zh": "个人或团体之间的战斗或交战，尤指在战争中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бой",
                                "target_lang_sense_clarification": "военное столкновение"
                            },
                            {
                                "target_lang_word": "сражение",
                                "target_lang_sense_clarification": "крупная битва"
                            },
                            {
                                "target_lang_word": "битва",
                                "target_lang_sense_clarification": "решительное сражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "战斗",
                                "target_lang_sense_clarification": "指军事上的交战或冲突"
                            },
                            {
                                "target_lang_word": "交战",
                                "target_lang_sense_clarification": "指双方进行武装对抗"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "614f494d-f7eb-31c7-a21a-5e4ff56eabd7",
                    "sense_definition": "To take action to reduce, destroy, or prevent something undesirable or harmful.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_oppose_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced new laws to <w>combat</w> crime in the city.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело новые законы, чтобы <w>бороться</w> с преступностью в городе.",
                                "zh": "政府出台了新法律以<w>打击</w>城市犯罪。"
                            }
                        },
                        {
                            "text": "Regular exercise is an effective way to <w>combat</w> stress.",
                            "target_lang_translations": {
                                "ru": "Регулярные упражнения — эффективный способ <w>бороться</w> со стрессом.",
                                "zh": "经常锻炼是<w>对抗</w>压力的有效方法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fight",
                        "tackle",
                        "oppose",
                        "battle",
                        "counter"
                    ],
                    "antonyms": [
                        "support",
                        "promote",
                        "encourage"
                    ],
                    "common_phrases": [
                        "combat climate change",
                        "combat disease",
                        "combat poverty",
                        "combat terrorism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предпринимать действия для уменьшения, уничтожения или предотвращения чего-либо нежелательного.",
                        "zh": "采取行动以减少、消除或防止某种不良或有害的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "противодействовать чему-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打击",
                                "target_lang_sense_clarification": "指采取强力措施制止某种行为"
                            },
                            {
                                "target_lang_word": "对抗",
                                "target_lang_sense_clarification": "指与某种负面现象进行抗衡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "571e1b76-ccaa-33da-a12f-c7ac0b363e32",
                    "sense_definition": "To engage in a physical fight or battle against someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_fight_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knights <w>combated</w> fiercely until one fell to the ground.",
                            "target_lang_translations": {
                                "ru": "Рыцари яростно <w>сражались</w>, пока один из них не упал на землю.",
                                "zh": "骑士们激烈地<w>搏斗</w>，直到其中一人倒地。"
                            }
                        },
                        {
                            "text": "They had to <w>combat</w> the enemy forces on difficult terrain.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>сражаться</w> с вражескими силами на труднопроходимой местности.",
                                "zh": "他们不得不在复杂地形上与敌军<w>交战</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fight",
                        "battle",
                        "clash"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в физическую схватку или битву против кого-либо.",
                        "zh": "与某人进行身体上的搏斗或战斗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сражаться",
                                "target_lang_sense_clarification": "вести бой"
                            },
                            {
                                "target_lang_word": "биться",
                                "target_lang_sense_clarification": "драться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搏斗",
                                "target_lang_sense_clarification": "指激烈的身体对抗"
                            },
                            {
                                "target_lang_word": "交战",
                                "target_lang_sense_clarification": "指双方进行战斗"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}