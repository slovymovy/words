                    "frequency": "Low",
                    "semantic_group_id": "figurative_present",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы должны строить счастливое <w>сегодня</w> для наших детей.",
                            "target_lang_translations": {
                                "en": "We must build a happy <w>present</w> for our children.",
                                "zh": "我们必须为孩子们创造一个幸福的<w>当今</w>。",
                                "de": "Wir müssen ein glückliches <w>Heute</w> für unsere Kinder aufbauen."
                            }
                        },
                        {
                            "text": "В литературном <w>сегодня</w> появляется много новых талантливых авторов.",
                            "target_lang_translations": {
                                "en": "In the literary <w>today</w>, many new talented authors are appearing.",
                                "zh": "在文学的<w>当今</w>，涌现出了许多有才华的新作者。",
                                "de": "Im literarischen <w>Heute</w> tauchen viele neue talentierte Autoren auf."
                            }
                        }
