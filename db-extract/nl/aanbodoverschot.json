                        "sense_id": "48735ef3-c890-36f8-b4d9-8cadad2a0a69",
                        "entry_id": "3cf3fbf5-cea5-32fe-9aa4-3d5e6cb1b5cf",
                        "glosses": [
                            "aanbodoverschot of vraagtekort ontstaat als de bij een bepaalde prijs aangeboden hoeveelheid van een goed of dienst groter is dan de bij die prijs gevraagde hoeveelheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40dccbdb-4a1e-4622-b3d3-8982817ecbd7",
                                "sense_id": "48735ef3-c890-36f8-b4d9-8cadad2a0a69",
                                "text": "De prijzen van groenten lagen zelfs 7 procent onder het niveau van vorig jaar door een aanbodoverschot in Europa. Alleen aardappelen en fruit werden niet goedkoper."
                            },
                            {
                                "example_id": "be2cbe37-a2a6-43f4-9a31-356799976eb7",
                                "sense_id": "48735ef3-c890-36f8-b4d9-8cadad2a0a69",
                                "text": "De prijzen van chips komen volgend jaar mogelijk nog verder onder druk te staan. Ook houdt het aanbodoverschot aan, stellen analisten van Goldman Sachs in een sectorrapport."
                            }
                        ]
                    }
