                "senses": [
                    {
                        "sense_id": "a9c47962-ce3e-3e83-be82-bd6a0362c514",
                        "entry_id": "67f17f09-08a4-34d6-a945-5a000682e74b",
                        "glosses": [
                            "musicus die zich toelegt op het bespelen van het orgel"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "992fffe5-f550-4770-b864-f60ff74d8dca",
                                "sense_id": "a9c47962-ce3e-3e83-be82-bd6a0362c514",
                                "text": "De organist van onze kerk vergastte ons op een prachtige prelude van Bach."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c23ea5f-0264-3a74-bdaa-0d0ea379f9cf",
                        "entry_id": "67f17f09-08a4-34d6-a945-5a000682e74b",
                        "glosses": [
                            "een zangvogel uit het geslacht Euphonia of Chlorophonia van de familie Fringillidae (vinkachtigen)"
                        ],
                        "tags": [
                            "zangvogels"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "217e9d0a-2750-432f-9913-ed87052a9b19",
                        "source_entry_id": "67f17f09-08a4-34d6-a945-5a000682e74b",
                        "source_sense_id": "a9c47962-ce3e-3e83-be82-bd6a0362c514",
                        "source_sense_description": "musicus die zich toelegt op het bespelen van het orgel",
                        "target_lang_word": "Kantor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kantor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                        "entry_id": "467d794c-2b9e-3a67-a8fa-01f081aa0124",
                                        "glosses": [
                                            "Person, die im christlichen oder jüdischen Gottesdienst die Orgel spielt und/oder den Chor leitet"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "162cef22-5cfc-44e9-b048-36ea0caa2a1a",
                                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                                "text": "Johann Sebastian Bach war Kantor der Kirchengemeinde St. Thomas zu Leipzig."
                                            },
                                            {
                                                "example_id": "4c828602-31c1-4ca3-80db-c3de381207a7",
                                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                                "text": "„Der Kantor senkte den Blick und fragte nicht weiter.“"
                                            },
                                            {
                                                "example_id": "b9d434de-6cf6-4830-aadd-627140849d54",
                                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                                "text": "„Es war nicht für die einfachen Gläubigen bestimmt, von denen die meisten es ohnehin weder hätten bezahlen noch benutzen können, sondern für Chorsänger und Kantoren.“"
                                            },
                                            {
                                                "example_id": "c6648dbe-c53b-4d22-9307-df1835023590",
                                                "sense_id": "f5699c49-9c36-35ed-9d69-c475827b250c",
                                                "text": "„Trommelwirbel ertönte, ein silbernes Kreuz tauchte auf; dann erschienen zwei Leuchter, von Kantoren getragen, sowie der Herr Pfarrer mit Stola, Chorhemd, Chormantel und Barett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba4f26b7-a349-41aa-a8c5-0f9785061cd9",
                        "source_entry_id": "67f17f09-08a4-34d6-a945-5a000682e74b",
                        "source_sense_id": "a9c47962-ce3e-3e83-be82-bd6a0362c514",
                        "source_sense_description": "musicus die zich toelegt op het bespelen van het orgel",
                        "target_lang_word": "Organist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Organist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                        "entry_id": "af2198a0-d739-3ea9-90b8-2864f13801c5",
                                        "glosses": [
                                            "jemand, der eine Orgel spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d49a741f-e05e-44c3-b2fb-37f8b3b3ee1e",
                                                "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                                "text": "Der Organist kam zu spät zur Chorprobe."
                                            },
                                            {
                                                "example_id": "442d44b2-ea42-4b6b-ad31-bed6d7707307",
                                                "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                                "text": "„Die unerwartete Kunde von dem neuen Organisten füllte Bodendorfs Kirche am Sonntag bis auf den letzten Platz.“"
                                            },
                                            {
                                                "example_id": "6b270895-eaf5-4546-a628-ff7922f053e0",
                                                "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                                "text": "„Zu dieser Zeit erschienen zehn Haftchen, die der Organist Jónas Helgason herausgab.“"
                                            },
                                            {
                                                "example_id": "0c901684-430c-4634-82e9-8877c81fa79a",
                                                "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                                "text": "„Ein Organist übt für seinen Auftritt am nächsten Sonntag, erfahren wir später.“"
                                            },
                                            {
                                                "example_id": "68ebf73f-7742-42c7-a01d-d79a7a15c00f",
                                                "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                                "text": "„Wir sind dann weiter durch den großen Dom von Trier gegangen, und wir haben uns seinen Kreuzgang und die Krypta angeschaut, als ein Organist auf der Orgel etwas geübt und geprobt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5ccc143-f001-3833-ae3e-b50b4ebbd6b5",
                                        "entry_id": "af2198a0-d739-3ea9-90b8-2864f13801c5",
                                        "glosses": [
                                            "die Vogelgattung Euphonia aus der Familie der Finken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4522afd-d2e8-46d9-a556-ba1b992acddc",
                                                "sense_id": "f5ccc143-f001-3833-ae3e-b50b4ebbd6b5",
                                                "text": "Organisten leben in Mittel- und Südamerika."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a54848b7-bbce-4fa6-b479-9dd30071c9f2",
                        "source_entry_id": "67f17f09-08a4-34d6-a945-5a000682e74b",
                        "source_sense_id": "a9c47962-ce3e-3e83-be82-bd6a0362c514",
                        "source_sense_description": "musicus die zich toelegt op het bespelen van het orgel",
                        "target_lang_word": "Orgelspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orgelspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "783fb77f-5ce0-3181-be75-ce6ec4a07ef8",
                                        "entry_id": "7f72de96-9602-3923-b937-0494ea0ec6f1",
                                        "glosses": [
                                            "(männliche^☆) Person, die eine Orgel spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1339bac7-fc52-4444-baa6-e2dcbaa465e6",
                                                "sense_id": "783fb77f-5ce0-3181-be75-ce6ec4a07ef8",
                                                "text": "„An der Veranstaltung sollen unter anderem 20 Sängerinnen und Sänger des Erwachsenenchors von Notre-Dame, zwei Solisten und ein Orgelspieler teilnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1165a15-dbcc-49c5-9e82-e837a362e7b2",
                        "source_entry_id": "67f17f09-08a4-34d6-a945-5a000682e74b",
                        "source_sense_id": "a9c47962-ce3e-3e83-be82-bd6a0362c514",
