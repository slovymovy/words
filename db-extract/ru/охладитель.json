                    {
                        "translation_id": "0d2da82e-98f2-4a6a-9789-2efb5de20c6a",
                        "source_entry_id": "968f14ee-0127-3fd6-9c8c-46d2b00a2473",
                        "target_lang_word": "Kühler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kühler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd03851-0c8f-3ad7-9d99-69c2c7d375be",
                                        "entry_id": "c7cdaa84-a239-3fed-8888-dc8d63607f96",
                                        "glosses": [
                                            "Gefäß/Behälter zum Kühlhalten von Getränken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8be1cac-87d4-4b79-8bf8-69784c803f37",
                                                "sense_id": "bfd03851-0c8f-3ad7-9d99-69c2c7d375be",
                                                "text": "Zu dem Sekt erhielten sie vom Kellner einen Kühler."
                                            },
                                            {
                                                "example_id": "d779b2d6-c940-4013-baeb-dd8059618be0",
                                                "sense_id": "bfd03851-0c8f-3ad7-9d99-69c2c7d375be",
                                                "text": "„Er nimmt Eiswürfel aus einem silbernen Kühler, er scheint sie sorgsam auszusuchen, und er redet, während er uns den Rücken zuwendet.“"
                                            },
                                            {
                                                "example_id": "325ecac6-6f5c-47a3-9ce1-8586801e5e34",
                                                "sense_id": "bfd03851-0c8f-3ad7-9d99-69c2c7d375be",
                                                "text": "„Sie stellt uns eine Flasche auf den Tisch, winkt von einer Kellnerin einen Kühler heran.“"
                                            },
                                            {
                                                "example_id": "119c5b59-de5c-479e-8888-a6d43d2f4bd3",
                                                "sense_id": "bfd03851-0c8f-3ad7-9d99-69c2c7d375be",
                                                "text": "„Auf dem Tisch stand eine Silberplatte mit zwei halben Langusten und eine Flasche Champagne nature in einem Kühler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed3ccd99-e634-3b54-a874-8a70a130677f",
                                        "entry_id": "c7cdaa84-a239-3fed-8888-dc8d63607f96",
                                        "glosses": [
                                            "Vorrichtung zum Kühlen des Motors von einem Kraftfahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5b1efb3-96f9-439c-891d-15f207c31159",
                                                "sense_id": "ed3ccd99-e634-3b54-a874-8a70a130677f",
                                                "text": "„Die Depots kamen wieder in Sicht, ein Wagen davor, der Kühler qualmte wie ein Vesuv, die Haube war aufgerissen, ein Mensch steckte zur Hälfte darin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
