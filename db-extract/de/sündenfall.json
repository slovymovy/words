                ],
                "senses": [
                    {
                        "sense_id": "b4145b11-1879-33b3-966b-076a311b5d14",
                        "entry_id": "cc4bf36b-1047-363a-8a15-b53be5232ac1",
                        "glosses": [
                            "symbolisches (beziehungsweise archetypisches) Ereignis, das im Buch Genesis beschrieben ist und wonach die Menschheit von Gott abgefallen ist: die Menschen (Adam und Eva) essen verbotenerweise die Früchte des Baums der Erkenntnis von Gut und Böse, wodurch die Sünde entsteht und das von Gott geschaffene Menschenpaar aus dem Paradies auf in die Welt beziehungsweise auf die Erde vertrieben werden, wo seither alle Menschen von der Erbsünde behaftet sind"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b0f5e596-ff28-4351-b8f9-37d4f6d4d6ac",
                                "sense_id": "b4145b11-1879-33b3-966b-076a311b5d14",
                                "text": "In der Exegese wird der Begriff des Sündenfalls heute eher vermieden."
                            },
                            {
                                "example_id": "2ced6107-0c0d-466a-8036-32390583aa70",
                                "sense_id": "b4145b11-1879-33b3-966b-076a311b5d14",
                                "text": "„Die Erzählung vom Sündenfall oder von der Vertreibung aus dem Paradies enthält einige Spannungen, für die unterschiedliche Lösungen angeboten werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9bafc845-a042-3a6f-b151-93e288f80d88",
                        "entry_id": "cc4bf36b-1047-363a-8a15-b53be5232ac1",
                        "glosses": [
                            "unangemessenes Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddfed028-8274-45f2-8588-daaa6bbb38cb",
                                "sense_id": "9bafc845-a042-3a6f-b151-93e288f80d88",
                                "text": "„Und die Maßlosigkeit steht in der Rangliste der deutschen Sündenfälle ganz obenan.“"
                            },
                            {
                                "example_id": "577cc22f-7794-4743-8115-b9cfad3d83be",
                                "sense_id": "9bafc845-a042-3a6f-b151-93e288f80d88",
                                "text": "„Lange Zeit galt die Billigung des deutschen Zwangsexodus als letzter Sündenfall des Westens.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
