                "senses": [
                    {
                        "sense_id": "3059cdf3-eb2d-36d2-9963-675d12044fe5",
                        "entry_id": "7d72fd9a-c4cf-31f0-9179-e7b4c10ea4dd",
                        "glosses": [
                            "связанный с Западной Европой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46783d4a-7ec8-44d8-b568-6e9778a8d5ec",
                                "sense_id": "3059cdf3-eb2d-36d2-9963-675d12044fe5",
                                "text": "К VIII веку в западноевропейских школах устанавливаются два цикла наук, непосредственно связанные с пониманием слова в указанном выше смысле — тривий и квадривий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a67a993d-9e92-4d0d-ad1e-645efb446d16",
                        "source_entry_id": "7d72fd9a-c4cf-31f0-9179-e7b4c10ea4dd",
                        "source_sense_id": "3059cdf3-eb2d-36d2-9963-675d12044fe5",
                        "target_lang_word": "westeuropäisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "westeuropäisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e369987c-4ccb-37ad-9bda-c66a9b6ecf6e",
                                        "entry_id": "e4fcb5e2-5e23-36f9-b3bb-755542143b9e",
                                        "glosses": [
                                            "zu Westeuropa gehörig, in Westeuropa befindend, es betreffend, sich darauf beziehend oder von dort stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd14add-bd9a-48db-96e2-26815eb9a484",
                                                "sense_id": "e369987c-4ccb-37ad-9bda-c66a9b6ecf6e",
                                                "text": "„Sankt Petersburg wurde im 18. Jahrhundert nach westeuropäischem Vorbild aufgebaut und ist das kulturelle und wirtschaftliche Zentrum Nordrusslands.“"
                                            },
                                            {
                                                "example_id": "720140a5-987b-468c-9b1f-700723f57ece",
                                                "sense_id": "e369987c-4ccb-37ad-9bda-c66a9b6ecf6e",
                                                "text": "Irland mutet selbstverständlich westeuropäischer an als die Schweiz."
                                            },
