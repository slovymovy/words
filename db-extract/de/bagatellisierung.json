                        "sense_id": "27764b66-0c75-3498-8783-599d9fecff29",
                        "entry_id": "45a71440-dacc-345f-bcd7-320637362377",
                        "glosses": [
                            "Darstellung einer Sache als weniger bedeutsam, als sie tatsächlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "471248e9-57a0-4a8e-97f9-0554b9299828",
                                "sense_id": "27764b66-0c75-3498-8783-599d9fecff29",
                                "text": "Die politischen Bagatellisierungen führen zur Ausbreitung der Problematik."
