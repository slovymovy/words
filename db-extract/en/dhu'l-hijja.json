                                "sense_id": "940cc7ff-7a6b-3eeb-8061-508e320dcac7",
                                "text": "Having performed the rites of Pilgrimage, on the twentieth day precisely of Dhu'l-Hijjah I went out of Mecca in company with the commander of al-Iraq."
                            },
                            {
                                "example_id": "c491c4b2-209e-4748-9603-d5063debe13f",
                                "sense_id": "940cc7ff-7a6b-3eeb-8061-508e320dcac7",
                                "text": "Stay at Arafat on 9th Dhu al-Hijjah from after dawn to slightly after sunset (when pilgrims proceed to Muzdalfa)."
                            }
