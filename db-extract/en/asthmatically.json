                        "glosses": [
                            "In an asthmatic manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c657f3-812b-4f3b-b00a-6b3413c5dabc",
                                "sense_id": "9462ed08-386e-34f0-9b66-b56ed6171f03",
                                "text": "He came in and stood breathing asthmatically."
                            },
                            {
                                "example_id": "28c5a17f-3bf0-40b6-8574-4d141276cc91",
                                "sense_id": "9462ed08-386e-34f0-9b66-b56ed6171f03",
                                "text": "The Chinese Puffhard excelled herself, and though she choked asthmatically did not really stop once until we were half way up the drive, when I abandoned her to the gardeners, who later on harnessed the donkey to her and pulled her into the motor-house."
                            },
                            {
                                "example_id": "b0289092-f26f-4d1b-be50-452c724ec9e8",
                                "sense_id": "9462ed08-386e-34f0-9b66-b56ed6171f03",
                                "text": "He was not an old man, though he affected to be so--walking very slowly and deliberately, coughing asthmatically, glimmering with his eyes, and mumbling like a witch."
                            }
                        ]
                    }
                ],
