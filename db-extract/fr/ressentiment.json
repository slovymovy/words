        "fr-extract.jsonl": [
            {
                "entry_id": "3c854896-8976-3695-a749-e72556e1d848",
                "word": "ressentiment",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ec2cc23b-a93d-475e-bd46-a54216119416",
                        "entry_id": "3c854896-8976-3695-a749-e72556e1d848",
                        "tags": [
                            "plural"
                        ],
                        "form": "ressentiments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ed760155-a6bf-37fe-9b05-663e7d0b50d0",
                        "entry_id": "3c854896-8976-3695-a749-e72556e1d848",
                        "glosses": [
                            "Faible atteinte, faible renouvellement d’un mal qu’on a eu, d’une douleur qu’on a ressentie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "69a207c3-47d8-46f4-93b5-3b0c795a2526",
                                "sense_id": "ed760155-a6bf-37fe-9b05-663e7d0b50d0",
                                "text": "Il n’est pas encore délivré de sa fièvre, il en a quelques ressentiments."
                            },
                            {
                                "example_id": "de9d9b0e-61db-45eb-9905-e803330e74f9",
                                "sense_id": "ed760155-a6bf-37fe-9b05-663e7d0b50d0",
                                "text": "Il vient d’avoir encore un léger ressentiment de sa goutte."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d9f05c1-c6c9-3982-b2e8-dce3ef04d5bb",
                        "entry_id": "3c854896-8976-3695-a749-e72556e1d848",
                        "glosses": [
                            "Souvenir douloureux qu’on garde des injures et blessures, avec désir de s’en venger."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a420875b-7785-4883-889d-b3d144a8771e",
                                "sense_id": "7d9f05c1-c6c9-3982-b2e8-dce3ef04d5bb",
                                "text": "Le ressentiment forme un sentiment composé proche de l'envie, qui mélange désir de vengeance, frustration, dépit, rancune et volonté de dénigrement. Il se délecte dans le malheur infligé à ceux que l'existence a choyés et dans la destruction ou le ravalement des splendeurs, ainsi que des œuvres et des valeurs dont la positivité paraît d'autant plus insolente qu'elles sont inaccessibles et réservées à une petite minorité."
                            },
                            {
                                "example_id": "86241971-c1c4-40c2-b74c-8d8528cbed6f",
                                "sense_id": "7d9f05c1-c6c9-3982-b2e8-dce3ef04d5bb",
                                "text": "Ce n’est pas de réprimer le juste ressentiment qui oppresse mon cœur depuis une année, et que l’on force enfin à s’exhaler."
                            },
                            {
                                "example_id": "3b401928-2451-4d9f-887c-70996233fc48",
                                "sense_id": "7d9f05c1-c6c9-3982-b2e8-dce3ef04d5bb",
                                "text": "Non seulement il invita ses concitoyens à déposer leurs ressentiments et leurs griefs sur l'autel de la patrie, mais il demanda encore que le bienfait de cette pacification fût étendu aux autres peuples, et que la France, introduisant parmi les nations une nouvelle diplomatie, jetât les fondements d'une alliance universelle."
                            },
                            {
                                "example_id": "697ddfea-1927-4f39-8a18-ca31aa304acc",
                                "sense_id": "7d9f05c1-c6c9-3982-b2e8-dce3ef04d5bb",
                                "text": "Par contre, elles ont été assez médiocres pour nourrir son ressentiment personnel qui […] explique largement la « petite guerre » faite aujourd’hui aux scientifiques et universitaires."
                            },
                            {
                                "example_id": "31c4b45e-1ad5-4397-8a19-b9104f76db2b",
                                "sense_id": "7d9f05c1-c6c9-3982-b2e8-dce3ef04d5bb",
                                "text": "Nabet vit rouge et sentit monter en lui une colère irrationnelle. Pourtant il se contint, l'angoisse était plus forte que son ressentiment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3866670e-4ef9-4aa4-8031-fb95e1e16528",
                        "source_entry_id": "3c854896-8976-3695-a749-e72556e1d848",
                        "source_sense_id": "7d9f05c1-c6c9-3982-b2e8-dce3ef04d5bb",
                        "source_sense_description": "(Sens figuré) (Plus courant) Souvenir douloureux qu’on garde des injures et blessures, avec désir de s’en venger.",
                        "target_lang_word": "resentment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resentment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "559c33d6-523b-36c4-8012-e9f9f40336be",
                                        "entry_id": "246d733f-e844-3bed-adc0-560e770bfc77",
                                        "glosses": [
                                            "Anger or displeasure stemming from belief that one or one's group has been wronged or betrayed by others; indignation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9a9661d-3dc7-40e7-9bfc-db59cea1f77f",
                                                "sense_id": "559c33d6-523b-36c4-8012-e9f9f40336be",
                                                "text": "Amongst the most violent against him was Mrs. Bennet, whose dislike of his general behaviour, was sharpened into particular resentment, by his having slighted one of her daughters."
                                            },
                                            {
                                                "example_id": "62cd1bfe-1381-45e2-ba99-93fa5666badf",
                                                "sense_id": "559c33d6-523b-36c4-8012-e9f9f40336be",
                                                "text": "Younger [Customs] examiners, who, perhaps, have not yet acquired the intuition resulting from years of experience, seem partly responsible for the closer examination of incoming luggage. Not only is this closer scrutiny arousing feelings of resentment among passengers, but it is causing serious delays in the departure of boat trains, many of which have been reaching their destinations two or three hours late."
                                            },
                                            {
                                                "example_id": "b755a0a0-de25-494e-81f0-2e36f71556e7",
                                                "sense_id": "559c33d6-523b-36c4-8012-e9f9f40336be",
                                                "text": "“I Love Lisa” opens with one of my favorite underappreciated running jokes from The Simpsons: the passive-aggressive, quietly contentious relationship of radio jocks Bill and Marty, whose mindless happy talk regularly gives way to charged exchanges that betray the simmering resentment and disappointment perpetually lingering just under the surface of their relationship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac710696-84ae-3fbb-bd4b-6c2b1683980e",
                                        "entry_id": "246d733f-e844-3bed-adc0-560e770bfc77",
                                        "glosses": [
                                            "The state of holding something in the mind as a subject of contemplation, or of being inclined to reflect upon it; feeling; impression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8719a194-3dd3-4238-85ee-c5138ef6ff04",
                                                "sense_id": "ac710696-84ae-3fbb-bd4b-6c2b1683980e",
                                                "text": "It is a greater wonder that so many of them die, with so little resentment of their danger."
                                            },
                                            {
                                                "example_id": "8550876f-7dd2-4ce3-a34f-b12e9dda425d",
                                                "sense_id": "ac710696-84ae-3fbb-bd4b-6c2b1683980e",
                                                "text": "In my mind it is a ſign of a great deal of natural Integrity and inbred Nobleneſs of ſpirit, that maugre [in spite of] the heavineſs of his Complexion that thus ſtrongly bears him dovvn from apprehending ſo concerning Metaphyſicall Truths, yet he retains ſo vivid reſentments of the more sſolid Morality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "093c1bab-6c73-3005-bebc-95e759258cc6",
                                        "entry_id": "246d733f-e844-3bed-adc0-560e770bfc77",
                                        "glosses": [
                                            "Satisfaction; gratitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2bf52af-0def-420e-aa49-6d0c721fb36b",
                                                "sense_id": "093c1bab-6c73-3005-bebc-95e759258cc6",
                                                "text": "The Council taking notice of the many good services performed by Mr. John Milton […] have thought fit to declare their resentment and good acceptance of the same."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
