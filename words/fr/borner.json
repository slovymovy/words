{
    "word_family": [
        "borne",
        "bornage",
        "déborner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a1732b6-0e41-385f-a993-b2aa6e3ffa70",
                    "sense_definition": "Restreindre son action, son propos ou son effort à quelque chose d'unique ou de précis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour le moment, il se <w>borne</w> à écouter les remarques sans intervenir dans le débat."
                        },
                        {
                            "text": "Nous nous sommes <w>bornés</w> à répondre aux questions les plus urgentes lors de cette réunion."
                        }
                    ],
                    "synonyms": [
                        "limiter",
                        "cantonner",
                        "restreindre"
                    ],
                    "common_phrases": [
                        "se borner à"
                    ]
                },
                {
                    "sense_id": "6f679c06-b6b3-3afe-86de-97e56d6fd435",
                    "sense_definition": "Maintenir dans de justes limites, modérer ou restreindre quelque chose d'abstrait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé de <w>borner</w> les dépenses du projet pour éviter tout déficit imprévu."
                        },
                        {
                            "text": "Il convient de <w>borner</w> ses ambitions pour ne pas risquer de perdre l'essentiel."
                        }
                    ],
                    "synonyms": [
                        "restreindre",
                        "modérer",
                        "freiner"
                    ],
                    "antonyms": [
                        "étendre",
                        "élargir"
                    ],
                    "common_phrases": [
                        "borner ses prétentions",
                        "borner son ambition"
                    ]
                },
                {
                    "sense_id": "ffee2dc7-b90d-3f74-b283-99a7480349d7",
                    "sense_definition": "Constituer la limite spatiale de quelque chose ou fermer l'horizon.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une haute rangée de collines boisées <w>borne</w> la vue vers le sud du village."
                        },
                        {
                            "text": "Les montagnes rocheuses <w>bornent</w> la plaine et la protègent des vents froids du nord."
                        }
                    ],
                    "synonyms": [
                        "border",
                        "délimiter",
                        "clore"
                    ],
                    "common_phrases": [
                        "borner la vue"
                    ]
                },
                {
                    "sense_id": "c0713dd0-48c9-375c-a195-959b7e0494ee",
                    "sense_definition": "Poser des bornes physiques pour marquer légalement les limites d'un terrain ou d'une propriété.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le géomètre expert a été mandaté pour <w>borner</w> le terrain avant la vente définitive."
                        },
                        {
                            "text": "Les deux voisins ont convenu de <w>borner</w> leurs propriétés respectives à l'amiable."
                        }
                    ],
                    "synonyms": [
                        "délimiter"
                    ],
                    "common_phrases": [
                        "borner un terrain",
                        "borner un champ"
                    ]
                },
                {
                    "sense_id": "60a58e00-0d73-32da-8a8c-2f0bfa99c404",
                    "sense_definition": "Se connecter à une antenne relais de télécommunications, permettant d'enregistrer la localisation d'un appareil.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le téléphone du suspect a cessé de <w>borner</w> au moment précis de l'incident."
                        },
                        {
                            "text": "Les enquêteurs ont découvert que son appareil <w>bornait</w> près de la gare vers minuit."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "jargon policier et judiciaire"
                        }
                    ]
                }
            ]
        }
    ]
