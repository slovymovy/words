                "senses": [
                    {
                        "sense_id": "f383d609-0639-3e41-b220-1acb50bbd6c0",
                        "entry_id": "4f1eda51-11f0-33b4-af3f-7d494d6782b9",
                        "glosses": [
                            "Donner un caractère sémiologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "660fc6b4-5779-4cf1-8569-fa1b98fff795",
                                "sense_id": "f383d609-0639-3e41-b220-1acb50bbd6c0",
                                "text": "Délimiter la frontière ou du moins la sémiologiser par une modification de la valeur de son gradient est une exigence de la population."
                            },
                            {
                                "example_id": "33df5d8c-a89a-4934-83af-81a426113f6b",
                                "sense_id": "f383d609-0639-3e41-b220-1acb50bbd6c0",
                                "text": "Il s'agit alors de sémiologiser l'intégralité de la praxis pour subordonner son plan au plan langagier, dans le sens le plus totalisant de ce terme."
                            },
                            {
                                "example_id": "ac9b5a8f-a731-4531-92e8-1de905ff8ce1",
                                "sense_id": "f383d609-0639-3e41-b220-1acb50bbd6c0",
                                "text": "Petit à petit on commence à sémiologiser l'aveu, à constituer des symptômes."
                            }
                        ]
                    }
