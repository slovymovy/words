                        "examples": [
                            {
                                "example_id": "ed4b8ed3-056b-4e2b-b9bc-1d897b55e80a",
                                "sense_id": "1686217b-9785-3c2e-b070-7c1eea90fd49",
                                "text": "McClatchy goes on to try and level a damning critique, which amounts to a lot of handwaving about things we already know."
                            },
                            {
                                "example_id": "2b9bbda1-13e7-45e9-baad-8f35a7bab25a",
                                "sense_id": "1686217b-9785-3c2e-b070-7c1eea90fd49",
                                "text": "If one looks today at the logical literature, one finds that there is a great deal of handwaving going on of the same kind as that used by Gödel in his paper. That is, informal arguments are given to show that a formalization of a certain statement is formally provable in a certain theory."
                            }
                        ]
                    }
