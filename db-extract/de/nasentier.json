                ],
                "senses": [
                    {
                        "sense_id": "1e124022-b658-3e9c-b744-ac13de424bca",
                        "entry_id": "52d8ed8a-1fe0-31b1-8dea-5baf79c54749",
                        "glosses": [
                            "Ein Tier, dessen funktionell primärer sensorischer Sinn der Riechsinn ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6e8305f-7fc4-45e5-940f-6376769a3606",
                                "sense_id": "1e124022-b658-3e9c-b744-ac13de424bca",
                                "text": "„Wobei die Aufrichtung des Menschen vom Boden nach Sigmund Freuds Meinung zur Verlagerung der Sinnestätigkeiten führte. Aus dem einstmaligen Nasentier entwickelte sich das Augentier.“"
                            },
                            {
                                "example_id": "e70a50aa-3496-43f1-8b70-4de861ac6782",
                                "sense_id": "1e124022-b658-3e9c-b744-ac13de424bca",
                                "text": "„Wir sahen soeben schon den ganzen grundlegenden Unterschied zwischen Nasentieren und Augentieren als Verfolger. Eine Schutzfarbe wirkt nur einem Augentier gegenüber, ist einem Nasentier gegenüber so gut wie völlig belanglos."
                            },
                            {
                                "example_id": "f66f92d9-e5ef-4b23-8906-082c5126ceef",
                                "sense_id": "1e124022-b658-3e9c-b744-ac13de424bca",
                                "text": "„Geruchswelten: Wie die meisten Nagetiere sind Ratten sogenannte Makrosmaten: Sie sehen nur unscharf, dafür liefert ihnen aber ihr Geruchssinn detaillierte Informationen über die Umgebung. Besonders aufregend ist es für das Nasentier Ratte dort, wo es viele unterschiedliche Düfte und Wohlgerüche zu schnuppern gibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "623960bb-600a-394b-af95-95afb8180813",
                        "entry_id": "52d8ed8a-1fe0-31b1-8dea-5baf79c54749",
                        "glosses": [
                            "Umgangssprachlicher Name für einen Vertreter der Rhinogradentia oder Naslinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e963f16-7f66-475a-9d90-57417a83b1f0",
                                "sense_id": "623960bb-600a-394b-af95-95afb8180813",
                                "text": "„Der Schwede Einar Pettersson-Skämtkvist entdeckte die seltsamen Nasentiere, als er aus japanischer Kriegsgefangenschaft in der Südsee auf die Insel Haidadaifi flüchtete, die zum Archipel Heieiei (auf Englisch: Hi-Iay) gehört.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
