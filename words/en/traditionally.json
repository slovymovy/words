{
    "word_family": [
        "tradition",
        "traditional",
        "traditionalist",
        "traditionalism"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2a7d0ed6-224e-3861-99d1-42ab1347d738",
                    "sense_definition": "In a way that follows tradition or established custom.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancers were dressed <w>traditionally</w> in bright, colorful costumes.",
                            "target_lang_translations": {
                                "ru": "Танцоры были одеты <w>традиционно</w> — в яркие, красочные костюмы.",
                                "zh": "舞者们<w>传统地</w>穿着色彩鲜艳的服装。",
                                "es": "Los bailarines estaban vestidos <w>tradicionalmente</w> con trajes brillantes y coloridos."
                            }
                        },
                        {
                            "text": "We celebrate the holiday <w>traditionally</w> with a large family dinner.",
                            "target_lang_translations": {
                                "ru": "Мы отмечаем этот праздник <w>традиционно</w>, большим семейным ужином.",
                                "zh": "我们<w>按照传统</w>以一顿丰盛的家庭晚餐来庆祝这个节日。",
                                "es": "Celebramos la festividad <w>tradicionalmente</w> con una gran cena familiar."
                            }
                        }
                    ],
                    "synonyms": [
                        "conventionally",
                        "customarily"
                    ],
                    "antonyms": [
                        "nontraditionally",
                        "untraditionally"
                    ],
                    "common_phrases": [
                        "dressed traditionally",
                        "traditionally prepared",
                        "traditionally built"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следуя традициям, в соответствии с установленными обычаями.",
                        "zh": "按照传统或既定习俗的方式。",
                        "es": "De una manera que sigue la tradición o las costumbres establecidas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "традиционно",
                                "target_lang_sense_clarification": "наречие образа действия"
                            },
                            {
                                "target_lang_word": "по традиции",
                                "target_lang_sense_clarification": "в силу обычая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传统地",
                                "target_lang_sense_clarification": "以传统的方式"
                            },
                            {
                                "target_lang_word": "按照传统",
                                "target_lang_sense_clarification": "遵循既定习俗"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tradicionalmente",
                                "target_lang_sense_clarification": "de forma tradicional"
                            },
                            {
                                "target_lang_word": "según la tradición",
                                "target_lang_sense_clarification": "siguiendo una costumbre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18439a80-29bd-33d3-8199-fdb0df8639e7",
                    "sense_definition": "According to what has been done or believed for a long time; historically.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This region is <w>traditionally</w> known for its excellent wine production.",
                            "target_lang_translations": {
                                "ru": "Этот регион <w>традиционно</w> славится производством превосходного вина.",
                                "zh": "该地区<w>传统上</w>以出产优质葡萄酒而闻名。",
                                "es": "Esta región es <w>tradicionalmente</w> conocida por su excelente producción de vino."
                            }
                        },
                        {
                            "text": "Teaching has <w>traditionally</w> been viewed as a very noble profession.",
                            "target_lang_translations": {
                                "ru": "Преподавание <w>традиционно</w> рассматривается как очень благородная профессия.",
                                "zh": "教学<w>历来</w>被视为一种非常高尚的职业。",
                                "es": "La enseñanza ha sido <w>tradicionalmente</w> considerada una profesión muy noble."
                            }
                        }
                    ],
                    "synonyms": [
                        "historically"
                    ],
                    "common_phrases": [
                        "traditionally associated",
                        "traditionally known",
                        "traditionally used"
                    ],
                    "target_lang_definitions": {
                        "ru": "Как было принято или считалось на протяжении долгого времени; исторически.",
                        "zh": "根据长期以来的做法或信仰；从历史上看。",
                        "es": "De acuerdo con lo que se ha hecho o creído durante mucho tiempo; históricamente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "традиционно",
                                "target_lang_sense_clarification": "исторически сложившись"
                            },
                            {
                                "target_lang_word": "исторически",
                                "target_lang_sense_clarification": "с давних пор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传统上",
                                "target_lang_sense_clarification": "从历史习惯来看"
                            },
                            {
                                "target_lang_word": "历来",
                                "target_lang_sense_clarification": "从过去到现在一直如此"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tradicionalmente",
                                "target_lang_sense_clarification": "desde un punto de vista histórico"
                            },
                            {
                                "target_lang_word": "históricamente",
                                "target_lang_sense_clarification": "desde hace mucho tiempo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}