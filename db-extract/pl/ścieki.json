                                    {
                                        "sense_id": "59cceb13-4a42-3769-85ed-be39911cc7b6",
                                        "entry_id": "838b3b87-281b-304b-9235-186b8688973e",
                                        "glosses": [
                                            "A suspension of water and solid waste, transported by sewers to be disposed of or processed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7977b0ab-cd6b-4a19-a829-1fd9efec81b1",
                                                "sense_id": "59cceb13-4a42-3769-85ed-be39911cc7b6",
                                                "text": "Untreated sewage can pollute rivers."
                                            },
                                            {
                                                "example_id": "323d57d2-6a73-478d-ae91-e8f7ffae66b1",
                                                "sense_id": "59cceb13-4a42-3769-85ed-be39911cc7b6",
                                                "text": "The city invested in a modern sewage system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf09843d-36bb-3c9c-9142-ea7ba7b43206",
