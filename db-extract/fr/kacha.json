                        "source_sense_id": "8875c62a-51ae-3b38-a87f-5d766fc5b0f7",
                        "source_sense_description": "Gastronomie: Kascha, Buchweizengrütze, Grütze",
                        "target_lang_word": "Buchweizengrütze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchweizengrütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18f02209-06ca-38f0-882e-714a3afe1a2f",
                                        "entry_id": "a53719da-07a5-3cea-904c-80be0e6d46fe",
                                        "glosses": [
                                            "Grütze aus Buchweizen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b4b7736-fb4a-4de6-bc45-7481143421c8",
                                                "sense_id": "18f02209-06ca-38f0-882e-714a3afe1a2f",
                                                "text": "„So streiften sie durch die Gegend, umgingen ein Moorgelände und fanden in einem Wäldchen ein verirrtes Tier, das sich mit einer Handvoll Buchweizengrütze anlocken ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bfb2b90-1e86-47e5-80f4-6918a77e52a2",
                        "source_entry_id": "7ac9869c-09f0-3cb7-80ab-2e86e4f8549d",
                        "source_sense_id": "8875c62a-51ae-3b38-a87f-5d766fc5b0f7",
                        "source_sense_description": "Gastronomie: Kascha, Buchweizengrütze, Grütze",
                        "target_lang_word": "Grütze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "452bcd6a-1c9f-32bf-b230-5b7f45e87eae",
                                        "entry_id": "b36a5ec1-6284-3a52-859e-21db8995e1ca",
                                        "glosses": [
                                            "grob gemahlenes Getreide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deef6704-504c-4f7e-b9c8-d7d21ad30edd",
                                                "sense_id": "452bcd6a-1c9f-32bf-b230-5b7f45e87eae",
                                                "text": "„Währenddessen hatte die viertausend Mann starke Abteilung Bagration lustig ihre Lagerfeuer angezündet, trocknete sich, wärmte sich, kochte sich nach drei Tagen wieder zum ersten Mal ihre Grütze, und keiner von den Leuten der Abteilung wusste oder ahnte auch nur, was ihm bevorstand.“"
                                            },
                                            {
                                                "example_id": "1cade70d-8320-4def-828d-20a05859f2b0",
                                                "sense_id": "452bcd6a-1c9f-32bf-b230-5b7f45e87eae",
                                                "text": "„Man brachte Grütze von isländischem Moos, Hammellende, Dorschköpfe, saure Milch und steinhartes, glasklares Haifischfleisch.“"
                                            },
                                            {
                                                "example_id": "e0d984ff-430e-4af0-a2a0-10177c777f5d",
                                                "sense_id": "452bcd6a-1c9f-32bf-b230-5b7f45e87eae",
                                                "text": "„Zugleich hatte ich mich für ein Feuer entschieden, das ich in einem der unversehrten Küchenherde entfachen wollte, um mir den Rest meiner Grütze zu kochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3cdceb12-3e0b-3beb-95db-d0ea985acb07",
                                        "entry_id": "b36a5ec1-6284-3a52-859e-21db8995e1ca",
                                        "glosses": [
                                            "grob gemahlenes Getreide",
                                            "Brei aus grob gemahlenem Getreide"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "a6f9e86b-c39f-3a73-97fe-ed4cb453dc43",
                                        "entry_id": "b36a5ec1-6284-3a52-859e-21db8995e1ca",
                                        "glosses": [
                                            "süße, eingedickte Speise aus Früchten, ursprünglich mit Grütze^([1])"
                                        ],
                                        "tags": [
                                            "rote/grüne/gelbe Grütze"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50c8d1e4-5a6b-4a0f-85e9-787193346a06",
                                                "sense_id": "a6f9e86b-c39f-3a73-97fe-ed4cb453dc43",
                                                "text": "„Nach der roten Grütze geht dann jeder mit Wut im Bauch nach Hause.“"
                                            },
                                            {
                                                "example_id": "0a8f0e65-8060-4aec-85aa-b23c5f9f1bdd",
                                                "sense_id": "a6f9e86b-c39f-3a73-97fe-ed4cb453dc43",
                                                "text": "„Er ging zum Herd und rührte den Kessel mit Grütze um, dann machte er die Ofentür auf und betrachtete die Biskuits.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
