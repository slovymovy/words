                "senses": [
                    {
                        "sense_id": "304d44d6-d470-3c25-b7d9-f017a8139a32",
                        "entry_id": "fcc6a50c-c658-3a58-9315-89f1736f2e38",
                        "glosses": [
                            "относящийся к Булгакову, связанный с ним"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65775450-cc48-4dca-b936-2b8ed414b8f0",
                                "sense_id": "304d44d6-d470-3c25-b7d9-f017a8139a32",
                                "text": "К булгаковедению я никакого отношения не имею, но знаю, как тщательно изучался и изучается булгаковский текст на протяжении десятилетий, с какой осторожностью допускается (если допускается) любая поправка к нему."
                            },
                            {
                                "example_id": "168a5f0a-6524-45a6-b5ce-daee2da742d4",
                                "sense_id": "304d44d6-d470-3c25-b7d9-f017a8139a32",
                                "text": "Булгаковский Воланд как-то заметил: «Рукописи не горят»."
                            }
                        ]
                    }
