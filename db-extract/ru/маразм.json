                ],
                "translations": [
                    {
                        "translation_id": "36dd675f-5bbd-4a81-934c-202258572963",
                        "source_entry_id": "33359632-4e8d-384c-816e-2b12bcdcb0e3",
                        "target_lang_word": "marasmus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marasmus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e2c4aa5-4705-3cb5-a707-d79618e70675",
                                        "entry_id": "58b583a9-fe1e-36e2-8168-26c1c1267ced",
                                        "glosses": [
                                            "A condition of chronic undernourishment especially in children, caused by a diet deficient in calories or the inability to digest protein and presenting as a severe loss of body weight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5af849c-cfc4-44e4-979e-a9e33b5158c1",
                                                "sense_id": "3e2c4aa5-4705-3cb5-a707-d79618e70675",
                                                "text": "Indian children are still among the skinniest and shortest on the planet, but they are taller and plumper than were their parents or grandparents, and the signs of gross hunger, such as marasmus, are now rarely seen in nutritional surveys."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
