{
    "word_family": [
        "et cetera"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b4194201-5893-3a5e-9acf-29a82d2baa5e",
                    "sense_definition": "Used at the end of a list to indicate that further, similar items are included; an alternative form of <w>etc.</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please bring your own pens, pencils, paper, <w>etc</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, принесите свои ручки, карандаши, бумагу <w>и т. д.</w>",
                                "zh": "请自带钢笔、铅笔、纸张<w>等等</w>。"
                            }
                        },
                        {
                            "text": "The festival features music, dance, food, <w>etc</w>.",
                            "target_lang_translations": {
                                "ru": "На фестивале представлены музыка, танцы, еда <w>и т. д.</w>",
                                "zh": "节日活动包括音乐、舞蹈、美食<w>等等</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "and so on",
                        "and so forth"
                    ],
                    "common_phrases": [
                        "books, pens, etc",
                        "apples, oranges, etc"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of etc."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в конце перечисления для указания на то, что список можно продолжить другими подобными элементами; сокращение от «и так далее».",
                        "zh": "用于列举结束时，表示还有其他类似的项目；“等等”的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "и так далее",
                                "target_lang_sense_clarification": "стандартное завершение перечисления"
                            },
                            {
                                "target_lang_word": "и тому подобное",
                                "target_lang_sense_clarification": "для перечисления схожих предметов или явлений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "等等",
                                "target_lang_sense_clarification": "用于列举结束，表示还有类似事物"
                            },
                            {
                                "target_lang_word": "以及其他",
                                "target_lang_sense_clarification": "用于正式场合的列举"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc9f867e-16ee-30b3-b663-47392dc30786",
                    "sense_definition": "Acronym of <w>Electronic Toll Collection</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new highway uses <w>ETC</w> to speed up traffic flow.",
                            "target_lang_translations": {
                                "ru": "На новой автомагистрали используется <w>электронный сбор платы</w> для ускорения транспортного потока.",
                                "zh": "这条新高速公路使用<w>电子不停车收费系统</w>来加快车流速度。"
                            }
                        },
                        {
                            "text": "Drivers without <w>ETC</w> must stop at the booth to pay cash.",
                            "target_lang_translations": {
                                "ru": "Водители без <w>системы электронного сбора платы</w> должны остановиться у будки для оплаты наличными.",
                                "zh": "没有<w>电子不停车收费系统</w>的司机必须在收费站停车付现金。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от Electronic Toll Collection (система электронного сбора платы за проезд).",
                        "zh": "电子不停车收费系统的缩写，用于高速公路自动缴费。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электронный сбор платы",
                                "target_lang_sense_clarification": "дорожная система"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电子不停车收费系统",
                                "target_lang_sense_clarification": "交通领域术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "320111d9-28b8-3ee3-a355-603469ddbece",
                    "sense_definition": "Acronym of <w>electron transport chain</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ETC</w> is a crucial process for cellular respiration.",
                            "target_lang_translations": {
                                "ru": "<w>ЭТЦ</w> является важнейшим процессом клеточного дыхания.",
                                "zh": "<w>电子传递链</w>是细胞呼吸的关键过程。"
                            }
                        },
                        {
                            "text": "Students studied how the <w>ETC</w> generates energy in mitochondria.",
                            "target_lang_translations": {
                                "ru": "Студенты изучали, как <w>ЭТЦ</w> вырабатывает энергию в митохондриях.",
                                "zh": "学生们研究了<w>电子传递链</w>如何在粒线体中产生能量。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от electron transport chain (электрон-транспортная цепь).",
                        "zh": "电子传递链的缩写，生物化学中细胞呼吸的关键过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электрон-транспортная цепь",
                                "target_lang_sense_clarification": "биология/химия"
                            },
                            {
                                "target_lang_word": "ЭТЦ",
                                "target_lang_sense_clarification": "аббревиатура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电子传递链",
                                "target_lang_sense_clarification": "生物化学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa17d353-82f0-3735-84a7-326c0d8d38fe",
                    "sense_definition": "Acronym of <w>Exchange-Traded Commodity</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors often buy an <w>ETC</w> to gain exposure to gold prices.",
                            "target_lang_translations": {
                                "ru": "Инвесторы часто покупают <w>биржевые товарные инструменты</w>, чтобы получить доступ к ценам на золото.",
                                "zh": "投资者经常购买<w>交易所交易商品</w>来获取黄金价格的投资机会。"
                            }
                        },
                        {
                            "text": "The portfolio includes stocks, bonds, and an <w>ETC</w>.",
                            "target_lang_translations": {
                                "ru": "Портфель включает акции, облигации и <w>биржевой товарный инструмент</w>.",
                                "zh": "投资组合包括股票、债券和一种<w>交易所交易商品</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от Exchange-Traded Commodity (биржевой товарный инструмент).",
                        "zh": "交易所交易商品的缩写，指在证券交易所上市交易的商品类金融产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "биржевой товарный инструмент",
                                "target_lang_sense_clarification": "финансы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交易所交易商品",
                                "target_lang_sense_clarification": "金融投资术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
