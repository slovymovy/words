{
    "word_family": [
        "remark",
        "remarkably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fc267ca8-e193-3ee9-a62e-05e62df8dad1",
                    "sense_definition": "Worthy of attention; notable or interesting.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "notable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She showed <w>remarkable</w> talent for music at a very young age.",
                            "target_lang_translations": {
                                "ru": "Она проявила <w>выдающийся</w> музыкальный талант в очень юном возрасте.",
                                "tr": "Çok genç yaşta müziğe karşı <w>olağanüstü</w> bir yetenek gösterdi.",
                                "zh": "她年纪轻轻就展现出了<w>非凡的</w>音乐天赋。"
                            }
                        },
                        {
                            "text": "The scientist made a <w>remarkable</w> discovery that changed history.",
                            "target_lang_translations": {
                                "ru": "Учёный сделал <w>замечательное</w> открытие, которое изменило историю.",
                                "tr": "Bilim insanı tarihi değiştiren <w>kayda değer</w> bir keşif yaptı.",
                                "zh": "这位科学家做出了一个改变历史的<w>显著</w>发现。"
                            }
                        }
                    ],
                    "synonyms": [
                        "notable",
                        "noteworthy",
                        "extraordinary",
                        "outstanding",
                        "significant",
                        "impressive",
                        "striking",
                        "amazing"
                    ],
                    "antonyms": [
                        "unremarkable"
                    ],
                    "common_phrases": [
                        "remarkable achievement",
                        "truly remarkable",
                        "quite remarkable",
                        "remarkable success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий внимания; выдающийся или интересный.",
                        "tr": "Dikkat çekmeye değer; dikkate değer veya ilginç.",
                        "zh": "值得注意的；非凡的或有趣的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдаю́щийся",
                                "target_lang_sense_clarification": "исключительный, выделяющийся среди других"
                            },
                            {
                                "target_lang_word": "замеча́тельный",
                                "target_lang_sense_clarification": "достойный внимания, очень хороший"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kayda değer",
                                "target_lang_sense_clarification": "önemli, dikkati çeken"
                            },
                            {
                                "target_lang_word": "dikkate değer",
                                "target_lang_sense_clarification": "dikkati hak eden, önemli"
                            },
                            {
                                "target_lang_word": "olağanüstü",
                                "target_lang_sense_clarification": "benzerlerinden üstün, fevkalade"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非凡的",
                                "target_lang_sense_clarification": "指才华或成就超出寻常，非常出色"
                            },
                            {
                                "target_lang_word": "显著的",
                                "target_lang_sense_clarification": "指非常明显，值得关注"
                            },
                            {
                                "target_lang_word": "卓越的",
                                "target_lang_sense_clarification": "指杰出、高超，常用于形容能力或成就"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05e73428-5b2f-382a-a499-43342531371e",
                    "sense_definition": "Uncommon, unusual, or surprising.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unusual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>remarkable</w> that the two strangers had the exact same name.",
                            "target_lang_translations": {
                                "ru": "<w>Удивительно</w>, что у двух незнакомцев были совершенно одинаковые имена.",
                                "tr": "İki yabancının birebir aynı ada sahip olması <w>şaşırtıcı</w>.",
                                "zh": "这两个陌生人竟然同名，真是<w>令人惊奇</w>。"
                            }
                        },
                        {
                            "text": "There is a <w>remarkable</w> similarity between the two paintings.",
                            "target_lang_translations": {
                                "ru": "Между двумя картинами существует <w>поразительное</w> сходство.",
                                "tr": "İki tablo arasında <w>göze çarpan</w> bir benzerlik var.",
                                "zh": "这两幅画之间存在着<w>惊人的</w>相似之处。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unusual",
                        "strange",
                        "rare",
                        "singular",
                        "surprising"
                    ],
                    "antonyms": [
                        "normal",
                        "unremarkable"
                    ],
                    "common_phrases": [
                        "remarkable coincidence",
                        "remarkable similarity",
                        "remarkable difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Необычный, редкий или вызывающий удивление.",
                        "tr": "Alışılmadık, olağandışı veya şaşırtıcı.",
                        "zh": "不寻常的、罕见的或令人惊讶的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порази́тельный",
                                "target_lang_sense_clarification": "вызывающий сильное удивление"
                            },
                            {
                                "target_lang_word": "удиви́тельный",
                                "target_lang_sense_clarification": "странный или неожиданный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şaşırtıcı",
                                "target_lang_sense_clarification": "hayret verici, beklenmedik"
                            },
                            {
                                "target_lang_word": "şayanıhayret",
                                "target_lang_sense_clarification": "hayret edilecek derecede sıradışı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惊人的",
                                "target_lang_sense_clarification": "指程度极高，令人感到吃惊"
                            },
                            {
                                "target_lang_word": "奇特的",
                                "target_lang_sense_clarification": "指罕见且不同寻常"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}