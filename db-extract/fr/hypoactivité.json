                ],
                "senses": [
                    {
                        "sense_id": "59510796-06d0-3fe5-9a3f-b673233db7f3",
                        "entry_id": "8d5b62be-3523-39e4-8fd2-14caab6c9ed4",
                        "glosses": [
                            "Activité très faible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b18d171e-09e5-43e1-8c64-9d67550b069e",
                                "sense_id": "59510796-06d0-3fe5-9a3f-b673233db7f3",
                                "text": "L’ensemble de ces processus cérébraux complexes s’altère lui aussi sous l’effet de l’hypoactivité."
                            },
                            {
                                "example_id": "9b844de3-78ab-4603-ab73-fa0e0482c91c",
                                "sense_id": "59510796-06d0-3fe5-9a3f-b673233db7f3",
                                "text": "L’hypoactivité est caractérisée par une absence de contraintes sur le système musculo-squelettique."
                            },
                            {
                                "example_id": "c4a1158a-e35a-4080-abb8-efb40ad1fe57",
                                "sense_id": "59510796-06d0-3fe5-9a3f-b673233db7f3",
                                "text": "Face aux maths, on observe parfois des réactions typiques de la panique, en particulier une hyperactivité de l’amygdale, qui s'accompagne souvent d’une hypoactivité des régions associées aux traitements mathématiques..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5d68f6c-6f99-4495-9273-c49103d19acf",
                        "source_entry_id": "8d5b62be-3523-39e4-8fd2-14caab6c9ed4",
                        "source_sense_id": "59510796-06d0-3fe5-9a3f-b673233db7f3",
                        "target_lang_word": "Hypoaktivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hypoaktivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88df351a-9a8f-3ed5-82eb-babb1a13e83e",
                                        "entry_id": "04446ac9-712b-3b75-beb8-3d09511a0696",
                                        "glosses": [
                                            "Mangel an Aktivität/Tätigkeit"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f95a6a52-00e1-4719-9731-c927ef45bfe6",
                                                "sense_id": "88df351a-9a8f-3ed5-82eb-babb1a13e83e",
                                                "text": "„So löste die Injektion von Silber (je 1 mg) bei Mäusen nach einigen Tagen Hypoaktivität aus.“"
                                            },
                                            {
                                                "example_id": "b8f96c55-b1b2-4ca5-ace4-91d97cf14347",
                                                "sense_id": "88df351a-9a8f-3ed5-82eb-babb1a13e83e",
                                                "text": "„Ein Delir kann sich sowohl durch Hyper- als auch durch Hypoaktivität äußern, was die Diagnosestellung erschwert.“"
                                            },
                                            {
                                                "example_id": "45bf3b01-f7a0-4ef2-9954-6abe83612b8a",
                                                "sense_id": "88df351a-9a8f-3ed5-82eb-babb1a13e83e",
                                                "text": "„Es handelt sich um eine Desinhibition der Amygdala durch Hypoaktivität des präfrontalen Kortex.“"
                                            },
                                            {
                                                "example_id": "d2a9f6e3-ad6d-431b-93b0-8edd1668e014",
                                                "sense_id": "88df351a-9a8f-3ed5-82eb-babb1a13e83e",
                                                "text": "„Die deutlich seltenere Hypoaktivität ist häufig Nebenwirkung von Anticholinergika oder Antidepressiva.“"
                                            },
                                            {
                                                "example_id": "bd2caa5c-973b-42fe-b97a-e6ae11d8cd02",
                                                "sense_id": "88df351a-9a8f-3ed5-82eb-babb1a13e83e",
                                                "text": "„Wenn die Impulsivität gegen Null geht, haben wir das vor uns, was wir unter »Durchhängen« oder »Hypoaktivität« kennengelernt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
