                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d489a9d3-6a93-35ac-b8d0-9d7cd264d48c",
                                        "entry_id": "535e627c-c36b-3747-8827-baa09ad1cafa",
                                        "glosses": [
                                            "Herstellung/Vermittlung von Kontakten zwischen Personen zwecks Heirat oder - oft bezahlter - sexueller Aktivitäten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5610bff-1236-46c8-a97f-311eedd2cadd",
                                                "sense_id": "d489a9d3-6a93-35ac-b8d0-9d7cd264d48c",
                                                "text": "„Da Polen wieder einmal in einer prekären politischen Lage steckte, schreckten Polens Diplomaten nicht einmal vor Kuppeleien zurück.“"
                                            },
                                            {
                                                "example_id": "fc54e125-0c72-4ceb-b2ac-8323e94fb7b3",
                                                "sense_id": "d489a9d3-6a93-35ac-b8d0-9d7cd264d48c",
                                                "text": "„Für solche Weibsbilder wurde die Kuppelei tatsächlich zur Leidenschaft.“"
                                            },
                                            {
                                                "example_id": "153f3259-a421-4e90-abbd-50f378dfc6b8",
                                                "sense_id": "d489a9d3-6a93-35ac-b8d0-9d7cd264d48c",
                                                "text": "„Eine Strafanzeige wegen Kuppelei hätte ohne weiteres erhoben werden können.“"
                                            },
                                            {
                                                "example_id": "0c80b5f7-a137-4012-9379-943627a188f7",
                                                "sense_id": "d489a9d3-6a93-35ac-b8d0-9d7cd264d48c",
                                                "text": "„Dort hausten mehr als zehn Familien, die sämtlich von Kuppelei lebten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
