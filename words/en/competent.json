                    "frequency": "Low",
                    "semantic_group_id": "function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>competent</w> immune system is essential for fighting off seasonal viruses.",
                            "target_lang_translations": {
                                "ru": "<w>Полноценная</w> иммунная система необходима для борьбы с сезонными вирусами.",
                                "tr": "Mevsimsel virüslerle savaşmak için <w>sağlıklı</w> bir bağışıklık sistemi şarttır."
                            }
