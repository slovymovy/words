                        "entry_id": "9f36a737-d87e-370d-9ede-aa982d7c9b20",
                        "glosses": [
                            "Filmpreis, der jährlich von der amerikanischen Academy of Motion Picture Arts and Sciences in unterschiedlichen Kategorien verliehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "276b5233-7346-4076-ab0d-eb52759873fb",
                                "sense_id": "e140d52f-27b8-3252-a357-d09b6dc494ad",
                                "text": "Dieser Film wurde letztes Jahr mit mehreren Academy-Awards ausgezeichnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
