                                                "example_id": "f4216d01-78ea-4f56-9e47-d5f19b1d00d5",
                                                "sense_id": "611a7a64-1b32-34ae-a0b1-5d55482ca4e5",
                                                "text": "Cleopatra is rent by a struggle between her newly-acquired dignity as a queen, and a strong impulse to put out her tongue at him."
                                            }
