                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f90c40ef-8629-3bf2-b05c-82797b7d8296",
                                        "entry_id": "0c8ee655-a91e-3d76-8cc6-ad00133d14d4",
                                        "glosses": [
                                            "A class, typically in a performing art such as music or drama, in which a teacher listens to and critiques the performance of individual students, one at a time, while the other students observe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02037a0e-b440-404e-82c2-84deacf90018",
                                                "sense_id": "f90c40ef-8629-3bf2-b05c-82797b7d8296",
                                                "text": "The vocal pedagogue loves the Master Class idea. Such classes are usually conducted by the more plutocratic teachers for periods of from two to six weeks. Many of them vaguely promise to deliver a complete technique within that time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86230ff0-8f0c-31cc-ae96-e8a5a4c201bb",
                                        "entry_id": "0c8ee655-a91e-3d76-8cc6-ad00133d14d4",
                                        "glosses": [
                                            "An action or series of actions that serve to demonstrate a person's mastery of a subject."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9d7c91d-8b1a-3afb-891d-e128b1c9de2c",
                                        "entry_id": "0c8ee655-a91e-3d76-8cc6-ad00133d14d4",
                                        "glosses": [
                                            "A brilliant or virtuosic performance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
