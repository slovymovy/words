                                            {
                                                "example_id": "047d6475-63b1-4a18-87fe-5c1aba5b6737",
                                                "sense_id": "6df0436c-bf5c-3551-b2bc-4632e6a2a240",
                                                "text": "A brooding hen can be aggressive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b7ff4e-983b-3373-a12a-3d313fdcdac1",
                                        "entry_id": "6ef03507-3e1c-360b-9c75-61a08ae083f9",
                                        "glosses": [
                                            "Deeply or seriously thoughtful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca91ca9b-9fb9-4e35-8e0f-ec9f2c20073b",
                                                "sense_id": "39b7ff4e-983b-3373-a12a-3d313fdcdac1",
                                                "text": "You like T. S. Eliot's \"The Waste Land\"? You must be so brooding and deep."
                                            },
                                            {
                                                "example_id": "565a9bfb-37c1-4f77-b7e9-765452764b87",
                                                "sense_id": "39b7ff4e-983b-3373-a12a-3d313fdcdac1",
                                                "text": "his brooding good looks and distinct Scottish brogue won him legions of fans worldwide."
                                            }
                                        ]
                                    }
