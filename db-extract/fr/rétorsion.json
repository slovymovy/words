                                                "example_id": "263b3988-0365-471b-ab5a-026687f0b520",
                                                "sense_id": "2af45b41-0732-31f5-9fec-84420c67677c",
                                                "text": "„Mit Sex übt man auch Vergeltung am Tod.“"
                                            },
