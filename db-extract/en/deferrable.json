                                        "examples": [
                                            {
                                                "example_id": "26bf5911-487e-4086-b432-9fab1d2e3541",
                                                "sense_id": "986faec9-0a0f-35e4-ae6a-a68979e6e1be",
                                                "text": "„Keines der Geschäfte war aufschiebbar.“"
                                            },
                                            {
                                                "example_id": "f33a7c22-9da4-44df-bc0e-ea9bd5e20c1f",
                                                "sense_id": "986faec9-0a0f-35e4-ae6a-a68979e6e1be",
                                                "text": "„Ich habe Dir allerdings etwas Ernstes mitzutheilen, was leider nicht mehr aufschiebbar ist.“"
                                            },
                                            {
                                                "example_id": "35ce753f-e314-463d-a527-f4e55959b42f",
                                                "sense_id": "986faec9-0a0f-35e4-ae6a-a68979e6e1be",
                                                "text": "„[Telegramm:] Druck des Plakates nicht aufschiebbar darum Mitwirkung eingesetzt rechnen bestimmt mit Eintreffen Thema Dostojewski Unkosten werden ersetzt Künstlerhilfe Berlin Wilhelmstr.“"
                                            },
                                            {
                                                "example_id": "3cbd4188-bd3a-43af-a36a-a944359f9894",
                                                "sense_id": "986faec9-0a0f-35e4-ae6a-a68979e6e1be",
                                                "text": "„[Telegramm:] Operation nicht länger aufschiebbar, erfolgt morgen. Erbitte dringlichst Antwort. Kurt fragt ständig nach Mutter, unglücklich über Ausbleiben jeder Antwort.“"
                                            },
                                            {
                                                "example_id": "77b63056-e6c0-4182-a8a0-b56c61fa4524",
                                                "sense_id": "986faec9-0a0f-35e4-ae6a-a68979e6e1be",
                                                "text": "„Oftmals ist die Pflegefreistellung nicht möglich, ein nicht aufschiebbarer Termin steht vor der Tür und Oma oder Opa sind nicht greifbar, .... da sich eine Krankheit an keinen Terminkalender hält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
