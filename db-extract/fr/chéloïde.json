                                    {
                                        "sense_id": "014389cb-68eb-3781-b2e3-3d870d7c27f1",
                                        "entry_id": "42c61312-a4a1-3bd9-8d67-938e621fa352",
                                        "glosses": [
                                            "To form a keloid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "116db366-038b-4f20-9554-fa9ac41fd35b",
                                                "sense_id": "014389cb-68eb-3781-b2e3-3d870d7c27f1",
                                                "text": "The scar on his neck from running through that plate glass on one of our licks has keloided smooth and shiny."
                                            }
                                        ]
