                        "entry_id": "46c17051-15d3-375e-bdf7-0a60dfc5c238",
                        "glosses": [
                            "deska służąca do siedzenia, długie siedzisko bez oparcia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49bc663a-27bd-499f-af6c-9f592ff23014",
                                "sense_id": "c090abe7-1750-3814-a15f-04287750c685",
                                "text": "Dla biesiadników pospiesznie zbijano z desek stoły i ławy, stawiając je na zewnątrz, bo gości było więcej niż obszerna izba mogła pomieścić."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "96a97d34-bfcb-32b0-a8f8-3151149dc288",
                        "entry_id": "46c17051-15d3-375e-bdf7-0a60dfc5c238",
                        "glosses": [
                            "niski stolik, zwykle podłużny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb6deb70-92fa-47dd-950c-c677eaf5ac5c",
                                "sense_id": "96a97d34-bfcb-32b0-a8f8-3151149dc288",
                                "text": "Na imprezie u Karola musieliśmy zasiąść na tapczanie przy niewygodnej ławie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "a4aa4787-5685-3dfd-96f5-75fa8c46993f",
                        "entry_id": "46c17051-15d3-375e-bdf7-0a60dfc5c238",
                        "glosses": [
