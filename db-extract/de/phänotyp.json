                                    {
                                        "sense_id": "3e8d7da4-6114-3ce1-84b9-c7834a010f1d",
                                        "entry_id": "0664f6f2-db86-35e9-9775-c86a962cdf16",
                                        "glosses": [
                                            "The appearance of an organism based on a multifactorial combination of genetic traits and environmental factors, especially used in pedigrees."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c2e7cd1-adf5-3946-95c6-59c1701374ef",
