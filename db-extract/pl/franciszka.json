                    {
                        "translation_id": "bd8c26aa-39ec-4503-95f8-b9266bd7d501",
                        "source_entry_id": "8a70f21a-b149-3eae-ad18-7c38aaa4648a",
                        "source_sense_id": "58121591-d9b8-30a0-8cb1-9f1e3d31366c",
