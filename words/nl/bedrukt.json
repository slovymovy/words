                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het slechte nieuws heerste er een <w>bedrukte</w> stemming in de kamer.",
                            "target_lang_translations": {
                                "en": "After the bad news, there was a <w>subdued</w> atmosphere in the room.",
                                "ru": "После плохих новостей в комнате воцарилась <w>подавленная</w> атмосфера."
                            }
                        },
                        {
                            "text": "Hij keek met een <w>bedrukt</w> gezicht naar de resultaten van het onderzoek.",
                            "target_lang_translations": {
                                "en": "He looked at the results of the investigation with a <w>gloomy</w> face.",
                                "ru": "Он смотрел на результаты исследования с <w>мрачным</w> лицом."
