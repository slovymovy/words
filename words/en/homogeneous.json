{
    "word_family": [
        "homogeneity",
        "homogenize",
        "homogeneously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f29f73fe-0abc-39ff-9496-bf162352f013",
                    "sense_definition": "Consisting of parts or elements that are all of the same kind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uniformity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group was <w>homogeneous</w>, with all members sharing the same background.",
                            "target_lang_translations": {
                                "zh": "这个群体是<w>同质的</w>，所有成员都有相同的背景。"
                            }
                        },
                        {
                            "text": "A <w>homogeneous</w> society often lacks cultural diversity.",
                            "target_lang_translations": {
                                "zh": "一个<w>单一的</w>社会往往缺乏文化多样性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uniform"
                    ],
                    "antonyms": [
                        "heterogeneous"
                    ],
                    "common_phrases": [
                        "homogeneous group",
                        "homogeneous society"
                    ],
                    "target_lang_definitions": {
                        "zh": "由相同种类或性质的成分组成。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同质的",
                                "target_lang_sense_clarification": "指事物在性质或构成上是相同的。"
                            },
                            {
                                "target_lang_word": "单一的",
                                "target_lang_sense_clarification": "指群体或社会缺乏多样性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0881b7fa-5cf3-39ae-b3de-88d90a70846d",
                    "sense_definition": "Having a consistent composition or texture throughout.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "uniformity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stir the mixture until it is completely <w>homogeneous</w>.",
                            "target_lang_translations": {
                                "zh": "搅拌混合物直到它完全<w>均匀</w>。"
                            }
                        },
                        {
                            "text": "The <w>homogeneous</w> texture of the paint ensures a smooth finish.",
                            "target_lang_translations": {
                                "zh": "油漆<w>均匀的</w>质地确保了涂层平滑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uniform",
                        "unmixed"
                    ],
                    "antonyms": [
                        "heterogeneous"
                    ],
                    "common_phrases": [
                        "homogeneous mixture",
                        "homogeneous texture"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物质在整体上具有一致的成分或质地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "均匀的",
                                "target_lang_sense_clarification": "指混合物或质地分布一致。"
                            },
                            {
                                "target_lang_word": "均一的",
                                "target_lang_sense_clarification": "常用于科学或技术语境，指物质成分统一。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}