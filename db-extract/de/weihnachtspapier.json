                "senses": [
                    {
                        "sense_id": "1a066692-910d-3d0b-b252-76ebb34dcb87",
                        "entry_id": "133f7f4b-f448-3112-9474-1b2105fe1b6a",
                        "glosses": [
                            "mit weihnachtlichen Motiven bedrucktes Papier, das zum Einpacken der Geschenke verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3497a94-bcd9-482a-9f1b-0c85d5b1f3e7",
                                "sense_id": "1a066692-910d-3d0b-b252-76ebb34dcb87",
                                "text": "Was früher von der Oma im Kaufhaus gekauft und mit schönen Schleifen und rotem Weihnachtspapier eingepackt wurde, wird heute direkt in die Wohnstuben versandt."
                            },
                            {
                                "example_id": "fc9b6347-365d-4f57-b664-f114330d7dfa",
                                "sense_id": "1a066692-910d-3d0b-b252-76ebb34dcb87",
                                "text": "In buntes Weihnachtspapier gewickelt, so wurden die Pakete bereitgelegt."
                            },
                            {
                                "example_id": "aa403ab3-63d6-46e0-8850-d11203dc7feb",
                                "sense_id": "1a066692-910d-3d0b-b252-76ebb34dcb87",
                                "text": "„Hauptsache, es ist in Weihnachtspapier eingewickelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
