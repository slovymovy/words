                ],
                "senses": [
                    {
                        "sense_id": "bd03961c-da3a-3c07-801b-56b123b52b69",
                        "entry_id": "9ed75ece-53bd-38fb-8232-f22a68778cf6",
                        "glosses": [
                            "mieszkaniec Gdańska"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9eb8eb8-370b-4333-879c-9ee03aebc9d6",
                                "sense_id": "bd03961c-da3a-3c07-801b-56b123b52b69",
                                "text": "Wielu współczesnych gdańszczan nie do końca kojarzy modny dziś wrzeszczański Garnizon właśnie z Czarnymi Huzarami, dla których wybudowano te koszary w II połowie XIX stulecia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "47e23bea-fa50-32de-872c-d646a34281de",
                        "entry_id": "9ed75ece-53bd-38fb-8232-f22a68778cf6",
                        "glosses": [
                            "osoba pochodząca z Gdańska, urodzona w Gdańsku"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffe149bf-91e1-4b6d-a669-cf0ecf1373a7",
                        "source_entry_id": "9ed75ece-53bd-38fb-8232-f22a68778cf6",
                        "source_sense_id": "bd03961c-da3a-3c07-801b-56b123b52b69",
                        "target_lang_word": "Danziger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Danziger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bce89b9c-8fce-3fde-8fc6-4719fa6ddeb9",
                                        "entry_id": "0a83dcb6-0fc5-34c8-b348-283437fc9c51",
                                        "glosses": [
                                            "Einwohner von Danzig, in Danzig geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12012e57-3fcd-4bf2-947e-db614df12baa",
                                                "sense_id": "bce89b9c-8fce-3fde-8fc6-4719fa6ddeb9",
                                                "text": "„Das Fischerörtchen, in dem normalerweise Boote in verträumten, schilfgesäumten Buchten lagen, war für die Danziger noch im Sommer zuvor ein Ausflugsziel gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Danziger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ee0d120-21f5-388b-bc27-87c8d04c736d",
                                        "entry_id": "5333c4d9-3998-320e-a310-207a0c86605f",
                                        "glosses": [
                                            "sich auf Danzig beziehend, aus Danzig kommend, zu Danzig gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a3f8209-d0fd-468c-91e1-bbd6261dcf62",
                                                "sense_id": "4ee0d120-21f5-388b-bc27-87c8d04c736d",
                                                "text": "„Court stand an der Spitze des Schnellbootes und spähte blinzelnd zu den Docks der Danziger Schiffswerft, die vor ihm lagen.“"
                                            },
                                            {
                                                "example_id": "8386a947-5701-45ca-ae2e-4a93bfdeffe3",
                                                "sense_id": "4ee0d120-21f5-388b-bc27-87c8d04c736d",
                                                "text": "„Andere Ostpreußen misstrauten dem Landweg und steuerten bereits die Evakuierungshäfen in der Danziger Bucht an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "373783b2-4e56-4566-9007-1abeee752303",
                        "source_entry_id": "9ed75ece-53bd-38fb-8232-f22a68778cf6",
                        "source_sense_id": "bd03961c-da3a-3c07-801b-56b123b52b69",
                        "target_lang_word": "гданьчанин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9ed2702a-dcea-4ab2-bb4e-3dfd70a030ca",
                        "source_entry_id": "9ed75ece-53bd-38fb-8232-f22a68778cf6",
                        "source_sense_id": "bd03961c-da3a-3c07-801b-56b123b52b69",
                        "target_lang_word": "житель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "житель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                        "entry_id": "48058ecc-8620-3a80-8fdc-61f58a8f68c0",
                                        "glosses": [
                                            "представитель населения; тот, кто живёт где-либо, в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6093453-1613-49b6-8b67-86a6c6bd12df",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "[Платон Михайлович:] Как видишь, брат: // Московский житель и женат."
                                            },
                                            {
                                                "example_id": "b8563718-ed44-4c84-b82c-94c55cf554ca",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "— Ты не можешь представить себе, как для меня, деревенского жителя, всё это дико .."
                                            },
                                            {
                                                "example_id": "4b57b5cc-26f2-4119-8e0f-069a4bb0b28c",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "Городские жители начинали вспоминать о своих деревенских друзьях и родственниках и посещать их."
                                            },
                                            {
                                                "example_id": "bacf6630-448d-4ad0-b622-7f5d29d82700",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "Мне, жителю севера, ещё не доводилось бывать зимою в южной степи."
                                            },
                                            {
                                                "example_id": "3b553bd8-39c1-4f92-a583-9c5872a336cf",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "Жители Тифлиса покинули свои квартиры, захватив ценные вещи."
                                            },
                                            {
                                                "example_id": "8d3180ab-95aa-4174-83ba-2ff7eb98051a",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "Как у всех приморских жителей, у неё был запас раскладушек и постельного белья для немереных приезжих родственников."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9706ebd-a240-4870-b4e5-9a409665e44b",
                        "source_entry_id": "9ed75ece-53bd-38fb-8232-f22a68778cf6",
