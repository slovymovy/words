                        "entry_id": "e1ce3c9a-6859-3c0a-b379-f5757d2f9a57",
                        "glosses": [
                            "Plasticine; modelling clay."
                        ],
                        "tags": [
                            "Ireland",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c5bdd0cd-0a97-4499-a7dc-ba983006ba37",
                                "sense_id": "b918a888-eba9-3192-9d48-74063bc87f99",
                                "text": "Miss Carney handed us out blank paper and marla,\nold plasticine with the colours\nall rolled together into brown."
                            },
                            {
                                "example_id": "fa42258e-c9ac-40c1-a51b-56c394155152",
                                "sense_id": "b918a888-eba9-3192-9d48-74063bc87f99",
                                "text": "As she sits and plays with Damien, she feels her legs start to tremble from the effort. Her knees seem to disappear.\nPlasticine legs, she says to Damien. Old marla legs."
                            }
                        ]
                    }
