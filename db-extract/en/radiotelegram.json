                                "target_senses": [
                                    {
                                        "sense_id": "45e6fa1a-526f-34fa-9522-978918071bb9",
                                        "entry_id": "0838ef1b-18ef-38b6-99bf-6eae61cc87b3",
                                        "glosses": [
                                            "Dépêche par télégraphie sans fil."
                                        ],
                                        "tags": [
                                            "Histoire des télécommunications"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e64e3355-d52f-47e0-9f91-698cf1b03238",
                                                "sense_id": "45e6fa1a-526f-34fa-9522-978918071bb9",
                                                "text": "« Élaborons donc notre plan d’action : dès ma libération, je m’abouche avec le gardien-chef du sémaphore. Je suppose que vos dollars le convainquent. Il consent à envoyer le radiogramme. Je suppose encore que la princesse se rende à votre appel. »"
                                            },
                                            {
                                                "example_id": "b135e3ec-d4a5-48c9-9180-5836bd4eaaa2",
                                                "sense_id": "45e6fa1a-526f-34fa-9522-978918071bb9",
                                                "text": "Un radiogramme du « Gustav Holm » confirmait leurs dires en félicitant notre compagnon, fou de joie."
                                            },
                                            {
                                                "example_id": "b67e9a69-fcc2-4de3-b368-61f56aa8ad3c",
                                                "sense_id": "45e6fa1a-526f-34fa-9522-978918071bb9",
                                                "text": "- Rose, Rose, ici Tempête, j'attends la réponse à mon radiogramme … attends réponse … Passe à l'écoute, je passe à l'écoute."
                                            },
                                            {
                                                "example_id": "97bb6864-ac38-4753-8b5a-e8fac8b0c745",
                                                "sense_id": "45e6fa1a-526f-34fa-9522-978918071bb9",
                                                "text": "Peu de temps avant l’heure H, on diffusa le radiogramme suivant : « S. M. l’empereur et Hindenburg se sont rendus sur le théâtre des opérations »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae682ca-d3ce-3985-8656-a824eee85593",
                                        "entry_id": "0838ef1b-18ef-38b6-99bf-6eae61cc87b3",
                                        "glosses": [
                                            "Nom peu utilisé pour désigner l'image obtenue par la technique de radiographie aux rayons X. On dit généralement une radio ou une radiographie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a953065-42ed-4710-93e8-877167f4efbf",
                        "source_entry_id": "35e3ef5d-2c64-3f28-a4de-e80e59dc7aec",
                        "source_sense_id": "b235d318-a3dc-33d3-a9cc-40f7add08700",
                        "source_sense_description": "message, like a telegram, transmitted by wireless telegraphy",
                        "target_lang_word": "Funkspruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Funkspruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9efabd34-e4aa-328c-a63d-608ac831c976",
                                        "entry_id": "d960ebeb-0325-34fe-8803-2bc5f50190b0",
                                        "glosses": [
                                            "Nachricht, die über Funk weitergegeben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09876b46-d223-490d-962d-933c8577b15b",
                                                "sense_id": "9efabd34-e4aa-328c-a63d-608ac831c976",
                                                "text": "Der Notarzt wurde durch einen Funkspruch alarmiert."
                                            },
                                            {
                                                "example_id": "334b4e0b-7f8a-4d9b-be3f-07dbee63a04d",
                                                "sense_id": "9efabd34-e4aa-328c-a63d-608ac831c976",
                                                "text": "„In der linken Hand hält er den Funkspruch und mit der rechten setzt er den Stechzirkel auf.“"
                                            },
                                            {
                                                "example_id": "b0ebae38-0af1-476e-bfb9-903b754d2558",
                                                "sense_id": "9efabd34-e4aa-328c-a63d-608ac831c976",
                                                "text": "„Doch schon zwei weitere Tage später kam frühmorgens ein Funkspruch des Kommandanten Erich Topp von U 552 herein, man habe einen Geleitzug gesichtet, der sich mit einer Geschwindigkeit von zehn Knoten in Richtung Norden bewege.“"
                                            },
                                            {
                                                "example_id": "8314405b-e562-4ac6-8bf6-db9d4230fb7e",
                                                "sense_id": "9efabd34-e4aa-328c-a63d-608ac831c976",
                                                "text": "„Der verräterische Funker, der zwar nicht London, wohl aber die Deutschen verständigt hatte, nahm nun Funksprüche auf, die angeblich aus London, in Wahrheit aber von der Deutschen Abwehr Paris kamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
