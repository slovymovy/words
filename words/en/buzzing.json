                    "sense_id": "7ed4ae2c-c787-3f7d-a186-e30508628176",
                    "sense_definition": "Present participle and gerund of <w>buzz</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bees were <w>buzzing</w> around the flowers in the garden.",
