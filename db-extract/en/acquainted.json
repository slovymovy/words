                                            {
                                                "example_id": "4d451ece-3252-431d-9caf-158ec824d974",
                                                "sense_id": "e228a30b-c8c7-3a31-b83f-b106a92f59bf",
                                                "text": "Die straat komt me bekend voor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88bdbf1a-fcf8-36b1-9531-b992dd143212",
                                        "entry_id": "3fcdbb16-4c9e-3159-904a-afd318153865",
                                        "glosses": [
                                            "behorend tot de kennis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5956285-a622-4ec0-946b-04480ee864ca",
                                                "sense_id": "88bdbf1a-fcf8-36b1-9531-b992dd143212",
                                                "text": "Nu concludeert het gerechtshof dat het intrekken van het reeds gepubliceerde rapport onnodig is, omdat de inhoud ervan al bekend is."
                                            },
                                            {
                                                "example_id": "15a1cd8b-b9a9-4bdc-add1-8f9fe7a0455e",
                                                "sense_id": "88bdbf1a-fcf8-36b1-9531-b992dd143212",
                                                "text": "Eerder werd al bekend dat verdachte Tetsuya Yamagami wrok tegen Abe koesterde, omdat de politicus volgens hem verbonden was aan een religieuze groep. Het is niet duidelijk waarom de 41-jarige man uiteindelijk Abe als slachtoffer koos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e64c999-035d-3139-b768-9dca70fecdf3",
                                        "entry_id": "3fcdbb16-4c9e-3159-904a-afd318153865",
                                        "glosses": [
                                            "beroemd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ca3583-3a86-42b2-9bfe-1510cbf0c992",
                                                "sense_id": "4e64c999-035d-3139-b768-9dca70fecdf3",
                                                "text": "De bekende voetballer wordt door iedereen herkend."
                                            },
                                            {
                                                "example_id": "b7d7deaa-f290-4769-9e96-c5a5c4baa9fb",
                                                "sense_id": "4e64c999-035d-3139-b768-9dca70fecdf3",
                                                "text": "\"Een zwarte dag voor de horeca\", zegt chef-kok Rik van de Laar over het overlijden van Boer. Hij begon op 16-jarige leeftijd in De Librije, het eerste en bekendste restaurant van Boer, werkte er zeven jaar en runt inmiddels twee restaurants in Den Haag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e408e6b-91e8-3590-9ca1-ad7421c0402d",
                                        "entry_id": "3fcdbb16-4c9e-3159-904a-afd318153865",
                                        "glosses": [
                                            "genoemd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "257182d5-0cde-4b74-a74e-f4b8cf3a2298",
                                                "sense_id": "0e408e6b-91e8-3590-9ca1-ad7421c0402d",
                                                "text": "Met een ibuprofen – ook wel bekend als ‘vitamine-i’ – tegen mijn rusteloze benen viel ik bijna in slaap toen ik rechtovereind schrok door geritsel recht onder mijn hoofd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
