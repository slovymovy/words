{
    "word_family": [
        "ashamed",
        "shameful",
        "shameless",
        "shamefully",
        "shamelessly",
        "shamefulness",
        "shamelessness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "169ad37c-49e1-3344-8338-140061ccf3b9",
                    "sense_definition": "Something to regret; a cause for disappointment or sadness.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "regret_pity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>shame</w> that you cannot come to the party with us.",
                            "target_lang_translations": {
                                "ru": "Как <w>жаль</w>, что ты не можешь пойти с нами на вечеринку.",
                                "de": "Es ist <w>schade</w>, dass du nicht mit uns zur Party kommen kannst.",
                                "zh": "你不能和我们一起去参加派对，真是太<w>可惜</w>了。"
                            }
                        },
                        {
                            "text": "What a <w>shame</w> to waste so much good food.",
                            "target_lang_translations": {
                                "ru": "Как <w>жаль</w> выбрасывать столько хорошей еды.",
                                "de": "Was für eine <w>Schande</w>, so viel gutes Essen zu verschwenden.",
                                "zh": "浪费这么多好食物真是太<w>可惜</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pity",
                        "misfortune"
                    ],
                    "common_phrases": [
                        "what a shame",
                        "it is a shame",
                        "crying shame",
                        "real shame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, вызывающее сожаление или разочарование; досадная ситуация.",
                        "de": "Etwas, das Bedauern oder Enttäuschung hervorruft; eine bedauerliche Situation.",
                        "zh": "指令人感到遗憾或失望的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаль",
                                "target_lang_sense_clarification": "выражение сожаления"
                            },
                            {
                                "target_lang_word": "обидно",
                                "target_lang_sense_clarification": "чувство огорчения из-за неудачи"
                            },
                            {
                                "target_lang_word": "досада",
                                "target_lang_sense_clarification": "чувство раздражения и сожаления"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schade",
                                "target_lang_sense_clarification": "Ausdruck des Bedauerns"
                            },
                            {
                                "target_lang_word": "Jammer",
                                "target_lang_sense_clarification": "bedauerlicher Umstand"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可惜",
                                "target_lang_sense_clarification": "表示遗憾"
                            },
                            {
                                "target_lang_word": "遗憾",
                                "target_lang_sense_clarification": "表示对某事感到不圆满"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b42d786-952f-33bf-89bb-941895900c67",
                    "sense_definition": "An uncomfortable or painful feeling of guilt, embarrassment, or disgrace caused by the consciousness of one's own wrong behavior or foolishness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "feeling_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt deep <w>shame</w> for lying to his parents about his grades.",
                            "target_lang_translations": {
                                "ru": "Он испытывал глубокий <w>стыд</w> за то, что солгал родителям об оценках.",
                                "de": "Er empfand tiefe <w>Scham</w> dafür, seine Eltern bezüglich seiner Noten belogen zu haben.",
                                "zh": "他因为对父母撒谎隐瞒成绩而感到深深的<w>羞愧</w>。"
                            }
                        },
                        {
                            "text": "She hung her head in <w>shame</w> after realizing her mistake.",
                            "target_lang_translations": {
                                "ru": "Она опустила голову от <w>стыда</w>, осознав свою ошибку.",
                                "de": "Sie ließ vor <w>Scham</w> den Kopf hängen, nachdem sie ihren Fehler erkannt hatte.",
                                "zh": "意识到自己的错误后，她<w>羞愧</w>地低下了头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "embarrassment",
                        "guilt",
                        "remorse",
                        "humiliation",
                        "mortification",
                        "disgrace",
                        "dishonor"
                    ],
                    "antonyms": [
                        "honor",
                        "exaltation"
                    ],
                    "common_phrases": [
                        "feel shame",
                        "hang head in shame",
                        "burn with shame",
                        "overcome with shame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Болезненное чувство вины, смущения или позора из-за осознания собственного неправильного поведения.",
                        "de": "Ein unangenehmes oder schmerzhaftes Gefühl von Schuld, Verlegenheit oder Schande aufgrund des Bewusstseins eigenen Fehlverhaltens.",
                        "zh": "因意识到自己的错误行为或愚蠢而产生的羞愧、尴尬或丢脸的痛苦感受。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стыд",
                                "target_lang_sense_clarification": "чувство вины или смущения"
                            },
                            {
                                "target_lang_word": "срам",
                                "target_lang_sense_clarification": "сильный стыд или позор (разговорное)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Scham",
                                "target_lang_sense_clarification": "Gefühl der Schuld oder Verlegenheit"
                            },
                            {
                                "target_lang_word": "Schande",
                                "target_lang_sense_clarification": "Gefühl des Ehrverlusts"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "羞耻",
                                "target_lang_sense_clarification": "因做错事而感到羞愧"
                            },
                            {
                                "target_lang_word": "羞愧",
                                "target_lang_sense_clarification": "感到惭愧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9965c45-b7d9-3a5d-8677-5667eca2ec4c",
                    "sense_definition": "The capacity to be ashamed, acting as a restraint against improper behavior; a sense of decency.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feeling_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have you no <w>shame</w> to speak to your mother like that?",
                            "target_lang_translations": {
                                "ru": "У тебя совсем нет <w>стыда</w>, раз ты так разговариваешь с матерью?",
                                "de": "Hast du denn gar kein <w>Schamgefühl</w>, so mit deiner Mutter zu sprechen?",
                                "zh": "你这样跟妈妈说话，难道一点<w>廉耻</w>都没有吗？"
                            }
                        },
                        {
                            "text": "He has absolutely no sense of <w>shame</w> regarding his rude behavior.",
                            "target_lang_translations": {
                                "ru": "У него нет ни капли <w>стыда</w> за свое грубое поведение.",
                                "de": "Er hat absolut kein <w>Schamgefühl</w> bezüglich seines unhöflichen Verhaltens.",
                                "zh": "对于自己的粗鲁行为，他完全没有一点<w>羞耻心</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decency",
                        "modesty"
                    ],
                    "common_phrases": [
                        "have no shame",
                        "sense of shame",
                        "lost all shame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность испытывать стыд, удерживающая от недостойного поведения; чувство приличия.",
                        "de": "Die Fähigkeit, sich zu schämen, die als Hemmschwelle gegen unangemessenes Verhalten dient; ein Gefühl für Anstand.",
                        "zh": "指一个人具备的道德约束力，即知廉耻、懂礼节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стыд",
                                "target_lang_sense_clarification": "чувство моральной ответственности"
                            },
                            {
                                "target_lang_word": "совесть",
                                "target_lang_sense_clarification": "внутреннее чувство нравственности"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schamgefühl",
                                "target_lang_sense_clarification": "moralisches Empfinden"
                            },
                            {
                                "target_lang_word": "Anstand",
                                "target_lang_sense_clarification": "Sinn für moralisches Verhalten"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "廉耻",
                                "target_lang_sense_clarification": "指对羞耻的感知能力"
                            },
                            {
                                "target_lang_word": "羞耻心",
                                "target_lang_sense_clarification": "道德上的自我约束感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f81d8e37-b04f-3fe5-8f9a-792d04555446",
                    "sense_definition": "A state of dishonor, disgrace, or loss of reputation incurred by wrong or foolish actions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disgrace_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His criminal actions brought <w>shame</w> upon his entire family.",
                            "target_lang_translations": {
                                "ru": "Его преступные действия навлекли <w>позор</w> на всю его семью.",
                                "de": "Seine kriminellen Handlungen brachten <w>Schande</w> über seine ganze Familie.",
                                "zh": "他的犯罪行为给全家带来了<w>耻辱</w>。"
                            }
                        },
                        {
                            "text": "There is no <w>shame</w> in admitting that you need help.",
                            "target_lang_translations": {
                                "ru": "Нет ничего <w>постыдного</w> в том, чтобы признать, что тебе нужна помощь.",
                                "de": "Es ist keine <w>Schande</w>, zuzugeben, dass man Hilfe braucht.",
                                "zh": "承认自己需要帮助并不是什么<w>丢脸</w>的事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disgrace",
                        "dishonor",
                        "ignominy",
                        "infamy"
                    ],
                    "antonyms": [
                        "honor",
                        "exaltation"
                    ],
                    "common_phrases": [
                        "bring shame on",
                        "live in shame",
                        "cover in shame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние бесчестья, позора или потери репутации из-за неправильных действий.",
                        "de": "Ein Zustand der Ehrlosigkeit, Schande oder des Ansehensverlusts durch falsches Handeln.",
                        "zh": "因错误或愚蠢的行为而导致的名誉扫地或丢脸的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позор",
                                "target_lang_sense_clarification": "бесчестье, потеря репутации"
                            },
                            {
                                "target_lang_word": "бесчестье",
                                "target_lang_sense_clarification": "утрата чести и достоинства"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schande",
                                "target_lang_sense_clarification": "Verlust des Ansehens"
                            },
                            {
                                "target_lang_word": "Blamage",
                                "target_lang_sense_clarification": "peinlicher Vorfall, der das Ansehen schädigt"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耻辱",
                                "target_lang_sense_clarification": "丢脸、不光彩"
                            },
                            {
                                "target_lang_word": "丢脸",
                                "target_lang_sense_clarification": "失去面子或名誉"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "514885c3-4588-3fd2-9362-b72416255b50",
                    "sense_definition": "To cause someone to feel ashamed, humiliated, or embarrassed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>shamed</w> the student in front of the whole class for forgetting his homework.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>пристыдил</w> ученика перед всем классом за то, что тот забыл домашнее задание.",
                                "de": "Der Lehrer <w>beschämte</w> den Schüler vor der ganzen Klasse, weil er seine Hausaufgaben vergessen hatte.",
                                "zh": "老师因为学生忘记带作业，当着全班同学的面<w>羞辱</w>了他。"
                            }
                        },
                        {
                            "text": "He was <w>shamed</w> by the public revelation of his secrets.",
                            "target_lang_translations": {
                                "ru": "Он был <w>опозорен</w> публичным раскрытием его секретов.",
                                "de": "Er wurde durch die öffentliche Enthüllung seiner Geheimnisse <w>bloßgestellt</w>.",
                                "zh": "他的秘密被公开揭露，使他感到十分<w>丢脸</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "humiliate",
                        "embarrass",
                        "mortify",
                        "abash"
                    ],
                    "antonyms": [
                        "honor",
                        "dignify"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то чувствовать стыд, унижение или смущение.",
                        "de": "Jemanden dazu bringen, sich zu schämen, sich gedemütigt oder verlegen zu fühlen.",
                        "zh": "使某人感到羞愧、丢脸或尴尬。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пристыдить",
                                "target_lang_sense_clarification": "заставить устыдиться (совершенный вид)"
                            },
                            {
                                "target_lang_word": "позорить",
                                "target_lang_sense_clarification": "навлекать позор, унижать"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beschämen",
                                "target_lang_sense_clarification": "Scham in jemandem hervorrufen"
                            },
                            {
                                "target_lang_word": "bloßstellen",
                                "target_lang_sense_clarification": "öffentlich demütigen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……蒙羞",
                                "target_lang_sense_clarification": "让某人感到丢脸"
                            },
                            {
                                "target_lang_word": "羞辱",
                                "target_lang_sense_clarification": "使人受辱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01a8e6da-8f2b-33bd-b830-2b85cc7d483f",
                    "sense_definition": "To criticize or denounce someone publicly with the intent of causing them to feel ashamed, often for specific behaviors or characteristics.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "criticize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "People should stop <w>shaming</w> others on social media for their appearance.",
                            "target_lang_translations": {
                                "ru": "Людям следует перестать <w>стыдить</w> других в социальных сетях за их внешность.",
                                "de": "Menschen sollten aufhören, andere in sozialen Medien für ihr Aussehen zu <w>beschämen</w>.",
                                "zh": "人们应该停止在社交媒体上因为外貌而<w>羞辱</w>他人。"
                            }
                        },
                        {
                            "text": "The campaign aims to stop <w>shaming</w> mothers for breastfeeding in public.",
                            "target_lang_translations": {
                                "ru": "Кампания направлена на то, чтобы перестать <w>стыдить</w> матерей за кормление грудью в общественных местах.",
                                "de": "Die Kampagne zielt darauf ab, Mütter nicht mehr für das Stillen in der Öffentlichkeit zu <w>beschämen</w>.",
                                "zh": "这项运动旨在停止对在公共场合哺乳的母亲进行<w>羞辱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "criticize",
                        "denounce"
                    ],
                    "common_phrases": [
                        "body shame",
                        "publicly shame",
                        "online shaming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публично критиковать или осуждать кого-то с целью вызвать чувство стыда.",
                        "de": "Jemanden öffentlich kritisieren oder anprangern, um Schamgefühle zu erzeugen.",
                        "zh": "公开批评或谴责某人，意图使其感到羞愧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стыдить",
                                "target_lang_sense_clarification": "укорять, вызывать стыд"
                            },
                            {
                                "target_lang_word": "позорить",
                                "target_lang_sense_clarification": "выставлять в дурном свете публично"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "anprangern",
                                "target_lang_sense_clarification": "öffentlich bloßstellen"
                            },
                            {
                                "target_lang_word": "beschämen",
                                "target_lang_sense_clarification": "durch Kritik in Verlegenheit bringen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "羞辱",
                                "target_lang_sense_clarification": "公开批评以使人难堪"
                            },
                            {
                                "target_lang_word": "谴责",
                                "target_lang_sense_clarification": "公开指责"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe9af164-5a59-34a5-bff0-77e95bf1f3c4",
                    "sense_definition": "To force or compel someone to do something by making them feel ashamed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "compel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician was <w>shamed</w> into resigning after the scandal broke.",
                            "target_lang_translations": {
                                "ru": "Политика <w>пристыдили</w>, вынудив уйти в отставку после того, как разразился скандал.",
                                "de": "Der Politiker wurde nach Bekanntwerden des Skandals dazu <w>beschämt</w>, zurückzutreten.",
                                "zh": "丑闻曝光后，这位政客在舆论压力下感到<w>羞愧</w>，被迫辞职。"
                            }
                        },
                        {
                            "text": "They <w>shamed</w> him into donating money to the charity.",
                            "target_lang_translations": {
                                "ru": "Они <w>пристыдили</w> его, заставив пожертвовать деньги на благотворительность.",
                                "de": "Sie <w>beschämten</w> ihn so sehr, dass er Geld für den wohltätigen Zweck spendete.",
                                "zh": "他们通过舆论压力<w>逼迫</w>他向慈善机构捐款。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shame into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить или вынудить кого-то сделать что-то, вызвав у него чувство стыда.",
                        "de": "Jemanden durch das Erzeugen von Schamgefühlen zu einer Handlung zwingen.",
                        "zh": "通过使某人感到羞愧来强迫或逼迫其做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пристыдить",
                                "target_lang_sense_clarification": "побудить к действию через чувство стыда"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "dazu bringen",
                                "target_lang_sense_clarification": "durch Druck zu einer Handlung bewegen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逼迫",
                                "target_lang_sense_clarification": "通过压力强迫"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "cd0f92a2-a23f-3d4c-9886-4c15be651e4f",
                    "sense_definition": "Used to express disapproval or admonition for someone's actions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Shame</w> on you for speaking to your grandmother so rudely!",
                            "target_lang_translations": {
                                "ru": "<w>Позор</w> тебе за то, что ты так грубо разговариваешь с бабушкой!",
                                "de": "<w>Schande</w> über dich, dass du so unhöflich mit deiner Großmutter sprichst!",
                                "zh": "你对奶奶说话这么粗鲁，真是<w>不知羞耻</w>！"
                            }
                        },
                        {
                            "text": "You cheated on the test? <w>Shame</w>!",
                            "target_lang_translations": {
                                "ru": "Ты списал на тесте? <w>Позор</w>!",
                                "de": "Du hast beim Test geschummelt? <w>Schande</w>!",
                                "zh": "你考试作弊？真<w>丢脸</w>！"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shame on you"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения неодобрения или укора за чьи-то действия.",
