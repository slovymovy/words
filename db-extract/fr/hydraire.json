                        "examples": [
                            {
                                "example_id": "533dd1c8-b580-4b19-b7be-d8d4b4422c0e",
                                "sense_id": "677f6631-4f21-3c13-9594-e0dd6250563b",
                                "text": "Un hydraire génère ainsi par bourgeonnement de nombreuses méduses libres, mâles et femelles, qui redémarrent le même cycle de reproduction."
                            },
                            {
                                "example_id": "0382e6db-addd-46df-8fad-b0131aaa9b0f",
                                "sense_id": "677f6631-4f21-3c13-9594-e0dd6250563b",
                                "text": "Je descends le long de la coque, dont l’acier est déchiqueté, tordu par les explosions – mais orné d’hydraires jaune d'or, de bryozoaires de dentelle rose, d’algues incrustantes rouges ou mauves."
                            }
                        ]
                    }
