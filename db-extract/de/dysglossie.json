                ],
                "senses": [
                    {
                        "sense_id": "90587581-5acc-3d4a-a410-7c0a53fcfa96",
                        "entry_id": "ed41121c-5da8-30a1-8eb5-2c0ad9d8b899",
                        "glosses": [
                            "Sprachstörung, die durch eine Fehlbildung oder Erkrankung der Sprechorgane (Zunge, Lippe, Gaumen, Zähne) verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d005516f-7334-49aa-9a29-bed9bbdc529f",
                                "sense_id": "90587581-5acc-3d4a-a410-7c0a53fcfa96",
                                "text": "„Eine palatale Dysglossie geht mit einem Näseln einher. Ätiologie. Die häufigsten Ursachen für Dysglossien im Kindesalter sind Fehlbildungen (u. a. Lippen-Kiefer-Gaumenspalten) und Unfallfolgen.“"
                            },
                            {
                                "example_id": "46c9ede2-63a1-4097-9ca8-a03b44b9aee9",
                                "sense_id": "90587581-5acc-3d4a-a410-7c0a53fcfa96",
                                "text": "„Solche Kombinationen umfassen etwa: dentale Dysglossie wegen Kieferbruch; linguale Dysglossie nach Verletzung oder peripherer Lähmung der Zunge; zentrale Dysarthrie wegen supranukleärer Läsion mehrer Hirnnerven; und dysphasische Ausfälle infolge einer Schädigung des Großhirns auf der dominanten Seite.“"
                            },
                            {
                                "example_id": "08d30e11-a4ab-4813-8896-7f868023c1df",
                                "sense_id": "90587581-5acc-3d4a-a410-7c0a53fcfa96",
                                "text": "„Im logopädischen Sinn ist eine Dysglossie eine oft mit einer Schluckstörung verbundene Artikulatiensstörung (evtl. verbunden mit einer Phonetionsstörung), die durch organische Veränderungen im Bereich der Zunge, aber auch des Kiefers, der Zähne sowie der Lippen, des harten und weichen Gaumens, evtl. des Kehlkopfs, hervorgerufen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
