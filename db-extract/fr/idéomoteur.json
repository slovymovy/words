                "senses": [
                    {
                        "sense_id": "89703fd0-f8a4-39b5-954c-b1e3aae9a7c9",
                        "entry_id": "a355eff4-bd96-3a78-b9fc-f40e891a1f33",
                        "glosses": [
                            "Qui se produit de manière inconsciente (par exemple sous l’effet de l’hypnose ou de l’autosuggestion), en parlant d’un mouvement corporel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245a1650-a517-47af-aba9-8f7f237a79f6",
                                "sense_id": "89703fd0-f8a4-39b5-954c-b1e3aae9a7c9",
                                "text": "Les changements musculaires sont la catalepsie et les mouvements idéomoteurs. Un mouvement est dit idéomoteur s’il a lieu sans qu'il y ait une décision consciente de l'amorcer."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc3b4394-0982-3cc6-b67a-eecca395bb43",
                        "entry_id": "a355eff4-bd96-3a78-b9fc-f40e891a1f33",
                        "glosses": [
                            "Relatif à la production inconsciente de mouvements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8d0359c-ba53-4637-88c6-7634fefa28b6",
                                "sense_id": "fc3b4394-0982-3cc6-b67a-eecca395bb43",
                                "text": "Le pendule bouge-t-il ? Si non, regardez le plus fixement parce qu'il se pourrait bien qu'il bouge en fin de compte. La raison n’est pas magique du tout. Ce qui se passe est un effet idéomoteur, qui est un mouvement inconscient dirigé indirectement par votre espérance de le voir bouger plutôt que par une activité musculaire consciente."
                            }
                        ]
                    },
                    {
                        "sense_id": "03a0bfc8-9f06-35c8-b2f7-47a5c6af40ea",
                        "entry_id": "a355eff4-bd96-3a78-b9fc-f40e891a1f33",
                        "glosses": [
                            "Synonyme de psychomoteur (« qui concerne à la fois les fonctions physiques et psychiques »)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5543af84-3f2f-4663-8d2c-89a4051ca6a9",
                                "sense_id": "03a0bfc8-9f06-35c8-b2f7-47a5c6af40ea",
                                "text": "Le ralentissement idéomoteur des personnes âgées."
                            }
                        ]
                    }
