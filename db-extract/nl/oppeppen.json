                "senses": [
                    {
                        "sense_id": "6294a4fe-b1a9-319f-9aa7-5a1d778d389b",
                        "entry_id": "874e4352-45af-39d1-88b6-1318dd383806",
                        "glosses": [
                            "to cheer up, to invigorate, to give someone more energy, motivation, or encouragement"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d97b3ccd-8515-4bf2-a227-d5a8806ddad9",
                                "sense_id": "6294a4fe-b1a9-319f-9aa7-5a1d778d389b",
                                "text": "Hij voelde zich moe, dus dronk hij koffie om zich wat op te peppen.",
                                "translation": "He felt tired, so he drank coffee to pep himself up a bit.",
                                "english": "He felt tired, so he drank coffee to pep himself up a bit."
                            }
                        ]
                    },
                    {
                        "sense_id": "756a191c-9b0a-30e7-92a4-54817120f65d",
                        "entry_id": "874e4352-45af-39d1-88b6-1318dd383806",
                        "glosses": [
                            "to boost or enhance the appearance or quality of something"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85ffed21-a971-4cd0-8aae-cf100a60369a",
                                "sense_id": "756a191c-9b0a-30e7-92a4-54817120f65d",
                                "text": "Ze pepten hun presentatie op met een paar leuke afbeeldingen.",
                                "translation": "They livened up their presentation with some fun images.",
                                "english": "They livened up their presentation with some fun images."
                            }
                        ]
                    }
