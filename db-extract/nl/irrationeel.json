                "senses": [
                    {
                        "sense_id": "e0e47952-6474-3432-9f7a-189574995f2f",
                        "entry_id": "f07f3183-3684-3deb-978e-8a8a7f19a91f",
                        "glosses": [
                            "niet volgens logisch nadenken, zonder het gebruik van je verstand, strijdig met de rede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0f8fd18-527e-4fff-90fd-b7170960e0d0",
                                "sense_id": "e0e47952-6474-3432-9f7a-189574995f2f",
                                "text": "Woede eist vergelding. Dit kan op twee manieren, die beide volgens Nussbaum verwerpelijk zijn. Ofwel de vergelding heeft tot doel de oude situatie te herstellen, maar dat is onmogelijk en dus irrationeel. Ofwel de vergelding is erop gericht het slachtoffer te vernederen en zodoende dus immoreel."
                            },
                            {
                                "example_id": "b307e65b-a4c8-4e53-9133-ac6fc678ef0e",
                                "sense_id": "e0e47952-6474-3432-9f7a-189574995f2f",
                                "text": "Ze pruilt, barst uit in irrationele woede, of huilt geluidloos."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2f49532-2d9c-3f99-b1fb-9ef38ab538fb",
                        "entry_id": "f07f3183-3684-3deb-978e-8a8a7f19a91f",
                        "glosses": [
                            "van getallen dat ze niet op te schrijven zijn als een breuk van gehele getallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dfa82f0-b6b4-4722-aa43-4be38d1bebaa",
                                "sense_id": "b2f49532-2d9c-3f99-b1fb-9ef38ab538fb",
                                "text": "De wortel van 2 is een irrationeel getal."
                            }
                        ]
                    }
