                ],
                "senses": [
                    {
                        "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                        "entry_id": "a3064c6c-624b-3bba-be8f-947a2571700f",
                        "glosses": [
                            "Gesetz, das die Einwanderung in eine Land regelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a050a99-b9a9-4c0d-b43a-cb206e6856c5",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„Nicht nur der langjährige Innenminister und CSU-Politiker Friedrich Zimmermann stand für eine extrem restriktive Ausländerpolitik. Erst im neuen Jahrtausend brachte Deutschland ein halbwegs modernes Zuwanderungsgesetz auf den Weg.“"
                            },
                            {
                                "example_id": "731e8e8e-3ce6-45e2-864e-89a6ab4262d2",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„1.7.2004: Nach jahrelangen Kontroversen über das neue Zuwanderungsgesetz billigt der Bundestag den von Regierung und Opposition im Vermittlungsausschuss ausgehandelten Kompromiss.“"
                            },
                            {
                                "example_id": "ad6e054c-feb1-4253-bc1e-4884dfb1d4ee",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„Deutschland nimmt im Prinzip Flüchtlinge aus humanitären Gründen auf. Es folgt dabei der Genfer Flüchtlingskonvention, EU-Richtlinien und dem Zuwanderungsgesetz.“"
                            },
                            {
                                "example_id": "1d8bb4f4-7442-40b1-a9b9-b1fe121b1e70",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„Am 28. August 2007 wurde das Zuwanderungsgesetz reformiert.“"
                            },
                            {
                                "example_id": "e0af6d57-0263-4b13-8c10-648f70be815b",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„Liebing, der auch Bundestagsabgeordneter für den Kreis Nordfriesland ist, zeigte sich überzeugt, auch die CSU für ein Zuwanderungsgesetz gewinnen zu können: »Das alles ist ein Prozess von Diskussionen. […]«“"
                            },
                            {
                                "example_id": "b7d075f7-6220-4f37-b34c-124d26062541",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„Das Kabinett hat Eckpunkte für ein Zuwanderungsgesetz für Fachkräfte beschlossen.“"
                            },
                            {
                                "example_id": "5ef0842d-9524-4399-b5bf-0af44191aadb",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„Grundsätzlich setzt der Gesetzentwurf das um, was die zuständigen Ministerien schon Anfang Oktober in den Eckpunkten fürs Zuwanderungsgesetz vereinbart haben: Fachkräfte aus aller Welt sollen künftig in Deutschland in allen Berufen arbeiten dürfen, wenn sie einen Arbeitsvertrag und eine anerkannte Qualifikation haben. […]“"
                            },
                            {
                                "example_id": "e6b3bef7-6e51-4afc-a62b-27ceedd8c637",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„Das neue Zuwanderungsgesetz, wenn es denn kommt, erlaubt Jobsuchenden aus Nicht-EU-Ländern mit gefragten Qualifikationen, für ein halbes Jahr nach Deutschland zu gehen und sich hier eine Arbeit zu suchen.“"
                            },
                            {
                                "example_id": "de36a27c-8795-4adb-b2ca-1713c7caa797",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„Das Zuwanderungsgesetz erkennt an, dass Deutschland Einwanderungsland ist […].“"
                            },
                            {
                                "example_id": "962a823c-6309-4417-a97a-6ba444fd4848",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„US-Präsident Donald Trump hat mit Plänen für eine weitere Verschärfung der Zuwanderungsgesetze eine Niederlage vor Gericht erlitten.“"
                            },
                            {
                                "example_id": "4c840dd7-f485-43ec-a539-189766018d6f",
                                "sense_id": "c49f7f3b-199f-3501-87ed-92e33c5d6d76",
                                "text": "„[…] wenn eine Richterin in Los Angeles ihn im November 2019 nicht gestoppt hätte, hätte Trump die Zuwanderungsgesetze und Strafen für illegale Einwanderer noch weiter verschärft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
