                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mature",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fedfc4ca-135a-37bd-9cab-87246de3118b",
                                        "entry_id": "528b13c2-26f0-32a4-9d9c-2d78adbef9f8",
                                        "glosses": [
                                            "Fully developed; grown up in terms of physical appearance, behaviour or thinking; ripe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a980dd3-9de4-4a3a-ad13-d7a145cba3e4",
                                                "sense_id": "fedfc4ca-135a-37bd-9cab-87246de3118b",
                                                "text": "She is quite mature for her age."
                                            },
                                            {
                                                "example_id": "5e818925-002c-45db-9571-4d21e02fc81f",
                                                "sense_id": "fedfc4ca-135a-37bd-9cab-87246de3118b",
                                                "text": "The excellent mature eggplants grown in the garden plot are quickly being picked up by family and friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "740cf768-30ec-3734-ae19-900a2652ad35",
                                        "entry_id": "528b13c2-26f0-32a4-9d9c-2d78adbef9f8",
                                        "glosses": [
                                            "Brought to a state of complete readiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0fd5de-c9ae-4c2a-a53c-54177cc55a16",
                                                "sense_id": "740cf768-30ec-3734-ae19-900a2652ad35",
                                                "text": "a mature plan"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67b69f6a-df28-3d24-978f-e0cf9c76cd20",
                                        "entry_id": "528b13c2-26f0-32a4-9d9c-2d78adbef9f8",
                                        "glosses": [
                                            "Profound; careful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e9b8834-a15f-4451-952a-18b3400a4ebc",
                                                "sense_id": "67b69f6a-df28-3d24-978f-e0cf9c76cd20",
                                                "text": "The headmaster decided to expel the boy after a mature consideration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b1dc20e-211c-3a47-bad5-1b54525d1090",
                                        "entry_id": "528b13c2-26f0-32a4-9d9c-2d78adbef9f8",
                                        "glosses": [
                                            "Come to, or in a state of, completed suppuration."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67501972-7195-39b0-b5c4-c1780c484a37",
                                        "entry_id": "528b13c2-26f0-32a4-9d9c-2d78adbef9f8",
                                        "glosses": [
                                            "Suitable for adults only, due to sexual themes, violence, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfa0c27a-64bd-4a96-b153-ef80a41756c7",
                                                "sense_id": "67501972-7195-39b0-b5c4-c1780c484a37",
                                                "text": "mature content"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mature",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c16f92a9-201c-38e4-9040-36afd71ec193",
                                        "entry_id": "c51a73e2-0c3a-3f16-a765-790c69f255c7",
                                        "glosses": [
                                            "To proceed toward maturity: full development or completion (either of concrete or of abstract things, e.g. plans, judgments, qualities)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc790354-10b7-481f-a0e4-b3dff83e0446",
                                                "sense_id": "c16f92a9-201c-38e4-9040-36afd71ec193",
                                                "text": "[…] his originality, in the mean time, was maturing to perfection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44cde552-547d-3732-91cc-c45a2951ae97",
                                        "entry_id": "c51a73e2-0c3a-3f16-a765-790c69f255c7",
                                        "glosses": [
                                            "To attain maturity, to become mature or ripe."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cadfd45-34ef-45f2-bfd9-a68357e10a0f",
                                                "sense_id": "44cde552-547d-3732-91cc-c45a2951ae97",
                                                "text": "[…] Trees […] have alwayes Fruit upon them, ripe, or preparing to mature;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0a43520-c92a-3e8a-abfa-1ecc1c79cf0e",
                                        "entry_id": "c51a73e2-0c3a-3f16-a765-790c69f255c7",
                                        "glosses": [
                                            "To bring (something) to maturity, full development, or completion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff76d21c-844b-4fba-8c06-6498ef249ab3",
                                                "sense_id": "b0a43520-c92a-3e8a-abfa-1ecc1c79cf0e",
                                                "text": "[…] I did not interrupt her, I was so busy maturing a plan I had had in my mind for some days […]"
                                            },
                                            {
                                                "example_id": "5aac80d5-f027-4cff-8741-542d77989164",
                                                "sense_id": "b0a43520-c92a-3e8a-abfa-1ecc1c79cf0e",
                                                "text": "[…] But these thoughts\nFull Counsel must mature:"
                                            },
                                            {
                                                "example_id": "a3cdfef6-5e6c-47bc-8860-dc6c1f681b3a",
                                                "sense_id": "b0a43520-c92a-3e8a-abfa-1ecc1c79cf0e",
                                                "text": "[…] much it now\nImports they should be still deceiv’d, till time\nMatures our enterprize;"
                                            },
                                            {
                                                "example_id": "4669fc2a-9614-4d78-9565-033090ddc358",
                                                "sense_id": "b0a43520-c92a-3e8a-abfa-1ecc1c79cf0e",
                                                "text": "[…] the long clean groove of her upper lip was ready to go into motion, as if she were going to break her silence with something momentous and long-matured; explain love to me, perhaps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2505aa-b8e0-35ec-ba7e-fd7b1f7278dd",
                                        "entry_id": "c51a73e2-0c3a-3f16-a765-790c69f255c7",
                                        "glosses": [
                                            "To make (something, e.g. fruit) ripe or mature."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0746c5a-b6f5-40be-8bb9-8a07752c587c",
                                                "sense_id": "ab2505aa-b8e0-35ec-ba7e-fd7b1f7278dd",
                                                "text": "[…] a ship well freighted with the stores\nThe sun matures on India’s spicy shores,"
                                            },
                                            {
                                                "example_id": "9e80e258-5090-4caf-b880-9f706b92d66a",
                                                "sense_id": "ab2505aa-b8e0-35ec-ba7e-fd7b1f7278dd",
                                                "text": "There are certain vegetables like the tomato which require a long period to mature the fruit, and these must be started several weeks before the frosts have passed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "913256e5-18e7-382a-bd69-0fee922cbe75",
                                        "entry_id": "c51a73e2-0c3a-3f16-a765-790c69f255c7",
                                        "glosses": [
                                            "To proceed toward or become mature or full-grown, either physically or psychologically; to gain experience or wisdom with age."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "299fb6fe-035a-371d-80e5-15d00716dfc2",
                                        "entry_id": "c51a73e2-0c3a-3f16-a765-790c69f255c7",
                                        "glosses": [
                                            "To make (someone) mature."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "348d66a7-94ec-4b6f-8313-8e436ce9ddfa",
                                                "sense_id": "299fb6fe-035a-371d-80e5-15d00716dfc2",
                                                "text": "Then Tom shall have his kite, and Fan new dollies,\nTill time matures them for important follies."
                                            },
                                            {
                                                "example_id": "fd52e2f1-e8af-42e1-936a-f58d6b14e82c",
                                                "sense_id": "299fb6fe-035a-371d-80e5-15d00716dfc2",
                                                "text": "[…] what I most wanted was time to grow up. The war had not matured me;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20b55115-3bd2-314b-a57c-33552a08c92c",
                                        "entry_id": "c51a73e2-0c3a-3f16-a765-790c69f255c7",
                                        "glosses": [
                                            "To reach the date when payment is due."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b3d14f-35d3-4c61-9dfb-a99993186701",
                                                "sense_id": "20b55115-3bd2-314b-a57c-33552a08c92c",
                                                "text": "When the bond matures, the full face value is payable to its bearer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
