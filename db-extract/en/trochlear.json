                        "glosses": [
                            "A trochlear muscle or nerve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d442dfe-8a69-4fef-8a73-675e8e2a582e",
                                "sense_id": "4823dc12-df71-30cc-87dd-497aeec68253",
                                "text": "The two trochlears decussate in the anterior medullary velum."
                            },
                            {
                                "example_id": "4ee61edb-f8ab-43fa-8bde-617d42fe8a21",
                                "sense_id": "4823dc12-df71-30cc-87dd-497aeec68253",
                                "text": "At 90° of flexion, the patella enters the condylar fossa, where the contact areas are on both the lateral and medial trochlears of the femur."
                            },
                            {
                                "example_id": "aafb0da6-b21b-4e56-a05b-8d077f7a1275",
                                "sense_id": "4823dc12-df71-30cc-87dd-497aeec68253",
                                "text": "Using three-dimensional printing, they replaced the native trochlear in four cadaveric knees with dysplastic trochlears and then subjected them to squat simulation, open chain extension, and a patella stability test."
                            }
                        ]
                    }
