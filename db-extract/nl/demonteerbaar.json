                        "translation_id": "79e23b73-083d-4fc4-89af-4058bd93a977",
                        "source_entry_id": "ba250b39-c9bc-3ce1-a714-db7f9818645c",
                        "source_sense_id": "fefb4123-4b89-3fa0-855a-2247788bb8db",
                        "source_sense_description": "uit elkaar te halen",
                        "target_lang_word": "demontierbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demontierbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be758536-dbf5-3e11-89f3-a55e61516794",
                                        "entry_id": "60250905-3b08-3e4c-b7f5-29452ff458b8",
                                        "glosses": [
                                            "so, dass es demontiert werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3beff087-e2a0-48af-b43e-5e3ac817409a",
                                                "sense_id": "be758536-dbf5-3e11-89f3-a55e61516794",
                                                "text": "„Als Sonderausstattung ist der Beifahrersitz mit wenigen Handgriffen demontierbar.“"
                                            },
                                            {
                                                "example_id": "04594b49-d597-48be-9184-61de5e986609",
                                                "sense_id": "be758536-dbf5-3e11-89f3-a55e61516794",
                                                "text": "„Bei Bedarf einfach montierbar und demontierbar durch Einhängen in die Gabeln.“"
                                            },
                                            {
                                                "example_id": "a8dc0c06-aa1b-45be-b7dc-fbcc7ed70843",
                                                "sense_id": "be758536-dbf5-3e11-89f3-a55e61516794",
                                                "text": "„Für den einfachen Transport demontierbar, leicht bauende Traverse für räumliche Lasten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
