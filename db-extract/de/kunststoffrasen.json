                        "entry_id": "c35321ce-2f54-3324-a0d7-54fdaec086d6",
                        "glosses": [
                            "künstlich hergestellter Rasen, der in Beschaffenheit und Aussehen einem Naturrasen ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21cab1f1-ecea-4b06-abc3-487ba78a4096",
                                "sense_id": "117200b5-ec8b-36eb-96eb-f2537acc244e",
                                "text": "„Nach DIN SPEC 18035-7 ist ein gefüllter Kunststoffrasen ein Kunststoffrasen, dessen Polschicht im Gegensatz zum ungefüllten Kunststoffrasen mineralische und/oder elastische Füllstoffe enthält.“"
                            },
                            {
                                "example_id": "fc7fbe41-3a33-4c63-8a52-53ce26cb078d",
                                "sense_id": "117200b5-ec8b-36eb-96eb-f2537acc244e",
                                "text": "„Damit wurde der Kunststoffrasen für den Spitzenfussball die Alternative zum Naturrasen.“"
                            }
                        ],
