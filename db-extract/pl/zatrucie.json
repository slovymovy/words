                    {
                        "translation_id": "7acc6697-dfcf-463e-b80e-927cbac02378",
                        "source_entry_id": "87daf013-e72e-39bd-bf73-c5373ea5af03",
                        "source_sense_id": "9aafa73e-5988-372e-a1e8-224fb4723ea0",
                        "target_lang_word": "Vergiftung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vergiftung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df49a6ed-ee85-373e-aab2-2b1e9aa22ab6",
                                        "entry_id": "980345ea-1b15-36ed-9554-f1f2d7934ebc",
                                        "glosses": [
                                            "körperliche Schädigung durch Einnahme von Gift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f52418-1467-428a-b420-f1ca7fb33f26",
                                                "sense_id": "df49a6ed-ee85-373e-aab2-2b1e9aa22ab6",
                                                "text": "Die Vergiftung des Rivalen führte zum Tode."
                                            },
                                            {
                                                "example_id": "ab29ba14-9d28-40cf-b952-0ed23f63cc68",
                                                "sense_id": "df49a6ed-ee85-373e-aab2-2b1e9aa22ab6",
                                                "text": "Er ist letztlich an der Vergiftung gestorben."
                                            },
                                            {
                                                "example_id": "69ac65c4-0551-4a7f-bd31-d2e6d2e6e312",
                                                "sense_id": "df49a6ed-ee85-373e-aab2-2b1e9aa22ab6",
                                                "text": "„Bei falscher Zubereitung sind schwere Vergiftungen nicht selten, insbesondere in Osteuropa.“"
                                            },
                                            {
                                                "example_id": "1f3b8473-ff0e-4c31-a803-f26d2621ae7e",
                                                "sense_id": "df49a6ed-ee85-373e-aab2-2b1e9aa22ab6",
                                                "text": "„Durch Zollsenkung von Seiten der europäischen Wirtschaftsgemeinschaft drohte die entscheidende Verbilligung von Kaffee und Tee und damit eine Vergiftung des deutschen Volkskörpers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c7dc44d-aa18-34b7-9b30-e0e8395f5820",
                                        "entry_id": "980345ea-1b15-36ed-9554-f1f2d7934ebc",
                                        "glosses": [
                                            "die Verabreichung von Gift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d93b24fe-4e94-4f36-a13a-004785fd49ff",
                                                "sense_id": "0c7dc44d-aa18-34b7-9b30-e0e8395f5820",
                                                "text": "Die Vergiftung ihres Mannes war ein heimtückischer Mordversuch."
                                            },
                                            {
                                                "example_id": "dba7aa14-d51b-40f2-b395-3388f58edf35",
                                                "sense_id": "0c7dc44d-aa18-34b7-9b30-e0e8395f5820",
                                                "text": "„Er war noch immer auf Rache aus, als er sich in Belgien niederließ, wo er 1928 an einer Vergiftung starb.“"
                                            },
                                            {
                                                "example_id": "ec6a7703-d515-4a34-932a-b03e112e26d6",
                                                "sense_id": "0c7dc44d-aa18-34b7-9b30-e0e8395f5820",
                                                "text": "„Ich bitte den Leser, mir zu sagen, ob ein kluger, ein denkender Mann die Vergiftung dieses Papstes in Zweifel ziehen kann, nachdem man bei seinem Tod die Porphezeiung als zutreffend hat erkennen müssen.“"
                                            },
                                            {
                                                "example_id": "c21bd40f-5de7-4b8b-ac8b-3355b5e5a1b6",
                                                "sense_id": "0c7dc44d-aa18-34b7-9b30-e0e8395f5820",
                                                "text": "„Ich beschloß jedoch, mich nicht zu rühren, ehe es nicht dunkel wurde und ehe ich nach der gestrigen Vergiftung nicht wieder ganz beisammen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
