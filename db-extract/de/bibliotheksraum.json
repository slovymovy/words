                        "glosses": [
                            "Raum, der eine Bibliothek beherbergt, in dem sich eine Büchersammlung befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c88e83-782e-4aa8-bf16-f7ba9335e411",
                                "sense_id": "323393dc-6457-37cc-8581-f8b219040018",
                                "text": "„Vincent Voland hatte sich bereits zum Schlafen aufs Sofa im Bibliotheksraum gelegt, am entgegengesetzten Ende des Landhauses, doch brauchte er nur eine Minute, um seinen Anzug und seine Waffe wieder anzulegen, und ließ sich dann von einem der syrischen Bewacher nach hinten in die Küche bringen.“"
                            }
                        ],
