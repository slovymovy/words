    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bca2c8bc-4ad9-3b1c-9ce9-c437e01f48a5",
                    "sense_definition": "To shout insulting or mocking comments at someone to show lack of respect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry crowd began to <w>jeer</w> at the referee after he made a controversial decision.",
                            "target_lang_translations": {
                                "ru": "Разгневанная толпа начала <w>насмехаться</w> над судьей после того, как он принял спорное решение.",
                                "nl": "De boze menigte begon de scheidsrechter <w>uit te jouwen</w> nadat hij een controversiële beslissing had genomen."
                            }
                        },
                        {
                            "text": "It is unkind to <w>jeer</w> at the performers just because they made a small mistake on stage.",
                            "target_lang_translations": {
                                "ru": "Некрасиво <w>глумиться</w> над артистами только из-за того, что они совершили небольшую ошибку на сцене.",
                                "nl": "Het is onaardig om artiesten <w>uit te joelen</w> alleen maar omdat ze een klein foutje op het podium maakten."
                            }
                        }
                    ],
                    "synonyms": [
                        "scoff",
                        "sneer",
                        "gibe",
                        "mock",
                        "taunt"
                    ],
                    "antonyms": [
                        "cheer",
                        "applaud",
                        "praise"
                    ],
                    "common_phrases": [
                        "jeer at the referee",
                        "jeer from the sidelines"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выкрикивать оскорбительные или насмешливые комментарии в чей-то адрес, чтобы выразить неуважение.",
                        "nl": "Beledigende of spottende opmerkingen naar iemand roepen om een gebrek aan respect te tonen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насмехаться",
                                "target_lang_sense_clarification": "издевательски шутить"
