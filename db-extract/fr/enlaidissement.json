                        "examples": [
                            {
                                "example_id": "3f9e3821-fde5-4a3c-9add-d55d1ad43630",
                                "sense_id": "09647fe7-083d-3588-a9dc-d07c34c3d00f",
                                "text": "Bien que cette classification soit un peu schématique, on la reprendra dans ses grandes lignes en étudiant successivement l’enlaidissement, l’encombrement et l’appauvrissement de l’espace."
                            },
                            {
                                "example_id": "5a127b98-1963-486e-95ae-6611f55cf43c",
                                "sense_id": "09647fe7-083d-3588-a9dc-d07c34c3d00f",
                                "text": "Et qui capitule devant cette colonisation idéologique du dictionnaire par une vision du monde complètement déconnectée de la réalité participe en fait à l’enlaidissement et à l’affaiblissement de notre langue."
                            }
                        ]
