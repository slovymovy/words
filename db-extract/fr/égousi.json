                        "examples": [
                            {
                                "example_id": "099393e1-f91f-460e-9ad2-92e35835a059",
                                "sense_id": "04044ddf-c5c9-3e21-8230-44349e82dc5a",
                                "text": "Prendre 180 grammes de haricot à akara (akara-ewa) et moudre à la perfection de même 90 grammes de graines de potiron (égousi) qui doivent être rôties avant d'être moulues. Mélanger la poudre d'égousi à la pâte de haricots en y ajoutant assez d'eau pour lui donner une consistance de soupe à petits pois."
                            },
                            {
                                "example_id": "10ce6475-a4e8-4ee4-bbea-2730c4f2e245",
                                "sense_id": "04044ddf-c5c9-3e21-8230-44349e82dc5a",
                                "text": "J’ai ainsi fait un tour du monde des soupes. (...) Soupe d’égousi avec du foufou."
                            }
                        ]
