{
    "word_family": [
        "swishing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ac46256-7a26-3b20-9ec3-eb115dd5500f",
                    "sense_definition": "To make a soft rustling or whistling sound while moving through the air or water",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long grass <w>swished</w> against her legs as she walked through the field.",
                            "target_lang_translations": {
                                "ru": "Длинная трава <w>шуршала</w> у неё под ногами, пока она шла по полю."
                            }
                        },
                        {
                            "text": "The paddle <w>swished</w> steadily through the calm water of the lake.",
                            "target_lang_translations": {
                                "ru": "Весло мерно <w>рассекало</w> спокойную воду озера."
                            }
                        }
                    ],
                    "synonyms": [
                        "rustle",
                        "whoosh"
                    ],
                    "common_phrases": [
                        "swish through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать мягкий шуршащий или свистящий звук при движении в воздухе или воде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шурша́ть",
                                "target_lang_sense_clarification": "о звуке трения о траву или ткань"
                            },
                            {
                                "target_lang_word": "свисте́ть",
                                "target_lang_sense_clarification": "о звуке быстрого движения в воздухе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f697a306-b4df-3ce2-9e91-3a56bf74a5f8",
                    "sense_definition": "To move liquid around inside a container or inside one's mouth",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Swish</w> the mouthwash around your teeth for thirty seconds before spitting it out.",
                            "target_lang_translations": {
                                "ru": "<w>Полощите</w> рот ополаскивателем в течение тридцати секунд, прежде чем выплюнуть."
                            }
                        },
                        {
                            "text": "She <w>swished</w> the water in the glass to clean the remaining residue.",
                            "target_lang_translations": {
                                "ru": "Она <w>поболтала</w> воду в стакане, чтобы смыть остатки."
                            }
                        }
                    ],
                    "synonyms": [
                        "rinse",
                        "slosh"
                    ],
                    "common_phrases": [
                        "swish around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полоскать или перемещать жидкость внутри емкости или во рту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоска́ть",
                                "target_lang_sense_clarification": "о полоскании рта"
                            },
                            {
                                "target_lang_word": "болта́ть",
                                "target_lang_sense_clarification": "о перемещении жидкости в емкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67ab5942-0f4e-3486-9bdb-d11d17ed3710",
                    "sense_definition": "To move something quickly through the air with a whistling sound",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat <w>swished</w> its tail back and forth while watching the bird.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>хлестала</w> хвостом из стороны в сторону, наблюдая за птицей."
                            }
                        },
                        {
                            "text": "He <w>swished</w> his cane in the air to show his excitement.",
                            "target_lang_translations": {
                                "ru": "Он <w>взмахнул</w> тростью в воздухе, чтобы показать свое волнение."
                            }
                        }
                    ],
                    "synonyms": [
                        "flick",
                        "wave"
                    ],
                    "common_phrases": [
                        "swish tail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро перемещать что-либо по воздуху со свистящим звуком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взмахну́ть",
                                "target_lang_sense_clarification": "резкое движение предметом"
                            },
                            {
                                "target_lang_word": "хлестну́ть",
                                "target_lang_sense_clarification": "о резком движении хвостом или гибким предметом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3bfdf72-7b11-316c-9965-9eaf3aebc244",
                    "sense_definition": "To make a basketball shot that goes directly through the net without touching the rim",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "basketball",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player <w>swished</w> the ball from the three-point line.",
                            "target_lang_translations": {
                                "ru": "Игрок <w>чисто забросил</w> мяч с трехочковой линии."
                            }
                        },
                        {
                            "text": "He <w>swished</w> the final shot to win the game.",
                            "target_lang_translations": {
                                "ru": "Он <w>чисто забросил</w> последний мяч, выиграв игру."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Забросить мяч в баскетбольную корзину так, чтобы он пролетел через сетку, не коснувшись обода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забро́сить «чи́сто»",
                                "target_lang_sense_clarification": "баскетбольный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd6c9bb9-f939-3067-99fc-23a2848960b5",
                    "sense_definition": "To hit someone with a thin flexible object",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naughty boy was <w>swished</w> for his bad behavior.",
                            "target_lang_translations": {
                                "ru": "Непослушного мальчика <w>высекли</w> за плохое поведение."
                            }
                        },
                        {
                            "text": "Teachers used to <w>swish</w> students who did not follow the rules.",
                            "target_lang_translations": {
                                "ru": "Учителя раньше <w>секли</w> учеников, которые не соблюдали правила."
                            }
                        }
                    ],
                    "synonyms": [
                        "flog",
                        "whip"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical method of corporal punishment."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-либо тонким гибким предметом (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлестну́ть",
                                "target_lang_sense_clarification": "ударить гибким предметом"
                            },
                            {
                                "target_lang_word": "вы́сечь",
                                "target_lang_sense_clarification": "наказать розгами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6532dd7e-077c-35de-b186-20a34ef249c5",
                    "sense_definition": "To behave in a manner considered stereotypically effeminate",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was told not to <w>swish</w> if he wanted to fit in with the group.",
                            "target_lang_translations": {
                                "ru": "Ему сказали не <w>жеманиться</w>, если он хочет вписаться в группу."
                            }
                        },
                        {
                            "text": "Some people feel pressured to hide their natural way of moving and not <w>swish</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди чувствуют давление, вынуждающее их скрывать свою естественную манеру движений и не <w>жеманиться</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often considered offensive or derogatory."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя манерно, женственно (пренебр.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жема́ниться",
                                "target_lang_sense_clarification": "вести себя манерно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "873e1147-19dd-36ef-a3ec-8c7b11b14f43",
                    "sense_definition": "Very fashionable, expensive, or sophisticated",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stayed at a very <w>swish</w> hotel in the center of London.",
                            "target_lang_translations": {
                                "ru": "Они остановились в очень <w>шикарном</w> отеле в центре Лондона."
                            }
                        },
                        {
                            "text": "The new office building looks quite <w>swish</w> with its glass walls.",
                            "target_lang_translations": {
                                "ru": "Новое офисное здание выглядит довольно <w>роскошно</w> со своими стеклянными стенами."
                            }
                        }
                    ],
                    "synonyms": [
                        "stylish",
                        "posh"
                    ],
                    "antonyms": [
                        "shabby"
                    ],
                    "common_phrases": [
                        "swish hotel",
                        "swish restaurant"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень модный, дорогой или изысканный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шика́рный",
                                "target_lang_sense_clarification": "дорогой и модный"
                            },
                            {
                                "target_lang_word": "роско́шный",
                                "target_lang_sense_clarification": "высокого качества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06850b44-265e-3509-93ed-506b513e695a",
                    "sense_definition": "Attractive and stylish in appearance or performance",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team played some <w>swish</w> football during the second half.",
                            "target_lang_translations": {
                                "ru": "Во втором тайме команда показала очень <w>элегантный</w> футбол."
                            }
                        },
                        {
                            "text": "She wore a <w>swish</w> dress to the party.",
                            "target_lang_translations": {
                                "ru": "На вечеринку она надела <w>щегольское</w> платье."
                            }
                        }
                    ],
                    "synonyms": [
                        "elegant",
                        "smart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекательный и стильный на вид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элега́нтный",
                                "target_lang_sense_clarification": "стильный и изящный"
                            },
                            {
                                "target_lang_word": "щего́льский",
                                "target_lang_sense_clarification": "очень нарядный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ed550f4-4f70-36c4-9748-3db2cffaf547",
                    "sense_definition": "Having qualities or characteristics traditionally associated with women",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term was used to describe a <w>swish</w> manner of walking.",
                            "target_lang_translations": {
                                "ru": "Этот термин использовался для описания <w>женоподобной</w> походки."
                            }
                        },
                        {
                            "text": "He was criticized for his <w>swish</w> behavior.",
                            "target_lang_translations": {
                                "ru": "Его критиковали за <w>женоподобное</w> поведение."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often considered offensive or derogatory."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий качества, традиционно приписываемые женщинам (пренебр.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "женоподо́бный",
                                "target_lang_sense_clarification": "о поведении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0893fc45-c219-35c4-945e-7d3dd7ee4390",
                    "sense_definition": "A short rustling or whistling sound caused by friction or movement",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard the <w>swish</w> of her silk dress as she walked past.",
                            "target_lang_translations": {
                                "ru": "Я услышал <w>шуршание</w> её шелкового платья, когда она проходила мимо."
                            }
                        },
                        {
                            "text": "The <w>swish</w> of the wind through the trees was very relaxing.",
                            "target_lang_translations": {
                                "ru": "<w>Шелест</w> ветра в деревьях очень расслаблял."
                            }
                        }
                    ],
                    "synonyms": [
                        "rustle",
                        "whoosh"
                    ],
                    "common_phrases": [
                        "soft swish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий шуршащий или свистящий звук, вызванный трением или движением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шурша́ние",
                                "target_lang_sense_clarification": "звук трения"
                            },
                            {
                                "target_lang_word": "свист",
                                "target_lang_sense_clarification": "звук быстрого движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a884a6cf-df4f-35b5-a180-38c1abe42274",
                    "sense_definition": "A basketball shot that goes through the net without touching the rim",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "basketball",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd cheered after his perfect <w>swish</w>.",
                            "target_lang_translations": {
                                "ru": "Толпа зааплодировала после его идеального <w>чистого броска</w>."
                            }
                        },
                        {
                            "text": "He practiced until every shot was a <w>swish</w>.",
                            "target_lang_translations": {
                                "ru": "Он тренировался до тех пор, пока каждый бросок не стал <w>чистым</w>."
