                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b80d5983-f580-321a-99f6-feb5be204db2",
                                        "entry_id": "ac44ef0d-4358-3e81-a0bf-dd3002e6d5af",
                                        "glosses": [
                                            "To print with a stencil."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c45fc820-5588-4bfa-acf4-5272892ef9cc",
                                                "sense_id": "b80d5983-f580-321a-99f6-feb5be204db2",
                                                "text": "Stencilled letters were used for words and phrases, as well as for captions for some of his stencil “prints,” print being used in the sense of a multicolor woodcut."
                                            }
                                        ]
                                    }
                                ]
                            }
