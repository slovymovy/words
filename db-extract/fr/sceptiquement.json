                        "cross_references": [
                            {
                                "target_word": "скептически",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2cbd7412-6c89-3e2e-8534-ddb78873b84a",
                                        "entry_id": "018bfef5-fcc8-3c65-8c90-1c767613dd5d",
                                        "glosses": [
                                            "преисполнившись скептицизма, скепсиса — критического, недоверчивого отношения к чему-либо, сомнения в правильности, истинности, возможности чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0805d56-f213-417e-a123-657dc2b7cfc9",
                                                "sense_id": "2cbd7412-6c89-3e2e-8534-ddb78873b84a",
                                                "text": "Многократно битый как-то укрепляется духом и спиной и смотрит, наконец, на наказание скептически, почти как на малое неудобство, и уже не боится его."
                                            },
                                            {
                                                "example_id": "cbf8c162-8fe2-4d76-9c55-3f537fa48295",
                                                "sense_id": "2cbd7412-6c89-3e2e-8534-ddb78873b84a",
                                                "text": "Но в то время как камышинский мещанин скептически вопрошает: «Какой бог, и кто его видел?» — Яшка производит неуклонное стучание во имя господне."
                                            },
                                            {
                                                "example_id": "4f2a60bc-dcd7-438b-bfeb-0bb25a653a41",
                                                "sense_id": "2cbd7412-6c89-3e2e-8534-ddb78873b84a",
                                                "text": "Любит поспать и вылить; к прочим земным радостям относится скептически, а женщин прямо-таки презирает самым искренним образом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
