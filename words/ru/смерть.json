{
    "word_family": [
        "смертный",
        "смертельный",
        "бессмертие",
        "насмерть",
        "предсмертный",
        "посмертный",
        "смертник",
        "смертушка"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4141cb6c-2c6b-3e63-81cd-a262f13cb31c",
                    "sense_definition": "Прекращение жизнедеятельности организма, конец жизни.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cessation_of_life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Внезапная <смерть> известного писателя стала большой потерей для литературы.",
                            "target_lang_translations": {
                                "en": "The sudden <death> of the famous writer became a great loss for literature.",
                                "zh": "这位著名作家的突然<w>死亡</w>对文学界来说是一个巨大的损失。"
                            }
                        },
                        {
                            "text": "Врачи делали всё возможное, но <смерть> наступила мгновенно.",
                            "target_lang_translations": {
                                "en": "Doctors did everything possible, but <death> occurred instantly.",
                                "zh": "医生们尽了全力，但病人还是瞬间<w>死亡</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "кончина",
                        "уход из жизни",
                        "конец",
                        "гибель"
                    ],
                    "antonyms": [
                        "жизнь",
                        "рождение",
                        "воскрешение"
                    ],
                    "common_phrases": [
                        "вопрос жизни и смерти",
                        "на волосок от смерти",
                        "верная смерть",
                        "клиническая смерть"
                    ],
                    "target_lang_definitions": {
                        "en": "Cessation of the organism's vital activity, end of life.",
                        "zh": "生物生命活动的停止，生命的终结。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "death",
                                "target_lang_sense_clarification": "cessation of life"
                            },
                            {
                                "target_lang_word": "passing",
                                "target_lang_sense_clarification": "polite/euphemism"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死亡",
                                "target_lang_sense_clarification": "生命活动的停止"
                            },
                            {
                                "target_lang_word": "去世",
                                "target_lang_sense_clarification": "委婉语，指人离世"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e79495e6-5fda-3e93-ac3d-6c8e22f9f13f",
                    "sense_definition": "Полное прекращение существования или деятельности чего-либо; конец.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cessation_of_life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для профессионального спортсмена серьёзная травма — это <смерть> карьеры.",
                            "target_lang_translations": {
                                "en": "For a professional athlete, a serious injury is the <death> of a career.",
                                "zh": "对于职业运动员来说，严重的受伤意味着职业生涯的<w>终结</w>。"
                            }
                        },
                        {
                            "text": "Отсутствие новых идей означает медленную <смерть> для любого искусства.",
                            "target_lang_translations": {
                                "en": "The absence of new ideas means a slow <death> for any art.",
                                "zh": "缺乏新思想对任何艺术形式来说都意味着缓慢的<w>消亡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "конец",
                        "финал"
                    ],
                    "antonyms": [
                        "расцвет",
                        "оживление",
                        "жизнь"
                    ],
                    "common_phrases": [
                        "смерть надежды",
                        "подобно смерти"
                    ],
                    "target_lang_definitions": {
                        "en": "Complete cessation of existence or activity of something; the end.",
                        "zh": "某事物存在或活动的彻底终结。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "death",
                                "target_lang_sense_clarification": "end of something"
                            },
                            {
                                "target_lang_word": "demise",
                                "target_lang_sense_clarification": "formal end or failure"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "终结",
                                "target_lang_sense_clarification": "事物或过程的结束"
                            },
                            {
                                "target_lang_word": "消亡",
                                "target_lang_sense_clarification": "逐渐消失或灭亡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cefcb605-3135-391e-894f-f55ca22e636b",
                    "sense_definition": "Мифологический образ или аллегорическая фигура (обычно в виде скелета с косой), символизирующая конец жизни.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На старинной гравюре была изображена <смерть> в чёрном плаще.",
                            "target_lang_translations": {
                                "en": "The old engraving depicted <Death> in a black cloak.",
                                "zh": "古老的版画上描绘着身披黑斗篷的<w>死神</w>。"
                            }
                        },
                        {
                            "text": "Герой сказки попытался обмануть <смерть> и спрятался в волшебном лесу.",
                            "target_lang_translations": {
                                "en": "The hero of the fairy tale tried to cheat <Death> and hid in the magic forest.",
                                "zh": "童话里的英雄试图欺骗<w>死神</w>，躲进了魔法森林。"
                            }
                        }
                    ],
                    "synonyms": [
                        "костлявая",
                        "старуха с косой",
                        "безносая"
                    ],
                    "common_phrases": [
                        "лик смерти"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mythological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Mythological image or allegorical figure (usually in the form of a skeleton with a scythe) symbolizing the end of life.",
                        "zh": "象征生命终结的神话形象或寓言人物（通常为手持镰刀的骷髅）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Death",
                                "target_lang_sense_clarification": "personification"
                            },
                            {
                                "target_lang_word": "Grim Reaper",
                                "target_lang_sense_clarification": "personification"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死神",
                                "target_lang_sense_clarification": "拟人化的死亡形象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e4a6327-c2d8-3b37-ad32-98ef4a0e1865",
                    "sense_definition": "То, что представляет смертельную угрозу или является крайне опасным.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "threat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для человека с аллергией даже один орех — это верная <смерть>.",
                            "target_lang_translations": {
                                "en": "For a person with an allergy, even one nut is certain <death>.",
                                "zh": "对于过敏的人来说，哪怕只吃一颗坚果也是<w>致命</w>的。"
                            }
                        },
                        {
                            "text": "Идти в горы без подготовки и снаряжения — это просто <смерть>.",
                            "target_lang_translations": {
                                "en": "Going into the mountains without preparation and equipment is simply <suicide>.",
                                "zh": "不经准备和装备就去登山简直是去<w>送死</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "конец"
                    ],
                    "antonyms": [
                        "жизнь"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that poses a mortal threat or is extremely dangerous.",
                        "zh": "构成致命威胁或极其危险的事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "death",
                                "target_lang_sense_clarification": "deadly danger"
                            },
                            {
                                "target_lang_word": "suicide",
                                "target_lang_sense_clarification": "figurative danger"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致命",
                                "target_lang_sense_clarification": "导致死亡的危险"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9eda9c25-9b85-3fab-bc0b-59909db1e2a3",
                    "sense_definition": "Очень некрасивая женщина или что-то отталкивающее.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он познакомился с девушкой, но друзья сказали, что она просто <смерть>.",
                            "target_lang_translations": {
                                "en": "He met a girl, but friends said she was just a <fright>.",
                                "zh": "他认识了一个女孩，但朋友们说她长得实在太难看了。"
                            }
                        },
                        {
                            "text": "Я не надену это платье, в нём я выгляжу как <смерть>.",
                            "target_lang_translations": {
                                "en": "I won't wear this dress, I look like <death> in it.",
                                "zh": "我才不穿这件裙子，穿上它我看起来简直像个鬼。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A very ugly woman or something repulsive.",
                        "zh": "形容外貌极丑或令人反感的人或事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fright",
                                "target_lang_sense_clarification": "ugly person"
                            },
                            {
                                "target_lang_word": "mess",
                                "target_lang_sense_clarification": "looking terrible"
                            }
                        ],
                        "zh": []
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d0deec89-4db2-315d-aace-1b1b3e276607",
                    "sense_definition": "Очень сильно, в высшей степени (обычно о желании или неприятном состоянии).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгой дороги нам <смерть> как хотелось спать.",
                            "target_lang_translations": {
                                "en": "After the long journey, we were <dying> to sleep.",
                                "zh": "长途跋涉后，我们困得<w>要命</w>。"
                            }
                        },
                        {
                            "text": "Мне <смерть> как надоело слушать эти бесконечные споры.",
                            "target_lang_translations": {
                                "en": "I am <sick to death> of listening to these endless arguments.",
                                "zh": "我听这些没完没了的争论听得都快烦<w>死</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ужасно",
                        "страшно",
                        "чертовски",
                        "до́ смерти"
                    ],
                    "antonyms": [
                        "немного",
                        "слегка",
                        "чуть-чуть"
                    ],
                    "common_phrases": [
                        "смерть как хочется",
                        "смерть как устал"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Very strongly, to a high degree (usually about a desire or unpleasant state).",
                        "zh": "程度极深，通常用于表达强烈的愿望或厌恶的情绪。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dying",
                                "target_lang_sense_clarification": "intensifier for wanting"
                            },
                            {
                                "target_lang_word": "badly",
                                "target_lang_sense_clarification": "intensifier"
                            },
                            {
                                "target_lang_word": "to death",
                                "target_lang_sense_clarification": "intensifier for negative states"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "要命",
                                "target_lang_sense_clarification": "程度副词，表示极度"
                            },
                            {
                                "target_lang_word": "死",
                                "target_lang_sense_clarification": "程度补语，表示程度极深"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}