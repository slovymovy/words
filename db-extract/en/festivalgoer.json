                                    }
                                ]
                            },
                            {
                                "target_word": "festivalier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f59be7b4-14b2-3ca3-9434-c5ee8cfbb7f2",
                                        "entry_id": "7e4a65d8-bcf0-3c7e-8b4e-824abfafafe7",
                                        "glosses": [
                                            "Participant à un festival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899f6568-a35b-47e5-adbd-096a9fb149c7",
                                                "sense_id": "f59be7b4-14b2-3ca3-9434-c5ee8cfbb7f2",
                                                "text": "Ce mardi matin, des festivaliers hébétés se rassemblaient en silence près des lieux du drame."
                                            },
                                            {
                                                "example_id": "fa85d1ae-3303-41ae-a7db-47628ab9ccb3",
                                                "sense_id": "f59be7b4-14b2-3ca3-9434-c5ee8cfbb7f2",
                                                "text": "Avec près de 130 000 personnes sur quatre jours, les Eurockéennes ont battu leur record de fréquentation en 2017. Tout comme les Vieilles Charrues, qui affichaient complet (2800 000 entrées) deux mois avant l’événement, ou le Main Square d’Arras, avec 125 000 festivaliers sur trois jours."
                                            },
                                            {
                                                "example_id": "9ca1245e-5e48-42e8-a4aa-f6a715ddae92",
                                                "sense_id": "f59be7b4-14b2-3ca3-9434-c5ee8cfbb7f2",
                                                "text": "Quelques invités et festivaliers se sont désistés au dernier moment, en raison de la reprise de l’épidémie."
                                            }
                                        ]
                                    }
                                ]
                            }
