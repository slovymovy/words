                    ],
                    "antonyms": [
                        "объект права"
                    ],
                    "common_phrases": [
                        "юридическое лицо",
                        "физическое лицо"
                    ],
                    "target_lang_definitions": {
                        "en": "A subject of civil rights and duties (an organization or a human).",
                        "zh": "民事权利和义务的主体（组织或个人）。"
                    },
