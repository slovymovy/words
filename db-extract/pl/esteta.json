                "translations": [
                    {
                        "translation_id": "685d0060-7804-437d-8991-c4618df8ed9d",
                        "source_entry_id": "87b600b4-51c0-3cbe-beb1-0b7c2a6ee8f7",
                        "source_sense_id": "04dc2b2e-36ba-335f-9e26-a556d000e2e7",
                        "target_lang_word": "esthete",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esthete",
