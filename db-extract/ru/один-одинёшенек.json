                        "cross_references": []
                    },
                    {
                        "translation_id": "0c51b778-fbad-477a-94d8-1062033befa0",
                        "source_entry_id": "f193f277-ea80-3c9d-8493-e0171e6f512a",
                        "source_sense_id": "7ce49aca-7121-3f52-9106-be7f41413723",
                        "target_lang_word": "all by myself",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "01bacb46-5dd7-4868-b0d9-d91627805138",
                        "source_entry_id": "f193f277-ea80-3c9d-8493-e0171e6f512a",
                        "source_sense_id": "7ce49aca-7121-3f52-9106-be7f41413723",
                        "target_lang_word": "mutterseelenallein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutterseelenallein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21338c3d-3253-34ab-9e91-0bc54949e253",
                                        "entry_id": "00543b1f-7715-3c5d-bbdd-c82e5bca09c8",
                                        "glosses": [
                                            "ganz und gar allein, sehr einsam, völlig vereinsamt; ganz verlassen"
                                        ],
                                        "tags": [
                                            "zumeist",
                                            "prädikativ",
                                            "emotional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66d88a21-eb10-459a-87cd-74f62d01c9cb",
                                                "sense_id": "21338c3d-3253-34ab-9e91-0bc54949e253",
                                                "text": "Er hatte sich verlaufen und fühlte sich mutterseelenallein."
                                            },
                                            {
                                                "example_id": "af9eb1b3-1721-4111-9c5d-4f765f13be83",
                                                "sense_id": "21338c3d-3253-34ab-9e91-0bc54949e253",
                                                "text": "„Manchmal ist das so - man hat sich gerade noch geküßt wie verrückt (natürlich hat er mich schon geküßt), und plötzlich sitzt man in dem kleinen Wagen nebeneinander, ganz dicht, und ist doch so mutterseelenallein.“"
                                            },
                                            {
                                                "example_id": "e8d00558-5730-4e3f-b6ae-22ed17ca7df9",
                                                "sense_id": "21338c3d-3253-34ab-9e91-0bc54949e253",
                                                "text": "„Seit dem Morgengrauen bin ich durch eure Gassen geschlendert. Mutterseelenallein. Alle Läden herunter, jede Tür zu.“"
                                            },
                                            {
                                                "example_id": "c900f79d-773b-4959-853f-fc628a60d263",
                                                "sense_id": "21338c3d-3253-34ab-9e91-0bc54949e253",
                                                "text": "„Aber was machen Sie hier so mutterseelenallein auf der Landstraße?“"
                                            },
                                            {
                                                "example_id": "ecbd99ba-2444-45cd-ad71-c44eaa04b39d",
                                                "sense_id": "21338c3d-3253-34ab-9e91-0bc54949e253",
                                                "text": "„Sabeth nochmals auf der Mole draußen, sie steht jetzt, unsere tote Tochter, und singt, ihre Hände wieder in den Hosentaschen, sie glaubt sich mutterseelenallein und singt, aber unhörbar - Ende der Spule.“"
                                            },
                                            {
                                                "example_id": "a71a5eae-38c0-414b-97cf-866942946cea",
                                                "sense_id": "21338c3d-3253-34ab-9e91-0bc54949e253",
                                                "text": "„Wohin ich in meiner Gier nach Kontakten und Menschen in meiner gottlosen und mutterseelenalleinen Einsamkeit auch vordringe, ich entdecke immer nur Metamorphosen der Werbung und Geldgier.“"
                                            },
                                            {
                                                "example_id": "f3ac3117-b631-4133-ba9f-21165953501e",
                                                "sense_id": "21338c3d-3253-34ab-9e91-0bc54949e253",
                                                "text": "„Ich hatte damals unter den Studenten einen Übersetzungspartner gesucht, der für mich als Verlobte infrage kam und mir nicht plötzlich einen Kuss auf die Backe drücken würde, wenn wir stundenlang mutterseelenallein abends in einem der großen, leeren Hörsäle saßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
