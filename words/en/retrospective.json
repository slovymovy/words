{
    "word_family": [
        "retrospect",
        "retrospection"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d43ea372-a99e-3b20-ba9e-575f279e07ab",
                    "sense_definition": "Relating to or contemplating the past.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "past_oriented",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum organized a <w>retrospective</w> exhibition to celebrate the artist's long career.",
                            "target_lang_translations": {
                                "zh": "博物馆举办了一场<w>回顾性</w>展览来庆祝这位艺术家漫长的职业生涯。"
                            }
                        },
                        {
                            "text": "The committee conducted a <w>retrospective</w> analysis of the project to identify past mistakes.",
                            "target_lang_translations": {
                                "zh": "委员会对该项目进行了<w>回顾性</w>分析，以找出过去的错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "retrospective analysis",
                        "retrospective study"
                    ],
                    "target_lang_definitions": {
                        "zh": "涉及或回顾过去的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "回顾性的",
                                "target_lang_sense_clarification": "指对过去事物进行审视或总结的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52f30da4-2968-3164-9869-54f2d01d603c",
                    "sense_definition": "Looking backwards in time or thought.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "past_oriented",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a <w>retrospective</w> look at his life choices during his retirement.",
                            "target_lang_translations": {
                                "zh": "退休期间，他<w>回首</w>审视了自己的人生选择。"
                            }
                        },
                        {
                            "text": "The author wrote a <w>retrospective</w> account of the events that shaped his childhood.",
                            "target_lang_translations": {
                                "zh": "作者写了一篇关于塑造他童年经历的<w>回顾性</w>叙述。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hindsightly"
                    ],
                    "target_lang_definitions": {
                        "zh": "在时间或思想上向后看。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "回首往事的",
                                "target_lang_sense_clarification": "侧重于个人对过去经历的思考。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0119bf1-a0f1-3db3-8e20-2ab5f95a9018",
                    "sense_definition": "Affecting or influencing things that happened in the past.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "past_oriented",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new tax law will not have a <w>retrospective</w> effect on previous payments.",
                            "target_lang_translations": {
                                "zh": "新的税法对之前的缴款不具有<w>追溯</w>效力。"
                            }
                        },
                        {
                            "text": "The company decided to apply the policy change on a <w>retrospective</w> basis.",
                            "target_lang_translations": {
                                "zh": "公司决定以<w>追溯</w>方式实施这项政策变更。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "retrospective effect"
                    ],
                    "target_lang_definitions": {
                        "zh": "对过去发生的事情产生影响的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "追溯性的",
                                "target_lang_sense_clarification": "指法律或政策对过去行为的效力。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9343952a-9d00-37f7-a52a-5830d1bb264c",
                    "sense_definition": "An exhibition of works from an extended period of an artist's activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exhibition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gallery is hosting a major <w>retrospective</w> of the painter's work from the last decade.",
                            "target_lang_translations": {
                                "zh": "画廊正在举办一场该画家过去十年作品的大型<w>回顾展</w>。"
                            }
                        },
                        {
                            "text": "Visitors enjoyed the <w>retrospective</w> which showcased the evolution of the sculptor's style.",
                            "target_lang_translations": {
                                "zh": "参观者很欣赏这场展示了雕塑家风格演变的<w>回顾展</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "artist retrospective"
                    ],
                    "target_lang_definitions": {
                        "zh": "展示艺术家长期创作作品的展览。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "回顾展",
                                "target_lang_sense_clarification": "艺术领域中对艺术家作品的系统性展示。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}