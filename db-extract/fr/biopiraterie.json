                                        "entry_id": "e55621f4-acb3-3c63-8db8-25e7a3c24f9f",
                                        "glosses": [
                                            "het onrechtmatig patenteren van biologisch materiaal dat uit armere landen is verkregen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eae713c-366f-415b-a452-f45cb6f4e9d4",
                                                "sense_id": "645c7598-f955-3cce-bec1-b40b75caf6b2",
                                                "text": "Ook de financiering van maatregelen om de vernietiging van bossen en zeeën tegen te gaan komt aan bod. Waarschijnlijk wordt er ook gepraat over een rechtvaardige verdeling van de winsten gemaakt uit het gebruik van dieren en planten om 'biopiraterij' te verhinderen."
                                            }
                                        ]
