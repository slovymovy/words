                "senses": [
                    {
                        "sense_id": "cc9ef8e7-1e9a-35e2-b70d-3496373ffcdd",
                        "entry_id": "e5d13e0e-50b4-3a94-a3fc-e41dbf0edcd0",
                        "glosses": [
                            "такой, как бывает перед Рождеством, накануне Рождества"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fc9ad395-d70d-3e2c-953b-8b7bd7cae51d",
                        "entry_id": "e5d13e0e-50b4-3a94-a3fc-e41dbf0edcd0",
                        "glosses": [
                            "предшествующий Рождеству"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7f906f4-41da-4428-9523-4a070d9b2cd3",
                                "sense_id": "fc9ad395-d70d-3e2c-953b-8b7bd7cae51d",
                                "text": "Во многих Церквях, отмечающих Рождество Христово 25 декабря, за четыре недели до праздника начинается предрождественский период."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d01be2bb-201e-458c-8174-3bb4175b43f4",
                        "source_entry_id": "e5d13e0e-50b4-3a94-a3fc-e41dbf0edcd0",
                        "target_lang_word": "vorweihnachtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorweihnachtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7a83d49-44ef-3ea4-806c-83f4729a221c",
                                        "entry_id": "8b44048f-9b7f-3fa2-8f49-5699c781530a",
                                        "glosses": [
                                            "die Zeit vor Weihnachten betreffend, für die Zeit vor Weihnachten typisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9416adb7-0e1e-4c12-8f0e-450774204d73",
                                                "sense_id": "d7a83d49-44ef-3ea4-806c-83f4729a221c",
                                                "text": "Die »Christbaumschachtel«, vom Speicher oder aus dem Kammerkasten geholt, verstaubt und fremd, ist den Kindern von Jahr zu Jahr eine vorweihnachtliche Augenweide."
                                            },
                                            {
                                                "example_id": "1b1d728f-1836-4082-a6b6-1d183c6ebddd",
                                                "sense_id": "d7a83d49-44ef-3ea4-806c-83f4729a221c",
                                                "text": "Zuvor hatte Wiens Erzbischof Christoph Schönborn bei einer Veranstaltung vom Start der Hilfsaktion berichtet und von einem \"vorweihnachtlichen Zeichen der gelungenen Herbergsuche\" gesprochen."
                                            },
                                            {
                                                "example_id": "a65094e7-c68a-459c-b06b-740c343b12fa",
                                                "sense_id": "d7a83d49-44ef-3ea4-806c-83f4729a221c",
                                                "text": "Der vorweihnachtliche Trubel macht es uns zwar schwerer, aber er beraubt uns nicht der Möglichkeit, die Stille zu finden."
                                            },
                                            {
                                                "example_id": "7d3d76d0-7bf4-440a-96de-cd957c854557",
                                                "sense_id": "d7a83d49-44ef-3ea4-806c-83f4729a221c",
                                                "text": "Noch im November hatten sie eine frohe Botschaft: Die Verbraucher seien in bester vorweihnachtlicher Stimmung."
                                            },
                                            {
                                                "example_id": "22208157-cefa-4e35-a647-8bf585d02205",
                                                "sense_id": "d7a83d49-44ef-3ea4-806c-83f4729a221c",
                                                "text": "Am besten schmeckt das kräftige Fleisch jetzt, wenn es draußen kälter wird, weil man es sehr gut mit vorweihnachtlichen Aromen kombinieren kann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
