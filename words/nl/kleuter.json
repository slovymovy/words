    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0dbd2737-a5a5-306f-aee7-47b53679f02d",
                    "sense_definition": "Een jong kind in de leeftijd van ongeveer vier tot zes jaar dat naar de basisschool gaat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kleuter</w> fietste op zijn driewieler door het huis.",
                            "target_lang_translations": {
                                "en": "The <w>preschooler</w> rode his tricycle through the house."
                            }
                        },
                        {
                            "text": "Mijn jongste zoon is een vrolijke <w>kleuter</w> die graag buiten speelt.",
                            "target_lang_translations": {
                                "en": "My youngest son is a cheerful <w>kindergartner</w> who loves playing outside."
                            }
                        }
                    ],
                    "synonyms": [
                        "kleutertje"
                    ],
                    "common_phrases": [
                        "vrolijke kleuter",
                        "kleuter op de driewieler"
                    ],
                    "target_lang_definitions": {
                        "en": "A young child approximately four to six years old who attends primary school or kindergarten."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "preschooler",
                                "target_lang_sense_clarification": "a child who is educated at preschool"
                            },
                            {
                                "target_lang_word": "kindergartner",
                                "target_lang_sense_clarification": "a child attending kindergarten"
                            },
                            {
                                "target_lang_word": "toddler",
                                "target_lang_sense_clarification": "a young child, though usually slightly younger than a kleuter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e7745b2-0132-38a8-a2ee-5762caace42d",
                    "sense_definition": "Een volwassen persoon die zich op een zeer onvolwassen of kinderachtige manier gedraagt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop met dat kinderachtige gedoe en gedraag je niet als een <w>kleuter</w>.",
                            "target_lang_translations": {
                                "en": "Stop that childish behavior and don't act like a <w>child</w>."
                            }
                        },
                        {
                            "text": "De directeur gedroeg zich als een <w>kleuter</w> tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "The director behaved like a <w>toddler</w> during the meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "kindskop"
                    ],
                    "antonyms": [
                        "volwassene"
                    ],
                    "common_phrases": [
                        "gedragen als een kleuter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically to criticize behavior"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An adult who behaves in a very immature or childish manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "child",
                                "target_lang_sense_clarification": "metaphorical use for an immature adult"
                            },
                            {
                                "target_lang_word": "infant",
                                "target_lang_sense_clarification": "used to describe someone acting very childishly"
                            },
                            {
                                "target_lang_word": "baby",
                                "target_lang_sense_clarification": "informal term for an immature person"
                            }
                        ]
                    }
                }
            ]
        },
