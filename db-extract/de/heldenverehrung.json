                "senses": [
                    {
                        "sense_id": "bb6d1d01-bac6-3cd0-9404-b9050bdc3156",
                        "entry_id": "7f526be8-8714-3e42-8212-b13174263c52",
                        "glosses": [
                            "Verehren von Menschen, die als Helden gelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d6db198-4aa2-4551-9ef4-532131812539",
                                "sense_id": "bb6d1d01-bac6-3cd0-9404-b9050bdc3156",
                                "text": "„In aufgeklärten Demokratien ist die Heldenverehrung schwer in Verruf geraten.“"
                            },
                            {
                                "example_id": "461ca735-1f57-4219-ba0d-a5988b7f0e6b",
                                "sense_id": "bb6d1d01-bac6-3cd0-9404-b9050bdc3156",
                                "text": "„Wir erleben gerade viel mehr Solidarität von den Kunden, sie sind freundlicher und diese Art der Anerkennung könnte doch dauerhaft erhalten bleiben. Dazu brauche ich keine Systemrelevanz-Debatte und keine Heldenverehrung, sondern einfach nur den Respekt der Mitmenschen untereinander.“"
                            },
                            {
                                "example_id": "5be42129-bd31-45d8-8da4-0c1ef1d97031",
                                "sense_id": "bb6d1d01-bac6-3cd0-9404-b9050bdc3156",
                                "text": "„Warum er keine einheimischen Bildhauer damit beauftragte, die international zu den anerkanntesten ihrer Kunst zählten, ist unbekannt, möglicherweise kam die Ästhetik der Nordkoreaner seinen Vorstellungen von angemessener Heldenverehrung näher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
