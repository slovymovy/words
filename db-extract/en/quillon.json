                                        "examples": [
                                            {
                                                "example_id": "a254a4e2-2634-4496-973d-e062e3fcf72b",
                                                "sense_id": "b5b7bea6-86a5-3673-9cb9-181d27cbd3a2",
                                                "text": "Il lui crache au visage et, sans répondre un mot, il tire son épée à double quillon [ξίφους / ἕλκει διπλοῦς κνώδοντας]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7be7408f-9746-358f-860b-3b5b1509028c",
                                        "entry_id": "694204a7-8d4e-3296-b646-0cbee4618165",
                                        "glosses": [
                                            "Partie de l’embouchoir, dans le fusil Lebel, qui servait à former les faisceaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468bc11c-f502-450e-8534-6e3ab8f9202d",
                                                "sense_id": "7be7408f-9746-358f-860b-3b5b1509028c",
                                                "text": "L’escorte attend au chaud de la caserne, le front somnolant sur le quillon des fusils : par un froid pareil, à l’idée qu’on va battre la semelle en haut des miradors, vous ne vous sentez pas non plus à la noce."
                                            }
                                        ]
                                    }
