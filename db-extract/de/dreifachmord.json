                        "examples": [
                            {
                                "example_id": "27a7eca2-5ce1-4327-8ddb-a02c07c9456e",
                                "sense_id": "2c0b1b5f-e26a-3837-8c20-4df7ece7858d",
                                "text": "Die Polizei konnte den Dreifachmord zügig aufklären."
                            },
                            {
                                "example_id": "a2a3e33c-385c-4874-b02e-508a82621e36",
                                "sense_id": "2c0b1b5f-e26a-3837-8c20-4df7ece7858d",
                                "text": "„Was den Dreifachmord besonders macht: Die Familie würde man, wäre der Adel in Österreich nicht 1919 per Gesetz aufgehoben worden, als Grafen ansprechen müssen, ihnen gehört das Schloss auf einer kleinen Anhöhe in dem Straßendorf, dazu Felder und ein Waldstück im Süden des Gemeindegebietes – konkret einer Stiftung, erzählt Amtsleiter Wolfgang Pöltinger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
