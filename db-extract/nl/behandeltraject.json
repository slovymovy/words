                "senses": [
                    {
                        "sense_id": "6f2b1f7a-628d-34a2-ad26-f2abd0107ce0",
                        "entry_id": "7e903b97-4afb-3a11-be9f-7d143e6556ea",
                        "glosses": [
                            "een reeks behandelingen en onderzoeken die nodig zijn om te genezen van een bepaalde aandoening of ziekte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b6085d9-f25c-462a-a241-3405cea711b7",
                                "sense_id": "6f2b1f7a-628d-34a2-ad26-f2abd0107ce0",
                                "text": "Uit psychisch onderzoek bleek eerder dat de man geen last heeft van een stoornis. De daad wordt hem daarom volledig aangerekend. Omdat de kans op herhaling laag wordt ingeschat, acht het hof een zorg- of behandeltraject niet nodig."
                            },
                            {
                                "example_id": "a8fc6e11-f96f-40fe-94f3-e683dfa0d524",
                                "sense_id": "6f2b1f7a-628d-34a2-ad26-f2abd0107ce0",
                                "text": "Hij zal niet al te veel hoop willen geven, maar toch dringend aanraden om aan een behandeltraject te beginnen."
                            },
                            {
                                "example_id": "f8aea31c-6823-40ce-bbfd-a09a3c2e5e72",
                                "sense_id": "6f2b1f7a-628d-34a2-ad26-f2abd0107ce0",
                                "text": "Vooral op sociale media, maar ook in de Britse media, werden vraagtekens gezet bij het gebrek aan transparantie over haar gezondheid. \"Zoals jullie kunnen voorstellen heeft dit tijd gekost. Het kostte mij tijd om te herstellen van een grote operatie zodat ik mijn behandeltraject kon starten\", zegt de prinses nu."
                            }
                        ]
                    }
