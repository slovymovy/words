                ],
                "senses": [
                    {
                        "sense_id": "831a612d-4b6c-3174-8708-33bf445ce6bf",
                        "entry_id": "15e64aab-59fa-3ddf-8e4e-b5f33cf2102c",
                        "glosses": [
                            "kleines Kriegsschiff, das mit einer Geschwindigkeit von über 50 Knoten fahren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5ff61c6-c36e-4130-be47-63a4fc75f09f",
                                "sense_id": "831a612d-4b6c-3174-8708-33bf445ce6bf",
                                "text": "„Die Schnellboote der Jaguar-Klasse (Marinebezeichnung: Klasse 140/141) waren die ersten nach dem Zweiten Weltkrieg neu entwickelten Kriegsschiffe der deutschen Bundesmarine.“"
                            },
                            {
                                "example_id": "8d3fcdbc-9492-4512-b673-e153d35ebad2",
                                "sense_id": "831a612d-4b6c-3174-8708-33bf445ce6bf",
                                "text": "„Es folgten Einsätze auf Schnellbooten, Minenräumbooten und anderen »fahrbaren Untersätzen«.“"
                            },
                            {
                                "example_id": "f2d4ffd0-c902-4afe-87da-908e1bf8f049",
                                "sense_id": "831a612d-4b6c-3174-8708-33bf445ce6bf",
                                "text": "„Bei einem Personalumfang von 15.000 bis 20.000 Mann sollte die neue Marine vor allem über kleinere Fahrzeuge wie Minensuchboote, Schnellboote, Geleitboote und große Torpedoboote verfügen.“"
                            },
                            {
                                "example_id": "a2503ba6-e25b-496e-b500-e0c95302fad8",
                                "sense_id": "831a612d-4b6c-3174-8708-33bf445ce6bf",
                                "text": "„Er befehligt eine Gruppe von Schnellbooten, die gerade in den kleinen, uns so nahen Ostseehafen eingelaufen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
