                                    {
                                        "sense_id": "0c91a1ca-c16e-3caa-a357-77c347570d41",
                                        "entry_id": "fc25f77b-690d-3b86-a43f-64976b74eb44",
                                        "glosses": [
                                            "A tube inserted into the body to drain or inject fluid."
