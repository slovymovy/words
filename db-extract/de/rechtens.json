                    {
                        "translation_id": "0f2122ec-5ec8-4059-9d72-fb0dfd5d1d2f",
                        "source_entry_id": "411947f8-6f8f-357e-8e34-6fdfec229ae4",
                        "source_sense_id": "a0ab5aa5-e56a-3fcc-917a-c1c8122a5745",
