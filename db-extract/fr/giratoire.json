                "translations": [
                    {
                        "translation_id": "2818b93d-6f6a-4211-9571-aa8f3619b836",
                        "source_entry_id": "286aab70-25cc-304f-a20b-e8d9c2c5e541",
                        "source_sense_description": "Sens giratoire.",
                        "target_lang_word": "Kreisverkehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
