    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03afc42e-7279-32db-ba9a-b47281112a1d",
                    "sense_definition": "Kleidung vom Körper oder einem Körperteil entfernen und diesen unbedeckt zeigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "koerper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor der gründlichen Untersuchung bat die Ärztin den Patienten, seinen Oberkörper zu <w>entblößen</w>."
                        },
                        {
                            "text": "Als Zeichen des tiefen Respekts <w>entblößten</w> alle anwesenden Männer beim Betreten des Raumes ihr Haupt."
                        }
                    ],
                    "common_phrases": [
                        "den Oberkörper entblößen",
                        "das Haupt entblößen"
                    ]
                },
                {
                    "sense_id": "43e5a777-b9ef-32cb-8a0c-d13b91e92021",
                    "sense_definition": "etwas bisher Verborgenes oder Verdecktes sichtbar machen und freilegen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aufdecken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein heftiger Windstoß hob die Plane an und <w>entblößte</w> die geheime Ladung auf dem Anhänger."
                        },
                        {
                            "text": "Das rasche Schmelzen des Schnees <w>entblößte</w> den kargen und steinigen Boden des Berghangs."
                        }
                    ],
                    "synonyms": [
                        "freilegen",
                        "aufdecken"
                    ]
                },
                {
                    "sense_id": "5e3a9765-4035-3acf-b397-fb1f79f58688",
                    "sense_definition": "innerste Gefühle, Gedanken oder persönliche Schwächen preisgeben und sich verletzlich zeigen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aufdecken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er scheute sich davor, vor seinen Kollegen die eigenen Ängste zu <w>entblößen</w>."
                        },
                        {
                            "text": "In dem vertraulichen Gespräch <w>entblößte</w> sie ihre tiefsten Zweifel an der gemeinsamen Zukunft."
                        }
                    ],
                    "synonyms": [
                        "offenbaren"
                    ]
                },
                {
                    "sense_id": "fbd5ec49-e7fb-3785-865b-62517ce0c616",
                    "sense_definition": "einer Sache vollständig berauben oder völlig ohne Schutz und Hilfsmittel dastehen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "berauben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch den langwierigen Streit war die Familie aller finanziellen Mittel <w>entblößt</w>."
                        },
                        {
                            "text": "Nach dem plötzlichen Ausfall der Truppen war die Festung jeglicher Verteidigung <w>entblößt</w>."
                        }
                    ],
                    "common_phrases": [
                        "aller Mittel entblößt"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "gehoben und veraltend"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb4c1eac-d3c9-38fa-96cc-c8b1c4fda1f5",
                    "sense_definition": "das Abnehmen oder Wegziehen von Kleidung zur Freilegung eines Körperteils",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "koerper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In vielen Kirchen gilt das <w>Entblößen</w> der Schultern als respektlos."
                        },
                        {
                            "text": "Erst durch das behutsame <w>Entblößen</w> der Schulter konnte der Notarzt die Schwere der Verletzung erkennen."
                        }
                    ],
                    "common_phrases": [
                        "das Entblößen des Körpers"
                    ]
                }
            ]
        }
    ]
}