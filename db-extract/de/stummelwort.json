                "senses": [
                    {
                        "sense_id": "cc222ee8-bbec-35a0-986e-20e1613cbcbb",
                        "entry_id": "9b80e472-a531-37e6-a257-702cc8f141e4",
                        "glosses": [
                            "gegenüber der Vollform gekürztes Wort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab5cef44-5b74-45a0-8bcb-84c6d0bebaa0",
                                "sense_id": "cc222ee8-bbec-35a0-986e-20e1613cbcbb",
                                "text": "„Später, im März 1944, kam es einmal zu einer ernsthaften öffentlichen und offiziellen Warnung vor dem mißbräuchlichen Übermaß der »Stummelwörter«, wie die Abbreviaturen hierbei genannt wurden.“"
                            },
                            {
                                "example_id": "580a15b7-b6b3-4447-97a5-0e8c1c79721f",
                                "sense_id": "cc222ee8-bbec-35a0-986e-20e1613cbcbb",
                                "text": "„Die Sexualität hat nämlich, seitdem sie zu einem Stummelwort geschrumpft ist, bei uns noch mehr als anderswo an Charme verloren.“"
                            },
                            {
                                "example_id": "26a69c08-34e0-4406-ab0b-64f867a4d619",
                                "sense_id": "cc222ee8-bbec-35a0-986e-20e1613cbcbb",
                                "text": "„Aus dem Schraubenflügler \"Heliko-pter\" ist im Amerikanischen \"Copter\" geworden, und auch dieses Stummelwort ist produktiv.“"
                            },
                            {
                                "example_id": "20ad8c28-0c8b-4a71-b10b-b4a91a50ca5b",
                                "sense_id": "cc222ee8-bbec-35a0-986e-20e1613cbcbb",
                                "text": "„Und so ist das Stummelwort \"'tschuldigung\" die wohl süßeste Verführung seit Eva mit ihrem \"Sorry Gott, es war die Schlange, nicht ich\" die Verantwortung fürs getane Übel von sich wies.“"
                            },
                            {
                                "example_id": "6b06571e-5876-4c10-aadb-6da2817b5f54",
                                "sense_id": "cc222ee8-bbec-35a0-986e-20e1613cbcbb",
                                "text": "„Nein, nicht Karaoke, nur –aóke. Immer wieder hör ich dieses Stummelwort, wenn ich mit Leuten rede: als Antwort auf eine meiner Aussagen. “"
                            },
                            {
                                "example_id": "b6a0f0db-a0be-4f13-b649-7ea87ed303d4",
                                "sense_id": "cc222ee8-bbec-35a0-986e-20e1613cbcbb",
                                "text": "„Das lange maahanmuuttaja ist inzwischen zu einem sogenannten Stummelwort reduziert worden: mamu, das allein oder in Zusammensetzungen wie mamunuoretjugendliche Einwanderer, verwendet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
