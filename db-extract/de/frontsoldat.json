                "senses": [
                    {
                        "sense_id": "de51da83-cd0e-3911-a1b9-b9d9b3a7ee82",
                        "entry_id": "7616d6ec-6449-393b-afc5-c54ce63e7df3",
                        "glosses": [
                            "der kämpfenden Truppe angehörender Soldat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d400c532-2276-4cb5-a90f-6d1552cd7061",
                                "sense_id": "de51da83-cd0e-3911-a1b9-b9d9b3a7ee82",
                                "text": "„Im Laufe des Jahres 1916 wurden die meisten deutschen Frontsoldaten mit einem zeitgemäßen Stahlhelm ausgestattet.“"
                            },
                            {
                                "example_id": "93347bc6-3be2-4441-b828-c51807723def",
                                "sense_id": "de51da83-cd0e-3911-a1b9-b9d9b3a7ee82",
                                "text": "„Wir fühlen uns als Frontsoldaten, wir spielen Frontsoldaten, wir öffnen die Patronentaschen, wir zählen die scharfe Munition, wir hantieren an den Schlössern unserer Karabiner.“"
                            },
                            {
                                "example_id": "2dabd36f-fb1c-4d3c-a172-a7d02df16200",
                                "sense_id": "de51da83-cd0e-3911-a1b9-b9d9b3a7ee82",
                                "text": "„Nun gibt es aber keine schlimmere Beleidigung für einen Frontsoldaten als den Anblick eines Feldgendarmen mit seinem Blechschild auf der Brust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
