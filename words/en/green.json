                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>greens</w> are campaigning for stricter carbon emission laws.",
                            "target_lang_translations": {
                                "ru": "<w>Зелёные</w> выступают за ужесточение законов о выбросах углекислого газа."
                            }
                        },
                        {
                            "text": "She has been a committed <w>green</w> for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Она является убеждённым <w>экологом</w> уже более двадцати лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "environmentalist",
                        "greenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член партии «зелёных»; защитник окружающей среды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зелёный",
                                "target_lang_sense_clarification": "активист"
                            },
                            {
                                "target_lang_word": "эколог",
                                "target_lang_sense_clarification": "защитник природы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9839782-d823-3bd0-9e83-189cf12e6655",
