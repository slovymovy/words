                                "example_id": "74774d47-acf7-46d3-9d29-650e234d231d",
                                "sense_id": "8f7d2ec2-3d5c-3ce0-bff0-bf24deac2989",
                                "text": "Au moment de s’empoigner, Pinon me dit :\n— Bige-moi !\nNous nous embrassâmes deux fois."
                            }
