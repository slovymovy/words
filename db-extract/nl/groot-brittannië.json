                                            "Spojené království"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1364d8a8-8a5b-452e-af5f-a6284f94ab26",
                                                "sense_id": "74059b68-d322-3292-91e6-8c320fe64760",
                                                "text": "Severní Irsko patří k Velké Británii."
                                            },
                                            {
                                                "example_id": "030450a6-653c-4ff7-b019-3134ddb9daf0",
                                                "sense_id": "74059b68-d322-3292-91e6-8c320fe64760",
                                                "text": "Také politické a vojenské postavení Velké Británie bylo v té době velmi silné. Británie tak vyšla z druhé světové války zdánlivě posílena ..."
                                            },
                                            {
                                                "example_id": "0b4ad29f-53f3-4cee-9444-be55606faed4",
                                                "sense_id": "74059b68-d322-3292-91e6-8c320fe64760",
                                                "text": "Zároveň bylo rozhodnuto o podpoře balkánských zemí diplomatickou akcí (kterou mělo vést především Turecko) z iniciativy Velké Británie, o dodávkách válečného materiálu a o přípravě technických prací ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
