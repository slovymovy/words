                        "examples": [
                            {
                                "example_id": "258c8ef1-4622-449f-ace7-5e7b3786fba9",
                                "sense_id": "a183b78b-f84b-30dc-ad1f-5e6ddea6ecfa",
                                "text": "In het metrostation is het druk, mensen staan in bosjes bij elkaar, heel soms vindt een koude windvlaag zijn weg naar binnen"
                            },
                            {
                                "example_id": "4ddbd84c-733c-476c-b03e-8778e94260b9",
                                "sense_id": "a183b78b-f84b-30dc-ad1f-5e6ddea6ecfa",
                                "text": "Het Rotterdamse college heeft deze week het definitieve ontwerp voor het strandplein in Hoek van Holland goedgekeurd. Het plein moet voor het metrostation van het strand van Hoek van Holland komen en moet samen met het nog te bouwen eindstation van de Hoekse Lijn in 2022 opgeleverd worden."
                            }
                        ]
                    }
