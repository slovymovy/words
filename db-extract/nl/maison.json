                "senses": [
                    {
                        "sense_id": "5cbd8670-14f0-3b47-b852-480081a8d5a6",
                        "entry_id": "3163b0b6-f300-34d4-a622-5d817eb298ec",
                        "glosses": [
                            "verblijf, herberg, woning"
                        ],
                        "tags": [],
