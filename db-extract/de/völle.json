                    {
                        "translation_id": "b18dd211-feea-4db2-8054-d9c20d2cf5eb",
                        "source_entry_id": "18087166-6023-3295-82d4-641b3f74f3b4",
                        "source_sense_id": "bafbd4b7-b657-381d-a427-e37ca7d131a7",
                        "source_sense_description": "seltener: drückendes Gefülltsein (des Magens); übermäßiges Gesättigtsein",
                        "target_lang_word": "lourdeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lourdeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09d742ca-852f-3d75-9aad-b47571e43515",
                                        "entry_id": "de15b67c-9869-3ac6-b187-01dfe69e59e8",
                                        "glosses": [
                                            "État de ce qui est lourd."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ca5876e-7c3b-4cb4-a98e-77d2e21a66f5",
                                                "sense_id": "09d742ca-852f-3d75-9aad-b47571e43515",
                                                "text": "En effet, le cadavre était froid. L'homme essaya de le soulever : la rigidité, la lourdeur des membres le firent renoncer à son projet."
                                            },
                                            {
                                                "example_id": "d9f68c5d-d806-4330-a875-e6e26feea7cf",
                                                "sense_id": "09d742ca-852f-3d75-9aad-b47571e43515",
                                                "text": "La chambre, tout en chaos, est pleine d’un mélange d’odeurs : savon, poudre de riz, senteur aiguë de l’eau de Cologne, dans la lourdeur du matin enfermé."
                                            },
                                            {
                                                "example_id": "54950457-0542-4b8b-8836-8413662826dd",
                                                "sense_id": "09d742ca-852f-3d75-9aad-b47571e43515",
                                                "text": "Nietzsche s'est dressé face au siècle. Et l’adversaire qu'il s'est choisi, c'est l’esprit de lourdeur, notre poids naturel, notre faculté naturelle de retombement dans la coutume."
                                            },
                                            {
                                                "example_id": "d89c3d94-a191-45f4-9712-966d387383b5",
                                                "sense_id": "09d742ca-852f-3d75-9aad-b47571e43515",
                                                "text": "Deux ans et demi après le début de son mandat, son gouvernement est incapable de créer de simples places en garderie en raison de la lourdeur de la « machine » du ministère de la Famille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c72bd088-dbab-445a-834f-9a29046c43ac",
                        "source_entry_id": "18087166-6023-3295-82d4-641b3f74f3b4",
                        "source_sense_id": "bafbd4b7-b657-381d-a427-e37ca7d131a7",
                        "source_sense_description": "seltener: drückendes Gefülltsein (des Magens); übermäßiges Gesättigtsein",
                        "target_lang_word": "pesanteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pesanteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90a963bf-0e8a-32ea-b1b5-603150150985",
                                        "entry_id": "736705a8-1ddd-36cf-83f3-c0f98e669716",
                                        "glosses": [
                                            "Principe d’attraction d’un corps par l’astre sur lequel il est posé."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d28591c9-0444-3ff7-9da7-8dfd31f8fbe8",
                                        "entry_id": "736705a8-1ddd-36cf-83f3-c0f98e669716",
                                        "glosses": [
                                            "Qualité de ce qui a du poids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e182e8d-b2e0-4fea-a5d5-0d1b39668cf2",
                                                "sense_id": "d28591c9-0444-3ff7-9da7-8dfd31f8fbe8",
                                                "text": "Grégoire affirme que le Créateur de l'univers a créé le monde sensible comme situé entre deux termes extrêmes contraires l'un à l'autre, je veux dire entre la pesanteur et l’impondérabilité, qui s'opposent absolument l'un à l'autre."
                                            },
                                            {
                                                "example_id": "535a9049-4e0e-4b11-933a-b56f6825337a",
                                                "sense_id": "d28591c9-0444-3ff7-9da7-8dfd31f8fbe8",
                                                "text": "Le baromètre fait connaître la pesanteur de l’air."
                                            },
                                            {
                                                "example_id": "80e572db-c911-4fb5-ac84-b8efc39d0da8",
                                                "sense_id": "d28591c9-0444-3ff7-9da7-8dfd31f8fbe8",
                                                "text": "L’accélération de la pesanteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d4e5ee4-540f-318b-ad3d-0561b31989a2",
                                        "entry_id": "736705a8-1ddd-36cf-83f3-c0f98e669716",
                                        "glosses": [
                                            "Caractère de ce qui a un grand poids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "967429e9-8be2-4601-bdc0-fdcf7b20ecfa",
                                                "sense_id": "6d4e5ee4-540f-318b-ad3d-0561b31989a2",
                                                "text": "Et partant lors qu'on tend le piege, faut sçauoir ou presumer la pesanteur de la beste, à laquelle on tend & auoir d'auantage obserué, si elle est grande ou petite pour jugër de sa pesanteur, laquelle ne peut marcher sur le piege que d'vn pied à la fois. Et partãt c'est la moitié presque de la pesanteur de la beste."
                                            },
                                            {
                                                "example_id": "e1d91759-6341-4b44-875b-642fa820b31c",
                                                "sense_id": "6d4e5ee4-540f-318b-ad3d-0561b31989a2",
                                                "text": "Il fit lever ses trois filles et ses quatre fils, sans nous introduire dans sa maison, et ceux-ci nous apportèrent dans de vieux pots de terre, un peu de lait de chèvre, avec du pain de maïs d'une pesanteur spécifique effrayante."
                                            },
                                            {
                                                "example_id": "88da0546-1d9f-4fdd-b5da-a976db0b2e7a",
                                                "sense_id": "6d4e5ee4-540f-318b-ad3d-0561b31989a2",
                                                "text": "Il lui a fait sentir la pesanteur de son bras, Il lui a donné un coup violent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dfb0779-3593-3c74-89c6-345d9c1ad79a",
                                        "entry_id": "736705a8-1ddd-36cf-83f3-c0f98e669716",
                                        "glosses": [
                                            "Malaise qui fait sentir comme un poids dans quelque partie du corps."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c697b3f-1555-4cd9-9f4e-8dd8860eb4af",
                                                "sense_id": "3dfb0779-3593-3c74-89c6-345d9c1ad79a",
                                                "text": "Avoir une grande pesanteur de tête."
                                            },
                                            {
                                                "example_id": "29aeb059-cae2-48ba-8534-39576289b2a7",
                                                "sense_id": "3dfb0779-3593-3c74-89c6-345d9c1ad79a",
                                                "text": "Une pesanteur d’estomac."
                                            },
                                            {
                                                "example_id": "ee4c613d-cbcd-4819-8f5b-ea15dd6386c1",
                                                "sense_id": "3dfb0779-3593-3c74-89c6-345d9c1ad79a",
                                                "text": "Il sent une grande pesanteur dans le bras."
                                            },
                                            {
                                                "example_id": "315afeff-1858-42a9-81be-4947f71714cf",
                                                "sense_id": "3dfb0779-3593-3c74-89c6-345d9c1ad79a",
                                                "text": "Il sent de la pesanteur par tout le corps, par tous les membres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15810f5f-fb2b-3af0-83f2-0e71a596bae4",
                                        "entry_id": "736705a8-1ddd-36cf-83f3-c0f98e669716",
                                        "glosses": [
                                            "Lenteur, défaut d’activité et de célérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38a97e9c-a8de-41fb-ad23-9f5f3e946da2",
                                                "sense_id": "15810f5f-fb2b-3af0-83f2-0e71a596bae4",
                                                "text": "Cet homme, que j’ai vu si agile, est aujourd’hui d’une incroyable pesanteur."
                                            },
                                            {
                                                "example_id": "00f4fdde-f14d-4057-87a4-a1595d8087ff",
                                                "sense_id": "15810f5f-fb2b-3af0-83f2-0e71a596bae4",
                                                "text": "La pesanteur de sa marche."
                                            },
                                            {
                                                "example_id": "86765bef-6faf-4604-9ae2-da7ab3aa23af",
                                                "sense_id": "15810f5f-fb2b-3af0-83f2-0e71a596bae4",
                                                "text": "Ce cheval a trop de pesanteur pour être employé comme cheval de selle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c94aa13e-daa2-3140-ba27-171c5198733a",
                                        "entry_id": "736705a8-1ddd-36cf-83f3-c0f98e669716",
                                        "glosses": [
                                            "Lenteur, défaut de pénétration, de vivacité, de légèreté, de grâce, en parlant de l’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ecaa748-f2fc-43d4-ad36-8ec2371a4b2e",
                                                "sense_id": "c94aa13e-daa2-3140-ba27-171c5198733a",
                                                "text": "Avoir une grande pesanteur d’esprit, de la pesanteur dans l’esprit."
                                            },
                                            {
                                                "example_id": "47cddd61-4ec9-4476-8061-089536b49ede",
                                                "sense_id": "c94aa13e-daa2-3140-ba27-171c5198733a",
                                                "text": "La pesanteur de son esprit l’empêche de saisir promptement ce qu’on lui dit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
