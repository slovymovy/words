{
    "word_family": [
        "hill",
        "uphill"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bc15f9df-cf3c-3c5e-8cb4-f752959401f7",
                    "sense_definition": "Towards a lower position on a slope.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water flowed <w>downhill</w> and eventually emptied into the small creek.",
                            "target_lang_translations": {
                                "ru": "Вода текла <w>вниз</w> и в конце концов впадала в небольшой ручей.",
                                "zh": "水向<w>下</w>流去，最终汇入了那条小溪。"
                            }
                        },
                        {
                            "text": "It is much easier to ride a bicycle <w>downhill</w> than to pedal up the steep street.",
                            "target_lang_translations": {
                                "ru": "Ехать на велосипеде <w>под гору</w> гораздо легче, чем крутить педали вверх по крутой улице.",
                                "zh": "骑自行车<w>下坡</w>比在陡峭的街道上蹬车上坡要容易得多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "downslope"
                    ],
                    "antonyms": [
                        "uphill"
                    ],
                    "common_phrases": [
                        "flow downhill",
                        "roll downhill",
                        "move downhill"
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении более низкого места на склоне.",
                        "zh": "朝斜坡的低处移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вниз",
                                "target_lang_sense_clarification": "направление движения"
                            },
                            {
                                "target_lang_word": "под гору",
                                "target_lang_sense_clarification": "вниз по склону"
                            },
                            {
                                "target_lang_word": "под уклон",
                                "target_lang_sense_clarification": "по наклонной поверхности вниз"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "向下",
                                "target_lang_sense_clarification": "表示运动方向"
                            },
                            {
                                "target_lang_word": "下坡",
                                "target_lang_sense_clarification": "沿着斜坡向下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33760fbc-d282-3f6a-91a6-6ce0c393b712",
                    "sense_definition": "Towards a worse or inferior state; deteriorating.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the manager resigned, the quality of service in the restaurant went <w>downhill</w>.",
                            "target_lang_translations": {
                                "ru": "После увольнения менеджера качество обслуживания в ресторане пошло <w>на спад</w>.",
                                "zh": "经理辞职后，餐厅的服务质量就开始<w>走下坡路</w>了。"
                            }
                        },
                        {
                            "text": "His health began to go <w>downhill</w> rapidly during the cold winter months.",
                            "target_lang_translations": {
                                "ru": "Его здоровье начало стремительно <w>ухудшаться</w> в холодные зимние месяцы.",
                                "zh": "在寒冷的冬日里，他的健康状况开始迅速<w>恶化</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go downhill",
                        "go downhill fast",
                        "start to go downhill"
                    ],
                    "target_lang_definitions": {
                        "ru": "К худшему или низшему состоянию; в сторону упадка.",
                        "zh": "向更差或更低的状态发展；恶化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "под откос",
                                "target_lang_sense_clarification": "об ухудшении дел или здоровья (идиома)"
                            },
                            {
                                "target_lang_word": "на спад",
                                "target_lang_sense_clarification": "об ухудшении или снижении активности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走下坡路",
                                "target_lang_sense_clarification": "指情况或健康状况恶化"
                            },
                            {
                                "target_lang_word": "每况愈下",
                                "target_lang_sense_clarification": "形容情况越来越坏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "83ab89c9-2dbf-32ad-b170-336b0dceddb6",
                    "sense_definition": "Descending or leading down a slope or hill.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We followed the <w>downhill</w> path that led us straight to the riverbank.",
                            "target_lang_translations": {
                                "ru": "Мы шли по <w>спускающейся</w> тропинке, которая привела нас прямо к берегу реки.",
                                "zh": "我们沿着那条<w>下坡</w>小路走，直接到达了河岸。"
                            }
                        },
                        {
                            "text": "The runners prepared themselves for the steep <w>downhill</w> section of the race.",
                            "target_lang_translations": {
                                "ru": "Бегуны готовились к крутому <w>спуску</w> на дистанции.",
                                "zh": "选手们为比赛中那段陡峭的<w>下坡</w>路段做好了准备。"
                            }
                        }
                    ],
                    "antonyms": [
                        "uphill"
                    ],
                    "common_phrases": [
                        "downhill slope",
                        "downhill path",
                        "downhill course"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спускающийся или ведущий вниз по склону.",
                        "zh": "沿着斜坡向下延伸的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спускающийся",
                                "target_lang_sense_clarification": "ведущий вниз"
                            },
                            {
                                "target_lang_word": "идущий под уклон",
                                "target_lang_sense_clarification": "о дороге или пути"
                            },
                            {
                                "target_lang_word": "наклонный",
                                "target_lang_sense_clarification": "имеющий наклон вниз"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下坡的",
                                "target_lang_sense_clarification": "形容路径或地形"
                            },
                            {
                                "target_lang_word": "向下的",
                                "target_lang_sense_clarification": "形容倾斜的方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e14e17ab-be1e-34b6-8f70-b25ec40d7a7e",
                    "sense_definition": "Situated towards or at the bottom of a slope.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>downhill</w> side of the building offers a beautiful view of the valley.",
                            "target_lang_translations": {
                                "ru": "<w>Нижняя</w> сторона здания предлагает прекрасный вид на долину.",
                                "zh": "建筑的<w>下方</w>一侧可以欣赏到山谷的美景。"
                            }
                        },
                        {
                            "text": "Rocks and debris often collect at the <w>downhill</w> edge of the glacier.",
                            "target_lang_translations": {
                                "ru": "Камни и обломки часто скапливаются у <w>нижнего</w> края ледника.",
                                "zh": "岩石和碎屑经常堆积在冰川的<w>下方</w>边缘。"
                            }
                        }
                    ],
                    "antonyms": [
                        "uphill"
                    ],
                    "common_phrases": [
                        "downhill side",
                        "downhill end"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный внизу или у подножия склона.",
                        "zh": "位于斜坡底部或较低位置的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нижний",
                                "target_lang_sense_clarification": "расположенный ниже по уровню"
                            },
                            {
                                "target_lang_word": "низинный",
                                "target_lang_sense_clarification": "находящийся в низине"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下方的",
                                "target_lang_sense_clarification": "位置在低处"
                            },
                            {
                                "target_lang_word": "低处的",
                                "target_lang_sense_clarification": "处于地势较低处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9c2c290-a18a-3a57-bf1e-ccbf31e4497e",
                    "sense_definition": "Free from difficulty or obstacles; easy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have finished the hardest part of the project, so it should be <w>downhill</w> from here.",
                            "target_lang_translations": {
                                "ru": "Мы закончили самую сложную часть проекта, так что дальше должно быть <w>легче</w>.",
                                "zh": "我们已经完成了项目最难的部分，所以接下来应该会<w>容易</w>多了。"
                            }
                        },
                        {
                            "text": "Once you learn the basics of the software, the rest is <w>downhill</w> all the way.",
                            "target_lang_translations": {
                                "ru": "Как только вы освоите основы программного обеспечения, остальное пойдет <w>как по маслу</w>.",
                                "zh": "一旦你掌握了软件的基础知识，剩下的部分就<w>顺风顺水</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "downhill all the way",
                        "all downhill from here"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не требующий усилий; легкий (обычно после преодоления трудностей).",
                        "zh": "不再有困难或障碍；变得容易。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легкий",
                                "target_lang_sense_clarification": "простой, не требующий усилий"
                            },
                            {
                                "target_lang_word": "как по маслу",
                                "target_lang_sense_clarification": "очень легко (идиома)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容易",
                                "target_lang_sense_clarification": "指事情变得简单"
                            },
                            {
                                "target_lang_word": "顺风顺水",
                                "target_lang_sense_clarification": "形容进展顺利"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bec1633f-3583-3d50-a473-df3b767c603d",
                    "sense_definition": "A competitive skiing event involving a rapid descent down a steep course.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She trained for years to compete in the Olympic <w>downhill</w> against the best skiers.",
                            "target_lang_translations": {
                                "ru": "Она тренировалась годами, чтобы соревноваться в олимпийском <w>скоростном спуске</w> с лучшими лыжниками.",
                                "zh": "她训练多年，就是为了在奥运会<w>速降</w>比赛中与顶尖滑雪选手一较高下。"
                            }
                        },
                        {
                            "text": "The <w>downhill</w> is considered one of the most dangerous disciplines in alpine skiing.",
                            "target_lang_translations": {
                                "ru": "<w>Скоростной спуск</w> считается одной из самых опасных дисциплин в горнолыжном спорте.",
                                "zh": "<w>速降</w>被认为是高山滑雪中最危险的项目之一。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alpine downhill",
                        "downhill race",
                        "downhill skiing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соревнование по горнолыжному спорту, включающее быстрый спуск по крутой трассе.",
                        "zh": "一种高山滑雪比赛，选手需快速沿陡峭赛道下滑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скоростной спуск",
                                "target_lang_sense_clarification": "горнолыжная дисциплина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "速降",
                                "target_lang_sense_clarification": "滑雪运动项目"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bbd80ff0-d161-37cd-99eb-d80dabcb7f58",
                    "sense_definition": "To ski down a slope.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>downhilled</w> all morning until the snow conditions became too slushy.",
                            "target_lang_translations": {
                                "ru": "Они <w>спускались на лыжах</w> всё утро, пока снег не стал слишком рыхлым.",
                                "zh": "他们整个上午都在<w>滑下</w>山坡，直到雪变得太稀软。"
                            }
                        },
                        {
                            "text": "He has <w>downhilled</w> on some of the most challenging mountains in Europe.",
                            "target_lang_translations": {
                                "ru": "Он <w>спускался</w> с некоторых из самых сложных гор в Европе.",
                                "zh": "他曾在欧洲一些最具挑战性的山峰上<w>滑下</w>过。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спускаться по склону на лыжах.",
                        "zh": "在斜坡上滑雪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спускаться на лыжах",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑下",
                                "target_lang_sense_clarification": "滑雪动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ae75f92b-615c-38c0-9e53-f9c77c554fe3",
                    "sense_definition": "A coastal village and beach in County Londonderry, Northern Ireland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We visited <w>Downhill</w> to see the famous temple on the cliff edge.",
                            "target_lang_translations": {
                                "ru": "Мы посетили <w>Даунхилл</w>, чтобы увидеть знаменитый храм на краю утеса.",
                                "zh": "我们参观了<w>道恩希尔</w>，去看了悬崖边那座著名的神庙。"
                            }
                        },
                        {
                            "text": "The train tracks run remarkably close to the beach at <w>Downhill</w>.",
                            "target_lang_translations": {
                                "ru": "Железнодорожные пути проходят удивительно близко к пляжу в <w>Даунхилле</w>.",
                                "zh": "铁轨在<w>道恩希尔</w>离海滩近得惊人。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прибрежная деревня и пляж в графстве Лондондерри, Северная Ирландия.",
                        "zh": "北爱尔兰伦敦德里郡的一个沿海村庄和海滩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Даунхилл",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "道恩希尔",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "416142c8-5e6b-3ed9-a61e-de612576c79c",
                    "sense_definition": "A hamlet in St Eval parish, Cornwall, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small community of <w>Downhill</w> is located in the Cornish countryside.",
                            "target_lang_translations": {
                                "ru": "Небольшое поселение <w>Даунхилл</w> расположено в сельской местности Корнуолла.",
                                "zh": "<w>道恩希尔</w>这个小社区坐落在康沃尔的乡村地带。"
                            }
                        },
                        {
                            "text": "They drove through <w>Downhill</w> on their way to the coast.",
                            "target_lang_translations": {
                                "ru": "Они проехали через <w>Даунхилл</w> по пути к побережью.",
                                "zh": "他们在去往海岸的路上开车穿过了<w>道恩希尔</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревушка в приходе Сент-Эвал, Корнуолл, Англия.",
                        "zh": "英格兰康沃尔郡圣埃瓦尔教区的一个小村庄。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Даунхилл",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "道恩希尔",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaa2d5f6-41e2-31a1-aca7-1f849d7d724c",
                    "sense_definition": "A northern suburb of Sunderland, Tyne and Wear, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "New housing developments are being planned for the area around <w>Downhill</w>.",
                            "target_lang_translations": {
                                "ru": "В районе вокруг <w>Даунхилла</w> планируется строительство новых жилых комплексов.",
                                "zh": "在<w>道恩希尔</w>周边地区，新的住宅开发项目正在规划中。"
                            }
                        },
                        {
                            "text": "He grew up in <w>Downhill</w> before moving to the city center for work.",
                            "target_lang_translations": {
                                "ru": "Он вырос в <w>Даунхилле</w>, прежде чем переехать в центр города ради работы.",
                                "zh": "他在<w>道恩希尔</w>长大，后来为了工作搬到了市中心。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Северный пригород Сандерленда, Тайн-энд-Уир, Англия.",
                        "zh": "英格兰泰恩-威尔郡桑德兰的一个北部郊区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Даунхилл",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "道恩希尔",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}