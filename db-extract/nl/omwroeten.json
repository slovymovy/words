                "senses": [
                    {
                        "sense_id": "a1e5ccea-c3ff-3a68-9967-c93ba4956e07",
                        "entry_id": "7aa886bd-9ab5-3589-b195-f807da581e4e",
                        "glosses": [
                            "zowel in letterlijke als figuurlijke zin iets helemaal veranderen door iets helemaal door elkaar te gooien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12beeb45-dd1f-4085-b5c4-b91c8e35e97d",
                                "sense_id": "a1e5ccea-c3ff-3a68-9967-c93ba4956e07",
                                "text": "Nu moet een wijngaard ook omtuind zijn om de wijnstokken te beschermen tegen beschadigingen of omwroeten. De vraag die daarbij gesteld kan worden is of de verdeeldheid binnen de gereformeerde gezindte de vruchtbaarheid van de wijngaard niet belemmert en ook of de omtuining de wijngaard niet nutteloos maakt voor de wereld."
                            },
                            {
                                "example_id": "7c5ee251-99e7-4162-8106-2ce170ff219d",
                                "sense_id": "a1e5ccea-c3ff-3a68-9967-c93ba4956e07",
                                "text": "Literatuur is voor mij het onderzoeken en omwroeten van de menselijke ziel, en daarvoor gelden geen regels.'"
                            },
                            {
                                "example_id": "a6b70ee1-10f3-45fc-bdb1-16815f7f94db",
                                "sense_id": "a1e5ccea-c3ff-3a68-9967-c93ba4956e07",
                                "text": "Op een prachtige meidag begaf ik mij naar het Sporten Horecacentrum achter de rivierdijk waar de conferentie zich afspeelde. Het motto van de dag was 'Op de schop' dat verraderlijke eufemisme van de reuzenmollen die overal om ons heen landschappen omwroeten. 'Ja, dat gebied gaat helemaal op de schop' je ziet er een mannetje met een schep en een bergje zand bij."
                            }
                        ]
                    }
