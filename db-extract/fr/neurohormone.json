                "entry_id": "746101bf-cfea-33b8-8b4e-ca237f5b1895",
                "word": "neurohormone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e8f749c6-4bda-4408-99c1-b80767bf8169",
