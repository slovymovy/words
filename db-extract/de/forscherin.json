                        ],
                        "form": "die Forscherin"
                    },
                    {
                        "form_id": "f1b8ed34-b580-45e4-98fa-5aad829efd1f",
                        "entry_id": "37c98f1a-351b-3206-86c9-e34d5ff4aeca",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Forscherinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                        "entry_id": "37c98f1a-351b-3206-86c9-e34d5ff4aeca",
                        "glosses": [
                            "weibliche Person, die wissenschaftliche Zusammenhänge untersucht"
                        ],
                        "tags": [
                            "Beruf",
                            "Forschung"
                        ],
                        "examples": [
                            {
                                "example_id": "7baa4536-e821-4aa5-98f6-262740727a84",
                                "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                "text": "Viele Forscherinnen versuchen herauszufinden, wie das menschliche Gehirn funktioniert."
                            },
                            {
                                "example_id": "09f141a9-2e69-4edf-b879-ffc593d909e2",
                                "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                "text": "„Um die Fortbildung von Polizisten kümmert sich die rührige Forscherin ebenfalls.“"
                            },
                            {
                                "example_id": "c125d222-c7c9-4dd0-94a9-17a105065161",
                                "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                "text": "„An diesem Gespräch waren zwei Forscherinnen beteiligt, die zwischen 20 und 25 Jahre alt sind.“"
                            },
                            {
                                "example_id": "9ff345ca-7100-4df0-aa10-54349b24462d",
                                "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                "text": "„Auf sieben Gebieten orteten die Forscherinnen die Zutaten des langen gesunden Lebens.“"
                            },
                            {
                                "example_id": "84aff0c7-e4a3-460d-8e52-fd51fd9ac200",
                                "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                "text": "„Es gelang den Forscherinnen und Forschern, von neun der Toten genügend mitochondriale DNA – das Erbgut der weiblichen Linie – für eine Analyse zu extrahieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
