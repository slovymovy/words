    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ae20d7dd-c4cf-3df3-bd8b-4ac6b11cf230",
                "word": "choking",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "32b66ab8-ca8a-4675-9309-8d1150710bf4",
                        "entry_id": "ae20d7dd-c4cf-3df3-bd8b-4ac6b11cf230",
                        "tags": [
                            "plural"
                        ],
                        "form": "chokings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "916183e0-9bf1-3868-957e-a61883236b10",
                        "entry_id": "ae20d7dd-c4cf-3df3-bd8b-4ac6b11cf230",
                        "glosses": [
                            "The process in which a person's airway becomes blocked, resulting in asphyxia in cases that are not treated promptly."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "201a3b46-1f0d-48ca-acbd-61665d993b0c",
                                "sense_id": "916183e0-9bf1-3868-957e-a61883236b10",
                                "text": "In the last 6 years, there has been a great effort to educate the public concerning the prevention of choking due to accidental aspiration of foods or small objects by children."
                            },
                            {
                                "example_id": "484a7683-4ce6-4ed7-af53-191a4dfb7576",
                                "sense_id": "916183e0-9bf1-3868-957e-a61883236b10",
                                "text": "The study found that 29 percent of nonfood-related chokings were caused by latex balloons."
                            },
                            {
                                "example_id": "a5b6687a-b9d0-4276-86a9-ecfd1b042782",
                                "sense_id": "916183e0-9bf1-3868-957e-a61883236b10",
                                "text": "Choking occurs when the respiratory passage in the throat or windpipe is blocked."
                            }
                        ]
                    },
                    {
                        "sense_id": "64f53092-9955-3839-b748-9831779b91b4",
                        "entry_id": "ae20d7dd-c4cf-3df3-bd8b-4ac6b11cf230",
                        "glosses": [
                            "The act of coughing when a person finds it difficult to breathe."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d731ec22-7f46-4b80-b4e5-c3bd2b485b68",
                                "sense_id": "64f53092-9955-3839-b748-9831779b91b4",
                                "text": "Putting the latter on her head and the former on the table, the old woman, after telling Oliver that she had come to sit up with him, drew her chair close to the fire and went off into a series of short naps, chequered at frequent intervals with sundry tumblings forward, and divers moans and chokings."
                            },
                            {
                                "example_id": "32e35242-8a76-480c-9e6a-58ad1cb4fed3",
                                "sense_id": "64f53092-9955-3839-b748-9831779b91b4",
                                "text": "The chokings, which now always succeed every epileptic sleep, are violent beyond description, and last a long time."
                            },
                            {
                                "example_id": "fc624ba2-1c7b-4f9e-95e0-ad19fb64036a",
                                "sense_id": "64f53092-9955-3839-b748-9831779b91b4",
                                "text": "\"I applied,” says he in his first memoir, “a large plate of copper upon the pit of the stomach and a ring of the same metal around each limb: and in three or four minutes the chokings, palpitations, and vomitings ceased."
                            }
                        ]
                    },
                    {
                        "sense_id": "f469631f-58b8-359a-bc8b-f1b7591feb41",
                        "entry_id": "ae20d7dd-c4cf-3df3-bd8b-4ac6b11cf230",
                        "glosses": [
                            "The act of trying to kill a person by strangulation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c06d713f-6650-4c60-9214-80f525ba7c07",
                                "sense_id": "f469631f-58b8-359a-bc8b-f1b7591feb41",
                                "text": "She tells of many chokings and blows inflicted by the defendant, and says her health was thereby affected and, presumably, her life endangered."
                            },
                            {
                                "example_id": "dd741b6a-8b71-4e83-8d43-dd2996441003",
                                "sense_id": "f469631f-58b8-359a-bc8b-f1b7591feb41",
                                "text": "This particular man was a small, wiry , athletic Negro who had confessed to many chokings and rapings of young women."
                            },
                            {
                                "example_id": "96adaef3-4e1d-44a2-87a5-449470190139",
                                "sense_id": "f469631f-58b8-359a-bc8b-f1b7591feb41",
                                "text": "Judges should not decide which police chokings are acceptable, and which are not, based on Orwellian newspeak."
                            }
                        ]
                    },
                    {
                        "sense_id": "db980b6c-f3ef-306a-b7a2-898edf00aa7f",
                        "entry_id": "ae20d7dd-c4cf-3df3-bd8b-4ac6b11cf230",
                        "glosses": [
                            "The result of something being choked."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "34e3b592-91d3-4ae1-89bb-336dbaffecaf",
                                "sense_id": "db980b6c-f3ef-306a-b7a2-898edf00aa7f",
                                "text": "This feature has been found effective in reducing injector trouble, resulting either from the clogging of sieves or the choking of the annular orifices of the injectors by fine particles of coal."
                            }
                        ]
                    }
