                "senses": [
                    {
                        "sense_id": "b3798802-dc40-343b-96ba-cf469b574ba5",
                        "entry_id": "ee3c16bb-5d2f-3d4e-aea2-ebb61774b24d",
                        "glosses": [
                            "a white, dirt-dwelling grub of beetles in the superfamily Scarabaeoidea, for example the European cockchafers, the summer chafers, the garden chafer or the European rhinoceros beetle."
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "56ab8f71-f1fc-38c4-ba82-8fb7b73aaa9c",
                        "entry_id": "ee3c16bb-5d2f-3d4e-aea2-ebb61774b24d",
                        "glosses": [
                            "larva of the family Oestridae, including the botflies, warbleflies and gadflies."
                        ],
                        "tags": [
                            "dated",
                            "dialectal",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "3d4f295f-57ca-4335-8491-9657e55037a1",
                                "sense_id": "56ab8f71-f1fc-38c4-ba82-8fb7b73aaa9c",
                                "text": "Hier finden sich dann die Dasselbeulen, etwa sechs Monate nach dem Schwärmen der Fliegen, also im Januar bis zum Frühjahr. Die Beulen erreichen die Größe einer Walnuß und weisen bei der Reife seitlich eine kleine Öffnung auf, aus der eine klebrige Flüssigkeit hervortritt. In diesen Beulen sitzen die Larven, von den Landleuten „Engerlinge“ genannt.",
                                "translation": "Here the warbles appear, approximately six months after the swarming of the adult, thus in January until the Spring. The swellings reach the size of a walnut and upon maturity exhibit a small opening at the side, from which a sticky fluid emerges. In these swellings reside the larvae, known to the country folk as \"grubs\".",
                                "english": "Here the warbles appear, approximately six months after the swarming of the adult, thus in January until the Spring. The swellings reach the size of a walnut and upon maturity exhibit a small opening at the side, from which a sticky fluid emerges. In these swellings reside the larvae, known to the country folk as \"grubs\"."
                            }
                        ]
                    }
                ],
