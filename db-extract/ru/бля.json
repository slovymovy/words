        "ru-extract.jsonl": [
            {
                "entry_id": "2a6fb94b-eabb-3b23-a900-1009a38b3344",
                "word": "бля",
                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "36c60770-c785-3511-8d80-06d2bdacf2b4",
                        "entry_id": "2a6fb94b-eabb-3b23-a900-1009a38b3344",
                        "glosses": [
                            "бран. то же, что блядь; употребляется для выражения раздражения, удивления и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f2b8a5-1a88-4267-90e7-fe9bdf4df593",
                                "sense_id": "36c60770-c785-3511-8d80-06d2bdacf2b4",
                                "text": "Бля! Чё за хуйня!"
                            },
                            {
                                "example_id": "f484f81f-1d29-4791-aa3c-827caacf9002",
                                "sense_id": "36c60770-c785-3511-8d80-06d2bdacf2b4",
                                "text": "«Бля, ну я и лох», — подумал Саша."
                            },
                            {
                                "example_id": "b4e1df5e-0729-4f31-9467-4c0e08c203d7",
                                "sense_id": "36c60770-c785-3511-8d80-06d2bdacf2b4",
                                "text": "— Понял. — Бля, не «понял», а «так точно». Приготовишься — доложишь."
                            },
                            {
                                "example_id": "89cfc089-383d-4ff6-a863-12b124927878",
                                "sense_id": "36c60770-c785-3511-8d80-06d2bdacf2b4",
                                "text": "— Что они тебе за приз дали? — интересуется Тузик, взяв из рук Эди бутылку и отхлебывая. — Да ну, хуйню, ― мнется Эди — … домино. — Да, бля, — ухмыляется Тузик."
                            }
                        ]
                    },
                    {
                        "sense_id": "09b8f7f1-7e61-370c-acaf-dccb9d6c4082",
                        "entry_id": "2a6fb94b-eabb-3b23-a900-1009a38b3344",
                        "glosses": [
                            "вульг. употребляется для усиления выразительности, подчёркивания значения того или иного слова"
                        ],
                        "tags": [
                            "частица"
                        ],
                        "examples": [
                            {
                                "example_id": "bf495302-34c9-42c6-9860-99cf5fc9f575",
                                "sense_id": "09b8f7f1-7e61-370c-acaf-dccb9d6c4082",
                                "text": "Впосле́дствии Потоцкий говори́л мне: «…Я — писа́тель, бля, типа Че́хова.»"
                            },
                            {
                                "example_id": "1712113e-da38-4d3e-8e98-055878b03f19",
                                "sense_id": "09b8f7f1-7e61-370c-acaf-dccb9d6c4082",
                                "text": "Нет, э́то сли́шком, э́то, бля, переги́б…"
                            },
                            {
                                "example_id": "01c3a640-1591-4390-8fd1-5eaa3d54612d",
                                "sense_id": "09b8f7f1-7e61-370c-acaf-dccb9d6c4082",
                                "text": "Ах, что за славная земля Вокруг залива Коктебля; Колхозы, бля, совхозы, бля, Природа!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b09d8c87-5bca-455f-8622-f7ec14bfb3d9",
                        "source_entry_id": "2a6fb94b-eabb-3b23-a900-1009a38b3344",
                        "source_sense_description": "междометие",
                        "target_lang_word": "kurwa",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kurwa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e41491a1-16ff-326a-9431-f9cdade49b1c",
