                ],
                "senses": [
                    {
                        "sense_id": "28570f1b-a5a0-3bc0-96f3-22f6351006a0",
                        "entry_id": "1ef354eb-88c6-3dab-9f20-996f40878b4d",
                        "glosses": [
                            "Volk mit seiner Blütezeit von der Zeitenwende bis cirka 300 n. Chr."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4d06e742-399d-48bc-8c4f-a98bd149236e",
                                "sense_id": "28570f1b-a5a0-3bc0-96f3-22f6351006a0",
                                "text": "„Andere wichtige Zentren der Epi-Olmeken sind Chalchuapa in El Salvador und La Lagunita im guatemaltekischen Hochland, Abaj Takalik und Izapa nahe der Pazifikküste und Chiapa de Corzo im Hochland von Chiapas.“"
                            },
                            {
                                "example_id": "4933a42f-9e75-49a7-addc-66ade5ec4c6e",
                                "sense_id": "28570f1b-a5a0-3bc0-96f3-22f6351006a0",
                                "text": "„Weit nach Norden und im Süden bis ins heutige Guatemala verstreut, lebten sie – nun Epi-Olmeken genannt – noch einige Jahrhunderte weiter.“"
                            },
                            {
                                "example_id": "194c905d-8102-4bad-8e2f-e59233443e85",
                                "sense_id": "28570f1b-a5a0-3bc0-96f3-22f6351006a0",
                                "text": "„In welcher Sprache die Epi-Olmeken geschrieben haben und ob ihre Schrift bereits wie die der Maya den Status einer Vollschrift erreicht hatte, war bisher jedoch umstritten.“"
                            },
                            {
                                "example_id": "a30a6f76-c032-457f-aa7a-7e7f84c9b041",
                                "sense_id": "28570f1b-a5a0-3bc0-96f3-22f6351006a0",
                                "text": "„Aber bereits ihre Nachfolger, die Epi-Olmeken, besaßen wahrscheinlich eine logosyllabische, also auf einem Sprachcode basierende Schrift.“"
                            },
                            {
                                "example_id": "c1c38a23-320a-43c9-b811-87750ebd72f8",
                                "sense_id": "28570f1b-a5a0-3bc0-96f3-22f6351006a0",
                                "text": "„Das Einflussgebiet der Olmeken zu ihrer Blütezeit, aber auch noch danach, in der Zeit der Epi-Olmeken, reichte bis zum westlichen Mexiko und zentralen Hochland Mexikos, bis Oaxaca sowie bis zu den Küstenzonen in Chiapas […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
