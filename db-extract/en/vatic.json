                        "entry_id": "75ce06f9-4754-321b-afd5-e8b48423fa44",
                        "glosses": [
                            "Pertaining to a prophet; prophetic, oracular."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31e75f9d-b56f-4001-b785-7d6647e26160",
                                "sense_id": "886c14a7-b5f7-3676-a7e4-3c32427dcd85",
                                "text": "The truth of life lay in the vatic messages words sent, meanings beyond what the world called meaning."
                            },
                            {
                                "example_id": "ae2f290d-635d-49b6-9c94-dc1d55be6878",
                                "sense_id": "886c14a7-b5f7-3676-a7e4-3c32427dcd85",
                                "text": "“Inordinate attention from the middle latitudes,” proclaimed Miles, with a sort of vatic swoon in his voice."
                            },
                            {
                                "example_id": "9719975d-93ff-415d-b09d-2a56d4348a3e",
                                "sense_id": "886c14a7-b5f7-3676-a7e4-3c32427dcd85",
                                "text": "[T]he book, constructed in short, lucid episodes, can be satisfyingly read as a sequence of provocative talks, at once well informed and vatic."
                            },
                            {
                                "example_id": "ddb1274d-66b6-4fde-849f-d60b9ece5257",
                                "sense_id": "886c14a7-b5f7-3676-a7e4-3c32427dcd85",
                                "text": "Here is that gush, vatic visions of those ‘fixed, fast-frozen relations’ melting […]"
                            }
                        ]
                    }
