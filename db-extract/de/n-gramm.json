                "senses": [
                    {
                        "sense_id": "e944fc74-b96e-3021-9ba3-1875989d3e92",
                        "entry_id": "3f3aeb49-ef26-372c-a4f4-d6b08035ee47",
                        "glosses": [
                            "Kryptologie, beliebig lange Folge von Buchstaben oder anderen sprachlichen Einheiten, wobei N für die jeweilige Anzahl steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f938cf20-66ec-4891-832b-ce0a8de37d4a",
                                "sense_id": "e944fc74-b96e-3021-9ba3-1875989d3e92",
                                "text": "Untersuchungen zu N-Grammen sind in mehreren Wissenschaften von Bedeutung."
                            },
                            {
                                "example_id": "9eb9f977-60f5-4262-bb7e-2b7b4c159167",
                                "sense_id": "e944fc74-b96e-3021-9ba3-1875989d3e92",
                                "text": "„Das häufigste N-Gramm gibt die beste Vorhersage für das letzte Wort des N-Gramms, wenn die Wörter zuvor bereits bekannt sind.“"
                            },
                            {
                                "example_id": "03b5482e-97f8-49e9-a3c4-0d6a224975dd",
                                "sense_id": "e944fc74-b96e-3021-9ba3-1875989d3e92",
                                "text": "„Die Auszählung der n-Gramme erfolgte nach ihrer Stellung im Wort getrennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
