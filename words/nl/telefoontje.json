                    "frequency": "High",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet nog even een belangrijk <w>telefoontje</w> plegen voor mijn werk.",
                            "target_lang_translations": {
                                "en": "I just need to make an important <w>phone call</w> for work.",
                                "ru": "Мне нужно сделать важный <w>звонок</w> по работе.",
                                "pl": "Muszę jeszcze wykonać ważny <w>telefon</w> w sprawie pracy.",
                                "de": "Ich muss für meine Arbeit noch kurz einen wichtigen <w>Anruf</w> tätigen.",
                                "fr": "Je dois encore passer un <w>coup de fil</w> important pour mon travail.",
                                "it": "Devo ancora fare un'importante <w>telefonata</w> per lavoro.",
                                "cs": "Musím ještě vyřídit důležitý <w>telefonát</w> kvůli práci.",
                                "tr": "İşim için önemli bir <w>telefon görüşmesi</w> yapmam gerekiyor.",
                                "es": "Todavía tengo que hacer una <w>llamada</w> importante para mi trabajo.",
                                "zh": "我工作上还有个重要的<w>电话</w>要打。"
                            }
                        },
                        {
                            "text": "Na zijn <w>telefoontje</w> wist ik precies wat ik moest doen.",
                            "target_lang_translations": {
                                "en": "After his <w>call</w>, I knew exactly what to do.",
                                "ru": "После его <w>звонка</w> я точно знал, что мне делать.",
                                "pl": "Po jego <w>telefonie</w> wiedziałem dokładnie, co mam zrobić.",
                                "de": "Nach seinem <w>Anruf</w> wusste ich genau, was ich tun musste.",
                                "fr": "Après son <w>appel</w>, je savais exactement ce que je devais faire.",
                                "it": "Dopo la sua <w>chiamata</w> sapevo esattamente cosa dovevo fare.",
                                "cs": "Po jeho <w>telefonátu</w> jsem přesně věděl, co mám dělat.",
                                "tr": "Onun <w>telefonundan</w> sonra ne yapmam gerektiğini tam olarak biliyordum.",
                                "es": "Después de su <w>llamada</w>, supe exactamente lo que tenía que hacer.",
                                "zh": "在他打来<w>电话</w>后，我就清楚该怎么做了。"
                            }
