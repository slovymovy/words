                ],
                "senses": [
                    {
                        "sense_id": "15d37cac-0dcc-3c01-8a90-2eb94d7676f3",
                        "entry_id": "785f9513-1176-33c3-9f74-32f9a4679066",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e680f27d-4758-4c6e-98cf-44b9ddcc44e6",
                                "sense_id": "15d37cac-0dcc-3c01-8a90-2eb94d7676f3",
                                "text": "Frau Barg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "77ee3166-f912-4e49-b823-eb4d0a2eac94",
                                "sense_id": "15d37cac-0dcc-3c01-8a90-2eb94d7676f3",
                                "text": "Herr Barg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8867035f-ffab-41de-816a-e2aa62109c3e",
                                "sense_id": "15d37cac-0dcc-3c01-8a90-2eb94d7676f3",
                                "text": "Die Bargs kommen heute aus Mecklenburg."
                            },
                            {
                                "example_id": "4ed94a8e-dcb0-4b71-9e16-a3d9dd36be11",
                                "sense_id": "15d37cac-0dcc-3c01-8a90-2eb94d7676f3",
                                "text": "Der Barg trägt nie die Schals, die die Barg ihm strickt."
                            },
                            {
                                "example_id": "5f19ed73-dcec-4719-8199-910a99df96a1",
                                "sense_id": "15d37cac-0dcc-3c01-8a90-2eb94d7676f3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Barg kommt, geht der Herr Barg.“"
                            },
                            {
                                "example_id": "dea57767-1eb3-48bf-a7ee-ddd9e831df8c",
                                "sense_id": "15d37cac-0dcc-3c01-8a90-2eb94d7676f3",
                                "text": "Barg kommt und geht."
                            },
                            {
                                "example_id": "2c3fb63e-0b59-4f65-9253-bb6000e84ae4",
                                "sense_id": "15d37cac-0dcc-3c01-8a90-2eb94d7676f3",
                                "text": "Bargs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
