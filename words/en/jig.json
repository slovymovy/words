                    "target_lang_definitions": {
                        "nl": "Energiek dansen of op en neer huppelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "huppelen",
                                "target_lang_sense_clarification": "vrolijk springen"
                            },
                            {
                                "target_lang_word": "dansen",
                                "target_lang_sense_clarification": "energiek bewegen"
                            },
                            {
                                "target_lang_word": "springen",
                                "target_lang_sense_clarification": "op en neer wippen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6277532e-e479-3568-b50d-5ad3288816fe",
                    "sense_definition": "To move rapidly up and down or with quick, jerky motions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He watched the candle flame <w>jig</w> in the sudden draft.",
                            "target_lang_translations": {
                                "nl": "Hij keek hoe de kaarsvlam <w>flakkerde</w> in de plotselinge tocht."
                            }
                        },
                        {
                            "text": "She began <w>jigging</w> her leg nervously while waiting for the interview.",
                            "target_lang_translations": {
                                "nl": "Ze begon zenuwachtig met haar been te <w>wippen</w> terwijl ze op het sollicitatiegesprek wachtte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jig up and down"
