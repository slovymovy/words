                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0408760-c276-3753-9503-e7f5adf4f872",
                                        "entry_id": "f9c8a306-ea24-3aa6-a759-aa30c6d87705",
                                        "glosses": [
                                            "eine Tiergattung in der Teilordnung der Altweltaffen; mittelgroße, vorwiegend baumbewohnende Primaten, die in Afrika südlich der Sahara beheimatet sind"
                                        ],
                                        "tags": [
                                            "Zoologische Taxonomie",
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33ac4f4e-4c30-42b7-8a79-99f5e5ae920a",
                                                "sense_id": "e0408760-c276-3753-9503-e7f5adf4f872",
                                                "text": "„Zum Beispiel jagen überall dort, wo in dichter bewaldeten Regionen große Horden von Meerkatzen, Mangaben und Colubusaffen leben, Leoparden zu zweit“"
                                            },
                                            {
                                                "example_id": "60d87619-3596-4cc0-a612-5ef2b560fc09",
                                                "sense_id": "e0408760-c276-3753-9503-e7f5adf4f872",
                                                "text": "„Orang-Utans seien auch nicht so wild wie Paviane, nicht so dumm wie Meerkatzen, nicht so schmutzig wie Springaffen, nicht so ungeduldig und triebhaft wie Hundsaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "846fce0d-8506-3322-9d9b-22ff4b4b8744",
                                        "entry_id": "f9c8a306-ea24-3aa6-a759-aa30c6d87705",
                                        "glosses": [
                                            "ein Vertreter der Meerkatzen"
                                        ],
                                        "tags": [
                                            "im Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ac5e5be-cd90-48c8-a5c7-88101e611d12",
                                                "sense_id": "846fce0d-8506-3322-9d9b-22ff4b4b8744",
                                                "text": "„Zum Beispiel jagen überall dort, wo in dichter bewaldeten Regionen große Horden von Meerkatzen, Mangaben und Colubusaffen leben, Leoparden zu zweit“"
                                            },
                                            {
                                                "example_id": "408c7453-2763-4d31-a62c-520d25710067",
                                                "sense_id": "846fce0d-8506-3322-9d9b-22ff4b4b8744",
                                                "text": "„Eine Meerkatze sitzt bei dem Kessel und schäumt ihn und sorgt, daß er nicht überläuft. Der Meerkater mit den Jungen sitzt darneben und wärmt sich.“"
                                            },
                                            {
                                                "example_id": "85707d72-b49d-4a02-bdd8-4baa9864ec8a",
                                                "sense_id": "846fce0d-8506-3322-9d9b-22ff4b4b8744",
                                                "text": "„Ruiz trägt eine Korallenkette und hält zwei Meerkatzen im Arm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
