                "senses": [
                    {
                        "sense_id": "57d26a7a-bc8e-3bb2-96fd-cdb89441e0a9",
                        "entry_id": "53cfd6fd-e82d-3053-b70e-a630f129c3a5",
                        "glosses": [
                            "Éditer soi-même ce qu’on a écrit."
                        ],
                        "tags": [],
                        "examples": [
