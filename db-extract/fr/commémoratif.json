                    },
                    {
                        "form_id": "e81f5b25-74b5-4ec4-bc08-5c0d0a3361c4",
                        "entry_id": "537a182f-3264-3adf-a743-da6276258286",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "commémoratives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ddc1a356-5ea0-3cd6-909f-3b4fd482cd56",
                        "entry_id": "537a182f-3264-3adf-a743-da6276258286",
                        "glosses": [
                            "Qui rappelle le souvenir, qui commémore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63b77d9f-5b3c-452f-bf3e-d4e048573ce8",
                                "sense_id": "ddc1a356-5ea0-3cd6-909f-3b4fd482cd56",
                                "text": "Une demi-heure plus tard, après avoir, suivant la tradition, placé dans une anfractuosité une bouteille cachetée contenant un document commémoratif que je leur passai, Moussard et Le François purent sauter de nouveau dans la baleinière […]."
                            },
                            {
                                "example_id": "55bc68c2-4789-4244-98ba-bfd4f25f23d7",
                                "sense_id": "ddc1a356-5ea0-3cd6-909f-3b4fd482cd56",
                                "text": "Dans une petite commune telle que Drain, l’épidémie de peste de 1563 fit 153 morts qui furent enterrés ensemble à l'endroit où se dresse la croix commémorative du Moulin-Moreau, sur la route de Saint-Laurent-des-Autels."
                            },
                            {
                                "example_id": "0195002b-d36b-4643-9604-d16321dc7618",
                                "sense_id": "ddc1a356-5ea0-3cd6-909f-3b4fd482cd56",
                                "text": "Les cérémonies commémoratives officielles constituent la piqûre de rappel à la mémoire collective d'une nation."
                            },
                            {
                                "example_id": "db14b950-ef0d-4a7b-9fa3-b56afc1d0ab0",
                                "sense_id": "ddc1a356-5ea0-3cd6-909f-3b4fd482cd56",
                                "text": "Outre son livre qui mettait en lumière cette histoire, Christine Dollard-Leplomb, devenue membre puis présidente des Amis de la Fondation pour la Mémoire de la Déportation (AFMD) , répondit aux sollicitations de quelques maires pour que des plaques commémoratives à la mémoire des victimes déportées soient apposées dans leurs villages comme à Puilly-et-Charbeaux et Tétaigne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26420805-961b-413d-b9e7-1ea406527323",
                        "source_entry_id": "537a182f-3264-3adf-a743-da6276258286",
                        "source_sense_id": "ddc1a356-5ea0-3cd6-909f-3b4fd482cd56",
                        "target_lang_word": "commemorative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commemorative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a6b56b9-cd70-3542-b587-1158e9dff00c",
                                        "entry_id": "d07b96ab-092d-3449-b4cf-9aeb4895b84f",
                                        "glosses": [
                                            "Serving to commemorate something."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd5bb0e8-07f1-4387-86a0-3572f1e139d2",
                                                "sense_id": "2a6b56b9-cd70-3542-b587-1158e9dff00c",
                                                "text": "a commemorative plaque"
                                            },
                                            {
                                                "example_id": "f143b206-7136-468a-b5e2-b9ccfe7e55ff",
                                                "sense_id": "2a6b56b9-cd70-3542-b587-1158e9dff00c",
                                                "text": "The centenary of Britain's most famous train has called for a commemorative and descriptive work and in this 40-page illustrated booklet the author has tried—with some success, to pour a quart into a pint pot."
                                            },
                                            {
                                                "example_id": "a3ee1b36-8e83-43ad-a5f2-17203110d449",
                                                "sense_id": "2a6b56b9-cd70-3542-b587-1158e9dff00c",
                                                "text": "The plaza in front of San Francisco's City Hall was the scene Nov. 27 of two separate ceremonies commemorative of the assassinations one year ago of Mayor George Moscone and Supervisor Harvey Milk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "commemorative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9e17621-dbe2-301d-905f-07d3504c780e",
                                        "entry_id": "8a757589-8500-3718-a8da-fd7ae8daafae",
                                        "glosses": [
                                            "An object made to commemorate a person, mark an event, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b207c504-f8bd-3a7b-b04b-d617817aaf10",
                                        "entry_id": "8a757589-8500-3718-a8da-fd7ae8daafae",
                                        "glosses": [
                                            "A postage stamp issued to commemorate, usually a person or event; also commonly applied to thematic (topical) stamp issues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de054b88-de0c-4a0b-a40c-c952cd39a2c9",
                                                "sense_id": "b207c504-f8bd-3a7b-b04b-d617817aaf10",
                                                "text": "beautiful Pictorials, topicals, commemoratives, airmails. Introductory selection 40% discount. Ralph Rice, 15 Longlane, West Hartford 7, Conn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
