                        "examples": [
                            {
                                "example_id": "fd5a00a2-f2bf-4333-92cb-55938f03136c",
                                "sense_id": "c5a5ad6d-9a81-35bb-8160-9339be928747",
                                "text": "Grand amateur de vins depuis presque trente ans, Paul Dupré est habité par la passion de l’œnographilie, terme qui sert à désigner la collection d’étiquettes de bouteilles de vin."
                            },
                            {
                                "example_id": "0e457145-1165-4dbc-83be-5c4a79cd372c",
                                "sense_id": "c5a5ad6d-9a81-35bb-8160-9339be928747",
                                "text": "L’amicale des collectionneurs d’étiquettes de vin de Genas (69), a organisé sa 23e rencontre d’œnographilie dans la salle de la médiathèque La Maison de Julien."
                            },
                            {
                                "example_id": "4133de56-cfb1-4083-9cc6-51965ef2bd41",
                                "sense_id": "c5a5ad6d-9a81-35bb-8160-9339be928747",
                                "text": "Les collectionneurs passionnés, pour ne pas dire plus, par l’œnographilie (fans des étiquettes de vins et spiritueux), viennent de passer deux jours intenses, vendredi 21 et samedi 22 juin 2024."
                            }
