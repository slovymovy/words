                "translations": [
                    {
                        "translation_id": "de0c5eb0-f93c-4009-8a3b-caea593e5cb5",
                        "source_entry_id": "7318c170-de85-39b9-a178-6442423003f6",
                        "source_sense_id": "0a894769-1f09-3c3f-9bad-ff763a95d996",
                        "target_lang_word": "broad-gauge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broad-gauge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b96507e-a21b-3d2b-bf87-2dedaac3f249",
                                        "entry_id": "d1639a8e-6a70-3f6e-9e2f-980a24f224bc",
                                        "glosses": [
                                            "Relating to broad gauge or having a broad gauge."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8243047-d309-4968-84df-c323342a19f0",
                                                "sense_id": "5b96507e-a21b-3d2b-bf87-2dedaac3f249",
                                                "text": "a broad-gauge railroad track"
                                            },
                                            {
                                                "example_id": "27db7122-9f92-4ea9-89f9-9e658f6fefe9",
                                                "sense_id": "5b96507e-a21b-3d2b-bf87-2dedaac3f249",
                                                "text": "Broad-gauge track consists of both bullhead and flat-bottom rails, carried on a variety of sleepers—treated soft wood, hard wood, steel trough—and cast-iron pots and plates."
                                            },
                                            {
                                                "example_id": "684d4c76-4776-46b7-b4ea-5000838c9c45",
                                                "sense_id": "5b96507e-a21b-3d2b-bf87-2dedaac3f249",
                                                "text": "An offensive against Germany would require large forces and offered no certain prospect of success. An attack on Austria promised great victories, the destruction of the whole Austrian army and of the Austro-Hungarian state itself, the reordering of half of Europe—and meanwhile Russia would need only small forces to defend herself against the Germans, inflicting on them the disadvantages of poor roads and Russian broad-gauge lines."
                                            },
                                            {
                                                "example_id": "dc2529e8-2366-460d-ac26-b6a29cd95f3d",
                                                "sense_id": "5b96507e-a21b-3d2b-bf87-2dedaac3f249",
                                                "text": "In the Gladstone photo, the sitters look too small for their conveyances, and this is because they were sitting in extra-wide - that is, broad-gauge - wagons of the Great Western, which would run along the Met on broad-gauge tracks (7 foot 2 inches between the rails), together with trains using standard-gauge tracks of 4 foot 8½. In the Met's own language, the line ran on 'the mixed-gauge principle', which makes the arrangement sound almost sensible. That broad gauge did not last long, and all Underground trains today run on the standard gauge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39a455ab-b2dd-3af4-b0f1-aa4905f5de60",
                                        "entry_id": "d1639a8e-6a70-3f6e-9e2f-980a24f224bc",
                                        "glosses": [
                                            "Comprehensive; wide in scope."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
