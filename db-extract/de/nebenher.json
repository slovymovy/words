                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a355f0c6-962d-4c14-b8bf-67a46ce82cdb",
                                "sense_id": "b72a4321-d40d-30d2-9500-7d1dbb32faef",
                                "text": "Er studiert Philosophie und fährt nebenher Taxi."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "79813903-902c-3d30-b35e-1141f654dfa4",
                        "entry_id": "df607847-9a69-3400-8d25-90fe271a4e8f",
                        "glosses": [
                            "wie zufällig, am Rande, ohne besondere Betonung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c63b22e-658e-4e1a-8a5a-f46aa2d23adb",
                                "sense_id": "79813903-902c-3d30-b35e-1141f654dfa4",
                                "text": "Beim Abendessen erwähnte sie nebenher, dass ihr gekündigt wurde."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b87ecb5a-4a33-4aa6-90f8-e89f3c400801",
                        "source_entry_id": "df607847-9a69-3400-8d25-90fe271a4e8f",
                        "source_sense_id": "b72a4321-d40d-30d2-9500-7d1dbb32faef",
                        "source_sense_description": "noch dazu, auch noch",
                        "target_lang_word": "on the side",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on the side",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2cfe234-34d0-3587-87e8-37308d709ca3",
                                        "entry_id": "26f7966a-bcaa-38fc-a7dc-8de4a53cad84",
                                        "glosses": [
                                            "Separate from the main course of a meal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc765639-8831-4cfd-a4c3-1251c63abc92",
                                                "sense_id": "e2cfe234-34d0-3587-87e8-37308d709ca3",
                                                "text": "Shish kebab is skewered lamb with rice on the side."
                                            },
                                            {
                                                "example_id": "f8c02c86-37b6-492a-99dc-82f61011531f",
                                                "sense_id": "e2cfe234-34d0-3587-87e8-37308d709ca3",
                                                "text": "Stir sage and the remaining unsalted butter into the sauce and serve it in a bowl on the side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a33b942-bec9-36ac-b6b5-a473b9b69c81",
                                        "entry_id": "26f7966a-bcaa-38fc-a7dc-8de4a53cad84",
                                        "glosses": [
                                            "Supplementary or in addition to one's usual job or income."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee4cdcce-b2fa-4e03-821a-a49070006b70",
                                                "sense_id": "0a33b942-bec9-36ac-b6b5-a473b9b69c81",
                                                "text": "You don't want to jeopardize your primary source of income or any savings you've socked away in your effort to boost your earnings on the side."
                                            },
                                            {
                                                "example_id": "5304c127-4dc7-4e81-9751-81fde1cff4d5",
                                                "sense_id": "0a33b942-bec9-36ac-b6b5-a473b9b69c81",
                                                "text": "Borg has graying black hair and is trimly built, fit from a lifetime of hard work maintaining gas pipelines while trapping on the side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077ecf1e-df84-3ead-ab95-fd42291c642e",
                                        "entry_id": "26f7966a-bcaa-38fc-a7dc-8de4a53cad84",
                                        "glosses": [
                                            "Additional, surreptitious; often with a connotation of dishonesty, illegality or adultery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6708325-3a05-427d-8ab1-11e06407cd65",
                                                "sense_id": "077ecf1e-df84-3ead-ab95-fd42291c642e",
                                                "text": "I shouted to make sure she knew that I wasn't just some ho on the side. If anyone was on the side, it was her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2af04a58-a9f7-4d21-8a9b-fdcfb0a0b447",
                        "source_entry_id": "df607847-9a69-3400-8d25-90fe271a4e8f",
                        "source_sense_id": "b72a4321-d40d-30d2-9500-7d1dbb32faef",
                        "source_sense_description": "noch dazu, auch noch",
                        "target_lang_word": "en outre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en outre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00b863ec-7c0d-3adc-8de7-cad71a782df7",
                                        "entry_id": "34def171-e796-3a36-bacc-f13d92a5002b",
                                        "glosses": [
                                            "De plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a66fa1a-a236-42d2-9e3b-369c16c27647",
                                                "sense_id": "00b863ec-7c0d-3adc-8de7-cad71a782df7",
                                                "text": "L'Autriche déclarait en outre, qu'elle trouvait inadmissible que, dans l'article 3, les puissances se congratulassent de la signature de la paix entre la Prusse et le Danemarck, les hostilités ayant formellement repris."
                                            },
                                            {
                                                "example_id": "e3da6254-6231-4812-81b0-fd075ad9d254",
                                                "sense_id": "00b863ec-7c0d-3adc-8de7-cad71a782df7",
                                                "text": "En outre, la conception de l’autodéschisteur doit être telle que le blocage des dispositifs d’évacuation par la matière à éliminer soit impossible. Il doit être parfaitement automatique."
                                            },
                                            {
                                                "example_id": "ff6b68af-66fe-41f2-a000-b33e313642fe",
                                                "sense_id": "00b863ec-7c0d-3adc-8de7-cad71a782df7",
                                                "text": "En outre, j’ai rêvé que j’étais deux chats et que je jouais ensemble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a608c313-7fc5-4986-9173-700aaecd3166",
                        "source_entry_id": "df607847-9a69-3400-8d25-90fe271a4e8f",
                        "source_sense_id": "79813903-902c-3d30-b35e-1141f654dfa4",
                        "source_sense_description": "wie zufällig, am Rande, ohne besondere Betonung",
                        "target_lang_word": "in passing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in passing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d93456c-30a2-3096-98a3-0b563d93a5af",
                                        "entry_id": "12ac6dc3-5e1f-37e6-a5c3-ea167f68d968",
                                        "glosses": [
                                            "Incidentally; as a brief diversion from another topic etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eb190d8-1e23-47b5-8c0f-5ccd97ee5805",
                                                "sense_id": "5d93456c-30a2-3096-98a3-0b563d93a5af",
                                                "text": "We mostly talked about his mother's illness, but he told me in passing that he'd won a small prize in the lottery."
                                            },
                                            {
                                                "example_id": "340337aa-8de3-496a-845b-9ca06cba05ad",
                                                "sense_id": "5d93456c-30a2-3096-98a3-0b563d93a5af",
                                                "text": "Did she mention my name just in passing?"
                                            },
                                            {
                                                "example_id": "281b2da4-0e80-4edc-bab7-1c73bf96290d",
                                                "sense_id": "5d93456c-30a2-3096-98a3-0b563d93a5af",
                                                "text": "And that number, 400 million[subscribers], does not account for the people who watch MrBeast’s videos in passing, or who are aware of his cultural presence because of their children, or who just sort of know who he is but don’t have any intricate awareness as to why he is famous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1b31d38-3365-442e-8e9b-a8b2d6d143d9",
                        "source_entry_id": "df607847-9a69-3400-8d25-90fe271a4e8f",
                        "source_sense_id": "79813903-902c-3d30-b35e-1141f654dfa4",
                        "source_sense_description": "wie zufällig, am Rande, ohne besondere Betonung",
                        "target_lang_word": "à côté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à côté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e93d23b8-bf26-3dc2-96d9-95b856524b15",
                                        "entry_id": "8eb07630-941b-34c5-a5c4-87725152197a",
                                        "glosses": [
                                            "Tout près, à une certaine distance du lieu où l’on est ou du but que l’on vise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9c0c0e4-debc-4b05-bdfa-998eb89f5c89",
                                                "sense_id": "e93d23b8-bf26-3dc2-96d9-95b856524b15",
                                                "text": "Le bar est à côté du magasin."
                                            },
                                            {
                                                "example_id": "715708f4-ab32-41d0-a96c-c6e41ec96d4c",
                                                "sense_id": "e93d23b8-bf26-3dc2-96d9-95b856524b15",
                                                "text": "Marcher à côté."
                                            },
                                            {
                                                "example_id": "0e6ec8f0-6ddc-47bb-ad8f-2116d468fc46",
                                                "sense_id": "e93d23b8-bf26-3dc2-96d9-95b856524b15",
                                                "text": "Être à côté."
                                            },
                                            {
                                                "example_id": "ae4ad06f-48d5-4f50-babd-f25cb30913ba",
                                                "sense_id": "e93d23b8-bf26-3dc2-96d9-95b856524b15",
                                                "text": "Le coup passa à côté."
                                            },
                                            {
                                                "example_id": "8c4a7a4b-c618-462a-9128-28e80ee200d3",
                                                "sense_id": "e93d23b8-bf26-3dc2-96d9-95b856524b15",
                                                "text": "Au réveil, elle s'offre une courte marche dans le parc en face et un croissant à la boulangerie d'à côté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f40ccd-b319-3e56-b6f4-efb945b69e12",
                                        "entry_id": "8eb07630-941b-34c5-a5c4-87725152197a",
                                        "glosses": [
                                            "En dehors d’une activité que l’on a ou d’un centre d’intérêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcde746f-4e36-4b33-b01f-7f6130d6a541",
                                                "sense_id": "32f40ccd-b319-3e56-b6f4-efb945b69e12",
                                                "text": "À côté de l’école, certains élèves pratiquent un instrument."
                                            },
                                            {
                                                "example_id": "5b23fbab-0861-4e14-8b6d-3563bf6059a7",
                                                "sense_id": "32f40ccd-b319-3e56-b6f4-efb945b69e12",
                                                "text": "Elle avait, à côté de sa passion pour les mathématiques, un engouement certain pour le cinéma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7754488-e39b-3786-b525-000c6134617d",
                                        "entry_id": "8eb07630-941b-34c5-a5c4-87725152197a",
                                        "glosses": [
                                            "Par comparaison ; en comparant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "215af1e1-f2aa-46c2-bc7a-19fe6e4f4d3d",
                                                "sense_id": "a7754488-e39b-3786-b525-000c6134617d",
                                                "text": "Il y a dix ans, tous nous prenions encore les bateaux français, me dit-on cent fois. C’étaient les meilleurs. Aujourd’hui, Anglais, Allemands, Italiens les ont tellement distancés, que les vôtres ont l’air, à côté, de bateaux d’émigrants, mal entretenus, incommodes."
                                            },
                                            {
                                                "example_id": "3b2bf320-6ce8-45bb-91a6-959f66521b67",
                                                "sense_id": "a7754488-e39b-3786-b525-000c6134617d",
                                                "text": "Quand j'étais à Hollywood, j'ai remarqué que tous les acteurs américains ne buvaient pas. Nous, les Britanniques, on est des vrais alcolos, à côté."
                                            },
                                            {
                                                "example_id": "2f75cc57-1cbb-402c-aaad-e6036168b279",
                                                "sense_id": "a7754488-e39b-3786-b525-000c6134617d",
                                                "text": "Clémence qui, à côté, fait figure de vilain petit canard."
                                            },
                                            {
                                                "example_id": "6ada3c3c-5968-46d1-8986-6b096d895e81",
                                                "sense_id": "a7754488-e39b-3786-b525-000c6134617d",
                                                "text": "New York, à côté de ce qui nous attend, c’est de la roupie de sansonnet. Ces territoires lointains sont peuplés de tribus indigènes aux réactions incontrôlables, les Kiowas, les Cheyennes, ou les Pawnees, peut-être les pires de tous..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
