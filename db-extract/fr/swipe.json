                        "entry_id": "74273572-0220-3dbd-b9a9-51c42034bb76",
                        "glosses": [
                            "Interaction avec un écran tactile en déplaçant rapidement son doigt sur celui-ci."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b6520b98-f02e-447a-a7c1-473b5e8223ba",
                                "sense_id": "4f3e81b3-cfde-360f-ae0e-4a49c1c5bad9",
                                "text": "Ainsi, vous n’êtes peut-être qu’à quelques swipes de votre prochaine mission intérim."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f13263df-1afe-4e7c-b4a9-f20aaae31724",
                        "source_entry_id": "74273572-0220-3dbd-b9a9-51c42034bb76",
                        "source_sense_id": "4f3e81b3-cfde-360f-ae0e-4a49c1c5bad9",
