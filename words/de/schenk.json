                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "imperativ_schenken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte <w>schenk</w> mir doch noch ein Glas frisches Wasser ein.",
                            "target_lang_translations": {
                                "en": "Please <w>pour</w> me another glass of fresh water."
                            }
                        },
                        {
                            "text": "<w>Schenk</w> deinem Bruder zum Geburtstag ein spannendes Buch über Tiere.",
                            "target_lang_translations": {
                                "en": "<w>Give</w> your brother an exciting book about animals for his birthday."
                            }
                        }
                    ],
                    "common_phrases": [
