                                "target_senses": [
                                    {
                                        "sense_id": "8eb6b6c2-36b8-370a-856e-e28d535424e7",
                                        "entry_id": "dda41788-2608-3f6d-be6a-523580abb63b",
                                        "glosses": [
                                            "Someone who moderates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea4999db-aeb2-4168-884d-8b4a5c367957",
                                                "sense_id": "8eb6b6c2-36b8-370a-856e-e28d535424e7",
                                                "text": "Angling was […] a moderator of passions."
                                            },
                                            {
                                                "example_id": "21c4871a-8773-4a9e-8b22-1dcdfceb50f4",
                                                "sense_id": "8eb6b6c2-36b8-370a-856e-e28d535424e7",
                                                "text": "Instead of focusing on the stressors, as in most research on caregiving, it may be wise to focus on the likely moderators: coping, and social support between stressors and stress. It is often difficult to help an individual to solve his or her primary problem, whereas providing social support and improving coping ability is feasible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bb3fded-edea-397f-be8d-5e8588ed848a",
                                        "entry_id": "dda41788-2608-3f6d-be6a-523580abb63b",
                                        "glosses": [
