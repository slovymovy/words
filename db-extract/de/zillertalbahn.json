                    {
                        "sense_id": "a19776e0-2fb0-3b20-8baf-d47de37facdd",
                        "entry_id": "6867df24-bdc7-3b11-b28c-c8bf754278f8",
                        "glosses": [
                            "Schmalspurbahn, die von Jenbach nach Mayrhofen führt"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "56545b83-6159-4828-abe2-8a03b855138c",
                                "sense_id": "a19776e0-2fb0-3b20-8baf-d47de37facdd",
                                "text": "„Ein 27 Jahre alter Urlauber aus Belgien ist Samstagabend in Mayerhofen von einer Garnitur der Zillertalbahn erfasst und in eine angrenzende Wiese geschleudert worden.“"
                            },
                            {
                                "example_id": "c13f2ef5-2933-4cd7-ab70-5c4350f33b4b",
                                "sense_id": "a19776e0-2fb0-3b20-8baf-d47de37facdd",
                                "text": "„Teil des Konzepts ist auch die neue Zillertalbahn, die ab 2022 als erste Schmalspurbahn der Welt mit Wasserstoff fahren soll.“"
                            },
                            {
                                "example_id": "09805dbd-0ea6-4051-b7e0-a5d4308f3587",
                                "sense_id": "a19776e0-2fb0-3b20-8baf-d47de37facdd",
                                "text": "„Für die Tiroler Zillertalbahn baut Stadler fünf Triebzüge.“"
                            },
                            {
                                "example_id": "b6d11bf0-3701-4dea-8390-c9f3425b11cb",
                                "sense_id": "a19776e0-2fb0-3b20-8baf-d47de37facdd",
                                "text": "„Durch die Zillertalbahn ist das Tal an den internationalen Bahnverkehr angebunden.“"
                            }
                        ],
