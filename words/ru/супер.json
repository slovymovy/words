                    "sense_definition": "Разговорное сокращение слова <w>супергерой</w>; персонаж с необычными способностями.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В итоге «<w>суперы</w>» делятся на два лагеря: одни за контроль, другие против.",
                            "target_lang_translations": {
                                "en": "In the end, the \"<w>supers</w>\" divide into two camps: some are for control, others against.",
                                "fr": "Au final, les « <w>super-héros</w> » se divisent en deux camps : les uns pour le contrôle, les autres contre."
                            }
                        },
                        {
                            "text": "В современных фильмах <w>суперы</w> часто спасают мир от глобальных угроз.",
                            "target_lang_translations": {
                                "en": "In modern movies, <w>supers</w> often save the world from global threats.",
                                "fr": "Dans les films modernes, les <w>super-héros</w> sauvent souvent le monde de menaces planétaires."
                            }
                        }
                    ],
                    "synonyms": [
                        "супергерой"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
