                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41597a41-dd28-3a63-af9e-50655471108a",
                                        "entry_id": "c6afd802-e6d0-33b5-8eff-e083c6aa8da9",
                                        "glosses": [
                                            "present participle and gerund of shop"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
