                                                "example_id": "f10c2ccb-9f38-4ad7-b48b-50e320963bb4",
                                                "sense_id": "7b83c2ea-2a56-3af9-ab81-036d0602773e",
                                                "text": "„Allerdings trug er einen dermaßen stattlichen Schnauzer, dass dieser an eine gespaltene Autowaschbürste erinnerte.“"
                                            }
