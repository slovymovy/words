                        "sense_id": "9c9c5429-4652-3f6e-be56-2e9fbdccdded",
                        "entry_id": "e1106a5a-70dc-3b76-a14f-093636f00922",
                        "glosses": [
                            "Qualifie une molécule organique qui contient au moins un atome de phosphore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4416fa0-9bf6-46e1-8d59-222c6af983b3",
                                "sense_id": "9c9c5429-4652-3f6e-be56-2e9fbdccdded",
                                "text": "Les insecticides organophosphorés sont très toxiques pour l’homme et pour les animaux, surtout avant d’être dilués. Ils peuvent passer à travers la peau des personnes et des animaux. Faites attention quand vous les utilisez."
                            }
                        ]
                    }
