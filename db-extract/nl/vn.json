                    {
                        "sense_id": "d80d3d57-69b0-3a18-8690-d7104dd90356",
                        "entry_id": "a2138765-bfdf-3a81-9d71-bf08de1235cc",
                        "glosses": [
                            "wereldwijde organisatie waarin alle landen kunnen samenwerken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02e2c41d-9842-4e75-a4a3-3c1f1973771b",
                                "sense_id": "d80d3d57-69b0-3a18-8690-d7104dd90356",
                                "text": "In de grote conflicten van deze tijd – Gaza, Soedan, Oekraïne – spelen de VN geen rol van betekenis."
                            },
                            {
                                "example_id": "fe21d757-aa15-443f-bcf9-316207a3f6a9",
                                "sense_id": "d80d3d57-69b0-3a18-8690-d7104dd90356",
                                "text": "De VN heeft zijn hulpverleners en vrijwilligers al getraind om dit soort misstanden te signaleren."
                            },
                            {
                                "example_id": "48fb2c9c-5f42-42c7-9028-786259d13339",
                                "sense_id": "d80d3d57-69b0-3a18-8690-d7104dd90356",
                                "text": "De VN hebben hun neutrale positie opgegeven en zijn nu weggezakt in het moeras van de Somalische clan-politiek."
                            }
                        ]
                    }
