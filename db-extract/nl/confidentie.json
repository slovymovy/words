                "translations": [
                    {
                        "translation_id": "db36966c-4df3-4809-b2dc-b5a74c8a29c2",
                        "source_entry_id": "f29c21e3-a0af-3e12-9382-d17a9d953ee4",
                        "target_lang_word": "confidence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confidence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d54a281-052b-3fee-b037-1a8f8fd8e5e8",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "Self-assurance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91447330-766d-4ee2-9b41-8225eff0253b",
                                                "sense_id": "2d54a281-052b-3fee-b037-1a8f8fd8e5e8",
                                                "text": "He entered the ring with confidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "A feeling of certainty; firm trust or belief; faith."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c953efe6-64e8-4d49-99ac-8fd103c483f5",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "She had confidence it would soon end."
                                            },
                                            {
                                                "example_id": "b87f62f3-206b-4ad0-be18-546ff46a3863",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "It is better to truſt in the Lord : then to put confidence in man. / It is better to truſt in the Lord : then to put confidence in Princes."
                                            },
                                            {
                                                "example_id": "fe0ebaca-3e7d-455d-bd1d-3d022851f240",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "Khedron hesitated for a moment, wondering how far he should take Jeserac into his confidence. He knew that Jeserac was kindly and well-intentioned, but he also knew that he must be bound by the same taboos that controlled everyone on Diaspar."
                                            },
                                            {
                                                "example_id": "669172c3-6af4-459e-90db-9fb65c35f788",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6af89e55-bf6e-3c86-b402-7747c6e4b71e",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "Information held in secret; a piece of information shared but to thence be kept in secret."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a9ca2b6-ec39-4f53-acab-368b3a1a7db1",
                                                "sense_id": "6af89e55-bf6e-3c86-b402-7747c6e4b71e",
                                                "text": "In the course of these confidences it became quite plain to me I had been represented to the wife of the high dignitary, and goodness knows to how many more people besides, as an exceptional and gifted creature - a piece of good fortune for the Company - a man you don’t get hold of every day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dae91c80-8457-32d2-ac69-01719c3315d1",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "Boldness; presumption."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6d65f20-1baa-4de8-9d45-35cacc8e52ea",
                        "source_entry_id": "f29c21e3-a0af-3e12-9382-d17a9d953ee4",
                        "target_lang_word": "secret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "A piece of knowledge that is hidden and intended to be kept hidden."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f2f7f8e-b227-4100-9d3b-4837e94775a0",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "\"Can you keep a secret?\" \"Yes.\" \"So can I.\""
                                            },
                                            {
                                                "example_id": "cb8203d9-a4f6-4518-83b4-6b3c4eb08059",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "To tell our own secrets is generally folly, but that folly is without guilt; to communicate those with which we are intrusted is always treachery"
                                            },
                                            {
                                                "example_id": "0d664713-297f-48ab-9fb2-3ab73fa8412e",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "Well, mistress, I am sorry this is a matter I cannot aid you in—it goes against my conscience, and it is an affair above my condition, and beyond my management;—but I will keep your secret."
                                            },
                                            {
                                                "example_id": "ec68d0ef-7c76-4244-9f1a-bdb6e33712f6",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "Barla Von: Most people think I deal in finances, but my real currency is knowledge. I trade information and it has made me very wealthy.\nBarla Von: But the Shadow Broker is the true master. Every day, he buys and sells secrets that could topple governments, always giving them to the highest bidder."
                                            },
                                            {
                                                "example_id": "51911e71-9296-44c4-9a1c-2c54b701281c",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            },
                                            {
                                                "example_id": "a59911cd-f5c2-4b72-b98f-3ec975b1aea6",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "The storage of cryptographic secrets is one of the paramount requirements in building trustworthy systems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28fa91c8-75a2-3416-bb60-2b3693d9a299",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "The key or principle by which something is made clear; the knack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eb529b3-3cd4-4cdc-b7e7-7ad4a65b7768",
                                                "sense_id": "28fa91c8-75a2-3416-bb60-2b3693d9a299",
                                                "text": "The secret to a long-lasting marriage is compromise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "644330c6-1357-3e29-a255-a38f0e6b2009",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "Something not understood or known."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dd1c66a-1b34-45f9-bb37-452546fb3077",
                                                "sense_id": "644330c6-1357-3e29-a255-a38f0e6b2009",
                                                "text": "Thou knewſt by name, and all th' ethereal powers, / All ſecrets of the deep, all Natures works,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3027190-32b9-3de5-87b2-ec3af8e95a8a",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "Private seclusion."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a91313d-ab0a-4a17-834e-b40eec9138ff",
                                                "sense_id": "f3027190-32b9-3de5-87b2-ec3af8e95a8a",
                                                "text": "The work was done in secret, so that nobody could object."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5580da84-ca9f-3d68-94d1-71326a8bee94",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "The genital organs."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15521f03-fa88-3596-b89f-781f156781c5",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "A form of steel skullcap."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fdf0499-b829-30ad-b293-e7a47314b71e",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "Any prayer spoken inaudibly and not aloud; especially, one of the prayers in the Tridentine Mass, immediately following the \\\"orate, fratres\\\", said inaudibly by the celebrant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "secret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70f3fcfd-5e64-3bfb-b5bf-9f05bb1c82c3",
                                        "entry_id": "e99f4f55-6f38-334f-922e-1218fbd9f9ed",
                                        "glosses": [
                                            "To make or keep secret."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7a3c19d-ad79-47b9-83f0-2b2e0b7a850c",
                                                "sense_id": "70f3fcfd-5e64-3bfb-b5bf-9f05bb1c82c3",
                                                "text": "… she would unfold the silk, press it with a smooth wooden block that she'd heated in the oven, and then once more secret it away."
                                            },
                                            {
                                                "example_id": "ea941787-6ba8-461f-abe2-89de9b35271a",
                                                "sense_id": "70f3fcfd-5e64-3bfb-b5bf-9f05bb1c82c3",
                                                "text": "1986, InfoWorld, InfoWorld Media Group, Inc.\nDiskless workstations … make it difficult for individuals to copy information … onto a diskette and secret it away."
                                            },
                                            {
                                                "example_id": "407f69df-fc2c-40f5-b5e6-7f5b5a1a7678",
                                                "sense_id": "70f3fcfd-5e64-3bfb-b5bf-9f05bb1c82c3",
                                                "text": "To prevent the elixir from reaching mankind and thereby upsetting the balance of the universe, two gods secret it away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90852667-65c3-39a0-b53d-99a21d0218d5",
                                        "entry_id": "e99f4f55-6f38-334f-922e-1218fbd9f9ed",
                                        "glosses": [
                                            "To hide secretly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a853265-a364-4c17-8388-95aca7e3dff0",
                                                "sense_id": "90852667-65c3-39a0-b53d-99a21d0218d5",
                                                "text": "He was so scared for his safety he secreted arms around the house."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "secret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88413749-236c-3a3d-b7af-49d8f165e628",
                                        "entry_id": "1f5c449b-b868-31f8-bc06-cfa4346cc371",
                                        "glosses": [
                                            "Being or kept hidden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45bf33aa-12a9-4cd9-8017-4b7282890847",
                                                "sense_id": "88413749-236c-3a3d-b7af-49d8f165e628",
                                                "text": "We went down a secret passage."
                                            },
                                            {
                                                "example_id": "7bd01cc8-2776-4755-aabd-a7ee81e39462",
                                                "sense_id": "88413749-236c-3a3d-b7af-49d8f165e628",
                                                "text": "The ſecret things belong unto the Lord our God; but thoſe things which are reuealed belong unto us, and to our children for euer, that wee may doe all the words of this Law."
                                            },
                                            {
                                                "example_id": "236b77a1-2d2c-4b80-9cf6-ea67d6976464",
                                                "sense_id": "88413749-236c-3a3d-b7af-49d8f165e628",
                                                "text": "The original family who had begun to build a palace to outrival Nonesuch had died out before they had put up little more than the gateway, so that the actual structure which had come down to posterity retained the secret magic of a promise rather than the overpowering splendour of a great architectural achievement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6adb494-b6ec-3d17-b2de-582bb019f4e6",
                                        "entry_id": "1f5c449b-b868-31f8-bc06-cfa4346cc371",
                                        "glosses": [
                                            "Withdrawn from general intercourse or notice; in retirement or secrecy; secluded."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd64e57e-0e31-4c77-9522-2995aaa7a919",
                                                "sense_id": "b6adb494-b6ec-3d17-b2de-582bb019f4e6",
                                                "text": "Sing Heav'nly Muſe, that on the secret top / Of Oreb, or of Sinai, didſt inſpire / That Shepherd, who firſt taught the choſen Seed, / In the Beginning how the Heav'ns and Earth / Roſe out of Chaos: [...]"
                                            },
                                            {
                                                "example_id": "163dfda9-3a6f-4fbb-bd14-d10e34776780",
                                                "sense_id": "b6adb494-b6ec-3d17-b2de-582bb019f4e6",
                                                "text": "secret in her sapphire cell"
                                            },
                                            {
                                                "example_id": "61c85e37-968b-4637-87c2-97a593e22fb6",
                                                "sense_id": "b6adb494-b6ec-3d17-b2de-582bb019f4e6",
                                                "text": "\"He was a secret man, Alexander—a secret, silent man,\" he continued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c83e181-6e31-3f73-8add-2c8a87c141cb",
                                        "entry_id": "1f5c449b-b868-31f8-bc06-cfa4346cc371",
                                        "glosses": [
                                            "Faithful to a secret; not inclined to divulge or betray confidence; secretive, separate, apart."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b744eb62-f2ba-4a52-9274-c34e46b21b7d",
                                                "sense_id": "7c83e181-6e31-3f73-8add-2c8a87c141cb",
                                                "text": "What neede we any ſpurre, but our owne cauſe / To pricke vs to redreſſe? What other Bond / Than ſecret Romans, that haue ſpoke the Word, / And will not palter?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4afe6c5-8d03-34c1-b416-ef6c058245fd",
                                        "entry_id": "1f5c449b-b868-31f8-bc06-cfa4346cc371",
                                        "glosses": [
                                            "Separate; distinct."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56657805-9368-4c03-a77b-5b4bcd618608",
                                                "sense_id": "c4afe6c5-8d03-34c1-b416-ef6c058245fd",
                                                "text": "They suppose two other divine hypostases superior thereunto, which were perfectly secret from matter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
