                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7600ac52-d35d-4f3f-a85c-d296c4a15008",
                                "sense_id": "65489766-a58a-39fe-b3ba-c47140f0b370",
                                "text": "Страсть к самосохранению выразилась в соглашательстве инстинкта и совести."
                            },
                            {
                                "example_id": "03c41e76-8570-46b0-a1b3-3c964fb8c0dd",
                                "sense_id": "65489766-a58a-39fe-b3ba-c47140f0b370",
                                "text": "Соглашательство времен Керенского отдавало власть империалистской буржуазии, а вопрос о власти есть коренной вопрос всякой революции."
                            }
                        ]
                    }
