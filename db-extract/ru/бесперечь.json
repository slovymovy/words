        "ru-extract.jsonl": [
            {
                "entry_id": "9d97c2cf-1850-31ea-a99e-80bf865bf128",
                "word": "бесперечь",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ab872a0d-5875-31f4-989d-1677630eac0e",
                        "entry_id": "9d97c2cf-1850-31ea-a99e-80bf865bf128",
                        "glosses": [
                            "прост. беспрестанно, беспрерывно; постоянно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1e59e3-f373-472d-80af-f1bc0792f67f",
                                "sense_id": "ab872a0d-5875-31f4-989d-1677630eac0e",
                                "text": "— Что за напасть, братцы, вот почитай месяц целый, как дождь льёт бесперечь…"
                            },
                            {
                                "example_id": "261a7cca-462d-436d-8bdd-25c98dbf1d6e",
                                "sense_id": "ab872a0d-5875-31f4-989d-1677630eac0e",
                                "text": "— Мужичонка совсем негодный!.. Бесперечь по кабакам!.. Беспокойство было — не приведи господи!.."
                            },
                            {
                                "example_id": "1e1e95f3-b422-4b57-8e91-e46c779bba40",
                                "sense_id": "ab872a0d-5875-31f4-989d-1677630eac0e",
                                "text": "Околодочный который раз спрашивает: «Какая такая у вас дама бесперечь то в шестом, то в седьмом часу домой приходит?..»"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdc62466-ac0c-4f08-9648-3ed1320afabe",
                        "source_entry_id": "9d97c2cf-1850-31ea-a99e-80bf865bf128",
                        "source_sense_id": "ab872a0d-5875-31f4-989d-1677630eac0e",
                        "target_lang_word": "continuously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                        "entry_id": "67d61252-9945-34ea-a8f4-233d95259065",
                                        "glosses": [
                                            "Without pause."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3f9061-309d-45bb-812d-f6df62058290",
                                                "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                                "text": "The river continuously flows to the sea, it will never pause to let us cross on dry land."
                                            },
                                            {
                                                "example_id": "5bf09a40-14e7-44b1-b69f-518f212f4abe",
                                                "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                                "text": "In the year 1633, the Bridget Nuns, near Xanthus, behaved like sheep, jumping about and bleating continuously."
                                            },
                                            {
                                                "example_id": "05a70050-46b3-4ba7-889e-f8bdfbe2c66c",
                                                "sense_id": "b57111cb-32df-399d-b33c-2a81e071db8b",
                                                "text": "\"We continuously strive to improve our processes and indeed have updated our systems accordingly. Ultimately, however, it is for the student to make a proper declaration to SLC [Student Loans Company]^([sic]) to draw down funding,\" LSST said in a statement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6bdc2d9-7e71-45dc-a053-4b0848737d33",
                        "source_entry_id": "9d97c2cf-1850-31ea-a99e-80bf865bf128",
