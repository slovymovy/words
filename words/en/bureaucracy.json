{
    "word_family": [
        "bureaucrat",
        "bureaucratic",
        "bureaucratically",
        "bureaucratize",
        "bureaucratization"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4bff55c5-ed33-3863-ab79-a92424f708da",
                    "sense_definition": "A system of administration based on organization into bureaus, division of labor, and a hierarchy of authority.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "administrative_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government replaced the old system of patronage with a modern <w>bureaucracy</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство заменило старую систему покровительства современной <w>бюрократией</w>."
                            }
                        },
                        {
                            "text": "Large corporations often develop a complex <w>bureaucracy</w> to manage their global operations.",
                            "target_lang_translations": {
                                "ru": "Крупные корпорации часто создают сложный <w>административный аппарат</w> для управления своими глобальными операциями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "government bureaucracy",
                        "corporate bureaucracy",
                        "vast bureaucracy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система управления, основанная на организации по отделам, разделении труда и иерархии власти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюрократия",
                                "target_lang_sense_clarification": "система управления"
                            },
                            {
                                "target_lang_word": "административный аппарат",
                                "target_lang_sense_clarification": "структура управления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3334cd00-d7e0-3a13-9cc6-248068ae87f0",
                    "sense_definition": "Excessive official routine and fixed rules that result in delay and inaction.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inefficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law aims to cut through the <w>bureaucracy</w> that prevents small businesses from growing.",
                            "target_lang_translations": {
                                "ru": "Новый закон направлен на то, чтобы покончить с <w>бюрократизмом</w>, который мешает росту малого бизнеса."
                            }
                        },
                        {
                            "text": "Many citizens are frustrated by the endless <w>bureaucracy</w> required to apply for a simple permit.",
                            "target_lang_translations": {
                                "ru": "Многие граждане разочарованы бесконечной <w>волокитой</w>, необходимой для получения простого разрешения."
                            }
                        }
                    ],
                    "synonyms": [
                        "papyrocracy"
                    ],
                    "common_phrases": [
                        "cut through bureaucracy",
                        "endless bureaucracy",
                        "unnecessary bureaucracy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерная официальная рутина и жесткие правила, приводящие к задержкам и бездействию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюрократизм",
                                "target_lang_sense_clarification": "излишний формализм"
                            },
                            {
                                "target_lang_word": "волокита",
                                "target_lang_sense_clarification": "затягивание дел"
                            },
                            {
                                "target_lang_word": "бюрократия",
                                "target_lang_sense_clarification": "сложные формальности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d97e8614-8d64-3ea9-bd22-41acdba6a90e",
                    "sense_definition": "The collective body of officials and administrators, especially those working for a government.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "administrative_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The federal <w>bureaucracy</w> is responsible for implementing the policies decided by parliament.",
                            "target_lang_translations": {
                                "ru": "Федеральное <w>чиновничество</w> несет ответственность за реализацию политики, принятой парламентом."
                            }
                        },
                        {
                            "text": "A professional <w>bureaucracy</w> is essential for the stable functioning of a modern state.",
                            "target_lang_translations": {
                                "ru": "Профессиональная <w>бюрократия</w> необходима для стабильного функционирования современного государства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "federal bureaucracy",
                        "state bureaucracy",
                        "civil service bureaucracy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность должностных лиц и администраторов, особенно работающих в правительстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чиновничество",
                                "target_lang_sense_clarification": "корпус чиновников"
                            },
                            {
                                "target_lang_word": "бюрократия",
                                "target_lang_sense_clarification": "слой госслужащих"
                            },
                            {
                                "target_lang_word": "госаппарат",
                                "target_lang_sense_clarification": "государственные служащие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}