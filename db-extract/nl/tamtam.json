                        "sense_id": "1e3681ed-faee-3bb9-80c3-8640d2bbe0ef",
                        "entry_id": "3e457000-8e4b-3de9-b9e8-4f6f71b13bec",
                        "glosses": [
                            "met een hoop ophef, lawaai en gedoe"
