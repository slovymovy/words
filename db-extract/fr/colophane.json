        "fr-extract.jsonl": [
            {
                "entry_id": "ad88a0a6-6a82-306d-9c8f-f54cc31108e0",
                "word": "colophane",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "17d7846c-ed8d-45bf-b022-7079fc37582d",
                        "entry_id": "ad88a0a6-6a82-306d-9c8f-f54cc31108e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "colophanes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6281545d-bc9e-35f0-9158-d6af65ff19d4",
                        "entry_id": "ad88a0a6-6a82-306d-9c8f-f54cc31108e0",
                        "glosses": [
                            "Résidu solide issu de la distillation de la térébenthine brute — ou parfois d’autres oléorésines —, il reste au fond des alambics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b18094e6-c4ad-49e6-b595-20d5fe6b8e6f",
                                "sense_id": "6281545d-bc9e-35f0-9158-d6af65ff19d4",
                                "text": "La colophane est le résidu de la distillation des oléo-résines (térébenthines) des conifères. Lorsqu'on a distillé ces oléo-résines, on coule les résidus sur des filtres à mailles métalliques très serrées et on laisse durcir le produit obtenu par refroidissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee1ba837-b57c-3355-9a6e-3f666181f090",
                        "entry_id": "ad88a0a6-6a82-306d-9c8f-f54cc31108e0",
                        "glosses": [
                            "Sorte de résine dont on se sert pour enduire les crins de l’archet d’un instrument à cordes ou les mains des sportifs afin de mieux agripper les objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab80630-f8f6-4df1-92ad-391cfecd0522",
                                "sense_id": "ee1ba837-b57c-3355-9a6e-3f666181f090",
                                "text": "Sans compter que les voleurs ont pris, en même temps que mon pantalon, ma colophane qui s’y trouvait !"
                            },
                            {
                                "example_id": "77c4db79-32bb-41ba-9c51-5cd057d6704e",
                                "sense_id": "ee1ba837-b57c-3355-9a6e-3f666181f090",
                                "text": "Derrière l’apparente magie de ces actions se cache un produit dont raffolent les handballeurs : la colophane."
                            }
                        ]
                    },
                    {
                        "sense_id": "88175477-4c69-3b9d-a0c8-736bc8cf6d5e",
                        "entry_id": "ad88a0a6-6a82-306d-9c8f-f54cc31108e0",
                        "glosses": [
                            "Nom donné à des arbres de la famille des burséracées, endémiques de l'île Maurice."
                        ],
                        "tags": [
                            "Île Maurice"
                        ],
                        "note": "On trouve plus souvent le nom composé bois colophane",
                        "examples": [
                            {
                                "example_id": "014cdcc3-d32a-4a3a-ad37-a41dcf0e6461",
                                "sense_id": "88175477-4c69-3b9d-a0c8-736bc8cf6d5e",
                                "text": "Autour de moi sont les ébènes aux troncs lisses, les térébinthes, les colophanes, les figuiers sauvages, les sycomores."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b723cf80-1a55-4ed6-9742-3d73708b7a85",
                        "source_entry_id": "ad88a0a6-6a82-306d-9c8f-f54cc31108e0",
                        "target_lang_word": "Kolophonium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kolophonium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff1f78d-2950-3221-bdaa-ed320503ccdc",
                                        "entry_id": "eb7c24ff-41f1-3ed4-91b4-443011b6a6a2",
                                        "glosses": [
                                            "amorphes, sprödes, glasiges Produkt aus gelbem, rotem bis schwarzbraunem Baumharz, das zum Bestreichen von Geigenbögen und anderen technischen Zwecken dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3860f1e0-3a1d-4379-8645-8d76d1c77b19",
                                                "sense_id": "3ff1f78d-2950-3221-bdaa-ed320503ccdc",
                                                "text": "Rätselhaft anmutende Erscheinungen wie etwa die fischgrätenförmigen Abschabungen an Kiefernstämmen werden in kurzen Artikeln erläutert: Sie dienen der Gewinnung von Harz, das als Grundstoff für die Herstellung von Terpentin und Kolophonium benötigt wird."
                                            },
                                            {
                                                "example_id": "44f40856-6744-460f-9235-e6c50e9031ee",
                                                "sense_id": "3ff1f78d-2950-3221-bdaa-ed320503ccdc",
                                                "text": "Die Akustik sei nicht mehr so hallig gewesen wie noch in der Probe, sondern sehr trocken. Er hatte zuviel Kolophonium auf dem Bogen, sein Cello klang hart und sprach nicht richtig an."
                                            },
                                            {
                                                "example_id": "1d52e3b3-a737-4c6a-85d1-b87cebc2914b",
                                                "sense_id": "3ff1f78d-2950-3221-bdaa-ed320503ccdc",
                                                "text": "Und rasch, auf den leichten, mit Kolophonium isolierten Schuhen, zerstreuen sich die Knaben."
                                            },
                                            {
                                                "example_id": "3d765d20-da8d-4ca2-ba74-ffd1833efd48",
                                                "sense_id": "3ff1f78d-2950-3221-bdaa-ed320503ccdc",
                                                "text": "Die meisten Unverträglichen bei Kosmetika gehen auf Allergien zurück. Neben Duftstoffen werden vor allem Perubalsam, Kolophonium, Korbblütler und Teebaumöl für allergische Reaktionen verantwortlich gemacht."
                                            },
                                            {
                                                "example_id": "6015be9f-b145-466c-90e3-6c2f4d037d91",
                                                "sense_id": "3ff1f78d-2950-3221-bdaa-ed320503ccdc",
                                                "text": "Warum sitzen sie nicht zu Hause, trinken ein Glas Wein oder machen einen Spaziergang, anstatt ihre Lungen mit dem hier herrschenden Duftcocktail aus Terpentin, Abdecklack und Kolophonium zu strapazieren?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93638e4c-f93c-43a8-8ca8-f07d3b9d0d3a",
                        "source_entry_id": "ad88a0a6-6a82-306d-9c8f-f54cc31108e0",
                        "target_lang_word": "rosin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rosin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5bca422-1d75-362a-8960-e73a4bb3a758",
                                        "entry_id": "618eb879-9a02-3c4f-8cce-a1eb1694c04c",
                                        "glosses": [
                                            "A solid form of resin, obtained from liquid resin by vaporizing its volatile components."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a6727a5-c6a7-4d2e-b1da-2e7f02e61ce1",
                                                "sense_id": "a5bca422-1d75-362a-8960-e73a4bb3a758",
                                                "text": "The action of the bow therefore depends almost entirely upon the application of rosin and upon its frictional properties. Violin rosin is a natural gum obtained from conifers such as larch that produce turpentine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a957e45a-01b9-310b-964a-3307193f6d23",
                                        "entry_id": "618eb879-9a02-3c4f-8cce-a1eb1694c04c",
                                        "glosses": [
                                            "Resin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ebebf90-b0fc-4f89-b196-a434b8060b6b",
                                                "sense_id": "a957e45a-01b9-310b-964a-3307193f6d23",
                                                "text": "‘It is delicate,’ said Pansa, ‘but there is perhaps the least particle too much of rosin in its flavor.’"
                                            },
                                            {
                                                "example_id": "e48df3a9-1364-48f4-8d61-500b54f2c7f2",
                                                "sense_id": "a957e45a-01b9-310b-964a-3307193f6d23",
                                                "text": "From three o'clock onward they would be burning rosin and pitch pine (the sign of preparation), and so one had the picturesque spectacle of a rank, some two or three miles long, of tall, ascending columns of coal-black smoke; […]"
                                            },
                                            {
                                                "example_id": "cbf7c9c3-cc83-4a9c-8b1e-bba530471abf",
                                                "sense_id": "a957e45a-01b9-310b-964a-3307193f6d23",
                                                "text": "A thick, fat smoke oozed out from the fire, and a heavy smell of burned rosin and singed hair filled the air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rosin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9442b568-d0d4-360a-9b56-70fa074b91d1",
                                        "entry_id": "c2d2dce3-8bb6-344b-b410-7b516c19bea9",
                                        "glosses": [
                                            "To apply rosin to (something); to rub or cover with rosin."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd60e17-d89b-4b08-8e5e-6c64654c5f0d",
                                                "sense_id": "9442b568-d0d4-360a-9b56-70fa074b91d1",
                                                "text": "We waited expectantly as the guest violinist rosined his bow in preparation for playing."
                                            },
                                            {
                                                "example_id": "0240fd08-2940-447f-aeba-472406dd366c",
                                                "sense_id": "9442b568-d0d4-360a-9b56-70fa074b91d1",
                                                "text": "The devil opened up his case and he said, \"I'll start this show.\"\nAnd fire flew from his fingertips as he rosined up his bow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8b9a3fb-5146-4166-a90a-875649b12f45",
