                                        "entry_id": "9bf7c4b4-4500-369d-81dc-8490421be46c",
                                        "glosses": [
                                            "een persoon die meestal op verzoek van de nabestaanden, als die er zijn, de begrafenis van overledenen vanaf het afleggen tot en met de begrafenis of crematie verzorgt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e828d8-3cf3-4845-aab8-d5b9b5dbcfc6",
                                                "sense_id": "1671a77d-6f18-363b-8f8b-7e4bfe5af4fe",
                                                "text": "Mijn vader ruziede met de uitvaartondernemer."
                                            },
                                            {
                                                "example_id": "f0c9e6d8-07e5-4c32-8c35-32220ed83bbf",
                                                "sense_id": "1671a77d-6f18-363b-8f8b-7e4bfe5af4fe",
                                                "text": "Gianluca Parente is uitvaartondernemer in Bergamo. Hij vertelt dat familieleden geen afscheid meer kunnen nemen. \"We transporteren de overledenen direct van hun sterfplaats naar de begraafplaats.\""
                                            }
                                        ]
                                    }
                                ]
