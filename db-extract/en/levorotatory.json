                "word": "levorotatory",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "501536ce-5d91-3403-9fa5-dd63b2bf5003",
                        "entry_id": "4e395f0a-e396-3bc2-affe-79c6f98136d4",
                        "glosses": [
                            "(of an optically active compound or crystal) That rotates the plane of polarized light to the left, or counter-clockwise. Notation: (−) or formerly lowercase l-."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d09e9b8a-cefe-4f43-ae8d-a20e7223a2ae",
                                "sense_id": "501536ce-5d91-3403-9fa5-dd63b2bf5003",
                                "text": "Levofloxacin is the levorotatory enantiomer of the medication ofloxacin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06df660e-68c8-48c2-9759-f53652132c7b",
