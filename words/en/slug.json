{
    "word_family": [
        "sluggish",
        "sluggishness",
        "sluggard",
        "slugger",
        "slugfest"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "282c5fc3-59e1-3039-84a8-7dd16384d3fd",
                    "sense_definition": "Any of many gastropod mollusks, having no (or only a rudimentary) shell.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the heavy rain, I found a large <w>slug</w> crawling across the garden path.",
                            "target_lang_translations": {
                                "ru": "После сильного дождя я нашел большого <w>слизня</w>, ползущего по садовой дорожке."
                            }
                        },
                        {
                            "text": "The <w>slug</w> left a shiny trail of slime on the lettuce leaves in the vegetable patch.",
                            "target_lang_translations": {
                                "ru": "<w>Слизень</w> оставил блестящий след слизи на листьях салата в огороде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "garden slug",
                        "sea slug",
                        "slime trail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из множества брюхоногих моллюсков, не имеющий (или имеющий лишь рудиментарную) раковину."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слизень",
                                "target_lang_sense_clarification": "биологический термин"
                            },
                            {
                                "target_lang_word": "слизняк",
                                "target_lang_sense_clarification": "общеупотребительное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9a4ff3e-d17f-3e59-b57a-490042f013b2",
                    "sense_definition": "A shot of a drink, usually alcoholic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a quick <w>slug</w> of whiskey to steady his nerves before the performance.",
                            "target_lang_translations": {
                                "ru": "Он быстро выпил <w>глоток</w> виски, чтобы успокоить нервы перед выступлением."
                            }
                        },
                        {
                            "text": "She poured herself a <w>slug</w> of rum and sat down by the fireplace.",
                            "target_lang_translations": {
                                "ru": "Она налила себе <w>стопку</w> рома и села у камина."
                            }
                        }
                    ],
                    "synonyms": [
                        "nip & Thesaurus:drink"
                    ],
                    "common_phrases": [
                        "slug of whiskey",
                        "slug of rum"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for a quick gulp of alcohol"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Порция напитка, обычно алкогольного; глоток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глоток",
                                "target_lang_sense_clarification": "большой глоток"
                            },
                            {
                                "target_lang_word": "стопка",
                                "target_lang_sense_clarification": "порция крепкого алкоголя"
                            },
                            {
                                "target_lang_word": "рюмка",
                                "target_lang_sense_clarification": "небольшая порция"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb819f62-03f3-36ee-9a95-a8b634c3ee03",
                    "sense_definition": "A bullet or other projectile fired from a firearm; in modern usage, generally refers to a shotgun slug.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ammunition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter loaded a heavy <w>slug</w> into his shotgun for the deer season.",
                            "target_lang_translations": {
                                "ru": "Охотник зарядил тяжелую <w>пулю</w> в свое ружье для сезона охоты на оленей."
                            }
                        },
                        {
                            "text": "A solid metal <w>slug</w> is designed to transfer maximum energy to the target on impact.",
                            "target_lang_translations": {
                                "ru": "Цельнометаллическая <w>болванка</w> предназначена для передачи максимальной энергии цели при ударе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shotgun slug",
                        "metal slug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пуля или другой снаряд, выпущенный из огнестрельного оружия; в современном понимании обычно пуля для гладкоствольного ружья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пуля",
                                "target_lang_sense_clarification": "снаряд для оружия"
                            },
                            {
                                "target_lang_word": "болванка",
                                "target_lang_sense_clarification": "цельнометаллический снаряд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3441f311-5208-34b1-8cdb-bc5e0b2a404d",
                    "sense_definition": "The last part of a clean URL, the displayed resource name, similar to a filename.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should optimize the <w>slug</w> of your blog post to improve its search engine ranking.",
                            "target_lang_translations": {
                                "ru": "Вам следует оптимизировать <w>слаг</w> вашего поста в блоге, чтобы улучшить его позиции в поисковых системах."
                            }
                        },
                        {
                            "text": "The developer changed the URL <w>slug</w> from a random ID to a descriptive title.",
                            "target_lang_translations": {
                                "ru": "Разработчик изменил <w>слаг</w> URL-адреса со случайного ID на описательный заголовок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "URL slug",
                        "clean slug"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in web development"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последняя часть понятного URL-адреса, отображаемое имя ресурса, похожее на имя файла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слаг",
                                "target_lang_sense_clarification": "технический термин в веб-разработке"
                            },
                            {
                                "target_lang_word": "ЧПУ",
                                "target_lang_sense_clarification": "человекопонятный URL"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e716142-5b2a-3e2d-a600-f7b30e7ecaa0",
                    "sense_definition": "A slow, lazy person; a <w>sluggard</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get out of bed, you little <w>slug</w>, or we will be late for the meeting!",
                            "target_lang_translations": {
                                "ru": "Вставай с кровати, <w>лентяй</w> ты этакий, иначе мы опоздаем на встречу!"
                            }
                        },
                        {
                            "text": "He was known as a bit of a <w>slug</w> who never finished his chores on time.",
                            "target_lang_translations": {
                                "ru": "Его знали как порядочного <w>слизняка</w>, который никогда не выполнял свои обязанности вовремя."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal insult for laziness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медлительный, ленивый человек; бездельник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слизняк",
                                "target_lang_sense_clarification": "переносное, уничижительное"
                            },
                            {
                                "target_lang_word": "лентяй",
                                "target_lang_sense_clarification": "ленивый человек"
                            },
                            {
                                "target_lang_word": "копуша",
                                "target_lang_sense_clarification": "медлительный человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dbadaf9-2252-3af8-afe6-81bab9fdae1a",
                    "sense_definition": "A title, name or header, a catchline, a short phrase or title to indicate the content of a newspaper or magazine story for editing use.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "journalism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor wrote a short <w>slug</w> at the top of the page to identify the breaking news story.",
                            "target_lang_translations": {
                                "ru": "Редактор написал короткий <w>заголовок</w> в верхней части страницы, чтобы обозначить срочную новость."
                            }
                        },
                        {
                            "text": "Every draft in the newsroom must have a unique <w>slug</w> for tracking purposes.",
                            "target_lang_translations": {
                                "ru": "Каждый черновик в редакции должен иметь уникальный <w>идентификатор</w> для целей отслеживания."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "journalism jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заголовок, название или короткая фраза, указывающая на содержание газетного или журнального материала для внутреннего использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заголовок",
                                "target_lang_sense_clarification": "рабочее название статьи"
                            },
                            {
                                "target_lang_word": "кетчлайн",
                                "target_lang_sense_clarification": "журналистский жаргон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f01915c3-a976-3357-bc3d-06c19444baa4",
                    "sense_definition": "The imperial (English) unit of mass that accelerates by 1 foot per second squared (1 ft/s²) when a force of one pound-force (lbf) is exerted on it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the physics problem, we had to convert the weight in pounds to mass in <w>slugs</w>.",
                            "target_lang_translations": {
                                "ru": "В физической задаче нам нужно было перевести вес в фунтах в массу в <w>слагах</w>."
                            }
                        },
                        {
                            "text": "The <w>slug</w> is a less common unit of mass compared to the kilogram used in the metric system.",
                            "target_lang_translations": {
                                "ru": "<w>Слаг</w> — менее распространенная единица массы по сравнению с килограммом, используемым в метрической системе."
                            }
                        }
                    ],
                    "synonyms": [
                        "geepound"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific/engineering unit"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Британская единица измерения массы, которая ускоряется на 1 фут в секунду в квадрате при воздействии силы в один фунт-силу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слаг",
                                "target_lang_sense_clarification": "единица массы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24040efd-ea59-3fea-b8c9-cc2ea761985d",
                    "sense_definition": "A hard blow, usually with the fist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer delivered a powerful <w>slug</w> to his opponent's jaw in the third round.",
                            "target_lang_translations": {
                                "ru": "Боксер нанес мощный <w>удар</w> в челюсть противника в третьем раунде."
                            }
                        },
                        {
                            "text": "He took a <w>slug</w> to the ribs during the scuffle outside the bar.",
                            "target_lang_translations": {
                                "ru": "Он получил <w>удар</w> по ребрам во время потасовки у бара."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for a punch"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный удар, обычно кулаком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "сильный удар кулаком"
                            },
                            {
                                "target_lang_word": "затрещина",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c942044-5481-3fde-a11b-e4cd555653c6",
                    "sense_definition": "To hit very hard, usually with the fist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He insulted my family, so I <w>slugged</w> him right in the face.",
                            "target_lang_translations": {
                                "ru": "Он оскорбил мою семью, поэтому я <w>врезал</w> ему прямо по лицу."
                            }
                        },
                        {
                            "text": "The angry fan tried to <w>slug</w> the referee after the controversial call.",
                            "target_lang_translations": {
                                "ru": "Разгневанный фанат попытался <w>ударить</w> судью после спорного решения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень сильно ударить, обычно кулаком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врезать",
                                "target_lang_sense_clarification": "разговорное, сильно ударить"
                            },
                            {
                                "target_lang_word": "съездить",
                                "target_lang_sense_clarification": "разговорное, нанести удар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44c10b5c-bd1b-3e6f-a9d2-bbc7b495f1ec",
                    "sense_definition": "To drink quickly; to gulp; to down.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>slugged</w> back the rest of his beer and stood up to leave.",
                            "target_lang_translations": {
                                "ru": "Он <w>осушил</w> остатки пива и встал, чтобы уйти."
                            }
                        },
                        {
                            "text": "She <w>slugged</w> down the cold water after finishing her long run.",
                            "target_lang_translations": {
                                "ru": "Она жадно <w>выпила</w> холодную воду после долгой пробежки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slug back",
                        "slug down"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро выпить; проглотить залпом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлебнуть",
                                "target_lang_sense_clarification": "быстро выпить"
                            },
                            {
                                "target_lang_word": "осушить",
                                "target_lang_sense_clarification": "выпить до дна"
                            },
                            {
                                "target_lang_word": "заглотить",
                                "target_lang_sense_clarification": "быстро проглотить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81dc38b6-f5a5-32ee-a04b-a09e06a73ff7",
                    "sense_definition": "To take part in casual carpooling; to form ad hoc, informal carpools for commuting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many commuters in the D.C. area choose to <w>slug</w> to work to save on gas and tolls.",
                            "target_lang_translations": {
                                "ru": "Многие жители пригородов Вашингтона предпочитают <w>ездить попутками</w> на работу, чтобы сэкономить на бензине и дорожных сборах."
                            }
                        },
                        {
                            "text": "I have been <w>slugging</w> to my job for years because the HOV lanes are much faster.",
                            "target_lang_translations": {
                                "ru": "Я годами <w>подсаживаюсь попутчиком</w>, чтобы добраться до работы, потому что полосы для машин с пассажирами намного быстрее."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US, specifically Washington D.C. area"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в неформальном совместном использовании автомобилей; попутчество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсаживаться",
                                "target_lang_sense_clarification": "в качестве попутчика"
                            },
                            {
                                "target_lang_word": "ездить попуткой",
                                "target_lang_sense_clarification": "использовать неформальный карпулинг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}