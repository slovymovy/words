                "senses": [
                    {
                        "sense_id": "ef73bafd-b9e7-3e12-853a-54d3b8d175f2",
                        "entry_id": "419f7c78-5d73-3aa8-86d9-8fc341082868",
                        "glosses": [
                            "Qui possède deux allèles différents d’un gène sur un même locus pour chacun de ses chromosomes homologues."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "b4bf4f2f-3e87-46a3-91c8-061b3a169185",
                                "sense_id": "ef73bafd-b9e7-3e12-853a-54d3b8d175f2",
                                "text": "En cas de transmission récessive liée à l’X, les femmes sont très souvent homozygotes et n’expriment pas la maladie, tandis que les hommes sont forcément hétérozygotes et expriment toujours la maladie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a55f004-fd7f-43c8-8e7b-c3ece5825f0b",
                        "source_entry_id": "419f7c78-5d73-3aa8-86d9-8fc341082868",
                        "source_sense_id": "ef73bafd-b9e7-3e12-853a-54d3b8d175f2",
                        "target_lang_word": "heterozygous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heterozygous",
