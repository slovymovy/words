                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8569604d-1afd-4a5c-b387-0e61c0c067e6",
                                                "sense_id": "ce8e0234-e3d1-34a8-bfaf-3870908b5fd4",
                                                "text": "Musharraf erklärte jetzt, der Terroristenchef halte sich vermutlich in der […] Provinz Kunar […] auf."
