                            {
                                "target_word": "аплодисменты",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dc79c5d7-3f7f-37a5-adc0-34c69eed9a97",
                                        "entry_id": "7987c795-9f6c-362c-8288-e2c1cfde20b1",
                                        "glosses": [
                                            "рукоплескания в знак одобрения или приветствия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ee2d7f0-35cb-4181-a5e8-263f227ac20a",
                                                "sense_id": "dc79c5d7-3f7f-37a5-adc0-34c69eed9a97",
                                                "text": "Речь была встречена бурными аплодисментами, переходящими в овацию."
                                            },
                                            {
                                                "example_id": "df581d7c-472b-4450-a047-dff8237d2fe9",
                                                "sense_id": "dc79c5d7-3f7f-37a5-adc0-34c69eed9a97",
                                                "text": "После этого кот раскланялся, шаркнув правой задней лапой, и вызвал неимоверный аплодисмент."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba025cbd-573f-4247-aacd-163edbf2ddc2",
                        "source_entry_id": "d8a30cd9-0a41-38c9-b563-fa53d1d7768a",
                        "source_sense_id": "99ce8c3e-9abb-37e8-9d9e-a93f37c4d45c",
                        "target_lang_word": "рукоплескание",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рукоплескание",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d1e975ee-e637-3039-880c-7ffa7447e2d9",
                                        "entry_id": "3ad07ba9-414b-3fe5-9c1f-67d959aca68d",
                                        "glosses": [
                                            "то же, что рукоплескания; хлопки в ладоши в знак одобрения, приветствия; аплодисменты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "487b936c-cc08-4488-b756-d8edfd334796",
                                                "sense_id": "d1e975ee-e637-3039-880c-7ffa7447e2d9",
                                                "text": "И если тебе импонирует рукоплескание площади, следует понимать, что твои побуждения, твое поведение оцениваются уже по особу счету."
                                            },
                                            {
                                                "example_id": "576f8034-8898-4113-879c-65a2ecd8032c",
                                                "sense_id": "d1e975ee-e637-3039-880c-7ffa7447e2d9",
                                                "text": "Вторая лекция была поразительно хороша, и на третьей он был встречен единодушным рукоплесканием…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
