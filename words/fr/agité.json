                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "nervioso",
                                "target_lang_sense_clarification": "por nervios o tensión"
                            },
                            {
                                "target_lang_word": "agitado",
                                "target_lang_sense_clarification": "alterado emocionalmente, muy visible"
                            },
                            {
                                "target_lang_word": "inquieto",
                                "target_lang_sense_clarification": "incapaz de calmarse o relajarse"
                            }
