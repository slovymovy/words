                ],
                "senses": [
                    {
                        "sense_id": "ebea349d-0c2f-36b1-a435-92fdd3d91499",
                        "entry_id": "356d6dd7-553c-33eb-9b9d-21c71870cc98",
                        "glosses": [
                            "Person oder Sache, die neu hinzugekommen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493ed51a-8c67-4f53-99e3-b3ae98b4f3df",
                                "sense_id": "ebea349d-0c2f-36b1-a435-92fdd3d91499",
                                "text": "„Die Vereinsführung schwärmt vom Talent ihres Neuzugangs.“"
                            },
                            {
                                "example_id": "8e950d00-0147-4e25-84c7-8d95f761936c",
                                "sense_id": "ebea349d-0c2f-36b1-a435-92fdd3d91499",
                                "text": "„Für Fenerbahce wäre João Pedro der fünfte Neuzugang in der Offensive und für Galatasaray die vierte Absage in wenigen Wochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1700cc78-99b7-450d-9cbe-09a5c6564c83",
                        "source_entry_id": "356d6dd7-553c-33eb-9b9d-21c71870cc98",
                        "source_sense_id": "ebea349d-0c2f-36b1-a435-92fdd3d91499",
                        "source_sense_description": "Person oder Sache, die neu hinzugekommen ist",
                        "target_lang_word": "nouveau venu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nouveau venu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "745e7351-edb3-3704-9353-624269b6fbb8",
                                        "entry_id": "60f4ed4b-5598-3b28-8730-cc8b5a3d1523",
                                        "glosses": [
                                            "Celui qui vient d’arriver dans un lieu ou d’être admis dans un groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5211049f-d522-4b35-8e91-2fd6b4c2510e",
                                                "sense_id": "745e7351-edb3-3704-9353-624269b6fbb8",
                                                "text": "Pendant que le nouveau venu se débitait à lui-même ce monologue, un autre cavalier, entré par l’autre bout de la rue, […], s’arrêtait et demeurait aussi en extase devant l’enseigne de la Belle-Étoile."
                                            },
                                            {
                                                "example_id": "95b2b438-f789-4fee-80fb-bd7ab0d30a0c",
                                                "sense_id": "745e7351-edb3-3704-9353-624269b6fbb8",
                                                "text": "Les lits étaient déjà presque tous occupés et on ne pouvait plus recevoir indistinctement tous les nouveaux venus."
                                            },
                                            {
                                                "example_id": "7da3bbcc-f91e-4587-bbac-2ab629cf63a6",
                                                "sense_id": "745e7351-edb3-3704-9353-624269b6fbb8",
                                                "text": "D’abord, les deux nouveaux venus parurent terribles, puis ils furent agréables et désirables comme des frères."
                                            },
                                            {
                                                "example_id": "30da2acd-96cf-4aa6-a174-edaa2cac4e8e",
                                                "sense_id": "745e7351-edb3-3704-9353-624269b6fbb8",
                                                "text": "Les bistros regorgeaient d’hommes, de femmes endormis, que parfois le garçon réveillait pour qu’ils cédassent la place à de nouveaux venus."
                                            },
                                            {
                                                "example_id": "48ed9c27-4419-432f-98c4-6b411b895473",
                                                "sense_id": "745e7351-edb3-3704-9353-624269b6fbb8",
                                                "text": "Nous réservâmes aux nouveaux venus un accueil qui fut cordial et empressé, mais le temps n’était pas aux effusions et d’un commun avis, il fallait agir vite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nouveau venu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4733033-8aae-3f39-80a6-daf8454be7bd",
                                        "entry_id": "0ec01d0b-b68c-39f3-8e79-13359d3db024",
                                        "glosses": [
                                            "Qui vient d’arriver dans un lieu ou d’être admis dans un groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d8478e-45bd-4a43-a41f-78fbac893797",
                                                "sense_id": "a4733033-8aae-3f39-80a6-daf8454be7bd",
                                                "text": "Il eût été maladroit d'insister, surtout en présence des deux consommateurs nouveaux venus qui ne paraissaient pas appartenir à ce qu'on appelait déjà les classes dirigeantes."
                                            },
                                            {
                                                "example_id": "dfa76adf-8a58-433f-978f-341dceb50bac",
                                                "sense_id": "a4733033-8aae-3f39-80a6-daf8454be7bd",
                                                "text": "Les voix autorisées étaient muettes sur les banlieues et les familles nouvelles venues, voisinant dans les HLM avec les habitants déjà là qui leur reprochaient de ne pas parler ni manger comme nous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b635f5ca-31a3-44e0-818f-a3ee432fec1d",
                        "source_entry_id": "356d6dd7-553c-33eb-9b9d-21c71870cc98",
