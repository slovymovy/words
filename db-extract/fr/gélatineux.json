                    },
                    {
                        "form_id": "91a4e805-77da-4e51-b8fb-3ded9da8027f",
                        "entry_id": "64a552d6-935a-329e-9d6f-54657419a01a",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "gélatineuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd9f1446-96dd-3f1e-85dd-24ad02bba266",
                        "entry_id": "64a552d6-935a-329e-9d6f-54657419a01a",
                        "glosses": [
                            "Qui est de la nature de la gélatine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "388b0215-4d9e-43a9-b302-28da2d26e518",
                                "sense_id": "dd9f1446-96dd-3f1e-85dd-24ad02bba266",
                                "text": "Thunherg présume que cette dernière en tire les matériaux d'espèces de fucus, notamment du fucus bursa, qui, suivant lui, est aussi gélatineux que la substance même des nids d'hirondelle."
                            },
                            {
                                "example_id": "54db1d6a-b852-4df9-8fc1-15e909a7b3b8",
                                "sense_id": "dd9f1446-96dd-3f1e-85dd-24ad02bba266",
                                "text": "Vers le mois de mars ou d'avril, on procède au collage avec du blanc d'œuf ; cette substance a la propriété de former, avec le tannin et une partie des principes colorants, un composé gélatineux qui entraîne, en se coagulant, les matières en suspension dans le vin."
                            },
                            {
                                "example_id": "239aee92-0567-4339-a81f-bd954d3bccb7",
                                "sense_id": "dd9f1446-96dd-3f1e-85dd-24ad02bba266",
                                "text": "On emploie comme matière première soit les déchets de soie naturelle […], soit la substance gélatineuse contenue dans le gros intestin du ver à soie."
                            },
                            {
                                "example_id": "1ae4ebd5-c7c5-4609-b335-fa2c7edd05be",
                                "sense_id": "dd9f1446-96dd-3f1e-85dd-24ad02bba266",
                                "text": "Cette révélation passa le visage de Plantin au blanc gélatineux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f199d2d7-e403-4d76-a5a0-c1cae9680dbe",
                        "source_entry_id": "64a552d6-935a-329e-9d6f-54657419a01a",
                        "source_sense_id": "dd9f1446-96dd-3f1e-85dd-24ad02bba266",
                        "target_lang_word": "halbfest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3176f55b-185e-48d3-bdee-87d8fbb6891e",
                        "source_entry_id": "64a552d6-935a-329e-9d6f-54657419a01a",
                        "source_sense_id": "dd9f1446-96dd-3f1e-85dd-24ad02bba266",
                        "target_lang_word": "gelatineartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelatineartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a8582bf-5086-363b-b5a2-7a1a9b005e76",
                                        "entry_id": "fe5d2780-7d50-332d-8d75-db1b5b8b1474",
                                        "glosses": [
                                            "an Gelatine erinnernd, Gelatine ähnelnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034c2ebf-63af-4c75-8cc5-2a5c39975f80",
                                                "sense_id": "3a8582bf-5086-363b-b5a2-7a1a9b005e76",
                                                "text": "„Der abgetrennte Kopf schreit auch dann noch, als er sich schon in dem gelatineartigen Magen befindet.“"
                                            },
                                            {
                                                "example_id": "0b40df93-ab99-426b-827f-180848603562",
                                                "sense_id": "3a8582bf-5086-363b-b5a2-7a1a9b005e76",
                                                "text": "„Es enthielt pures Protein in Form eines dicken, gelatineartigen Sirups, nährstoffreich genug, um einen Mann für eine Woche bei Kräften zu halten, wenn es nötig wurde.“"
                                            },
                                            {
                                                "example_id": "631667ab-1b1c-4bc4-8012-dc0757310a78",
                                                "sense_id": "3a8582bf-5086-363b-b5a2-7a1a9b005e76",
                                                "text": "„›Der Leichnam liegt auf dem Rücken, Arme und Beine gespreizt. Würgemale am Hals, die Augen wurden entfernt, und die leeren Höhlen sondern eine gelatineartige Substanz aus.‹“"
                                            },
                                            {
                                                "example_id": "5ca17a2c-c4ee-451c-bb7c-89624c1a3ac4",
                                                "sense_id": "3a8582bf-5086-363b-b5a2-7a1a9b005e76",
                                                "text": "„Die gelatineartige Flüssigkeit in ihrem Inneren war jedoch kein Öl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53303929-c61c-48a1-8baf-0f54143e3b30",
                        "source_entry_id": "64a552d6-935a-329e-9d6f-54657419a01a",
                        "source_sense_id": "dd9f1446-96dd-3f1e-85dd-24ad02bba266",
                        "target_lang_word": "gelatinous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelatinous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bbe54f2-5fd6-3a9f-81f0-aff3e1bd366a",
                                        "entry_id": "5ca2c05e-607c-39af-a362-76a44d0cc1be",
                                        "glosses": [
                                            "Jelly-like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f724b18-59ab-4753-86d7-13cca87952b2",
                                                "sense_id": "6bbe54f2-5fd6-3a9f-81f0-aff3e1bd366a",
                                                "text": "In certain star-fishes, small depressions in the layer of pigment which surrounds the nerve are filled, as described by the author just quoted, with transparent gelatinous matter, and this projects outwardly with a convex surface, like the cornea in the higher animals."
                                            },
                                            {
                                                "example_id": "0a3511eb-af41-4cf1-a980-80a5760899ff",
                                                "sense_id": "6bbe54f2-5fd6-3a9f-81f0-aff3e1bd366a",
                                                "text": "Everyone listened, and everyone was listening still when It lumbered slobberingly into sight and gropingly squeezed Its gelatinous green immensity through the black doorway into the tainted outside air of that poison city of madness."
                                            },
                                            {
                                                "example_id": "a7286c05-a56f-43da-997a-ffbed02957a9",
                                                "sense_id": "6bbe54f2-5fd6-3a9f-81f0-aff3e1bd366a",
                                                "text": "Winston was gelatinous with fatigue. Gelatinous was the right word. It had come into his head spontaneously. His body seemed to have not only the weakness of a jelly, but its translucency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3346dee6-ad30-3108-8538-632eabde5f7e",
                                        "entry_id": "5ca2c05e-607c-39af-a362-76a44d0cc1be",
                                        "glosses": [
                                            "Of or referring to gelatin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfb0cf31-2e96-44da-88d6-c8cce810c1ee",
