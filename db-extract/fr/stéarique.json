        "fr-extract.jsonl": [
            {
                "entry_id": "f6ba4e4b-ff85-3222-a1d6-520bacc194d9",
                "word": "stéarique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2c4370e-36fc-3a6e-b023-7ccf30e08fda",
                        "entry_id": "f6ba4e4b-ff85-3222-a1d6-520bacc194d9",
                        "glosses": [
                            "Qualifie un acide qui est le produit de la saponification des corps gras."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0da69be-69ed-40e2-b871-5a7818702a09",
                                "sense_id": "a2c4370e-36fc-3a6e-b023-7ccf30e08fda",
                                "text": "Art. 23. — Il est établi sur l’acide stéarique, et autres matières à l'état de bougies ou de cierges, un droit de consommation intérieure, fixé en principal à 25 fr. les 100 kilogrammes."
                            },
                            {
                                "example_id": "99cedf0b-6982-4f24-b107-e4b81203089e",
                                "sense_id": "a2c4370e-36fc-3a6e-b023-7ccf30e08fda",
                                "text": "Les corps gras sont des éthers composés ou glycérides tertiaires formés par la glycérine et divers acides gras à teneur élevée en carbone. Les glycérides les plus répandus sont ceux des acides stéarique, palmitique et oléique."
                            },
                            {
                                "example_id": "c758cb60-fda7-48b7-8647-ed524d19b199",
                                "sense_id": "a2c4370e-36fc-3a6e-b023-7ccf30e08fda",
                                "text": "Fines herbes psychotropiques, notamment silène, spergule et saponaire, concoctées avec ester stéarique de glycérine et jus de coquelicot ranci. Recette infaillible pour susciter hallucinations catachrétiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "62a3fb93-7222-33e0-8fc1-dd9c3e0ba913",
                        "entry_id": "f6ba4e4b-ff85-3222-a1d6-520bacc194d9",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)…"
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "b8aa8be6-02c1-4560-9523-258f4e399c1b",
                                "sense_id": "62a3fb93-7222-33e0-8fc1-dd9c3e0ba913",
                                "text": "Après la Libération, ce néant stéarique à grosses lunettes aura avantage à ne pas sortir sans casque lourd."
                            }
                        ]
                    }
                ],
