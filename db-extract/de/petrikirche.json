                        "sense_id": "00489580-0e2d-3e03-946f-49ff768343e2",
                        "entry_id": "b80b41a0-42bf-3119-8e80-e7c2c9d7bf16",
                        "glosses": [
                            "Gotteshaus zu Ehren des Apostels Petrus ^(→ WP), das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9218d447-0a8e-4d8e-9e3d-3dcad732dede",
                                "sense_id": "00489580-0e2d-3e03-946f-49ff768343e2",
                                "text": "„Am 25. April 1793 wurde er zum Prediger der Petrikirche gewählt. Am 15. Mai 1821 stieg er zum (Haupt)pastor der Petrikirche auf.“"
                            },
                            {
                                "example_id": "e42c8f61-bd4b-4e52-b887-6ca4f60f8272",
                                "sense_id": "00489580-0e2d-3e03-946f-49ff768343e2",
                                "text": "„Archäologen hatten dort [Petriplatz] Reste der über die Jahrhunderte entstandenen verschiedenen Petrikirchen und einer Lateinschule entdeckt.“"
                            }
                        ],
