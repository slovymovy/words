                                    {
                                        "sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                                        "entry_id": "6bbeef62-0d01-39cb-8006-fe9f40bd5c50",
                                        "glosses": [
                                            "großes, tief liegendes Geschwür, das aus mehreren nebeneinanderliegenden Furunkeln besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb58cece-4efc-4337-a8b5-954a55ccb26d",
                                                "sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                                                "text": "Furunkel und Karbunkel treten gehäuft bei Diabetes auf und können ein Hinweis auf diese Erkrankung sein."
                                            },
                                            {
                                                "example_id": "45b249c8-5239-4eb6-9ff4-a532cd23d836",
                                                "sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                                                "text": "Ein Karbunkel im Nacken wächst sich im Lauf der Erzählungen zu einer napfgroßen Geschwulst aus."
                                            },
                                            {
                                                "example_id": "dc3f188b-db20-498f-90bf-8a97d4606108",
                                                "sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                                                "text": "\"Gestern lag ich wieder brach, da ein bösartiger Hund von Karbunkel an linker Lende ausgebrochen\", berichtete Karl Marx seinem Vertrauten Friedrich Engels am 13. Februar 1866 aus dem Londoner Exil."
                                            },
                                            {
                                                "example_id": "6c68e27e-311a-4d86-a7b3-14e7c1968f7a",
                                                "sense_id": "58a220d8-1db9-3dea-b372-438be8c2dc73",
                                                "text": "„Ich sah dabei, daß er einen fast verheilten Karbunkel im Nacken hatte mit einem Pflaster darüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
