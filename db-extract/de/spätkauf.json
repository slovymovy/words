                "senses": [
                    {
                        "sense_id": "3ba69759-399e-3508-9cd5-508645e80c5d",
                        "entry_id": "6c613094-b0e4-33ee-935c-ac7f3ff66b6b",
                        "glosses": [
                            "über den allgemeinen Ladenschluss hinaus geöffnete kleinere Verkaufsstelle in einer Großstadt (vor allem Berlin, ferner unter anderem auch Hamburg, Köln, München), in der Getränke, Tabakwaren und zumeist auch Zeitschriften, Lebensmittel verkauft sowie häufig auch Internetzugänge angeboten werden"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "fc80b1e4-5a2f-4007-b76e-87d7a30269e0",
                                "sense_id": "3ba69759-399e-3508-9cd5-508645e80c5d",
                                "text": "„Folglich antwortete der Stadtrat auch auf die Frage, ob sich denn der Spätkauf am Kollwitzplatz nun an die Regeln halte, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
