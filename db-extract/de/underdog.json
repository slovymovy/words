                    {
                        "sense_id": "41719e0b-4725-394f-8099-73b66a1d6177",
                        "entry_id": "475e62c1-ee95-3cc7-b296-97bb59c2d30a",
                        "glosses": [
                            "Person oder Sportverein, der leistungsmäßig unterlegen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d7a17a9-4251-472d-bff4-e09b0d4fc14a",
                                "sense_id": "41719e0b-4725-394f-8099-73b66a1d6177",
                                "text": "„Als Underdog hat Otto Rehhagel, die vom Anstreicher zum Bohemien gewandelte Trainerlegende, seine spektakulärsten Erfolge gefeiert.“"
                            },
                            {
                                "example_id": "70e15869-2900-41e2-b250-26d76714272c",
                                "sense_id": "41719e0b-4725-394f-8099-73b66a1d6177",
                                "text": "„Selbst Alkoholiker, thematisierte er immer wieder das Leben der Unterdogs und Trinker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95ee3f42-e675-4de5-9b26-45521b6161eb",
                        "source_entry_id": "475e62c1-ee95-3cc7-b296-97bb59c2d30a",
                        "source_sense_id": "41719e0b-4725-394f-8099-73b66a1d6177",
                        "source_sense_description": "Person oder Sportverein, der leistungsmäßig unterlegen ist",
                        "target_lang_word": "underdog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underdog",
