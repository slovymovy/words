                "translations": [
                    {
                        "translation_id": "d852b546-cb7d-481b-b9ca-2410d11d6376",
                        "source_entry_id": "bff074a8-b2fd-3831-8ec1-4f22b083d91c",
                        "source_sense_description": "строить, завершать постройку",
                        "target_lang_word": "build",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "build",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "622861d5-7c87-3a17-900e-50c2d3cb7211",
                                        "entry_id": "b6fc1102-032b-3823-a181-864895ab975b",
                                        "glosses": [
                                            "To form (something) by combining materials or parts."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d7af93e-83c0-40bd-840a-cecae2f45154",
                                                "sense_id": "622861d5-7c87-3a17-900e-50c2d3cb7211",
                                                "text": "It was a bridge ybuilt in goodly wize, / With curious Corbes and pendants grauen faire, [...]"
                                            },
                                            {
                                                "example_id": "994fc31b-8d86-4dc1-b1f4-248e9e78e023",
                                                "sense_id": "622861d5-7c87-3a17-900e-50c2d3cb7211",
                                                "text": "Athelstan Arundel walked home all the way, foaming and raging. No omnibus, cab, or conveyance ever built could contain a young man in such a rage. His mother lived at Pembridge Square, which is four good measured miles from Lincoln's Inn."
                                            },
                                            {
                                                "example_id": "0c1e07a5-1f13-4ff7-b86b-2be4f8afe083",
                                                "sense_id": "622861d5-7c87-3a17-900e-50c2d3cb7211",
                                                "text": "A chap named Eleazir Kendrick and I had chummed in together the summer afore and built a fish-weir and shanty at Setuckit Point, down Orham way. For a spell we done pretty well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "816689c0-b910-3df4-948b-638b7c45530d",
                                        "entry_id": "b6fc1102-032b-3823-a181-864895ab975b",
                                        "glosses": [
                                            "To develop or give form to (something) according to a plan or process."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02c87fcb-de19-4654-b4d9-5a86279c3e1d",
                                                "sense_id": "816689c0-b910-3df4-948b-638b7c45530d",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about […], or offering services that let you [...] \"share the things you love with the world\" and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc917a8c-742a-36e5-8f2f-b5044596f525",
                                        "entry_id": "b6fc1102-032b-3823-a181-864895ab975b",
                                        "glosses": [
                                            "To increase or strengthen (something) by adding gradually to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7779d882-bb9e-4999-8ffc-7339017d9635",
                                                "sense_id": "cc917a8c-742a-36e5-8f2f-b5044596f525",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70a76ead-3723-3dee-a84a-05b24c9fcd29",
                                        "entry_id": "b6fc1102-032b-3823-a181-864895ab975b",
                                        "glosses": [
                                            "To establish a basis for (something)."
                                        ],
                                        "tags": [
