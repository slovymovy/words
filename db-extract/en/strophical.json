                                "example_id": "77b0dc02-6851-4640-9c73-f03036a19690",
                                "sense_id": "57cd850a-391c-3437-94a9-8301a153009c",
                                "text": "I now purpose to consider the strophical organization of the trimeter poems."
                            },
                            {
                                "example_id": "e5eca8b3-85c1-4151-a2e5-348ab7e3fef2",
                                "sense_id": "57cd850a-391c-3437-94a9-8301a153009c",
                                "text": "The Psalmist is feeling after strophical form, but he does not bind himself to it."
                            }
                        ]
