                "senses": [
                    {
                        "sense_id": "67163dfb-dd35-362c-9ca2-c283b1e3b440",
                        "entry_id": "cc6e3a70-1762-3a95-9785-ddf933c52edf",
                        "glosses": [
                            "durch das Verbrennen von Petroleum betriebene Lampe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990ddef2-1850-4d3d-ac87-9fb3fa466c24",
                                "sense_id": "67163dfb-dd35-362c-9ca2-c283b1e3b440",
                                "text": "„Bevor das elektrische Licht eingeführt wurde, übernahmen oft Petroleumlampen die Beleuchtung in vielen Bereichen.“"
                            },
                            {
                                "example_id": "e380b64e-f8d6-40e0-8f04-1183e2e26b37",
                                "sense_id": "67163dfb-dd35-362c-9ca2-c283b1e3b440",
                                "text": "„Hier oben gab es keinen Strom und damit auch kein elektrisches Licht, weswegen es in jedem Zimmer kleine verrußte Petroleumlampen gab.“"
                            },
                            {
                                "example_id": "10d1ffb4-2b5e-4cc7-9ff7-32c0a55d1633",
                                "sense_id": "67163dfb-dd35-362c-9ca2-c283b1e3b440",
                                "text": "„Im Felde hatten wir höchstens mal eine Petroleumlampe.“"
                            },
                            {
                                "example_id": "87dbe1f4-2536-4d7b-b44b-41f40d976cf9",
                                "sense_id": "67163dfb-dd35-362c-9ca2-c283b1e3b440",
                                "text": "„Pinneberg brennt die kleine Petroleumlampe mit dem blauen Glasschirm an, jetzt geht der Tag los, die erste halbe Stunde hat er viel zu beschicken.“"
                            },
                            {
                                "example_id": "44ec85b7-4607-4d41-ad4d-3eca669d4644",
                                "sense_id": "67163dfb-dd35-362c-9ca2-c283b1e3b440",
                                "text": "„Jemand brachte eine Petroleumlampe und eine Tasse Tee oder Kaffee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
