                "translations": [
                    {
                        "translation_id": "04bb2c2e-4cfe-4fe8-be0d-60ad17c974ab",
                        "source_entry_id": "9531e883-c824-3800-92e0-c90e3837973e",
                        "source_sense_id": "1be85d51-2791-33bb-85cc-08d1214d535b",
                        "source_sense_description": "in a catastrophic manner",
                        "target_lang_word": "catastrophiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catastrophiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b925ed30-0fe8-35df-a98c-6f7aff26b25c",
                                        "entry_id": "dcfd618d-552e-3bd3-bb2d-c36e887fc978",
                                        "glosses": [
                                            "D'une manière catastrophique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c70a17-825c-40f1-aa71-05b2d91dda31",
                                                "sense_id": "b925ed30-0fe8-35df-a98c-6f7aff26b25c",
                                                "text": "Ainsi, un producteur de produits alimentaires ne se nourrit jamais mieux que lorsque les prix de ses produits tombent catastrophiquement et que sa situation matérielle empire."
                                            },
                                            {
                                                "example_id": "fbe073a8-a1f4-48a5-b4df-ac5b69e06107",
                                                "sense_id": "b925ed30-0fe8-35df-a98c-6f7aff26b25c",
                                                "text": "On peut dire qu’on y aura mis le temps, mais mieux vaut très tard qu’absolument jamais, comme on dit quand on est catastrophiquement en retard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc3d16ba-8c1a-3c39-8add-04b95e7c364f",
                                        "entry_id": "dcfd618d-552e-3bd3-bb2d-c36e887fc978",
                                        "glosses": [
                                            "Très brutalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ebc05a2-30fd-4d97-9278-9ee895513b66",
                                                "sense_id": "bc3d16ba-8c1a-3c39-8add-04b95e7c364f",
                                                "text": "Il existera donc en général des points singuliers de W où il sera catastrophiquement substitué par un autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a150c2f-ad87-4810-bd1d-f5a87edeb42b",
                        "source_entry_id": "9531e883-c824-3800-92e0-c90e3837973e",
                        "source_sense_id": "1be85d51-2791-33bb-85cc-08d1214d535b",
                        "source_sense_description": "in a catastrophic manner",
                        "target_lang_word": "katastrophal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "katastrophal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                        "entry_id": "7048382b-1419-3ec5-82c5-da736b146af3",
                                        "glosses": [
                                            "sehr schlimm, verhängnisvoll, entsetzlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef23ed6a-9df8-46cf-8498-3836d75009a6",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "Die katastrophale Wirtschaftslage eines Landes wirkt sich auf andere Länder aus."
                                            },
                                            {
                                                "example_id": "f0279160-73f3-493a-8674-4321e622d3e4",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Die enorme Auswanderungswelle, die Ende der 1960er, Anfang der 1970er Jahre auch Italien, vor allem den Süden des Landes, erfasst hatte, war eine Folge der katastrophalen Wirtschaftslage und der damit verbundenen Perspektivlosigkeit.“"
                                            },
                                            {
                                                "example_id": "f3ae5ed5-544a-4b7e-ad8a-c22a3e04f332",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Keltische Kriegerscharen fielen, von Gallien kommend, in Italien ein, die Römer stellten sich ihnen in der Schlacht an der Allia und erlitten eine katastrophale Niederlage.“"
                                            },
                                            {
                                                "example_id": "7755cf5f-2bfd-481c-ac03-41a5b1444feb",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Die Verkehrs- und Versorgungslage in Deutschland ist katastrophal in diesen Tagen [Anmerkung: im April 1945] […].“"
                                            },
                                            {
                                                "example_id": "df306c34-06e7-4220-a992-322c11a00c5e",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Im Gegensatz zu vielen seiner Kollegen ist es Mugabe trotz seiner katastrophalen Politik bisher gelungen, die Armee ruhig und auf seiner Seite zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
