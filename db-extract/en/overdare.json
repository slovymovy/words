                    {
                        "sense_id": "70b06e25-e0e9-327b-b3f6-7286e24dab33",
                        "entry_id": "a0bcecbb-19b6-395b-bf0a-30c5266410c2",
                        "glosses": [
                            "To dare too much or rashly; to be too daring."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4a2b1286-c246-4a76-b1c1-2fbbac2bbb58",
                                "sense_id": "70b06e25-e0e9-327b-b3f6-7286e24dab33",
                                "text": "Meete you for this, proud ouerdaring peeres,\nEre my sweete Gaueston shall part from me,\nThis Ile shall fleete vpon the Ocean,\nAnd wander to the vnfrequented Inde."
                            },
                            {
                                "example_id": "6ce9296b-dd4a-44ac-a3b8-abcef64a9885",
                                "sense_id": "70b06e25-e0e9-327b-b3f6-7286e24dab33",
                                "text": "1912, William Butler Yeats, The Countess Cathleen, Scene III, in Poems, London: T. Fisher Unwin, p. 59,\nWhen one so great has spoken of love to one\nSo little as I, though to deny him love,\nWhat can he but hold out beseeching hands,\nThen let them fall beside him, knowing how greatly\nThey have overdared?"
                            }
                        ]
                    }
