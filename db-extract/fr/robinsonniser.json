                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3955b559-d794-405e-8952-a20d20059ed1",
                                "sense_id": "a17b80a8-381c-3b52-bae3-af8dc77eeafe",
                                "text": "Le moratoire nous « robinsonnise ». — (Pascal Couchepin, Jean Romain, Je crois à l'action politique, 2003)"
                            },
                            {
                                "example_id": "905a07b3-837c-48be-959e-d45f026ac2a6",
                                "sense_id": "a17b80a8-381c-3b52-bae3-af8dc77eeafe",
                                "text": "Se robinsonniser le mardi sans attendre Vendredi, perdu au milieu de la foule, parler tout seul sans un mot pour les autres, bombarder le monde de paroles lorsqu’on se croit isolé, perdu, désemparé. — (site simonu.blog.lemonde.fr, 17 juin 2017)"
                            },
                            {
                                "example_id": "115f18b0-945a-45d5-a658-6af5b32474bb",
                                "sense_id": "a17b80a8-381c-3b52-bae3-af8dc77eeafe",
                                "text": "Comme dans certains endroits de Casamance, Mar Lodj donne vraiment enfin de se «robinsonniser». — (site www.planete-senegal.com)"
                            }
                        ]
                    }
