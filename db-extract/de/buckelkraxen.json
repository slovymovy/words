                        "examples": [
                            {
                                "example_id": "3c458ec0-3d3f-4ded-abce-c2baa261aaf8",
                                "sense_id": "5f212e7b-63f0-3141-8550-6f17afad2bd9",
                                "text": "„Wenn sie in Wien zu dem Chiropraktiker Dr. Rauch kommt, trägt sie der immer hilfsbereite Arzt zur Behandlung buckelkraxen in die Ordination und dann wieder hinunter auf die Straße.“"
                            },
                            {
                                "example_id": "3e690e3d-e6ba-429c-9268-dbb3058efca5",
                                "sense_id": "5f212e7b-63f0-3141-8550-6f17afad2bd9",
                                "text": "„Stimmungskanone Marc Pircher nahm die bloßfüßige Kollegin Rosanna Rocci einfach bucklkraxn.“"
                            },
                            {
                                "example_id": "28f2fed2-0f4b-4542-9d02-1ea06b8bf072",
                                "sense_id": "5f212e7b-63f0-3141-8550-6f17afad2bd9",
                                "text": "„In dem Wienerlied ‚A Gfrett is ’s auf da Welt‘ heißt es dazu: [‚]Statt hamfahrn mit an Zeiserlwagen/tuat aner den andern buckelkraxn tragn.‘“"
                            },
                            {
                                "example_id": "9d3e78e2-33c5-47c6-a2d7-adb303e2a609",
                                "sense_id": "5f212e7b-63f0-3141-8550-6f17afad2bd9",
                                "text": "„Nichts gegen die Waidmänner, die Hege und Pflege ernst nehmen, buchstäblich mit dem Futtersack buckelkraxn im Schnee bergan stapfen, um hungrige Mäuler zu füttern, Laien die Möglichkeit geben, bei unvergesslicher Hirschbrunft zuzusehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
