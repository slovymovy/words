                ],
                "senses": [
                    {
                        "sense_id": "754b430f-8556-3582-adff-546d5b66a2b2",
                        "entry_id": "6b6efd8b-9212-34ba-9bda-303cbc98dddd",
                        "glosses": [
                            "eine Art aus der Familie der Pinguine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b83b347-6959-43fd-8731-e7860c20e05b",
                                "sense_id": "754b430f-8556-3582-adff-546d5b66a2b2",
                                "text": "„Der Felsenpinguin ist die am weitesten verbreitete Art der Gattung.“"
                            },
                            {
                                "example_id": "1bc9baf6-0168-4ec3-9798-704a48e6599d",
                                "sense_id": "754b430f-8556-3582-adff-546d5b66a2b2",
                                "text": "„Wie die meisten Pinguinarten nistet der Felsenpinguin nicht auf dem antarktischen Festland, sondern bevorzugt etwas wärmeren Regionen fern der Polkappe“."
                            },
                            {
                                "example_id": "f2284d5f-eb48-4747-88b6-4d0e2559a59d",
                                "sense_id": "754b430f-8556-3582-adff-546d5b66a2b2",
                                "text": "„Mit der leuchtend gelben Federbüscheln am Kopf ist der Felsenpinguin ein auffälliges Mitglied seiner Familie.“"
                            },
                            {
                                "example_id": "07765e0f-79a6-461a-b665-64e8eb14d8de",
                                "sense_id": "754b430f-8556-3582-adff-546d5b66a2b2",
                                "text": "„Um ans Ufer zu gelangen, nimmt der Felsenpinguin unter Wasser Anlauf, schießt aus dem Wasser und landet sicher auf seinen Füßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
