    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "096336dd-3f89-3d98-b767-a42ec766fdfd",
                    "sense_definition": "Present participle and gerund of <w>drop</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>dropping</w> her friend off at the train station.",
                            "target_lang_translations": {
                                "ru": "Она <w>высаживает</w> свою подругу на вокзале.",
                                "pl": "Ona <w>podwozi</w> swoją przyjaciółkę na stację kolejową."
                            }
                        },
                        {
                            "text": "The temperature has been <w>dropping</w> steadily all afternoon.",
                            "target_lang_translations": {
                                "ru": "Температура неуклонно <w>падала</w> весь день.",
                                "pl": "Temperatura przez całe popołudnie stale <w>spadała</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dropping out",
                        "dropping off",
                        "dropping by",
                        "dropping in"
                    ],
                    "traits": [
