        "ru-extract.jsonl": [
            {
                "entry_id": "a6680c91-4881-3bf2-bbb4-e38637c1443d",
                "word": "однорукий",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "19d58787-25d2-3fa1-8d77-1302ef1f9bbc",
                        "entry_id": "a6680c91-4881-3bf2-bbb4-e38637c1443d",
                        "glosses": [
                            "имеющий одну руку, с одной рукой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63702423-7cf1-4bd4-8eb9-bcfe3d0debd5",
                                "sense_id": "19d58787-25d2-3fa1-8d77-1302ef1f9bbc",
                                "text": "За роялем сидел однорукий старик в сером костюме. Он играл правой рукой. Левый пустой рукав был небрежно засунут в боковой карман пиджака."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cc348b2-3eb5-4dc7-bccb-52a091be2f37",
                        "source_entry_id": "a6680c91-4881-3bf2-bbb4-e38637c1443d",
                        "source_sense_id": "19d58787-25d2-3fa1-8d77-1302ef1f9bbc",
                        "target_lang_word": "one-armed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "one-armed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82e3a365-79e7-3b27-8dc7-21b08a121a40",
                                        "entry_id": "6da394e8-0ff4-309a-8483-e93851cd7429",
                                        "glosses": [
                                            "Having only one arm; especially having lost an arm."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e34a2fb9-c265-4b26-955c-d24c74938e00",
                                                "sense_id": "82e3a365-79e7-3b27-8dc7-21b08a121a40",
                                                "text": "\"Hope I'm not talking out of school but I do feel you acted unwisely by employing a one-armed chauffeur.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1313a14c-474f-4762-8538-8a366f7f951c",
                        "source_entry_id": "a6680c91-4881-3bf2-bbb4-e38637c1443d",
                        "source_sense_id": "19d58787-25d2-3fa1-8d77-1302ef1f9bbc",
                        "target_lang_word": "einarmig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einarmig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84f192c6-cd6f-3af9-ac4b-cbc5b8cace19",
                                        "entry_id": "793dab6a-8167-3af1-b3c4-ccfded527fbf",
                                        "glosses": [
                                            "einen Arm besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4923168b-7e19-4015-b656-f9332cce595b",
                                                "sense_id": "84f192c6-cd6f-3af9-ac4b-cbc5b8cace19",
                                                "text": "In Filmen kann man manchmal einarmige Schauspieler sehen."
                                            },
                                            {
                                                "example_id": "91d22c20-e7c2-41d0-ace6-65f59078d7b2",
                                                "sense_id": "84f192c6-cd6f-3af9-ac4b-cbc5b8cace19",
                                                "text": "„In der Verhandlung sagt der einarmige Mann aus, der, wie die Gutachten sagen, jetzt wieder ganz hergestellt und vernehmungsfähig ist:…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d2d8e0db-b4dd-3762-9cb9-3c26c81dfd54",
                                        "entry_id": "793dab6a-8167-3af1-b3c4-ccfded527fbf",
                                        "glosses": [
                                            "mit einem Arm ausgestattet, mit einem Armen versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d57fc9-aa14-4932-ad8e-807f9d666a9e",
                                                "sense_id": "d2d8e0db-b4dd-3762-9cb9-3c26c81dfd54",
                                                "text": "In Spielhallen gibt es auch einarmige Banditen."
                                            },
                                            {
                                                "example_id": "23707f97-6e5a-4fc3-839a-20dcf79f2d8a",
                                                "sense_id": "d2d8e0db-b4dd-3762-9cb9-3c26c81dfd54",
                                                "text": "„Die bisher auf dem Markt käuflichen Roboter sind einarmig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
