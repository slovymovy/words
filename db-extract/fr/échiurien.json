                        "entry_id": "e533fdd2-b1a8-32e1-b1a5-7f6559554223",
                        "glosses": [
                            "Qui appartient à la classe Echiura."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3dae69-9654-47de-be22-abb15ef0ac63",
                                "sense_id": "9af854e4-b3bd-3f1b-ae7d-6e82a95d054c",
                                "text": "Contrairement aux apparences, les petits bivalves accrochés à ce ver échiurien ne sont pas forcément des parasites."
                            },
                            {
                                "example_id": "bf575430-3855-4814-89ca-ba7a63a73b52",
                                "sense_id": "9af854e4-b3bd-3f1b-ae7d-6e82a95d054c",
                                "text": "Des photographies prises par un appareil automatique ont montré que les traces étoilées étaient dues à un ver échiurien, qui explore le sédiment à intervalles plus ou moins régulier pour se nourrir."
                            }
                        ]
                    }
