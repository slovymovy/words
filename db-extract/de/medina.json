                "senses": [
                    {
                        "sense_id": "73a5a1be-9e1c-3078-b29f-5a7ff55c57c4",
                        "entry_id": "fab0b67c-3461-3513-b9d1-0e077caf8e4c",
                        "glosses": [
                            "Altstadt orientalischer Städte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7297d81b-8fd2-4a47-aa32-1e9f7e155610",
                                "sense_id": "73a5a1be-9e1c-3078-b29f-5a7ff55c57c4",
                                "text": "„Er liegt in der Mitte der Altstadt, und schmale wie schmalste Gässchen führen von dort entweder hinauf ins Adlernest der Medina oder zum Hafen hinab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e6fbe94-94a4-43da-af21-18c691ebb820",
                        "source_entry_id": "fab0b67c-3461-3513-b9d1-0e077caf8e4c",
                        "source_sense_id": "73a5a1be-9e1c-3078-b29f-5a7ff55c57c4",
                        "source_sense_description": "Altstadt orientalischer Städte",
                        "target_lang_word": "Медина",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Медина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3af22e4c-2777-38b2-a87e-26c7c6cc3a6c",
                                        "entry_id": "4c6f9a04-6785-3a4e-b82a-a73145d8454b",
                                        "glosses": [
                                            "город на западе Саудовской Аравии, центр провинции Медина [2], один из двух, наряду с Меккой священных городов мусульман"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b0fdf2c-3292-4220-bd97-2d5044c04e54",
                                                "sense_id": "3af22e4c-2777-38b2-a87e-26c7c6cc3a6c",
                                                "text": "Из несомненного источника сообщают, что арабы разграбили станции строящегося участка Мекка-Медина, Геджасской дороги, приводя в исполнение свою угрозу препятствовать постройке этого участка, лишающего арабских шейхов доходов от сопровождения караванов паломников."
                                            },
                                            {
                                                "example_id": "8c925053-d69f-4262-b351-eca605c9520d",
                                                "sense_id": "3af22e4c-2777-38b2-a87e-26c7c6cc3a6c",
                                                "text": "В ней, например, есть святые (сакральные) места, которые особым образом организуют «пространство культуры»: Мекка и Медина для мусульман, Святая земля для христиан, поля великих и малых сражений, где решалось историческое будущее народов, места неслыханных страданий (Освенцим, Хиросима)…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0208280-54c3-32d1-a2d0-add74da36005",
                                        "entry_id": "4c6f9a04-6785-3a4e-b82a-a73145d8454b",
                                        "glosses": [
                                            "провинция на западе Саудовской Аравии"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e02cbfc5-70b3-3125-b34a-480ab31dca9e",
                                        "entry_id": "4c6f9a04-6785-3a4e-b82a-a73145d8454b",
                                        "glosses": [
                                            "муниципалитет в штате Минас-Жерайс, Бразилия"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
