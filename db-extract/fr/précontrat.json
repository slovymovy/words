                            {
                                "example_id": "9f9caf74-ba7c-47e3-bd7b-4b208cccd3f7",
                                "sense_id": "53d96a25-ab79-3d64-b32e-a3df711d32e2",
                                "text": "Selon Europe 1, le jeune coiffeur, qui avait signé un précontrat avec Endemol, avait quitté son emploi et son logement lyonnais, persuadé de figurer dans le casting final de «Secret Story»."
                            },
                            {
                                "example_id": "15f8484f-7c95-4579-ad0a-d55d77e71dc8",
                                "sense_id": "53d96a25-ab79-3d64-b32e-a3df711d32e2",
                                "text": "Eden Hazard, qui est le chouchou d’un certain Zinedine Zidane depuis longtemps, aurait signé un précontrat avec le Real Madrid."
                            },
                            {
                                "example_id": "49f95c9d-2d1d-4ec6-a45e-ff76e151766a",
                                "sense_id": "53d96a25-ab79-3d64-b32e-a3df711d32e2",
                                "text": "Blessé à la cheville lors du récent Euro en Lituanie, le Guadeloupéen n’avait pas pu satisfaire à la rituelle visite médicale qui devait valider le précontrat qu’il avait signé avec le club belge."
                            }
                        ]
                    },
