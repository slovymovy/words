                "senses": [
                    {
                        "sense_id": "fe3f657b-7ad8-3c14-9742-c69fe43afe07",
                        "entry_id": "3f1e1594-6271-3e25-aed6-9f5ddb9cc35d",
                        "glosses": [
                            "organiczny związek chemiczny stanowiący istotny składnik budowy błony komórkowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eac0249-f510-46a2-b5bd-e43cd3c71840",
                                "sense_id": "fe3f657b-7ad8-3c14-9742-c69fe43afe07",
                                "text": "Oleje rafinowane pozbawione są cennych z żywieniowego punktu widzenia fosfolipidów złożonych znajdujących się obok triacygliceroli w nasionach oleistych w ilości 0,5-3,5%. Największą zawartość fosfolipidów posiada olej rzepakowy (2,5%), olej sojowy (3,2%) i z kiełków kukurydzianych (2,0%)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8353fb4f-431c-459e-985f-dc7d06565bcd",
                        "source_entry_id": "3f1e1594-6271-3e25-aed6-9f5ddb9cc35d",
                        "source_sense_id": "fe3f657b-7ad8-3c14-9742-c69fe43afe07",
                        "target_lang_word": "phospholipid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phospholipid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eec871fe-cf0d-35bb-9a00-ee36324cd20b",
                                        "entry_id": "885bc3c0-dd76-3ec6-8268-d5c5c4cc8353",
                                        "glosses": [
                                            "Any lipid, such as lecithin or cephalin, consisting of a diglyceride combined with a phosphate group and a simple organic molecule such as choline or ethanolamine; they are important constituents of biological membranes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504512b1-390b-4a6a-81df-ed86583eae5b",
                                                "sense_id": "eec871fe-cf0d-35bb-9a00-ee36324cd20b",
                                                "text": "An index of the amount of phospholipids present was secured from the total phosphorus content of a third aliquot, the method employed being the colorimetric procedure devised by Whitehorn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23ac63bb-1736-40df-bc28-6e656c6fd8d1",
                        "source_entry_id": "3f1e1594-6271-3e25-aed6-9f5ddb9cc35d",
                        "source_sense_id": "fe3f657b-7ad8-3c14-9742-c69fe43afe07",
                        "target_lang_word": "phospholipide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phospholipide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5d4bc43-5ed8-3972-93e0-e77f7ba6a7ca",
                                        "entry_id": "234a600e-f269-352d-a75d-bb25906aa87b",
                                        "glosses": [
                                            "Lipide possédant un groupe phosphate soit un assemblage de deux acides gras, avec du glycérol et du phosphate, comprenant les phosphoacylglycérol (glycérophospholipide), phosphosphingolipide, phosphonosphingolipide et phosphosaccharolipide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71029e1e-1f0d-411c-9299-28da392f81d2",
                                                "sense_id": "b5d4bc43-5ed8-3972-93e0-e77f7ba6a7ca",
                                                "text": "En revanche, la lécithine, un phospholipide à choline, abondante dans les structures extraplastidiales, est absente des chloroplastes, à lexception de la membrane externe de l’enveloppe chloroplastique (Joyard et al., 1998)."
                                            },
                                            {
                                                "example_id": "498cc3f0-a3db-4384-873e-9d71c0fe190c",
                                                "sense_id": "b5d4bc43-5ed8-3972-93e0-e77f7ba6a7ca",
                                                "text": "Les protéines du jaune sont peu foisonnantes mais possèdent d'excellentes propriétés émulsifiantes dues aux phospholipides et aux lipoprotéines (effet stabilisant)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
