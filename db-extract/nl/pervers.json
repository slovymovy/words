                                        "glosses": [
                                            "Of, relating to, or practicing unusual or \\\"kinky\\\" sex."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "527081d8-c01c-338a-b587-1af0c209a688",
                                        "entry_id": "f43bd432-63a5-3b3e-a8b2-5c7e8402f18b",
                                        "glosses": [
                                            "Misrepresented, altered or distorted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8287d660-5414-3f78-8245-58c1610f613c",
                                        "entry_id": "f43bd432-63a5-3b3e-a8b2-5c7e8402f18b",
                                        "glosses": [
                                            "Reversed in chirality; flipped."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "719a017d-cb3c-4e63-bcfa-570a679bda59",
                                                "sense_id": "8287d660-5414-3f78-8245-58c1610f613c",
                                                "text": "The reflection of an object in a mirror image is a perverted image of the object."
                                            },
                                            {
                                                "example_id": "73753ab2-1647-4f4a-b685-2633f1db92a2",
                                                "sense_id": "8287d660-5414-3f78-8245-58c1610f613c",
                                                "text": "The right hand may be considered the perverted image of the left."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "perverted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35eba7c8-2297-3dad-ba52-214931f34a63",
