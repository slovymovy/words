                            {
                                "target_word": "fellowship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "873db999-bfcc-33c0-8597-7a52473acd18",
                                        "entry_id": "f9dff728-b401-3a65-b3f5-9bac06948ede",
                                        "glosses": [
                                            "To admit to fellowship, enter into fellowship with; to make feel welcome by showing friendship or building a cordial relationship. Now only in religious use."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19b983cb-912d-4756-8d1b-c186f20bc6ee",
                                                "sense_id": "873db999-bfcc-33c0-8597-7a52473acd18",
                                                "text": "The Bishop's family fellowshipped the new converts."
                                            },
                                            {
                                                "example_id": "9f5dd85c-33c2-4910-b9f8-7c3dfeb02fea",
                                                "sense_id": "873db999-bfcc-33c0-8597-7a52473acd18",
                                                "text": "The Society of Religious Snobs refused to fellowship the poor family."
                                            },
                                            {
                                                "example_id": "3ebe329e-cf9a-49a3-a44c-6fff662b313d",
                                                "sense_id": "873db999-bfcc-33c0-8597-7a52473acd18",
                                                "text": "Then pes seynge hir sistris alle in acorde...she turnid ayene; For whenne contencions & styf wer' cessid, then pes was felashipid among hem.\nThen Peace saw her sisters all in accord...she turned again; for when contentions and strife were ceased, then Peace was fellowshipped among them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18dea953-b84c-3aa6-ba54-287e2c84b15f",
                                        "entry_id": "f9dff728-b401-3a65-b3f5-9bac06948ede",
                                        "glosses": [
                                            "To join in fellowship; to associate with."
                                        ],
                                        "tags": [
                                            "US",
                                            "especially",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5f6b40-036f-4487-9bfb-b9b6912944f2",
                                                "sense_id": "18dea953-b84c-3aa6-ba54-287e2c84b15f",
                                                "text": "The megachurch he attends is too big for making personal connections, so he also fellowships weekly in one of the church's small groups."
                                            },
                                            {
                                                "example_id": "fa9eebad-39f6-4ee9-ba6e-f434716c596e",
                                                "sense_id": "18dea953-b84c-3aa6-ba54-287e2c84b15f",
                                                "text": "After she got married, she stopped fellowshipping with the singles in our church."
                                            },
                                            {
                                                "example_id": "c8000b2b-fb28-45dd-94ee-c7781d5cf6b4",
                                                "sense_id": "18dea953-b84c-3aa6-ba54-287e2c84b15f",
                                                "text": "Oure lorde Jesu came in manere of a pilgrym and felauschipped [Aldh felischippede] with hem.\nOur lord Jesus came in the manner of a pilgrim and fellowshipped with them."
                                            }
                                        ]
                                    }
                                ]
