                                        "examples": [
                                            {
                                                "example_id": "8c4490ef-163d-4dfd-b594-b95c15523492",
                                                "sense_id": "9801352a-f61c-3e95-beac-ecc4db2c44a8",
                                                "text": "Deaf people often must deal with hearing people."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hearing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21d0d288-4d5c-30f6-9ea1-6a10f7d1f932",
                                        "entry_id": "20e1bae3-f602-30c4-8e21-2f0ba34182ce",
                                        "glosses": [
                                            "The sense used to perceive sound."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64dde739-dba6-4a1d-bf1c-9cb25a9b2f04",
                                                "sense_id": "21d0d288-4d5c-30f6-9ea1-6a10f7d1f932",
                                                "text": "My hearing isn't what it used to be, but I still heard that noise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f553b05-7d8d-3ba7-a684-323213daaec7",
                                        "entry_id": "20e1bae3-f602-30c4-8e21-2f0ba34182ce",
                                        "glosses": [
                                            "The distance or physical region within which something may be heard; earshot."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1705c181-66d0-4291-991f-54ccc39fef68",
                                                "sense_id": "0f553b05-7d8d-3ba7-a684-323213daaec7",
                                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "058f9564-a0a4-3e25-a258-f11afe5975ce",
                                        "entry_id": "20e1bae3-f602-30c4-8e21-2f0ba34182ce",
                                        "glosses": [
                                            "Something heard; a report or piece of news."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c058a3d-9625-4262-a659-48bfc8f3ba8d",
                                                "sense_id": "058f9564-a0a4-3e25-a258-f11afe5975ce",
                                                "text": "More evidence followed. Evidence as to the financial difficulties in which the prisoner had found himself at the end of July. Evidence as to his intrigue with Mrs. Raikes—poor Mary, that must have been bitter hearing for a woman of her pride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f99041a4-0d56-3884-830f-86968c14a4ce",
                                        "entry_id": "20e1bae3-f602-30c4-8e21-2f0ba34182ce",
                                        "glosses": [
                                            "The act by which something is heard; the act of perceiving by sound or the auditory sense."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49dc866f-3288-4c2d-a831-9b321def0f35",
                                                "sense_id": "f99041a4-0d56-3884-830f-86968c14a4ce",
                                                "text": "To such perceivings we give names like these: seeings, hearings, smellings, chillings and burnings, pleasures and pains, desires […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "244ae827-a68c-3e78-b4ee-44b29885c2b5",
                                        "entry_id": "20e1bae3-f602-30c4-8e21-2f0ba34182ce",
                                        "glosses": [
                                            "A proceeding at which discussions are heard."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00b6484f-6a9e-4eb9-aaaa-be610eea18ee",
                                                "sense_id": "244ae827-a68c-3e78-b4ee-44b29885c2b5",
                                                "text": "There will be a public hearing to discuss the new traffic light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b786ad6-e784-38b7-ab5a-4270d2dd5aba",
                                        "entry_id": "20e1bae3-f602-30c4-8e21-2f0ba34182ce",
                                        "glosses": [
                                            "A legal procedure done before a judge, without a jury, as with an evidentiary hearing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "686d0216-1cb9-46d9-a69b-cb5155518486",
                                                "sense_id": "7b786ad6-e784-38b7-ab5a-4270d2dd5aba",
                                                "text": "Next month, Clemons will be brought before a court presided over by a \"special master\", who will review the case one last time. The hearing will be unprecedented in its remit, but at its core will be a simple issue: should Reggie Clemons live or die?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eab81884-6b58-3677-a930-466fb8e64b80",
                                        "entry_id": "20e1bae3-f602-30c4-8e21-2f0ba34182ce",
                                        "glosses": [
                                            "A scolding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
