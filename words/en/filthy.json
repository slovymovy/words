    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7c79bf0e-392b-3fcf-8071-96519b6989ce",
                    "sense_definition": "Covered with filth; very dirty.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Go and wash your <w>filthy</w> hands before you sit at the table.",
                            "target_lang_translations": {
                                "ru": "Иди и вымой свои <w>грязные</w> руки, прежде чем садиться за стол.",
                                "zh": "去餐桌前先把你的<w>脏</w>手洗干净。",
                                "es": "Ve a lavarte las manos <w>sucias</w> antes de sentarte a la mesa."
                            }
                        },
                        {
                            "text": "The streets were <w>filthy</w> and covered in litter after the festival.",
                            "target_lang_translations": {
                                "ru": "Улицы были <w>грязными</w> и завалены мусором после фестиваля.",
                                "zh": "节日过后，街道变得<w>肮脏</w>不堪，到处都是垃圾。",
                                "es": "Las calles estaban <w>mugrientas</w> y cubiertas de basura después del festival."
                            }
                        }
                    ],
                    "synonyms": [
                        "grimy",
                        "dirty",
                        "mucky"
                    ],
                    "antonyms": [
                        "pristine"
                    ],
                    "common_phrases": [
                        "filthy hands",
                        "filthy clothes",
                        "filthy water",
                        "filthy floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый грязью; очень грязный.",
                        "zh": "被污垢覆盖；非常脏。",
                        "es": "Cubierto de suciedad; muy sucio."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязный",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "запачканный",
                                "target_lang_sense_clarification": "имеющий пятна грязи"
                            },
                            {
