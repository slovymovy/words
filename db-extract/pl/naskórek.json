                                        "glosses": [
                                            "гистол. эпителиальный слой кожи, развивающийся из эктодермы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39baea03-9787-38f3-822f-1fdbc734b3fe",
                                        "entry_id": "0c4f1fc1-239c-3d94-9072-82dc75ddf4df",
                                        "glosses": [
                                            "ботан. наружный слой клеток растений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dda7877-fe84-49ff-af5a-5009ebd456d5",
                                                "sense_id": "39baea03-9787-38f3-822f-1fdbc734b3fe",
                                                "text": "Катехины сосредоточены в примыкающем к эпидермису слое мезофилла — слое зеленых клеток листа."
                                            }
