            {
                "entry_id": "a6d3e819-660c-38c6-bea5-05979d1bf95e",
                "word": "fusiforme",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cb874596-2a9c-4fb1-8bcc-3ba6a15e56e1",
                        "entry_id": "a6d3e819-660c-38c6-bea5-05979d1bf95e",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "fusiformes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7227cfe2-b16f-3627-ae75-5ba4dd960bfc",
                        "entry_id": "a6d3e819-660c-38c6-bea5-05979d1bf95e",
                        "glosses": [
                            "Qui a la forme d’un fuseau."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "57f7c989-bdbb-4825-a6fa-a84a8aae8059",
                                "sense_id": "7227cfe2-b16f-3627-ae75-5ba4dd960bfc",
                                "text": "Ces poissons ont une morphologie fusiforme, avec un dos convexe et une section plus ou moins cylindrique."
                            },
                            {
                                "example_id": "c00fa000-4221-48ec-a8d6-c0a2a07a7ff5",
                                "sense_id": "7227cfe2-b16f-3627-ae75-5ba4dd960bfc",
                                "text": "La pointe est fusiforme, les bords étant parallèles sur la zone centrale et convergents sur la zone proximale."
                            },
                            {
                                "example_id": "5bf89002-15e7-4a3b-b1c6-340a54c7fc93",
                                "sense_id": "7227cfe2-b16f-3627-ae75-5ba4dd960bfc",
                                "text": "De nombreuses amphores sont présentes et semblent faire l’objet d’une répartition spatiale selon leur forme : les globulaires au plus large de la coque, les fusiformes vers l’extrémité, ce qui permet d’envisager qu’il s’agit d’une partie du chargement initial du navire."
                            },
                            {
                                "example_id": "03c2e7e8-eab5-40cb-95e0-27410e008e7d",
                                "sense_id": "7227cfe2-b16f-3627-ae75-5ba4dd960bfc",
                                "text": "– « Ouî…î…î, Madame Colê…ê…tte », chantait à droite une voix d’ange aigrelet, probablement branché sur le cirrus fusiforme qui naviguait à la rencontre de la jeune lune."
                            },
                            {
                                "example_id": "16cc7bf7-2de8-4f46-90ea-baeecdcc78c7",
                                "sense_id": "7227cfe2-b16f-3627-ae75-5ba4dd960bfc",
                                "text": "De l’autre côté du mur bas et éboulé, un front cornu de chèvre toucha ma main, une paire de pupilles fusiformes me dévisagea."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a7b2b0e-c18a-4bb2-91a8-2bd93223ec54",
                        "source_entry_id": "a6d3e819-660c-38c6-bea5-05979d1bf95e",
                        "source_sense_id": "7227cfe2-b16f-3627-ae75-5ba4dd960bfc",
                        "target_lang_word": "spindelförmig",
                        "target_lang_code": "de",
