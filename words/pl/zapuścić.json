{
    "word_family": [
        "zapuszczać",
        "zapuszczenie",
        "opuszczać",
        "wpuszczać",
        "wypuszczać",
        "puszczać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e173f85a-4662-3f61-81f5-41633631d9f2",
                    "sense_definition": "pozwolić urosnąć włosom, brodzie lub paznokciom, nie obcinając ich",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wygląd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój brat postanowił <w>zapuścić</w> brodę, więc od dwóch miesięcy wcale się nie goli.",
                            "target_lang_translations": {
                                "ru": "Мой брат решил <w>отрастить</w> бороду, поэтому уже два месяца совсем не бреется."
                            }
                        },
                        {
                            "text": "Dziewczyna chciała mieć inną fryzurę i zaczęła <w>zapuszczać</w> włosy na wakacje.",
                            "target_lang_translations": {
                                "ru": "Девушка захотела другую прическу и стала <w>отращивать</w> волосы к каникулам."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyhodować"
                    ],
                    "common_phrases": [
                        "zapuścić brodę",
                        "zapuścić wąsy",
                        "zapuścić włosy",
                        "zapuścić paznokcie"
                    ],
                    "target_lang_definitions": {
                        "ru": "дать отрасти волосам, бороде или ногтям, не состригая их"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрастить",
                                "target_lang_sense_clarification": "волосы, бороду, ногти"
                            },
                            {
                                "target_lang_word": "отпустить",
                                "target_lang_sense_clarification": "бороду, усы, волосы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a660bbb-e0f1-3a80-801e-e4e261e95337",
                    "sense_definition": "doprowadzić coś do złego stanu przez zaniedbanie, brak opieki lub porządku",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zaniedbanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poprzedni właściciele bardzo <w>zapuścili</w> to mieszkanie i teraz wymaga ono generalnego remontu.",
                            "target_lang_translations": {
                                "ru": "Предыдущие владельцы сильно <w>запустили</w> эту квартиру, и теперь ей требуется капитальный ремонт."
                            }
                        },
                        {
                            "text": "Przez brak wolnego czasu zupełnie <w>zapuścił</w> ogród za domem.",
                            "target_lang_translations": {
                                "ru": "Из-за нехватки свободного времени он совершенно <w>забросил</w> сад за домом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zapuścić mieszkanie",
                        "zapuścić ogród"
                    ],
                    "target_lang_definitions": {
                        "ru": "довести что-либо до плохого состояния из-за небрежности, отсутствия ухода или порядка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запустить",
                                "target_lang_sense_clarification": "сад, квартиру, дела, здоровье"
                            },
                            {
                                "target_lang_word": "забросить",
                                "target_lang_sense_clarification": "оставить без ухода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae706907-8572-3221-83fa-c3502f96fbad",
                    "sense_definition": "wprowadzić lub wpuścić kogoś albo coś do wnętrza",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przemieszczanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz delikatnie <w>zapuścił</w> sondę w głąb przewodu pokarmowego pacjenta.",
                            "target_lang_translations": {
                                "ru": "Врач аккуратно <w>ввел</w> зонд в пищеварительный тракт пациента."
                            }
                        },
                        {
                            "text": "Mechanik ostrożnie <w>zapuścił</w> elastyczny przewód do rury, aby sprawdzić usterkę.",
                            "target_lang_translations": {
                                "ru": "Механик осторожно <w>опустил</w> гибкий шланг в трубу, чтобы проверить неисправность."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zapuścić sondę",
                        "zapuścić żurawia"
                    ],
                    "target_lang_definitions": {
                        "ru": "ввести или опустить что-либо (зонд, кабель) внутрь"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опустить",
                                "target_lang_sense_clarification": "внутрь емкости или трубы"
                            },
                            {
                                "target_lang_word": "ввести",
                                "target_lang_sense_clarification": "зонд, инструмент"
                            },
                            {
                                "target_lang_word": "засунуть",
                                "target_lang_sense_clarification": "погрузить вглубь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b45075e-f580-36f3-b57e-c154334ecc43",
                    "sense_definition": "opuścić coś w dół, aby coś zasłonić lub zakryć",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "opuszczanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kobieta <w>zapuściła</w> ciemne rolety, aby ostre słońce nie raziło jej w oczy.",
                            "target_lang_translations": {
                                "ru": "Женщина <w>опустила</w> темные жалюзи, чтобы яркое солнце не слепило глаза."
                            }
                        },
                        {
                            "text": "Gospodarz szybko <w>zapuścił</w> zasłony, chroniąc pokój przed chłodem.",
                            "target_lang_translations": {
                                "ru": "Хозяин быстро <w>задернул</w> шторы, защищая комнату от холода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zapuścić zasłony",
                        "zapuścić żaluzje"
                    ],
                    "target_lang_definitions": {
                        "ru": "опустить что-либо вниз, чтобы закрыть или заслонить"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опустить",
                                "target_lang_sense_clarification": "шторы, жалюзи"
                            },
                            {
                                "target_lang_word": "задернуть",
                                "target_lang_sense_clarification": "занавески"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4667844b-9d22-3641-883d-d38119453be8",
                    "sense_definition": "udać się gdzieś daleko, w nieznane, odległe lub niebezpieczne miejsce",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Turyści niechcący <w>zapuścili</w> się za daleko w głąb gęstego lasu.",
                            "target_lang_translations": {
                                "ru": "Туристы случайно <w>забрели</w> слишком далеко в глубь густого леса."
                            }
                        },
                        {
                            "text": "Wieczorem lepiej nie <w>zapuszczać</w> się w te podejrzane uliczki miasta.",
                            "target_lang_translations": {
                                "ru": "Вечером лучше не <w>заходить</w> в эти подозрительные переулки города."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zapuścić się za daleko",
                        "zapuścić się w las"
                    ],
                    "target_lang_definitions": {
                        "ru": "зайти или забрести слишком далеко, в незнакомое или опасное место"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зайти",
                                "target_lang_sense_clarification": "слишком далеко, вглубь"
                            },
                            {
                                "target_lang_word": "забраться",
                                "target_lang_sense_clarification": "в глушь, в чащу"
                            },
                            {
                                "target_lang_word": "забрести",
                                "target_lang_sense_clarification": "случайно попасть далеко"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91c2d70d-b0df-3483-be23-b543ac7c6482",
                    "sense_definition": "rozgadać się, rozwodzić się nadmiernie nad jakimś tematem",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mówienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wykładowca znowu za bardzo <w>zapuścił</w> się w dygresje i zabrakło mu czasu.",
                            "target_lang_translations": {
                                "ru": "Преподаватель снова чересчур <w>увлекся</w> отступлениями, и ему не хватило времени."
                            }
                        },
                        {
                            "text": "Podczas rozmowy <w>zapuścił</w> się w długie wspomnienia ze swojej młodości.",
                            "target_lang_translations": {
                                "ru": "Во время разговора он <w>ударился</w> в долгие воспоминания о своей молодости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zapuścić się w rozważania"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w potocznym stylu wypowiedzi"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "увлечься пространными рассуждениями или отвлечься от темы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "углубиться",
                                "target_lang_sense_clarification": "в рассуждения, в воспоминания"
                            },
                            {
                                "target_lang_word": "удариться",
                                "target_lang_sense_clarification": "в воспоминания, в отступления"
                            },
                            {
                                "target_lang_word": "пуститься",
                                "target_lang_sense_clarification": "в пространные рассуждения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}