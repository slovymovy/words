                        "cross_references": [
                            {
                                "target_word": "Aussteuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30a70c15-36b9-325f-a9a1-49be2e6009f6",
                                        "entry_id": "8a857944-249a-3dd7-aac4-d56770048a21",
                                        "glosses": [
                                            "Vermögen, in Form von Geld, Gütern oder Hausrat, das die Eltern ihrer Tochter bei der zukünftiger Heirat mitgeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39958e5b-2d63-44a6-b8f2-e3c97a83831b",
                                                "sense_id": "30a70c15-36b9-325f-a9a1-49be2e6009f6",
                                                "text": "„Seit dem Frühjahr 1965 warten zahllose junge Ehepaare auf die Entscheidung des Bundesverfassungsgerichts, ob selbst beschaffte Aussteuer steuerbegünstigt ist oder nicht.“"
                                            },
                                            {
                                                "example_id": "cd209e50-dbf0-426d-81a5-6c81b23bc45c",
                                                "sense_id": "30a70c15-36b9-325f-a9a1-49be2e6009f6",
                                                "text": "„Marja Dmitrijewna bestellte bei ihr fast die ganze Aussteuer für Natascha.“"
                                            },
                                            {
                                                "example_id": "47cd7132-072a-4ae7-8bde-4332331bdf11",
                                                "sense_id": "30a70c15-36b9-325f-a9a1-49be2e6009f6",
                                                "text": "„Den Töchtern seiner Schwestern schenkte er jeweils eine Aussteuer von 100 Reichstalern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d91ef11-e546-472f-84cc-8c0ab10551ed",
                        "source_entry_id": "c2bdee51-5301-3e13-a94d-db315ddd97cf",
                        "source_sense_id": "8596f7a5-e1ba-3393-bb3b-87de32043130",
                        "source_sense_description": "complete uitrusting van kleren, linnengoed, borden, etc. van een bruid of bruidspaar",
                        "target_lang_word": "outfit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outfit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8be03fb-6128-3b58-82df-bdfe33ed8483",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "A set of clothing (with accessories)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "428e6ed8-a0f8-4885-ab45-033453be0dcb",
                                                "sense_id": "d8be03fb-6128-3b58-82df-bdfe33ed8483",
                                                "text": "She wore a fashionable outfit with matching purse and shoes."
                                            },
                                            {
                                                "example_id": "dd86e578-270d-4d51-acbf-1eb31aa6e581",
                                                "sense_id": "d8be03fb-6128-3b58-82df-bdfe33ed8483",
                                                "text": "Don't call what you're wearing an outfit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca6ce33b-aef5-3396-b9bb-1ef00672d3ef",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "Gear consisting of a set of articles or tools for a specified purpose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d311f768-c527-3a46-bedc-50d5348e816c",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "Any cohesive group of people; a unit; such as a military company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f34deeb2-d1c5-47d7-8e67-24afbbd9ac20",
                                                "sense_id": "d311f768-c527-3a46-bedc-50d5348e816c",
                                                "text": "The League of One was suddenly exposed and in danger of being hunted by enemies of the salarians. Before any harm could be done, the team mysteriously disappeared.[...]Realizing the threat posed by this rogue outfit, the Special Tasks Group dispatched a team of hunters. When they didn't return, the STG dispatched ten of its brightest operators with broad discretionary powers. Only two returned; they reported no evidence of the League."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9364ab77-5b61-34aa-8cce-abb4bb474f1f",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "A business or firm."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79737ddb-22a7-4713-a187-ffde0196e938",
                                                "sense_id": "9364ab77-5b61-34aa-8cce-abb4bb474f1f",
                                                "text": "Should we buy it here, or do you think the outfit across town will have a better deal?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db7b5f09-ed37-3980-9f2b-30b15cdadda4",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "A sports team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3d716e-e45e-4dad-b18b-2beae695a2a7",
                                                "sense_id": "db7b5f09-ed37-3980-9f2b-30b15cdadda4",
                                                "text": "With only two fit centre-backs available, Tottenham boss Harry Redknapp employed young midfielder Jake Livermore at the back alongside Sebastien Bassong but Spurs struggled against a seasoned Champions League outfit, who beat Barcelona at the Nou Camp in 2009-10 and continually worked their way between the home defence to create some golden opportunities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f59af32-e3d9-3f8c-bb25-290c3b7f212a",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "An outlier-sensitive fit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a206c1c5-15e3-3ae2-8cb1-e6393a09b044",
                                        "entry_id": "00a5e12d-b490-39b4-9317-059f1d22e1d2",
                                        "glosses": [
                                            "A fiscal year of the Hudson's Bay Company, or the supplies required for such a period."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "128c0f25-5da8-40c0-bcbd-67ed69845284",
                                                "sense_id": "a206c1c5-15e3-3ae2-8cb1-e6393a09b044",
                                                "text": "[…] the outfit of 1821, which outfit suffered a loss. From 1822 there were profits on each outfit as the many subsequent credit entries indicate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outfit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15a66150-358c-3b3c-8838-c6f4fc6485ce",
                                        "entry_id": "26be500a-4ee0-3c7f-92da-09a4e474a892",
                                        "glosses": [
                                            "To provide with, usually for a specific purpose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f823770-4c30-4e62-9dd9-aa4823d08c99",
                                                "sense_id": "15a66150-358c-3b3c-8838-c6f4fc6485ce",
                                                "text": "The expedition was outfitted with proper clothing, food, and other necessities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02844ebb-76de-4d20-b332-9911bf3dc7c6",
                        "source_entry_id": "c2bdee51-5301-3e13-a94d-db315ddd97cf",
                        "source_sense_id": "8596f7a5-e1ba-3393-bb3b-87de32043130",
                        "source_sense_description": "complete uitrusting van kleren, linnengoed, borden, etc. van een bruid of bruidspaar",
                        "target_lang_word": "trousseau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trousseau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "804966eb-16a3-38e5-a42c-b46ffacd9918",
                                        "entry_id": "325405ec-b0bc-36a9-ad7c-4285ca3e6a77",
                                        "glosses": [
                                            "Petite trousse."
                                        ],
                                        "tags": [],
                                        "note": "Il n’est guère usité, en ce sens, que dans l'expression ; trousseau de clefs",
                                        "examples": [
                                            {
                                                "example_id": "8351e36b-8834-488b-9560-a867f60f701f",
                                                "sense_id": "804966eb-16a3-38e5-a42c-b46ffacd9918",
                                                "text": "Comme maîtresse de maison, Alix a en gouvernation les clefs des appartements. Elle a tiré du trousseau poudreux relégué a l'office la clef qui ouvre la porte de la chambre de son cousin, […]."
                                            },
                                            {
                                                "example_id": "aadff71d-905f-40c2-86f6-474c0d1c88a9",
                                                "sense_id": "804966eb-16a3-38e5-a42c-b46ffacd9918",
                                                "text": "Un matin d’hiver, il partit avant le jour, bien équipé, une arbalète sur l’épaule et un trousseau de flèches à l’arçon de la selle."
                                            },
                                            {
                                                "example_id": "f521c36f-64b3-404b-a34d-8f6134970220",
                                                "sense_id": "804966eb-16a3-38e5-a42c-b46ffacd9918",
                                                "text": "Toutes les clés de la maison, des armoires et des coffres, cliquetaient autour de sa taille en un trousseau noué à sa ceinture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "384e338e-dfc1-35db-95a3-f0f2cfb6131b",
                                        "entry_id": "325405ec-b0bc-36a9-ad7c-4285ca3e6a77",
                                        "glosses": [
                                            "Vêtements, linge, tout ce qu’on donne à une jeune fille lorsqu’elle se marie ou se fait religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d84981b-1d25-4eca-8f9a-92515e7af791",
                                                "sense_id": "384e338e-dfc1-35db-95a3-f0f2cfb6131b",
                                                "text": "Elle cousait, de ses petites mains maladroites, son humble trousseau de fiancée nomade."
                                            },
                                            {
                                                "example_id": "577e4cb6-aea7-47d4-b638-403c3066532e",
                                                "sense_id": "384e338e-dfc1-35db-95a3-f0f2cfb6131b",
                                                "text": "A douze ans, les filles se marient, si toutefois elles ont un trousseau complet ; autrement, les partis ne se présenteraient pas. Ce trousseau, il faut qu'elles le fassent elles-mêmes; la plus habile est la mieux ornée."
                                            },
                                            {
                                                "example_id": "e80baeed-bbab-4952-b6b5-ed419a8410ca",
                                                "sense_id": "384e338e-dfc1-35db-95a3-f0f2cfb6131b",
                                                "text": "MARIE. – Moi, madame, j’aurai dix mille francs de dot. Mon trousseau est prêt depuis longtemps. C’est celui d’une sœur de ma mère qui est morte à dix-huit ans, il y a une vingtaine d’années. J’aurai aussi une machine à coudre qu’on a gagnée à la loterie."
                                            },
                                            {
                                                "example_id": "52faa23d-6f5b-4fe7-880f-de4194ed458c",
                                                "sense_id": "384e338e-dfc1-35db-95a3-f0f2cfb6131b",
                                                "text": "Dose après dose, les éditeurs ont scellé un pacte tacite avec la plateforme, un pacte aux allures de mariage de raison. Il faut dire que le trousseau de la mariée est bien garni avec ses deux milliards d’utilisateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3270437-e83a-3196-985e-ce5f63f2a360",
                                        "entry_id": "325405ec-b0bc-36a9-ad7c-4285ca3e6a77",
                                        "glosses": [
                                            "Ensemble des vêtements, du linge, etc., que devait apporter un élève, ou qu’on lui fournissait, lors de son entrée dans une école, dans une maison d’éducation, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620c0201-763c-4e36-bdde-15a73a8a9838",
                                                "sense_id": "b3270437-e83a-3196-985e-ce5f63f2a360",
                                                "text": "Les pièces dont se compose le trousseau réglementaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41171fc1-8a2a-3c63-8aff-7af8c863a178",
                                        "entry_id": "325405ec-b0bc-36a9-ad7c-4285ca3e6a77",
                                        "glosses": [
                                            "Liste de vêtements que les enfants doivent avoir lorsqu’ils partent en colonie de vacances, en centre ou à l’hôpital."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e58b4c47-e895-4c64-95cb-4e02ebb852e4",
                                                "sense_id": "41171fc1-8a2a-3c63-8aff-7af8c863a178",
                                                "text": "Avant de partir, je dois t’acheter des chaussettes pour compléter ton trousseau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trousseau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f4b200a-bb01-3f5b-9fb1-bd95000131dd",
                                        "entry_id": "f0d3c9c3-63bb-34d8-a0c7-e5aee8759222",
                                        "glosses": [
                                            "Cépage originaire du Jura, où il est utilisé pour les vins rouges."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2710b488-70f9-4a71-b5df-01ee8ab95046",
                                                "sense_id": "7f4b200a-bb01-3f5b-9fb1-bd95000131dd",
                                                "text": "L’appellation Arbois, qui se décline en blanc et en rosé, est surtout connue pour ses rouges réalisés avec le trousseau, un cépage authentique d’origine comtoise et qui fournit des vins élégants et lumineux aux saveurs poivrées et épicées."
                                            },
                                            {
                                                "example_id": "74384dbe-50cd-4ba6-8967-85e01219d819",
                                                "sense_id": "7f4b200a-bb01-3f5b-9fb1-bd95000131dd",
                                                "text": "Capitale du cépage du trousseau, Montigny est un village bâti en amphithéâtre sur le versant occidental du Jura."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
