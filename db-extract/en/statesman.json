                    },
                    {
                        "translation_id": "a10b2a19-3ba2-4767-8cc1-3ca1c7216018",
                        "source_entry_id": "01e930aa-1931-3840-b4a8-494a2862a230",
                        "source_sense_description": "man who is a leader in national or international affairs",
                        "target_lang_word": "Staatsmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staatsmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35154357-c940-332f-84a2-32910288a15f",
                                        "entry_id": "0f4cdafd-f6fc-3a37-b792-6a4aa8124879",
                                        "glosses": [
                                            "exponierter Mann mit einem politisch ausgerichteten Beruf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d25edda-fea1-4782-9bfc-8fc22fd05674",
                                                "sense_id": "35154357-c940-332f-84a2-32910288a15f",
                                                "text": "Er war ein großer Staatsmann."
                                            },
                                            {
                                                "example_id": "1043c6c5-b657-411a-b23f-d9c993f86dbe",
                                                "sense_id": "35154357-c940-332f-84a2-32910288a15f",
                                                "text": "„Im Zeichen des guten Willens standen die Weihnachts- und Neujahrsbotschaften der Staatsmänner. Der Gedanke der Völkerverständigung soll als Leitstern über dem Jahre 1947 stehen.“"
                                            },
                                            {
                                                "example_id": "54698553-4db5-43b3-8c43-4b27be538213",
                                                "sense_id": "35154357-c940-332f-84a2-32910288a15f",
                                                "text": "„Der Witz ist hübsch boshaft, sodass es sich lohnt, ihn über die Abwanderung des Betroffenen in das Rollenfach alter, edler Staatsmann auf Friedensmission hinaus zu bewahren.“"
                                            },
                                            {
                                                "example_id": "8d7ec596-40ee-4774-9d33-5c4790bb8860",
                                                "sense_id": "35154357-c940-332f-84a2-32910288a15f",
                                                "text": "„Fürst Andrej hatte Speranskij noch nie lachen hören, und nun machte ihm das klangvolle, helle Lachen des Staatsmannes einen ganz eigenartigen Eindruck.“"
                                            },
                                            {
                                                "example_id": "de612c13-6bf7-4ad7-b8f1-8294eb4844f3",
                                                "sense_id": "35154357-c940-332f-84a2-32910288a15f",
                                                "text": "„Alle drei Staatsmänner versteckten sich also.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
