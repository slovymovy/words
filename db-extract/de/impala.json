                                "target_senses": [
                                    {
                                        "sense_id": "a0d78685-d863-32ba-ba6e-c8c51941e499",
                                        "entry_id": "ad14dae9-009c-3795-a39d-5866d209cd15",
                                        "glosses": [
                                            "Espèce d’antilope des savanes d’Afrique de l’Est et australe qui a des marques noires uniques à chaque individu au bout des oreilles, sur le dos de la queue et sur le front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0bf7dc8-57b2-4e01-848a-4037dacaf36b",
                                                "sense_id": "a0d78685-d863-32ba-ba6e-c8c51941e499",
                                                "text": "Parmi les impalas qui portaient sur chacun de leurs flancs dorés une flèche noire, et qui étaient les plus gracieuses des antilopes, et les plus promptes à l’effroi, Patricia montrait celles qui la recevaient sans crainte."
                                            },
                                            {
                                                "example_id": "5981a228-bce8-4cbf-8c7b-8d832c7af91d",
                                                "sense_id": "a0d78685-d863-32ba-ba6e-c8c51941e499",
                                                "text": "L’impala à face noire est une espèce endémique au nord-ouest namibien et au sud-ouest angolais, ce qui veut dire que vous ne verrez cette antilope nulle part ailleurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
