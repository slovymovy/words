                        "examples": [
                            {
                                "example_id": "3e3ff03a-2e87-45dc-af9b-b3c6184c761f",
                                "sense_id": "8fb312f3-2395-39a2-ba72-ac274f9facaf",
                                "text": "Les plus importants péages se trouvaient le long du Rhin (Cologne, Lobith, Arnhem), de la Meuse (Roermond), de l’IJssel (Zutphen), et sur le Waal (Nimègue, Tiel, Zaltbommel)."
                            },
                            {
                                "example_id": "dfbf5272-dae6-4665-9b8d-f9721acdac3d",
                                "sense_id": "8fb312f3-2395-39a2-ba72-ac274f9facaf",
                                "text": "Même dans le delta rhénan, entre l’IJssel et le bras principal du fleuve, au nord d’Arnhem, s’élèvent les coteaux de la Veluwe, longues chaînes, qu’embellissent les bois, les jardins, le prairies dans le voisinage d’Arnhem et des autres villes, mais qui partout ailleurs sont couvertes de bruyères […]"
                            }
                        ]
                    }
