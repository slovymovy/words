                        {
                            "text": "The done bell on the <w>nuke</w> went off, signaling the food was hot.",
                            "target_lang_translations": {
                                "ru": "На <w>микроволновке</w> прозвенел сигнал, сообщая, что еда разогрелась."
                            }
                        }
                    ],
                    "synonyms": [
                        "microwave"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for the appliance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Микроволновая печь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "микроволновка",
                                "target_lang_sense_clarification": "бытовой прибор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fef3c12a-3029-3f42-b4b5-edb599558408",
                    "sense_definition": "A nuclear power station.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nuclear_energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters gathered outside the <w>nuke</w> to demand its closure.",
                            "target_lang_translations": {
                                "ru": "Протестующие собрались у <w>АЭС</w>, требуя её закрытия."
                            }
                        },
                        {
                            "text": "He calculates that <w>nukes</w> might be needed to power large scale energy projects.",
                            "target_lang_translations": {
                                "ru": "Он подсчитал, что <w>атомные станции</w> могут понадобиться для обеспечения энергией крупных проектов."
                            }
                        }
                    ],
                    "synonyms": [
                        "nuclear plant"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for power plants"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атомная электростанция."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "АЭС",
                                "target_lang_sense_clarification": "атомная станция"
                            },
                            {
                                "target_lang_word": "атомка",
                                "target_lang_sense_clarification": "разговорное название станции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b16ba6bc-5fe9-3938-8e3a-89c271617219",
                    "sense_definition": "A person, such as a sailor or scientist, who works with nuclear weapons or nuclear power.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nuclear_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Navy <w>nukes</w> are responsible for maintaining the nuclear-powered fleet.",
                            "target_lang_translations": {
                                "ru": "Флотские <w>атомщики</w> отвечают за обслуживание атомного флота."
                            }
                        },
                        {
                            "text": "As a trained <w>nuke</w>, he understood the complexities of reactor safety.",
                            "target_lang_translations": {
                                "ru": "Как обученный <w>специалист-ядерщик</w>, он понимал все сложности безопасности реактора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "navy nukes"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "jargon used within the military or nuclear industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек (моряк или ученый), работающий с ядерным оружием или энергетикой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атомщик",
                                "target_lang_sense_clarification": "специалист по ядерной технике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9251f63-a0c9-38e0-91f8-4bcfc89d60bd",
                    "sense_definition": "A vessel, such as a ship or submarine, running on nuclear power.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nuclear_vessels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a <w>nuke</w>, you only come to periscope depth once every few days.",
                            "target_lang_translations": {
                                "ru": "На <w>атомной подлодке</w> всплываешь на перископную глубину лишь раз в несколько дней."
                            }
