                    {
                        "form_id": "b4293f54-37a0-4c65-a758-f28a7b57e637",
                        "entry_id": "1dc8cbb5-a801-3131-a522-c79be2ebfb87",
                        "tags": [
                            "feminine"
                        ],
                        "form": "échappée"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53ee8b99-d482-343f-a908-2afb34c75e88",
                        "entry_id": "1dc8cbb5-a801-3131-a522-c79be2ebfb87",
                        "glosses": [
                            "Fou qui a été enfermé ou qui pourrait l’être."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dd652497-a00d-4923-8350-41e7186a7727",
                                "sense_id": "53ee8b99-d482-343f-a908-2afb34c75e88",
                                "text": "Un échappé de Charenton, ou des petites maisons."
                            }
                        ]
                    },
                    {
                        "sense_id": "16c0759a-af90-3831-8e03-b7748511c667",
                        "entry_id": "1dc8cbb5-a801-3131-a522-c79be2ebfb87",
                        "glosses": [
                            "Personne qui s’est sauvée du bagne, d’une prison, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "168e3504-7903-4c00-ad7d-5094e66c5dd8",
                                "sense_id": "16c0759a-af90-3831-8e03-b7748511c667",
                                "text": "Un échappé du bagne, de prison."
                            },
                            {
                                "example_id": "1231661b-6822-4a73-9985-53b024876502",
                                "sense_id": "16c0759a-af90-3831-8e03-b7748511c667",
                                "text": "Il se mit à fréquenter l’école de dessin, où il se lia avec un jeune échappé du collége qui lui prêta son ancien traité de géométrie."
                            },
                            {
                                "example_id": "e2656c58-47d3-4c26-9761-56dc530b4ae3",
                                "sense_id": "16c0759a-af90-3831-8e03-b7748511c667",
                                "text": "Malgré de sensibles défauts, malgré l’humilité de son origine, ce fils de paysans et de pauvres marins, couvert du triple ridicule d’échappé de séminaire, de clerc défroqué, de cuistre endurci, on l’a tout d’abord accueilli, écouté, choyé même, uniquement parce qu’on trouvait dans sa voix des accents sincères."
                            },
                            {
                                "example_id": "6b5cc979-a8c0-4ff4-99c7-4867d5bfdb34",
                                "sense_id": "16c0759a-af90-3831-8e03-b7748511c667",
                                "text": "Lefèvre est un échappé de Bicêtre ; Maillard est un intrigant que la société des Cordeliers a chassé de son sein et qui a fait tout pour la détruire."
                            }
                        ]
                    },
                    {
                        "sense_id": "db2d7f06-aa63-389e-a275-21c128f6b7f9",
                        "entry_id": "1dc8cbb5-a801-3131-a522-c79be2ebfb87",
                        "glosses": [
                            "Hauteur mesurée à la verticale entre le nez de marche et le plafond. On dit aussi échappement."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9898b3ab-4224-3b0f-999d-2ac22d469900",
                "word": "échappé",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9865dcbf-c4be-3e8c-a970-4c8d019af910",
                        "entry_id": "9898b3ab-4224-3b0f-999d-2ac22d469900",
                        "glosses": [
                            "Participe passé masculin singulier de échapper."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "889b7ec8-a859-47e7-96a3-5cb74240a328",
                                "sense_id": "9865dcbf-c4be-3e8c-a970-4c8d019af910",
                                "text": "Si prompt qu’il eût été, ce mouvement n’avait cependant pas échappé à Hilda qui sourit avec un peu d’amertume et hocha approbativement la tête ; dans son regard, clair et droit, Serge Brunof lut sans peine la vérité."
                            },
                            {
                                "example_id": "9e68edb0-05b4-4ff7-92a4-be9d2e2f8109",
                                "sense_id": "9865dcbf-c4be-3e8c-a970-4c8d019af910",
                                "text": "Un lion adulte s’est échappé d’un cirque à Ladispoli (Italie), samedi."
                            }
                        ]
                    }
                ],
