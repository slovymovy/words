                "senses": [
                    {
                        "sense_id": "712f8ca0-ab43-31eb-8fb8-159389f9d65e",
                        "entry_id": "140d9034-d186-3bc3-a58b-486bcdd32276",
                        "glosses": [
                            "устар. это, то"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41118b82-b80f-4c8e-8b5a-a6542188d47e",
                                "sense_id": "712f8ca0-ab43-31eb-8fb8-159389f9d65e",
                                "text": "Как вы смеете назвать его ни тем ни сем, да ещё и чорт знает чем?"
                            },
                            {
                                "example_id": "a61bec91-4313-4597-8d33-bd9526b89da1",
                                "sense_id": "712f8ca0-ab43-31eb-8fb8-159389f9d65e",
                                "text": "А ведь хлопотливая, чорт возьми, вещь — женитьба! То, да сё, да это."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "901f0f10-1f07-4c60-9984-3f8c0338e30a",
                        "source_entry_id": "140d9034-d186-3bc3-a58b-486bcdd32276",
                        "source_sense_id": "712f8ca0-ab43-31eb-8fb8-159389f9d65e",
                        "target_lang_word": "this",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "this",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0d202f6-a39d-3d61-8346-944cb0b83fdf",
                                        "entry_id": "6d51cc39-f589-32c3-a73c-02075860b124",
                                        "glosses": [
                                            "The (thing) here (used in indicating something or someone nearby)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7539d75b-2522-48cd-8857-049707c6b437",
                                                "sense_id": "e0d202f6-a39d-3d61-8346-944cb0b83fdf",
                                                "text": "This classroom is where I learned to read and write."
                                            },
                                            {
                                                "example_id": "ffb4495b-280f-48b9-b59c-2a5b284897c6",
                                                "sense_id": "e0d202f6-a39d-3d61-8346-944cb0b83fdf",
                                                "text": "Right, boys, as much fun as this night has been, this girl is tired, so I'm gonna hit the hay."
                                            },
                                            {
                                                "example_id": "d48568ab-c0d9-46cf-970e-eac923b4f6a6",
                                                "sense_id": "e0d202f6-a39d-3d61-8346-944cb0b83fdf",
                                                "text": "\"As far as I can tell, there's been no journalistic interest in these basic issues of why Wikipedia editors make the decisions they do, and how they give effect to them, despite the fact the announcement of the ban was basically worldwide news,\" wrote Reddit user ronsmith7. Well, ronsmith7, today is your lucky day because this journalist is interested in those issues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "769bd021-5314-3f14-952f-4f82105ba9bc",
                                        "entry_id": "6d51cc39-f589-32c3-a73c-02075860b124",
                                        "glosses": [
                                            "The (thing) here (used in indicating something or someone nearby).",
                                            "Referring to oneself."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29ffff39-ef92-4b58-bddc-c200c64299e5",
                                                "sense_id": "769bd021-5314-3f14-952f-4f82105ba9bc",
                                                "text": "Hey, you know what's got two thumbs and really likes brownies? This guy!"
                                            },
                                            {
                                                "example_id": "6810cb89-0884-443a-ae02-7d9882018ff3",
                                                "sense_id": "769bd021-5314-3f14-952f-4f82105ba9bc",
                                                "text": "I am no longer your little naïve toy. I am a woman. All woman. And this woman is tired of your crap."
                                            },
                                            {
                                                "example_id": "781d654e-e803-4aad-9b44-461f22322655",
                                                "sense_id": "769bd021-5314-3f14-952f-4f82105ba9bc",
                                                "text": "\"You'll find another way. This girl is done.\" Hayden let his gun fall to the ground. \"You can shoot me if you want. It's your call.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "623683db-d55d-3688-9d10-bc4ca3864ab0",
                                        "entry_id": "6d51cc39-f589-32c3-a73c-02075860b124",
                                        "glosses": [
                                            "The known (thing) (used in indicating something or someone just mentioned)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e799a4-85af-4839-93c9-f910719ed919",
                                                "sense_id": "623683db-d55d-3688-9d10-bc4ca3864ab0",
                                                "text": "They give the appearance of knowing what they're doing. It's this appearance that lets them get away with so much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "412993cd-050b-3f9e-8b2c-25693a6565e9",
                                        "entry_id": "6d51cc39-f589-32c3-a73c-02075860b124",
                                        "glosses": [
                                            "The known (thing) (used in indicating something or someone about to be mentioned)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e9154d-5f65-4b4e-b999-2359b68f36dc",
                                                "sense_id": "412993cd-050b-3f9e-8b2c-25693a6565e9",
                                                "text": "When asked what he wanted for his birthday, he gave this reply: “[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51b387e0-c903-320d-a44a-dfc8a28c9c27",
                                        "entry_id": "6d51cc39-f589-32c3-a73c-02075860b124",
                                        "glosses": [
                                            "A known (thing) (used in first mentioning a person or thing that the speaker does not think is known to the audience). Compare with \\\"a certain ...\\\"."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c0604b-0a20-46f7-99c9-1a36b6d15c8b",
                                                "sense_id": "51b387e0-c903-320d-a44a-dfc8a28c9c27",
                                                "text": "I met this woman the other day who's allergic to wheat. I didn't even know that was possible!"
                                            },
                                            {
                                                "example_id": "39695e3c-838e-4dc8-b0d7-7b672ac881c7",
                                                "sense_id": "51b387e0-c903-320d-a44a-dfc8a28c9c27",
                                                "text": "There's just this nervous mannerism that Bob has with his hands, and it drives me crazy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e93922c-c857-34be-8647-eed178a4c486",
                                        "entry_id": "6d51cc39-f589-32c3-a73c-02075860b124",
                                        "glosses": [
                                            "Designates the current or next instance."
                                        ],
                                        "tags": [
                                            "of a time reference"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "812e23c3-87a2-465c-ba65-c0457e0aaf24",
                                                "sense_id": "1e93922c-c857-34be-8647-eed178a4c486",
                                                "text": "It's cold this morning."
                                            },
                                            {
                                                "example_id": "e2a93093-c4c1-4b2d-a4e4-a252263658c7",
                                                "sense_id": "1e93922c-c857-34be-8647-eed178a4c486",
                                                "text": "I plan to go to London this Friday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "this",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5323c7df-6d03-378f-aa3f-e4e3d0a71dbf",
                                        "entry_id": "39bb7643-941f-3938-9bc4-459c5d42a7e8",
                                        "glosses": [
                                            "To the degree or extent indicated."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2e9db86-f096-44b5-8acf-e6116d48ebc6",
                                                "sense_id": "5323c7df-6d03-378f-aa3f-e4e3d0a71dbf",
                                                "text": "I need this much water."
                                            },
                                            {
                                                "example_id": "f7b0e874-822c-4867-96f4-3229671dc711",
                                                "sense_id": "5323c7df-6d03-378f-aa3f-e4e3d0a71dbf",
                                                "text": "Do we need this many recommendations?"
                                            },
                                            {
                                                "example_id": "d3c8e62b-2ecb-48fc-9b57-b01e49ce6c1d",
                                                "sense_id": "5323c7df-6d03-378f-aa3f-e4e3d0a71dbf",
                                                "text": "We've already come this far, we can't turn back now."
                                            },
                                            {
                                                "example_id": "b3d04847-728e-4d1c-a25a-d65ffa500193",
                                                "sense_id": "5323c7df-6d03-378f-aa3f-e4e3d0a71dbf",
                                                "text": "I couldn't garage this big a car; show me something smaller."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "this",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce625d21-8422-39f2-bdab-1b76976d2d44",
                                        "entry_id": "5220fcd0-8167-3d13-9f1a-2fe238af93e2",
                                        "glosses": [
                                            "The thing, item, etc. being indicated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f81f32f7-a26a-4066-91f0-b3e460880a9e",
                                                "sense_id": "ce625d21-8422-39f2-bdab-1b76976d2d44",
                                                "text": "This isn't the item that I ordered."
                                            },
                                            {
                                                "example_id": "853f1f3d-7d58-49a4-aca0-d4e1f65fb929",
                                                "sense_id": "ce625d21-8422-39f2-bdab-1b76976d2d44",
                                                "text": "This is the excellent foppery of the world, that, when we are sick in fortune,—often the surfeit of our own behaviour,—we make guilty of our disasters the sun, the moon, and the stars[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "this",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e12eca1-ccb2-3902-b48d-42cb76395bb9",
                                        "entry_id": "405deafc-26c6-323e-aa3d-854e2a86d9cc",
                                        "glosses": [
                                            "Something being indicated that is here; one of these."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e42efc-6ed3-4782-8590-042e3a98536b",
                                                "sense_id": "3e12eca1-ccb2-3902-b48d-42cb76395bb9",
                                                "text": "Terms like 'house', 'sphere', 'animal', and 'human' do not refer to other thises distinct from these ones here — they refer to the sort of thing these ones here are."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "this",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1793434a-ed54-396b-a65d-a57eb7e882cd",
                                        "entry_id": "674540e1-d64f-3550-900d-9b5c5d0d1b6e",
                                        "glosses": [
                                            "Indicates the speaker's strong approval or agreement with the previous material."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "058f1806-927f-47c4-a60c-9ccc4a294e20",
                                                "sense_id": "1793434a-ed54-396b-a65d-a57eb7e882cd",
                                                "text": "― I wish trolls could be banned from the forum immediately, without any discussion.\n― This!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
