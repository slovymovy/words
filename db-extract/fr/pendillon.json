                "senses": [
                    {
                        "sense_id": "a3e59f68-144e-3d06-9ffe-a3b57d0ed6d1",
                        "entry_id": "067bfa6a-12d2-3dd9-bd14-a09d8a241b47",
                        "glosses": [
                            "Verge, dite aussi fourchette, rivée avec la tige de l'échappement, pour communiquer le mouvement au pendule d'une horloge, et le maintenir en vibration."
                        ],
                        "tags": [
                            "Horlogerie"
                        ],
                        "examples": [
                            {
                                "example_id": "93a7cf5e-eac3-462c-9fe7-2f55921fc4be",
                                "sense_id": "a3e59f68-144e-3d06-9ffe-a3b57d0ed6d1",
                                "text": "Hors de ce point, marqué sur le cadran par une ligne noire qui s'étend d'un quart d'heure avant midi au quart après midi, le pendillon vacillera toutes les fois que sa goupille tombera dans l'encoche de la rondelle de détente."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2417378-610b-398e-a1ea-334a9a276c15",
                        "entry_id": "067bfa6a-12d2-3dd9-bd14-a09d8a241b47",
                        "glosses": [
                            "Verge, dite aussi fourchette, rivée avec la tige de l'échappement, pour communiquer le mouvement au pendule d'une horloge, et le maintenir en vibration.",
                            "Ce qui met en mouvement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6949d396-1a31-4375-8cdd-2451fab405cd",
                                "sense_id": "b2417378-610b-398e-a1ea-334a9a276c15",
                                "text": "En attendant, je vous recommande la rate de ma mère ; vous êtes pour les vapeurs le meilleur pendillon du monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b7cb957-86de-3e71-9fe0-d71533042f6a",
                        "entry_id": "067bfa6a-12d2-3dd9-bd14-a09d8a241b47",
                        "glosses": [
                            "Pendeloque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1c6a4f-f389-4744-8abc-19e76dbfed41",
                                "sense_id": "1b7cb957-86de-3e71-9fe0-d71533042f6a",
                                "text": "Autour du cou [des Mauresques et Israélites d'Algérie], des colliers garnis de plaques diverses avec ou sans pendillons."
                            }
                        ]
                    }
