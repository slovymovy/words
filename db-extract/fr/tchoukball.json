        "fr-extract.jsonl": [
            {
                "entry_id": "4e1baaa1-26e0-3e03-b5fd-2f9cf34961c6",
                "word": "tchoukball",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "24c8b8c7-3a5d-380d-9be3-71278a7c34b8",
                        "entry_id": "4e1baaa1-26e0-3e03-b5fd-2f9cf34961c6",
                        "glosses": [
                            "Sport de ballon rappelant le handball, mais excluant tout contact et même toute obstruction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deba28f7-075b-4f10-95db-07ae5259d45f",
                                "sense_id": "24c8b8c7-3a5d-380d-9be3-71278a7c34b8",
                                "text": "Le tchoukball puise beaucoup dans le handball, avec un peu de volleyball et même une petite touche de ballon-chasseur."
                            },
                            {
                                "example_id": "440f4d32-9b08-49b6-9e41-149f1286ab38",
                                "sense_id": "24c8b8c7-3a5d-380d-9be3-71278a7c34b8",
                                "text": "Et chose peu commune dans les sports traditionnels, ici on ne gêne pas le joueur adverse. Si c’est une question de fairplay, c’est surtout l’essence même du tchoukball. En effet, c’est avant tout pour limiter les contacts et les chocs violents entre athlètes qu’un docteur suisse a inventé ce sport dans les années 60."
                            },
                            {
                                "example_id": "f8c59fb0-3e30-4d74-91aa-0eef1d0c0aaf",
                                "sense_id": "24c8b8c7-3a5d-380d-9be3-71278a7c34b8",
                                "text": "« Tchouk, c’est le bruit que fait le ballon quand il rebondit sur le trampoline » explique Valentin Bienvenu-Rouillon, jeune joueur de tchoukball à Melle."
                            }
                        ]
                    }
                ],
