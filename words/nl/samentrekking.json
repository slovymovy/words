    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16e3abd7-785c-33ed-8aba-f14e9a07075e",
                    "sense_definition": "Het korter en dikker worden van spierweefsel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De snelle <w>samentrekking</w> van de hartspier zorgt ervoor dat het bloed door het lichaam wordt gepompt.",
                            "target_lang_translations": {
                                "en": "The rapid <w>contraction</w> of the heart muscle ensures that blood is pumped through the body."
                            }
                        },
                        {
                            "text": "Een plotselinge <w>samentrekking</w> van de spieren kan een pijnlijke kramp veroorzaken.",
                            "target_lang_translations": {
                                "en": "A sudden <w>contraction</w> of the muscles can cause a painful cramp."
                            }
                        }
                    ],
                    "synonyms": [
                        "contractie"
                    ],
                    "common_phrases": [
                        "samentrekking van spieren",
                        "plotselinge samentrekking"
                    ],
                    "target_lang_definitions": {
                        "en": "The shortening and thickening of muscle tissue"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contraction",
                                "target_lang_sense_clarification": "of muscles"
                            },
                            {
                                "target_lang_word": "spasm",
                                "target_lang_sense_clarification": "sudden involuntary contraction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19ea0ab7-3224-39e2-853c-ff2b3dd15b0d",
                    "sense_definition": "Het weglaten van gemeenschappelijke woorden of zinsdelen in een zin om herhaling te voorkomen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "taalkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>samentrekking</w> in deze zin maakt de bepaling helaas erg onduidelijk.",
                            "target_lang_translations": {
                                "en": "The <w>contraction</w> in this sentence unfortunately makes the clause very unclear."
                            }
                        },
                        {
                            "text": "In de zin 'hij drinkt bier en zij wijn' is sprake van een grammaticaal correcte <w>samentrekking</w>.",
                            "target_lang_translations": {
                                "en": "In the sentence 'he drinks beer and she wine' there is a grammatically correct <w>ellipsis</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "foutieve samentrekking",
                        "grammaticale samentrekking"
                    ],
                    "target_lang_definitions": {
                        "en": "The omission of shared words or parts of a sentence to avoid repetition"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contraction",
                                "target_lang_sense_clarification": "linguistic shortening of words"
                            },
                            {
                                "target_lang_word": "ellipsis",
                                "target_lang_sense_clarification": "omission of words in a sentence"
                            },
                            {
                                "target_lang_word": "zeugma",
                                "target_lang_sense_clarification": "rhetorical figure of coordination"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21fe9019-6138-3767-80d6-fb0b47dd7931",
                    "sense_definition": "Het proces of de handeling waarbij iets naar elkaar toe getrokken of verkleind wordt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysiek_proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>samentrekking</w> van het materiaal door de kou veroorzaakte kleine scheurtjes.",
                            "target_lang_translations": {
                                "en": "The <w>contraction</w> of the material due to the cold caused small cracks."
                            }
                        },
                        {
                            "text": "Door de geleidelijke <w>samentrekking</w> van de ring sluit de opening zich volledig.",
                            "target_lang_translations": {
                                "en": "Due to the gradual <w>constriction</w> of the ring, the opening closes completely."
                            }
                        }
                    ],
                    "synonyms": [
                        "contractie"
                    ],
                    "common_phrases": [
                        "samentrekking van het materiaal"
                    ],
                    "target_lang_definitions": {
                        "en": "The process or act of pulling together or shrinking"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contraction",
                                "target_lang_sense_clarification": "shrinking of materials"
                            },
                            {
                                "target_lang_word": "shrinkage",
                                "target_lang_sense_clarification": "reduction in size"
                            },
                            {
                                "target_lang_word": "constriction",
                                "target_lang_sense_clarification": "narrowing or tightening"
                            }
                        ]
                    }
                }
            ]
        }
    ]
