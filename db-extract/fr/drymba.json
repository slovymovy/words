                "senses": [
                    {
                        "sense_id": "eb43a115-01e5-3996-a512-b4fa8a39a973",
                        "entry_id": "9f9f7856-49b3-35ac-9485-918f877fd910",
                        "glosses": [
                            "Instrument à lamelle vibrante actionnée par le doigt, utilisant la bouche de l’instrumentiste comme résonateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "841cf52e-f55f-4efe-b56b-71713ecbf071",
                                "sense_id": "eb43a115-01e5-3996-a512-b4fa8a39a973",
                                "text": "Il est intéressant de noter que cet instrument est utilisé de nos jours sous forme de l’instrument populaire moldave : drymba, d’ailleurs, pendant plus d’un millénaire, ni ses dimensions ni ses proportions ni la technique de sa fabrication n’ont pas changé."
                            },
                            {
                                "example_id": "9ad2fc98-b3ca-4cbf-b5a0-ea7ea1407836",
                                "sense_id": "eb43a115-01e5-3996-a512-b4fa8a39a973",
                                "text": "Des broderies aux instruments de musique comme la trembita ou la drymba, en passant par les pysanky (œufs peints) et autres travaux sur bois, ces traditions constituent l’essence de l’identité houtsoule et participent activement à la représentation du folklore ukrainien, l’un des plus riches au monde."
                            },
                            {
                                "example_id": "73bf2d45-4622-4433-b293-21d6a2c9dfc8",
                                "sense_id": "eb43a115-01e5-3996-a512-b4fa8a39a973",
                                "text": "En Europe, la guimbarde ressemble souvent à cette drymba Ukrainienne : cadre arrondi, branches autour de l’embouchure plutôt courtes."
                            }
                        ]
                    }
