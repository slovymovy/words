{
    "word_family": [
        "spinka",
        "spinacz",
        "spięcie",
        "spięty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b2cf8e0-b80c-3088-9071-95db34d2efc0",
                    "sense_definition": "łączyć lub przytrzymywać ze sobą za pomocą klamerki, agrafki lub spinacza",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sekretarka codziennie rano starannie <w>spina</w> ważne dokumenty metalowym spinaczem.",
                            "target_lang_translations": {
                                "ru": "Секретарь каждое утро аккуратно <w>скрепляет</w> важные документы металлической скрепкой."
                            }
                        },
                        {
                            "text": "Zanim wyjdzie na wiatr, zazwyczaj <w>spina</w> długie włosy klamrą.",
                            "target_lang_translations": {
                                "ru": "Перед выходом на ветреную улицу она обычно <w>закалывает</w> длинные волосы зажимом."
                            }
                        }
                    ],
                    "synonyms": [
                        "czepiać",
                        "przypinać"
                    ],
                    "antonyms": [
                        "rozpinać"
                    ],
                    "common_phrases": [
                        "spinać włosy",
                        "spinać kartki"
                    ],
                    "target_lang_definitions": {
                        "ru": "соединять или сдерживать вместе с помощью скрепки, зажима, булавки или заколки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скреплять",
                                "target_lang_sense_clarification": "бумаги, документы скрепкой или зажимом"
                            },
                            {
                                "target_lang_word": "закалывать",
                                "target_lang_sense_clarification": "волосы заколкой"
                            },
                            {
                                "target_lang_word": "скалывать",
                                "target_lang_sense_clarification": "булавкой или зажимом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc257439-7fe0-3e47-88e0-1cc6b17fc733",
                    "sense_definition": "stanowić fizyczne lub komunikacyjne połączenie między dwoma miejscami",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "laczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowo wybudowany most <w>spina</w> dwa brzegi szerokiej rzeki i ułatwia ruch.",
                            "target_lang_translations": {
                                "ru": "Недавно построенный мост <w>соединяет</w> два берега широкой реки и облегчает движение."
                            }
                        },
                        {
                            "text": "Ta zabytkowa estakada kolejowa od stu lat <w>spina</w> oba krańce doliny.",
                            "target_lang_translations": {
                                "ru": "Эта историческая железнодорожная эстакада уже сто лет <w>соединяет</w> оба конца долины."
                            }
                        }
                    ],
                    "synonyms": [
                        "łączyć"
                    ],
                    "antonyms": [
                        "dzielić"
                    ],
                    "common_phrases": [
                        "spinać brzegi"
                    ],
                    "target_lang_definitions": {
                        "ru": "служить физической связью или транспортным сообщением между двумя местами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "берега, края, две точки"
                            },
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "транспортным сообщением, мостом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3aa6685-6c78-3f12-8974-17f1918bf39e",
                    "sense_definition": "mobilizować wszystkie siły lub uwagę w celu wykonania trudnego zadania",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "napiecie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed decydującym egzaminem uczeń <w>spina</w> się i pilnie powtarza cały materiał.",
                            "target_lang_translations": {
                                "ru": "Перед решающим экзаменом ученик <w>собирается с силами</w> и усердно повторяет весь материал."
                            }
                        },
                        {
                            "text": "Cały zespół bardzo <w>spina</w> się, żeby dokończyć ten projekt przed terminem.",
                            "target_lang_translations": {
                                "ru": "Вся команда очень <w>напрягается</w>, чтобы закончить этот проект раньше срока."
                            }
                        }
                    ],
                    "synonyms": [
                        "mobilizować się"
                    ],
                    "antonyms": [
                        "rozluźniać się"
                    ],
                    "common_phrases": [
                        "spinać pośladki"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie w odniesieniu do mobilizacji lub przygotowania"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "собираться с силами, мобилизовать всю волю и внимание для выполнения сложной задачи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "с силами или с духом"
                            },
                            {
                                "target_lang_word": "мобилизоваться",
                                "target_lang_sense_clarification": "для решения трудной задачи"
                            },
                            {
                                "target_lang_word": "напрягаться",
                                "target_lang_sense_clarification": "прилагать максимальные усилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7df34892-19f9-382d-ad44-53a82c55274b",
                    "sense_definition": "odczuwać silne napięcie nerwowe lub stresować się pod wpływem trudnej sytuacji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "napiecie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas każdej rozmowy z dyrektorem niepotrzebnie się <w>spina</w> i denerwuje.",
                            "target_lang_translations": {
                                "ru": "Во время каждого разговора с директором он понапрасну <w>зажимается</w> и нервничает."
                            }
                        },
                        {
                            "text": "Nie <w>spinaj</w> się tak bardzo, to tylko zwykła próba przed występem.",
                            "target_lang_translations": {
                                "ru": "Не <w>напрягайся</w> так сильно, это всего лишь обычная репетиция перед выступлением."
                            }
                        }
                    ],
                    "synonyms": [
                        "stresować się",
                        "denerwować się"
                    ],
                    "antonyms": [
                        "wyluzować"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie stresowania się"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "испытывать нервное напряжение, нервничать или стрессовать в сложной ситуации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напрягаться",
                                "target_lang_sense_clarification": "стрессовать, зажиматься от волнения"
                            },
                            {
                                "target_lang_word": "зажиматься",
                                "target_lang_sense_clarification": "внутренне сковываться"
                            },
                            {
                                "target_lang_word": "нервничать",
                                "target_lang_sense_clarification": "испытывать тревогу и стресс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfdd9174-73bb-3416-8199-0197d9ca0fa8",
                    "sense_definition": "mocno wiązać lub zaciskać coś dookoła sznurem, pasem albo rzemieniem",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "laczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pracownik magazynu mocno <w>spina</w> ładunek grubym pasem transportowym.",
                            "target_lang_translations": {
                                "ru": "Работник склада крепко <w>стягивает</w> груз толстым транспортировочным ремнём."
                            }
                        },
                        {
                            "text": "Przed dalszą podróżą kierowca dokładnie <w>spina</w> deski skórzanymi pasami.",
                            "target_lang_translations": {
                                "ru": "Перед дальнейшей поездкой водитель тщательно <w>скрепляет</w> доски кожаными ремнями."
                            }
                        }
                    ],
                    "synonyms": [
                        "ściskać",
                        "związywać"
                    ],
                    "antonyms": [
                        "rozwiązywać"
                    ],
                    "common_phrases": [
                        "spinać pasem"
                    ],
                    "target_lang_definitions": {
                        "ru": "туго связывать или стягивать верёвкой, ремнём или тросом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стягивать",
                                "target_lang_sense_clarification": "ремнями или шнуром"
                            },
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "крепко фиксировать верёвками"
                            },
                            {
                                "target_lang_word": "скреплять",
                                "target_lang_sense_clarification": "груз ремнями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}