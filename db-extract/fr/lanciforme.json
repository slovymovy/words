                        "glosses": [
                            "Qui a la forme dʼune lance, qui en a lʼaspect."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "85fc8c29-e02a-49d8-a787-d13771046612",
                                "sense_id": "50ecdda1-b6b6-328e-abb4-4d4734fed8d9",
                                "text": "LANCIFORME, adj., lanciformis (lancea, lance, forma, forme) ; qui a la forme d’une lance. Le Saurocephalus lanciformis est ainsi nommé à cause de la forme comprimée, angulaire et tranchante de ses dents, qui ressemblent un peu à un fer de lance très raccourci."
                            },
                            {
                                "example_id": "e172615c-bdf2-4288-ad75-20282c8af838",
                                "sense_id": "50ecdda1-b6b6-328e-abb4-4d4734fed8d9",
                                "text": "On ne fait quʼune incision avec le couteau lanciforme ; la cataracte est extraite à lʼaide dʼun petit crochet quʼon plonge dans le centre de la capsule."
                            }
                        ]
                    }
