                "senses": [
                    {
                        "sense_id": "25cec031-1242-3f73-8aec-5b8069e8f2ac",
                        "entry_id": "6c028042-b376-3af4-b731-a325189ca74f",
                        "glosses": [
                            "To trust or believe."
                        ],
                        "tags": [
                            "archaic",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "4fa0f729-977e-45b0-afbe-4647401678e8",
                                "sense_id": "25cec031-1242-3f73-8aec-5b8069e8f2ac",
                                "text": "...Sure (he said) my wife shall never know\nOf this escape, and if she do, I know the worst I trow\nShe can but chide, shall feare of chiding make me to forslow?"
                            },
                            {
                                "example_id": "69494df8-df4f-45c7-90b8-a30411ce6da3",
                                "sense_id": "25cec031-1242-3f73-8aec-5b8069e8f2ac",
                                "text": "Finding me stick to her still like wax, for my mettle was up as hers was, away she flew with me swifter than ever I went before, or since, I trow."
                            },
                            {
                                "example_id": "50e6c842-d854-4114-a9dd-a54494b618a2",
                                "sense_id": "25cec031-1242-3f73-8aec-5b8069e8f2ac",
                                "text": "\"And as their valour, so you trow, defied\non aspe'rous voyage cruel harm and sore,\nso many changing skies their manhood tried,\nsuch climes where storm-winds blow and billows roar[.]\""
                            },
                            {
                                "example_id": "75b756fe-479b-4539-b6dd-4b732992cecc",
                                "sense_id": "25cec031-1242-3f73-8aec-5b8069e8f2ac",
                                "text": "But was the matter allowed to end there? I trow not."
                            }
                        ]
                    },
                    {
                        "sense_id": "0934479f-6411-3522-a05a-2641e4075b03",
                        "entry_id": "6c028042-b376-3af4-b731-a325189ca74f",
                        "glosses": [
                            "To have confidence in, or to give credence to."
                        ],
