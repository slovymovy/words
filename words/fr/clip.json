                    "frequency": "Low",
                    "semantic_group_id": "attache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a posé un <w>clip</w> artériel afin de stopper immédiatement le saignement."
                        },
                        {
                            "text": "L'intervention chirurgicale a nécessité la pose d'un <w>clip</w> en titane."
