        "nl-extract.jsonl": [
            {
                "entry_id": "63da2016-688d-32a6-af80-905ef590bc42",
                "word": "fascisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0635c6e8-2c3f-3dab-8cca-9a94db681948",
                        "entry_id": "63da2016-688d-32a6-af80-905ef590bc42",
                        "glosses": [
                            "ideologie, berustende op nationalistische, autoritaire en corporatieve beginselen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056539c1-2e34-41ef-9bfa-def87d20cbca",
                                "sense_id": "0635c6e8-2c3f-3dab-8cca-9a94db681948",
                                "text": "Het fascisme is in Italië ontstaan."
                            },
                            {
                                "example_id": "9c9c915d-4e9c-4872-966b-fce9d0a0472e",
                                "sense_id": "0635c6e8-2c3f-3dab-8cca-9a94db681948",
                                "text": "De schaduw van het fascisme uit de jaren dertig, dat resulteerde in een genocidale vernietigingsoorlog, verliest aan kracht. Het stigma dat kleeft aan dictatuur en extreemrechts is verminderd"
                            },
                            {
                                "example_id": "88b103f9-a6f5-4124-bf3a-2e97e50231d5",
                                "sense_id": "0635c6e8-2c3f-3dab-8cca-9a94db681948",
                                "text": "Joe Biden noemde Vladimir Poetin een ‘moordzuchtige dictator en onvervalste schurk’. Maar sinds zijn opvolger Donald Trump in Het Witte Huis zetelt, komt er vanuit de Amerikaanse regering geen slecht woord meer naar buiten over de Russische president. Hoe kan dat? ,,Het fascisme regeert in Washington.’’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c201a3b9-7ee8-4e19-a9ab-e26f27416139",
                        "source_entry_id": "63da2016-688d-32a6-af80-905ef590bc42",
                        "source_sense_id": "0635c6e8-2c3f-3dab-8cca-9a94db681948",
                        "source_sense_description": "ideologie",
                        "target_lang_word": "Faschismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faschismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89a13a60-37ea-3ec3-9fb8-929fdc3a3e2a",
                                        "entry_id": "10f27454-7fcd-3048-984c-d81c857c8f06",
                                        "glosses": [
                                            "Herrschaftssystem in Italien von 1922 bis 1945"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b3ea4fb-8808-3dcd-94b0-fb960092f4a1",
                                        "entry_id": "10f27454-7fcd-3048-984c-d81c857c8f06",
                                        "glosses": [
                                            "(zu Bedeutung [1] verallgemeinert) nationalistische (chauvinistische), antidemokratische, rechtsextreme, antisozialistische und antikommunistische nach dem Führerprinzip organisierte politische Bewegung, Ideologie sowie Herrschaftsform"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec11074a-6363-4b58-91ae-95390e065eb2",
                                                "sense_id": "5b3ea4fb-8808-3dcd-94b0-fb960092f4a1",
                                                "text": "„Der Faschismus war die Ideologie, die den Diktaturen von Benito Mussolini und seiner Partito Nazionale Fascista (PNF) in Italien 1922–43 sowie von Adolf Hitler und seiner Nationalsozialistischen Deutschen Arbeiterpartei (NSDAP) in Deutschland 1933–45 zugrunde lag.“"
                                            },
                                            {
                                                "example_id": "5022782b-90b1-411e-afaf-54bcdf1430dd",
                                                "sense_id": "5b3ea4fb-8808-3dcd-94b0-fb960092f4a1",
                                                "text": "„Sie stellte sich vor, daß er diese Gelegenheit, noch einmal, ein letztesmal, ehe der Faschismus fiel, als Untergrundkämpfer aufzutreten, nicht vorbeigehen lassen würde.“"
                                            },
                                            {
                                                "example_id": "b13be6b5-8760-4c80-9fc7-bd84b41cbd1a",
                                                "sense_id": "5b3ea4fb-8808-3dcd-94b0-fb960092f4a1",
                                                "text": "„War es im vergangenen Jahr noch der Kapitalismus gewesen, der an allem schuld war, hatte der sich in diesem Jahr zum Faschismus gesteigert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ff63f12-ffe2-4763-81ce-02723be4da18",
                        "source_entry_id": "63da2016-688d-32a6-af80-905ef590bc42",
                        "source_sense_id": "0635c6e8-2c3f-3dab-8cca-9a94db681948",
                        "source_sense_description": "ideologie",
                        "target_lang_word": "fascism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fascism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66e3ef2e-f4e2-31b8-a782-6811428cebd1",
                                        "entry_id": "8b01f007-3042-376f-bd8b-97b5b832dd0d",
                                        "glosses": [
                                            "Any right-wing, authoritarian, nationalist ideology characterized by centralized, totalitarian governance, strong regimentation of the economy and society, and repression of criticism or opposition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2b23824-a925-4fa2-b677-1c4e26087ba8",
                                                "sense_id": "66e3ef2e-f4e2-31b8-a782-6811428cebd1",
                                                "text": "Today \"Fascism\" like Russian \"Bolshevism\" does not know what freedom means and cares less about the principles of liberty and the rights of man. It knows only one law and that is the will of Mussolini and his band of \"Black Shirts.\""
                                            },
                                            {
                                                "example_id": "d576d7dd-d7a0-441b-8e26-7f5d5299f463",
                                                "sense_id": "66e3ef2e-f4e2-31b8-a782-6811428cebd1",
                                                "text": "Fascism, with all its forcefulness in the prosecution of its violent deeds, is indeed nothing else but the expression of the disintegration and decay of capitalist economy, and the symptom of the dissolution of the bourgeois State."
                                            },
                                            {
                                                "example_id": "bbf0d7e5-4c8e-452c-98ab-db2e0f992e50",
                                                "sense_id": "66e3ef2e-f4e2-31b8-a782-6811428cebd1",
                                                "text": "Fascism, at any rate the German version, is a form of capitalism that borrows from Socialism just such features as will make it efficient for war purposes... Ownership has never been abolished, there are still capitalists and workers, and—this is the important point, and the real reason why rich men all over the world tend to sympathize with Fascism—generally speaking the same people are capitalists and the same people workers as before the Nazi revolution. But at the same time the State, which is simply the Nazi Party, is in control of everything... The mere efficiency of such a system, the elimination of waste and obstruction, is obvious. In seven years it has built up the most powerful war machine the world has ever seen."
                                            },
                                            {
                                                "example_id": "713b1f86-888c-4704-9f61-2db6023b0d55",
                                                "sense_id": "66e3ef2e-f4e2-31b8-a782-6811428cebd1",
                                                "text": "Despite the three decades that have passed since the end of the second world war, fascism remains a subject of much heated argument. […] It also continues to be a subject of controversy, partly because it collides with so many preconceived ideological notions, partly because generalizations are made difficult by the fact that there was not one fascism but several fascisms."
                                            },
                                            {
                                                "example_id": "c22c2037-6f5f-4af9-ae7a-6feb05b24de2",
                                                "sense_id": "66e3ef2e-f4e2-31b8-a782-6811428cebd1",
                                                "text": "Fascism became an all-purpose term because one can eliminate from a fascist regime one or more features, and it will still be recognizable as fascist. Take away imperialism from fascism and you still have Franco and Salazar. Take away colonialism and you still have the Balkan fascism of the Ustashes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a352f93b-18cc-3ec2-94dd-ce37c26c738e",
                                        "entry_id": "8b01f007-3042-376f-bd8b-97b5b832dd0d",
                                        "glosses": [
                                            "Any system of strong autocracy or oligarchy usually to the extent of bending and breaking the law, race-baiting, and/or violence against largely unarmed populations."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f3e63a0-73a5-4098-b220-d39d3f39195e",
                                                "sense_id": "a352f93b-18cc-3ec2-94dd-ce37c26c738e",
                                                "text": "...even the people who recklessly fling the word ‘Fascist’ in every direction attach at any rate an emotional significance to it. By ‘Fascism’ they mean, roughly speaking, something cruel, unscrupulous, arrogant, obscurantist, anti-liberal and anti-working-class. Except for the relatively small number of Fascist sympathizers, almost any English person would accept ‘bully’ as a synonym for ‘Fascist’. That is about as near to a definition as this much-abused word has come."
                                            },
                                            {
                                                "example_id": "7b6dfa28-3d7e-436c-9718-125e3c49e00f",
                                                "sense_id": "a352f93b-18cc-3ec2-94dd-ce37c26c738e",
                                                "text": "For Argentine fascists and nacionalistas, fascism was not a theory but a mold for Catholic thinking. For instance, one of the most significant nacionalista intellectuals, César Pico, argued that fascism was a \"reaction against the calamities ascribed to liberal democracy, socialism, and capitalism. It's a reaction that, although instinctive in its origins, is searching for a doctrine that could justify it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "831462c9-82f6-3453-9c5b-3aac39c877d7",
                                        "entry_id": "8b01f007-3042-376f-bd8b-97b5b832dd0d",
                                        "glosses": [
                                            "Any extreme reliance on or enforcement of rules and regulations."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d868a6d-8e82-44c8-9fe4-e6290d7aa0be",
                        "source_entry_id": "63da2016-688d-32a6-af80-905ef590bc42",
                        "source_sense_id": "0635c6e8-2c3f-3dab-8cca-9a94db681948",
                        "source_sense_description": "ideologie",
                        "target_lang_word": "fascisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fascisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29cceebc-a4cb-3361-aa0d-ec0770719bc8",
                                        "entry_id": "c2d7c44a-c3d5-3af7-b387-9fa41c3a5295",
                                        "glosses": [
                                            "Doctrine et système politique instauré par Mussolini en 1922 et jusqu’en 1943, caractérisé par une toute puissance de l’État, le corporatisme, l’exaltation du nationalisme et une politique réactionnaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dedc00c-980f-4faa-bb86-293b1c59a0c2",
                                                "sense_id": "29cceebc-a4cb-3361-aa0d-ec0770719bc8",
                                                "text": "Fondé avec ce programme pseudo-socialiste, le fascisme ne tarde pourtant pas à manifester son véritable caractère de classe : et c’est, justement, en dirigeant aussitôt ses attaques contre les socialistes, les anciens compagnons de Mussolini et, pour commencer, contre l’Avanti !."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89d1372f-bef3-3e75-9b26-56e97147569b",
                                        "entry_id": "c2d7c44a-c3d5-3af7-b387-9fa41c3a5295",
                                        "glosses": [
                                            "Doctrine, tendance visant à instaurer un régime autoritaire, nationaliste, comparable au fascisme italien historique ; un tel régime."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6db1158-bb59-478e-aed5-b78c42d23650",
                                                "sense_id": "89d1372f-bef3-3e75-9b26-56e97147569b",
                                                "text": "Ces avertissements ont une résonance toute particulière en Europe, berceau du fascisme et théâtre de la montée des partis d’extrême droite depuis dix ans."
                                            },
                                            {
                                                "example_id": "fcdf1d3b-daa9-4ecf-b1b8-5dc093646ea4",
                                                "sense_id": "89d1372f-bef3-3e75-9b26-56e97147569b",
                                                "text": "Pour Joe Wright, tout l'enjeu résidait dans le défi de définir ce qu'est réellement le fascisme, un terme souvent galvaudé."
                                            },
                                            {
                                                "example_id": "2b07b855-b268-4148-b655-a495b0dfa4f4",
                                                "sense_id": "89d1372f-bef3-3e75-9b26-56e97147569b",
                                                "text": "Ce qui menace la culture ce sont les fascismes, les nationalismes étroits et artificiels qui n’ont rien de commun avec le vrai patriotisme, l’amour profond de son pays. Ce qui menace la culture c'est la guerre à laquelle fatalement, nécessairement, ces nationalismes haineux conduisent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1570e2-2fdd-3313-bc07-cd5e94052917",
                                        "entry_id": "c2d7c44a-c3d5-3af7-b387-9fa41c3a5295",
                                        "glosses": [
                                            "Toute attitude autoritaire, arbitraire, violente et dictatoriale, hors du domaine politique."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84e6455c-48ac-484b-aeb2-c5bc2bb260ac",
                        "source_entry_id": "63da2016-688d-32a6-af80-905ef590bc42",
                        "source_sense_id": "0635c6e8-2c3f-3dab-8cca-9a94db681948",
                        "source_sense_description": "ideologie",
                        "target_lang_word": "fascismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fascismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "50c98b47-2d1a-3d32-9c09-9451501e02df",
                                        "entry_id": "8f50e1c6-86df-3734-b16a-4b3353992887",
                                        "glosses": [
                                            "movimento e poi partito politico fondato nel 1919 da Benito Mussolini in risposta alle mancate conquiste della prima guerra mondiale, salito al potere in Italia nel 1922, i cui tratti principali erano l'esaltazione della patria e della nazione, il rifiuto del comunismo e del socialismo e la gerarchizzazione della società"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "545ed91c-d6cc-4721-b1de-fcc08dd725c5",
                                                "sense_id": "50c98b47-2d1a-3d32-9c09-9451501e02df",
                                                "text": "E` vietata la riorganizzazione, sotto qualsiasi forma, del disciolto partito fascista."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d05b6a-f7a8-3abb-accd-563af97a8de9",
                                        "entry_id": "8f50e1c6-86df-3734-b16a-4b3353992887",
                                        "glosses": [
                                            "dottrina politica propria del fascismo italiano e di movimenti simili, i cui principi sono il rifiuto delle dottrine liberali e socialiste, il nazionalismo, il classismo e la difesa della proprietà privata"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83488289-ebd5-4ac8-979b-90aaf8e3e357",
                                                "sense_id": "d9d05b6a-f7a8-3abb-accd-563af97a8de9",
                                                "text": "A partire dalla fine della prima guerra mondiale in Italia si diffuse il fascismo"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c5d63fc-6f19-4cf0-8b7f-d18d9108ed73",
                        "source_entry_id": "63da2016-688d-32a6-af80-905ef590bc42",
                        "source_sense_id": "0635c6e8-2c3f-3dab-8cca-9a94db681948",
                        "source_sense_description": "ideologie",
                        "target_lang_word": "фашизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фашизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2dc5f197-3058-3854-98dd-0d5a3f7d5a2a",
                                        "entry_id": "577eca6f-ff5d-3a38-8009-3d55e199a893",
                                        "glosses": [
                                            "социально-политические движения, идеологии и государственные режимы тоталитарного типа, основанные на идее национального или расового превосходства; одна из форм диктатуры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d0ba4a-2fcc-49ba-9bac-89b544c4bc9d",
                                                "sense_id": "2dc5f197-3058-3854-98dd-0d5a3f7d5a2a",
                                                "text": ".. это фашизм латиноамериканского типа со стареющим «каудильо»."
                                            },
                                            {
                                                "example_id": "da3feb6c-099c-4517-ae01-8f9e94f4a7f9",
                                                "sense_id": "2dc5f197-3058-3854-98dd-0d5a3f7d5a2a",
                                                "text": "— Мы убиваем и будем убивать оккупантов, мы воевали, воюем и будем уничтожать фашизм до тех пор, пока не освободим не только Европу, но и саму Германию от Гитлера и той мерзости, которой он исковеркал поколения немцев."
                                            },
                                            {
                                                "example_id": "32f42207-c7a4-4e0b-8a27-bed28a61abe4",
                                                "sense_id": "2dc5f197-3058-3854-98dd-0d5a3f7d5a2a",
                                                "text": "«Классические» фашизмы имеют некоторые общие черты: все они — движения «среднего класса», предъявляющего претензии на политическую власть."
                                            },
                                            {
                                                "example_id": "05123929-7ce6-41c7-82b6-81d1bcf806ac",
                                                "sense_id": "2dc5f197-3058-3854-98dd-0d5a3f7d5a2a",
                                                "text": "А сам термин фашизм имеет вполне чёткое значение, берущее начало в межвоенной Италии, в чернорубашечниках во главе с Бенито Муссолини. У него, у этого фашизма, есть вполне ясные признаки: антикоммунистическая риторика, шовинистическая риторика силы и величия государства, риторика вражеского окружения, презрение к либерализму, диктатура вождя, подчинение бизнеса, репрессии против несогласных и внешняя агрессия. Узнаёшь? Так скажи мне, в какой стране расцвёл фашизм, какая страна нуждается в дефашизации?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5edc216b-730e-4caa-9fcd-b3b1f421abbc",
                        "source_entry_id": "63da2016-688d-32a6-af80-905ef590bc42",
                        "source_sense_id": "0635c6e8-2c3f-3dab-8cca-9a94db681948",
                        "source_sense_description": "ideologie",
                        "target_lang_word": "fascismo",
                        "target_lang_code": "es",
