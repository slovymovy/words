                    ],
                    "target_lang_definitions": {
                        "ru": "Одетый достаточно, чтобы показаться на людях.",
                        "zh": "衣着整齐，可以见人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оде́тый",
                                "target_lang_sense_clarification": "в одежде"
