                        "glosses": [
                            "Tache blanche que l’on voit de loin sur les rochers, et plus généralement sur la terre ferme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9786dac-a800-4f42-add9-1aa131c9a228",
                                "sense_id": "1e2c546c-86a9-31c6-aae5-a89c567fb97d",
                                "text": "Il y a une demi-lieue de la pointe du mouillage des Anglais au morne de la Vigie ou de Charlemagne, et une demi-lieue de celui-ci au tapion de la Cahouane."
                            },
                            {
                                "example_id": "5a971129-a087-4e03-8382-a8fd07d2976a",
                                "sense_id": "1e2c546c-86a9-31c6-aae5-a89c567fb97d",
                                "text": "Le tapion sert d’amer."
