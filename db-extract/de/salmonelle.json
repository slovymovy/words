                    {
                        "sense_id": "cceffe6e-5296-3456-b496-ade722ef5b78",
                        "entry_id": "6ab4f5d1-e050-3785-938f-2269098da2b1",
                        "glosses": [
                            "Bakterium, das im Darm von Mensch und Tier lebt und oft Krankheiten wie Typhus und Durchfall bewirkt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "1ac6c93d-8c0d-472e-8b10-d93090fc0c13",
                                "sense_id": "cceffe6e-5296-3456-b496-ade722ef5b78",
                                "text": "Aufgrund der Lebensweise von Enten besteht jedoch eine erhöhte Gefahr des Befalls mit Salmonellen und weiteren Erregern"
                            },
                            {
                                "example_id": "0db30b47-54fc-4d50-ad1d-caacb09bb88c",
                                "sense_id": "cceffe6e-5296-3456-b496-ade722ef5b78",
                                "text": "„Das wiederum lag an Thomas, der fürchtete, er und die Kinder könnten von den Tieren Salmonellen und eine Magen-Darm-Infektion bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aedc2760-ce0f-4e92-be80-550a8911752a",
                        "source_entry_id": "6ab4f5d1-e050-3785-938f-2269098da2b1",
                        "source_sense_id": "cceffe6e-5296-3456-b496-ade722ef5b78",
                        "source_sense_description": "eine Art Darmbakterium",
                        "target_lang_word": "salmonella",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salmonella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b96f9eb-b9b4-350e-b269-62d4ee3f4ffb",
                                        "entry_id": "07ca927c-40a7-3674-87bc-53a5343514c1",
                                        "glosses": [
                                            "Any of the serotypes of the two species of rod-shaped bacteria, of the genus Salmonella, especially Salmonella enterica, that cause typhoid fever and salmonellosis, manifest as food poisoning and other diseases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a6536ca-9ab6-49c5-ab73-986c50d3e1b9",
                                                "sense_id": "7b96f9eb-b9b4-350e-b269-62d4ee3f4ffb",
                                                "text": "Everyone got sick from salmonella in the undercooked meat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "574ddfab-67fa-3bae-b358-4c89de3cac61",
                                        "entry_id": "07ca927c-40a7-3674-87bc-53a5343514c1",
                                        "glosses": [
                                            "Food poisoning, especially in humans, caused by such organisms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
