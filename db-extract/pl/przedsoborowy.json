                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preconciliar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "974e2680-0b73-38a7-a8d4-47c3896fff79",
                                        "entry_id": "b8729049-24d6-3045-a163-babf7f4e1c84",
                                        "glosses": [
                                            "In or of the period before an ecclesiastical council, especially the Second Vatican Council."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8f4f49-829e-422d-bfe6-b47f95feb331",
                                                "sense_id": "974e2680-0b73-38a7-a8d4-47c3896fff79",
                                                "text": "Whether the patriarchal Churches then owed their uniqueness ultimately to their civil position or to their ecclesiastical traditions will be a question to which Chalcedon gives no answer, or rather gives two inconsistent ones. We are thrown back for the solution of the problem on Nicaea and its recognition of the pre-eminence of Rome, Alexandria, and Antioch. But since what was recognised at Nicaea was not created there, the investigation belongs rather to the pre-conciliar era of Christianity, and must for the moment be deferred."
                                            },
                                            {
                                                "example_id": "18241a33-8aa0-44c2-81fb-0aea2472ec2a",
                                                "sense_id": "974e2680-0b73-38a7-a8d4-47c3896fff79",
                                                "text": "Any theological reconstruction therefore that would be thorough-going and do for our age what the original creators of theology did for theirs in preconciliar periods must face two tasks[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
