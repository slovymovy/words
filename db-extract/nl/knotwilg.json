                "senses": [
                    {
                        "sense_id": "90c40040-adc3-3fad-94bb-2192d5320881",
                        "entry_id": "4d13f09b-238f-3a4e-8ff1-a6d4cc0ffa91",
                        "glosses": [
                            "een wilg waarvan men regelmatig de top of de zijscheuten verwijdert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e679aa7b-3e02-4ac5-a38f-9614418e0bea",
                                "sense_id": "90c40040-adc3-3fad-94bb-2192d5320881",
                                "text": "Amsterdam. Het Van Gogh Museum heeft voor 1,5 miljoen euro de waterverftekening Knotwilg (1882) van Vincent van Gogh aangekocht. Het is voor het eerst in vijf jaar dat het museum weer een werk van Van Gogh (1853-1890) aanschaft. Van wie het is gekocht, maakt het museum niet bekend. Tot en met 10 juli organiseert het museum een speciale presentatie rondom deze aankoop."
                            },
                            {
                                "example_id": "123e1b57-95a2-469b-8fd4-a0872a652876",
                                "sense_id": "90c40040-adc3-3fad-94bb-2192d5320881",
                                "text": "'Probeer niet het onmogelijke uit je tuin te halen. Sommige dingen kunnen nu eenmaal niet, zoals een bostuin op klei of een mediterrane palmentuin in Nederland. Dat gaat hoogstens een paar jaar goed waarna alles weer moet worden afgedankt. Je kunt overal olijfboompjes kopen in potten. Als je geen plaats hebt om die in de winter binnen te zetten, koop ze dan niet. De knotwilg is de Nederlandse palmboom.'"
                            }
                        ]
                    }
