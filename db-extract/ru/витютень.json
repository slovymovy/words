                                    {
                                        "sense_id": "5384ea6c-50c5-3a27-9205-76775e335f6c",
                                        "entry_id": "74a4271f-6b39-3763-8fe6-288baaea8baa",
                                        "glosses": [
                                            "Alternative form of wood pigeon."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "940ee724-18c7-4663-9730-35ff61eabe96",
                                                "sense_id": "5384ea6c-50c5-3a27-9205-76775e335f6c",
                                                "text": "If Sémiramis be a Wood-pigeon in Greece, it may, perchance have been an House-pigeon in the Countrey of Ajhur."
                                            },
                                            {
                                                "example_id": "24eef48b-ca91-4de3-98f7-af19b38f98dd",
                                                "sense_id": "5384ea6c-50c5-3a27-9205-76775e335f6c",
                                                "text": "ONE of the most interesting and controversial problems connected with the wood-pigeon is the huge winter flocks which many believe are reinforced by migrants or 'foreigners' from abroad."
                                            },
                                            {
                                                "example_id": "8d3897a0-a37e-4318-a1ac-dd98ce294fa7",
                                                "sense_id": "5384ea6c-50c5-3a27-9205-76775e335f6c",
                                                "text": "For a decade, up to 60% of the wood-pigeon population were removed each winter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
