                                        "sense_id": "06d2e8ef-800c-3a38-9e4a-94ec3f80d91d",
                                        "entry_id": "1e6baf74-2ee9-32e1-9cad-ae19dc44d62f",
                                        "glosses": [
                                            "Sub-Saharan Africa, especially the parts south of Egypt and along and east of the Nile."
