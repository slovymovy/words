        "ru-extract.jsonl": [
            {
                "entry_id": "e0f6bddc-5699-3392-acd1-591844973cc2",
                "word": "фактически",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c4b5e07-1388-36fc-84cf-959c62c86655",
                        "entry_id": "e0f6bddc-5699-3392-acd1-591844973cc2",
                        "glosses": [
                            "наречие к фактический; с точки зрения реального существования, имеющихся фактов"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "cfe98889-36b4-44d9-8b64-383e116d7b70",
                                "sense_id": "1c4b5e07-1388-36fc-84cf-959c62c86655",
                                "text": "Фактически эта педагогика стала понимать под непрерывным образованием возобновляемое обучение или нудное пожизненное векование всех и вся за аудиторными столами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb696468-50cb-4054-8183-1695c939f646",
                        "source_entry_id": "e0f6bddc-5699-3392-acd1-591844973cc2",
                        "source_sense_id": "1c4b5e07-1388-36fc-84cf-959c62c86655",
                        "target_lang_word": "in fact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in fact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1cb2683-bf83-301e-8ac0-883834c54e71",
                                        "entry_id": "5807e3c3-cd8e-3e6c-af30-1bc7f32c81dc",
                                        "glosses": [
                                            "Resulting from the actions of parties."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                        "entry_id": "5807e3c3-cd8e-3e6c-af30-1bc7f32c81dc",
                                        "glosses": [
                                            "Actually; in truth; de facto."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "551b7793-bbdf-4384-9624-7dbad635730a",
                                                "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                                "text": "People think he's rich, but in fact he's nearly penniless."
                                            },
                                            {
                                                "example_id": "7a406dc3-16fb-486b-ba2e-7ab88ff37c69",
                                                "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                                "text": "Now all this was very fine, but not at all in keeping with the Celebrity's character as I had come to conceive it. The idea that adulation ever cloyed on him was ludicrous in itself. In fact I thought the whole story fishy, and came very near to saying so."
                                            },
                                            {
                                                "example_id": "ddb6178d-cefc-47c6-924e-46e09712fab8",
                                                "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                                "text": "A great bargain also had been the excellent Axminster carpet which covered the floor; as, again, the arm-chair in which Bunting now sat forward, staring into the dull, small fire. In fact, that arm-chair had been an extravagance of Mrs. Bunting. She had wanted her husband to be comfortable after the day's work was done, and she had paid thirty-seven shillings for the chair."
                                            },
                                            {
                                                "example_id": "c9780516-948f-4b3b-ac71-21e7563e1709",
                                                "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                                "text": "Menggetimur (d. 1433),¹⁸ chief of the Odoli subtribe of the Chien-chou Jurchen, had in fact moved into Korea south of the Tumen River. Because he offered tribute to the Choson court and had encamped at Hoeryŏng (Chinese: Hui-ning), the Koreans regarded him as their vassal."
                                            },
                                            {
                                                "example_id": "4cc1a4b6-91af-4322-89e6-2be02eb9c937",
                                                "sense_id": "4b22d11a-487d-38b9-bedb-a6935a49dca5",
                                                "text": "We tend to think of the seafloor a few kilometres down as a flat plain. In fact, about two-thirds of this “abyssal” seabed is made up of gentle rolling hills a few hundred metres high, says Jennifer Durden at the University of Southampton, UK."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d507d01-6d26-3e5f-bd71-730cbd347b66",
                                        "entry_id": "5807e3c3-cd8e-3e6c-af30-1bc7f32c81dc",
                                        "glosses": [
                                            "Moreover."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ab41f01-5c68-49d7-b216-d692d580b896",
                                                "sense_id": "6d507d01-6d26-3e5f-bd71-730cbd347b66",
                                                "text": "I don't have the time or patience to deal with him. In fact, I barely even have time for being here at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
