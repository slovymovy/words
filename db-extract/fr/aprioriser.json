                ],
                "senses": [
                    {
                        "sense_id": "430dcb85-1483-3905-9b38-3df9bc25fbd4",
                        "entry_id": "6f260037-d534-364b-83bb-4ccb1914617e",
                        "glosses": [
                            "Donner un caractère a priori à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c49bf9-011a-4ba1-acad-6ea88e5b3015",
                                "sense_id": "430dcb85-1483-3905-9b38-3df9bc25fbd4",
                                "text": "On sait que, dans notre tradition, se sont au contraire affirmées les tendances symétriques à « aposterioriser » et à « aprioriser » l’idée."
                            },
                            {
                                "example_id": "94109264-c814-45a2-b450-40916c32db6a",
                                "sense_id": "430dcb85-1483-3905-9b38-3df9bc25fbd4",
                                "text": "L’esthétique kantienne, anticipée d’ailleurs par Baumgarten, est en rupture avec l’intellectualisme des Classiques et elle se donne la tâche de valoriser, c'est-à-dire d’aprioriser le sensible."
                            }
                        ]
                    }
                ],
