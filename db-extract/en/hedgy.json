                        "entry_id": "393fe809-0fc5-3411-9f27-5d14fbd10a56",
                        "glosses": [
                            "Pertaining to or like a hedge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f925ec-f3b3-430d-ba2b-bef0eef6c81f",
                                "sense_id": "cebd2fb7-2bef-32b3-aa0b-cd3de9151224",
                                "text": "A long hedgy path led through the woodland to the house."
                            },
                            {
                                "example_id": "989fe1f2-a1d4-4806-aa43-01410a1e25a0",
                                "sense_id": "cebd2fb7-2bef-32b3-aa0b-cd3de9151224",
                                "text": "The Isle of Wight is a pocket edition of England,- an epitome, a compact gem, of all England's beauties of rolling hills, quiet valleys, emerald meadows, hedgy lanes, broken cliffs, and shaggy ocean bays."
                            },
                            {
                                "example_id": "327a806a-7716-4a86-ab07-77f5cec088db",
                                "sense_id": "cebd2fb7-2bef-32b3-aa0b-cd3de9151224",
                                "text": "Little picket gates and hedgy archways provide interesting access points to the gardens and their crazy paving winding among small lawns, rose arrays and vegetable patches."
                            }
                        ]
                    },
                    {
                        "sense_id": "c62b0108-c9d8-3c8b-ac26-532018e2f2aa",
                        "entry_id": "393fe809-0fc5-3411-9f27-5d14fbd10a56",
                        "glosses": [
                            "Indecisive, hesitant, noncommittal, unwilling to take a side."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c71afc-54fe-4fc0-ae14-4aa1d7c2d42c",
                                "sense_id": "c62b0108-c9d8-3c8b-ac26-532018e2f2aa",
                                "text": "Naturally they were curious, the businessmen and cadre and assorted visitors, who offered up cigarettes and tea before making their first hedgy attempts at conversation."
                            },
                            {
                                "example_id": "a5e0c58d-1bdf-4481-a920-d6c4adfcf5cb",
                                "sense_id": "c62b0108-c9d8-3c8b-ac26-532018e2f2aa",
                                "text": "He remained hedgy until he knew exactly what was being asked of him."
                            },
                            {
                                "example_id": "2e19792f-f871-4daa-a351-466863b95731",
                                "sense_id": "c62b0108-c9d8-3c8b-ac26-532018e2f2aa",
                                "text": "Indicators of hesitation such as em, and other lexis associated with the realm of vague, fuzzy or hedgy language can be found in the examples, sort, mean, think, terms, bit, maybe, just, little, and some."
                            }
                        ]
