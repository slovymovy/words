                "senses": [
                    {
                        "sense_id": "d0c54e8c-8908-3dfd-9421-30e968238f96",
                        "entry_id": "590e07fd-194f-3af1-8e02-1f9803f4ea2a",
                        "glosses": [
                            "делать острым, заострять конец чего-либо (карандаша, пера и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd949262-3515-4be2-8c28-f8c6f4da7e72",
                                "sense_id": "d0c54e8c-8908-3dfd-9421-30e968238f96",
                                "text": "Проклятая цапля! он, верно, завидует, что я сижу в директорском кабинете и очиниваю перья для его превосходительства."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9366cd0-f9dc-4ac3-88c4-6e2507a571d0",
                        "source_entry_id": "590e07fd-194f-3af1-8e02-1f9803f4ea2a",
                        "source_sense_id": "d0c54e8c-8908-3dfd-9421-30e968238f96",
                        "target_lang_word": "sharpen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sharpen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e800c93-e5cc-3adf-888a-692fd4b8e9cb",
                                        "entry_id": "9fa63d35-9504-3981-b5d3-0d61fd261678",
                                        "glosses": [
                                            "To make sharp."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a53be8e-8305-4bc4-a7fe-b59a58d0d6aa",
                                                "sense_id": "9e800c93-e5cc-3adf-888a-692fd4b8e9cb",
                                                "text": "to sharpen a pencil or a knife or a musical note"
                                            },
                                            {
                                                "example_id": "1a127d15-6b60-4dd5-afe1-98864064d677",
                                                "sense_id": "9e800c93-e5cc-3adf-888a-692fd4b8e9cb",
                                                "text": "He that wrestles with us strengthens our nerves and sharpens our skill."
                                            },
                                            {
                                                "example_id": "8a40a1e7-3644-4d55-bd7d-3d8414ea2d1c",
                                                "sense_id": "9e800c93-e5cc-3adf-888a-692fd4b8e9cb",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives.[…]who, if anyone, is policing their use. Such concerns were sharpened further by the continuing revelations about how the US National Security Agency (NSA) has been using algorithms to help it interpret the colossal amounts of data it has collected from its covert dragnet of international telecommunications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f112b54-de96-31e1-975c-639749fd8b55",
                                        "entry_id": "9fa63d35-9504-3981-b5d3-0d61fd261678",
                                        "glosses": [
                                            "To become sharp."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d50f42a-4f3e-42b7-85b8-f2b54ce51a05",
                                                "sense_id": "6f112b54-de96-31e1-975c-639749fd8b55",
                                                "text": "The organizers said they had found themselves \"more involved in the web of social convulsions and violence that is tormenting our country. The present economic crisis, the grave political instability and the rapidly sharpening violence have finally overtaken […] our wishes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
