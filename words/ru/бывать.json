                        "иногда бывает"
                    ]
                },
                {
                    "sense_id": "fe674aad-df18-3eb9-9971-4a20d62a9f5f",
                    "sense_definition": "Существовать или встречаться в реальности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Таких редких животных в природе почти не <w>бывает</w>."
