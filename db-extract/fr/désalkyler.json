                ],
                "senses": [
                    {
                        "sense_id": "a7dd4d9d-ce0e-350e-bfec-83c6e79966e8",
                        "entry_id": "f8f6532c-0094-3d01-9c42-093cba5a08c1",
                        "glosses": [
                            "Remplacer les radicaux alkyle par des atomes d’hydrogène dans (un composé chimique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06b21fcc-603e-4ae7-8d41-d19941756e0e",
                                "sense_id": "a7dd4d9d-ce0e-350e-bfec-83c6e79966e8",
                                "text": "Si on a affaire à une amine tertiaire, il est indispensable de commencer par la désalkyler pour pouvoir la transformer en amide."
                            },
                            {
                                "example_id": "fdb20497-22cd-44ed-a32e-ca45eb418f5e",
                                "sense_id": "a7dd4d9d-ce0e-350e-bfec-83c6e79966e8",
                                "text": "Sous des conditions fortement acides, il se désalkyle et se réarrange en composés de type quinone."
                            },
                            {
                                "example_id": "f2d3dd06-4750-4a22-ae5a-f831252e5bba",
                                "sense_id": "a7dd4d9d-ce0e-350e-bfec-83c6e79966e8",
                                "text": "Il existe des procédés spéciaux pour désalkyler le toluène et les xylènes en vue de l’obtention du benzène."
                            }
                        ]
                    }
