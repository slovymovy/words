                "senses": [
                    {
                        "sense_id": "0c0f7616-1b8f-3510-a5e5-e53dc6dccaf0",
                        "entry_id": "d16129ed-3a71-30ed-a99d-50c7ce1e252a",
                        "glosses": [
                            "Attirer par de beaux discours, par de beaux semblants, enjôler, dans le but de tromper."
                        ],
                        "tags": [
                            "Suisse",
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "9c35cf1f-80d9-4e59-bfd6-c48490071f5a",
                                "sense_id": "0c0f7616-1b8f-3510-a5e5-e53dc6dccaf0",
                                "text": "Quels que soient leurs beaux discours pour apigeonner les gens, disait-il, les maîtres sont nécessairement par position des aristocrates;"
                            },
                            {
                                "example_id": "ed9eeeb6-1ef9-43d7-80fd-4bcc9e1cddd4",
                                "sense_id": "0c0f7616-1b8f-3510-a5e5-e53dc6dccaf0",
                                "text": "Tu cherchais à l’apigeonner, mais c'est fini de rire; rappelle-toi que d’aujourd’hui je te donne ton compte."
                            }
                        ]
                    }
                ],
