                        "examples": [
                            {
                                "example_id": "22d0f77a-e631-4985-b4e7-1394defae8c0",
                                "sense_id": "6a84333b-bce9-3bab-8b2d-aadc33f17f81",
                                "text": "И всегда предосторожности оказывались излишними ― чернила оставались там, где им положено быть, ― в баллончике ручки."
                            },
                            {
                                "example_id": "cc1050ed-e7d0-44bc-b78b-3f218d95ac37",
                                "sense_id": "6a84333b-bce9-3bab-8b2d-aadc33f17f81",
                                "text": "А где вы баллончики берёте для сифона?"
                            }
                        ]
                    }
