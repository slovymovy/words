                            {
                                "example_id": "a75cab5a-193d-4ee6-9d27-dc1e28bff6d7",
                                "sense_id": "42668bbc-71bf-3874-8b2a-e462a4851445",
                                "text": "Mickelson deinde op de tweede dag van het evenement op golfbaan Liberty National in het Amerikaanse Jersey City (New Jersey) mee op de Amerikaanse dominantie in de spelvorm fourball. Hij won, samen met Kevin Kisner, van het Australische koppel Jason Day en Marc Leishman."
                            },
                            {
                                "example_id": "4b60a227-9028-42e3-9c31-ff37ff54610c",
                                "sense_id": "42668bbc-71bf-3874-8b2a-e462a4851445",
                                "text": "Met veel spelvormen op de training hebben we geprobeerd het plezier en het vertrouwen een beetje terug te krijgen. Het lijkt erop dat het gelukt is."
                            }
                        ]
                    },
                    {
                        "sense_id": "067ae040-a005-3836-9153-966b89c86c5c",
                        "entry_id": "bca1e851-bf10-3efd-98c1-0f09e06a1dfe",
                        "glosses": [
                            "iets dat lijkt alsof het een spelletje is, maar dat eigenlijk niet is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a7bec1-25fc-430e-9b8d-90bf9a44dcdb",
                                "sense_id": "067ae040-a005-3836-9153-966b89c86c5c",
                                "text": "„Weinig jongeren zullen uit zichzelf een assessment doen om hun kwaliteiten te meten”, vertelt ceo en medeoprichter Linda Frietman. „Door het in een spelvorm te gieten en talenten te vergelijken, wordt het een stuk aantrekkelijker.”"
