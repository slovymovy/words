                    {
                        "sense_id": "f834dc0b-d4eb-3559-b006-5bfadb9a46e5",
                        "entry_id": "a6804a34-68d1-322c-9195-a70e244327be",
                        "glosses": [
                            "Cucumis sativus een vrucht van de plant Cucumis sativus uit de komkommerfamilie die wordt ingelegd in azijn of pekel om te fermenteren. De vers gegeten komkommer en de augurk zijn verschillende cultuurvormen van dezelfde soort met verschillende eigenschappen. De vruchten die gebruikt worden voor het maken van de augurk zijn kleiner en hebben over het algemeen een dunnere schil dan de vers gegeten komkommer. De augurk mag geen smaak van zichzelf hebben; de komkommersmaak moet geheel ontbreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4da734b-1c34-4cfb-abc0-dbf828031142",
                                "sense_id": "f834dc0b-d4eb-3559-b006-5bfadb9a46e5",
                                "text": "De augurk behoort plantkundig gezien tot dezelfde soort als de komkommer."
                            },
                            {
                                "example_id": "cd9c855c-7edf-4bee-8f31-e57731b114cb",
                                "sense_id": "f834dc0b-d4eb-3559-b006-5bfadb9a46e5",
                                "text": "De zwangere vrouw at de hele dag augurken."
                            },
                            {
                                "example_id": "5f9cb7c3-3e8c-48f0-ad18-7bed8d6ff734",
                                "sense_id": "f834dc0b-d4eb-3559-b006-5bfadb9a46e5",
                                "text": "Al dagen fantaseerde ik wat ik zou gaan bestellen: een dubbele hamburger met kaas, augurken en ketchup en hopelijk hadden ze ook mayo voor bij de friet. Het water liep me spontaan in de mond als ik dacht aan een vanille milkshake en cola met ijs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "848fab15-195e-418f-beaf-b8e3ffa7c37a",
                        "source_entry_id": "a6804a34-68d1-322c-9195-a70e244327be",
                        "source_sense_id": "f834dc0b-d4eb-3559-b006-5bfadb9a46e5",
                        "source_sense_description": "kleine, in het zuur ingemaakte komkommer",
                        "target_lang_word": "Gurke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gurke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c775278c-5f93-3446-a0c6-15a5c0906711",
                                        "entry_id": "1dfa112f-c3e5-3b7d-b59b-b7f3c6b4084c",
                                        "glosses": [
                                            "eine Pflanzengattung in der Familie der Kürbisgewächse"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ab1389-fa2f-444b-9c43-6efa81a897f6",
                                                "sense_id": "c775278c-5f93-3446-a0c6-15a5c0906711",
                                                "text": "Die Zuckermelone zählt zur Gattung der Gurken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1faeb54c-0a21-3794-a6e7-9e86a5cf2920",
                                        "entry_id": "1dfa112f-c3e5-3b7d-b59b-b7f3c6b4084c",
                                        "glosses": [
                                            "eine Art innerhalb der Gattung der Gurken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d30217b5-9651-460b-9b9e-6d5495eb4c70",
                                                "sense_id": "1faeb54c-0a21-3794-a6e7-9e86a5cf2920",
                                                "text": "„Vor den Häusern reihten sich gut gepflegte Beete mit Tomaten, Paprika, Gurken und Salat.“"
                                            },
                                            {
                                                "example_id": "f98f92af-3109-4189-8ca9-c2de9aa724ea",
                                                "sense_id": "1faeb54c-0a21-3794-a6e7-9e86a5cf2920",
                                                "text": "„Die Gurke ist eine einjährige Pflanze, die niederliegend und kletternd wächst, und dabei ein bis vier Meter lang werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "801f3ff6-148e-3862-91c6-f8f94aa55a7a",
                                        "entry_id": "1dfa112f-c3e5-3b7d-b59b-b7f3c6b4084c",
                                        "glosses": [
                                            "längliche, als Gemüse verwendete Frucht, die an der gleichnamigen Pflanze wächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221aaf2d-4532-4153-97a1-d384eeb52297",
                                                "sense_id": "801f3ff6-148e-3862-91c6-f8f94aa55a7a",
                                                "text": "Heute gibt’s geschmorte Gurken."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ccea1f02-df7c-3ba8-af35-33ae8c9d823c",
                                        "entry_id": "1dfa112f-c3e5-3b7d-b59b-b7f3c6b4084c",
                                        "glosses": [
                                            "eine (tatsächlich oder bildlich) lange Nase"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79938c34-2ccc-499e-b098-dc9250fba5f2",
                                                "sense_id": "ccea1f02-df7c-3ba8-af35-33ae8c9d823c",
                                                "text": "Der muss seine Gurke auch überall reinstecken."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2f2bc5e2-1089-3974-9925-e8a0759d8ddf",
                                        "entry_id": "1dfa112f-c3e5-3b7d-b59b-b7f3c6b4084c",
                                        "glosses": [
                                            "eine unfähige Sache, Person oder Gruppe („Gurkentruppe“)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fceaba9d-9dc1-4a33-b859-c023c752f8a1",
                                                "sense_id": "2f2bc5e2-1089-3974-9925-e8a0759d8ddf",
                                                "text": "„dann haben wir so ein Billigauto gekauft. […] Und das war so eine alte Gurke“"
                                            },
                                            {
                                                "example_id": "635f38f4-0f77-4dcf-8cfa-a71d733519ac",
                                                "sense_id": "2f2bc5e2-1089-3974-9925-e8a0759d8ddf",
                                                "text": "„Das ist ´ne Gurke. Ist glaub’ ich so ein paneuropäischer Katastrophenfilm-Versuch mit vielen schwach synchronisierten Schauspielern aus anderen Nationen.“"
                                            },
                                            {
                                                "example_id": "66d79f50-a6d4-4995-a2bb-a556bb071cda",
                                                "sense_id": "2f2bc5e2-1089-3974-9925-e8a0759d8ddf",
                                                "text": "„Der Hyundai i20 ist, so gesehen, eine Gurke. Allein schon wie sein Blinker klingt, wie Stäbchen aus dem Chinaimbiss, die hysterisch aneinanderschlagen: Klack! Klack! Klack!“"
                                            },
                                            {
                                                "example_id": "4e815385-ff16-40aa-a381-7730a0b0a472",
                                                "sense_id": "2f2bc5e2-1089-3974-9925-e8a0759d8ddf",
                                                "text": "„So blöd sind weder »Gurken« noch »Wildsäue«, auch wenn Guido W. nicht ganz frei vom Verdacht des Todestriebs ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
