                "senses": [
                    {
                        "sense_id": "9faf02f0-b728-3572-98e2-5b0846ed800c",
                        "entry_id": "d7dc77b1-aed2-3745-bd31-6835d368a687",
                        "glosses": [
                            "Fahrbahn für Putschautos (Autoskooter)"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "46b76f49-0716-4f3a-98bf-98ed991d24d6",
                                "sense_id": "9faf02f0-b728-3572-98e2-5b0846ed800c",
                                "text": "„Wieder mit dabei sind auch die «Südseewelle», die Achterbahn «Alpen- Blitz» die Berg-und-Tal-Bahn «Disco-Express» und natürlich die Putschautobahn «Auto Scooter».“"
                            },
                            {
                                "example_id": "4e10d90a-77cc-40e4-a20b-f4f999d81b17",
                                "sense_id": "9faf02f0-b728-3572-98e2-5b0846ed800c",
                                "text": "„Dabei hätte ihm doch bewusst sein sollen, dass er nur noch auf der Putschautobahn fahren dürfte, stellte der Gerichtspräsident fest.“"
                            },
                            {
                                "example_id": "7d7733cf-bc35-47a8-9b69-f0463812828a",
                                "sense_id": "9faf02f0-b728-3572-98e2-5b0846ed800c",
                                "text": "„Der Chilbi-Gottesdienst in Aarau zeigte: Auf der Putschautobahn im Aarauer Schachen kann es auch ruhig zu und her gehen.“"
                            },
                            {
                                "example_id": "e5900adb-d01a-4c70-9fa2-1ba6527c7876",
                                "sense_id": "9faf02f0-b728-3572-98e2-5b0846ed800c",
                                "text": "„Die Karussells, das Schaukelschiff und die Putschautobahn werden aufgebaut.“"
                            },
                            {
                                "example_id": "85193381-d444-4c64-a2f7-81554f3afa6f",
                                "sense_id": "9faf02f0-b728-3572-98e2-5b0846ed800c",
                                "text": "„Aargauer sind die besseren Autofahrer: Das wollte Eloy den Zürchern auf der Putschautobahn beweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
