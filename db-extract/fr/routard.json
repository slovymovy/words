                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reiziger",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7c45a434-50e6-3791-a7d5-f34a7b1ea21d",
                                        "entry_id": "23e69810-8650-39ff-8c94-16eb1b73d299",
                                        "glosses": [
                                            "iemand die bezig is een reis te maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4514f97-0a62-4234-93dd-b235b575cf61",
                                                "sense_id": "7c45a434-50e6-3791-a7d5-f34a7b1ea21d",
                                                "text": "De reizigers waren gestrand doordat het noodweer het luchtverkeer tot een chaos gemaakt had."
                                            },
                                            {
                                                "example_id": "384fc7d2-a1d8-4607-9b24-b65dfaff1fa3",
                                                "sense_id": "7c45a434-50e6-3791-a7d5-f34a7b1ea21d",
                                                "text": "Een reeds lang geleden gesloten hotel met een verschoten lichtbak die de reiziger een zwembad en kamer met tv belooft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84554c12-95cc-37ef-b927-dbb5302e5b7f",
