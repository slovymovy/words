                    "sense_definition": "dwunasty i ostatni miesiąc roku w kalendarzu gregoriańskim, następujący po listopadzie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "months",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W <w>grudniu</w> dni są bardzo krótkie i szybko robi się ciemno.",
                            "target_lang_translations": {
                                "ru": "В <w>декабре</w> дни очень короткие, и быстро темнеет.",
                                "en": "In <w>December</w>, the days are very short and it gets dark quickly.",
                                "nl": "In <w>december</w> zijn de dagen erg kort en wordt het snel donker.",
                                "de": "Im <w>Dezember</w> sind die Tage sehr kurz und es wird schnell dunkel.",
                                "fr": "En <w>décembre</w>, les journées sont très courtes et il fait nuit rapidement.",
                                "it": "A <w>dicembre</w> le giornate sono molto corte e fa buio presto.",
                                "cs": "V <w>prosinci</w> jsou dny velmi krátké a rychle se stmívá.",
                                "tr": "<w>Aralıkta</w> günler çok kısadır ve hava çabuk kararır.",
                                "es": "En <w>diciembre</w> los días son muy cortos y anochece pronto.",
                                "zh": "在<w>十二月</w>，白天很短，天黑得很快。"
                            }
                        },
                        {
                            "text": "Moja siostra ma urodziny w <w>grudniu</w>.",
                            "target_lang_translations": {
                                "ru": "У моей сестры день рождения в <w>декабре</w>.",
                                "en": "My sister has her birthday in <w>December</w>.",
                                "nl": "Mijn zus is in <w>december</w> jarig.",
                                "de": "Meine Schwester hat im <w>Dezember</w> Geburtstag.",
                                "fr": "Ma sœur a son anniversaire en <w>décembre</w>.",
                                "it": "Mia sorella compie gli anni a <w>dicembre</w>.",
                                "cs": "Moje sestra má narozeniny v <w>prosinci</w>.",
                                "tr": "Kız kardeşimin doğum günü <w>aralıkta</w>.",
                                "es": "Mi hermana cumple años en <w>diciembre</w>.",
                                "zh": "我妹妹的生日在<w>十二月</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "w grudniu",
                        "zimny grudzień",
                        "początek grudnia",
                        "koniec grudnia"
