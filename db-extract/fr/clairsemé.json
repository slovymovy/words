                "senses": [
                    {
                        "sense_id": "42b8c2db-0299-36e2-a1de-707a9ead8a8e",
                        "entry_id": "1e7c417f-0076-36e1-80b0-ed531f4bc21a",
                        "glosses": [
                            "scattered"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e650c28-18b3-4e91-bf71-ce75a9c25e85",
                                "sense_id": "42b8c2db-0299-36e2-a1de-707a9ead8a8e",
                                "text": "Je poursuivais jusque sur le talus qui, derrière la haie, montait en pente raide vers les champs, quelque coquelicot perdu, quelques bluets restés paresseusement en arrière, qui le décoraient çà et là de leurs fleurs comme la bordure d’une tapisserie où apparaît clairsemé le motif agreste qui triomphera sur le panneau; […].",
                                "translation": "Swann's Way",
                                "english": "Swann's Way"
                            }
                        ]
                    },
                    {
                        "sense_id": "5c0a5bc6-908d-3082-bdb5-5bf2b83a241e",
                        "entry_id": "1e7c417f-0076-36e1-80b0-ed531f4bc21a",
                        "glosses": [
                            "sparse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "123fbf86-2385-4bfe-904e-5d69ec84f2fb",
                                "sense_id": "5c0a5bc6-908d-3082-bdb5-5bf2b83a241e",
                                "text": "Le public était très clairsemé hier soir.",
                                "translation": "The audience was very sparse last night.",
                                "english": "The audience was very sparse last night."
                            },
                            {
                                "example_id": "8c63ed13-3550-4b79-8502-8795df7b2758",
                                "sense_id": "5c0a5bc6-908d-3082-bdb5-5bf2b83a241e",
                                "text": "Nous marchions directement vers l'ouest, et, le 11 janvier, nous doublâmes ce cap Wessel, situé par 135° de longitude et l0° de latitude nord, qui forme la pointe est du golfe de Carpentarie. Les récifs étaient encore nombreux, mais plus clairsemés, et relevés sur la carte avec une extrême précision.",
                                "translation": "Our course was directed to the west, and on 11th January we doubled Cape Wessel;, situated in 135° longitude, and 10° north latitude, which forms the east point of the Gulf of Carpentaria. The reefs were still numerous, but more equalised, and marked on the chart with extreme precision.",
                                "english": "Our course was directed to the west, and on 11th January we doubled Cape Wessel;, situated in 135° longitude, and 10° north latitude, which forms the east point of the Gulf of Carpentaria. The reefs were still numerous, but more equalised, and marked on the chart with extreme precision."
                            }
                        ]
                    }
