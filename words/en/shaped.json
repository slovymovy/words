{
    "word_family": [
        "shape",
        "shaper",
        "shapeless",
        "shapely",
        "reshape"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5a18b115-3911-3889-90c2-0a1826459639",
                    "sense_definition": "Having a particular form or outline, often resembling a specific object or geometric figure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cookies were <w>shaped</w> like small stars for the holiday party.",
                            "target_lang_translations": {
                                "ru": "Печенье было <w>сделано в форме</w> маленьких звезд для праздничной вечеринки.",
                                "zh": "为了节日派对，饼干被做成了小<w>星状</w>。"
                            }
                        },
                        {
                            "text": "She found a heart <w>shaped</w> stone while walking along the beach.",
                            "target_lang_translations": {
                                "ru": "Гуляя по пляжу, она нашла камень <w>в форме</w> сердца.",
                                "zh": "她在海边散步时发现了一块<w>心形</w>的石头。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heart shaped box",
                        "oddly shaped object",
                        "square shaped container"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий определенную форму или очертания, часто напоминающие конкретный объект или геометрическую фигуру.",
                        "zh": "具有特定的形状或轮廓，通常类似于某种物体或几何图形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в форме",
                                "target_lang_sense_clarification": "имеющий вид чего-либо"
                            },
                            {
                                "target_lang_word": "-образный",
                                "target_lang_sense_clarification": "суффикс, указывающий на подобие формы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "……状",
                                "target_lang_sense_clarification": "后缀，表示具有某种形状"
                            },
                            {
                                "target_lang_word": "……形的",
                                "target_lang_sense_clarification": "表示具有某种形状的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cea0ae0-dd55-3a67-b047-7d2805667fa1",
                    "sense_definition": "Having been given a specific, often curved or intentional, physical form.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>shaped</w> sides of the wardrobe give it a more attractive appearance.",
                            "target_lang_translations": {
                                "ru": "<w>Фигурные</w> боковины шкафа придают ему более привлекательный вид.",
                                "zh": "衣柜<w>异形</w>的侧板使其外观更具吸引力。"
                            }
                        },
                        {
                            "text": "The artist used <w>shaped</w> wood to create the unique sculpture.",
                            "target_lang_translations": {
                                "ru": "Художник использовал <w>обработанное</w> дерево для создания этой уникальной скульптуры.",
                                "zh": "艺术家使用<w>成型</w>的木材创作了这件独特的雕塑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shapen"
                    ],
                    "common_phrases": [
                        "specially shaped wood",
                        "perfectly shaped curves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий заданную, часто изогнутую или намеренно созданную физическую форму.",
                        "zh": "被赋予了特定的、通常是弯曲的或刻意设计的物理形态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "профилированный",
                                "target_lang_sense_clarification": "имеющий заданный контур"
                            },
                            {
                                "target_lang_word": "фигурный",
                                "target_lang_sense_clarification": "имеющий сложную или декоративную форму"
                            },
                            {
                                "target_lang_word": "вырезанный",
                                "target_lang_sense_clarification": "которому придали форму путем обработки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "异形",
                                "target_lang_sense_clarification": "具有特殊或装饰性形状的"
                            },
                            {
                                "target_lang_word": "成型",
                                "target_lang_sense_clarification": "经过加工而具有特定形状的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3032cc1-ebd8-3142-a277-1bce46569209",
                    "sense_definition": "Designed or perfectly suited for a particular person, thing, or situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a God <w>shaped</w> hole in his heart after the loss.",
                            "target_lang_translations": {
                                "ru": "После утраты он почувствовал в сердце пустоту, <w>соразмерную</w> Богу.",
                                "zh": "失去亲人后，他感到内心有一处唯有上帝能<w>填补</w>的空虚。"
                            }
                        },
                        {
                            "text": "The company faced a uniquely <w>shaped</w> problem that required a creative solution.",
                            "target_lang_translations": {
                                "ru": "Компания столкнулась с проблемой <w>особого рода</w>, которая требовала творческого решения.",
                                "zh": "公司面临一个<w>特有</w>的问题，需要创造性的解决方案。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "custom shaped solution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спроектированный или идеально подходящий для конкретного человека, вещи или ситуации.",
                        "zh": "为特定的人、事物或情况而设计或完美契合的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответствующий",
                                "target_lang_sense_clarification": "идеально подходящий по форме или сути"
                            },
                            {
                                "target_lang_word": "специфический",
                                "target_lang_sense_clarification": "имеющий особую форму, характерную для ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特有的",
                                "target_lang_sense_clarification": "针对特定情况或需求而形成的"
                            },
                            {
                                "target_lang_word": "量身定制的",
                                "target_lang_sense_clarification": "完全符合特定要求的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c3798fd-e888-3e22-8d5b-9f897f7bd38b",
                    "sense_definition": "Past tense and past participle of <w>shape</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The potter <w>shaped</w> the clay into a beautiful vase on the wheel.",
                            "target_lang_translations": {
                                "ru": "Гончар на круге <w>придал</w> глине форму прекрасной вазы.",
                                "zh": "陶艺家在转盘上将黏土<w>塑造</w>成了一个精美的花瓶。"
                            }
                        },
                        {
                            "text": "Years of hard work <w>shaped</w> his character and made him stronger.",
                            "target_lang_translations": {
                                "ru": "Годы упорного труда <w>сформировали</w> его характер и сделали его сильнее.",
                                "zh": "多年的艰苦工作<w>塑造</w>了他的性格，使他变得更加坚强。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shaped by hand",
                        "shaped the future"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «придавать форму» (shape).",
                        "zh": "动词 shape 的过去式和过去分词，意为塑造或形成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сформировал",
                                "target_lang_sense_clarification": "придал вид или характер"
                            },
                            {
                                "target_lang_word": "вылепил",
                                "target_lang_sense_clarification": "придал форму пластичному материалу"
                            },
                            {
                                "target_lang_word": "определил",
                                "target_lang_sense_clarification": "повлиял на развитие чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塑造",
                                "target_lang_sense_clarification": "使具有某种形态或性格"
                            },
                            {
                                "target_lang_word": "形成",
                                "target_lang_sense_clarification": "对事物的发展产生影响"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}