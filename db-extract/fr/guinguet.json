                    {
                        "sense_id": "f48945ae-8f17-3444-b40d-1609950637dc",
                        "entry_id": "c29686a2-0edc-3d29-9251-153a3d65f447",
                        "glosses": [
                            "Aigrelet."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "743ef42d-4564-43c2-9a08-334072c2ccef",
                                "sense_id": "f48945ae-8f17-3444-b40d-1609950637dc",
                                "text": "Tonneaux pleins de vin commun, du vin guinguet pour les tavernes."
                            },
                            {
                                "example_id": "32933d28-5bb2-4d1e-b915-540f74440247",
                                "sense_id": "f48945ae-8f17-3444-b40d-1609950637dc",
                                "text": "La servante mettait le couvert : sept assiettes creuses chantantes au heurt des cuillers et des fourchettes de fer, de petits verres d'auberge aux parois épaisses, des bouteilles de cidre et de vin guinguet bouchées à l'aide de crosses de maïs égrenées, et, au milieu de tout cela, on versait la soupe bouillante sur les tranches de pain rassis, dans une immense soupière d'étain."
                            }
                        ]
                    }
                ],
