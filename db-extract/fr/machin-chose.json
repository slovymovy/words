                "senses": [
                    {
                        "sense_id": "0b7612f3-b6f6-3507-b23f-bc3bf9540e2c",
                        "entry_id": "43be2851-7652-337e-9cc9-6c50b29f1333",
                        "glosses": [
                            "Mot utilisé quand on ne connait pas le nom d’une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f006e30d-b58c-4d90-8300-f183ca3392ba",
                                "sense_id": "0b7612f3-b6f6-3507-b23f-bc3bf9540e2c",
                                "text": "– Où est votre détective ? Celia Machin-Chose ?"
                            },
                            {
                                "example_id": "0367a06f-0bfd-43d6-9663-616dc580eb4e",
                                "sense_id": "0b7612f3-b6f6-3507-b23f-bc3bf9540e2c",
                                "text": "Donne-le à faire à Machin-Chose, le nouveau, dans ton service."
                            },
                            {
                                "example_id": "20ed3ce8-0c2e-4601-8dcc-04808b005b58",
                                "sense_id": "0b7612f3-b6f6-3507-b23f-bc3bf9540e2c",
                                "text": "Comment s’appelle-t-il déjà, Machin-Chose ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "75487705-e47b-305b-a16e-03240f6a6096",
                        "entry_id": "43be2851-7652-337e-9cc9-6c50b29f1333",
                        "glosses": [
                            "Mot utilisé quand on ne connait pas le nom d’une chose incongrue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10581b51-8091-411a-b862-7e648c100820",
                                "sense_id": "75487705-e47b-305b-a16e-03240f6a6096",
                                "text": "C’est quoi ce machin-chose, là ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60d36d31-a3f9-4489-a901-e912691cb3f6",
                        "source_entry_id": "43be2851-7652-337e-9cc9-6c50b29f1333",
                        "target_lang_word": "whatchamacallit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whatchamacallit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "706fae51-3101-3aee-87d6-97239a8cadd7",
                                        "entry_id": "390ecf15-e42a-35c0-9cef-642ecd0760be",
                                        "glosses": [
                                            "A metasyntactic term used for any object whose actual name the speaker does not know or cannot remember; a doodad, gizmo, thingamajig, thingy."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e66337-2b20-45f4-a76e-ac8370a92f04",
                                                "sense_id": "706fae51-3101-3aee-87d6-97239a8cadd7",
                                                "text": "The Thingamajig and the Wachamacallit."
                                            },
                                            {
                                                "example_id": "de23d4cc-f3dc-47c0-9a7a-04dd8e035294",
                                                "sense_id": "706fae51-3101-3aee-87d6-97239a8cadd7",
                                                "text": "You’re—you must be the whatchamacallit, huh? The peer."
                                            },
                                            {
                                                "example_id": "34dd8e60-ca3f-4291-9551-db0bb49b18d0",
                                                "sense_id": "706fae51-3101-3aee-87d6-97239a8cadd7",
                                                "text": "JESSICA: How many times do I have to say it? We were not stealing, Officer. We were just— / MONAHAN: I know. Performing some kind of whatchamacallit deed. Anyhow, they go to the clink, that's what happens to people who filch city property."
                                            },
                                            {
                                                "example_id": "81dcf1d5-9580-45a9-86aa-507475ab17c7",
                                                "sense_id": "706fae51-3101-3aee-87d6-97239a8cadd7",
                                                "text": "I'm a boy, so when I'm sick, they can call in poohaghooma, Indian doctor. But not Tom Mitchell! No, sir! [We] won't have Tom Mitchell to doctor me! 'Cause whatchamacallit, he always used to doctor me …"
                                            },
                                            {
                                                "example_id": "5343397f-0dcc-46e3-9076-72f1f92f3007",
                                                "sense_id": "706fae51-3101-3aee-87d6-97239a8cadd7",
                                                "text": "\"Think we ought to check this whatchamacallit?\" / \"No, that doodad over there seems to be the problem.\""
                                            },
                                            {
                                                "example_id": "f7c6d325-46ca-4219-8801-b7ce2ed6ae91",
                                                "sense_id": "706fae51-3101-3aee-87d6-97239a8cadd7",
                                                "text": "You know, he looked at everybody and everything but not me as if just by letting his eyes rest on me for a moment would let out that he and I are having a whatchamacalit."
                                            },
                                            {
                                                "example_id": "42176729-e686-4828-908f-8c42a9f813c3",
                                                "sense_id": "706fae51-3101-3aee-87d6-97239a8cadd7",
                                                "text": "As you've said, the safety of the American people is our first priority. We have orders that if these EMP whatchamacallits can't be secured then they must be destroyed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db75681c-1fe5-4065-9aaf-c2fb50294bd6",
