    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "093c9cb8-2f54-3c1d-a5fe-bac5354ff1ee",
                    "sense_definition": "een helder, rinkelend geluid maken, zoals van een bel of glas",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de ober struikelde, hoorden we de glazen luid op de vloer <w>rinkelen</w>.",
                            "target_lang_translations": {
                                "en": "When the waiter tripped, we heard the glasses <w>shatter</w> loudly on the floor."
                            }
                        },
                        {
                            "text": "Ik hoorde de sleutels in zijn zak <w>rinkelen</w> terwijl hij naar de deur liep.",
                            "target_lang_translations": {
                                "en": "I heard the keys <w>jingle</w> in his pocket as he walked to the door."
                            }
                        }
                    ],
                    "synonyms": [
                        "klingelen",
                        "tingelen"
                    ],
                    "common_phrases": [
                        "glazen laten rinkelen",
                        "sleutels horen rinkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a clear, metallic or glass-like clinking sound, such as a bell or glass"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to jingle",
                                "target_lang_sense_clarification": "like keys or small bells"
                            },
                            {
                                "target_lang_word": "to tinkle",
                                "target_lang_sense_clarification": "light, high-pitched sound"
                            },
                            {
                                "target_lang_word": "to clatter",
                                "target_lang_sense_clarification": "shattering or falling glass"
                            },
                            {
                                "target_lang_word": "to ring",
                                "target_lang_sense_clarification": "a telephone or bell"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}