                ],
                "senses": [
                    {
                        "sense_id": "38b4780b-26dd-364d-bc34-209877fc428d",
                        "entry_id": "0196d8d4-69d9-3d5f-8a4f-eb92dfe1e1c0",
                        "glosses": [
                            "Dessert aus marinierten, zerkleinerten frischen Früchten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13deed91-6a4e-4e71-b67c-7df640eb711d",
                                "sense_id": "38b4780b-26dd-364d-bc34-209877fc428d",
                                "text": "Ich esse gerade einen Fruchtsalat."
                            },
                            {
                                "example_id": "e40b51ce-b790-4879-91e0-6a85a4165d5e",
                                "sense_id": "38b4780b-26dd-364d-bc34-209877fc428d",
                                "text": "„Nach einem in Eile eingenommenen Mittagessen, bestehend aus einer kaltgewordenen, mit einer glitschigen Haut überzogenen Suppe, einem Gulasch, das sich im Wärmerohr aufgelöst hatte, und Fruchtsalat aus einem Restposten Konservenbüchsen der amerikanischen Besatzungstruppen, versammelten sich die Callgirls im Konferenzraum zur Abschlußdiskussion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48e4c2b9-1393-438d-98a3-ddf5f7e973c2",
                        "source_entry_id": "0196d8d4-69d9-3d5f-8a4f-eb92dfe1e1c0",
                        "source_sense_id": "38b4780b-26dd-364d-bc34-209877fc428d",
                        "target_lang_word": "salade de fruits",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salade de fruits",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1d0f4e0-86ea-3f37-8a27-6be21be5fb65",
                                        "entry_id": "be3a1ec2-51ea-3f3c-a19f-7f27bb0190d8",
                                        "glosses": [
                                            "Mélange de plusieurs fruits coupés en morceaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e24ef00-86e6-46a0-a3fe-d67b2b39bca8",
                                                "sense_id": "c1d0f4e0-86ea-3f37-8a27-6be21be5fb65",
                                                "text": "Existe-t-il dessert plus attirant, plus simple, plus beau, plus délectable qu’une salade de fruits ?"
                                            },
                                            {
                                                "example_id": "074b7c6e-b0c3-489d-b33f-dec71910b720",
                                                "sense_id": "c1d0f4e0-86ea-3f37-8a27-6be21be5fb65",
                                                "text": "Les fougasses, les panini et les salades de fruits aux couleurs vives étaient artistiquement disposés sur des plateaux, formant une splendide composition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
