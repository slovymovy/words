                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b89a2a-0f7b-41dc-aace-b306629f9323",
                                "sense_id": "5eadfc71-0c35-34c4-9ccb-db1798ee84b2",
                                "text": "Провожающий нажимает кнопку, и легко, плавно электричество отводит невероятную несгораемую дверь."
                            },
                            {
                                "example_id": "c134917f-b9b7-406e-91a2-b7bd37f5c6df",
                                "sense_id": "5eadfc71-0c35-34c4-9ccb-db1798ee84b2",
                                "text": "В Москве на трёх уезжающих — один провожающий, а здесь, в Одессе, на одного приезжающего — трое встречающих."
                            }
                        ]
                    }
