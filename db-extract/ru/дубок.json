                "senses": [
                    {
                        "sense_id": "4d89bd7f-764a-33eb-bcca-2d2fc20e10d0",
                        "entry_id": "a31fc7e4-2e2e-3b64-b27c-7222003eb97d",
                        "glosses": [
                            "молодой дуб"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d0feb20-e854-484e-ae4b-ed369775f0d9",
                                "sense_id": "4d89bd7f-764a-33eb-bcca-2d2fc20e10d0",
                                "text": "Жёлуди одинаковые, но когда вырастут из них молодые дубки — из одного дубка сделают кафедру для учёного, другой идёт на рамку для портрета любимой девушки, а из третьего дубка смастерят такую виселицу, что любо-дорого…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33bae1c8-370e-4db7-afe8-966245a5a1d9",
                        "source_entry_id": "a31fc7e4-2e2e-3b64-b27c-7222003eb97d",
                        "source_sense_id": "4d89bd7f-764a-33eb-bcca-2d2fc20e10d0",
                        "source_sense_description": "молодой дуб",
                        "target_lang_word": "oaklet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oaklet",
