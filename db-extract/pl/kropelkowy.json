                ],
                "translations": [
                    {
                        "translation_id": "57152d67-fbb0-4287-b8b0-b6691cb407a2",
                        "source_entry_id": "e16a3b59-4f5d-372e-b6d3-3f020734c25b",
                        "source_sense_id": "299527d9-6d73-3f48-855b-b2cb65bfacb6",
                        "target_lang_word": "капельный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "капельный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b83a166e-e569-3645-8743-8346084798ac",
                                        "entry_id": "bd8e6664-685a-335f-bd63-ec4f44a824de",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным капля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f9e0cca-64b9-4f46-8401-9c64062b07b2",
                                                "sense_id": "b83a166e-e569-3645-8743-8346084798ac",
                                                "text": "Хлорацетон прибавлялся по каплям из капельной воронки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ddcbd28-f89f-3711-8dc6-888932721498",
                                        "entry_id": "bd8e6664-685a-335f-bd63-ec4f44a824de",
                                        "glosses": [
                                            "такой, как у капли"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ccb4215-cecf-4e9d-ad5d-41ced73640cc",
                                                "sense_id": "3ddcbd28-f89f-3711-8dc6-888932721498",
                                                "text": "Их своеобразную капельную форму со свойственными всем метеоритам углублениями нетрудно воспроизвести, если продувать горячую струю пара через кусок сургуча."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "324ccdf2-4661-353c-8d4c-2420bc546d1d",
                                        "entry_id": "bd8e6664-685a-335f-bd63-ec4f44a824de",
                                        "glosses": [
                                            "перен., разг. самый малый, крохотный, крошечный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "721da871-3601-4dc3-9f86-ac70b5d0e3c1",
                                                "sense_id": "324ccdf2-4661-353c-8d4c-2420bc546d1d",
                                                "text": "Замети ли ― целое облако белых кружев и крошечная, капельная туфелька с французским каблучком…"
                                            },
                                            {
                                                "example_id": "47b88604-eebb-4d2a-b618-aad00f029cd4",
                                                "sense_id": "324ccdf2-4661-353c-8d4c-2420bc546d1d",
                                                "text": "И ещё так, что забудет что-нибудь, то вспоминает, вспоминает ― и всё, всё до капельной капельки, до синь-пороха ему рассказала."
                                            },
                                            {
                                                "example_id": "5c47868e-5d84-481d-b354-4d717ef23ad1",
                                                "sense_id": "324ccdf2-4661-353c-8d4c-2420bc546d1d",
                                                "text": "― Там я хоть в самой малой, капельной мере, но способствую делу освобождения, прости за высокий стиль, а здесь я иждивенец войны…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
