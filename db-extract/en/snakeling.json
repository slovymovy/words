                            {
                                "example_id": "0db92889-2ef4-4e0d-8bea-d878932b96c7",
                                "sense_id": "c5d69026-f681-3fdc-a74c-8ff4fd872152",
                                "text": "But just as Teddy was stooping, something flinched a little in the dust, and a tiny voice said: \"Be careful. I am death!\" It was Karait, the dusty brown snakeling that lies for choice on the dusty earth; and his bite is as dangerous as the cobra's. But he is so small that nobody thinks of him, and so he does the more harm to people."
                            }
                        ]
