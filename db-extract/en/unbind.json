                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b258ed4-4708-4017-a4b2-536b2db3c9b6",
                                                "sense_id": "298c1cd9-2cfa-326a-8d3a-833f8e7d331e",
                                                "text": "Ontbind dit getal in zijn priemgetallen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f6e24f2-c9cf-323f-8d04-a8cbab0629be",
