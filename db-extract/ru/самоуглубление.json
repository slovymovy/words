                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "delving",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7038029a-2d5c-3078-a8ba-48dbf6bdb63d",
                                        "entry_id": "6b256523-ee3b-3888-b2c1-faa41da562d6",
                                        "glosses": [
                                            "The act of one who delves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e65373f-7195-4897-a045-33dae521bc7a",
                                                "sense_id": "7038029a-2d5c-3078-a8ba-48dbf6bdb63d",
                                                "text": "The purpose of my visit, and the frightful abnormalities it postulated struck at me all at once with a chill sensation that nearly over-balanced my ardour for strange delvings."
                                            },
                                            {
                                                "example_id": "ab067175-09e5-471a-a1bd-c5f7f909331d",
                                                "sense_id": "7038029a-2d5c-3078-a8ba-48dbf6bdb63d",
                                                "text": "Doubtless, as has happened to others, her motives were sometimes misunderstood by those who may have looked with suspicion upon these delvings into pagan practice and belief, but they have been fully justified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "876dca2d-956d-3217-9dee-7f21b55cfaed",
                                        "entry_id": "6b256523-ee3b-3888-b2c1-faa41da562d6",
                                        "glosses": [
                                            "Alternative form of dilving."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7525a52-0bc6-419b-843a-dc167440c444",
                        "source_entry_id": "a6f440be-8b39-374e-9168-af908fdd8835",
                        "target_lang_word": "Introspektion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Introspektion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2599d74-bcff-3aee-83d9-c665ac133f34",
                                        "entry_id": "329d7f37-ae12-3c4e-8566-966d54de88be",
                                        "glosses": [
                                            "(während dem Erleben bestimmter subjektiver Erfahrungen) nach innen gerichtete Beobachtung der eigenen seelischen Vorgänge zwecks psychologischer Selbsterkenntnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba4632b-0c30-4210-a37a-ed24f4cd4ff8",
                                                "sense_id": "b2599d74-bcff-3aee-83d9-c665ac133f34",
                                                "text": "Sein Versuch zur Introspektion ist jämmerlich gescheitert."
                                            },
                                            {
                                                "example_id": "c5e22277-c465-40c2-834d-7deeaa7d4990",
                                                "sense_id": "b2599d74-bcff-3aee-83d9-c665ac133f34",
                                                "text": "Die einen sagen Introspektion dazu, die anderen Nabelschau."
                                            },
                                            {
                                                "example_id": "0efdfada-2b58-4116-98b6-81f38fc1a949",
                                                "sense_id": "b2599d74-bcff-3aee-83d9-c665ac133f34",
                                                "text": "„Es geht hier weder um eine Anthropomorphisierung der Welt noch um eine Mechanisierung der menschlichen Leidenschaften; es geht vielmehr darum, die Wesensgleichheiten zu erkennen, die sich hinter dem äußeren Anschein verbergen; es geht darum, diese große Kühnheit zu begründen, auf der das gesamte System basiert: die Anwendung der Introspektion als metaphysische Untersuchungsmethode.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f7b56cd-8722-496c-8b59-2ab824da4a15",
                        "source_entry_id": "a6f440be-8b39-374e-9168-af908fdd8835",
                        "target_lang_word": "Selbstbeobachtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0e29830e-323a-4825-8e9b-cbb8967a7e17",
                        "source_entry_id": "a6f440be-8b39-374e-9168-af908fdd8835",
                        "target_lang_word": "Selbstvertiefung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fbb7bc32-04ff-48eb-b628-aed3e855a353",
                        "source_entry_id": "a6f440be-8b39-374e-9168-af908fdd8835",
                        "target_lang_word": "introspection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "introspection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6511e669-8273-3120-8fb2-98861394b28d",
                                        "entry_id": "841c6473-346f-3411-8a19-d9db51dfac6c",
                                        "glosses": [
                                            "Observation intérieure, observation par la conscience, examen fait par le sujet lui-même des phénomènes psychologiques qui se passent en lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1056b44-59e5-425b-b69b-b827d1ceb15b",
                                                "sense_id": "6511e669-8273-3120-8fb2-98861394b28d",
                                                "text": "Quand il avait achevé un examen il tombait dans une longue méditation, que nous nous gardions d’interrompre, le regard en introspection, le visage incliné de côté, ainsi que s’il percevait de très loin le confidentiel chuchotement de la nature. Il en oubliait la circonstance, ses obligations, l’heure de son repas. Il sortait de cette rêverie brusquement quelquefois, par un « ah bah ! » retentissant, à l’aide duquel il se raillait de lui-même."
                                            },
                                            {
                                                "example_id": "79a72fa9-3290-4a40-bc0e-8f5053193728",
                                                "sense_id": "6511e669-8273-3120-8fb2-98861394b28d",
                                                "text": "…le génie spirituel de Bergson se détache de l’introspection d'un Maine de Biran en ce sens que c’est le Moi profond à l’état pur qui l’a ressaisi par delà tout caractère accidentel d’un Moi individuel : la personne ici est vraiment le lieu et rien que le lieu où passe, que traverse, le courant spirituel."
                                            },
                                            {
                                                "example_id": "58fe9603-37bf-4468-b6e9-97aeb2ff74a0",
                                                "sense_id": "6511e669-8273-3120-8fb2-98861394b28d",
                                                "text": "C’est sous l’emprise de cette introspection que je me suis abîmé dans la contemplation, habité par l’esprit des temps qui courent …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa72d265-cb47-3b74-9adc-66abb77c09d1",
                                        "entry_id": "841c6473-346f-3411-8a19-d9db51dfac6c",
                                        "glosses": [
                                            "Capacité d'un programme à examiner son propre état."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9fd0316-f277-4839-8f72-a9117981cb2a",
                        "source_entry_id": "a6f440be-8b39-374e-9168-af908fdd8835",
                        "target_lang_word": "auto",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d618a560-9d03-3126-9445-63e39fa0650d",
                                        "entry_id": "ed2fcfd0-961d-3358-b074-1d2dfc7f0664",
                                        "glosses": [
                                            "Automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa9956ff-ddd5-470d-9d92-f797ef57689d",
                                                "sense_id": "d618a560-9d03-3126-9445-63e39fa0650d",
                                                "text": "Ces jeunes gens avaient des autos à la porte. Ils ne parlaient qu'automobile. L'un d'eux déclara : « Quand je suis dans la pente de (j'ai oublié quelle localité) alors, là, j'existe ! »"
                                            },
                                            {
                                                "example_id": "9e0aeda8-f970-4e15-a963-373ba6480a8b",
                                                "sense_id": "d618a560-9d03-3126-9445-63e39fa0650d",
                                                "text": "Ils ont tous une auto, un piano, de l’argenterie, des ameublements modernes, un appareil de T.S.F."
                                            },
                                            {
                                                "example_id": "f7b131e2-7558-44e7-8fff-21284568f496",
                                                "sense_id": "d618a560-9d03-3126-9445-63e39fa0650d",
                                                "text": "Seul, Delcassé s'est rendu à l’Étoile en auto ouverte. Il espérait une ovation, mais la foule resta muette."
                                            },
                                            {
                                                "example_id": "db480c33-12ee-4062-b9f1-4e00facd8e11",
                                                "sense_id": "d618a560-9d03-3126-9445-63e39fa0650d",
                                                "text": "Une auto qui venait en sens inverse éclaira un instant la borne kilométrique et Joseph Mittel se pencha juste à temps pour lire : Forges-les-Eaux, 2 km."
                                            },
                                            {
                                                "example_id": "fc435b9b-1689-46f0-bf39-f0f883d7684b",
                                                "sense_id": "d618a560-9d03-3126-9445-63e39fa0650d",
                                                "text": "Je revenais dans l’auto des estafettes, portant des piles et d'autres accessoires lorsque nous offrîmes une place à une sorte d'ambulancier, […]."
                                            },
                                            {
                                                "example_id": "7092ef3d-e3d8-4f69-b96a-35e7b3a0a06d",
                                                "sense_id": "d618a560-9d03-3126-9445-63e39fa0650d",
                                                "text": "[Il] n'est peut-être pas moins dévoyé que le fils du notaire, à Rouen, qui comparaît devant les Assises pour un vol d’auto, […]."
                                            },
                                            {
                                                "example_id": "bae7dee8-3fb1-478f-b322-65c452f99b15",
                                                "sense_id": "d618a560-9d03-3126-9445-63e39fa0650d",
                                                "text": "L’auto stoppa devant le perron."
                                            },
                                            {
                                                "example_id": "c9e77ed3-bff9-49f7-8332-6ebc56162563",
                                                "sense_id": "d618a560-9d03-3126-9445-63e39fa0650d",
                                                "text": "Certains disposaient d'autos et de bons d'essence, et s'en allaient chez des amis ; d'autres allaient à pied, ou en voiture bientôt en panne, et marchaient sans but."
                                            }
                                        ]
                                    }
                                ]
                            },
