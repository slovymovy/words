                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25b6816f-e6bf-3ba9-bb9c-5911857378ce",
                                        "entry_id": "f0663755-d289-366e-b9cb-5de3342b37b7",
                                        "glosses": [
                                            "πολύ αυστηρός, σκληρός"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97156359-e3a3-47e5-8a6c-32509f5e3cf5",
                                                "sense_id": "25b6816f-e6bf-3ba9-bb9c-5911857378ce",
                                                "text": "Δρακόντεια μέτρα ασφαλείας για βυζαντινή εικόνα: Μέτρα ασφαλείας που θυμίζουν ταινία του Τζέιμς Μποντ θα ληφθούν για τη μεταφορά της εικόνας «Η Σταύρωση του Χριστού» (14^(ου) αιώνα) από το Βυζαντινό Μουσείο της Αθήνας, όπου εκτίθεται σήμερα, στο ναό του Ελκόμενου Χριστού στη Μονεμβασιά, απ' όπου εκλάπη το 1979. (εφ. Ελευθεροτυπία, 27.08.2009)"
                                            }
                                        ]
                                    }
                                ]
                            }
