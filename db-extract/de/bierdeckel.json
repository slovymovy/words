                                "target_senses": [
                                    {
                                        "sense_id": "63a957a6-4e79-3934-a34c-4d3dcd5cacb1",
                                        "entry_id": "7f8a4cc8-8e21-34ba-853f-c1f7cc2c7955",
                                        "glosses": [
                                            "A small square, circular or differently shaped cardboard mat, often with an advertisement for a brewery on it, that is used to rest one's glass on, and to protect the surface of a table or a bar in a pub."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
