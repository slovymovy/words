                "senses": [
                    {
                        "sense_id": "6298ca1f-c3bb-345b-86f2-01820fa1b051",
                        "entry_id": "232298cc-83ab-3d64-8d0f-46612de4fb6a",
                        "glosses": [
                            "Fait de se citer soi-même, en particulier: pour l'auteur d'un article scientifique qui cite la littérature plus ancienne dans l'état de l'art."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d434e985-edac-4443-ade7-9de88f70c431",
                                "sense_id": "6298ca1f-c3bb-345b-86f2-01820fa1b051",
                                "text": "L’étalonnage de la qualité des revues repose sur le taux de citations dont leurs articles font l’objet dans les revues les mieux classées. Entre auteurs, institutions et revues de l’élite, la protection du rang passe par des pratiques d’autocitation et par l’oubli sélectif de revues, auteurs et institutions qui ne font pas partie du monde qu’ils composent."
                            },
                            {
                                "example_id": "55cb110f-d6db-4b8d-8483-053130476c0a",
                                "sense_id": "6298ca1f-c3bb-345b-86f2-01820fa1b051",
                                "text": "Toutes les communautés scientifiques nationales ont tendance à augmenter leurs autocitations dans leur recherche désespérée visant à atteindre l’objectif que leurs gouvernements leurs assignent via cet indicateur devenu, dès lors, stupide."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1549b7a-d712-3a0b-be74-febbf594fb3b",
                        "entry_id": "232298cc-83ab-3d64-8d0f-46612de4fb6a",
                        "glosses": [
                            "Citation que l’on fait de ses propres paroles, d’un texte dont on est l’auteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "909dff88-e3ec-4823-be94-ff920dd43f8c",
                                "sense_id": "c1549b7a-d712-3a0b-be74-febbf594fb3b",
                                "text": "Qu’on me permette encore une autocitation. Ce qui suit est extrait du chapitre de mon livre « Ontologie et Psychologie physiologique », qui a pour titre : « La Métaphysique dans les Sciences » : […]"
                            }
                        ]
                    }
