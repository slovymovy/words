                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31898bbc-1e42-4708-8478-eb5a563fa8ed",
                                "sense_id": "905ff5ce-c9f4-3f01-970f-5b4c0738a5bd",
                                "text": "les aryténoïdes sont des petits cartilages situés en haut et en arrière du larynx, au-dessus du cartilage cricoïde."
                            },
                            {
                                "example_id": "fea648cd-ed44-421a-9f43-6e06b11c2634",
                                "sense_id": "905ff5ce-c9f4-3f01-970f-5b4c0738a5bd",
                                "text": "Ce ligament est tapissé intérieurement par une synoviale, qui est très lâche et qui, de ce fait, permet à l’aryténoïde des mouvements faciles et a étendus."
                            }
                        ]
