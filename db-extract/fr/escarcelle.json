        "fr-extract.jsonl": [
            {
                "entry_id": "d579444c-fa7a-363f-8deb-87e856c6407a",
                "word": "escarcelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ea3748b4-1905-4368-a6fd-22fe5440cead",
                        "entry_id": "d579444c-fa7a-363f-8deb-87e856c6407a",
                        "tags": [
                            "plural"
                        ],
                        "form": "escarcelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dc7f724-8565-3ab0-aa03-760ecaee93ab",
                        "entry_id": "d579444c-fa7a-363f-8deb-87e856c6407a",
                        "glosses": [
                            "Grande bourse que l’on portait autrefois pendue à la ceinture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d6888e7-c9c1-4408-b078-7555bd47e0a5",
                                "sense_id": "1dc7f724-8565-3ab0-aa03-760ecaee93ab",
                                "text": "Il mettait dans la serrure la petite clef compliquée qu’il portait toujours sur lui dans l’escarcelle pendue à son côté"
                            },
                            {
                                "example_id": "35b5d845-3467-401c-94e9-cd55b66078c0",
                                "sense_id": "1dc7f724-8565-3ab0-aa03-760ecaee93ab",
                                "text": "L’escarcelle ou escharcelle tirait son nom du vieux mot français eschars qui signifiait avare ou au moins économe. La bourse était surtout affectée à la dépense, l’escarcelle plutôt à la recette ; les pèlerins, qui recevaient plus qu’ils ne donnaient, ne se mettaient jamais en route sans escarcelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "296e8340-42c3-3e5c-8704-15376324eda7",
                        "entry_id": "d579444c-fa7a-363f-8deb-87e856c6407a",
                        "glosses": [
                            "Porte-monnaie ; portefeuille."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "bfd291b8-6cbb-43aa-afe1-78a2ff0b5f51",
                                "sense_id": "296e8340-42c3-3e5c-8704-15376324eda7",
                                "text": "Afin de se montrer dignes de leurs illustres protectrices, les petites bourgeoises ne craignent pas de mettre à sec l’escarcelle du ménage pour se procurer les parures enviées."
                            },
                            {
                                "example_id": "2a1a9357-2343-473f-b219-5c50d707ce63",
                                "sense_id": "296e8340-42c3-3e5c-8704-15376324eda7",
                                "text": "Mais Césarin ne procédait pas toujours par intimidation ; il avait, au contraire, pour attendrir ses concitoyens et se faire ouvrir leurs escarcelles, recours le plus souvent à la ruse et la flagornerie."
                            },
                            {
                                "example_id": "02a4c873-e359-4148-8b5e-2cd0a8de2567",
                                "sense_id": "296e8340-42c3-3e5c-8704-15376324eda7",
                                "text": "Toutes sortes de firmes, par le moyen de leurs succursales, lancent vers lui, ou plutôt vers son escarcelle, leurs tentacules émoustillants, titillants et aspirants."
                            }
                        ]
                    }
                ],
