                "senses": [
                    {
                        "sense_id": "74ec8c4e-a2aa-3cdd-a5fa-fe4f67108387",
                        "entry_id": "4443c01f-86fc-3aa9-88a5-b1023a9cd5de",
                        "glosses": [
                            "Eigenschaft, die Voraussetzungen (das Potenzial) zu haben, um realisiert und Wirklichkeit zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18368ef6-d1c4-4b3b-b0f6-14d64c421d2f",
                                "sense_id": "74ec8c4e-a2aa-3cdd-a5fa-fe4f67108387",
                                "text": "„Sie ist aber noch keine Statue, sondern befindet sich im Prozess der Annahme der Form. Während sie durch den Bildhauer geformt wird, bleibt ihre Potenzialität, Statue-zu-werden, erhalten.“"
                            },
                            {
                                "example_id": "8ac58b5b-b0a4-4ffc-82fa-286d20b47f20",
                                "sense_id": "74ec8c4e-a2aa-3cdd-a5fa-fe4f67108387",
                                "text": "„Eine Oozyte geht nach dem Sprung aus dem Ovar nach kurzer Zeit zugrunde, wenn sie nicht durch das Eindringen eines Spermiums oder durch einen experimentellen Eingriff aktiviert wird. Sie hat also die Potenzialität, zu einem erwachsenen Menschen heranzureifen, ist aber zur Realisierung dieser Potenzialität auf die Aktivierung durch etwas Anderes angewiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
