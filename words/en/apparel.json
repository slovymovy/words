                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать или украшать что-либо орнаментом или естественной красотой.",
                        "de": "Etwas bedecken oder mit Verzierungen bzw. natürlicher Schönheit schmücken."
