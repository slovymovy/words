                "senses": [
                    {
                        "sense_id": "fce20420-b343-3025-a9f1-2489bf5ee535",
                        "entry_id": "0781abde-444f-3688-a4f7-1787b290ebeb",
                        "glosses": [
                            "die (gesamte) Bevölkerung der Sowjetunion"
                        ],
                        "tags": [
                            "nur Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "06fb1578-7fc3-457c-a976-886d42de2dd7",
                                "sense_id": "fce20420-b343-3025-a9f1-2489bf5ee535",
                                "text": "„Wir gehen an die Arbeit, erfüllt von unserem Verantwortungsgefühl gegenüber der Partei und dem Sowjetvolk.“"
                            },
                            {
                                "example_id": "dce8d44f-e550-4466-b015-e8776c71b878",
                                "sense_id": "fce20420-b343-3025-a9f1-2489bf5ee535",
                                "text": "„Josef Stalin sprach von Hirse / Zu Mitschurins Schülern, sprach von Dung und Dürrewind. / Und des Sowjetvolkes großer Ernteleiter / Nannt die Hirse ein verwildert Kind ...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "094726d1-822e-3b52-b4f0-1125f4e8fa16",
                        "entry_id": "0781abde-444f-3688-a4f7-1787b290ebeb",
                        "glosses": [
                            "die (verschiedenen) Völker/Nationalitäten der Sowjetunion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e961e2e-5662-4242-b2d9-d7bfa7ce33aa",
                                "sense_id": "094726d1-822e-3b52-b4f0-1125f4e8fa16",
                                "text": "„Lang und breit erklärte mir Siegfried, dass Russen nur ein Sowjetvolk sind. Wie Ukrainer, Kasachen.“"
                            },
                            {
                                "example_id": "9bc65467-f2a0-4ced-8ecc-a876a221a420",
                                "sense_id": "094726d1-822e-3b52-b4f0-1125f4e8fa16",
                                "text": "„Im entschlossenen Gleichschritt mit den anderen Brudervölkern der Sowjetunion schreitet das armenische Sowjetvolk triumphierend dem Fortschritt entgegen und auf die Gipfelpunkte der menschlichen Zivilisation zu.“"
                            },
                            {
                                "example_id": "d540d399-8e80-4f49-a859-18b64392e6da",
                                "sense_id": "094726d1-822e-3b52-b4f0-1125f4e8fa16",
                                "text": "„Es gibt deutsche Romane, die in chinesischer Übersetzung und in den Sprachen asiatischer Sowjetvölker vorliegen, aber in Hamburg oder Frankfurt in keiner Buchhandlung zu finden sind.“"
                            },
                            {
                                "example_id": "b9f71111-6b0f-42cc-a58b-e306a5ec0d9b",
                                "sense_id": "094726d1-822e-3b52-b4f0-1125f4e8fa16",
                                "text": "„Dem Glasnost-Experiment Gorbatschows war es zu verdanken, daß zum ersten Mal der Schleier heuchlerischer Brüderlichkeit zwischen den diversen Sowjetvölkern zerriß und eine ganz andere Wirklichkeit zutage trat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
