                        "glosses": [
                            "Première feuille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b57e89-c880-45d7-9ca1-056fc713096b",
                                "sense_id": "d6ecd8a2-f106-3d77-977a-6d2d26617f96",
                                "text": "Pour M. Duval-Jouve, le cladode florifère des ruscus est composé d’un rameau et de la primefeuille de ce rameau à lui soudée, et le cladode non florifère est la primefeuille d’un rameau qui est demeuré à l’état rudimentaire."
                            },
                            {
                                "example_id": "16d9c068-6ced-4aad-aaed-e2d0ac930939",
                                "sense_id": "d6ecd8a2-f106-3d77-977a-6d2d26617f96",
                                "text": "Dans le R. Hypoglossum, la bractée florale est opposée à la feuille-mère et doit être regardée comme la primefeuille du rameau cladodique."
                            }
                        ]
                    }
