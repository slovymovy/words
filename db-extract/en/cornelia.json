                                                "sense_id": "c10d488e-9d59-3e43-b19f-0d9bc14b329a",
                                                "text": "Maren maakte het haar destijds moeilijk en ze kon nog niet op de vriendschap van Cornelia rekenen."
                                            },
                                            {
                                                "example_id": "11f9417a-f49e-497e-9059-0e881275ba0d",
                                                "sense_id": "c10d488e-9d59-3e43-b19f-0d9bc14b329a",
                                                "text": "Cornelia staat bij de deur te wachten, en als Nella haar ziet, besterven het nieuws over Johannes en het geheim van de miniatuurmaakster op haar lippen."
                                            }
                                        ]
                                    }
                                ]
                            }
