                        "target_lang_word": "Uluru",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uluru",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                        "entry_id": "77d4e246-ed29-360f-9a57-a67f252832f1",
                                        "glosses": [
                                            "ein den Aborigines Aṉangu heiliger Berg in der zentralaustralischen Wüste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ec186a6-1296-4029-96da-14b2d4a87f29",
                                                "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                                "text": "Der 843 Meter hohe Berg Uluru erhebt sich 348 Meter über sein Umland."
                                            },
                                            {
                                                "example_id": "6d44f24a-0942-4f50-8d84-c2ac421c5c40",
                                                "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                                "text": "Aufgrund seiner natürlichen und kulturellen Bedeutung hat die UNESCO den Uluru zum Weltnaturerbe und zum Weltkulturerbe erklärt."
                                            },
                                            {
                                                "example_id": "9072904c-3c71-4347-90bf-80992c1d17e2",
                                                "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                                "text": "Der Berg Uluru in Australien symbolisiert für die Aborigines das Nichts."
                                            },
                                            {
                                                "example_id": "2f25d3cd-d348-4d04-97e7-c13c863debf1",
                                                "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                                "text": "Die Aborigines protestierten, Australiens Regierung gab ihnen schließlich recht: Seit Oktober ist der Uluru für Besucher gesperrt."
                                            },
                                            {
                                                "example_id": "0446883b-5000-457c-a99e-14e1f823f94a",
                                                "sense_id": "749e1799-df4d-3ca6-aa7f-2421b447b768",
                                                "text": "Eine typische Tour führt von Alice Springs über einen Stop an einer Kamelfarm zum Uluru mit dortiger Wanderung und/oder Sonnenuntergangs-Sekt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d33a838-e694-45e4-80d6-652b9cca3d7f",
                        "source_entry_id": "a93539cd-0e96-310f-b144-baeeb566affa",
                        "source_sense_id": "3f544f21-8191-3179-8be1-31088058beb5",
                        "source_sense_description": "giant rock in Australia",
                        "target_lang_word": "Ουλουρού",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ουλουρού",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "ee7d3b24-c69b-3c9d-ae31-377c7f351d30",
                                        "entry_id": "8df627dd-6b3c-3d21-8499-92b604f33b96",
                                        "glosses": [
                                            "γιγάντιος ερυθρόχρωμος βράχος στην κεντρική Αυστραλία"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74494405-f999-44ea-b1ef-e9a6e496cffc",
                                                "sense_id": "ee7d3b24-c69b-3c9d-ae31-377c7f351d30",
                                                "text": "※ Στην καρδιά της Αυστραλίας, εκεί που το μάτι τρέχει πάνω από τις επίπεδες εκτάσεις, ένας τεράστιος βράχος υψώνεται ξαφνικά «από το πουθενά». Είναι το Ουλουρού, ο μεγαλύτερος μονόλιθος στον κόσμο, ιερός βράχος για τους Αβορίγινες που ζούσαν πάντα στην περιοχή.",
                                                "translation": "Μάχη Μαργαρίτη, Ο βράχος-«χαμαιλέων» που διχάζει τους επισκέπτες: το Ουλουρού της Αυστραλίας, ertnews.gr, 25 Μαΐου 2016"
                                            },
                                            {
                                                "example_id": "f8eea47e-2ef2-4698-b9eb-0ddfa6c0dc32",
                                                "sense_id": "ee7d3b24-c69b-3c9d-ae31-377c7f351d30",
                                                "text": "※ Η ορειβασία στον περίφημο κόκκινο βράχο Ουλουρού / Άγιερς Ροκ της Αυστραλίας παύει από το 2019, μετά από προσπάθειες των ντόπιων Αβοριγίνων, που τον θεωρούν ιερό.",
                                                "translation": "Αυστραλία: Παύει η ορειβασία στο μονόλιθο Ουλουρού / Άγιερς Ροκ, athensvoice.gr, 2 Νοεμβρίου 2017"
                                            },
                                            {
                                                "example_id": "90cd176a-e324-4f90-a4fc-411fcafe0bdc",
                                                "sense_id": "ee7d3b24-c69b-3c9d-ae31-377c7f351d30",
                                                "text": "※ Τεράστια πλήθη συγκεντρώθηκαν στο Ουλουρού της Αυστραλίας, την τελευταία ημέρα πριν την απαγόρευση της αναρρίχησης.",
                                                "translation": "Η τελευταία αναρρίχηση στον ιερό βράχο Ουλουρού - Τεράστια πλήθη πριν την ιστορική απαγόρευση, lifo.gr, 25 Οκτωβρίου 2019"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
