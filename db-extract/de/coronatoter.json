                "senses": [
                    {
                        "sense_id": "654d156d-b62c-37d1-b7ce-a9085457e787",
                        "entry_id": "2b791a5e-5fa6-3e87-a0ca-5c3e6aff9bd6",
                        "glosses": [
                            "(männliche) Person, die an Covid-19 verstorben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e326ff87-4cd7-4ce9-8cc9-643bee214036",
                                "sense_id": "654d156d-b62c-37d1-b7ce-a9085457e787",
                                "text": "„Kein anderes Land der Welt zählt mehr Coronatote pro Einwohner, die Intensivstationen sind hoffnungslos überfüllt. Im Video erzählen Patienten aus Rumänien, wie sehr sie es bereuen, dass sie sich nicht impfen ließen.“"
                            },
                            {
                                "example_id": "131fac0e-adcf-4e12-8538-f3aafdaf23f6",
                                "sense_id": "654d156d-b62c-37d1-b7ce-a9085457e787",
                                "text": "„Natürlich ist es nicht mehr als eine Zahl. Heute ist der Tag, an dem in Deutschland mehr als 100.000 Coronatote zu beklagen sind. Die Infektionszahlen steigen weiter, die Aussichten sind düster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
