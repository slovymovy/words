                                        "entry_id": "1874199f-5536-3365-9c7a-043cfef06035",
                                        "glosses": [
                                            "Branche de la géologie qui étudie la formation, le transport, le dépôt et la transformation (diagenèse) des sédiments et des roches sédimentaires, en vue de reconstituer les processus et environnements passés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24045582-de97-4af4-b7ee-a4c2306ffc38",
                                                "sense_id": "2ac8e2e4-025e-3589-8182-7778e85534da",
                                                "text": "De ce point de vue, le développement de la sédimentologie appliquée aux milieux humides livre désormais des éclairages d’une portée capitale."
                                            }
                                        ]
                                    }
                                ]
