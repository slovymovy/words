                                        "glosses": [
                                            "Qui ne peut être exterminé."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "011502c7-ae72-4418-87d3-e632c0a3717a",
                                                "sense_id": "a8ae69ee-1572-34f0-8364-1f7fa4259884",
                                                "text": "Dieu a créé l’homme inexterminable et l’a faict à l’image de sa semblance."
                                            },
                                            {
                                                "example_id": "ccd498fd-28e1-4a06-9a2c-22b5b5ed9bc8",
                                                "sense_id": "a8ae69ee-1572-34f0-8364-1f7fa4259884",
                                                "text": "Or comme Dieu est inexterminable, l’homme est inexterminable puisqu’il est fait à son Image et plus bas nous prouverons que la mort même n’atteint pas la racine indestructible de l’homme créé ; elle la mord, elle l’enserre, elle l’enchaîne, mais elle ne peut la détruire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
