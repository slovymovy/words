                    {
                        "form_id": "799bbc22-8a19-4674-b8cf-424b7282fb05",
                        "entry_id": "bb5498a4-cef5-3b23-a169-34c7ce0819c5",
                        "tags": [
                            "singular"
                        ],
                        "form": "^((h aspiré))\\i.ki.ko.mo.ʁi\\"
