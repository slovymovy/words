                                    {
                                        "sense_id": "f1a120b4-12f7-374c-893a-5f5155df0413",
                                        "entry_id": "fd0b6122-e060-3c09-97e3-d74fed84c390",
                                        "glosses": [
                                            "Prénom masculin d’origine slave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9726ddf7-c642-4d6a-9748-34e1621a352a",
                                                "sense_id": "f1a120b4-12f7-374c-893a-5f5155df0413",
                                                "text": "La demeure est ouverte depuis le 22 mars et accueille une famille ukrainienne de huit enfants orphelins de 5 à 17 ans avec leurs parents adoptifs, Ivan et Svitlana Levishko."
                                            },
                                            {
                                                "example_id": "b8852fad-1c72-4a7c-940c-b6a29e7853b0",
                                                "sense_id": "f1a120b4-12f7-374c-893a-5f5155df0413",
                                                "text": "C’est une mesure stupide, s’indigne Ivan Sébla, médecin dans les Yvelines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ivan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df12bcd8-142e-3ac5-bc9d-447c9b350d7a",
                                        "entry_id": "194c8f51-8f54-3316-b0a1-ea0da2ca384a",
                                        "glosses": [
                                            "Soldats russes à la fin de la Seconde Guerre mondiale."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89872102-2126-49f1-bed5-0d8be96d76b5",
                                                "sense_id": "df12bcd8-142e-3ac5-bc9d-447c9b350d7a",
                                                "text": "Juutilainen prit cet ordre comme une récompense, tant il n’avait d’autre souhait que d’utiliser enfin son fusil et descendre quelques Ivans."
                                            },
                                            {
                                                "example_id": "1ecdfc39-d044-4516-a89d-4ae614460c8f",
                                                "sense_id": "df12bcd8-142e-3ac5-bc9d-447c9b350d7a",
                                                "text": "Affamés, terrifiés, les Berlinois se terrent dans les sous-sols pour échapper aux « Ivan ». Ces soldats envoyés pour liquider les dernières poches de résistance sont décrits par la propagande nazie comme une bande de « bestiaux russes » de qui il faut tout attendre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
