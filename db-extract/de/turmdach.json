                ],
                "senses": [
                    {
                        "sense_id": "8c8a7bc6-9c2f-3201-83f1-6509e8fe2a4d",
                        "entry_id": "1e98017d-f15e-33bb-8fd3-58793edb792f",
                        "glosses": [
                            "Dach eines Turms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8311a3e8-1e0c-4fb4-b137-25663787aba7",
                                "sense_id": "8c8a7bc6-9c2f-3201-83f1-6509e8fe2a4d",
                                "text": "„Er ließ den Blick noch einmal über die Turmdächer wandern, hob die Luke der Falltür an und hastete die unbeleuchtete Treppe hinab, durch die Barriere hindurch, die einen so brennenden Schmerz verursachte.“"
                            },
                            {
                                "example_id": "3c42a555-1b6e-41a0-a625-10ece17d583a",
                                "sense_id": "8c8a7bc6-9c2f-3201-83f1-6509e8fe2a4d",
                                "text": "„Es dauerte einen Moment, bis ihm klar wurde, dass es beim Einschlag der Granate über den Rand des Turmdachs gefallen sein musste.“"
                            },
                            {
                                "example_id": "4e76856e-87cb-4700-bd00-27937253b6a3",
                                "sense_id": "8c8a7bc6-9c2f-3201-83f1-6509e8fe2a4d",
                                "text": "„Das Turmdach maß nicht mehr als drei Meter im Geviert, war nur um ein weniges höher als die Mauern, die es umgaben und knappe zwanzig Meter lang waren - das Ganze eher eine Spielzeugburg als eine Festung.“"
                            },
                            {
                                "example_id": "796c1ff3-e820-4eb4-b9b0-9a11ca84ed50",
                                "sense_id": "8c8a7bc6-9c2f-3201-83f1-6509e8fe2a4d",
                                "text": "„Fernöstliche Tempel, auf deren Gepränge aus Bronze und Gold das Sonnenlicht gleißte, wichen spitzen, dicht gedrängten Giebeln und Turmdächern mittelalterlicher Städte, gefolgt von tropischen Dschungeln und nordischen Wäldern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
