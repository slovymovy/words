                    {
                        "translation_id": "9b6bbf09-d4c8-43a7-8176-b833a89987cd",
                        "source_entry_id": "6b977864-6cf1-3130-8125-4aa644e666d0",
                        "source_sense_id": "6be4f341-a4ae-36e7-8326-d9f4467615bf",
                        "source_sense_description": "a person who shapes metal",
                        "target_lang_word": "металли́ст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "металли́ст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0d710f0d-ab89-3f4f-a02f-2b14d2d51d97",
                                        "entry_id": "226527d3-be30-35a0-81be-a64e03f18157",
                                        "glosses": [
                                            "рабочий металлообрабатывающей промышленности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f213879-cff6-4501-8dd0-7f1d440d569b",
                                                "sense_id": "0d710f0d-ab89-3f4f-a02f-2b14d2d51d97",
                                                "text": "На лице старого рабочего-металлиста, сидящего на табурете с паяльником в одной руке, с медной трубкой в другой, были написаны усердие, выдержка, уверенность в себе, торжество, любование своей работой и сдержанный восторг перед собственным мастерством."
                                            },
                                            {
                                                "example_id": "d52cbe34-a41a-4aea-91a5-ea9873b1e748",
                                                "sense_id": "0d710f0d-ab89-3f4f-a02f-2b14d2d51d97",
                                                "text": "― Кончу семилетку, поступлю в фабзавуч. Буду металлистом, настоящим рабочим. Меня в комсомол и без кандидатского стажа примут."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d241d1-6008-342b-b2a9-1e21fcd186c9",
                                        "entry_id": "226527d3-be30-35a0-81be-a64e03f18157",
                                        "glosses": [
                                            "специалист по металлам, металловедению"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23edba67-ae2c-349a-8229-b3e61d98f416",
                                        "entry_id": "226527d3-be30-35a0-81be-a64e03f18157",
                                        "glosses": [
                                            "исполнитель или поклонник металлического рока"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2de4fbc-e467-4ca5-b631-44f0d264bcbd",
                                                "sense_id": "23edba67-ae2c-349a-8229-b3e61d98f416",
                                                "text": "Когда я тусовалась с рокерами, с металлистами, как ни старалась, не могла принять их культ силы, исключительной личности."
                                            },
                                            {
                                                "example_id": "df0aa13b-b083-4799-a3d1-1571ea53a043",
                                                "sense_id": "23edba67-ae2c-349a-8229-b3e61d98f416",
                                                "text": "Кто-то из «старых» видел однажды в клубе металлиста с Космонавтов: с цепями, браслетами и прочей ерундой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
