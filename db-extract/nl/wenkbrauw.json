                        "entry_id": "de2c489d-d37d-38e1-8649-d0319b80cfdd",
                        "glosses": [
                            "knokige rand boven het oog, meestal begroeid met haar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5cccedb-82de-4231-a316-ecf426f31b74",
                                "sense_id": "42cf2d3f-47ba-3530-8f0e-d98ea8736f12",
                                "text": "De wenkbrauwen fronsen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "223a0f40-78a3-4dfc-b072-f029dbe52695",
                        "source_entry_id": "de2c489d-d37d-38e1-8649-d0319b80cfdd",
                        "source_sense_id": "42cf2d3f-47ba-3530-8f0e-d98ea8736f12",
                        "source_sense_description": "knokige rand boven het oog, meestal begroeid met haar",
                        "target_lang_word": "Augenbraue",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Augenbraue",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27807cee-f881-3de9-9525-0eade2d2d209",
                                        "entry_id": "6a2844f0-7720-3302-8a6f-e01112030ac4",
                                        "glosses": [
                                            "der behaarte Halbbogen über den Augen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c2a7227-62ae-44ac-b2f2-da1c3b01ed86",
                                                "sense_id": "27807cee-f881-3de9-9525-0eade2d2d209",
                                                "text": "Marlen zupft sich grad die Augenbrauen."
                                            },
                                            {
                                                "example_id": "9521d888-a038-4f8b-81c0-3a9ac20fcb86",
                                                "sense_id": "27807cee-f881-3de9-9525-0eade2d2d209",
                                                "text": "„Die Mütze war ihm wohl drei Nummern zu groß, denn der weiße Rand reichte bis an die Augenbrauen und bis zum oberen Teil der Ohren.“"
                                            },
                                            {
                                                "example_id": "888bdb59-9b68-4272-8c46-beb064eda2ae",
                                                "sense_id": "27807cee-f881-3de9-9525-0eade2d2d209",
                                                "text": "„Ich stellte fest, daß ich die Augenbrauen bewegen konnte.“"
                                            },
                                            {
                                                "example_id": "61768e50-0d7b-42de-9db0-6bb859b39c2b",
                                                "sense_id": "27807cee-f881-3de9-9525-0eade2d2d209",
                                                "text": "„Noby zog die Augenbrauen unter seiner Brille empor.“"
                                            },
                                            {
                                                "example_id": "2b5ab834-6059-41af-bb6c-5599c373f17b",
                                                "sense_id": "27807cee-f881-3de9-9525-0eade2d2d209",
                                                "text": "„Sie zieht ihren dunkelroten Kordrock ein Stück hinunter, fährt sich über die Augenbrauen – damit kein Härchen nach oben oder unten absteht – und nimmt das Tablett mit den sechs Teegläsern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
