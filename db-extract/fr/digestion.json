        "fr-extract.jsonl": [
            {
                "entry_id": "0c5b41a7-2c0c-35e0-ba76-4ce738b34cc3",
                "word": "digestion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b8c3e7a3-640c-4f8e-85f8-12e4856a5f1d",
                        "entry_id": "0c5b41a7-2c0c-35e0-ba76-4ce738b34cc3",
                        "tags": [
                            "plural"
                        ],
                        "form": "digestions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d99e2661-d858-3910-852c-3cdbfad78964",
                        "entry_id": "0c5b41a7-2c0c-35e0-ba76-4ce738b34cc3",
                        "glosses": [
                            "Action de digérer : processus au cours duquel un organisme vivant élabore les aliments mangés en nutriments, les assimile, et défèque le rebut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9dd958f-3cbe-4964-841f-f235b7d71fbc",
                                "sense_id": "d99e2661-d858-3910-852c-3cdbfad78964",
                                "text": "On fait aussi du pain, mais d'une digestion assez difficile, avec du seigle, de l’orge et même de l’avoine ; […]."
                            },
                            {
                                "example_id": "8bdf7b92-f2fc-4751-8b1f-9fe6fe49831c",
                                "sense_id": "d99e2661-d858-3910-852c-3cdbfad78964",
                                "text": "Je sens mes intestins qui ronronnent légèrement. La digestion sans heurts est le plus grand facteur d'activité. Le cerveau s'emplit avec le ventre et l'optimisme a sa source dans la béatitude des tripes."
                            },
                            {
                                "example_id": "075eac05-5ca3-4795-82d2-eca75e7eef38",
                                "sense_id": "d99e2661-d858-3910-852c-3cdbfad78964",
                                "text": "La digestion commence dans la cavité buccale où se font l'ingestion, la fragmentation et l'humidification des aliments."
                            },
                            {
                                "example_id": "88d7a4ae-a1d9-42de-854a-ad5d24a0eb74",
                                "sense_id": "d99e2661-d858-3910-852c-3cdbfad78964",
                                "text": "Les Nepenthes sont des plantes carnivores caractérisées par des feuilles modifiées, en forme d'urnes, surmontées d'un opercule protecteur et contenant un fluide riche en enzymes permettant la digestion des proies qui y tombent."
                            }
                        ]
                    },
                    {
                        "sense_id": "eeb836a1-e082-31dc-8b86-f710058f493b",
                        "entry_id": "0c5b41a7-2c0c-35e0-ba76-4ce738b34cc3",
                        "glosses": [
                            "Opération ayant pour but d’extraire, par macération dans un liquide approprié, certains éléments solubles contenus dans une substance donnée."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74da0738-75c7-4a00-96d1-e3b826e910f6",
                        "source_entry_id": "0c5b41a7-2c0c-35e0-ba76-4ce738b34cc3",
                        "target_lang_word": "Verdauung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdauung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f3e3f84-f2c1-3973-a3bb-29aa0165f434",
                                        "entry_id": "1a653a08-14d5-319a-9b3a-ecb0cdfa5899",
                                        "glosses": [
                                            "Verwertung der Nahrung, vor allem durch Magen und Darm; Umsetzung der Nahrung in Lebenskraft; Teil des Stoffwechsels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d958ce73-72d5-463a-8b61-70cf5efb26ae",
                                                "sense_id": "0f3e3f84-f2c1-3973-a3bb-29aa0165f434",
                                                "text": "Verdauung ist ein lebenswichtiger körperlicher Vorgang."
                                            },
                                            {
                                                "example_id": "8cd6e4c4-a624-4b72-a94b-d8a1165b6224",
                                                "sense_id": "0f3e3f84-f2c1-3973-a3bb-29aa0165f434",
                                                "text": "Auch Nagetiere haben das Problem der schwerverdaulichen Pflanzennahrung, das die meisten – ausgenommen etwa Siebenschläfer – wie die Hasentiere durch Caecotrophie, die doppelte Verdauung, lösen."
                                            },
                                            {
                                                "example_id": "59f945f5-a416-4615-b71d-de6e70e368df",
                                                "sense_id": "0f3e3f84-f2c1-3973-a3bb-29aa0165f434",
                                                "text": "„Die Frage ist halb ernst gemeint, aber Lampe fängt sofort an zu plappern, über seine Erfahrungen mit Gänsen, die mit Fenchel gefüllt werden müßten, der Verdauung wegen; oder Hasen, die in Buttermilch eingelegt, schneller gar würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "195e4c2d-2eb9-378f-89f3-4b254fca8ea1",
                                        "entry_id": "1a653a08-14d5-319a-9b3a-ecb0cdfa5899",
                                        "glosses": [
                                            "Stuhlgang"
                                        ],
                                        "tags": [
                                            "euphemistisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5fd0d25-2a31-4492-8992-d4bb17c4ee32",
                                                "sense_id": "195e4c2d-2eb9-378f-89f3-4b254fca8ea1",
                                                "text": "Hatten Sie heute schon Verdauung?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dce858f0-4760-34b9-af4d-825152a40088",
                                        "entry_id": "1a653a08-14d5-319a-9b3a-ecb0cdfa5899",
                                        "glosses": [
                                            "(psychische) Verkraftung von etwas Belastendem"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026bf541-e52a-48b9-b972-dc25d7b42e72",
                                                "sense_id": "dce858f0-4760-34b9-af4d-825152a40088",
                                                "text": "Die Verdauung der Niederlage erforderte viel Kraft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
