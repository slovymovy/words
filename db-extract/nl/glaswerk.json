                        "glosses": [
                            "van glas vervaardigde vaten en toestellen zoals deze in een laboratorium veel gebruikt worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df13909e-d67e-4987-8f18-ddd48ad7cb81",
                                "sense_id": "782b04b7-5d35-3610-af60-cca99017fa4e",
                                "text": "Veel glaswerk is van pyrex vervaardigd omdat dat beter tegen snelle temperatuursveranderingen bestand is."
                            }
                        ]
                    },
                    {
                        "sense_id": "03fd8841-1222-32c9-84c5-f49b7e32ce1e",
