                        "examples": [
                            {
                                "example_id": "68085a5a-a6c5-469a-9c62-bd87545604b4",
                                "sense_id": "338ec66c-0b61-3482-82b4-87feefa26190",
                                "text": "Od zeszłego roku nasze trafiki wysyłamy wyłącznie do posiadaczy kart klienta."
