                        "translation_id": "bec4bbcd-3402-46d5-87d0-60cc1e87082c",
                        "source_entry_id": "379ebb7b-17f8-39e3-8360-535b3c82a21c",
                        "source_sense_id": "84c600c1-6c93-3a24-a518-d0680e21916e",
