                        "tags": [],
                        "examples": [
                            {
                                "example_id": "532d372c-e06f-4b2e-839c-234ffbe13124",
                                "sense_id": "ad17e29f-e591-3cf4-beef-45503aba2734",
                                "text": "Sie ist Dattelnerin, ihr Mann ist Bochumer."
                            },
                            {
                                "example_id": "c25dc5dc-7f97-4fc7-ac1c-cd65a7ae3fdb",
                                "sense_id": "ad17e29f-e591-3cf4-beef-45503aba2734",
                                "text": "„Er kennt das Stimmungsbild in der Stadt, weil er mit den Dattelnerinnen und Dattelnern regelmäßig Gespräche führt[.]“"
                            },
                            {
                                "example_id": "902e6491-89f9-4e96-8caa-e43e952bdc20",
                                "sense_id": "ad17e29f-e591-3cf4-beef-45503aba2734",
                                "text": "„Dann steht auch fest, ob die Dattelnerin Lena Kaiser (17) weiter kommt.“"
                            },
                            {
                                "example_id": "6bc59876-b98c-4043-a2ce-717379e48579",
                                "sense_id": "ad17e29f-e591-3cf4-beef-45503aba2734",
                                "text": "„Katja Seizinger […] war allerdings nur eine »en passent«-Dattelnerin, weil sie zwar in Datteln geboren wurde, dann aber mit ihren Eltern nach Süddeutschland zog.“"
                            },
                            {
                                "example_id": "6d2d650d-9fba-45fc-a706-c01e8370eefd",
                                "sense_id": "ad17e29f-e591-3cf4-beef-45503aba2734",
                                "text": "„Die 42-Jährige Dattelnerin hat gute Chancen, den Kunden der AOK bald aus einer Broschüre entgegen zu lächeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
