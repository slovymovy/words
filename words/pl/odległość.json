                    "sense_id": "cf607358-b826-30e0-aeff-3eee3cd025a5",
                    "sense_definition": "Przestrzeń lub dystans dzielący dwa punkty, miejsca lub obiekty",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jaka jest <w>odległość</w> między twoim domem a szkołą?",
                            "target_lang_translations": {
