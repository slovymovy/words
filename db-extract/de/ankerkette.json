                ],
                "senses": [
                    {
                        "sense_id": "093bffd7-f901-3017-9aee-27de3986217c",
                        "entry_id": "24446617-d091-31f0-b032-de44a3dfc185",
                        "glosses": [
                            "die Kette, an der der Anker eines Schiffes hängt"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "f6197815-f8c7-40b5-afed-2de62052eb78",
                                "sense_id": "093bffd7-f901-3017-9aee-27de3986217c",
                                "text": "„Dann rasselt die Ankerkette und die Transvaal dreht sich in den Wind.“"
                            },
                            {
                                "example_id": "a6924dd7-2b77-45c8-9d4e-56e26898c7f0",
                                "sense_id": "093bffd7-f901-3017-9aee-27de3986217c",
                                "text": "„Auch sie war ein Prachtstück in Sachen Innovation\", sagt Burke, während die Ankerkette zügig in Richtung Meeresgrund rasselt und man vor lauter Lärm schon fast seine Lippen lesen muss.“"
                            },
                            {
                                "example_id": "755b4c1c-daa4-4167-a743-1a1319ad2375",
                                "sense_id": "093bffd7-f901-3017-9aee-27de3986217c",
                                "text": "„Ein Filipino klettert die Ankerkette eines Frachtschiffs hoch, das im Hafen von Manila liegt.“"
                            },
                            {
                                "example_id": "a0585ea4-7600-4045-b8d4-d2ce39c0628c",
                                "sense_id": "093bffd7-f901-3017-9aee-27de3986217c",
                                "text": "„Als es wieder still war, hörte man deutlich, wie Ankerketten in den Klüsen rasselten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
